// Package registry: `use <name>` of a name found in no local search directory fetches the git repository named here
// into packages/<name> and loads packages/<name>/<name>.wasp; a package without it only brings files.
// `name: "git url"` follows the default branch (a shallow clone per checkout);
// `name: {repository: "git url", version: 1.2.3}` pins the git tag v1.2.3: cloned once per machine into
// ~/.cache/warp/packages/<name>@1.2.3 (a tag never changes) and linked as packages/<name>. Raise the version to update.
// A local checkout can stand in for a fetch: ln -s ~/dev/uniscript packages/uniscript

// 1.0.0 ships data/entities.idx, the compiled entity index uniscript.wasp reads; its .wasp entity sources are never compiled by warp
uniscript: {repository: "https://github.com/pannous/uniscript.git", version: 1.0.0}
