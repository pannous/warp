#!/usr/bin/env warp
# warp's language server (card language-server): the Language Server Protocol over standard input and output, for an
# editor's LSP client (Sublime's LSP package, VS Code). Each file is parsed by the compiler's own parser, `parse`,
# whose nodes know the line and column they were written at. Go to definition and hover find a name's definition in
# the open file, then in the files of its folder, then in the modules it `use`s, where the compiler finds them.
use c
use json
use path
use url
read(file: i32, buffer: handle, count: i64): i64 from 'c'

STANDARD_INPUT = 0
CHUNK_BYTES = 65536
LENGTH_HEADER = "Content-Length: "
HEADER_END = "\r\n\r\n"
FILE_SCHEME = "file://"
WARP_EXTENSION = ".warp"
# what the server answers: the whole text of a file at each change (textDocumentSync 1)
CAPABILITIES = {"textDocumentSync": 1, "definitionProvider": yes, "hoverProvider": yes}
# the operators of a definition, `sq(a) := a * a`, `x = 1`, `count: 3`, and the words before a defined name,
# `def f(x) {…}`, `global g = 2`, `enum E {…}`
DEFINING_OPERATORS = [":=", "=", ":"]
DEFINING_WORDS = ["def", "fn", "fun", "function", "global", "class", "struct", "enum", "trait", "type", "interface"]
NAME_PUNCTUATION = "_·"
BLOCK = "{"
STATEMENT_SEPARATORS = ["\n", ";"]

global input = calloc(1, CHUNK_BYTES)
# the open files' texts by their uri
global documents = {}

# count bytes of standard input; its end ends the server
input_bytes(count: int): text := {
	got = ""
	while byte_size(got) < count {
		read_now = read(STANDARD_INPUT, input, min(count - byte_size(got), CHUNK_BYTES))
		if read_now <= 0 { exit(0) }
		got += field_bytes(input, 0, read_now)
	}
	got
}
# the next message: its header's lines up to a blank one, then as many bytes as its Content-Length says
next_message(): map := {
	header = ""
	while not header.ends_with(HEADER_END) { header += input_bytes(1) }
	length = lines(header).filter(line => line.starts_with(LENGTH_HEADER)).map(line => int(line[#LENGTH_HEADER ..].trim))
	parse_json(input_bytes(length#1))
}
# a message out; print's line break ends the body, which JSON allows, so it is counted in
sent(message: map) := {
	body = message.json
	print LENGTH_HEADER + text(byte_size(body) + 1) + HEADER_END + body
}

answer(message: map): any := {
	method = message["method"]
	parameters = message.get("params") ?? {}
	if method == "initialize" { return {"capabilities": CAPABILITIES, "serverInfo": {"name": "warp"}} }
	if method == "textDocument/didOpen" { documents[parameters["textDocument"]["uri"]] = parameters["textDocument"]["text"] }
	if method == "textDocument/didChange" { documents[parameters["textDocument"]["uri"]] = parameters["contentChanges"].last["text"] }
	if method == "textDocument/didClose" { documents.remove(parameters["textDocument"]["uri"]) }
	if method == "textDocument/definition" { return found(parameters, location_of) }
	if method == "textDocument/hover" { return found(parameters, hover_of) }
	if method == "exit" { exit(0) }
	ø
}

# the definition of the name at the place `parameters` names, as `shown` gives it; ø when there is none
found(parameters: map, shown: function): any := {
	uri = parameters["textDocument"]["uri"]
	place = parameters["position"]
	name = name_at(document_text(uri), place["line"] + 1, place["character"] + 1)
	if not name { return ø }
	for file in searched(uri) {
		definition = definitions(document_text(file)).find(d => d#1 == name)
		if definition { return shown(file, definition) }
	}
	ø
}
location_of(uri: text, definition: list): map := {
	start = {"line": definition#2 - 1, "character": definition#3 - 1}
	{"uri": uri, "range": {"start": start, "end": {"line": start["line"], "character": start["character"] + #definition#1}}}
}
hover_of(uri: text, definition: list): map := {"contents": {"kind": "markdown", "value": "```warp\n" + lines(document_text(uri))#(definition#2).trim + "\n```"}}

# the name written around a column of a line, counted from 1
name_at(source: text, line: int, column: int): text := {
	rows = lines(source)
	if line > #rows { return "" }
	characters = [c for c in rows#line]
	first = column
	while first > 1 and is_name_character(characters#(first - 1)) { first -= 1 }
	last = column - 1
	while last < #characters and is_name_character(characters#(last + 1)) { last += 1 }
	characters[first - 1 ..< last].join("")
}
is_name_character(c: text): bool := is_alphanumeric(c) or c in NAME_PUNCTUATION

# a text's statements: a parse of several is their list, of one that statement; a text that does not parse has none
statements_of(source: text): list := {
	code = try parse(source) else []
	if type(code) is list and code.separator in STATEMENT_SEPARATORS then [statement for statement in code] else [code]
}
# the definitions of a text: each top-level statement's [name, line, column], its name the first word of its head,
# its place the innermost one on the way there (a call's place is its group's, `square(x)`)
definitions(source: text): list := {
	paths = statements_of(source).map(statement => [statement] + defined_path(statement)).filter(path => #path > 1 and path.last is symbol and path.any(is_placed))
	paths.map(path => {
		placed = path.filter(is_placed).last
		[path.last.name, line_of(placed), column_of(placed)]
	})
}
is_placed(n: any): bool := line_of(n) != ø
# the nodes from a definition down to its name; a head before a block defines it, `def f(x) {…}`, a call before
# anything else does not, `print twice(3)`
defined_path(statement: any): list := {
	if type(statement) is key and statement.op in DEFINING_OPERATORS { return named_path(head_path(statement#1), statement#2) }
	if type(statement) is list and #statement == 2 and statement#2.bracket == BLOCK { return named_path(head_path(statement#1), statement#2) }
	[]
}
# a defining word is followed by the name: `global g = 2`, `def f(x) {…}`
named_path(path: list, rest: any): list := if path.last is symbol and path.last.name in DEFINING_WORDS then head_path(rest) else path
# a key's first part is its left side, `(square x)` of `square(x) := …`, a list's its first item
head_path(n: any): list := if (type(n) is key or type(n) is list) and #n > 0 then [n] + head_path(n#1) else [n]

# the files a name of `uri` is looked for in: the file, the other files of its folder, then the modules it uses
searched(uri: text): list := {
	folder = dirname(path_of(uri))
	neighbours = list_files(folder).filter(name => name.ends_with(WARP_EXTENSION)).map(name => uri_of(path_join(folder, name)))
	[uri] + neighbours.filter(file => file != uri) + used_modules(document_text(uri), folder)
}
used_modules(source: text, folder: text): list := {
	uses = statements_of(source).filter(statement => type(statement) is list and #statement > 1 and statement#1 == data use)
	names = uses.flat_map(statement => [part.name for part in statement[1 ..] if part is symbol])
	names.map(name => module_path(name, folder)).filter(path => path != ø).map(uri_of)
}
# where the compiler finds `use name`: beside the file, else in lib/
module_path(name: text, folder: text): text? := [path_join(folder, name + WARP_EXTENSION), path_join(library_folder(), name + WARP_EXTENSION)].find(exists)
library_folder(): text := run_option("lib") ?? path_join(dirname(program_folder()), "lib")

# an open file's text as the editor has it, else as it is on disk
document_text(uri: text): text := documents.get(uri) ?? (try read(path_of(uri)) else "")
path_of(uri: text): text := url_decode(if uri.starts_with(FILE_SCHEME) then uri[#FILE_SCHEME ..] else uri)
uri_of(path: text): text := FILE_SCHEME + path.split("/").map(url_encode).join("/")

while yes {
	message = next_message()
	result = answer(message)
	if "id" in message and "method" in message { sent({"jsonrpc": "2.0", "id": message["id"], "result": result}) }
}
