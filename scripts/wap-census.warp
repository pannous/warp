# The road to self-build, measured (notes/wap.md "Road to self-build"): the compiler's own stages (wap/core/pipeline.wap)
# run on one wap source file, statement by statement where a stage allows, every refusal printed as: stage <tab> message.
#   for f in $(git ls-files "wap/*.wap"); do echo "== $f"; warp scripts/wap-census.warp $f; done
use "../wap/core/pipeline.wap"
use "../wap/core/emit/emitter.wap"

preload = language_loaded(program.folder + "/../wap")
library_scope = declarations_of(preload).map(library_word)

report(stage: text, message: text) := print "${stage}\t" + message.replace("\n", " ")

# the names the modules a file uses define, as the compiler binds them
used_scope(file: text) as list := {
	try {
		modules = declared_modules(file)
		return used_declarations(modules#(#modules), modules).map(library_word)
	} catch e { report("declare", e.message) }
	[]
}

probe(file: text) := {
	statements = []
	try statements = top_level_statements(read_notation(file)).filter(statement => not is_use(operated_program(statement))) catch e { report("read", e.message) }
	used = used_scope(file)
	lowered_ok = []
	for statement in statements {
		try { lowered_ok = lowered_ok + [lowered(declared_code(statement))] } catch e { report("lower", e.message) }
	}
	scope = defined_in(lowered_ok, library_scope, PROGRAM_DEPTH) + used + library_scope
	bound_ok = []
	for statement in lowered_ok {
		try { bound_ok = bound_ok + [bound(statement, scope, PROGRAM_DEPTH)] } catch e { report("bind", e.message) }
	}
	# typing and emitting run on the whole file, as the compiler runs them: the first refusal stops them
	typed = no
	emitted_ok = no
	try {
		code = typed_file(file, preload)
		typed = yes
		emitted(code)
		emitted_ok = yes
	} catch e { report(if typed then "emit" else "type", e.message) }
	print "ok\t${#statements} statements, ${#lowered_ok} lowered, ${#bound_ok} bound, typed: ${typed}, emitted: ${emitted_ok}"
}
probe(args#1)
