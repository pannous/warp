# The road to self-build, measured (notes/wap.md "Road to self-build"): the compiler's own stages (wap/core/pipeline.wap)
# run on wap source files, statement by statement where a stage allows, every refusal printed as: stage <tab> message;
# a total line at the end (test/wap/ratchet_census.sh). The counts come from two paths: "functions typed" from one
# typing state shared by the whole run, each module's forms typed once, a refusal rolled back; "typed whole" from the
# compiler's own typed_file path, once for each closure; a closure holding a smaller one that refuses is refused with it.
#   warp --no-window scripts/wap-census.warp $(git ls-files "wap/*.wap")
# every module whose names the census reads, each used by name: a module sees the names of the modules it uses
use "../wap/kernel/forms.wap"
use "../wap/core/stage.wap"
use "../wap/core/type_notation.wap"
use "../wap/core/language.wap"
use "../wap/core/pipeline.wap"
use "../wap/core/parse/lexemes.wap"
use "../wap/core/parse/operators.wap"
use "../wap/core/rules/lines.wap"
use "../wap/core/rules/lowering.wap"
use "../wap/core/rules/stages.wap"
use "../wap/core/rules/typed.wap"
use "../wap/core/analyze/calls.wap"
use "../wap/core/analyze/declarations.wap"
use "../wap/core/analyze/letters.wap"
use "../wap/core/analyze/modules.wap"
use "../wap/core/analyze/names.wap"
use "../wap/core/analyze/scope.wap"
use "../wap/core/analyze/types.wap"
use "../wap/core/analyze/variables.wap"
use "../wap/core/emit/emitter.wap"

# the folder of the preload, as the census is given its files and as their places spell them
PRELOAD_FOLDER = "wap/preload/"
language = base_language()
preload = language_loaded(language, program.folder + "/../wap")
library_scope = scope_of(preload_scope(declarations_of(preload)))
library_code = library_code_of(language, preload)
library = statements_in(library_code)
# the names every file given and the modules it uses define, known before any is read, as the compiler does
# (core/pipeline.wap program_words_defined)
for file in args { program_words_defined(language, file) }

# Each module read, declared and prepared once a run, shared by every file and function probe that uses it: a file's
# modules are the same values whichever file reaches them, as the compiler makes them (core/pipeline.wap
# declared_modules, prepared, typed_file)
class Shared { operated: map<text, Node> = {}, declared: map<text, Node> = {}, prepared: map<text, list<Node>> = {} }
shared = Shared()
operated_once(file: text) as Node := {
	global shared
	if not shared.operated.has(file) { shared.operated[file] = operated_file(language, file) }
	shared.operated[file]
}
declared_once(module: Node) as Node := {
	global shared
	key = file_of(module) ?? ""
	if not shared.declared.has(key) { shared.declared[key] = declared_operated(language, module) }
	shared.declared[key]
}
# the files of modules, and the functions among statements as the typing stage holds them
files_of(modules: list<Module>) as list<text> := modules.map(module => module.file)
functions_in(statements: list) as list<Function> := statements.filter(statement => statement is Define).map(function_of)
# a file with the modules it uses, theirs first, as declared_modules gives them
modules_of(file: text) as list<Module> := {
	code = operated_once(file)
	(modules_used(code, operated_once) + [code]).map(declared_once).map(module_declared)
}
prepared_once(module: Module, modules: list<Module>) as list := {
	global shared
	key = module.file
	if not shared.prepared.has(key) { shared.prepared[key] = statements_in(prepared(language, module, modules, preload)) }
	shared.prepared[key]
}
# One typing state for the run, as the compiler types a program: the library's definitions and records, then each
# module's joined once, its top-level values typed, then its functions typed alone, so a form is typed once and its
# callees' types are there for the next. The modules of a closure join before any of their statements is typed, as the
# compiler knows every record and definition before it types: modules that use each other (emit/lists.wap and
# emitter.wap) see each other's records whichever comes first. A refusal leaves the state as it was before the form,
# so it changes how no other form types; a top-level statement's refusal is kept with its module. A module that cannot
# be bound whole joins with the statements that bind alone, so a refusal hides only its statement (probe reports it
# with the file).
class Run { state: TypingState, frame: TypeFrame, joined: map<text, list> = {}, refusals: map<text, list<text>> = {}, probed: map<text, Probed> = {} }
run = Run(typing_state(library), TypeFrame())
typing_joined(modules: list<Module>) := {
	global run
	keys = files_of(modules)
	joining = keys.filter(key => not run.joined.has(key))
	for module in modules.filter(module => module.file in joining) {
		key = module.file
		run.refusals[key] = []
		statements = []
		try statements = prepared_once(module, modules) catch e { statements = bound_alone(module, modules) }
		run.joined[key] = statements
		run.state.definitions += functions_in(statements)
		run.state.records = added_records(run.state.records, statements)
	}
	for key in joining {
		for statement in run.joined[key].filter(statement => not (statement is Define) and not (statement is Record)) {
			before = copied(run.state)
			try typed_form(statement, run.state, run.frame, ø) catch e {
				run.state = rolled_back(before)
				run.refusals[key] += ["type\ta top-level statement: " + e.message]
			}
		}
	}
}
# a module's statements bound one by one, as probe binds a file's (which reports their refusals)
bound_alone(module: Module, modules: list<Module>) as list := {
	words = scope_around(library_around(module.code, preload), codes_of(modules_of_uses(module, modules)))
	statements = statements_in(lowered_program(language, module.code))
	bound_each(statements, within(words, defined_in(statements, words, PROGRAM_DEPTH)), no)
}
# statements bound one by one in a scope, those that bind kept; each refusal reported where it is `shown`
bound_each(statements: list, scope: Scope, shown: bool) as list := {
	kept = []
	for statement in statements {
		try kept = kept + [bound(statement, scope, PROGRAM_DEPTH)] catch e { if shown { report("bind", e.message) } }
	}
	kept
}
# a module's refusals so far, typed in the run's state
refusals_of(key: text) as list<text> := if run.refusals.has(key) then run.refusals[key] else []

# How a file's program fared typed and emitted whole: the first refusal stops both, as in the compiler
class Outcome { typed: bool = no, emitted: bool = no, refusal: text = "", file: text = "", modules: int = 0, ms: int = 0 }
whole_typed(file: text) as Outcome := {
	outcome = Outcome()
	try {
		code = typed_whole(file)
		outcome.typed = yes
		emitted(code)
		outcome.emitted = yes
	} catch e { outcome.refusal = e.message }
	outcome
}
# A file typed whole as the compiler types it; the files of one closure, a cycle of modules that use each other, make
# one program, typed once a run. A smaller closure inside it that refuses refuses it too, its refused form being
# part of it (assumed: the bigger program's other definitions could add an overload that the refused call takes), so
# the big closures are not typed again once a closure they hold refuses.
closures: map<text, Outcome> = {}
# each refused function's name, taken before a rollback drops the function value it may name
refused_names: map<text, text> = {}
whole_once(file: text) as Outcome := {
	global closures
	keys = files_of(modules_of(file))
	key = keys.sorted().join(" ")
	if closures.has(key) { return closures[key] }
	for inner in keys {
		held = files_of(modules_of(inner))
		if #held < #keys and held.all(each => each in keys) {
			refused = whole_once(inner)
			if not refused.typed {
				closures[key] = Outcome(no, no, "as ${inner}, which it holds: " + refused.refusal)
				return closures[key]
			}
		}
	}
	started = wall_clock_ms()
	closures[key] = whole_typed(file)
	closures[key].file = file
	closures[key].modules = #keys
	closures[key].ms = wall_clock_ms() - started
	closures[key]
}
# the file typed whole with the modules it uses, as typed_file types it
typed_whole(file: text) as Block := {
	modules = modules_of(file)
	whole = Block(modules.flat_map(module => prepared_once(module, modules)))
	typed_by_rules(language, typed_shown(whole, library_code), declarations_of(preload), library_code)
}

report(stage: text, message: text) := {
	global front_refused
	if stage in FRONT_STAGES { front_refused += 1 }
	print "${stage}\t" + (message + use_missing(message)).replace("\n", " ")
}
# Wap's own source stays something wap reads: a spelling the front cannot read or lower, or a name it cannot bind (a
# missing use), fails the census, so the source never drifts ahead of the compiler that has to read it; typing's
# refusals are the road still ahead
FRONT_STAGES = ["read", "lower", "declare", "bind"]
front_refused = 0
# A name nothing in scope defines, though a module the census read declares it: a missing `use`, which old warp's
# transitive use hides from the suite; the refusal names the module (the name is what the refusal ends with)
NOTHING_DEFINES = "nothing defines this name"
use_missing(message: text) as text := {
	if not message.contains(NOTHING_DEFINES) { return "" }
	file = defining_file(message.split(": ").last)
	if file == "" then "" else "; it is defined in ${file}, which this file does not use"
}
defining_file(name: text) as text := {
	for key in shared.declared.keys {
		if declarations_of(shared.declared[key]).any(declaration => declaration_word(declaration) == name) { return key }
	}
	""
}
declaration_word(declaration: Node) as text := match declaration {
	Key(name, op, signature) => text(name)
	Record(name, fields, variants) => text(name)
	_ => ""
}

# the names the modules a file uses define, as the compiler binds them
used_scope(file: text) as list<Definition> := {
	try {
		modules = modules_of(file)
		return modules_scope(codes_of(modules_of_uses(modules#(#modules), modules)))
	} catch e { report("declare", e.message) }
	[]
}

# a file's lines, and a line's statements: a rule's line stays whole, as rules_loaded reads `rule P => A; B` with B in
# its template (core/rules/stages.wap sequence_rule)
lines_of(code: Node) as list := match code { List(items, Bracket.None, Separator.Newline) => items; _ => [code] }
statements_of_line(line: Node) as list := {
	operated = operated_program(language, line)
	if sequence_rule(operated) != operated then [line] else top_level_statements(line)
}
# a `use` or an `include` line: it brings in another file, no code of its own
brings_a_file(statement: Node) as bool := [USE_WORD, INCLUDE_WORD].any(word => phrase_text(statement, word) != ø)
probe(file: text) as Tally := {
	statements = []
	try statements = lines_of(read_notation(file)).flat_map(statements_of_line).filter(statement => not brings_a_file(operated_program(language, statement))) catch e { report("read", e.message) }
	used = used_scope(file)
	lowered_ok = []
	for statement in statements {
		try { lowered_ok = lowered_ok + statements_in(lowered_program(language, declared_code(language, statement))) } catch e { report("lower", e.message) }
	}
	bound_ok = bound_each(lowered_ok, within(within(library_scope, used), defined_in(lowered_ok, library_scope, PROGRAM_DEPTH)), yes)
	# typing: each function alone in the run's state (functions_probe), then the whole file as the compiler types it
	# and emits it when no module of its closure refuses a form (whole_once); a preload file is no program of its own
	# but every program's library, typed function by function
	counted = functions_probe(file)
	outcome = if in_preload(file) then Outcome() else whole_once(file)
	if outcome.refusal != "" { report(if outcome.typed then "emit" else "type", outcome.refusal) }
	whole = if in_preload(file) then "typed: as every program's library, by function" else "typed: ${outcome.typed}, emitted: ${outcome.emitted}"
	print "ok\t${#statements} statements, ${#lowered_ok} lowered, ${#bound_ok} bound, " + whole
	for line in counted.lines { print line }
	print "functions\ttyped ${counted.typed} of ${counted.functions} functions (${counted.by_calls} typed by their calls), ${counted.anys} places typed any"
	Tally(1, if outcome.typed then 1 else 0, counted.functions, counted.typed, counted.anys)
}

# whether a file is one of the preload's, the library every program is compiled with
in_preload(file: text) as bool := file.starts_with(PRELOAD_FOLDER)
# the files probed, those typed whole, the functions found, those typed alone, and the places in them typed any
class Tally { files: int = 0, whole: int = 0, functions: int = 0, typed: int = 0, anys: int = 0 }
added(a: Tally, b: Tally) as Tally := Tally(a.files + b.files, a.whole + b.whole, a.functions + b.functions, a.typed + b.typed, a.anys + b.anys)

# The compiler's own source stays fully typed (any is for programs): the places of typed code whose type holds any
anys_in(n: Node) as int := (if holds_any(fact_of(n, TYPE)) then 1 else 0) + parts_of(n).map(anys_in).sum()
holds_any(type: Node?) as bool := type == symbol(ANY_TYPE) or (type_parts(type) ?? []).any(holds_any)
parts_of(n: Node) as list := match n { Key(left, op, right) => [left, right]; List(items, bracket, separator) => items; _ => [] }

# Each function of a module whose parameters are typed, typed alone, as the compiler types it in its block
# (core/analyze/types.wap block_typed), in the run's state, so a refusal names its function and hides no other; a
# function of letters or untyped parameters is typed by its calls. What it finds is printed with the module's file.
class Probed { functions: int = 0, typed: int = 0, by_calls: int = 0, anys: int = 0, lines: list<text> = [] }
module_probed(key: text, own: list<Function>) as Probed := {
	global run
	if run.probed.has(key) { return run.probed[key] }
	p = Probed()
	p.lines = refusals_of(key).map(refusal => refusal.replace("\n", " "))
	for held in own {
		name = held.name
		if not all_typed(held, run.state.records) { p.by_calls += 1 } else {
			p.functions += 1
			before = copied(run.state)
			try {
				typed = function_typed(held, held.parameters, run.state, held.definer)
				# counted before the unknowns left open default to any: typed alone, a global's empty `{}` is settled by
				# the other functions that fill it, as the whole program types it
				found = anys_in(typed.define)
				all_settled(run.state)
				p.typed += 1
				if found > 0 { p.lines += ["any\t${name}: ${found} places typed any"] }
				p.anys += found
			} catch e {
				run.state = rolled_back(before)
				p.lines += ["type\t${name}: " + e.message.replace("\n", " ")]
			}
		}
	}
	run.probed[key] = p
	p
}
# A file's functions probed, with those of every module of its closure, which decide whether it is typed whole; a
# preload file's functions are the library's, in the run's state from its start: none has a second copy
functions_probe(file: text) as Probed := {
	modules = []
	try modules = modules_of(file) catch e { report("declare", e.message); return Probed() }
	if in_preload(file) { return module_probed(file, functions_in(library).filter(function => function.module == file)) }
	typing_joined(modules)
	for module in modules {
		key = module.file
		module_probed(key, functions_in(run.joined[key]))
	}
	run.probed[modules.last.file]
}
# a typing state that knows the library's definitions and records
typing_state(library: list) as TypingState := {
	s = TypingState()
	s.definitions = functions_in(library)
	s.records = added_records(Records(), library)
	s
}
# The state rolled back to one taken before a refused form: its lists are the prefixes they were, so their indexes,
# shared with the state that refused, forget the places past them
# a refused function named as its callers' refusals name it (core/analyze/calls.wap called_name), a function value
# found among the state's lambdas
named_in(refusal: Refusal, s: TypingState) as text := {
	lambda = s.lambdas.filter(each => function_key_of(each) == refusal.key)
	definition = definition_keyed(refusal.key, s) ?? (if lambda is empty then ø else function_of(lambda#1))
	if definition == ø then refusal.key else called_name(definition)
}
rolled_back(before: TypingState) as TypingState := {
	global refused_names
	# what was refused stays known: a function refused once is refused to every caller after it, as the typing says
	for refusal in run.state.refusals.filter(each => not refused_names.has(each.key)) { refused_names[refusal.key] = named_in(refusal, run.state) }
	before.refusals = run.state.refusals
	truncated(before.definition_names, #before.definitions)
	truncated(before.definition_keys, #before.definitions)
	truncated(before.records.names, #before.records.items)
	before
}
truncated(index: NameIndex, count: int) := {
	if index.count > count {
		for name in index.places.keys { index.places[name] = index.places[name].filter(place => place < count) }
		index.count = count
	}
}
# a typing state that starts where another stands, its lists its own: what one function's typing adds stays its own
copied(base: TypingState) as TypingState := {
	s = TypingState()
	s.definitions = base.definitions + []
	s.definition_names = base.definition_names
	s.definition_keys = base.definition_keys
	s.records = base.records
	s.functions = base.functions + []
	for key in base.instances.keys { s.instances[key] = base.instances[key] + [] }
	s.globals = base.globals + []
	s.lambdas = base.lambdas + []
	s.captured = base.captured + []
	s.unknowns = base.unknowns
	s.settled = base.settled + []
	s.deferred = base.deferred + []
	s.unset = base.unset + []
	s.dispatchers = base.dispatchers + []
	s.refusals = base.refusals + []
	s
}

total = Tally()
for file in args {
	print "== ${file}"
	total = added(total, probe(file))
}
# The refusals that block the most functions, most first: a root, a refusal of a function's own, with the functions
# refused for calling it, directly or through one another ("this calls …, which wap refuses", core/analyze/calls.wap)
CALLS_REFUSED = ", which wap refuses"
CALLS = "this calls "
class Family { root: Refusal, name: text, size: int = 1 }
refused_name(refusal: Refusal) as text := if refused_names.has(refusal.key) then refused_names[refusal.key] else named_in(refusal, run.state)
called_refused(refusal: Refusal) as text := if refusal.message.contains(CALLS_REFUSED) then refusal.message.split(CALLS).last.split(CALLS_REFUSED)#1 else ""
family_of(root: Refusal, refusals: list) as Family := {
	family = Family(root, refused_name(root))
	blocked = [family.name]
	grown = yes
	while grown {
		callers = refusals.filter(each => called_refused(each) in blocked and not (refused_name(each) in blocked))
		blocked = blocked + callers.map(refused_name).unique
		grown = callers is not empty
	}
	family.size = #blocked
	family
}
families = run.state.refusals.filter(each => called_refused(each) == "").map(root => family_of(root, run.state.refusals)).sorted(by: family => -family.size)
# who unblocks a family: the owner of its root's file, by the longest path of the Owners table (notes/wap.md "Owners")
# that the file starts with; a root no row names says so, for warp-lead to give it one
OWNERS_TABLE = "/../notes/wap.md"
OWNERS_COLUMN = " | "
NO_OWNER = "no owner in notes/wap.md"
class Owned { path: text, owner: text }
owned_in(row: text) as list<Owned> := {
	cells = row.split(OWNERS_COLUMN)
	if #cells != 3 { return [] }
	cells#3.split("; ")#1.replace(" |", "").split(", ").map(path => Owned("wap/" + path, cells#2))
}
owners_table: text = read(program.folder + OWNERS_TABLE)
owned = owners_table.split("\n").filter(line => line.starts_with("| ")).flat_map(owned_in)
owner_of(file: text) as text := {
	rows = owned.filter(each => file.starts_with(each.path)).sorted(by: each => -#each.path)
	if rows is empty then NO_OWNER else rows#1.owner
}
# the file a family's root is refused in, as its refusal names it first (core/errors.wap place_of)
root_file(family: Family) as text := family.root.message.split(" line ")#1
# each closure typed and emitted whole, the slowest first: where a faster compiler pays most
for whole in closures.values.filter(each => each.file != "").sorted(by: each => -each.ms) {
	print "closure\t${whole.ms} ms\t${whole.file} and the ${whole.modules - 1} modules it reaches, typed: ${whole.typed}"
}
for family in families { print "family\t${family.size} blocked by ${family.name}\t${owner_of(root_file(family))}\t" + family.root.message.replace("\n", " ") }
print "total\t${total.whole} of ${total.files} files typed whole, ${total.typed} of ${total.functions} functions typed, ${total.anys} places typed any"
if front_refused > 0 {
	print "front\t${front_refused} refusals of reading, lowering or binding wap's own source"
	raise "wap cannot compile what it is written in: ${front_refused} refusals of reading, lowering or binding its own source"
}
