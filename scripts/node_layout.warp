# warp scripts/node_layout.warp > lib/native/warp_layout.h: the value layout as C defines, for lib/native/warp_node.h,
# read from where the compiler keeps it: the kinds (core/analysis/kinds.warp), the GC types' fields
# (core/emitter/emitter.warp gc_names) and an instance's (core/emitter/instances.warp instance_fields).
# scripts/wasmtime-c-api.sh checks the committed header against it
kinds_file = "core/analysis/kinds.warp"

# a top-level assignment's value, its continuation lines (indented) joined
def assigned(file: text, name: text) {
	prefix = name + " = "
	lines = split(read(file), "\n")
	for i in 0..<#lines {
		if starts_with(lines[i], prefix) {
			value = lines[i][#prefix..]
			j = i + 1
			while j < #lines and starts_with(lines[j], "\t") { value = value + lines[j]; j += 1 }
			return parse(value)
		}
	}
	throw "no " + name + " in " + file
}
def defined(name: text, value: int) { print "#define WARP_" + upper(name) + " " + value }
def table_defined(group: text, table) { for entry in table { defined(group + "_" + entry.key, entry.value) } }
def fields_defined(type: text, fields: list) { for i in 0..<#fields { defined(type + "_" + fields[i], i) } }

print "// generated by scripts/node_layout.warp from the compiler's value layout: do not edit"
print "#pragma once"
defined("kind_mask", assigned(kinds_file, "kind_mask"))
table_defined("kind", assigned(kinds_file, "Kind"))
table_defined("marked", assigned(kinds_file, "Marked"))
table_defined("bracket", assigned(kinds_file, "BracketCode"))
defined("info_unit", assigned(kinds_file, "KindUnit").Info)
for type in assigned("core/emitter/emitter.warp", "gc_names") { fields_defined(type#1, type#2) }
instance = assigned("core/emitter/instances.warp", "instance_fields")
fields_defined("instance", instance)
defined("instance_declared", #instance)
