# The size of wap, measured as the nodes wap's own reader makes of each file (notes/wap.md "Size"), Meta excluded:
# comments, blank lines, line breaks and the length of names count nothing, so only a real simplification makes it
# smaller. Prints each file, the total, the count per stage folder and the TOP_COUNT largest top-level statements.
#   warp --no-window scripts/wap-size.warp $(git ls-files "wap/*.wap")
use "../wap/core/parse/reader.wap"

TOP_COUNT := 20

# the nodes of a notation: every node counts one, a Meta node only its node
size_of(n: Node) as int := match n {
	List(items, bracket, separator) => 1 + items.map(size_of).sum()
	Key(left, op, right) => 1 + size_of(left) + size_of(right)
	Error(node) => 1 + size_of(node)
	Type(name, body) => 1 + size_of(name) + size_of(body)
	Meta(node, data) => size_of(node)
	_ => 1
}

# a file's top-level statements: the items of its lines, or the one statement it is
statements_of(code: Node) as list := match code {
	List(items, Bracket.None, Separator.Newline) => items
	Empty => []
	Meta(node, data) => statements_of(node)
	_ => [code]
}

# the name a statement defines or starts with: its first word
first_word(n: Node) as text := match n {
	List(items, bracket, separator) => if #items > 0 then first_word(items#1) else "·"
	Key(left, op, right) => first_word(left)
	Symbol(name) => name
	Meta(node, data) => first_word(node)
	_ => "·"
}

# the stage folder of a file: its folder under wap/
folder_of(file: text) as text := {
	parts = file.split("/")
	if #parts > 2 then parts.slice(1, #parts - 1).join("/") else "."
}

class Measured { name: text, folder: text, nodes: int }

measured = []
for file in args {
	statements = statements_of(notation(read(file), file))
	for statement in statements { measured = measured + [Measured(file + " " + first_word(statement), folder_of(file), size_of(statement))] }
	print "${file}\t" + text(statements.map(size_of).sum())
}
print "total\t" + text(measured.map(m => m.nodes).sum())
for folder in measured.map(m => m.folder).unique() {
	print "folder ${folder}\t" + text(measured.filter(m => m.folder == folder).map(m => m.nodes).sum())
}
for m in measured.sorted_by_key(m => 0 - m.nodes).slice(0, TOP_COUNT) { print "top ${m.name}\t" + text(m.nodes) }
