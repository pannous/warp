// The standard library module i18n (card web-i18n, notes/i18n.md): `use i18n`. Translations are data, one map per
// language; a message is a text with {name} holes, or a map of plural categories (Unicode CLDR: zero one two few many
// other) chosen by the value `count`:
//   messages = { en: { cart: { one: "{count} item", other: "{count} items" } }, de: { cart: { one: "{count} Artikel", other: "{count} Artikel" } } }
//   translate(messages, "de", "cart", { count: 3 }) → "3 Artikel"
// A language the messages lack, or a message one language lacks, comes from the first language (de-AT reads de first).

translate(messages: any, language: text, key: text, values: any): text := {
	let message = i18n_message(messages, language, key)
	var chosen = message
	if not (message is text) { chosen = i18n_plural_form(message, plural_category(language, values["count"])) }
	i18n_filled(chosen, values)
}

// The message of a key: in the language, its base language (de for de-AT), else the first language
i18n_message(messages: any, language: text, key: text): any := {
	let base = split(language, "-")[0]
	for candidate in [language, base, keys(messages)#1] {
		if contains(keys(messages), candidate) {
			let translations = messages[candidate]
			if contains(keys(translations), key) { return translations[key] }
		}
	}
	throw "no translation of " + key
}

// A plural message's form for the category, else its form other
i18n_plural_form(forms: any, category: text): any := {
	if contains(keys(forms), category) { return forms[category] }
	forms["other"]
}

// The text with each {name} replaced by the value named name
i18n_filled(message: text, values: any): text := {
	var out = message
	for name in keys(values) { out = replace(out, "{" + name + "}", "" + values[name]) }
	out
}

// The CLDR plural category of a whole number in a language: "one", "few", "other", …
plural_category(language: text, n: int): text := {
	let base = split(language, "-")[0]
	let last = n % 10
	let last_two = n % 100
	let teen = last_two >= 12 and last_two <= 14
	if contains(["ja", "zh", "ko", "th", "vi", "id", "ms"], base) { return "other" }
	if contains(["fr", "hi"], base) { return if n <= 1 then "one" else "other" }
	if contains(["ru", "uk", "be"], base) {
		if last == 1 and last_two != 11 { return "one" }
		if last >= 2 and last <= 4 and not teen { return "few" }
		return "many"
	}
	if base == "pl" {
		if n == 1 { return "one" }
		if last >= 2 and last <= 4 and not teen { return "few" }
		return "many"
	}
	if contains(["cs", "sk"], base) {
		if n == 1 { return "one" }
		return if n >= 2 and n <= 4 then "few" else "other"
	}
	if base == "ar" {
		if n <= 2 { return ["zero", "one", "two"]#(n + 1) }
		if last_two >= 3 and last_two <= 10 { return "few" }
		return if last_two >= 11 then "many" else "other"
	}
	if n == 1 then "one" else "other"
}

// --- transliteration (card print-in-script, wiki/in.md): a text's Latin letters written in another script, letter
// for letter, by a table; every other character kept. `cyrillic("Peter")` is "Петер", and `print name in cyrillic`
// prints it so (`to print string in cyrillic: map string's chars to cyrillic`). The table reads English spellings the
// Russian way, the longest Latin spelling first ("shch" before "sh" before "s").

// Latin spellings and their Cyrillic letters, longest first
CYRILLIC_LETTERS = [["shch", "щ"], ["sch", "щ"], ["zh", "ж"], ["kh", "х"], ["ts", "ц"], ["ch", "ч"], ["sh", "ш"], ["yu", "ю"], ["ya", "я"], ["yo", "ё"], ["a", "а"], ["b", "б"], ["c", "к"], ["d", "д"], ["e", "е"], ["f", "ф"], ["g", "г"], ["h", "х"], ["i", "и"], ["j", "дж"], ["k", "к"], ["l", "л"], ["m", "м"], ["n", "н"], ["o", "о"], ["p", "п"], ["q", "к"], ["r", "р"], ["s", "с"], ["t", "т"], ["u", "у"], ["v", "в"], ["w", "в"], ["x", "кс"], ["y", "ы"], ["z", "з"]]

// the text in Cyrillic letters: each Latin spelling its letter, a capital's spelling capitalized ("Sh" → "Ш")
cyrillic(t: text): text := transliterated(t, CYRILLIC_LETTERS)

// the text with each spelling of the table, matched case-blind, replaced by its letter, upper case after a capital
transliterated(t: text, table: list): text := {
	out = ""
	at = 0
	n = count(t)
	while at < n {
		matched = table.filter(pair => at + count(pair#1) <= n and lower(t[at .. at + count(pair#1)]) == pair#1)
		step = if count(matched) == 0 then 1 else count(matched#1#1)
		out = out + (if count(matched) == 0 then t[at .. at + 1] else capitalized_like(matched#1#2, t[at .. at + 1]))
		at += step
	}
	out
}

// the letter in upper case when the character it stands for is a capital
capitalized_like(letter: text, character: text): text := if upper(character) == character and lower(character) != character then upper(letter[0 .. 1]) + letter[1 .. count(letter)] else letter

// `name in cyrillic` is the name written so, `print name in cyrillic` prints it (no list is called cyrillic)
rewrite ($x in cyrillic) => cyrillic($x)
