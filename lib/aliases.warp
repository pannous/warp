# The aliases of warp (card alias-mechanism, notes/aliases.md, wiki/alias.md): one entry per canonical word, the
# form format and print show, with the other spellings that mean the same.
#   operator: the infix operator the word names; prefix-operator: its prefix operator. Every operator has its English
#   name (decision operators-named), the word a class defines it by, `less_or_equal(o) := …` (operator-english-names);
#   an entry named by an operator is that operator
#   symbol: the operation, an Op of core/node.warp
#   aliases: the other spellings, a symbol one spells the operator, a word one the word
#   infix: yes when the word and its word aliases are written between operands too (`7 mod 2`), but
#   name a block written right after them (`div {…}` is the html tag)
#   declared: yes when only a declaration gives the operator its meaning, `infix operator ↑(a, b) := …`
#   power: [left, right], how tightly the operator binds its operands (card parser-rows): the higher binds first,
#   right below left groups to the right (`2^3^2` is 2^(3^2)); an operator without one binds as `=` does, [60, 59]
# Keywords, operator words and constants are quoted: written bare, the parser reads them already.
# A library keeps the aliases of its own words (lib/math.warp: sin and sine, log₂ …).
# The data format's own `.`, `?.`, `::` and `:` bind as parser.warp STRUCTURE_POWERS says: reading this table needs them.

# arithmetic
add { operator: "+", symbol: Op.Add, aliases: [plus], infix: [plus], power: [140, 141] } # todo rename power to precedence, explain why TWO via interviewer (card aliases-rename-precedence)
subtract { operator: "-", symbol: Op.Sub, aliases: [minus, "‐", "‑", "‒", "–", "—", "―"], infix: [minus], power: [140, 141] }
multiply { operator: "*", symbol: Op.Mul, aliases: [times, "×", "⋅"], power: [150, 151] }
divide { operator: "/", symbol: Op.Div, power: [150, 151] }
div { operator: "/!", symbol: Op.FloorDiv, aliases: ["÷"], infix: yes, power: [150, 151] }
modulo { operator: "%", symbol: Op.Mod, aliases: [mod], infix: yes, power: [150, 151] }
remainder { operator: "rem", power: [150, 151] }
power { operator: "^", symbol: Op.Pow, aliases: ["**"], power: [160, 159] }
# the operators only a declaration gives meaning (lib/prelude.warp `infix operator ↑`), bound as tight as ^
arrow_up { operator: "↑", declared: yes, power: [160, 159] }
arrow_down { operator: "↓", declared: yes, power: [160, 159] }
dot { operator: "·", declared: yes, power: [160, 159] }
dot_dot { operator: "··", declared: yes, power: [160, 159] }
count { prefix-operator: "#", symbol: Op.Hash, aliases: [size, len, length] }
# a class's position(p) is `b#p` and its index(i), `b[i]`, the parser's b#(i+1) (extensions/class_methods.warp)
position { operator: "#", symbol: Op.Hash, power: [170, 182] }
shift_left { operator: "<<", power: [135, 136] }
shift_right { operator: ">>", power: [135, 136] }

# comparison and logic
equal { operator: "==", symbol: Op.Eq, aliases: [equals, Equals], infix: [equals, Equals], power: [115, 116] }
compare { aliases: [compareTo, compare_to] }
# a class's less(o) and greater(o) are its `<` and `>` (extensions/class_methods)
less { operator: "<", power: [120, 121] }
greater { operator: ">", power: [120, 121] }
less_or_equal { operator: "<=", symbol: Op.Le, aliases: ["≤"], power: [120, 121] }
greater_or_equal { operator: ">=", symbol: Op.Ge, aliases: ["≥"], power: [120, 121] }
not_equal { operator: "!=", symbol: Op.Ne, aliases: ["≠"], power: [115, 116] }
"is" { power: [115, 116] }
identical { operator: "===", power: [115, 116] }
not_identical { operator: "!==", power: [115, 116] }
approximately { operator: "≈", power: [115, 116] }
similar { operator: "~", declared: yes, aliases: ["~~", circa], power: [115, 116] }
"and" { symbol: Op.And, aliases: ["&&", "&"], power: [100, 101] }
"xor" { symbol: Op.Xor, aliases: ["^^"], power: [95, 96] }
"or" { symbol: Op.Or, aliases: ["||", "|"], power: [90, 91] }
# the effect constraint `f(x) := x*x ! Pure`: a free `!` takes the whole statement before it
"not" { symbol: Op.Not, aliases: ["!", "¬"], power: [0, 105] }
contains { aliases: [has, includes] }
# `x default y` and its quiet spellings otherwise, failing, except are extensions/sugar/defaults.warp's rules
default { operator: "??", power: [93, 92] }

# how a value shows, another language's method names for it (a class's text() method, extensions/class_methods.warp)
text { aliases: [toString, to_s, __str__] }

# ranges, pipes, conversion and arrows
"to" { symbol: Op.To, aliases: ["...", "..=", "…", through], infix: [through], power: [130, 131] }
upto { operator: "..", symbol: Op.Range, aliases: ["..<"], infix: yes, power: [130, 131] }
pipe { operator: "|>", power: [127, 128] }
"as" { power: [125, 250] }
maps_to { operator: "->", symbol: Op.Arrow, aliases: ["=>"], power: [70, 69] }
# a rule's or a match arm's `=>` takes less after it than a lambda's `->`
rule { operator: "=>", power: [70, 58] }

# conditionals: the ternary `c ? a : b`, `a ?: b`, `if c then a else b`, `while c do …`
# `?` with its `:` is one operator, the whole `if c then a else b` written in symbols
conditional { operator: "?", power: [85, 79] }
or_else { operator: "?:", power: [85, 86] }
"then" { power: [77, 76] }
"else" { power: [75, 74] }
"do" { power: [77, 10] }

# keywords and constants
"else if" { aliases: [elif, elsif, elseif] }
"yes" { aliases: ["true"] }
"no" { aliases: ["false"] }
"ø" { aliases: ["null", "nul", "none", "nil", "nill", "nix", "nada", "nothing", "void"] }
warning { aliases: [warn] }
