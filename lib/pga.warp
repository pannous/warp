// The standard library module pga (card geometric-algebra): `use pga`, Clifford algebras of any metric and the
// projective geometric algebras of the plane and of space built on them. A Multivector holds the squares of its basis
// vectors (metric, e0 first) and one coefficient per basis blade (parts), the blade of index m being the product of
// the basis vectors whose bits m sets, in ascending order: in 2D PGA, metric [0, 1, 1], parts#4 is e01 (m = 3).
// + - and * (the geometric product) and == are the class's operator methods and take a Multivector or a plain number
// on the right; the other products are words: wedge (outer, ∧, a meet in PGA), regressive (∨, a join in PGA),
// inner (the symmetric inner product), contract (the left contraction).
// The PGA words are one verb with overloads: point, line, plane, join, meet, reflect (a method: the mirror reflects
// a point), rotor, translator, motor, apply (a rotor or motor on a point), coordinates, arrow, ray, span, collection.
// The glyphs ⋏ ⋎ ↦ ↣ ⟇ ⊔ spell meet, join, arrow, ray, span and collection as infix operators (card pga-glyphs). ∧, ∨ and → already
// mean and, or and maps-to in lib/math.warp, so they are not these operators. English aliases of those words: intersect,
// intersection and crossing for meet; connect for join; segment and path for an arrow from a to b anchored at a;
// halfline for a ray from a through b; subspace for span; assembly for collection. The pga2_ and pga3_ names stay as they
// were.
// Conventions those of bivector.net: the plane's point (x, y) is x·e20 + y·e01 + e12, its line a·x + b·y + c = 0 is
// a·e1 + b·e2 + c·e0; space's point is e123 + x·e032 + y·e013 + z·e021, its plane a·e1 + b·e2 + c·e3 + d·e0.
// The dual is the right complement, e_m ∧ mv_dual(e_m) = I (the pseudoscalar), which needs no metric and so works in the
// degenerate PGA metrics; mv_undual undoes it.
use math

class Multivector {
	metric: list
	parts: list
	plus(o: any) as Multivector := mv_combined(this, o, 1.0)
	minus(o: any) as Multivector := mv_combined(this, o, -1.0)
	times(o: any) as Multivector := mv_product(this, as_multivector(o, metric), 0)
	equals(o: any) as bool := (o is Multivector or o is number) and parts == as_multivector(o, metric).parts
	text() as text := multivector_text(this)
	// the PGA verbs, also called as meet(a, b) and apply(r, x); reflect stays a method so it does not take math.reflect
	meet(o: any) as Multivector := wedge(this, o)
	join(o: Multivector) as Multivector := regressive(this, o)
	reflect(x: Multivector) as Multivector := sandwich(this, x)
	apply(x: Multivector) as Multivector := sandwich(this, x)
}

// the bit words blades are made of
blade_and(a: int, b: int) as int := wasm i64.and
blade_xor(a: int, b: int) as int := wasm i64.xor
// the grade of the blade of index m: how many basis vectors it is the product of
blade_grade(m: int) as int := wasm i64.popcnt

// the zero of the algebra of that metric
mv_zero(metric: list) as Multivector := Multivector(metric, [0.0 for m in 1 to 1 << count(metric)])
// coefficient times the blade of index m
blade(metric: list, m: int, coefficient: number) as Multivector := {
	if m < 0 or m >= 1 << count(metric) { raise "pga: no blade " + text(m) + " in an algebra of " + text(count(metric)) + " basis vectors" }
	parts = [0.0 for i in 1 to 1 << count(metric)]
	parts[m] = coefficient * 1.0
	Multivector(metric, parts)
}
// the basis vector e_i (e0 is the first)
basis(metric: list, i: int) as Multivector := blade(metric, 1 << i, 1)
// the pseudoscalar, the product of all basis vectors
pseudoscalar(metric: list) as Multivector := blade(metric, (1 << count(metric)) - 1, 1)
// a Multivector, or a plain number as the scalar of the algebra of that metric
as_multivector(x: any, metric: list) as Multivector := if x is Multivector then x else blade(metric, 0, x)

mv_combined(a: Multivector, o: any, sign: float) as Multivector := {
	b = as_multivector(o, a.metric)
	if count(b.parts) != count(a.parts) { raise "pga: multivectors of different algebras" }
	Multivector(a.metric, [a.parts#i + sign * b.parts#i for i in 1 to count(a.parts)])
}

// the sign e_a·e_b takes to become e_(a xor b): -1 for each swap that orders the basis vectors, times the square of
// each one both share
blade_sign(a: int, b: int, metric: list) as float := {
	swaps = 0
	s = a >> 1
	while s != 0 {
		swaps += blade_grade(blade_and(s, b))
		s = s >> 1
	}
	sign = if swaps % 2 == 0 then 1.0 else -1.0
	shared = blade_and(a, b)
	for i in 0..count(metric) {
		if blade_and(shared, 1 << i) != 0 { sign = sign * metric#(i + 1) }
	}
	sign
}

// whether e_a·e_b adds to the product of that kind: 0 the geometric product, 1 the outer (no shared vector), 2 the left
// contraction (a within b), 3 the symmetric inner product (one within the other)
blade_kept(a: int, b: int, kind: int) as bool := {
	shared = blade_and(a, b)
	if kind == 0 then yes else if kind == 1 then shared == 0 else if kind == 2 then shared == a else shared == a or shared == b
}

mv_product(a: Multivector, b: Multivector, kind: int) as Multivector := {
	n = count(a.parts)
	if count(b.parts) != n { raise "pga: multivectors of different algebras" }
	out = [0.0 for m in 1 to n]
	for i in 0..n {
		x = a.parts#(i + 1)
		if x != 0 {
			for j in 0..n {
				y = b.parts#(j + 1)
				if y != 0 and blade_kept(i, j, kind) {
					k = blade_xor(i, j)
					out[k] = out#(k + 1) + x * y * blade_sign(i, j, a.metric)
				}
			}
		}
	}
	Multivector(a.metric, out)
}

// the products other than the geometric one (a * b)
wedge(a: Multivector, b: any) as Multivector := mv_product(a, as_multivector(b, a.metric), 1)
contract(a: Multivector, b: any) as Multivector := mv_product(a, as_multivector(b, a.metric), 2)
inner(a: Multivector, b: any) as Multivector := mv_product(a, as_multivector(b, a.metric), 3)

// the reverse: each blade's vectors in the opposite order, the sign (-1)^(k(k-1)/2) of grade k
mv_reverse(a: Multivector) as Multivector := Multivector(a.metric, [if (blade_grade(m) * (blade_grade(m) - 1) / 2) % 2 == 0 then a.parts#(m + 1) else -a.parts#(m + 1) for m in 0..count(a.parts)])
// the part of grade k
mv_grade(a: Multivector, k: int) as Multivector := Multivector(a.metric, [if blade_grade(m) == k then a.parts#(m + 1) else 0.0 for m in 0..count(a.parts)])
// the scalar part
mv_scalar(a: Multivector) as float := a.parts#1
// the right complement: e_m becomes ±e_(not m) with e_m ∧ mv_dual(e_m) = I
mv_dual(a: Multivector) as Multivector := {
	full = count(a.parts) - 1
	out = [0.0 for m in 0..count(a.parts)]
	for m in 0..count(a.parts) { out[full - m] = a.parts#(m + 1) * blade_sign(m, full - m, []) }
	Multivector(a.metric, out)
}
// the inverse of mv_dual: mv_undual(mv_dual(a)) == a
mv_undual(a: Multivector) as Multivector := {
	full = count(a.parts) - 1
	out = [0.0 for m in 0..count(a.parts)]
	for c in 0..count(a.parts) { out[full - c] = a.parts#(c + 1) * blade_sign(full - c, c, []) }
	Multivector(a.metric, out)
}
// the regressive product a ∨ b, the dual of the outer product of the duals: in PGA the join of points
regressive(a: Multivector, b: Multivector) as Multivector := mv_undual(wedge(mv_dual(a), mv_dual(b)))
// the norm, √|⟨a·ã⟩₀|
mv_norm(a: Multivector) as float := sqrt(abs(mv_scalar(a * mv_reverse(a))))
// a divided by its norm; a null multivector is refused
mv_normalized(a: Multivector) as Multivector := {
	n = mv_norm(a)
	if n == 0 { raise "pga: a null multivector has no direction to keep" }
	Multivector(a.metric, [x / n for x in a.parts])
}
// x transformed by the versor r: r·x·r̃ (a rotor rotates, a motor moves)
sandwich(r: Multivector, x: Multivector) as Multivector := r * x * mv_reverse(r)

// The projective geometric algebra of the plane, R(2,0,1): e0² = 0, e1² = e2² = 1
PGA2 = [0, 1, 1]
pga2_point(x: number, y: number) as Multivector := blade(PGA2, 5, -x) + blade(PGA2, 3, y) + blade(PGA2, 6, 1)
// the line a·x + b·y + c = 0
pga2_line(a: number, b: number, c: number) as Multivector := blade(PGA2, 2, a) + blade(PGA2, 4, b) + blade(PGA2, 1, c)
// an ideal point (a direction, weight 0) has no Euclidean coordinates
pga_refuse_ideal(w: number) := if w == 0 { raise "pga: an ideal point (a direction) has no coordinates" }
// a point's [x, y]; an ideal point (a direction, e12 part 0) is refused
pga2_coordinates(p: Multivector) as list := {
	w = p.parts#7
	pga_refuse_ideal(w)
	[-p.parts#6 / w, p.parts#4 / w]
}
// the rotor turning by angle radians counter-clockwise around the point (x, y): sandwich(rotor, p)
pga2_rotor(angle: number, x: number, y: number) as Multivector := pga2_point(x, y) * -sin(angle / 2) + cos(angle / 2)
// the translator moving by (dx, dy): sandwich(translator, p)
pga2_translator(dx: number, dy: number) as Multivector := blade(PGA2, 0, 1) + blade(PGA2, 3, -dx / 2) + blade(PGA2, 5, -dy / 2)

// The projective geometric algebra of space, R(3,0,1): e0² = 0, e1² = e2² = e3² = 1
PGA3 = [0, 1, 1, 1]
pga3_point(x: number, y: number, z: number) as Multivector := blade(PGA3, 14, 1) + blade(PGA3, 13, -x) + blade(PGA3, 11, y) + blade(PGA3, 7, -z)
// the plane a·x + b·y + c·z + d = 0
pga3_plane(a: number, b: number, c: number, d: number) as Multivector := blade(PGA3, 2, a) + blade(PGA3, 4, b) + blade(PGA3, 8, c) + blade(PGA3, 1, d)
// a point's [x, y, z]; an ideal point is refused
pga3_coordinates(p: Multivector) as list := {
	w = p.parts#15
	pga_refuse_ideal(w)
	[-p.parts#14 / w, p.parts#12 / w, -p.parts#8 / w]
}
// space's basis blades by their bivector.net names (blade m with a sign where the name orders its vectors otherwise)
e0 = blade(PGA3, 1, 1)
e1 = blade(PGA3, 2, 1)
e2 = blade(PGA3, 4, 1)
e3 = blade(PGA3, 8, 1)
e01 = blade(PGA3, 3, 1)
e02 = blade(PGA3, 5, 1)
e03 = blade(PGA3, 9, 1)
e12 = blade(PGA3, 6, 1)
e31 = blade(PGA3, 10, -1)
e23 = blade(PGA3, 12, 1)
e021 = blade(PGA3, 7, -1)
e013 = blade(PGA3, 11, 1)
e032 = blade(PGA3, 13, -1)
e123 = blade(PGA3, 14, 1)
e0123 = blade(PGA3, 15, 1)
// the same blades named by what they are: the directions (ideal points), so that
// point(x, y, z) == origin + x·ẋ + y·ẏ + z·ż; the origin; the pseudoscalar
// TODO (card standard-module) x̅ y̅ z̅ for the planes e1 e2 e3, x⃑ y⃑ z⃑ for the ideal lines e01 e02 e03, x⃗ y⃗ z⃗ for the axes
// e23 e31 e12, once a standard module's names may carry combining marks (z with one: card value-variable)
ẋ = e032
ẏ = e013
ż = e021
origin = e123
I = e0123

// one verb each, overloads of the plane and of space (the pga2_ and pga3_ words above)
point(x: number, y: number) as Multivector := pga2_point(x, y)
point(x: number, y: number, z: number) as Multivector := pga3_point(x, y, z)
// the line a·x + b·y + c = 0 in the plane; a line in space is the join of two points or the meet of two planes
line(a: number, b: number, c: number) as Multivector := pga2_line(a, b, c)
plane(a: number, b: number, c: number, d: number) as Multivector := pga3_plane(a, b, c, d)
coordinates(p: Multivector) as list := if count(p.metric) == 3 then pga2_coordinates(p) else pga3_coordinates(p)
meet(a: Multivector, b: any) as Multivector := wedge(a, b)
join(a: Multivector, b: Multivector) as Multivector := regressive(a, b)
// an arrow from a to b, anchored at a (wiki/algebra.md: point ↦ point)
arrow(from a: Multivector, to b: Multivector) := [a, b - a]
// a ray from a through b: a line with one source (wiki/algebra.md)
ray(from a: Multivector, through b: Multivector) := [a, join(a, b)]
// the span of two different objects (wiki/algebra.md: a ⟇ b)
span(a: Multivector, b: Multivector) := [a, b]
// an assembly of two objects, not their sum or product (wiki/algebra.md)
collection(a, b) := [a, b]
// the glyphs of those words; ⋏ binds tighter than ⋎ as meet does than join
infix operator ⋏(a: Multivector, b: any) := meet(a, b)
infix operator ⋎(a: Multivector, b: Multivector) := join(a, b)
infix operator ↦(a: Multivector, b: Multivector) := arrow(a, b)
infix operator ↣(a: Multivector, b: Multivector) := ray(a, b)
infix operator ⟇(a: Multivector, b: Multivector) := span(a, b)
infix operator ⊔(a, b) := collection(a, b)
// English aliases of those words (card pga-glyphs). intersect, segment, halfline, subspace and assembly
// are aliases of the canonical words; intersection, crossing, connect and path are typed overloads so they
// do not take over list intersection or the everyday words connect and path. Both parameters are Multivector:
// a second parameter typed any made intersection([1, 2], [2, 3]) ambiguous with use list.
alias intersect => meet
intersection(a: Multivector, b: Multivector) as Multivector := meet(a, b)
crossing(a: Multivector, b: Multivector) as Multivector := meet(a, b)
infix operator intersect(a: Multivector, b: Multivector) := meet(a, b)
connect(a: Multivector, b: Multivector) as Multivector := join(a, b)
infix operator connect(a: Multivector, b: Multivector) := join(a, b)
alias segment => arrow
path(from a: Multivector, to b: Multivector) := arrow(a, b)
alias halfline => ray
alias subspace => span
alias assembly => collection
operator ⋏ has precedence above ⋎
apply(versor: Multivector, x: Multivector) as Multivector := sandwich(versor, x)
// a rotor around the point (x, y) in the plane, around the line axis in space, or around the direction (x, y, z)
// through the origin: sandwich(rotor, p) or rotor.apply(p)
rotor(angle: number, x: number, y: number) as Multivector := pga2_rotor(angle, x, y)
rotor(angle: number, axis: Multivector) as Multivector := mv_normalized(axis) * -sin(angle / 2) + cos(angle / 2)
rotor(angle: number, x: number, y: number, z: number) as Multivector := rotor(angle, join(point(0, 0, 0), point(x, y, z)))
translator(dx: number, dy: number) as Multivector := pga2_translator(dx, dy)
translator(dx: number, dy: number, dz: number) as Multivector := blade(PGA3, 0, 1) + blade(PGA3, 3, -dx / 2) + blade(PGA3, 5, -dy / 2) + blade(PGA3, 9, -dz / 2)
// a motor: the translator after the rotor, applied as sandwich(motor, p) or motor.apply(p)
motor(r: Multivector, t: Multivector) as Multivector := t * r

// the name of the blade of index m: e, then the indices of its vectors, e013; the scalar's is empty
blade_name(m: int) as text := {
	if m == 0 { return "" }
	name = "e"
	i = 0
	while m >> i != 0 {
		if blade_and(m >> i, 1) == 1 { name = name + text(i) }
		i += 1
	}
	name
}
mv_part_text(x: float) as text := if x == floor(x) and abs(x) < 1000000000000000 then text(int(x)) else text(x)
// "1 + 2e1 - e12": the nonzero parts by blade index, a coefficient of ±1 left out before a blade; "0" for zero
multivector_text(a: Multivector) as text := {
	out = ""
	for m in 0..count(a.parts) {
		x = a.parts#(m + 1)
		if x != 0 {
			size = if x < 0 then -x else x
			digits = if m > 0 and size == 1 then "" else mv_part_text(size)
			out = if out == "" then (if x < 0 then "-" else "") + digits + blade_name(m) else out + (if x < 0 then " - " else " + ") + digits + blade_name(m)
		}
	}
	if out == "" then "0" else out
}
