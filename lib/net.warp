// The standard library module net (notes/stdlib.md section 7): `use net`, or a program naming the global fetch. post
// sends a text through the adapter std_io and gives the answer's text (a synchronous request in the browser;
// the native warp has no net.post yet, card net-get-curl)
use json
public post(url: any, body: any) := std_io("net", "post", [url, body])
// post(url, body, {"x-api-key": key}): the map's pairs are the request's headers; an answer of status >= 400 is the
// error, with the answer's text
public post(url: any, body: any, headers: any) := std_io("net", "post", [url, body, headers])
// fetch(url): what a GET of the url answers (the page answers it with a request, the native warp by curl): a JSON
// array or object as warp data (lists, maps), any other answer its text (notes/web_framework.md "Async data"); no
// declared result, so a failed request's error comes through as itself
global fetch(url: text) := fetched_value(std_io("net", "get", [url]))
// fetch(url, {"User-Agent": "me", "Accept": "application/json"}): the map's pairs are the request's headers
global fetch(url: text, headers: map) := fetched_value(std_io("net", "get", [url, "text", header_lines(headers)]))
header_lines(headers: map) as list := [key + ": " + text(headers.get(key)) for key in keys(headers)]
fetched_value(answer) := if answer is text and is_json_shaped(answer) then json(answer) else answer
is_json_shaped(answer: text) as bool := trim(answer).starts_with("[") or trim(answer).starts_with("{")
// `users := fetch url` at the main level (extensions/fetch_signals.warp): the answer given to reply at once, a failure
// as the Error it is, which reply keeps apart from the value
global fetch_into(url: text, reply: function) := reply(fetch(url))

