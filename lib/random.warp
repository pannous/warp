// The standard library module random (notes/stdlib.md): `use random`, over the host words random and random_below
// The host word random needs no `use`: `random` is a float from 0 up to 1, `random(6)` a whole number 0…5, `random(1, 6)` a die roll 1…6 (both ends included; fractions give a float from a up to b), `random int`, `random bool`, `random codepoint`, `random float`

choice(xs: any): any := xs#(random_below(count(xs)) + 1)
shuffle(xs: list): list := { out = xs; i = count(out); while i > 1 { j = random_below(i) + 1; t = out#i; out#i = out#j; out#j = t; i = i - 1 }; out }
sample(xs: list, k: any): list := { mixed = shuffle(xs); out = []; for i in 1 to min(k, count(mixed)) { out = out + [mixed#i] }; out }
// the same numbers after the same seed: seed(42); [random_below(100), random()]
seed(n: any): any := random_seed(n)
