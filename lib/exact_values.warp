// `e as exact`, `exact e`, `precise e` (decision exact-sums): a value kept exact, a whole number, a fraction, an exact
// real or a sum of them, as it is; a float has none. A module of its own, lending its rules (core/passes/rewrites.warp
// std_module_names) without linking lib/reals' classes apart from the program's; `exact x = 1/3` declares x, as
// `x: exact = 1/3` does
exact_value(x: any) := if x is float then raise "a float has no exact value: write it exact, 0.1 or 1/3, not 0.1 * 1.0" else x
rewrite $x as exact => exact_value($x)
rewrite $x as precise => exact_value($x)
rewrite exact $x => exact_value($x) where $x is not assignment
rewrite precise $x => exact_value($x) where $x is not assignment
