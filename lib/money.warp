// The standard library module money: `use money`, exact amounts of an ISO 4217 currency, never floats. A Money is
// whole minor units (cents) and a currency code: money_of(12.34, "EUR") is Money(1234, "EUR"), its text "EUR 12.34";
// `+` and `-` refuse two currencies, `*` takes an int or an exact fraction (0.1 and 1/3 are fractions in warp, a
// float is refused), rounding half to even; money_times(m, k, mode) picks the mode. A rounding mode is the text
// "half_even" (banker's), "half_up" (ties away from zero), "down" (toward zero) or "up" (away from zero).
// money_allocate(m, ratios) and money_split(m, n) share an amount by largest remainders, the parts always summing back
// (100 cents by [1, 1, 1] are 34, 33, 33). money_parse("€1.234,56") and money_parse("$1,234.56") read amounts,
// money_format(m, "en") is "€1,234.56" and money_format(m, "de") "1.234,56 €". No exchange rates.
// Amounts are 64-bit ints inside: a sum or product past ±2^63 raises instead of wrapping

use math

// ISO 4217: code, minor units, the symbol written (the code itself where English uses no other)
MONEY_CURRENCIES = [["AED", 2, "AED"], ["ARS", 2, "ARS"], ["AUD", 2, "A$"], ["BGN", 2, "BGN"], ["BHD", 3, "BHD"], ["BRL", 2, "R$"], ["CAD", 2, "CA$"], ["CHF", 2, "CHF"], ["CLF", 4, "CLF"], ["CLP", 0, "CLP"], ["CNY", 2, "CN¥"], ["COP", 2, "COP"], ["CZK", 2, "CZK"], ["DKK", 2, "DKK"], ["EGP", 2, "EGP"], ["EUR", 2, "€"], ["GBP", 2, "£"], ["HKD", 2, "HK$"], ["HUF", 2, "HUF"], ["IDR", 2, "IDR"], ["ILS", 2, "₪"], ["INR", 2, "₹"], ["IQD", 3, "IQD"], ["ISK", 0, "ISK"], ["JOD", 3, "JOD"], ["JPY", 0, "¥"], ["KRW", 0, "₩"], ["KWD", 3, "KWD"], ["LYD", 3, "LYD"], ["MXN", 2, "MX$"], ["MYR", 2, "MYR"], ["NGN", 2, "NGN"], ["NOK", 2, "NOK"], ["NZD", 2, "NZ$"], ["OMR", 3, "OMR"], ["PHP", 2, "PHP"], ["PKR", 2, "PKR"], ["PLN", 2, "PLN"], ["RON", 2, "RON"], ["RUB", 2, "RUB"], ["SAR", 2, "SAR"], ["SEK", 2, "SEK"], ["SGD", 2, "SGD"], ["THB", 2, "THB"], ["TND", 3, "TND"], ["TRY", 2, "TRY"], ["TWD", 2, "NT$"], ["UAH", 2, "UAH"], ["USD", 2, "$"], ["UYI", 0, "UYI"], ["UYW", 4, "UYW"], ["VND", 0, "₫"], ["XAF", 0, "FCFA"], ["XOF", 0, "F CFA"], ["ZAR", 2, "ZAR"]]
MONEY_LIMIT = 4611686018427387904

def currency_info(code: text): list {
	for c in MONEY_CURRENCIES { if c[0] == upper(code) { return c } }
	raise "money: " + code + " is no ISO 4217 currency of lib/money.warp"
}
currency_minor_units(code: text): int := currency_info(code)[1]
currency_symbol(code: text): text := currency_info(code)[2]
money_ten(n: int): int := { p = 1; for i in 0 ..< n { p = p * 10 }; p }

// --- exact int arithmetic that refuses to wrap
def money_sum(a: int, b: int): int {
	r = a + b
	if (a > 0 and b > 0 and r < 0) or (a < 0 and b < 0 and r >= 0) or r >= MONEY_LIMIT or r <= -MONEY_LIMIT { raise "money: " + str(a) + " + " + str(b) + " minor units is too large" }
	r
}
def money_product(a: int, b: int): int {
	r = a * b
	if a != 0 and (r /! a != b or r >= MONEY_LIMIT or r <= -MONEY_LIMIT) { raise "money: " + str(a) + " × " + str(b) + " minor units is too large" }
	r
}
// n / d (d > 0) as an int by a rounding mode
def money_divide(n: int, d: int, mode: text): int {
	if d <= 0 { raise "money: divide by " + str(d) }
	if not (mode in ["half_even", "half_up", "down", "up"]) { raise "money: the rounding mode is half_even, half_up, down or up, not " + mode }
	q = n /! d
	r = n - q * d
	if r == 0 { return q }
	if mode == "down" { return if n < 0 then q + 1 else q }
	if mode == "up" { return if n > 0 then q + 1 else q }
	twice = 2 * r
	if mode == "half_up" { return if twice > d or (twice == d and n > 0) then q + 1 else q }
	if mode == "half_even" { return if twice > d or (twice == d and q % 2 != 0) then q + 1 else q }
	raise "money: the rounding mode is half_even, half_up, down or up, not " + mode
}
// a number as [numerator, denominator]: an int or a fraction; a float raises, it is not exact
def money_ratio(x: any): list {
	kind = type(x).name
	if kind != "rational" and kind != "float" and x is int { return [x, 1] }
	if kind == "rational" { return [x.numerator, x.denominator] }
	raise "money: " + str(x) + " is a " + kind + ", not an exact number: write it as an int or a fraction (0.1, 1/3)"
}

class Money {
	minor: int
	currency: text
	plus(o: any): Money := Money(money_sum(minor, money_same(currency, o, "+").minor), currency)
	minus(o: any): Money := Money(money_sum(minor, -money_same(currency, o, "-").minor), currency)
	times(k: any): Money := money_times(Money(minor, currency), k, "half_even")
	equals(o: any): bool := o is Money and o.minor == minor and o.currency == currency
	compare(o: any): int := minor - money_same(currency, o, "compared with").minor
	text(): text := currency + " " + money_decimal(minor, currency_minor_units(currency), ".", "")
}
def money_same(currency: text, o: any, operation: text) {
	if not (o is Money) { raise "money: " + operation + " needs two Money amounts, not " + str(o) }
	if o.currency != currency { raise "money: " + currency + " " + operation + " " + o.currency + " mixes currencies; convert one first" }
	o
}
public money_add(a: any, b: any) := a + b
public money_sub(a: any, b: any) := a - b
money_negate(m: any) := Money(-m.minor, m.currency)
// m times an int or a fraction, rounded to minor units by the mode
def money_times(m: any, k: any, mode: text) {
	r = money_ratio(k)
	Money(money_divide(money_product(m.minor, r[0]), r[1], mode), m.currency)
}
money_mul(m: any, k: any) := money_times(m, k, "half_even")

// an amount in major units, an int, a fraction or a decimal text ("12.34"), exact: one finer than the currency's
// minor unit raises unless a rounding mode is given
def money_of(amount: any, code: text, mode: text) {
	minor = currency_minor_units(code)
	r = if amount is text then money_text_ratio(amount) else money_ratio(amount)
	Money(money_divide(money_product(r[0], money_ten(minor)), r[1], mode), upper(code))
}
def money_of(amount: any, code: text) {
	minor = currency_minor_units(code)
	r = if amount is text then money_text_ratio(amount) else money_ratio(amount)
	scaled = money_product(r[0], money_ten(minor))
	if scaled % r[1] != 0 { raise "money: " + str(amount) + " is finer than " + upper(code) + "'s " + str(minor) + " decimals; pass a rounding mode" }
	Money(scaled /! r[1], upper(code))
}
// "-12.345" as [-12345, 1000]
def money_text_ratio(t: text): list {
	s = trim(t)
	negative = s.starts_with("-")
	if negative or s.starts_with("+") { s = s[1 ..< count(s)] }
	parts = split(s, ".")
	if count(parts) > 2 or not is_digits(parts[0] + (if count(parts) == 2 then parts[1] else "")) or parts[0] + (if count(parts) == 2 then parts[1] else "") == "" { raise "money: " + t + " is no decimal amount" }
	fraction = if count(parts) == 2 then parts[1] else ""
	n = int("0" + parts[0] + fraction)
	[if negative then -n else n, money_ten(count(fraction))]
}
// m rounded to `places` decimals of its major unit (0 for whole euros), still in minor units
def money_round(m: any, places: int, mode: text) {
	drop = currency_minor_units(m.currency) - places
	if drop <= 0 { return m }
	step = money_ten(drop)
	Money(money_product(money_divide(m.minor, step, mode), step), m.currency)
}

// --- sharing
// the parts of m in proportion to ratios (ints or fractions, none negative), by largest remainders: the floor of each
// share, then the cents left one each to the largest remainders, the earlier first on a tie
def money_allocate(m: any, ratios: list): list {
	if count(ratios) == 0 { raise "money: allocate needs at least one ratio" }
	pairs = [money_ratio(r) for r in ratios]
	common = 1
	for p in pairs { if p[0] < 0 { raise "money: a negative ratio " + str(p[0]) + "/" + str(p[1]) }; common = money_product(common, p[1] /! gcd(common, p[1])) }
	weights = [money_product(p[0], common /! p[1]) for p in pairs]
	total = 0
	for w in weights { total = money_sum(total, w) }
	if total == 0 { raise "money: the ratios sum to 0" }
	sign = if m.minor < 0 then -1 else 1
	amount = m.minor * sign
	shares = []
	rests = []
	given = 0
	for w in weights {
		exact = money_product(amount, w)
		shares.add(exact /! total)
		rests.add(exact % total)
		given = given + exact /! total
	}
	left = amount - given
	while left > 0 {
		best = 0
		for i in 1 ..< count(rests) { if rests[i] > rests[best] { best = i } }
		shares[best] = shares[best] + 1
		rests[best] = -1
		left = left - 1
	}
	[Money(s * sign, m.currency) for s in shares]
}
money_split(m: any, n: int): list := money_allocate(m, [1 for i in 0 ..< n])

// --- text
// minor units as a decimal: digits grouped by threes with `group`, the fraction after `point`
def money_decimal(minor: int, places: int, point: text, group: text): text {
	n = if minor < 0 then -minor else minor
	step = money_ten(places)
	whole = str(n /! step)
	fraction = str(n % step)
	while count(fraction) < places { fraction = "0" + fraction }
	grouped = ""
	for i in 0 ..< count(whole) {
		if i > 0 and (count(whole) - i) % 3 == 0 { grouped = grouped + group }
		grouped = grouped + whole[i]
	}
	(if minor < 0 then "-" else "") + grouped + (if places > 0 then point + fraction else "")
}
// a symbol of letters only (BHD, FCFA) is written apart from the number, $ and CA$ before it
def money_word_symbol(symbol: text): bool {
	for c in symbol { if not (c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ ") { return no } }
	yes
}
// "en": €1,234.56, -€1,234.56, BHD 1,234.567; "de": 1.234,56 €, -1.234,56 €
def money_format(m: any, style: text): text {
	places = currency_minor_units(m.currency)
	symbol = currency_symbol(m.currency)
	sign = if m.minor < 0 then "-" else ""
	if style == "en" {
		number = money_decimal(if m.minor < 0 then -m.minor else m.minor, places, ".", ",")
		return sign + (if money_word_symbol(symbol) then symbol + " " else symbol) + number
	}
	if style == "de" { return money_decimal(m.minor, places, ",", ".") + " " + symbol }
	raise "money_format: the style is en or de, not " + style
}
money_format(m: any): text := money_format(m, "en")

// the currency an amount text names, longest symbol or code first: [code, the text without it]
def money_currency_in(t: text): list {
	best = ""
	code = ""
	for c in MONEY_CURRENCIES {
		for written in [c[2], c[0]] { if count(written) > count(best) and t.index_of(written) > 0 { best = written; code = c[0] } }
	}
	if code == "" { return ["", t] }
	[code, replace(t, best, "")]
}
// "€1.234,56", "$1,234.56", "1.234,56 €", "-¥1,235", "(BHD 1,234.567)": the style (decimal point) read from the
// separators when not given: both . and , the last is the point; one of them twice or more a grouping; once followed
// by exactly three digits a grouping unless the currency has three decimals. Options: {style: "en" or "de",
// currency: "EUR"} for a text naming none
def money_parse(t: text, options: map): any {
	found = money_currency_in(t)
	code = if found[0] != "" then found[0] else (if "currency" in options then upper(options["currency"]) else raise "money_parse: " + t + " names no currency; pass {currency: …}")
	places = currency_minor_units(code)
	s = trim(replace(replace(replace(found[1], " ", ""), " ", ""), " ", ""))
	negative = no
	if s.starts_with("(") and s.ends_with(")") { negative = yes; s = s[1 ..< count(s) - 1] }
	if s.starts_with("-") or s.starts_with("−") { negative = yes; s = s[1 ..< count(s)] }
	if s.ends_with("-") { negative = yes; s = s[0 ..< count(s) - 1] }
	s = trim(s)
	style = if "style" in options then options["style"] else money_style_of(s, places)
	point = if style == "de" then "," else if style == "en" then "." else raise "money_parse: the style is en or de, not " + str(style)
	grouping = if point == "," then "." else ","
	digits = replace(replace(s, grouping, ""), "'", "")
	parts = split(digits, point)
	if count(parts) > 2 or digits == "" or not is_digits(replace(digits, point, "")) { raise "money_parse: " + t + " is no amount" }
	fraction = if count(parts) == 2 then parts[1] else ""
	if count(fraction) > places { raise "money_parse: " + t + " has " + str(count(fraction)) + " decimals, " + code + " has " + str(places) }
	while count(fraction) < places { fraction = fraction + "0" }
	n = money_product(int("0" + parts[0]), money_ten(places)) + int("0" + fraction)
	Money(if negative then -n else n, code)
}
money_parse(t: text): any := money_parse(t, {"style_auto": yes})
def money_style_of(s: text, places: int): text {
	dot = 0
	comma = 0
	last_mark = ""
	tail = 0
	for c in s {
		if c == "." or c == "," { if c == "." { dot = dot + 1 } else { comma = comma + 1 }; last_mark = c; tail = 0 } else { tail = tail + 1 }
	}
	if dot > 0 and comma > 0 { return if last_mark == "," then "de" else "en" }
	if dot + comma == 0 { return "en" }
	if dot + comma > 1 { return if dot > 0 then "de" else "en" }
	if tail == 3 and places != 3 { return if dot > 0 then "de" else "en" }
	if dot > 0 then "en" else "de"
}
