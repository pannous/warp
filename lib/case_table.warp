// upper, lower and fold in warp (card case-table-warp), the twin of src/wasm_emitter/text/text_unicode.rs, over the
// case tables of lib/case_tables.warp (generated by scripts/case_tables.py): `use case_table; case_upper("straße")` is
// "STRASSE". A range of the table maps each code point from start to last, a stride apart, to itself plus delta; a
// mapping to several code points (`ß` is `SS`) is a range of one with the second and third after it. The builtins
// upper/lower/fold stay Rust until this module is measured against them and the tables are cheap constant data (card
// constant-data: today the lists are built when the module loads).
use case_tables

enum CaseMapping { Upper, Lower, Fold }

// the ints of one range in a table: start, last, stride, delta, second, third
RANGE_FIELDS = 6

class CaseTable { ranges: list
	range_count(): int := count(ranges) /! RANGE_FIELDS
	field(range: int, index: int): int := ranges[range * RANGE_FIELDS + index]
	start(range: int): int := field(range, 0)
	last(range: int): int := field(range, 1)
	stride(range: int): int := field(range, 2)
	delta(range: int): int := field(range, 3)
	second(range: int): int := field(range, 4)
	third(range: int): int := field(range, 5)
	// binary search: the last range starting at or before code, -1 when none does
	range_before(code: int): int := {
		low = 0
		high = range_count()
		while low < high {
			middle = (low + high) /! 2
			if start(middle) <= code { low = middle + 1 } else { high = middle }
		}
		low - 1
	}
	covers(range: int, code: int): bool := range >= 0 and code <= last(range) and (code - start(range)) % stride(range) == 0
	// the code points code maps to: itself unless a range covers it
	mapped(code: int): list := {
		range = range_before(code)
		if not covers(range, code) { return [code] }
		out = [code + delta(range)]
		if second(range) != 0 { out = out + [second(range)] }
		if third(range) != 0 { out = out + [third(range)] }
		out
	}
	map_text(t: text): text := {
		out = ""
		for code in codepoints(t) { for each in mapped(code) { out = out + chr(each) } }
		out
	}
}

case_table_of(mapping: CaseMapping): CaseTable := match mapping {
	CaseMapping.Upper: CaseTable(upper_case_ranges)
	CaseMapping.Lower: CaseTable(lower_case_ranges)
	CaseMapping.Fold: CaseTable(fold_case_ranges)
}

case_map(t: text, mapping: CaseMapping): text := case_table_of(mapping).map_text(t)
case_upper(t: text): text := case_map(t, CaseMapping.Upper)
case_lower(t: text): text := case_map(t, CaseMapping.Lower)
// lower case without accents (`É` is `e`), for `≈`
case_fold(t: text): text := case_map(t, CaseMapping.Fold)
