// The standard library module wikipedia (notes/world_events.md): the edits of every Wikimedia wiki as they happen,
// from Wikimedia's public event stream (server-sent events, no key). `for edit in changes("enwiki") { print edit.title }`;
// an edit is a map: title, user, wiki, type (edit, new, log, categorize), bot, comment, timestamp, server_name …
use feeds
RECENT_CHANGES = "https://stream.wikimedia.org/v2/stream/recentchange"

class WikiChanges extends Streamed {
	wiki: text = ""
	keeps(event) := wiki == "" or event.wiki == wiki
}

// the recent changes of one wiki ("enwiki", "dewiki", "wikidatawiki" …), of all of them by default
changes(wiki: text = ""): WikiChanges := WikiChanges(url: RECENT_CHANGES, wiki: wiki)
