// The standard module tasks (decision N29, card go-cooperative): `go {…}` is a cooperative task, no thread: it starts
// when main yields (its sleep, an await, a channel's receive, main's end) and gives the others their turn at its own
// sleeps, natively and in a page alike, its block split there (lib/rule_words.warp task_steps); `go x` of an expression its value.
// `await job` runs the tasks until it is done and gives its value, `await all jobs` their values, `await any`/`first`
// the first done's, `await job within t or d` its value if done within t, else d.
// A task keeps what a module holds per task (task_context: sound's voice), its starter's when it was started
use units
// (`await go …` is one rule: `await $x` taking the go would leave it unrewritten)
rewrite await go $body: block => task_awaited(task_go(() => $steps)) where $steps = task_steps($body)
rewrite await go $x => ($context = task_context(); $value = $x; task_context_back($context); $value)
// `go for x in xs {…}`: each iteration a task, the loop done when all of them are (a parallel for)
rewrite go for $x in $xs {$body...} => ($jobs = $xs.map($x => task_go(() => $steps)); $jobs.map(task_awaited); ø) where $steps = task_steps({$body...})
rewrite go $body: block => task_go(() => $steps) where $steps = task_steps($body)
// a task of an expression is a block's (decision go-unified): `go f(x)` is `go { f(x) }`
rewrite go $x => task_go(() => $x)
rewrite await all $xs => $xs.map(task_awaited)
rewrite await any $xs => task_awaited_any($xs)
rewrite await first $xs => task_awaited_any($xs)
rewrite await $x within $t or $d => task_awaited_within($x, $t / 1ms, () => $d)
rewrite await $x within $t => task_awaited_within($x, $t / 1ms, () => raise "the task took longer than " + str($t))
rewrite await $x => $awaited where $awaited = awaited_operand($x)
// `finish job` is `await job` (decision finish-await), a word a program may define for itself
rewrite finish $x => $awaited where $awaited = awaited_operand($x)
// `shared n = 0` (wiki/async.md): one value every task sees; cooperative tasks run in one instance, so it is the
// a global of the main level as a `linear` array is, its `+=` atomic as any step is
rewrite (shared $d) => global: $d
// a cancelled task yields no result (decision stopped-no-result): reading or awaiting it raises "job was cancelled"
rewrite cancel $x => task_cancelled($x, $n) where statement and $x is symbol and $n = spelled($x)
rewrite $x.cancel() => task_cancelled($x, $n) where statement and $x is symbol and $n = spelled($x)
// `end job` is refused, naming both: finish job or cancel job (decision end-refused)
rewrite end $x => $refused where statement and $x is symbol and $refused = end_refused($x)
// `stop job` pauses it, as a stopped job of a shell (decision stopped-no-result), and says so
rewrite stop $x => task_stopped($x, $n) where statement and $x is symbol and $n = spelled($x)
rewrite $x.stop() => task_stopped($x, $n) where statement and $x is symbol and $n = spelled($x)
// `pause job` holds a task where it stands until `resume job` (or an await of it)
rewrite pause $x => (task_paused($x); ø) where statement
rewrite resume $x => (task_resumed($x); ø) where statement
// `once job finishes: …` runs when the task's last step ran, at once if it is done; `once job pauses: …` at each
// pause (`on job.stop: …` alike), `on job.cancel: …` once it is cancelled
rewrite once $x finishes $body: block => task_finished_then($x, () => $body)
rewrite once $x finishes: $body => task_finished_then($x, () => $body)
rewrite once $x pauses $body: block => task_paused_then($x, () => $body)
rewrite once $x pauses: $body => task_paused_then($x, () => $body)
rewrite on $x.stop $body: block => task_paused_then($x, () => $body)
rewrite on $x.stop: $body => task_paused_then($x, () => $body)
rewrite on $x.cancel $body: block => task_cancelled_then($x, () => $body)
rewrite on $x.cancel: $body => task_cancelled_then($x, () => $body)
// a program that starts tasks runs them all before it ends, its value kept
rewrite $p => $q where program and $q = tasked($p)

// the scheduler: each step of a task runs to the task's next sleep, which queues the rest
class Task {
	due: int; next: any; done: bool = no; value: any = ø; failed: any = ø; awaited: bool = no; context: any = ø
	paused: bool = no; finish_handlers: list = []; pause_handlers: list = []; cancel_handlers: list = []
	cancel() := task_cancelled(self, "the task")
	stop() := task_stopped(self, "the task")
	pause() := task_paused(self)
	resume() := task_resumed(self)
}
// a place typed task (or thread, its alias while tasks share one scheduler) keeps the job
type task = Task
type thread = Task
global task_queue = []
global running_task = ø
global failed_tasks = []
global task_sleep_said = no
// the task of a step, queued to start at main's next yield, its starter's context its own (sound's voice)
task_go(first: function) := {
	task = Task(clock(), first)
	task.context = task_context()
	task_queue = task_queue + [task]
	task
}
// a sleep's amount in ms: a duration's, a plain number's seconds (as sleep)
sleep_ms_of(amount) := (if amount is Time then amount.amount else amount) * 1000
// the rest of the running task, due once it slept that long (ms)
task_sleep(ms, rest: function) := {
	running_task.due = clock() + ms
	running_task.next = rest
	ø
}
// a sleep of main runs the tasks due meanwhile; one inside a function a task calls holds the task there, and the
// others with it, said once
slept(ms) := {
	if running_task == ø {
		tasks_run_while(ø, clock() + ms)
	} else {
		if #task_queue > 1 and not task_sleep_said {
			task_sleep_said = yes
			warning("a task's sleep inside a function it calls holds every task until it wakes: sleep in the task's own block to let the others run")
		}
		sleep_ms(ms)
	}
	ø
}
// the queued steps, the earliest due first, while the condition holds (ø: always) and each is due before the deadline
// (ø: none): sleeping until each is due, and until the deadline at the end
tasks_run_while(holds: any, deadline: any) := {
	while #task_queue > 0 and (holds == ø or holds()) {
		ready = task_queue.filter(t => not t.paused)
		if #ready == 0 { break }
		task = ready.fold(ready#1, (soonest, t) => if t.due < soonest.due then t else soonest)
		if deadline != ø and task.due > deadline { break }
		if task.due > clock() { sleep_ms(task.due - clock()) }
		task_stepped(task)
	}
	if deadline != ø and deadline > clock() { sleep_ms(deadline - clock()) }
	ø
}
// one step of the task, in its own context: its last step's value is the task's, an error it raised its failure
task_stepped(task: Task) := {
	step = task.next
	task.next = ø
	running_task = task
	starter = task_context()
	task_context_back(task.context)
	value = try step() catch e { task.failed = e; failed_tasks = failed_tasks + [task]; ø }
	task.context = task_context()
	task_context_back(starter)
	running_task = ø
	if task.next == ø {
		task.done = yes
		task.value = value
		task_queue = task_queue.filter(t => not t.done)
		handlers_run(task.finish_handlers)
	}
}
handlers_run(handlers: list) := for handler in handlers { handler() }
// `await job`: the tasks run until it is done, its value (its error raised again); any other value as it is. The
// emitter calls it too where a place typed as a value takes a task, `n: int = go f(3)` (decision task-to-value-awaits)
task_awaited(x) := if x is Task then task_value(x) else x
task_value(x: Task) := {
	x.paused = no
	tasks_run_while(() => not x.done, ø)
	x.awaited = yes
	if x.failed != ø { raise str(x.failed) }
	x.value
}
// `await any jobs`: the value of the first to be done
task_awaited_any(xs) := {
	tasks_run_while(() => not xs.any(is_done), ø)
	task_awaited(xs.filter(is_done)#1)
}
// `await job within t or d`: its value if it is done within t (ms), else d (an error without one)
task_awaited_within(x, ms, fallback: function) := if x is Task then task_value_within(x, ms, fallback) else x
task_value_within(x: Task, ms, fallback: function) := {
	tasks_run_while(() => not x.done, clock() + ms)
	if x.done then task_value(x) else fallback()
}
// a value is done, a task once its last step ran
is_done(x) := if x is Task then task_finished(x) else yes
task_finished(x: Task) := x.done
// a task named name ends without a result: an await or read of it raises; one done already keeps its value
task_cancelled(x, name: text) := {
	if x is Task and not x.done { task_ended(x, name) }
	ø
}
task_ended(x: Task, name: text) := {
	x.done = yes
	x.failed = name + " was cancelled"
	task_queue = task_queue.filter(t => not t.done)
	handlers_run(x.cancel_handlers)
}
task_stopped(x, name: text) := {
	warning("stop pauses " + name + "; to end it: cancel " + name)
	task_paused(x)
}
task_paused(x) := {
	if x is Task and not x.paused { task_held(x) }
	ø
}
task_held(x: Task) := {
	x.paused = yes
	handlers_run(x.pause_handlers)
}
task_paused_then(x, handler: function) := {
	if x is Task { x.pause_handlers += [handler] }
	ø
}
task_cancelled_then(x, handler: function) := {
	if x is Task { x.cancel_handlers += [handler] }
	ø
}
task_resumed(x) := {
	if x is Task { x.paused = no }
	ø
}
task_finished_then(x, handler: function) := if x is Task then task_handled(x, handler) else handler()
task_handled(x: Task, handler: function) := {
	if x.done { return handler() }
	x.finish_handlers += [handler]
	ø
}
// main's end: every task runs to its end; a task's error that nobody awaited ends it loudly. The program's value is a
// value place: a task there is awaited (decision task-tests-answers)
tasks_end(value: any = ø) := {
	tasks_run_while(ø, ø)
	unawaited = failed_tasks.filter(task => not task.awaited)
	if #unawaited > 0 { raise "a task failed and nobody awaited it: " + str(unawaited#1.failed) }
	task_awaited(value)
}
