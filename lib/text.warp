// The standard library module text (notes/stdlib.md): standard functions of every program, `repeat(t, 2)` or `t.repeat(2)`, no `use` needed (`use text` only for the qualified `text.repeat(t, 2)`)
use list
use letter_ranges
use slugs
repeat(t: text, n: int) := if n < 0 then raise "repeat needs a count of at least 0, not " + str(n) else t * n
pad_left(t, width) := if count(t) >= width then t else (width - count(t)) times " " + t
pad_right(t, width) := if count(t) >= width then t else t + (width - count(t)) times " "
// format("{} has {} items", ["cart", 3]): each {} takes the next value
format(template, values) := {
	parts = split(template, "{}")
	result = parts[0]
	for i in 1 ..< count(parts) {
		result = result + values[i - 1] + parts[i]
	}
	result
}
// the words between runs of whitespace: spaces, tabs, newlines (Python's split())
words(t): list := [w for w in split(join([if not is_space(c) then c else " " for c in t], ""), " ") if w]
lines(t: text): list := [remove_suffix(l, chr(13)) for l in split(t, "\n")]
// the letters of a text, no digits, spaces or punctuation: letters of "a1 b!" is ['a' 'b'] (decision 2026-10-15),
// of any script: letters of "x، ب٣" is ['x' 'ب']
letters(t): list := [c for c in chars(t) if is_unicode_letter(c)]
// whether c is a letter of any script, cased or not (Unicode's letter categories): `q`, `é`, `ا`, `名`; no digit, mark
// or punctuation. is_alpha stays ASCII's a–z and A–Z
is_unicode_letter(c): bool := {
	code = ord(c)
	if code < 128 { return is_alpha(c) }
	at = letter_range_before(code)
	at >= 0 and code <= letter_ranges[at * 2 + 1]
}
// the last letter range (lib/letter_ranges.warp) starting at or before code, by halving; -1 when none does
letter_range_before(code: int): int := {
	low = 0
	high = count(letter_ranges) /! 2
	while low < high {
		middle = (low + high) /! 2
		if letter_ranges[middle * 2] <= code { low = middle + 1 } else { high = middle }
	}
	low - 1
}
capitalize(t) := if t is empty then t else upper(t[0]) + t[1..]
center(t, width) := pad_right(pad_left(t, (width + count(t)) /! 2), width)
title(t): text := join([capitalize(w) for w in words(t)], " ")
// lower case letters and digits, the rest as single dashes: "Hello, World!" → "hello-world"
slug(t): text := slugify(t)
truncate(t, width) := if width < 1 then raise "truncate needs a width of at least 1, not " + str(width) else if count(t) <= width then t else t[0 ..< width - 1] + "…"
// UTF-8: a text as its bytes, and bytes back as a text (Rust's String::from_utf8, string.from_utf8)
def to_utf8(t: text): list {
	out = []
	for c in t.codepoints {
		n = ord(c)
		if n < 128 { out.add(n) }
		else if n < 2048 { out.add(192 + n /! 64); out.add(128 + n % 64) }
		else if n < 65536 { out.add(224 + n /! 4096); out.add(128 + n /! 64 % 64); out.add(128 + n % 64) }
		else { out.add(240 + n /! 262144); out.add(128 + n /! 4096 % 64); out.add(128 + n /! 64 % 64); out.add(128 + n % 64) }
	}
	out
}

// bytes → text; UFCS `string.from_utf8(bytes)` arrives as from_utf8(string, bytes) — ignore the owner
def from_utf8_bytes(bytes: any): text {
	out = ""
	i = 0
	total = count(bytes)
	while i < total {
		b = bytes[i]
		if not (b is int) or b < 0 or b > 255 { raise "from_utf8: " + str(b) + " at position " + str(i) + " is not a byte" }
		length = if b < 128 then 1 else if b >= 194 and b < 224 then 2 else if b >= 224 and b < 240 then 3 else if b >= 240 and b < 245 then 4 else 0
		if length == 0 { raise "from_utf8: the byte " + str(b) + " at position " + str(i) + " cannot start a character (invalid UTF-8)" }
		if i + length > total { raise "from_utf8: the character starting at position " + str(i) + " is cut off (invalid UTF-8)" }
		n = if length == 1 then b else if length == 2 then b % 32 else if length == 3 then b % 16 else b % 8
		for k in 1 to length - 1 {
			c = bytes[i + k]
			if not (c is int) or c < 128 or c > 191 { raise "from_utf8: the byte " + str(c) + " at position " + str(i + k) + " is not a continuation byte (invalid UTF-8)" }
			n = n * 64 + c % 64
		}
		if (length == 3 and n < 2048) or (length == 4 and (n < 65536 or n > 1114111)) or (n >= 55296 and n <= 57343) { raise "from_utf8: an overlong or out-of-range sequence at position " + str(i) + " (invalid UTF-8)" }
		out = out + chr(n)
		i = i + length
	}
	out
}
from_utf8(bytes) := from_utf8_bytes(bytes)
from_utf8(owner, bytes) := from_utf8_bytes(bytes)
// only spaces, tabs and line breaks, or nothing
is_blank(t): bool := trim(t) is empty
// has letters, all upper (or lower) case
is_upper(t): bool := upper(t) == t and lower(t) != t
is_lower(t): bool := lower(t) == t and upper(t) != t
remove_prefix(t, prefix) := if starts_with(t, prefix) then t[count(prefix):] else t
remove_suffix(t, suffix) := if ends_with(t, suffix) then t[0: count(t) - count(suffix)] else t
is_palindrome(t): bool := { s = lower(join([c for c in t if is_alphanumeric(c)], "")); s == reverse(s) }
word_count(t): int := count(words(t))
// "helloWorld", "Hello World", "hello-world" → "hello_world"; one implementation in slugs (acronyms stay whole:
// "HTTPServer" → "http_server")
snake_case(t): text := to_snake(t)
kebab_case(t): text := to_kebab(t)
// "hello_world" → "helloWorld"
camel_case(t): text := to_camel(t)
// each line indented by n spaces
indent(t, n): text := join([n times " " + line for line in lines(t)], "\n")
// a whole or decimal number, optionally signed: "12.5", "-3"
is_numeric(t): bool := { parts = split(remove_prefix(trim(t), "-"), "."); if count(parts) > 2 { return false }; for p in parts { if p is empty { return false }; for c in p { if not is_digit(c) { return false } } }; true }
// the text between the first opening and the next closing after it, "" when either is missing
between(t, opening, closing) := { from = index_of(t, opening); if from == 0 { return "" }; rest = t[from - 1 + count(opening):]; to = index_of(rest, closing); if to == 0 then "" else rest[0: to - 1] }
// the words in lines of at most width characters
wrap(t, width): text := { out = []; line = ""; for w in words(t) { if line is empty { line = w } else if count(line) + 1 + count(w) <= width { line = line + " " + w } else { out = out + [line]; line = w } }; if line { out = out + [line] }; join(out, "\n") }
// a reading position in a text, for scanners and parsers: `c = Cursor("ab12"); c.take_while(is_letter)` is "ab",
// then `c.peek()` is '1'; `at` counts the characters read (an index)
class Cursor { source: text; at = 0
	at_end(): bool := at >= count(source)
	peek() := source[at]
	advance() := { taken = source[at]; at += 1; taken }
	looking_at(part): bool := source[at : min(at + count(part), count(source))] == part
	skip(part): bool := { if looking_at(part) { at += count(part); return true }; false }
	take_while(ok) := { start = at; while at < count(source) and ok(source[at]) { at += 1 }; source[start : at] }
	skip_while(ok): int := count(take_while(ok))
	rest() := source[at : count(source)]
}
// the Levenshtein distance: the fewest one-character inserts, deletes and replacements from a to b, by characters:
// edit_distance("kitten", "sitting") is 3, edit_distance("café", "cafe") is 1
def edit_distance(a: text, b: text): int {
	xs = [c for c in a]
	ys = [c for c in b]
	row = [j for j in 0 to count(ys)]
	for i in 1 to count(xs) {
		previous = row
		row = [i]
		for j in 1 to count(ys) {
			cost = if xs[i - 1] == ys[j - 1] then 0 else 1
			row = row + [min(min(previous[j] + 1, row[j - 1] + 1), previous[j - 1] + cost)]
		}
	}
	row[count(ys)]
}
// the leading spaces and tabs of a line
indentation(line: text): text := { n = 0; while n < count(line) and (line[n] == " " or line[n] == "\t") { n = n + 1 }; line[0 ..< n] }
// the longest start two texts share
common_start(a: text, b: text): text := { n = 0; while n < count(a) and n < count(b) and a[n] == b[n] { n = n + 1 }; a[0 ..< n] }
// without the leading whitespace all its non-blank lines share (Python's textwrap.dedent); blank lines become empty
def dedent(t: text): text {
	margin = nil
	for line in lines(t) { if not is_blank(line) { margin = if margin == nil then indentation(line) else common_start(margin, indentation(line)) } }
	cut = if margin == nil then 0 else count(margin)
	join([if is_blank(line) then "" else line[cut..] for line in lines(t)], "\n")
}

// Number formatting (card lib-stats-format)
// format_number(1234567.89) is "1,234,567.89": commas between groups of three whole digits, the sign and the fraction kept
// as text gives them (no rounding); format_number(-1234) is "-1,234"
format_number(n: any): text := {
	s = "" + n
	sign = ""
	whole = ""
	rest = ""
	for c in s {
		if c == "-" and whole == "" and rest == "" { sign = "-" } else if rest != "" or c == "." { rest = rest + c } else { whole = whole + c }
	}
	out = ""
	k = 0
	i = count(whole)
	while i >= 1 { if k > 0 and k % 3 == 0 { out = "," + out }; out = "" + whole#i + out; k = k + 1; i = i - 1 }
	sign + out + rest
}
// ordinalize(n): "1st" "2nd" "3rd" "4th" "11th" "12th" "13th" "21st" "101st" "111th"; a whole number >= 1, else refused.
// Not named ordinal: the prelude's ordinal is ord, the codepoint of a character
ordinalize(n: any): text := {
	if not (n is int) or n < 1 { raise "ordinalize needs a whole number >= 1" }
	suffix = "th"
	if n % 100 < 11 or n % 100 > 13 {
		if n % 10 == 1 { suffix = "st" }
		if n % 10 == 2 { suffix = "nd" }
		if n % 10 == 3 { suffix = "rd" }
	}
	"" + n + suffix
}
// human_size(bytes): decimal SI units, 1000 a step (B KB MB GB TB PB), as disks and networks count: 1500000 is "1.5 MB",
// 1536 is "1.5 KB"; one decimal rounded half up, a .0 dropped ("2 KB"); under 1000 whole bytes ("999 B"); negatives refused
human_size(bytes: any): text := {
	if bytes < 0 { raise "human_size needs bytes >= 0" }
	units = ["B", "KB", "MB", "GB", "TB", "PB"]
	if bytes < 1000 { return "" + int(bytes) + " B" }
	u = 1
	v = bytes
	while v >= 1000 and u < count(units) { v = v / 1000; u = u + 1 }
	tenths = int(v * 10 + 1/2)
	// rounding can reach the next unit: 999.95 KB is 1 MB
	if tenths >= 10000 and u < count(units) { tenths = tenths / 1000; u = u + 1 }
	whole = int(tenths / 10)
	frac = tenths - whole * 10
	shown = "" + whole
	if frac != 0 { shown = shown + "." + frac }
	shown + " " + units#u
}
