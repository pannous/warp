// Rust's regex crate as a C library (card ffi-rust-crate-adapter, notes/crate_adapter.md): `scripts/warp-crate build
// lib/crates/regex.warp` builds librs_regex and writes native/rs_regex.warp, these lines without their `= rust` parts;
// a program then says `use rs_regex`. Each foreign line's `= path` is the Rust item answering it, `?.m` maps m over an
// Option, `*.m` over an iterator (whose items come back as a list).
crate: "regex@1"

regex_new(pattern: text): handle(regex::Regex) from 'rs_regex' = regex::Regex::new
regex_is_match(re: handle, haystack: text): bool from 'rs_regex' = regex::Regex::is_match
regex_find(re: handle, haystack: text): text from 'rs_regex' = regex::Regex::find?.as_str
regex_find_start(re: handle, haystack: text): i64 from 'rs_regex' = regex::Regex::find?.start
regex_find_all(re: handle, haystack: text): list from 'rs_regex' = regex::Regex::find_iter*.as_str
regex_replace_all(re: handle, haystack: text, replacement: text): text from 'rs_regex' = regex::Regex::replace_all
regex_shortest_match(re: handle, haystack: text): i64 from 'rs_regex' = regex::Regex::shortest_match
regex_captures_len(re: handle): i64 from 'rs_regex' = regex::Regex::captures_len
regex_as_str(re: handle): text from 'rs_regex' = regex::Regex::as_str
regex_free(re: handle(regex::Regex)): void from 'rs_regex' = drop

// the words of lib/regex.warp, in warp over the lines above: each compiles its pattern, asks, and frees it
regex_of(pattern: text) := {
	re = regex_new(pattern)
	if re == 0 { raise "regex: " + rs_regex_last_error() }
	re
}
// the texts of a list rs_regex handed back, which it then frees
rs_regex_texts(list: int) := {
	found = []
	i = 0
	while i < rs_regex_list_count(list) {
		found += [rs_regex_list_text(list, i)]
		i += 1
	}
	rs_regex_list_free(list)
	found
}
is_match(subject: text, pattern: text) := {
	re = regex_of(pattern)
	found = regex_is_match(re, subject)
	regex_free(re)
	found
}
first_match(subject: text, pattern: text) := {
	re = regex_of(pattern)
	found = regex_find(re, subject)
	regex_free(re)
	found
}
find_all(subject: text, pattern: text) := {
	re = regex_of(pattern)
	found = rs_regex_texts(regex_find_all(re, subject))
	regex_free(re)
	found
}
replace_all(subject: text, pattern: text, replacement: text) := {
	re = regex_of(pattern)
	replaced = regex_replace_all(re, subject, replacement)
	regex_free(re)
	replaced
}
