// The standard library module path (card lib-path-helpers): `use path`, paths as plain text, no file system. A path's
// parts are split at "/", a leading "/" makes it absolute. normalize is math's (a vector's), so the path one is
// normalize_path
// a joined to b, one "/" between; an absolute b stands alone: path_join("a/", "b") is "a/b", path_join("a", "/b") "/b"
path_join(a: text, b: text): text := if b.starts_with("/") or a == "" then b else if a.ends_with("/") then a + b else a + "/" + b
// the path without trailing slashes, "/" itself kept
path_trimmed(p: text): text := { t = p; while #t > 1 and t.ends_with("/") { t = t[0: #t - 1] }; t }
// the folder part: dirname("a/b/c") is "a/b", dirname("c") ".", dirname("/c") and dirname("/") "/"
dirname(p: text): text := {
	t = path_trimmed(p)
	slashes = (1 to #t).filter(i => t#i == '/')
	if #slashes == 0 { return "." }
	last = slashes.last
	if last == 1 then "/" else path_trimmed(t[0: last - 1])
}
// the last part: basename("a/b.txt") is "b.txt", basename("a/b/") "b", basename("/") ""
basename(p: text): text := {
	t = path_trimmed(p)
	if t == "/" { return "" }
	slashes = (1 to #t).filter(i => t#i == '/')
	if #slashes == 0 then t else t[slashes.last:]
}
// the last part's suffix from its last dot, the dot included: ".gz" of "a.tar.gz", "" of ".bashrc" (a leading dot
// names a dotfile, no extension) and of "README"
// . and .. are no file names: no extension, the stem the name itself; a dot ending the name starts no extension
// (pathlib): "a." has none and stem "a."
extension(p: text): text := { name = basename(p); at = last_dot(name); if at <= 1 or at == #name or name == ".." then "" else name[at - 1:] }
// the last part without its extension: "a.tar" of "a.tar.gz", ".bashrc" of ".bashrc"; stem + extension is basename
stem(p: text): text := { name = basename(p); at = last_dot(name); if at <= 1 or at == #name or name == ".." then name else name[0: at - 1] }
last_dot(name: text): int := { dots = (1 to #name).filter(i => name#i == '.'); if #dots == 0 then 0 else dots.last }
// . parts and repeated or trailing slashes dropped, a .. taking back the part before it; at the root of an absolute
// path a .. stays there, a relative path keeps the .. it cannot take back: "a/./b//../c/" is "a/c", "/../x" "/x",
// "../a/../.." "../..", "" and "." ".".
normalize_path(p: text): text := {
	absolute = p.starts_with("/")
	kept = []
	for part in split(p, "/") {
		if part == "" or part == "." { continue }
		if part == ".." {
			if #kept > 0 and kept.last != ".." { kept = kept[0: #kept - 1] } else if not absolute { kept = kept + [".."] }
		} else { kept = kept + [part] }
	}
	joined = kept.join("/")
	if absolute then "/" + joined else if joined == "" then "." else joined
}
path_parts(p: text): list := { n = normalize_path(p); if n == "/" or n == "." then [] else split(if n.starts_with("/") then n[1:] else n, "/") }
// the path that leads from the folder from to to, both normalized first: relative_path("a/b", "a/c/d") is "../c/d",
// "." for the same place; an absolute path and a relative one share no root, so that refuses
relative_path(from: text, to: text): text := {
	if from.starts_with("/") != to.starts_with("/") { raise "relative_path: " + from + " and " + to + " must both be absolute or both relative" }
	a = path_parts(from)
	b = path_parts(to)
	if a.any(part => part == "..") { raise "relative_path: " + from + " climbs above its start, the way back from there is unknown" }
	common = 0
	while common < #a and common < #b and a#(common + 1) == b#(common + 1) { common += 1 }
	steps = [".." for i in common + 1 to #a] + b[common:]
	if #steps == 0 then "." else steps.join("/")
}
// glob_match(pattern, path): * any run of characters within one part, ? one character but "/", [abc] [a-z] one of
// them ([!…] or [^…] none of them), ** any number of whole parts ("**/" none too); everything else is itself
glob_match(pattern: text, path: text): bool := glob_from(pattern, 1, path, 1)
glob_from(p: text, i: int, s: text, j: int): bool := {
	if i > #p { return j > #s }
	c = p#i
	if c == '*' and i < #p and p#(i + 1) == '*' {
		rest = i + 2
		if rest <= #p and p#rest == '/' and glob_from(p, rest + 1, s, j) { return yes }
		return (j to #s + 1).any(k => glob_from(p, rest, s, k))
	}
	if c == '*' {
		k = j
		while yes {
			if glob_from(p, i + 1, s, k) { return yes }
			if k > #s or s#k == '/' { return no }
			k += 1
		}
	}
	if j > #s { return no }
	if c == '?' { return s#j != '/' and glob_from(p, i + 1, s, j + 1) }
	if c == '[' {
		close = i + 1
		while close <= #p and p#close != ']' { close += 1 }
		if close <= #p {
			members = p[i: close - 1]
			negated = #members > 0 and (members#1 == '!' or members#1 == '^')
			if negated { members = members[1:] }
			if s#j == '/' or class_has(members, s#j) == negated { return no }
			return glob_from(p, close + 1, s, j + 1)
		}
	}
	c == s#j and glob_from(p, i + 1, s, j + 1)
}
// whether the class's members, single characters and ranges a-z, hold c
class_has(members: text, c: any): bool := {
	i = 1
	while i <= #members {
		if i + 2 <= #members and members#(i + 1) == '-' {
			if ord(c) >= ord(members#i) and ord(c) <= ord(members#(i + 2)) { return yes }
			i += 3
		} else {
			if members#i == c { return yes }
			i += 1
		}
	}
	no
}
