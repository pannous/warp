// The standard library module json (notes/stdlib.md section 7): `use json`. Warp data is a superset of JSON, read and
// written here in warp, alike under every host: parse reads JSON5 too, and leniently on purpose (decided on card
// lib-path-file-conformance, test/json/README.md): JSON5 numbers (+1, .5, 1.), unknown escapes read as the
// character (\x is x), raw control characters in strings (a tab, a line break), comments, single quotes, trailing
// commas, bare keys and numeric bare keys ({1: 1}); and `json(t)` is json.parse(t) without `use json`; `x.json`
// is the JSON text of any value, to_json(x), also
// without `use json` (`{a: 1}.json` is {"a":1}), code in the JsonLogic shape (`1+1` is {"+":[1,1]})
rewrite parse($input, $type) => $result where $type is type and $result = typed_json($input, $type, $program)

JSON_SPACE = [" ", "\t", "\n", "\r"]
JSON_NUMBER_CHARACTERS = "+-0123456789.eE"
JSON_ESCAPED = {"n": "\n", "t": "\t", "r": "\r", "b": chr(8), "f": chr(12)}
JSON_ESCAPES = {"\"": "\\\"", "\\": "\\\\", "\n": "\\n", "\t": "\\t", "\r": "\\r"}
JSON_LITERALS = {"true": yes, "false": no, "null": ø}
// the types of a key that is no instance of a class: code, an operation inside code (`b + 1` of `a * (b + 1)`)
KEY_TYPES = ["code", "key", "operation"]
// the operators of code that are entries of an object, `{a: 1+2}` is {"a":{"+":[1,2]}}
JSON_ENTRY_OPERATORS = ["", ":", "=", ":="]
HEX_DIGITS = "0123456789abcdef"
JSON_WORD_ENDS = ":,]}/"

global parse_json(source: any): any := {
	read = json_read(source, json_skipped(source, 1))
	if json_skipped(source, read#2) <= #source { raise json_refusal(source, "more after the value") }
	read#1
}
// json of warp data, `json{ 'a':1 }`, is that data
global json(source: any): any := if source is text then parse_json(source) else source
global to_json(value: any): text := json_written(value, no)
// `x.json` (extensions/sugar/methods.warp): the JSON text of any value; a map's own field json wins
global json_text(value: any): any := if value is map and "json" in value then value["json"] else to_json(value)
// the old form naming the classes whose instances are their fields: every instance is
to_json_of_classes(value: any, classes: any): text := to_json(value)
// to_json under `use strict`: a fraction JSON writes only approximately is an error
exact_json(value: any, classes: any): text := json_written(value, yes)

json_refusal(source, problem): text := "" + source + " is no json: " + problem
// the place of the first character after spaces and comments from at on; a character other than / starts no
// comment, so it returns before slicing (card lib-perf-bench)
json_space(c: text): bool := c == " " or c == "\t" or c == "\n" or c == "\r"
json_number_char(c: text): bool := is_digit(c) or c == "+" or c == "-" or c == "." or c == "e" or c == "E"
json_skipped(source: text, at: int): int := {
	while at <= #source {
		if json_space(source#at) { at += 1 }
		else if source#at != "/" { return at }
		else if source[at - 1..<at + 1] == "//" { while at <= #source and source#at != "\n" { at += 1 } }
		else if source[at - 1..<at + 1] == "/*" {
			at += 2
			while at < #source and source[at - 1..<at + 1] != "*/" { at += 1 }
			at += 2
		}
		else { return at }
	}
	at
}
// [the value written at that place, the place after it]
json_read(source: text, at: int): list := {
	if at > #source { raise json_refusal(source, "it ends early") }
	first = source#at
	if first == "{" { return json_object_read(source, at + 1) }
	if first == "[" { return json_array_read(source, at + 1) }
	if first == "\"" or first == "'" { return json_text_read(source, at + 1, first) }
	if json_number_char(first) { return json_number_read(source, at) }
	word = json_word_read(source, at)
	if word#1 in JSON_LITERALS { return [JSON_LITERALS[word#1], word#2] }
	raise json_refusal(source, "unexpected " + first)
}
json_object_read(source: text, at: int): list := {
	object = {}
	at = json_skipped(source, at)
	while at <= #source and source#at != "}" {
		if source#at == "[" or source#at == "{" { raise json_refusal(source, "a key expected, not " + source#at) }
		key = if source#at == "\"" or source#at == "'" then json_text_read(source, at + 1, source#at) else json_word_read(source, at)
		at = json_skipped(source, key#2)
		if at > #source or source#at != ":" { raise json_refusal(source, "no : after the key " + key#1) }
		value = json_read(source, json_skipped(source, at + 1))
		object[key#1] = value#1
		at = json_after_item(source, value#2, "}")
	}
	if at > #source { raise json_refusal(source, "no closing }") }
	[object, at + 1]
}
json_array_read(source: text, at: int): list := {
	items = []
	at = json_skipped(source, at)
	while at <= #source and source#at != "]" {
		item = json_read(source, at)
		items.add(item#1)
		at = json_after_item(source, item#2, "]")
	}
	if at > #source { raise json_refusal(source, "no closing ]") }
	[items, at + 1]
}
// the place after an item and its comma, at the closing bracket when none follows
json_after_item(source: text, at: int, closing: text): int := {
	at = json_skipped(source, at)
	if at <= #source and source#at == "," { return json_skipped(source, at + 1) }
	if at <= #source and source#at != closing { raise json_refusal(source, "no , or " + closing + " after an item") }
	at
}
// a run of plain characters joins the text as one slice, not character by character (card lib-perf-bench)
json_text_read(source: text, at: int, quote: text): list := {
	// no-escape fast path: one slice, no builder (card lib-json-read-perf)
	start0 = at
	while at <= #source and source#at != quote and source#at != "\\" { at += 1 }
	if at <= #source and source#at == quote { return [source[start0 - 1..<at - 1], at + 1] }
	read = source[start0 - 1..<at - 1]
	while at <= #source and source#at != quote {
		if source#at == "\\" {
			escaped = source#(at + 1)
			if escaped == "u" {
				r = json_unicode_read(source, at)
				read += r[0]
				at = r[1]
			} else {
				// by code point too: a combining mark after \n is part of the n's character
				points = ("" + escaped).codepoints
				first = "" + points[0]
				read += (JSON_ESCAPED.get(first) ?? first) + join([points[i] for i in 1 ..< count(points)], "")
				at += 2
			}
		} else {
			start = at
			while at <= #source and source#at != quote and source#at != "\\" { at += 1 }
			read += source[start - 1..<at - 1]
		}
	}
	if at > #source { raise json_refusal(source, "no closing " + quote) }
	[read, at + 1]
}
// a number: a whole one exactly, however long, one with a fraction or an exponent a float
json_number_read(source: text, at: int): list := {
	// integer fast path: accumulate while scanning; fall through for fraction/exponent/extra (card lib-json-read-perf)
	end = at
	if end <= #source and (source#end == "-" or source#end == "+") { end += 1 }
	start = end
	n = 0
	while end <= #source and is_digit(source#end) {
		n = n * 10 + ord(source#end) - 48
		end += 1
	}
	if end > start and (end > #source or not json_number_char(source#end)) {
		if end - start > 1 and source#start == "0" { raise json_refusal(source, "a bad number " + source[at - 1..<end - 1]) }
		if source#at == "-" { return [0 - n, end] }
		return [n, end]
	}
	end = at
	while end <= #source and json_number_char(source#end) { end += 1 }
	digits = source[at - 1..<end - 1]
	if not json_number_valid(digits) { raise json_refusal(source, "a bad number " + digits) }
	fractional = "." in digits or "e" in digits or "E" in digits
	// two returns, not one `if … then float else int` inside the list, which typed every number a float (card
	// samples-dogfood-apps: a todo id read back from JSON refused `next_id(…): int`)
	if fractional { return [float(digits), end] }
	[whole_number(digits), end]
}
// JSON's number, with JSON5's leading + and a fraction without digits on one side (+1, .5, 1.): one sign, digits, no
// leading zero, an exponent's sign only after its e (-, ++1, 1+2, 012 are none, JSONTestSuite)
json_number_valid(digits: text): bool := {
	at = 1
	n = #digits
	if at <= n and (digits#at == "-" or digits#at == "+") { at += 1 }
	whole = at
	while at <= n and is_digit(digits#at) { at += 1 }
	if at - whole > 1 and digits#whole == "0" { return no }
	some = at > whole
	if at <= n and digits#at == "." {
		at += 1
		fraction = at
		while at <= n and is_digit(digits#at) { at += 1 }
		some = some or at > fraction
	}
	if not some { return no }
	if at <= n and (digits#at == "e" or digits#at == "E") {
		at += 1
		if at <= n and (digits#at == "-" or digits#at == "+") { at += 1 }
		exponent = at
		while at <= n and is_digit(digits#at) { at += 1 }
		if at == exponent { return no }
	}
	at > n
}
whole_number(digits: text): int := {
	at = 1
	negative = digits#1 == "-"
	if negative or digits#1 == "+" { at = 2 }
	n = 0
	while at <= #digits {
		n = n * 10 + ord(digits#at) - 48
		at += 1
	}
	if negative then 0 - n else n
}
// a \uXXXX escape at the backslash: [its text, the place after]; the 4 hex digits (either case) are read by code point,
// not by character, so a combining mark after them (\u0000 then U+0301) stays a mark of its own; a high surrogate
// with a low one after it is one character (\ud83d\ude00 is 😀); a lone surrogate raises, as warp texts are UTF-8
// (python's json.loads keeps it as a lone code point)
json_unicode_read(source: text, at: int): list := {
	h = json_hex_at(source, at)
	code = h[0]
	next = at + 6
	if code >= 0xDC00 and code < 0xE000 { raise json_refusal(source, "a lone low surrogate \\u" + json_hex4(code)) }
	if code >= 0xD800 and code < 0xDC00 {
		if h[1] != "" or next + 1 > #source or source#next != "\\" or source#(next + 1) != "u" { raise json_refusal(source, "a lone high surrogate \\u" + json_hex4(code)) }
		l = json_hex_at(source, next)
		if l[0] < 0xDC00 or l[0] >= 0xE000 { raise json_refusal(source, "a lone high surrogate \\u" + json_hex4(code)) }
		return [chr(0x10000 + (code - 0xD800) * 1024 + l[0] - 0xDC00) + l[1], next + 6]
	}
	[chr(code) + h[1], next]
}
// the value of the 4 hex digits after a \u at the backslash, and the code points past them in the same character
json_hex_at(source: text, at: int): list := {
	points = [ord(p) for p in source[at + 1..<at + 5].codepoints]
	if count(points) < 4 { raise json_refusal(source, "a \\u escape needs 4 hex digits") }
	n = 0
	for i in 0 ..< 4 {
		d = points[i]
		digit = if d >= 48 and d <= 57 then d - 48 else if d >= 97 and d <= 102 then d - 87 else if d >= 65 and d <= 70 then d - 55 else -1
		if digit < 0 { raise json_refusal(source, "a \\u escape needs 4 hex digits") }
		n = n * 16 + digit
	}
	[n, join([chr(points[i]) for i in 4 ..< count(points)], "")]
}
json_hex4(code: int): text := join([HEX_DIGITS[(code /! (16 ** k)) % 16] for k in [3, 2, 1, 0]], "")
// a bare word, a JSON5 key or a literal: up to a space or a character of JSON's syntax
json_word_read(source: text, at: int): list := {
	end = at
	while end <= #source and source#end not in JSON_WORD_ENDS and source#end not in JSON_SPACE { end += 1 }
	if end == at { raise json_refusal(source, "unexpected " + source#at) }
	[source[at - 1..<end - 1], end]
}

// the JSON text of a value, an instance its fields; exact refuses a fraction it can't write so
json_written(value: any, exact: bool): text := {
	if value == ø { return "null" }
	if value is bool { return if value then "true" else "false" }
	if value is int { return "" + value }
	if value is number { return json_number(value, exact) }
	if value is text or value is codepoint { return json_quoted("" + value) }
	if value is symbol { return json_quoted(value.name) }
	written = (part => json_written(part, exact))
	if value is map or (value is key and type(value).name not in KEY_TYPES) { return json_fields(value, written) }
	if value is key { return json_code_key(value, written) }
	if value is list { return json_list(value, written) }
	json_quoted("" + value)
}
// a fraction as its decimal digits when it ends, `-1/8` is -0.125, else as the float nearest it
json_number(value: any, exact: bool): text := {
	spelled = "" + value
	if "/" not in spelled { return spelled }
	if exact { raise "JSON has no exact " + spelled + ": it cannot be written as JSON exactly" }
	"" + float(value)
}
// a text as a JSON string (RFC 8259 section 7): " and \\ escaped, U+0000-U+001F as the short escapes \\b \\f \\n \\r \\t
// or else \\u00xx in lowercase hex (as python's json.dumps), a CRLF (one character in warp) as \\r\\n; anything else,
// DEL and non-ASCII included, as itself. The parts collect in a list joined once, a run of plain characters as one
// slice (cards lib-perf-bench, lib-json-ctrl-and-builders; core-text-append-cost)
json_quoted(source: text): text := {
	if #source <= 32 {
		quoted = "\""
		for character in source { quoted += if json_plain(character) then character else json_escape(character) ?? character }
		return quoted + "\""
	}
	parts = ["\""]
	plain = 0
	i = 0
	for character in source {
		escape = if json_plain(character) then ø else json_escape(character)
		if escape != ø {
			if i > plain { parts.add(source[plain ..< i]) }
			parts.add(escape)
			plain = i + 1
		}
		i += 1
	}
	if i > plain { parts.add(source[plain ..< i]) }
	parts.add("\"")
	join(parts, "")
}
// a character that stands as itself without a lookup: not a control, " or \\ (the common case, checked first)
json_plain(character: any): bool := ord(character) >= 32 and character != "\"" and character != "\\"
// the escape of one character, ø when it stands as itself; a character of several code points (a CRLF) escapes each
json_escape(character: any): any := {
	escape = JSON_ESCAPES.get("" + character)
	if escape != ø { return escape }
	if ord(character) >= 32 { return ø }
	points = [ord(p) for p in ("" + character).codepoints]
	if count(points) == 1 { return json_control(points[0]) }
	join([if p < 32 then json_control(p) else (JSON_ESCAPES.get(chr(p)) ?? chr(p)) for p in points], "")
}
json_control(code: int): text := {
	if code == 8 { return "\\b" }
	if code == 9 { return "\\t" }
	if code == 10 { return "\\n" }
	if code == 12 { return "\\f" }
	if code == 13 { return "\\r" }
	"\\u00" + HEX_DIGITS[code /! 16] + HEX_DIGITS[code % 16]
}
// a map's entries, an instance's fields, as an object
json_fields(value: any, written: function): text := "{" + value.keys.map(key => json_quoted(json_key(key)) + ":" + written(value[key])).join(",") + "}"
json_key(key: any): text := if key is text then key else if key is symbol then key.name else "" + key
// [[key, its JSON], …] as an object
json_object(entries): text := "{" + entries.map(entry => json_quoted(entry#1) + ":" + entry#2).join(",") + "}"
// code: an entry `a: 1` an object, an operation its operator and operands, `not x` {"not":["x"]}
json_code_key(n: any, written: function): text := {
	if n.op in JSON_ENTRY_OPERATORS { return json_object([[json_key(n.key), written(n.value)]]) }
	"{" + json_quoted(n.op) + ":[" + [n.key, n.value].filter(side => side != ø).map(written).join(",") + "]}"
}
// code in curly braces an object, its items without a key numbered by their place; a group of one its item; any
// other list an array
json_list(n: any, written: function): text := {
	if n.bracket == "(" and #n == 1 { return written(n#1) }
	if n.bracket != "{" { return "[" + n.map(written).join(",") + "]" }
	entries = []
	for item in n {
		if item is key and item.op in JSON_ENTRY_OPERATORS { entries += [[json_key(item.key), written(item.value)]] }
		else { entries += [["" + #entries, written(item)]] }
	}
	json_object(entries)
}
