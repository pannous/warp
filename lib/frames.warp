// The standard module frames (decision on-frame-headless): `on frame {…}` (extensions/sugar/events.warp) runs each frame of
// the window, the native warp's (lib/native_window.warp) until it closes, its paintings shown in it. Without a window
// (WARP_NO_WINDOW, CI, no SDL3) the frame runs once after the program, the window a small one, so a program
// painting each frame paints one PNG at that size (the prelude's paint_each samples a painted function down to it)
HEADLESS_FRAME_WIDTH = 240
HEADLESS_FRAME_HEIGHT = 135
rewrite listen(data frame, $listener, $once) => frame_listened($listener, $once)
// `on exit {…}` runs once the program and its frames are done, the program's value kept
rewrite listen(data exit, $listener, $once) => exit_listened($listener, $once)

frame_listened(listener: function, once: bool): int := listen(data frame, listener, once)
exit_listened(listener: function, once: bool): int := listen(data exit, listener, once)
exits_end(value: any = ø) := {
	emitted(data exit, ø)
	value
}
// the frames after the program, its last value kept: each of the window's while it is open, one without a window
frames_end(value: any = ø) := {
	set_system_value("window_open", 1)
	if window_open() {
		while window_open() { emitted(data frame, ø) }
		return value
	}
	set_system_value("window_width", HEADLESS_FRAME_WIDTH)
	set_system_value("window_height", HEADLESS_FRAME_HEIGHT)
	painting_headless_frame = yes
	emitted(data frame, ø)
	painting_headless_frame = no
	value
}
