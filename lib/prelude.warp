// The prelude (notes/stdlib.md §8): words every program has without `use`; only those it calls come along.
// Each is `name(parameters) := body` (modules::prelude_word_arity reads the parameters); library_words maps other
// spellings and method forms onto them (`isdigit(c)`, `xs.first()`, `round(x, 2)` → round_to)

// The words warp computes itself, the emitter's runtime functions, with their signatures (decision
// foreign-signature, `from warp`); a parameter with a default may be left out (`s.split` splits at spaces). A word
// of several lines is overloaded by its first parameter's type, whose line gives the call's result (card typed-builtins)
upper(t: text): text from warp
lower(t: text): text from warp
reverse(xs: list): list from warp
reverse(t: text): text from warp
sort(xs: list): list from warp
sort(t: text): text from warp
split(t: text, separator: text = ø): list of text from warp
join(xs: list, separator: text): text from warp
chars(t: text): list of text from warp
code_point_list(t: text): list of int from warp
ord(c: codepoint): int from warp
map_keys(m: map): list from warp
map_values(m: map): list from warp
map_entries(m: map): list from warp
map_without(m: map, key): list from warp
map_of_entry(entry): same as entry from warp
map_get_or(m: map, key, default = ø): value of m from warp
collection_contains(xs: list, x): bool from warp
collection_contains(t: text, part): bool from warp
collection_contains(m: map, key): bool from warp
collection_position(xs: list, x): int from warp
collection_position(t: text, part): int from warp
slice(xs: list, start, end = ø): list from warp
slice(t: text, start, end = ø): text from warp
field_with(object, name, value): same as object from warp
instance_copy(x, shallow): same as x from warp
wasi_environment(): text from warp
kind_mark(x: any): int from warp

// The builtins the emitter expands in place, without a runtime function (card typed-builtins): their signatures and
// results, as the analyzer reads them
count(xs: list): int from emitter
count(t: text): int from emitter
count(m: map): int from emitter
byte_size(x): int from emitter
type(x): symbol from emitter
print(values...): nothing from emitter
fetch(url: text, options...): text from emitter
// the builtin methods of lists, texts and maps (members.rs), each a function value like the others (card dir-lists)
// over a text they take its characters; a map has no overload (`map(m, f)` would see its entries)
map(xs: list, f: function): list from emitter
map(t: text, f: function): list from emitter
filter(xs: list, f: function): list from emitter
filter(t: text, f: function): list from emitter
reduce(xs: list, f: function): element of xs from emitter
fold(xs: list, start, f: function): same as start from emitter
any(xs: list, f: function): bool from emitter
any(t: text, f: function): bool from emitter
// all of any value: `f(all xs)` broadcasts (wiki/all.md), a typed `all` would nest as a call of two values
all(xs, f: function): bool from emitter
find(xs: list, f: function): element of xs from emitter
find(t: text, f: function): element of t from emitter
each(xs: list, f: function) from emitter
each(t: text, f: function) from emitter
// the call form of xs.add(x), which lib/sugar/methods.warp appends in place (the emitter has no call add)
add(xs, x) := { xs.add(x); xs }
insert(xs: list, at: int, x) := list_insert(xs, at, x)
remove(xs: list, x) from emitter
remove(m: map, key) from emitter
pop(xs: list): any := list_pop(xs)
clear(xs: list): same as xs from emitter
number(x): number from emitter
// the calls lowering passes write: a list changed in place, a removed map value or list, a list ordered by keys
list_become(place, fresh): same as place from emitter
list_drop_last(place): same as place from emitter
removed_value(x, k): any from emitter
list_sorted_by(xs, keys): any from emitter
str(x): text from emitter
text_form(x): text from emitter
int(x): int from emitter
float(x): float from emitter
symbol(name): symbol from emitter
// the emitter's text builtins
trim(t: text): text from emitter
starts_with(t: text, part): bool from emitter
ends_with(t: text, part): bool from emitter
byte_slice(t: text, start, end): text from emitter
// a program's int type (core/passes/int_types.warp): `x as Color` marks x, `x is Color` reads its mark
int_marked(x, kind: int): any from emitter
int_mark_of(x): int from emitter
chr(code): codepoint from emitter
read(path): text from emitter
warning(message): text from emitter
raise(message): same as message from emitter
error(message): any from emitter
is_error(x): bool from emitter
is_type(x, type_name): bool from emitter
// a node's parts and a node made of parts (wiki/node.md)
key_of(n): any from emitter
value_of(n): any from emitter
op_of(n): any from emitter
name_of(n): any from emitter
bracket_of(n): any from emitter
separator_of(n): any from emitter
line_of(n): any from emitter
column_of(n): any from emitter
attributes_of(n): list from emitter
with_attribute(n, word): any from emitter
bracketed(n, bracket): list from emitter
separated(n, separator): list from emitter
string(x): text from emitter

// Other spellings of the built-in and prelude words (wiki/alias.md): `sorted(xs)`, `xs.contains(x)`, `t.strip()`
alias warn = warning
alias tuple = list
// decision nat-and-int: a fraction is a rational
type fraction = rational
alias keys = map_keys
alias values = map_values
alias contains = collection_contains
alias has = collection_contains
alias includes = collection_contains
alias get = map_get_or
// P35 default: `xs.index_of(x)` is the 1-based position (0 when absent)
alias index_of = collection_position
// card of-in-chain: `t.characters`, `characters in t`; a glyph is a character too; decision text-unit-plurals:
// `t.graphemes`, `t.codepoints` are the lists
alias characters = chars
alias glyphs = chars
alias graphemes = chars
alias codepoints = code_point_list
alias uppercase = upper
alias lowercase = lower
// the text builtin trim, Python's strip
alias strip = trim
alias reversed = reverse
alias size = count
alias len = count
alias length = count
alias sorted = sort
alias clone = copy
alias ordinal = ord
alias codepoint = ord
alias isdigit = is_digit
alias average = mean
alias is_letter = is_alpha
alias isalpha = is_alpha
alias is_alnum = is_alphanumeric
alias isalnum = is_alphanumeric
alias is_whitespace = is_space
alias isspace = is_space
// C's put words, as print: puts and putf answer 0 as C's puts does, puti and putl their number
puts(t) := { print t; 0 }
puti(n: int) := { print n; n }
putl(n: int) := { print n; n }
putf(x: float) := { print x; 0 }
first(xs) := xs#1
last(xs) := xs#(count(xs))
// decision byte-index-of: a text names the unit it counts a part's place in: `"a👍🏽b".find "b"` is the position 3
// (characters from 1, like t#p), `"a👍🏽b".byte_index_of "b"` the offset 9 (bytes from 0); a missing part is an error
find(t: text, part: text) := count(split(t, present_part(t, part))#1) + 1
byte_index_of(t: text, part: text) := byte_size(split(t, present_part(t, part))#1)
present_part(t: text, part: text) := { if not (part in t) { raise "ValueError: \"" + part + "\" is not in \"" + t + "\"" }; part }
// Python's `list(x)`: the list itself, a text's characters
as_list(x) := x as list
// `count x in y`, `y.count(x)`: how often x occurs as an item of a list or a character of a text, and how often part
// occurs in a text, not overlapping: count_of("banana", "an") is 2; # counts, so a program's own count leaves them be
count_item(xs, x) := #filter(xs, item => item == x)
count_of(t, part) := #split(t, part) - 1
// the count of x in y, written `count(y, x)` or `y.count(x)` (arity_variants; `count x in y` counts a yes/no, refused): of a text its parts,
// else its items; its own name, so `count xs` stays the emitter's count
count_in(y, x) := if y is text then count_of(y, "" + x) else count_item(y, x)
// the first or last n items (fewer when xs has fewer): `xs.first(3)`, `first 3 of xs`
first_items(xs, n) := xs[0: min(n, count(xs))]
last_items(xs, n) := xs[max(count(xs) - n, 0): count(xs)]
// x rounded to that many digits after the point
round_to(x, places) := round(x * 10 ^ places) / 10 ^ places
// The laws of the operators a fold combines with (card sum-plain-fold): each one is associative, so the compiler may
// regroup, fuse and split any fold of it, whatever the word calling it is named, and the identity starts the fold
operator_laws = {"+": {associative: yes, identity: 0}, "*": {associative: yes, identity: 1}, and: {associative: yes, identity: yes}, or: {associative: yes, identity: no}, max: {associative: yes}, min: {associative: yes}}
// the sum of the items, a fold like any other: a program's own sum replaces it (the Rust compiler still expands its
// own sum: rust-harness:src/lowering/words/library_words.rs)
sum(xs: list) := fold(xs, 0, +)
// dir(v) of a value only the run knows (lib/sugar/reflection.warp gives the words of a list, a text and a map): a map's
// keys, then its words (decision dir-map-keys-first), a list's or a text's words, none of a number
dir_of_value(x, list_words, text_words, map_words) := if x is map then x.keys + map_words else if x is list then list_words else if x is text then text_words else []
// a range's sum in closed form, Gauss's count · (first + last) / 2, the even factor halved first so the product stays small.
// The template names no helper word (card after-sum): it lands in the program's code, where a program's own word of
// that name (`range_sum(a, b) := sum(a..b)`) would be called instead, and every lane emits its arithmetic
rewrite sum($first to $last) => (if $last < $first then 0 else if ($last - $first + 1) % 2 == 0 then (($last - $first + 1) /! 2) * ($first + $last) else ($last - $first + 1) * (($first + $last) /! 2))
rewrite sum($first .. $end) => (if $end <= $first then 0 else if ($end - $first) % 2 == 0 then (($end - $first) /! 2) * ($first + $end - 1) else ($end - $first) * (($first + $end - 1) /! 2))
// `ys = 2 floats`: a list of 2 floats, as `ys = float[2]` (warp fix writes the count first, card fix-in-lib)
rewrite $n floats => float[$n]
rewrite $n ints => int[$n]
// paint(f, width, height) of a program function f(x, y) (card warp-to-shaders, decision shaders-in-lib): the WGSL shader
// that wgsl_shader of lib/wgsl.warp compiles f to, the program values it reads the values of paint, read again
// at each paint; on the GPU, else f of each pixel on the CPU, by paint_shader below. shader_of(f) is the text of that
// shader. Rules of the prelude, so they meet paint before arity_overloads names its overloads, in every program
rewrite paint($f, $w, $h) => paint_shader($painting, $w, $h, $f) where $f is symbol and $f is function and $painting = wgsl_painting($f, $program)
rewrite shader_of($f) => $shader where $f is symbol and $f is function and $shader = wgsl_shader($f, $program)
// a paint of a shader the program assigns reads its holes from the variables of their names (lib/wgsl.warp shader_values)
rewrite paint($s, $w, $h, $v) => paint($s, $w, $h, $filled) where $s is symbol and $filled = shader_values($s, $v, $program)
rewrite paint($s, $w, $h) => paint($s, $w, $h, $filled) where $s is symbol and $filled = shader_values_of($s, $program)
rewrite paint($s) => paint($s, view_width(), view_height(), $filled) where $s is symbol and $filled = shader_values_of($s, $program)
// a list the program makes for the GPU (gpu_compute takes it) is made as a GPU list [f32] (decision gpu-bound-floats,
// lib/rule_words.warp gpu_lists_packed): f32 cells in linear memory the GPU reads and writes where they are; `xs: [f32] = …` asks
// for one outright
rewrite $p => $q where program and $q = gpu_lists_packed($p)
// (this rule needs gpu_compute, so the prelude's rules, the one above too, come with any program calling it)
rewrite gpu_compute($s, $v, $n) => gpu_compute($s, $made, $n) where $made = gpu_list_made($v)
rewrite ($xs: [f32] = $v) => ($xs = $packed) where $packed = gpu_packed($v)
// the arithmetic mean, also spelled average
mean(xs) := sum(xs) / count(xs)
// the UTF-8 bytes of a text, `t.bytes` (decision text-unit-plurals)
bytes(t: text) := (0..byte_size(t)).map(at => byte_at(t, at))
// x↑n, Knuth's up arrow, is the power and x↓b the log of x to base b (card easy-add): operators of numbers only, so
// another type declares its own `infix operator ↑(v: V, n: int) := …`
infix operator ↑(x: number, n: number) := x ^ n
infix operator ↓(x: number, b: number) := log(x, b)
replace(t, old, with new) := join(split(t, old), new)
// ASCII character tests; a character compares by its code point
is_digit(c) := c >= '0' and c <= '9'
is_alpha(c) := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
is_alphanumeric(c) := is_alpha(c) or is_digit(c)
is_space(c) := c == ' ' or c == '\t' or c == '\n' or c == '\r'
is_hex_digit(c) := is_digit(c) or (lower(c) >= 'a' and lower(c) <= 'f')
is_word_char(c) := is_alphanumeric(c) or c == '_'
// at least one character, each passing is_class: consists_of("42", is_digit)
consists_of(t: text, is_class) := { if t is empty { return false }; for c in t { if not is_class(c) { return false } }; true }
// a whole number, optionally signed: "-3"
is_integer(t: text) := consists_of(remove_prefix(t, "-"), is_digit)
// a hole's text fits its type in a text pattern: `"/users/" + id: int`, `"v" + n: digits`, `c: letter + "!"`
fits_text_type(t: text, type: text) := match type {
	"int" | "integer" => is_integer(t)
	"number" | "float" => { parts = split(t, "."); count(parts) <= 2 and is_integer(parts#1) and (count(parts) == 1 or consists_of(parts#2, is_digit)) }
	"digit" => count(t) == 1 and is_digit(t)
	"digits" => consists_of(t, is_digit)
	"letter" => count(t) == 1 and is_alpha(t)
	"letters" => consists_of(t, is_alpha)
	"hex" => consists_of(t, is_hex_digit)
	"space" => consists_of(t, is_space)
	"word" => consists_of(t, is_word_char)
	_ => true
}
// text patterns (notes/matching.md): the texts of the holes between the pieces of `"0x" + rest`, [] when t doesn't
// match (also when t is no text); the first piece is the prefix, the last the suffix, "" where the pattern starts or
// ends with a hole; each hole's text fits its type, "" for any text
text_holes(t, pieces: [text], types: [text]) := {
	if not (t is text) { return [] }
	prefix = first(pieces)
	suffix = last(pieces)
	if count(t) < count(prefix) + count(suffix) or not starts_with(t, prefix) or not ends_with(t, suffix) { return [] }
	rest = t[count(prefix): count(t) - count(suffix)]
	holes = []
	for piece in pieces[1: count(pieces) - 1] {
		at = index_of(rest, piece)
		if at == 0 { return [] }
		holes = holes + [rest[0: at - 1]]
		rest = rest[at - 1 + count(piece):]
	}
	holes = holes + [rest]
	for i in 1 to count(holes) { if not fits_text_type(holes#i, types#i) { return [] } }
	holes
}
// the digits of n in a base up to 36, letters past 9 (upper: true capitals): to_base(255, 16) is "ff",
// from_base("ff", 16) is 255; a digit is its code point ('0' is 48, 'A' 10 + 55, 'a' 10 + 87), not an index into a text of
// symbols, which needs the grapheme runtime
to_base(n: int, base: int, upper = false) := { if n == 0 { return "0" }; out = ""; rest = abs(n); while rest > 0 { digit = rest % base; out = (digit + (if digit < 10 then 48 else if upper then 55 else 87)) as char + out; rest = rest /! base }; if n < 0 then "-" + out else out }
from_base(t: text, base: int) := { symbols = "0123456789abcdefghijklmnopqrstuvwxyz"; out = 0; for c in lower(t) { out = out * base + index_of(symbols, c) - 1 }; out }
// how an int shown in hex or binary prints (cards hex-printing, binary-int): hex_text(255) is "0xFF", binary_text(-5)
// "-0b101"; the printer of such values calls them (wasm_emitter/numbers/radix.rs)
radix_text(n: int, base: int, prefix: text) := (if n < 0 then "-" else "") + prefix + to_base(abs(n), base, upper: true)
hex_text(n: int) := radix_text(n, 16, "0x")
binary_text(n: int) := radix_text(n, 2, "0b")
// a value's form as its kind field holds it (card kind-reflection, rust-harness:src/type_kinds.rs), what the lib printers read:
// the Kind in the low byte (Int 1, Text 3, Key 6, List 8, Error 11, …), the info byte above it (a key's operator, a
// list's bracket, an Int's bool 1, hex 2 or binary 3), and the mark of a type value (`int`, `type(x)`; code is
// `x is code`); the Kind and the info byte are KIND_BITS wide, the type value mark is bit 54 (TYPE_VALUE_MARK)
kind_bits() := 8
type_value_bit() := 54
kind_number(x: any) := kind_mark(x) % (1 << kind_bits())
kind_info(x: any) := (kind_mark(x) >> kind_bits()) % (1 << kind_bits())
is_type_value(x: any) := (kind_mark(x) >> type_value_bit()) % 2 == 1
// n copies of value, ø for none (list.warp fill): `n times [x]` and `int[n]` where no typed array holds them; the
// compiler calls it (wasm_emitter/lists/list_emitter.rs), so a fractional count is the error the runtime gives
filled_list(n, value: any) := { if n > floor(n) { raise "count must be an integer; fix: compute it with /! (floor division) or `… as int`" }; out = []; for i in 1 to n { out = out + [value] }; out }
// `n times {…}` runs the block n times, a plain library function (decision language-layers); `n times [x]` is n
// copies of x, `n times "ab"` the text n times, `n times x` of a number their product
infix operator times(n: int, body: block) := for i in 1 to n { body() }
infix operator times(n: int, items: list) := if #items == 1 then zero_fill(n, items#1) else { out = []; for i in 1 to n { out = out + items }; out }
infix operator times(n: int, t: text) := t * n
infix operator times(n: number, x: number) := n * x
// once, twice and thrice count as times does (decision count-words-library): a block runs, a value repeats
once(body: block) := 1 times body
once(value: any) := 1 times value
twice(body: block) := 2 times body
twice(value: any) := 2 times value
thrice(body: block) := 3 times body
thrice(value: any) := 3 times value
// how a ± value prints (card plus-minus, P219): the ± part to 2 significant digits, the value to the same place, 7.0 ± 2.0;
// a ± part of 0 or ∞, or more digits than 17, as each float prints; gaussian 1 adds σ. The printer calls it with the
// parts (wasm_emitter/numbers/uncertain.rs)
uncertain_text(value: float, radius: float, gaussian: int) := {
	sigma = if gaussian == 1 then "σ" else ""
	if not (radius > 0.0 and radius < 1.0 / 0.0) { return "\(value) ± \(radius)\(sigma)" }
	scale = 1.0
	decimals = 0
	while radius * scale < 9.5 and decimals <= 17 { scale = scale * 10.0; decimals += 1 }
	while radius * scale >= 99.5 { scale = scale / 10.0 }
	if decimals > 17 or abs(value) * scale >= 1e17 { return "\(value) ± \(radius)\(sigma)" }
	place_text(value, scale, decimals) + " ± " + place_text(radius, scale, decimals) + sigma
}
// x rounded to the place of 1/scale with that many decimals: whole units half away from zero, decimals half to even
place_text(x: float, scale: float, decimals: int) := {
	sign = if x < 0.0 then "-" else ""
	if decimals == 0 { return sign + to_base((floor(abs(x) * scale + 0.5) * round(1.0 / scale)) as int, 10) }
	digits = round(abs(x) * scale) as int
	fraction = ""
	while #fraction < decimals { fraction = (digits % 10 + 48) as char + fraction; digits = digits /! 10 }
	sign + to_base(digits, 10) + "." + fraction
}
// `x as decimal` of a ratio (card repeating-decimals): the digits before the period, then the period's overlined, 1/6
// is 0.16̅; a terminating decimal, or a period longer than 1000 digits, as the ratio prints. The cast calls it with the
// ratio's parts, the denominator never 0 (wasm_emitter/numbers/exact.rs)
decimal_text(numerator: int, denominator: int) := {
	rest = denominator; twos = 0; fives = 0
	while rest % 2 == 0 { rest = rest /! 2; twos += 1 }
	while rest % 5 == 0 { rest = rest /! 5; fives += 1 }
	if rest == 1 { return "\(numerator / denominator)" }
	// the period: the first power of ten that is 1 modulo the rest
	power = 10 % rest; period = 1
	while power != 1 and period <= 1000 { power = power * 10 % rest; period += 1 }
	if period > 1000 { return "\(numerator / denominator)" }
	before_period = if twos > fives then twos else fives
	whole = abs(numerator)
	text = (if numerator < 0 then "-" else "") + "\(whole /! denominator)."
	remainder = whole % denominator
	for digit in 1 to before_period + period {
		remainder = remainder * 10
		text = text + "\(remainder /! denominator)" + (if digit > before_period then "̅" else "")
		remainder = remainder % denominator
	}
	text
}
// x as a fraction, by its continued fraction (rust-harness:src/numbers/real.rs computes it exactly for √2, π, … written in the program):
// `within: 1e-6` the first convergent that close, a limit the closest fraction whose denominator is at most that
// (Python's limit_denominator and its default 1000000, user decision); limit 0 the exact fraction, of a float the first
// convergent that is the same float. A precision replaces the default limit (`within: 1e-40` reaches beyond it)
nearest(x, kind, limit = 1000000, within = 0) := {
	p0 = 0; q0 = 1; p1 = 1; q1 = 0; rest = x
	cap = if within > 0 and limit == 1000000 then 0 else limit
	while true {
		a = floor(rest) as int
		q2 = q0 + a * q1
		if cap > 0 and q2 > cap {
			// the closer of the last convergent and the semiconvergent with the largest denominator in the limit
			k = (cap - q0) /! q1
			below = (p0 + k * p1) / (q0 + k * q1)
			above = p1 / q1
			return if abs(above - x) <= abs(below - x) then above else below
		}
		p2 = p0 + a * p1
		p0 = p1; q0 = q1; p1 = p2; q1 = q2
		fraction = p1 / q1
		// a float stops at the first fraction that is the same float: its continued fraction beyond is noise
		is_same_float = x is float and float(p1) / q1 == x
		if rest == a or is_same_float or (within > 0 and abs(fraction - x) <= within) { return fraction }
		rest = 1 / (rest - a)
	}
}
// Python's dict(pairs) (card python-stdlib): a map of [key value] pairs
dict(pairs) := { out = {}; for pair in pairs { out[pair#1] = pair#2 }; out }
// Python's dict.fromkeys(ks, value) (card python-aliases): a map of each key with the one value
fromkeys(ks, value) := { out = {}; for k in ks { out[k] = value }; out }
// Python's xs.pop(i) and m.pop(k) (card python-aliases, declaration_lowering removed_key): the element at the 0-based
// position i (-1 the last) or the value of the key k, and the list or map without it
popped_position(xs, i) := if i < 0 then count(xs) + i + 1 else i + 1
popped_item(x, k) := if x is map then x.get(k) else x#(popped_position(x, k))
popped_rest(x, k) := if x is map then { rest = x; rest.remove(k); rest } else [x#i for i in 1 to count(x) if i != popped_position(x, k)]
// Python's xs.clear() and m.clear() (card python-aliases, declaration_lowering cleared_collection): the empty list or map
cleared(x) := if x is map then {} else []
// xs.insert(v, at: i) (list_mutations inserted_in_place): the list with v at the 0-based position i, past the end or
// before 0 at the end
inserted(xs, i: int, v: any) := if i < 0 or i >= count(xs) then xs + [v] else xs[0: i] + [v] + xs[i:]
// `a ≈ b`, and `a ~ b` when rough (notes/approximately.md): `{…}` maps key by key in any order, other lists item by item,
// pairs and instances (a class name paired with its fields) part by part, each with the same comparison again; two
// other values by the runtime's values_similar or values_rough. Two plain numbers never get here: they compare inline
alike(a: any, b: any, tolerance: float, rough: bool) := {
	if bracket_of(a) == "{" and bracket_of(b) == "{" {
		return #a == #b and keys(a).all(k => b has k and alike(a[k], b[k], tolerance, rough))
	}
	if bracket_of(a) != ø and bracket_of(a) == bracket_of(b) {
		return #a == #b and (1 to #a).all(i => alike(a#i, b#i, tolerance, rough))
	}
	if type(a) is key and type(b) is key {
		keys_alike = alike(key_of(a), key_of(b), tolerance, rough)
		return op_of(a) == op_of(b) and keys_alike and alike(value_of(a), value_of(b), tolerance, rough)
	}
	if rough then values_rough(a, b, tolerance) else values_similar(a, b, tolerance)
}
// `a .op b` where the compiler cannot tell which side is a list (broadcasting.rs, card compile-shaders): each item of
// a list with the other side, two lists paired by index, two numbers plainly; `combined` is `(l, r) => l op r`. Both
// sides are `any`: inferred from the body, one call with a number made it a list
element_wise_any(left: any, right: any, combined) := if left is list and right is list then { if count(left) != count(right) { raise "element-wise operator: the lists differ in length" }; [combined(left#i, right#i) for i in 1 to count(left)] } else if left is list then [combined(item, right) for item in left] else if right is list then [combined(left, item) for item in right] else combined(left, right)
// f of a value that may be a list (lib/sugar/broadcasting.warp): of each item of a list, else of the value itself
each_any(value: any, f) := if value is list then [f(item) for item in value] else f(value)
// a pixel of paint(f, width, height) on the CPU (gpu_maps painted_functions): a vector of 3 numbers from 0 to 1 is
// that color as 0xAARRGGBB, as the shader paints it; a number stays itself
pixel_color(v: any) := if v is list then 0xFF000000 + pixel_channel(v#1) * 65536 + pixel_channel(v#2) * 256 + pixel_channel(v#3) else v
pixel_channel(c) := round(255 * min(max(c, 0), 1)) as int
// paint(f, width, height) of a warp function on the CPU, where no shader paints it (gpu_maps painted_functions): f(column,
// row) of every pixel, row by row; in a frame without a window (lib/frames.warp frames_end) at most the window's size,
// f sampled across the size asked
global painting_headless_frame = no
paint_each(f, width, height) := {
	columns = if painting_headless_frame then min(width, window_width(), window_height() * width /! height) else width
	rows = columns * height /! width
	paint([pixel_color(f((i % columns) * width /! columns, (i /! columns) * height /! rows)) for i in 0..columns * rows], columns, rows)
}
// paint(pixels, width, height) of a list of pixels, row by row, as the host paints them; of a function, f(column, row)
// of each pixel on the CPU (paint_each)
paint(picture, width, height) := if picture is list then paint(picture, width, height, ø) else paint_each(picture, width, height)
// paint(f, width, height) of a program function: its shader on the GPU, else f of each pixel on the CPU (the rules
// at the sum rules above)
paint_shader(painting: map, width, height, f) := if gpu_paints() then paint(painting.shader as text, width, height, shader_values(painting.uniform)) else paint_each(f, width, height)
// the program values a shader reads as the plain floats it takes: a quantity by its amount in SI base units, an angle in
// radians, each item of a vector (decision no-units-in-shaders: a shader ignores units)
shader_values(values) := {
	if values == ø { return ø }
	plain = {}
	for name in values.keys { plain[name] = shader_value(values[name]) }
	plain
}
shader_value(value) := if value is list then value.map(shader_value) else float(value)
// paint(shader) of a WGSL shader text, at the view's size (wiki/graphics.md)
paint(shader: text) := paint(shader, view_width(), view_height(), ø)
// sleep 0.2, sleep(t): a bare number is seconds (decision sleep-seconds); `sleep 20ms` the compiler folds into sleep_ms
sleep(amount) := sleep_ms(amount * 1000)
// random(a, b) (decision random-forms): of whole numbers a whole number from a to b, both included (random(1, 6) rolls
// a die), else a float in [a, b); random a..b one of the range's elements, a to b-1
random_fraction(a, b) := a + random() * (b - a)
random_until(a, b) := if a is int and b is int then a + random_below(b - a) else random_fraction(a, b)
random_between(a, b) := if a is int and b is int then random_until(a, b + 1) else random_fraction(a, b)
// random(x) by the value's type (card random-dispatches): of a list one of its elements, of a whole number n one of 0…n-1,
// of a fraction a float from 0 up to it
random_element(xs) := xs#(random_below(count(xs)) + 1)
random_of(x) := if x is list then random_element(x) else random_of_type(x)
// random int, random bool, random codepoint, random float: a random value of the type, before a whole number n (0…n-1)
// and a fraction (a float below it)
random_of_type(x) := {
	if x == int { return random_int() }
	if x == bool { return random_bool() }
	if x == codepoint { return random_codepoint() }
	if x == float { return random() }
	if x is int then random_below(x) else random_fraction(0, x)
}
// random int, random bool, random codepoint: a random value of the type; random int spans the whole 64-bit range
random_int() := (random_below(0x100000000) - 0x80000000) * 0x100000000 + random_below(0x100000000)
random_bool() := random_below(2) == 1
// a Unicode scalar value: the surrogates 0xD800…0xDFFF are no characters
random_codepoint() := { n = random_below(0x110000 - 0x800); if n >= 0xD800 then n = n + 0x800; n as codepoint }
// random(x), random(a, b): the dispatch above; random() itself is the host's float in [0, 1)
random(x) := random_of(x)
random(a, b) := random_between(a, b)
// the machine's readings, read now by the host word system_value (Rust: lowering/signals/system_values.rs,
// rust-harness:crates/warp-runtime host_words.rs SYSTEM_VALUES): a yes/no one is a reading other than 0, the mouse's place a float; a
// program's own name of the same word wins
battery() := system_value("battery")
charging() := system_value("charging") != 0
online() := system_value("online") != 0
mouse_x() := system_value("mouse_x") as float
mouse_y() := system_value("mouse_y") as float
mouse_down() := system_value("mouse_down") != 0
mouse_wheel() := system_value("mouse_wheel")
key_down() := system_value("key_down") != 0
window_open() := system_value("window_open") != 0
view_width() := system_value("view_width")
view_height() := system_value("view_height")
gpu_drawing() := system_value("gpu_drawing") != 0
gpu_paints() := system_value("gpu_paints") != 0
window_width() := system_value("window_width")
window_height() := system_value("window_height")
display_width() := system_value("display_width")
display_height() := system_value("display_height")
display_dpi() := system_value("display_dpi")
// the paint window's size (the playground: the paintings' frame), system values, so `whenever window.width > 800 {…}`
// listens; written, the window resizes
window.width := window_width
window.width(new_width) := set_system_value("window_width", new_width)
window.height := window_height
window.height(new_height) := set_system_value("window_height", new_height)
// a program cannot resize the display: set window.width or canvas.width instead
display.width := display_width
display.height := display_height
// the device pixels per length (decision display-names, other names display.dpi and display.ppi), a quantity in dpi
// that turns lengths into px, `3 cm * display.density`; a program sets it in dpi, `display.density = 300 dpi`
display.density := display_dpi * 1dpi
display.density(density) := set_system_value("display_dpi", density / 1dpi)
// width × height in px (other names display.dimensions and display.resolution)
display.size := [display_width, display_height] px
// the diagonal as a length: its nearest whole px at the density (quantities run as exact amounts, a run-time √ is a
// float)
display.diagonal := round(√(display_width² + display_height²)) * 1px / (display_dpi * 1dpi)
// The fields of a time at run time (card time-fields-warp, notes/dates_at_run_time.md), called late by the emitter's
// time_field with the time's form (TimeForm: 1 a date, its position in days; else nanoseconds since 1970), its wall
// clock position, its zone's seconds east of UTC (not `offset`: the index type's synonym) and the index of the field in times.rs TIME_FIELDS
time_field_of(form: int, wall: int, zone_seconds: int, field: int): int := {
	days = time_days(form, wall)
	nanos = time_nanos(form, wall)
	match field {
		0 => civil_year(days)
		1 => civil_month(days)
		2 => civil_day(days)
		// ISO weekday: 1970-01-01 was a Thursday, Monday is 1
		3 => floor_mod(days + 3, 7) + 1
		4 => days - days_from_civil(civil_year(days), 1, 1) + 1
		5 => nanos /! 3600000000000
		6 => nanos /! 60000000000 % 60
		7 => nanos /! 1000000000 % 60
		8 => days * 86400 + nanos /! 1000000000
		9 => zone_seconds
		// the time of day in whole seconds, as calendar::Time::part: 22:27:46
		10 => nanos /! 1000000000 * 1000000000
		_ => days
	}
}
// time_parts(form, position): the calendar day of a position and the nanoseconds into it; a date has no clock
time_days(form: int, position: int): int := if form == 1 then position else position /! 86400000000000
time_nanos(form: int, position: int): int := if form == 1 then 0 else floor_mod(position, 86400000000000)
floor_mod(n: int, divisor: int): int := n - n /! divisor * divisor
// Howard Hinnant's calendar over day numbers (days since 1970-01-01, proleptic Gregorian), the one warp copy of
// rust-harness:src/time/calendar.rs days_from_civil / civil_from_days (card civil-days-dup); lib/time.warp builds on it.
// civil_from_days: eras of 400 years from 0000-03-01, a year from March
civil_era(days: int): int := (days + 719468) /! 146097
civil_day_of_era(days: int): int := days + 719468 - civil_era(days) * 146097
civil_year_of_era(day_of_era: int): int := (day_of_era - day_of_era /! 1460 + day_of_era /! 36524 - day_of_era /! 146096) /! 365
civil_day_of_year(day_of_era: int): int := {
	year_of_era = civil_year_of_era(day_of_era)
	day_of_era - (365 * year_of_era + year_of_era /! 4 - year_of_era /! 100)
}
// the month counted from March: months 10 and 11 of the year are January and February
civil_march_month(day_of_year: int): int := (5 * day_of_year + 2) /! 153
civil_month(days: int): int := {
	march_month = civil_march_month(civil_day_of_year(civil_day_of_era(days)))
	if march_month < 10 then march_month + 3 else march_month - 9
}
civil_day(days: int): int := {
	day_of_year = civil_day_of_year(civil_day_of_era(days))
	day_of_year - (153 * civil_march_month(day_of_year) + 2) /! 5 + 1
}
civil_year(days: int): int := {
	year = civil_year_of_era(civil_day_of_era(days)) + civil_era(days) * 400
	if civil_month(days) <= 2 then year + 1 else year
}
// the date of a day number as {year, month, day}
civil_from_days(day_count: int) := {year: civil_year(day_count), month: civil_month(day_count), day: civil_day(day_count)}
// the day number of a proleptic Gregorian date
days_from_civil(year: int, month: int, day: int): int := {
	march_year = if month <= 2 then year - 1 else year
	era = march_year /! 400
	year_of_era = march_year - era * 400
	march_month = if month > 2 then month - 3 else month + 9
	day_of_year = (153 * march_month + 2) /! 5 + day - 1
	era * 146097 + year_of_era * 365 + year_of_era /! 4 - year_of_era /! 100 + day_of_year - 719468
}
// the check of the Rust tests' `is!("3+3", 6)`, written `is! "3+3" 6` (decision warp-is-tests): the code's value is
// the expected one, permissively: equal, or both nothing-like (0, ø, [], no); a failure says what the code gave
is!(warp: text, expected: any) := {
	got = eval(warp)
	passed = got == expected or (not got and not expected)
	if not passed then print("✗ is! \"" + warp + "\" " + str(expected) + ": got " + str(got))
	passed
}

// The class of every error (decision error-classes): `class ParseError: Error` declares one, `except Error` catches all
class Error { message: text }
# a value that lambdas share, the variable they change (core/passes/lambdas.warp shared captures, P124)
class Cell { value: any }

// Pattern matching (wiki/pattern-matching.md): the names a pattern binds in a value as a map, ø when it doesn't fit.
// The pattern is an arm's code quoted (core/passes/node_matches.warp asks for an arm of a list, tuple, map, text cut or
// `data(…)` pattern): a name binds, `_` takes anything, a type word tests the type, a value must be equal; a rest
// `...rest` takes what the other items leave; `>= 18`, `18..65` and `a | b` stand for a part. Inside `data(…)` the
// code must be the same but for its `$holes`, a hole used twice taking equal code
pattern_bindings(value: any, pattern: any): any := {
	bound = {}
	if fits_pattern(value, pattern, bound, no) then bound else ø
}
fits_pattern(value: any, pattern: any, bound: map, code: bool): bool := {
	if is_type(pattern, "symbol") { return fits_name(value, name_of(pattern), bound, code) }
	if is_type(pattern, "key") { return fits_key(value, pattern, bound, code) }
	if bracket_of(pattern) != ø { return fits_group(value, pattern, bound, code) }
	value == pattern
}
// a hole or name takes the value, the same one again where it is bound already
bound_as(value: any, name: text, bound: map): bool := {
	if name == "_" { return yes }
	if name in bound { return bound[name] == value }
	bound[name] = value
	yes
}
fits_name(value: any, name: text, bound: map, code: bool): bool := {
	if name.starts_with("$") { return bound_as(value, name[1 ..< #name], bound) }
	if code { return value == symbol(name) }
	if is_pattern_type(name) { return has_pattern_type(value, name) }
	bound_as(value, name, bound)
}
// the type words a pattern tests a value by, each with its test
pattern_types = {"int": is_int_value, "float": is_float_value, "number": is_number_value, "text": is_text_value,
	"bool": is_bool_value, "list": is_list_value, "map": is_map_value, "symbol": is_symbol_value, "key": is_key_value,
	"block": is_block_value}
is_int_value(value: any): bool := is_type(value, "int")
is_float_value(value: any): bool := is_type(value, "number") and not is_type(value, "int")
is_number_value(value: any): bool := is_type(value, "number")
is_text_value(value: any): bool := is_type(value, "text")
is_bool_value(value: any): bool := is_type(value, "bool")
is_list_value(value: any): bool := is_type(value, "list")
is_map_value(value: any): bool := is_type(value, "map")
is_symbol_value(value: any): bool := is_type(value, "symbol")
is_key_value(value: any): bool := is_type(value, "key")
is_block_value(value: any): bool := bracket_of(value) == "{"
is_pattern_type(name: text): bool := name in pattern_types
has_pattern_type(value: any, name: text): bool := pattern_types[name](value)
fits_key(value: any, pattern: any, bound: map, code: bool): bool := {
	op = op_of(pattern)
	left = key_of(pattern)
	right = value_of(pattern)
	if op == ":" and is_type(left, "key") and op_of(left) == "+" { return fits_text_cut(value, text_pieces(left), right, bound) }
	// `x: int`, `$k: int`, `$n: > 0`: the part fits the condition, and the name takes it
	if op == ":" and is_type(left, "symbol") { return fits_pattern(value, right, bound, no) and fits_name(value, name_of(left), bound, code) }
	if op == "|" or op == "or" { return fits_pattern(value, left, bound, code) or fits_pattern(value, right, bound, code) }
	if op == "+" and is_type(left, "text") and not code { return fits_text_cut(value, text_pieces(pattern), ø, bound) }
	// `not p`, `!= x` (read as `not == x`): the part does not fit p, binding nothing
	if op == "not" and left == ø and not code { return not fits_pattern(value, right, {}, no) }
	if left == ø and not code { return compares(value, op, right) }
	if op == ".." and not code { return value >= left and value <= right }
	is_type(value, "key") and op_of(value) == op and fits_pattern(key_of(value), left, bound, code) and fits_pattern(value_of(value), right, bound, code)
}
// `>= 18`, `!= ""`: the comparison of the part with the limit; an order only between two numbers or two texts
comparisons = {">=": at_least, ">": above, "<=": at_most, "<": below, "!=": unequal, "==": equal}
compares(value: any, op: text, limit: any): bool := {
	if not (op in comparisons) { raise "a pattern compares by >=, >, <=, <, != or ==, not " + op }
	if op != "!=" and op != "==" and not are_ordered(value, limit) { return no }
	comparisons[op](value, limit)
}
are_ordered(a: any, b: any): bool := (is_type(a, "number") and is_type(b, "number")) or (is_type(a, "text") and is_type(b, "text"))
at_least(a: any, b: any): bool := a >= b
above(a: any, b: any): bool := a > b
at_most(a: any, b: any): bool := a <= b
below(a: any, b: any): bool := a < b
unequal(a: any, b: any): bool := a != b
equal(a: any, b: any): bool := a == b
fits_group(value: any, pattern: any, bound: map, code: bool): bool := {
	// `data(…)`: the code inside, holes and all
	if not code and bracket_of(pattern) == "(" and #pattern == 2 and pattern#1 == symbol("data") { return fits_pattern(value, pattern#2, bound, yes) }
	if bracket_of(pattern) == "{" and not code { return fits_map(value, pattern, bound) }
	if code and bracket_of(value) != bracket_of(pattern) { return no }
	if not code and not is_type(value, "list") { return no }
	fits_items(value, pattern, bound, code)
}
// the items, a rest among them taking those the others leave, the items after it counted from the end
fits_items(value: any, pattern: any, bound: map, code: bool): bool := {
	rest = 0
	for i in 0..<#pattern { if rest == 0 and is_rest_item(pattern#(i + 1)) { rest = i + 1 } }
	if rest == 0 {
		if #value != #pattern { return no }
		for i in 0..<#pattern { if not fits_pattern(value#(i + 1), pattern#(i + 1), bound, code) { return no } }
		return yes
	}
	after = #pattern - rest
	if #value < rest - 1 + after { return no }
	for i in 0..<(rest - 1) { if not fits_pattern(value#(i + 1), pattern#(i + 1), bound, code) { return no } }
	for i in 0..<after { if not fits_pattern(value#(#value - after + i + 1), pattern#(rest + i + 1), bound, code) { return no } }
	taken = []
	for i in (rest - 1)..<(#value - after) { taken += [value#(i + 1)] }
	fits_rest(taken, pattern#rest, bound, code)
}
// `...rest`, `*rest`, `rest...`, `$rest...`, a bare `..`, an item pattern `[n, label]...`
is_rest_item(item: any): bool := {
	if is_type(item, "symbol") { return name_of(item).starts_with("*") }
	is_type(item, "key") and (op_of(item) == "to" or op_of(item) == "..") and value_of(item) == ø
}
fits_rest(taken: list, item: any, bound: map, code: bool): bool := {
	if is_type(item, "symbol") { return bound_as(taken, name_of(item)[1 ..< #name_of(item)], bound) }
	held = key_of(item)
	if held == ø { return yes }
	if is_type(held, "symbol") { return bound_as(taken, unmarked(name_of(held), "$"), bound) }
	// an item pattern fits each item; each of its names takes the list of its values
	fitted = []
	for item_value in taken {
		one = {}
		if not fits_pattern(item_value, held, one, code) { return no }
		fitted += [one]
	}
	for name in pattern_names(held) { bound[name] = fitted.map(one => one[name]) }
	yes
}
// the names a pattern binds, in order
pattern_names(pattern: any): list := {
	if is_type(pattern, "symbol") { return if name_of(pattern) == "_" or is_pattern_type(name_of(pattern)) then [] else [unmarked(unmarked(name_of(pattern), "$"), "*")] }
	if is_type(pattern, "key") { return pattern_names(key_of(pattern)) + (if op_of(pattern) == ":" then [] else pattern_names(value_of(pattern))) }
	if bracket_of(pattern) == ø { return [] }
	names = []
	for i in 0..<#pattern { names += pattern_names(pattern#(i + 1)) }
	names
}
// `{status: 200, data: {user: {name}}}`: the fields it names, the others ignored; `{name}` binds the field to its name
fits_map(value: any, pattern: any, bound: map): bool := {
	if not is_type(value, "map") { return no }
	for i in 0..<#pattern {
		field = pattern#(i + 1)
		if is_type(field, "symbol") {
			if not (name_of(field) in value) or not bound_as(value[name_of(field)], name_of(field), bound) { return no }
		} else if is_type(field, "key") and op_of(field) == ":" {
			name = if is_type(key_of(field), "symbol") then name_of(key_of(field)) else key_of(field)
			if not (name in value) or not fits_pattern(value[name], value_of(field), bound, no) { return no }
		} else { return no }
	}
	yes
}
// the pieces of `"/users/" + id + "/x"`, texts and holes, in order
text_pieces(pattern: any): list := if is_type(pattern, "key") and op_of(pattern) == "+" then text_pieces(key_of(pattern)) + text_pieces(value_of(pattern)) else [pattern]
// the text cut at its literal pieces, each hole taking what lies between, the last its type converting it
fits_text_cut(value: any, pieces: list, last_type: any, bound: map): bool := {
	if not is_type(value, "text") { return no }
	rest = value
	for i in 0..<#pieces {
		piece = pieces#(i + 1)
		if is_type(piece, "text") {
			if not rest.starts_with(piece) { return no }
			rest = rest[#piece ..< #rest]
		} else {
			next = if i + 1 < #pieces then pieces#(i + 2) else ø
			ends = if next == ø then #rest + 1 else rest.find(next)
			if ends == 0 { return no }
			part = rest[0 ..< ends - 1]
			rest = rest[ends - 1 ..< #rest]
			typed = if i + 1 == #pieces and last_type != ø then converted_part(part, last_type) else part
			if typed == ø or not bound_as(typed, name_of(piece), bound) { return no }
		}
	}
	rest == ""
}
// a text part as its hole's type wants it, ø when it isn't one; a type no text converts to is an error
part_conversions = {"int": int_part, "float": float_part, "number": number_part, "text": text_part}
converted_part(part: text, type_word: any): any := {
	name = name_of(type_word)
	if not (name in part_conversions) { raise "a text cut's last hole converts to int, float, number or text, not " + name }
	part_conversions[name](part)
}
is_digits(t: text): bool := t != "" and t.all(c => c >= '0' and c <= '9')
# a number's digits after its leading minus, if any: `-3`, `-2.5`
unsigned(t: text): text := if starts_with(t, "-") then slice(t, 1) else t
int_part(t: text): any := if is_digits(unsigned(t)) then int(t) else ø
float_part(t: text): any := {
	pieces = unsigned(t).split(".")
	if #pieces > 2 or not is_digits(pieces#1) or (#pieces == 2 and not is_digits(pieces#2)) { return ø }
	float(t)
}
number_part(t: text): any := if is_digits(unsigned(t)) then int(t) else float_part(t)
text_part(t: text): any := t
// the name without its mark: `$a` → a, `*rest` → rest
unmarked(name: text, mark: text): text := if starts_with(name, mark) then slice(name, #mark) else name


// Named events (lib/sugar/events.warp): each event's listeners in order, with their numbers (counted within the event
// from 1) and whether they listen once, as three lists of the same length
global event_listeners = {}
global listener_numbers = {}
global listening_once = {}
global listener_counts = {}
listen(name: any, listener: function, once: bool): int := {
	key = name_of(name)
	if not (key in event_listeners) {
		event_listeners[key] = []
		listener_numbers[key] = []
		listening_once[key] = []
		listener_counts[key] = 0
	}
	listener_counts[key] += 1
	event_listeners[key] += [listener]
	listener_numbers[key] += [listener_counts[key]]
	listening_once[key] += [once]
	listener_counts[key]
}
emitted(name: any, data: any): any := {
	key = name_of(name)
	if not (key in event_listeners) { return ø }
	running = event_listeners[key]
	kept_listeners(key, i => not listening_once[key]#i)
	result = ø
	for listener in running { result = listener(data) }
	result
}
listeners_of(name: any): list := if name_of(name) in listener_numbers then listener_numbers[name_of(name)] else []
unlisten(name: any, number: int): any := {
	key = name_of(name)
	if key in event_listeners { kept_listeners(key, i => listener_numbers[key]#i != number) }
	ø
}
// the listeners of an event at the positions keep holds for
kept_listeners(key: text, keep: function): any := {
	listeners = []
	numbers = []
	onces = []
	for i in 1 ..< #event_listeners[key] + 1 {
		if keep(i) {
			listeners += [event_listeners[key]#i]
			numbers += [listener_numbers[key]#i]
			onces += [listening_once[key]#i]
		}
	}
	event_listeners[key] = listeners
	listener_numbers[key] = numbers
	listening_once[key] = onces
	ø
}

// Python's range: `range(4)` is [0, 1, 2, 3], `range(1, 4)` [1, 2, 3]
range(stop: int): list := 0 ..< stop
range(start: int, stop: int): list := start ..< stop
