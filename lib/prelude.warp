// The prelude (notes/stdlib.md §8): words every program has without `use`; only those it calls come along.
// Each is `name(parameters) := body` (modules::prelude_word_arity reads the parameters); library_words maps other
// spellings and method forms onto them (`isdigit(c)`, `xs.first()`, `round(x, 2)` → round_to)

// The words warp computes itself, the emitter's runtime functions, with their signatures (decision
// foreign-signature, `from warp`); a parameter with a default may be left out (`s.split` splits at spaces). A word
// of several lines is overloaded by its first parameter's type, whose line gives the call's result (card typed-builtins)
upper(t: text): text from warp
lower(t: text): text from warp
reverse(xs: list): list from warp
reverse(t: text): text from warp
sort(xs: list): list from warp
sort(t: text): text from warp
split(t: text, separator: text = " "): list of text from warp
join(xs: list, separator: text): text from warp
chars(t: text): list of text from warp
code_point_list(t: text): list of int from warp
ord(c: codepoint): int from warp
map_keys(m: map): list from warp
map_values(m: map): list from warp
map_entries(m: map): list from warp
map_without(m: map, key): list from warp
map_of_entry(entry): same as entry from warp
map_get_or(m: map, key, default = ø): value of m from warp
collection_contains(xs: list, x): bool from warp
collection_contains(t: text, part): bool from warp
collection_contains(m: map, key): bool from warp
collection_position(xs: list, x): int from warp
collection_position(t: text, part): int from warp
slice(xs: list, start, end = ø): list from warp
slice(t: text, start, end = ø): text from warp
field_with(object, name, value): same as object from warp
instance_copy(x, shallow): same as x from warp
wasi_environment(): text from warp
kind_mark(x: any): int from warp

// The builtins the emitter expands in place, without a runtime function (card typed-builtins): their signatures and
// results, as the analyzer reads them
count(xs: list): int from emitter
count(t: text): int from emitter
count(m: map): int from emitter
sum(xs: list): element of xs from emitter
byte_size(x): int from emitter
type(x): symbol from emitter
print(values...): nothing from emitter
puts(t: text): int from emitter
puti(n: int): int from emitter
putl(n: int): int from emitter
putf(x: float): int from emitter
fetch(url: text, options...): text from emitter
// the builtin methods of lists, texts and maps (members.rs), each a function value like the others (card dir-lists)
// over a text they take its characters; a map has no overload (`map(m, f)` would see its entries)
map(xs: list, f: function): list from emitter
map(t: text, f: function): list from emitter
filter(xs: list, f: function): list from emitter
filter(t: text, f: function): list from emitter
reduce(xs: list, f: function): element of xs from emitter
fold(xs: list, start, f: function): same as start from emitter
any(xs: list, f: function): bool from emitter
any(t: text, f: function): bool from emitter
// all of any value: `f(all xs)` broadcasts (wiki/all.md), a typed `all` would nest as a call of two values
all(xs, f: function): bool from emitter
find(xs: list, f: function): element of xs from emitter
find(t: text, f: function): element of t from emitter
each(xs: list, f: function) from emitter
each(t: text, f: function) from emitter
add(xs: list, x): same as xs from emitter
insert(xs: list, x, at: int): same as xs from emitter
remove(xs: list, x) from emitter
remove(m: map, key) from emitter
pop(xs: list): element of xs from emitter
clear(xs: list): same as xs from emitter
number(x): number from emitter
// the calls lowering passes write: a list changed in place, a removed map value or list, a list ordered by keys
list_become(place, fresh): same as place from emitter
removed_value(x, k): any from emitter
list_sorted_by(xs, keys): any from emitter
string(x): text from emitter

// Other spellings of the built-in and prelude words (wiki/alias.md): `sorted(xs)`, `xs.contains(x)`, `t.strip()`
alias warn = warning
alias tuple = list
alias keys = map_keys
alias values = map_values
alias contains = collection_contains
alias has = collection_contains
alias includes = collection_contains
alias get = map_get_or
// P35 default: `xs.index_of(x)` is the 1-based position (0 when absent)
alias index_of = collection_position
// card of-in-chain: `t.characters`, `characters in t`; a glyph is a character too; decision text-unit-plurals:
// `t.graphemes`, `t.codepoints` are the lists
alias characters = chars
alias glyphs = chars
alias graphemes = chars
alias codepoints = code_point_list
alias uppercase = upper
alias lowercase = lower
// the text builtin trim, Python's strip
alias strip = trim
alias reversed = reverse
alias size = count
alias len = count
alias length = count
alias sorted = sort
alias clone = copy
alias ordinal = ord
alias codepoint = ord
alias isdigit = is_digit
alias average = mean
alias is_letter = is_alpha
alias isalpha = is_alpha
alias is_alnum = is_alphanumeric
alias isalnum = is_alphanumeric
alias is_whitespace = is_space
alias isspace = is_space
first(xs) := xs#1
last(xs) := xs#(count(xs))
// Python's `list(x)`: the list itself, a text's characters
as_list(x) := x as list
// `count x in y`, `y.count(x)`: how often x occurs as an item of a list or a character of a text, and how often part
// occurs in a text, not overlapping: count_of("banana", "an") is 2; # counts, so a program's own count leaves them be
count_item(xs, x) := #filter(xs, item => item == x)
count_of(t, part) := #split(t, part) - 1
// the first or last n items (fewer when xs has fewer): `xs.first(3)`, `first 3 of xs`
first_items(xs, n) := xs[0: min(n, count(xs))]
last_items(xs, n) := xs[max(count(xs) - n, 0): count(xs)]
// x rounded to that many digits after the point
round_to(x, places) := round(x * 10 ^ places) / 10 ^ places
// the arithmetic mean, also spelled average
mean(xs) := sum(xs) / count(xs)
// the UTF-8 bytes of a text, `t.bytes` (decision text-unit-plurals)
bytes(t: text) := (0..byte_size(t)).map(offset => byte_at(t, offset))
// x↑n, Knuth's up arrow, is the power and x↓b the log of x to base b (card easy-add): operators of numbers only, so
// another type declares its own `infix operator ↑(v: V, n: int) := …`
infix operator ↑(x: number, n: number) := x ^ n
infix operator ↓(x: number, b: number) := log(x, b)
replace(t, old, with new) := join(split(t, old), new)
// ASCII character tests; a character compares by its code point
is_digit(c) := c >= '0' and c <= '9'
is_alpha(c) := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
is_alphanumeric(c) := is_alpha(c) or is_digit(c)
is_space(c) := c == ' ' or c == '\t' or c == '\n' or c == '\r'
is_hex_digit(c) := is_digit(c) or (lower(c) >= 'a' and lower(c) <= 'f')
is_word_char(c) := is_alphanumeric(c) or c == '_'
// at least one character, each passing is_class: consists_of("42", is_digit)
consists_of(t: text, is_class) := { if t == "" { return false }; for c in t { if not is_class(c) { return false } }; true }
// a whole number, optionally signed: "-3"
is_integer(t: text) := consists_of(remove_prefix(t, "-"), is_digit)
// a hole's text fits its type in a text pattern: `"/users/" + id: int`, `"v" + n: digits`, `c: letter + "!"`
fits_text_type(t: text, type: text) := match type {
	"int" | "integer" => is_integer(t)
	"number" | "float" => { parts = split(t, "."); count(parts) <= 2 and is_integer(parts#1) and (count(parts) == 1 or consists_of(parts#2, is_digit)) }
	"digit" => count(t) == 1 and is_digit(t)
	"digits" => consists_of(t, is_digit)
	"letter" => count(t) == 1 and is_alpha(t)
	"letters" => consists_of(t, is_alpha)
	"hex" => consists_of(t, is_hex_digit)
	"space" => consists_of(t, is_space)
	"word" => consists_of(t, is_word_char)
	_ => true
}
// text patterns (notes/matching.md): the texts of the holes between the pieces of `"0x" + rest`, [] when t doesn't
// match (also when t is no text); the first piece is the prefix, the last the suffix, "" where the pattern starts or
// ends with a hole; each hole's text fits its type, "" for any text
text_holes(t, pieces: [text], types: [text]) := {
	if not (t is text) { return [] }
	prefix = first(pieces)
	suffix = last(pieces)
	if count(t) < count(prefix) + count(suffix) or not starts_with(t, prefix) or not ends_with(t, suffix) { return [] }
	rest = t[count(prefix): count(t) - count(suffix)]
	holes = []
	for piece in pieces[1: count(pieces) - 1] {
		at = index_of(rest, piece)
		if at == 0 { return [] }
		holes = holes + [rest[0: at - 1]]
		rest = rest[at - 1 + count(piece):]
	}
	holes = holes + [rest]
	for i in 1 to count(holes) { if not fits_text_type(holes#i, types#i) { return [] } }
	holes
}
// the digits of n in a base up to 36, letters past 9 (upper: true capitals): to_base(255, 16) is "ff",
// from_base("ff", 16) is 255; a digit is its code point ('0' is 48, 'A' 10 + 55, 'a' 10 + 87), not an index into a text of
// symbols, which needs the grapheme runtime
to_base(n: int, base: int, upper = false) := { if n == 0 { return "0" }; out = ""; rest = abs(n); while rest > 0 { digit = rest % base; out = (digit + (if digit < 10 then 48 else if upper then 55 else 87)) as char + out; rest = rest /! base }; if n < 0 then "-" + out else out }
from_base(t: text, base: int) := { symbols = "0123456789abcdefghijklmnopqrstuvwxyz"; out = 0; for c in lower(t) { out = out * base + index_of(symbols, c) - 1 }; out }
// how an int shown in hex or binary prints (cards hex-printing, binary-int): hex_text(255) is "0xFF", binary_text(-5)
// "-0b101"; the printer of such values calls them (wasm_emitter/numbers/radix.rs)
radix_text(n: int, base: int, prefix: text) := (if n < 0 then "-" else "") + prefix + to_base(abs(n), base, upper: true)
hex_text(n: int) := radix_text(n, 16, "0x")
binary_text(n: int) := radix_text(n, 2, "0b")
// a value's form as its kind field holds it (card kind-reflection, src/type_kinds.rs), what the lib printers read:
// the Kind in the low byte (Int 1, Text 3, Key 6, List 8, Error 11, …), the info byte above it (a key's operator, a
// list's bracket, an Int's bool 1, hex 2 or binary 3), and the mark of a type value (`int`, `type(x)`; code is
// `x is code`)
kind_number(x: any) := kind_mark(x) % 256
kind_info(x: any) := (kind_mark(x) >> 8) % 256
is_type_value(x: any) := (kind_mark(x) >> 54) % 2 == 1
// n copies of value, ø for none (list.warp fill): `n times [x]` and `int[n]` where no typed array holds them; the
// compiler calls it (wasm_emitter/lists/list_emitter.rs), so a fractional count is the error the runtime gives
filled_list(n, value: any) := { if n > floor(n) { raise "count must be an integer; fix: compute it with /! (floor division) or `… as int`" }; out = []; for i in 1 to n { out = out + [value] }; out }
// how a ± value prints (card plus-minus, P219): the ± part to 2 significant digits, the value to the same place, 7.0 ± 2.0;
// a ± part of 0 or ∞, or more digits than 17, as each float prints; gaussian 1 adds σ. The printer calls it with the
// parts (wasm_emitter/numbers/uncertain.rs)
uncertain_text(value: float, radius: float, gaussian: int) := {
	sigma = if gaussian == 1 then "σ" else ""
	if not (radius > 0.0 and radius < 1.0 / 0.0) { return "\(value) ± \(radius)\(sigma)" }
	scale = 1.0
	decimals = 0
	while radius * scale < 9.5 and decimals <= 17 { scale = scale * 10.0; decimals += 1 }
	while radius * scale >= 99.5 { scale = scale / 10.0 }
	if decimals > 17 or abs(value) * scale >= 1e17 { return "\(value) ± \(radius)\(sigma)" }
	place_text(value, scale, decimals) + " ± " + place_text(radius, scale, decimals) + sigma
}
// x rounded to the place of 1/scale with that many decimals: whole units half away from zero, decimals half to even
place_text(x: float, scale: float, decimals: int) := {
	sign = if x < 0.0 then "-" else ""
	if decimals == 0 { return sign + to_base((floor(abs(x) * scale + 0.5) * round(1.0 / scale)) as int, 10) }
	digits = round(abs(x) * scale) as int
	fraction = ""
	while #fraction < decimals { fraction = (digits % 10 + 48) as char + fraction; digits = digits /! 10 }
	sign + to_base(digits, 10) + "." + fraction
}
// `x as decimal` of a ratio (card repeating-decimals): the digits before the period, then the period's overlined, 1/6
// is 0.16̅; a terminating decimal, or a period longer than 1000 digits, as the ratio prints. The cast calls it with the
// ratio's parts, the denominator never 0 (wasm_emitter/numbers/exact.rs)
decimal_text(numerator: int, denominator: int) := {
	rest = denominator; twos = 0; fives = 0
	while rest % 2 == 0 { rest = rest /! 2; twos += 1 }
	while rest % 5 == 0 { rest = rest /! 5; fives += 1 }
	if rest == 1 { return "\(numerator / denominator)" }
	// the period: the first power of ten that is 1 modulo the rest
	power = 10 % rest; period = 1
	while power != 1 and period <= 1000 { power = power * 10 % rest; period += 1 }
	if period > 1000 { return "\(numerator / denominator)" }
	before_period = if twos > fives then twos else fives
	whole = abs(numerator)
	text = (if numerator < 0 then "-" else "") + "\(whole /! denominator)."
	remainder = whole % denominator
	for digit in 1 to before_period + period {
		remainder = remainder * 10
		text = text + "\(remainder /! denominator)" + (if digit > before_period then "̅" else "")
		remainder = remainder % denominator
	}
	text
}
// x as a fraction, by its continued fraction (src/numbers/real.rs computes it exactly for √2, π, … written in the program):
// `within: 1e-6` the first convergent that close, a limit the closest fraction whose denominator is at most that
// (Python's limit_denominator and its default 1000000, user decision); limit 0 the exact fraction, of a float the first
// convergent that is the same float. A precision replaces the default limit (`within: 1e-40` reaches beyond it)
nearest(x, kind, limit = 1000000, within = 0) := {
	p0 = 0; q0 = 1; p1 = 1; q1 = 0; rest = x
	cap = if within > 0 and limit == 1000000 then 0 else limit
	while true {
		a = floor(rest) as int
		q2 = q0 + a * q1
		if cap > 0 and q2 > cap {
			// the closer of the last convergent and the semiconvergent with the largest denominator in the limit
			k = (cap - q0) /! q1
			below = (p0 + k * p1) / (q0 + k * q1)
			above = p1 / q1
			return if abs(above - x) <= abs(below - x) then above else below
		}
		p2 = p0 + a * p1
		p0 = p1; q0 = q1; p1 = p2; q1 = q2
		fraction = p1 / q1
		// a float stops at the first fraction that is the same float: its continued fraction beyond is noise
		is_same_float = x is float and float(p1) / q1 == x
		if rest == a or is_same_float or (within > 0 and abs(fraction - x) <= within) { return fraction }
		rest = 1 / (rest - a)
	}
}
// Python's dict(pairs) (card python-stdlib): a map of [key value] pairs
dict(pairs) := { out = {}; for pair in pairs { out[pair#1] = pair#2 }; out }
// Python's dict.fromkeys(ks, value) (card python-aliases): a map of each key with the one value
fromkeys(ks, value) := { out = {}; for k in ks { out[k] = value }; out }
// Python's xs.pop(i) and m.pop(k) (card python-aliases, declaration_lowering removed_key): the element at the 0-based
// position i (-1 the last) or the value of the key k, and the list or map without it
popped_position(xs, i) := if i < 0 then count(xs) + i + 1 else i + 1
popped_item(x, k) := if x is map then x.get(k) else x#(popped_position(x, k))
popped_rest(x, k) := if x is map then { rest = x; rest.remove(k); rest } else [x#i for i in 1 to count(x) if i != popped_position(x, k)]
// Python's xs.clear() and m.clear() (card python-aliases, declaration_lowering cleared_collection): the empty list or map
cleared(x) := if x is map then {} else []
// xs.insert(v, at: i) (list_mutations inserted_in_place): the list with v at the 0-based position i, past the end or
// before 0 at the end
inserted(xs, i: int, v: any) := if i < 0 or i >= count(xs) then xs + [v] else xs[0: i] + [v] + xs[i:]
// `a ≈ b`, and `a ~ b` when rough (notes/approximately.md): `{…}` maps key by key in any order, other lists item by item,
// pairs and instances (a class name paired with its fields) part by part, each with the same comparison again; two
// other values by the runtime's values_similar or values_rough. Two plain numbers never get here: they compare inline
alike(a: any, b: any, tolerance: float, rough: bool) := {
	if bracket_of(a) == "{" and bracket_of(b) == "{" {
		return #a == #b and keys(a).all(k => b has k and alike(a[k], b[k], tolerance, rough))
	}
	if bracket_of(a) != ø and bracket_of(a) == bracket_of(b) {
		return #a == #b and (1 to #a).all(i => alike(a#i, b#i, tolerance, rough))
	}
	if type(a) is key and type(b) is key {
		keys_alike = alike(key_of(a), key_of(b), tolerance, rough)
		return op_of(a) == op_of(b) and keys_alike and alike(value_of(a), value_of(b), tolerance, rough)
	}
	if rough then values_rough(a, b, tolerance) else values_similar(a, b, tolerance)
}
// `a .op b` where the compiler cannot tell which side is a list (broadcasting.rs, card compile-shaders): each item of
// a list with the other side, two lists paired by index, two numbers plainly; `combined` is `(l, r) => l op r`. Both
// sides are `any`: inferred from the body, one call with a number made it a list
element_wise_any(left: any, right: any, combined) := if left is list and right is list then { if count(left) != count(right) { raise "element-wise operator: the lists differ in length" }; [combined(left#i, right#i) for i in 1 to count(left)] } else if left is list then [combined(item, right) for item in left] else if right is list then [combined(left, item) for item in right] else combined(left, right)
// `norm x`, `‖x‖`: a number's absolute value, a list's Euclidean length (decision S3: `count`/`length` stay the number
// of items); magnitude is its other name (card compile-shaders)
norm(x: any) := if x is list then { var total = 0; for i in 1 to count(x) { total = total + x#i * x#i }; sqrt(total) } else abs(x)
magnitude(x: any) := norm(x)
// a pixel of paint(f, width, height) on the CPU (gpu_maps painted_functions): a vector of 3 numbers from 0 to 1 is
// that color as 0xAARRGGBB, as the shader paints it; a number stays itself
pixel_color(v: any) := if v is list then 0xFF000000 + pixel_channel(v#1) * 65536 + pixel_channel(v#2) * 256 + pixel_channel(v#3) else v
pixel_channel(c) := round(255 * min(max(c, 0), 1)) as int
// paint(f, width, height) of a warp function on the CPU, where no shader paints it (gpu_maps painted_functions): f(column,
// row) of every pixel, row by row
paint_each(f, width, height) := paint([pixel_color(f(i % width, i /! width)) for i in 0..width * height], width, height)
// sleep 0.2, sleep(t): a bare number is seconds (decision sleep-seconds); `sleep 20ms` the compiler folds into sleep_ms
sleep(amount) := sleep_ms(amount * 1000)
// random(a, b) (decision random-forms): of whole numbers a whole number from a to b, both included (random(1, 6) rolls
// a die), else a float in [a, b); random a..b one of the range's elements, a to b-1
random_fraction(a, b) := a + random() * (b - a)
random_until(a, b) := if a is int and b is int then a + random_below(b - a) else random_fraction(a, b)
random_between(a, b) := if a is int and b is int then random_until(a, b + 1) else random_fraction(a, b)
// random(x) by the value's type (card random-dispatches): of a list one of its elements, of a whole number n one of 0…n-1,
// of a fraction a float from 0 up to it
random_element(xs) := xs#(random_below(count(xs)) + 1)
random_of(x) := if x is list then random_element(x) else if x is int then random_below(x) else random_fraction(0, x)
// random int, random bool, random codepoint: a random value of the type; random int spans the whole 64-bit range
random_int() := (random_below(4294967296) - 2147483648) * 4294967296 + random_below(4294967296)
random_bool() := random_below(2) == 1
// a Unicode scalar value: the surrogates 0xD800…0xDFFF are no characters
random_codepoint() := { n = random_below(1112064); if n >= 55296 then n = n + 2048; n as codepoint }
// the paint window's size (the playground: the paintings' frame), system values, so `whenever window.width > 800 {…}`
// listens; written, the window resizes
window.width := window_width
window.width(new_width) := set_system_value("window_width", new_width)
window.height := window_height
window.height(new_height) := set_system_value("window_height", new_height)
// a program cannot resize the display: set window.width or canvas.width instead
display.width := display_width
display.height := display_height
// the device pixels per length (decision display-names, other names display.dpi and display.ppi), a quantity in dpi
// that turns lengths into px, `3 cm * display.density`; a program sets it in dpi, `display.density = 300 dpi`
display.density := display_dpi * 1dpi
display.density(density) := set_system_value("display_dpi", density / 1dpi)
// width × height in px (other names display.dimensions and display.resolution)
display.size := [display_width, display_height] px
// the diagonal as a length: its nearest whole px at the density (quantities run as exact amounts, a run-time √ is a
// float)
display.diagonal := round(√(display_width² + display_height²)) * 1px / (display_dpi * 1dpi)
// The fields of a time at run time (card time-fields-warp, notes/dates_at_run_time.md), called late by the emitter's
// time_field with the time's form (TimeForm: 1 a date, its position in days; else nanoseconds since 1970), its wall
// clock position, its zone offset in seconds east of UTC and the index of the field in times.rs TIME_FIELDS
time_field_of(form: int, wall: int, offset: int, field: int): int := {
	days = time_days(form, wall)
	nanos = time_nanos(form, wall)
	match field {
		0 => civil_year(days)
		1 => civil_month(days)
		2 => civil_day(days)
		// ISO weekday: 1970-01-01 was a Thursday, Monday is 1
		3 => floor_mod(days + 3, 7) + 1
		4 => days - days_from_civil(civil_year(days), 1, 1) + 1
		5 => nanos /! 3600000000000
		6 => nanos /! 60000000000 % 60
		7 => nanos /! 1000000000 % 60
		8 => days * 86400 + nanos /! 1000000000
		9 => offset
		// the time of day in whole seconds, as calendar::Time::part: 22:27:46
		10 => nanos /! 1000000000 * 1000000000
		_ => days
	}
}
// time_parts(form, position): the calendar day of a position and the nanoseconds into it; a date has no clock
time_days(form: int, position: int): int := if form == 1 then position else position /! 86400000000000
time_nanos(form: int, position: int): int := if form == 1 then 0 else floor_mod(position, 86400000000000)
floor_mod(n: int, divisor: int): int := n - n /! divisor * divisor
// Howard Hinnant's calendar over day numbers (days since 1970-01-01, proleptic Gregorian), the one warp copy of
// src/time/calendar.rs days_from_civil / civil_from_days (card civil-days-dup); lib/time.warp builds on it.
// civil_from_days: eras of 400 years from 0000-03-01, a year from March
civil_era(days: int): int := (days + 719468) /! 146097
civil_day_of_era(days: int): int := days + 719468 - civil_era(days) * 146097
civil_year_of_era(day_of_era: int): int := (day_of_era - day_of_era /! 1460 + day_of_era /! 36524 - day_of_era /! 146096) /! 365
civil_day_of_year(day_of_era: int): int := {
	year_of_era = civil_year_of_era(day_of_era)
	day_of_era - (365 * year_of_era + year_of_era /! 4 - year_of_era /! 100)
}
// the month counted from March: months 10 and 11 of the year are January and February
civil_march_month(day_of_year: int): int := (5 * day_of_year + 2) /! 153
civil_month(days: int): int := {
	march_month = civil_march_month(civil_day_of_year(civil_day_of_era(days)))
	if march_month < 10 then march_month + 3 else march_month - 9
}
civil_day(days: int): int := {
	day_of_year = civil_day_of_year(civil_day_of_era(days))
	day_of_year - (153 * civil_march_month(day_of_year) + 2) /! 5 + 1
}
civil_year(days: int): int := {
	year = civil_year_of_era(civil_day_of_era(days)) + civil_era(days) * 400
	if civil_month(days) <= 2 then year + 1 else year
}
// the date of a day number as {year, month, day}
civil_from_days(day_count: int) := {year: civil_year(day_count), month: civil_month(day_count), day: civil_day(day_count)}
// the day number of a proleptic Gregorian date
days_from_civil(year: int, month: int, day: int): int := {
	march_year = if month <= 2 then year - 1 else year
	era = march_year /! 400
	year_of_era = march_year - era * 400
	march_month = if month > 2 then month - 3 else month + 9
	day_of_year = (153 * march_month + 2) /! 5 + day - 1
	era * 146097 + year_of_era * 365 + year_of_era /! 4 - year_of_era /! 100 + day_of_year - 719468
}
// the check of the Rust tests' `is!("3+3", 6)`, written `is! "3+3" 6` (decision warp-is-tests): the code's value is
// the expected one, permissively: equal, or both nothing-like (0, ø, [], no); a failure says what the code gave
is!(warp: text, expected: any) := {
	got = eval(warp)
	passed = got == expected or (not got and not expected)
	if not passed then print("✗ is! \"" + warp + "\" " + str(expected) + ": got " + str(got))
	passed
}

// The class of every error (decision error-classes): `class ParseError: Error` declares one, `except Error` catches all
class Error { message: text }
