// compute.toys shaders in warp (card compute-toys): compute_toy(code) takes a single-pass shader as compute.toys
// writes them, a WGSL kernel `@compute @workgroup_size(16, 16) fn main_image(@builtin(global_invocation_id) id: vec3u)`
// that ends in textureStore(screen, id.xy, color), and makes it a WGSL fragment shader for paint and gpu_render.
// The kernel runs once per pixel as a plain function: id is the pixel (rows from the top, as compute.toys counts them),
// time, mouse, custom and keyDown read paint's values, and its color goes to the screen sRGB-encoded, as compute.toys
// shows its screen texture. Passes (#storage, #dispatch, more than one @compute), textures (channel0/1) and the old
// @stage(compute) syntax are compute.toys' engine, which warp does not have: compute_toy says so
use regex

// compute.toys' prelude (github compute-toys/compute.toys lib/engine/index.ts getPrelude): its type aliases, its
// Time and Mouse, keyDown; each read from paint's built-in values
compute_toys_prelude = "
alias int = i32;
alias uint = u32;
alias float = f32;
alias int2 = vec2<i32>;
alias int3 = vec3<i32>;
alias int4 = vec4<i32>;
alias uint2 = vec2<u32>;
alias uint3 = vec3<u32>;
alias uint4 = vec4<u32>;
alias float2 = vec2<f32>;
alias float3 = vec3<f32>;
alias float4 = vec4<f32>;
alias bool2 = vec2<bool>;
alias bool3 = vec3<bool>;
alias bool4 = vec4<bool>;
alias float2x2 = mat2x2<f32>;
alias float2x3 = mat2x3<f32>;
alias float2x4 = mat2x4<f32>;
alias float3x2 = mat3x2<f32>;
alias float3x3 = mat3x3<f32>;
alias float3x4 = mat3x4<f32>;
alias float4x2 = mat4x2<f32>;
alias float4x3 = mat4x3<f32>;
alias float4x4 = mat4x4<f32>;
struct Time {
	elapsed: f32,
	delta: f32,
	frame: u32
}
struct Mouse {
	pos: vec2i,
	zoom: f32,
	click: i32,
	start: vec2i,
	delta: vec2i
}
var<private> time: Time;
var<private> mouse: Mouse;
var<private> warp_color: vec4f;
var<private> warp_where: vec2i;
fn warp_store(pixel: vec2i, color: vec4f) {
	warp_where = pixel;
	warp_color = color;
}
fn keyDown(keycode: uint) -> bool {
	return u32(values.key) == keycode;
}
"

// The fragment main: compute.toys' uniforms from paint's values, the kernel for this pixel, its color sRGB-encoded.
// A fragment colors only its own pixel: a kernel storing elsewhere, as a mirror does ((x, height - 1 - y)), runs again
// from where it stored, which for a mirror is the pixel that stores here
compute_toys_main = "
@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	time = Time(values.time, 1.0 / 60.0, u32(values.frame));
	let pointer = vec2i(values.mouse);
	mouse = Mouse(pointer, 1.0, i32(values.mouse_down), pointer, vec2i(0));
	let here = vec2i(at.xy);
	warp_where = here;
	main_image(vec3u(vec2u(here), 0u));
	if (any(warp_where != here) && all(warp_where >= vec2i(0))) {
		main_image(vec3u(vec2u(warp_where), 0u));
	}
	return vec4f(pow(clamp(warp_color.rgb, vec3f(0.0), vec3f(1.0)), vec3f(1.0 / 2.2)), 1.0);
}
"

// what compute_toy cannot run, the pattern that finds it and why
compute_toys_engine_only = [
	["(?m)^\\s*#(storage|dispatch|workgroup_count|dispatch_once|dispatch_count)\\b", "it declares storage buffers or passes (#storage, #dispatch …), which need compute.toys' multi-pass engine"],
	["\\b(channel0|channel1|pass_in|pass_out|passLoad|passStore|passSampleLevelBilinearRepeat)\\b", "it reads input textures or earlier passes (channel0, channel1, passLoad …), which warp's paint does not bind"],
	["@stage\\(compute\\)", "it is written in the WGSL of 2022 (@stage(compute)): write @compute"],
	["@compute[\\s\\S]*@compute", "it has more than one @compute entry point, each a pass of compute.toys' engine; compute_toy takes single-pass shaders"]
]

// The kernel as a function: no @compute attributes, the pixel parameter plain, its writes to the screen warp_store's
compute_toys_kernel(code: text) := {
	plain = replace_all(code, "@compute\\s*@workgroup_size\\([^)]*\\)\\s*", "")
	plain = replace_all(plain, "@builtin\\(\\s*global_invocation_id\\s*\\)\\s*", "")
	plain = replace_all(plain, "textureDimensions\\(\\s*screen\\s*\\)", "vec2u(values.size)")
	plain = replace_all(plain, "\\bcustom\\.", "values.")
	// textureStore(screen, where, color), where a vec2i or vec2u with parentheses two deep at most
	replace_all(plain, "textureStore\\(\\s*screen\\s*,\\s*((?:[^,()]|\\((?:[^()]|\\([^()]*\\))*\\))+),", "warp_store(vec2i($1),")
}

compute_toy(code: text) := {
	for rule in compute_toys_engine_only {
		if matches(code, rule#1) { raise "compute_toy cannot run this shader: " + rule#2 }
	}
	if not (code contains "fn main_image") { raise "compute_toy takes a compute.toys shader: its kernel is fn main_image(@builtin(global_invocation_id) id: vec3u)" }
	compute_toys_prelude + compute_toys_kernel(code) + compute_toys_main
}
