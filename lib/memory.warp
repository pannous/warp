// Linear memory by its bytes (samples/wasm_interop.warp): `memory.slice(ptr, end)` reads the bytes ptr…end-1,
// `memory.copy(bytes, ptr)` writes them from ptr on; addresses are 0-based byte offsets
def slice(start, end) {
	bytes = []
	for address in start until end { bytes = bytes + [memory_byte(address)] }
	bytes
}
def copy(bytes, at) {
	for i in 0 until count(bytes) { memory_set_byte(at + i, bytes[i]) }
	count(bytes)
}
