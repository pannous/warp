// The standard library module os (notes/stdlib.md section 7): `use os`, through the adapter std_io;
# todo (card browser-env) the browser has no environment (env gives ø) (use local storage?)
# and no command line (args gives [], or a playground sample's <name>.args)
use host_io
// `env("HOME")`: the variable as the program set it (setenv), else as its environment started with it
env(name: any) := variables_set.get(text(name)) ?? started_env(name)
// warp's two machine switches (decision no-bash-exports), which the processes a run starts inherit: a windowless run
// (`warp --no-window`, WARP_WINDOW=0: a test, an agent's, a CI machine's) opens no window, a muted one (`warp --mute`,
// WARP_SOUND=0) sounds nothing
windowless() := started_env("WARP_WINDOW") == "0"
muted() := started_env("WARP_SOUND") == "0"
// the command line arguments after the program file: `warp run prog.warp a b` gives ["a" "b"]
args = std_io("os", "args", [])
// `exec sh "crontab -l"`: the command (a sh template, its argument vector) run without a shell, what it printed; natively
// only, the browser runs no processes
exec(command: any) := std_io("os", "exec", [command])
// `run(["sh" "-c" "make"])`: the command run without a shell, its {status, out, err} (trailing newlines dropped); a
// failing command is no error, its status says so. The native warp runs it (core/native/driver.warp)
run(command: any) := std_io("os", "run", [command])
// a WebAssembly module's bytes (a list of bytes, or a text): Wasm(read_bytes(./m.wasm)), or compile's
class Wasm { bytes: any }
// `run(Wasm(read_bytes(./m.wasm)))`: the module run in this process with the same imports as a program, its main's
// value; a trap is an Error. compile(code) is the Wasm of a program of the current folder, or the compiler's refusal
// as an Error (raising nothing), so `run(compile("6*7"))` evaluates code. The native warp runs them
// (core/native/driver.warp)
run(module: Wasm) := std_io("os", "run_wasm", [module.bytes])
// `run(module, ["a", "b"])`: the module sees those arguments as its args, not the program's
run(module: Wasm, arguments: list) := std_io("os", "run_wasm", [module.bytes, arguments])
compile(code: any) := {
	compiled = std_io("os", "compile_wasm", [code])
	if is_error(compiled) then compiled else Wasm(compiled)
}
// The scripting words (decision use-script, all of them in `use script`):

// the command line arguments, as args gives them
arguments = args
// the folder the program runs in, now: after `cd` the new one
cwd := std_io("os", "cwd", [])
// `command("ls | wc -l")`: a shell command line run by sh, what it printed; the explicit opt-in to text as shell
command(line: any) := std_io("os", "command", [line])
// a path as one word of a command line: `command("wc -l " + quoted_path(file))`
quoted_path(path: text): text := "'" + path.replace("'", "'\\''") + "'"
// a line typed on standard input (without its line end), ø at the input's end; input("name? ") shows the prompt first
input() := std_io("os", "input", [])
input(prompt: any) := std_io("os", "input", [prompt])
// all of standard input as one text: `cat notes.txt | warp count.warp`
stdin() := std_io("os", "stdin", [])
// `setenv("MODE", "fast")`: the variable set for the commands the program runs, yes when it was; natively C's
// setenv through the 'c' library (lib/c.warp), so a page has none. env reads it at once: WASI's environment is the
// one the program started with
setenv(name: text, value: text, overwrite: i32): i32 from 'c'
global variables_set = {}
setenv(name: any, value: any): bool := {
	variables_set[text(name)] = text(value)
	setenv(text(name), text(value), 1) == 0
}
// `eprint "no such file"`: the value on standard error, a line of its own, through WASI natively and in the page
eprint(value: any) := said_on_stderr(text(value))
// a slow path taken where a fast one was meant (a library's fallback): said once per reason on standard error, its fix
// named; `warp --strict` refuses it instead, so a program that must stay fast fails loudly where it would only crawl
global slow_reasons_said = {}
slow(reason: text, fix: text) := {
	if run_option("strict") != ø { raise "slow path: " + reason + "; fix: " + fix }
	if slow_reasons_said.get(reason) != ø { return ø }
	slow_reasons_said[reason] = yes
	eprint("slow path: " + reason + " (" + (run_option("program") ?? "") + "); fix: " + fix)
}
