// The standard library module encoding: `use encoding`, texts as base64 (RFC 4648) and hex of their UTF-8 bytes,
// and uuid(), a random version 4 UUID: base64_encode("foo") is "Zm9v", hex_encode("foo") is "666f6f"
use text

BASE64_DIGITS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
HEX_DIGITS = "0123456789abcdef"

// the place of a digit in its alphabet, -1 when it is not there
digit_value(digits: text, c: any): int := {
	value = -1
	for i in 0 ..< count(digits) { if digits[i] == c { value = i } }
	value
}

def base64_encode(t: text): text {
	b = to_utf8(t)
	out = ""
	i = 0
	while i < count(b) {
		left = count(b) - i
		n = b[i] * 65536 + (if left > 1 then b[i + 1] * 256 else 0) + (if left > 2 then b[i + 2] else 0)
		out = out + BASE64_DIGITS[n /! 262144] + BASE64_DIGITS[n /! 4096 % 64]
		out = out + (if left > 1 then BASE64_DIGITS[n /! 64 % 64] else "=") + (if left > 2 then BASE64_DIGITS[n % 64] else "=")
		i = i + 3
	}
	out
}

def base64_decode(t: text): text {
	out = []
	n = 0
	bits = 0
	for c in t {
		v = digit_value(BASE64_DIGITS, c)
		if v >= 0 {
			n = n * 64 + v
			bits = bits + 6
			if bits >= 8 {
				bits = bits - 8
				p = 2 ** bits
				out = out + [n /! p]
				n = n % p
			}
		}
	}
	from_utf8(out)
}

hex_byte(n: int): text := HEX_DIGITS[n /! 16] + HEX_DIGITS[n % 16]
hex_encode(t: text): text := join([hex_byte(n) for n in to_utf8(t)], "")

def hex_decode(t: text): text {
	out = []
	low = lower(t)
	i = 0
	while i + 1 < count(low) {
		out = out + [digit_value(HEX_DIGITS, low[i]) * 16 + digit_value(HEX_DIGITS, low[i + 1])]
		i = i + 2
	}
	from_utf8(out)
}

// xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx with random lowercase hex x and y one of 8 9 a b
def uuid(): text {
	out = ""
	for i in 0 ..< 36 {
		out = out + (if i == 8 or i == 13 or i == 18 or i == 23 then "-" else if i == 14 then "4" else if i == 19 then HEX_DIGITS[8 + random(4)] else HEX_DIGITS[random(16)])
	}
	out
}
