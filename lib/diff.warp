// The standard library module diff (card lib-diff): `use diff`. A diff is a list of edits, each [op, item] with op
// "keep", "delete" or "insert": diff([1, 2, 3], [1, 3, 4]) is [["keep", 1], ["delete", 2], ["keep", 3], ["insert", 4]].
// It is a longest common subsequence's (deletions before insertions where both are possible). Texts are lines split
// at "\n", the empty text no lines; unified_diff writes git's format and apply_patch reads it back

// the edits that turn the list a into the list b
diff(a: list, b: list): list := {
	n = count(a); m = count(b)
	// longest[i][j]: the longest common subsequence of a from i on and b from j on (1-based, n + 1 / m + 1 past the end)
	longest = [[0 for j in 1 to m + 1] for i in 1 to n + 1]
	for i in 0 to n - 1 {
		row = n - i
		for j in 0 to m - 1 {
			col = m - j
			longest#row#col = if a#row == b#col then longest#(row + 1)#(col + 1) + 1 else max(longest#(row + 1)#col, longest#row#(col + 1))
		}
	}
	edits = []
	i = 1; j = 1
	while i <= n or j <= m {
		if i <= n and j <= m and a#i == b#j { edits += [["keep", a#i]]; i += 1; j += 1 }
		else if i <= n and (j > m or longest#(i + 1)#j >= longest#i#(j + 1)) { edits += [["delete", a#i]]; i += 1 }
		else { edits += [["insert", b#j]]; j += 1 }
	}
	edits
}
// a text's lines, the empty text none
text_lines(t: text): list := if t == "" then [] else split(t, "\n")
// the edits between the lines of two texts
line_diff(a: text, b: text): list := diff(text_lines(a), text_lines(b))
// git's unified diff of two texts: "--- a" and "+++ b", then hunks "@@ -start,count +start,count @@" of " " kept,
// "-" deleted and "+" inserted lines with context lines of kept text around each change; changes closer than twice
// the context share a hunk. An empty range counts 0 and starts at the line before it. Equal texts give ""
unified_diff(old: text, new: text, context = 3): text := {
	edits = line_diff(old, new)
	changes = (1 to count(edits)).filter(k => edits#k#1 != "keep")
	if count(changes) == 0 { return "" }
	// the hunks as [first, last] edit positions
	hunks = []
	first = changes#1; last = changes#1
	for k in changes[1:] {
		if k - last - 1 > 2 * context { hunks += [[first, last]]; first = k }
		last = k
	}
	hunks += [[first, last]]
	// the old and new line numbers before each edit
	old_before = []; new_before = []
	o = 0; w = 0
	for edit in edits {
		old_before += [o]; new_before += [w]
		if edit#1 != "insert" { o += 1 }
		if edit#1 != "delete" { w += 1 }
	}
	out = ["--- a", "+++ b"]
	for hunk in hunks {
		from = max(1, hunk#1 - context); to = min(count(edits), hunk#2 + context)
		part = edits[from - 1: to]
		old_count = count(part.filter(e => e#1 != "insert")); new_count = count(part.filter(e => e#1 != "delete"))
		old_start = old_before#from + (if old_count == 0 then 0 else 1)
		new_start = new_before#from + (if new_count == 0 then 0 else 1)
		out += ["@@ -" + str(old_start) + "," + str(old_count) + " +" + str(new_start) + "," + str(new_count) + " @@"]
		out += part.map(e => (if e#1 == "keep" then " " else if e#1 == "delete" then "-" else "+") + e#2)
	}
	out.join("\n") + "\n"
}
// the text with a unified diff applied: each hunk's kept and deleted lines must be the text's lines where its header
// says, else it raises naming the hunk and the line
apply_patch(t: text, patch: text): text := {
	old = text_lines(t)
	out = []
	at = 0
	number = 0
	lines = text_lines(if patch.ends_with("\n") then patch[0: count(patch) - 1] else patch)
	k = 1
	while k <= count(lines) {
		line = lines#k
		if line.starts_with("---") or line.starts_with("+++") or line == "" { k += 1; continue }
		if not line.starts_with("@@") { raise "apply_patch: a line outside a hunk: " + line }
		number += 1
		header = line
		ranges = split(line, " ")
		old_range = split(ranges#2[1:], ",")
		old_start = int(old_range#1)
		old_count = if count(old_range) > 1 then int(old_range#2) else 1
		start = if old_count == 0 then old_start else old_start - 1
		if start < at or start > count(old) { raise "apply_patch: hunk " + str(number) + " (" + header + ") starts outside the text" }
		out += old[at: start]
		at = start
		k += 1
		while k <= count(lines) and not lines#k.starts_with("@@") {
			body = lines#k
			mark = if body == "" then " " else str(body#1)
			content = if body == "" then "" else body[1:]
			if mark == "+" { out += [content] }
			else if mark == " " or mark == "-" {
				if at >= count(old) or old#(at + 1) != content { raise "apply_patch: hunk " + str(number) + " (" + header + ") does not match line " + str(at + 1) + ": expected \"" + content + "\", found " + (if at >= count(old) then "the end" else "\"" + old#(at + 1) + "\"") }
				if mark == " " { out += [content] }
				at += 1
			}
			k += 1
		}
	}
	out += old[at:]
	out.join("\n")
}
// how alike two lists or two texts (as characters) are, from 0 to 1: twice the kept items over both lengths, 1 for
// two empty ones
similarity(a: any, b: any): float := {
	xs = if a is text then [c for c in a] else a
	ys = if b is text then [c for c in b] else b
	if count(xs) + count(ys) == 0 { return 1.0 }
	2.0 * count(diff(xs, ys).filter(e => e#1 == "keep")) / (count(xs) + count(ys))
}
