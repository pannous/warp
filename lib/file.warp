// The standard library module file (notes/stdlib.md section 7): `use file`, or a file URL in the program (P183). read,
// write, exists, write_bytes and read_bytes are prelude words (P171), the rest needs the module; append is written file.append(path, text).
// They call the adapter std_io: the file system natively, the page's in-memory files in the browser
global write(path: any, text: any) := std_io("file", "write", [home_expanded(path), text])
// a file's bytes as a list of ints 0 to 255 (a .wasm a warp-written emitter writes)
global write_bytes(path: any, bytes: any) := std_io("file", "write_bytes", [home_expanded(path), bytes])
global read_bytes(path: any) := std_io("file", "read_bytes", [home_expanded(path)])
// a value written to a file, by its type (card save-sound): save "hi" as: "note.txt"; `use sound` adds
// save sound as: "song.wav"
save(content: text, as file) := write(file, content)
global append_file(path: any, text: any) := std_io("file", "append", [home_expanded(path), text])
global exists(path: any) := std_io("file", "exists", [home_expanded(path)])
list_files(folder: any) := std_io("file", "list", [home_expanded(folder)])
// `glob("rust-harness:src/*.rs")`: the paths matching the pattern, sorted; its wildcards * and ? are in its last part
glob(pattern: any) := std_io("file", "glob", [home_expanded(pattern)])
lines(path) := split(read(home_expanded(path)), "\n")
// `~/notes.txt`: a path's leading ~ is the home folder ($HOME), expanded where the path is used (notes/shell_words.md),
// so a quoted "~/x" works too and a program expands it on the machine it runs on; any other value stays as it is
home_expanded(path: any) := if path is text and (path == "~" or path.starts_with("~/")) then std_io("os", "env", ["HOME"]) + path[1..] else path
