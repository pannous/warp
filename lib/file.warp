// The standard library module file (notes/stdlib.md section 7): `use file`, or a file URL in the program (P183). read,
// write, exists, write_bytes and read_bytes are prelude words (P171), the rest needs the module; append is written file.append(path, text).
// They call the adapter std_io: the file system natively, the page's in-memory files in the browser; append_file and
// glob fall back on read, write and list_files where the host has no word of their own (card lib-path-file-conformance)
use path
global write(path: any, text: any) := std_io("file", "write", [home_expanded(path), text])
// a file's bytes as a list of ints 0 to 255 (a .wasm a warp-written emitter writes)
global write_bytes(path: any, bytes: any) := std_io("file", "write_bytes", [home_expanded(path), bytes])
global read_bytes(path: any) := std_io("file", "read_bytes", [home_expanded(path)])
// a value written to a file, by its type (card save-sound): save "hi" as: "note.txt"; `use sound` adds
// save sound as: "song.wav"
save(content: text, as file) := write(file, content)
global append_file(path: any, text: any) := try { std_io("file", "append", [home_expanded(path), text]) } catch e { appended_by_writing(home_expanded(path), text) }
appended_by_writing(path: any, text: any) := write(path, (if exists(path) then read(path) else "") + text)
// "" names no file (python's os.path.exists)
global exists(path: any) := if path == "" then no else std_io("file", "exists", [home_expanded(path)])
list_files(folder: any) := std_io("file", "list", [home_expanded(folder)])
// `glob("rust-harness:src/*.rs")`: the paths matching the pattern, sorted; its wildcards * and ? are in its last part
glob(pattern: any) := try { std_io("file", "glob", [home_expanded(pattern)]) } catch e { glob_listed(home_expanded(pattern)) }
// the folder's names matching the pattern's last part, sorted; * and ? match no leading dot unless the part starts with
// one (python's glob); a folder that isn't there has none
glob_listed(pattern: text): list := {
	folder = dirname(pattern)
	part = basename(pattern)
	names = try { list_files(folder) } catch e { [] }
	matching = names.filter(name => glob_match(part, name) and (part.starts_with(".") or not name.starts_with("."))).sort
	if pattern.contains("/") then matching.map(name => path_join(folder, name)) else matching
}
lines(path) := split(read(home_expanded(path)), "\n")
// `~/notes.txt`: a path's leading ~ is the home folder ($HOME), expanded where the path is used (notes/shell_words.md),
// so a quoted "~/x" works too and a program expands it on the machine it runs on; any other value stays as it is
home_expanded(path: any): any := if path is text and (path == "~" or path.starts_with("~/")) then std_io("os", "env", ["HOME"]) + path[1..] else path
// the folder for temporary files: $TMPDIR without its trailing /, else /tmp (card lib-regex-groups-tempfiles)
global temp_folder(): text := {
	folder = std_io("os", "env", ["TMPDIR"]) ?? "/tmp"
	if folder == "" then "/tmp" else if folder.ends_with("/") and #folder > 1 then folder[0 ..< #folder - 1] else folder
}
// `delete_file("~/old.txt")`: the file removed, yes when it was there; natively C's unlink through the 'c' library
// (lib/c.warp), so a page, which has no C library, has no delete_file yet
unlink(path: text): i32 from 'c'
global delete_file(path: any): bool := unlink(home_expanded(path)) == 0
