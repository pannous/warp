// The standard library module math (notes/stdlib.md): `use math`, together with the C library libm.
// Whole-number words declare int parameters, which their signatures show; the others take any number
// Its builtins, the math words warp computes itself and libm's (`from warp`, `from 'm'`), are the core's:
// core/analysis/math_builtins.warp
use reals
use integers
use case_table

// The math spellings of operators (decision operator-alias), every program reads them: each keeps the precedence
// of the operator it spells
operator × := *
// operator · := *   (· no longer multiplies; the compiler names its made words with it, item·3)
operator ⋅ := *
operator ÷ := /!
operator ÷= := /!=
operator − := -
operator ≤ := <=
operator ≥ := >=
operator ≠ := !=
operator ≟ := ==
operator ≡ := ===
operator ﹦ := ==
// `a ≈ b` within tolerance 1e-9 (alike below); `a ~ b` (also `a ~~ b`) the looser, within rough_tolerance 0.01; a
// program sets either: `tolerance = 0.1; 1 ≈ 1.05` holds (decision approx-zero)
global tolerance = 0.000000001
global rough_tolerance = 0.01
infix operator ≈(a: any, b: any) := alike(a, b, tolerance, no)
infix operator ~(a: any, b: any) := alike(a, b, rough_tolerance, yes)
infix operator ⋍(a: any, b: any) := alike(a, b, tolerance, no)
// `a ≈ b`, and `a ~ b` when rough (wiki/operator.md): `{…}` maps key by key in any order, other lists item by item,
// instances of one class field by field, pairs part by part, each with the same comparison again; two
// other values by the runtime's values_similar or values_rough. Two plain numbers never get here: they compare inline
alike(a: any, b: any, tolerance: float, rough: bool) := {
	if bracket_of(a) == "{" and bracket_of(b) == "{" {
		return #a == #b and keys(a).all(k => b has k and alike(a[k], b[k], tolerance, rough))
	}
	if bracket_of(a) != ø and bracket_of(a) == bracket_of(b) {
		return #a == #b and (1 to #a).all(i => alike(a#i, b#i, tolerance, rough))
	}
	if is_instance(a) and is_instance(b) {
		return class_name(a) == class_name(b) and a.keys.all(k => alike(a[k], b[k], tolerance, rough))
	}
	if type(a) is key and type(b) is key {
		keys_alike = alike(key_of(a), key_of(b), tolerance, rough)
		return op_of(a) == op_of(b) and keys_alike and alike(value_of(a), value_of(b), tolerance, rough)
	}
	values_alike(a, b, tolerance, rough)
}
// `a ≈ b` and the looser `a ~ b` (wiki/operator.md): lib/prelude.warp alike walks lists, maps and pairs, the
// two below compare the leaves; tolerance 1e-9 for ≈, 0.01 for ~
// two leaves alike: a yes/no by truth, numbers within tolerance of either (or 1e-12 near zero), texts and characters
// folded (lower case without accents), the rough ones trimmed of blanks and punctuation at both ends first
values_alike(a: any, b: any, tolerance: float, rough: bool): bool := {
	if a is bool or b is bool { return truthy(a) == truthy(b) }
	# real: an exact value too, π or 2π, which `is number` leaves out
	if a is real and b is real { return numbers_alike(a as float, b as float, tolerance) }
	if (a is text or a is char) and (b is text or b is char) { return text_alike(text(a), rough) == text_alike(text(b), rough) }
	a == b
}
numbers_alike(a: float, b: float, tolerance: float): bool := {
	d = abs(a - b)
	d <= tolerance * abs(a) or d <= tolerance * abs(b) or d <= 0.000000000001
}
truthy(x: any): bool := if x then yes else no
// an instance of a class, a pair of its class name and its fields as a value: P(1), 5km
is_instance(x: any): bool := type(x) is key and class_name(x) != "key"
text_alike(t: text, rough: bool): text := case_fold(if rough then rough_trimmed(t) else t)
rough_trimmed(t: text): text := {
	first = 1; last = #t
	while first <= last and is_rough_edge(t#first) { first += 1 }
	while last >= first and is_rough_edge(t#last) { last -= 1 }
	if first > last then "" else t[first - 1: last]
}
// a blank, a control character or ASCII punctuation
is_rough_edge(c): bool := { code = ord(c); code <= 32 or (code < 127 and not is_ascii_alphanumeric(code)) }
is_ascii_alphanumeric(code: int): bool := (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
operator ∧ := and
operator ⋀ := and
operator ∨ := or
operator ⋁ := or
operator ⊻ := xor
operator ± := +-
// A prefix glyph spelling a function calls it: √9 is sqrt(9), the plain function (decision prefix-symbols-alias-functions)
prefix operator √ := sqrt
prefix operator ∛ := cbrt
prefix operator ∜ := fourth_root
// A glyph pair bracketing an expression like parentheses applies the function to it: ⌊3.7⌋ is floor(3.7)
circumfix operator ‖ ‖ := abs
circumfix operator ⌊ ⌋ := floor
circumfix operator ⌈ ⌉ := ceil
// The arrows of rust-harness:src/operators/spellings.rs's list that spell an operator (card user-listed); the rest stay unread
operator → := ->
operator ⟶ := ->
operator ➔ := ->
operator ➜ := ->
operator ➝ := ->
operator ➞ := ->
operator ➡ := ->
operator ⭢ := ->
operator ⇒ := =>
operator ⟹ := =>
operator ← := <-
operator ⟵ := <-
operator ⬅ := <-
operator ⭠ := <-
operator ⬆ := ↑
operator ⇧ := ↑
operator ⭡ := ↑
operator ⬇ := ↓
operator ⇩ := ↓
operator ⭣ := ↓
// membership (card parse-free); ∉ is `not in`, a negated spelling (rust-harness:src/operators/spellings.rs)
operator ∈ := in
operator ∋ := contains

// the rounding mode named: a half goes up, toward +∞ (`round_half_up(-2.5)` is -2), or to the even neighbour
round_half_up(x: number): int := floor(x + 1/2) as int
round_half_even(x: number): int := {
	below = floor(x) as int
	rest = x - below
	if rest > 1/2 or (rest == 1/2 and below % 2 != 0) then below + 1 else below
}

// gcd(a, b) is the core's (core/integers.warp), of any whole numbers
lcm(a, b) := a /! gcd(a, b) * b
// x within low and high: of vectors each component (min and max of a vector, card min-max)
clamp(x, low, high) := each_any(x, e -> min(max(e, low), high))
sign(x) := if x > 0 then 1 else if x < 0 then - 1 else 0
factorial(n: int) := { out = 1; for i in 2 to n { out = out * i }; out }
is_prime(n: int) := { if n < 2 { return false }; i = 2; while i * i <= n { if n % i == 0 { return false }; i++ }; true }
// the value a fraction t of the way from a to b
lerp(a, b, t) := a .+ (b .- a) .* t
// lerp's GLSL name; both take numbers and lists of numbers (vectors); a function, so a module's typed mix overloads
// it (lib/color.warp mix of two colors)
mix(a, b, t) := lerp(a, b, t)
// shader math (card compile-shaders, WGSL's words): the fractional part, 0 below the edge and 1 from it, and the smooth
// Hermite step from 0 at low to 1 at high
fract(x) := each_any(x, e -> e - floor(e))
step(edge, x) := if x < edge then 0 else 1
smoothstep(low, high, x) := { var t = clamp((x - low) / (high - low), 0, 1); t * t * (3 - 2 * t) }
// `norm x`, `‖x‖`: a number's absolute value, a list's Euclidean length (decision S3: `count`/`length` stay the number
// of items); magnitude is its other name (card compile-shaders); here since `use math` brings it 
norm(x: any) := if x is list then { var total = 0; for i in 1 to count(x) { total = total + x#i * x#i }; sqrt(total) } else abs(x)
magnitude(x: any) := norm(x)
// vectors are lists of numbers: their dot product, their distance, the vector of length 1 along v, the cross product of
// two 3-vectors and the direction i reflected at a surface of normal n. Small vectors stay a fused GC loop (exact
// ints). From DOT_LINEAR_FEWEST up, items are copied into linear memory and multiplied as f64 there (~80× the GC
// loop on 10^5; samples/lists/dot.warp). The emitter's linear_dotf (f64x2, no copy) still wins once auto-linear
// pairs float[n] by dot — that path is core, not lib (card dot-compose-fix)
DOT_LINEAR_FEWEST = 64
dot_cell_bytes() := 8
dot_page_bytes() := 65536
dot_cell_at(address: int): float := wasm f64.load
dot_set_cell(address: int, value: float) := wasm f64.store
dot_count_at(address: int): int := wasm i64.load
dot_set_count_at(address: int, count: int) := wasm i64.store
dot_memory_pages(): int := wasm memory.size
dot_grown_pages(pages: int): int := wasm memory.grow
// n zeroed f64 cells behind a count, never freed (as sound's sample blocks)
dot_new_block(n: int): int := {
	let address = dot_memory_pages() * dot_page_bytes
	dot_grown_pages(dot_cell_bytes * (n + 1) /! dot_page_bytes + 1)
	dot_set_count_at(address, n)
	address
}
dot_fill_block(list, address) := {
	let n = count(list)
	for i in 1 to n { dot_set_cell(address + dot_cell_bytes * i, list#i as float) }
}
dot_blocks(au: int, av: int): float := {
	let n = dot_count_at(au)
	if n != dot_count_at(av) { raise "dot: the lists differ in length" }
	var total = 0.0
	var i = 1
	while i <= n {
		total = total + dot_cell_at(au + dot_cell_bytes * i) * dot_cell_at(av + dot_cell_bytes * i)
		i = i + 1
	}
	total
}
dot(u: list, v: list) := {
	let n = count(u)
	if n != count(v) { raise "dot: the lists differ in length" }
	if n >= DOT_LINEAR_FEWEST {
		let au = dot_new_block(n)
		let av = dot_new_block(n)
		dot_fill_block(u, au)
		dot_fill_block(v, av)
		return dot_blocks(au, av)
	}
	var total = 0
	for i in 1 to n { total = total + u#i * v#i }
	total
}
// of two numbers their product: `x·y` of numbers multiplies (decision middot-scalars)
dot(u: number, v: number) := u * v
// `u ∘ v`, the dot product's canonical spelling, and `u·v` (decision dot-glyphs); `u * v` of two lists stays refused
infix operator ∘(u, v) := dot(u, v)
infix operator ·(u, v) := dot(u, v)
distance(a, b) := norm(a .- b)
normalize(v) := v ./ norm(v)
cross(a, b) := [a#2 * b#3 - a#3 * b#2, a#3 * b#1 - a#1 * b#3, a#1 * b#2 - a#2 * b#1]
reflect(i, n) := i .- (2 * dot(n, i)) .* n
is_even(n: int) := n % 2 == 0
is_odd(n: int) := n % 2 != 0
// the decimal digits of a whole number: digits(1234) is [1 2 3 4]
digits(n: int) := { out = []; rest = abs(n); while rest >= 10 { out = [rest % 10] + out; rest = rest /! 10 }; [rest] + out }
// the number of ways to choose k of n (the binomial coefficient)
choose(n: int, k: int) := { if k < 0 or k > n { return 0 }; out = 1; for i in 1 to min(k, n - k) { out = out * (n - min(k, n - k) + i) /! i }; out }
// base^exponent % modulus without the huge power
mod_pow(base: int, exponent: int, modulus: int) := { out = 1; b = base % modulus; e = exponent; while e > 0 { if e % 2 == 1 { out = out * b % modulus }; b = b * b % modulus; e = e /! 2 }; out }
// part as a percentage of whole: percent(1, 4) is 25
percent(part, whole) := part * 100.0 / whole
to_radians(degrees) := degrees * pi / 180
to_degrees(radians) := radians * 180 / pi
// the whole square root, rounded down
isqrt(n: int) := { r = floor(sqrt(n as float)) as int; while r * r > n { r = r - 1 }; while (r + 1) * (r + 1) <= n { r = r + 1 }; r }
is_square(n: int) := n >= 0 and isqrt(n) * isqrt(n) == n
divisors(n: int) := [d for d in 1..n + 1 if n % d == 0]
prime_factors(n: int) := { if n < 1 { raise "prime_factors needs a positive whole number, not " + text(n) }; out = []; rest = n; d = 2; while d * d <= rest { while rest % d == 0 { out = out + [d]; rest = rest /! d }; d++ }; if rest > 1 { out = out + [rest] }; out }
// the primes up to and including n, by the sieve of Eratosthenes: primes(10) is [2, 3, 5, 7]
primes(n: int): list := {
	if n < 2 { return [] }
	composite = [no for i in 1 to n]
	p = 2
	while p * p <= n {
		if not composite#p { multiple = p * p; while multiple <= n { composite#multiple = yes; multiple += p } }
		p += 1
	}
	(2 to n).filter(i => not composite#i)
}
// the smallest prime greater than n: next_prime(7) is 11
next_prime(n: int): int := { candidate = max(n + 1, 2); while not is_prime(candidate) { candidate += 1 }; candidate }
// the one bits of whole numbers ≥ 0 (`&` and `|` are logical, `xor` is bitwise already): bit_count(6) is 2
bit_count(n: int) := { out = 0; rest = n; while rest > 0 { out = out + rest % 2; rest = rest /! 2 }; out }
// two's-complement bits of any whole numbers: the wasm instructions, as the runtime's own bits_and and bits_or
// (decision wasm-instruction-body): bit_and(-129, 127) is 127, bit_or(-128, 1) is -127
bit_and(a: int, b: int): int := wasm i64.and
bit_or(a: int, b: int): int := wasm i64.or
// P169/P191: descriptive names; they forward to the C library (use cmath) until warp has its own implementations.
// The C names still work after `use math`, each with a note naming the word here: the alias lines (wiki/alias.md)
// Each broadcasts, decided at run time (prelude each_any): binary_log([1, 8]) is [0 3], as a list may reach a word of
// a module, where the program's broadcasting rules (extensions/sugar/broadcasting.warp) don't look

square_root(x) := each_any(x, e -> sqrt(e))
cube_root(x) := ∛x
alias pow => power
power(base, exponent) := base ^ exponent
alias exp => exponential
exponential(x) := each_any(x, e -> exp(e))
alias ln => natural_log
natural_log(x) := each_any(x, e -> log(e))
alias log2 => binary_log
binary_log(x) := each_any(x, e -> log2(e))
alias log10 => decimal_log
decimal_log(x) := each_any(x, e -> log10(e))
// the logarithm of x to any base: logarithm(8, 2) is 3
logarithm(x, base) := log(x) / log(base)
alias sin => sine
sine(x) := each_any(x, e -> sin(e))
alias cos => cosine
cosine(x) := each_any(x, e -> cos(e))
alias tan => tangent
tangent(x) := each_any(x, e -> tan(e))
alias asin => arc_sine
arc_sine(x) := each_any(x, e -> asin(e))
alias acos => arc_cosine
arc_cosine(x) := each_any(x, e -> acos(e))
alias atan => arc_tangent
arc_tangent(x) := each_any(x, e -> atan(e))
# arcsine(x) := asin(x)
# arccosine(x) := acos(x)
# arctangent(x) := atan(x)
arcsin=&arc_sine
arccos=&arc_cosine
arctan=&arc_tangent
# arctan:=arc_tangent
// the angle of the point (x, y) from the x axis, in radians: C's atan2(y, x)
angle(x, y) := atan2(y, x)
alias sinh => hyperbolic_sine
hyperbolic_sine(x) := each_any(x, e -> sinh(e))
alias cosh => hyperbolic_cosine
hyperbolic_cosine(x) := each_any(x, e -> cosh(e))
alias tanh => hyperbolic_tangent
hyperbolic_tangent(x) := each_any(x, e -> tanh(e))
// the length of the long side of a right triangle with sides a and b
alias hypot => hypotenuse
hypotenuse(a, b) := hypot(a, b)
alias ceil => ceiling
ceiling(x) := each_any(x, e -> ceil(e))
// x without its fraction, toward zero: whole_part(-2.5) is -2
alias trunc => whole_part
whole_part(x) := each_any(x, e -> trunc(e))
// what remains of a after taking out b as often as it fits, with the sign of a (C's fmod)
alias fmod => remainder
remainder(a, b) := fmod(a, b)

// The exact arithmetic the runtime emits in Rust (rust-harness:src/wasm_emitter/numbers/exact.rs int_gcd, ratio_new, exact_div,
// int_mod, int_euclid_div) written in warp (card ratio-gcd-warp); gcd is int_gcd's twin, never below 0. The
// builtins stay until a measured step calls these late; test/numbers/test_euclidean_operators pins `%` and `/!`.
class RatioParts {
	numerator: int
	denominator: int
}
// n/d in lowest terms with a positive denominator, as ratio_new keeps every ratio: 6/-4 is -3/2, 5/0 is 1/0 (∞), 0/0 stays
lowest_terms(n: number, d: number): RatioParts := {
	sign = if d < 0 then -1 else 1
	divisor = gcd(n, d)
	if divisor > 1 { return RatioParts(sign * n /! divisor, sign * d /! divisor) }
	RatioParts(sign * n, sign * d)
}
// a/b of two exact numbers as exact_div divides them: an int whenever b divides a, by 0 the error divide by zero
// (top and bottom, not a and b: a class-typed parameter types every same-named one, card parameter-typed-class)
exact_quotient(top: RatioParts, bottom: RatioParts): RatioParts := {
	if bottom.numerator == 0 { raise "divide by zero" }
	lowest_terms(top.numerator * bottom.denominator, top.denominator * bottom.numerator)
}
// the call is the operator, written where the call is, so a literal and a for-loop value each keep the `/!` and `%`
// of that place. A parameter would be inferred on its own and those two disagree when the divisor is negative
euclidean_remainder(a, b) := a % b
euclidean_quotient(a, b) := a /! b
rewrite euclidean_remainder($a, $b) => $a % $b
rewrite euclidean_quotient($a, $b) => $a /! $b
even(n: int) := is_even(n)
odd(n: int) := is_odd(n)
