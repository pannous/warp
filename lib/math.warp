// The standard library module math (notes/stdlib.md): `use math`, together with the C library libm.
// Whole-number words declare int parameters, which their signatures show; the others take any number

// The math spellings of operators (decision operator-alias), every program reads them: each keeps the precedence
// of the operator it spells
operator × := *
operator · := *
operator ⋅ := *
operator ÷ := /
operator − := -
operator ≤ := <=
operator ≥ := >=
operator ≠ := !=
operator ≟ := ==
operator ≡ := ==
operator ﹦ := ==
operator ≈ := approximately
operator ⋍ := approximately
operator ∧ := and
operator ⋀ := and
operator ∨ := or
operator ⋁ := or
operator ⊻ := xor
operator ± := +-
prefix operator √ := sqrt
prefix operator ∛ := cbrt

// The math words warp computes itself, with their signatures (decision foreign-signature, `from warp`): exact on
// exact values where they can be, so floor gives an int where C's floor gives a float
sqrt(x: number): number from warp
cbrt(x: number): number from warp
abs(x: number): number from warp
floor(x: number): int from warp
ceil(x: number): int from warp
round(x: number): int from warp
trunc(x: float): float from warp
// the real functions, exact on exact values (src/numbers/real.rs), else libm's
sin(x: float): float from warp
cos(x: float): float from warp
tan(x: float): float from warp
exp(x: float): float from warp
ln(x: float): float from warp
min(a: number, b: number, more...): number from warp
max(a: number, b: number, more...): number from warp

// The C library's math functions (libm), f64 each: the host links them (src/ffi reads these lines, decision
// foreign-signature), the browser takes them from Math. Every program calls them without `use math`
fmin(a: float, b: float): float from 'm'
fmax(a: float, b: float): float from 'm'
fabs(x: float): float from 'm'
floor(x: float): float from 'm'
ceil(x: float): float from 'm'
round(x: float): float from 'm'
sqrt(x: float): float from 'm'
sin(x: float): float from 'm'
cos(x: float): float from 'm'
tan(x: float): float from 'm'
fmod(a: float, b: float): float from 'm'
pow(base: float, exponent: float): float from 'm'
exp(x: float): float from 'm'
log(x: float): float from 'm'
log10(x: float): float from 'm'
asin(x: float): float from 'm'
acos(x: float): float from 'm'
atan(x: float): float from 'm'
atan2(y: float, x: float): float from 'm'
sinh(x: float): float from 'm'
cosh(x: float): float from 'm'
tanh(x: float): float from 'm'
hypot(a: float, b: float): float from 'm'
log2(x: float): float from 'm'
trunc(x: float): float from 'm'
log1p(x: float): float from 'm'
expm1(x: float): float from 'm'

gcd(a: int, b: int) := if b == 0 then a else gcd(b, a % b)
lcm(a: int, b: int) := a / gcd(a, b) * b
clamp(x, low, high) := if x < low then low else if x > high then high else x
sign(x) := if x > 0 then 1 else if x < 0 then - 1 else 0
// x rounded to the given number of decimal places: round_to(3.14159, 2) is 3.14
round_to(x, digits) := round(x * 10 ^ digits) / 10 ^ digits
factorial(n: int) := { out = 1; for i in 2 to n { out = out * i }; out }
is_prime(n: int) := { if n < 2 { return false }; i = 2; while i * i <= n { if n % i == 0 { return false }; i++ }; true }
// the value a fraction t of the way from a to b
lerp(a, b, t) := a .+ (b .- a) .* t
// lerp's GLSL name; both take numbers and lists of numbers (vectors)
mix=&lerp
// shader math (card compile-shaders, WGSL's words): the fractional part, 0 below the edge and 1 from it, and the smooth
// Hermite step from 0 at low to 1 at high
fract(x) := x - floor(x)
step(edge, x) := if x < edge then 0 else 1
smoothstep(low, high, x) := { var t = clamp((x - low) / (high - low), 0, 1); t * t * (3 - 2 * t) }
// vectors are lists of numbers: their distance, the vector of length 1 along v, the cross product of two 3-vectors and
// the direction i reflected at a surface of normal n
distance(a, b) := norm(a .- b)
normalize(v) := v ./ norm(v)
cross(a, b) := [a#2 * b#3 - a#3 * b#2, a#3 * b#1 - a#1 * b#3, a#1 * b#2 - a#2 * b#1]
reflect(i, n) := i .- (2 * dot(n, i)) .* n
is_even(n: int) := n % 2 == 0
is_odd(n: int) := n % 2 != 0
// the decimal digits of a whole number: digits(1234) is [1 2 3 4]
digits(n: int) := { out = []; rest = abs(n); while rest >= 10 { out = [rest % 10] + out; rest = rest /! 10 }; [rest] + out }
// the number of ways to choose k of n (the binomial coefficient)
choose(n: int, k: int) := { if k < 0 or k > n { return 0 }; out = 1; for i in 1 to min(k, n - k) { out = out * (n - min(k, n - k) + i) /! i }; out }
// base^exponent % modulus without the huge power
mod_pow(base: int, exponent: int, modulus: int) := { out = 1; b = base % modulus; e = exponent; while e > 0 { if e % 2 == 1 { out = out * b % modulus }; b = b * b % modulus; e = e /! 2 }; out }
// part as a percentage of whole: percent(1, 4) is 25
percent(part, whole) := part * 100.0 / whole
to_radians(degrees) := degrees * pi / 180
to_degrees(radians) := radians * 180 / pi
// the whole square root, rounded down
isqrt(n: int) := { r = floor(sqrt(n)) as int; while r * r > n { r = r - 1 }; while (r + 1) * (r + 1) <= n { r = r + 1 }; r }
is_square(n: int) := n >= 0 and isqrt(n) * isqrt(n) == n
divisors(n: int) := [d for d in 1..n + 1 if n % d == 0]
prime_factors(n: int) := { out = []; rest = n; d = 2; while d * d <= rest { while rest % d == 0 { out = out + [d]; rest = rest /! d }; d++ }; if rest > 1 { out = out + [rest] }; out }
// the one bits of whole numbers ≥ 0 (`&` and `|` are logical, `xor` is bitwise already): bit_count(6) is 2
bit_count(n: int) := { out = 0; rest = n; while rest > 0 { out = out + rest % 2; rest = rest /! 2 }; out }
// two's-complement bits of any whole numbers, by a + b = (a xor b) + 2 * bit_and(a, b): bit_and(-129, 127) is 127
bit_and(a: int, b: int) := (a + b - (a xor b)) / 2
bit_or(a: int, b: int) := (a + b + (a xor b)) / 2
// P169/P191: descriptive names; they forward to the C library (use cmath) until warp has its own implementations.
// The C names still work after `use math`, each with a note naming the word here (modules STD_ALIASES)
square(x) := x * x
square_root(x) := sqrt(x)
cube_root(x) := ∛x
power(base, exponent) := base ^ exponent
exponential(x) := exp(x)
natural_log(x) := log(x)
binary_log(x) := log2(x)
decimal_log(x) := log10(x)
// the logarithm of x to any base: logarithm(8, 2) is 3
logarithm(x, base) := log(x) / log(base)
sine(x) := sin(x)
cosine(x) := cos(x)
tangent(x) := tan(x)
arc_sine(x) := asin(x)
arc_cosine(x) := acos(x)
arc_tangent(x) := atan(x)
# arcsine(x) := asin(x)
# arccosine(x) := acos(x)
# arctangent(x) := atan(x)
arcsin=&arc_sine
arccos=&arc_cosine
arctan=&arc_tangent
# arctan:=arc_tangent
// the angle of the point (x, y) from the x axis, in radians: C's atan2(y, x)
angle(x, y) := atan2(y, x)
hyperbolic_sine(x) := sinh(x)
hyperbolic_cosine(x) := cosh(x)
hyperbolic_tangent(x) := tanh(x)
// the length of the long side of a right triangle with sides a and b
hypotenuse(a, b) := hypot(a, b)
ceiling(x) := ceil(x)
// x without its fraction, toward zero: whole_part(-2.5) is -2
whole_part(x) := trunc(x)
// what remains of a after taking out b as often as it fits, with the sign of a (C's fmod)
remainder(a, b) := fmod(a, b)
