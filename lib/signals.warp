// The standard module signals (card signals-lib): a variable's listeners. `on set x {…}` runs its block after each
// later write of x, the block reading the written value as `value` and the one before as `old`; `on change x {…}`
// only when the write changed it; `whenever x > 1 {…}` each time the condition comes to hold after a write of a name it
// reads, `once x == 5 {…}` the first time only. The program rule (extensions/rules/rule_words.warp signaled) makes each watched write notify the listeners
use timers
// how often a listened system value is read
SYSTEM_VALUE_POLL = 250ms
// `on change online {…}`, `on change dark mode {…}`: a system value is a word without arguments the program does not
// define, read every SYSTEM_VALUE_POLL by a timer (lib/timers.warp: the page runs it, natively none starts)
rewrite on change dark mode $body: block => on change dark_mode $body
rewrite on set $x $body: block => variable_listen([$n], no, (value, old) => $body) where $x is symbol and $n = spelled($x)
rewrite on change $x $body: block => variable_listen([$n], yes, (value, old) => $body) where $x is symbol and $n = spelled($x)
// `on change b + c {…}`: the block runs when a write of a name it reads changed the expression's value
rewrite on change $x $body: block => $listens where not $x is symbol and $listens = change_listens($x, $body)
rewrite whenever $c $body: block => $listens where $listens = whenever_listens($c, $body)
rewrite once $c $body: block => $listens where $listens = once_listens($c, $body)
// the same with the block after a colon, `whenever x > 2: print "big"`
rewrite on set $x: $body => variable_listen([$n], no, (value, old) => $body) where $x is symbol and $n = spelled($x)
rewrite on change $x: $body => variable_listen([$n], yes, (value, old) => $body) where $x is symbol and $n = spelled($x)
rewrite on change $x: $body => $listens where not $x is symbol and $listens = change_listens($x, $body)
rewrite whenever $c: $body => $listens where $listens = whenever_listens($c, $body)
rewrite once $c: $body => $listens where $listens = once_listens($c, $body)

// a watched name's listeners are the listeners of the event of that name (lib/prelude.warp listen), so a listener is
// numbered as an event's: `h = on set x {…}`, `listeners of x`, `remove h from listeners of x`; the number within the
// last name it listens to
variable_listen(names: list, changes_only: bool, listener: function): int := {
	number = 0
	for name in names { number = listen(if name is Signal then name.name else name, written => if not changes_only or written#1 != written#2 { listener(written#1, written#2) }, no) }
	number
}
// the listeners of the name told of its write, from old to value, as its event with [value, old]; the value. A
// listener writing what it watches (`on change x { x = x + 1 }`) writes it without telling the listeners again, so a
// write never loops
global signals_notifying = []
signal_notify(name: text, value: any, old: any): any := {
	signal_values[name] = value
	if name in signals_notifying { return value }
	signals_notifying = signals_notifying + [name]
	emitted(name, [value, old])
	signals_notifying = signals_notifying.filter(notifying => notifying != name)
	value
}

// a variable passed in a list literal to a function listening to its loop variable (notes/signals.md "Lists of
// signals"): the variable itself, its name and its value as last written, which a bare read of the loop variable gives
class Signal { name: text; value: any }
global signal_values = {}
signal_value(item: any): any := if item is Signal then signal_values.get(item.name) ?? item.value else item

// each polled word's last value, a listener's at its position
global polled_values = []
value_listened(read: function, listener: function): int := {
	polled_values.add(read())
	at = count(polled_values)
	timer_every(SYSTEM_VALUE_POLL, () => value_polled(at, read, listener))
}
value_polled(at: int, read: function, listener: function): any := {
	value = read()
	old = polled_values#at
	if value != old {
		polled_values#at = value
		listener(value, old)
	}
}

// the host words of this module, which the host answers (natively core/native/driver.warp, the playground its JS)
notify(name: node) from host
dispatch_event(name: node, detail: node) from host
