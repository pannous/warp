// The standard module fast_math (card switch-rebinds): `use fast_math`, or `warp fast <file>` for the whole program, rebinds sin, cos,
// exp, pow and atan2 to polynomials of plain wasm arithmetic instead of calls into the C library, for hot loops such as
// shaders run on the CPU: 10^7 calls of sin or atan2 take ~0.6 s through the C library, ~0.05 s so.
// sqrt is the wasm instruction already; `^` stays the C library's pow. Each word then takes and gives floats; the
// largest error against the C library, measured on 20001 points:
//   sin cos      6e-12 for |x| ≤ 1000 (grows with |x|: the reduction by τ loses the digits of x / τ beyond 2^52)
//   exp          8e-14 relative, from x = -700 to 700
//   pow          1e-14 relative, base > 0; a negative base takes whole exponents only (others give nan)
//   atan2        3e-12 radians
use machine_math

sin(x: float): float := fast_sin(x)
cos(x: float): float := fast_cos(x)
exp(x: float): float := fast_exp(x)
pow(base: float, exponent: float): float := fast_pow(base, exponent)
atan2(y: float, x: float): float := fast_atan2(y, x)
