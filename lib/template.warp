// The standard library module template: `use template`, Mustache templates (mustache.github.io, the spec's interpolation,
// sections, inverted sections, comments, partials and set-delimiter; no lambdas): mustache("Hi {{name}}!", {name: "Ada"})
// is "Hi Ada!". {{x}} is HTML-escaped, {{{x}}} and {{& x}} are not; {{a.b}} looks a name up through the contexts,
// {{.}} is the current one; {{#x}}…{{/x}} hides for false, nil or an empty list, repeats for a list and enters a map;
// {{^x}}…{{/x}} shows only for those; {{! …}} is a comment, {{> name}} the partial of that name, {{=<% %>=}} changes the
// delimiters; a tag alone on its line takes the line with it (the spec's standalone rule)
use html
use text

STANDALONE_KINDS = ["#", "^", "/", "!", ">", "="]

// the template as text pieces and tags, each a map {kind, name, text, indent}
def template_tokens(t: text): list {
	tokens = []
	open = "{{"
	close = "}}"
	rest = t
	while rest != "" {
		at = rest.index_of(open)
		if at == 0 { tokens.add({kind: "text", name: "", text: rest, indent: ""}); rest = "" }
		else {
			if at > 1 { tokens.add({kind: "text", name: "", text: rest[0 ..< at - 1], indent: ""}) }
			rest = rest[at - 1 + count(open)..]
			triple = open == "{{" and rest.starts_with("{")
			ending = if triple then "}" + close else close
			end = rest.index_of(ending)
			if end == 0 { raise "unclosed tag " + open + rest }
			content = trim(rest[0 ..< end - 1])
			rest = rest[end - 1 + count(ending)..]
			kind = if triple then "&" else if content != "" and "!#^/>&=".contains(content[0]) then content[0] else "name"
			name = if triple or kind == "name" then content else trim(content[1..])
			if kind == "=" {
				pair = [w for w in split(trim(name[0 ..< count(name) - 1]), " ") if w != ""]
				open = pair[0]
				close = pair[1]
			}
			tokens.add({kind: kind, name: if triple then trim(name[1..]) else name, text: "", indent: ""})
		}
	}
	tokens
}

is_blank_run(t: text): bool := all([c for c in t], c => c == " " or c == "\t")
// line breaks, LF or CRLF (a CRLF is one character of a text)
is_break(c: any): bool := c == "\n" or c == "\r\n"
has_break(t: text): bool := any([c for c in t], c => is_break(c))
// the 0-based place of the first line break, -1 for none
first_break(t: text): int := { cs = [c for c in t]; at = -1; for i in 0 ..< count(cs) { if at < 0 and is_break(cs[i]) { at = i } }; at }
// the part of a text after its last line break, the whole text without one
line_tail(t: text): text := { cs = [c for c in t]; at = -1; for i in 0 ..< count(cs) { if is_break(cs[i]) { at = i } }; join(cs[at + 1..], "") }
// whether the tag at i is alone on its line, only spaces and tabs beside it
def is_standalone(tokens: list, i: int): bool {
	if not (tokens[i].kind in STANDALONE_KINDS) { return no }
	before_ok = i == 0 or (tokens[i - 1].kind == "text" and (has_break(tokens[i - 1].text) or i == 1) and is_blank_run(line_tail(tokens[i - 1].text)))
	if i + 1 == count(tokens) { return before_ok }
	after = tokens[i + 1]
	before_ok and after.kind == "text" and (if has_break(after.text) then is_blank_run(join([c for c in after.text][0 ..< first_break(after.text)], "")) else is_blank_run(after.text) and i + 2 == count(tokens))
}
// the spec's standalone rule: a section, inverted, closing, comment, partial or delimiter tag with only spaces and tabs
// beside it on its line loses them and the line break after it; a partial keeps that indentation for its lines
def standalone_trimmed(tokens: list): list {
	// decided on the template as written, then applied: a trim never hides the next tag's line
	standalone = [is_standalone(tokens, i) for i in 0 ..< count(tokens)]
	out = tokens
	for i in 0 ..< count(out) {
		if standalone[i] {
			tag = out[i]
			if i > 0 {
				previous = out[i - 1]
				tail = line_tail(previous.text)
				out[i - 1] = {kind: "text", name: "", text: join([c for c in previous.text][0 ..< count(previous.text) - count(tail)], ""), indent: ""}
				out[i] = {kind: tag.kind, name: tag.name, text: "", indent: tail}
			}
			if i + 1 < count(out) {
				after = out[i + 1]
				cut = first_break(after.text)
				out[i + 1] = {kind: "text", name: "", text: if cut < 0 then "" else join([c for c in after.text][cut + 1..], ""), indent: ""}
			}
		}
	}
	out
}

// the tokens from start as nodes up to the closing tag of name ("" for the end): [nodes, the position after]
def template_nodes(tokens: list, start: int, name: text): list {
	nodes = []
	i = start
	while i < count(tokens) {
		token = tokens[i]
		if token.kind == "/" {
			if token.name != name { raise "{{/" + token.name + "}} closes no {{#" + token.name + "}}" }
			return [nodes, i + 1]
		}
		if token.kind == "#" or token.kind == "^" {
			inner = template_nodes(tokens, i + 1, token.name)
			nodes.add({kind: token.kind, name: token.name, text: "", indent: "", children: inner[0]})
			i = inner[1]
		} else {
			nodes.add({kind: token.kind, name: token.name, text: token.text, indent: token.indent, children: []})
			i = i + 1
		}
	}
	if name != "" { raise "{{#" + name + "}} is not closed" }
	[nodes, i]
}

// a name through the stack of contexts, innermost first; its dotted parts inside the first one found; nil for none
def template_lookup(stack: list, name: text): any {
	if name == "." { return stack[count(stack) - 1] }
	parts = split(name, ".")
	value = nil
	found = no
	i = count(stack) - 1
	while not found and i >= 0 {
		context = stack[i]
		if context is map and parts[0] in keys(context) { value = context[parts[0]]; found = yes }
		i = i - 1
	}
	for part in parts[1..] { value = if value is map and part in keys(value) then value[part] else nil }
	value
}
is_falsey(value: any): bool := value == nil or (value is bool and not value) or (value is list and count(value) == 0)
template_value_text(value: any): text := if value == nil then "" else if value is text then value else str(value)
// a partial's lines each after the indentation of its standalone tag
indented(t: text, indent: text): text := if indent == "" then t else {
	lines = split(t, "\n")
	join([if i == count(lines) - 1 and lines[i] == "" then "" else indent + lines[i] for i in 0 ..< count(lines)], "\n")
}

def template_render(nodes: list, stack: list, partials: map): text {
	out = ""
	for node in nodes {
		kind = node.kind
		if kind == "text" { out = out + node.text }
		else if kind == "name" { out = out + html_escape(template_value_text(template_lookup(stack, node.name))) }
		else if kind == "&" { out = out + template_value_text(template_lookup(stack, node.name)) }
		else if kind == "#" {
			value = template_lookup(stack, node.name)
			if not is_falsey(value) {
				if value is list { for item in value { out = out + template_render(node.children, stack + [item], partials) } }
				else { out = out + template_render(node.children, stack + [value], partials) }
			}
		}
		else if kind == "^" { if is_falsey(template_lookup(stack, node.name)) { out = out + template_render(node.children, stack, partials) } }
		else if kind == ">" {
			if node.name in keys(partials) { out = out + template_render(template_tree(indented(partials[node.name], node.indent)), stack, partials) }
		}
	}
	out
}
template_tree(t: text): list := template_nodes(standalone_trimmed(template_tokens(t)), 0, "")[0]

// the template filled in from the context (a map, or any value for {{.}}), its partials by name
mustache(t: text, context: any, partials: map): text := template_render(template_tree(t), [context], partials)
mustache(t: text, context: any): text := mustache(t, context, {})
