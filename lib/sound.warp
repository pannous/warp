// The standard library module sound (card basic-sound): `play 440Hz for 0.5s`, `play C4`, `play [C4 E4 G4]` (a chord, as
// in Sonic Pi), `play note("C#4")`, `melody [C4 E4 G4]` (one note after another), `beep`, `tone(frequency, seconds, "square")`. Frequencies
// and durations are numbers or quantities (440Hz, 0.5s, 250ms), read by si_amount as plain numbers (src/units/static_units.rs). The samples are made here and played by the host word
// sound_samples: natively a WAV file and the system's player (src/sound.rs; silent under tests and WARP_NO_WINDOW),
// in the browser WebAudio. Loaded when a program calls one of its words (src/modules.rs SOUND_WORDS)
global sample_rate = 22050
// the share of the loudest sample: chords and melodies stay below it
global loudness = 0.3 as float
// sine, square, triangle, sawtooth or noise
global wave_shape = "sine"
// `as float`: a float assigned later (loudness = -6 dB) stays readable in the functions (card float-global)
global note_seconds = 0.5 as float
// beats per minute: `play C4 for 1/4 beat`, `melody [C4 E4] each 1/8 beat`, `sleep 1 bar` (src/lowering/music_words.rs)
global tempo = 120
global beats_per_bar = 4
beat_seconds(beats) := beats * 60.0 / tempo
bar_seconds(bars) := beat_seconds(bars * beats_per_bar)
// the samples cross to the host as whole numbers ≥ 0: amplitude + 32768 (src/sound.rs SAMPLE_OFFSET)
sample_offset = 32768
loudest_sample = 32767
// the envelope of every note (ADSR): it rises for attack seconds, falls for decay seconds to the sustain share and
// fades out in its last release seconds; the short default fades keep the speaker from clicking
global attack = 0.005 as float
global decay = 0.0 as float
global sustain = 1.0 as float
global release = 0.005 as float
// a note letter's semitone above C is its place here, from 0
scale_letters = "C.D.EF.G.A.B"

// the frequency of a note name: note("A4") is 440, note("C#4") a semitone above C4, note("Eb5") one below E5
note(name) := {
	accidental = if count(name) == 3 then (if name#2 == "#" or name#2 == "♯" then 1 else -1) else 0
	octave = number(name#(count(name)))
	key = 12 * (octave + 1) + scale_letters.index_of(name#1) - 1 + accidental
	440.0 * 2^((key - 69) / 12)
}
// the gain factor of decibels: loudness = -6 dB is about half (src/lowering/music_words.rs reads `-6 dB`)
decibels(level) := 10^(level / 20.0)
// note names (C4, F#4, Bb3, any octave 0–9) are their frequencies in a program that uses sound: the compiler parses them
// (src/lowering/music_words.rs), as note(name) does at run time

// one wave at phase p (0 to 1) of its period, from -1 to 1
wave(shape, p) := if shape == "square" then (if p < 0.5 then 1.0 else -1.0)
	else if shape == "triangle" then 1 - 4 * abs(p - 0.5)
	else if shape == "sawtooth" then 2 * p - 1
	else if shape == "noise" then 2 * random() - 1
	else sin(2 * pi * p)
// how far a ramp of seconds has come after steps samples: 0 to 1
ramp(steps, seconds) := if seconds <= 0 then 1.0 else min(1.0, steps / (seconds * sample_rate))
// the level of sample i of n (ADSR): 0 at both ends
envelope(i, n) := {
	t = i / sample_rate
	held = if t < attack then 1.0 else 1 - (1 - sustain) * ramp(i - attack * sample_rate, decay)
	ramp(i, attack) * held * ramp(n - 1 - i, release)
}
// the samples of frequencies sounding together
chord_samples(pitches, duration, shape) := {
	n = round(duration * sample_rate) as int
	share = loudness * loudest_sample / count(pitches)
	[sample_offset + (round(share * envelope(i, n) * sum([wave(shape, (f * i / sample_rate) % 1) for f in pitches])) as int) for i in 0..n]
}
// the sound's handle: its number in the run, for stop_sound(handle)
sound(samples) := {
	sound_samples(samples, count(samples), sample_rate)
	std_io("sound", "last", [])
}

// one wave shape: tone 440Hz for 0.5s (a sine), tone(220Hz, 100ms, "square")
tone(pitch, duration, shape) := sound(chord_samples([si_amount(pitch)], si_amount(duration), shape))
to tone pitch for duration: tone(pitch, duration, wave_shape)
beep() := tone(880, 0.15, "square")
// a frequency, or a list of them sounding together (a chord)
pitches_of(x) := if x is list then [si_amount(f) for f in x] else [si_amount(x)]
to play x for duration: sound(chord_samples(pitches_of(x), si_amount(duration), wave_shape))
// a music file in the background (wav, mp3, ogg, flac, aiff, m4a): play "song.mp3"; stop_sound stops it
play_file(path) := std_io("sound", "play_file", [path])
// play gives the sound's handle: h = play C4 for 2s; stop_sound(h) stops that one alone, stop_sound (handle 0) all
stop_sound(handle = 0) := std_io("sound", "stop", [handle])
// play returns at once, its sound queued behind those before it: sound_queued() is how many seconds its voice still sounds,
// wait_sound waits for them (a program's end does too)
sound_queued() := std_io("sound", "queued", [])
wait_sound() := std_io("sound", "wait", [])
// the sounds since the last render (or the start) one after another in one WAV file, offline (also without speakers):
// render_sound("song.wav") gives its seconds
render_sound(path) := std_io("sound", "render", [path])
to play x: if x is text then play_file(x) else sound(chord_samples(pitches_of(x), note_seconds, wave_shape))
// one note (or chord) after another: melody [C4 E4 G4], melody [C4 E4 G4] each 250ms (or melody([C4 E4 G4], 0.25s))
// plain seconds: the unit check reads a quantity parameter in a loop as unsupported (notes/units_runtime.md)
melody_samples(notes, seconds) := {
	samples = []
	for pitch in notes { samples = samples + chord_samples(pitches_of(pitch), seconds, wave_shape) }
	samples
}
to melody notes each duration: sound(melody_samples(notes, si_amount(duration)))
to melody notes: melody(notes, note_seconds)

// how loud each frequency band sounds at a moment of the samples (card winamp-like, samples/visualizer.warp): the bands
// spaced evenly in pitch from band_low to band_high Hz, each level from 0 to 1 (a full-scale sine is 1)
global band_low = 60
global band_high = 5000
// the samples a spectrum looks at: 512 at 22050 Hz are 23 ms, bands 43 Hz apart are still told apart
spectrum_window = 512
// the middle frequency of band i of count
band_frequency(i, count) := band_low * (band_high / band_low)^(i / (count - 1))
// the band whose middle frequency is nearest in pitch
nearest_band(frequency, count) := round(log(frequency / band_low) / log(band_high / band_low) * (count - 1)) as int
// how loud frequency f sounds in the window: one term of the discrete Fourier transform, Hann-weighted so a tone between
// two bands does not leak into the far ones
def band_level(window, f) {
	n = count(window)
	step = 2 * pi * f / sample_rate
	re = 0.0
	im = 0.0
	for i in 0..n {
		weighted = (window[i] - sample_offset) * (0.5 - 0.5 * cos(2 * pi * i / (n - 1)))
		re = re + weighted * cos(step * i)
		im = im + weighted * sin(step * i)
	}
	4 * sqrt(re * re + im * im) / n / loudest_sample
}
def spectrum(samples, seconds, bands) {
	start = min(round(seconds * sample_rate) as int, count(samples))
	window = samples[start..min(start + spectrum_window, count(samples))]
	if count(window) < 2 { return [0 for i in 0..bands] }
	[band_level(window, band_frequency(i, bands)) for i in 0..bands]
}
