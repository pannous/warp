// The standard module timers (card registers-page): `on every 500ms {…}` and `on every 2 seconds {…}` run their block at
// each period, `at 9:30 {…}` once at that time of day, `on every day at 9:30 {…}` each day at it. A page runs them (web/playground/host-timers.js): the program tells the host each timer by the host word
// signal_listen(kind, id, argument) and the page calls back the exported timer_fired(id) at each firing; the native warp
// the same, once main returned (core/native/driver.warp events): an `every` timer keeps the run going until exit()
use units
TIMER_EVERY = 0
TIMER_CLOCK = 2
// a clock timer's argument, weekdays * 10000 + minute of the day: the weekdays a mask (bit 0 Sunday), 0 once
WEEKDAYS_SHIFT = 10000
EVERY_DAY = 127
ONCE = 0
rewrite on every day at $time $body: block => timer_at($time, EVERY_DAY, () => $body)
rewrite on every day at $time {} => timer_at($time, EVERY_DAY, () => ø)
// a bare `at` only of a clock time, hours:minutes: sound's `at bars(0) {…}` places its block on the beat clock (card
// wasm-trap: taken as a clock time, it trapped)
rewrite at $hour:$minute $body: block => timer_at($hour:$minute, ONCE, () => $body)
rewrite on every $period $body: block => timer_every($period, () => $body)
rewrite on every $count $unit $body: block => timer_every($count $unit, () => $body)
rewrite on every $period: $body => timer_every($period, () => $body)
// an empty block, `{}`, reads as a map, which no block hole takes
rewrite on every $period {} => timer_every($period, () => ø)
rewrite on every $count $unit {} => timer_every($count $unit, () => ø)

// the handlers of the program's timers, a timer's id its position
global timer_handlers = []
timer_started(kind: int, argument: int, handler: function): int := {
	timer_handlers.add(handler)
	timer_periods.add(if kind == TIMER_EVERY then argument else 0)
	timer_dues.add(0)
	id = count(timer_handlers)
	if id == 1 { listen(TIMER_TICK, now => timers_ticked(now), no) }
	signal_listen(kind, id, argument)
	id
}
// A page's window (`warp app`, lib/markup.warp page_window_run) runs the `every` timers itself, as its loop never returns
// to the host's: each of its ticks, now in milliseconds since 1970, fires those due; the milliseconds till the next is
// due back, -1 for none (a clock timer, `at 9:30`, runs only in the playground's page and after a native main yet)
TIMER_TICK = "tick"
global timer_periods = []
global timer_dues = []
timers_ticked(now: int): int := {
	wait = -1
	for at in 0 ..< count(timer_handlers) {
		period = timer_periods[at]
		if period > 0 {
			if timer_dues[at] == 0 { timer_dues[at] = now + period }
			if now >= timer_dues[at] {
				timer_dues[at] = max(timer_dues[at] + period, now)
				timer_fired(at + 1)
			}
			left = timer_dues[at] - now
			if wait < 0 or left < wait { wait = left }
		}
	}
	wait
}
timer_every(period: any, handler: function): int := timer_started(TIMER_EVERY, floor(period / 1ms) as int, handler)
// `9:30`, the pair of an hour and its minutes
timer_at(time: any, weekdays: int, handler: function): int := timer_started(TIMER_CLOCK, weekdays * WEEKDAYS_SHIFT + key_of(time) * 60 + value_of(time), handler)
// the handler named before its call: `timer_handlers#id()` calls no function ("not a function")
export timer_fired(id: int) := {
	handler = timer_handlers#id
	handler()
}

// the host words of this module, which the host answers (natively core/native/driver.warp, the playground its JS)
signal_listen(signal: int, changes_only: int, listener: int) from host
