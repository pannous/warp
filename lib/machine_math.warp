// The C library's sin, cos, exp, pow and atan2 as polynomials of plain wasm arithmetic, named fast_sin … fast_atan2:
// lib/fast_math.warp rebinds a whole program's sin … to them, extensions/fast.warp a `fast` function's alone (card
// fast-declaration). Their precision is fast_math's, said there.
// π and τ as floats, as the rest is plain float arithmetic: the exact reals' π makes a sum with it a Real
half_turn = 3.141592653589793
full_turn = 6.283185307179586

// sin of x reduced to [-π/2, π/2]: its Taylor series to x^15, whose next term is below 1e-11 there
global fast_sin(x: float): float := {
	r = x - round(x / full_turn) * full_turn
	if r > half_turn / 2 { r = half_turn - r } else if r < -half_turn / 2 { r = -half_turn - r }
	s = r * r
	r * (1.0 + s * (-0.16666666666666666 + s * (0.008333333333333333 + s * (-0.0001984126984126984 + s * (2.7557319223985893e-06 + s * (-2.505210838544172e-08 + s * (1.6059043836821613e-10 + s * -7.647163731819816e-13)))))))
}
global fast_cos(x: float): float := fast_sin(x + half_turn / 2)
// e^x = 2^k · e^r with r in [-ln 2 / 2, ln 2 / 2]: the Taylor series of e^r to r^13, then 2^k by squaring halves
global fast_exp(x: float): float := {
	if x > 709.78 { return 1.0 / 0.0 }
	if x < -745.2 { return 0.0 }
	k = round(x / 0.6931471805599453)
	r = x - k * 0.6931471805599453
	e = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * (2.755731922398589e-06 + r * (2.755731922398589e-07 + r * (2.505210838544172e-08 + r * (2.08767569878681e-09 + r * 1.6059043836821613e-10))))))))))))
	e * two_to(k)
}
// 2^k of a whole k by repeated squaring, halved into two factors so 2^-1074 … 2^1023 stay in range
two_to(k: float): float := {
	out = 1.0
	base = if k < 0 then 0.5 else 2.0
	rest = abs(k)
	while rest > 0 { if rest % 2 == 1 { out = out * base }; base = base * base; rest = floor(rest / 2) }
	out
}
// ln x (x > 0) = 2 atanh((m - 1) / (m + 1)) + e ln 2 for x = m · 2^e, m in [√½, √2): the atanh series to the 31st power
positive_ln(x: float): float := {
	if x <= 0 { return if x == 0 then -1.0 / 0.0 else 0.0 / 0.0 }
	m = x
	e = 0
	while m >= 1.4142135623730951 { m = m / 2; e = e + 1 }
	while m < 0.7071067811865476 { m = m * 2; e = e - 1 }
	t = (m - 1) / (m + 1)
	s = t * t
	sum = 0.0
	n = 31
	while n > 0 { sum = sum * s + 1.0 / n; n = n - 2 }
	2 * t * sum + e * 0.6931471805599453
}
global fast_pow(base: float, exponent: float): float := {
	if exponent == 0 { return 1.0 }
	if base > 0 { return fast_exp(exponent * positive_ln(base)) }
	if base == 0 { return if exponent > 0 then 0.0 else 1.0 / 0.0 }
	if exponent - floor(exponent) > 0 { return 0.0 / 0.0 }
	magnitude = fast_exp(exponent * positive_ln(-base))
	if exponent % 2 == 0 then magnitude else -magnitude
}
// atan of t in [0, 1]: reduced to [0, tan π/12] by atan t = π/6 + atan((t√3 - 1) / (t + √3)), then its series to t^17
small_atan(t: float): float := {
	shifted = t > 0.2679491924311227
	u = if shifted then (t * 1.7320508075688772 - 1) / (t + 1.7320508075688772) else t
	s = u * u
	a = u * (1.0 + s * (-0.3333333333333333 + s * (0.2 + s * (-0.14285714285714285 + s * (0.1111111111111111 + s * (-0.09090909090909091 + s * (0.07692307692307693 + s * (-0.06666666666666667 + s * 0.058823529411764705))))))))
	if shifted then a + half_turn / 6 else a
}
// the angle of the point (x, y) from the x axis in (-π, π], y first as C's atan2
global fast_atan2(y: float, x: float): float := {
	if x == 0 and y == 0 { return 0.0 }
	ay = abs(y)
	ax = abs(x)
	a = if ay <= ax then small_atan(ay / ax) else half_turn / 2 - small_atan(ax / ay)
	if x < 0 { a = half_turn - a }
	if y < 0 then -a else a
}
