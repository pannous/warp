// The standard library module splats: Gaussian splats as a capture keeps them, in the .splat file web viewers read
// (antimatter15/splat): a record of 32 bytes each splat, its position and its scale (three little-endian f32 each),
// its color and opacity (red, green, blue, alpha: a byte each) and its rotation, the unit quaternion [w, x, y, z] a
// byte each component (q · 128 + 128). read_splats(./tree.splat) is the list of its Splats, write_splats writes one
use bits
use color
use file
use math

splat_record_size = 32

class Splat { position: list; scale: list; rotation: list; color: Color; opacity: float }

// the splats of a .splat file, in its order (a capture puts the biggest, most opaque ones first)
read_splats(path: any): list := splats_of(read_bytes(path))
write_splats(path: any, splats: list) := write_bytes(path, splats_bytes(splats))

splats_of(bytes: list): list := [splat_at(bytes, splat_record_size * i) for i in 0 ..< count(bytes) /! splat_record_size]
splat_at(bytes: list, at: int): Splat := Splat(record_floats(bytes, at, 0, 3), record_floats(bytes, at, 3, 6), normalize(record_quaternion(bytes, at)), rgb(bytes[at + 24], bytes[at + 25], bytes[at + 26]), bytes[at + 27] / 255.0)
record_floats(bytes: list, at: int, from: int, to: int): list := [f32_at(bytes, at + 4 * k) for k in from ..< to]
record_quaternion(bytes: list, at: int): list := [(bytes[at + 28 + k] - 128) / 128.0 for k in 0 ..< 4]

// the six upper-triangle numbers of Σ = R S² Rᵀ, row-major c00 c01 c02 c11 c12 c22. R is the rotation matrix of the
// unit quaternion [w, x, y, z], S the scales along the Gaussian's own axes
covariance_terms(rotation: list, scale: list): list := {
	w = rotation#1; x = rotation#2; y = rotation#3; z = rotation#4
	r00 = 1 - 2 * (y * y + z * z)
	r01 = 2 * (x * y - w * z)
	r02 = 2 * (x * z + w * y)
	r10 = 2 * (x * y + w * z)
	r11 = 1 - 2 * (x * x + z * z)
	r12 = 2 * (y * z - w * x)
	r20 = 2 * (x * z - w * y)
	r21 = 2 * (y * z + w * x)
	r22 = 1 - 2 * (x * x + y * y)
	sx = scale#1 * scale#1
	sy = scale#2 * scale#2
	sz = scale#3 * scale#3
	[r00 * r00 * sx + r01 * r01 * sy + r02 * r02 * sz,
		r00 * r10 * sx + r01 * r11 * sy + r02 * r12 * sz,
		r00 * r20 * sx + r01 * r21 * sy + r02 * r22 * sz,
		r10 * r10 * sx + r11 * r11 * sy + r12 * r12 * sz,
		r10 * r20 * sx + r11 * r21 * sy + r12 * r22 * sz,
		r20 * r20 * sx + r21 * r21 * sy + r22 * r22 * sz]
}

// one depth per splat, the dot of (position − eye) with forward, written into depths when it already has one cell a
// splat (a GPU list [f32] included), else into a new list. The list written
depths_of(scene: list, eye: list, forward: list, depths: list): list := {
	ex = eye#1; ey = eye#2; ez = eye#3
	fx = forward#1; fy = forward#2; fz = forward#3
	n = #scene
	out = if #depths == n then depths else [0.0 for i in 1 to n]
	for i in 1 to n {
		p = scene#i.position
		out#i = (p#1 - ex) * fx + (p#2 - ey) * fy + (p#3 - ez) * fz
	}
	out
}
// indices 0 ..< #depths of the depths at least nearest, the nearest first
order_by_depth(depths: list, nearest: float): list := [i - 1 for i in 1 to #depths].filter(i => depths#(i + 1) >= nearest).sort_by(i => depths#(i + 1))
// the same order of a GPU list [f32] of centres (xyzw per splat), written into `into` as f32, the count of indices
// written. The sample uses this because view_order_into (extensions/gpu_lists/runtime.warp:193) currently refuses on
// the [i32] bin tables it allocates (gpu_list_refused_as at :262; test/modules/test_splat_view_order.pairs.warp)
order_by_depth(centres, eye, forward, nearest, into): int := {
	n = #centres /! 4
	depths = [0.0 for i in 1 to n]
	for i in 0 ..< n {
		b = 4 * i
		depths#(i + 1) = (centres#(b + 1) - eye#1) * forward#1 + (centres#(b + 2) - eye#2) * forward#2 + (centres#(b + 3) - eye#3) * forward#3
	}
	idx = order_by_depth(depths, nearest)
	for i in 1 to #idx { into#i = idx#i }
	#idx
}

// a .splat file laid into the three GPU lists a renderer uploads, without a Splat per record: centres xyz and opacity,
// then the six covariance numbers (shapes, then the first two of shades) and the color's 24 bits. px is not kept apart
// from centres. read_splats is the list of Splats; this is the same bytes for the GPU
class SplatFrame { count: int; centres: list; shapes: list; shades: list }

read_splat_frame(path: any): SplatFrame := splat_frame_of(read_bytes(path))
splat_frame_of(bytes: list): SplatFrame := {
	n = #bytes /! splat_record_size
	centres: [f32] = float[n * 4]
	shapes: [f32] = float[n * 4]
	shades: [f32] = float[n * 4]
	for i in 0 ..< n {
		at = splat_record_size * i
		base = i * 4
		centres#(base + 1) = f32_at(bytes, at)
		centres#(base + 2) = f32_at(bytes, at + 4)
		centres#(base + 3) = f32_at(bytes, at + 8)
		centres#(base + 4) = bytes[at + 27] / 255.0
		c = covariance_terms(normalize(record_quaternion(bytes, at)), record_floats(bytes, at, 3, 6))
		shapes#(base + 1) = c#1
		shapes#(base + 2) = c#2
		shapes#(base + 3) = c#3
		shapes#(base + 4) = c#4
		shades#(base + 1) = c#5
		shades#(base + 2) = c#6
		shades#(base + 3) = (bytes[at + 24] * 65536 + bytes[at + 25] * 256 + bytes[at + 26]) * 1.0
		shades#(base + 4) = 0.0
	}
	SplatFrame(n, centres, shapes, shades)
}

splats_bytes(splats: list): list := {
	bytes = []
	for s in splats { bytes += splat_bytes(s) }
	bytes
}
splat_bytes(s: Splat): list := {
	bytes = []
	for x in s.position + s.scale { bytes += float_bytes(x, 32, "little") }
	bytes + [round(c * 255) as int for c in channels(s.color)] + [round(s.opacity * 255) as int] + [quaternion_byte(q) for q in s.rotation]
}
quaternion_byte(q: float): int := clamp(round(q * 128 + 128) as int, 0, 255)
