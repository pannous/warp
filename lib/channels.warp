// Channels (P155, notes/channels.md): a channel inside one run, written in warp, and `channel "chat"`, the
// machine-wide channel (rust-harness:src/host/channels.rs). The words are rewrite rules (card compiler-modules): every program
// mentioning them gets them, no `use` needed. A task `go {…}` is cooperative (lib/tasks.warp): `ch.receive()` lets
// the tasks run until one sent a value and takes the oldest, `for v in ch {…}` receives until the channel is closed or
// no task is left to send.
use units
use tasks
rewrite channel() => Channel()
rewrite send $v to $c => $c.send($v) where $c = channel()
rewrite (for $item in $c $body) => while $c.more() { $item = $c.receive(); $body } where $c = channel()

class Channel {
	waiting: list = []
	closed: bool = no
	send(value) := {
		if closed { raise "send on a closed channel" }
		waiting += [value]
	}
	// the tasks run until one sent a value or the channel closed
	more() := {
		tasks_run_while(() => #waiting == 0 and not closed, ø)
		#waiting > 0
	}
	receive() := {
		if not more() { raise "receive on a channel no task sends to: every task has ended" }
		oldest = waiting#1
		waiting = waiting[1..]
		oldest
	}
	close() := { closed = yes }
}

// the machine-wide channel listens from its assignment on: a variable holds its name and its listener
rewrite channel $name => machine_channel($name)
rewrite $c.send($v) => channel_send($c#1, $v) where $c = channel $name
rewrite send $v to $c => channel_send($c#1, $v) where $c = channel $name
rewrite $c.receive() => machine_receive($c#2) where $c = channel $name

// listener ids of channel variables, apart from those system_signals counts from 0
global last_listener = 1048576

machine_channel(name) := { last_listener += 1; channel_listen(last_listener, name); [name, last_listener] }
// a receive looks for a message every 5 ms
machine_receive(listener) := { while channel_pending(listener) == 0 { sleep(5 ms) }; channel_next(listener) }
