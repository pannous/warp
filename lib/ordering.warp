// The standard library module ordering: `use ordering`, texts in natural order, their digit runs compared as numbers:
// natural_sort(["a10", "a2", "a1"]) is ["a1", "a2", "a10"]

// a text as its runs of digits and of other characters: "a10b" is ["a", "10", "b"]
def natural_runs(t: text): list {
	runs = []
	run = ""
	for c in t {
		if run != "" and is_digit(c) != is_digit(run[0]) { runs.add(run); run = "" }
		run = run + c
	}
	if run != "" { runs.add(run) }
	runs
}
// -1, 0 or 1: digit runs by their numbers (then fewer leading zeros first), other runs by their characters
def natural_compare(a: text, b: text): int {
	xs = natural_runs(a)
	ys = natural_runs(b)
	for i in 0 ..< min(count(xs), count(ys)) {
		x = xs[i]
		y = ys[i]
		if is_digit(x[0]) and is_digit(y[0]) {
			if int(x) != int(y) { return if int(x) < int(y) then -1 else 1 }
			if count(x) != count(y) { return if count(x) < count(y) then -1 else 1 }
		} else if x != y { return if x < y then -1 else 1 }
	}
	if count(xs) == count(ys) then 0 else if count(xs) < count(ys) then -1 else 1
}
natural_sort(xs: list): list := sorted_in_order(xs, (a, b) => natural_compare(a, b) < 0)
