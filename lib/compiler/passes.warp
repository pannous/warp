# The warp pipeline so far (card parser-tree, notes/self_hosting.md step 13): a source parsed by parser.warp, then
# each pass twin in the order src/pipeline.rs runs its Rust twin. A pass joins here once its twin matches.
use "parser.warp"
use "interpolation.warp"
use "welcome_forms.warp"
use "number_words.warp"
use "of_lookups.warp"
use "definitions.warp"
use "multiple_assignments.warp"
use "clauses.warp"
use "phrase_blocks.warp"
use "comprehensions.warp"
use "for_loops.warp"
use "list_methods.warp"
use "node_matches.warp"
use "node_cases.warp"
use "type_tests.warp"
use "number_keys.warp"
use "tries.warp"
use "prelude_words.warp"
use "preposition_heads.warp"
use "plain_enums.warp"
use "uses.warp"
use "prefix_calls.warp"
use "data_items.warp"
use "parse_words.warp"
use "lambdas.warp"
use "index_positions.warp"
use "arity_overloads.warp"
use "kind_changes.warp"
use "source_checks.warp"
use "main_globals.warp"
use "rewrites.warp"
use "library_calls.warp"

# the keyword rewrites among the sugar passes, one walk (Rust twin: src/pipeline.rs SUGAR_PHRASES, which also lowers
# `xs .* 2` and `(p).a`: lib/sugar/arithmetic.warp's and methods.warp's rules here): `a of b`
sugar_phrases_table = [[is_lookup_word, lookup_phrase]]
sugar_phrases(program: Node): Node := keyword_rewrites(program, sugar_phrases_table)

passes = [interpolation, match_arms, arrow_result_types, sugar_phrases, number_words_pass]

# the pure lane's passes (card pure-runs): the twinned ones (passes#i is stage i Rust drives) between those Rust runs
# outside src/compiler/self_hosted.rs, first principles in warp
pure_passes = [parse_words, tries, definitions, preposition_heads, arity_overloads, clauses, multiple_assignments, type_tests, spaced_prefix_calls] + passes + [bare_returns, first_sugar, node_matches, node_cases, enums_declared, plain_enums, phrase_blocks, comprehensions, data_items, library_calls, sugar, lambdas, for_loops, late_sugar, list_methods, number_keys]

# a node after every pure pass, in order
lowered_node(n: any): any := {
	for pass in pure_passes { n = pass(n) }
	n
}

# the program as the passes leave it, from parser.warp's nodes (card rest-node), with the declarations of the files
# it uses from `folder` (uses.warp) and the definitions they reach of the standard modules they use and of the
# prelude (prelude_words.warp)
lowered_program(source: text, folder: text, prelude: text): Node := lowered_node(with_used(plain_node(parsed(source)), source, folder, prelude))
# the sugar rules the program at hand keeps (with_used), of each sugar step
global kept_first_sugar = []
global kept_sugar = []
# the late sugar rules it keeps (rewrites.warp late_sugar_module_names)
global kept_late_sugar = []
# (the rewrite rules first, as Rust's lowering runs them before any pass: a fired module's `use` brings its words;
# after interpolation, so that a rule sees the code in a text's holes, `"$(2 in xs)"`; declared counts before the
# prelude is reached, so the words index_positions answers with, `byte_index_of` for a `byte index b = t.find(part)`,
# bring their definitions; the source tells a rule's `·` from `*`). The sugar rules the program keeps are chosen here,
# by its own bindings, before the definitions it reaches join it.
with_used(program: Node, source: text, folder: text, prelude: text): Node := {
	own = interpolation(with_uses(program, folder))
	kept_first_sugar = sugar_rules(own, first_sugar_module_names)
	kept_sugar = sugar_rules(own, sugar_module_names)
	kept_late_sugar = sugar_rules(own, late_sugar_module_names)
	with_reached(with_used_modules(with_type_module_uses(index_positions(rewritten_program(own, source))), folder), prelude, no)
}

# the sugar rules (lib/sugar/) the program keeps, over it and the definitions it reached: the first before the passes
# that would read its forms as something else (rewrites.warp first_sugar_module_names), the others where the passes
# before them have made their forms (definitions' `?? []` of a list result) and read the written ones (data_items
# `xs.add(x)`, of_lookups `keys in m`)
first_sugar(program: Node): Node := sugared(program, kept_first_sugar)
sugar(program: Node): Node := sugared(program, kept_sugar)
# the late sugar rules, after for_loops took the loops over a range
late_sugar(program: Node): Node := sugared(program, kept_late_sugar)

# the source text as the passes leave it, as its view
lowered(source: text, folder: text, prelude: text): any := view_of(lowered_program(source, folder, prelude))

# the program as the passes leave it, its checks run (card pure-diagnostics): those of the program as written, then
# those of the lowered program, as Rust runs them; what they find goes to `diagnosed` (diagnostics.warp)
checked_program(source: text, folder: text, prelude: text): Node := {
	program = plain_node(source_checks(parsed(source), prelude))
	own_names = statements_in(program).map(declared_name)
	main_globals(kind_changes(lowered_node(with_used(program, source, folder, prelude))), own_names)
}

# [the view of the checked program, what its checks diagnosed: [level, message, fix] each]
checked(source: text, folder: text, prelude: text): list := [view_of(checked_program(source, folder, prelude)), diagnosed]

# One stage of a compile Rust drives (card warp-pipeline-suite, src/compiler/self_hosted.rs): [0, source] gives the
# parse tree's view, [i, view] the view after passes#i, ["pure", source, folder] the view after all of them and the
# diagnostics of its checks (cards pure-runs, pure-diagnostics), with the definitions of the prelude's text it
# reaches and the program's uses read from its folder
stage(request: any, prelude: text): any := {
	if request#1 == "pure" { return checked(request#2, request#3, prelude) }
	if request#1 == 0 { return bridged(stage_view(parsed(request#2))) }
	pass = passes#(request#1)
	stage_view(pass(stage_node(request#2)))
}
