# The warp pipeline so far (card parser-tree, notes/self_hosting.md step 13): a source parsed by parser.warp, then
# each pass twin in the order src/pipeline.rs runs its Rust twin. A pass joins here once its twin matches.
use "parser.warp"
use "interpolation.warp"
use "welcome_forms.warp"
use "times_phrases.warp"
use "number_words.warp"
use "of_lookups.warp"
use "grouped_receivers.warp"
use "broadcasting.warp"

passes = [interpolation, match_arms, arrow_result_types, of_lookups, grouped_receivers, times_phrases, element_wise_operators_pass, number_words_pass]

# a node after every pass, in order
lowered_node(n: any): any := {
	for pass in passes { n = pass(n) }
	n
}

# the program as the passes leave it, from parser.warp's nodes (card rest-node): what pure runs hand to analyzer.warp
lowered_program(source: text): Node := lowered_node(plain_node(parsed(source)))

# the source text as the passes leave it, as its view
lowered(source: text): any := view_of(lowered_program(source))

# One stage of a compile Rust drives (card warp-pipeline-suite, src/compiler/self_hosted.rs): [0, source] gives the
# parse tree's view, [i, view] the view after passes#i
stage(request: any): any := {
	if request#1 == 0 { return bridged(tree(request#2)) }
	pass = passes#(request#1)
	view_of(pass(node_of(request#2)))
}
