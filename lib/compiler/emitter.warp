# The emitter core (card emits-wasm, notes/self_hosting.md step 15; Rust twin: src/wasm_emitter): the lowered
# program (pipeline::lower) as a node gives a wasm module as a list of bytes, whose main returns the program's value.
# The core knows ints (i64), floats (f64), yes/no conditions (i32), characters (i32), texts (GC byte arrays), lists
# (GC vectors), arithmetic, comparisons, locals, functions, if and while, print (layout: notes/self_hosting.md "Value
# layout"). A value of a kind known only at run time, and a value main gives that is no number, is a boxed `$Node`.
# Runtime words are warp (lib/compiler/runtime.warp, lowered like a program), compiled on their first call. Any other
# form refuses the program: `wasm_module` then gives a text naming the form, and the twin harness
# (tests/common/twins.rs emitter_differential) counts the source as outside the core. A function's parameters take
# their kinds from their annotations, else from the first call; its result kind from its body, read twice so that a
# recursive call knows it.
use "walk.warp"
use "words.warp"
use "signatures.warp"
use "builtin_signatures.warp"
use "kinds.warp"
use "byte_codes.warp"
use math
use os
use "emitter/encoding.warp"
use "emitter/module_layout.warp"
use "emitter/literals.warp"
use "emitter/lists.warp"
use "emitter/instances.warp"
use "emitter/runtime_words.warp"
use "emitter/output.warp"
use "emitter/operators.warp"
use "emitter/functions.warp"
use "emitter/closures.warp"
use "emitter/control_flow.warp"
use "emitter/quotes.warp"
use "emitter/host.warp"
use "emitter/times.warp"
use "emitter/c_functions.warp"

wasm_header = [0, 97, 115, 109, 1, 0, 0, 0]
type_bytes = {int: 126, float: 124, bool: 127, char: 127, i32: 127}
section_ids = {custom: 0, type: 1, import: 2, function: 3, memory: 5, globals: 6, export: 7, code: 10, data: 11, data_count: 12, tag: 13}
function_type_byte = 96
export_function_byte = 0
export_memory_byte = 2
export_global_byte = 3
# the globals the runner reads after a trap (src/run/wasm_reader.rs with_trap_detail): the value a runtime error names,
# the position of the statement it happened in
exported_globals = ["trap_detail", "text_heap", "trap_position"]
# trap_position holds line * columns_per_line + column, Rust's line << 12 | column (src/wasm_emitter/control/traps.rs
# encoded_position)
columns_per_line = 4096
import_function_byte = 0
# the export WASI hosts run a module by (Rust's wasi_emitter.rs WASI_START)
wasi_start = "_start"
# a module that prints imports WASI's fd_write(fd, iovecs, iovec count, written at) → error code, all i32
fd_write_import = ["wasi_snapshot_preview1", "fd_write", [96, 4, 127, 127, 127, 127, 1, 127]]
stdout = 1
# the words that warn, `warning "careful"` and its alias warn (lib/prelude.warp), as a line or a call
warning_words = ["warning", "warn"]
text_heap_name = "text_heap"
# its linear memory, one page: fd_write's iovec {address, count} at 0, the count it wrote at 8, the bytes it writes from
# output_address (an offset of the store, so `output_byte(i, b)` stores at output_address + i)
memory_pages = 1
iovec_address = 0
written_address = 8
output_address = 16
names_subsections = {functions: 1, locals: 2, types: 4, globals: 7, fields: 10, tags: 11}
# `try` (Rust's src/wasm_emitter/control/try_guard.rs): while one runs (try_depth above 0) a runtime error throws the
# tag warp_error(i32), which the try's try_table catches; otherwise it traps as before
error_tag_name = "warp_error"
try_depth_name = "try_depth"
# the message of the error a try caught (error_throw), a text
failed_in_name = "failed_in"
# the trap-only functions of a missing field or switch case: their prefix, then the name (error_function)
no_field_prefix = "no_field_"
no_case_prefix = "no_case_"
# a runtime error's fix after its message (src/wasm_emitter/lists/list_ops/runtime_errors.rs RUNTIME_ERROR_FIXES)
whole_number_fix = "fix: compute it with /! (floor division) or `… as int`"
error_in_data_fix = "handle it with try … else, or declare `or error`"
runtime_error_fixes = {index_must_be_an_integer: whole_number_fix, count_must_be_an_integer: whole_number_fix,
	an_int_must_be_a_whole_number: whole_number_fix, not_a_map: "keys, values and entries are a map's; a list's positions are 1..count(xs)",
	a_list_item_holds_no_error: error_in_data_fix, a_field_holds_no_error: error_in_data_fix}
# `[e 2]`, `q.k = e`: an item written into a list or field, shown `data·item: e`, `data·field: e` (src/compiler/node_views.rs
# SHOWN_LIST_ITEM; lib/compiler/data_items.warp), and the runtime word that fails where it holds an Error
data_item_checks = {"data·item": "held_list_item", "data·field": "held_field"}
# `data e`: e as written (src/lowering/control/blocks.rs DATA_WORD)
catch_clause_byte = 0
mutable = 1
# the GC types ahead of the function types: an array (94) of one [storage type, mutable], a struct (95) of fields
# [storage type, mutable]. $text: the UTF-8 bytes; $list: a vector, its items boxed; $Node(kind i64, data anyref,
# value ref null $Node) a boxed value (CLAUDE.md "Serialization"), its number in an $i64box or $f64box; an exact
# rational an Int $Node holding a $Ratio(numerator, denominator) of two $i64box (src/run/wasm_reader.rs read_payload);
# a positioned node a $MetaNode, the final subtype (79, one supertype) of the open $Node (80, none) adding its line,
# column and comment (src/wasm_emitter/type_manager.rs emit_meta_node_type); an integer beyond 64 bits an Int $Node
# holding a $BigInt(negative, limbs), its magnitude little-endian base 2^32 limbs in a $Limbs array of i32, no leading
# zero one (Rust's $BigInt, read back by read_payload; runtime/extended/big_ints.warp).
# A module declares a type only once its code uses it, as it compiles a runtime word on its first call (decision
# runtime-split): gc names each type by its name, and gc_type gives the index the module takes it under. A type
# another type refers to is written as that type's name in gc_types (gc_bytes), and comes first
gc = {text: "text", items: "items", list: "list", node: "Node", int_box: "i64box", float_box: "f64box", ratio: "Ratio", meta_node: "MetaNode", limbs: "Limbs", big_int: "BigInt"}
node_fields = [126, 0, 110, 0, 99, gc.node, 0]
gc_types = [[94, 120, 1], [94, 110, 1], [95, 2, 127, 1, 100, gc.items, 1], [80, 0, 95, 3] + node_fields, [95, 1, 126, 0], [95, 1, 124, 0], [95, 2, 110, 0, 110, 0],
	[79, 1, gc.node, 95, 6] + node_fields + [126, 0, 126, 0, 99, gc.node, 0], [94, 127, 1], [95, 2, 127, 0, 99, gc.limbs, 0]]
gc_names = [["text", []], ["items", []], ["list", ["length", "items"]], ["Node", ["kind", "data", "value"]], ["i64box", ["value"]], ["f64box", ["value"]], ["Ratio", ["numerator", "denominator"]],
	["MetaNode", ["kind", "data", "value", "line", "column", "comment"]], ["Limbs", []], ["BigInt", ["negative", "limbs"]]]
# the kinds held as a reference: a text, a list, a boxed value of any kind ("node", also ø) as anyref
# a time, a $Node of Kind time held as anyref like a node, is its own kind so that only what handles times takes one
references = {text: [99, gc.text], list: [99, gc.list], node: [110], time: [110]}
passive_segment = 1
# block type of a block that leaves nothing
no_value = 64
# opcodes (WebAssembly core spec, section 5.4)
op = {unreachable: 0, block: 2, loop: 3, if: 4, else: 5, end: 11, br: 12, br_if: 13, return: 15, call: 16, drop: 26, select: 27,
	local_get: 32, local_set: 33, local_tee: 34, global_get: 35, global_set: 36, i32_load: 40, i32_load8_u: 45, i32_store: 54, i32_store8: 58,
	i32_const: 65, i64_const: 66, f64_const: 68, i32_eqz: 69, i64_eqz: 80, i64_eq: 81, i64_ne: 82, i64_lt_s: 83, i64_ge_u: 90, f64_ne: 98, i32_sub: 107, i32_and: 113, i32_or: 114,
	i64_div_s: 127, i64_rem_s: 129, i64_and: 131, f64_ceil: 155, f64_floor: 156, f64_trunc: 157, f64_nearest: 158, f64_sub: 161, f64_mul: 162, f64_div: 163, f64_abs: 153, f64_neg: 154, i32_wrap_i64: 167, i64_trunc_f64_s: 176, i64_extend_i32_u: 173,
	i64_extend_i32_s: 172, f64_convert_i64_s: 185, i64_reinterpret_f64: 189, f64_reinterpret_i64: 191, ref_is_null: 209, ref_eq: 211, throw: 8, try_table: 31, i64_add: 124, i64_sub: 125}
# GC instructions, after their prefix 251
gc_prefix = 251
gc_ops = {struct_new: 0, struct_get: 2, struct_set: 5, ref_cast_null: 23, array_new_default: 7, array_new_fixed: 8, array_new_data: 9, array_get: 11, array_get_u: 13,
	array_set: 14, array_len: 15, array_copy: 17, ref_test: 20, ref_i31: 28, i31_get_u: 30}
# the abstract heap type i31 (a character boxed in a $Node), as a cast's immediate
i31_type = 108
ref_null = 208
int_ops = {"+": 124, "-": 125, "*": 126, "rem": 129, "xor": 133, "<<": 134, ">>": 135, "==": 81, "!=": 82, "<": 83, ">": 85, "<=": 87, ">=": 89}
# where Rust's ints grow unbounded past i64 the program's + - * trap instead of wrapping (runtime words wrap)
checked_words = {"+": "checked_add", "-": "checked_subtract", "*": "checked_multiply"}
bit_operators = ["xor", "<<", ">>"]
float_ops = {"+": 160, "-": 161, "*": 162, "/": 163, "==": 97, "!=": 98, "<": 99, ">": 100, "<=": 101, ">=": 102}
# yes/no held as i32: only equal or not
bool_ops = {"==": 70, "!=": 71}
# `xs.length`, `count xs`: `#xs`; a property also by count's other names, and `x.number` (not `number x`, a conversion)
length_words = {length: yes, count: yes}
counting_properties = {length: yes, count: yes, size: yes, len: yes, number: yes}
# `m.keys`, `t.chars`, `t.codepoints`: a member name naming a library word of one value, by itself or as a prelude alias,
# is that word's call (a node's entry of that name first, unless keeps_word), as Rust's library_words.rs method_call;
# else ø
member_word(name: text): any := {
	word = library_words.get(unaliased(name)) ?? ""
	if word in module.runtime and #module.runtime[word].signature.parameters == 1 then word else ø
}
# whether `x.name` is the word's call even when x has an entry of that name, as Rust's reads_entry_first: a map's own
# member (`found.keys` of a map holding the entry "keys") or a word of a known result, which the code after it reads
keeps_word(name: text, word: text): bool := takes_map_first(name) or module.runtime[word].signature.result not in ["", "any"]
# whether the variable only ever holds map literals with that entry in the function: `n = {keys: 5}; n.keys` is its
# own member 5, known as it compiles (Rust's OwnMember of a variable only holding object literals)
holds_entry(body: Body, receiver: any, entry: text): bool := {
	if not (receiver is symbol) { return no }
	values = assigned_values(body.function.body, name_of(receiver))
	#values > 0 and values.all(value => is_group(value) and bracket_of(value) == "{" and #value > 0 and value.all(is_map_entry) and value.any(item => entry_name(item) == entry))
}
entry_name(entry: any): text := if key_of(entry) is symbol then name_of(key_of(entry)) else "" + key_of(entry)
# `t.bytecount`, `t.byte_size`: the bytes of a text's UTF-8, 8 bytes an item of a list (Rust's node_bytes)
byte_count_words = {bytecount: yes, byte_size: yes}
def byte_size_code(value: any): list { runtime_call("node_bytes", [["node", boxed(value)]]) }
# the kinds `+` joins as texts
characters = {text: yes, char: yes}
comparisons = {"==": yes, "!=": yes, "<": yes, ">": yes, "<=": yes, ">=": yes}
equalities = {"==": yes, "!=": yes}
identities = {"===": yes, "!==": yes}
compiled_compound_ops = {"+=": "+", "-=": "-", "*=": "*", "/=": "/", "%=": "%"}
steps = {"++": "+", "--": "-"}
smallest_int = -9223372036854775808
largest_int = 9223372036854775807
# (a refusal is thrown; a word ends with its value, not with `refuse`, whose kind would become the word's: card
# is-early-return)
# the kind of a recursive call before its function's body is read: it takes the kind of what it meets
pending = "?"
# what a refusal says first: the twin harness counts such a program as outside the core
outside_the_core = "outside the core: "
no_kind = "none"
# the kind of code that never ends normally (an endless loop): it joins as a call still compiling does, taking the
# other kind
never = pending
# the host word that never returns
ending_host_word = "exit"
# the code of a [kind, code] value that ends the run, nothing after it reached (read through a parameter as converted
# reads its value: `host_call(…)#2 + […]` written in place is read as a text's character)
def ended_code(value: any): list { value#2 + [op.unreachable] }
# the names of the helpers Rust's lowering adds to a program (prelude·round_to)
prelude_prefix = "prelude·"
# WARP_EMIT_SURVEY set: a refused function is recorded and taken as giving a node, the others compiled on, and the
# refusal names each refused function's first refused form, a line each (probes/self_hosting/bootstrap_gap.sh)
survey_setting = "WARP_EMIT_SURVEY"

## the program's functions
# a function as written, its name, signature and body; compiling it gives the rest: kinds its parameters' kinds, result
# its result's kind
class Function { name: text; signature: any; body: any; index: int = -1; kinds: any = ø; result: any = ø; code: any = ø; locals: any = ø; local_names: any = ø; is_runtime: bool = no; widened: any = {}; sums: any = {}; gives_nothing: bool = no }
# runtime: the runtime words by name; texts: the offset of each text's bytes in `bytes`, the module's data segment
# globals: [index, kind] of each `global` variable by name, global_order their names
# imports: the functions imported ahead of the program's, [module, name, type] each (fd_write)
# host: the host words a module may import, name → [[parameter kind…], [result kind…]] (src/host.rs)
# errors: the functions that only trap, by name (error_function)
# classes: the program's classes (an enum's cases with fields among them), each its fields' type names by name (ø
# for an untyped field); class_defaults the values of the fields an instance may leave out, [view] each by name (an
# optional field's is ø); member_classes the classes declaring methods or operators in their body; variants its enums'
# bare cases; sum_types the classes with bare cases ("cases", which `x is T` tests outside the core) or subclasses
# ("subclasses", whose tests class_methods.warp widens) (card
# pure-lane-shape)
# counts_fuel: the program said `use fuel`
# aliases: the type each type alias names, `type Name = text`, by its name
# kinds: what lib/compiler/analyzer.warp `kinds` found in the program ({functions: {f: {params, result}}, …}), or {}
# literal_arguments: the kinds of the literals the program's calls pass, by `f·i` (collect_literal_arguments)
# unannotated: the parameters, by `f·i`, whose kind the calls give (widen_parameter)
# gc_indices: the index of each GC type the module declares, by its name; gc_order: their names in index order (gc_type)
# program_file: the file the program was read from (compiler.warp names it); emitting_at: ` at file:line:column` of
# the program's latest written node being emitted, the place a refusal names (card error-names)
class Module { functions: any; order: any; runtime: any = {}; texts: any = {}; bytes: any = []; globals: any = {}; global_order: any = []; imports: any = []; host: any = {}; classes: any = {}; parents: any = {}; variants: any = {}; sum_types: any = {}; errors: any = {}; closures: any = []; dispatchers: any = []; surveying: bool = no; refusals: any = []; kinds: any = {}; runtime_globals: any = []; shared: any = {}; saw_pending: bool = no; rereads: any = []; builders: any = []; catches_errors: bool = no; counts_fuel: bool = no; aliases: any = {}; reads_positions: bool = no; literal_arguments: any = {}; class_defaults: any = {}; member_classes: any = {}; unannotated: any = {}; later_kinds: any = {}; widenings: int = 0; makes_big_ints: bool = no; big_int_sites: any = []; gc_indices: map = {}; gc_order: list = []; program_file: text = ""; emitting_at: text = "" }

module = Module({}, [])

refuse(why: text): any := {
	throw outside_the_core + why + module.emitting_at
}

# the file the program comes from, which a refusal names
def emitting_file(file: text) { module.program_file = file }

# a node of the program (no runtime word's) written somewhere: the place a later refusal names
def note_emitting(body: Body, n: any) {
	at = if body.intrinsics then ø else written_at(n)
	if at { module.emitting_at = place_text(at, module.program_file) }
}

# a refused form as the program writes it, in a few words: `… := …`, the call `memo_known(…)`, a name
form_of(n: any): text := {
	if type(n) is key and key_of(n) == symbol(opaque_word) { return opaque_form(value_of(n)) }
	if type(n) is key { return "`… " + op_of(n) + " …`" }
	if n is symbol { return name_of(n) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol { return "the call " + name_of(n#1) + "(…)" }
	if is_group(n) and #n > 0 and n#1 is symbol { return "`" + opening_of(bracket_of(n)) + name_of(n#1) + " …`" }
	if is_group(n) { return "the group " + opening_of(bracket_of(n)) + "…" }
	"a " + type(n).name
}
# a template, an error value or an empty group, which travel behind the opaque word (walk.warp), in the program's words
opaque_form(view: any): text := {
	kind = kind_of(view)
	if kind == "list" { return "the empty group " + bracket_pair(view#2) }
	if kind == "error" { return "an error value" }
	"a " + kind
}
opening_of(bracket: text): text := if bracket == "" then "(" else bracket
bracket_pair(bracket: text): text := {"(": "()", "[": "[]", "{": "{}"}[opening_of(bracket)] ?? "()"

# a function made with no parameters, its body given later or its code written by the caller
# `: any` until card class-named: a class Function as a result type fails in the Rust lane
bare_function(name: text): any := Function(name, Signature(), ø)

# `(name params…) := body` at the program's top level, its head; `name := body` reading `it` is a function of `it`, and
# `name := { statements }` one of none (Rust's defined_function); `x := 5` is a value (assignment_operators)
function_head(n: any): any := {
	if not (type(n) is key and op_of(n) == ":=") { return ø }
	left = key_of(n)
	if bracket_of(left) == "(" and #left > 0 and left#1 is symbol { return left }
	if not (left is symbol) { return ø }
	if mentions(value_of(n), implicit_parameter) { return [left, symbol(implicit_parameter)] }
	if is_statement_block(value_of(n)) { return [left] }
	ø
}
is_statement_block(n: any): bool := is_group(n) and bracket_of(n) == "{" and #n > 0 and not n.all(is_map_entry)
# `x := 5`, the value definition left a statement, assigns as `x = 5` does
assignment_operators = ["=", ":="]
# a statement without the keyword `def f(x): T := e` keeps before its definition
unkeyworded(n: any): any := if bracket_of(n) == "" and #n == 2 and n#1 is symbol and name_of(n#1) in function_keywords then n#2 else n

# `use math`, `import f from lib`: the Rust pipeline brought the module in already, so the statement has no code
import_words = ["use", "require", "import", "include"]
is_import(n: any): bool := is_group(n) and #n > 0 and n#1 is symbol and name_of(n#1) in import_words
# `use fuel`: the program's runs count fuel steps (decision fuel-metering); the module carries the custom section
# fuel_section for its host (Rust twin: module_finish.rs FUEL_SECTION)
fuel_section = "warp.fuel"
uses_fuel(program: any): bool := program_statements(program).any(n => is_import(n) and #n == 2 and n#2 == symbol("fuel"))

def block_statements(n: any): list {
	# `[1;2;3]` is a list of three items, not three statements
	if is_group(n) and bracket_of(n) != "[" and (bracket_of(n) == "" or bracket_of(n) == "{" or separator_of(n) == ";") { return items_of(n) }
	[n]
}

# a program of one line, `data [1 2]`, is that one statement: only lines and `;` separate a program's statements
def program_statements(program: any): list {
	if is_group(program) and bracket_of(program) == "" and separator_of(program) == " " { return [program] }
	block_statements(program)
}
# the definitions of a program into `functions`, the statements left
def collect_functions(program: any, functions: any): list {
	kept = []
	for n in program_statements(program).map(unkeyworded) {
		head = function_head(n)
		if head == ø and not is_import(n) { kept += [n] } else if head != ø {
			functions[name_of(head#1)] = Function(name_of(head#1), signature_of(head), value_of(n))
		}
	}
	kept
}
# the main-level variables a function reads and neither assigns nor takes (`limit = 3; f(x) := x > limit`): module
# globals, main's assignment declaring each, as Rust's late_binding makes them
shared_names(statements: any) := {
	shared = {}
	for s in statements {
		if type(s) is key and op_of(s) in assignment_operators and key_of(s) is symbol {
			name = name_of(key_of(s))
			for f_name in module.functions.keys { if reads_free(module.functions[f_name], name) { shared[name] = yes } }
		}
	}
	shared
}
reads_free(f: Function, name: text) := {
	if not mentions(f.body, name) or assigns(f.body, name) { return no }
	name not in taken_names(f.signature)
}
# whether n assigns the symbol `name` anywhere
assigns(n: any, name: text) := {
	if type(n) is key and op_of(n) in assignment_operators and key_of(n) is symbol and name_of(key_of(n)) == name { return yes }
	if type(n) is key { return assigns(key_of(n), name) or assigns(value_of(n), name) }
	if is_group(n) { for x in n { if assigns(x, name) { return yes } } }
	no
}
# the names of the functions the program defines
def defined_names(program: any): list {
	names = []
	for n in program_statements(program).map(unkeyworded) {
		head = function_head(n)
		if head != ø { names += [name_of(head#1)] }
	}
	names
}

## one function's locals while its body is read
# a runtime word's body may use the intrinsics
# function: the one compiled, returned: the kinds its `return`s give, declared: the kind of each `x: T = v` local
# depth: the blocks, loops and ifs around the code read now; exits: the depth of each enclosing loop's exit block,
# continuable: whether each takes a continue (continued_safely)
# unshared: the locals whose list nobody else holds yet (sequence keeps them), which `xs = xs + [x]` grows in place
# globals: the names the body declares `global`, which it assigns as the module's variables, never as its own locals
class Body { names: any; kinds: any; order: any; scratch: int; intrinsics: bool; function: any; returned: any; declared: any; depth: int; exits: any; continuable: any; unshared: any; globals: any }

local_index(body: Body, name: text, kind: text): int := {
	if name in body.names { return body.names[name] }
	body.names[name] = #body.kinds
	body.kinds += [kind]
	body.order += [name]
	body.names[name]
}
fresh_local(body: Body, kind: text): int := {
	body.scratch += 1
	local_index(body, "·scratch" + body.scratch, kind)
}

## expressions: each gives [kind, code]
# the kind both values become: a number widened to float, else a value boxed; a statement and a value stay mixed
joint_kind(a: text, b: text): text := {
	if a == pending { return b }
	if b == pending or a == b { return a }
	if (a == "int" and b == "float") or (a == "float" and b == "int") { return "float" }
	if a == no_kind or b == no_kind or a == "mixed" or b == "mixed" { return "mixed" }
	"node"
}
# code of kind `from` as kind `to`; a boxed value read as a text, yes/no or list by the runtime word checking it is one
node_readers = {text: "text_of_node", bool: "bool_of_node", list: "list_of_node", char: "char_of_node"}
def converted(value: any, to: text): list {
	from = value#1
	if to == "node" { return boxed(value) }
	if from == "int" and to == "float" { return value#2 + [op.f64_convert_i64_s] }
	if from == "bool" and to == "int" { return value#2 + [op.i64_extend_i32_u] }
	if from == "int" and to == "bool" { return condition(value) }
	if from == "node" and to == "int" { return runtime_call("int_of_node", [value])#2 }
	if from == "node" and to == "float" { return runtime_call("float_of_node", [value])#2 }
	if from == "node" and to in node_readers { return runtime_call(node_readers[to], [value])#2 }
	if from == "char" and to == "text" { return runtime_call("char_text", [value])#2 }
	# (a local holding a call still compiling, in a first reading of a cycle, whose code is not kept)
	if from != to and from != pending and to != pending { refuse("a " + from + " where a " + to + " is needed") }
	value#2
}
# `text(x)`, `string(x)`: x as shown (Rust's TEXT_TYPES)
text_words = ["text", "string"]
# int(x) and float(x), as Rust's emit_cast: a text spells the number, a float truncates toward zero
text_readers = {int: "text_as_int", float: "text_as_float"}
node_casts = {int: "truncated_int", float: "float_cast"}
def cast(value: any, to: text): list {
	if value#1 == "text" { return runtime_call(text_readers[to], [value]) }
	# '7' as int is 7, the text it is
	if value#1 == "char" { return cast(["text", converted(value, "text")], to) }
	if value#1 == "float" and to == "int" { return ["int", value#2 + [op.i64_trunc_f64_s]] }
	# `7/2 as int`: an exact rational truncated toward 0; a text known only at run time spells the number
	if value#1 == "node" { return runtime_call(node_casts[to], [value]) }
	[to, converted(value, to)]
}
# a value as a yes/no condition: non-zero is yes
def condition(value: any): list {
	kind = value#1
	if kind == "int" { return value#2 + [op.i64_eqz, op.i32_eqz] }
	if kind == "float" { return value#2 + [op.f64_const] + le64(0) + [op.f64_ne] }
	if kind == "node" or kind == "list" or kind in characters { return runtime_call("node_truthy", [["node", boxed(value)]])#2 }
	# (a recursive call not yet known is taken as yes/no: wasm validation fails the module if it is not)
	if kind != "bool" and kind != pending { refuse("a " + kind + " as a condition") }
	value#2
}
# the test of an if or a loop read inside `blocks` more blocks: in `if name and …` each side is tested by its own kind
# (a text by its emptiness), the right one only when the left leaves the answer open
def condition_of(body: Body, test: any, blocks: int): list {
	if not (type(test) is key and op_of(test) in logical_words) { return condition(nested(body, test, blocks)) }
	a = condition_of(body, key_of(test), blocks)
	b = condition_of(body, value_of(test), blocks + 1)
	if logical_words[op_of(test)] == "and" { return a + [op.if, type_bytes.bool] + b + [op.else, op.i32_const, 0, op.end] }
	a + [op.if, type_bytes.bool, op.i32_const, 1, op.else] + b + [op.end]
}

def number_value(n: any): list {
	if n is float and exact_decimal(n) != ø { return exact_decimal(n) }
	if n is float { return ["float", [op.f64_const] + le64(float_bits(n))] }
	if n < smallest_int or n > largest_int { return refuse("an int beyond 64 bits") }
	["int", [op.i64_const] + sleb(n)]
}

# a GC instruction with its immediates
def gc_code(code: int, immediates: any): list { [gc_prefix] + uleb(code) + concatenated(immediates.map(uleb)) }
# the index of the GC type of this name in the module, taken on the type's first use: after the types it refers to,
# so each type follows those it names (a type naming itself, as $Node, refers to the index it takes)
def gc_type(name: text): int {
	if name in module.gc_indices { return module.gc_indices[name] }
	for part in gc_types#(gc_position(name)) { if part is text and part != name { gc_type(part) } }
	module.gc_indices[name] = #module.gc_order
	module.gc_order += [name]
	module.gc_indices[name]
}
# the position (from 1) of the GC type of this name in gc_types and gc_names
def gc_position(name: text): int {
	for i in 1 to #gc_names { if gc_names#i#1 == name { return i } }
	throw "no GC type " + name
}
# bytes that name GC types by their names (a type's definition in gc_types, a reference in references): each name the
# index the module takes the type under
def gc_bytes(parts: list): list { concatenated(parts.map(part => if part is text then uleb(gc_type(part)) else [part])) }
# a boxed value: a $Node of the kind code, its data from `payload`, no second value
def node(kind_code: int, payload: any): list { node_code([op.i64_const] + sleb(kind_code), payload) }
# a $Node of the kind field the code gives
def node_code(kind: any, payload: any): list { kind + payload + [ref_null, gc_type(gc.node)] + gc_code(gc_ops.struct_new, [gc_type(gc.node)]) }
# a value boxed as a $Node: a number or yes/no in its box, a character as an i31
def boxed(value: any): list {
	kind = value#1
	code = value#2
	if kind == "node" or kind == "time" { return code }
	if kind == "text" { return node(Kind.Text, code) }
	if kind == "list" { return node(Marked.SquareList, code) }
	if kind == "char" { return node(Kind.Codepoint, code + gc_code(gc_ops.ref_i31, [])) }
	if kind == "float" { return node(Kind.Float, code + gc_code(gc_ops.struct_new, [gc_type(gc.float_box)])) }
	if kind == "bool" { return node(Marked.Bool, code + [op.i64_extend_i32_u] + gc_code(gc_ops.struct_new, [gc_type(gc.int_box)])) }
	if kind != "int" and kind != pending { refuse("a " + kind + " as a value") }
	node(Kind.Int, code + gc_code(gc_ops.struct_new, [gc_type(gc.int_box)]))
}
# `[a, b, c]`: a vector of its items, boxed, read in order
# `{1, 2}` as a value is a curly list of its values, as Rust builds the list structure; `{a; b}` and the spaced `{3 4}`
# run as statements (user 2026-10-20: `hi := {3 4}; hi()` giving 4 is reasonable), and a body or branch runs its block
is_curly_list(n: any): bool := bracket_of(n) == "{" and separator_of(n) == ","
def curly_list_value(body: Body, items: any): list { ["node", node(Marked.Map, vector_code(items.map(item => boxed(expression_code(body, item)))))] }
# a body or branch `{a, b}` runs its statements, as Rust unwraps a block there
statements_block(n: any): any := if is_curly_list(n) then separated(n, ";") else n
# a runtime word sees only the globals runtime.warp declares, the program only its own: its local `counted` is no
# runtime word's global of that name
is_global(body: Body, name: text): bool := name not in body.names and name in module.globals and body.intrinsics == (name in module.runtime_globals)
# a built-in type's name, `type` or a declared class's
names_a_type_value(name: text): bool := is_tested_type_word(name) or name == "type" or name in module.classes
def local_value(body: Body, n: any): list {
	name = name_of(n)
	if is_global(body, name) {
		entry = module.globals[name]
		return [entry#2, [op.global_get] + uleb(entry#1)]
	}
	# a bare enum case is its name, a symbol, at run time
	if name not in body.names and name in module.variants { return ["node", node(Kind.Symbol, text_bytes(name))] }
	# a type's name, unbound, is the type value: `k = int` (Rust: names_a_type_value)
	if name not in body.names and names_a_type_value(name) { return ["node", node(Marked.TypeValue, text_bytes(name))] }
	if name not in body.names and system_value_kinds.has(name) { return system_value_read(name) }
	if name not in body.names { return refuse("the unknown name " + name) }
	index = body.names[name]
	[body.kinds#(index + 1), [op.local_get] + uleb(index)]
}
# a system value the program leaves unbound (Rust: lowering/signals/system_values.rs, warp-runtime host_words.rs
# SYSTEM_VALUES): `view_width`, `online`, `mouse_x` read now by the host word system_value(name), a yes/no one as its
# reading != 0, the mouse's place a float (Rust's FLOAT_VALUES); the phrases (`dark mode`) and listeners on one come later
system_value_kinds = {battery: "int", charging: "bool", online: "bool", mouse_x: "float", mouse_y: "float", mouse_down: "bool",
	mouse_wheel: "int", key_down: "bool", window_open: "bool", view_width: "int", view_height: "int", gpu_drawing: "bool",
	window_width: "int", window_height: "int", display_width: "int", display_height: "int", display_dpi: "int"}
# where the name goes, a C string as the host reads it: the scratch bytes past the output's (runtime/extended/wasi.warp scratch_bytes)
system_name_at = 32
def system_value_read(name: text): list {
	bytes = name.bytes + [0]
	code = []
	for i in 0..<#bytes { code += [op.i32_const] + sleb(system_name_at + i) + [op.i32_const] + sleb(bytes#(i + 1)) + [op.i32_store8, 0] + uleb(output_address) }
	code += [op.i32_const] + sleb(output_address + system_name_at) + [op.call] + uleb(import_index(host_import("system_value")))
	kind = system_value_kinds[name]
	if kind == "bool" { return ["bool", code + [op.i64_const, 0, op.i64_ne]] }
	if kind == "float" { return ["float", code + [op.f64_convert_i64_s]] }
	["int", code]
}

# a rem b of floats, the sign of a as with ints: a - trunc(a / b) * b (wasm has no f64 remainder)
def float_remainder(body: Body, a: list, b: list): list {
	dividend = uleb(fresh_local(body, "float"))
	divisor = uleb(fresh_local(body, "float"))
	get_dividend = [op.local_get] + dividend
	get_divisor = [op.local_get] + divisor
	kept = a + [op.local_set] + dividend + b + [op.local_set] + divisor
	["float", kept + get_dividend + get_dividend + get_divisor + [op.f64_div, op.f64_trunc] + get_divisor + [op.f64_mul, op.f64_sub]]
}

def assignment(body: Body, target: any, value: any): list {
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø and subscript_name(value_of(target)) != ø {
		return map_assignment(body, key_of(target), subscript_name(value_of(target)), value)
	}
	# `m[k] = v`, lowered `m#(k+1) = v`: a text k names an entry; a k known only at run time may be either
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø and is_shifted_index(value_of(target)) {
		subscript = expression_code(body, key_of(value_of(target)))
		if subscript#1 == "text" or subscript#1 == "char" { return entry_assignment(body, key_of(target), subscript, value) }
		# a value known only at run time takes an int k as its item k+1, any other k as the entry named so
		held = expression_code(body, key_of(target))
		if held#1 == "node" { return keyed_assignment(body, key_of(target), held, subscript, value) }
		# a list takes the put in place, its variable keeps the same list (no place to write back: ø)
		if held#1 == "list" and subscript#1 == "node" { return keyed_assignment(body, ø, ["node", boxed(held)], subscript, value) }
		if subscript#1 == "node" { return refuse("a write by a key known only at run time, an index or a name") }
	}
	if type(target) is key and op_of(target) == "." and value_of(target) is symbol {
		return map_assignment(body, key_of(target), name_of(value_of(target)), value)
	}
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø {
		return element_assignment(body, expression_code(body, key_of(target)), expression_code(body, value_of(target)), value)
	}
	if type(target) is key and op_of(target) == ":" and key_of(target) is symbol and value_of(target) is symbol {
		return declaration(body, name_of(key_of(target)), name_of(value_of(target)), value)
	}
	if not (target is symbol) { return refuse("an assignment to " + form_of(target)) }
	name = name_of(target)
	if name in body.declared { value = admitted(value, body.declared[name]) }
	kind = value#1
	# a shared main-level variable is main's to assign: a function's assignment of that name makes its own local,
	# unless the function declared it `global`
	is_shared = name in module.shared and name not in body.globals
	if name not in body.names and is_shared and body.function.name == "main" { return declare_global(name, value) }
	if is_global(body, name) and not is_shared { return global_assignment(name, value) }
	if name not in body.names and name in body.function.widened { kind = body.function.widened[name] }
	# analyzer.warp's kind of the local, unless a value not held as that kind widened it (`x = 10.0; x = floor(2.5)`);
	# a node stays one where the analyzer found a list: a $List holds no bracket or separator (bracketed(xs, "("))
	if name not in body.names and name not in body.function.widened and analyzed_local_kind(body.function, name) != ø and not (kind == "node" and analyzed_local_kind(body.function, name) == "list") {
		kind = analyzed_local_kind(body.function, name)
	}
	# the last reading of a function in a cycle: a local given the value of a call still compiling holds a node until
	# the function is read again (module.rereads)
	if name not in body.names and kind == pending and body.function.result != pending { kind = "node" }
	if name in body.names and body.kinds#(body.names[name] + 1) != kind {
		held = body.kinds#(body.names[name] + 1)
		if widens(body, name, held, kind) {
			body.function.widened[name] = joint_kind(held, kind)
			# the rest of this reading holds the local as the joint kind too: `held = [1]` in one branch,
			# `held = xs#1` in another, then `w(held)` taking a text
			body.kinds[body.names[name]] = joint_kind(held, kind)
			return [held, [op.unreachable]]
		}
		kind = held
	}
	index = uleb(local_index(body, name, kind))
	[kind, converted(value, kind) + [op.local_tee] + index]
}

# `x: T = v`: x holds T's kind from here on; a value known only at run time is checked then (field_checks: int_admitted,
# bool_checked, …), any other value Rust would check at run time (a fraction, a byte's range) is refused
declared_kinds = {int: "int", float: "float", text: "text", list: "list", bool: "bool", char: "char"}
def declaration(body: Body, name: text, written_type: text, value: any): list {
	type_name = aliased_type(written_type)
	# `x: any = v` admits every value: the plain assignment; `t: type = int`, `m: map = {}` too, a node like any
	if type_name in node_annotations { return assignment(body, symbol(name), value) }
	if type_name.ends_with("?") { return optional_declaration(body, name, without_optional_mark(type_name), value) }
	if type_name in module.classes { return typed_declaration(body, name, type_name, value) }
	# `xs: ints = v`, `xs: list of text = v`: a list as `list` declares it
	kind_word = if is_list_type(type_name) then "list" else type_name
	if kind_word not in declared_kinds { return refuse("a variable declared " + type_name) }
	body.declared[name] = declared_kinds[kind_word]
	assignment(body, symbol(name), value)
}
# `x: T = v` of a class or enum T the program declares: x holds an object (an instance, also of a class that fits by
# its fields, or a case of T), a node; a value known only at run time is checked then (runtime.warp object_checked
# fails with "not a T", as Rust's), one of another kind refused
def typed_declaration(body: Body, name: text, type_name: text, value: any): list {
	if value#1 != "node" and value#1 != pending { return refuse("a " + value#1 + " given to a variable declared " + type_name) }
	assignment(body, symbol(name), runtime_call("object_checked", [value, text_value_of("not " + with_article(type_name))]))
}
# `x: int? = v` (`line: int? = try n.line else ø`): a T or ø, so x holds a node; a value known
# only at run time is not checked yet (Rust's is), a value of another kind is refused; `x: Node? = v` (any node
# annotation, a class too: an object or ø) holds the node as it is
def optional_declaration(body: Body, name: text, type_name: text, value: any): list {
	if type_name in node_annotations or type_name in module.classes {
		if value#1 != "node" and value#1 != pending and type_name in module.classes { return refuse("a " + value#1 + " given to a variable declared " + type_name + "?") }
		return assignment(body, symbol(name), value)
	}
	if type_name not in declared_kinds { return refuse("a variable declared " + type_name + "?") }
	value = texted(type_name, value)
	kind = value#1
	if kind != "node" and kind != pending and kind != declared_kinds[type_name] { return refuse("a " + kind + " given to a variable declared " + type_name + "?") }
	assignment(body, symbol(name), ["node", boxed(value)])
}
# a value as the declared kind takes it: an int widened to a float, a char (a one-character text) to a text, a value known only at run time checked (a list
# one stays a node, as Rust keeps ø), else of that kind
def admitted(value: any, kind: text): list {
	if value#1 == kind { return value }
	if value#1 == "int" and kind == "float" { return ["float", converted(value, "float")] }
	if value#1 == "char" and kind == "text" { return shown_text(value) }
	if value#1 == "node" and kind in field_checks { return runtime_call(field_checks[kind], [value]) }
	# the result of a call still compiling (pending), or a kind guessed from one (`f(x) + g(x)` an int), is held as the
	# declared kind: the reading is done again once the call's result is known
	if value#1 == pending or module.saw_pending { return [kind, value#2] }
	refuse("a " + value#1 + " given to a variable declared " + kind)
}
def whole(value: any): list { admitted(value, "int") }
# whether a local (not a parameter) of kind `held` assigned a `kind` takes their joint kind from the next reading of
# its function on: `x = 7; x /= 2` makes x a boxed value, `x = 0; x += 0.5` a float; a local analyzer.warp gave a kind
# keeps it for every value held as that kind (`x = "a"; x = "b"`: a text, though a one-letter literal is a character)
widens(body: Body, name: text, held: text, kind: text): bool := {
	if analyzed_local_kind(body.function, name) != ø and held_as(kind, analyzed_local_kind(body.function, name)) { return no }
	# a yes/no stays one (a number given to it counts as yes when not 0), an int given a yes/no takes 1 or 0
	if body.names[name] < #body.function.signature.parameters or held == pending or kind == pending or held == "bool" or kind == "bool" { return no }
	joint = joint_kind(held, kind)
	joint != held and (joint in type_bytes or joint in references)
}

# `global name = value` declares the module's variable name, which every function reads and writes; a bare
# `global name` (the analyzer's, for a main-level variable only a function assigns) holds nodes, 0 until assigned,
# and reads it: a function declaring it on each call keeps its value
def global_declaration_code(body: Body, declaration: any): list {
	if declaration is symbol {
		body.globals[name_of(declaration)] = yes
		entry = declared_global(name_of(declaration), "node")
		# a runtime word's `global trap_detail = …`, lowered `global: trap_detail; trap_detail = …`, writes the global
		if body.intrinsics and name_of(declaration) not in module.runtime_globals { module.runtime_globals += [name_of(declaration)] }
		return [entry#2, [op.global_get] + uleb(entry#1)]
	}
	if not (type(declaration) is key and op_of(declaration) == "=" and key_of(declaration) is symbol) {
		return refuse("the declaration global " + form_of(declaration))
	}
	body.globals[name_of(key_of(declaration))] = yes
	if body.intrinsics { module.runtime_globals += [name_of(key_of(declaration))] }
	declare_global(name_of(key_of(declaration)), expression_code(body, value_of(declaration)))
}
def declare_global(name: text, value: any): list {
	declared_global(name, value#1)
	global_assignment(name, value)
}
# the module's global name: [its index, its kind], the kind of its first declaration
def declared_global(name: text, kind: text): list {
	if name not in module.globals {
		module.globals[name] = [#module.global_order, kind]
		module.global_order += [name]
	}
	module.globals[name]
}
def global_assignment(name: text, value: any): list {
	entry = module.globals[name]
	index = uleb(entry#1)
	[entry#2, converted(value, entry#2) + [op.global_set] + index + [op.global_get] + index]
}
# `return x`: x ends the function; what follows it is unreachable, of any kind
def return_value(body: Body, value: any): list {
	body.returned += [value#1]
	result = body.function.result
	code = if result == pending then value#2 else converted(value, result)
	[pending, code + [op.return]]
}

def expression_code(body: Body, n: any): list {
	note_emitting(body, n)
	if n is bool { return ["bool", [op.i32_const, if n then 1 else 0]] }
	if n is number { return number_value(n) }
	if n is text { return text_value(n) }
	if n === ø { return ["node", [ref_null, gc_type(gc.node)]] }
	if n == symbol("break") { return loop_exit(body) }
	if n == symbol("continue") { return loop_again(body) }
	# `{ return ø }`: the block keeps a bare return, its ø no item of the group
	if n == symbol("return") { return return_value(body, expression_code(body, ø)) }
	if n is symbol and name_of(n) in module.host and name_of(n) not in body.names { return host_call(body, name_of(n), []) }
	if n is symbol { return local_value(body, n) }
	if type(n) is key { return key_expression(body, n) }
	if not is_group(n) { refuse("the value " + form_of(n)) }
	group_expression(body, n)
}

# `f 3 4`: a program function's name before as many spaced arguments as it takes calls it, as `f(3, 4)`
is_spaced_call(body: Body, n: any): bool := {
	if not (bracket_of(n) == "" and separator_of(n) == " " and #n > 1 and n#1 is symbol) { return no }
	name = name_of(n#1)
	name in module.functions and name not in body.names and #module.functions[name].signature.parameters == #n - 1
}
# `print x`, `raise x` called, a line of their own, or the one line of a block (`if c { print x }`)
is_call_or_line(n: any): bool := bracket_of(n) == "(" or bracket_of(n) == "" or (bracket_of(n) == "{" and separator_of(n) == " ")
# `n times [x]`, `n times "ab"`, `n times t` among the items of a spaced group or a call `print(3 times [7])`: n copies,
# as Rust's times_phrases.rs lowers them (zero_fill, times·text, which multiplies a number), the count the item before;
# `n times {…}` is a loop by then (lib/sugar/loops.warp). The index of `times` in items, 0 for none
repetition_at(items: any): int := {
	places = range_list(#items).map(i => i + 1).filter(at => at > 1 and at < #items and repeats_at(items, at))
	if places then places#1 else 0
}
# whether items#at is `times` before a value it repeats
repeats_at(items: any, at: int): bool := {
	value = items#(at + 1)
	items#at == symbol("times") and not (is_group(value) and (bracket_of(value) == "{" or (bracket_of(value) == "[" and #value != 1)))
}
repetition_call(count: any, value: any): any := if is_group(value) and bracket_of(value) == "[" then call_of("zero_fill", [count, value#1]) else call_of("times·text", [count, value])
# the group with its repetition at `at` as one call: the group itself when only the repetition is left
repetition_folded(n: any, at: int): any := {
	items = items_of(n)
	folded = items[..(at - 2)] + [repetition_call(items#(at - 1), items#(at + 1))] + items[(at + 1)..]
	if #folded == 1 then folded#1 else separated(bracketed(folded, bracket_of(n)), separator_of(n))
}
has_repetition(n: any): bool := {
	if not is_group(n) or not (bracket_of(n) == "" or bracket_of(n) == "(") { return no }
	repetition_at(items_of(n)) > 0
}
# the group with each of its repetitions one call
repetitions_folded(n: any): any := if has_repetition(n) then repetitions_folded(repetition_folded(n, repetition_at(items_of(n)))) else n
def group_expression(body: Body, n: any): list {
	if is_quote(n) { return ["node", quoted_code(body, n#2)] }
	if has_repetition(n) { return expression_code(body, repetitions_folded(n)) }
	if inline_quote_at(n) > 0 { return group_expression(body, quote_folded(n, inline_quote_at(n))) }
	if bracket_of(n) == "(" and #n > 1 and n#1 == symbol("closure_new") { return closure_value(body, n#2, items_of(n)[2..]) }
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1).starts_with(closure_call_prefix) {
		return closure_call(body, int(name_of(n#1)[(#closure_call_prefix)..]), items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1).contains(captured_marker) {
		return closure_item(expression_code(body, n#2)#2, captured_index(name_of(n#1)))
	}
	# the forms `wasm i64.rem_s` and `try` lower to, ahead of the program's functions: emitter.warp has a
	# wasm_instruction of its own
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("wasm_instruction") and n#2 is text { return wasm_instruction(body, n#2) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("ran·without·error") { return ran_without_error(body, n#2) }
	if (bracket_of(n) == "(" or is_spaced_call(body, n)) and #n > 0 and n#1 is symbol and is_program_call(body, name_of(n#1), items_of(n)[1..]) {
		return call(body, module.functions[name_of(n#1)], items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.classes {
		return positional_instance(body, name_of(n#1), items_of(n)[1..])
	}
	std = std_word(n)
	if std != ø { return call(body, module.runtime[std], std_arguments(n#4)) }
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.host {
		# `exit(1)` ends the run: never a value, so `try 42 catch e { exit(1) }` and `if x > 0 { x } else { exit(1) }`
		# take the other branch's kind (card pure-exit-miscompile)
		if name_of(n#1) == ending_host_word { return [never, ended_code(host_call(body, name_of(n#1), items_of(n)[1..]))] }
		return host_call(body, name_of(n#1), items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in intrinsics and (body.intrinsics or name_of(n#1) in program_intrinsics) {
		return intrinsic(body, name_of(n#1), items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in time_intrinsics and body.intrinsics {
		return time_intrinsic(body, name_of(n#1), items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in time_words {
		return time_call(body, name_of(n#1), items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.runtime and body.intrinsics {
		return call(body, module.runtime[name_of(n#1)], items_of(n)[1..])
	}
	if bracket_of(n) == "(" and #n == 3 and n#1 == symbol("is_type") and n#3 is text { return type_test_code(body, n#2, n#3) }
	# a match no case takes: `switch_no_case("label": value)` ends the run in no_case_<label>, which Rust's run reports
	# as "no case for label"
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("switch_no_case") {
		label = if type(n#2) is key and key_of(n#2) is text then key_of(n#2) else "value"
		return ended_in(pending, no_case_prefix + label)
	}
	# `raise X` (also throw, fail, panic), called or a line of its own: the run fails with X as its message, a value of
	# no kind; a program's own function of that name is its function
	if is_call_or_line(n) and #n == 2 and n#1 is symbol and name_of(n#1) in raise_words and name_of(n#1) not in module.functions {
		raised_value = expression_code(body, n#2)
		# a one-letter text, held as a character, raises its text: `raise "x"` is Error("x"), not Error("'x'")
		if raised_value#1 == "char" { raised_value = ["text", converted(raised_value, "text")] }
		return [never, runtime_call("raised", [raised_value])#2 + [op.drop, op.unreachable]]
	}
	# the min, max or reduce of an empty list (Rust's lowering: min_max.rs): `empty_extremum(min)` ends the run in
	# min_of_an_empty_list
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("empty_extremum") and n#2 is symbol {
		return ended_in(pending, name_of(n#2) + "_of_an_empty_list")
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in library_words {
		word = library_words[name_of(n#1)]
		if word in sort_words and orders_instances() { return refuse("a sort where instances order through compare") }
		# `a /! b` of a ratio, a float or a value known only at run time floors the quotient as Rust does;
		# floor_quotient takes ints only
		if word == "floor_quotient" and #n == 3 {
			values = n[1..].map(x => expression_code(body, x))
			if values.any(value => value#1 != "int") { return floored(operation_code(body, "/", values#1, values#2)) }
		}
		# `3 times 4` of numbers multiplies (Rust's emit_text_times)
		if word == "repeated_text" and #n == 3 {
			values = n[1..].map(x => expression_code(body, x))
			if values#2#1 in ["int", "float"] { return operation_code(body, "*", values#1, values#2) }
		}
		return call(body, module.runtime[word], items_of(n)[1..])
	}
	# `print a, b` is print(a, b): its values shown, a space between (Rust's print_call)
	if is_call_or_line(n) and #n >= 2 and n#1 == symbol("print") { return printed(if #n == 2 then printed_value(body, n#2) else texts_joined(body, items_of(n)[1..], " ")) }
	if is_call_or_line(n) and #n == 2 and n#1 is symbol and name_of(n#1) in warning_words { return call(body, module.runtime["warned"], [n#2]) }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in length_words {
		# `count = 0; count(users)`: Rust's "`count` is a variable here"
		if name_of(n#1) in body.names { return refuse("the variable " + name_of(n#1) + " applied to a value") }
		return length_code(expression_code(body, n#2))
	}
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("floor") { return floored(expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in byte_count_words { return byte_size_code(expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("type") { return type_value_of(body, expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("ord") { return code_point(expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("chr") { return ["char", converted(expression_code(body, n#2), "int") + [op.i32_wrap_i64]] }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in bit_casts { return bit_cast(expression_code(body, n#2), bit_casts[name_of(n#1)]) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("unwrap") { return unwrapped(expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in text_words { return shown_text(expression_code(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in text_readers { return cast(expression_code(body, n#2), name_of(n#1)) }
	if bracket_of(n) == "(" and #n == 1 { return expression_code(body, n#1) }
	if bracket_of(n) == "" and #n == 2 and n#1 == symbol("return") { return return_value(body, expression_code(body, n#2)) }
	if bracket_of(n) == "" and #n == 2 and n#1 == symbol("global") { return global_declaration_code(body, n#2) }
	if bracket_of(n) == "[" { return list_value(body, items_of(n)) }
	# `{ Run: {…} }` is a block giving an instance to Rust's lowering as often as a map: neither is sure; with a
	# statement beside it (`{ xs = …; Gaps{…} }`) it is a block, its instance a statement; `{Error: 11}` is a map
	if bracket_of(n) == "{" and n.all(is_map_entry) and n.any(x => is_map_entry(x) and key_of(x) is symbol and name_of(key_of(x)) in module.classes and is_group(value_of(x)) and bracket_of(value_of(x)) == "{") {
		return refuse("a block or map holding an instance")
	}
	if bracket_of(n) == "{" and n.all(is_map_entry) { return map_value(body, items_of(n)) }
	# a map of one entry, as Rust's lowering marks it: map_value already gives the map
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("map_of_entry") { return expression_code(body, n#2) }
	if bracket_of(n) == "(" and #n == 4 and n#1 == symbol("field_with") {
		value = expression_code(body, n#4)
		if checks_fields(body, n#2) and not (n#3 is text and field_admits(n#3, value#1)) and #module.classes.keys > 0 { return refuse("a field write a typed field may refuse") }
		return field_assignment(expression_code(body, n#2), expression_code(body, n#3), value)
	}
	if is_curly_list(n) { return curly_list_value(body, items_of(n)) }
	# a call of a program's function it can't take: refused naming the count
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.functions { return call(body, module.functions[name_of(n#1)], items_of(n)[1..]) }
	if not (bracket_of(n) == "" or bracket_of(n) == "{" or separator_of(n) == ";") { refuse(form_of(n)) }
	# `y = 2 x`: Rust's "`x` after `y=2` does nothing"
	assigns = x => type(x) is key and op_of(x) in assignment_operators
	if separator_of(n) == " " and #n > 1 and assigns(n#1) { refuse("a value after an assignment") }
	# `y 1+1`: values side by side are a list without brackets, as Rust's emitter holds a spaced group (only `;` and
	# lines are statements); its text is the items with a space between
	if separator_of(n) == " " and #n > 1 { return ["node", node(Marked.UnbracketedList, list_value(body, items_of(n))#2)] }
	sequence(body, items_of(n))
}

# an item as written into a list or field: an Error there fails as "a list item holds no error" (Rust's emit_data_item);
# a value of any other kind than node holds none
def data_item(body: Body, mark: text, item: any): list {
	value = expression_code(body, item)
	if value#1 != "node" { return value }
	runtime_call(data_item_checks[mark], [value])
}
# the tables a runtime word reads a number of by name, `Kind.List` (kinds.warp), folded into the code
constant_tables = {Kind: Kind, HeldBit: HeldBit, Marked: Marked, KindUnit: KindUnit, BracketCode: BracketCode, TimeFormCode: TimeFormCode, TimeInfoUnit: TimeInfoUnit, Ascii: Ascii, Utf8: Utf8, Unicode: Unicode}
# the number `Kind.List` names in its table, else ø
table_number(table: any, case: any): any := {
	if not (table is symbol and name_of(table) in constant_tables) { return ø }
	numbers = constant_tables[name_of(table)]
	if case in numbers then numbers[case] else ø
}
def key_expression(body: Body, n: any): list {
	operator = op_of(n)
	left = key_of(n)
	right = value_of(n)
	if body.intrinsics and table_number(left, read_field(n)) != ø { return number_value(table_number(left, read_field(n))) }
	# `{}`: a map of no entries, not ø, so the entries a function given it writes reach every holder, as in Rust's
	if is_empty_map(n) { return ["node", node(Marked.Map, vector_code([]))] }
	# `[]`, held behind the opaque word as Rust's parser builds it: a list of no items
	if is_empty_list(n) { return list_value(body, []) }
	if operator == ":" and left is symbol and name_of(left) in data_item_checks { return data_item(body, name_of(left), right) }
	if operator == "else" and type(left) is key and op_of(left) == "then" { return conditional(body, value_of(key_of(left)), value_of(left), right, yes) }
	if operator == "then" and type(left) is key and op_of(left) == "if" { return conditional(body, right_of_if(left), right, ø, no) }
	# `c ? a : b`: the keys ?(c, :(a, b))
	if operator == "?" and type(right) is key and op_of(right) == ":" { return conditional(body, left, key_of(right), value_of(right), yes) }
	if operator == "do" and type(left) is key and op_of(left) == "while" { return loop_of(body, value_of(left), right) }
	if operator == "=" and left is symbol and name_of(left) in body.unshared and self_append_name(n) != ø {
		grown = appended(body, left, value_of(right))
		if grown != ø { return grown }
	}
	# a type alias names its type for the annotations, which collect_types read
	if is_type_alias(n) { return [no_kind, []] }
	if operator in assignment_operators { return assignment(body, left, expression_code(body, right)) }
	if operator == ":" and left == symbol("global") { return global_declaration_code(body, right) }
	# the step a `for` lowering appends to its loop body, as the analysis view shows it: run after the body
	if is_loop_step(n) { return expression_code(body, right) }
	# a class declaration, held as an opaque view (walk.warp): its instances are maps (instance_value)
	if left == symbol(opaque_word) and kind_of(right) == "type" { return [no_kind, []] }
	if left == symbol(opaque_word) { return refuse(opaque_form(right)) }
	# the key of `Point{x: 1}` has no operator as parser.warp reads it, `:` as Rust's analysis view shows it
	# `P{}`: every field its default (an empty group reads as ø, or as the opaque `{}`)
	if operator == "" and left is symbol and name_of(left) in module.classes and (right == ø or is_empty_map(right)) { return instance_value(body, name_of(left), []) }
	if (operator == ":" or operator == "") and left is symbol and is_group(right) and bracket_of(right) == "{" and right.all(is_map_entry) {
		# `div{ a: 1 }` of no class is Rust's `div:a:1`: a block of one entry is that entry
		if #right == 1 and name_of(left) not in module.classes {
			return ["node", keyed_code(name_node(left), boxed(expression_code(body, right#1)))]
		}
		return instance_value(body, name_of(left), items_of(right))
	}
	# a function value as an operand: Rust's type error `1 + (x => x)`, its reflection `f.name` read as `(closure_new f)#("name"+1)`
	if operator not in closure_comparisons and (is_closure_value(left) or is_closure_value(right)) { return refuse("a function value in " + operator) }
	if operator == "#" and left != ø and subscript_name(right) != ø { return field_read(body, expression_code(body, left), subscript_name(right)) }
	if operator == "#" and left != ø and is_shifted_index(right) {
		target = expression_code(body, left)
		if target#1 == "node" { return runtime_call("node_get", [target, ["node", boxed(expression_code(body, key_of(right)))]]) }
	}
	if operator == "+=" {
		target = expression_code(body, left)
		added = expression_code(body, right)
		# Rust's `s += "ab"` on a number is its type error, though `s = s + "ab"` joins
		# a number variable given boxed values by `+=` (a sum over a list's items) stays a sum after it widens
		numeric = target#1 == "int" or target#1 == "float"
		if numeric and added#1 in characters { return refuse("a number += a " + added#1) }
		sum = left is symbol and (numeric or name_of(left) in body.function.sums)
		if sum and added#1 == "node" {
			body.function.sums[name_of(left)] = yes
			return assignment(body, left, operation_code(body, "+", target, runtime_call("number_node", [added])))
		}
		grown = appended(body, left, right)
		if grown != ø { return grown }
	}
	if operator == "/=" and left is symbol and name_of(left) in body.declared and body.declared[name_of(left)] == "int" {
		return assignment(body, left, runtime_call("floor_quotient", [expression_code(body, left), whole(expression_code(body, right))]))
	}
	if operator in compiled_compound_ops { return assignment(body, left, operation_code(body, compiled_compound_ops[operator], expression_code(body, left), expression_code(body, right))) }
	if operator in steps and right == ø { return assignment(body, left, operation_code(body, steps[operator], expression_code(body, left), number_value(1))) }
	if operator == "-" and left == ø { return negation(body, expression_code(body, right)) }
	if operator == "‖" and left == ø { return absolute_value(body, expression_code(body, right)) }
	if operator in logical_words { return logical(body, logical_words[operator], left, right) }
	if operator in bit_words { return bitwise(body, operator, left, right) }
	if operator == "#" and left == ø { return length_code(expression_code(body, right)) }
	if operator == "." and right is symbol and name_of(right) in counting_properties {
		return field_or_word(body, expression_code(body, left), name_of(right), length_code)
	}
	# `type(x).name`
	if operator == "." and right == symbol("name") and is_type_call(left) { return ["text", payload(type_value_of(body, expression_code(body, left#2))#2, gc_type(gc.text))] }
	if operator == "." and right is symbol and member_word(name_of(right)) != ø {
		word = member_word(name_of(right))
		value = expression_code(body, left)
		if holds_entry(body, left, name_of(right)) { return field_read(body, value, name_of(right)) }
		if keeps_word(name_of(right), word) { return runtime_call(word, [value]) }
		return field_or_word(body, value, name_of(right), receiver => runtime_call(word, [receiver]))
	}
	if operator == "." and right is symbol and name_of(right) in byte_count_words { return byte_size_code(expression_code(body, left)) }
	# `m.a`: the entry a of the map (or instance) m, as Rust lowers it to `m#("a"+1)`
	if operator == "." and right is symbol {
		value = expression_code(body, left)
		# `n.sq`, `parts.last`: a member naming a function of the program that takes the value is its call (a node's
		# entry of that name first)
		if is_program_call(body, name_of(right), [left]) {
			called = module.functions[name_of(right)]
			return field_or_word(body, value, name_of(right), receiver => call_values(called, defaulted(body, called, [receiver], 1)))
		}
		return field_of(body, value, name_of(right))
	}
	# (only `rational`: a float `as real` or `as exact` stays a float in Rust, type_tests.rs is_exact_fraction_type)
	if operator == "as" and right is symbol and name_of(right) == "rational" {
		return as_rational(expression_code(body, left))
	}
	# `t as codepoint`, `x as integer`: a type word's other names are its kind's; `255 as byte`, `5 as hex` an int's
	target = if not (right is symbol) then ø else if name_of(right) in core_type_words then core_type_words[name_of(right)] else if name_of(right) in int_spellings then "int" else name_of(right)
	if operator == "as" and target == "number" { return as_number(expression_code(body, left)) }
	if operator == "as" and (target in type_bytes or target in references) {
		value = expression_code(body, left)
		if target in text_readers { return cast(value, target) }
		if target == "text" { return shown_text(value) }
		# `"ab" as list` is its characters, as Rust's emit_cast
		if target == "list" and value#1 == "text" { return runtime_call("text_chars", [value]) }
		# `65 as codepoint` is 'A', `2 as char` the digit '2'
		if target == "char" and value#1 == "int" { return ["char", runtime_call("cast_code_point", [value])#2 + [op.i32_wrap_i64]] }
		if target == "bool" and (value#1 == "node" or value#1 == "text") { return runtime_call("bool_cast", [["node", boxed(value)]]) }
		return [target, converted(value, target)]
	}
	if operator == "not" and left == ø { return ["bool", condition(expression_code(body, right)) + [op.i32_eqz]] }
	# `√x`: the float root, as Rust's emitter gives it
	if operator == "√" and left == ø { return ["float", converted(expression_code(body, right), "float") + [wasm_instructions["f64.sqrt"]]] }
	if left === ø or right === ø {
		other = if left === ø then right else left
		if operator in identities or operator in equalities { return identity_with_nothing(body, operator, other) }
		return refuse("the operator " + operator + " with nothing " + (if left === ø then "before" else "after") + " it")
	}
	if operator == "#" and left is symbol { return analyzed_element(body, left, right) }
	operation_code(body, operator, expression_code(body, left), expression_code(body, right))
}
# `xs#i` of a list whose elements analyzer.warp knows: the element as that kind, else as a node
def analyzed_element(body: Body, list: any, index: any): list {
	value = operation_code(body, "#", expression_code(body, list), expression_code(body, index))
	kind = analyzed_element_kind(body.function, name_of(list))
	if kind == ø or value#1 != "node" { return value }
	[kind, converted(value, kind)]
}
right_of_if(n: any): any := value_of(n)
is_type_call(n: any): bool := is_group(n) and #n == 2 and n#1 == symbol("type")
# the fixed-width ints and the ways to write an int, each an int as the core holds it (Rust's FIXED_WIDTHS, `5 as hex`)
int_spellings = ["byte", "int8", "int16", "int32", "int64", "uint8", "u8", "uint16", "uint32", "uint64", "hex", "binary", "octal"]
# `t as number`: a text spells the number, "1/3" the exact ratio (runtime text_numbers.warp); a number stays as it is
def as_number(value: any): list {
	if value#1 == "int" or value#1 == "float" { return value }
	if value#1 in characters { return runtime_call("text_as_number", [["text", converted(value, "text")]]) }
	runtime_call("number_cast", [["node", boxed(value)]])
}
# `x as rational` of a float: the runtime's float_as_exact (decision float-as-rational); other kinds Rust takes
def as_rational(value: any): list {
	if value#1 == "float" { return runtime_call("float_as_exact", [value]) }
	refuse("a " + value#1 + " as rational")
}

# -value; a value known only at run time as 0 - value
def negation(body: Body, value: any): list {
	if value#1 == "float" { return ["float", value#2 + [op.f64_neg]] }
	if value#1 == "node" { return operation_code(body, "-", number_value(0), value) }
	if value#1 != "int" { refuse("the negation of a " + value#1) }
	["int", [op.i64_const, 0] + value#2 + [op.i64_sub]]
}
# `a and b`, `a or b` on yes/no values: b is read only when a leaves the answer open
# on other values they give one of them, as Rust does: `a and b` is b when a holds, else a; `a or b` a when a holds,
# else b (`(1==1) and 5` is 5, `x | y` with x 0 is y); a yes/no beside a number counts as 1 or 0
logical_words = {and: "and", or: "or"}
def logical(body: Body, symbol: text, left: any, right: any): list { logical_code(body, symbol, expression_code(body, left), nested(body, right, 1)) }
# `3 & 5` is 1, `6 | 1` is 7: the bits of two whole numbers; on yes/no and other values the logical and/or, as Rust's
# BitAnd and BitOr (parser.warp bit_operator). The right operand is read inside one block, as logical's branch reads it.
bit_words = {"&": "and", "|": "or"}
bit_codes = {"&": 131, "|": 132}
def bitwise(body: Body, symbol: text, left: any, right: any): list {
	a = expression_code(body, left)
	b = nested(body, right, 1)
	if a#1 == "int" and b#1 == "int" { return ["int", a#2 + [op.block] + value_type("int") + b#2 + [op.end, bit_codes[symbol]]] }
	logical_code(body, bit_words[symbol], a, b)
}
def logical_code(body: Body, symbol: text, a: list, b: list): list {
	# a value whose kind the first reading of a recursive function does not know yet (pending) beside a yes/no is one
	yes_no = kind => kind == "bool" or kind == pending
	if yes_no(a#1) and yes_no(b#1) {
		a = condition(a)
		b = condition(b)
		if symbol == "and" { return ["bool", a + [op.if, type_bytes.bool] + b + [op.else, op.i64_const, 0, op.i64_eqz, op.i32_eqz, op.end]] }
		return ["bool", a + [op.if, type_bytes.bool, op.i64_const, 1, op.i64_eqz, op.i32_eqz, op.else] + b + [op.end]]
	}
	kind = if a#1 == "bool" then b#1 else if b#1 == "bool" then a#1 else joint_kind(a#1, b#1)
	# a list or text, `at < n and fields`, `e or "a"`: either value boxed, as a value known only at run time is
	if kind == "list" or kind in characters { kind = "node" }
	# on a float Rust fails: "is a float where an exact Int is expected"; boxed values count by their truth
	if (kind != "int" and kind != "node") or a#1 == "float" or b#1 == "float" { return refuse("the operator " + symbol + " on " + a#1 + " and " + b#1) }
	held = [a#1, [op.local_get] + uleb(fresh_local(body, a#1))]
	test = condition([a#1, a#2 + [op.local_set] + held#2[1..] + held#2])
	# beside a value known only at run time a yes/no on the left counts as 1 or 0, one on the right stays yes/no, as Rust's
	left = if kind == "node" and a#1 == "bool" then ["int", converted(held, "int")] else held
	given = if symbol == "and" then [b, left] else [left, b]
	[kind, test + [op.if] + value_type(kind) + converted(given#1, kind) + [op.else] + converted(given#2, kind) + [op.end]]
}

## host words: the program's environment, imported from the "host" module (src/host.rs)
# the words a program reaches: those it refers to (not the keys of its maps: `{paint: …}` names no paint), the runtime
# words its library words and std calls stand for, and theirs in turn: the host and WASI words they call are imported
def reached_words(program: any): any {
	reached = {}
	referred = {}
	collect_referred(program, referred)
	pending = referred.keys
	i = 0
	while i < #pending {
		name = pending[i]
		i += 1
		if name not in reached {
			reached[name] = yes
			more = {}
			if name in library_words { more[library_words[name]] = yes }
			if system_value_kinds.has(name) { more["system_value"] = yes }
			if name in module.runtime { collect_referred_outside(module.runtime[name], more) }
			pending += more.keys
		}
	}
	reached
}
# the words a runtime word refers to, but its parameters and locals: time_text's local `clock` imports no host clock
def collect_referred_outside(word: Function, found: any) {
	referred = {}
	collect_referred(word.body, referred)
	own = {}
	collect_assigned(word.body, own)
	for name in taken_names(word.signature) { own[name] = yes }
	for name in referred.keys { if name not in own { found[name] = yes } }
}
# the names a body assigns, `x = …`
def collect_assigned(n: any, found: any) {
	if type(n) is key {
		if op_of(n) == "=" and key_of(n) is symbol { found[name_of(key_of(n))] = yes }
		collect_assigned(value_of(n), found)
	}
	if is_group(n) { for item in n { collect_assigned(item, found) } }
}
def collect_referred(n: any, found: any) {
	if n is symbol { found[name_of(n)] = yes }
	if type(n) is key and key_of(n) != symbol(opaque_word) {
		collect_referred(key_of(n), found)
		collect_referred(value_of(n), found)
	}
	if is_group(n) {
		std = std_word(n)
		# a std word the runtime gives itself refers to that runtime word, not to the host's std_io
		if std != ø {
			found[std] = yes
			collect_referred(n#4, found)
		} else {
			for item in n {
				if is_curly_group(n) and is_key(item, Op.Colon) and key_of(item) is symbol { collect_referred(value_of(item), found) } else { collect_referred(item, found) }
			}
		}
	}
}
# `std_io("os", "args", [])`, a std module's word the runtime gives itself over WASI (runtime/extended/wasi.warp): the runtime
# word std_os_args, else ø (the host's std_io answers)
def std_word(n: any): any {
	if bracket_of(n) != "(" or #n != 4 { return ø }
	if n#1 != symbol("std_io") or not (n#2 is text) or not (n#3 is text) or (bracket_of(n#4) != "[" and not is_empty_list(n#4)) { return ø }
	name = "std_" + n#2 + "_" + n#3
	if name in module.runtime then name else ø
}
# the arguments of a std word: `[]` is held behind the opaque word (is_empty_list)
std_arguments(arguments: Node): list := if is_empty_list(arguments) then [] else items_of(arguments)
# the module of a lowered program, or a text naming the first form outside the core; `runtime` is
# lib/compiler/runtime.warp lowered by the same pipeline
wasm_module(program: any, runtime: any): any := hosted_wasm_module(program, runtime, {})

# as wasm_module, the host words `host` names importable (src/compiler/self_hosted.rs passes src/host.rs's)
hosted_wasm_module(program: any, runtime: any, host: any): any := typed_wasm_module(program, runtime, host, {})

# as hosted_wasm_module, an unannotated parameter of the kind analyzer.warp found in `kinds` (WARP_SELF_ANALYSIS); again
# while a call widens a parameter (passed)
typed_wasm_module(program: any, runtime: any, host: any, kinds: any): any := {
	module.later_kinds = {}
	module.widenings = 0
	widenings = -1
	compiled = ø
	while widenings != module.widenings {
		widenings = module.widenings
		compiled = module_compiled(program, runtime, host, kinds)
	}
	compiled
}
module_compiled(program: any, runtime: any, host: any, kinds: any): any := {
	module.kinds = kinds
	module.emitting_at = ""
	module.functions = {}
	module.order = []
	module.runtime = {}
	module.globals = {}
	module.runtime_globals = []
	module.global_order = []
	module.catches_errors = mentions(program, "ran·without·error")
	if module.catches_errors {
		declared_global(try_depth_name, "int")
		declared_global(failed_in_name, "text")
	}
	module.texts = {}
	module.bytes = []
	# the host words, but those the program defines itself: its own `notify(x) := …` is its own
	module.host = {}
	defined = defined_names(program)
	for name in host.keys { if name not in defined { module.host[name] = host[name] } }
	module.classes = {}
	module.parents = {}
	module.variants = {}
	module.sum_types = {}
	module.errors = {}
	module.closures = []
	module.dispatchers = []
	module.counts_fuel = uses_fuel(program)
	module.reads_positions = reads_position(program)
	module.surveying = env(survey_setting) != ø
	module.refusals = []
	module.literal_arguments = {}
	module.saw_pending = no
	module.rereads = []
	module.builders = []
	module.makes_big_ints = no
	module.big_int_sites = []
	module.gc_indices = {}
	module.gc_order = []
	collect_types(program)
	for child in module.parents.keys { inherit_fields(child) }
	for n in collect_functions(runtime, module.runtime) { runtime_global(n) }
	reached = reached_words(program)
	module.imports = if "print" in reached then [fd_write_import] else []
	# imported ahead of the functions, whose indices follow them: every host or WASI word the program reaches
	for name in module.host.keys {
		if (name in reached or (name in time_host_words and makes_time(program))) and host_import(name) not in module.imports { module.imports += [host_import(name)] }
	}
	c_function_globals()
	for name in module.runtime.keys {
		word = module.runtime[name]
		word.is_runtime = yes
	}
	main = bare_function("main")
	try {
		main.body = separated(bracketed(collect_functions(program, module.functions), ""), ";")
		collect_literal_arguments(main.body)
		for name in module.functions.keys { collect_literal_arguments(module.functions[name].body) }
		module.shared = shared_names(block_statements(main.body))
		compile_function(main, [])
		# a function of the program never called is compiled too, its parameters of any kind: Rust's compiles each, so
		# a program with one it cannot compile fails there (not the prelude's helpers, compiled when called)
		for name in module.functions.keys {
			f = module.functions[name]
			if f.kinds == ø and not name.starts_with(prelude_prefix) { compile_function(f, f.signature.parameters.map(p => "node")) }
		}
		# a dispatcher's call may compile a target that makes more closures or dispatchers: again until none is new
		seen = -1
		while seen != #module.closures + #module.dispatchers {
			seen = #module.closures + #module.dispatchers
			for f in module.dispatchers { if f.name == closure_text_name { closure_text_code(f) } else if f.name == shown_big_int_name { shown_big_int_code(f) } else { dispatcher_code(f) } }
		}
		# every function compiled, no call gives a guessed kind any more
		for f in module.rereads {
			module.saw_pending = no
			body_code(f)
		}
		# a program that makes big ints (big_int_power compiled): the functions with a big_int_case read again, with it
		if module.runtime["big_int_power"].kinds != ø {
			module.makes_big_ints = yes
			for f in module.big_int_sites { body_code(f) }
		}
		# a closure's target compiled late may make big ints: shown_big_int's code once every function is compiled
		for f in module.dispatchers { if f.name == shown_big_int_name { shown_big_int_code(f) } }
		if main.result != "int" and main.result != "float" {
			main.code = boxed([main.result, main.code])
			main.result = "node"
		}
		# WASI's command entry: main run for what it does, so `wasmtime app.wasm` runs the program
		start = added_function(wasi_start, [], no_kind, [])
		start.code = [op.call] + uleb(main.index) + [op.drop]
		if #module.refusals > 0 { throw module.refusals.join("\n") }
		module_bytes(module.order)
	} catch refusal {
		if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
		text = "" + refusal
		if #module.refusals > 0 and text != module.refusals.join("\n") { return (module.refusals + [text]).join("\n") }
		text
	}
}
