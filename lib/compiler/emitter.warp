# The emitter core (card emits-wasm, notes/self_hosting.md step 15; Rust twin: src/wasm_emitter): the lowered
# program (pipeline::lower) as a node gives a wasm module as a list of bytes, whose main returns the program's value.
# The core knows ints (i64), floats (f64), yes/no conditions (i32), characters (i32), texts (GC byte arrays), lists
# (GC vectors), arithmetic, comparisons, locals, functions, if and while, print (layout: notes/self_hosting.md "Value
# layout"). A value of a kind known only at run time, and a value main gives that is no number, is a boxed `$Node`.
# Runtime words are warp (lib/compiler/runtime.warp, lowered like a program), compiled on their first call. Any other
# form refuses the program: `wasm_module` then gives a text naming the form, and the twin harness
# (tests/common/twins.rs emitter_differential) counts the source as outside the core. A function's parameters take
# their kinds from their annotations, else from the first call; its result kind from its body, read twice so that a
# recursive call knows it.
use "walk.warp"
use "words.warp"
use math
use os

wasm_header = [0, 97, 115, 109, 1, 0, 0, 0]
type_bytes = {int: 126, float: 124, bool: 127, char: 127}
section_ids = {custom: 0, type: 1, import: 2, function: 3, memory: 5, globals: 6, export: 7, code: 10, data: 11, data_count: 12}
function_type_byte = 96
export_function_byte = 0
export_memory_byte = 2
export_global_byte = 3
# the globals the runner reads after a trap (src/run/wasm_reader.rs with_trap_detail): the value a runtime error names
exported_globals = ["trap_detail"]
import_function_byte = 0
# a module that prints imports WASI's fd_write(fd, iovecs, iovec count, written at) → error code, all i32
fd_write = ["wasi_snapshot_preview1", "fd_write", [96, 4, 127, 127, 127, 127, 1, 127]]
stdout = 1
# its linear memory, one page: fd_write's iovec {address, count} at 0, the count it wrote at 8, the bytes it writes from
# output_address (an offset of the store, so `output_byte(i, b)` stores at output_address + i)
memory_pages = 1
iovec_address = 0
written_address = 8
output_address = 16
names_subsections = {functions: 1, locals: 2, types: 4, globals: 7, fields: 10}
mutable = 1
# the GC types ahead of the function types: an array (94) of one [storage type, mutable], a struct (95) of fields
# [storage type, mutable]. $text: the UTF-8 bytes; $list: a vector, its items boxed; $Node(kind i64, data anyref,
# value ref null $Node) a boxed value (CLAUDE.md "Serialization"), its number in an $i64box or $f64box; an exact
# rational an Int $Node holding a $Ratio(numerator, denominator) of two $i64box (src/run/wasm_reader.rs read_payload)
gc = {text: 0, items: 1, list: 2, node: 3, int_box: 4, float_box: 5, ratio: 6}
gc_types = [[94, 120, 1], [94, 110, 1], [95, 2, 127, 1, 100, 1, 1], [95, 3, 126, 0, 110, 0, 99, 3, 0], [95, 1, 126, 0], [95, 1, 124, 0], [95, 2, 110, 0, 110, 0]]
gc_names = [["text", []], ["items", []], ["list", ["length", "items"]], ["Node", ["kind", "data", "value"]], ["i64box", ["value"]], ["f64box", ["value"]], ["Ratio", ["numerator", "denominator"]]]
# a $Node's kind field (src/type_kinds.rs): the Kind, a bool marked above it, a list's bracket above it
node_kind_codes = {int: 1, float: 2, text: 3, codepoint: 4, symbol: 5, bool: 257, list: 264, map: 8, entry: 262, instance: 6, function: 16}
# a map entry `name: value` is a key of the operator `:` (Op::Colon's code 1 above Kind::Key, src/operators/codes.rs)
# the kinds held as a reference: a text, a list, a boxed value of any kind ("node", also ø) as anyref
# a time, a $Node of Kind time held as anyref like a node, is its own kind so that only what handles times takes one
references = {text: [99, gc.text], list: [99, gc.list], node: [110], time: [110]}
passive_segment = 1
# block type of a block that leaves nothing
no_value = 64
# opcodes (WebAssembly core spec, section 5.4)
op = {unreachable: 0, block: 2, loop: 3, if: 4, else: 5, end: 11, br: 12, br_if: 13, return: 15, call: 16, drop: 26, select: 27,
	local_get: 32, local_set: 33, local_tee: 34, global_get: 35, global_set: 36, i32_store: 54, i32_store8: 58,
	i32_const: 65, i64_const: 66, f64_const: 68, i32_eqz: 69, i64_eqz: 80, i64_ge_u: 90, i32_sub: 107, i32_and: 113, i32_or: 114,
	i64_div_s: 127, i64_rem_s: 129, i64_and: 131, f64_ceil: 155, f64_floor: 156, f64_nearest: 158, f64_neg: 154, i32_wrap_i64: 167, i64_trunc_f64_s: 176, i64_extend_i32_u: 173,
	i64_extend_i32_s: 172, f64_convert_i64_s: 185, i64_reinterpret_f64: 189, f64_reinterpret_i64: 191, ref_is_null: 209, ref_eq: 211}
# the instructions a function body may be (decision wasm-instruction-body), those on ints (i64) and floats (f64)
wasm_instructions = {"i64.clz": 121, "i64.ctz": 122, "i64.popcnt": 123, "i64.add": 124, "i64.sub": 125, "i64.mul": 126,
	"i64.div_s": 127, "i64.div_u": 128, "i64.rem_s": 129, "i64.rem_u": 130, "i64.and": 131, "i64.or": 132, "i64.xor": 133,
	"i64.shl": 134, "i64.shr_s": 135, "i64.shr_u": 136, "i64.rotl": 137, "i64.rotr": 138, "f64.abs": 153, "f64.neg": 154,
	"f64.ceil": 155, "f64.floor": 156, "f64.trunc": 157, "f64.nearest": 158, "f64.sqrt": 159, "f64.add": 160, "f64.sub": 161,
	"f64.mul": 162, "f64.div": 163, "f64.min": 164, "f64.max": 165, "f64.copysign": 166, "i64.trunc_f64_s": 176,
	"i64.trunc_f64_u": 177, "f64.convert_i64_s": 185, "f64.convert_i64_u": 186, "i64.reinterpret_f64": 189, "f64.reinterpret_i64": 191}
# GC instructions, after their prefix 251
gc_prefix = 251
gc_ops = {struct_new: 0, struct_get: 2, struct_set: 5, ref_cast_null: 23, array_new_default: 7, array_new_fixed: 8, array_new_data: 9, array_get: 11, array_get_u: 13,
	array_set: 14, array_len: 15, array_copy: 17, ref_test: 20, ref_i31: 28, i31_get_u: 30}
# the abstract heap type i31 (a character boxed in a $Node), as a cast's immediate
i31_type = 108
ref_null = 208
int_ops = {"+": 124, "-": 125, "*": 126, "==": 81, "!=": 82, "<": 83, ">": 85, "<=": 87, ">=": 89}
# where Rust's ints grow unbounded past i64 the program's + - * trap instead of wrapping (runtime words wrap)
checked_words = {"+": "checked_add", "-": "checked_subtract", "*": "checked_multiply"}
float_ops = {"+": 160, "-": 161, "*": 162, "/": 163, "==": 97, "!=": 98, "<": 99, ">": 100, "<=": 101, ">=": 102}
# `xs.length`, `count xs`: `#xs`
length_words = {length: yes, count: yes}
# the kinds `+` joins as texts
characters = {text: yes, char: yes}
comparisons = {"==": yes, "!=": yes, "<": yes, ">": yes, "<=": yes, ">=": yes}
equalities = {"==": yes, "!=": yes}
identities = {"===": "==", "!==": "!="}
compound_ops = {"+=": "+", "-=": "-", "*=": "*", "/=": "/", "%=": "%"}
steps = {"++": "+", "--": "-"}
smallest_int = -9223372036854775808
largest_int = 9223372036854775807
# (a refusal is thrown; a word ends with its value, not with `refuse`, whose kind would become the word's: card
# is-early-return)
# the kind of a recursive call before its function's body is read: it takes the kind of what it meets
pending = "?"
# what a refusal says first: the twin harness counts such a program as outside the core
outside_the_core = "outside the core: "
no_kind = "none"
# the names of the helpers Rust's lowering adds to a program (prelude·round_to)
prelude_prefix = "prelude·"
# WARP_EMIT_SURVEY set: a refused function is recorded and taken as giving a node, the others compiled on, and the
# refusal names each refused function's first refused form, a line each (probes/self_hosting/bootstrap_gap.sh)
survey_setting = "WARP_EMIT_SURVEY"

## bytes
def uleb(n: int): list {
	out = []
	while n >= 128 {
		out += [bit_or(bit_and(n, 127), 128)]
		n = n >> 7
	}
	out + [n]
}
def sleb(n: int): list {
	out = []
	more = yes
	while more {
		b = bit_and(n, 127)
		n = n >> 7
		if (n == 0 and bit_and(b, 64) == 0) or (n == -1 and bit_and(b, 64) != 0) { more = no } else { b = bit_or(b, 128) }
		out += [b]
	}
	out
}
# the 8 little-endian bytes of an int's low 64 bits
def le64(n: int): list {
	out = []
	for i in 0..8 { out += [bit_and(n >> (8 * i), 255)] }
	out
}
def joined(parts: any): list {
	out = []
	for part in parts { out += part }
	out
}
def vector(parts: any): list { uleb(#parts) + joined(parts) }
def name_bytes(name: text): list { vector(name.bytes.map(b => [b])) }
def section(id: int, content: any): list { [id] + uleb(#content) + content }

## the program's functions
# a function as written; compiling it gives the rest
class Function { name: text; parameters: any; annotations: any; body: any; index: int = -1; kinds: any = ø; result: any = ø; code: any = ø; locals: any = ø; local_names: any = ø; is_runtime: bool = no; widened: any = {}; sums: any = {}; gives_nothing: bool = no }
# runtime: the runtime words by name; texts: the offset of each text's bytes in `bytes`, the module's data segment
# globals: [index, kind] of each `global` variable by name, global_order their names
# imports: the functions imported ahead of the program's, [module, name, type] each (fd_write)
# host: the host words a module may import, name → [[parameter kind…], [result kind…]] (src/host.rs)
# classes: the names of the program's classes (an enum's cases with fields among them), variants its enums' bare cases
# kinds: what lib/compiler/analyzer.warp `kinds` found in the program ({functions: {f: {params, result}}, …}), or {}
class Module { functions: any; order: any; runtime: any = {}; texts: any = {}; bytes: any = []; globals: any = {}; global_order: any = []; imports: any = []; host: any = {}; classes: any = {}; variants: any = {}; closures: any = []; dispatchers: any = []; shows_values: bool = no; surveying: bool = no; refusals: any = []; kinds: any = {}; runtime_globals: any = []; shared: any = {}; saw_pending: bool = no; rereads: any = [] }

module = Module({}, [])


refuse(why: text): any := {
	throw outside_the_core + why
}

# a refused form in a few words: `key :=`, `group ( memo_known`, a name
form_of(n: any): text := {
	if type(n) is key { return "key " + op_of(n) }
	if n is symbol { return name_of(n) }
	if is_group(n) and #n > 0 and n#1 is symbol { return "group " + bracket_of(n) + " " + name_of(n#1) }
	if is_group(n) { return "group " + bracket_of(n) }
	"a " + type(n)
}

parameter_symbol(p: any): any := if type(p) is key and op_of(p) == ":" then key_of(p) else p
annotation_of(p: any): any := {
	if type(p) is key and op_of(p) == ":" and value_of(p) is symbol { return name_of(value_of(p)) }
	# `xs: [int]` and other type forms Rust checks at each call: no kind, so the function is refused
	if type(p) is key and op_of(p) == ":" { return form_of(value_of(p)) }
	ø
}

# `(name params…) := body` at the program's top level
definition(n: any): any := {
	if type(n) is key and op_of(n) == ":=" and bracket_of(key_of(n)) == "(" and #key_of(n) > 0 and key_of(n)#1 is symbol {
		return key_of(n)
	}
	ø
}
# a statement without the keyword `def f(x): T := e` keeps before its definition
unkeyworded(n: any): any := if bracket_of(n) == "" and #n == 2 and n#1 is symbol and name_of(n#1) in function_keywords then n#2 else n

# `use math`, `import f from lib`: the Rust pipeline brought the module in already, so the statement has no code
import_words = ["use", "require", "import", "include"]
is_import(n: any): bool := is_group(n) and #n > 0 and n#1 is symbol and name_of(n#1) in import_words

def statements_of(n: any): list {
	if is_group(n) and (bracket_of(n) == "" or bracket_of(n) == "{" or separator_of(n) == ";") { return n.map(x => x) }
	[n]
}

# the definitions of a program into `functions`, the statements left
def collect_functions(program: any, functions: any): list {
	kept = []
	for n in statements_of(program).map(unkeyworded) {
		head = definition(n)
		if head == ø and not is_import(n) { kept += [n] } else if head != ø {
			parameters = head[1..].map(parameter_symbol)
			annotations = head[1..].map(annotation_of)
			functions[name_of(head#1)] = Function(name_of(head#1), parameters, annotations, value_of(n))
		}
	}
	kept
}
# the main-level variables a function reads and neither assigns nor takes (`limit = 3; f(x) := x > limit`): module
# globals, main's assignment declaring each, as Rust's late_binding makes them
shared_names(statements: any) := {
	shared = {}
	for s in statements {
		if type(s) is key and op_of(s) == "=" and key_of(s) is symbol {
			name = name_of(key_of(s))
			for f_name in module.functions.keys { if reads_free(module.functions[f_name], name) { shared[name] = yes } }
		}
	}
	shared
}
reads_free(f: Function, name: text) := {
	if not mentions(f.body, name) or assigns(f.body, name) { return no }
	for p in f.parameters { if name_of(p) == name { return no } }
	yes
}
# whether n assigns the symbol `name` anywhere
assigns(n: any, name: text) := {
	if type(n) is key and op_of(n) == "=" and key_of(n) is symbol and name_of(key_of(n)) == name { return yes }
	if type(n) is key { return assigns(key_of(n), name) or assigns(value_of(n), name) }
	if is_group(n) { for x in n { if assigns(x, name) { return yes } } }
	no
}
# the names of the functions the program defines
def defined_names(program: any): list {
	names = []
	for n in statements_of(program).map(unkeyworded) {
		head = definition(n)
		if head != ø { names += [name_of(head#1)] }
	}
	names
}

## one function's locals while its body is read
# a runtime word's body may use the intrinsics
# function: the one compiled, returned: the kinds its `return`s give, declared: the kind of each `x: T = v` local
# depth: the blocks, loops and ifs around the code read now; exits: the depth of each enclosing loop's exit block
# unshared: the locals whose list nobody else holds yet (sequence keeps them), which `xs = xs + [x]` grows in place
class Body { names: any; kinds: any; order: any; scratch: int; intrinsics: bool; function: any; returned: any; declared: any; depth: int; exits: any; unshared: any }

local_index(body: Body, name: text, kind: text): int := {
	if name in body.names { return body.names[name] }
	body.names[name] = #body.kinds
	body.kinds += [kind]
	body.order += [name]
	body.names[name]
}
fresh_local(body: Body, kind: text): int := {
	body.scratch += 1
	local_index(body, "·scratch" + body.scratch, kind)
}

## expressions: each gives [kind, code]
# the kind both values become: a number widened to float, else a value boxed; a statement and a value stay mixed
joint_kind(a: text, b: text): text := {
	if a == pending { return b }
	if b == pending or a == b { return a }
	if (a == "int" and b == "float") or (a == "float" and b == "int") { return "float" }
	if a == no_kind or b == no_kind or a == "mixed" or b == "mixed" { return "mixed" }
	"node"
}
# code of kind `from` as kind `to`; a boxed value read as a text, yes/no or list by the runtime word checking it is one
node_readers = {text: "text_of_node", bool: "bool_of_node", list: "list_of_node"}
def converted(value: any, to: text): list {
	from = value#1
	if to == "node" { return boxed(value) }
	if from == "int" and to == "float" { return value#2 + [op.f64_convert_i64_s] }
	if from == "bool" and to == "int" { return value#2 + [op.i64_extend_i32_u] }
	if from == "int" and to == "bool" { return condition(value) }
	if from == "node" and to == "int" { return runtime_call("int_of_node", [value])#2 }
	if from == "node" and to == "float" { return runtime_call("float_of_node", [value])#2 }
	if from == "node" and to in node_readers { return runtime_call(node_readers[to], [value])#2 }
	if from == "char" and to == "text" { return runtime_call("char_text", [value])#2 }
	# (a local holding a call still compiling, in a first reading of a cycle, whose code is not kept)
	if from != to and from != pending and to != pending { refuse("a " + from + " where a " + to + " is needed") }
	value#2
}
# a value as a yes/no condition: non-zero is yes
def condition(value: any): list {
	kind = value#1
	if kind == "int" { return value#2 + [op.i64_eqz, op.i32_eqz] }
	if kind == "float" { return value#2 + [op.f64_const] + le64(0) + [float_ops["!="]] }
	if kind == "node" or kind == "list" or kind in characters { return runtime_call("node_truthy", [["node", boxed(value)]])#2 }
	# (a recursive call not yet known is taken as yes/no: wasm validation fails the module if it is not)
	if kind != "bool" and kind != pending { refuse("a " + kind + " as a condition") }
	value#2
}

def number_value(n: any): list {
	if n is float and exact_decimal(n) != ø { return exact_decimal(n) }
	if n is float { return ["float", [op.f64_const] + le64(float_bits(n))] }
	if n < smallest_int or n > largest_int { return refuse("an int beyond 64 bits") }
	["int", [op.i64_const] + sleb(n)]
}

# a decimal literal as Rust reads it: exact, a rational, when it has at most 15 significant digits (0.1 is 1/10, so
# 0.1 + 0.2 == 0.3; 3.0 is the int 3); π's 16 stay a float (Number::is_exact_decimal)
exact_decimal_digits = 15
exact_decimal(n: float): any := {
	shown = "" + n
	if shown.contains("e") or not shown.contains(".") { return ø }
	negative = shown.starts_with("-")
	unsigned = if negative then shown[1..] else shown
	parts = unsigned.split(".")
	digits = parts#1 + parts#2
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	if #significant > exact_decimal_digits { return ø }
	numerator = int(digits)
	if negative { numerator = -numerator }
	denominator = 1
	for i in 0..#parts#2 { denominator = denominator * 10 }
	divisor = gcd(numerator, denominator)
	if divisor < 0 { divisor = -divisor }
	if divisor == denominator { return number_value(numerator / divisor) }
	box = x => [op.i64_const] + sleb(x) + gc_code("struct_new", [gc.int_box])
	["node", node(node_kind_codes.int, box(numerator / divisor) + box(denominator / divisor) + gc_code("struct_new", [gc.ratio]))]
}

# the offset of a text's bytes in the data segment, each text stored once
text_offset(t: text): int := {
	if not (t in module.texts) {
		module.texts[t] = #module.bytes
		module.bytes += t.bytes
	}
	module.texts[t]
}
# a GC instruction with its immediates
def gc_code(name: text, immediates: any): list { [gc_prefix] + uleb(gc_ops[name]) + joined(immediates.map(uleb)) }
# a boxed value: a $Node of the kind code, its data from `payload`, no second value
def node(kind_code: int, payload: any): list { [op.i64_const] + sleb(kind_code) + payload + [ref_null, gc.node] + gc_code("struct_new", [gc.node]) }
# a text as its bytes; one character as its codepoint, as warp holds a literal "a"
def text_value(t: text): list {
	if #t == 1 { return ["char", [op.i32_const] + sleb(ord(t))] }
	["text", text_bytes(t)]
}
def text_bytes(t: text): list { [op.i32_const] + sleb(text_offset(t)) + [op.i32_const] + sleb(#t.bytes) + gc_code("array_new_data", [gc.text, 0]) }
# a value boxed as a $Node: a number or yes/no in its box, a character as an i31
def boxed(value: any): list {
	kind = value#1
	code = value#2
	if kind == "node" or kind == "time" { return code }
	if kind == "text" { return node(node_kind_codes.text, code) }
	if kind == "list" { return node(node_kind_codes.list, code) }
	if kind == "char" { return node(node_kind_codes.codepoint, code + gc_code("ref_i31", [])) }
	if kind == "float" { return node(node_kind_codes.float, code + gc_code("struct_new", [gc.float_box])) }
	if kind == "bool" { return node(node_kind_codes.bool, code + [op.i64_extend_i32_u] + gc_code("struct_new", [gc.int_box])) }
	if kind != "int" and kind != pending { refuse("a " + kind + " as a value") }
	node(node_kind_codes.int, code + gc_code("struct_new", [gc.int_box]))
}
# `[a, b, c]`: a vector of its items, boxed, read in order
def list_value(body: Body, items: any): list { ["list", vector_code(items.map(item => boxed(expression(body, item))))] }
def vector_code(item_codes: any): list {
	code = [op.i32_const] + sleb(#item_codes) + joined(item_codes)
	code + gc_code("array_new_fixed", [gc.items, #item_codes]) + gc_code("struct_new", [gc.list])
}
## maps and class instances, as Rust's (runtime.warp "a map is a curly list")
# `name: value` as a map entry: its name a symbol, its value boxed
def entry_code(name_code: any, value_code: any): list { keyed_code(node(node_kind_codes.symbol, name_code), value_code) }
def keyed_code(name_node: any, value_code: any): list { key_code(node_kind_codes.entry, name_node, value_code) }
def key_code(kind: int, name_node: any, value_code: any): list { [op.i64_const] + sleb(kind) + name_node + as_node(value_code) + gc_code("struct_new", [gc.node]) }
# an entry's name as Rust's holds it: `a` a symbol, a quoted "ab" a text, a quoted "+" a character
def name_node(name: any): list {
	if name is symbol { return node(node_kind_codes.symbol, text_bytes(name_of(name))) }
	if #name == 1 { return node(node_kind_codes.codepoint, [op.i32_const] + sleb(ord(name)) + gc_code("ref_i31", [])) }
	node(node_kind_codes.text, text_bytes(name))
}
is_entry(n: any): bool := type(n) is key and op_of(n) == ":" and (key_of(n) is symbol or key_of(n) is text)
# `{a: 1, b: "x"}`: a map
def map_value(body: Body, entries: any): list {
	codes = entries.map(e => keyed_code(name_node(key_of(e)), boxed(expression(body, value_of(e)))))
	["node", node(node_kind_codes.map, vector_code(codes))]
}
# `Point{x:1 y:2}`, an instance as lowered: the entry of the class name, its value the map of the fields
# an instance's key has no operator (Op::None), as Rust's has
def instance_value(body: Body, class_name: text, fields: any): list {
	name = node(node_kind_codes.symbol, text_bytes(class_name))
	["node", key_code(node_kind_codes.instance, name, map_value(body, fields)#2)]
}
# `m.x`, lowered as the subscript `m#("x"+1)`: the name's text, else ø
subscript_name(index: any): any := {
	# (type() of an arithmetic key is "operation", not key)
	if op_of(index) == "+" and value_of(index) == 1 and key_of(index) is text { return key_of(index) }
	ø
}
# `k+1`, the index `m[k]` lowers to
is_shifted_index(index: any): bool := op_of(index) == "+" and value_of(index) == 1
def map_get(map: any, name: text): list { runtime_call("map_get", [["node", boxed(map)], text_value_of(name)]) }
def field_of(value: any, name: text): any { if value#1 == "node" then map_get(value, name) else refuse("the field " + name + " of a " + value#1) }
# `m.x = v`: the map with its entry x set to v
def field_assignment(map: any, name: any, value: any): list { runtime_call("field_with", [["node", boxed(map)], shown_text(name), ["node", boxed(value)]]) }
# a name as a text value, even of one character (text_value gives a "char" then)
def text_value_of(name: text): list { ["text", text_bytes(name)] }
# an int as an i32 index
def index_code(value: any): list { converted(value, "int") + [op.i32_wrap_i64] }
# `#x`: the characters of a text, the items of a list or map, either known only at run time
def length(value: any): list {
	if value#1 == "text" { return runtime_call("text_count", [value]) }
	if value#1 == "list" { return ["int", value#2 + gc_code("struct_get", [gc.list, 0]) + [op.i64_extend_i32_u]] }
	if value#1 == "node" { return runtime_call("node_length", [value]) }
	refuse("the length of a " + value#1)
}
# `xs#i = v`: the i-th item becomes v, boxed; the assignment gives v
def element_assignment(body: Body, list: any, index: any, value: any): list {
	if list#1 == "node" { return runtime_call("node_set_at", [list, index, value]) }
	if list#1 != "list" { return refuse("an assignment to an element of a " + list#1) }
	held = uleb(fresh_local(body, value#1))
	code = value#2 + [op.local_set] + held + checked_item(body, list, index) + boxed([value#1, [op.local_get] + held])
	[value#1, code + gc_code("array_set", [gc.items]) + [op.local_get] + held]
}
# `xs#i`: the i-th item, counted from 1
def element(body: Body, list: any, index: any): list {
	if list#1 == "node" { return runtime_call("node_at", [list, index]) }
	if list#1 != "list" { return refuse("an element of a " + list#1) }
	["node", checked_item(body, list, index) + gc_code("array_get", [gc.items])]
}
# a list's items and the 0-based place of its index-th item; an index outside 1…count fails in index_out_of_range_of
def checked_item(body: Body, list: any, index: any): list {
	held = uleb(fresh_local(body, "list"))
	at = [op.local_get] + uleb(fresh_local(body, "int"))
	count = ["int", [op.local_get] + held + gc_code("struct_get", [gc.list, 0]) + [op.i64_extend_i32_u]]
	whole = if index#1 == "node" then runtime_call("index_of_node", [index])#2 else converted(index, "int")
	code = list#2 + [op.local_set] + held + whole + [op.local_set] + at[1..]
	outside = at + [op.i64_const, 1, int_ops["-"]] + count#2 + [op.i64_ge_u]
	code += outside + [op.if, no_value] + dropped(runtime_call("index_out_of_range_of", [["int", at], count])) + [op.end]
	code + [op.local_get] + held + gc_code("struct_get", [gc.list, 1]) + at + [op.i32_wrap_i64, op.i32_const, 1, op.i32_sub]
}
# `name(a: float): float := wasm f64.floor`: the parameters in order, then the instruction, which leaves the result
def wasm_instruction(body: Body, name: text): list {
	if not (name in wasm_instructions) { return refuse("wasm " + name) }
	code = []
	for i in 0..<#body.function.parameters { code += [op.local_get] + uleb(i) }
	[if name.starts_with("i64") then "int" else "float", code + [wasm_instructions[name]]]
}
# the words the runtime is written in, each one or two instructions
def intrinsic(body: Body, name: text, arguments: any): list {
	values = arguments.map(a => expression(body, a))
	if name == "new_text" { return ["text", index_code(values#1) + gc_code("array_new_default", [gc.text])] }
	if name == "byte_count" { return ["int", values#1#2 + gc_code("array_len", []) + [op.i64_extend_i32_u]] }
	if name == "byte_at" { return ["int", values#1#2 + index_code(values#2) + gc_code("array_get_u", [gc.text]) + [op.i64_extend_i32_u]] }
	if name == "kind_code" { return ["int", kind_code_of(values#1#2)] }
	if name == "unboxed_int" { return ["int", unboxed(values#1#2, gc.int_box)] }
	if name == "marked_kind" { return ["int", as_node(values#1#2) + gc_code("struct_get", [gc.node, 0])] }
	if name == "unboxed_list" { return ["list", payload(values#1#2, gc.list)] }
	if name == "unboxed_text" { return ["text", payload(values#1#2, gc.text)] }
	if name == "unboxed_char" { return ["char", as_node(values#1#2) + gc_code("struct_get", [gc.node, 1]) + gc_code("ref_cast_null", [i31_type]) + gc_code("i31_get_u", [])] }
	if name == "char_of" { return ["char", index_code(values#1)] }
	if name == "new_list" {
		count = [op.local_get] + uleb(fresh_local(body, "int"))
		code = converted(values#1, "int") + [op.local_set] + count[1..] + count + [op.i32_wrap_i64] + count + [op.i32_wrap_i64]
		return ["list", code + gc_code("array_new_default", [gc.items]) + gc_code("struct_new", [gc.list])]
	}
	if name == "copy_items" {
		items = x => x + gc_code("struct_get", [gc.list, 1])
		code = items(values#1#2) + index_code(values#2) + items(values#3#2) + index_code(values#4) + index_code(values#5)
		return [no_kind, code + gc_code("array_copy", [gc.items, gc.items])]
	}
	# adopt_items(to, from): to takes from's length and items
	if name == "adopt_items" {
		to = [op.local_get] + uleb(fresh_local(body, "list"))
		from = [op.local_get] + uleb(fresh_local(body, "list"))
		code = values#1#2 + [op.local_set] + to[1..] + values#2#2 + [op.local_set] + from[1..]
		taken = field => to + from + gc_code("struct_get", [gc.list, field]) + gc_code("struct_set", [gc.list, field])
		return [no_kind, code + taken(0) + taken(1)]
	}
	# an entry's name, a symbol, text or character (name_node), as a text
	if name == "key_name" { return ["text", runtime_call("node_text", [["node", as_node(values#1#2) + gc_code("struct_get", [gc.node, 1])]])#2] }
	if name == "key_value" { return ["node", as_node(values#1#2) + gc_code("struct_get", [gc.node, 2])] }
	if name == "map_of" { return ["node", node(node_kind_codes.map, values#1#2)] }
	if name == "new_key" { return ["node", entry_code(values#1#2, values#2#2)] }
	# item_room(list): the items its array holds, its length and the spare room after it; set_count(list, n)
	if name == "item_room" { return ["int", values#1#2 + gc_code("struct_get", [gc.list, 1]) + gc_code("array_len", []) + [op.i64_extend_i32_u]] }
	if name == "set_count" { return [no_kind, values#1#2 + index_code(values#2) + gc_code("struct_set", [gc.list, 0])] }
	# keyed(kind, left, right): a $Node of the kind with the two nodes; entry_key(n) a key's left node
	if name == "keyed" { return ["node", values#1#2 + values#2#2 + as_node(values#3#2) + gc_code("struct_new", [gc.node])] }
	if name == "entry_key" { return ["node", as_node(values#1#2) + gc_code("struct_get", [gc.node, 1]) + gc_code("ref_cast_null", [gc.node])] }
	if name == "symbol_of" { return ["node", node(node_kind_codes.symbol, values#1#2)] }
	if name == "is_null" { return ["int", values#1#2 + [op.ref_is_null, op.i64_extend_i32_u]] }
	if name == "same_text" { return ["int", values#1#2 + values#2#2 + [op.ref_eq, op.i64_extend_i32_u]] }
	if name == "fail" { return [pending, [op.unreachable]] }
	if name == "is_ratio" { return ["int", ratio_test(values#1#2) + [op.i64_extend_i32_u]] }
	if name == "ratio_of" {
		box = v => converted(v, "int") + gc_code("struct_new", [gc.int_box])
		return ["node", node(node_kind_codes.int, box(values#1) + box(values#2) + gc_code("struct_new", [gc.ratio]))]
	}
	if name == "ratio_numerator" { return ["int", ratio_part(values#1#2, 0)] }
	if name == "ratio_denominator" { return ["int", ratio_part(values#1#2, 1)] }
	if name == "unboxed_float" { return ["float", unboxed(values#1#2, gc.float_box)] }
	if name == "code_of" { return ["int", values#1#2 + [op.i64_extend_i32_u]] }
	if name == "set_byte" { return [no_kind, values#1#2 + index_code(values#2) + index_code(values#3) + gc_code("array_set", [gc.text])] }
	if name == "output_byte" { return [no_kind, index_code(values#1) + index_code(values#2) + [op.i32_store8, 0] + uleb(output_address)] }
	if name == "write_output" { return ["int", write_output(index_code(values#1))] }
	# copy_text(to, at, from, start, count)
	code = values#1#2 + index_code(values#2) + values#3#2 + index_code(values#4) + index_code(values#5)
	[no_kind, code + gc_code("array_copy", [gc.text, gc.text])]
}
intrinsics = {new_text: 1, copy_text: 5, byte_count: 1, byte_at: 2, code_of: 1, set_byte: 3,
	output_byte: 2, write_output: 1, kind_code: 1, unboxed_int: 1, unboxed_float: 1,
	marked_kind: 1, unboxed_text: 1, unboxed_char: 1, unboxed_list: 1, fail: 0, is_null: 1,
	char_of: 1, new_list: 1, copy_items: 5, adopt_items: 2, item_room: 1, set_count: 2, is_ratio: 1, ratio_of: 2, ratio_numerator: 1, ratio_denominator: 1,
	key_name: 1, key_value: 1, new_key: 2, map_of: 1, keyed: 3, entry_key: 1, symbol_of: 1, same_text: 2}
# the words a program calls that runtime.warp gives, by the runtime word's name
library_words = {join: "joined", "times·text": "repeated_text", zero_fill: "zero_fill", round: "rounded", len: "node_length",
	text_form: "node_text", str: "node_text", split: "split_text", chars: "text_graphemes", code_point_list: "text_chars", reverse: "reversed", list_sum: "list_sum",
	floor_quotient: "floor_quotient", map_entries: "map_entries", map_keys: "map_keys", map_values: "map_values",
	collection_contains: "collection_contains", key: "key_node", key_of: "key_left", value_of: "key_right", op_of: "key_operator",
	name_of: "node_text", Symbol: "symbol_node", symbol: "symbol_node", sort: "sorted_node", sorted: "sorted_node", list_sorted_by: "sorted_node_by",
	slice: "node_slice", starts_with: "node_starts_with", ends_with: "node_ends_with", lower: "text_lower", upper: "text_upper",
	trim: "node_trim", map_get_or: "map_get_or"}
# node_order knows no user compare: a program with classes sorts outside the core
sort_words = ["sorted_node", "sorted_node_by"]
# `x is spec`: the type words of Rust's BUILTIN_TYPES (src/lowering/types/type_tests.rs) the core holds, by their
# canonical name, and the kinds of the core each covers; an untyped value asks runtime.warp node_is_type
type_words = {int: "int", integer: "int", long: "int", i64: "int", i32: "int", rational: "rational", real: "rational",
	exact: "rational", float: "float", double: "float", f64: "float", f32: "float", float32: "float", float64: "float",
	number: "number", text: "text", str: "text", string: "text", codepoint: "char", char: "char", character: "char",
	bool: "bool", boolean: "bool", list: "list", key: "key", symbol: "symbol"}
covered_kinds = {int: ["int"], rational: ["int"], float: ["float"], number: ["int", "float"], text: ["text", "char"],
	char: ["char"], bool: ["bool"], list: ["list"], key: [], symbol: []}
def type_test(body: Body, subject: any, spec: text): list {
	if spec in module.classes { return runtime_call("instance_of", [["node", boxed(expression(body, subject))], text_value(spec)]) }
	if not (spec in type_words) { return refuse("a test of the type " + spec) }
	type = type_words[spec]
	value = expression(body, subject)
	if value#1 == "node" { return runtime_call("node_is_type", [value, text_value(type)]) }
	["bool", [op.i32_const, if value#1 in covered_kinds[type] then 1 else 0]]
}
# a boxed value's code as a $Node; its Kind without the marks above it; its payload: the value in a box, or a text
def as_node(code: any): list { code + gc_code("ref_cast_null", [gc.node]) }
def kind_code_of(code: any): list { as_node(code) + gc_code("struct_get", [gc.node, 0]) + [op.i64_const] + sleb(255) + [op.i64_and] }
def payload(code: any, held: int): list { as_node(code) + gc_code("struct_get", [gc.node, 1]) + gc_code("ref_cast_null", [held]) }
def unboxed(code: any, box: int): list { payload(code, box) + gc_code("struct_get", [box, 0]) }
# whether an Int $Node holds a $Ratio (an i32); the numerator (0) or denominator (1) of one
def ratio_test(code: any): list { as_node(code) + gc_code("struct_get", [gc.node, 1]) + gc_code("ref_test", [gc.ratio]) }
def ratio_part(code: any, field: int): list { payload(code, gc.ratio) + gc_code("struct_get", [gc.ratio, field]) + gc_code("ref_cast_null", [gc.int_box]) + gc_code("struct_get", [gc.int_box, 0]) }
# fd_write of the first `count` output bytes, its error code as an int
def write_output(count: any): list {
	word = [op.i32_store, 2, 0]
	iovec = [op.i32_const] + sleb(iovec_address) + [op.i32_const] + sleb(output_address) + word
	iovec += [op.i32_const] + sleb(iovec_address + 4) + count + word
	arguments = [op.i32_const] + sleb(stdout) + [op.i32_const] + sleb(iovec_address) + [op.i32_const, 1, op.i32_const] + sleb(written_address)
	iovec + arguments + [op.call] + uleb(import_index(fd_write)) + [op.i64_extend_i32_u]
}
import_index(entry: any): int := {
	index = -1
	for i in 0..<#module.imports { if module.imports[i] == entry { index = i } }
	if index < 0 { refuse("the import " + entry#2 + ", not declared") }
	index
}
def code_point(value: any): list { ["int", value#2 + [op.i64_extend_i32_u]] }
# a value as the text `+` joins it with and print writes
def shown_text(value: any): list {
	kind = value#1
	if kind == "text" { return value }
	if kind == pending { return ["text", value#2] }
	if kind == "list" or kind == "node" { module.shows_values = yes }
	if kind == "list" { return runtime_call("list_text", [value]) }
	if kind == "int" { return runtime_call("int_text", [value]) }
	if kind == "float" { return runtime_call("float_text", [value]) }
	if kind == "char" { return runtime_call("char_text", [value]) }
	if kind == "node" { return runtime_call("node_text", [value]) }
	if kind != "bool" { return refuse("the text of a " + kind) }
	["text", value#2 + [op.if] + references.text + text_value("yes")#2 + [op.else] + text_value("no")#2 + [op.end]]
}
# what `print` writes: `print a 3` each value as a list shows it, a space between
def printed_value(body: Body, n: any): list {
	if not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n > 1) { return expression(body, n) }
	runtime_call("items_text", [list_value(body, n.map(x => x))])
}
# `print x`: x's text and a newline to stdout; ø, as Rust's print gives
def printed(value: any): list { ["node", dropped(runtime_call("print_line", [shown_text(value)])) + [ref_null, gc.node]] }
# whether the symbol `name` occurs in n
mentions(n: any, name: text): bool := {
	if n is symbol { return name_of(n) == name }
	if type(n) is key { return mentions(key_of(n), name) or mentions(value_of(n), name) }
	if is_group(n) { for x in n { if mentions(x, name) { return yes } } }
	no
}
def runtime_call(name: text, values: any): list { call_values(module.runtime[name], values) }
# the classes and enum cases the program declares, wherever it does (a declaration arrives as an opaque view
# ["type", name, body], its name an attribute layer for an enum's bare cases or a base class)
collect_types(n: any): any := {
	if type(n) is key and key_of(n) == symbol(opaque_word) and kind_of(value_of(n)) == "type" { return record_type(value_of(n)#2) }
	if is_group(n) { for x in n { collect_types(x) } }
}
record_type(name: any): any := {
	if kind_of(name) == "symbol" { return module.classes[name#2] = yes }
	if kind_of(name) != "attribute" { return refuse("a type named by " + kind_of(name)) }
	if name#2 == "variants" { for variant in name#3[3..] { module.variants[variant#2] = yes } }
	record_type(name#4)
}

# a runtime word sees only the globals runtime.warp declares, never those of the program
is_global(body: Body, name: text): bool := not (name in body.names) and name in module.globals and (not body.intrinsics or name in module.runtime_globals)
def local_value(body: Body, n: any): list {
	name = name_of(n)
	if is_global(body, name) {
		entry = module.globals[name]
		return [entry#2, [op.global_get] + uleb(entry#1)]
	}
	# a bare enum case is its name, a symbol, at run time
	if not (name in body.names) and name in module.variants { return ["node", node(node_kind_codes.symbol, text_bytes(name))] }
	if not (name in body.names) { return refuse("the unknown name " + name) }
	index = body.names[name]
	[body.kinds#(index + 1), [op.local_get] + uleb(index)]
}

def operation(body: Body, symbol: text, a: any, b: any): list {
	kind = joint_kind(a#1, b#1)
	if kind == pending { kind = "int" }
	if symbol == "#" and (a#1 == "list" or a#1 == "node") { return element(body, a, b) }
	if symbol == "#" and a#1 == "text" { return runtime_call("text_char", [a, b]) }
	if symbol == "+" and a#1 == "list" and b#1 == "list" { return runtime_call("list_join", [a, b]) }
	textual = a#1 in characters or b#1 in characters
	if symbol == "+" and textual { return runtime_call("text_join", [shown_text(a), shown_text(b)]) }
	structured = a#1 == "list" or b#1 == "list" or a#1 == "node" or b#1 == "node"
	if structured and symbol in equalities { return equality(body, symbol, a, b) }
	# `"ab" * 2.5`: Rust says how a text repeats, a trap could not
	if textual and (a#1 == "node" or b#1 == "node") and not (symbol in comparisons) { return refuse("the operator " + symbol + " on " + a#1 + " and " + b#1) }
	if a#1 == "node" or b#1 == "node" { return node_operation(body, symbol, boxed(a), boxed(b)) }
	if symbol in comparisons and a#1 == "char" and b#1 == "char" { return operation(body, symbol, code_point(a), code_point(b)) }
	if symbol in comparisons and textual and a#1 in characters and b#1 in characters {
		return operation(body, symbol, runtime_call("text_order", [shown_text(a), shown_text(b)]), number_value(0))
	}
	if kind != "int" and kind != "float" { return refuse("the operator " + symbol + " on " + a#1 + " and " + b#1) }
	if symbol == "%" and kind == "int" { return euclidean_remainder(body, a, b) }
	if symbol == "%" { return runtime_call("float_mod", [["float", converted(a, kind)], ["float", converted(b, kind)]]) }
	if symbol == "/" and kind == "int" { return runtime_call("exact_ratio", [a, b]) }
	# a negative exponent gives an exact rational, so the power is a boxed value
	if symbol == "^" and kind == "int" { return runtime_call("exact_pow", [["node", boxed(a)], ["node", boxed(b)]]) }
	ops = if kind == "float" then float_ops else int_ops
	if not (symbol in ops) { return refuse("the operator " + symbol + " on " + kind) }
	if kind == "int" and symbol in checked_words and not body.intrinsics {
		return runtime_call(checked_words[symbol], [["int", converted(a, kind)], ["int", converted(b, kind)]])
	}
	result = if symbol in comparisons then "bool" else kind
	[result, converted(a, kind) + converted(b, kind) + [ops[symbol]]]
}

# an operator on boxed values, by the kinds they hold at run time: `+` is the runtime word node_add; a comparison
# between two texts or characters orders them as texts; two ints stay ints; an exact rational with an int or another
# stays exact; any other two are floats
def node_operation(body: Body, symbol: text, a: any, b: any): list {
	if symbol == "+" { return runtime_call("node_add", [["node", a], ["node", b]]) }
	left = ["node", [op.local_get] + uleb(fresh_local(body, "node"))]
	right = ["node", [op.local_get] + uleb(fresh_local(body, "node"))]
	ints = operation(body, symbol, ["int", unboxed(left#2, gc.int_box)], ["int", unboxed(right#2, gc.int_box)])
	floats = operation(body, symbol, runtime_call("float_of_node", [left]), runtime_call("float_of_node", [right]))
	kind = if ints#1 == "bool" then "bool" else "node"
	exact = exact_operation(body, symbol, left, right, floats)
	integers = ratio_test(left#2) + ratio_test(right#2) + [op.i32_or] + chosen(kind, exact, ints)
	numbers = both_of_kind(left#2, right#2, node_kind_codes.int) + chosen(kind, [kind, integers], floats)
	code = a + [op.local_set] + left#2[1..] + b + [op.local_set] + right#2[1..]
	if not (symbol in comparisons) { return [kind, code + numbers] }
	texts = operation(body, symbol, runtime_call("node_text", [left]), runtime_call("node_text", [right]))
	textual = x => condition(runtime_call("textual_node", [x]))
	[kind, code + textual(left) + textual(right) + [op.i32_and] + chosen(kind, texts, [kind, numbers])]
}
# `x == ø`, `x != ø` (a match's `ø:` case): ø and an empty list are nothing, as Rust's equality takes them
def nothing_test(body: Body, symbol: text, n: any): list {
	held_nothing = runtime_call("is_nothing", [["node", boxed(expression(body, n))]])
	if symbol == "==" { return held_nothing }
	["bool", condition(held_nothing) + [op.i32_eqz]]
}
# `a == b`, `a != b` with a list or a boxed value: the runtime word node_equal compares them deeply
def equality(body: Body, symbol: text, a: any, b: any): list {
	equal = runtime_call("node_equal", [["node", boxed(a)], ["node", boxed(b)]])
	if symbol == "==" { return equal }
	["bool", equal#2 + [op.i32_eqz]]
}
# an operator on two Int $Nodes, one an exact rational: the runtime's exact word, a comparison by exact_order; the
# operators without one take the floats
exact_words = {"-": "exact_sub", "*": "exact_mul", "/": "exact_div", "%": "exact_mod"}
def exact_operation(body: Body, symbol: text, left: any, right: any, floats: any): list {
	if symbol in exact_words { return runtime_call(exact_words[symbol], [left, right]) }
	if symbol in comparisons { return operation(body, symbol, runtime_call("exact_order", [left, right]), number_value(0)) }
	floats
}
# `floor x`: an int itself, a float's floor as an int, a boxed number by the runtime word floored_node (exact for a
# ratio, as Rust's exact_floor)
def floored(value: any): list {
	if value#1 == "int" { return value }
	if value#1 == "float" { return ["int", value#2 + [op.f64_floor, op.i64_trunc_f64_s]] }
	if value#1 == "node" { return runtime_call("floored_node", [value]) }
	refuse("floor of a " + value#1)
}
# `if` on the condition just computed: yes gives a, no gives b, both as kind
def chosen(kind: text, a: any, b: any): list { [op.if] + value_type(kind) + converted(a, kind) + [op.else] + converted(b, kind) + [op.end] }
def both_of_kind(a: any, b: any, code: int): list {
	test = x => kind_code_of(x) + [op.i64_const] + sleb(code) + [int_ops["=="]]
	test(a) + test(b) + [op.i32_and]
}

# a % b as in mathematics: never below 0, r + |b| for a negative truncated remainder r
def euclidean_remainder(body: Body, a: any, b: any): list {
	divisor = uleb(fresh_local(body, "int"))
	rest = uleb(fresh_local(body, "int"))
	get_divisor = [op.local_get] + divisor
	get_rest = [op.local_get] + rest
	zero = [op.i64_const, 0]
	absolute = zero + get_divisor + [int_ops["-"]] + get_divisor + get_divisor + zero + [int_ops["<"], op.select]
	code = a#2 + b#2 + [op.local_tee] + divisor + [op.i64_rem_s, op.local_set] + rest + get_rest + zero + [int_ops["<"]]
	["int", code + [op.if, type_bytes.int] + get_rest + absolute + [int_ops["+"], op.else] + get_rest + [op.end]]
}

def assignment(body: Body, target: any, value: any): list {
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø and subscript_name(value_of(target)) != ø {
		return map_assignment(body, expression(body, key_of(target)), subscript_name(value_of(target)), value)
	}
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø and is_shifted_index(value_of(target)) {
		held = expression(body, key_of(target))
		if held#1 == "node" { return keyed_assignment(body, key_of(target), held, expression(body, key_of(value_of(target))), value) }
	}
	if type(target) is key and op_of(target) == "#" and key_of(target) != ø {
		return element_assignment(body, expression(body, key_of(target)), expression(body, value_of(target)), value)
	}
	if type(target) is key and op_of(target) == ":" and key_of(target) is symbol and value_of(target) is symbol {
		return declaration(body, name_of(key_of(target)), name_of(value_of(target)), value)
	}
	if not (target is symbol) { return refuse("an assignment to " + form_of(target)) }
	name = name_of(target)
	if name in body.declared { value = admitted(value, body.declared[name]) }
	kind = value#1
	# a shared main-level variable is main's to assign: a function's assignment of that name makes its own local
	is_shared = name in module.shared
	if not (name in body.names) and is_shared and body.function.name == "main" { return declare_global(name, value) }
	if is_global(body, name) and not is_shared { return global_assignment(name, value) }
	if not (name in body.names) and name in body.function.widened { kind = body.function.widened[name] }
	if not (name in body.names) and analyzed_local_kind(body.function, name) != ø { kind = analyzed_local_kind(body.function, name) }
	# the last reading of a function in a cycle: a local given the value of a call still compiling holds a node until
	# the function is read again (module.rereads)
	if not (name in body.names) and kind == pending and body.function.result != pending { kind = "node" }
	if name in body.names and body.kinds#(body.names[name] + 1) != kind {
		held = body.kinds#(body.names[name] + 1)
		if widens(body, name, held, kind) {
			body.function.widened[name] = joint_kind(held, kind)
			return [held, [op.unreachable]]
		}
		kind = held
	}
	index = uleb(local_index(body, name, kind))
	[kind, converted(value, kind) + [op.local_tee] + index]
}

# `x: T = v`: x holds T's kind from here on; a value known only at run time is checked then (int_admitted,
# list_admitted), any other value Rust would check at run time (a fraction, a byte's range) is refused
declared_kinds = {int: "int", float: "float", text: "text", list: "list"}
admitting_words = {int: "int_admitted", list: "list_admitted"}
def declaration(body: Body, name: text, type_name: text, value: any): list {
	if not (type_name in declared_kinds) { return refuse("a variable declared " + type_name) }
	body.declared[name] = declared_kinds[type_name]
	assignment(body, symbol(name), value)
}
# a value as the declared kind takes it: an int widened to a float, a value known only at run time checked (a list
# one stays a node, as Rust keeps ø), else of that kind
def admitted(value: any, kind: text): list {
	if value#1 == kind or value#1 == pending { return value }
	if value#1 == "int" and kind == "float" { return ["float", converted(value, "float")] }
	if value#1 == "node" and kind in admitting_words { return runtime_call(admitting_words[kind], [value]) }
	refuse("a " + value#1 + " given to a variable declared " + kind)
}
def whole(value: any): list { admitted(value, "int") }

# `m.x = v` as lowered, `m#("x"+1) = v`: the assignment gives v
def map_assignment(body: Body, map: any, name: text, value: any): list {
	held = [op.local_get] + uleb(fresh_local(body, value#1))
	set = dropped(field_assignment(map, text_value_of(name), [value#1, held]))
	[value#1, value#2 + [op.local_set] + held[1..] + set + held]
}
# `m[k] = v` of a value known only at run time, as lowered `m#(k+1) = v`: an int k sets the item k+1, any other key
# the entry named so (runtime.warp node_put); a variable m holds the result, a map made of ø; the assignment gives v
def keyed_assignment(body: Body, target: any, map: any, key: any, value: any): list {
	held = [op.local_get] + uleb(fresh_local(body, value#1))
	put = ["node", runtime_call("node_put", [map, ["node", boxed(key)], ["node", boxed([value#1, held])]])#2]
	set = if target is symbol then dropped(assignment(body, target, put)) else dropped(put)
	[value#1, value#2 + [op.local_set] + held[1..] + set + held]
}
# whether a local (not a parameter) of kind `held` assigned a `kind` takes their joint kind from the next reading of
# its function on: `x = 7; x /= 2` makes x a boxed value, `x = 0; x += 0.5` a float
widens(body: Body, name: text, held: text, kind: text): bool := {
	# a yes/no stays one (a number given to it counts as yes when not 0), an int given a yes/no takes 1 or 0
	if body.names[name] < #body.function.parameters or held == pending or kind == pending or held == "bool" or kind == "bool" { return no }
	joint = joint_kind(held, kind)
	joint != held and (joint in type_bytes or joint in references)
}

# `global name = value` declares the module's variable name, which every function reads and writes; a bare
# `global name` (the analyzer's, for a main-level variable only a function assigns) holds nodes, 0 until assigned,
# and reads it: a function declaring it on each call keeps its value
def global_declaration(body: Body, declaration: any): list {
	if declaration is symbol {
		entry = declared_global(name_of(declaration), "node")
		return [entry#2, [op.global_get] + uleb(entry#1)]
	}
	if not (type(declaration) is key and op_of(declaration) == "=" and key_of(declaration) is symbol) {
		return refuse("the declaration global " + form_of(declaration))
	}
	declare_global(name_of(key_of(declaration)), expression(body, value_of(declaration)))
}
def declare_global(name: text, value: any): list {
	declared_global(name, value#1)
	global_assignment(name, value)
}
# the module's global name: [its index, its kind], the kind of its first declaration
def declared_global(name: text, kind: text): list {
	if not (name in module.globals) {
		module.globals[name] = [#module.global_order, kind]
		module.global_order += [name]
	}
	module.globals[name]
}
def global_assignment(name: text, value: any): list {
	entry = module.globals[name]
	index = uleb(entry#1)
	[entry#2, converted(value, entry#2) + [op.global_set] + index + [op.global_get] + index]
}
# `return x`: x ends the function; what follows it is unreachable, of any kind
def return_value(body: Body, value: any): list {
	body.returned += [value#1]
	result = body.function.result
	code = if result == pending then value#2 else converted(value, result)
	[pending, code + [op.return]]
}

def call(body: Body, f: Function, arguments: any): list {
	if #arguments != #f.parameters { return refuse("a call of " + f.name + " with " + #arguments + " arguments") }
	call_values(f, arguments.map(a => expression(body, a)))
}
def call_values(f: Function, values: any): list {
	if f.kinds == ø { compile_function(f, values.map(v => v#1)) }
	if f.result == pending { module.saw_pending = yes }
	code = []
	for i in 0..<#values { code += converted(values[i], f.kinds[i]) }
	[f.result, code + [op.call] + uleb(f.index)]
}

## closures (Rust's lowering: src/lowering/definitions/closures.rs)
# `closure_new(target, captured…)`: a Function $Node holding the list [the target's number, the captured values…], its
# value the target's name, as Rust's reads back; module.closures holds [target name, captured count] by number.
# `closure_call_<n>(f, a…)`: a function made once per arity n, its code written last (dispatcher_code), that calls the
# target f's number names; `<target>·captured·<i>(f)`: f's i-th captured value
closure_call_prefix = "closure_call_"
captured_marker = "·captured·"
# the runtime words that give a value's text: a program using one (or shown_text of a list or node) has no closures
# here, whose text is the lambda as written
text_words = ["node_text", "list_text", "joined"]
# the operators a closure takes part in (node_equal compares closures)
closure_comparisons = ["==", "!="]
is_closure_value(n: any) := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 == symbol("closure_new")
def closure_value(body: Body, target: any, captured: any): list {
	if not (target is symbol and name_of(target) in module.functions) { return refuse("a closure of " + form_of(target)) }
	number = closure_number(name_of(target), #captured)
	items = [boxed(number_value(number))] + captured.map(c => boxed(expression(body, c)))
	["node", key_code(node_kind_codes.function, vector_code(items), name_node(target))]
}
closure_number(name: text, captured: int): int := {
	for i in 0..<#module.closures { if module.closures[i]#1 == name { return i } }
	module.closures += [[name, captured]]
	#module.closures - 1
}
# the item i of a closure's list: 0 its number, then its captured values
def closure_item(closure: any, i: int): list { ["node", payload(closure, gc.list) + gc_code("struct_get", [gc.list, 1]) + [op.i32_const] + sleb(i) + gc_code("array_get", [gc.items])] }
captured_index(name: text): int := int(name.split(captured_marker)#2) + 1
def closure_call(body: Body, arity: int, arguments: any): list {
	if #arguments != arity + 1 { return refuse("a closure call of " + #arguments + " values") }
	call_values(dispatcher(arity), arguments.map(a => expression(body, a)))
}
dispatcher(arity: int): any := {
	name = closure_call_prefix + arity
	# (a list: `name in module.dispatchers` of a map missed the name just set, card emitter-name)
	for known in module.dispatchers { if known.name == name { return known } }
	f = Function(name, [], [], ø)
	f.index = #module.imports + #module.order
	module.order += [f]
	f.kinds = range_list(arity + 1).map(i => "node")
	f.result = "node"
	f.locals = []
	f.local_names = ["closure"] + range_list(arity).map(i => "argument" + (i + 1))
	f.code = [op.unreachable]
	module.dispatchers += [f]
	f
}
# a value called that is no closure fails in not_a_function; for each closure of f's arity: if the closure's number is
# its own, the target's call on the captured values and the arguments; a closure of another arity fails in
# wrong_number_of_arguments (the runtime errors of Rust's src/wasm_emitter/functions/closures.rs)
dispatcher_code(f: Function): any := {
	arity = #f.kinds - 1
	closure = [op.local_get, 0]
	number = unboxed(closure_item(closure, 0)#2, gc.int_box)
	not_a_function = dropped(runtime_call("not_a_function", [])) + [op.unreachable]
	code = closure + [op.ref_is_null, op.if, no_value] + not_a_function + [op.end]
	code += kind_code_of(closure) + [op.i64_const] + sleb(node_kind_codes.function) + [int_ops["!="], op.if, no_value] + not_a_function + [op.end]
	for k in 0..<#module.closures {
		target = module.functions[module.closures[k]#1]
		captured = module.closures[k]#2
		if #target.parameters - captured == arity {
			values = range_list(captured).map(i => closure_item(closure, i + 1)) + range_list(arity).map(j => ["node", [op.local_get] + uleb(j + 1)])
			called = boxed(call_values(target, values))
			code += number + [op.i64_const] + sleb(k) + [int_ops["=="], op.if, no_value] + called + [op.return, op.end]
		}
	}
	f.code = code + dropped(runtime_call("wrong_number_of_arguments", [])) + [op.unreachable]
}

# `if c then a else b`, `if c then a`: the parser's keys else(then(if(ø, c), a), b)
# has_else: `else ø` is a branch giving ø, no missing one
def conditional(body: Body, test: any, yes_branch: any, no_branch: any, has_else: bool): list {
	c = condition(expression(body, test))
	a = nested(body, yes_branch, 1)
	if not has_else { return [no_kind, c + [op.if, no_value] + dropped(a) + [op.end]] }
	b = nested(body, no_branch, 1)
	kind = joint_kind(a#1, b#1)
	if kind == pending { kind = "int" }
	if kind == no_kind or kind == "mixed" { return [no_kind, c + [op.if, no_value] + dropped(a) + [op.else] + dropped(b) + [op.end]] }
	[kind, c + [op.if] + value_type(kind) + converted(a, kind) + [op.else] + converted(b, kind) + [op.end]]
}
# `while c do body`: block { loop { exit unless c; body; again } }; a `break` in body branches to the block's end
def loop_of(body: Body, test: any, block: any): list {
	exit_unless = condition(nested(body, test, 2)) + [op.i32_eqz, op.br_if, 1]
	body.exits += [body.depth + 1]
	looped = nested(body, block, 2)
	body.exits = body.exits[0..<(#body.exits - 1)]
	[no_kind, [op.block, no_value, op.loop, no_value] + exit_unless + dropped(looped) + [op.br, 0, op.end, op.end]]
}

# the code of n read inside `blocks` more blocks, loops or ifs
def nested(body: Body, n: any, blocks: int): list {
	body.depth += blocks
	code = expression(body, n)
	body.depth -= blocks
	code
}

# `break`: to the end of the innermost loop's block
def loop_exit(body: Body): list {
	if #body.exits == 0 { return refuse("a break outside a loop") }
	[no_kind, [op.br] + uleb(body.depth - body.exits#(#body.exits))]
}

# a statement's code, its value dropped
def dropped(value: any): list { if value#1 == no_kind then value#2 else value#2 + [op.drop] }

# `xs += e`: e's items appended to the list xs holds, in place, so every alias sees them; ø when xs holds no list
appended(body: Body, target_name: any, addition: any): any := {
	target = expression(body, target_name)
	if target#1 == "list" { return runtime_call("list_append", [target, expression(body, addition)]) }
	if target#1 == "node" { return assignment(body, target_name, runtime_call("node_append", [target, expression(body, addition)])) }
	ø
}
def sequence(body: Body, items: any): list {
	if #items == 0 { return refuse("an empty block") }
	code = []
	for item in items[0..<(#items - 1)] { code += dropped(statement(body, item)) }
	last = statement(body, items#(#items))
	code += last#2
	[last#1, code]
}
# a statement of a sequence: a local stays unshared while statements only append to it (Rust's list_sharing.rs,
# simpler); a fresh list makes it unshared, a list made inside a block of the statement does not outlast it
def statement(body: Body, n: any): list {
	kept = []
	for name in body.unshared { if appends_only(n, name) { kept += [name] } }
	body.unshared = kept
	value = expression(body, n)
	after = []
	for name in body.unshared { if name in kept { after += [name] } }
	made = fresh_list_name(n)
	if made != ø and made in body.names { after += [made] }
	body.unshared = after
	value
}
# `xs = []`, `xs = ø`, `xs = [a, b]`: the local name holds a list made right here
fresh_list_name(n: any): any := {
	if not (type(n) is key and op_of(n) == "=" and key_of(n) is symbol) { return ø }
	if value_of(n) is ø or bracket_of(value_of(n)) == "[" { return name_of(key_of(n)) }
	ø
}
# `xs = xs + e`, `xs += e` of e not mentioning xs: the name xs, else ø
self_append_name(n: any): any := {
	if not (type(n) is key and key_of(n) is symbol) { return ø }
	name = name_of(key_of(n))
	sum = value_of(n)
	if op_of(n) == "+=" and not mentions(sum, name) { return name }
	if op_of(n) != "=" or not (type(sum) is key and op_of(sum) == "+" and key_of(sum) == key_of(n)) { return ø }
	if mentions(value_of(sum), name) { return ø }
	name
}
# whether n mentions the local name only in appends to it
appends_only(n: any, name: text): bool := {
	if self_append_name(n) == name { return yes }
	if n is symbol { return name_of(n) != name }
	if type(n) is key { return appends_only(key_of(n), name) and appends_only(value_of(n), name) }
	if is_group(n) { for x in n { if not appends_only(x, name) { return no } } }
	yes
}

def expression(body: Body, n: any): list {
	if n is bool { return ["bool", [op.i32_const, if n then 1 else 0]] }
	if n is number { return number_value(n) }
	if n is text { return text_value(n) }
	if n is ø { return ["node", [ref_null, gc.node]] }
	if n == symbol("break") { return loop_exit(body) }
	if n is symbol and name_of(n) in module.host and not (name_of(n) in body.names) { return host_call(body, name_of(n), []) }
	if n is symbol { return local_value(body, n) }
	if type(n) is key { return key_expression(body, n) }
	if not is_group(n) { refuse("the value " + form_of(n)) }
	group_expression(body, n)
}

def group_expression(body: Body, n: any): list {
	if bracket_of(n) == "(" and #n > 1 and n#1 == symbol("closure_new") { return closure_value(body, n#2, n[2..].map(x => x)) }
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1).starts_with(closure_call_prefix) {
		return closure_call(body, int(name_of(n#1)[(#closure_call_prefix)..]), n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1).contains(captured_marker) {
		return closure_item(expression(body, n#2)#2, captured_index(name_of(n#1)))
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.functions {
		return call(body, module.functions[name_of(n#1)], n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.host {
		return host_call(body, name_of(n#1), n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("wasm_instruction") and n#2 is text { return wasm_instruction(body, n#2) }
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in intrinsics and body.intrinsics {
		return intrinsic(body, name_of(n#1), n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in time_intrinsics and body.intrinsics {
		return time_intrinsic(body, name_of(n#1), n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in time_words {
		return time_call(body, name_of(n#1), n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in module.runtime and body.intrinsics {
		return call(body, module.runtime[name_of(n#1)], n[1..].map(x => x))
	}
	if bracket_of(n) == "(" and #n == 3 and n#1 == symbol("is_type") and n#3 is text { return type_test(body, n#2, n#3) }
	# a match no case takes (one the analyzer found exhaustive): a trap, as Rust's no_case_ error word ends the program
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("switch_no_case") { return [pending, [op.unreachable]] }
	if bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in library_words {
		word = library_words[name_of(n#1)]
		if word in sort_words and #module.classes > 0 { return refuse("a sort where instances order through compare") }
		# `a /! b` of a ratio or float floors it as Rust does; floor_quotient takes ints only
		if word == "floor_quotient" { for x in n[1..] { if expression(body, x)#1 != "int" { return refuse("/! on a value not an int") } } }
		if not body.intrinsics and word in text_words { module.shows_values = yes }
		return call(body, module.runtime[word], n[1..].map(x => x))
	}
	if (bracket_of(n) == "(" or bracket_of(n) == "") and #n == 2 and n#1 == symbol("print") { return printed(printed_value(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 is symbol and name_of(n#1) in length_words {
		# `count = 0; count(users)`: Rust's "`count` is a variable here"
		if name_of(n#1) in body.names { return refuse("the variable " + name_of(n#1) + " applied to a value") }
		return length(expression(body, n#2))
	}
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("floor") { return floored(expression(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("text") { return shown_text(expression(body, n#2)) }
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("float") { return ["float", converted(expression(body, n#2), "float")] }
	if bracket_of(n) == "(" and #n == 1 { return expression(body, n#1) }
	if bracket_of(n) == "" and #n == 2 and n#1 == symbol("return") { return return_value(body, expression(body, n#2)) }
	if bracket_of(n) == "" and #n == 2 and n#1 == symbol("global") { return global_declaration(body, n#2) }
	if bracket_of(n) == "[" { return list_value(body, n.map(x => x)) }
	if bracket_of(n) == "{" and #n > 0 and n.all(is_entry) { return map_value(body, n.map(x => x)) }
	# a map of one entry, as Rust's lowering marks it: map_value already gives the map
	if bracket_of(n) == "(" and #n == 2 and n#1 == symbol("map_of_entry") { return expression(body, n#2) }
	if bracket_of(n) == "(" and #n == 4 and n#1 == symbol("field_with") {
		return field_assignment(expression(body, n#2), expression(body, n#3), expression(body, n#4))
	}
	if not (bracket_of(n) == "" or bracket_of(n) == "{" or separator_of(n) == ";") { refuse(form_of(n)) }
	# `y = 2 x`: Rust's "`x` after `y=2` does nothing"
	assigns = x => type(x) is key and (op_of(x) == "=" or op_of(x) == ":=")
	if separator_of(n) == " " and #n > 1 and assigns(n#1) { refuse("a value after an assignment") }
	sequence(body, n.map(x => x))
}

def key_expression(body: Body, n: any): list {
	operator = op_of(n)
	left = key_of(n)
	right = value_of(n)
	if operator == "else" and type(left) is key and op_of(left) == "then" { return conditional(body, value_of(key_of(left)), value_of(left), right, yes) }
	if operator == "then" and type(left) is key and op_of(left) == "if" { return conditional(body, right_of_if(left), right, ø, no) }
	# `c ? a : b`: the keys ?(c, :(a, b))
	if operator == "?" and type(right) is key and op_of(right) == ":" { return conditional(body, left, key_of(right), value_of(right), yes) }
	if operator == "do" and type(left) is key and op_of(left) == "while" { return loop_of(body, value_of(left), right) }
	if operator == "=" and left is symbol and name_of(left) in body.unshared and self_append_name(n) != ø {
		grown = appended(body, left, value_of(right))
		if grown != ø { return grown }
	}
	if operator == "=" { return assignment(body, left, expression(body, right)) }
	if operator == ":" and left == symbol("global") { return global_declaration(body, right) }
	# the step a `for` lowering appends to its loop body, as the analysis view shows it: run after the body
	if operator == ":" and left == symbol("loop·step") { return expression(body, right) }
	# a class declaration, held as an opaque view (walk.warp): its instances are maps (instance_value)
	if left == symbol(opaque_word) and kind_of(right) == "type" { return [no_kind, []] }
	if operator == ":" and left is symbol and is_group(right) and bracket_of(right) == "{" and right.all(is_entry) {
		# `div{ a: 1 }` of no class is Rust's `div:a:1`: a block of one entry is that entry
		if #right == 1 and not (name_of(left) in module.classes) {
			return ["node", keyed_code(name_node(left), boxed(expression(body, right#1)))]
		}
		return instance_value(body, name_of(left), right.map(x => x))
	}
	# a function value as an operand: Rust's type error `1 + (x => x)`, its reflection `f.name` read as `(closure_new f)#("name"+1)`
	if not (operator in closure_comparisons) and (is_closure_value(left) or is_closure_value(right)) { return refuse("a function value in " + operator) }
	if operator == "#" and left != ø and subscript_name(right) != ø { return map_get(expression(body, left), subscript_name(right)) }
	if operator == "#" and left != ø and is_shifted_index(right) {
		target = expression(body, left)
		if target#1 == "node" { return runtime_call("node_get", [target, ["node", boxed(expression(body, key_of(right)))]]) }
	}
	if operator == "+=" {
		target = expression(body, left)
		added = expression(body, right)
		# Rust's `s += "ab"` on a number is its type error, though `s = s + "ab"` joins
		# a number variable given boxed values by `+=` (a sum over a list's items) stays a sum after it widens
		numeric = target#1 == "int" or target#1 == "float"
		if numeric and added#1 in characters { return refuse("a number += a " + added#1) }
		sum = left is symbol and (numeric or name_of(left) in body.function.sums)
		if sum and added#1 == "node" {
			body.function.sums[name_of(left)] = yes
			return assignment(body, left, operation(body, "+", target, runtime_call("number_node", [added])))
		}
		grown = appended(body, left, right)
		if grown != ø { return grown }
	}
	if operator == "/=" and left is symbol and name_of(left) in body.declared and body.declared[name_of(left)] == "int" {
		return assignment(body, left, runtime_call("floor_quotient", [expression(body, left), whole(expression(body, right))]))
	}
	if operator in compound_ops { return assignment(body, left, operation(body, compound_ops[operator], expression(body, left), expression(body, right))) }
	if operator in steps and right == ø { return assignment(body, left, operation(body, steps[operator], expression(body, left), number_value(1))) }
	if operator == "-" and left == ø { return negation(body, expression(body, right)) }
	if operator in logical_words { return logical(body, logical_words[operator], left, right) }
	if operator == "#" and left == ø { return length(expression(body, right)) }
	if operator == "." and right is symbol and name_of(right) in length_words { return length(expression(body, left)) }
	# `m.a`: the entry a of the map (or instance) m, as Rust lowers it to `m#("a"+1)`
	if operator == "." and right is symbol { return field_of(expression(body, left), name_of(right)) }
	# (only `rational`: a float `as real` or `as exact` stays a float in Rust, type_tests.rs is_exact_fraction_type)
	if operator == "as" and right is symbol and name_of(right) == "rational" {
		return as_rational(expression(body, left))
	}
	if operator == "as" and right is symbol and (name_of(right) in type_bytes or name_of(right) in references) {
		value = expression(body, left)
		# `7/2 as int`: an exact rational truncated toward 0
		if value#1 == "node" and name_of(right) == "int" { return runtime_call("truncated_int", [value]) }
		if name_of(right) == "text" { return shown_text(value) }
		return [name_of(right), converted(value, name_of(right))]
	}
	if operator == "not" and left == ø { return ["bool", condition(expression(body, right)) + [op.i32_eqz]] }
	if left == ø or right == ø {
		# `x === ø` is `x == ø`: ø is one value, as Rust's identity of it
		equality = if operator in identities then identities[operator] else operator
		if equality in equalities { return nothing_test(body, equality, if left == ø then right else left) }
		return refuse("the operator " + operator)
	}
	if operator == "#" and left is symbol { return analyzed_element(body, left, right) }
	operation(body, operator, expression(body, left), expression(body, right))
}
# `xs#i` of a list whose elements analyzer.warp knows: the element as that kind, else as a node
def analyzed_element(body: Body, list: any, index: any): list {
	value = operation(body, "#", expression(body, list), expression(body, index))
	kind = analyzed_element_kind(body.function, name_of(list))
	if kind == ø or value#1 != "node" { return value }
	[kind, converted(value, kind)]
}
right_of_if(n: any): any := value_of(n)
# `x as rational` of a float: the runtime's float_as_exact (decision float-as-rational); other kinds Rust takes
def as_rational(value: any): list {
	if value#1 == "float" { return runtime_call("float_as_exact", [value]) }
	refuse("a " + value#1 + " as rational")
}

# -value; a value known only at run time as 0 - value
def negation(body: Body, value: any): list {
	if value#1 == "float" { return ["float", value#2 + [op.f64_neg]] }
	if value#1 == "node" { return operation(body, "-", number_value(0), value) }
	if value#1 != "int" { refuse("the negation of a " + value#1) }
	["int", [op.i64_const, 0] + value#2 + [int_ops["-"]]]
}
# `a and b`, `a or b` on yes/no values: b is read only when a leaves the answer open
# on other values they give one of them, as Rust does: `a and b` is b when a holds, else a; `a or b` a when a holds,
# else b (`(1==1) and 5` is 5, `x | y` with x 0 is y); a yes/no beside a number counts as 1 or 0
logical_words = {and: "and", or: "or", "|": "or"}
def logical(body: Body, symbol: text, left: any, right: any): list {
	a = expression(body, left)
	b = nested(body, right, 1)
	# a value whose kind the first reading of a recursive function does not know yet (pending) beside a yes/no is one
	yes_no = kind => kind == "bool" or kind == pending
	if yes_no(a#1) and yes_no(b#1) {
		a = condition(a)
		b = condition(b)
		if symbol == "and" { return ["bool", a + [op.if, type_bytes.bool] + b + [op.else, op.i64_const, 0, op.i64_eqz, op.i32_eqz, op.end]] }
		return ["bool", a + [op.if, type_bytes.bool, op.i64_const, 1, op.i64_eqz, op.i32_eqz, op.else] + b + [op.end]]
	}
	kind = if a#1 == "bool" then b#1 else if b#1 == "bool" then a#1 else joint_kind(a#1, b#1)
	# on a float Rust fails: "is a float where an exact Int is expected"; boxed values count by their truth
	if (kind != "int" and kind != "node") or a#1 == "float" or b#1 == "float" { return refuse("the operator " + symbol + " on " + a#1 + " and " + b#1) }
	held = [a#1, [op.local_get] + uleb(fresh_local(body, a#1))]
	test = condition([a#1, a#2 + [op.local_set] + held#2[1..] + held#2])
	# beside a value known only at run time a yes/no on the left counts as 1 or 0, one on the right stays yes/no, as Rust's
	left = if kind == "node" and a#1 == "bool" then ["int", converted(held, "int")] else held
	given = if symbol == "and" then [b, left] else [left, b]
	[kind, test + [op.if] + value_type(kind) + converted(given#1, kind) + [op.else] + converted(given#2, kind) + [op.end]]
}

## functions
# the locals of f's body, its parameters first
# (a function whose first parameter is a class sees that class's fields bare: its locals are named apart)
new_scope(f: Function): Body := {
	scope = Body({}, [], [], 0, f.is_runtime, f, [], {}, 0, [], [])
	for i in 0..<#f.parameters { local_index(scope, name_of(f.parameters[i]), f.kinds[i]) }
	scope
}

# is the program analyzed (WARP_SELF_ANALYSIS): then a node meeting a list or text holds one, as analyzer.warp found
analyzed_program(): bool := module.kinds != ø and "value" in module.kinds
# the kinds analyzer.warp finds that the emitter holds as found; a node stays the emitter's own reading of the value
# not int: analyzer.warp's int is warp's unbounded one, a node holding a big number would trap as an i64
held_kinds = {float: 1, char: 1, text: 1, list: 1}
held_kind(kind: any): any := if kind in held_kinds then kind else ø
# what analyzer.warp found for the program's function f, main's being the program's variables and value; ø if nothing
analyzed_function(f: Function): any := {
	if f.is_runtime or not analyzed_program() { return ø }
	if f.name == "main" { return {params: [], result: module.kinds["value"], locals: module.kinds["variables"], elements: module.kinds["elements"]} }
	functions = module.kinds["functions"]
	if functions == ø or not (f.name in functions) { return ø }
	functions[f.name]
}
# the kind analyzer.warp found for f's i-th parameter (counted from 0), its result, a local, if the emitter holds it
analyzed_parameter_kind(f: Function, i: int): any := {
	found = analyzed_function(f)
	if found == ø or i >= #found["params"] { return ø }
	held_kind(found["params"][i])
}
analyzed_result_kind(f: Function): any := {
	found = analyzed_function(f)
	if found == ø { return ø }
	held_kind(found["result"])
}
# (an empty map of locals comes as null: card lib-json)
analyzed_local_kind(f: Function, name: text): any := {
	found = analyzed_function(f)
	if found == ø or found["locals"] == ø or not (name in found["locals"]) { return ø }
	held_kind(found["locals"][name])
}
# the kind of the elements analyzer.warp found for f's list `name`, if the emitter unboxes it from a node
unboxed_element_kinds = {float: 1, text: 1, list: 1}
analyzed_element_kind(f: Function, name: text): any := {
	found = analyzed_function(f)
	if found == ø or found["elements"] == ø or not (name in found["elements"]) { return ø }
	kind = found["elements"][name]
	if kind in unboxed_element_kinds then kind else ø
}

compile_function(f: Function, argument_kinds: any): any := {
	outer = module.saw_pending
	if not module.surveying { function_compiled(f, argument_kinds) } else {
		try { function_compiled(f, argument_kinds) } catch refusal {
			if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
			module.refusals += [outside_the_core + f.name + ": " + ("" + refusal)[(#outside_the_core)..]]
			if f.kinds == ø { f.kinds = argument_kinds.map(k => "node") }
			f.result = "node"
		}
	}
	module.saw_pending = outer
}
function_compiled(f: Function, argument_kinds: any): any := {
	f.index = #module.imports + #module.order
	module.order += [f]
	parameter_kinds = []
	for i in 0..<#f.parameters {
		annotation = f.annotations[i]
		if annotation == ø { annotation = analyzed_parameter_kind(f, i) }
		# an argument of a call still compiling (a cycle of functions) is not known yet: the parameter takes a node
		given = if argument_kinds[i] == pending then "node" else argument_kinds[i]
		parameter_kinds += [if annotation == ø then given else if annotation == "any" or annotation == "function" or annotation in module.classes then "node" else annotation]
	}
	for kind in parameter_kinds { if not (kind in type_bytes or kind in references) { return refuse("a parameter of kind " + kind) } }
	f.kinds = parameter_kinds
	# the first readings find the result kind and the kinds of locals assigned values of two kinds (`widens`), the
	# last gives the code with every recursive call knowing the result
	widened = -1
	while widened != #f.widened.keys {
		widened = #f.widened.keys
		f.result = pending
		first = new_scope(f)
		result = expression(first, f.body)#1
		for kind in first.returned { result = joint_kind(result, kind) }
	}
	if result != no_kind and analyzed_result_kind(f) != ø { result = analyzed_result_kind(f) }
	if result == "mixed" { return refuse(f.name + " giving a " + result) }
	# a body ending in a statement (a loop, a print) gives ø, as Rust's does; one giving only the result of a call
	# still compiling gives a node
	f.result = if result == no_kind or result == pending then "node" else result
	f.gives_nothing = result == no_kind
	module.saw_pending = no
	body_code(f)
	if module.saw_pending { module.rereads += [f] }
}
# the last reading of f, every call's result known but those of functions still compiling; a function that called
# one of those is read again once every function is compiled (module.rereads)
body_code(f: Function) := {
	scope = new_scope(f)
	value = expression(scope, f.body)
	f.code = if f.gives_nothing then value#2 + [ref_null, gc.node] else converted(value, f.result)
	f.locals = scope.kinds[(#f.parameters)..]
	f.local_names = scope.order
}

## the module
def value_type(kind: text): list { if kind in references then references[kind] else [type_bytes[kind]] }
# a global's first value, before its declaration sets it
def zero_of(kind: text): list {
	if kind == "int" { return [op.i64_const, 0] }
	if kind == "float" { return [op.f64_const] + le64(0) }
	# a node global holds 0 until assigned, as Rust's `global x; x` gives (struct.new is a constant expression)
	if kind == "node" { return boxed(number_value(0)) }
	if kind in references { return [ref_null] + (if kind == "time" then [110] else uleb(references[kind]#2)) }
	[op.i32_const, 0]
}
def global_entry(name: text): list { value_type(module.globals[name]#2) + [mutable] + zero_of(module.globals[name]#2) + [op.end] }
def function_type(f: Function): list { [function_type_byte] + vector(f.kinds.map(value_type)) + [1] + value_type(f.result) }
def function_body(f: Function): list {
	content = vector(f.locals.map(k => [1] + value_type(k))) + f.code + [op.end]
	uleb(#content) + content
}
def index_name(i: int, name: text): list { uleb(i) + name_bytes(name) }
def name_map(names: any): list { vector(range_list(#names).map(i => index_name(i, names#(i + 1)))) }
def local_name_map(f: Function): list { uleb(f.index) + name_map(f.local_names) }
def range_list(n: int): list {
	out = []
	for i in 0..n { out += [i] }
	out
}
def subsection(id: int, content: any): list { [id] + uleb(#content) + content }
def names_section(functions: any): list {
	imported = range_list(#module.imports).map(i => index_name(i, module.imports#(i + 1)#2))
	function_names = vector(imported + functions.map(f => index_name(f.index, f.name)))
	locals = vector(functions.map(local_name_map))
	types = name_map(gc_names.map(t => t#1))
	fields = vector(range_list(#gc_names).map(i => uleb(i) + name_map(gc_names#(i + 1)#2)))
	content = subsection(names_subsections.functions, function_names) + subsection(names_subsections.locals, locals)
	globals = name_map(module.global_order)
	content += subsection(names_subsections.types, types) + subsection(names_subsections.globals, globals)
	content += subsection(names_subsections.fields, fields)
	section(section_ids.custom, name_bytes("name") + content)
}

def module_bytes(functions: any): list {
	# an import's type follows the GC types in the imports' order, so a function's type is #gc_types + its index too
	types = section(section_ids.type, vector(gc_types + module.imports.map(i => i#3) + functions.map(function_type)))
	imported = section(section_ids.import, vector(range_list(#module.imports).map(i => import_entry(i))))
	declared = section(section_ids.function, vector(functions.map(f => uleb(#gc_types + f.index))))
	exports = [name_bytes("main") + [export_function_byte] + uleb(functions#1.index)]
	memory = []
	if #module.imports > 0 {
		memory = section(section_ids.memory, vector([[0] + uleb(memory_pages)]))
		exports += [name_bytes("memory") + [export_memory_byte, 0]]
	} else { imported = [] }
	for name in exported_globals {
		if name in module.globals { exports += [name_bytes(name) + [export_global_byte] + uleb(module.globals[name]#1)] }
	}
	exported = section(section_ids.export, vector(exports))
	# the texts' bytes: one passive segment, which array.new_data reads
	segments = section(section_ids.data_count, uleb(1))
	codes = section(section_ids.code, vector(functions.map(function_body)))
	texts = section(section_ids.data, vector([[passive_segment] + uleb(#module.bytes) + module.bytes]))
	globals = section(section_ids.globals, vector(module.global_order.map(global_entry)))
	parts = [types, imported, declared, memory, globals, exported, segments, codes, texts]
	wasm_header + joined(parts) + names_section(functions)
}
def import_entry(i: int): list {
	entry = module.imports#(i + 1)
	name_bytes(entry#1) + name_bytes(entry#2) + [import_function_byte] + uleb(#gc_types + i)
}

## host words: the program's environment, imported from the "host" module (src/host.rs)
host_module = "host"
def host_import(name: text): list {
	signature = module.host[name]
	[host_module, name, [function_type_byte] + vector(signature#1.map(host_type)) + vector(signature#2.map(host_type))]
}
def host_type(kind: text): list { if kind == "i32" then [type_bytes.char] else value_type(kind) }

# `clock`, `sleep(ms)`: a call of the imported host word, its arguments in the kinds it takes; a host word taking or
# giving a node builds and reads nodes through functions the module exports for it (new_int…), which this one lacks
def host_call(body: Body, name: text, arguments: any): list {
	signature = module.host[name]
	if "node" in signature#1 or "node" in signature#2 { return refuse("the host word " + name + " on nodes") }
	if #arguments != #signature#1 { return refuse("a call of " + name + " with " + #arguments + " arguments") }
	code = []
	for i in 0..<#arguments { code += host_argument(expression(body, arguments[i]), signature#1[i]) }
	code += [op.call] + uleb(import_index(host_import(name)))
	if #signature#2 == 0 { return [no_kind, code] }
	result = signature#2#1
	if result == "i32" { return ["int", code + [op.i64_extend_i32_s]] }
	[result, code]
}
def host_argument(value: any, kind: text): list {
	if kind == "i32" { return host_int(value) + [op.i32_wrap_i64] }
	if kind == "int" { return host_int(value) }
	converted(value, kind)
}
# a number a host word takes as an int: a fraction or a float rounded to the nearest, as Rust passes `sleep(1/60*1000)`
def host_int(value: any): list {
	if value#1 == "node" or value#1 == "float" { return runtime_call("rounded", [["float", converted(value, "float")]])#2 }
	converted(value, "int")
}

# `global name = 0` or `= ""` at the top of runtime.warp: a module variable of that kind its words share, from the
# kind's zero (ø for a text)
runtime_global(n: any): any := {
	if not (type(n) is key and op_of(n) == ":" and key_of(n) == symbol("global")) { return ø }
	name = name_of(key_of(value_of(n)))
	module.globals[name] = [#module.global_order, if value_of(value_of(n)) is number then "int" else "text"]
	module.runtime_globals += [name]
	module.global_order += [name]
}

# the module of a lowered program, or a text naming the first form outside the core; `runtime` is
# lib/compiler/runtime.warp lowered by the same pipeline
wasm_module(program: any, runtime: any): any := hosted_wasm_module(program, runtime, {})

# as wasm_module, the host words `host` names importable (src/compiler/self_hosted.rs passes src/host.rs's)
hosted_wasm_module(program: any, runtime: any, host: any): any := typed_wasm_module(program, runtime, host, {})

# as hosted_wasm_module, an unannotated parameter of the kind analyzer.warp found in `kinds` (WARP_SELF_ANALYSIS)
typed_wasm_module(program: any, runtime: any, host: any, kinds: any): any := {
	module.kinds = kinds
	module.functions = {}
	module.order = []
	module.runtime = {}
	module.globals = {}
	module.runtime_globals = []
	module.global_order = []
	module.texts = {}
	module.bytes = []
	# the host words, but those the program defines itself: its own `notify(x) := …` is its own
	module.host = {}
	defined = defined_names(program)
	for name in host.keys { if not (name in defined) { module.host[name] = host[name] } }
	module.classes = {}
	module.variants = {}
	module.closures = []
	module.dispatchers = []
	module.shows_values = no
	module.surveying = env(survey_setting) != ø
	module.refusals = []
	module.saw_pending = no
	module.rereads = []
	collect_types(program)
	module.imports = if mentions(program, "print") then [fd_write] else []
	# imported ahead of the functions, whose indices follow them: every host word the program names
	for name in module.host.keys {
		if mentions(program, name) or (name in time_host_words and makes_time(program)) { module.imports += [host_import(name)] }
	}
	for n in collect_functions(runtime, module.runtime) { runtime_global(n) }
	for name in module.runtime.keys {
		word = module.runtime[name]
		word.is_runtime = yes
	}
	main = Function("main", [], [], ø)
	try {
		main.body = separated(bracketed(collect_functions(program, module.functions), ""), ";")
		module.shared = shared_names(statements_of(main.body))
		compile_function(main, [])
		# a function of the program never called is compiled too, its parameters of any kind: Rust's compiles each, so
		# a program with one it cannot compile fails there (not the prelude's helpers, compiled when called)
		for name in module.functions.keys {
			f = module.functions[name]
			if f.kinds == ø and not name.starts_with(prelude_prefix) { compile_function(f, f.parameters.map(p => "node")) }
		}
		# a dispatcher's call may compile a target that makes more closures or dispatchers: again until none is new
		seen = -1
		while seen != #module.closures + #module.dispatchers {
			seen = #module.closures + #module.dispatchers
			for f in module.dispatchers { dispatcher_code(f) }
		}
		for f in module.rereads { body_code(f) }
		# a closure's text is its lambda as written, which the lowered program no longer holds
		if #module.closures > 0 and module.shows_values { refuse("the text of a closure") }
		if main.result != "int" and main.result != "float" {
			main.code = boxed([main.result, main.code])
			main.result = "node"
		}
		if #module.refusals > 0 { throw module.refusals.join("\n") }
		module_bytes(module.order)
	} catch refusal {
		if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
		text = "" + refusal
		if #module.refusals > 0 and text != module.refusals.join("\n") { return (module.refusals + [text]).join("\n") }
		text
	}
}

## times (card time-primitives; Rust twin: src/wasm_emitter/time, layout: src/time/mod.rs TimeForm): a $Node of the
## Kind time, its info (form, then a duration's days and months or a zoned time's zone and offset) above the kind
## bits, its data an $i64box of the position (days since 1970 for a date, nanoseconds for the others)
time_kind_code = 18
kind_bits = 8
nanos_per_milli = 1000000
# the info bits: a duration's days (32 bits, unsigned) above the form, its months above them; a zoned time's zone
# index (8 bits) above the form, its offset in minutes above that
form_bits = 3
form_mask = 7
months_shift = 35
zone_mask = 255
offset_shift = 11
seconds_per_minute = 60
shift_ops = {i64_or: 132, i64_shl: 134, i64_shr_s: 135, i64_shr_u: 136, i64_mul: 126}
# the calls a lowered program makes a time with (src/time/mod.rs: `now` is instant_at(clock()), a constant time_of)
time_words = {time_of: 2, instant_at: 1}
# the words runtime.warp reads a time with, one or two instructions each (runtime words only, as `intrinsics`)
time_intrinsics = {time_form: 1, time_position: 1, duration_months: 1, duration_days: 1, zone_index: 1, zone_offset: 1}
# the host words runtime words over times call, imported when the program makes a time (Rust: imports.rs makes_instant)
time_host_words = ["local_offset"]
makes_time(program: any): bool := mentions(program, "instant_at") or mentions(program, "time_of")

# time_of(info, position): the time node; instant_at(milliseconds since 1970): an instant
def time_call(body: Body, name: text, arguments: any): list {
	if #arguments != time_words[name] { return refuse("a call of " + name + " with " + #arguments + " arguments") }
	values = arguments.map(a => expression(body, a))
	if name == "instant_at" {
		nanos = converted(values#1, "int") + [op.i64_const] + sleb(nanos_per_milli) + [shift_ops.i64_mul]
		return ["time", time_node([op.i64_const, 0], nanos)]
	}
	["time", time_node(converted(values#1, "int"), converted(values#2, "int"))]
}
def time_node(info: any, position: any): list {
	kind = info + [op.i64_const] + sleb(kind_bits) + [shift_ops.i64_shl, op.i64_const] + sleb(time_kind_code) + [shift_ops.i64_or]
	kind + position + gc_code("struct_new", [gc.int_box]) + [ref_null, gc.node] + gc_code("struct_new", [gc.node])
}
# the kind word of a time node shifted right by `shift` bits, arithmetic (`signed`) or logical
def kind_word_shifted(code: any, shift: int, signed: bool): list {
	shifted = as_node(code) + gc_code("struct_get", [gc.node, 0]) + [op.i64_const] + sleb(shift)
	shift_op = if signed then shift_ops.i64_shr_s else shift_ops.i64_shr_u
	shifted + [shift_op]
}
def masked(code: any, mask: int): list { code + [op.i64_const] + sleb(mask) + [op.i64_and] }
def time_intrinsic(body: Body, name: text, arguments: any): list {
	t = expression(body, arguments#1)#2
	if name == "time_form" { return ["int", masked(kind_word_shifted(t, kind_bits, no), form_mask)] }
	if name == "time_position" { return ["int", unboxed(t, gc.int_box)] }
	if name == "duration_months" { return ["int", kind_word_shifted(t, kind_bits + months_shift, yes)] }
	# the 32 days bits, sign-extended: shifted to the top of the word, then down again
	if name == "duration_days" {
		top = 64 - kind_bits - months_shift
		days = as_node(t) + gc_code("struct_get", [gc.node, 0]) + [op.i64_const] + sleb(top) + [shift_ops.i64_shl]
		return ["int", days + [op.i64_const] + sleb(32) + [shift_ops.i64_shr_s]]
	}
	if name == "zone_index" { return ["int", masked(kind_word_shifted(t, kind_bits + form_bits, no), zone_mask)] }
	# seconds east of UTC
	offset = kind_word_shifted(t, kind_bits + offset_shift, yes)
	["int", offset + [op.i64_const] + sleb(seconds_per_minute) + [shift_ops.i64_mul]]
}
