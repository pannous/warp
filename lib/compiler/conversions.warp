# A program's conversions (decision general-conversions; Rust twin: src/lowering/types/conversions.rs): `Person as
# text := it.name` says how a Person turns into text, and every `p as text` of the program then uses it. Each target
# gets one function trying the program's conversions to it in the order written, the built-in one last:
#   as·text(it) := if it is Person then it.name else it as text
# A use is its call, `as·text(p)`; a declaration `x as text = "a"` stays one.
use "walk.warp"
use "words.warp"
use "scope.warp"
use "diagnostics.warp"

# `as·text`: the function converting to the target, a name no program can write
conversion_name(target: text): text := "as·" + target

# a word naming a type: a type word, a collection, or a type the program declares (`class Person {…}`)
names_type(n: any, scope: any): bool := n is symbol and (is_tested_type_word(name_of(n)) or binds_as(scope, name_of(n), Meaning.Type))

# [source, target, body] of `A as B := body` with A and B types, else ø
conversion_of(n: any, scope: any): any := {
	if not (is_key(n, Op.Define) and is_key(key_of(n), Op.As)) { return ø }
	source = key_of(key_of(n))
	target = value_of(key_of(n))
	if names_type(source, scope) and names_type(target, scope) then [name_of(source), name_of(target), value_of(n)] else ø
}

# every `x as B` of a target B the program converts to as the call of its conversion; `x as B = v` and `f(x) as B := …`
# declare and stay
converting_uses(n: any, targets: any): any := {
	if (is_key(n, Op.Assign) or is_key(n, Op.Define)) and is_key(key_of(n), Op.As) {
		return Key(key_of(n), op_of(n), converting_uses(value_of(n), targets))
	}
	walked = children(n, x => converting_uses(x, targets))
	if is_key(walked, Op.As) and value_of(walked) is symbol and targets.has(name_of(value_of(walked))) {
		return call_of(conversion_name(name_of(value_of(walked))), [key_of(walked)])
	}
	walked
}

# the conversion to `target`: the program's conversions to it tried in order, by the source type, then the built-in one
conversion_function(target: text, written: list, targets: any): any := {
	it = symbol(implicit_parameter)
	tried = Key(it, Op.As, symbol(target))
	for conversion in written.reverse() {
		test = Key(it, Op.Is, symbol(conversion#1))
		tried = Key(Key(Key(ø, Op.If, test), Op.Then, converting_uses(conversion#3, targets)), Op.Else, tried)
	}
	Key(call_of(conversion_name(target), [it]), Op.Define, tried)
}

# the program with its conversions as functions, before its statements (its last one stays its value), and their uses
# as calls
conversions(program: any): any := {
	scope = scope_of(program)
	targets = {}
	order = []
	kept = []
	for statement in statements_in(program) {
		conversion = conversion_of(statement, scope)
		if conversion == ø {
			kept += [statement]
		} else if conversion#1 == conversion#2 {
			kept += [diagnose(call_of("own_type_conversion", [conversion#2]))]
		} else {
			if not targets.has(conversion#2) {
				targets[conversion#2] = []
				order += [conversion#2]
			}
			targets[conversion#2] = targets[conversion#2] + [conversion]
		}
	}
	if not order { return if #kept == #statements_in(program) then program else List(kept, Bracket.None, Separator.Newline) }
	functions = order.map(target => conversion_function(target, targets[target], targets))
	List(functions + kept.map(statement => converting_uses(statement, targets)), Bracket.None, Separator.Newline)
}
