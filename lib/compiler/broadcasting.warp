# `xs .* 2` is `xs.map(each_element -> each_element * 2)`: a dotted operator applies to each element (Rust twin:
# src/lowering/collections/broadcasting.rs lower_element_wise_operators). The parser keeps it as the phrase
# [xs .* 2]. Only this form is ported (decision: broadcasting minimal); broadcasting functions over lists stays Rust.
use "walk.warp"
use "words.warp"

each_element = "each_element"

# `.*` gives `*`, else ø
element_operator(word: any) := {
	if word is not symbol { return ø }
	for op in element_wise_operators {
		if name_of(word) == "." + op { return op }
	}
	ø
}

# xs.map(each_element -> each_element op operand)
element_wise(list: Node, op: text, operand: Node): Node := {
	item = symbol(each_element)
	Key(list, Op.Dot, call_of("map", [Key(item, Op.Arrow, Key(item, op as Op, operand))]))
}

element_wise_phrase(n: Node): Node := match n {
	List(parts, Bracket.None, Separator.Space): {
		op = if #parts == 3 then element_operator(parts#2) else ø
		if op == ø then n else element_wise(parts#1, op, parts#3)
	}
	_: n
}

element_wise_operators_pass(program: any) := bottom_up(program, element_wise_phrase)
