# A function written with a keyword (card pure-runs): `def f(x) := e` and `fun f(x) { body }` (any of
# function_keywords) are the definition `f(x) := body`; the parser keeps the keyword before the definition, or before
# the call and its block side by side.
use "walk.warp"
use "words.warp"

is_keyword(n: Node): bool := match n {
	Symbol(name): name in function_keywords
	_: no
}

defined(n: Node): Node := match n {
	List(parts, Bracket.Round, Separator.None): { if #parts == 2 then Key(parts#1, Op.Define, parts#2) else n }
	_: n
}

definition(n: Node): Node := match n {
	List(parts, Bracket.None, Separator.Space): { if #parts == 2 and is_keyword(parts#1) then defined(parts#2) else n }
	_: n
}

definitions(program: any): any := bottom_up(program, definition)
