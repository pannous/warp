# Forms other languages use, in warp's own (card sugar-twins; Rust twin: src/lowering/welcoming/welcome_forms.rs).
#
# match_arms (lower_match_arms): every match's arms in the one form later passes read: `[match, subject, {k => v …}]`, `[match, (subject {k => v …})]` or `[(match subject), {…}]` with
# the cases as `k: v`, `_ => v` and `else -> v` as `default: v`; Swift's `case .north: 1` as `.north: 1` and
# `case 1` as 1. `match alle = f(3) {…}` names its subject: `match (alle = f(3)) {…}`.
use "walk.warp"

switch_words = [symbol("switch"), symbol("match")]
default_word = "default"

is_switch_word(n: any): bool := switch_words contains n
last_of(items: any): any := items#(#items)

# `alle = (f(3) {cases})` as [alle = f(3), {cases}], else ø
named_subject(item: Node): any := match item {
	Key(name, Op.Assign, value): { if name is symbol then named_value(name, value) else ø }
	_: ø
}

named_value(name: Node, value: Node): any := {
	if not is_group(value) or #value < 2 or bracket_of(last_of(value)) != "{" { return ø }
	expression = value[0 .. #value - 1]
	subject = if #expression == 1 then expression#1 else group_like(value, expression)
	[Key(name, Op.Assign, subject), last_of(value)]
}

named_switch_subjects(n: Node): Node := match n {
	List(items, bracket, separator): List(subjects_named(items.map(named_switch_subjects)), bracket, separator)
	Key(left, Op.Assign, value): named_assignment(left, value)
	_: children(n, named_switch_subjects)
}

# the items with the subject after each switch word named
subjects_named(items: any): list := {
	found = []
	for item in items {
		named = if #found > 0 and is_switch_word(last_of(found)) then named_subject(item) else ø
		if named != ø { found += named } else { found += [item] }
	}
	found
}

# `(match alle) = …` as `match (alle = …)`
named_assignment(left: Node, value: Node): Node := {
	if is_group(left) and #left == 2 and is_switch_word(left#1) {
		return named_switch_subjects(List([left#1, Key(left#2, Op.Assign, value)], Bracket.None, Separator.Space))
	}
	Key(named_switch_subjects(left), Op.Assign, named_switch_subjects(value))
}

colon_case(case: Node): Node := match case {
	List(cases, Bracket.None, Separator.Comma): List(cases.map(colon_case), Bracket.None, Separator.Comma)
	Key(Key(word, Op.Dot, label), Op.Colon, value): { if word == symbol("case") then Key(Key(ø, Op.Dot, label), Op.Colon, value) else case }
	List(parts, bracket, separator): { if #parts == 2 and parts#1 == symbol("case") then parts#2 else case }
	Key(arm_pattern, Op.Arrow, value): Key(default_pattern(arm_pattern), Op.Colon, value)
	_: case
}

# `_` and `else` as `default`
default_pattern(pattern: Node): Node := if pattern == symbol("_") or pattern == symbol("else") then symbol(default_word) else pattern

colon_cases(block: Node): Node := match block {
	List(cases, Bracket.Curly, separator): List(cases.map(colon_case), Bracket.Curly, separator)
	_: block
}

# the items of a match with its cases block in the colon form; other items as they are
with_colon_cases(items: any): any := {
	if #items == 2 and is_group(items#1) and #(items#1) == 2 and is_switch_word(items#1#1) {
		return [items#1, colon_cases(items#2)]
	}
	if #items == 0 or not is_switch_word(items#1) { return items }
	if #items == 3 { return [items#1, items#2, colon_cases(items#3)] }
	if #items == 2 and is_group(items#2) and #(items#2) == 2 {
		pair = items#2
		return [items#1, group_like(pair, [pair#1, colon_cases(pair#2)])]
	}
	items
}

colon_arms(n: Node): Node := match n {
	List(items, bracket, separator): List(with_colon_cases(items.map(unchanged)), bracket, separator)
	_: n
}

match_arms(program: any): any := bottom_up(named_switch_subjects(program), colon_arms)

# bare_returns (lower_bare_returns): returning ø, bare (`if t == ø { return }`) or written (`return ø`), parses as the
# word alone; here it becomes the phrase `return ø` the emitter compiles. `return = 1` and `x.return` keep the word
bare_returns(n: Node): Node := match n {
	Symbol(word): { if word == "return" then List([n, ø], Bracket.None, Separator.Space) else n }
	List(items, bracket, separator): {
		if #items == 2 and items#1 == symbol("return") { return List([items#1, bare_returns(items#2)], bracket, separator) }
		children(n, bare_returns)
	}
	Key(left, op, right): {
		if left == symbol("return") { return Key(left, op, bare_returns(right)) }
		if op == Op.Dot and right == symbol("return") { return Key(bare_returns(left), op, right) }
		children(n, bare_returns)
	}
	_: children(n, bare_returns)
}

# arrow_result_types (lower_arrow_result_types): Swift's and Rust's result arrow before `:=`, `x(p:P) -> int := p.n`,
# is the typed head `x(p:P): int := p.n` every pass reads
calls_by_name(n: Node): bool := match n {
	List(parts, Bracket.Round, separator): #parts > 0 and parts#1 is symbol
	_: no
}

arrow_result_types(n: Node): Node := match n {
	Key(target, Op.Define, value): Key(result_typed(target), Op.Define, arrow_result_types(value))
	Key(target, Op.Assign, value): Key(result_typed(target), Op.Assign, arrow_result_types(value))
	_: children(n, arrow_result_types)
}

# `x(p:P) -> int` as `x(p:P): int`
result_typed(target: Node): Node := match target {
	Key(head, Op.Arrow, result): { if calls_by_name(head) then Key(head, Op.Colon, result) else arrow_result_types(target) }
	_: arrow_result_types(target)
}
