# What the names of a program are (target pipeline shape, notes/self_hosting.md): one walk that knows every binding
# form, read by the passes that ask "does the program give this word a meaning?". For now one scope for the whole
# program; scopes per block come with the application pass.
# `x = v` a variable (a function when v is a lambda), `f(a) := …` / `f(a) = …` / `def f(a) {…}` a function and its
# parameters, `for x in …` a loop variable, `a => …` a parameter, `{k: v}` a field.
use "walk.warp"
use "words.warp"

# the name a binding form gives: `x`, `x: int`, `x: int = 1`; ø for anything else
binding_name(view: any) := {
	kind = kind_of(view)
	if kind == "symbol" { return view#2 }
	if kind == "key" { return binding_name(view#3) }
	ø
}

# `x => …`, `(x => …)`: a lambda
is_lambda_view(view: any) := {
	kind = kind_of(view)
	if kind == "key" { return view#2 == "=>" or view#2 == "->" }
	kind == "list" and view#2 == "(" and #view == 4 and is_lambda_view(view#4)
}

is_round(view: any) := kind_of(view) == "list" and view#2 == "("

# the parameters of a lambda's left side `(a, b)`, `a`, or of a head's items after its name; a group of them, `f (a b)`,
# gives its items
parameters_of(head: any) := {
	if not is_round(head) { return [binding_name(head)] }
	names = []
	for item in head[3 ..] { names += if is_round(item) then parameters_of(item) else [binding_name(item)] }
	names
}

# `def f(a) {…}` arrives as `((f (a)) {…})`: the head `(f (a))`
definition_head(view: any) := if is_round(view) and #view > 3 and is_round(view#4) then definition_head(view#4) else view

# the meanings a view gives, [name, meaning] each
meanings_of(view: any) := {
	kind = kind_of(view)
	found = []
	if kind == "key" and (view#2 == "=" or view#2 == ":=") {
		target = view#3
		if kind_of(target) == "list" and target#2 == "(" and #target > 3 {
			found += [[binding_name(target#4), "function"]]
			for name in parameters_of(["list", "(", ""] + target[4 ..]) { found += [[name, "parameter"]] }
		} else {
			meaning = if view#2 == ":=" or is_lambda_view(view#4) then "function" else "variable"
			found += [[binding_name(target), meaning]]
		}
	}
	if kind == "key" and (view#2 == "=>" or view#2 == "->") {
		for name in parameters_of(view#3) { found += [[name, "parameter"]] }
	}
	if kind == "list" {
		at = 4
		while at < #view {
			word = view#at
			if kind_of(word) == "symbol" and word#2 == "for" { found += [[binding_name(view#(at + 1)), "loop"]] }
			if kind_of(word) == "symbol" and function_keywords contains word#2 {
				head = definition_head(view#(at + 1))
				found += [[head_name(head), "function"]]
				if is_round(head) { for name in parameters_of(["list", "(", ""] + head[4 ..]) { found += [[name, "parameter"]] } }
			}
			at += 1
		}
		if view#2 == "{" {
			for item in view[3 ..] {
				if kind_of(item) == "key" and item#2 == ":" { found += [[binding_name(item#3), "field"]] }
			}
		}
	}
	found
}

# name → its meanings, of the whole program
scope_of(program: any) := {
	scope = {}
	for view in views_in(program) {
		for pair in meanings_of(view) {
			name = pair#1
			if name != ø and name != "" {
				if not scope.has(name) { scope[name] = [] }
				scope[name] = scope[name] + [pair#2]
			}
		}
	}
	scope
}

binds(scope: any, name: text) := scope.has(name)
binds_as(scope: any, name: text, meaning: text) := scope.has(name) and scope[name] contains meaning
