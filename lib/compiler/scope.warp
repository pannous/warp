# What the names of a program are (target pipeline shape, notes/self_hosting.md): one walk that knows every binding
# form, read by the passes that ask "does the program give this word a meaning?". For now one scope for the whole
# program; scopes per block come with the application pass.
# `x = v` a variable (a function when v is a lambda), `f(a) := …` / `f(a) = …` / `def f(a) {…}` a function and its
# parameters, `for x in …` a loop variable, `a => …` a parameter, `{k: v}` a field.
use "walk.warp"
use "words.warp"

# the name a binding form gives: `x`, `x: int`, `x: int = 1`; ø for anything else
binding_name(view: any): any := {
	kind = kind_of(view)
	if kind == "symbol" { return view#2 }
	if kind == "key" { return binding_name(view#3) }
	ø
}

# `x => …`, `(x => …)`: a lambda
is_lambda_view(view: any): bool := {
	kind = kind_of(view)
	if kind == "key" { return view#2 == "=>" or view#2 == "->" }
	kind == "list" and view#2 == "(" and #view == 4 and is_lambda_view(view#4)
}

is_round(view: any): bool := kind_of(view) == "list" and view#2 == "("

# the parameters of a lambda's left side `(a, b)`, `a`, or of a head's items after its name; a group of them, `f (a b)`,
# gives its items
parameters_of(head: any): list := {
	if not is_round(head) { return bound_names(head) }
	names = []
	for item in head[3 ..] { names += if is_round(item) then parameters_of(item) else bound_names(item) }
	names
}

# the name a parameter binds, none for a pattern without one: `f([]) := 0`
bound_names(view: any): list := {
	name = binding_name(view)
	if name == ø then [] else [name]
}

# `def f(a) {…}` arrives as `((f (a)) {…})`: the head `(f (a))`
definition_head(view: any): any := if is_round(view) and #view > 3 and is_round(view#4) then definition_head(view#4) else view

as_parameters(names: list): list := names.map(name => [name, "parameter"])

# `f(a, b)` as a definition's head: the function and its parameters
function_meanings(head: any): list := {
	if not is_round(head) { return [[head_name(head), "function"]] }
	[[head_name(head), "function"]] + as_parameters(parameters_of(["list", "(", ""] + head[4 ..]))
}

# `x = v`, `f(a) = …`, `f := …`: a variable, or a function when v is a lambda or the head a call
assignment_meanings(op: text, target: any, value: any): list := match target {
	["list", "(", _, _, ..._] => function_meanings(target)
	_ => [[binding_name(target), if op == ":=" or is_lambda_view(value) then "function" else "variable"]]
}

# the meanings a word gives the item after it in a phrase: `for x`, `def f(a)`
word_meanings(word: any, next: any): list := match word {
	["symbol", "for"] => [[binding_name(next), "loop"]]
	["symbol", keyword] if function_keywords contains keyword => function_meanings(definition_head(next))
	_ => []
}

# the meanings the words of a list view give
phrase_meanings(view: any): list := {
	found = []
	for at in 4 ..< #view { found += word_meanings(view#at, view#(at + 1)) }
	found
}

# the meanings a view gives, [name, meaning] each
meanings_of(view: any): list := match view {
	["key", op, target, value] if op == "=" or op == ":=" => assignment_meanings(op, target, value)
	["key", op, parameters, _] if op == "=>" or op == "->" => as_parameters(parameters_of(parameters))
	["list", _, _, ..._] => phrase_meanings(view)
	_ => []
}

# `{k: v}`: the field k
fields_of(view: any): list := {
	found = []
	if kind_of(view) != "list" or view#2 != "{" { return found }
	for item in view[3 ..] {
		found += match item {
			["key", ":", name, _] => [[binding_name(name), "field"]]
			_ => []
		}
	}
	found
}

# the scope with each [name, meaning] pair added
remember(scope: any, pairs: list): any := {
	for pair in pairs {
		name = pair#1
		if name != ø and name != "" {
			if not scope.has(name) { scope[name] = [] }
			scope[name] = scope[name] + [pair#2]
		}
	}
	scope
}

# name → its meanings, of the whole program
scope_of(program: any): any := scope_of_view(view_of(program))

# name → its meanings, of a program's view (parser.warp's tree)
scope_of_view(top: any): any := {
	scope = {}
	for view in lists_in(top) {
		scope = remember(remember(scope, meanings_of(view)), fields_of(view))
	}
	scope
}

binds(scope: any, name: text): bool := scope.has(name)
binds_as(scope: any, name: text, meaning: text): bool := scope.has(name) and scope[name] contains meaning
