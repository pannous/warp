# The word tables the pass twins share, each a plain list checked against its Rust twin by tests/parser/test_self_words.rs
# until the Rust table is gone (card library-word-tables).

# the words naming a type a value is held as, lowercase (Rust twin: analyzer type_word_kind, from BUILTIN_TYPES in
# src/lowering/types/type_tests.rs and FIXED_WIDTHS in src/numbers/fixed_width.rs)
type_words = ["int", "integer", "long", "i64", "i32", "rational", "real", "exact", "float", "double", "f64", "f32",
	"float32", "float64", "fast", "number", "text", "str", "string", "codepoint", "char", "character", "bool", "boolean",
	"function", "closure", "builtin", "byte", "int8", "int16", "int32", "int64", "uint8", "u8", "uint16", "uint32",
	"uint64"]
any_word = "any"
# a collection type's head words, before `of` (`list of int`; Rust twin: type_tests.rs COLLECTION_WORDS) and the
# foreign spellings of list (warp_parser/mod.rs FOREIGN_LIST_HEADS)
collection_words = ["list", "map"]
foreign_list_heads = ["Vec", "vector", "Vector", "array", "Array", "ArrayList"]

is_type_word(word: text) := type_words contains word.lower()
is_type_word_or_any(word: text) := word == any_word or is_type_word(word)
is_collection_head(word: text) := collection_words contains word or foreign_list_heads contains word
