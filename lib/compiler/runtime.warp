# The runtime words of lib/compiler/emitter.warp: warp over the emitter's intrinsics (`intrinsic` there: new_text,
# byte_at, set_byte … each one or two instructions, callable only here). This file is lowered by the same pipeline as
# any program; the emitter compiles a word on its first call, so a module carries only the words it uses.

text_join(a: text, b: text): text := {
	out = new_text(byte_count(a) + byte_count(b))
	copy_text(out, 0, a, 0, byte_count(a))
	copy_text(out, byte_count(a), b, 0, byte_count(b))
	# a walk over a stays good on out, which starts with a's bytes: `t += …` keeps t's cursor
	if same_text(a, walked_text) == 1 { walked_text = out }
	if same_text(a, other_text) == 1 { other_text = out }
	out
}
# the text counted last, its size then and its count; the two texts `t#i` walked last, each with its size then, the
# index the walk stands at, that character's byte and the one before's (-1 when unknown): `for ch in t` counts t once
# and walks on from the character before, also with another text indexed in between or one look back (linear time,
# as Rust's text cursor)
global counted_text = ""
global counted_bytes = 0
global counted = 0
global walked_text = ""
global walked_bytes = 0
global walked_index = 0
global walked_at = 0
global walked_before = -1
global other_text = ""
global other_bytes = 0
global other_index = 0
global other_at = 0
global other_before = -1
# the characters (grapheme clusters) of a text
text_count(t: text): int := {
	if same_text(t, counted_text) == 1 and byte_count(t) == counted_bytes { return counted }
	count = 0
	at = 0
	while at < byte_count(t) {
		at = character_end(t, at)
		count += 1
	}
	counted_text = t
	counted_bytes = byte_count(t)
	counted = count
	count
}
# the code points of a text: its bytes that start one, all but the continuation bytes 10xxxxxx
code_point_count(t: text): int := {
	count = 0
	for i in 0..byte_count(t) {
		b = byte_at(t, i)
		if b < 128 or b >= 192 { count += 1 }
	}
	count
}
# t and a newline to stdout, through the output bytes of linear memory a chunk at a time: the one place a text
# goes into memory
print_line(t: text): int := {
	room = 65520
	start = 0
	while start < byte_count(t) {
		stop = start + room
		if stop > byte_count(t) { stop = byte_count(t) }
		for i in start..stop { output_byte(i - start, byte_at(t, i)) }
		write_output(stop - start)
		start = stop
	}
	output_byte(0, 10)
	write_output(1)
}
# -1, 0 or 1 as a's bytes come before b's, equal them or come after
text_order(a: text, b: text): int := {
	i = 0
	while i < byte_count(a) and i < byte_count(b) {
		if byte_at(a, i) < byte_at(b, i) { return -1 }
		if byte_at(a, i) > byte_at(b, i) { return 1 }
		i += 1
	}
	if byte_count(a) == byte_count(b) then 0 else if byte_count(a) < byte_count(b) then -1 else 1
}
# the text of a boxed value of a kind known only at run time (kind codes: src/type_kinds.rs); others trap
node_text(n: any): text := match n {
	ø: char_text("ø")
	Number(_): number_text(n)
	Char(_): char_text(unboxed_char(n))
	Text(_): unboxed_text(n)
	Symbol(_): unboxed_text(n)
	Key(_, _, _): key_text(n)
	True: "yes"
	False: "no"
	_: collection_text(n)
}
number_text(n: any): text := if kind_code(n) == 1 then exact_text(n) else float_text(unboxed_float(n))
# a map in braces, a list as list_text shows it
collection_text(n: any): text := {
	if marked_kind(n) == 8 { return "{" + items_text(unboxed_list(n)) + "}" }
	if kind_code(n) == 8 { return list_text(unboxed_list(n)) }
	if kind_code(n) == 18 { return time_text(n) }
	fail()
}
# a value as a list shows its items: a text in double quotes, a character in single quotes
node_code(n: any): text := match n {
	Char(_): "'" + node_text(n) + "'"
	Text(_): text_code(unboxed_text(n))
	_: node_text(n)
}
# a one-character text reads as the character it is (src/node/serialization.rs)
text_code(t: text): text := if code_point_count(t) == 1 then "'" + t + "'" else quoted_text(t)
# a text in double quotes, a `\` before each of its quotes and backslashes, so the printed list reads back (P126)
quoted_text(t: text): text := {
	escapes = 0
	for i in 0..byte_count(t) { escapes += escaped_byte(byte_at(t, i)) }
	out = new_text(byte_count(t) + escapes + 2)
	set_byte(out, 0, 34)
	at = 1
	for i in 0..byte_count(t) {
		b = byte_at(t, i)
		if escaped_byte(b) == 1 {
			set_byte(out, at, 92)
			at += 1
		}
		set_byte(out, at, b)
		at += 1
	}
	set_byte(out, at, 34)
	out
}
# 1 for the bytes of `"` and `\`, which a quoted text escapes
escaped_byte(b: int): int := if b == 34 or b == 92 then 1 else 0
list_text(xs: list): text := "[" + items_text(xs) + "]"
# the items of a list as a list shows them, a space between: `print a 3` writes its values so
items_text(xs: list): text := {
	inner = ""
	for x in xs {
		if #inner > 0 { inner += " " }
		inner += node_code(x)
	}
	inner
}
# `a:1`; a class instance `Point{x:1 y:2}`, its fields a map
key_text(entry: any): text := {
	value = key_value(entry)
	if is_null(value) == 0 and marked_kind(value) == 8 { return key_name(entry) + node_text(value) }
	key_name(entry) + ":" + node_code(value)
}
# `a + b` of values known only at run time: lists and texts join, numbers add
node_add(a: any, b: any): any := {
	# ø, also `[]` in the lowered program, beside a list is that list, beside a text "ø"; beside a number Rust fails
	if is_null(a) == 1 and is_null(b) == 0 and kind_code(b) == 8 { return b }
	if is_null(b) == 1 and is_null(a) == 0 and kind_code(a) == 8 { return a }
	if textual_node(a) == 1 or textual_node(b) == 1 { return node_text(a) + node_text(b) }
	if is_null(a) + is_null(b) > 0 { fail() }
	if kind_code(a) == 8 and kind_code(b) == 8 { return list_join(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == 1 and kind_code(b) == 1 and is_ratio(a) + is_ratio(b) > 0 { return exact_add(a, b) }
	if kind_code(a) == 1 and kind_code(b) == 1 { return checked_add(unboxed_int(a), unboxed_int(b)) }
	float_of_node(a) + float_of_node(b)
}
# a + b, a - b, a * b of ints; past i64 the ints of Rust grow unbounded, here they trap
checked_add(a: int, b: int): int := {
	added = a + b
	if (b > 0 and added < a) or (b < 0 and added > a) { fail() }
	added
}
checked_subtract(a: int, b: int): int := {
	difference = a - b
	if (b > 0 and difference > a) or (b < 0 and difference < a) { fail() }
	difference
}
# 2^63 bounds the product; one rounded to it from just below traps too, loud rather than wrong
checked_multiply(a: int, b: int): int := {
	estimate = float(a) * float(b)
	bound = float(4611686018427387904) + float(4611686018427387904)
	if estimate >= bound or estimate < 0 - bound { fail() }
	a * b
}
# `a += b` of values known only at run time: a list grows in place as list_append, anything else is a + b
node_append(a: any, b: any) := {
	if is_null(a) == 0 and is_null(b) == 0 and kind_code(a) == 8 and kind_code(b) == 8 {
		return list_append(unboxed_list(a), unboxed_list(b))
	}
	node_add(a, b)
}
# `a == b` of values known only at run time: ø equals only ø, lists equal item by item, closures by their target and
# captured values (emitter.warp closure_value), texts and characters as texts, numbers as numbers (an int and a float alike)
node_equal(a: any, b: any): bool := {
	if is_null(a) == 1 or is_null(b) == 1 { return is_null(a) == is_null(b) }
	if kind_code(a) == 6 or kind_code(b) == 6 {
		return kind_code(a) == kind_code(b) and text_order(key_name(a), key_name(b)) == 0 and node_equal(key_value(a), key_value(b))
	}
	if kind_code(a) == 8 or kind_code(b) == 8 { return kind_code(a) == kind_code(b) and list_equal(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == 16 or kind_code(b) == 16 { return kind_code(a) == kind_code(b) and list_equal(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == 5 or kind_code(b) == 5 { return kind_code(a) == kind_code(b) and text_order(node_text(a), node_text(b)) == 0 }
	if textual_node(a) == 1 or textual_node(b) == 1 { return textual_node(a) == textual_node(b) and text_order(node_text(a), node_text(b)) == 0 }
	if kind_code(a) == 1 and kind_code(b) == 1 and is_ratio(a) + is_ratio(b) > 0 { return exact_order(a, b) == 0 }
	if kind_code(a) == 1 and kind_code(b) == 1 { return unboxed_int(a) == unboxed_int(b) }
	float_of_node(a) == float_of_node(b)
}
list_equal(a: list, b: list): bool := {
	if #a != #b { return no }
	for i in 1 to #a { if not node_equal(a#i, b#i) { return no } }
	yes
}
# a map is a curly list of `name:value` keys (kind 8 and 262, as Rust's); a class instance `Point{x:1}` is the key of
# its class name and the map of its fields
fields_of(m: any): any := if kind_code(m) == 6 then key_value(m) else m
# the place of m's entry named `name`, counted from 1; 0 when it has none
map_index(m: any, name: text): int := {
	entries = unboxed_list(fields_of(m))
	for i in 1 to #entries { if text_order(key_name(entries#i), name) == 0 { return i } }
	0
}
# `m.name`: the value of m's entry `name`; none traps, where Rust's says "no field name"
map_get(m: any, name: text): any := {
	at = map_index(m, name)
	if at == 0 { fail() }
	key_value(unboxed_list(fields_of(m))#at)
}
# what `for k, v in x` walks: a map's entries as [name, value] pairs, any other list itself
map_entries(n: any): any := {
	if marked_kind(n) != 8 { return n }
	out = []
	for entry in unboxed_list(n) { out += [[key_name(entry), key_value(entry)]] }
	out
}
map_keys(m: any): list := {
	out = new_list(0)
	for entry in unboxed_list(fields_of(m)) { out += [key_name(entry)] }
	out
}
map_values(m: any): list := {
	out = new_list(0)
	for entry in unboxed_list(fields_of(m)) { out += [key_value(entry)] }
	out
}
# `x in c`, `c.contains(x)`: a map's entry named x, a list's item equal to x, a text's part x
collection_contains(c: any, x: any): bool := {
	if marked_kind(c) == 8 or kind_code(c) == 6 { return map_index(c, node_text(x)) > 0 }
	if kind_code(c) == 3 { return text_index(unboxed_text(c), node_text(x)) >= 0 }
	for item in unboxed_list(c) { if node_equal(item, x) { return yes } }
	no
}
# where the bytes of part first start in t, -1 when nowhere
text_index(t: text, part: text): int := {
	for start in 0..(byte_count(t) - byte_count(part) + 1) {
		i = 0
		while i < byte_count(part) and byte_at(t, start + i) == byte_at(part, i) { i += 1 }
		if i == byte_count(part) { return start }
	}
	-1
}
# `x[key]` of a value known only at run time: a list's item at an int key (counted from 0), else the map's entry
node_get(n: any, key: any): any := {
	if kind_code(key) == 1 { return node_at(n, unboxed_int(key) + 1) }
	map_get(n, node_text(key))
}
# `m.name = value`: a new entry in the old one's place, or at m's end; m itself, so every alias sees it; ø (`{}`)
# becomes a map of the one entry
field_with(m: any, name: text, value: any): any := {
	if is_null(m) == 1 { return map_of([new_key(name, value)]) }
	entries = unboxed_list(fields_of(m))
	at = map_index(m, name)
	if at == 0 { list_append(entries, [new_key(name, value)]) } else { entries#at = new_key(name, value) }
	m
}
# 1 for a boxed text or character, else 0
# `x == ø`: ø, and a list or map without items, as Rust's equality and print take them
is_nothing(n: any): bool := if is_null(n) == 1 then yes else kind_code(n) == 8 and #unboxed_list(n) == 0
textual_node(n: any): int := if is_null(n) == 0 and (kind_code(n) == 3 or kind_code(n) == 4) then 1 else 0
# the bytes of the code point whose UTF-8 starts with the byte lead
code_point_width(lead: int): int := if lead < 128 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4
# the code point whose UTF-8 bytes start at byte `at` of t
code_point_at(t: text, at: int): int := {
	lead = byte_at(t, at)
	n = if lead < 128 then lead else if lead < 224 then lead - 192 else if lead < 240 then lead - 224 else lead - 240
	for k in 1 to code_point_width(lead) - 1 { n = n * 64 + byte_at(t, at + k) - 128 }
	n
}
within(c: int, low: int, high: int): bool := c >= low and c <= high
# a code point that continues the character before it: combining marks, variation selectors, skin tones, ZWJ …
# (src/extensions/strings.rs GRAPHEME_EXTEND, the same table)
extends_character(c: int): bool := {
	if c < 768 { return no }
	if within(c, 768, 879) { return yes }
	if within(c, 1155, 1161) { return yes }
	if within(c, 1425, 1469) { return yes }
	if within(c, 1473, 1474) { return yes }
	if within(c, 1476, 1477) { return yes }
	if within(c, 1552, 1562) { return yes }
	if within(c, 1611, 1631) { return yes }
	if within(c, 1648, 1648) { return yes }
	if within(c, 1750, 1756) { return yes }
	if within(c, 2304, 2307) { return yes }
	if within(c, 2362, 2364) { return yes }
	if within(c, 2366, 2383) { return yes }
	if within(c, 2385, 2391) { return yes }
	if within(c, 2402, 2403) { return yes }
	if within(c, 3633, 3633) { return yes }
	if within(c, 3636, 3642) { return yes }
	if within(c, 3655, 3662) { return yes }
	if within(c, 6832, 6911) { return yes }
	if within(c, 7616, 7679) { return yes }
	if within(c, 8204, 8205) { return yes }
	if within(c, 8400, 8447) { return yes }
	if within(c, 12441, 12442) { return yes }
	if within(c, 65024, 65039) { return yes }
	if within(c, 65056, 65071) { return yes }
	if within(c, 127995, 127999) { return yes }
	if within(c, 917536, 917631) { return yes }
	within(c, 917760, 917999)
}
# after a ZWJ these join the character (emoji ZWJ sequences, GRAPHEME_PICTOGRAPHIC)
pictographic(c: int): bool := within(c, 9728, 10175) or within(c, 126976, 129791)
# a flag is a pair of these
regional_indicator(c: int): bool := within(c, 127462, 127487)
# the byte after the character (grapheme cluster) starting at byte `at` of t (src/extensions/strings.rs
# grapheme_clusters): controls stand alone but CR LF, a flag pairs two regional indicators
character_end(t: text, at: int): int := {
	previous = code_point_at(t, at)
	end = at + code_point_width(byte_at(t, at))
	if previous == 13 and end < byte_count(t) and byte_at(t, end) == 10 { return end + 1 }
	if previous < 32 or within(previous, 127, 159) { return end }
	unpaired = if regional_indicator(previous) then 1 else 0
	while end < byte_count(t) {
		next = code_point_at(t, end)
		if not (extends_character(next) or (previous == 8205 and pictographic(next)) or (unpaired == 1 and regional_indicator(next))) { return end }
		unpaired = 0
		previous = next
		end += code_point_width(byte_at(t, end))
	}
	end
}
# the character of t from byte `at` to end: a character value for one code point, else a text
character_between(t: text, at: int, end: int): any := {
	if end - at == code_point_width(byte_at(t, at)) { return char_of(code_point_at(t, at)) }
	bytes_between(t, at, end)
}
# the index-th character of t, counted from 1
text_char(t: text, index: int): any := {
	if walk_reaches(t, index) == 0 { swap_walks() }
	if walk_reaches(t, index) == 0 {
		walked_text = t
		walked_bytes = byte_count(t)
		walked_index = 1
		walked_at = 0
		walked_before = -1
	}
	if index < walked_index {
		walked_index -= 1
		walked_at = walked_before
		walked_before = -1
	}
	while walked_index < index {
		walked_before = walked_at
		walked_at = character_end(t, walked_at)
		walked_index += 1
	}
	character_between(t, walked_at, character_end(t, walked_at))
}
# 1 when the current walk is over t, or over the start of t that t grew from, and stands at index, before it or one
# past it
walk_reaches(t: text, index: int): int := {
	if same_text(t, walked_text) == 0 or byte_count(t) < walked_bytes or index < walked_index - 1 { return 0 }
	if index == walked_index - 1 and walked_before < 0 { return 0 }
	1
}
swap_walks(): int := {
	text = walked_text
	walked_text = other_text
	other_text = text
	bytes = walked_bytes
	walked_bytes = other_bytes
	other_bytes = bytes
	index = walked_index
	walked_index = other_index
	other_index = index
	at = walked_at
	walked_at = other_at
	other_at = at
	before = walked_before
	walked_before = other_before
	other_before = before
	0
}
list_join(a: list, b: list): list := {
	out = new_list(#a + #b)
	copy_items(out, 0, a, 0, #a)
	copy_items(out, #a, b, 0, #b)
	out
}
# `a += b`: b's items after a's in a itself, so every alias of a sees them; a full array is replaced by one twice
# as large, so appending one item at a time copies each item a bounded number of times
list_append(a: list, b: list): list := {
	start = #a
	added = #b
	if start + added > item_room(a) {
		grown = new_list(max_int(start + added, 2 * item_room(a)))
		copy_items(grown, 0, a, 0, start)
		adopt_items(a, grown)
	}
	copy_items(a, start, b, 0, added)
	set_count(a, start + added)
	a
}
# `n#i` of a value known only at run time, counted from 1: a list's item, a text's character
node_at(n: any, index: int): any := {
	if kind_code(n) == 8 { return unboxed_list(n)#index }
	if kind_code(n) == 3 { return text_char(unboxed_text(n), index) }
	fail()
}
# `#n` of a value known only at run time: a list's items, a text's characters, one of a character ("d" of a list)
node_length(n: any): int := {
	# ø, also an empty list `[]` in the lowered program, holds nothing
	if is_null(n) == 1 { return 0 }
	if kind_code(n) == 8 { return #unboxed_list(n) }
	if kind_code(n) == 3 { return text_count(unboxed_text(n)) }
	if kind_code(n) == 4 { return 1 }
	fail()
}
# `n#i = value` of a list known only at run time, in the list itself, so every alias sees it
node_set_at(n: any, index: int, value: any): any := {
	if kind_code(n) != 8 { fail() }
	items = unboxed_list(n)
	items#index = value
	value
}
# the characters from..to of t, counted from 1, both included: the bytes between their lead bytes
text_slice(t: text, from: int, to: int): text := {
	start = character_offset(t, from)
	bytes_between(t, start, character_offset(t, to + 1))
}
# the byte offset of t's index-th character, counted from 1; past the last, the byte count
character_offset(t: text, index: int): int := {
	at = 0
	for counted in 1..<index {
		if at < byte_count(t) { at += 1 }
		while at < byte_count(t) and byte_at(t, at) >= 128 and byte_at(t, at) < 192 { at += 1 }
	}
	at
}
# t starts with the bytes of start
text_starts_with(t: text, start: text): bool := byte_count(start) <= byte_count(t) and bytes_match_at(t, start, 0)
# t ends with the bytes of end
text_ends_with(t: text, end: text): bool := byte_count(end) <= byte_count(t) and bytes_match_at(t, end, byte_count(t) - byte_count(end))
# part's bytes stand in t from byte offset at on
bytes_match_at(t: text, part: text, at: int): bool := {
	for i in 0..byte_count(part) {
		if byte_at(t, at + i) != byte_at(part, i) { return no }
	}
	yes
}
# the character position of part's first place in t, counted from 1; 0 when t holds no part
text_find(t: text, part: text): int := {
	position = 1
	for at in 0 to byte_count(t) - byte_count(part) {
		if bytes_match_at(t, part, at) { return position }
		if byte_at(t, at) < 128 or byte_at(t, at) >= 192 { position += 1 }
	}
	0
}
# t without the spaces, tabs and line breaks at its two ends
text_trim(t: text): text := {
	start = 0
	while start < byte_count(t) and is_space_byte(byte_at(t, start)) { start += 1 }
	stop = byte_count(t)
	while stop > start and is_space_byte(byte_at(t, stop - 1)) { stop -= 1 }
	bytes_between(t, start, stop)
}
# the library words of lib/compiler on values known only at run time, as Rust's text and list words give them
# `slice(x, from, to)`: x's items (a text's characters) from..<to, counted from 0; to ø or beyond the end stops at the
# end, a negative from or to fails, as Rust's "index out of range"
node_slice(x: any, from: int, to: any): any := {
	stop = if is_null(to) == 1 then node_length(x) else unboxed_int(to)
	if from < 0 or stop < 0 { index_out_of_range() }
	if kind_code(x) == 3 { return character_slice(unboxed_text(x), from, stop) }
	if kind_code(x) == 8 { return items_slice(unboxed_list(x), from, stop) }
	not_a_list()
}
character_slice(t: text, from: int, to: int): text := {
	start = character_offset_of(t, from)
	stop = character_offset_of(t, to)
	if stop <= start { return "" }
	bytes_between(t, start, stop)
}
# the byte offset after t's first count characters (grapheme clusters); past the last, the byte count
character_offset_of(t: text, count: int): int := {
	at = 0
	for i in 0..<count { if at < byte_count(t) { at = character_end(t, at) } }
	at
}
items_slice(items: list, from: int, to: int): list := {
	count = min_int(to, #items) - from
	if count < 0 { count = 0 }
	out = new_list(count)
	copy_items(out, 0, items, from, count)
	out
}
# `starts_with(t, part)`, `ends_with(t, part)`: 1 when part's bytes begin or end t, else 0, as Rust's give an int
node_starts_with(t: any, part: any): int := if text_starts_with(text_of_textual(t), text_of_textual(part)) then 1 else 0
node_ends_with(t: any, part: any): int := if text_ends_with(text_of_textual(t), text_of_textual(part)) then 1 else 0
node_trim(t: any): text := text_trim(text_of_textual(t))
# a text or a character as its text; anything else fails
text_of_textual(n: any): text := {
	if textual_node(n) == 0 { not_a_text() }
	node_text(n)
}
# `map_get_or(m, key, fallback)`: the value of m's entry key, fallback when m has none
map_get_or(m: any, key: any, fallback: any): any := {
	if is_null(m) == 1 { return fallback }
	at = map_index(m, node_text(key))
	if at == 0 { return fallback }
	key_value(unboxed_list(fields_of(m))#at)
}
# a space, a tab, a line feed or a carriage return
is_space_byte(b: int): bool := b == 32 or b == 9 or b == 10 or b == 13
# the bytes start..<stop of t
bytes_between(t: text, start: int, stop: int): text := {
	out = new_text(stop - start)
	copy_text(out, 0, t, start, stop - start)
	out
}
# `xs.join(separator)`: the texts of xs's items with separator between them; texts and numbers only, as Rust joins
joined(xs: list, separator: any): text := {
	between = node_text(separator)
	out = ""
	count = 0
	for x in xs {
		if kind_code(x) == 8 { fail() }
		if count > 0 { out += between }
		out += node_text(x)
		count += 1
	}
	out
}
# `n times "ab"`: t n times over
repeated_text(n: int, t: any): text := {
	piece = node_text(t)
	out = new_text(n * byte_count(piece))
	for i in 0..<n { copy_text(out, i * byte_count(piece), piece, 0, byte_count(piece)) }
	out
}
# `int[n]`: a list of count zeros
zero_fill(count: int, filler: any): list := {
	out = new_list(count)
	for i in 1 to count { out#i = filler }
	out
}
# `t.split(separator)`: the texts between separator's places in t
split_text(t: text, separator: any): list := {
	between = node_text(separator)
	out = new_list(0)
	start = 0
	at = 0
	while at + byte_count(between) <= byte_count(t) {
		if byte_count(between) > 0 and bytes_match_at(t, between, at) {
			out += [bytes_between(t, start, at)]
			at += byte_count(between)
			start = at
		} else {
			at += 1
		}
	}
	out += [bytes_between(t, start, byte_count(t))]
	out
}
# `t.chars`: t's characters (grapheme clusters)
text_graphemes(t: text): list := {
	out = new_list(text_count(t))
	at = 0
	for i in 1 to #out {
		end = character_end(t, at)
		out#i = character_between(t, at, end)
		at = end
	}
	out
}
# `for each codepoint in t`: t's code points
text_chars(t: text): list := {
	out = new_list(code_point_count(t))
	at = 0
	for i in 1 to #out {
		out#i = char_of(code_point_at(t, at))
		at += code_point_width(byte_at(t, at))
	}
	out
}
# `xs.reverse`: a list's items or a text's characters the other way round
reversed(n: any): any := {
	if kind_code(n) == 4 { return char_text(unboxed_char(n)) }
	if kind_code(n) == 3 {
		t = unboxed_text(n)
		backwards = ""
		at = 0
		while at < byte_count(t) {
			end = character_end(t, at)
			backwards = bytes_between(t, at, end) + backwards
			at = end
		}
		return backwards
	}
	reversed_items(unboxed_list(n))
}
reversed_items(items: list): list := {
	turned = new_list(#items)
	for i in 1 to #items { turned#i = items#(#items + 1 - i) }
	turned
}
# `sum(xs)` as `list_sum(xs, loop)`: the loop the lowering wrote gives it
list_sum(xs: list, computed: any): any := computed
# `x is type` of a value known only at run time, type a name of emitter.warp's covered_kinds: Rust's run-time kind
# masks (src/lowering/types/type_tests.rs BUILTIN_TYPES): a bool has a mark of its own, ø is the empty list
node_is_type(n: any, type: text): bool := {
	if is_null(n) == 1 { return type == "list" }
	if marked_kind(n) == 257 { return type == "bool" }
	kind = kind_code(n)
	if type == "int" { return kind == 1 and is_ratio(n) == 0 }
	if type == "rational" or type == "number" { return kind == 1 or kind == 2 }
	if type == "float" { return kind == 2 }
	if type == "text" { return kind == 3 or kind == 4 }
	if type == "char" { return kind == 4 }
	if type == "list" { return kind == 8 or kind == 7 }
	if type == "key" { return kind == 6 }
	if type == "symbol" { return kind == 5 }
	no
}
# `x is Name` of a class: an instance is an entry keyed by its class's name
instance_of(n: any, name: text): bool := {
	if is_null(n) == 1 or kind_code(n) != 6 { return no }
	text_order(key_name(n), name) == 0
}
# `round(x)`: the nearest int, half to even as wasm rounds (f64.nearest)
rounded(x: float): int := truncated(float_nearest(x))
# the text of a run-time float (src/wasm_emitter/numbers/float_text.rs): its shortest digits that read back,
# positional from 1e-5 up to 1e15, else as 1.5e20 or 1e-7; ∞, -∞ and NaN as the exact numbers print them
float_text(x: float): text := {
	if x != x { return "NaN" }
	if x == float_of_bits(9218868437227405312) { return char_text("∞") }
	if x == -float_of_bits(9218868437227405312) { return "-∞" }
	if x == 0 { return char_text("0") }
	if x < 0 { return "-" + positive_float_text(-x) }
	positive_float_text(x)
}
positive_float_text(x: float): text := {
	found = float_digits(x)
	digits = int_text(unboxed_int(found#1))
	count = byte_count(digits)
	exponent = count - 1 - unboxed_int(found#2)
	if exponent >= 15 or exponent < -5 {
		rest = if count > 1 then "." + bytes_between(digits, 1, count) else ""
		return bytes_between(digits, 0, 1) + rest + "e" + int_text(exponent)
	}
	if exponent >= count - 1 { return digits + zeros(exponent - count + 1) }
	if exponent >= 0 { return bytes_between(digits, 0, exponent + 1) + "." + bytes_between(digits, exponent + 1, count) }
	"0." + zeros(-1 - exponent) + digits
}
# [digits, shift] of a positive float: its shortest digits, digits · 10^-shift reads back as x. x · 10^shift has 17
# digits, and the whole numbers between the halfways to its neighbours read back as x (the halfways too when x's last
# bit is even, as a reader rounds half to even); the multiple of the largest power of ten among them, nearest x
float_digits(x: float): list := {
	exponent = 0
	mantissa = x
	while mantissa >= 10 {
		mantissa = mantissa / 10
		exponent += 1
	}
	while mantissa < 1 {
		mantissa = mantissa * 10
		exponent -= 1
	}
	shift = 16 - exponent
	scaled = float_scaled(x, float(0), shift)
	while has_17_digits(scaled, 1e17) or not has_17_digits(scaled, 1e16) {
		shift += if has_17_digits(scaled, 1e17) then -1 else 1
		scaled = float_scaled(x, float(0), shift)
	}
	hi = unboxed_float(scaled#1)
	lo = unboxed_float(scaled#2)
	whole = truncated(hi) + truncated(float_floor(lo))
	fraction = lo - float_floor(lo)
	# the gaps to the neighbours; the largest float's upper one is its lower
	below = x - float_of_bits(bits_of_float(x) - 1)
	above = float_of_bits(bits_of_float(x) + 1) - x
	if above == float_of_bits(9218868437227405312) { above = below }
	# an odd last bit excludes a halfway that is whole
	odd = int_remainder(bits_of_float(x), 2)
	lowest = float_scaled(x, -below, shift)
	low_lo = unboxed_float(lowest#2)
	low = truncated(unboxed_float(lowest#1)) + truncated(float_ceil(low_lo))
	if odd == 1 and low_lo == float_ceil(low_lo) { low += 1 }
	highest = float_scaled(x, above, shift)
	high_lo = unboxed_float(highest#2)
	high = truncated(unboxed_float(highest#1)) + truncated(float_floor(high_lo))
	if odd == 1 and high_lo == float_floor(high_lo) { high -= 1 }
	# the largest power of ten with a multiple from low to high
	power = 10
	while int_quotient(low + power - 1, power) * power <= high { power = power * 10 }
	power = int_quotient(power, 10)
	# its multiple nearest x · 10^shift: the one below or the next, by twice the distance minus the power
	multiple = whole - int_remainder(whole, power)
	twice = (whole - multiple) * 2 - power + fraction * 2
	if twice > 0 or (twice == 0 and int_remainder(int_quotient(multiple, power), 2) == 1) { multiple += power }
	if multiple < low { multiple += power }
	if multiple > high { multiple -= power }
	while int_remainder(multiple, 10) == 0 {
		multiple = int_quotient(multiple, 10)
		shift -= 1
	}
	[multiple, shift]
}
# the double-double scaled reaches bound: hi beyond it, or at it with lo not below
has_17_digits(scaled: list, bound: float): bool := {
	hi = unboxed_float(scaled#1)
	hi > bound or (hi == bound and unboxed_float(scaled#2) >= 0)
}
# [hi, lo]: (x + gap/2) · 10^shift as the double-double hi + lo, by at most 10^22 a step (each power exact): a product's
# error is Dekker's exact product, a quotient's the remainder of its exact product. Exact in one step, within 2^-104 in
# more. A float beyond ±2^900 is moved by 2^∓128 first and back after, so no product overflows, no half underflows
float_scaled(x: float, gap: float, shift: int): list := {
	value = x
	scaled_gap = gap
	scale = float(1)
	if x >= float_of_bits(8660422083433463808) {
		value = x * float_of_bits(4030721666496593920)
		scaled_gap = scaled_gap * float_of_bits(4030721666496593920)
		scale = float_of_bits(5183643171103440896)
	}
	if x < float_of_bits(553942754166571008) {
		value = x * float_of_bits(5183643171103440896)
		scaled_gap = scaled_gap * float_of_bits(5183643171103440896)
		scale = float_of_bits(4030721666496593920)
	}
	hi = value
	lo = scaled_gap / 2
	left = shift
	while left != 0 {
		step = if left > 22 then 22 else if left < -22 then -22 else left
		power = float(1)
		count = step
		if step < 0 { count = -step }
		for k in 1 to count { power = power * 10 }
		if step > 0 {
			product = hi * power
			lo = product_error(hi, power, product) + lo * power
			hi = product
		} else {
			quotient = hi / power
			product = quotient * power
			lo = (hi - product - product_error(quotient, power, product) + lo) / power
			hi = quotient
		}
		# renormalized, so hi is the nearest float
		sum = hi + lo
		lo = lo - (sum - hi)
		hi = sum
		left -= step
	}
	[hi * scale, lo * scale]
}
# a · b - product exactly, a and b split in halves of 26 bits whose products are exact (Veltkamp, Dekker)
product_error(a: float, b: float, product: float): float := {
	a_hi = upper_half(a)
	a_lo = a - a_hi
	b_hi = upper_half(b)
	b_lo = b - b_hi
	a_hi * b_hi - product + a_hi * b_lo + a_lo * b_hi + a_lo * b_lo
}
# v's upper 26 bits: 2^27 + 1 times v, less its distance to v
upper_half(v: float): float := {
	t = v * 134217729
	t - (t - v)
}
# a boxed int (kind code 1), exact rational or float as a float
float_of_node(n: any): float := {
	if kind_code(n) != 1 { return unboxed_float(n) }
	float(exact_numerator(n)) / float(exact_denominator(n))
}
# a % b of floats as in mathematics, as the floats of Rust: the truncated remainder, plus |b| when below 0
float_mod(a: float, b: float): float := {
	if b == 0 { divide_by_zero() }
	q = a / b
	rest = a - b * (if q < 0 then float_ceil(q) else float_floor(q))
	if rest < 0 { return rest + (if b < 0 then -b else b) }
	rest
}
# a boxed number added to a number variable (`s += x`); a text or any other value traps, as Rust fails on it
number_node(n: any): any := {
	if is_null(n) == 1 or (kind_code(n) != 1 and kind_code(n) != 2) { fail() }
	n
}
# a boxed int where an int is needed; any other value traps, as Rust fails on it
int_of_node(n: any): int := {
	if is_null(n) == 1 or kind_code(n) != 1 or is_ratio(n) == 1 { fail() }
	unboxed_int(n)
}
# a node the analysis holds a list where a list is needed: ø is the empty list (`xs = ø; xs += [x]`); any other value
# traps
list_of_node(n: any): list := {
	if is_null(n) == 1 { return new_list(0) }
	if kind_code(n) != 8 { fail() }
	unboxed_list(n)
}
# a node the analysis holds a text where a text is needed: a text, or a character as its text; any other value traps
text_of_node(n: any): text := {
	if is_null(n) == 1 { fail() }
	if kind_code(n) == 4 { return char_text(unboxed_char(n)) }
	if kind_code(n) != 3 { fail() }
	unboxed_text(n)
}
# `n as int` of a boxed int or exact rational, truncated toward 0
truncated_int(n: any): int := {
	if is_null(n) == 1 or kind_code(n) != 1 { fail() }
	int_quotient(exact_numerator(n), exact_denominator(n))
}
# the decimal digits of n, the last first; truncating division keeps the smallest int's digits in reach
int_text(n: int): text := {
	sign = if n < 0 then 1 else 0
	digits = 1
	left = n
	while int_quotient(left, 10) != 0 {
		left = int_quotient(left, 10)
		digits += 1
	}
	out = new_text(sign + digits)
	if n < 0 { set_byte(out, 0, 45) }
	left = n
	for i in sign + digits - 1 down to sign {
		digit = int_remainder(left, 10)
		if digit < 0 { digit = -digit }
		set_byte(out, i, 48 + digit)
		left = int_quotient(left, 10)
	}
	out
}
# a character's UTF-8 bytes: 6 bits in each continuation byte 10xxxxxx, the rest in the lead byte
char_text(c: char): text := {
	n = code_of(c)
	count = if n < 128 then 1 else if n < 2048 then 2 else if n < 65536 then 3 else 4
	out = new_text(count)
	for i in count - 1 down to 1 {
		set_byte(out, i, 128 + int_remainder(n, 64))
		n = int_quotient(n, 64)
	}
	lead = if count == 1 then 0 else if count == 2 then 192 else if count == 3 then 224 else 240
	set_byte(out, 0, lead + n)
	out
}

## exact rationals: int `/` gives one, an int over a positive int in lowest terms (the Rust twin's Number::Quotient),
## held in an Int $Node as a $Ratio (intrinsics is_ratio, ratio_of, ratio_numerator, ratio_denominator)
int_gcd(a: int, b: int): int := {
	if a < 0 { a = -a }
	if b < 0 { b = -b }
	while b != 0 {
		rest = int_remainder(a, b)
		a = b
		b = rest
	}
	a
}
# n/d in lowest terms, an int when d divides n; d 0 traps, as Rust's divide by zero fails
exact_ratio(n: int, d: int): any := {
	if d == 0 { divide_by_zero() }
	divisor = int_gcd(n, d)
	if d < 0 { divisor = -divisor }
	n = int_quotient(n, divisor)
	d = int_quotient(d, divisor)
	if d == 1 { return n }
	ratio_of(n, d)
}
# the numerator and denominator of an Int $Node, an int its own numerator over 1
exact_numerator(n: any): int := if is_ratio(n) == 1 then ratio_numerator(n) else unboxed_int(n)
exact_denominator(n: any): int := if is_ratio(n) == 1 then ratio_denominator(n) else 1
exact_add(a: any, b: any): any := exact_ratio(exact_numerator(a) * exact_denominator(b) + exact_numerator(b) * exact_denominator(a), exact_denominator(a) * exact_denominator(b))
exact_sub(a: any, b: any): any := exact_ratio(exact_numerator(a) * exact_denominator(b) - exact_numerator(b) * exact_denominator(a), exact_denominator(a) * exact_denominator(b))
exact_mul(a: any, b: any): any := exact_ratio(exact_numerator(a) * exact_numerator(b), exact_denominator(a) * exact_denominator(b))
exact_div(a: any, b: any): any := exact_ratio(exact_numerator(a) * exact_denominator(b), exact_denominator(a) * exact_numerator(b))
# -1, 0 or 1 as a is below, equal to or above b (denominators are positive)
exact_order(a: any, b: any): int := {
	left = exact_numerator(a) * exact_denominator(b)
	right = exact_numerator(b) * exact_denominator(a)
	if left < right then -1 else if left > right then 1 else 0
}
# an exact rational as Rust shows it: a terminating one (its denominator 2^a·5^b) as decimal digits, 7/2 as 3.5,
# any other as n/d
exact_text(n: any): text := {
	if is_ratio(n) == 0 { return int_text(unboxed_int(n)) }
	numerator = ratio_numerator(n)
	denominator = ratio_denominator(n)
	twos = factor_count(denominator, 2)
	fives = factor_count(denominator, 5)
	if denominator != int_pow(2, twos) * int_pow(5, fives) { return int_text(numerator) + "/" + int_text(denominator) }
	digits = max_int(twos, fives)
	# numerator · 10^digits / denominator without the product beyond 64 bits: the denominator's missing twos and fives
	scaled = numerator * power(2, digits - twos) * power(5, digits - fives)
	magnitude = int_text(if scaled < 0 then -scaled else scaled)
	padded = zeros(digits + 1 - byte_count(magnitude)) + magnitude
	whole = byte_count(padded) - digits
	out = new_text(byte_count(padded) + 1)
	copy_text(out, 0, padded, 0, whole)
	set_byte(out, whole, 46)
	copy_text(out, whole + 1, padded, whole, digits)
	if numerator < 0 { return "-" + out }
	out
}
# how often factor divides n
factor_count(n: int, factor: int): int := {
	count = 0
	while n != 0 and int_remainder(n, factor) == 0 {
		n = int_quotient(n, factor)
		count += 1
	}
	count
}
power(base: int, exponent: int): int := {
	out = 1
	for i in 0..exponent { out = out * base }
	out
}
# `x as rational` of a run-time float (decision float-as-rational; Rust twin float_as_exact in
# src/wasm_emitter/numbers/float_text.rs): the exact value of its shortest digits, 1.4142135623730951 as
# 14142135623730951/10^16; ∞ and NaN have no fraction
float_as_exact(x: float): any := {
	# x - x is 0 for every finite x, NaN for ∞ and NaN
	if x - x != 0 { not_a_finite_number() }
	if x == 0 { return exact_ratio(0, 1) }
	sign = if x < 0 then -1 else 1
	# `then -x else` reads as a subtraction from then
	magnitude = if x < 0 then 0 - x else x
	found = float_digits(magnitude)
	digits = unboxed_int(found#1)
	shift = unboxed_int(found#2)
	if shift <= 0 { return exact_ratio(sign * multiplied_within_64_bits(digits, 10, -shift), 1) }
	# digits / (2^shift · 5^shift), the common factors taken out first so the denominator fits where it can
	twos = shift
	fives = shift
	while twos > 0 and int_remainder(digits, 2) == 0 {
		digits = int_quotient(digits, 2)
		twos -= 1
	}
	while fives > 0 and int_remainder(digits, 5) == 0 {
		digits = int_quotient(digits, 5)
		fives -= 1
	}
	exact_ratio(sign * digits, multiplied_within_64_bits(multiplied_within_64_bits(1, 5, fives), 2, twos))
}
# n · factor^times of n ≥ 0; beyond 64 bits it fails as an int64 overflow (Rust's twin goes on in big ints)
multiplied_within_64_bits(n: int, factor: int, times: int): int := {
	for i in 0..times {
		if n > int_quotient(9223372036854775807, factor) { overflow_of_int64() }
		n = n * factor
	}
	n
}
max_int(a: int, b: int): int := if a > b then a else b
# a text of count zero digits
zeros(count: int): text := {
	out = new_text(if count > 0 then count else 0)
	for i in 0..count { set_byte(out, i, 48) }
	out
}
# `a /! b`: the Euclidean quotient that goes with `%`, a = q * b + r with 0 <= r < |b|: -7 /! 2 is -4
floor_quotient(a: int, b: int): int := {
	q = int_quotient(a, b)
	if a - q * b < 0 {
		if b > 0 { q -= 1 } else { q += 1 }
	}
	q
}
# `base ^ exponent` of exact numbers (src/wasm_emitter/numbers/exact.rs exact_pow): an int exponent only, a negative one
# inverts the base first: 2^-2 is 1/4, (2/3)^2 is 4/9; a rational exponent fails here, which traps.rs names
exact_pow(base: any, exponent: any): any := {
	if is_ratio(exponent) == 1 { fail() }
	times = unboxed_int(exponent)
	if times < 0 {
		base = exact_ratio(exact_denominator(base), exact_numerator(base))
		times = -times
	}
	if is_ratio(base) == 0 { return int_pow(unboxed_int(base), times) }
	# a ratio in lowest terms stays in lowest terms raised to any power
	ratio_of(int_pow(ratio_numerator(base), times), int_pow(ratio_denominator(base), times))
}
# base ^ exponent by squaring, exponent at least 0 (src/wasm_emitter/numbers/big_int/slow_paths.rs int_pow); a product
# beyond the int range fails in int_overflow, where Rust's turns into a big int
int_pow(base: int, exponent: int): int := {
	if exponent < 0 { fail() }
	result = 1
	while exponent > 0 {
		if int_remainder(exponent, 2) == 1 { result = checked_product(result, base) }
		exponent = int_quotient(exponent, 2)
		if exponent > 0 { base = checked_product(base, base) }
	}
	result
}
# a * b, failing in int_overflow when the product leaves the int range
checked_product(a: int, b: int): int := {
	product = a * b
	# -1 · smallest leaves the range, and its quotient check would trap itself
	overflowed = if a == -1 then b == least_int() else a != 0 and int_quotient(product, a) != b
	if overflowed { int_overflow() }
	product
}
least_int(): int := -9223372036854775807 - 1

## exact rounding: Rust's exact_floor … exact_div_assign (src/wasm_emitter/numbers/exact.rs) as words over an Int
## $Node's numerator and denominator; a $Ratio n/0 is ±∞ by n's sign and 0/0 is NaN, as Rust reads them
# -1 for -∞, 1 for ∞, 0 for a finite x and for NaN
exact_infinity_rank(x: any): int := if exact_denominator(x) == 0 then exact_numerator(x) else 0
exact_is_nan(x: any): bool := exact_numerator(x) == 0 and exact_denominator(x) == 0
int_order(a: int, b: int): int := if a < b then -1 else if a > b then 1 else 0
# -1, 0 or 1 as a is below, equal to or above b; 2 (unequal) when exactly one of them is NaN
exact_cmp(a: any, b: any): int := {
	if exact_is_nan(a) or exact_is_nan(b) { return if exact_is_nan(a) and exact_is_nan(b) then 0 else 2 }
	if exact_denominator(a) == 0 or exact_denominator(b) == 0 { return int_order(exact_infinity_rank(a), exact_infinity_rank(b)) }
	exact_order(a, b)
}
exact_neg(x: any): any := exact_ratio(-exact_numerator(x), exact_denominator(x))
exact_abs(x: any): any := {
	if exact_numerator(x) < 0 { return exact_neg(x) }
	x
}
# the integer part, rounded toward 0
exact_trunc(x: any): any := {
	if is_ratio(x) == 0 { return x }
	int_quotient(ratio_numerator(x), ratio_denominator(x))
}
# a - b * trunc(a / b), the sign of a as i64.rem_s
exact_rem(a: any, b: any): any := exact_sub(a, exact_mul(b, exact_trunc(exact_div(a, b))))
# the Euclidean remainder, 0 <= r < |b|: the truncated one plus |b| when negative
exact_mod(a: any, b: any): any := {
	rest = exact_rem(a, b)
	if exact_numerator(rest) < 0 { return exact_add(rest, exact_abs(b)) }
	rest
}
# the largest integer <= x, exact beyond the float range: a negative ratio truncates up, so one less
exact_floor(x: any): any := {
	if is_ratio(x) == 0 { return x }
	whole = exact_trunc(x)
	if ratio_numerator(x) < 0 { return exact_sub(whole, 1) }
	whole
}
# the quotient of a // b that goes with a % b: floor(a / b) for b > 0, -floor(-a / b) for b < 0
exact_euclid_div(a: any, b: any): any := {
	if exact_numerator(b) < 0 { return exact_neg(exact_floor(exact_neg(exact_div(a, b)))) }
	exact_floor(exact_div(a, b))
}
# x /= y: an int x stays an int, the Euclidean quotient (x - x % y) / y; a ratio x divides exactly
exact_div_assign(x: any, y: any): any := {
	if is_ratio(x) == 1 { return exact_div(x, y) }
	exact_div(exact_sub(x, exact_mod(x, y)), y)
}
# `floor x` of a boxed number: exact for an int or ratio, a float's floor as an int
floored_node(n: any): any := {
	if kind_code(n) != 1 { return truncated(float_floor(unboxed_float(n))) }
	exact_floor(n)
}

## runtime errors: each fails inside a function of its name, which src/wasm_emitter/control/traps.rs reads off the
## trace as the error's message; the global trap_detail holds the value the message names
divide_by_zero(): int := {
	fail()
	0
}
# `xs#i` outside 1…count: "index out of range: i not in 1…count"
# the runtime errors of the library words, named for src/wasm_emitter/control/traps.rs to read off the trace
index_out_of_range(): int := {
	fail()
	0
}
not_a_list(): int := {
	fail()
	0
}
not_a_text(): int := {
	fail()
	0
}
index_out_of_range_of(index: int, count: int): int := {
	global trap_detail = held([index, count])
	fail()
	0
}
# `xs#i` of an i known only at run time: an int, else "index must be an integer"
index_of_node(n: any): int := {
	if is_null(n) == 1 or kind_code(n) != 1 or is_ratio(n) == 1 { index_must_be_an_integer() }
	unboxed_int(n)
}
# a product beyond the int range (Rust's would be a big int)
int_overflow() := {
	fail()
	0
}
index_must_be_an_integer(): int := {
	fail()
	0
}
# `x as rational` of ∞ or NaN: "not a finite number"
not_a_finite_number() := {
	fail()
	0
}
# an int result beyond 64 bits where the runtime has no big ints: "int64 overflow" (src/numbers/fixed_width.rs)
overflow_of_int64() := {
	fail()
	0
}
# a closure call of a value that is no closure, or of a closure of another arity
not_a_function() := {
	fail()
	0
}
wrong_number_of_arguments() := {
	fail()
	0
}
# a value as a boxed $Node
held(value: any): any := value
# the built-in node's parts (lib/compiler/node.warp): a key's operator is its code above the kind bits, the
# position of its spelling here (src/operators/codes.rs OP_CODES)
operator_spellings(): list := ["", ":", "=", ":=", ".", "?.", "::", "->", "+", "-", "*", "/", "%", "rem", "^", "<<", ">>", "+=", "-=",
	"*=", "/=", "%=", "^=", "&&=", "||=", "^^=", "<", ">", "<=", ">=", "==", "!=", "≈", "and", "or", "xor", "not", "-", "√", "∛",
	"‖", "++", "--", "?", "if", "then", "else", "while", "do", "#", "..", "to", "as", "±", "??", "===", "!==", "~", "⌞", "⌟", "&",
	"|", "↑", "↓", "/!", "/!="]
operator_code(spelled: text): int := {
	spellings = operator_spellings()
	for i in 1 to #spellings { if text_order(node_text(spellings#i), spelled) == 0 { return i - 1 } }
	0
}
key_node(left: any, operator: any, right: any): any := keyed(operator_code(node_text(operator)) * 256 + 6, left, right)
key_left(n: any): any := entry_key(n)
key_right(n: any): any := key_value(n)
key_operator(n: any): text := node_text(operator_spellings()#(int_quotient(marked_kind(n), 256) + 1))
symbol_node(name: any): any := symbol_of(node_text(name))

## durations (card duration-warp; src/wasm_emitter/time times.rs duration_text, time_arithmetic.rs duration_order): a
## time node of the duration form keeps its months and days in its kind word, above the kind's 8 and the form's 3
## bits (src/time/mod.rs MONTHS_SHIFT), its nanoseconds in its box. The words below the unpacking ones take the three
## amounts, so they read as calendar.rs Duration does (tests/numbers/test_duration_words.rs)
# a constant of the durations: an untyped word, as `f(): int :=` has no use yet
second_nanos() := 1000000000
day_nanos() := 86400 * second_nanos()
hour_nanos() := 3600 * second_nanos()
duration_months(n: any): int := floor_quotient(marked_kind(n), power(2, 43))
# the 32 signed bits above the kind and the form
duration_days(n: any): int := {
	days = floor_quotient(marked_kind(n), power(2, 11)) % power(2, 32)
	if days >= power(2, 31) then days - power(2, 32) else days
}
duration_nanos(n: any): int := unboxed_int(n)
# `3 hours`: an amount and its unit, plural unless the amount is 1
amount_text(amount: int, unit: text): text := {
	if amount == 1 { return int_text(amount) + " " + unit }
	int_text(amount) + " " + unit + "s"
}
# shown and the part after a space, the part alone when nothing is shown yet
spaced(shown: text, part: text): text := if byte_count(shown) == 0 then part else shown + " " + part
# shown and the amount of the unit, unchanged for a zero amount
with_amount(shown: text, amount: int, unit: text): text := if amount == 0 then shown else spaced(shown, amount_text(amount, unit))
# `1.5`, `-0.000000001`, `0`: nanoseconds as seconds with their fraction, without trailing zeros
seconds_text(nanos: int): text := {
	magnitude = if nanos < 0 then 0 - nanos else nanos
	whole = int_text(int_quotient(magnitude, second_nanos()))
	fraction = int_remainder(magnitude, second_nanos())
	digits = 9
	while fraction != 0 and int_remainder(fraction, 10) == 0 {
		fraction = int_quotient(fraction, 10)
		digits -= 1
	}
	shown = whole
	if fraction != 0 { shown = whole + "." + zeros(digits - byte_count(int_text(fraction))) + int_text(fraction) }
	if nanos < 0 { return "-" + shown }
	shown
}
# a duration as calendar.rs `Display for Duration` shows it: `1 month 2 days 3 hours`, `1.5 seconds`, `0 seconds`
duration_parts_text(months: int, days: int, nanos: int): text := {
	shown = with_amount(with_amount("", months, "month"), days, "day")
	# whole seconds read as hours, minutes and seconds: `3 hours`, not `10800 seconds`
	if nanos != 0 and int_remainder(nanos, second_nanos()) == 0 {
		seconds = int_quotient(nanos, second_nanos())
		shown = with_amount(shown, int_quotient(seconds, 3600), "hour")
		shown = with_amount(shown, int_quotient(int_remainder(seconds, 3600), 60), "minute")
		return with_amount(shown, int_remainder(seconds, 60), "second")
	}
	if nanos == 0 and byte_count(shown) > 0 { return shown }
	spaced(shown, seconds_text(nanos) + " seconds")
}
sign_of(n: int): int := if n > 0 then 1 else if n < 0 then -1 else 0
duration_text(n: any): text := duration_parts_text(duration_months(n), duration_days(n), duration_nanos(n))
# -1, 0 or 1 as the difference of two durations is shorter, none or longer on every date (calendar.rs
# Duration::compares); an order that depends on the date fails
duration_parts_order(months: int, days: int, nanos: int): int := {
	# an exact difference: the sign of its nanoseconds
	if months == 0 and days == 0 { return sign_of(nanos) }
	# a month is 28 to 31 days; negative months take more days off the longer they are
	fewest_days = days + months * (if months < 0 then 31 else 28)
	most_days = days + months * (if months < 0 then 28 else 31)
	# daylight saving moves an exact part against the calendar part by at most an hour; calendar parts alone keep the hour
	shift = if nanos != 0 then hour_nanos() else 0
	if fewest_days * day_nanos() + nanos - shift > 0 { return 1 }
	if most_days * day_nanos() + nanos + shift < 0 { return -1 }
	durations_compare_differently_on_different_dates()
}
duration_order(a: any, b: any): int := duration_parts_order(duration_months(a) - duration_months(b), duration_days(a) - duration_days(b), duration_nanos(a) - duration_nanos(b))
# the runtime error of duration_parts_order, named for src/wasm_emitter/control/traps.rs to read off the trace
durations_compare_differently_on_different_dates() := {
	fail()
	0
}

## times (card time-primitives; Rust twin: src/wasm_emitter/time): a time node of a form (src/time/mod.rs TimeForm:
## instant 0, date 1, local time 2, duration 3, zoned time 4, time of day 5) and a position, read by the intrinsics
## time_form, time_position, duration_months, duration_days, zone_index, zone_offset and made by time_of(info, position)
is_time(n: any): bool := is_null(n) == 0 and kind_code(n) == 18
is_instant(t: any): bool := time_form(t) == 0
is_date(t: any): bool := time_form(t) == 1
is_local_time(t: any): bool := time_form(t) == 2
is_duration(t: any): bool := time_form(t) == 3
is_zoned(t: any): bool := time_form(t) == 4
is_time_of_day(t: any): bool := time_form(t) == 5
# the duration of months, days and nanoseconds: its days kept as 32 unsigned bits above the form, its months above them
duration_of(months: int, days: int, nanos: int): any := {
	unsigned_days = if days < 0 then days + 4294967296 else days
	time_of(3 + unsigned_days * 8 + months * 34359738368, nanos)
}
# the wall clock of an instant in the environment's time zone, in seconds east of UTC (the host word local_offset)
local_offset_at(t: any): int := local_offset(floor_quotient(time_position(t), 1000000))

## times (card time-text-warp; src/wasm_emitter/time/times.rs emit_time_text and emit_fraction, calendar.rs): a $Node
## of kind 18, its form in the info bits (src/time/mod.rs TimeForm), its position in an $i64box: days since 1970 for a
## date, nanoseconds since 1970 for an instant and a local time, since midnight for a time of day
instant_form() := 0
date_form() := 1
duration_form() := 3
zoned_form() := 4
clock_form() := 5
time_form(n: any): int := int_remainder(int_quotient(marked_kind(n), 256), 8)
# RFC 3339 as calendar.rs shows a time, `2026-10-10T14:43:33.682Z`: a date has no clock, a time of day no date, a
# local time no Z. A duration (card duration-warp) and a zoned time (its zone names) are still Rust's: they trap
time_text(n: any): text := {
	form = time_form(n)
	if form == duration_form() or form == zoned_form() { time_form_not_in_warp() }
	position = unboxed_int(n)
	if form == date_form() { return date_text(position) }
	days = floor_quotient(position, day_nanos())
	clock = clock_text(position - days * day_nanos(), form)
	if form == clock_form() { return clock }
	zone = if form == instant_form() then "Z" else ""
	date_text(days) + "T" + clock + zone
}
# Howard Hinnant's civil_from_days as `2026-10-10`, the proleptic Gregorian date of a day number
date_text(days: int): text := {
	z = days + 719468
	era = floor_quotient(z, 146097)
	day_of_era = z - era * 146097
	year_of_era = int_quotient(day_of_era - int_quotient(day_of_era, 1460) + int_quotient(day_of_era, 36524) - int_quotient(day_of_era, 146096), 365)
	day_of_year = day_of_era - (365 * year_of_era + int_quotient(year_of_era, 4) - int_quotient(year_of_era, 100))
	shifted_month = int_quotient(5 * day_of_year + 2, 153)
	day = day_of_year - int_quotient(153 * shifted_month + 2, 5) + 1
	month = if shifted_month < 10 then shifted_month + 3 else shifted_month - 9
	year = year_of_era + era * 400
	if month <= 2 { year += 1 }
	padded(year, 4) + "-" + padded(month, 2) + "-" + padded(day, 2)
}
# `14:43:33.682` of the nanoseconds of a day: the seconds only when there are any or it is a time of day (22:27:46)
clock_text(nanos: int, form: int): text := {
	hours = int_quotient(nanos, 3600 * second_nanos())
	minutes = int_remainder(int_quotient(nanos, 60 * second_nanos()), 60)
	seconds = int_remainder(int_quotient(nanos, second_nanos()), 60)
	fraction = int_remainder(nanos, second_nanos())
	out = padded(hours, 2) + ":" + padded(minutes, 2)
	if seconds != 0 or fraction != 0 or form == clock_form() { out = out + ":" + padded(seconds, 2) }
	out + fraction_text(fraction)
}
# `.5` of the nanoseconds below a second, without trailing zeros; "" for none
fraction_text(fraction: int): text := {
	if fraction == 0 { return "" }
	digits = padded(fraction, 9)
	stop = 9
	while byte_at(digits, stop - 1) == 48 { stop -= 1 }
	"." + bytes_between(digits, 0, stop)
}
# n with leading zeros to count digits
padded(n: int, count: int): text := zeros(count - byte_count(int_text(n))) + int_text(n)
# a duration or a zoned time in time_text: "time form not in warp"
time_form_not_in_warp() := {
	fail()
	0
}
## ordering: node_order and the sort words (Rust's src/wasm_emitter/reflection/library_ops/ordering.rs)
# -1, 0 or 1 as a sorts before, with or after b: texts and characters by their bytes, ints and exact rationals exactly,
# a float on either side as floats; anything else traps, as Rust's not_comparable (instances and times stay Rust's)
node_order(a: any, b: any): int := {
	if textual_node(a) == 1 and textual_node(b) == 1 { return text_order(node_text(a), node_text(b)) }
	if numeric_node(a) == 0 or numeric_node(b) == 0 { fail() }
	if kind_code(a) == 1 and kind_code(b) == 1 { return exact_order(a, b) }
	float_order(float_of_node(a), float_of_node(b))
}
# 1 for a boxed int, exact rational or float, else 0
numeric_node(n: any): int := if kind_code(n) == 1 or kind_code(n) == 2 then 1 else 0
# -1, 0 or 1 as x is below, equal to or above y; NaN equals everything, as f64.gt - f64.lt gives
float_order(x: float, y: float): int := if x < y then -1 else if x > y then 1 else 0
# `sort xs`, `sorted "hello"`: a new list of xs's items (a new text of its characters) in ascending order
sorted_node(xs: any): any := {
	if is_null(xs) == 1 { return xs }
	sorted_like(xs, sortable_items(xs))
}
# `xs.sort_by(p => p.k)` as `list_sorted_by(xs, keys)` (src/lowering/lambdas.rs): xs's items ordered by their keys,
# the items themselves where keys is ø or ends early
sorted_node_by(xs: any, keys: any): any := {
	if is_null(keys) == 1 { return sorted_node(xs) }
	if is_null(xs) == 1 { return xs }
	sorted_like(xs, unboxed_list(keys))
}
# xs's items ordered by keys, as a text again when xs is one
sorted_like(xs: any, keys: list): any := {
	items = sortable_items(xs)
	sorted = sorted_items(items, sort_ranks(items, keys))
	if kind_code(xs) == 3 { return characters_text(sorted) }
	sorted
}
# a list's items, a text's characters
sortable_items(xs: any): list := if kind_code(xs) == 3 then text_graphemes(unboxed_text(xs)) else unboxed_list(xs)
# the characters of chars joined into one text
characters_text(chars: list): text := {
	out = ""
	for i in 1 to #chars { out += node_text(chars#i) }
	out
}
# what each item sorts by: its key as far as keys go, the item itself after
sort_ranks(items: list, keys: list): list := {
	ranks = new_list(#items)
	copy_items(ranks, 0, items, 0, #items)
	copy_items(ranks, 0, keys, 0, min_int(#keys, #items))
	ranks
}
# a new list of items in the order of their ranks, equal ranks in their old order: a bottom-up merge sort, without
# recursion, whose runs of width merge pairwise into the spare lists, which then take their place. Items in order
# already (ascending as they are, strictly descending reversed, so equal ranks keep their order) take n - 1
# comparisons and no merging
sorted_items(items: list, ranks: list): list := {
	count = #items
	cells = new_list(count)
	copy_items(cells, 0, items, 0, count)
	order = run_order(ranks)
	if order == 1 { return cells }
	if order == -1 { return reversed_items(cells) }
	cells_to = new_list(count)
	ranks_to = new_list(count)
	width = 1
	while width < count {
		low = 1
		while low <= count {
			middle = min_int(low + width, count + 1)
			high = min_int(middle + width, count + 1)
			merge_runs(cells, ranks, cells_to, ranks_to, low, middle, high)
			low = high
		}
		spare = cells
		cells = cells_to
		cells_to = spare
		spare = ranks
		ranks = ranks_to
		ranks_to = spare
		width = 2 * width
	}
	cells
}
# 1 when no rank is below the one before (sorted already), -1 when each one is (strictly descending), else 0
run_order(ranks: list): int := {
	if #ranks < 2 { return 1 }
	ascending = 1
	descending = 1
	for i in 2 to #ranks {
		if node_order(ranks#i, ranks#(i - 1)) < 0 { ascending = 0 } else { descending = 0 }
		if ascending == 0 and descending == 0 { return 0 }
	}
	if ascending == 1 then 1 else -1
}
# the runs low..<middle and middle..<high of cells and ranks, counted from 1, merged into the same places of cells_to
# and ranks_to
merge_runs(cells: list, ranks: list, cells_to: list, ranks_to: list, low: int, middle: int, high: int): list := {
	left = low
	right = middle
	for index in low..high {
		from = right
		if takes_left(ranks, left, middle, right, high) == 1 {
			from = left
			left += 1
		} else {
			right += 1
		}
		cells_to#index = cells#from
		ranks_to#index = ranks#from
	}
	cells_to
}
# 1 when the merge takes the left run's next item: the right run is done, or its next rank is not below the left's
# (of equal ranks the left one first, which keeps the sort stable); 0 when the left run is done
takes_left(ranks: list, left: int, middle: int, right: int, high: int): int := {
	if left >= middle { return 0 }
	if right >= high { return 1 }
	if node_order(ranks#right, ranks#left) < 0 then 0 else 1
}
min_int(a: int, b: int): int := if a < b then a else b

## texts as numbers at run time (card card-4; Rust's text_as_int and text_as_float in
## src/wasm_emitter/lists/list_ops/node_arithmetic.rs, text_as_number in src/wasm_emitter/numbers/casts.rs): a text
## that spells no number traps, where Rust's fails with invalid_number
# 1 for a leading - or + of t, else 0: the byte offset of what follows the sign
sign_length(t: text): int := if byte_count(t) > 0 and (byte_at(t, 0) == 45 or byte_at(t, 0) == 43) then 1 else 0
# t starts with -
is_negative_text(t: text): bool := byte_count(t) > 0 and byte_at(t, 0) == 45
# the digit a byte spells, -1 for any other byte
digit_of(b: int): int := if b >= 48 and b <= 57 then b - 48 else -1
# how many digits stand in t from byte offset start on
digit_run(t: text, start: int): int := {
	at = start
	while at < byte_count(t) and digit_of(byte_at(t, at)) >= 0 { at += 1 }
	at - start
}
# `t as int`: an optional sign and decimal digits, nothing else; 64 bits, where Rust's grows a big int
text_as_int(t: text): int := {
	start = sign_length(t)
	count = digit_run(t, start)
	if count == 0 or start + count != byte_count(t) { fail() }
	value = 0
	for i in start..byte_count(t) { value = value * 10 + digit_of(byte_at(t, i)) }
	if is_negative_text(t) then -value else value
}
# `t as float`: a sign, digits with an optional point among them, an optional exponent (e or E, a sign, digits): the
# nearest float, correctly rounded also beyond 10^±22, where Rust's multiplies ten by ten
text_as_float(t: text): float := {
	start = sign_length(t)
	whole = digit_run(t, start)
	at = start + whole
	fraction = 0
	if at < byte_count(t) and byte_at(t, at) == 46 {
		fraction = digit_run(t, at + 1)
		at += 1 + fraction
	}
	if whole + fraction == 0 { fail() }
	stop = at
	exponent = 0
	if at < byte_count(t) and (byte_at(t, at) == 101 or byte_at(t, at) == 69) {
		exponent = text_as_int(bytes_between(t, at + 1, byte_count(t)))
		at = byte_count(t)
	}
	if at != byte_count(t) { fail() }
	found = decimal_digits(t, start, stop)
	magnitude = decimal_float(unboxed_int(found#1), unboxed_int(found#2) + exponent - fraction)
	if is_negative_text(t) then -magnitude else magnitude
}
# [digits, dropped] of the digits between the byte offsets start and stop (a point among them skipped): the first 18
# significant ones as an int (below 10^18, so below 2^63), the count of those dropped after them
decimal_digits(t: text, start: int, stop: int): list := {
	digits = 0
	count = 0
	dropped = 0
	for i in start..stop {
		d = digit_of(byte_at(t, i))
		if d >= 0 and count < 18 {
			digits = digits * 10 + d
			if digits > 0 { count += 1 }
		} else if d >= 0 {
			dropped += 1
		}
	}
	[digits, dropped]
}
# digits · 10^shift as the nearest float: digits as the double-double hi + lo (exact), scaled by float_scaled (one
# exact power of ten up to 10^22: one rounding, as Clinger's fast path; beyond, within 2^-104 before the last
# rounding). float_scaled's steps overflow near 2^1024, so a result beyond 10^290 is scaled to 10^20 below and
# multiplied back (a second rounding there), one below 10^-290 to 10^20 above and divided back
decimal_float(digits: int, shift: int): float := {
	if digits == 0 { return float(0) }
	magnitude = byte_count(int_text(digits)) - 1 + shift
	if magnitude > 308 { return float_of_bits(9218868437227405312) }
	if magnitude < -325 { return float(0) }
	hi = float(digits)
	gap = float(digits - truncated(hi)) * 2
	back = if magnitude > 290 then 20 else if magnitude < -290 then -20 else 0
	scaled = unboxed_float(float_scaled(hi, gap, shift - back)#1)
	if back > 0 { return scaled * power_of_ten(back) }
	if back < 0 { return scaled / power_of_ten(-back) }
	scaled
}
# 10^n of an n from 0 to 22, exact
power_of_ten(n: int): float := {
	power = float(1)
	left = n
	while left > 0 {
		power = power * 10
		left -= 1
	}
	power
}
# `t as number`: "1/3" the exact ratio of the ints around the slash, a whole number below 2^63 an int, else a float
text_as_number(t: text): any := {
	slash = text_index(t, char_text("/"))
	if slash >= 0 { return exact_ratio(text_as_int(bytes_between(t, 0, slash)), text_as_int(bytes_between(t, slash + 1, byte_count(t)))) }
	x = text_as_float(t)
	# 2^63 (its bits 0x43E0000000000000)
	limit = float_of_bits(4890909195324358656)
	if float_floor(x) == x and x < limit and -x < limit { return truncated(x) }
	x
}
