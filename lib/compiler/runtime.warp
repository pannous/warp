# The runtime words of lib/compiler/emitter.warp: warp over the emitter's intrinsics (`intrinsic` there: new_text,
# byte_at, set_byte … each one or two instructions, callable only here). This file is lowered by the same pipeline as
# any program; the emitter compiles a word on its first call, so a module carries only the words it uses.

text_join(a: text, b: text) := {
	out = new_text(byte_count(a) + byte_count(b))
	copy_text(out, 0, a, 0, byte_count(a))
	copy_text(out, byte_count(a), b, 0, byte_count(b))
	out
}
# the characters (code points) of a text: its bytes that start one, all but the continuation bytes 10xxxxxx
text_count(t: text) := {
	count = 0
	for i in 0..byte_count(t) {
		b = byte_at(t, i)
		if b < 128 or b >= 192 { count += 1 }
	}
	count
}
# t and a newline to stdout, through the output bytes of linear memory a chunk at a time: the one place a text
# goes into memory
print_line(t: text) := {
	room = 65520
	start = 0
	while start < byte_count(t) {
		stop = start + room
		if stop > byte_count(t) { stop = byte_count(t) }
		for i in start..stop { output_byte(i - start, byte_at(t, i)) }
		write_output(stop - start)
		start = stop
	}
	output_byte(0, 10)
	write_output(1)
}
# -1, 0 or 1 as a's bytes come before b's, equal them or come after
text_order(a: text, b: text) := {
	i = 0
	while i < byte_count(a) and i < byte_count(b) {
		if byte_at(a, i) < byte_at(b, i) { return -1 }
		if byte_at(a, i) > byte_at(b, i) { return 1 }
		i += 1
	}
	if byte_count(a) == byte_count(b) then 0 else if byte_count(a) < byte_count(b) then -1 else 1
}
# the text of a boxed value of a kind known only at run time (kind codes: src/type_kinds.rs); others trap
node_text(n: any) := {
	# ø, a one-character text, is a character literal
	if is_null(n) == 1 { return char_text("ø") }
	if marked_kind(n) == 257 {
		if unboxed_int(n) == 0 { return "no" }
		return "yes"
	}
	if kind_code(n) == 1 { return int_text(unboxed_int(n)) }
	if kind_code(n) == 3 { return unboxed_text(n) }
	if kind_code(n) == 4 { return char_text(unboxed_char(n)) }
	if kind_code(n) == 8 { return list_text(unboxed_list(n)) }
	fail()
}
# a value as a list shows its items: a text in double quotes, a character in single quotes
node_code(n: any) := {
	if is_null(n) == 0 and kind_code(n) == 3 { return quoted_text(unboxed_text(n)) }
	if is_null(n) == 0 and kind_code(n) == 4 { return "'" + node_text(n) + "'" }
	node_text(n)
}
# a text in double quotes, a `\` before each of its quotes and backslashes, so the printed list reads back (P126)
quoted_text(t: text) := {
	escapes = 0
	for i in 0..byte_count(t) { escapes += escaped_byte(byte_at(t, i)) }
	out = new_text(byte_count(t) + escapes + 2)
	set_byte(out, 0, 34)
	at = 1
	for i in 0..byte_count(t) {
		b = byte_at(t, i)
		if escaped_byte(b) == 1 {
			set_byte(out, at, 92)
			at += 1
		}
		set_byte(out, at, b)
		at += 1
	}
	set_byte(out, at, 34)
	out
}
# 1 for the bytes of `"` and `\`, which a quoted text escapes
escaped_byte(b: int) := if b == 34 or b == 92 then 1 else 0
list_text(xs: list) := {
	inner = ""
	for x in xs {
		if #inner > 0 { inner += " " }
		inner += node_code(x)
	}
	"[" + inner + "]"
}
# `a + b` of values known only at run time: ø adds nothing, lists and texts join, numbers add
node_add(a: any, b: any) := {
	if is_null(a) == 1 { return b }
	if is_null(b) == 1 { return a }
	if kind_code(a) == 8 and kind_code(b) == 8 { return list_join(unboxed_list(a), unboxed_list(b)) }
	if textual_node(a) == 1 or textual_node(b) == 1 { return node_text(a) + node_text(b) }
	if kind_code(a) == 1 and kind_code(b) == 1 { return unboxed_int(a) + unboxed_int(b) }
	float_of_node(a) + float_of_node(b)
}
# 1 for a boxed text or character, else 0
textual_node(n: any) := if kind_code(n) == 3 or kind_code(n) == 4 then 1 else 0
# the index-th character of t, counted from 1: past index - 1 lead bytes, then the code point its bytes spell
text_char(t: text, index: int) := {
	at = 0
	count = 1
	while count < index {
		at += 1
		while byte_at(t, at) >= 128 and byte_at(t, at) < 192 { at += 1 }
		count += 1
	}
	lead = byte_at(t, at)
	extra = if lead < 128 then 0 else if lead < 224 then 1 else if lead < 240 then 2 else 3
	n = if lead < 128 then lead else if lead < 224 then lead - 192 else if lead < 240 then lead - 224 else lead - 240
	for k in 1 to extra { n = n * 64 + byte_at(t, at + k) - 128 }
	char_of(n)
}
list_join(a: list, b: list) := {
	out = new_list(#a + #b)
	copy_items(out, 0, a, 0, #a)
	copy_items(out, #a, b, 0, #b)
	out
}
# `a += b`: b's items after a's in a itself, so every alias of a sees them
list_append(a: list, b: list) := {
	adopt_items(a, list_join(a, b))
	a
}
# `n#i` of a value known only at run time, counted from 1: a list's item, a text's character
node_at(n: any, index: int) := {
	if kind_code(n) == 8 { return unboxed_list(n)#index }
	if kind_code(n) == 3 { return text_char(unboxed_text(n), index) }
	fail()
}
# `#n` of a value known only at run time: a list's items, a text's characters
node_length(n: any) := {
	if kind_code(n) == 8 { return #unboxed_list(n) }
	if kind_code(n) == 3 { return text_count(unboxed_text(n)) }
	fail()
}
# `n#i = value` of a list known only at run time, in the list itself, so every alias sees it
node_set_at(n: any, index: int, value: any) := {
	if kind_code(n) != 8 { fail() }
	items = unboxed_list(n)
	items#index = value
	value
}
# the characters from..to of t, counted from 1, both included: the bytes between their lead bytes
text_slice(t: text, from: int, to: int) := {
	start = character_offset(t, from)
	stop = character_offset(t, to + 1)
	out = new_text(stop - start)
	copy_text(out, 0, t, start, stop - start)
	out
}
# the byte offset of t's index-th character, counted from 1; past the last, the byte count
character_offset(t: text, index: int) := {
	at = 0
	for counted in 1..<index {
		if at < byte_count(t) { at += 1 }
		while at < byte_count(t) and byte_at(t, at) >= 128 and byte_at(t, at) < 192 { at += 1 }
	}
	at
}
# t starts with the bytes of start
text_starts_with(t: text, start: text) := byte_count(start) <= byte_count(t) and bytes_match_at(t, start, 0)
# t ends with the bytes of end
text_ends_with(t: text, end: text) := byte_count(end) <= byte_count(t) and bytes_match_at(t, end, byte_count(t) - byte_count(end))
# part's bytes stand in t from byte offset at on
bytes_match_at(t: text, part: text, at: int) := {
	for i in 0..byte_count(part) {
		if byte_at(t, at + i) != byte_at(part, i) { return no }
	}
	yes
}
# the character position of part's first place in t, counted from 1; 0 when t holds no part
text_find(t: text, part: text) := {
	position = 1
	for at in 0 to byte_count(t) - byte_count(part) {
		if bytes_match_at(t, part, at) { return position }
		if byte_at(t, at) < 128 or byte_at(t, at) >= 192 { position += 1 }
	}
	0
}
# t without the spaces, tabs and line breaks at its two ends
text_trim(t: text) := {
	start = 0
	while start < byte_count(t) and is_space_byte(byte_at(t, start)) { start += 1 }
	stop = byte_count(t)
	while stop > start and is_space_byte(byte_at(t, stop - 1)) { stop -= 1 }
	out = new_text(stop - start)
	copy_text(out, 0, t, start, stop - start)
	out
}
# a space, a tab, a line feed or a carriage return
is_space_byte(b: int) := b == 32 or b == 9 or b == 10 or b == 13
# a boxed int (kind code 1) or float as a float
float_of_node(n: any) := if kind_code(n) == 1 then unboxed_int(n) else unboxed_float(n)
# the decimal digits of n, the last first; truncating division keeps the smallest int's digits in reach
int_text(n: int) := {
	sign = if n < 0 then 1 else 0
	digits = 1
	left = n
	while int_quotient(left, 10) != 0 {
		left = int_quotient(left, 10)
		digits += 1
	}
	out = new_text(sign + digits)
	if n < 0 { set_byte(out, 0, 45) }
	left = n
	for i in sign + digits - 1 down to sign {
		digit = int_remainder(left, 10)
		if digit < 0 { digit = -digit }
		set_byte(out, i, 48 + digit)
		left = int_quotient(left, 10)
	}
	out
}
# a character's UTF-8 bytes: 6 bits in each continuation byte 10xxxxxx, the rest in the lead byte
char_text(c: char) := {
	n = code_of(c)
	count = if n < 128 then 1 else if n < 2048 then 2 else if n < 65536 then 3 else 4
	out = new_text(count)
	for i in count - 1 down to 1 {
		set_byte(out, i, 128 + int_remainder(n, 64))
		n = int_quotient(n, 64)
	}
	lead = if count == 1 then 0 else if count == 2 then 192 else if count == 3 then 224 else 240
	set_byte(out, 0, lead + n)
	out
}
