# The runtime words of lib/compiler/emitter.warp: warp over the emitter's intrinsics (`intrinsic` there: new_text,
# byte_at, set_byte … each one or two instructions, callable only here). This file is lowered by the same pipeline as
# any program; the emitter compiles a word on its first call, so a module carries only the words it uses.
# Its parts, one idea each, are the files lib/compiler/runtime/*.warp the `use` lines name; src/compiler/self_hosted.rs
# puts the words of each used file after this one, in the order of the lines.
# The case tables of upper and lower
use case_tables
use "runtime/instructions.warp"
use "runtime/text.warp"
use "runtime/case.warp"
use "runtime/show.warp"
use "runtime/arithmetic.warp"
use "runtime/equality.warp"
use "runtime/maps.warp"
use "runtime/fields.warp"
use "runtime/types.warp"
use "runtime/characters.warp"
use "runtime/lists.warp"
use "runtime/text_words.warp"
use "runtime/library_words.warp"
use "runtime/floats.warp"
use "runtime/conversions.warp"
use "runtime/exact.warp"
use "runtime/exact_rounding.warp"
use "runtime/errors.warp"
use "runtime/files.warp"
use "runtime/nodes.warp"
use "runtime/builders.warp"
use "runtime/durations.warp"
use "runtime/times.warp"
use "runtime/ordering.warp"
use "runtime/text_numbers.warp"
