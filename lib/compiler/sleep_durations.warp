# `sleep 0.2`, `sleep(1/60)`, `sleep 20ms`, `sleep(2s)` (card pure-runs): the host word sleep counts milliseconds; a bare
# number is seconds (decision sleep-seconds), a duration unit says its own (Rust twin: src/numbers/units.rs
# milliseconds, which also warns about the bare number)
use "walk.warp"

milliseconds_per_unit = {ms: 1, millisecond: 1, milliseconds: 1, s: 1000, second: 1000, seconds: 1000, min: 60000, minute: 60000, minutes: 60000, h: 3600000, hour: 3600000, hours: 3600000}

# `20ms` (parsed `20 * ms`) is 20, `0.2` is 0.2 * 1000
in_milliseconds(duration: any): any := match duration {
	data($count * $unit) if unit is symbol and name_of(unit) in milliseconds_per_unit => multiplied(count, milliseconds_per_unit[name_of(unit)])
	_ => multiplied(duration, 1000)
}

multiplied(count: any, factor: int): any := if factor == 1 then count else Key(count, "*" as Op, factor)

# a code pattern ignores brackets, so `[sleep, 3]` (a list, not a call) is told apart by its bracket and separator
sleep_call(n: Node): any := match n {
	data(sleep $duration) if bracket_of(n) == "(" or separator_of(n) == " " => List([n#1, in_milliseconds(duration)], Bracket.Round, Separator.None)
	_ => n
}

sleep_durations(program: Node): Node := bottom_up(program, n => sleep_call(n))
