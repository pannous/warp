# `sleep 0.2`, `sleep(1/60)`, `sleep 20ms`, `sleep(2s)` (card pure-runs): the host word sleep counts milliseconds; a bare
# number is seconds (decision sleep-seconds), a duration unit says its own (Rust twin: src/numbers/units.rs
# milliseconds, which also warns about the bare number)
use "walk.warp"

milliseconds_per_unit = {ms: 1, millisecond: 1, milliseconds: 1, s: 1000, second: 1000, seconds: 1000, min: 60000, minute: 60000, minutes: 60000, h: 3600000, hour: 3600000, hours: 3600000}

# `20ms` (parsed `20 * ms`) is 20, `0.2` is 0.2 * 1000
in_milliseconds(duration: any): any := {
	if type(duration) is key and op_of(duration) == "*" and value_of(duration) is symbol and name_of(value_of(duration)) in milliseconds_per_unit {
		per_unit = milliseconds_per_unit[name_of(value_of(duration))]
		return if per_unit == 1 then key_of(duration) else Key(key_of(duration), "*" as Op, per_unit)
	}
	Key(duration, "*" as Op, 1000)
}

sleep_call(n: any): any := {
	if not (is_group(n) and #n == 2 and n#1 == symbol("sleep") and (bracket_of(n) == "(" or separator_of(n) == " ")) { return n }
	List([n#1, in_milliseconds(n#2)], Bracket.Round, Separator.None)
}

sleep_durations(program: any): any := bottom_up(program, n => sleep_call(n))
