// The lexer written in warp (card self-lexer, notes/self_hosting.md step 5), each word next to its Rust twin
// (tests/parser/test_self_lexer.rs); positions count code points, as the Rust parser does
use "positions.warp"

// Where the comments and texts of a source start and end, in code points: [[start, end], …]
// Rust twin: warp_parser comment_and_text_spans
def spans(text: text): list := if one_point_each(text) then spans_in(text) else spans_in(code_points(text))

def spans_in(source: any): list {
	found = []
	at = 0
	n = source.length
	while at < n {
		end = span_end(source, at, n)
		if end > at { found += [[at, end]]; at = end } else { at = at + 1 }
	}
	found
}

// The source with its comments and texts blanked out, a space each
// Rust twin: declaration_scan.rs code_only
def code_only(source: any): text {
	parts = []
	at = 0
	for span in spans_in(source) {
		parts += [source[at .. span#1], " "]
		at = span#2
	}
	join(parts + [source[at .. source.length]], "")
}

// The end of the comment (`// …`, `# …`, `/* … */`, `/# … #/`) or text (`"…"`, `'…'`) starting at `at`, else `at`
def span_end(source: any, at: int, n: int): int {
	c = source[at]
	next = peek(source, at + 1, n)
	if c == '/' and next == '/' and (at == 0 or source[at - 1] != ':') { return index_of(source, "\n", at, n) }
	if c == '#' and (next == ' ' or next == '\t') { return index_of(source, "\n", at, n) }
	if c == '#' and at_line_start(source, at) and hash_comment(source, at, n) { return index_of(source, "\n", at, n) }
	if c == '/' and next == '*' { return after(source, "*/", at + 2, n) }
	if c == '/' and next == '#' { return after(source, "#/", at + 2, n) }
	if c == '"' or c == '\'' { return quoted_end(source, at + 1, c, n) }
	at
}

// After the quote closing a text from `from` on: an escaped quote `\"` leaves it open
// Rust twin: warp_parser quoted_end
def quoted_end(source: any, from: int, quote: any, n: int): int {
	at = from
	while at < n and source[at] != quote {
		if source[at] == '\\' { at = at + 1 }
		at = at + 1
	}
	if at < n then at + 1 else n
}

// Where `part` first starts in the source from `from` on, else the source's length
def index_of(source: any, part: text, from: int, n: int): int {
	at = from
	while at < n and not starts_at(source, part, at) { at = at + 1 }
	at
}

// The index after the first `part` from `from` on, else the source's length
def after(source: any, part: text, from: int, n: int): int {
	at = index_of(source, part, from, n)
	if at < n then at + part.length else n
}

def starts_at(source: any, part: text, at: int): bool {
	i = 0
	while i < part.length and at + i < source.length and source[at + i] == part[i] { i = i + 1 }
	i == part.length
}

// Where the numbers of a source start: [[line, column], …], both from 1
// Rust twin: read_atoms, the number atoms the parser reads
def numbers(text: text): list := atoms(text, "number")

// Where the texts of a source start: [[line, column], …], both from 1
// Rust twin: read_atoms, the text atoms the parser reads
def texts(text: text): list := atoms(text, "text")

def atoms(text: text, kind: text): list := if one_point_each(text) then positions(text, kind) else positions(code_points(text), kind)

// Where the atoms of `kind` ("number" or "text") start
def positions(source: any, kind: text): list {
	found = []
	line = 1
	column = 1
	at = 0
	n = source.length
	style_end = 0
	while at < n {
		if starts_at(source, "style{", at) and (at == 0 or not is_name_char(source[at - 1])) {
			style_end = block_end(source, at + 6, n)
		}
		end = skipped_end(source, at, n)
		if end > at and kind == "text" and text_starts(source, at, n) { found += [[line, column]] }
		if end == at and at < style_end { end = css_color_end(source, at, n) }
		if end == at and number_starts(source, at) {
			end = version_end(source, at, n)
		}
		if end == at and number_starts(source, at) {
			if kind == "number" { found += [[line, column]] }
			end = number_end(source, at, n)
		}
		if end == at { end = at + 1 }
		while at < end {
			if source[at] == '\n' { line = line + 1; column = 1 } else { column = column + 1 }
			at = at + 1
		}
	}
	found
}

// A raised letter continues a name as in Rust (`xⁿ`), a raised digit ends it (`x²` squares x)
def is_name_char(c: any): bool := is_alphanumeric(c) or is_letter_beyond_ascii(c) or c == '_' or c == '♯' or c == '♭' or SUPERSCRIPT_LETTERS.contains(c)

// The superscript digits in digit order, the raised letters in the order of the letters they raise (no raised q)
// Rust twin: warp_parser/mod.rs SUPERSCRIPT_DIGITS, SUPERSCRIPT_LETTERS
SUPERSCRIPT_DIGITS = "⁰¹²³⁴⁵⁶⁷⁸⁹"
SUPERSCRIPT_LETTERS = "ᵃᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖʳˢᵗᵘᵛʷˣʸᶻ"
RAISED_LETTERS = "abcdefghijklmnoprstuvwxyz"

def is_blank(c: any): bool := c == ' ' or c == '\t' or c == '\n' or c == '\r'

// Only blanks stand before `at` on its line
// Rust twin: declaration_scan.rs at_line_start
def at_line_start(source: any, at: int): bool {
	before = at - 1
	while before >= 0 and (source[before] == ' ' or source[before] == '\t') { before = before - 1 }
	before < 0 or source[before] == '\n'
}

// The end of what the parser skips at `at`, a comment as it reads one or a text, else `at`
// Rust twin: warp_parser/scanning.rs skip_whitespace_and_comments, at_line_comment, at_hash_comment
def skipped_end(source: any, at: int, n: int): int {
	c = source[at]
	comment = comment_end(source, at, n)
	if comment > at { return comment }
	if c == '$' { return name_end(source, at + 1, n) }
	brace = shader_brace(source, at, n)
	if brace > at { return block_end(source, brace + 1, n) }
	if text_starts(source, at, n) { return text_end(source, at + 1, closing_of(c), n) }
	at
}

// The end of the comment starting at `at` (`// …`, `# …`, `/* … */`, `/# … #/`), else `at`
// Rust twin: warp_parser/scanning.rs at_line_comment, at_hash_comment
def comment_end(source: any, at: int, n: int): int {
	c = source[at]
	next = peek(source, at + 1, n)
	if c == '/' and next == '/' and (at == 0 or source[at - 1] != ':') { return index_of(source, "\n", at, n) }
	if c == '#' and (at == 0 or is_blank(source[at - 1])) and hash_comment(source, at, n) {
		return index_of(source, "\n", at, n)
	}
	if c == '/' and (next == '*' or next == '#') { return block_comment_end(source, at, next, n) }
	at
}

// After the block comment `/* … */` (`/# … #/` with the mark #) opening at `at`; comments nest:
// `/* outer /* inner */ still outer */`
// Rust twin: comments.rs consume_block_comment
def block_comment_end(source: any, at: int, mark: any, n: int): int {
	depth = 1
	i = at + 2
	while i < n {
		following = peek(source, i + 1, n)
		if source[i] == '/' and following == mark {
			depth = depth + 1
			i = i + 2
		} else if source[i] == mark and following == '/' {
			depth = depth - 1
			i = i + 2
			if depth == 0 { return i }
		} else {
			i = i + 1
		}
	}
	n
}

// The gaps of a source, read once: for each position, where its code goes on after blanks and comments
// (`resumes`, the source's length at its end) and whether a line break lies between (`breaks`); a comment's own line
// breaks do not count. The parser asks these instead of scanning ahead (card parser-tokens)
class Gaps { resumes: list; breaks: list }
def gaps(source: any, n: int): Gaps := {
	resumes = (n + 1) times [n]
	breaks = (n + 1) times [false]
	at = n - 1
	while at >= 0 {
		c = source[at]
		end = comment_end(source, at, n)
		if end > at {
			resumes[at] = resumes[end]
			breaks[at] = breaks[end]
		} else if is_blank(c) {
			resumes[at] = resumes[at + 1]
			breaks[at] = if c == '\n' then true else breaks[at + 1]
		} else {
			resumes[at] = at
		}
		at = at - 1
	}
	Gaps{resumes: resumes, breaks: breaks}
}

// A quote opening a text at `at`
def text_starts(source: any, at: int, n: int): bool {
	c = source[at]
	c == '«' or c == '"' or c == '`' or c == '\'' and not possessive(source, at, n)
}

// `shader {` or `wgsl {` at `at`: the index of its brace, else `at`
// Rust twin: warp_parser/literals.rs parse_shader_block (SHADER_WORDS)
def shader_brace(source: any, at: int, n: int): int {
	if at > 0 and is_name_char(source[at - 1]) { return at }
	for word in ["shader", "wgsl"] {
		if starts_at(source, word, at) {
			brace = at + word.length
			if brace < n and is_name_char(source[brace]) { return at }
			while brace < n and (source[brace] == ' ' or source[brace] == '\t') { brace = brace + 1 }
			return if is_at(source, brace, '{', n) then brace else at
		}
	}
	at
}

// After the `}` closing the block from `from` on, WGSL comments not counting
// Rust twin: warp_parser/literals.rs closing_brace
def block_end(source: any, from: int, n: int): int {
	at = from
	depth = 1
	while at < n {
		c = source[at]
		next = peek(source, at + 1, n)
		if c == '/' and next == '/' { at = index_of(source, "\n", at, n) }
		else if c == '/' and next == '*' { at = after(source, "*/", at + 2, n) - 1 }
		else if c == '{' { depth = depth + 1 }
		else if c == '}' {
			depth = depth - 1
			if depth == 0 { return at + 1 }
		}
		at = at + 1
	}
	n
}

// In a style sheet `#8884` is a hex color, no number: its end, else `at`
// Rust twin: warp_parser/lookahead.rs css_color_length
def css_color_end(source: any, at: int, n: int): int {
	if not (source[at] == '#' and at + 1 < n and is_digit(source[at + 1])) { return at }
	end = at + 1
	while end < n and is_hex_digit(source[end]) { end = end + 1 }
	digits = end - at - 1
	glued = end < n and (is_name_char(source[end]) or source[end] == '-')
	if [3, 4, 6, 8].contains(digits) and not glued then end else at
}

def is_hex_digit(c: any): bool := is_digit(c) or "abcdefABCDEF".contains(c)

// After the text from `from` on that `closing` ends, a backslash escaping the character after it
// Rust twin: warp_parser/literals.rs parse_string
def text_end(source: any, from: int, closing: any, n: int): int {
	interpolates = closing == '"' or closing == '`'
	at = from
	while at < n and source[at] != closing {
		c = source[at]
		next = peek(source, at + 1, n)
		if interpolates and (c == '\\' or c == '$') and (next == '(' or next == '{') {
			at = hole_end(source, at + 2, next, closing_of(next), n)
		} else {
			if c == '\\' { at = at + 1 }
			at = at + 1
		}
	}
	if at < n then at + 1 else n
}

// After the `close` of an interpolation hole from `from` on, nested brackets and quoted text inside
// Rust twin: warp_parser/literals.rs text_until_closing
def hole_end(source: any, from: int, open: any, close: any, n: int): int {
	depth = 1
	quote = ' '
	at = from
	while at < n {
		c = source[at]
		if quote != ' ' {
			if c == '\\' { at = at + 1 }
			else if c == quote { quote = ' ' }
		}
		else if c == '"' or c == '\'' { quote = c }
		else if c == open { depth = depth + 1 }
		else if c == close {
			depth = depth - 1
			if depth == 0 { return at + 1 }
		}
		at = at + 1
	}
	n
}

// `p's name`: the field p.name, no text
def possessive(source: any, at: int, n: int): bool {
	at > 0 and is_name_char(source[at - 1]) and is_at(source, at + 1, 's', n) and is_at(source, at + 2, ' ', n) and at + 3 < n and is_name_start(source[at + 3])
}

// `ø` is the empty value, never a name's start (Rust's atom reads it before names)
def is_name_start(c: any): bool := is_alpha(c) or (is_letter_beyond_ascii(c) and c != 'ø') or c == '_'

// `π`, `σ`, `é`, `名`: a letter beyond ASCII names as a Latin one does (Rust's is_alphabetic), a cased one or one of
// the CJK, kana and Hangul blocks
def is_letter_beyond_ascii(c: any): bool {
	if c <= '~' { return false }
	upper(c) != lower(c) or (c >= '\u{3040}' and c <= '\u{30ff}') or (c >= '\u{4e00}' and c <= '\u{9fff}') or (c >= '\u{ac00}' and c <= '\u{d7af}')
}

// `# note`, `#!`, `##`, `#use lib`: a comment; `#s`, `#a-1`, `#f(x)` count
def hash_comment(source: any, at: int, n: int): bool {
	next = peek(source, at + 1, n)
	if is_blank(next) or next == '!' or next == '#' { return true }
	width = name_end(source, at + 1, n) - at - 1
	any_word_at(source, at + 1, width, ["use", "require", "import", "include"])
}

// Whether one of `words` is exactly the `width` items at `at` (the source a text or its code points)
def any_word_at(source: any, at: int, width: int, words: list): bool {
	for word in words { if word.length == width and starts_at(source, word, at) { return true } }
	false
}

// After the name from `from` on; `$1` is a parameter, no number
def name_end(source: any, from: int, n: int): int {
	at = from
	while at < n and is_name_char(source[at]) { at = at + 1 }
	at
}

// `full-name`: a hyphen in a name joins the word after it; `x-1` and `i--` end the name at the hyphen
// Rust twin: warp_parser/atoms.rs parse_symbol, hyphen_joins_word
def symbol_end(source: any, from: int, n: int): int {
	at = name_end(source, from, n)
	while at + 1 < n and source[at] == '-' and is_name_start(source[at + 1]) { at = name_end(source, at + 1, n) }
	at
}

def number_starts(source: any, at: int): bool := (is_digit(source[at]) or fraction_starts(source, at)) and (at == 0 or not is_name_char(source[at - 1]))

// `.5`, `[.25]`: a fraction written without its 0, where no operand ends before the dot (`xs.1`, `f().5` stay members)
def fraction_starts(source: any, at: int): bool := source[at] == '.' and at + 1 < source.length and is_digit(source[at + 1]) and (at == 0 or not ").]}".contains(source[at - 1]))

def number_end(source: any, at: int, n: int): int {
	date = date_length(source, at, n)
	if date > 0 { return at + date }
	while at < n and (is_name_char(source[at]) or source[at] == '.' and at + 1 < n and is_digit(source[at + 1])) {
		if signed_exponent(source, at, n) { at = at + 1 }
		at = at + 1
	}
	at
}

// A version literal at `at`, digits with two dots or more (`1.2.3`), which the parser reads as no number: its end,
// else `at`. Rust twin: versions.rs literal_len
def version_end(source: any, at: int, n: int): int {
	end = digits_end(source, at, n)
	dots = 0
	while end + 1 < n and source[end] == '.' and is_digit(source[end + 1]) {
		end = digits_end(source, end + 1, n)
		dots = dots + 1
	}
	if dots < 2 or (end < n and is_name_char(source[end])) { return at }
	end
}

def digits_end(source: any, at: int, n: int): int {
	while at < n and is_digit(source[at]) { at = at + 1 }
	at
}

// After the spaces and tabs from `at` on
def blanks_end(source: any, at: int, n: int): int {
	while at < n and (source[at] == ' ' or source[at] == '\t') { at += 1 }
	at
}

// After the run of `c` from `at` on: `' '` for spaces alone, where a tab separates columns
def run_end(source: any, at: int, c: any, n: int): int {
	while at < n and source[at] == c { at += 1 }
	at
}

// Length of a date literal at `at` (RFC 3339 / 9557: `2024-01-31`, `2024-01-31T10:00:05.5Z`, `…+01:00[Europe/Berlin]`),
// else 0. Rust twin: time/calendar.rs literal_len
def date_length(source: any, at: int, n: int): int {
	if not (digits(source, at, 4, n) and is_at(source, at + 4, '-', n) and digits(source, at + 5, 2, n)) { return 0 }
	if not (is_at(source, at + 7, '-', n) and digits(source, at + 8, 2, n)) { return 0 }
	end = at + 10
	if (is_at(source, end, 'T', n) or is_at(source, end, 't', n)) and clock_at(source, end + 1, n) {
		end = end + 6
		if is_at(source, end, ':', n) and digits(source, end + 1, 2, n) {
			end = end + 3
			if is_at(source, end, '.', n) and digits(source, end + 1, 1, n) {
				end = end + 1
				while end < n and is_digit(source[end]) { end = end + 1 }
			}
		}
		if is_at(source, end, 'Z', n) or is_at(source, end, 'z', n) {
			end = end + 1
		} else if (is_at(source, end, '+', n) or is_at(source, end, '-', n)) and clock_at(source, end + 1, n) {
			end = end + 6
		}
		end = after_zone_names(source, end, n)
	}
	if end < n and is_name_char(source[end]) { return 0 }
	end - at
}

// `e-3` of `1e-3`, `E+5` at `at`
def signed_exponent(source: any, at: int, n: int): bool {
	(source[at] == 'e' or source[at] == 'E') and (is_at(source, at + 1, '-', n) or is_at(source, at + 1, '+', n)) and at + 2 < n and is_digit(source[at + 2])
}

// `hh:mm` at `at`
def clock_at(source: any, at: int, n: int): bool := digits(source, at, 2, n) and is_at(source, at + 2, ':', n) and digits(source, at + 3, 2, n)

// After the RFC 9557 suffixes at `at`: `[Europe/Berlin]`, `[_tzdata=warp-2026a]`
def after_zone_names(source: any, at: int, n: int): int {
	end = at
	while is_at(source, end, '[', n) {
		close = index_of(source, "]", end + 1, n)
		if close == n or close == end + 1 or not all_zone_chars(source, end + 1, close) { return end }
		end = close + 1
	}
	end
}

def all_zone_chars(source: any, from: int, to: int): bool {
	i = from
	while i < to and (is_alphanumeric(source[i]) or "/_+-=.!".contains(source[i])) { i = i + 1 }
	i == to
}

def digits(source: any, at: int, count: int, n: int): bool {
	i = 0
	while i < count and at + i < n and is_digit(source[at + i]) { i = i + 1 }
	i == count
}

def is_at(source: any, at: int, c: any, n: int): bool := at < n and source[at] == c

// The character at `at`, a newline past the end
def peek(source: any, at: int, n: int): any := if at < n then source[at] else '\n'

// The bracket or quote closing `open`, a quote closing itself
def closing_of(open: any): any {
	if open == '(' { return ')' }
	if open == '[' { return ']' }
	if open == '{' { return '}' }
	if open == '«' { return '»' }
	open
}
