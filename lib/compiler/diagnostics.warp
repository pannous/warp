# The diagnostics of the warp compiler (card pure-diagnostics, decision diagnostics-files): a check finds a fact, a
# node such as `kind_change(x, Int, List)`, and `diagnose(fact, at)` says it at the node the check looked at, with the
# message of the first row it matches in errors.data, then warnings.data, then hints.data. A row is `pattern TAB message`, optionally `TAB fix`
# and then `TAB topic@expression`, what "got it" silences:
# the pattern a node whose `$name` parts take any node (`data(…)` quotes it), the message and fix texts whose
# `{name}` holes give that part and `{a name}` it with its article. The stage hands `diagnosed` to Rust, which says
# the warnings and fails on an error (notes/pure_diagnostics.md); compiler.warp fails on an error itself.
use "parser.warp"
use "words.warp"
use "walk.warp"

# the message files in the order a fact is looked up, each with the level of its messages
message_files = [["errors.data", "error"], ["warnings.data", "warning"], ["hints.data", "hint"]]
quoting_word = "data"
hole_mark = "$"

# [level, message, fix, topic@expression, line, column] of each fact diagnosed so far ("" when it names none; line
# and column 0 at a node a pass made)
global diagnosed = []
# [level, pattern, message] of every row of the message files, read at the first fact
global message_rows = ø

# the node a check looks at: a key of the operator
is_operator(n: any, op: text): bool := n is key and op_of(n) == op

diagnose(fact: any, at: any): any := {
	diagnosed += [said_fact(fact) + place_of(at)]
	fact
}
# [line, column] where n was written
place_of(n: any): list := if is_positioned(n) then [line_of(n), column_of(n)] else [0, 0]

# [level, message, fix, topic@expression] of the first row the fact matches; a fact no row matches is an error
# naming it, loudly
said_fact(fact: any): list := {
	for row in rows() {
		bound = {}
		if matches(row#2, fact, bound) { return [row#1] + row[2..].map(message => filled(message, bound)) }
	}
	["error", "no message for the diagnostic ${fact} in lib/compiler/" + message_files.map(file => file#1).join(", "), "", ""]
}

rows(): list := {
	if message_rows == ø { message_rows = message_files.map(file => rows_of(file#1, file#2)).flatten() }
	message_rows
}

# the rows of a message file as plain warp data: a list of lines, each a tab-separated [pattern, message] with an
# optional fix and topic@expression after it, as [level, pattern, message, fix, topic@expression]
rows_of(file: text, level: text): list := {
	source = try read(module_directory + "/" + file) else ""
	lines = statements_in(plain_node(parsed(source)))
	lines.filter(line => line != ø).map(line => [level, unquoted(line#1), line#2, column(line, 3), column(line, 4)])
}
column(line: any, index: int): text := if #line >= index then line#index else ""
unquoted(pattern: any): any := if is_group(pattern) and #pattern == 2 and pattern#1 == symbol(quoting_word) then pattern#2 else pattern

# whether n has the pattern's shape, each part a hole takes put in `bound`: a hole takes any node, a key or group
# matches part by part, any other node only itself
matches(pattern: any, n: any, bound: any): bool := {
	if pattern is symbol and name_of(pattern).starts_with(hole_mark) {
		bound[name_of(pattern)[1..]] = n
		return yes
	}
	if pattern is key {
		return n is key and op_of(n) == op_of(pattern) and matches(key_of(pattern), key_of(n), bound) and matches(value_of(pattern), value_of(n), bound)
	}
	if is_group(pattern) {
		if not is_group(n) or bracket_of(n) != bracket_of(pattern) or #n != #pattern { return no }
		for index in 0 ..< #pattern { if not matches(pattern[index], n[index], bound) { return no } }
		return yes
	}
	pattern == n
}

# the message with each hole `{name}` or `{a name}` filled from the bound parts
filled(message: text, bound: any): text := {
	pieces = message.split("{")
	result = pieces#1
	for piece in pieces[1..] {
		hole = piece.split("}")#1
		words = hole.split(" ")
		part = shown(bound[words#(#words)])
		result += (if #words == 2 and words#1 == "a" then with_article(part) else part) + piece[(#hole + 1)..]
	}
	result
}
shown(part: any): text := if part is symbol then name_of(part) else if part is text then part else "${part}"

# what was diagnosed after the first `known` facts: a compile's own, past those of the runtime words lowered before it
diagnosed_since(known: int): list := diagnosed[known ..]

# the first error among the diagnosed, as Rust's Diagnostic says it; ø when none is an error
first_error(found: list): text? := {
	failing = found.find(said => said#1 == "error")
	if not failing { return ø }
	said_text(failing)
}

# the warnings among the diagnosed, each as Rust's Diagnostic says it
warnings_said(found: list): list := found.filter(said => said#1 == "warning").map(said_text)

# a diagnosed [level, message, fix, topic, line, column] as Rust's Diagnostic says it: the message, ` at line:column`
# when it has a position (the runner names the file and shows the line), then `; fix: ` and the fix when it names one
said_text(said: list): text := {
	placed = if said#5 > 0 then said#2 + " at ${said#5}:${said#6}" else said#2
	if said#3 then placed + "; fix: " + said#3 else placed
}
