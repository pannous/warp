# Properties of objects (decision property-accessors; Rust twin: src/lowering/definitions/property_accessors.rs):
# `canvas.width` read like a field and, where it has a setter, written like one. A property is defined in warp: its
# getter `canvas.width := canvas_width`, its setter the one-parameter overload `canvas.width(w) := canvas(w,
# canvas_height)` or a getter-shaped body reading `it`. A use is the definition's body in place: `canvas.width = 300`,
# `canvas.width(300)`, `+=` and its kin call the setter; writing a property without one fails loudly. The standard ones
# are lines of lib/prelude.warp (window, display) and lib/draw.warp (the canvas, whose `use` comes along); a program
# defines its own the same way, and an object the program binds as a value keeps its own fields.
# Runs on the program and the files it uses, before the standard modules and the prelude are reached, so the words a
# body calls (canvas_width, set_system_value) bring their definitions.
# Not yet: a bare `width`, `width(canvas)`, other names (display.dpi), the properties of a class's instances.
use "walk.warp"
use "scope.warp"
use "uses.warp"
use "parser.warp"
use "prelude_words.warp"

# the parameter of a setter written getter-shaped: `canvas.width := canvas(it, canvas_height)`
setter_word = "it"
# the standard modules defining properties, and the module a use of one brings ("" for the prelude, always there)
property_modules = [["prelude", ""], ["draw", "draw"]]
compound_assignments = [[Op.AddAssign, Op.Add], [Op.SubAssign, Op.Sub], [Op.MulAssign, Op.Mul], [Op.DivAssign, Op.Div],
	[Op.FloorDivAssign, Op.FloorDiv], [Op.ModAssign, Op.Mod], [Op.PowAssign, Op.Pow]]

# [object, property, the setter's parameter or "" for a getter, body] of `o.p := …` and `o.p(v) := …`, else ø
property_definition(n: Node): any := {
	if not is_key(n, Op.Define) { return ø }
	head = key_of(n)
	if not is_key(head, Op.Dot) or not (key_of(head) is symbol) { return ø }
	object = name_of(key_of(head))
	member = value_of(head)
	body = value_of(n)
	if member is symbol { return [object, name_of(member), if mentions(body, setter_word) then setter_word else "", body] }
	if not is_round(member) { return ø }
	items = items_of(member)
	if #items == 2 and items#1 is symbol and items#2 is symbol { return [object, name_of(items#1), name_of(items#2), body] }
	ø
}

# `canvas.width := …` or `canvas.width(w) := …` starting a line of a module's text
defines_property(line: text): bool := {
	object = leading_name(line)
	if object == "" or not line[#object ..].starts_with(".") { return no }
	leading_name(line[#object + 1 ..]) != "" and line.contains(":=")
}

# the properties `statements` define, each "object.property" → [getter or ø, [parameter, setter] or ø, module]
def properties_collected(statements: list, module: text, properties: any) {
	for statement in statements {
		found = property_definition(statement)
		if found != ø {
			name = found#1 + "." + found#2
			known = if properties.has(name) then properties[name] else [ø, ø, module]
			properties[name] = if found#3 == "" then [found#4, known#2, module] else [known#1, [found#3, found#4], module]
		}
	}
}

# the standard properties: the property lines of each module's text, parsed on their own
standard_properties(): any := {
	properties = {}
	for entry in property_modules {
		source = file_text(std_module_path(entry[0]))
		if source != ø {
			lines = source.split("\n").filter(defines_property)
			if #lines > 0 { properties_collected(statements_in(plain_node(parsed(lines.join("\n")))), entry[1], properties) }
		}
	}
	properties
}

# "object.property" of `object.member`, "" when it names no property or the program binds the object as a value
property_named(object: Node, member: Node, properties: any, scope: any): text := {
	if not (object is symbol) or not (member is symbol) or binds_value(scope, name_of(object)) { return "" }
	name = name_of(object) + "." + name_of(member)
	if properties.has(name) then name else ""
}
dotted_property(n: Node, properties: any, scope: any): text := if is_key(n, Op.Dot) then property_named(key_of(n), value_of(n), properties, scope) else ""

# the body with each `parameter` the value written
setter_with_value(body: Node, parameter: text, value: Node): Node := bottom_up(body, n => if n == symbol(parameter) then value else n)

# the base operator of `+=` and its kin, ø for another
compound_base(op: Op): any := {
	for pair in compound_assignments { if op == pair[0] { return pair[1] } }
	ø
}

# the program with each read of a property its getter and each write its setter
property_accessed(n: Node, properties: any, scope: any): Node := {
	getter_name = dotted_property(n, properties, scope)
	if getter_name != "" and properties[getter_name]#1 != ø { return properties[getter_name]#1 }
	match n {
		Key(left, op, right): key_accessed(left, op, right, properties, scope)
		_: children(n, part => property_accessed(part, properties, scope))
	}
}
# `left op right`: a property written (`=`, `+=`, the setter called `canvas.width(300)`), else its sides walked; a
# field's name is no read (`{width: 5}`, `p.width`)
key_accessed(left: Node, op: Op, right: Node, properties: any, scope: any): Node := {
	target = dotted_property(left, properties, scope)
	value = property_accessed(right, properties, scope)
	if target != "" and op == Op.Assign { return property_written(target, value, properties) }
	base = compound_base(op)
	if target != "" and base != ø and properties[target]#1 != ø { return property_written(target, Key(properties[target]#1, base, value), properties) }
	if op == Op.Dot and is_round(right) and #items_of(right) == 2 {
		items = items_of(right)
		called = property_named(left, items#1, properties, scope)
		if called != "" { return property_written(called, property_accessed(items#2, properties, scope), properties) }
	}
	if op == Op.Colon { return Key(left, op, value) }
	if op == Op.Dot { return Key(property_accessed(left, properties, scope), op, right) }
	Key(property_accessed(left, properties, scope), op, value)
}

# the setter's body, its parameter the value; a property without a setter is a loud error where it is written
property_written(name: text, value: Node, properties: any): Node := {
	setter = properties[name]#2
	if setter == ø { return call_of("raise", [Text(name + " is read-only, it has no setter")]) }
	setter_with_value(setter#2, setter#1, value)
}

# the program's properties in use, its own definitions gone; `use draw` in front when a canvas property needs it
property_accessors(program: Node): Node := {
	statements = statements_in(program)
	own = {}
	properties_collected(statements, "", own)
	mentioned = symbol_words(program)
	wants_standard = mentioned.any(word => word in ["window", "display", "canvas"])
	if #own.keys == 0 and not wants_standard { return program }
	properties = if wants_standard then standard_properties() else {}
	for name in own.keys { properties[name] = own[name] }
	kept = statements.filter(statement => property_definition(statement) == ø)
	scope = scope_of(program)
	rewritten = kept.map(statement => property_accessed(statement, properties, scope))
	# the modules of the properties the program names: `use draw` in front for the canvas's
	needed = properties.keys.filter(name => name.split(".")#1 in mentioned).map(name => properties[name]#3)
	uses = statements.map(use_target).filter(target => target is symbol).map(name_of)
	brought = property_modules.map(entry => entry[1]).filter(module => module != "" and module in needed and module not in uses)
	separated(bracketed(brought.map(module => plain_node(parsed("use " + module))) + rewritten, ""), ";")
}
