# `(p).a` is `p.a` (Rust twin: src/lowering/collections/grouped_receivers.rs): parentheses around a variable before a
# dot only group it. The parser gives the call `f()` the form of the group `(f)`, so only a name the program binds to
# a value (an assignment that is no lambda, a loop variable) ungroups; `f().b`, `today().year` stay calls.
use "walk.warp"
use "scope.warp"

# `(p)`: the one name in parentheses, else ø
grouped_name(n: Node): any := match n {
	List(parts, Bracket.Round, separator): { if #parts == 1 and parts#1 is symbol then parts#1 else ø }
	_: ø
}

# a name the program binds to a value, never to a function
is_variable(scope: any, name: text): bool := (binds_as(scope, name, Meaning.Variable) or binds_as(scope, name, Meaning.Loop)) and not binds_as(scope, name, Meaning.Function)

# `(p).a` as `p.a` when p is a variable: the keyword rewrite of a dot, an entry of passes.warp sugar_phrases_table
is_dot(word: Node): bool := word == symbol(".")
ungrouped(n: Node): Node := match n {
	Key(receiver, Op.Dot, member): {
		name = grouped_name(receiver)
		if name != ø and is_variable(rewritten_bindings(), name_of(name)) then Key(name, Op.Dot, member) else n
	}
	_: n
}
