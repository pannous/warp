# `try x else y` and `try x catch e { y }` (card pure-runs; Rust twin: src/lowering/words/library_words/guards.rs):
# x runs inside ran_without_error, which says whether it finished (a runtime error deep inside throws the wasm tag
# try_guard.rs catches); x's value counts unless it is an Error, else y. The errors wasm cannot catch are checked
# before they happen: a division by 0 directly under `try`, an index out of a list written in place.
#   try x else y        → (try·finished = ran_without_error({try·value = x});
#                          if try·finished and not is_error(try·value) then {try·value} else {y})
#   try x catch e { y } → … else {e = caught_error(try·finished, try·value); y}
#   try a / b else y    → (try·divisor = b; if try·divisor == 0 then {y} else {…a / try·divisor…})
#   try [1 2]#i else y  → (try·list = [1 2]; try·index = i; if 1 <= try·index <= count(try·list) then … else {y})
# Each try's names carry its number (try·value·3), as Rust's do, so two tries of a function keep their own kinds.
use "walk.warp"
use "phrase_blocks.warp"
use "plain_enums.warp"

applied_to(word: text, arguments: list): Node := List([symbol(word)] + arguments, Bracket.Round, Separator.None)
# `{n}`, a block of one item, as Rust writes it
braced(n: Node): Node := List([n], Bracket.Curly, Separator.Space)
try_statements(parts: list): Node := List(parts, Bracket.Round, Separator.Semicolon)
try_assigned(name: Node, value: Node): Node := Key(name, Op.Assign, value)
chosen_branch(test: Node, yes_branch: Node, no_branch: Node): Node := Key(Key(Key(ø, Op.If, test), Op.Then, yes_branch), Op.Else, no_branch)

try_name(role: text, number: int): Node := fresh_name("try·" + role, number)

# `try x else y`; with a catch binding (a name, else ø) the else branch binds it to the error before y
guarded(value: Node, fallback: Node, binding: any, number: int): Node := {
	finished = try_name("finished", number)
	result = try_name("value", number)
	ran = try_assigned(finished, applied_to("ran_without_error", [braced(try_assigned(result, value))]))
	succeeded = Key(finished, Op.And, Key(ø, Op.Not, applied_to("is_error", [result])))
	otherwise = if binding == ø then braced(fallback) else List([try_assigned(binding, applied_to("caught_error", [finished, result])), fallback], Bracket.Curly, Separator.Semicolon)
	try_statements([ran, chosen_branch(succeeded, braced(result), otherwise)])
}

divided(dividend: Node, op: any, divisor: Node, fallback: Node, number: int): Node := {
	held = try_name("divisor", number)
	quotient = guarded(Key(dividend, op, held), fallback, ø, number)
	try_statements([try_assigned(held, divisor), chosen_branch(Key(held, Op.Eq, 0), braced(fallback), braced(quotient))])
}

is_written_list(n: Node): bool := match n {
	List(written, Bracket.Square, separator): yes
	Text(t): yes
	_: no
}

indexed(written: Node, index: Node, fallback: Node, number: int): Node := {
	held = try_name("list", number)
	at = try_name("index", number)
	within = Key(Key(at, Op.Ge, 1), Op.And, Key(at, Op.Le, applied_to("count", [held])))
	try_statements([try_assigned(held, written), try_assigned(at, index), chosen_branch(within, braced(Key(held, Op.Hash, at)), braced(fallback))])
}

is_division(op: any): bool := op == Op.Div or op == Op.Mod or op == Op.Rem

# the value under try, its fallback, the catch binding or ø
lowered_try(value: Node, fallback: Node, binding: any): Node := {
	number = fresh_number()
	match value {
		Key(target, Op.Assign, assigned_value): { if is_name(target) and binding == ø then try_assigned(target, lowered_try(assigned_value, fallback, binding)) else guarded(value, fallback, binding, number) }
		Key(left, op, right): {
			if binding == ø and is_division(op) { return divided(left, op, right, fallback, number) }
			if binding == ø and op == Op.Hash and is_written_list(left) { return indexed(left, right, fallback, number) }
			guarded(value, fallback, binding, number)
		}
		# `try { x } …`: a block of one statement guards the statement (held as a value, `{x}` would be data)
		List(statements, Bracket.Curly, separator): {
			if #statements == 1 and not (statements#1 is key and op_of(statements#1) == ":") { return guarded(statements#1, fallback, binding, number) }
			guarded(value, fallback, binding, number)
		}
		_: guarded(value, fallback, binding, number)
	}
}

# `assert c else m`, `check c`: 1 when c holds, else it raises m (Rust twin: guards.rs lower_assert)
asserted(condition: Node, message: Node): Node := chosen_branch(condition, braced(1), braced(applied_to(raise_word, [message])))

# parser.warp reads `try x else y` as `try·else(x, y)`, `try x catch e { y }` as `try·else(x, {y}, e)` and
# `assert c else m` as `assert·else(c, m)`, as Rust's parser does
try_form(n: Node): Node := match n {
	List(parts, Bracket.Round, Separator.None): {
		if #parts == 3 and parts#1 == symbol("assert·else") { return asserted(parts#2, parts#3) }
		if #parts < 3 or parts#1 != symbol("try·else") { return n }
		if #parts == 3 { return lowered_try(parts#2, parts#3, ø) }
		if #parts == 4 and is_name(parts#4) { return lowered_try(parts#2, parts#3, parts#4) }
		n
	}
	_: n
}

tries(program: any): any := bottom_up(program, try_form)
