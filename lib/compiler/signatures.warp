# What a function takes and gives, read once for every stage (card function-signature, after wasp's Signature and
# Function in source/Code.h): the parameters of a program's definition `f(a, b: int = 2) := …`, with no other file read,
# so every pass may use it (builtin_signatures.warp reads the builtins' typed lines of lib/prelude.warp)
use "words.warp"
use "walk.warp"

# a parameter as written, `separator: text = " "`: its type_name "" when undeclared (its calls decide; dispatch fits it
# as any), defaulted_to [the default] or ø for none (ø itself is a default: `to = ø`), rest when it takes the remaining
# arguments (`values...`)
class Parameter { name: text; type_name: text = ""; defaulted_to: any = ø; rest: bool = no }
# the parameters in order and the declared result, "" when undeclared
class Signature { parameters: list = []; result: text = "" }

# `x`, `x: T`, `x = 1`, `x: T = 1`, `with new x` (label words before the name, Rust parameter_head)
parameter_of(written: any): Parameter := {
	declared = if is_key(written, Op.Assign) then key_of(written) else written
	defaulted_to = if is_key(written, Op.Assign) then [value_of(written)] else ø
	if not is_key(declared, Op.Colon) { return Parameter(name: parameter_name(declared), defaulted_to: defaulted_to) }
	Parameter(name: parameter_name(key_of(declared)), type_name: type_text(value_of(declared)), defaulted_to: defaulted_to)
}
# symbol first: `type(symbol("key")) is key` (card type-symbol)
parameter_name(named: any): text := {
	if named is symbol { return name_of(named) }
	if named is key { return parameter_name(key_of(named)) }
	parameter_name(named.last)
}
# `int` of `x: int`; a type form Rust checks at each call (`xs: [int]`) as written
type_text(type: any): text := if type is symbol then name_of(type) else "${type}"

# the head `f(a, b: int)` of a definition (its name first)
signature_of(head: list): Signature := Signature(parameters: head[1..].map(parameter_of))
taken_names(signature: Signature): list := signature.parameters.map(parameter => parameter.name)
# [how many arguments a call must pass, how many it may]: a defaulted parameter may be left out
arity(signature: Signature): list := [#signature.parameters.filter(parameter => parameter.defaulted_to == ø), #signature.parameters]
# a function's parameter by its index, `bottom_up·2`, the key of what the stages learn about it
parameter_key(function: text, index: int): text := function + "·" + index
# whether a call of `arguments` values fits: the parameters without a default at least, any more after a rest one
takes(signature: Signature, arguments: int): bool := {
	rest = signature.parameters.any(parameter => parameter.rest)
	arguments >= arity(signature)#1 - (if rest then 1 else 0) and (rest or arguments <= #signature.parameters)
}
