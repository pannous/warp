# Plain enums (card pure-enums; Rust twin: src/lowering/types/plain_enums.rs): `enum Color { Red, Green }` (Swift's
# `{ case north, south }`) declares the type Color whose variants are its bare cases, `type @variants(Red Green) Color
# {}`, and `Color.Red`, `Color::Red`, Swift's `.red` are the case itself, the symbol Red. A case's index, counting from
# 0 as C does, is `Coin.Dime as int`; an int becomes a case explicitly, `2 as Coin` or `Coin(2)`, an error when no case
# has that index (card enum-leftovers).
use "walk.warp"
use "phrase_blocks.warp"
use "shapes.warp"
use "node_matches.warp"
use "enum_declarations.warp"

variants_word = "variants"
# the types a case converts to, each with the number its first case counts as: `Coin.Dime as int` and `as index` its
# index 2 (from 0, as C counts), `as position` its position 3 (from 1, as `xs#p` counts)
count_types = {int: 0, index: 0, position: 1}
# the types a spelled case converts to its spelling, `op as text` (Rust twin: node_cases.rs TEXT_TYPES)
text_types = ["text", "string"]
# spelled_enums, node.warp's enums whose cases convert by their spelling (`op as text`), not by their index
use "node_cases.warp"

# the names declared of an enum type, `c: Coin`, with that enum; "" for a name declared of several types
# Rust twin: match_exhaustive.rs typed_subjects
subjects_in(n: Node, enums: any, subjects: any): any := {
	declared = match n {
		Key(name, Op.Colon, type_name): if is_name(name) and is_name(type_name) and name_of(type_name) in enums then [name_of(name), name_of(type_name)] else ø
		_: ø
	}
	if declared != ø { held_as(subjects, declared#1, declared#2) }
	for part in scope_parts(n) { subjects_in(part, enums, subjects) }
	subjects
}

# a name holds an enum's cases: "" once it holds another's or another value
held_as(subjects: any, name: text, enum_name: text): any := {
	subjects[name] = if name in subjects and subjects[name] != enum_name then "" else enum_name
	subjects
}

# the enum of a case assigned, `Coin.Dime` or a spelled case `Op·case(t)` as a match binds it, else ""
assigned_enum(value: Node, enums: any): text := match value {
	Key(owner, Op.Dot, case): if is_name(owner) and name_of(owner) in enums then name_of(owner) else ""
	List(parts, Bracket.Round, Separator.None): {
		named = spelled_enums.filter(enum_name => #parts == 2 and parts#1 == symbol(spelled_function(enum_name, "case")))
		if #named == 1 then named#1 else ""
	}
	_: ""
}

# the names assigned cases of one enum, `c = Coin.Dime`, with that enum; "" for a name also assigned anything else
# Rust twin: plain_enums.rs assigned_cases
assigned_in(n: any, enums: any, subjects: any): any := {
	if is_key(n, Op.Assign) and is_name(key_of(n)) { held_as(subjects, name_of(key_of(n)), assigned_enum(value_of(n), enums)) }
	for part in scope_parts(n) { assigned_in(part, enums, subjects) }
	subjects
}

# the parts of a node in its scope: those of a function's definition inside it have a scope of their own
scope_parts(n: Node): list := parts_of(n).filter(part => not is_function_definition(part))

# the names holding cases of an enum in a scope (the program outside its functions, or a function's definition, which
# sees those of `outer` it does not name itself): typed so, else assigned only its cases. Per scope, as names are: the
# parser's `bracket = ""` leaves view_of's `bracket`, bound a Bracket case, its spelling
held_cases(scope: any, enums: any, outer: any): any := {
	subjects = assigned_in(scope, enums, {})
	typed = subjects_in(scope, enums, {})
	for name in typed.keys { subjects[name] = typed[name] }
	for name in outer.keys { if name not in subjects { subjects[name] = outer[name] } }
	subjects
}

# the program's enum forms lowered, each function's by the names of its scope
scoped_enum_nodes(n: Node, enums: any, subjects: any): Node := {
	scope = if is_function_definition(n) then held_cases(n, enums, subjects) else subjects
	enum_node(children(n, part => scoped_enum_nodes(part, enums, scope)), enums, scope)
}

# the spelled enum whose case a name holds, else ø
held_spelled(value: Node, subjects: any): any := {
	if not is_name(value) or name_of(value) not in subjects { return ø }
	enum_name = subjects[name_of(value)]
	if enum_name in spelled_enums then enum_name else ø
}

# `x == "+"` of a name holding a spelled case: Op·text(x) == "+", a case equals its spelling
held_equality(left: Node, op: Node, right: Node, n: Node, subjects: any): Node := {
	enum_name = held_spelled(left, subjects) ?? held_spelled(right, subjects)
	if enum_name == ø { return n }
	Key(held_text(enum_name, left), op, held_text(enum_name, right))
}

# the enum having a case of that name, when only one has it, else ø
owner_of(case: text, enums: any): any := {
	owners = enums.keys.filter(name => case in enums[name])
	if #owners == 1 then owners#1 else ø
}

# the enum of a value: a case by name, or a name declared of the enum, else ø
type_of(value: Node, enums: any, subjects: any): any := {
	if not is_name(value) { return ø }
	name = name_of(value)
	owner = owner_of(name, enums)
	if owner != ø { return owner }
	if name in subjects and subjects[name] then subjects[name] else ø
}

# the declaration as the sum type of its cases, the view Rust's sum_type gives
enum_type(name: text, cases: list): any := {
	variants = ["list", "", " "] + cases.map(case => ["symbol", case])
	node_of(["type", ["attribute", variants_word, variants, ["symbol", name]], ["list", "{", ""]])
}

# `Color.Red` of a case Color declares: Red
case_of(owner: Node, case: Node, n: Node, enums: any): Node := {
	if not is_name(owner) or not is_name(case) or name_of(owner) not in enums { return n }
	if name_of(case) in enums[name_of(owner)] then case else n
}

# Swift's `.north`, and its arm `case .north:` read as the member `case.north`: north of the one enum having it
implicit_case(owner: Node, case: Node, n: Node, enums: any): Node := {
	if not (owner == ø or owner == symbol(case_word)) or not is_name(case) { return n }
	if owner_of(name_of(case), enums) != ø then case else n
}

# `match value { arms }`, lowered as node_matches.warp lowers a written one: this pass runs after it
match_over(value: Node, arms: list, enums: any): Node := matched(value, arms, ø, case_names_of(enums))

# The number of a case counting the first as `first`: `2` of `Dime` from 0, a match over the cases for a name of the
# enum type
case_number(value: Node, cases: list, first: int, enums: any): Node := {
	numbers = 1 to #cases
	if is_name(value) and name_of(value) in cases { return numbers.filter(i => cases#i == name_of(value))#1 - 1 + first }
	match_over(value, numbers.map(i => Key(symbol(cases#i), Op.Colon, i - 1 + first)), enums)
}

# The case at an index: `Dime` of `2`, a match over the indexes for any other value, an error past the cases
case_at(value: Node, enum_name: text, enums: any): Node := {
	cases = enums[enum_name]
	no_case = " is no " + enum_name + " case"
	if value is int {
		return if value >= 0 and value < #cases then symbol(cases#(value + 1)) else error_node("" + value + no_case)
	}
	raised = List([symbol(raise_word), Key(value, Op.Add, no_case)], Bracket.None, Separator.Space)
	arms = (1 to #cases).map(i => Key(i - 1, Op.Colon, symbol(cases#i)))
	match_over(value, arms + [Key(symbol(other_arm), Op.Colon, raised)], enums)
}

# `Coin.Dime as int` the case's index, `as position` its position, `2 as Coin` the case at an index; `op as text` of
# node.warp's spelled enums its spelling (node_cases.warp converted the other values to them already); other
# conversions as they are
case_conversion(value: Node, target: Node, n: Node, enums: any, subjects: any): Node := {
	if not is_name(target) { return n }
	target_name = name_of(target)
	if target_name in enums { return case_at(value, target_name, enums) }
	enum_name = type_of(value, enums, subjects)
	if enum_name != ø and enum_name in spelled_enums and target_name in text_types { return held_text(enum_name, value) }
	if enum_name == ø or target_name not in count_types { return n }
	case_number(value, enums[enum_name], count_types[target_name], enums)
}

# `c is Coin`, type_tests.warp's is_type(c, "Coin"): c is one of Coin's cases, as Rust's sum type test
case_test(value: Node, cases: list): Node := {
	tested = Key(value, Op.Eq, symbol(cases#1))
	for case in cases[1..] { tested = Key(tested, Op.Or, Key(value, Op.Eq, symbol(case))) }
	tested
}

# is_type(value, "Coin") of a declared enum: the test of its cases, else as it is
enum_type_test(items: list, n: Node, enums: any): Node := {
	if #items != 3 or items#1 != symbol("is_type") { return n }
	enum_name = "" + items#3
	if enum_name in enums then case_test(items#2, enums[enum_name]) else n
}

enum_node(n: Node, enums: any, subjects: any): Node := match n {
	Key(owner, Op.Dot, case): {
		cased = case_of(owner, case, n, enums)
		if cased == n then implicit_case(owner, case, n, enums) else cased
	}
	Key(owner, Op.Scope, case): case_of(owner, case, n, enums)
	Key(value, Op.As, target): case_conversion(value, target, n, enums, subjects)
	Key(left, Op.Eq, right): held_equality(left, Op.Eq, right, n, subjects)
	Key(left, Op.Ne, right): held_equality(left, Op.Ne, right, n, subjects)
	List(items, Bracket.Round, separator): {
		if #items == 2 and is_name(items#1) and name_of(items#1) in enums then case_at(items#2, name_of(items#1), enums)
		else enum_type_test(items, n, enums)
	}
	_: {
		declared = declared_enum(n)
		if declared == ø then n else enum_type(declared#1, declared#2)
	}
}

plain_enums(program: Node): Node := {
	enums = enums_in(program, {})
	if #enums.keys == 0 { return program }
	scoped_enum_nodes(program, enums, held_cases(program, enums, {}))
}
