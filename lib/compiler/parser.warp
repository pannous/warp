// The parser written in warp (card self-parser, notes/self_hosting.md step 6): a source's tree as nodes
// (lib/compiler/shapes.warp), each word next to its Rust twin in src/warp_parser (tests/parser/test_self_parser.rs),
// which compares its view (tests/common/twins.rs node_view)
use "lexer.warp"
use "shapes.warp"
use "words.warp"
use "sugar.warp"
use "foreign_forms.warp"

class Parser { code: text; n: int; at: int; header: bool; iterable: bool; indent: int; spaces: bool; branch: bool; branch_power: int; grouped: bool; enum_cases: bool; resumes: list; breaks: list; finally_blocks: int; types: list; bangs: list; type_body: bool; operators: list; aliases: list }

// The view of a source's tree, as the twins compare it and the self-hosted pipeline hands it on
def tree(source) := view_of(parsed(source))

// The tree of a source: one statement as itself, several as a list
// Rust twin: WarpParser::parse
def parsed(source) {
	try {
		written = written_tree(source)
		counted(written, scope_of(written), [])
	} catch failure {
		error_node(failure.message)
	}
}

// The tree as the source writes it, before the count words (lib/compiler/sugar.warp counted)
def written_tree(source) {
	found = gaps(source, source.length)
	p = Parser{code: source, n: source.length, at: 0, header: false, iterable: false, indent: 0, spaces: false, branch: false, branch_power: 0, grouped: false, enum_cases: false, resumes: found.resumes, breaks: found.breaks, finally_blocks: 0, types: declared_type_names(source), bangs: bang_words(source), type_body: false, operators: scanned_operators(source), aliases: operator_aliases(source) + math_operator_aliases()}
	items(p, ' ', "")
}

// The names glued to `!` a source defines as words of their own: `def is!(warp, expected) := …`, `is!(…) := …`;
// any other `!` after a name stays a suffix (`x!`), a macro (`println!(…)`) or `!=` (card parser-reads-2)
// Rust twin: declaration_scan.rs defined_name, lookahead.rs defines_bang_word
def bang_words(source) {
	found = []
	for line in source.split("\n") {
		at = blank_end_of(line, 0)
		if starts_at(line, "def ", at) { at = blank_end_of(line, at + 4) }
		end = name_end(line, at, line.length)
		if end > at and starts_at(line, "!(", end) { found += [line[at .. end] + "!"] }
	}
	found
}
def blank_end_of(line, from) {
	at = from
	while at < line.length and (line[at] == ' ' or line[at] == '\t') { at = at + 1 }
	at
}
// the prelude's bang words, scanned the first time a `name!` needs them: scanning the prelude on every parse made the
// front stage 5× slower (card front-stage-5x-slower)
global prelude_bangs = ø
def prelude_bang_words() {
	if prelude_bangs == ø { prelude_bangs = bang_words(module_source("prelude")) }
	prelude_bangs
}

// The width of the bang word at the parser's position (`is!`), else 0
def bang_word_at(p) {
	end = name_end(p.code, p.at, p.n)
	if end == p.at or not is_at(p.code, end, '!', p.n) or is_at(p.code, end + 1, '=', p.n) { return 0 }
	word = p.code[p.at .. end] + "!"
	if p.bangs contains word or prelude_bang_words() contains word then end + 1 - p.at else 0
}

// `{if: 4, from: 1 to: 2}`: a keyword or operator word glued to a key's colon names the key; `else:`, `then:` and
// `do:` open blocks
// Rust twin: lookahead.rs word_names_key, BLOCK_COLON_WORDS
BLOCK_COLON_WORDS = ["then", "else", "do"]
def word_names_key(p, word) {
	after = p.at + word.length
	word != "" and not BLOCK_COLON_WORDS.contains(word) and is_at(p.code, after, ':', p.n) and not is_at(p.code, after + 1, ':', p.n) and not is_at(p.code, after + 1, '=', p.n)
}

// The blank-separated words of the statement at the parser's position
def statement_words_at(p) {
	end = p.at
	while end < p.n and p.code[end] != '\n' and p.code[end] != ';' { end = end + 1 }
	blank_words(p.code[p.at .. end])
}
// `operator × := *`, `prefix operator √ := sqrt` (lib/math.warp): another spelling of a built-in operator, a statement
// declaring nothing (the pre-scan made the spelling an operator: operator_aliases)
// [spelling, target] of an alias statement's words (`operator ∧ := and`, `prefix operator √ := sqrt`), else []
// Rust twin: aliases.rs alias_line
def operator_alias(words) {
	if words.length > 0 and words#1 == "prefix" { words = words[1 .. words.length] }
	if words.length == 4 and words#1 == "operator" and words#3 == ":=" and is_operator_spelling(words#4) then [words#2, words#4] else []
}
// [spelling, target] of each operator alias a source declares
// Rust twin: aliases.rs source_aliases
def operator_aliases(source) {
	found = []
	if not source.contains(":=") { return found }
	for statement in code_statements(source) {
		alias = operator_alias(blank_words(statement))
		if alias.length > 0 { found += [alias] }
	}
	found
}
// lib/math.warp's aliases, which every program reads (decision operator-alias), scanned the first time a parse needs them
// Rust twin: aliases.rs math_aliases
global math_aliases = ø
def math_operator_aliases() {
	if math_aliases == ø { math_aliases = operator_aliases(module_source("math")) }
	math_aliases
}
// The canonical names of the alias targets parser.warp's operator lists spell otherwise
// Rust twin: spellings.rs OPERATOR_SPELLINGS ("approximately", "+-", "<-")
ALIAS_TARGET_NAMES = {"approximately": "≈", "+-": "±", "<-": "="}
// The canonical name of the operator an alias spells, else ""
def canonical_operator(target) {
	for op in SYMBOL_OPERATORS { if op#1 == target { return op#2 } }
	for op in WORD_OPERATORS { if op#1 == target { return op#2 } }
	if ALIAS_TARGET_NAMES.has(target) then ALIAS_TARGET_NAMES[target] else ""
}
// The alias written at the parser's position as [spelling, target], a word one as a whole word, the longest, else []
def alias_at(p) {
	longest = []
	for alias in p.aliases {
		spelled = alias#1
		here = starts_at(p.code, spelled, p.at) and not (is_name_start(spelled[0]) and is_at_name_char(p, p.at + spelled.length))
		if here and (longest.length == 0 or spelled.length > longest#1.length) { longest = alias }
	}
	longest
}
// The infix operator an alias at the parser's position spells, as [written, canonical], else []
def aliased_operator_at(p) {
	alias = alias_at(p)
	canonical = if alias.length == 0 then "" else canonical_operator(alias#2)
	if canonical == "" then [] else [alias#1, canonical]
}
// A spelling of a built-in operator: symbols (`*`, `/!=`, `->`), or an operator word (`and`, `in`, `sqrt`)
// Rust twin: spellings.rs table_operator, PREFIX_OPERATOR_WORDS
def is_operator_spelling(word) {
	if not is_name_start(word[0]) { return true }
	for op in WORD_OPERATORS { if op#1 == word { return true } }
	form = keyword_form(word)
	PREFIX_OPERATORS.contains(form) or form == "contains" or word == "in" or word == "approximately"
}
// The statement at the parser's position skipped: ø
def skip_statement(p) {
	while p.at < p.n and p.code[p.at] != '\n' and p.code[p.at] != ';' { p.at = p.at + 1 }
	ø
}

// The words a type's name follows where it is declared
// Rust twin: mod.rs TYPE_DECLARATION_WORDS, RECORD_WORD
TYPE_SCAN_WORDS = ["class", "struct", "record", "type"]

// The type names a source declares: the word after class, struct, record or type within a line, outside comments
// and texts, with nothing or a bracket, `:` or `;` glued after it (`record = find(…)` declares nothing)
// Rust twin: declaration_scan.rs scan_declared_types
def declared_type_names(source) {
	type_names = []
	for line in code_only(source).split("\n") {
		previous = ""
		for word_written in line.replace("\t", " ").split(" ") {
			if word_written == "" { continue }
			if TYPE_SCAN_WORDS.contains(previous) {
				end = symbol_end(word_written, 0, word_written.length)
				if end > 0 and (end == word_written.length or "({<[:;".contains(word_written[end])) { type_names += [word_written[0 .. end]] }
			}
			previous = word_written
		}
	}
	type_names
}

// The keyword forms: each word with a form of its own and the form's shape; a prefix word's shape is the operator it
// spells (`sqrt x` is `√x`), a constant word's the constant (any case: `True`, `NULL`)
// Rust twin: atoms.rs keyword_form, expressions.rs parse_expr, if_else.rs, conditions.rs, warp_parser check_constants
KEYWORD_FORMS = {"return": "return", "if": "condition", "while": "condition", "for": "loop", "loop": "endless",
	"class": "type", "struct": "type", "type": "type", "global": "global", "export": "global", "not": "not",
	"sqrt": "√", "cbrt": "∛", "abs": "‖", "elif": "else if", "elsif": "else if", "elseif": "else if",
	"where": "clause", "match": "clause", "switch": "clause", "contains": "contains", "has": "contains",
	"includes": "contains", "function": "reference", "func": "reference", "true": "true", "yes": "true",
	"false": "false", "no": "false", "null": "empty", "nul": "empty", "none": "empty", "nil": "empty", "nill": "empty",
	"nix": "empty", "nada": "empty", "nothing": "empty", "empty": "empty", "void": "empty"}
PREFIX_OPERATORS = ["√", "∛", "‖"]

// The shape of the keyword form `word` opens, else ""
def keyword_form(word) := if word in KEYWORD_FORMS then KEYWORD_FORMS[word] else ""

// The name at the parser's position, "" before anything else
def word_at(p) := p.code[p.at .. name_end(p.code, p.at, p.n)]

// The items up to `closer` (' ' for the end of the source), grouped by their separators; outside brackets the lines
// indented below an item are its body (`repeat⏎⇥x` is `repeat: x`) and a line indented less ends the items
// Rust twin: lists.rs parse_list_with_separators
def items(p, closer, bracket) {
	found = []
	opener = p.at - 1
	outer_branch = p.branch
	outer_grouped = p.grouped
	p.branch = false
	p.grouped = p.grouped or closer != ' '
	while true {
		skip_blanks(p)
		if p.at >= p.n {
			if closer != ' ' { raise "`" + closer + "` is missing: the group opened at " + line_and_column(p.code, opener) + " runs to the end of the input" }
			break
		}
		c = p.code[p.at]
		if c == closer {
			p.at = p.at + 1
			break
		}
		stray = c == ')' or c == ']' or c == '}'
		if stray and closer != ' ' { raise "`" + c + "` closes the group opened at " + line_and_column(p.code, opener) + ", which needs `" + closer + "`" }
		// the lines indented inside a group end at its closer: `{ for x in xs:⏎    a }`
		if stray and p.grouped { break }
		if stray { raise "`" + c + "` closes no group" }
		before = p.at
		item = if follows_clause_word(found) then header_expression(p, 0) else expression(p, 0)
		tabbed = tab_separates(p)
		newline = skip_blanks(p)
		if bracket == "" and newline and line_indent(p) > p.indent {
			body = lines_below(p)
			lines = group_parts(body)
			item = Key(item, Op.Colon, if lines != ø and lines#1 == "" and lines#2 == "\n" then listed("{", "\n", lines#3) else body)
			newline = skip_blanks(p)
		}
		dedent = bracket == "" and newline and line_indent(p) < p.indent
		after = if dedent then "" else separator(p, closer, newline)
		if tabbed and after == " " { after = "\t" }
		found += [[field_holding_lambda(statement), after] for statement in statements_of(item)]
		if dedent { break }
		if p.at == before { p.at = p.at + 1 }
	}
	p.branch = outer_branch
	p.grouped = outer_grouped
	grouped(found, bracket)
}

// `match f(x) {…}`: the subject after a clause word ends before the block, no call `f(x) {…}` takes it
// Rust twin: conditions.rs ends_with_clause_word
def follows_clause_word(found) {
	if found.length == 0 { return false }
	previous = found#(found.length)#1
	previous is symbol and keyword_form(name_of(previous)) == "clause"
}

// `line:column` of the character at `at`, both from 1
def line_and_column(code, at) {
	line = 1
	start = 0
	for i in 0 ..< at {
		if code[i] == '\n' {
			line = line + 1
			start = i + 1
		}
	}
	"" + line + ":" + (at - start + 1)
}

// The indent of the parser's position on its line: its tabs, its spaces too inside a block indented by spaces
// Rust twin: scanning.rs skip_whitespace
def line_indent(p) {
	at = p.at
	indent = 0
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') {
		at = at - 1
		if p.code[at] == '\t' or p.spaces { indent = indent + 1 }
	}
	indent
}

// The items of the lines indented below, the parser at the line they end before
// Rust twin: lists.rs parse_list_with_separators (indented block), blocks.rs parse_indented_block
def lines_below(p) {
	outer = p.indent
	p.indent = line_indent(p)
	block = items(p, ' ', "")
	p.indent = outer
	// the line break after the block still separates the next statement
	while p.at > 0 and is_blank(p.code[p.at - 1]) { p.at = p.at - 1 }
	block
}

// The block indented below a head that ends its line, `for x in xs:` and its lines; ø with nothing read if none
// Rust twin: blocks.rs parse_indented_block, curly_block
def indented_block(p) {
	before = p.at
	outer_spaces = p.spaces
	newline = skip_blanks(p)
	p.spaces = outer_spaces or p.code[p.at - line_blanks(p) .. p.at].contains(" ")
	if not newline or line_indent(p) <= p.indent {
		p.spaces = outer_spaces
		p.at = before
		return ø
	}
	block = lines_below(p)
	p.spaces = outer_spaces
	lines = group_parts(block)
	if lines != ø and lines#1 == "" { return listed("{", lines#2, lines#3) }
	listed("{", "", [block])
}

def line_blanks(p) {
	at = p.at
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') { at = at - 1 }
	p.at - at
}

// Only blanks follow `at` on its line
def ends_line(p, at) := line_ends_after(p, at)

// The body after `:` or `do`: the block indented below when the line ends, else the rest of the line
// Rust twin: blocks.rs colon_body
def colon_body(p, width) {
	p.at = p.at + width
	if only_blanks_before_newline(p) {
		block = indented_block(p)
		if block != ø { return block }
	}
	skip_spaces(p)
	statement_words(p)
}

// The separator after an item, consumed: "," ";" a newline, a blank, or "" before the closer
// Rust twin: lists.rs parse_separator
def separator(p, closer, newline) {
	if p.at >= p.n or p.code[p.at] == closer { return "" }
	c = p.code[p.at]
	if c == ',' {
		p.at = p.at + 1
		return ","
	}
	if c == ';' {
		p.at = p.at + 1
		return if only_blanks_before_newline(p) then "\n" else ";"
	}
	if newline then "\n" else " "
}

def only_blanks_before_newline(p) := line_ends_after(p, p.at)

// A tab between two items of a line separates columns: `'1+1'⇥2` is a list of two (tab-separated test pairs);
// indentation and a tab before a comment or the line's end separate nothing
// Rust twin: scanning.rs at_tab_separator
def tab_separates(p) {
	start = p.at - line_blanks(p)
	end = blank_end(p, p.at)
	if start == 0 or p.code[start - 1] == '\n' or line_ends_after(p, p.at) { return false }
	at = start
	while at < end {
		if p.code[at] == '\t' { return true }
		at = at + 1
	}
	false
}

// How loosely a separator groups: a blank tightest, a newline loosest, "" (the end) never
def precedence(separator) {
	if separator == " " { return 0 }
	if separator == "," { return 2 }
	if separator == ";" { return 3 }
	if separator == "\t" { return 4 }
	if separator == "\n" { return 5 }
	255
}

// [[item, separator], …] as one list: the loosest separator splits first, the groups between split by the tighter ones
// Rust twin: lists.rs group_by_separators
def grouped(pairs, bracket) {
	if pairs.length == 0 { return if bracket == "{" then listed("{", "", []) else ø }
	if pairs.length == 1 and bracket == "" { return pairs#1#1 }
	loosest = -1
	for pair in pairs {
		level = precedence(pair#2)
		if level < 255 and level > loosest { loosest = level }
	}
	if loosest < 0 { return phrase(bracket, [pair#1 for pair in pairs]) }
	split = ""
	for pair in pairs {
		if split == "" and precedence(pair#2) == loosest { split = pair#2 }
	}
	groups = []
	group = []
	for pair in pairs {
		if precedence(pair#2) == loosest {
			group += [[pair#1, ""]]
			groups += [group]
			group = []
		} else {
			group += [pair]
		}
	}
	if group.length > 0 { groups += [group] }
	nodes = [if group.length == 1 and group#1#2 == "" then group#1#1 else grouped(group, "") for group in groups]
	if nodes.length == 1 and bracket == "" { return nodes#1 }
	if split == " " { return phrase(bracket, nodes) }
	if split == "," { return comma_list(bracket, nodes) }
	listed(bracket, split, nodes)
}

// Words side by side; `print ord c` and `{ print ord c }` print the rest of the line as one value
// Rust twin: commands.rs grouped_list
def phrase(bracket, nodes) {
	if not (bracket == "" or bracket == "{") or nodes.length < 3 or nodes#1 != PRINT { return listed(bracket, " ", nodes) }
	listed(bracket, " ", [nodes#1, listed("", " ", nodes[1:])])
}
PRINT = symbol("print")

// `print a, b` and `{ print i, i*2 }`: the comma binds looser than the space, so [[print a], b] is the call print(a, b)
// Rust twin: commands.rs grouped_list, print_call
def comma_list(bracket, nodes) {
	head = group_parts(nodes#1)
	if not (bracket == "" or bracket == "{") or not prints(head) { return listed(bracket, ",", nodes) }
	call = listed("(", "", [PRINT] + head#3[1:] + nodes[1 ..])
	if bracket == "{" then listed("{", "", [call]) else call
}

// The parts of an unbracketed phrase `print a`
def prints(phrase) := phrase != ø and phrase#1 == "" and phrase#2 == " " and #phrase#3 > 0 and phrase#3#1 == PRINT

// Spaces, tabs, newlines and comments skipped; whether a newline was among them
// Rust twin: scanning.rs skip_whitespace_and_comments
def skip_blanks(p) {
	newline = line_breaks_after(p, p.at)
	p.at = p.resumes[p.at]
	newline
}

// A line break lies between `at` and the code after it, or the source ends there
def line_ends_after(p, at) := p.resumes[at] >= p.n or line_breaks_after(p, at)
def line_breaks_after(p, at) := p.breaks[at] == true

// The character the code goes on with after `at` and its blanks and comments: '\n' where the line ends first
def code_after(p, at) := if line_ends_after(p, at) then '\n' else p.code[p.resumes[at]]

def skip_spaces(p) {
	p.at = blank_end(p, p.at)
}

// An expression of operators binding at least `min_power` on the left
// Rust twin: expressions.rs parse_expr, continue_expr
def expression(p, min_power) := continued(p, prefixed(p), min_power)

// The head of `if`, `while` or `for`: a `{` after it opens the body, so `f(x) {` calls f rather than defining it
def header_expression(p, min_power) {
	outer = p.header
	p.header = true
	head = expression(p, min_power)
	p.header = outer
	head
}

// `left` and the operators after it binding at least `min_power`
// Rust twin: expressions.rs continue_expr
def continued(p, left, min_power) {
	while true {
		if tab_separates(p) { break }
		skip_spaces(p)
		c = peek(p.code, p.at, p.n)
		// `cd ~/notes`: a path after an operand is the next word, no operator
		if starts_path(p) { return left }
		if c == '@' and left != ø and min_power <= binding_powers("=")#2 {
			marked = trailing_attribute(p, left)
			if marked != ø {
				left = marked
				continue
			}
		}
		user_op = user_operator_at(p)
		if user_op != ø and user_op#2 != "prefix" and user_op#3 >= min_power {
			p.at = p.at + user_op#1.length
			if user_op#2 == "suffix" {
				left = operator_call(user_op#1, [left])
			} else {
				skip_blanks(p)
				left = operator_call(user_op#1, [left, expression(p, user_op#3 + 1)])
			}
			continue
		}
		// a declared operator binding looser than the context ends the operand, unless a built-in one of the glyph binds
		if user_op != ø and user_op#2 != "prefix" and operator_at(p).length == 0 { break }
		power = superscript_power(p, left, min_power)
		if power != ø {
			left = power
			continue
		}
		if (c == '+' or c == '-') and is_at(p.code, p.at + 1, c, p.n) and SUFFIX_POWER >= min_power {
			op = p.code[p.at .. p.at + 2]
			p.at = p.at + 2
			left = keyed(op, left, ø)
		} else if c == '!' and SUFFIX_POWER >= min_power and bang_suffix_at(p) {
			p.at = p.at + 1
			fully = is_at(p.code, p.at, '!', p.n) and not is_at(p.code, p.at + 1, '=', p.n)
			if fully { p.at = p.at + 1 }
			left = forced(left, fully)
		} else if c == '[' and p.at > 0 and not is_blank(p.code[p.at - 1]) and INDEX_POWER >= min_power {
			p.at = p.at + 1
			skip_blanks(p)
			index = slice_from_start(p)
			if index == ø { index = expression(p, 0) }
			skip_blanks(p)
			if is_at(p.code, p.at, ']', p.n) { p.at = p.at + 1 }
			left = subscript(left, index)
		} else if left != ø and keyword_at(p, "times") and times_binds(p, min_power) {
			p.at = p.at + 5
			skip_spaces(p)
			left = listed("", " ", [left, symbol("times"), repeated(p)])
		} else if floor_division_at(p).length > 0 {
			written = floor_division_at(p)
			powers = binding_powers("/")
			if written == "/!=" { powers = binding_powers("=") }
			if powers#1 < min_power { break }
			p.at = p.at + written.length
			skip_blanks(p)
			right = expression(p, powers#2)
			// `a /!= b` is the assignment `a = floor_quotient(a, b)`
			left = if written == "/!=" then Key(left, Op.Assign, quotient_call(left, right)) else quotient_call(left, right)
		} else if membership_at(p).length > 0 and not counts_units(left) {
			membership = membership_at(p)
			if 115 < min_power { break }
			p.at = p.at + membership#1.length
			skip_blanks(p)
			left = listed("", " ", [left, symbol(membership#2), expression(p, 116)])
		} else if negated_is_at(p).length > 0 {
			// `x is not 4` and `x isn't 4` are `not (x is 4)` (Rust twin: spellings.rs NEGATED_SPELLINGS)
			powers = binding_powers("is")
			if powers#1 < min_power { break }
			p.at = p.at + negated_is_at(p).length
			skip_blanks(p)
			left = Key(ø, Op.Not, Key(left, Op.Is, expression(p, powers#2)))
		} else if down_to_at(p) > 0 {
			// `10 down to 1` is `reverse(1 to 10)`, which for_loop counts down (Rust twin: ranges.rs binary_node)
			powers = binding_powers("to")
			if powers#1 < min_power { break }
			p.at = p.at + down_to_at(p)
			skip_blanks(p)
			left = listed("(", "", [symbol("reverse"), Key(expression(p, powers#2), Op.To, left)])
		} else {
			op = operator_at(p)
			if op.length == 0 and free_infix_at(p, left) {
				if OPERATOR_LEVELS["infix"] < min_power { break }
				glyph = "" + c
				p.at = p.at + 1
				skip_blanks(p)
				left = operator_call(glyph, [left, expression(p, OPERATOR_LEVELS["infix"] + 1)])
				continue
			}
			if op.length == 0 {
				if not applies(p, left, min_power) { break }
				left = listed("", " ", [left, argument(p, not applies_otherwise(p, min_power))])
				continue
			}
			powers = binding_powers(op#2)
			// one arrow, but `=>` binds as written: its body takes an assignment (Rust twin: Op::spelled_binding_power)
			if op#1 == "=>" { powers = binding_powers("=>") }
			if powers#1 < min_power { break }
			p.at = p.at + op#1.length
			// `f(n):` ending its line: the block indented below is its value
			block = if op#1 == ":" and ends_line(p, p.at) then indented_block(p) else ø
			if block != ø {
				left = Key(left, Op.Colon, block)
				continue
			}
			skip_blanks(p)
			if ELEMENT_WISE_OPERATORS contains op#1 {
				left = listed("", " ", [left, symbol(op#1), expression(p, powers#2)])
			} else if DECLARED_ONLY_OPERATORS contains op#2 {
				left = operator_call(op#2, [left, expression(p, powers#2)])
			} else {
				left = keyed(op#2, left, if op#2 == "then" or op#2 == "else" then branch(p, powers#2) else expression(p, powers#2))
			}
		}
	}
	left
}

// `n times {…}` binds below assignment, `n times [x]` to the count before it, `it times it` like `*`
// Rust twin: suffixes.rs try_parse_control_suffix
def times_binds(p, min_power) {
	at = blank_end(p, p.at + 5)
	c = peek(p.code, at, p.n)
	value_follows = is_digit(c) or c == '"' or c == '\'' or is_name_start(c)
	min_power <= TIMES_POWER or c == '[' or (value_follows and min_power <= 150)
}

TIMES_POWER = 50

// What `n times` repeats: a block, `: body` as a block, a list or a value
// Rust twin: suffixes.rs parse_times_loop
def repeated(p) {
	if is_at(p.code, p.at, ':', p.n) {
		body = colon_body(p, 1)
		return if is_block(body) then body else listed("{", ";", [body])
	}
	atom(p)
}

// `thrice {…}`, `twice "ab"`: the count word and what follows as written, else ø; `twice {a: 1}` stays the call,
// `def twice {…}` the definition; the scope pass (sugar.warp counted) makes it `3 times {…}` unless the program
// gives the word a meaning of its own (card parser-scope-pass)
// Rust twin: control/loops.rs try_parse_count_word
def count_worded(p) {
	if p.at > 0 and p.code[p.at - 1] == '.' { return ø }
	if function_keywords contains word_before(p) { return ø }
	for word in COUNT_WORDS {
		if keyword_at(p, word#1) {
			at = blank_end(p, p.at + word#1.length)
			c = peek(p.code, at, p.n)
			if c != '{' and c != '[' and c != '"' and c != '\'' { return ø }
			start = p.at
			p.at = at
			body = repeated(p)
			if counts_pairs(body) {
				p.at = start
				return ø
			}
			return listed("", " ", [symbol(word#1), body])
		}
	}
	ø
}

// The name before the parser's position and blanks, else ""
// Rust twin: definitions/functions.rs after_function_keyword_word
def word_before(p) {
	end = p.at
	while end > 0 and is_blank(p.code[end - 1]) { end = end - 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start = start - 1 }
	p.code[start .. end]
}

// `7 /! 2`, `x /!= 2`, `7 div 2`: the floor division written at the parser's position, else ""; `//` is a comment
// Rust twin: operators/spellings.rs `/!`, `/!=`, `div`
def floor_division_at(p) {
	if keyword_at(p, "div") and not opens_block(p, 3) { return "div" }
	if starts_at(p.code, "/!=", p.at) { return "/!=" }
	if starts_at(p.code, "/!", p.at) { return "/!" }
	""
}

// A block opens after the `width` characters at the parser's position and blanks: `div {…}` is the html tag
def opens_block(p, width) {
	is_at(p.code, blank_end(p, p.at + width), '{', p.n)
}

// `is not`, `isn't` at the parser's position, else ""
def negated_is_at(p) {
	for word in ["is not", "isn't", "isn’t"] {
		if keyword_at(p, word) { return word }
	}
	""
}

// `x in xs`, `xs contains x`: the membership word at the parser's position as [written, word], else []; `x is in xs` is
// `x in xs`
// Rust twin: expressions.rs special_infix
def membership_at(p) {
	if keyword_at(p, "is in") { return ["is in", "in"] }
	if keyword_at(p, "in") { return ["in", "in"] }
	word = word_at(p)
	if keyword_form(word) == "contains" and operand_after(p, word.length) and not assigned_at(p, p.at + word.length) { return [word, word] }
	// `x ∈ xs`, `xs ∋ x`: an alias of a membership word
	alias = alias_at(p)
	if alias.length > 0 and (alias#2 == "in" or keyword_form(alias#2) == "contains") { return alias }
	[]
}

// A unit word stays in the flat counting phrase `number of chars in t`
// Rust twin: counting.rs text_unit
def counts_units(left) := left is symbol and UNIT_WORDS.contains(name_of(left))

UNIT_WORDS = ["byte", "bytes", "char", "chars", "character", "characters", "codepoint", "codepoints", "grapheme", "graphemes"]

// An operand follows `width` characters on: blanks, then no end of the expression
// Rust twin: scanning.rs operand_after
// `alias contains = collection_contains`: an assignment's `=` (no `==`) after the blanks at `at`
def assigned_at(p, at) {
	sign = blank_end(p, at)
	is_at(p.code, sign, '=', p.n) and not is_at(p.code, sign + 1, '=', p.n)
}
def operand_after(p, width) {
	at = p.at + width
	if not (is_at(p.code, at, ' ', p.n) or is_at(p.code, at, '\t', p.n)) { return false }
	not "\n)]};,".contains(code_after(p, at))
}

// `x = f y`, `1 + count xs`: a name before an operand is called with it, as an assignment's value, in an operand from
// `or` up to `+` (not in an argument, a loop header or before `for`) or with an argument that is no name
// Rust twin: suffixes.rs try_parse_implicit_application
def applies(p, left, min_power) {
	if min_power == 0 or min_power > 151 { return false }
	callable = left is symbol or is_list_of(left, "")
	if not callable { return false }
	c = peek(p.code, p.at, p.n)
	if c == '{' and p.header { return false }
	in_operand = min_power >= OPERAND_POWERS#1 and min_power <= OPERAND_POWERS#2 and min_power != ARGUMENT_POWER and not p.iterable and not word_begins_item(p)
	(applies_otherwise(p, min_power) or in_operand) and (unnamed_at(p) or is_name_start(c))
}

// The word here begins what follows the operand: a loop clause, a block's `end`, a key (`_: 0`) or an element (`p{m}`)
// Rust twin: suffixes.rs word_begins_item
def word_begins_item(p) {
	if keyword_at(p, "for") or keyword_at(p, "end") or else_if_at(p) { return true }
	at = p.at
	while at < p.n and is_name_char(p.code[at]) { at = at + 1 }
	if at == p.at { return false }
	c = peek(p.code, at, p.n)
	next = peek(p.code, at + 1, p.n)
	c == '{' or (c == ':' and not (next == ':' or next == '='))
}

// An assignment's value, a branch or an argument that is no name is called with whatever the operand is
def applies_otherwise(p, min_power) := min_power <= 60 or min_power == p.branch_power or unnamed_at(p)

def unnamed_at(p) {
	c = peek(p.code, p.at, p.n)
	is_digit(c) or c == '"' or c == '\'' or c == '(' or c == '[' or c == '{' or c == '-'
}

// The argument of a braceless call; `while i < count t {…}`: a block after an operand's argument is the body
def argument(p, block_ends) {
	outer = p.header
	p.header = outer or block_ends
	value = expression(p, ARGUMENT_POWER)
	p.header = outer
	value
}

// The operands a braceless call binds in: the right sides of `or` to `+`
OPERAND_POWERS = [91, 141]

// A braceless argument takes arithmetic and ranges, stops at comparisons: `f 3-1 > 5`, `y = sum 1..4`
ARGUMENT_POWER = 130

// The marks of a slice from the start, `xs[:3]`, `xs[...3]`, each with its operator
// Rust twin: subscripts.rs SLICE_FROM_START
SLICE_FROM_START = [[":", ":"], ["…", "to"], ["...", "to"], ["..", ".."]]

// `[:end]`, `[...last]`, `[..end]`, `[:]`: a slice from the start, `ø:end`, else ø with nothing read
// Rust twin: subscripts.rs parse_slice_from_start
def slice_from_start(p) {
	for mark in SLICE_FROM_START {
		if starts_at(p.code, mark#1, p.at) {
			p.at = p.at + mark#1.length
			skip_blanks(p)
			if is_at(p.code, p.at, ']', p.n) { return keyed(mark#2, ø, ø) }
			return keyed(mark#2, ø, expression(p, 0))
		}
	}
	ø
}

// Below member access and indexing: `xs#1++`, `xs#2!`
SUFFIX_POWER = 165

// The `!` at the parser's position is the suffix `x!`, not a `!=` nor a prefix `!` of the operand after it: glued to
// its operand and followed by a blank, an infix operator or `)` (`name! email?`, `x!+1`), or no operand follows
// Rust twin: suffixes.rs try_parse_evaluate_bang
def bang_suffix_at(p) {
	next = peek(p.code, p.at + 1, p.n)
	if next == '=' { return false }
	glued = p.at > 0 and not is_blank(p.code[p.at - 1]) and " \t!+-*/%^<>)".contains(next)
	glued or not operand_follows(p, 1)
}

// `left!` (`left!!` when fully): `x.upper!` and `upper x!` mark their name for mutation.rs, `upper(x)!` assigns the
// result back to x, `{…}!` runs the block anyway, `ø!` unwraps
// Rust twin: suffixes.rs try_parse_evaluate_bang
def forced(left, fully) {
	if left == ø { return listed("(", "", [symbol("unwrap"), ø]) }
	variable = mutated_variable(left)
	if variable != ø and not is_member(left) { return Key(variable, Op.Assign, left) }
	if is_block(left) { return left }
	attributed("mutated", if fully then 2 else true, left)
}

def is_member(node) := match node {
	Key(receiver, Op.Dot, member): yes
	_: no
}

// The variable a call written before `!` changes: x in `x.upper`, `x.upper()` and `upper(x)`
// Rust twin: mutation.rs mutated_variable
def mutated_variable(call) := match call {
	Key(receiver, Op.Dot, method): { if receiver is symbol and is_method(method) then receiver else ø }
	List(parts, Bracket.Round, separator): { if #parts == 2 and parts#1 is symbol and parts#2 is symbol then parts#2 else ø }
	_: ø
}

def is_method(node) {
	parts = group_parts(node)
	node is symbol or (parts != ø and #parts#3 > 0 and parts#3#1 is symbol)
}
// The left power of `#`, which a glued `[` indexes with
INDEX_POWER = 170

// The operators written with symbols, longest first, each with its canonical name
// Rust twin: lookahead.rs peek_operator, operators.rs Op::as_str
SYMBOL_OPERATORS = [["...", "to"], ["===", "==="], ["!==", "!=="], ["..<", ".."], [".+", "+"], [".-", "-"], [".*", "*"], ["./", "/"], [".^", "^"], ["&&=", "&&="], ["||=", "||="], ["^^=", "^^="], ["**=", "^="], ["÷=", "/!="], ["??", "??"], [":=", ":="], ["~~", "~"], ["::", "::"], ["->", "->"], ["=>", "->"], ["**", "^"], ["+=", "+="], ["-=", "-="], ["*=", "*="], ["/=", "/="], ["%=", "%="], ["^=", "^="], ["<<", "<<"], [">>", ">>"], ["<=", "<="], [">=", ">="], ["==", "=="], ["!=", "!="], ["!", "not"], ["¬", "not"], ["..", ".."], ["&&", "and"], ["||", "or"], [":", ":"], ["=", "="], [".", "."], ["+", "+"], ["±", "±"], ["-", "-"], ["*", "*"], ["×", "*"], ["⋅", "*"], ["/", "/"], ["÷", "/!"], ["%", "%"], ["^", "^"], ["<", "<"], [">", ">"], ["≤", "<="], ["≥", ">="], ["≠", "!="], ["≈", "≈"], ["~", "~"], ["&", "and"], ["|", "or"], ["#", "#"], ["?", "?"], ["…", "to"], ["↑", "↑"], ["↓", "↓"]]
// `xs .* 2` maps `*` over the elements: the phrase [xs .* 2], binding as `*` does (Rust twin: spellings.rs
// element_wise_word)
ELEMENT_WISE_OPERATORS = [".+", ".-", ".*", "./", ".^"]
// The operators written as words, each with its canonical name
WORD_OPERATORS = [["then", "then"], ["else", "else"], ["and", "and"], ["xor", "xor"], ["or", "or"], ["is", "is"], ["do", "do"], ["to", "to"], ["as", "as"], ["mod", "%"], ["modulo", "%"], ["rem", "rem"], ["upto", ".."]]

// The operator at the parser's position as [written, canonical], else []
// (each text read is a walk from its start, card text-costs: the character is read once and picks the candidates)
def operator_at(p) {
	c = peek(p.code, p.at, p.n)
	if is_name_start(c) {
		if bang_word_at(p) > 0 or word_names_key(p, word_at(p)) { return [] }
		for op in WORD_OPERATORS {
			if op#1[0] == c and keyword_at(p, op#1) and not (p.branch and op#1 == "else") { return op }
		}
		return aliased_operator_at(p)
	}
	if starts_at(p.code, "?:", p.at) or starts_at(p.code, "//", p.at) { return [] }
	// `x = 1  # one` is a comment, `xs #1` the index operator (card parser-parses)
	if c == '#' and skipped_end(p.code, p.at, p.n) > p.at { return [] }
	for op in SYMBOL_OPERATORS {
		if op#1[0] == c and starts_at(p.code, op#1, p.at) and (op#1 != ">>" or operand_follows(p, 2)) { return op }
	}
	aliased_operator_at(p)
}

// An operand follows `width` characters on, after any blanks: `n >> 7` shifts, `list<list<int>>` closes two generics
// Rust twin: lookahead.rs operand_follows
def operand_follows(p, width) := operand_follows_at(p, p.at + width)
def operand_follows_at(p, at) := not "\n>)]},;=".contains(code_after(p, at))

// `word` at the parser's position as a whole word
def keyword_at(p, word) := keyword_at_position(p, word, p.at)

// `10 down to 1`: the length of the words `down to` (Kotlin's `downTo`), else 0
// Rust twin: ranges.rs down_to_length
def down_to_at(p) {
	if not keyword_at(p, "down") { return 0 }
	at = blank_end(p, p.at + 4)
	if at > p.at + 4 and keyword_at_position(p, "to", at) then at + 2 - p.at else 0
}

// The operators only a declaration gives meaning (lib/prelude.warp `infix operator ↑`): `2↑3` calls operator_↑(2, 3)
// Rust twin: Op::is_declared_only, word_operators.rs log_calls
DECLARED_ONLY_OPERATORS = ["↑", "↓"]
// The name of the function an operator declaration defines: `infix operator ⊕` defines operator_⊕
// Rust twin: operators/mod.rs OPERATOR_FUNCTION_PREFIX
OPERATOR_FUNCTION_PREFIX = "operator_"
// The words declaring an operator of a kind: `prefix operator ∆`, `infix operator ⊕`; `operator ⊕` alone is infix
// Rust twin: declaration_scan.rs OPERATOR_KINDS, operators.rs declared_kind
OPERATOR_KINDS = ["prefix", "suffix", "infix"]
// How tight a declared operator binds, as the built-ins it resembles: [kind, level]; an infix one's right power is one
// more than its level
// Rust twin: declaration_scan.rs USER_SUFFIX_BP, USER_PREFIX_RIGHT_BP, USER_INFIX_BP
OPERATOR_LEVELS = {"prefix": 155, "suffix": 165, "infix": 140}

// The call of a declared operator's function: `2 ⊕ 3` is operator_⊕(2, 3)
// Rust twin: operators.rs operator_call
def operator_call(glyph, arguments) := listed("(", "", [symbol(OPERATOR_FUNCTION_PREFIX + glyph)] + arguments)

// The kind of operator a declaration's first word declares, else ""
def operator_kind_word(word) := if word == "operator" then "infix" else if OPERATOR_KINDS.contains(word) then word else ""

// A glyph a program may declare as an operator: symbols with a non-ASCII character (`‼`, `⊕`), no letter or digit;
// raised digits too (`suffix operator ³`)
// Rust twin: operators.rs is_operator_glyph
def is_operator_glyph(glyph) {
	beyond_ascii = false
	at = 0
	while at < glyph.length {
		c = glyph[at]
		if not SUPERSCRIPT_DIGITS.contains(c) and (is_name_char(c) or is_digit(c) or is_blank(c)) { return false }
		if c > '~' { beyond_ascii = true }
		at = at + 1
	}
	beyond_ascii
}

// The operator the words after a declaration's first word declare, else "": a glyph (`operator ⊕ := …`), or for infix
// a word or glyph with its parameters, `infix operator divides(d, n) := …`, `infix operator ↑(x: number, n: number)`
// Rust twin: operators.rs declared_operator, declared_glyph
def declared_operator(kind, words) {
	glyph = if words.length > 2 and words#1 == "operator" and words#3 == ":=" then words#2 else if words.length > 1 and words#2 == ":=" then words#1 else ""
	if glyph != "" and is_operator_glyph(glyph) { return glyph }
	if kind != "infix" or not words.contains(":=") or words.length == 0 { return "" }
	head = if words#1 == "operator" and words.length > 1 then words#2 else words#1
	end = if is_name_start(head[0]) then name_end(head, 0, head.length) else 0
	if not is_name_start(head[0]) { while end < head.length and head[end] != '(' { end = end + 1 } }
	word = head[0 .. end]
	operator = (is_name_start(head[0]) and word != "operator") or is_operator_glyph(word)
	if operator and (end == head.length or head[end] == '(') then word else ""
}

// `operator × := *`: another spelling of a built-in operator, no function
// Rust twin: aliases.rs alias_line

// The blank-separated words of a statement
def blank_words(statement) {
	words = []
	for word in statement.replace("\t", " ").split(" ") { if word != "" { words += [word] } }
	words
}

// The [glyph, kind, level] of each operator a source declares: `[prefix|suffix|infix]
// operator ⊕ := …` and the pattern `a ⊕ b := …` (infix), at the level a precedence declaration gives it
// Rust twin: operators.rs declared_operators
def declared_operators(source) {
	found = []
	if not source.contains(":=") { return found }
	statements = code_statements(source)
	for statement in statements {
		if not statement.contains(":=") { continue }
		declared = operator_declared(blank_words(statement))
		if declared.length > 0 { found += [declared] }
	}
	// `operator ⊕ has precedence above *`, wherever it stands, once every operator is known
	for statement in statements {
		if not statement.contains("precedence") { continue }
		ranked = precedence_declaration(blank_words(statement), found)
		if ranked.length != 2 { continue }
		leveled = []
		for operator in found { leveled += [if operator#1 == ranked#1 then [operator#1, operator#2, ranked#2] else operator] }
		found = leveled
	}
	found
}

// The operators a parse of a source knows: its own declared ones, then the standard modules' glyph operators it writes
// Rust twin: operators.rs scan_user_operators (the operators of a `use`d module's words, `matches`, are not read yet)
def scanned_operators(source) {
	found = declared_operators(source)
	for library in library_glyph_operators() {
		if source.contains(library#1) and declared_level(found, library#1) < 0 { found += [library] }
	}
	found
}
// The glyph operators the standard modules declare, with their precedence: `[1] ∪ [2] ∩ [3]` reads ∩ first as
// lib/list.warp says, without `use list`; scanned the first time a parse needs them
// Rust twin: operators.rs library_glyph_operators (it scans every std module; these are the ones declaring operators)
global library_operators = ø
def library_glyph_operators() {
	if library_operators == ø {
		library_operators = []
		for operator in declared_operators(module_source("math") + "\n" + module_source("list") + "\n" + module_source("regex")) {
			if not is_name_start(operator#1[0]) { library_operators += [operator] }
		}
	}
	library_operators
}

// The statements of a source's code, outside comments and texts, split at line ends and `;`
def code_statements(source) {
	statements = []
	for line in code_only(source).split("\n") { statements += line.split(";") }
	statements
}

// `operator ⊕ has precedence above *`: ⊕ binds this much tighter than `*`; the built-in levels are at least 5 apart
// Rust twin: declaration_scan.rs PRECEDENCE_STEP
PRECEDENCE_STEP = 2
// What the words `operator ⊕ has precedence above|below [operator] Y` declare: [glyph, level]; [message] for one that
// cannot be followed (a built-in ⊕, an unknown Y); [] for any other statement
// Rust twin: operators.rs precedence_declaration
def precedence_declaration(words, declared) {
	if words.length < 6 or words#1 != "operator" or words#3 != "has" or words#4 != "precedence" { return [] }
	direction = words#5
	if direction != "above" and direction != "below" { return [] }
	other = if words.length == 7 and words#6 == "operator" then words#7 else if words.length == 6 then words#6 else ""
	if other == "" { return [] }
	glyph = words#2
	if declared_level(declared, glyph) < 0 { return ["operator " + glyph + " is built in: only a declared operator gets a precedence (`infix operator " + glyph + " := …` first)"] }
	reference = declared_level(declared, other)
	if reference < 0 {
		canonical = canonical_operator(other)
		if canonical == "" { return ["unknown operator " + other + " in `operator " + glyph + " has precedence " + direction + " " + other + "`"] }
		reference = binding_powers(canonical)#1
	}
	[glyph, if direction == "above" then reference + PRECEDENCE_STEP else reference - PRECEDENCE_STEP]
}
// The level of the declared operator spelled `glyph`, else -1
def declared_level(declared, glyph) {
	for operator in declared { if operator#1 == glyph { return operator#3 } }
	-1
}

// [glyph, kind, level] of the operator a statement's words declare, else []
def operator_declared(words) {
	if words.length == 0 { return [] }
	kind = operator_kind_word(words#1)
	rest = words[1 .. words.length]
	glyph = if kind == "" then "" else declared_operator(kind, rest)
	if glyph != "" and operator_alias(words).length == 0 { return [glyph, kind, OPERATOR_LEVELS[kind]] }
	if words.length > 3 and words#4 == ":=" and is_operator_glyph(words#2) and is_plain_name(words#1) and is_plain_name(words#3) { return [words#2, "infix", OPERATOR_LEVELS["infix"]] }
	[]
}
def is_plain_name(word) := word.length > 0 and name_end(word, 0, word.length) == word.length

// The declared operator written at the parser's position, the longest glyph, a word one as a whole word, else ø
// Rust twin: operators.rs user_operator_at
def user_operator_at(p) {
	longest = ø
	for declared in p.operators {
		glyph = declared#1
		glyph_here = starts_at(p.code, glyph, p.at) and not (is_name_start(glyph[0]) and is_at_name_char(p, p.at + glyph.length))
		if glyph_here and (longest == ø or glyph.length > longest#1.length) { longest = declared }
	}
	longest
}
def is_at_name_char(p, at) := at < p.n and is_name_char(p.code[at])

// `infix operator ⊕(a: int, b: int) := a * 10 + b`, `prefix operator ∆ := …`: the definition of the function
// operator_⊕, whose parameters are the declared ones, else `it` (prefix, suffix) or `a b` (`left right` when the body
// names them); ø for any other statement starting with the word
// Rust twin: operators.rs try_parse_operator_declaration
def operator_declaration(p, word) {
	end = p.at
	while end < p.n and p.code[end] != '\n' and p.code[end] != ';' { end = end + 1 }
	words = blank_words(p.code[p.at + word.length .. end])
	kind = operator_kind_word(word)
	glyph = declared_operator(kind, words)
	if glyph == "" { return ø }
	p.at = p.at + word.length
	skip_spaces(p)
	if words#1 == "operator" {
		p.at = p.at + 8
		skip_spaces(p)
	}
	p.at = p.at + glyph.length
	declared = if is_at(p.code, p.at, '(', p.n) then expression(p, binding_powers(":=")#1 + 1) else ø
	skip_spaces(p)
	p.at = p.at + 2
	skip_spaces(p)
	body = expression(p, 0)
	parts = if declared == ø then ø else group_parts(declared)
	parameters = if kind != "infix" then [symbol("it")] else if declared == ø then ø else if parts != ø and parts#1 == "(" then parts#3 else [declared]
	if parameters == ø { parameters = if mentions(body, "left") or mentions(body, "right") then [symbol("left"), symbol("right")] else [symbol("a"), symbol("b")] }
	Key(operator_call(glyph, parameters), Op.Define, body)
}

// Left and right binding power of an operator
// Rust twin: operators.rs Op::binding_power
def binding_powers(op) {
	// the effect constraint `f(x) := x*x ! Pure`: a free `!` takes the whole statement before it
	if op == "not" { return [0, 105] }
	if op == "." or op == "?." { return [180, 181] }
	if op == "::" { return [175, 176] }
	if op == "#" { return [170, 182] }
	if op == "^" or DECLARED_ONLY_OPERATORS.contains(op) { return [160, 159] }
	if op == "*" or op == "/" or op == "%" or op == "rem" { return [150, 151] }
	if op == "+" or op == "-" or op == "±" { return [140, 141] }
	if op == "<<" or op == ">>" { return [135, 136] }
	if op == ".." or op == "to" { return [130, 131] }
	if op == "as" { return [125, 250] }
	if op == "<" or op == ">" or op == "<=" or op == ">=" { return [120, 121] }
	if op == "==" or op == "is" or op == "!=" or op == "===" or op == "!==" or op == "≈" or op == "~" { return [115, 116] }
	if op == "and" { return [100, 101] }
	if op == "xor" { return [95, 96] }
	if op == "or" { return [90, 91] }
	if op == "??" { return [93, 92] }
	if op == "?" { return [85, 79] }
	if op == "then" { return [77, 76] }
	if op == "else" { return [75, 74] }
	if op == "do" { return [77, 10] }
	if op == ":" { return [80, 81] }
	if op == "->" { return [70, 69] }
	if op == "=>" { return [70, 58] }
	[60, 59]
}

// The words that guard a statement and the marker call each becomes: `check C` is `assert C` (card check-assert)
// Rust twin: control/guards.rs GUARD_MARKERS, warp_parser TRY_MARKER, ASSERT_MARKER
GUARD_MARKERS = {"try": "try·else", "assert": "assert·else", "check": "assert·else"}
// The words that start the fallback of `try X else Y`: classical `catch`, Python's `except` (P60)
FALLBACK_WORDS = ["else", "catch", "except"]
// The hidden name `try X` binds X's Error to, to hand it on as the value
UNCAUGHT_ERROR = "uncaught·error"
// The hidden name `except ParseError:` binds the Error to, to test its class
CAUGHT_ERROR = "caught·error"

// `try` or `assert` followed by an operand
// Rust twin: guards.rs guard_word_ahead
def guard_word_at(p, word) := word in GUARD_MARKERS and " \t{:".contains(peek(p.code, p.at + word.length, p.n))

// `try X else Y`, `assert C else X`: the marker call `marker(X, Y)`; `try X catch e {e}` adds the caught name the
// fallback reads, `r = try X` keeps X's Error as the value, `assert C` alone fails naming C as written
// Rust twin: guards.rs parse_guard
def guarded(p, word) {
	marker = GUARD_MARKERS[word]
	p.at = p.at + word.length
	skip_spaces(p)
	skip_python_colon(p)
	start = p.at
	guarded_part = guarded_phrase(p)
	written_part = p.code[start .. p.at].trim()
	skip_spaces(p)
	if fallback_word_ahead(p) != "" {
		// `except A: a except B: b`: an Error A does not catch passes on to the next one; an `else` after the
		// fallback is an enclosing `if`'s
		guard = guarded_part
		first = yes
		fallback_word = fallback_word_ahead(p)
		while fallback_word != "" and (first or fallback_word != "else") {
			first = no
			p.at = p.resumes[p.at] + fallback_word.length
			skip_spaces(p)
			caught = if fallback_word == "else" then ["", ""] else caught_parts(p, fallback_word)
			skip_python_colon(p)
			guard = guarded_by(marker, guard, guarded_phrase(p), caught)
			skip_spaces(p)
			fallback_word = fallback_word_ahead(p)
		}
		return with_finally(p, guard)
	}
	caught = ["", ""]
	fallback = ø
	if word == "try" {
		caught = [UNCAUGHT_ERROR, ""]
		fallback = symbol(UNCAUGHT_ERROR)
	} else if marker == "assert·else" {
		fallback = "assertion failed: " + written_part
	}
	with_finally(p, guarded_by(marker, guarded_part, fallback, caught))
}

// The marker call `marker(X, Y)`, with the name Y reads the caught Error by as a fourth item (`catch e { … }`);
// `except ParseError as e` binds `e: ParseError`, which lowering tests before Y runs
// Rust twin: guards.rs guarded_by
def guarded_by(marker, guarded_part, fallback, caught) {
	parts = [symbol(marker), guarded_part, fallback]
	name = caught#1
	caught_class = caught#2
	if caught_class != "" {
		bound = if name == "" then CAUGHT_ERROR else name
		parts = parts + [keyed(":", symbol(bound), symbol(caught_class))]
	} else if name != "" and mentions(fallback, name) {
		parts = parts + [symbol(name)]
	}
	listed("(", "", parts)
}

// `try: x` as Python writes it
def skip_python_colon(p) {
	if is_at(p.code, p.at, ':', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
	}
}

// The fallback word after the blanks and line breaks ahead, else ""
// Rust twin: guards.rs fallback_word_ahead
def fallback_word_ahead(p) {
	at = p.resumes[p.at]
	for word in FALLBACK_WORDS { if keyword_at_position(p, word, at) { return word } }
	""
}

// `catch e`, `except ZeroDivisionError`, `except ValueError as e`: [the name the Error is bound to, the class it must
// be], "" for none
// Rust twin: guards.rs parse_caught
def caught_parts(p, fallback_word) {
	if not is_name_start(peek(p.code, p.at, p.n)) { return ["", ""] }
	first = word_at(p)
	p.at = p.at + first.length
	skip_spaces(p)
	if keyword_at(p, "as") {
		p.at = p.at + 2
		skip_spaces(p)
		name = word_at(p)
		p.at = p.at + name.length
		skip_spaces(p)
		return [name, first]
	}
	if fallback_word == "catch" then [first, ""] else ["", first]
}

// Either part of `try X else Y`: one expression, or a braceless call of several (`try raise "boom" else print 3`)
// Rust twin: guards.rs parse_guarded_phrase
def guarded_phrase(p) {
	outer = p.branch
	p.branch = true
	phrase_parts = [expression(p, 0)]
	while true {
		skip_spaces(p)
		if fallback_word_ahead(p) != "" or keyword_at(p, "finally") or not starts_atom(p) { break }
		phrase_parts = phrase_parts + [expression(p, 0)]
	}
	p.branch = outer
	if phrase_parts.length == 1 then phrase_parts#1 else listed("", " ", phrase_parts)
}

// `… finally {Z}` after a guard: `(finally·N = guard; Z; finally·N)`, Z runs and the guard's value stays
// Rust twin: guards.rs with_finally
def with_finally(p, guard) {
	if not keyword_at_position(p, "finally", p.resumes[p.at]) { return guard }
	p.at = p.resumes[p.at] + 7
	skip_spaces(p)
	cleanup = if is_at(p.code, p.at, ':', p.n) then colon_body(p, 1) else statement_words(p)
	p.finally_blocks = p.finally_blocks + 1
	value = symbol("finally·" + str(p.finally_blocks))
	listed("(", ";", [Key(value, Op.Assign, guard), cleanup, value])
}

// An expression's start: a prefix operator and its operand, else an atom
// Rust twin: expressions.rs parse_expr (step 1), parse_prefix_operand, finish_prefix
def prefixed(p) {
	c = peek(p.code, p.at, p.n)
	if starts_path(p) { return path_literal(p) }
	user_op = user_operator_at(p)
	if user_op != ø and user_op#2 == "prefix" {
		p.at = p.at + user_op#1.length
		skip_spaces(p)
		return operator_call(user_op#1, [expression(p, user_op#3)])
	}
	if not is_name_start(c) { return prefixed_by_symbol(p, c) }
	word = word_at(p)
	// `op.if`, `math.sqrt`: a member's name is no keyword
	if word_names_key(p, word) or after_member_dot(p) { return atom(p) }
	if word == "operator" or OPERATOR_KINDS.contains(word) {
		words = statement_words_at(p)
		ranked = precedence_declaration(words, p.operators)
		if ranked.length == 1 { raise ranked#1 }
		// the pre-scans applied both: declared_operators, operator_aliases
		if ranked.length == 2 or operator_alias(words).length > 0 { return skip_statement(p) }
		declaration = operator_declaration(p, word)
		if declaration != ø { return declaration }
	}
	form = keyword_form(word)
	if form == "return" { return returned(p) }
	if guard_word_at(p, word) { return guarded(p, word) }
	if form == "condition" {
		p.at = p.at + word.length
		skip_spaces(p)
		return conditioned(word, header_expression(p, CONDITION_POWER), p)
	}
	if form == "loop" {
		loop = looped(p)
		return if loop == ø then atom(p) else loop
	}
	foreign = foreign_form(p, word)
	if foreign != ø { return foreign }
	declared = if form == "type" then type_declaration(p, word) else if form == "global" then global_declaration(p, word) else if form == "endless" then endless_loop(p) else count_worded(p)
	if declared != ø { return declared }
	if PREFIX_OPERATORS.contains(form) { return word_prefixed(p, word, form) }
	if form == "not" {
		p.at = p.at + 3
		skip_spaces(p)
		return Key(ø, Op.Not, expression(p, 105))
	}
	atom(p)
}

// Whether the word at the parser's position follows a member's dot: `math.sqrt(4)` calls the member sqrt, no √
// (a range's `..sqrt 4` keeps the operator)
// Rust twin: the member name after `.` never reaches lookahead.rs peek_prefix_operator
def after_member_dot(p) := p.at > 0 and p.code[p.at - 1] == '.' and not (p.at > 1 and p.code[p.at - 2] == '.')

// `abs x`, `sqrt(2)`: the operator word and its operand; `f = abs` alone is the operator itself. Braceless, the word
// takes its argument like a call (`sqrt 4 + 5` is sqrt(9)); glued parentheses are the whole operand (`sqrt(16) + 1`)
// Rust twin: expressions.rs parse_expr (prefix words), lookahead.rs expression_ends_after
// Rust twin of the words: lookahead.rs PREFIX_OPERATOR_WORDS
def word_prefixed(p, word, operator) {
	p.at = p.at + word.length
	if expression_ends(p) { return keyed(operator, ø, ø) }
	glued = peek(p.code, p.at, p.n) == '('
	skip_spaces(p)
	keyed(operator, ø, expression(p, glued ? PREFIX_POWER : ARGUMENT_POWER))
}

PREFIX_POWER = 162

// No operand follows the parser's position: the end of a line or group, or an infix operator set apart by blanks
// Rust twin: lookahead.rs expression_ends_after, operand_follows
def expression_ends(p) {
	c = code_after(p, p.at)
	at = p.resumes[p.at]
	if "\n>)]},;=".contains(c) { return true }
	if c == '.' and is_name_start(peek(p.code, at + 1, p.n)) { return true }
	at > p.at and "+-*/<".contains(c) and is_blank(peek(p.code, at + 1, p.n))
}

def prefixed_by_symbol(p, c) {
	next = peek(p.code, p.at + 1, p.n)
	if c == '-' and next != '>' and next != '-' {
		p.at = p.at + 1
		skip_spaces(p)
		operand = expression(p, 155)
		if operand is number { return 0 - operand }
		return keyed("-", ø, operand)
	}
	if c == '!' or c == '¬' {
		p.at = p.at + 1
		return Key(ø, Op.Not, expression(p, 105))
	}
	if c == '#' and not is_blank(next) {
		p.at = p.at + 1
		return Key(ø, Op.Hash, expression(p, INDEX_POWER - 1))
	}
	if PREFIX_OPERATORS.contains("" + c) {
		p.at = p.at + 1
		return keyed("" + c, ø, expression(p, PREFIX_POWER))
	}
	// `&lerp`: a reference to the function, an `&` glued to the word after it and not to one before it (`a &b`)
	// Rust twin: functions.rs starts_function_reference, closures.rs function_reference
	if c == '&' and is_alpha(next) and not (p.at > 0 and is_name_char(p.code[p.at - 1])) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return attributed(FUNCTION_REFERENCE_MARK, true, symbol(name))
	}
	if c == ':' and explicit_symbol_at(p) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return listed("(", "", [symbol("symbol"), name])
	}
	atom(p)
}

// `:post` (wiki/symbol.md): the symbol itself, written as the call symbol("post"), never evaluated
// Rust twin: atoms.rs parse_atom (':' at_explicit_symbol), lookahead.rs at_explicit_symbol
def explicit_symbol_at(p) {
	before = if p.at == 0 then ' ' else p.code[p.at - 1]
	is_name_start(peek(p.code, p.at + 1, p.n)) and (is_blank(before) or "([{,=".contains(before))
}

// `return x`, `return` alone: ø; `return = 1` assigns a name
// Rust twin: expressions.rs try_parse_return
def returned(p) {
	before = p.at
	p.at = p.at + 6
	skip_spaces(p)
	op = operator_at(p)
	if op.length > 0 and ASSIGNING.contains(op#2) {
		p.at = before
		return atom(p)
	}
	c = peek(p.code, p.at, p.n)
	value = ø
	if not (c == '}' or c == ';' or c == '\n' or c == '\r') { value = continued(p, expression(p, 59), 0) }
	// `return` alone is the word
	if value === ø then symbol("return") else listed("", " ", [symbol("return"), value])
}

// The operators after which `return` names a variable
ASSIGNING = ["=", ":=", ":", "+=", "-=", "*=", "/=", "%=", "^=", "&&=", "||=", "^^="]

// Binds a condition until `then`, `do` or the colon of `if c: x`
CONDITION_POWER = 81

// Rust's `loop { … }` as `while true { … }`, ø when no block follows the word
// Rust twin: atoms.rs keyword_form (LOOP_WORD)
def endless_loop(p) {
	at = blank_end(p, p.at + 4)
	if not is_at(p.code, at, '{', p.n) { return ø }
	p.at = at + 1
	Key(Key(ø, Op.While, true), Op.Do, items(p, '}', "{"))
}

// `if c {…} else {…}` and `while c {…}`: the block after the condition is its branch or body
// Rust twin: expressions.rs finish_if_prefix, finish_while_prefix
def conditioned(word, condition, p) {
	skip_spaces(p)
	body = ø
	if is_at(p.code, p.at, ':', p.n) {
		// `if c: x = 1 else: x = 2`: the body ends before the else
		outer = p.branch
		p.branch = word == "if"
		body = colon_body(p, 1)
		p.branch = outer
	} else if is_at(p.code, p.at, '{', p.n) {
		p.at = p.at + 1
		body = items(p, '}', "{")
	} else if word == "if" and is_list_of(condition, "(") and at_body_start(p) {
		// `if (x < 0) return -1`: C's parenthesized condition, then the statement on the same line
		outer = p.branch
		p.branch = true
		body = expression(p, 0)
		p.branch = outer
	} else {
		return keyed(word, ø, condition)
	}
	head = keyed(word, ø, condition)
	if word == "while" { return Key(head, Op.Do, body) }
	branches = Key(head, Op.Then, body)
	otherwise = else_branch(p)
	if otherwise.length == 0 { return branches }
	Key(branches, Op.Else, otherwise#1)
}

// Whether a statement starts at the parser's position, no end of one, `then`, `else` or `do`
// Rust twin: blocks.rs at_body_start
def at_body_start(p) {
	c = peek(p.code, p.at, p.n)
	not (p.at >= p.n or "\n;,})]".contains(c)) and not keyword_at(p, "do") and not keyword_at(p, "then") and not keyword_at(p, "else")
}

// `else body`, also on the line after the branch, `else: body`, and `elif`/`elsif`/`elseif` chaining a new if; [] if
// no else follows
// Rust twin: if_else.rs parse_optional_else, else_on_a_later_line, at_else_if_word
def else_branch(p) {
	skip_spaces(p)
	at = p.at
	while at < p.n and is_blank(p.code[at]) { at = at + 1 }
	if at > p.at and p.code[p.at .. at].contains("\n") and keyword_at_position(p, "else", at) { p.at = at }
	if else_if_at(p) {
		p.at = p.at + word_at(p).length
		skip_spaces(p)
		return [conditioned("if", header_expression(p, CONDITION_POWER), p)]
	}
	if not keyword_at(p, "else") { return [] }
	p.at = p.at + 4
	skip_spaces(p)
	if not is_at(p.code, p.at, ':', p.n) { return [branch(p, 74)] }
	p.at = p.at + 1
	skip_spaces(p)
	[branch(p, 0)]
}

// A branch of an if; `then print x, y` and `else print ord x` are the call print(…) of the expressions after it
// Rust twin: if_else.rs parse_branch, commands.rs take_braceless_print, print_call_from
// A `then` or `else` branch is a statement: a braceless call there takes a variable, `then count xs`
// Rust twin: expressions.rs parse_right_operand (branch_bp)
def branch(p, min_power) {
	outer = p.branch_power
	p.branch_power = min_power
	value = branch_assignment(p, branch_value(p, min_power), min_power)
	p.branch_power = outer
	value
}

// `if c then s += 5 else s = 0` assigns in the branch, the value stopping at `else`
// Rust twin: if_else.rs branch_assignment
def branch_assignment(p, target, min_power) {
	skip_spaces(p)
	op = operator_at(p)
	if op.length == 0 or not BRANCH_ASSIGNING.contains(op#2) { return target }
	p.at = p.at + op#1.length
	skip_spaces(p)
	keyed(op#2, target, expression(p, min_power))
}

BRANCH_ASSIGNING = ["=", "+=", "-=", "*=", "/=", "%=", "^=", "&&=", "||=", "^^="]

def branch_value(p, min_power) {
	at = blank_end(p, p.at + 5)
	if not (keyword_at(p, "print") and at > p.at + 5 and starts_atom_at(p, at)) { return expression(p, min_power) }
	p.at = at
	arguments = [expression(p, min_power)]
	while is_at(p.code, p.at, ',', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		arguments += [expression(p, min_power)]
	}
	listed("(", "", [PRINT] + arguments)
}

def keyword_at_position(p, word, at) := starts_at(p.code, word, at) and not (at + word.length < p.n and is_name_char(p.code[at + word.length]))

// `for x in xs {…}`: the loop variable, the iterable and the body, else ø, nothing read
// Rust twin: loops.rs try_parse_for_in, for_iterable_and_body_word
def looped(p) {
	before = p.at
	p.at = p.at + 3
	skip_spaces(p)
	variable = loop_variable(p)
	if variable != ø {
		skip_spaces(p)
		if keyword_at(p, "in") {
			p.at = p.at + 2
			skip_spaces(p)
			p.iterable = true
			iterable = header_expression(p, 81)
			p.iterable = false
			skip_spaces(p)
			return listed("", " ", [symbol("for"), variable, symbol("in"), iterable, loop_body(p)])
		}
	}
	p.at = before + 3
	skip_spaces(p)
	ranged = ranged_loop(p)
	if ranged == ø { p.at = before }
	ranged
}

// `for 1…100: print it`, `for xs {…}` and `for 0 to 2` with the lines indented below: a loop over the iterable without
// a name, its body a block; ø if no body follows
// Rust twin: loops.rs try_parse_for_in (only the colon and do forms), as_block
def ranged_loop(p) {
	p.iterable = true
	iterable = header_expression(p, 81)
	p.iterable = false
	skip_spaces(p)
	width = body_word_width(p)
	body = ø
	if width > 0 {
		body = colon_body(p, width)
	} else if is_at(p.code, p.at, '{', p.n) {
		body = atom(p)
	} else {
		body = indented_block(p)
	}
	if body == ø { return ø }
	// a colon body stays bare, as in `for i in xs: x`
	listed("", " ", [symbol("for"), iterable, body])
}

// A loop's body: `{…}`, `: words`, `do words`
// Rust twin: statements.rs for_iterable_and_body_word, colon_body
def loop_body(p) {
	width = body_word_width(p)
	if width > 0 { return colon_body(p, width) }
	block = indented_block(p)
	if block != ø { return block }
	atom(p)
}

def body_word_width(p) {
	if is_at(p.code, p.at, ':', p.n) { return 1 }
	if keyword_at(p, "do") { return 2 }
	0
}

// The words up to the end of the statement, one expression: `print ord c` of `for c in s: print ord c`
// Rust twin: statements.rs rest_of_statement, words_binding
def statement_words(p) {
	words = []
	while true {
		words = words + [expression(p, 0)]
		skip_spaces(p)
		if ends_branch(p) or not starts_atom(p) { break }
	}
	if words.length == 1 { return words#1 }
	phrase("", words)
}

def ends_branch(p) := keyword_at(p, "else") or else_if_at(p)

def else_if_at(p) := keyword_form(word_at(p)) == "else if"

def starts_atom(p) := starts_atom_at(p, p.at)

def starts_atom_at(p, at) {
	c = peek(p.code, at, p.n)
	is_name_start(c) or is_digit(c) or c == '"' or c == '\'' or c == '(' or c == '[' or c == '{' or (c == '@' and is_name_start(peek(p.code, at + 1, p.n))) or starts_path_at(p, at)
}

// `x`, `k, v` or `(k, v)`: the names a loop gives each item, else ø
// Rust twin: statements.rs parse_loop_variable
def loop_variable(p) {
	bracket = ""
	if is_at(p.code, p.at, '(', p.n) {
		bracket = "("
		p.at = p.at + 1
	}
	names = []
	while true {
		skip_spaces(p)
		if not is_name_start(peek(p.code, p.at, p.n)) { return ø }
		end = name_end(p.code, p.at, p.n)
		names = names + [symbol(p.code[p.at .. end])]
		p.at = end
		skip_spaces(p)
		if not is_at(p.code, p.at, ',', p.n) { break }
		p.at = p.at + 1
	}
	if bracket == "(" {
		if not is_at(p.code, p.at, ')', p.n) { return ø }
		p.at = p.at + 1
	}
	if names.length == 1 { return names#1 }
	listed(bracket, ",", names)
}

// A number, text, name or bracketed group
// Rust twin: atoms.rs parse_atom, literals.rs read_number_value
def atom(p) {
	if p.at >= p.n { return ø }
	c = p.code[p.at]
	if is_digit(c) {
		if c == '0' and (is_at(p.code, p.at + 1, 'x', p.n) or is_at(p.code, p.at + 1, 'X', p.n)) {
			p.at = p.at + 2
			return radix_value(p, 16)
		}
		if c == '0' and (is_at(p.code, p.at + 1, 'b', p.n) or is_at(p.code, p.at + 1, 'B', p.n)) and p.at + 2 < p.n and digit_value(p.code[p.at + 2]) < 2 {
			p.at = p.at + 2
			return radix_value(p, 2)
		}
		number_start = p.at
		written = decimal_number(p)
		// two returns and `amount: any`: an `if` of float(…) and int(…), a parameter float elsewhere, make an int beyond
		// i64 a float (card int-beyond)
		if written.contains(".") or written.contains("e-") or written.contains("E-") { return with_glued_factor(p, float(written)) }
		literal = p.code[number_start .. p.at]
		if not (literal.contains("e") or literal.contains("E")) {
			duration = with_time_unit(p, int(written))
			if duration != ø { return duration }
		}
		return with_glued_factor(p, int(written))
	}
	if c == '"' or c == '\'' { return quoted(p) }
	// `.5` is 0.5
	if c == '.' and is_digit(peek(p.code, p.at + 1, p.n)) { return float("0" + decimal_number(p)) }
	// a loop where an atom stands: the body of a comprehension's clause, `[a + b for a in xs for b in ys]`
	if keyword_at(p, "for") {
		loop = looped(p)
		if loop != ø { return loop }
	}
	if is_name_start(c) { return named(p) }
	// `$a`, a pattern's name hole: `data($a + 0)`; `$0`, a function's first parameter
	if c == '$' and (is_name_start(peek(p.code, p.at + 1, p.n)) or is_digit(peek(p.code, p.at + 1, p.n))) {
		end = symbol_end(p.code, p.at + 1, p.n)
		hole = symbol(p.code[p.at .. end])
		p.at = end
		return hole
	}
	if EXACT_CONSTANTS.contains("" + c) {
		p.at = p.at + 1
		return exact_constant("" + c)
	}
	if c == '@' and is_name_start(peek(p.code, p.at + 1, p.n)) { return attribute(p) }
	// `@1`: the node whose @id is 1
	if c == '@' and is_digit(peek(p.code, p.at + 1, p.n)) {
		end = p.at + 1
		while end < p.n and is_digit(p.code[end]) { end = end + 1 }
		reference = symbol(p.code[p.at .. end])
		p.at = end
		return reference
	}
	if c == '(' or c == '[' or c == '{' {
		p.at = p.at + 1
		outer = p.header
		outer_iterable = p.iterable
		p.header = outer and c == '('
		p.iterable = outer_iterable and c == '('
		group = if c == '{' then braced_items(p) else items(p, closing_of(c), "" + c)
		p.header = outer
		p.iterable = outer_iterable
		return group
	}
	// `°C`, `°F`: a temperature unit; `°` alone the angle unit (units.rs)
	// Rust twin: atoms.rs parse_atom (DEGREE)
	if c == DEGREE {
		end = if is_alpha(peek(p.code, p.at + 1, p.n)) then name_end(p.code, p.at + 1, p.n) else p.at + 1
		unit = symbol(p.code[p.at .. end])
		p.at = end
		return unit
	}
	if c == 'ø' or c == ')' or c == ']' or c == '}' or c == ';' {
		if c == 'ø' { p.at = p.at + 1 }
		return ø
	}
	// `"̅"`: a quote carrying combining marks is one grapheme of the code; the marks open the text (card parser-graphemes)
	if "\"'".contains(code_points("" + c)#1) { return quoted(p) }
	// every other character is read: a free symbol names itself, `x = ↯`, `⌘`; any other one is its character, `★`
	// (card unicode-glyphs)
	// Rust twin: atoms.rs parse_atom (is_free_symbol, parse_emoji; the Rust lane still errors on other characters)
	p.at = p.at + 1
	if is_free_symbol(p, c) then symbol("" + c) else c
}

// The degree sign of temperatures and angles (Rust twin: numbers/units.rs DEGREE)
DEGREE = '°'

// The Unicode blocks of symbols a program may use before anything defines them (decision unicode-symbols): arrows,
// math operators, technical and geometric symbols, dingbat arrows, the supplemental math and arrow blocks
// Rust twin: operators.rs FREE_SYMBOL_BLOCKS
FREE_SYMBOL_BLOCKS = [['←', '⏿'], ['■', '◿'], ['➔', '➿'], ['⟀', '⟿'], ['⤀', '⫿'], ['⬀', '⯿'], ['￩', '￬']]
// A symbol character no built-in operator, prefix operator or alias spells: a free operator or symbol name
// Rust twin: operators.rs is_free_symbol
def is_free_symbol(p, c) {
	glyph = "" + c
	if glyph.length != 1 or PREFIX_OPERATORS.contains(glyph) { return false }
	in_block = false
	for block in FREE_SYMBOL_BLOCKS { if c >= block#1 and c <= block#2 { in_block = true } }
	if not in_block { return false }
	for op in SYMBOL_OPERATORS { if op#1 == glyph { return false } }
	for alias in p.aliases { if alias#1 == glyph { return false } }
	true
}
// `1 ⇔ 1` with no `infix operator ⇔` declared: a free symbol with an operand after it on its line calls its operator;
// `[↯ ↯]` and `print ↯` read the glyph as a value
// Rust twin: operators.rs try_parse_free_infix, free_symbol_follows
def free_infix_at(p, left) := left != ø and is_free_symbol(p, peek(p.code, p.at, p.n)) and operand_follows(p, 1) and not is_free_symbol(p, code_after(p, p.at + 1))

// The URL after its scheme word, up to a blank, a separator, a closer or a quote
// Rust twin: literals/paths.rs parse_url, is_url_terminator
def url_text(p, scheme) {
	end = p.at
	while end < p.n and not " \t\n\r;)]}>\"',«".contains(p.code[end]) { end = end + 1 }
	url = scheme + p.code[p.at .. end]
	p.at = end
	url
}

// A file path without quotes starts here, glued to what follows and not to an operand before it: `./a.wav`,
// `../songs/a.wav`, `./` alone, `~/notes.txt`, `/etc/hosts` where no operand stands before it (`x = /tmp`, `[/a, /b]`);
// after an operand `/` divides (`width /height`). `ls /tmp`, a path after a word taking one, waits for card path-words
// Rust twin: literals/paths.rs starts_path_literal
def starts_path(p) := starts_path_at(p, p.at)

def starts_path_at(p, at) {
	c = peek(p.code, at, p.n)
	if at > 0 and is_operand_end(p.code[at - 1]) { return false }
	if c == '.' {
		dots = if is_at(p.code, at + 1, '.', p.n) then 2 else 1
		after = peek(p.code, at + dots + 1, p.n)
		return is_at(p.code, at + dots, '/', p.n) and (not ends_path(after) or not operand_follows_at(p, at + dots + 1))
	}
	// `cd ~` alone; `a ~ b` stays the comparison
	if c == '~' { return is_at(p.code, at + 1, '/', p.n) or not operand_follows_at(p, at + 1) }
	if c == '/' { return starts_path_name(peek(p.code, at + 1, p.n)) and not operand_before(p, at) }
	false
}

// The path at the parser's position, up to a blank, a closer or a separator, as a text
// Rust twin: literals/paths.rs parse_path_literal
def path_literal(p) {
	end = p.at
	while end < p.n and not ends_path(p.code[end]) { end = end + 1 }
	path = p.code[p.at .. end]
	p.at = end
	path
}

def is_operand_end(c) := is_name_char(c) or c == ')' or c == ']' or c == '}' or c == '"' or c == '\''
def ends_path(c) := c == "" or is_blank(c) or c == ']' or c == ')' or c == '}' or c == ',' or c == ';'
def starts_path_name(c) := is_name_start(c) or c == '.'

// Whether an operand ends before the blanks before `start`
def operand_before(p, start) {
	at = start - 1
	while at >= 0 and (p.code[at] == ' ' or p.code[at] == '\t') { at = at - 1 }
	at >= 0 and is_operand_end(p.code[at])
}

// The exact generators: `π` is the real π, not a float (src/extensions/reals.rs); a bare `e` or `i` stays a free name,
// as `epsilon` does; and `∞`, the float infinity
// Rust twin: literals/constants.rs check_constants, atoms.rs parse_atom (∞)
EXACT_CONSTANTS = ["π", "pi", "τ", "tau", "euler", "ℯ", "ⅈ", "ε", "ω", "∞"]
// no node of its own in warp yet (card node-more-cases): the number view, which the Rust side reads as written
def exact_constant(word) := opaque(["number", word])

// `shader { … }` (or `wgsl { … }`) after its word: WGSL as a sublanguage, the text between the braces without its
// common indentation, braces in WGSL comments not counted; else ø
// Rust twin: literals/shaders.rs parse_shader_block
SHADER_WORDS = ["shader", "wgsl"]
def shader_block(p, word) {
	open = p.at
	while open < p.n and (p.code[open] == ' ' or p.code[open] == '\t') { open = open + 1 }
	if not is_at(p.code, open, '{', p.n) { return ø }
	end = closing_brace(p.code, open + 1, p.n)
	if end < 0 { raise "the { of `" + word + " { … }` is never closed" }
	p.at = end + 1
	shader_text(dedented(p.code[open + 1 .. end]))
}

// Where the `}` closing a `{` before `at` is, -1 if none: WGSL comments hold no braces
// Rust twin: literals/text.rs closing_brace
def closing_brace(code, at, n) {
	depth = 1
	while at < n {
		c = code[at]
		if c == '/' and is_at(code, at + 1, '/', n) {
			while at + 1 < n and code[at + 1] != '\n' { at = at + 1 }
		} else if c == '/' and is_at(code, at + 1, '*', n) {
			at = at + 2
			while at + 1 < n and not (code[at] == '*' and code[at + 1] == '/') { at = at + 1 }
			at = at + 1
		} else if c == '{' {
			depth = depth + 1
		} else if c == '}' {
			if depth == 1 { return at }
			depth = depth - 1
		}
		at = at + 1
	}
	-1
}

// The lines without the indentation all non-blank ones share, without the blank lines around them, the first
// without any
// Rust twin: literals/text.rs without_common_indentation
def dedented(source) {
	lines = source.split("\n")
	written = [line for line in lines if line.trim() != ""]
	if #written == 0 { return "" }
	common = min(written.map(indent_width))
	first = 1
	while lines#first.trim() == "" { first = first + 1 }
	last = #lines
	while lines#last.trim() == "" { last = last - 1 }
	kept = []
	for index in first .. last + 1 {
		line = lines#index
		kept += [without_trailing_blanks(if index == first then line.trim() else line[common ..])]
	}
	kept.join("\n")
}

def indent_width(line) {
	width = 0
	while width < #line and (line[width] == ' ' or line[width] == '\t') { width = width + 1 }
	width
}

def without_trailing_blanks(line) {
	end = #line
	while end > 0 and (line[end - 1] == ' ' or line[end - 1] == '\t') { end = end - 1 }
	line[0 .. end]
}

// A shader's WGSL with each hole `$name` read from the uniform values (`values.name`), the holes listed in its
// shader_holes attribute; Book of Shaders names and `$mouse_x` read warp's own holes
// Rust twin: graphics/shader_holes.rs shader_text, written
HOLE_ALIASES = {"mouse_x": "mouse.x", "mouse_y": "mouse.y", "u_time": "time", "u_resolution": "size", "u_mouse": "mouse", "wheel": "mouse_wheel"}
def shader_text(wgsl) {
	names = []
	text = ""
	at = 0
	n = #wgsl
	while at < n {
		c = wgsl[at]
		end = at + 1
		if c == '$' {
			while end < n and (is_alphanumeric(wgsl[end]) or wgsl[end] == '_') { end = end + 1 }
		}
		if end == at + 1 or is_digit(wgsl[at + 1]) {
			text = text + c
			at = at + 1
		} else {
			written_name = wgsl[at + 1 .. end]
			read = if HOLE_ALIASES.contains(written_name) then HOLE_ALIASES[written_name] else written_name
			text = text + "values." + read
			hole_name = read.split(".")#1
			if not names.contains(hole_name) { names += [hole_name] }
			at = end
		}
	}
	if #names == 0 { return text }
	attributed("shader_hole_names", listed("[", " ", [symbol(hole_name) for hole_name in names]), text)
}

// `@name` or `@name(value)` marks the atom after it: `@version(2) @draft tee{a:1}`; `@name: value` is the meta entry
// `@name`, never a field; after a dot, `p.@name` names the meta key itself
// Rust twin: annotations.rs parse_attribute
def attribute(p) {
	after_dot = p.at > 0 and p.code[p.at - 1] == '.'
	end = name_end(p.code, p.at + 1, p.n)
	key = symbol(p.code[p.at .. end])
	name = p.code[p.at + 1 .. end]
	p.at = end
	if after_dot { return key }
	if is_at(p.code, p.at, ':', p.n) and not is_at(p.code, p.at + 1, '=', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		return Key(key, Op.Colon, atom(p))
	}
	value = attribute_value(p)
	skip_spaces(p)
	attributed(name, value, atom(p))
}

// The value of `@name(value)`, true for a bare `@name`
def attribute_value(p) {
	if not is_at(p.code, p.at, '(', p.n) { return true }
	group = atom(p)
	parts = group_parts(group)
	if parts != ø and #parts#3 == 1 then parts#3#1 else group
}

// `ys = xs.map(f) @parallel`: an `@name` or `@name(value)` with nothing after it on the statement marks the
// expression before it, else ø
// Rust twin: annotations.rs try_parse_trailing_attribute
def trailing_attribute(p, marked) {
	start = p.at
	if not is_name_start(peek(p.code, p.at + 1, p.n)) { return ø }
	end = name_end(p.code, p.at + 1, p.n)
	name = p.code[p.at + 1 .. end]
	p.at = end
	value = attribute_value(p)
	skip_spaces(p)
	if p.at < p.n and not "\n\r;,)]}".contains(p.code[p.at]) {
		p.at = start
		return ø
	}
	attributed(name, value, marked)
}

// The calendar length of each time unit word: [months, days, seconds]
// Rust twin: time/calendar.rs unit_named
TIME_UNITS = {"year": [12, 0, 0], "years": [12, 0, 0], "month": [1, 0, 0], "months": [1, 0, 0], "week": [0, 7, 0],
	"weeks": [0, 7, 0], "day": [0, 1, 0], "days": [0, 1, 0], "hour": [0, 0, 3600], "hours": [0, 0, 3600],
	"minute": [0, 0, 60], "minutes": [0, 0, 60], "second": [0, 0, 1], "seconds": [0, 0, 1]}

// `1 month`, `24 hours`, `1day`, `1 month 2 days`: an integer followed by a time unit word is a calendar duration, the
// data view Rust's parser gives it, ["data", "1 month 2 days"] as the duration prints; else ø, nothing read
// Rust twin: literals/units.rs with_time_unit, following_duration
def with_time_unit(p, count: int) {
	unit = time_unit_at(p, p.at)
	if unit == ø { return ø }
	length = unit#1.map(part => part * count)
	p.at = unit#2
	while true {
		spaces = p.at
		while is_at(p.code, spaces, ' ', p.n) { spaces = spaces + 1 }
		digits = spaces
		while digits < p.n and is_digit(p.code[digits]) { digits = digits + 1 }
		following = if spaces > p.at and digits > spaces then time_unit_at(p, digits) else ø
		if following == ø { break }
		amount = int(p.code[spaces .. digits])
		length = (1 to 3).map(i => length#i + following#1#i * amount)
		p.at = following#2
	}
	opaque(["data", duration_text(length)])
}

// The time unit word at `at` after any spaces: [its length, where it ends], else ø; `{year:1970 month:1}`: a word that
// starts the next entry or assignment is no unit
// Rust twin: literals/units.rs time_unit_at, time/calendar.rs unit_after
def time_unit_at(p, at: int) {
	while is_at(p.code, at, ' ', p.n) { at = at + 1 }
	end = at
	while end < p.n and (is_alphanumeric(p.code[end]) or p.code[end] == '_') { end = end + 1 }
	word = p.code[at .. end]
	if not (word in TIME_UNITS) { return ø }
	after = end
	while is_at(p.code, after, ' ', p.n) { after = after + 1 }
	starts_entry = is_at(p.code, after, ':', p.n) or (is_at(p.code, after, '=', p.n) and not is_at(p.code, after + 1, '=', p.n))
	if starts_entry then ø else [TIME_UNITS[word], end]
}

// `1 month 2 days`, `3 hours`: a duration's months, days and seconds as Rust's Duration prints them
// Rust twin: time/calendar.rs Display for Duration
def duration_text(length) {
	seconds = length#3
	amounts = [[length#1, "month"], [length#2, "day"], [seconds /! 3600, "hour"], [seconds % 3600 /! 60, "minute"], [seconds % 60, "second"]]
	parts = amounts.filter(amount => amount#1 != 0).map(amount => counted_unit(amount#1, amount#2))
	if parts.length == 0 { return "0 seconds" }
	parts.join(" ")
}

def counted_unit(amount: int, unit: text) := if amount == 1 then "1 " + unit else "" + amount + " " + unit + "s"

// `2x` is 2*x, `500ms` is 500*ms, `3(4)` is 3*(4): a name or `(` glued to a number multiplies it; ordinals `1st` do not
// Rust twin: literals.rs with_juxtaposed_factor
def with_glued_factor(p, amount: any) {
	c = peek(p.code, p.at, p.n)
	if not (is_name_start(c) or c == '(' or c == DEGREE) or ORDINAL_SUFFIXES.contains(p.code[p.at .. name_end(p.code, p.at, p.n)]) {
		return amount
	}
	factor = atom(p)
	power = superscript_power(p, factor, 0)
	Key(amount, Op.Mul, if power == ø then factor else power)
}

// `x²` is x^2, `x⁻¹` is 1/x^1, `2ⁿ⁺¹` is 2^(n+1), `2²⁺³` is 2^5:
// the power of `left` written in superscripts at the parser's position and binding at least `min_power`, else ø
// Rust twin: math_notation.rs try_parse_superscript_power, superscript_exponent, superscript_variable_exponent
def superscript_power(p, left, min_power) {
	terms = raised_terms(p)
	if terms.length == 0 { return ø }
	width = terms#(terms.length)#3 - p.at
	lettered = false
	for term in terms {
		if term#2 is symbol { lettered = true }
	}
	if lettered {
		if binding_powers("^")#1 < min_power { return ø }
		exponent = terms#1#2
		for term in terms[1:] { exponent = Key(exponent, if term#1 < 0 then Op.Sub else Op.Add, term#2) }
		p.at = p.at + width
		return reciprocal_if(terms#1#1 < 0, Key(left, Op.Pow, exponent))
	}
	total = 0
	for term in terms { total = total + term#1 * term#2 }
	power = Key(left, Op.Pow, if total < 0 then 0 - total else total)
	// a lone ² or ³ binds as a suffix: `a.b²` squares a.b
	suffix = width == 1 and (total == 2 or total == 3)
	if (if suffix then SUFFIX_POWER else binding_powers("^")#1) < min_power { return ø }
	p.at = p.at + width
	reciprocal_if(total < 0, power)
}

def reciprocal_if(negative, power) := if negative then Key(1, Op.Div, power) else power

// The superscript terms at the parser's position, each [sign, value, end]: a raised number, or a raised name as a symbol
def raised_terms(p) {
	terms = []
	at = p.at
	while true {
		sign = 1
		if is_at(p.code, at, '⁻', p.n) { sign = -1 }
		start = if is_at(p.code, at, '⁻', p.n) or is_at(p.code, at, '⁺', p.n) then at + 1 else at
		end = start
		letters = ""
		while end < p.n and position_in(SUPERSCRIPT_LETTERS, p.code[end]) < SUPERSCRIPT_LETTERS.length {
			letters = letters + RAISED_LETTERS[position_in(SUPERSCRIPT_LETTERS, p.code[end])]
			end = end + 1
		}
		value = 0
		while letters == "" and end < p.n and position_in(SUPERSCRIPT_DIGITS, p.code[end]) < 10 {
			value = value * 10 + position_in(SUPERSCRIPT_DIGITS, p.code[end])
			end = end + 1
		}
		if end == start { return terms }
		terms += [[sign, if letters == "" then value else symbol(letters), end]]
		at = end
	}
	terms
}

// Where the character c stands in `table`, else the table's length
def position_in(table, c) := index_of(table, c, 0, table.length)

ORDINAL_SUFFIXES = ["st", "nd", "rd", "th"]

// A name and what is glued to it: `f(x)` calls f, `f(x) {…}` defines it, `a{…}` is the tagged block `a:{…}`
// Rust twin: atoms.rs parse_symbol_with_suffix, parse_glued_suffix, function_call
def named(p) {
	bang = bang_word_at(p)
	end = if bang > 0 then p.at + bang else symbol_end(p.code, p.at, p.n)
	word = p.code[p.at .. end]
	p.at = end
	if keyword_form(word) == "reference" {
		referenced = function_reference(p)
		if referenced != ø { return referenced }
	}
	if word == "enum" and enum_values_ahead(p) { return enum_with_values(p) }
	if word == "wasm" {
		instruction = wasm_instruction_after(p)
		if instruction != ø { return instruction }
	}
	if optional_mark_follows(p, word) {
		p.at = p.at + 1
		return symbol(word + "?")
	}
	constant = if names_case(p, word.length) then "" else keyword_form(word.lower())
	if constant == "true" { return true }
	if constant == "false" { return false }
	if constant == "empty" { return ø }
	if not names_case(p, word.length) and EXACT_CONSTANTS.contains(word.lower()) { return exact_constant(word) }
	// `https://pannous.com`, `ssh://host`: a URL, the rest of which reads as one text
	if p.code[p.at .. min(p.at + 3, p.n)] == "://" { return url_text(p, word) }
	if SHADER_WORDS.contains(word) {
		shader = shader_block(p, word)
		if shader != ø { return shader }
	}
	name = symbol(word)
	// `x°`: a variable in degrees, as `30°` (Rust twin: atoms.rs, card angles-degrees)
	if is_at(p.code, p.at, DEGREE, p.n) and not is_alpha(peek(p.code, p.at + 1, p.n)) {
		p.at = p.at + 1
		return Key(name, Op.Mul, symbol("" + DEGREE))
	}
	// `Point {x: 1}` with blanks constructs a declared type as the glued one does (open decision 41); a capitalized word
	// of no declared type before a block of fields is the tagged object `Person:{…}` (card person-name)
	declared = p.types.contains(word)
	if (declared or is_capitalized(word)) and block_after_blanks(p, declared) { skip_spaces(p) }
	if is_at(p.code, p.at, '{', p.n) {
		p.at = p.at + 1
		// `Point{x: 1}` of a declared type constructs a point, any other `name{…}` stays the tagged block (D4)
		return Key(name, if declared then Op.None else Op.Colon, braced_items(p))
	}
	if not is_at(p.code, p.at, '(', p.n) { return name }
	p.at = p.at + 1
	arguments = typed_parameters(items(p, ')', "("))
	skip_spaces(p)
	if is_at(p.code, p.at, '{', p.n) and not p.header {
		p.at = p.at + 1
		body = items(p, '}', "{")
		// the head is the call f(x, y)
		return listed("(", "", [listed("(", "", [name] + spread(arguments)), body])
	}
	listed("(", "", [name] + spread(arguments))
}

// `x:int?=ø`, `f(x:int?)`, the field `right? }`: the `?` after `word` marks it optional when a closer, `=`, a comment,
// the next field or a declaration follows; a ternary `?` is followed by its branch instead
// Rust twin: atoms.rs parse_symbol_with_suffix (Optional type)
def optional_mark_follows(p, word) {
	if not is_at(p.code, p.at, '?', p.n) { return false }
	after = p.at + 1
	ends_optional_type(peek(p.code, after, p.n), peek(p.code, after + 1, p.n)) or closes_after_blanks(p, after) or next_field_follows(p, after) or declaration_follows(p, word, after)
}

// What ends an optional type after its `?`: a closer, a separator, the line's or source's end, or an assignment's `=`
// Rust twin: lookahead.rs ends_optional_type
def ends_optional_type(next, after) := ")]},;\n\r".contains(next) or (next == '=' and after != '=')

// Spaces or tabs from `at`, then a comment or what ends an optional type
// Rust twin: lookahead.rs closes_after_blanks
def closes_after_blanks(p, at) {
	end = spaces_end(p, at)
	comment_starts = is_at(p.code, end, '/', p.n) and "/*".contains(peek(p.code, end + 1, p.n))
	end > at and (comment_starts or ends_optional_type(peek(p.code, end, p.n), peek(p.code, end + 1, p.n)))
}

// Inside a type's body, spaces or tabs from `at`, then the next field `name:` (no `:=`, no `::`)
// Rust twin: lookahead.rs next_field_follows
def next_field_follows(p, at) {
	start = spaces_end(p, at)
	colon = name_end(p.code, start, p.n)
	p.type_body and start > at and colon > start and is_at(p.code, colon, ':', p.n) and not "=:".contains(peek(p.code, colon + 1, p.n))
}

// After the type word `word`, spaces or tabs from `at`, then the definition `:=` or a declared name `i =`: `int? i = 3`
// and `as int? := …` are optional types, no ternary
// Rust twin: lookahead.rs declaration_follows
def declaration_follows(p, word, at) {
	start = spaces_end(p, at)
	name_after = name_end(p.code, start, p.n)
	assigned = if name_after == start then start else spaces_end(p, name_after)
	assigns = if is_at(p.code, assigned, ':', p.n) then peek(p.code, assigned + 1, p.n) == '=' else is_at(p.code, assigned, '=', p.n) and peek(p.code, assigned + 1, p.n) != '='
	(is_type_word(word) or p.types.contains(word)) and start > at and assigns
}

// After the spaces and tabs from `at` on
def spaces_end(p, at) {
	end = at
	while is_at(p.code, end, ' ', p.n) or is_at(p.code, end, '\t', p.n) { end = end + 1 }
	end
}

// Blanks, then a block of fields: `{}`, `{ name: …`, or with `assignments` `{ x = 1 …` (its first entry may start on
// the next line)
// Rust twin: lookahead.rs block_after_blanks
def block_after_blanks(p, assignments) {
	at = blank_end(p, p.at)
	if at == p.at or not is_at(p.code, at, '{', p.n) { return false }
	first = at + 1
	while first < p.n and is_blank(p.code[first]) { first = first + 1 }
	if is_at(p.code, first, '}', p.n) { return true }
	end = name_end(p.code, first, p.n)
	if end == first { return false }
	after_name = blank_end(p, end)
	c = peek(p.code, after_name, p.n)
	following = peek(p.code, after_name + 1, p.n)
	(c == ':' and following != '=') or (assignments and c == '=' and following != '=')
}

// `wasm f64.floor`: a function body that is one wasm instruction (decision wasm-instruction-body), ø when no
// `type.operation` follows
// Rust twin: atoms.rs wasm_instruction_after
def wasm_instruction_after(p) {
	if not is_at(p.code, p.at, ' ', p.n) { return ø }
	type_end = name_end(p.code, p.at + 1, p.n)
	if type_end == p.at + 1 or not is_at(p.code, type_end, '.', p.n) { return ø }
	end = name_end(p.code, type_end + 1, p.n)
	if end == type_end + 1 { return ø }
	name = p.code[p.at + 1 .. end]
	p.at = end
	listed("(", "", [symbol("wasm_instruction"), name])
}

// A case of an enum, no constant: `Node.True`, `Node::Empty`, `None` in `enum Bracket { Round, None }`
// Rust twin: atoms.rs check_constants (at_member_name, at_scoped_name, in_enum_cases)
def names_case(p, length) {
	start = p.at - length
	if p.enum_cases or (start > 0 and p.code[start - 1] == '.') { return true }
	if not (start > 1 and p.code[start - 2 .. start] == "::") { return false }
	scope = start - 2
	while scope > 0 and is_name_char(p.code[scope - 1]) { scope = scope - 1 }
	scope < start - 2 and p.code[scope].upper() == p.code[scope] and p.code[scope].lower() != p.code[scope]
}

// The items of a `{…}` group, the parser after its `{`; after `enum Name` they are the enum's cases
// Rust twin: types/declarations.rs enum_name_and_cases
def braced_items(p) {
	outer = p.enum_cases
	p.enum_cases = outer or enum_body_at(p)
	block = items(p, '}', "{")
	p.enum_cases = outer
	block
}

// The `{` just read follows `enum Name`
def enum_body_at(p) {
	end = p.at - 1
	while end > 0 and is_blank(p.code[end - 1]) { end = end - 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start = start - 1 }
	if start == end { return false }
	keyword_end = start
	while keyword_end > 0 and is_blank(p.code[keyword_end - 1]) { keyword_end = keyword_end - 1 }
	keyword_end >= 4 and p.code[keyword_end - 4 .. keyword_end] == "enum" and (keyword_end == 4 or not is_name_char(p.code[keyword_end - 5]))
}

// `function add`, `func add`: the function add itself, where the expression ends after the name (or `on`, `is`
// follows: `map function square on xs`); `function add(x) {…}` defines it
// `function f`, `func f`: the function f as a value, marked as Rust's parser marks it (closures.rs
// FUNCTION_REFERENCE_MARK), so the closure pass makes it a closure, a nested one too
// Rust twin: definitions/functions.rs function_reference_after
FUNCTION_REFERENCE_MARK = "function_reference"
def function_reference(p) {
	at = blank_end(p, p.at)
	if at == p.at or at >= p.n or not is_alpha(p.code[at]) { return ø }
	end = name_end(p.code, at, p.n)
	rest = blank_end(p, end)
	next_word = p.code[rest .. name_end(p.code, rest, p.n)]
	if not (rest >= p.n or ";,)]}\n".contains(p.code[rest]) or next_word == "on" or next_word == "is") { return ø }
	p.at = end
	attributed(FUNCTION_REFERENCE_MARK, true, symbol(p.code[at .. end]))
}

// The items of an argument list: none for ø, the list's items, else the one argument; Swift's labeled parameter
// `greet(person name: String)` stays one argument
// Rust twin: atoms.rs function_call, is_labeled_parameter
def spread(arguments) {
	if arguments == ø { return [] }
	parts = group_parts(arguments)
	if parts != ø and not labeled_parameter(parts) { return parts#3 }
	[arguments]
}

// Every argument of `f(int x, float y)` as its typed parameter
// Rust twin: definitions/functions.rs typed_parameters
def typed_parameters(arguments) {
	parts = group_parts(arguments)
	if parts == ø or parts#2 != "," or #parts#3 == 0 { return typed_parameter(arguments) }
	listed(parts#1, ",", [typed_parameter(argument) for argument in parts#3])
}

// `f(int x)`, Go's `f(x int)`, `f(s Shape)` and `f(x of int)` as the typed parameter x:int; `f(vararg xs)`,
// `f(params int[] xs)` the rest parameter *xs; `f(int b = 2)` as b:int = 2; any other argument as it is
// Rust twin: definitions/functions.rs typed_parameter
def typed_parameter(argument) {
	parts = group_parts(argument)
	if parts == ø or parts#2 != " " or parts#1 == "[" or #parts#3 == 0 { return argument }
	words = parts#3
	first = words#1
	last = words#(words.length)
	if words.length == 2 and is_type_symbol(first) and is_symbol(last) { return Key(last, Op.Colon, first) }
	if words.length == 2 and is_symbol(first) and not is_type_symbol(first) and (is_type_symbol(last) or (is_symbol(last) and is_capitalized(name_of(last)))) {
		return Key(first, Op.Colon, last)
	}
	if words.length == 3 and words#2 == symbol("of") and is_type_symbol(last) and is_symbol(first) and not is_type_symbol(first) {
		return Key(first, Op.Colon, last)
	}
	if is_symbol(first) and REST_MARKERS.contains(name_of(first)) { return rest_parameter(last, argument) }
	if words.length == 2 and is_type_symbol(first) { return typed_default(last, first, argument) }
	argument
}

def is_capitalized(name) := name[0].upper() == name[0] and name[0].lower() != name[0]

// `vararg xs`, `params int[] xs: list` as the rest parameter *xs
def rest_parameter(last, argument) := match last {
	Symbol(name): symbol("*" + name)
	Key(name, Op.Colon, kind): { if name is symbol then symbol("*" + name_of(name)) else argument }
	_: argument
}

// `int b = 2` as b:int = 2
def typed_default(last, kind, argument) := match last {
	Key(name, Op.Assign, value): { if name is symbol then Key(Key(name, Op.Colon, kind), Op.Assign, value) else argument }
	_: argument
}

// The rest-parameter markers: Kotlin's `vararg xs`, C#'s `params int[] xs`
// Rust twin: warp_parser/definitions/functions.rs REST_MARKERS
REST_MARKERS = ["vararg", "params"]

def is_type_symbol(node) := is_symbol(node) and is_type_word(name_of(node))

// `person name: String`: a label, then the typed parameter, of a group's parts
def labeled_parameter(parts) := parts#2 == " " and #parts#3 == 2 and is_symbol(parts#3#1) and is_typed_name(parts#3#2)

def is_typed_name(node) := match node {
	Key(name, Op.Colon, kind): name is symbol
	_: no
}

// The words before a declared name that only say how it is declared: `global mutable x`, `export const y`; a type
// word types it, `global int n = 0` is `n:int = 0`
// Rust twin: mod.rs DECLARATION_MODIFIERS, words.rs CONSTANT_KEYWORDS, analyzer type_word_kind
DECLARATION_MODIFIERS = ["export", "mutable", "mut", "const", "constant", "final", "val"]
// the type words of words.warp, as Rust reads them (`global long k = 7`)
DECLARED_TYPE_WORDS = type_words

// `global x = 1`, `global n`, `export api: clock` as `global: x = 1`, a module-level variable; `global a, b` declares
// each; `export` without a name after it stays a word
// Rust twin: definitions/variables.rs try_parse_global_declaration, skip_declaration_modifiers, typed_global
def global_declaration(p, keyword) {
	at = blank_end(p, p.at + keyword.length)
	if at == p.at + keyword.length or not is_name_start(peek(p.code, at, p.n)) { return ø }
	p.at = at
	type_word = ø
	while true {
		end = name_end(p.code, p.at, p.n)
		word = p.code[p.at .. end]
		after = blank_end(p, end)
		if not (DECLARATION_MODIFIERS contains word or DECLARED_TYPE_WORDS contains word) or not is_name_start(peek(p.code, after, p.n)) { break }
		if DECLARED_TYPE_WORDS contains word { type_word = word }
		p.at = after
	}
	declaration = expression(p, 0)
	if type_word != ø { declaration = typed_default(declaration, symbol(type_word), declaration) }
	names = [declaration]
	while keyword == "global" and is_symbol(names#(names.length)) and is_at(p.code, p.at, ',', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		names = names + [atom(p)]
	}
	declared = [Key(GLOBAL, Op.Colon, name) for name in names]
	if declared.length == 1 { return declared#1 }
	listed("", ";", declared)
}

// The statements an item stands for in its block: `global a, b` is the declarations `global: a` and `global: b`
// Rust twin: definitions/variables.rs declarations_of_several_globals
def statements_of(item) {
	parts = group_parts(item)
	if parts == ø or parts#1 != "" or parts#2 != ";" or #parts#3 == 0 { return [item] }
	for declaration in parts#3 {
		if not declares_global(declaration) { return [item] }
	}
	parts#3
}

GLOBAL = symbol("global")

def declares_global(node) := match node {
	Key(word, Op.Colon, name): word == GLOBAL
	_: no
}

// What follows the name of a lowercase `type`: `type point {…}`, `type size = u32`, `type pair<T>`
TYPE_BODY_STARTS = "{=:<"
// `class V { x: int }`, `struct P {…}`, `type Point {…}` as ["type", name, body], else ø with nothing read
// Rust twin: mod.rs TYPE_DECLARATION_WORDS, types/declarations.rs declares_type
def type_declaration(p, word) {
	if (p.at > 0 and p.code[p.at - 1] == '.') or not declares_type(p, word) { return ø }
	outer = p.type_body
	p.type_body = true
	declaration = declared_type(p, word)
	p.type_body = outer
	declaration
}

// `class:"btn"`, `type = "text"` are keys and `type(x)`, `type 3.5` the type of a value: a declaration names its type,
// after `type` a capital name or a name with its body
// Rust twin: types/declarations.rs declares_type, type_declaration_follows
def declares_type(p, word) {
	at = blank_end(p, p.at + word.length)
	c = peek(p.code, at, p.n)
	if (c == ':' or c == '=') and peek(p.code, at + 1, p.n) != '=' { return false }
	if word != "type" { return true }
	if not is_name_start(c) { return false }
	end = symbol_end(p.code, at, p.n)
	after = blank_end(p, end)
	body_follows = TYPE_BODY_STARTS.contains(peek(p.code, after, p.n)) and peek(p.code, after + 1, p.n) != '='
	c.upper() == c or body_follows or p.code[at .. end] == "of"
}

// After the spaces, tabs and inline block comments from `from` on: `1 /* inline */ + 1`
// Rust twin: comments.rs skip_spaces_and_inline_comments
def blank_end(p, from) {
	at = from
	while true {
		at = spaces_end(p, at)
		following = peek(p.code, at + 1, p.n)
		if not is_at(p.code, at, '/', p.n) or not (following == '*' or following == '#') { return at }
		at = block_comment_end(p.code, at, following, p.n)
	}
}

// The name and `{fields}` of a type declaration; `class Dog extends Animal` carries its parent on the name, a bare
// `class Marker` is marked and gets an empty body
// Rust twin: types/declarations.rs parse_class_declaration, parse_type_declaration_body
def declared_type(p, word) {
	p.at = p.at + word.length
	skip_blanks(p)
	end = symbol_end(p.code, p.at, p.n)
	name = symbol(p.code[p.at .. end])
	// `mixin Name {…}`: the type its classes take the methods of (foreign_forms.warp)
	if word == "mixin" { name = attributed("mixin", true, name) }
	p.at = end
	parameters = type_parameters(p)
	ends_statement = ";}\n".contains(peek(p.code, blank_end(p, p.at), p.n))
	skip_blanks(p)
	if keyword_at(p, "extends") {
		p.at = p.at + 7
		skip_blanks(p)
		end = symbol_end(p.code, p.at, p.n)
		name = attributed("extends", symbol(p.code[p.at .. end]), name)
		p.at = end
		skip_blanks(p)
	}
	// `class ParseError: Error` ending its line: the parent (Rust twin: skip_conformances)
	if is_at(p.code, p.at, ':', p.n) {
		parent_at = blank_end(p, p.at + 1)
		parent_end = symbol_end(p.code, parent_at, p.n)
		initial = peek(p.code, parent_at, p.n)
		if parent_end > parent_at and initial.upper() == initial and initial.lower() != initial and ";\n".contains(peek(p.code, blank_end(p, parent_end), p.n)) {
			p.at = parent_end
			return declared_type_node(attributed("extends", symbol(p.code[parent_at .. parent_end]), name), listed("{", "", []))
		}
	}
	start = variants_start(p)
	if start >= 0 { return sum_type(p, name, start, parameters) }
	// `type Box[T]: { item: T }`
	if is_at(p.code, p.at, ':', p.n) and peek(p.code, blank_end(p, p.at + 1), p.n) == '{' { p.at = blank_end(p, p.at + 1) }
	if is_at(p.code, p.at, '{', p.n) {
		p.at = p.at + 1
		body = items(p, '}', "{")
		fields = group_parts(body)
		if fields != ø and fields#1 == "{" { body = listed("{", fields#2, fields#3.map(field => untyped(field, parameters))) }
		return declared_type_node(name, body)
	}
	if not ends_statement { return type_node(name, ø) }
	if word == "class" { name = attributed("bare_class", true, name) }
	declared_type_node(name, listed("{", "", []))
}

// A type declaration, its fields typed
// Rust twin: types/declarations.rs transform_fields_to_types
def declared_type_node(name, body) := type_node(name, typed_fields(body))

// `= Some(T) | None`, `: red | rgb(int, int, int)`, Elm's `= Failure HttpError | …` on lines of their own: the position
// after the `=` or `:` when the declaration lists alternatives one of which carries a payload, else -1
// Rust twin: types/declarations.rs variants_ahead
def variants_start(p) {
	at = space_end(p.code, p.at, p.n)
	sign = peek(p.code, at, p.n)
	next = peek(p.code, at + 1, p.n)
	if not ((sign == '=' and next != '=' and next != '>') or (sign == ':' and next != '=')) { return -1 }
	start = at + 1
	depth = 0
	alternatives = false
	payload = false
	words = 0
	at = start
	while at < p.n {
		c = p.code[at]
		after_word = is_name_char(p.code[at - 1])
		if depth == 0 and ";)]}".contains(c) { break }
		if depth == 0 and c == '\n' and peek(p.code, space_end(p.code, at + 1, p.n), p.n) != '|' { break }
		if c == '(' and depth == 0 and after_word { payload = true }
		if "([{".contains(c) {
			depth = depth + 1
		} else if ")]}".contains(c) {
			depth = depth - 1
		} else if c == '|' and depth == 0 and peek(p.code, at + 1, p.n) == '|' {
			at = at + 1
		} else if c == '|' and depth == 0 {
			alternatives = true
			words = 0
		} else if depth == 0 and is_name_char(c) and not after_word {
			words = words + 1
			payload = payload or words > 1
		}
		at = at + 1
	}
	if alternatives and payload then start else -1
}

// `Box[T]`, `Pair<A, B>`: the names of a declared type's parameters, read
// Rust twin: types/declarations.rs parse_type_parameters
def type_parameters(p) {
	names = []
	if not (is_at(p.code, p.at, '[', p.n) or is_at(p.code, p.at, '<', p.n)) { return names }
	closer = if p.code[p.at] == '[' then ']' else '>'
	p.at = p.at + 1
	while true {
		p.at = space_end(p.code, p.at, p.n)
		end = symbol_end(p.code, p.at, p.n)
		if end == p.at { break }
		names += [p.code[p.at .. end]]
		p.at = space_end(p.code, end, p.n)
		if is_at(p.code, p.at, ',', p.n) { p.at = p.at + 1 }
	}
	if is_at(p.code, p.at, closer, p.n) { p.at = p.at + 1 }
	names
}

// A field of a type parameter holds any value: `item: T` of `Box[T]` is `item: any`
// Rust twin: types/declarations.rs any_for_type_parameters
def untyped(field, parameters) := match field {
	Key(name, Op.Colon, kind): { if kind is symbol and parameters.contains(name_of(kind)) then Key(name, Op.Colon, symbol("any")) else field }
	_: field
}

def space_end(code, from, n) {
	at = from
	while at < n and " \t\r\n".contains(code[at]) { at = at + 1 }
	at
}

// The sum type `Name = A(T) | B | C(x: int)` (card sum-types): the type without fields, its variants without payload
// by name, then a class extending it for each variant with a payload
// Rust twin: types/declarations.rs parse_sum_type, sum_variants.rs sum_type
def sum_type(p, name, start, parameters) {
	p.at = start
	bare = []
	classes = []
	while true {
		p.at = space_end(p.code, p.at, p.n)
		end = symbol_end(p.code, p.at, p.n)
		if end == p.at { raise "a variant of " + view_of(name)#2 + " needs a name" }
		variant = p.code[p.at .. end]
		p.at = end
		payload = []
		if is_at(p.code, p.at, '(', p.n) {
			p.at = p.at + 1
			group = items(p, ')', "(")
			payload = if is_list_of(group, "(") then group_parts(group)#3 else [group]
		}
		// Elm's `Failure HttpError`: the payload's types after the name
		skip_spaces(p)
		while is_name_start(peek(p.code, p.at, p.n)) {
			end = symbol_end(p.code, p.at, p.n)
			payload += [symbol(p.code[p.at .. end])]
			p.at = end
			skip_spaces(p)
		}
		if payload.length == 0 { bare += [symbol(variant)] } else { classes += [variant_class(name, variant, payload, parameters)] }
		after = space_end(p.code, p.at, p.n)
		if peek(p.code, after, p.n) != '|' { break }
		p.at = after + 1
	}
	sum_type_of(name, bare, classes)
}

// The sum type of its bare variants by name, then the classes of the variants with a payload
// Rust twin: sum_variants.rs sum_type
def sum_type_of(name, bare, classes) := listed("", ";", [declared_type_node(attributed("variants", listed("", " ", bare), name), listed("{", "", []))] + classes)

// `enum Shape { Circle(r), Rect(w, h), Dot }` follows `enum`: its braced cases, one with values
// Rust twin: types/declarations.rs enum_body_ahead
def enum_values_ahead(p) {
	at = name_end(p.code, blank_end(p, p.at), p.n)
	if at == blank_end(p, p.at) { return false }
	at = space_end(p.code, at, p.n)
	if not is_at(p.code, at, '{', p.n) { return false }
	depth = 0
	while at < p.n {
		c = p.code[at]
		if c == '(' and depth == 1 and is_name_char(p.code[at - 1]) { return true }
		if "([{".contains(c) {
			depth = depth + 1
		} else if ")]}".contains(c) {
			if depth == 1 { return false }
			depth = depth - 1
		}
		at = at + 1
	}
	false
}

// `enum Shape { Circle(r), Rect(w, h), Dot }`, Swift's `case circle(radius: Double)` lines: each case with values a
// class extending Shape, the others its variants by name, as the sum type `Circle(r) | Rect(w, h) | Dot`
// Rust twin: types/declarations.rs parse_enum_with_values
def enum_with_values(p) {
	p.at = blank_end(p, p.at)
	end = name_end(p.code, p.at, p.n)
	name = symbol(p.code[p.at .. end])
	p.at = space_end(p.code, end, p.n) + 1
	cases = braced_items(p)
	bare = []
	classes = []
	for case in case_rows(cases).map(without_case_word) {
		parts = group_parts(case)
		if parts != ø and #parts#3 > 0 and is_symbol(parts#3#1) {
			classes += [variant_class(name, name_of(parts#3#1), parts#3[1:], [])]
		} else if is_symbol(case) {
			bare += [case]
		} else {
			raise "a case of enum " + name_of(name) + " is a name with optional values"
		}
	}
	sum_type_of(name, bare, classes)
}

// The cases of an enum body, a line of several cases `Add, Sub, Mul` among lines of cases each a case
// Rust twin: sum_variants.rs case_rows
def case_rows(cases) {
	rows = []
	for case in group_parts(cases)#3 {
		row = group_parts(case)
		if row != ø and row#1 == "" and row#2 == "," { rows += row#3 } else { rows += [case] }
	}
	rows
}

// Swift's `case circle(radius: Double)` as `circle(radius: Double)`
// Rust twin: types/declarations.rs without_case_keyword
def without_case_word(case) {
	words = group_parts(case)
	if words != ø and words#1 == "" and #words#3 == 2 and words#3#1 == symbol("case") then words#3#2 else case
}

// The words of the built-in types a variant's payload names: `rgb(int, int, int)` gives types, `rgb(r, g, b)` fields
// Rust twin: analyzer builtin_type_kind
BUILTIN_TYPE_WORDS = DECLARED_TYPE_WORDS + ["list", "map", "any", "real", "rational", "exact", "long", "double", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64"]

// A variant with a payload: the class extending the sum type, its fields in order (an unnamed one is `value`, several
// `value1`, `value2`…, a lowercase name that is no type a field of any value)
// Rust twin: types/declarations.rs variant_class
def variant_class(type_name, variant, payload, parameters) {
	fields = []
	position = 0
	for field in payload {
		position = position + 1
		// `(T)` and `(radius: int)` arrive as groups of one
		if is_list_of(field, "(") and #group_parts(field)#3 == 1 { field = group_parts(field)#3#1 }
		if is_typed_field(field) {
			fields += [field]
		} else if is_symbol(field) and name_of(field)[0].lower() == name_of(field)[0] and not BUILTIN_TYPE_WORDS.contains(name_of(field)) {
			fields += [Key(field, Op.Colon, symbol("any"))]
		} else {
			field_name = if payload.length == 1 then "value" else "value" + position
			fields += [Key(symbol(field_name), Op.Colon, field)]
		}
	}
	declared_type_node(attributed("extends", type_name, symbol(variant)), listed("{", ";", fields.map(field => untyped(field, parameters))))
}

def is_typed_field(node) := match node {
	Key(name, Op.Colon, kind): yes
	_: no
}

// The digits of a number in `base` (`_` between digits), read
// Rust twin: literals.rs read_number_value, its 0x and 0b branches
def radix_value(p, base) {
	value = 0
	while p.at < p.n {
		c = p.code[p.at]
		separates = c == '_' and (base == 2 or digit_value(peek(p.code, p.at + 1, p.n)) < base)
		if not separates {
			digit = digit_value(c)
			if digit >= base { return value }
			value = value * base + digit
		}
		p.at = p.at + 1
	}
	value
}

// The value of a hex digit, 16 for any other character
def digit_value(c) {
	small = "0123456789abcdef"
	capital = "0123456789ABCDEF"
	i = 0
	while i < 16 and small[i] != c and capital[i] != c { i = i + 1 }
	i
}

// A decimal number as written, read: digits (`_` between them dropped), a fraction unless `..` or a name follows the
// point, an exponent
// Rust twin: literals.rs push_digits, read_number_value, parse_exponent
def decimal_number(p) {
	written = digits_read(p)
	after_point = peek(p.code, p.at + 1, p.n)
	if is_at(p.code, p.at, '.', p.n) and after_point != '.' and not is_name_start(after_point) {
		p.at = p.at + 1
		written = written + "." + digits_read(p)
	}
	e = peek(p.code, p.at, p.n)
	sign = peek(p.code, p.at + 1, p.n)
	signed = (sign == '+' or sign == '-') and is_digit(peek(p.code, p.at + 2, p.n))
	if (e == 'e' or e == 'E') and (is_digit(sign) or signed) {
		p.at = p.at + 1
		if signed { p.at = p.at + 1 }
		exponent = digits_read(p)
		// 1e3 is the exact integer 1000, like the literal it abbreviates
		if written.contains(".") or sign == '-' { return written + "e" + (if sign == '-' then "-" else "") + exponent }
		zeros = int(exponent)
		while zeros > 0 {
			written = written + "0"
			zeros = zeros - 1
		}
	}
	written
}

def digits_read(p) {
	written = ""
	while p.at < p.n {
		c = p.code[p.at]
		if is_digit(c) {
			written = written + c
		} else if not (c == '_' and p.at > 0 and is_digit(p.code[p.at - 1]) and is_digit(peek(p.code, p.at + 1, p.n))) {
			return written
		}
		p.at = p.at + 1
	}
	written
}

// A text in quotes, its backslash escapes read; one character is a codepoint
// Rust twin: literals.rs read_text
def quoted(p) {
	opening = code_points("" + p.code[p.at])
	quote = opening#1
	marks = ""
	for mark in opening[1 .. opening.length] { marks = marks + mark }
	end = text_end(p.code, p.at + 1, quote, p.n)
	written = marks + p.code[p.at + 1 .. end - 1]
	p.at = end
	holed = if quote == '"' then template(written) else ø
	if holed != ø { return template_node(holed) }
	content = unescaped(written, quote == '"')
	if content.length == 1 then content[0] else content
}

// An interpolating text with a hole as its template: holes `\(x)` `\{x}` `$(x)` as `${x}`, escapes read, a literal
// dollar `$$` unless a name follows it (the bare `$name` of sql and sh templates); ø without a hole. An escaped
// dollar makes a template too: it is never a hole
// Rust twin: literals/text.rs read_text
def template(written) {
	read = ""
	holed = no
	at = 0
	n = written.length
	while at < n {
		c = written[at]
		next = peek(written, at + 1, n)
		if (c == '\\' or c == '$') and (next == '(' or next == '{') {
			end = hole_end(written, at + 2, next, closing_of(next), n)
			read = read + "\${" + written[at + 2 .. end - 1] + "}"
			holed = yes
			at = end
		} else if c == '\\' and at + 1 < n and next == ':' and at + 2 < n and is_alpha(written[at + 2]) {
			read = read + c + next
			at = at + 2
		} else if c == '\\' and code_escape(written, at, n) != ø {
			coded = code_escape(written, at, n)
			read = read + coded#1
			at = at + coded#2
		} else if c == '\\' and at + 1 < n {
			literal = escape_character(next)
			holed = holed or literal == '$'
			read = read + (if literal == '$' then "$$" else literal)
			at = at + 2
		} else if c == '$' {
			read = read + (if is_alpha(next) or next == '_' then "$" else "$$")
			at = at + 1
		} else {
			read = read + c
			at = at + 1
		}
	}
	if holed then read else ø
}

// A text's escapes read: `\n` `\t` `\r` `\e` as their characters, `\"` `\\` and the like as the character itself;
// entities `\:alpha` stay as written in an interpolating text (holes went to template)
// Rust twin: literals/text.rs read_text
def unescaped(content, interpolates) {
	if not content.contains("\\") { return content }
	read = ""
	at = 0
	while at < content.length {
		c = content[at]
		escaped = if at + 1 < content.length then content[at + 1] else ' '
		if c != '\\' or at + 1 >= content.length {
			read = read + c
			at = at + 1
		} else if interpolates and escaped == ':' and at + 2 < content.length and is_alpha(content[at + 2]) {
			read = read + c + escaped
			at = at + 2
		} else if code_escape(content, at, content.length) != ø {
			coded = code_escape(content, at, content.length)
			read = read + coded#1
			at = at + coded#2
		} else {
			read = read + escape_character(escaped)
			at = at + 2
		}
	}
	read
}

// `\x41`, `\u{1b}` at the backslash `at`: [the character, the length read], else ø
// Rust twin: literals/text.rs hex_byte_escape, unicode_escape
def code_escape(written, at, n) {
	kind = peek(written, at + 1, n)
	if kind == 'x' and is_hex_digit(peek(written, at + 2, n)) and is_hex_digit(peek(written, at + 3, n)) {
		return [hex_value(written[at + 2 .. at + 4]) as codepoint, 4]
	}
	if kind == 'u' and peek(written, at + 2, n) == '{' {
		end = at + 3
		while end < n and is_hex_digit(written[end]) { end = end + 1 }
		if end > at + 3 and peek(written, end, n) == '}' { return [hex_value(written[at + 3 .. end]) as codepoint, end + 1 - at] }
	}
	ø
}

// The number the hex digits write
def hex_value(digits) {
	value = 0
	for digit in digits { value = value * 16 + "0123456789abcdef".index_of(digit.lower()) - 1 }
	value
}

def escape_character(c) {
	if c == 'n' { return '\n' }
	if c == 't' { return '\t' }
	if c == 'r' { return '\r' }
	if c == 'e' { return '\e' }
	c
}
