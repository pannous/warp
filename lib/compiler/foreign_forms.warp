// Other languages' ways of writing a declaration (card pure-class-forms): the modifiers `public static fun f()`,
// `private x = 4`, `static k = 3` (P78), and the forms `new Point(1, 2)`, `constant x`, Ruby's `attr_accessor :x`,
// Kotlin's `enum class` and `data class`, `mixin Name {…}`, read as the warp form they mean
// Rust twin: src/warp_parser/definitions/foreign.rs

// Modifiers of other languages with no meaning in warp: skipped (user decision P78); `static` marks the statement
// Rust twin: foreign.rs FOREIGN_MODIFIERS
FOREIGN_MODIFIERS = ["public", "private", "protected", "internal", "static", "extern", "external", "C", "inline", "local", "virtual", "override", "abstract", "constexpr", "volatile", "thread_local", "synchronized", "transient", "native"]
// Modifiers with a warp meaning that change nothing before a function definition (a function is global and constant)
// Rust twin: foreign.rs DEFINITION_MODIFIERS
DEFINITION_MODIFIERS = ["global", "export", "import", "const", "final", "mutable", "mut"]
// Words before a class declaration that change nothing in warp: `data class` (a warp class compares by value already),
// `open`, `abstract`, `sealed`, `final`, visibility
// Rust twin: foreign.rs CLASS_MODIFIERS
CLASS_MODIFIERS = ["data", "open", "abstract", "sealed", "final", "public", "private", "internal"]
// The declaration words a class modifier stands before
// Rust twin: mod.rs TYPE_DECLARATION_WORDS
CLASS_KEYWORDS = ["class", "struct"]
// Ruby's field declarations `attr_accessor :x, :y`
RUBY_FIELD_WORDS = ["attr_accessor", "attr_reader", "attr_writer"]
STATIC_WORD = "static"

// The form another language writes with `word` at the parser's position, the parser after it; else ø, nothing read
// Rust twin: atoms.rs keyword_form (skip_foreign_modifiers), foreign.rs foreign_form
def foreign_form(p, word) {
	if starts_statement(p) {
		skipped = without_foreign_modifiers(p, word)
		if skipped != ø { return skipped }
	}
	keyword = class_keyword_after(p, word)
	if keyword != "" and CLASS_MODIFIERS.contains(word) {
		p.at = blank_end(p, p.at + word.length)
		return type_declaration(p, keyword)
	}
	if word == "new" and p.types.contains(name_after_blanks(p, word)) {
		p.at = blank_end(p, p.at + word.length)
		return atom(p)
	}
	if word == "constant" and name_after_blanks(p, word) != "" {
		p.at = p.at + word.length
		return symbol("const")
	}
	if word == "enum" and keyword == "class" {
		p.at = blank_end(p, p.at + word.length) + keyword.length
		return symbol(word)
	}
	if p.type_body and RUBY_FIELD_WORDS.contains(word) { return ruby_fields(p, word) }
	if word == "mixin" and block_after_name(p, word) { return type_declaration(p, word) }
	ø
}

// Only blanks stand between the start of the statement and the parser's position
// Rust twin: atoms.rs word_starts_statement
def starts_statement(p) {
	at = p.at - 1
	while at >= 0 and " \t\r".contains(p.code[at]) { at = at - 1 }
	at < 0 or "\n;{".contains(p.code[at])
}

// `public static fun f(){…}`, `private x = 4` (P78): a run of modifiers that ends before a function definition, or of
// modifiers without warp meaning before a name, is skipped; the statement after it, marked @static after `static`
// Rust twin: foreign.rs skip_foreign_modifiers
def without_foreign_modifiers(p, first) {
	if not is_modifier(first) { return ø }
	words = [first]
	at = p.at + first.length
	while true {
		start = spaces_end(p, at)
		// `public = 3`, `public(…)`: a name
		if start == at { return ø }
		at = name_end(p.code, start, p.n)
		next = p.code[start .. at]
		if not is_modifier(next) {
			foreign_only = words.all(word => FOREIGN_MODIFIERS.contains(word))
			if next == "" or not (function_keywords.contains(next) or foreign_only) { return ø }
			p.at = start
			statement = expression(p, 0)
			return if words.contains(STATIC_WORD) then attributed(STATIC_WORD, true, statement) else statement
		}
		words += [next]
	}
}

def is_modifier(word) := FOREIGN_MODIFIERS.contains(word) or DEFINITION_MODIFIERS.contains(word)

// The name after one or more blanks behind `word`, else ""
// Rust twin: declarations.rs identifier_after_blanks, declared_type_after_blanks
def name_after_blanks(p, word) {
	start = spaces_end(p, p.at + word.length)
	if start == p.at + word.length { return "" }
	p.code[start .. name_end(p.code, start, p.n)]
}

// `class` or `struct` after the blanks behind `word`, the word a class modifier stands before, else ""
// Rust twin: declarations.rs class_keyword_after_blanks
def class_keyword_after(p, word) {
	name = name_after_blanks(p, word)
	if CLASS_KEYWORDS.contains(name) then name else ""
}

// Ruby's `attr_accessor :x, :y` in a class body: the fields x and y, read to the end of the line
// Rust twin: foreign.rs foreign_form (RUBY_FIELD_WORDS)
def ruby_fields(p, word) {
	start = p.at + word.length
	end = start
	while end < p.n and not "\n;}".contains(p.code[end]) { end = end + 1 }
	names = p.code[start .. end].split(",").map(name => without_colon(name.trim()))
	if not names.all(name => name != "" and name_end(name, 0, name.length) == name.length) { return ø }
	p.at = end
	listed("", ";", names.map(name => symbol(name)))
}

def without_colon(name) := if starts_at(name, ":", 0) then name[1 .. name.length] else name

// `mixin Name {`: a name and a block after the blanks behind `word`
// Rust twin: scanning.rs name_and_block_follow
def block_after_name(p, word) {
	name = name_after_blanks(p, word)
	name != "" and is_at(p.code, spaces_end(p, spaces_end(p, p.at + word.length) + name.length), '{', p.n)
}
