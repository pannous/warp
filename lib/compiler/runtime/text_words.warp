# Texts cut and searched by characters: slices, offsets, starts and ends, find, trim
use "intrinsics.warp"
use "library_words.warp"
use "characters.warp"
# the characters from..to of t, counted from 1, both included: the bytes between their lead bytes
text_slice(t: text, from: int, to: int): text := {
	start = character_offset(t, from)
	bytes_between(t, start, character_offset(t, to + 1))
}
# the byte offset of t's index-th character, counted from 1; past the last, the byte count
character_offset(t: text, index: int): int := {
	at = 0
	for counted in 1..<index {
		if at < byte_count(t) { at += 1 }
		while at < byte_count(t) and is_continuation_byte(byte_at(t, at)) { at += 1 }
	}
	at
}
# t starts with the bytes of start
text_starts_with(t: text, start: text): bool := byte_count(start) <= byte_count(t) and bytes_match_at(t, start, 0)
# t ends with the bytes of end
text_ends_with(t: text, end: text): bool := byte_count(end) <= byte_count(t) and bytes_match_at(t, end, byte_count(t) - byte_count(end))
# part's bytes stand in t from byte offset at on
bytes_match_at(t: text, part: text, at: int): bool := {
	for i in 0..byte_count(part) {
		if byte_at(t, at + i) != byte_at(part, i) { return no }
	}
	yes
}
# the character position of part's first place in t, counted from 1; 0 when t holds no part
text_find(t: text, part: text): int := {
	at = 0
	position = 1
	while at <= byte_count(t) - byte_count(part) {
		if bytes_match_at(t, part, at) { return position }
		at = character_end(t, at)
		position += 1
	}
	0
}
# t without the spaces, tabs and line breaks at its two ends
text_trim(t: text): text := {
	start = 0
	while start < byte_count(t) and is_space_byte(byte_at(t, start)) { start += 1 }
	stop = byte_count(t)
	while stop > start and is_space_byte(byte_at(t, stop - 1)) { stop -= 1 }
	bytes_between(t, start, stop)
}

## print without texts (`use native`): straight from ints and linear memory into the output bytes, no GC value made
# n's decimal digits and a newline to stdout; its digits counted on the negative side, where every int has its magnitude
print_int_line(n: int): int := {
	at = if n < 0 then 1 else 0
	if n < 0 { output_byte(0, Ascii.Minus) }
	low = if n < 0 then n else 0 - n
	width = 1
	rest = toward_zero_tenth(low)
	while rest < 0 {
		width += 1
		rest = toward_zero_tenth(rest)
	}
	rest = low
	for i in 0..<width {
		output_byte(at + width - 1 - i, Ascii.Zero + last_digit_below_zero(rest))
		rest = toward_zero_tenth(rest)
	}
	output_byte(at + width, Ascii.Newline)
	write_output(at + width + 1)
}
# low (0 or less) divided by 10, rounded toward 0, and the digit that drops
toward_zero_tenth(low: int): int := if low % 10 == 0 then floor_quotient(low, 10) else floor_quotient(low, 10) + 1
last_digit_below_zero(low: int): int := if low % 10 == 0 then 0 else 10 - low % 10
# the NUL-terminated bytes at address (a cstr, `"hi" as cstr`) and a newline to stdout, the output room at a time
print_cstr_line(address: int): int := {
	at = address
	count = 0
	while memory_byte(at) != 0 {
		if count == output_room() {
			write_output(count)
			count = 0
		}
		output_byte(count, memory_byte(at))
		count += 1
		at += 1
	}
	if count == output_room() {
		write_output(count)
		count = 0
	}
	output_byte(count, Ascii.Newline)
	write_output(count + 1)
}
