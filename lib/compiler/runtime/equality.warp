# `a == b` of values known only at run time
# `a == b` of values known only at run time: ø equals only ø, lists equal item by item, closures by their target and
# captured values (emitter.warp closure_value), texts and characters as texts, numbers as numbers (an int and a float alike)
node_equal(a: any, b: any): bool := {
	if is_null(a) == 1 or is_null(b) == 1 { return is_null(a) == is_null(b) }
	if kind_code(a) == 6 or kind_code(b) == 6 {
		return code_free_kind(a) == code_free_kind(b) and text_order(key_name(a), key_name(b)) == 0 and node_equal(key_value(a), key_value(b))
	}
	if marked_kind(a) == 8 and marked_kind(b) == 8 { return map_equal(a, b) }
	if kind_code(a) == 8 or kind_code(b) == 8 { return kind_code(a) == kind_code(b) and list_equal(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == 16 or kind_code(b) == 16 { return kind_code(a) == kind_code(b) and list_equal(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == 5 or kind_code(b) == 5 { return kind_code(a) == kind_code(b) and text_order(unboxed_text(a), unboxed_text(b)) == 0 }
	if textual_node(a) == 1 or textual_node(b) == 1 { return textual_node(a) == textual_node(b) and text_order(node_text(a), node_text(b)) == 0 }
	if kind_code(a) == 1 and kind_code(b) == 1 and is_ratio(a) + is_ratio(b) > 0 { return exact_order(a, b) == 0 }
	if kind_code(a) == 1 and kind_code(b) == 1 { return unboxed_int(a) == unboxed_int(b) }
	# times: the same form at the same position; any other value besides a number is none of the numbers
	if kind_code(a) == 18 and kind_code(b) == 18 { return marked_kind(a) == marked_kind(b) and unboxed_int(a) == unboxed_int(b) }
	if numeric_node(a) + numeric_node(b) < 2 { return no }
	float_of_node(a) == float_of_node(b)
}
list_equal(a: list, b: list): bool := {
	if #a != #b { return no }
	for i in 1 to #a { if not node_equal(a#i, b#i) { return no } }
	yes
}
# `a == b` of two maps: the same names with equal values, in any order
map_equal(a: any, b: any): bool := {
	if #unboxed_list(a) != #unboxed_list(b) { return no }
	# its own search, not map_index's: map_index may still be compiling here (map_index → key_name → node_text → …
	# node_equal → map_equal), its result kind not known yet
	for entry in unboxed_list(a) {
		found = no
		for other in unboxed_list(b) {
			if text_order(key_name(entry), key_name(other)) == 0 {
				if not node_equal(key_value(entry), key_value(other)) { return no }
				found = yes
			}
		}
		if not found { return no }
	}
	yes
}
