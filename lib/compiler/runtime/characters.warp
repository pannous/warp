# The characters (grapheme clusters) of texts and the walks `t#i` and `for ch in t` take over them
# the bytes of the code point whose UTF-8 starts with the byte lead
code_point_width(lead: int): int := if lead < 128 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4
# the code point whose UTF-8 bytes start at byte `at` of t
code_point_at(t: text, at: int): int := {
	lead = byte_at(t, at)
	n = if lead < 128 then lead else if lead < 224 then lead - 192 else if lead < 240 then lead - 224 else lead - 240
	for k in 1 to code_point_width(lead) - 1 { n = n * 64 + byte_at(t, at + k) - 128 }
	n
}
within(c: int, low: int, high: int): bool := c >= low and c <= high
# `n as char`, `n as codepoint` (Rust's casts.rs emit_code_point, decision digit-as-char): a digit 0…9 is its digit
# character, as '5' as int is 5; another number the character of that code point, one no character has (beyond
# U+10FFFF, a surrogate) the error invalid_code_point
cast_code_point(n: int): int := {
	if within(n, 0, 9) { return n + 48 }
	if n < 0 or n > 1114111 or within(n, 55296, 57343) { invalid_code_point() }
	n
}
# a code point that continues the character before it: combining marks, variation selectors, skin tones, ZWJ …
# (src/extensions/strings.rs GRAPHEME_EXTEND, the same table)
extends_character(c: int): bool := {
	if c < 768 { return no }
	if within(c, 768, 879) { return yes }
	if within(c, 1155, 1161) { return yes }
	if within(c, 1425, 1469) { return yes }
	if within(c, 1473, 1474) { return yes }
	if within(c, 1476, 1477) { return yes }
	if within(c, 1552, 1562) { return yes }
	if within(c, 1611, 1631) { return yes }
	if within(c, 1648, 1648) { return yes }
	if within(c, 1750, 1756) { return yes }
	if within(c, 2304, 2307) { return yes }
	if within(c, 2362, 2364) { return yes }
	if within(c, 2366, 2383) { return yes }
	if within(c, 2385, 2391) { return yes }
	if within(c, 2402, 2403) { return yes }
	if within(c, 3633, 3633) { return yes }
	if within(c, 3636, 3642) { return yes }
	if within(c, 3655, 3662) { return yes }
	if within(c, 6832, 6911) { return yes }
	if within(c, 7616, 7679) { return yes }
	if within(c, 8204, 8205) { return yes }
	if within(c, 8400, 8447) { return yes }
	if within(c, 12441, 12442) { return yes }
	if within(c, 65024, 65039) { return yes }
	if within(c, 65056, 65071) { return yes }
	if within(c, 127995, 127999) { return yes }
	if within(c, 917536, 917631) { return yes }
	within(c, 917760, 917999)
}
# after a ZWJ these join the character (emoji ZWJ sequences, GRAPHEME_PICTOGRAPHIC)
pictographic(c: int): bool := within(c, 9728, 10175) or within(c, 126976, 129791)
# a flag is a pair of these
regional_indicator(c: int): bool := within(c, 127462, 127487)
# the byte after the character (grapheme cluster) starting at byte `at` of t (src/extensions/strings.rs
# grapheme_clusters): controls stand alone but CR LF, a flag pairs two regional indicators
character_end(t: text, at: int): int := {
	previous = code_point_at(t, at)
	end = at + code_point_width(byte_at(t, at))
	if previous == 13 and end < byte_count(t) and byte_at(t, end) == 10 { return end + 1 }
	if previous < 32 or within(previous, 127, 159) { return end }
	unpaired = if regional_indicator(previous) then 1 else 0
	while end < byte_count(t) {
		next = code_point_at(t, end)
		if not (extends_character(next) or (previous == 8205 and pictographic(next)) or (unpaired == 1 and regional_indicator(next))) { return end }
		unpaired = 0
		previous = next
		end += code_point_width(byte_at(t, end))
	}
	end
}
# the character of t from byte `at` to end: a character value for one code point, else a text
character_between(t: text, at: int, end: int): any := {
	if end - at == code_point_width(byte_at(t, at)) { return char_of(code_point_at(t, at)) }
	bytes_between(t, at, end)
}
# the index-th character of t, counted from 1; an index outside 1…count fails as Rust's "index out of range"
text_char(t: text, index: int): any := {
	if index < 1 { index_out_of_range() }
	at = character_start(t, index)
	if at >= byte_count(t) { index_out_of_range() }
	character_between(t, at, character_end(t, at))
}
# the byte offset of t's index-th character, counted from 1; past the last, the byte count. It walks on from a walk
# over t at or before index, else back from one past it (walk_back), else from the start: a scan with look backs
# (`src[start..i]`) takes linear time, as Rust's text_grapheme_offset
character_start(t: text, index: int): int := {
	if walk_reaches(t, index) == 0 { swap_walks() }
	if walk_reaches(t, index) == 0 { walk_back(t, index) }
	if index < walked_index {
		walked_index -= 1
		walked_at = walked_before
		walked_before = -1
	}
	while walked_index < index and walked_at < byte_count(t) {
		walked_before = walked_at
		walked_at = character_end(t, walked_at)
		walked_index += 1
	}
	walked_at
}
# How far (bytes) walk_back looks back from a walk; further back, an index walks from the start (Rust's BACK_REACH)
back_reach(): int := 256
# the walk over t moved back to a character at or before index by the ASCII bytes before it (each but \n starts a
# character: nothing joins an ASCII character to what precedes it, \r\n aside) and the characters counted from there
# (Rust's text_grapheme_back); a walk over another text, or none within back_reach, starts over at t's start
walk_back(t: text, index: int): int := {
	if same_text(t, walked_text) == 0 and same_text(t, other_text) == 1 { swap_walks() }
	if same_text(t, walked_text) == 0 or byte_count(t) < walked_bytes { return walk_from_start(t) }
	while walked_index > index {
		back = walked_at - 1
		while back >= 0 and back + back_reach() > walked_at and (byte_at(t, back) >= 128 or byte_at(t, back) == 10) { back -= 1 }
		if back < 0 or back + back_reach() <= walked_at { return walk_from_start(t) }
		at = back
		while at < walked_at {
			at = character_end(t, at)
			walked_index -= 1
		}
		walked_at = back
	}
	walked_before = -1
	0
}
walk_from_start(t: text): int := {
	walked_text = t
	walked_bytes = byte_count(t)
	walked_index = 1
	walked_at = 0
	walked_before = -1
	0
}
# 1 when the current walk is over t, or over the start of t that t grew from, and stands at index, before it or one
# past it
walk_reaches(t: text, index: int): int := {
	if same_text(t, walked_text) == 0 or byte_count(t) < walked_bytes or index < walked_index - 1 { return 0 }
	if index == walked_index - 1 and walked_before < 0 { return 0 }
	1
}
swap_walks(): int := {
	text = walked_text
	walked_text = other_text
	other_text = text
	bytes = walked_bytes
	walked_bytes = other_bytes
	other_bytes = bytes
	index = walked_index
	walked_index = other_index
	other_index = index
	at = walked_at
	walked_at = other_at
	other_at = at
	before = walked_before
	walked_before = other_before
	other_before = before
	0
}
