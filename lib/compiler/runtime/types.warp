# What kind a value known only at run time is: ø, errors, texts, `x is type`, `x is Name`
use "intrinsics.warp"
use "show.warp"
use "text.warp"
# `x == ø`: ø, and a list or map without items, as Rust's equality and print take them
is_nothing(n: Node): bool := if is_null(n) then yes else kind_code(n) == Kind.List and #unboxed_list(n) == 0
# `is_error(x)`: x is an Error value
node_is_error(n: Node): bool := not is_null(n) and kind_code(n) == Kind.Error
# a boxed text or character
textual_node(n: Node): bool := not is_null(n) and (kind_code(n) == Kind.Text or kind_code(n) == Kind.Codepoint)
# `x is type` of a value known only at run time, type a name of emitter.warp's covered_kinds: Rust's run-time kind
# masks (src/lowering/types/type_tests.rs BUILTIN_TYPES): a bool has a mark of its own, ø is the empty list
node_is_type(n: Node, type: text): bool := {
	if names_a_type(n) { return names_one_of(unboxed_text(n), covered_type_words(type)) }
	names_one_of(type, types_passed_by(kind_type_word(n)))
}
# the types `x is type` holds for, by x's type name: an int is a rational and a number, a float too (as Rust's
# BUILTIN_TYPES masks take it), a codepoint a text, a block a list
types_passed_by(name: text): list := match name {
	"block": ["list"]
	"int": ["int", "rational", "number"]
	"rational": ["rational", "number"]
	"float": ["float", "rational", "number"]
	"codepoint": ["char", "text"]
	_: [name]
}
# a type value `int`: a symbol marked TYPE_VALUE_MARK above its kind
names_a_type(n: Node): bool := not is_null(n) and marked_kind(n) == Marked.TypeValue
# a type value tests as the type it names: the words of the types a core type covers (type_tests.rs type_matches); a
# third copy of the type words beside words.warp type_kinds and emitter.warp core_type_words, as runtime bodies read no
# compiler globals yet (beautify-round, runtime constants)
covered_type_words(type: text): list := {
	ints = ["int", "integer", "long", "i64", "i32"]
	rationals = ints + ["rational", "real", "exact"]
	floats = ["float", "double", "f64", "f32", "float32", "float64", "fast"]
	chars = ["codepoint", "char", "character"]
	match type {
		"int": ints
		"rational": rationals
		"float": floats
		"number": rationals + floats + ["number"]
		"text": ["text", "str", "string"] + chars
		"char": chars
		"bool": ["bool", "boolean"]
		_: [type]
	}
}
# words are texts: unboxed_text, as node_text's variant patterns test types through node_is_type
names_one_of(name: text, words: list): bool := words.any(word => text_order(unboxed_text(word), name) == 0)
# `x is Name` of a class: an instance is an entry keyed by its class's name
instance_of(n: Node, name: text): bool := {
	if is_null(n) or kind_code(n) != Kind.Key { return no }
	text_order(key_name(n), name) == 0
}
# `type(x)` of a value known only at run time (Rust's list_ops.rs node_type_name): the type value naming its kind as
# the static names do; an instance names its class, one of the program's `classes`
node_type_name(n: any, classes: list): any := with_kind(symbol_of(node_type_word(n, classes)), Marked.TypeValue)
node_type_word(n: any, classes: list): text := {
	word = kind_type_word(n)
	if word != "key" { return word }
	for class_name in classes { if instance_of(n, class_name) { return class_name } }
	if key_operator(n) in operation_spellings() then "operation" else word
}
# the type word of x's kind alone, no class or operation told apart: what `x is type` tests, through no comparison
# of texts (a text equality tests types through node_is_type)
kind_type_word(n: any): text := {
	if is_null(n) { return "list" }
	if code_bit(n) == 1 { return "code" }
	if marked_kind(n) == Marked.Bool { return "bool" }
	if names_a_type(n) { return "type" }
	kind = kind_code(n)
	if kind == Kind.Int and is_ratio(n) { return "rational" }
	if marked_kind(n) == Marked.Map { return "map" }
	# a one-character text is a character (chars-codepoints): what a parameter given "a" holds
	if kind == Kind.Text and byte_count(unboxed_text(n)) > 0 and character_end(unboxed_text(n), 0) == byte_count(unboxed_text(n)) { return "codepoint" }
	kind_word(kind)
}
# the type word of a kind by its code (Rust's Kind names, RUN_TIME_TYPE_KINDS), data for the others: a match, as reading
# an item of a list asks node_is_type what it is
kind_word(kind: int): text := match kind {
	Kind.Empty: "empty"
	Kind.Int: "int"
	Kind.Float: "float"
	Kind.Text: "text"
	Kind.Codepoint: "codepoint"
	Kind.Symbol: "symbol"
	Kind.Key: "key"
	Kind.Block: "block"
	Kind.List: "list"
	Kind.Error: "error"
	Kind.TypeDef: "typedef"
	Kind.Function: "function"
	_: "data"
}
# the operators whose key computes a value, `1+1`, `a<b`, `-x` (Rust's Op::is_operation): a pair `a:1`, a binding
# `a=1` and a lookup `a.b` stay keys
operation_spellings(): list := ["+", "-", "*", "/", "/!", "%", "rem", "^", "<<", ">>", "<", ">", "<=", ">=", "==", "!=", "is",
	"===", "!==", "≈", "~", "and", "or", "xor", "&", "|", "not", "√", "∛", "‖", "⌞", "⌟", "±", "??", "↑", "↓"]
