## A list of bytes the host left in linear memory, made in one pass (card ffi-z): warp-host builds a C call's bytes
## (c_bytes, a bytes result) and any list of 0 to 255 with new_bytes when the program exports it, instead of a cell
## at a time with new_list, whose built_list joins each item ahead of the rest (a copy per item)
use "intrinsics.warp"
use "../kinds.warp"
use "nodes.warp"
built_bytes(address: int, length: int): Node := {
	items = new_list(length)
	for i in 1 to length { items#i = held(memory_byte(address + i - 1)) }
	list_node(KindUnit.Info + Kind.List, items)
}
