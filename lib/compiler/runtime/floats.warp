# Floats: rounding, their shortest text and digits
# `round(x)`: the nearest int, half to even as wasm rounds (f64.nearest)
rounded(x: float): int := truncated(float_nearest(x))
# the text of a run-time float (src/wasm_emitter/numbers/float_text.rs): its shortest digits that read back,
# positional from 1e-5 up to 1e15, else as 1.5e20 or 1e-7; ∞, -∞ and NaN as the exact numbers print them
float_text(x: float): text := {
	if x != x { return "NaN" }
	if x == float_of_bits(9218868437227405312) { return char_text("∞") }
	if x == -float_of_bits(9218868437227405312) { return "-∞" }
	if x == 0 { return char_text("0") }
	if x < 0 { return "-" + positive_float_text(-x) }
	positive_float_text(x)
}
positive_float_text(x: float): text := {
	found = float_digits(x)
	digits = int_text(unboxed_int(found#1))
	count = byte_count(digits)
	exponent = count - 1 - unboxed_int(found#2)
	if exponent >= 15 or exponent < -5 {
		rest = if count > 1 then "." + bytes_between(digits, 1, count) else ""
		return bytes_between(digits, 0, 1) + rest + "e" + int_text(exponent)
	}
	if exponent >= count - 1 { return digits + zeros(exponent - count + 1) }
	if exponent >= 0 { return bytes_between(digits, 0, exponent + 1) + "." + bytes_between(digits, exponent + 1, count) }
	"0." + zeros(-1 - exponent) + digits
}
# [digits, shift] of a positive float: its shortest digits, digits · 10^-shift reads back as x. x · 10^shift has 17
# digits, and the whole numbers between the halfways to its neighbours read back as x (the halfways too when x's last
# bit is even, as a reader rounds half to even); the multiple of the largest power of ten among them, nearest x
float_digits(x: float): list := {
	exponent = 0
	mantissa = x
	while mantissa >= 10 {
		mantissa = mantissa / 10
		exponent += 1
	}
	while mantissa < 1 {
		mantissa = mantissa * 10
		exponent -= 1
	}
	shift = 16 - exponent
	scaled = float_scaled(x, float(0), shift)
	while has_17_digits(scaled, 1e17) or not has_17_digits(scaled, 1e16) {
		shift += if has_17_digits(scaled, 1e17) then -1 else 1
		scaled = float_scaled(x, float(0), shift)
	}
	hi = unboxed_float(scaled#1)
	lo = unboxed_float(scaled#2)
	whole = truncated(hi) + truncated(float_floor(lo))
	fraction = lo - float_floor(lo)
	# the gaps to the neighbours; the largest float's upper one is its lower
	below = x - float_of_bits(bits_of_float(x) - 1)
	above = float_of_bits(bits_of_float(x) + 1) - x
	if above == float_of_bits(9218868437227405312) { above = below }
	# an odd last bit excludes a halfway that is whole
	odd = int_remainder(bits_of_float(x), 2)
	lowest = float_scaled(x, -below, shift)
	low_lo = unboxed_float(lowest#2)
	low = truncated(unboxed_float(lowest#1)) + truncated(float_ceil(low_lo))
	if odd == 1 and low_lo == float_ceil(low_lo) { low += 1 }
	highest = float_scaled(x, above, shift)
	high_lo = unboxed_float(highest#2)
	high = truncated(unboxed_float(highest#1)) + truncated(float_floor(high_lo))
	if odd == 1 and high_lo == float_floor(high_lo) { high -= 1 }
	# the largest power of ten with a multiple from low to high
	power = 10
	while int_quotient(low + power - 1, power) * power <= high { power = power * 10 }
	power = int_quotient(power, 10)
	# its multiple nearest x · 10^shift: the one below or the next, by twice the distance minus the power
	multiple = whole - int_remainder(whole, power)
	twice = (whole - multiple) * 2 - power + fraction * 2
	if twice > 0 or (twice == 0 and int_remainder(int_quotient(multiple, power), 2) == 1) { multiple += power }
	if multiple < low { multiple += power }
	if multiple > high { multiple -= power }
	while int_remainder(multiple, 10) == 0 {
		multiple = int_quotient(multiple, 10)
		shift -= 1
	}
	[multiple, shift]
}
# the double-double scaled reaches bound: hi beyond it, or at it with lo not below
has_17_digits(scaled: list, bound: float): bool := {
	hi = unboxed_float(scaled#1)
	hi > bound or (hi == bound and unboxed_float(scaled#2) >= 0)
}
# [hi, lo]: (x + gap/2) · 10^shift as the double-double hi + lo, by at most 10^22 a step (each power exact): a product's
# error is Dekker's exact product, a quotient's the remainder of its exact product. Exact in one step, within 2^-104 in
# more. A float beyond ±2^900 is moved by 2^∓128 first and back after, so no product overflows, no half underflows
float_scaled(x: float, gap: float, shift: int): list := {
	value = x
	scaled_gap = gap
	scale = float(1)
	if x >= float_of_bits(8660422083433463808) {
		value = x * float_of_bits(4030721666496593920)
		scaled_gap = scaled_gap * float_of_bits(4030721666496593920)
		scale = float_of_bits(5183643171103440896)
	}
	if x < float_of_bits(553942754166571008) {
		value = x * float_of_bits(5183643171103440896)
		scaled_gap = scaled_gap * float_of_bits(5183643171103440896)
		scale = float_of_bits(4030721666496593920)
	}
	hi = value
	lo = scaled_gap / 2
	left = shift
	while left != 0 {
		step = if left > 22 then 22 else if left < -22 then -22 else left
		power = float(1)
		count = step
		if step < 0 { count = -step }
		for k in 1 to count { power = power * 10 }
		if step > 0 {
			product = hi * power
			lo = product_error(hi, power, product) + lo * power
			hi = product
		} else {
			quotient = hi / power
			product = quotient * power
			lo = (hi - product - product_error(quotient, power, product) + lo) / power
			hi = quotient
		}
		# renormalized, so hi is the nearest float
		sum = hi + lo
		lo = lo - (sum - hi)
		hi = sum
		left -= step
	}
	[hi * scale, lo * scale]
}
# a · b - product exactly, a and b split in halves of 26 bits whose products are exact (Veltkamp, Dekker)
product_error(a: float, b: float, product: float): float := {
	a_hi = upper_half(a)
	a_lo = a - a_hi
	b_hi = upper_half(b)
	b_lo = b - b_hi
	a_hi * b_hi - product + a_hi * b_lo + a_lo * b_hi + a_lo * b_lo
}
# v's upper 26 bits: 2^27 + 1 times v, less its distance to v
upper_half(v: float): float := {
	t = v * 134217729
	t - (t - v)
}
