# The built-in node's parts: operators, keys, symbols, brackets and separators of lists
# a value as a boxed $Node
held(value: any): any := value
# the built-in node's parts (lib/compiler/node.warp): a key's operator is its code above the kind bits, the
# position of its spelling here (src/operators/codes.rs OP_CODES)
operator_spellings(): list := ["", ":", "=", ":=", ".", "?.", "::", "->", "+", "-", "*", "/", "%", "rem", "^", "<<", ">>", "+=", "-=",
	"*=", "/=", "%=", "^=", "&&=", "||=", "^^=", "<", ">", "<=", ">=", "==", "!=", "≈", "and", "or", "xor", "not", "-", "√", "∛",
	"‖", "++", "--", "?", "if", "then", "else", "while", "do", "#", "..", "to", "as", "±", "??", "===", "!==", "~", "⌞", "⌟", "&",
	"|", "↑", "↓", "/!", "/!="]
operator_code(spelled: text): int := {
	spellings = operator_spellings()
	for i in 1 to #spellings { if text_order(node_text(spellings#i), spelled) == 0 { return i - 1 } }
	0
}
key_node(left: any, operator: any, right: any): any := keyed(operator_code(node_text(operator)) * 256 + 6, left, right)
key_left(n: any): any := entry_key(n)
key_right(n: any): any := key_value(n)
key_operator(n: any): text := node_text(operator_spellings()#(int_quotient(marked_kind(n), 256) + 1))
symbol_node(name: any): any := symbol_of(node_text(name))
# a list's bracket and separator in its kind field: the bracket's info in the byte above the kind, the separator's
# code at bit 48 (src/wasm_emitter/mod.rs list_info); each written as `n.bracket` and `n.separator` give it
bracket_spellings(): list := ["{", "[", "(", "<", "·other", ""]
separator_spellings(): list := ["", " ", ",", ";", "\n", "\t"]
bracket_unit(): int := 256
separator_unit(): int := 281474976710656
bracket_info(n: any): int := int_remainder(int_quotient(marked_kind(n), bracket_unit()), 256)
separator_info(n: any): int := int_remainder(int_quotient(marked_kind(n), separator_unit()), 8)
# how a list shows its brackets and joins its items by its separator (Other's brackets as square ones)
bracket_openings(): list := ["{", "[", "(", "<", "[", ""]
bracket_closings(): list := ["}", "]", ")", ">", "]", ""]
separator_joiners(): list := [" ", " ", ", ", "; ", "\n", "\t"]
# `(1; 2)`, `'x', 2`: a list between its brackets, its items joined as its separator joins them
list_shown(n: any): text := {
	at = bracket_info(n) + 1
	joiner = node_text(separator_joiners()#(separator_info(n) + 1))
	node_text(bracket_openings()#at) + joined_items(unboxed_list(n), joiner) + node_text(bracket_closings()#at)
}
# `bracket_of(n)`: "(" of `(a b)`, "" of a list without brackets; ø of a node that is no list, Other's brackets too
list_bracket(n: any): any := {
	if is_null(n) == 1 or kind_code(n) != 8 or bracket_info(n) == 4 { return ø }
	bracket_spellings()#(bracket_info(n) + 1)
}
list_separator(n: any): any := {
	if is_null(n) == 1 or kind_code(n) != 8 { return ø }
	separator_spellings()#(separator_info(n) + 1)
}
# the position of a spelling in spellings, from 0
spelling_code(spellings: list, spelled: text): int := {
	for i in 1 to #spellings { if text_order(node_text(spellings#i), spelled) == 0 { return i - 1 } }
	fail()
	0
}
# `bracketed(items, "[")`, `separated(items, ",")`: the list with that bracket or separator; ø stays ø, as `()` parses
bracketed_node(items: any, bracket: any): any := {
	if is_null(items) == 1 { return items }
	if kind_code(items) != 8 { not_a_list() }
	code = spelling_code(bracket_spellings(), node_text(bracket))
	list_node(marked_kind(items) + (code - bracket_info(items)) * bracket_unit(), unboxed_list(items))
}
separated_node(items: any, separator: any): any := {
	if is_null(items) == 1 { return items }
	if kind_code(items) != 8 { not_a_list() }
	code = spelling_code(separator_spellings(), node_text(separator))
	list_node(marked_kind(items) + (code - separator_info(items)) * separator_unit(), unboxed_list(items))
}
