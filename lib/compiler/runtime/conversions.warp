# Conversions and casts of values known only at run time: `as`, typed variables, truthiness, int and char texts
# a boxed int (kind code 1), exact rational or float as a float
float_of_node(n: Node): float := {
	if kind_code(n) != Kind.Int { return unboxed_float(n) }
	float(exact_numerator(n)) / float(exact_denominator(n))
}
# `x.bytecount`: the bytes of a text's or character's UTF-8, 8 an item of a list or map; an error has none
node_bytes(n: Node): int := {
	if not is_null(n) and kind_code(n) == Kind.Error { fail() }
	if textual_node(n) { return byte_count(text_of_node(n)) }
	node_length(n) * 8
}
# `n as float` of a value known only at run time: a text or character spells the number
float_cast(n: Node): float := if textual_node(n) then text_as_float(text_of_node(n)) else float_of_node(n)
# a % b of floats as in mathematics, as the floats of Rust: the truncated remainder, plus |b| when below 0
float_mod(a: float, b: float): float := {
	if b == 0 { divide_by_zero() }
	q = a / b
	rest = a - b * (if q < 0 then float_ceil(q) else float_floor(q))
	if rest < 0 { return rest + (if b < 0 then -b else b) }
	rest
}
# a boxed number added to a number variable (`s += x`); a text or any other value traps, as Rust fails on it
number_node(n: Node): Node := {
	if is_null(n) or (kind_code(n) != Kind.Int and kind_code(n) != Kind.Float) { fail() }
	n
}
# a boxed int where an int is needed; any other value traps, as Rust fails on it
int_of_node(n: Node): int := {
	if is_null(n) or kind_code(n) != Kind.Int or is_ratio(n) { fail() }
	unboxed_int(n)
}
# a value known only at run time given to a variable declared int: a float or a fraction is no whole number, as Rust's
int_admitted(n: Node): int := {
	if is_null(n) or (kind_code(n) != Kind.Int and kind_code(n) != Kind.Float) { not_an_int() }
	if kind_code(n) == Kind.Float or is_ratio(n) { an_int_must_be_a_whole_number() }
	unboxed_int(n)
}
# … given to a variable declared list: ø or a list (a map is kind 8 in curly braces, no list), kept as it is, as Rust's
list_admitted(n: Node): Node := {
	if not is_null(n) and (kind_code(n) != Kind.List or marked_kind(n) == Marked.Map) { not_a_list() }
	n
}
# … given to a typed field: kept when the type admits it, else "not a text", as Rust's
# (src/wasm_emitter/declared_values.rs): a text or character for text, yes/no (or 0 and 1) for bool, a number for float
text_checked(n: Node): Node := {
	if is_null(n) or (kind_code(n) != Kind.Text and kind_code(n) != Kind.Codepoint) { returned_error("not a text") }
	n
}
bool_checked(n: Node): Node := {
	if is_null(n) or not (marked_kind(n) == Marked.Bool or (kind_code(n) == Kind.Int and not is_ratio(n) and unboxed_int(n) >= 0 and unboxed_int(n) <= 1)) { returned_error("not a bool") }
	n
}
float_checked(n: Node): Node := {
	if is_null(n) or (kind_code(n) != Kind.Int and kind_code(n) != Kind.Float) { returned_error("not a float") }
	n
}
# `x: T = v` of a class or enum T and a value known only at run time: v when it is an object (a symbol, key, block,
# list or data: Rust's OBJECT_KINDS, src/wasm_emitter/declared_values.rs) or an error (of every type), else the run
# fails with the message ("not a T")
object_checked(value: Node, message: text): Node := {
	if is_null(value) or kind_code(value) < Kind.Symbol or kind_code(value) == Kind.Meta or kind_code(value) > Kind.Error { returned_error(message) }
	value
}
# a boxed text, symbol or character where a text is needed, a boxed yes/no where one is needed, a boxed list (ø the
# empty one) where a list is needed, a boxed character where one is needed; any other value traps, as Rust fails on it
text_of_node(n: Node): text := {
	if not is_null(n) and (kind_code(n) == Kind.Text or kind_code(n) == Kind.Symbol) { return unboxed_text(n) }
	if not is_null(n) and kind_code(n) == Kind.Codepoint { return char_text(unboxed_char(n)) }
	fail()
	""
}
bool_of_node(n: Node): bool := {
	if is_null(n) or marked_kind(n) != Marked.Bool { fail() }
	unboxed_int(n) != 0
}
char_of_node(n: Node): char := {
	if is_null(n) or kind_code(n) != Kind.Codepoint { not_a_character() }
	unboxed_char(n)
}
list_of_node(n: Node): list := {
	if is_null(n) { return new_list(0) }
	if kind_code(n) != Kind.List { fail() }
	unboxed_list(n)
}
# `x as bool` of a value known only at run time, as Rust's cast: a text spelling a falsy word in any case ("No",
# "false"; FALSY_TEXTS of src/wasm_emitter/mod.rs) is no, another value as a condition (card yes-print)
bool_cast(n: Node): bool := {
	if is_null(n) or kind_code(n) != Kind.Text { return node_truthy(n) }
	t = unboxed_text(n)
	falsy = byte_count(t) == 0 or spells(t, "0") or spells(t, "false") or spells(t, "no") or spells(t, "ø")
	not (falsy or spells(t, "nil") or spells(t, "null") or spells(t, "none"))
}
# t is the lower-case word, any letter of t also in upper case
spells(t: text, word: text): bool := {
	if byte_count(t) != byte_count(word) { return no }
	for i in 0..<byte_count(t) {
		b = byte_at(t, i)
		if (if b >= 65 and b <= 90 then b + 32 else b) != byte_at(word, i) { return no }
	}
	yes
}
# a value known only at run time as a condition, the rule of Rust's is_truthy (Node::is_falsy): ø and errors are no, a
# list or map yes when it has items, a key when its key or value is, a number, character or text when not 0 or empty
node_truthy(n: Node): bool := {
	if is_null(n) { return no }
	kind = kind_code(n)
	if kind == Kind.Empty or kind == Kind.Error { return no }
	if kind == Kind.Block or kind == Kind.List { return #unboxed_list(n) > 0 }
	if kind == Kind.Key { return node_truthy(entry_key(n)) or node_truthy(key_value(n)) }
	if kind == Kind.Int { return is_ratio(n) or unboxed_int(n) != 0 }
	if kind == Kind.Float { return unboxed_float(n) != 0 }
	if kind == Kind.Codepoint { return code_of(unboxed_char(n)) != 0 }
	if kind == Kind.Text or kind == Kind.Symbol { return byte_count(unboxed_text(n)) > 0 }
	yes
}
# `n as int` of a boxed int, exact rational or float, truncated toward 0; a text or character spells the number
truncated_int(n: Node): int := {
	if textual_node(n) { return text_as_int(text_of_node(n)) }
	if not is_null(n) and kind_code(n) == Kind.Float { return truncated(unboxed_float(n)) }
	if is_null(n) or kind_code(n) != Kind.Int { fail() }
	int_quotient(exact_numerator(n), exact_denominator(n))
}
# the decimal digits of n, the last first; truncating division keeps the smallest int's digits in reach
int_text(n: int): text := {
	sign = if n < 0 then 1 else 0
	digits = 1
	left = n
	while int_quotient(left, 10) != 0 {
		left = int_quotient(left, 10)
		digits += 1
	}
	out = new_text(sign + digits)
	if n < 0 { set_byte(out, 0, 45) }
	left = n
	for i in sign + digits - 1 down to sign {
		digit = int_remainder(left, 10)
		if digit < 0 { digit = -digit }
		set_byte(out, i, 48 + digit)
		left = int_quotient(left, 10)
	}
	out
}
char_text(c: char): text := code_point_text(code_of(c))
# a code point's UTF-8 bytes: 6 bits in each continuation byte 10xxxxxx, the rest in the lead byte
code_point_text(code: int): text := {
	n = code
	count = if n < 128 then 1 else if n < 2048 then 2 else if n < 65536 then 3 else 4
	out = new_text(count)
	for i in count - 1 down to 1 {
		set_byte(out, i, 128 + int_remainder(n, 64))
		n = int_quotient(n, 64)
	}
	lead = if count == 1 then 0 else if count == 2 then 192 else if count == 3 then 224 else 240
	set_byte(out, 0, lead + n)
	out
}
