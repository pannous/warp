# `a + b`, `a += b` of values known only at run time, and int arithmetic that traps past 64 bits
# `a + b` of values known only at run time: lists and texts join, numbers add
node_add(a: any, b: any): any := {
	# ø, also `[]` in the lowered program, beside a list is that list (ø + ø the empty list), beside a text "ø"; beside
	# a number Rust fails
	if is_null(a) and is_null(b) { return a }
	if is_null(a) and not is_null(b) and kind_code(b) == Kind.List { return b }
	if is_null(b) and not is_null(a) and kind_code(a) == Kind.List { return a }
	if textual_node(a) or textual_node(b) { return node_text(a) + node_text(b) }
	if is_null(a) or is_null(b) { fail() }
	if kind_code(a) == Kind.List and kind_code(b) == Kind.List { return list_join(unboxed_list(a), unboxed_list(b)) }
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int and is_ratio(a) or is_ratio(b) { return exact_add(a, b) }
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int { return checked_add(unboxed_int(a), unboxed_int(b)) }
	float_of_node(a) + float_of_node(b)
}
# a + b, a - b, a * b of ints; past i64 the ints of Rust grow unbounded, here they trap
checked_add(a: int, b: int): int := {
	added = a + b
	if (b > 0 and added < a) or (b < 0 and added > a) { fail() }
	added
}
checked_subtract(a: int, b: int): int := {
	difference = a - b
	if (b > 0 and difference > a) or (b < 0 and difference < a) { fail() }
	difference
}
# 2^63 bounds the product; one rounded to it from just below traps too, loud rather than wrong
checked_multiply(a: int, b: int): int := {
	estimate = float(a) * float(b)
	bound = float(4611686018427387904) + float(4611686018427387904)
	if estimate >= bound or estimate < 0 - bound { fail() }
	a * b
}
# `a += b` of values known only at run time: a list grows in place as list_append, anything else is a + b
node_append(a: any, b: any) := {
	if not is_null(a) and not is_null(b) and kind_code(a) == Kind.List and kind_code(b) == Kind.List {
		return list_append(unboxed_list(a), unboxed_list(b))
	}
	node_add(a, b)
}
max_int(a: int, b: int): int := if a > b then a else b
least_int(): int := -9223372036854775807 - 1
min_int(a: int, b: int): int := if a < b then a else b
