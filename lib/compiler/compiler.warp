# The warp compiler as one warp program (card standalone, notes/standalone_compiler.md): source text in, wasm bytes out,
# its stages handing each other plain warp values. `warp lib/compiler/compiler.warp app.warp app.wasm`, then
# `warp app.wasm`; a form beyond the emitter's core is the compile's error ("outside the core: …")
use "passes.warp"
use "analyzer.warp"
use "emitter.warp"
use "host_words.warp"
use "commands.warp"
use os
use file

# a command (commands.warp), else the source file of a compile
command = if #args > 0 and is_command(args#1) then args#1 else ""

# lib/: the fourth argument of a compile (`warp pure` gives it), else WARP_LIB, else the folder above this file's
library_folder = if not command and #args > 3 then args#4 else env("WARP_LIB") ?? folder_of(module_directory)

# the name the lowered runtime words are kept under
RUNTIME_WORDS = "compiler.warp's lowered runtime words of " + library_folder

# the prelude's text, whose definitions a program reaches (prelude_words.warp)
prelude_source = read(library_folder + "/prelude.warp")

# the runtime words, lowered by the same passes as a program; the same at every run while lib/ stays as it is, so kept
# across runs and lowered once (card pure-warm-start); lowered at the first compile, so `help` needs none
lowered_runtime_words(): Node := kept(RUNTIME_WORDS) ?? keep(RUNTIME_WORDS, lowered_program(read(library_folder + "/compiler/runtime.warp"), library_folder + "/compiler", prelude_source))

# the wasm module of the source, as bytes; the refusal, a text, of a program outside the emitter's core
compile(source: text, folder: text): any := {
	program = checked_program(source, folder, prelude_source)
	# an error the checks diagnosed fails the compile with Rust's text (card pure-self-ignores-errors)
	failing = first_error()
	if failing { throw failing }
	// TODO runtime_words Instead of work-based, should we create a class for (partial) modules?
	made = typed_wasm_module(program, lowered_runtime_words(), host_words, emitter_kinds(program))
	# a form beyond the emitter's core gives the refusal's text, the compile's error
	if made is text { throw made }
	made
}

# the module of the source file written to the wasm file, the source's uses found in folder
compile_file(source_file: text, wasm_file: text, folder: text) := {
	emitting_file(source_file)
	compiled = compile(read(source_file), folder)
	# a program outside the emitter's core: the run fails with the refusal, no module written (card compiler-refusal-loud)
	if compiled is text { raise compiled }
	write_bytes(wasm_file, compiled)
}

# the REPL (`warp repl`): the lines that stay for the next ones, a program's declarations and uses, as warp text
REPL_STATE = ".warp-repl-state.warp"
staying_lines(line: text): text := {
	statements = statements_in(plain_node(parsed(line)))
	staying = statements.filter(statement => is_declaration(statement) or is_import(statement))
	staying.map(statement => "${statement}").join("\n")
}
# one line of the REPL: its module written to wasm_file, compiled after the state file's lines; the line's
# declarations added to the state once it compiled
repl_step(state_file: text, line: text, wasm_file: text) := {
	state = try read(state_file) else ""
	compiled = compile(state + "\n" + line, ".")
	if compiled is text { raise compiled }
	write_bytes(wasm_file, compiled)
	staying = staying_lines(line)
	if staying { write(state_file, state + "\n" + staying) }
}
# `warp repl` under plain WASI: each line compiled, its declarations kept; running it needs the native warp
repl() := {
	write(REPL_STATE, "")
	line = input(REPL_PROMPT)
	while line != ø {
		if line.trim() {
			try {
				repl_step(REPL_STATE, line, ".warp-repl-line.wasm")
				print "compiled; running it needs the native warp (plain WASI has no instantiate): warp repl or warp pure repl"
			} catch failure { print failure }
		}
		line = input(REPL_PROMPT)
	}
}

source_or_code(position: int): text := if #args > position then source_of(args#(position + 1)) else ""
match command {
	"": compile_file(args#1, args#2, if #args > 2 then args#3 else folder_of(args#1))
	"help": show_help()
	"version": print version_text(library_folder)
	"parse": print plain_node(parsed(source_or_code(1)))
	"data": print plain_node(parsed(source_or_code(1)))
	"lower": print lowered_program(source_or_code(1), ".", prelude_source)
	"compile": compile_file(args#2, if #args > 2 then args#3 else args#2 + ".wasm", folder_of(args#2))
	"build": compile_file(args#2, args#2 + ".wasm", folder_of(args#2))
	"repl": repl()
	"repl-step": repl_step(args#2, args#3, args#4)
	_: if command in running_commands then refuse_running(command) else refuse_native(command)
}
