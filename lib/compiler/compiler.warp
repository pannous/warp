# The warp compiler as one warp program (card standalone, notes/standalone_compiler.md): source text in, wasm bytes out,
# its stages handing each other plain warp values. `warp lib/compiler/compiler.warp app.warp app.wasm`, then
# `warp app.wasm`; a form beyond the emitter's core is the compile's error ("outside the core: …")
use "passes.warp"
use "analyzer.warp"
use "emitter.warp"
use "host_words.warp"
use "c_imports.warp"
use os
use file

# lib/: the fourth argument (`warp pure` gives it), else WARP_LIB, else the folder above this file's
library_folder = if #args > 3 then args#4 else run_library()
# the parser's and the uses' standard modules from that lib/ too, never the folder this compiler was built in
use_library(library_folder)

# the name the lowered runtime words are kept under
RUNTIME_WORDS = "compiler.warp's lowered runtime words of " + library_folder

# the prelude's text, whose definitions a program reaches (prelude_words.warp), built in as the compiler's other data
prelude_source = module_source("prelude")

# the files of the runtime words, each with the files its `use` lines name: the core and, never used by it, the
# extended runtime (decision runtime-split)
RUNTIME_ROOTS = ["runtime.warp", "runtime/extended.warp"]
# a root's text, its `use` paths named from lib/compiler, where the roots are lowered together: runtime/extended.warp's
# `use "extended/exact.warp"` is lib/compiler/runtime/extended/exact.warp
root_text(file: text): text := {
	text = read(library_folder + "/compiler/" + file)
	steps = file.split("/")
	if #steps == 1 { return text }
	text.replace("use \"", "use \"" + steps[0 ..< #steps - 1].join("/") + "/")
}

# the runtime words lowered and kept; keep's answer unused, so a host without the module cache (plain wasmtime answering
# its imports with defaults) still gets the words
lowered_runtime_words(): Node := {
	roots = RUNTIME_ROOTS.map(file => root_text(file))
	words = lowered_program(roots.join("\n"), library_folder + "/compiler", prelude_source)
	keep(RUNTIME_WORDS, words)
	words
}
# the runtime words, lowered by the same passes as a program; the same at every run while lib/ stays as it is, so kept
# across runs and lowered once (card pure-warm-start)
runtime_words = kept(RUNTIME_WORDS) ?? lowered_runtime_words()

# the wasm module of the source, as bytes; the refusal, a text, of a program outside the emitter's core
compile(source: text, folder: text): any := {
	known = #diagnosed
	# the C functions it calls, its foreign lines left out (c_imports.warp)
	foreign = c_functions_of(source, library_folder)
	unknown = foreign#3
	if #unknown > 0 { throw outside_the_core + "no C signature for " + unknown.join(", ") + ": declare it with a foreign line, `name(x: i32): i32 from 'library'`" }
	program = checked_program(foreign#1, folder, prelude_source)
	found = diagnosed_since(known)
	# an error the checks diagnosed fails the compile with Rust's text (card pure-self-ignores-errors)
	failing = first_error(found, module.program_file)
	if failing { throw failing }
	// TODO runtime_words Instead of work-based, should we create a class for (partial) modules?  (card runtime-words-modules)
	made = typed_wasm_module(program, runtime_words, with_c_functions(host_words, foreign#2), emitter_kinds(program))
	# a form beyond the emitter's core gives the refusal's text, the compile's error
	if made is text { throw owned_refusal(made, c_refused_form(made, foreign#2, library_folder)) }
	# the warnings once the module is made, as Rust's pure lane says them
	for warning in warnings_said(found, module.program_file) { warn warning }
	made
}

# todo wrap in main
# warp compiler.warp <source file> <wasm file> [<folder of the source's uses> [<lib folder>]]
source_file = args#1
folder = if #args > 2 then args#3 else folder_of(source_file)
emitting_file(working_relative(source_file))
compiled = compile(read(source_file), folder)
# a program outside the emitter's core: the run fails with the refusal, no module written (card compiler-refusal-loud)
if compiled is text { raise compiled }
write_bytes(args#2, compiled)
