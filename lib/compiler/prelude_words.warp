# The prelude's definitions a program reaches (Rust twin: src/modules/prelude_slices.rs): a call of a prelude word the
# program defines nowhere brings that word's definition, and those it calls in turn, as Rust's resolve loads them. The
# prelude is cut into slices, one per top-level `name(…) := …`; the reached ones are parsed after the program's own
# statements, so its positions stay as written. It runs on the parsed program after uses.warp: the source is parsed
# once (twice put parser.warp's lowering past the stage's 60 s).
use "parser.warp"
use "walk.warp"
use "uses.warp"

# [name, text] of each function definition in source: a line starting with a name and its parameters, with the
# indented or closing lines below it
definition_slices(source: text): list := {
	slices = []
	name = ""
	written = ""
	for line in source.split("\n") {
		started = defined_name(line)
		if started != "" {
			if name != "" { slices += [[name, written]] }
			name = started
			written = line
		} else if name != "" and continues(line) {
			written = written + "\n" + line
		} else if name != "" {
			slices += [[name, written]]
			name = ""
		}
	}
	if name != "" { slices += [[name, written]] }
	slices
}
# `f` of `f(x) := …` or `def f(x)`, else ""
defined_name(line: text): text := {
	start = if line.starts_with("def ") then 4 else 0
	stop = start
	while stop < #line and is_name_part(line#(stop + 1)) { stop += 1 }
	if stop == start or stop >= #line or line#(stop + 1) != '(' { return "" }
	if start == 0 and not line.contains(":=") { return "" }
	line[start ..< stop]
}
is_name_part(c: char): bool := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
# a line inside the definition above it: indented, or the brace closing it
continues(line: text): bool := #line > 0 and (line#1 == '\t' or line#1 == ' ' or line#1 == '}')

# the words a node mentions as symbols, each once (a map as the set: an 89 KB program has tens of thousands)
symbol_words(n: any): list := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is symbol { found[name_of(part)] = yes } else if type(part) is key { waiting += [key_of(part), value_of(part)] } else if is_group(part) { for item in part { waiting += [item] } }
	}
	found.keys
}

# the program with the prelude definitions it reaches after its own statements (its positions stay as written), the
# program itself when it reaches none; each reached slice parsed once
with_prelude(program: any, prelude: text): any := {
	own_names = statements_in(program).map(declared_name)
	program = aliased(program, prelude_aliases(prelude), own_heads(program))
	program_parts = statements_in(program)
	slices = definition_slices(prelude).filter(slice => not (slice#1 in own_names))
	reached = []
	brought = []
	wanted = symbol_words(program)
	while #wanted > 0 {
		word = wanted#1
		wanted = wanted[1 ..]
		for slice in slices {
			if slice#1 == word and not (slice in reached) {
				reached += [slice]
				slice_node = plain_node(parsed(slice#2))
				brought += statements_in(slice_node)
				wanted += symbol_words(slice_node)
			}
		}
	}
	if #brought == 0 { return program }
	for definition_node in brought { program_parts += [definition_node] }
	separated(bracketed(program_parts, ""), ";")
}

# `alias keys = map_keys` of the prelude: the word by each alias (Rust: src/modules/declarations.rs, an alias declares
# nothing, its calls call the word)
prelude_aliases(source: text): any := {
	aliases = {}
	for line in source.split("\n") {
		if line.starts_with("alias ") {
			sides = line[6 ..].split("=")
			if #sides == 2 { aliases[sides#1.trim()] = sides#2.trim() }
		}
	}
	aliases
}
# `keys(m)` as `map_keys(m)`: a call of an alias calls the word unless the program defines that name, as a variable
# or a function taking as many arguments (shadowing is per arity, Rust's library_words.rs word_for_unless: a program's
# `index_of(source, part, from, n)` leaves `"abc".index_of(c)` to the library); top-down, so a method call
# `x.f(a)` counts its receiver
aliased(n: any, aliases: any, own: any): any := match n {
	Key(receiver, Op.Dot, call): Key(aliased(receiver, aliases, own), Op.Dot, aliased_call(children(call, x => aliased(x, aliases, own)), aliases, own, 1))
	_: children(aliased_call(n, aliases, own, 0), x => aliased(x, aliases, own))
}

aliased_call(n: any, aliases: any, own: any, receivers: int): any := {
	if not (is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol) { return n }
	called = name_of(n#1)
	if not (called in aliases) or shadows(own, called, #n - 1 + receivers) { return n }
	group_like(n, [symbol(aliases[called])] + items_of(n)[1 ..])
}

# whether the program's own `name` hides the library word from a call of `count` arguments: a variable always, a
# function when it takes them (a parameter `b = 1` may be left out)
shadows(own: any, name: text, count: int): bool := {
	if not (name in own) { return no }
	head = own[name]
	if not is_group(head) { return yes }
	parameters = items_of(head)[1 ..]
	count >= #parameters.filter(parameter => not is_key(parameter, Op.Assign)) and count <= #parameters
}

# name → the head `f(a, b)` of each top-level statement defining a function, `yes` for one defining another name
own_heads(program: any): any := {
	heads = {}
	for statement in statements_in(program) {
		name = declared_name(statement)
		if name != ø { heads[name] = definition_head_of(statement) ?? yes }
	}
	heads
}

# the head of `f(a) := …`, `f(a): int := …`, `def f(a) {…}`; ø for another statement
definition_head_of(statement: any): any := {
	n = if is_keyword_group(statement) then statement#2 else statement
	while type(n) is key { n = key_of(n) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 then n else ø
}
