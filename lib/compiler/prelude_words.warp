# The definitions of a module's text a program reaches (Rust twin: src/modules/prelude_slices.rs), for the prelude and
# each standard module the program uses (`use case_tables`): a call of a word the program defines nowhere brings that
# word's definition, and those it calls in turn, as Rust's resolve loads them. The text is cut into slices, one per
# top-level `name(…) := …` or `name = …`; the reached ones are parsed after the program's own statements, so its
# positions stay as written. It runs on the parsed program after uses.warp: the source is parsed
# once (twice put parser.warp's lowering past the stage's 60 s).
use "parser.warp"
use "walk.warp"
use "uses.warp"

# [name, text] of each function definition in source: a line starting with a name and its parameters, with the
# indented or closing lines below it
definition_slices(source: text): list := {
	slices = []
	name = ""
	written = ""
	for line in source.split("\n") {
		started = defined_name(line)
		if started != "" {
			if name != "" { slices += [[name, written]] }
			name = started
			written = line
		} else if name != "" and continues(line) {
			written = written + "\n" + line
		} else if name != "" {
			slices += [[name, written]]
			name = ""
		}
	}
	if name != "" { slices += [[name, written]] }
	slices
}
# the words that start a definition of the name after them: `def f(x) …`, `const X = 1`, `class Table {…}`
defining_keywords = function_keywords + declaration_keywords + ["class", "enum", "struct", "trait", "type"]
# `f` of `f(x) := …`, a value `f = …`, `def f(x)`, `enum F {…}` (a defining keyword's name), else ""
defined_name(line: text): text := {
	leading = leading_name(line)
	if leading in defining_keywords { return leading_name(line[#leading ..].trim()) }
	if leading == "" { return "" }
	following = line[#leading ..].trim()
	is_function = following.starts_with("(") and line.contains(":=")
	is_value = following.starts_with(":=") or (following.starts_with("=") and not following.starts_with("=="))
	if is_function or is_value then leading else ""
}
# the name a line starts with, "" when it starts with another character
leading_name(line: text): text := {
	stop = 0
	while stop < #line and is_name_part(line#(stop + 1)) { stop += 1 }
	line[0 ..< stop]
}
is_name_part(c: char): bool := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
# a line inside the definition above it: indented, or the brace closing it
continues(line: text): bool := #line > 0 and (line#1 == '\t' or line#1 == ' ' or line#1 == '}')

# the words a node mentions as symbols, each once (a map as the set: an 89 KB program has tens of thousands)
symbol_words(n: any): list := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is symbol { found[name_of(part)] = yes } else if type(part) is key { waiting += [key_of(part), value_of(part)] } else if is_group(part) { for item in part { waiting += [item] } }
	}
	found.keys
}

# the program with the definitions of `module` (a module's text) it reaches, in the module's order, each slice parsed
# once and on its own (the program's positions stay as written); the program itself when it reaches none. As Rust's
# loader places them: a used module's in front of the program, the prelude's after it
with_reached(program: any, module: text, in_front: bool): any := {
	own_names = statements_in(program).map(declared_name)
	aliases = module_aliases(module)
	program = bottom_up(program, n => aliased_call(n, aliases, own_names))
	slices = definition_slices(module).filter(slice => not (slice#1 in own_names))
	# the statements of each reached slice, by its text
	reached = {}
	wanted = symbol_words(program)
	while #wanted > 0 {
		word = wanted#1
		wanted = wanted[1 ..]
		for slice in slices {
			if slice#1 == word and not (slice#2 in reached) {
				slice_node = plain_node(parsed(slice#2))
				reached[slice#2] = statements_in(slice_node)
				wanted += symbol_words(slice_node)
			}
		}
	}
	if #reached == 0 { return program }
	brought = []
	for slice in slices { if slice#2 in reached { brought += reached[slice#2] } }
	parts = if in_front then [] else statements_in(program)
	for reached_statement in brought { parts += [reached_statement] }
	if in_front { for own_statement in statements_in(program) { parts += [own_statement] } }
	separated(bracketed(parts, ""), ";")
}

# `alias keys = map_keys` of a module: the word by each alias (Rust: src/modules/declarations.rs, an alias declares
# nothing, its calls call the word)
module_aliases(source: text): any := {
	aliases = {}
	for line in source.split("\n") {
		if line.starts_with("alias ") {
			sides = line[6 ..].split("=")
			if #sides == 2 { aliases[sides#1.trim()] = sides#2.trim() }
		}
	}
	aliases
}
# `keys(m)` as `map_keys(m)`: a call of an alias the program defines no word of calls the word; a variable or
# parameter of that name (`size = 3`) stays
aliased_call(n: any, aliases: any, own_names: any): any := {
	if not (is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol) { return n }
	called = name_of(n#1)
	if not (called in aliases) or called in own_names { return n }
	group_like(n, [symbol(aliases[called])] + items_of(n)[1 ..])
}

# the program with the definitions it reaches of the standard modules it uses, those they use in turn included: `use
# case_tables` names lib/case_tables.warp when the program's folder has no case_tables.warp (uses.warp brings that)
with_used_modules(program: any, folder: text): any := {
	sources = used_module_sources(statements_in(program), folder, [])
	if #sources#1 == 0 then program else with_reached(program, sources#1.join("\n"), yes)
}
# [the sources of the standard modules the statements use, each after those it uses, the module names seen]
used_module_sources(statements: any, folder: text, seen: any): list := {
	sources = []
	for statement in statements {
		module = use_target(statement)
		if module is symbol and file_used(statement, folder) == ø and not (name_of(module) in seen) {
			seen += [name_of(module)]
			source = file_text(std_module_path(name_of(module)))
			if source != ø {
				inner = used_module_sources(statements_in(plain_node(parsed(source))), folder, seen)
				sources += inner#1 + [source]
				seen = inner#2
			}
		}
	}
	[sources, seen]
}
