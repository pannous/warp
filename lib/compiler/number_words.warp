# English number words are numbers (`one plus two` is 3) unless the program names a variable, parameter or function
# so (card times-phrases; Rust twin: src/lowering/words/number_words.rs). Keys (`{one: 1}`), members (`x.one`) and
# quoted data (`data [one]`) stay words. Each one hints its digits where it is written (card carries-line).
use "walk.warp"

number_words = {zero: 0, one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10,
	eleven: 11, twelve: 12, thirteen: 13, fourteen: 14, fifteen: 15, sixteen: 16, seventeen: 17, eighteen: 18,
	nineteen: 19, twenty: 20, thirty: 30, forty: 40, fifty: 50, sixty: 60, seventy: 70, eighty: 80, ninety: 90}
# the number words the program gives no other meaning
numbers = {}
digits_reason = "a number is written in digits"
# where a hint is: the last positioned node walked into (normalize set_position_of)
hint_at = ø

# the first positioned node, its own position or a part's: a word a pass made has none
start_of(n: any) := {
	if is_positioned(n) { return n }
	if type(n) is key {
		left = start_of(key_of(n))
		if left != ø { return left }
		return start_of(value_of(n))
	}
	if is_group(n) {
		for item in n {
			found = start_of(item)
			if found != ø { return found }
		}
	}
	ø
}

# `x` of `x`, `x: int`, `x: int = 1`: the innermost left side
parameter_head(n: any) := if type(n) is key then parameter_head(key_of(n)) else n
parameter_name(n: any) := {
	head = parameter_head(n)
	if head is symbol { return name_of(head) }
	ø
}

# every name the program gives: variables, functions, parameters, fields (soft_keywords.rs names_given)
names_given(n: any, names: any) := {
	if type(n) is key and (op_of(n) == ":=" or op_of(n) == "=") {
		target = key_of(n)
		if target is symbol { names[name_of(target)] = yes }
		if bracket_of(target) == "(" and #target > 0 {
			if target#1 is symbol { names[name_of(target#1)] = yes }
			for parameter in target[1..] { given(parameter_name(parameter), names) }
		}
		return names_given(value_of(n), names)
	}
	if type(n) is key and op_of(n) == "=>" {
		parameters = key_of(n)
		if is_group(parameters) { for parameter in parameters { given(parameter_name(parameter), names) } }
		else { given(parameter_name(parameters), names) }
		return names_given(value_of(n), names)
	}
	if type(n) is key {
		names_given(key_of(n), names)
		return names_given(value_of(n), names)
	}
	if is_group(n) {
		for item in n {
			if bracket_of(n) == "{" and type(item) is key and op_of(item) == ":" and key_of(item) is symbol { names[name_of(key_of(item))] = yes }
			names_given(item, names)
		}
	}
	names
}
given(name: any, names: any) := if name != ø then names[name] = yes

# `data e`: e as written
is_quoted(n: any) := bracket_of(n) == "" and separator_of(n) == " " and #n == 2 and n#1 == symbol("data")

as_numbers(n: any) := {
	global hint_at
	if is_quoted(n) { return n }
	if is_positioned(n) { hint_at = n }
	if n is symbol and numbers.has(name_of(n)) {
		number = numbers[name_of(n)]
		report(hint_at, digits_reason, text(number))
		return number
	}
	if type(n) is key and op_of(n) == ":" { return key(key_of(n), ":", as_numbers(value_of(n))) }
	if type(n) is key and op_of(n) == "." { return key(as_numbers(key_of(n)), ".", value_of(n)) }
	children(n, as_numbers)
}

number_words_pass(program: any) := {
	global numbers
	global hint_at
	hint_at = start_of(program)
	names = names_given(program, {})
	numbers = {}
	for word in number_words.keys() { if not names.has(word) { numbers[word] = number_words[word] } }
	as_numbers(program)
}
