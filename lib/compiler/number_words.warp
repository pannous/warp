# English number words are numbers (`one plus two` is 3) unless the program names a variable, parameter, field or
# function so; each one hints its digits where it is written (card carries-line; Rust twin:
# src/lowering/words/number_words.rs). Keys (`{one: 1}`) and members (`x.one`) stay words.
use "walk.warp"

digit_words = [
	["zero", 0], ["one", 1], ["two", 2], ["three", 3], ["four", 4], ["five", 5], ["six", 6], ["seven", 7],
	["eight", 8], ["nine", 9], ["ten", 10], ["eleven", 11], ["twelve", 12], ["thirteen", 13], ["fourteen", 14],
	["fifteen", 15], ["sixteen", 16], ["seventeen", 17], ["eighteen", 18], ["nineteen", 19], ["twenty", 20],
	["thirty", 30], ["forty", 40], ["fifty", 50], ["sixty", 60], ["seventy", 70], ["eighty", 80], ["ninety", 90]
]
digits_reason = "a number is written in digits"
# where a hint is: the last positioned node walked into (normalize set_position_of)
global hint_at = ø

is_key(n: any) := type(n) is key and n.key != symbol(opaque_word)

# the first positioned node, its own position or a part's: a word a pass made has none
start_of(n: any) := {
	if is_positioned(n) { return n }
	if is_key(n) {
		left = start_of(n.key)
		if left != ø { return left }
		return start_of(n.value)
	}
	if is_group(n) {
		for item in n {
			found = start_of(item)
			if found != ø { return found }
		}
	}
	ø
}

# `x` of `x`, `x: int`, `x: int = 1`: the innermost left side, ø when it is no word
parameter_name(p: any) := {
	if is_key(p) { return parameter_name(p.key) }
	if p is symbol { return p.name }
	ø
}
parameter_names(ps: any) := ps.map(parameter_name).filter(name => name != ø)

# every name the program gives: its variables, parameters, fields and functions (Rust: soft_keywords names_given)
names_given(n: any) := {
	if is_key(n) {
		if n.op == ":=" or n.op == "=" {
			target = n.key
			own = []
			if target is symbol { own = [target.name] }
			if is_group(target) and target.bracket == "(" and #target > 0 {
				if target#1 is symbol { own = [target#1.name] }
				own = own + parameter_names(target[2..])
			}
			return own + names_given(n.value)
		}
		if n.op == "->" {
			parameters = if is_group(n.key) then parameter_names(n.key) else parameter_names([n.key])
			return parameters + names_given(n.value)
		}
		return names_given(n.key) + names_given(n.value)
	}
	if is_group(n) {
		found = []
		for item in n {
			if n.bracket == "{" and is_key(item) and item.op == ":" and item.key is symbol { found = found + [item.key.name] }
			found = found + names_given(item)
		}
		return found
	}
	[]
}

digits_of(word: any, words: any) := {
	for pair in words {
		if pair#1 == word { return pair#2 }
	}
	ø
}

as_numbers(n: any, words: any) := {
	global hint_at
	if is_positioned(n) { hint_at = n }
	if is_key(n) and n.op == ":" { return key(n.key, n.op, as_numbers(n.value, words)) }
	if is_key(n) and n.op == "." { return key(as_numbers(n.key, words), n.op, n.value) }
	if n is symbol {
		number = digits_of(n.name, words)
		if number == ø { return n }
		report(hint_at, digits_reason, text(number))
		return number
	}
	children(n, child => as_numbers(child, words))
}

number_words(program: any) := {
	global hint_at
	names = names_given(program)
	words = digit_words.filter(pair => not names.contains(pair#1))
	if #words == 0 { return program }
	hint_at = start_of(program)
	as_numbers(program, words)
}
