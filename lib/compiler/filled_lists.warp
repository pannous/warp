# Typed arrays (card pure-lane-reads; Rust twin: src/lowering/collections/filled_lists.rs typed_array_value):
# `int[3]`, read as the subscript `int#4`, is the list of 3 zeros of the type, `zero_fill(3, 0)`, unless the program
# binds the type word as a value (`text = "abc"; text[2]` indexes).
use "walk.warp"
use "scope.warp"

zeroed_types = ["int", "float", "text"]
# the zero of an element type word (filled_lists.rs zero_element); `0 as float`, as a stage view holds no exact 0.0
zero_of(word: text): Node := {
	if word == "float" { return Key(0, Op.As, symbol("float")) }
	if word == "text" then "" else 0
}

# the count of a one-based subscript `#(n + 1)`: 3 of `4`, n of `n + 1`, else ø
zero_based(one_based: Node): any := match one_based {
	Key(count, Op.Add, 1): count
	_: if one_based is int then one_based - 1 else ø
}

filled(n: Node, zeros: any): Node := match n {
	Key(element, Op.Hash, one_based): {
		if not (element is symbol) or not (name_of(element) in zeros) { return n }
		count = zero_based(one_based)
		if count == ø then n else call_of("zero_fill", [count, zero_of(name_of(element))])
	}
	_: n
}

filled_lists(program: any): any := {
	scope = scope_of(program)
	zeros = zeroed_types.filter(word => not binds_value(scope, word))
	bottom_up(program, n => filled(n, zeros))
}
