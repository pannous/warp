# `reverse xs`, `upper t`, `floor x` (card pure-lane-knows): a library word of one typed value applies to the value after
# it, as `reverse(xs)` does, wherever it stands; a synonym calls its word (`sorted xs` is sort(xs)). A program binding
# the word keeps its own. The words and their parameters are the typed lines of lib/prelude.warp and lib/math.warp
# (`floor(x: number): int from warp`); a word with a default or a rest parameter takes no spaced argument.
# Rust twin: src/lowering/words/library_words.rs word_call (`sin x`), library_signatures.rs typed_first_arity
use "walk.warp"
use "scope.warp"
use "builtin_signatures.warp"

# the libraries of the typed lines: warp's runtime, the emitter's expansions, libm
typed_libraries = ["warp", "emitter", "'m'"]
math_text = module_source("math")

# word → its typed lines of lib/prelude.warp and lib/math.warp, the first written first
global typed_word_lines = ø
word_lines(): any := {
	if typed_word_lines != ø { return typed_word_lines }
	typed_word_lines = {}
	for line in (prelude_text + "\n" + math_text).split("\n") {
		for library in typed_libraries {
			typed = typed_line(line, library)
			if typed != ø {
				if not typed_word_lines.has(typed.name) { typed_word_lines[typed.name] = [] }
				typed_word_lines[typed.name] = typed_word_lines[typed.name] + [typed]
			}
		}
	}
	typed_word_lines
}

# whether the word's first line takes exactly one value, typed
takes_one_typed_value(word: text): bool := {
	lines = word_lines()
	if not lines.has(word) { return no }
	parameters = lines[word]#1.signature.parameters
	#parameters == 1 and parameters#1.type_name != "" and not parameters#1.rest
}

# `word value` → `word(value)` for a library word of one typed value the program leaves free
spaced_library_call(n: any, scope: any): any := {
	if not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n == 2 and n#1 is symbol) { return n }
	written = name_of(n#1)
	word = unaliased(written)
	if binds(scope, written) or not takes_one_typed_value(word) { return n }
	call_of(word, [n#2])
}

library_calls(program: any): any := {
	scope = scope_of(program)
	bottom_up(program, n => spaced_library_call(n, scope))
}
