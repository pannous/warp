# Indexes and positions (decisions index-position and index-units; Rust twin: src/lowering/collections/index_positions.rs):
# `index` counts from 0 (`xs[i]`), `position` from 1 (`xs#p`), both ints. A variable declared one, `p: position = v`
# or `position p = v`, holds its value counted its way: a position given to an index is one less, an index given to a
# position one more, so `i: index = "a👍🏽b".find("b")` is 2 and `p: position = …` 3. `find(t, part)` and `index_of`
# give positions, `byte_index_of`, `argmax` and `argmin` indexes; arithmetic with a plain int keeps what a value counts,
# and so does a name assigned only such values. A function definition is its own scope.
use "walk.warp"
use "scope.warp"
use "number_keys.warp"

position_word = "position"
index_word = "index"
# what a declared index or position is held as
count_type = "int"
position_calls = ["collection_position", "find"]
index_calls = ["byte_index_of", "argmax", "argmin"]

# what a value counts: "position", "index" or ""
counting(n: Node, counted: any): text := match n {
	Symbol(name): { if name in counted then counted[name] else "" }
	Key(receiver, Op.Dot, called): call_count(received_call(receiver, called))
	Key(left, Op.Add, right): sum_count(counting(left, counted), counting(right, counted), yes)
	Key(left, Op.Sub, right): sum_count(counting(left, counted), counting(right, counted), no)
	List(items, Bracket.Round, separator): { if #items == 1 then counting(items#1, counted) else call_count(items) }
	_: ""
}
# `p + 1`, `i - 1`, `1 + p`: what the counted side counts; `q - p` of two is a plain count
sum_count(left: text, right: text, adding: bool): text := {
	if right == "" { return left }
	if left == "" and adding { return right }
	""
}
# `xs.argmax()`, `t.find(part)` as the call `argmax(xs)`, `find(t, part)`
received_call(receiver: Node, called: Node): list := {
	items = if is_group(called) then items_of(called) else [called]
	if #items == 0 then [] else [items#1, receiver] + items[1..]
}
# a call of a counting word; `find(xs, x => …)` finds an item
call_count(items: list): text := {
	if #items < 2 or not (items#1 is symbol) { return "" }
	word = name_of(items#1)
	if word in position_calls and not is_lambda(items#(#items)) { return position_word }
	if word in index_calls { return index_word }
	""
}

# [name, counting type, value] of `name: position = v`, `position name = v`; else ø
counted_declaration(n: Node, type_words: list): any := match n {
	Key(target, Op.Assign, value): {
		declared = if is_key(target, Op.Colon) then value_of(target) else ø
		if declared is symbol and name_of(declared) in type_words and key_of(target) is symbol then [name_of(key_of(target)), name_of(declared), value] else ø
	}
	List(items, Bracket.None, Separator.Space): {
		if #items == 2 and items#1 is symbol and name_of(items#1) in type_words then declared_assignment(name_of(items#1), items#2) else ø
	}
	_: ø
}
declared_assignment(type_name: text, assignment: Node): any := match assignment {
	Key(target, Op.Assign, value): { if target is symbol then [name_of(target), type_name, value] else ø }
	_: ø
}

# the value counted as the declared type counts
recounted(value: Node, counts: text, declared: text): Node := {
	if counts == position_word and declared == index_word { return Key(value, Op.Sub, 1) }
	if counts == index_word and declared == position_word { return Key(value, Op.Add, 1) }
	value
}

# the names one scope counts: those around it, its own declared ones, and those it assigns only values counting the
# same way, in program order; not those of the functions it defines
scope_counts(body: Node, counted: any, type_words: list): any := {
	own = {}
	for name in counted.keys() { own[name] = counted[name] }
	statements = outer_nodes_in(body)
	declared_names = {}
	for n in statements {
		declared = counted_declaration(n, type_words)
		if declared != ø {
			own[declared#1] = declared#2
			declared_names[declared#1] = yes
		}
	}
	for n in statements {
		match n {
			Key(target, Op.Assign, value): {
				name = if target is symbol then name_of(target) else ""
				if name != "" and name not in declared_names { own[name] = assigned_count(name, counting(value, own), own) }
			}
			_: ø
		}
	}
	own
}
# a name's count after one more assignment: the same as before, or "" once two differ
assigned_count(name: text, given: text, own: any): text := if name in own and own[name] != given then "" else given

counted_node(n: Node, counted: any, type_words: list): Node := {
	parts = definition_parts(n)
	if parts != ø {
		return match n {
			Key(head, op, body): {
				inner = unbound(counted, parts#1)
				for parameter in counted_parameters(head, type_words) { inner[parameter#1] = parameter#2 }
				Key(plain_counted(head, type_words), op, counted_node(body, scope_counts(body, inner, type_words), type_words))
			}
			_: n
		}
	}
	declared = counted_declaration(n, type_words)
	if declared != ø {
		value = counted_node(declared#3, counted, type_words)
		return Key(Key(symbol(declared#1), Op.Colon, symbol(count_type)), Op.Assign, recounted(value, counting(value, counted), declared#2))
	}
	children(n, x => counted_node(x, counted, type_words))
}

# [name, type] of each parameter declared a position or an index: `f(p: position)`
counted_parameters(head: Node, type_words: list): list := nodes_in(head).map(n => declared_count(n, type_words)).filter(found => found != ø)
declared_count(n: Node, type_words: list): any := match n {
	Key(name, Op.Colon, type_name): { if name is symbol and type_name is symbol and name_of(type_name) in type_words then [name_of(name), name_of(type_name)] else ø }
	_: ø
}
# the head with its counted parameters declared ints
plain_counted(n: Node, type_words: list): Node := {
	if declared_count(n, type_words) != ø { return Key(key_of(n), Op.Colon, symbol(count_type)) }
	children(n, x => plain_counted(x, type_words))
}
# what the names around a function count, but those its parameters bind
unbound(counted: any, parameters: list): any := {
	seen = {}
	for name in counted.keys() { if name not in parameters { seen[name] = counted[name] } }
	seen
}

# the type words a program leaves free: one it assigns or declares is its own name (`index = 3`, `position: int`)
free_type_words(program: Node): list := {
	bound = nodes_in(program).map(bound_name).filter(name => name != "")
	[position_word, index_word].filter(word => word not in bound)
}
bound_name(n: Node): text := match n {
	Key(target, op, value): { if (op == Op.Assign or op == Op.Colon) and target is symbol then name_of(target) else "" }
	_: ""
}

index_positions(program: Node): Node := {
	if not mentions(program, position_word) and not mentions(program, index_word) { return program }
	type_words = free_type_words(program)
	counted_node(program, scope_counts(program, {}, type_words), type_words)
}
