# `x is int`, `n is symbol` (card pure-type-tests): `x is T` of a type word T no variable, parameter or loop variable
# in reach names (a field `{symbol: …}` does not), or of a type the program declares, is the type test
# is_type(x, "T"), as Rust's src/lowering/types/type_tests.rs lowers it (plain_enums.warp answers it for an enum);
# every other `x is v` is `x == v`. Only `is` tests a type: `3 == int` compares 3 with the type (no)
use "walk.warp"
use "words.warp"
use "scope.warp"

tested_word_call(subject: Node, word: text, equality: Node, scope: any): Node :=
	if is_tested_type(word, scope) then call_of("is_type", [tested(subject), word]) else equality

# `type(x) is int` tests x, as the type of x is what it names (Rust: type_tests.rs is_type_call, card type-int)
tested(subject: Node): Node := match subject {
	List(items, bracket, separator): { if #items == 2 and items#1 == symbol("type") then items#2 else subject }
	_: subject
}

# a type word no value of the program is named, or a type it declares (`enum Coin {…}`, `class P {…}`)
is_tested_type(word: text, scope: any): bool :=
	not binds_value(scope, word) and (is_tested_type_word(word) or binds_as(scope, word, Meaning.Type))

tested_type_call(subject: Node, type: Node, scope: any): Node := match type {
	Symbol(word): tested_word_call(subject, word, Key(subject, Op.Eq, type), scope)
	_: Key(subject, Op.Eq, type)
}

type_test_node(n: Node, scope: any): Node := match n {
	Key(subject, Op.Is, type): tested_type_call(subject, type, scope)
	_: n
}

# a function's body sees the program's names outside function bodies and its own parameters and locals, as Rust's
# Names::within: `x is key` in one function stays a type test beside a local `key` of another
scoped_type_tests(n: Node, outer: any): Node := {
	if is_function_definition(n) {
		inner = scope_with(outer, nodes_in(n))
		return bottom_up(n, x => type_test_node(x, inner))
	}
	type_test_node(children(n, x => scoped_type_tests(x, outer)), outer)
}

type_tests(program: any): any := scoped_type_tests(program, scope_with({}, outer_nodes_in(program)))
