# `x is int`, `n is symbol` (card pure-type-tests): `x is T` of a type word T the program binds nowhere (no variable,
# parameter or function of that name) is the type test is_type(x, "T"), as Rust's src/lowering/types/type_tests.rs
# lowers it; every other `x is v` is `x == v`. Only `is` tests a type: `3 == int` compares 3 with the type (no)
use "walk.warp"
use "words.warp"
use "scope.warp"

tested_word_call(subject: Node, word: text, equality: Node, scope: any): Node :=
	if is_tested_type_word(word) and not binds(scope, word) then call_of("is_type", [subject, word]) else equality

tested_type_call(subject: Node, type: Node, scope: any): Node := match type {
	Symbol(word): tested_word_call(subject, word, Key(subject, Op.Eq, type), scope)
	_: Key(subject, Op.Eq, type)
}

type_test_node(n: Node, scope: any): Node := match n {
	Key(subject, Op.Is, type): tested_type_call(subject, type, scope)
	_: n
}

type_tests(program: any): any := {
	scope = scope_of(program)
	bottom_up(program, n => type_test_node(n, scope))
}
