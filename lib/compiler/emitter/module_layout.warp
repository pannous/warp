# The module's sections in order (emitter.warp's part): types, imports, functions, memory, globals, exports, code, data
# and the names section
## the module
def value_type(kind: text): list { if kind in references then gc_bytes(references[kind]) else [type_bytes[kind]] }
# a global's first value, before its declaration sets it
def zero_code_of(kind: text): list {
	if kind == "int" { return [op.i64_const, 0] }
	if kind == "float" { return [op.f64_const] + le64(0) }
	# a node global holds 0 until assigned, as Rust's `global x; x` gives (struct.new is a constant expression)
	if kind == "node" { return boxed(number_value(0)) }
	if kind == "list" { return vector_code([]) }
	if kind in references { return [ref_null] + (if kind == "time" then [110] else uleb(gc_type(references[kind]#2))) }
	[op.i32_const, 0]
}
def global_entry(name: text): list { value_type(module.globals[name]#2) + [mutable] + zero_code_of(module.globals[name]#2) + [op.end] }
def function_type(f: Function): list { [function_type_byte] + vector(f.kinds.map(value_type)) + (if f.result == no_kind then [0] else [1] + value_type(f.result)) }
def function_body(f: Function): list {
	content = vector(f.locals.map(k => [1] + value_type(k))) + f.code + [op.end]
	uleb(#content) + content
}
def index_name(i: int, name: text): list { uleb(i) + name_bytes(name) }
def name_map(names: any): list { vector(range_list(#names).map(i => index_name(i, names#(i + 1)))) }
def local_name_map(f: Function): list { uleb(f.index) + name_map(f.local_names) }
def range_list(n: int): list {
	out = []
	for i in 0..n { out += [i] }
	out
}
def subsection(id: int, content: any): list { [id] + uleb(#content) + content }
def names_section(functions: any): list {
	imported = range_list(#module.imports).map(i => index_name(i, module.imports#(i + 1)#2))
	function_names = vector(imported + functions.map(f => index_name(f.index, f.name)))
	locals = vector(functions.map(local_name_map))
	types = name_map(module.gc_order)
	fields = vector(range_list(#module.gc_order).map(i => uleb(i) + name_map(gc_names#(gc_position(module.gc_order#(i + 1)))#2)))
	content = subsection(names_subsections.functions, function_names) + subsection(names_subsections.locals, locals)
	globals = name_map(module.global_order)
	content += subsection(names_subsections.types, types) + subsection(names_subsections.globals, globals)
	content += subsection(names_subsections.fields, fields)
	if module.catches_errors { content += subsection(names_subsections.tags, name_map([error_tag_name])) }
	section(section_ids.custom, name_bytes("name") + content)
}

def module_bytes(functions: any): list {
	# what names a value type first (functions' signatures and locals, globals), so the GC types the module declares
	# are all known: those its code used, then these (gc_type)
	function_types = functions.map(function_type)
	codes = section(section_ids.code, vector(functions.map(function_body)))
	globals = section(section_ids.globals, vector(module.global_order.map(global_entry)))
	# an import's type follows the GC types in the imports' order, so a function's type is #gc_order + its index too
	# the tag's type after every function's
	tag_types = if module.catches_errors then [[function_type_byte] + vector([value_type("bool")]) + [0]] else []
	gc_declared = module.gc_order.map(name => gc_bytes(gc_types#(gc_position(name))))
	types = section(section_ids.type, vector(gc_declared + module.imports.map(i => i#3) + function_types + tag_types))
	imported = section(section_ids.import, vector(range_list(#module.imports).map(i => import_entry(i))))
	declared = section(section_ids.function, vector(functions.map(f => uleb(#module.gc_order + f.index))))
	exports = [name_bytes("main") + [export_function_byte] + uleb(functions#1.index)]
	# always a memory, exported as Rust's: the host of a program importing this module compiled reads it
	memory = section(section_ids.memory, vector([[0] + uleb(memory_pages)]))
	exports += [name_bytes("memory") + [export_memory_byte, 0]]
	if #module.imports == 0 { imported = [] }
	for name in exported_globals {
		if name in module.globals { exports += [name_bytes(name) + [export_global_byte] + uleb(module.globals[name]#1)] }
	}
	# the program's functions under the names left free, as Rust's export_names: a module imported compiled calls them
	taken = ["main", "memory"] + exported_globals
	for f in module.builders {
		exports += [name_bytes(f.name) + [export_function_byte] + uleb(f.index)]
		taken += [f.name]
	}
	for f in functions[1..] {
		if not f.is_runtime and f.name not in taken {
			exports += [name_bytes(f.name) + [export_function_byte] + uleb(f.index)]
			taken += [f.name]
		}
	}
	exported = section(section_ids.export, vector(exports))
	# the texts' bytes: one passive segment, which array.new_data reads
	segments = section(section_ids.data_count, uleb(1))
	data = data_bytes()
	texts = section(section_ids.data, vector([[passive_segment] + uleb(#data) + data]))
	tags = []
	if module.catches_errors { tags = section(section_ids.tag, vector([[0] + uleb(#module.gc_order + #module.imports + #functions)])) }
	parts = [types, imported, declared, memory, tags, globals, exported, segments, codes, texts]
	marks = if module.counts_fuel then section(section_ids.custom, name_bytes(fuel_section)) else []
	wasm_header + concatenated(parts) + names_section(functions) + marks + c_functions_custom_section()
}
# the data segment: each text's bytes once, in the order text_offset gave them their offsets
def data_bytes(): list { concatenated(module.texts.keys.map(t => t.bytes)) }
def import_entry(i: int): list {
	entry = module.imports#(i + 1)
	name_bytes(entry#1) + name_bytes(entry#2) + [import_function_byte] + uleb(#module.gc_order + i)
}
