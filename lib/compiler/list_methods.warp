# Methods written as calls on a value (card pure-runs): `xs.push(v)` appends to the list the name holds,
# `xs += [v]`, which emitter.warp grows in place while the list is unshared; any other `x.f(a, b)` but a change in
# place (in_place_methods) is the call `f(x, a, b)`, as Rust's library_words.rs method_call makes it of a word (card
# pure-lane-lowers). `x in xs` (a list's item, a map's key, a text's part) is the runtime word
# collection_contains(xs, x), as Rust lowers it.
use "walk.warp"
use "phrase_blocks.warp"

pushed(list: Node, call: list, n: Node): Node := {
	if #call == 2 and call#1 == symbol("push") and is_name(list) {
		return Key(list, Op.AddAssign, List([call#2], Bracket.Square, Separator.Comma))
	}
	if #call >= 1 and call#1 is symbol and not (name_of(call#1) in in_place_methods) {
		return List([call#1, list] + call[1..], Bracket.Round, Separator.None)
	}
	n
}
# the methods that change the list or map they are called on, which Rust's list_mutations.rs lowers in place
in_place_methods = ["add", "append", "push", "insert", "pop", "remove", "delete", "clear"]

method_call(receiver: Node, called: Node, n: Node): Node := match called {
	List(call, Bracket.Round, Separator.None): pushed(receiver, call, n)
	_: n
}

# `x in xs`: whether a map has the key x or a list the element x; `xs contains x`, `xs has x`, `xs includes x` the same
# written the other way round. Rust twin: library_words.rs membership (its text units, `#bytes in t`, are not here)
contained_word = {"contains": 1, "has": 1, "includes": 1}

membership(phrase_parts: list, n: Node): Node := {
	if #phrase_parts != 3 or not is_name(phrase_parts#2) { return n }
	middle = name_of(phrase_parts#2)
	if middle == "in" { return List([symbol("collection_contains"), phrase_parts#3, phrase_parts#1], Bracket.Round, Separator.None) }
	if middle in contained_word { return List([symbol("collection_contains"), phrase_parts#1, phrase_parts#3], Bracket.Round, Separator.None) }
	n
}

list_method(n: Node): Node := match n {
	Key(receiver, Op.Dot, called): method_call(receiver, called, n)
	List(phrase_parts, Bracket.None, Separator.Space): membership(phrase_parts, n)
	_: n
}

list_methods(program: any): any := bottom_up(program, list_method)
