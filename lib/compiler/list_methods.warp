# Methods written as calls on a value (card pure-runs): any `x.f(a, b)` but a change in place (in_place_methods) is the
# call `f(x, a, b)`, as Rust's library_words.rs method_call makes it of a word (card pure-lane-lowers); it runs after the
# passes that read method calls (lambdas, arity_overloads). `m.remove(k)` needs a hidden name, which a rewrite cannot
# make yet (notes/layers.md F3). The appending methods and `x in xs` are lib/sugar/methods.warp.
use "walk.warp"
use "phrase_blocks.warp"

pushed(list: Node, call: list, n: Node): Node := {
	if #call == 2 and call#1 is symbol and name_of(call#1) in removal_methods and is_name(list) { return removed(list, call#2) }
	if #call >= 1 and call#1 is symbol and name_of(call#1) not in in_place_methods {
		return List([call#1, list] + call[1..], Bracket.Round, Separator.None)
	}
	n
}

# `m.remove(k)`, `m.delete(k)` of a variable: the value of k, its entry removed from m (Python's dict.pop); of a list the
# first element equal to k removed. Rust twin: list_mutations.rs removed_key
removal_methods = ["remove", "delete"]
removed(collection: Node, removed_key: Node): Node := {
	held = symbol(name_of(collection) + "·removed")
	taken = Key(held, Op.Assign, List([symbol("removed_value"), collection, removed_key], Bracket.Round, Separator.None))
	rest = Key(collection, Op.Assign, List([symbol("map_without"), collection, removed_key], Bracket.Round, Separator.None))
	List([taken, rest, held], Bracket.Round, Separator.Semicolon)
}
# the methods that change the list or map they are called on, which Rust's list_mutations.rs lowers in place
in_place_methods = ["add", "append", "push", "insert", "pop", "remove", "delete", "clear"]

method_call(receiver: Node, called: Node, n: Node): Node := match called {
	List(call, Bracket.Round, Separator.None): pushed(receiver, call, n)
	_: n
}

list_method(n: Node): Node := match n {
	Key(receiver, Op.Dot, called): method_call(receiver, called, n)
	_: n
}

list_methods(program: Node): Node := bottom_up(program, list_method)
