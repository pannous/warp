// Clusters of triangles, a coarser regular grid, and which clusters a camera keeps.
// `use meshlets`. This is not Nanite and not the three.js meshlet renderer: there is no cluster hierarchy,
// no streaming, and no GPU draw. The reference for the cone test is meshoptimizer's published bounds
// (MIT, Arseny Kapoulkine) as three.js uses it in MeshletDrawingPipeline at e4d0c9eb (MIT). The code here
// is new. Coarsening is only a stride-2 heightfield, notes/meshlets.md.
use bits
use file
use geometry
use math

TREE_MESH_SOURCE = "the EZ Tree meshes are fetched by scripts/sample-assets.sh fetch, or generated by node scripts/ez_tree/export.mjs, hero.mjs and python3 scripts/ez_tree/atlas.py (samples/graphics/ez_trees/NOTICE.md)"
MESHLET_TRIANGLES = 64
// meshoptimizer drops a cone once it is about 168 degrees wide (min dot at most 0.1). Wider than that,
// or any degenerate triangle, and the cluster stays: a cull would not be true of every triangle.
CONE_MIN_DOT = 0.1
MESHLET_EPSILON = 0.000000001

class Sphere { center: list; radius: float }
class Cone { axis: list; cutoff: float; cullable: bool }
// `at` is the cluster's first triangle in the mesh level, so a draw can name the range without copying it
class Cluster { triangles: list; sphere: Sphere; cone: Cone; at: int }
class MeshLevel { triangles: list; clusters: list; error: float }
// A tree mesh read from an .eztree file: two levels, each the point soup MeshLevel plus the vertices and indexed triangles the GPU draws
class TreeLevel { mesh: MeshLevel; vertices: list; indices: list; base: int; vertex_at: int }
class TreeMesh { levels: list }
class MeshPack { vertices: list; texels: list; triangles: list }

meshlet_cells(cells_x, cells_y) := {
	if not (cells_x is int) or not (cells_y is int) or cells_x < 2 or cells_y < 2 or cells_x % 2 != 0 or cells_y % 2 != 0 {
		raise "meshlets: a grid needs even cell counts of at least 2, not " + text(cells_x) + " by " + text(cells_y)
	}
}

meshlet_heights(cells_x, cells_y, heights) := {
	meshlet_cells(cells_x, cells_y)
	wanted = (cells_x + 1) * (cells_y + 1)
	if not (heights is list) { raise "meshlets: heights must be a list, not " + text(heights) }
	if count(heights) != wanted {
		raise "meshlets: a " + text(cells_x) + " by " + text(cells_y) + " grid needs " + text(wanted) + " heights, not " + text(count(heights))
	}
	for h in heights { if not (h is number) { raise "meshlets: a height must be a number, not " + text(h) } }
}

grid_height(cells_x, heights, i, j) := heights#(j * (cells_x + 1) + i + 1)

grid_vertex(cells_x, heights, i, j) := [i, j, grid_height(cells_x, heights, i, j)]

// Both triangles of a cell wind counter-clockwise seen from +z, so a flat grid faces up.
grid_cells(cells_x, cells_y, heights, step) := {
	triangles = []
	j = 0
	while j < cells_y {
		i = 0
		while i < cells_x {
			a = grid_vertex(cells_x, heights, i, j)
			b = grid_vertex(cells_x, heights, i + step, j)
			d = grid_vertex(cells_x, heights, i + step, j + step)
			c = grid_vertex(cells_x, heights, i, j + step)
			triangles.add([a, b, d])
			triangles.add([a, d, c])
			i = i + step
		}
		j = j + step
	}
	triangles
}

// Height of the coarse triangulation at a fine vertex. Even vertices are kept, so their error is zero.
// An odd vertex reads the coarse cell that contains it; on the far edge that cell is the one before it.
coarse_height(cells_x, cells_y, heights, i, j) := {
	if i % 2 == 0 and j % 2 == 0 { return grid_height(cells_x, heights, i, j) }
	i0 = if i == cells_x then i - 2 else i - i % 2
	j0 = if j == cells_y then j - 2 else j - j % 2
	u = (i - i0) / 2.0
	v = (j - j0) / 2.0
	za = grid_height(cells_x, heights, i0, j0)
	zb = grid_height(cells_x, heights, i0 + 2, j0)
	zc = grid_height(cells_x, heights, i0, j0 + 2)
	zd = grid_height(cells_x, heights, i0 + 2, j0 + 2)
	if u >= v { (1.0 - u) * za + (u - v) * zb + v * zd } else { (1.0 - v) * za + (v - u) * zc + u * zd }
}

grid_error(cells_x, cells_y, heights) := {
	worst = 0.0
	j = 0
	while j <= cells_y {
		i = 0
		while i <= cells_x {
			gap = 0.0 + abs(grid_height(cells_x, heights, i, j) - coarse_height(cells_x, cells_y, heights, i, j))
			if gap > worst { worst = gap }
			i = i + 1
		}
		j = j + 1
	}
	worst
}

meshlet_point(name, p) := {
	if not (p is list) or count(p) != 3 { raise name + " needs 3D points, not " + text(p) }
	for x in p { if not (x is number) { raise name + " needs numbers, not " + text(x) } }
}

meshlet_triangle(name, triangle) := {
	if not (triangle is list) or count(triangle) != 3 { raise name + " needs a triangle of 3 points, not " + text(triangle) }
	for p in triangle { meshlet_point(name, p) }
}

// Sphere of the axis-aligned box. It is larger than the smallest sphere and still contains every vertex.
sphere_of(points) := {
	box = bounding_box(points)
	low = box#1
	high = box#2
	center = [(low#k + high#k) / 2.0 for k in 1 to 3]
	radius = 0.0
	for p in points {
		d = geo_distance(center, p)
		if d > radius { radius = d }
	}
	Sphere(center, radius)
}

// No cull when a triangle has no area, the normals cancel, or the cone is wider than CONE_MIN_DOT.
// The stored cutoff is the sine of the half-angle, and 1 means "do not cull".
cone_of(triangles) := {
	normals = []
	degenerate = no
	for triangle in triangles {
		edge = vec_cross(vec_sub(triangle#2, triangle#1), vec_sub(triangle#3, triangle#1))
		span = vec_norm(edge)
		if span <= MESHLET_EPSILON { degenerate = yes } else { normals.add(vec_scale(edge, 1.0 / span)) }
	}
	idle = Cone([0.0, 0.0, 1.0], 1.0, no)
	if degenerate or count(normals) == 0 { return idle }
	total = [0.0, 0.0, 0.0]
	for normal in normals { total = vec_add(total, normal) }
	axis_length = vec_norm(total)
	if axis_length <= MESHLET_EPSILON { return idle }
	axis = vec_scale(total, 1.0 / axis_length)
	mindp = 1.0
	for n in normals {
		d = vec_dot(n, axis)
		if d < mindp { mindp = d }
	}
	if mindp <= CONE_MIN_DOT { return Cone(axis, 1.0, no) }
	if mindp > 1.0 { mindp = 1.0 }
	Cone(axis, sqrt(1.0 - mindp * mindp), yes)
}

cluster_of(triangles, at) := {
	points = []
	for triangle in triangles { for p in triangle { points.add(p) } }
	Cluster(triangles, sphere_of(points), cone_of(triangles), at)
}

// Consecutive triangles, 64 to a cluster. Not a spatial partition.
cluster_triangles(triangles: list) as list := {
	if not (triangles is list) { raise "meshlets: triangles must be a list, not " + text(triangles) }
	for triangle in triangles { meshlet_triangle("meshlets", triangle) }
	clusters = []
	bucket = []
	at = 0
	for triangle in triangles {
		bucket.add(triangle)
		if count(bucket) == MESHLET_TRIANGLES {
			clusters.add(cluster_of(bucket, at))
			bucket = []
			at = at + MESHLET_TRIANGLES
		}
	}
	if count(bucket) > 0 { clusters.add(cluster_of(bucket, at)) }
	clusters
}

flat_heights(cells_x: int, cells_y: int) as list := {
	meshlet_cells(cells_x, cells_y)
	[0 for i in 0 ..< ((cells_x + 1) * (cells_y + 1))]
}

grid_triangles(cells_x: int, cells_y: int, heights: list) as list := {
	meshlet_heights(cells_x, cells_y, heights)
	grid_cells(cells_x, cells_y, heights, 1)
}

// The fine grid as vertices plus a triangle index list. The triangles are grid_triangles, each index a vertex.
grid_indexed(cells_x: int, cells_y: int, heights: list) as list := {
	meshlet_heights(cells_x, cells_y, heights)
	vertices = []
	j = 0
	while j <= cells_y {
		i = 0
		while i <= cells_x {
			vertices.add(grid_vertex(cells_x, heights, i, j))
			i = i + 1
		}
		j = j + 1
	}
	indices = []
	span = cells_x + 1
	j = 0
	while j < cells_y {
		i = 0
		while i < cells_x {
			a = j * span + i
			b = a + 1
			c = a + span
			d = c + 1
			indices.add(a)
			indices.add(b)
			indices.add(d)
			indices.add(a)
			indices.add(d)
			indices.add(c)
			i = i + 1
		}
		j = j + 1
	}
	[vertices, indices]
}

// Triangle records [a, b, c, …] as the flat index buffer a hardware draw reads. Part and anything after c stay out.
mesh_draw_indices(indices: list) as list := {
	if not (indices is list) { raise "meshlets: indices must be a list, not " + text(indices) }
	flat = []
	for tri in indices {
		if not (tri is list) or count(tri) < 3 { raise "meshlets: an index triple is three numbers, not " + text(tri) }
		for k in 1 to 3 {
			if not (tri#k is int) { raise "meshlets: an index is an int, not " + text(tri#k) }
			flat.add(tri#k)
		}
	}
	if count(flat) == 0 { raise "meshlets: indices are empty" }
	flat
}

// Frames a second from a counted run. The samples print this on stderr when launched with `fps`.
frame_rate(frames: int, spent_ms: number) as float := {
	if not (frames is int) or frames <= 0 { raise "meshlets: frames must be a positive int, not " + text(frames) }
	if spent_ms <= 0 { raise "meshlets: the measured time must be positive, not " + text(spent_ms) }
	frames * 1000.0 / spent_ms
}

// Level 1 is the grid. Level 2 keeps every other vertex and records the largest vertical gap.
grid_levels(cells_x: int, cells_y: int, heights: list) as list := {
	meshlet_heights(cells_x, cells_y, heights)
	fine = grid_cells(cells_x, cells_y, heights, 1)
	coarse = grid_cells(cells_x, cells_y, heights, 2)
	[MeshLevel(fine, cluster_triangles(fine), 0.0), MeshLevel(coarse, cluster_triangles(coarse), grid_error(cells_x, cells_y, heights))]
}

// Perspective pixels: error / distance * cot(half fov) * screen height / 2. Orthographic is not this.
projected_error(error: number, distance: number, cot_half_fov: number, screen_height: number) as float := {
	meshlet_error(error)
	if distance <= 0 { raise "meshlets: distance must be positive, not " + text(distance) }
	if cot_half_fov < 0 or screen_height < 0 {
		raise "meshlets: cot(half fov) and screen height must not be negative, not " + text(cot_half_fov) + " and " + text(screen_height)
	}
	error / distance * cot_half_fov * screen_height / 2.0
}

meshlet_levels(levels) := {
	if not (levels is list) or count(levels) == 0 { raise "meshlets: levels must be a non-empty list, not " + text(levels) }
}

meshlet_rising(error, previous, started) := {
	meshlet_error(error)
	if started and error < previous { raise "meshlets: level errors must not decrease" }
	error
}

// The last level whose projected error is within the threshold. 1 is the finest. Errors do not fall.
lod_picked(errors: list, distance: number, cot_half_fov: number, screen_height: number, threshold: number) as int := {
	meshlet_levels(errors)
	if threshold < 0 { raise "meshlets: threshold must not be negative, not " + text(threshold) }
	previous = 0.0
	started = no
	for error in errors {
		previous = meshlet_rising(error, previous, started)
		started = yes
	}
	picked = 0
	i = 1
	for error in errors {
		if projected_error(error, distance, cot_half_fov, screen_height) <= threshold { picked = i }
		i = i + 1
	}
	if picked == 0 { raise "meshlets: no level is within the error threshold" }
	picked
}

// The last level whose projected error is within the threshold. Levels are fine first, errors do not fall.
chosen_level(levels: list, distance: number, cot_half_fov: number, screen_height: number, threshold: number) as int := {
	meshlet_levels(levels)
	for level in levels { if not (level is MeshLevel) { raise "meshlets: a level must be a MeshLevel, not " + text(level) } }
	lod_picked([level.error for level in levels], distance, cot_half_fov, screen_height, threshold)
}

meshlet_plane(plane) := {
	if not (plane is list) or count(plane) != 4 { raise "meshlets: a plane is nx, ny, nz, d, not " + text(plane) }
	for x in plane { if not (x is number) { raise "meshlets: a plane needs numbers, not " + text(x) } }
}

// Inside is n·p + d >= 0. A sphere that only touches the plane stays inside.
sphere_inside(sphere, planes) := {
	for plane in planes {
		meshlet_plane(plane)
		signed = plane#1 * sphere.center#1 + plane#2 * sphere.center#2 + plane#3 * sphere.center#3 + plane#4
		if signed < -sphere.radius { return no }
	}
	yes
}

// Strict: a sphere that only touches the back cone stays visible.
cone_faces_away(cone, sphere, camera) := {
	if not cone.cullable { return no }
	meshlet_point("meshlets", camera)
	to_center = vec_sub(sphere.center, camera)
	apart = vec_norm(to_center)
	if apart == 0 { return no }
	vec_dot(to_center, cone.axis) > cone.cutoff * apart + sphere.radius
}

meshlet_clusters(clusters) := {
	if not (clusters is list) { raise "meshlets: clusters must be a list, not " + text(clusters) }
}

meshlet_planes(planes) := {
	if not (planes is list) { raise "meshlets: planes must be a list, not " + text(planes) }
}

meshlet_error(error) := {
	if error < 0 { raise "meshlets: error must not be negative, not " + text(error) }
}

meshlet_one(cluster) := {
	if not (cluster is Cluster) { raise "meshlets: a cluster must be a Cluster, not " + text(cluster) }
}

visible_clusters(clusters: list, planes: list, camera: list) as list := {
	meshlet_clusters(clusters)
	meshlet_planes(planes)
	meshlet_point("meshlets", camera)
	kept = []
	for cluster in clusters {
		meshlet_one(cluster)
		if sphere_inside(cluster.sphere, planes) and not cone_faces_away(cluster.cone, cluster.sphere, camera) { kept.add(cluster) }
	}
	kept
}

triangle_count(clusters: list) as int := {
	meshlet_clusters(clusters)
	n = 0
	for cluster in clusters {
		meshlet_one(cluster)
		n = n + count(cluster.triangles)
	}
	n
}

// --- tree meshes (.eztree). EZ Tree emits a branch, then that branch's leaves, so 64 consecutive triangles
// already sit together; cluster_triangles is the partition, and there is no spatial rebuild.
TREE_VERTEX_BYTES = 20
TREE_TRIANGLE_BYTES = 8
TREE_LEVELS = 8

tree_span(bytes, at, n) := {
	if at < 0 or n < 0 or at + n > count(bytes) { raise "meshlets: a tree mesh is shorter than it says" }
}

tree_magic(bytes) := {
	if count(bytes) < 8 or bytes[0] != 69 or bytes[1] != 90 or bytes[2] != 84 or bytes[3] != 49 {
		raise "meshlets: a tree mesh starts with EZT1"
	}
}

tree_point(vertices, index) := {
	vertex = vertices#(index + 1)
	[vertex#1, vertex#2, vertex#3]
}

// World y is up. place is x, z, yaw, scale: a point p in the tree becomes (x, 0, z) + scale * R(yaw) * p.
// Planes and the camera move into that frame, so the shared clusters are culled where they stand.
meshlet_place(place) := {
	if not (place is list) or count(place) != 4 { raise "meshlets: a place is x, z, yaw, scale, not " + text(place) }
	for x in place { if not (x is number) { raise "meshlets: a place needs numbers, not " + text(x) } }
	if place#4 <= 0 { raise "meshlets: scale must be positive, not " + text(place#4) }
}

yaw_into(v, yaw) := {
	c = cos(yaw)
	s = sin(yaw)
	[c * v#1 + s * v#3, v#2, -s * v#1 + c * v#3]
}

local_view(planes: list, camera: list, place: list) as list := {
	meshlet_place(place)
	scale = place#4
	meshlet_planes(planes)
	meshlet_point("meshlets", camera)
	origin = [place#1, 0.0, place#2]
	moved = yaw_into(vec_sub(camera, origin), place#3)
	local_camera = vec_scale(moved, 1.0 / scale)
	local_planes = []
	for plane in planes {
		meshlet_plane(plane)
		normal = [plane#1, plane#2, plane#3]
		turned = yaw_into(normal, place#3)
		local_planes.add([turned#1, turned#2, turned#3, (vec_dot(normal, origin) + plane#4) / scale])
	}
	[local_planes, local_camera]
}

// The same sphere and cone in world space. Yaw turns the point the other way from local_view.
placed_point(point, place) as list := {
	meshlet_place(place)
	meshlet_point("meshlets", point)
	turned = yaw_into(vec_scale(point, place#4), -place#3)
	[turned#1 + place#1, turned#2, turned#3 + place#2]
}

placed_bounds(cluster, place) as list := {
	meshlet_one(cluster)
	center = placed_point(cluster.sphere.center, place)
	[center#1, center#2, center#3, cluster.sphere.radius * place#4]
}

placed_cone(cluster, place) as list := {
	meshlet_one(cluster)
	meshlet_place(place)
	axis = yaw_into(cluster.cone.axis, -place#3)
	[axis#1, axis#2, axis#3, cluster.cone.cutoff]
}

// One vec4 a cluster: first index, index count, then two zeros. The index count is three times the triangles.
cluster_ranges(clusters: list) as list := {
	meshlet_clusters(clusters)
	for cluster in clusters { meshlet_one(cluster) }
	[[0.0 + cluster.at * 3, 0.0 + count(cluster.triangles) * 3, 0.0, 0.0] for cluster in clusters]
}

cluster_bounds(clusters: list) as list := {
	meshlet_clusters(clusters)
	[placed_bounds(cluster, [0.0, 0.0, 0.0, 1.0]) for cluster in clusters]
}

cluster_cones(clusters: list) as list := {
	meshlet_clusters(clusters)
	[placed_cone(cluster, [0.0, 0.0, 0.0, 1.0]) for cluster in clusters]
}

// How many clusters stay, tested where they stand. The GPU cull uses the same sphere and the stored cutoff.
placed_visible(clusters: list, planes: list, camera: list, place: list) as int := {
	meshlet_clusters(clusters)
	meshlet_planes(planes)
	meshlet_point("meshlets", camera)
	meshlet_place(place)
	n = 0
	for cluster in clusters {
		meshlet_one(cluster)
		center = placed_point(cluster.sphere.center, place)
		radius = cluster.sphere.radius * place#4
		sphere = Sphere(center, radius)
		axis = yaw_into(cluster.cone.axis, -place#3)
		cone = Cone(axis, cluster.cone.cutoff, cluster.cone.cullable)
		if sphere_inside(sphere, planes) and not cone_faces_away(cone, sphere, camera) { n = n + 1 }
	}
	n
}

// Cone test: meshoptimizer, MIT, Arseny Kapoulkine, https://github.com/zeux/meshoptimizer
// Indirect words: the shape in three.js PR 35191, MIT, https://github.com/mrdoob/three.js/pull/35191
// The WGSL is written here. A cutoff of 1 means do not cull, the same as cone_of.
// view[0] is the camera, and its w is the sprite count for an instanced grove.
// view[1] is LOD parameters: cot(half fov), screen height, threshold, and the plane count.
// Planes start at view[2], and there are view[1].w of them. Anything after the planes is not a plane.
CULL_FN = "fn sphere_out(center: vec3f, radius: f32) -> bool {\n" + "let count = u32(view[1].w);\n" + "for (var p = 0u; p < count; p++) {\n" + "let plane = view[2u + p];\n" + "if (dot(plane.xyz, center) + plane.w < -radius) { return true; }\n" + "}\n" + "return false;\n" + "}\n" + "fn cone_away(center: vec3f, radius: f32, cone: vec4f) -> bool {\n" + "if (cone.w >= 1.0) { return false; }\n" + "let away = center - view[0].xyz;\n" + "let apart = length(away);\n" + "if (apart == 0.0) { return false; }\n" + "return dot(away, cone.xyz) > cone.w * apart + radius;\n" + "}\n" + "fn cluster_kept(i: u32) -> bool {\n" + "let bound = bounds[i];\n" + "return !sphere_out(bound.xyz, bound.w) && !cone_away(bound.xyz, bound.w, cones[i]);\n" + "}\n"

// The least max-depth of the 8 by 8 tiles the pixel rect covers. 1 means do not cull.
OCCLUDE_FN = "fn occluder(px: f32, py: f32, radius: f32, width: f32, height: f32) -> f32 {\n" + "let tiles_x = u32(ceil(width / 8.0));\n" + "let tiles_y = u32(ceil(height / 8.0));\n" + "let x0 = i32(floor((px - radius) / 8.0));\n" + "let x1 = i32(floor((px + radius) / 8.0));\n" + "let y0 = i32(floor((py - radius) / 8.0));\n" + "let y1 = i32(floor((py + radius) / 8.0));\n" + "var nearest = 1.0;\n" + "var any = false;\n" + "for (var y = y0; y <= y1; y++) {\n" + "if (y < 0 || u32(y) >= tiles_y) { continue; }\n" + "for (var x = x0; x <= x1; x++) {\n" + "if (x < 0 || u32(x) >= tiles_x) { continue; }\n" + "any = true;\n" + "let d = pyramid[u32(y) * tiles_x + u32(x)];\n" + "if (d < nearest) { nearest = d; }\n" + "}\n" + "}\n" + "if (!any) { return 1.0; }\n" + "return nearest;\n" + "}\n"

LOD_FN = "fn projected(error: f32, distance: f32) -> f32 {\n" + "return error / distance * view[1].x * view[1].y * 0.5;\n" + "}\n" + "fn level_from_view(at: u32, count: u32, distance: f32) -> u32 {\n" + "var picked = 0u;\n" + "for (var i = 0u; i < count; i++) {\n" + "if (projected(view[at + i].z, distance) <= view[1].z) { picked = i + 1u; }\n" + "}\n" + "return picked;\n" + "}\n"

LODS_FN = "fn level_picked(first: u32, count: u32, distance: f32) -> u32 {\n" + "var picked = 0u;\n" + "for (var i = 0u; i < count; i++) {\n" + "if (projected(lods[first + i].z, distance) <= view[1].z) { picked = i + 1u; }\n" + "}\n" + "return picked;\n" + "}\n"

INDEX_CULL = "@binding(0) @group(0) var<storage, read> bounds: array<vec4f>;\n" + "@binding(1) @group(0) var<storage, read> cones: array<vec4f>;\n" + "@binding(2) @group(0) var<storage, read> view: array<vec4f>;\n" + "@binding(3) @group(0) var<storage, read> ranges: array<vec4f>;\n" + "@binding(4) @group(0) var<storage, read> source: array<f32>;\n" + "@binding(5) @group(0) var<storage, read_write> indices: array<u32>;\n" + "@binding(6) @group(0) var<storage, read_write> indirect: array<u32>;\n" + CULL_FN + "@compute @workgroup_size(1) fn main() {\n" + "var count = 0u;\n" + "let n = arrayLength(&bounds);\n" + "for (var i = 0u; i < n; i++) {\n" + "if (!cluster_kept(i)) { continue; }\n" + "let first = u32(ranges[i].x);\n" + "let last = first + u32(ranges[i].y);\n" + "for (var k = first; k < last; k++) {\n" + "indices[count] = u32(source[k]);\n" + "count++;\n" + "}\n" + "}\n" + "indirect[0] = count;\n" + "indirect[1] = 1u;\n" + "indirect[2] = 0u;\n" + "indirect[3] = 0u;\n" + "indirect[4] = 0u;\n" + "}\n"

INSTANCE_CULL = "@binding(0) @group(0) var<storage, read_write> draws: array<vec4f>;\n" + "@binding(1) @group(0) var<storage, read_write> spans: array<vec4f>;\n" + "@binding(2) @group(0) var<storage, read> bounds: array<vec4f>;\n" + "@binding(3) @group(0) var<storage, read> cones: array<vec4f>;\n" + "@binding(4) @group(0) var<storage, read> view: array<vec4f>;\n" + "@binding(5) @group(0) var<storage, read_write> indirect: array<u32>;\n" + CULL_FN + "@compute @workgroup_size(1) fn main() {\n" + "var kept = 0u;\n" + "let n = arrayLength(&bounds);\n" + "for (var i = 0u; i < n; i++) {\n" + "if (!cluster_kept(i)) { continue; }\n" + "draws[kept] = draws[i];\n" + "spans[kept] = spans[i];\n" + "kept++;\n" + "}\n" + "indirect[0] = 4u;\n" + "indirect[1] = u32(view[0].w) + kept * " + text(MESHLET_TRIANGLES) + "u;\n" + "indirect[2] = 0u;\n" + "indirect[3] = 0u;\n" + "}\n"

// After the planes, two levels (first cluster, count, error) and the screen size. Distance is view[0].w.
LOD_INDEX = "@binding(0) @group(0) var<storage, read> bounds: array<vec4f>;\n" + "@binding(1) @group(0) var<storage, read> cones: array<vec4f>;\n" + "@binding(2) @group(0) var<storage, read> view: array<vec4f>;\n" + "@binding(3) @group(0) var<storage, read> ranges: array<vec4f>;\n" + "@binding(4) @group(0) var<storage, read> source: array<f32>;\n" + "@binding(5) @group(0) var<storage, read_write> indices: array<u32>;\n" + "@binding(6) @group(0) var<storage, read_write> indirect: array<u32>;\n" + "@binding(7) @group(0) var<storage, read> pyramid: array<f32>;\n" + CULL_FN + LOD_FN + OCCLUDE_FN + "fn grid_hidden(center: vec3f, radius: f32) -> bool {\n" + "let at = 2u + u32(view[1].w);\n" + "let screen = view[at + 2u];\n" + "let x_ndc = center.x * 1.6;\n" + "let y_ndc = center.y * 1.6 - 0.85;\n" + "let depth = clamp(center.z * 0.5 + 0.5, 0.0, 1.0);\n" + "let nearest = clamp(depth - radius * 0.5, 0.0, 1.0);\n" + "let px = (x_ndc * 0.5 + 0.5) * screen.x;\n" + "let py = (0.5 - y_ndc * 0.5) * screen.y;\n" + "let rad = radius * 1.6 * 0.5 * screen.x;\n" + "return nearest > occluder(px, py, rad, screen.x, screen.y);\n" + "}\n" + "@compute @workgroup_size(1) fn main() {\n" + "var count = 0u;\n" + "let at = 2u + u32(view[1].w);\n" + "let picked = level_from_view(at, 2u, view[0].w);\n" + "if (picked > 0u) {\n" + "let level = view[at + picked - 1u];\n" + "let first_c = u32(level.x);\n" + "let last_c = first_c + u32(level.y);\n" + "for (var i = first_c; i < last_c; i++) {\n" + "if (!cluster_kept(i) || grid_hidden(bounds[i].xyz, bounds[i].w)) { continue; }\n" + "let first = u32(ranges[i].x);\n" + "let last = first + u32(ranges[i].y);\n" + "for (var k = first; k < last; k++) {\n" + "indices[count] = u32(source[k]);\n" + "count++;\n" + "}\n" + "}\n" + "}\n" + "indirect[0] = count;\n" + "indirect[1] = 1u;\n" + "indirect[2] = 0u;\n" + "indirect[3] = 0u;\n" + "indirect[4] = 0u;\n" + "}\n"

// trees[t] is first level, level count, local distance. levels are that tree's levels, in order.
LOD_INSTANCE = "@binding(0) @group(0) var<storage, read_write> draws: array<vec4f>;\n" + "@binding(1) @group(0) var<storage, read_write> spans: array<vec4f>;\n" + "@binding(2) @group(0) var<storage, read> bounds: array<vec4f>;\n" + "@binding(3) @group(0) var<storage, read> cones: array<vec4f>;\n" + "@binding(4) @group(0) var<storage, read> view: array<vec4f>;\n" + "@binding(5) @group(0) var<storage, read_write> indirect: array<u32>;\n" + "@binding(6) @group(0) var<storage, read> lods: array<vec4f>;\n" + "@binding(7) @group(0) var<storage, read> pyramid: array<f32>;\n" + CULL_FN + LOD_FN + LODS_FN + OCCLUDE_FN + "fn forest_hidden(center: vec3f, radius: f32) -> bool {\n" + "let base = 2u + u32(view[1].w);\n" + "let forward = view[base].xyz;\n" + "let focal = view[base].w;\n" + "let right = view[base + 1u].xyz;\n" + "let centre_x = view[base + 1u].w;\n" + "let up = view[base + 2u].xyz;\n" + "let centre_y = view[base + 2u].w;\n" + "let near = view[base + 3u].x;\n" + "let far = view[base + 3u].y;\n" + "let width = view[base + 3u].z;\n" + "let height = view[base + 3u].w;\n" + "let d = center - view[0].xyz;\n" + "let z = dot(d, forward);\n" + "if (z < 0.2) { return false; }\n" + "let nearest = clamp((z - radius - near) / (far - near), 0.0, 1.0);\n" + "let px = centre_x + dot(d, right) / z * focal;\n" + "let py = centre_y - dot(d, up) / z * focal;\n" + "return nearest > occluder(px, py, radius * focal / z, width, height);\n" + "}\n" + "@compute @workgroup_size(1) fn main() {\n" + "var kept = 0u;\n" + "let base = 2u + u32(view[1].w);\n" + "let trees_n = u32(view[base + 4u].x);\n" + "for (var t = 0u; t < trees_n; t++) {\n" + "let tree = lods[t];\n" + "let picked = level_picked(u32(tree.x), u32(tree.y), tree.z);\n" + "if (picked == 0u) { continue; }\n" + "let level = lods[u32(tree.x) + picked - 1u];\n" + "let first = u32(level.x);\n" + "let last = first + u32(level.y);\n" + "for (var i = first; i < last; i++) {\n" + "if (!cluster_kept(i) || forest_hidden(bounds[i].xyz, bounds[i].w)) { continue; }\n" + "draws[kept] = draws[i];\n" + "spans[kept] = spans[i];\n" + "kept++;\n" + "}\n" + "}\n" + "indirect[0] = 4u;\n" + "indirect[1] = u32(view[0].w) + kept * " + text(MESHLET_TRIANGLES) + "u;\n" + "indirect[2] = 0u;\n" + "indirect[3] = 0u;\n" + "}\n"

// "EZT1", then a u32 level count. Each level is u32 vertices, u32 triangles, f32 error, then vertices
// (x, y, z, u, v) and triangles (u16 a, b, c, part). part 0 is bark and 1 is a leaf. notes/meshlets.md.
tree_mesh_of(bytes: list) as TreeMesh := {
	if not (bytes is list) { raise "meshlets: a tree mesh is bytes, not " + text(bytes) }
	tree_magic(bytes)
	levels_n = u32_at(bytes, 4)
	if levels_n == 0 or levels_n > TREE_LEVELS { raise "meshlets: a tree mesh needs 1 to 8 levels, not " + text(levels_n) }
	at = 8
	levels = []
	previous = 0.0
	started = no
	for n in 1 to levels_n {
		tree_span(bytes, at, 12)
		vertices_n = u32_at(bytes, at)
		triangles_n = u32_at(bytes, at + 4)
		error = f32_at(bytes, at + 8)
		at = at + 12
		if vertices_n > 65535 { raise "meshlets: a level has more vertices than a u16 index holds, " + text(vertices_n) }
		previous = meshlet_rising(error, previous, started)
		started = yes
		tree_span(bytes, at, vertices_n * TREE_VERTEX_BYTES + triangles_n * TREE_TRIANGLE_BYTES)
		vertices = []
		for i in 0 ..< vertices_n {
			vertices.add([f32_at(bytes, at), f32_at(bytes, at + 4), f32_at(bytes, at + 8), f32_at(bytes, at + 12), f32_at(bytes, at + 16)])
			at = at + TREE_VERTEX_BYTES
		}
		indices = []
		triangles = []
		for i in 0 ..< triangles_n {
			a = u16_at(bytes, at)
			b = u16_at(bytes, at + 2)
			c = u16_at(bytes, at + 4)
			part = u16_at(bytes, at + 6)
			at = at + TREE_TRIANGLE_BYTES
			if a >= vertices_n or b >= vertices_n or c >= vertices_n {
				raise "meshlets: a triangle index is outside the vertices, not " + text(a)
			}
			if part > 1 { raise "meshlets: a triangle part is bark or leaf, not " + text(part) }
			indices.add([a, b, c, part])
			triangles.add([tree_point(vertices, a), tree_point(vertices, b), tree_point(vertices, c)])
		}
		levels.add(TreeLevel(MeshLevel(triangles, cluster_triangles(triangles), error), vertices, indices, -1, -1))
	}
	if at != count(bytes) { raise "meshlets: a tree mesh has leftover bytes" }
	TreeMesh(levels)
}

// a tree file that is not there names what makes it: the larger EZ Tree meshes are kept out of git
tree_mesh(path: any) as TreeMesh := {
	if not exists(path) { raise "meshlets: no tree mesh " + text(path) + ": " + TREE_MESH_SOURCE }
	tree_mesh_of(read_bytes(path))
}

// One vertex and triangle buffer for every mesh, in order. Each level's base is the first triangle there,
// and its vertex_at is added to the level's own indices.
pack_tree_meshes(meshes: list) as MeshPack := {
	if not (meshes is list) or count(meshes) == 0 { raise "meshlets: meshes must be a non-empty list, not " + text(meshes) }
	vertices = []
	texels = []
	triangles = []
	for mesh in meshes {
		if not (mesh is TreeMesh) { raise "meshlets: a mesh must be a TreeMesh, not " + text(mesh) }
		for level in mesh.levels {
			level.vertex_at = count(vertices)
			level.base = count(triangles)
			for vertex in level.vertices {
				vertices.add([vertex#1, vertex#2, vertex#3, vertex#4])
				texels.add([vertex#5])
			}
			for index in level.indices {
				triangles.add([level.vertex_at + index#1, level.vertex_at + index#2, level.vertex_at + index#3, index#4])
			}
		}
	}
	if count(vertices) == 0 { raise "meshlets: a packed mesh has no vertices" }
	MeshPack(vertices, texels, triangles)
}
