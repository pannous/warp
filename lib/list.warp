// The standard library module list (notes/stdlib.md): standard functions of every program, `unique(xs)` or `xs.unique()`, no `use` needed (`use list` only for the qualified `list.zip(a, b)`)

def unique(xs) := { out = []; for x in xs { if not (x in out) { out = out + [x] } }; out }
def zip(a, b) := [[a#i, b#i] for i in 1 to min(count(a), count(b))]
def enumerate(xs) := [[i, xs#i] for i in 1 to count(xs)]
def product(xs) := fold(xs, 1, *)
// loops, not slices: the type model's W0 (tests/types/test_type_model.rs) reads take and drop, and has no slices
def take(xs, n) := { out = []; for i in 1 to min(n, count(xs)) { out = out + [xs#i] }; out }
def drop(xs, n) := { out = []; for i in n + 1 to count(xs) { out = out + [xs#i] }; out }
def flatten(xs) := { out = []; for x in xs { out += x }; out }
def chunk(xs, n) := { out = []; part = []; for x in xs { part = part + [x]; if count(part) == n { out = out + [part]; part = [] } }; if count(part) > 0 { out = out + [part] }; out }
def window(xs, n) := [xs[i:i + n] for i in 0 to count(xs) - n]
def median(xs) := { s = sort(xs); n = count(s); if n % 2 == 1 then s#(n /! 2 + 1) else (s#(n /! 2) + s#(n /! 2 + 1)) / 2 }
def flat_map(xs, f) := { out = []; for x in xs { out += f(x) }; out }
// [kept, rest]: the elements f holds for, and the others
def partition(xs, f) := { kept = []; rest = []; for x in xs { if f(x) { kept = kept + [x] } else { rest = rest + [x] } }; [kept, rest] }
def max_by(xs, f) := { best = xs#1; for x in xs { if f(x) > f(best) { best = x } }; best }
def min_by(xs, f) := { best = xs#1; for x in xs { if f(x) < f(best) { best = x } }; best }
// {key: [elements]}: the elements by the text of f's value
def group_by(xs, f) := { out = {}; for x in xs { k = "" + f(x); if out.has(k) { out[k] = out.get(k) + [x] } else { out[k] = [x] } }; out }
// {element: how often}
def tally(xs) := { out = {}; for x in xs { k = "" + x; if out.has(k) { out[k] = out.get(k) + 1 } else { out[k] = 1 } }; out }
def zip_with(a, b, f) := [f(a#i, b#i) for i in 1 to min(count(a), count(b))]
def sum_by(xs, f) := sum([f(x) for x in xs])
def count_by(xs, f) := count([x for x in xs if f(x)])
// the elements moved n places to the left
def rotate(xs, n) := { k = n % count(xs); xs[k:] + xs[:k] }
def interleave(a, b) := { out = []; for i in 1 to max(count(a), count(b)) { if i <= count(a) { out = out + [a#i] }; if i <= count(b) { out = out + [b#i] } }; out }
// without runs of equal neighbours
def dedupe(xs) := { out = []; for x in xs { if count(out) == 0 or last(out) != x { out = out + [x] } }; out }
// the running results of f: scan([1, 2, 3], 0, (a, b) => a + b) is [1 3 6]
def scan(xs, start, f) := { out = []; acc = start; for x in xs { acc = f(acc, x); out = out + [acc] }; out }
def take_while(xs, f) := { out = []; for x in xs { if not f(x) { break }; out = out + [x] }; out }
def drop_while(xs, f) := { out = []; dropping = true; for x in xs { if not (dropping and f(x)) { dropping = false; out = out + [x] } }; out }
// the index (from 0, like xs[i]) of the greatest element, the first of equal ones
def argmax(xs) := { best = 1; for i in 1 to count(xs) { if xs#i > xs#best { best = i } }; best - 1 }
def argmin(xs) := { best = 1; for i in 1 to count(xs) { if xs#i < xs#best { best = i } }; best - 1 }
// the neighbours: pairwise([1, 2, 3]) is [[1 2] [2 3]]
def pairwise(xs) := [[xs#i, xs#(i + 1)] for i in 1 to count(xs) - 1]
// [the first n, the rest]
def split_at(xs, n) := [take(xs, n), drop(xs, n)]
// every pair of an element of a and one of b
def cartesian(a, b) := [[x, y] for x in a for y in b]
// the most frequent element, the first of equally frequent ones
def mode(xs) := { best = xs#1; most = 0; for x in xs { n = count_by(xs, y => y == x); if n > most { best = x; most = n } }; best }
// the population variance and standard deviation
def variance(xs) := { m = mean(xs); sum_by(xs, x => (x - m) * (x - m)) / count(xs) }
def stdev(xs) := sqrt(variance(xs))
// the position (from 1, like index_of) of the first element f holds for, 0 when none does
def index_where(xs, f) := { for i in 1 to count(xs) { if f(xs#i) { return i } }; 0 }
def last_n(xs, n) := drop(xs, max(count(xs) - n, 0))
// n copies of value: fill(3, 0) is [0 0 0]
def fill(n, value) := filled_list(n, value)
// [smallest, greatest]
def minmax(xs) := [min(xs), max(xs)]
// Python's list methods (card python-stdlib): extend appends each of ys in place, index is the position from 0
def extend(xs, ys) := { for y in ys { xs.append(y) }; xs }
// JavaScript's concat: a new list of xs then ys
def concat(xs, ys) := xs + ys
def index(xs, x) := { at = index_of(xs, x); if at == 0 { raise "ValueError: " + str(x) + " is not in the list" }; at - 1 }
// sets of list items (card parse-free): the words and their math glyphs; ⊂ and ⊃ are proper, ⊆ and ⊇ allow equal sets
def union(a, b) := unique(a + b)
def intersection(a, b) := [x for x in unique(a) if x in b]
def subset(a, b) := { for x in a { if not (x in b) { return false } }; true }
def superset(a, b) := subset(b, a)
infix operator ∪(a, b) := union(a, b)
infix operator ∩(a, b) := intersection(a, b)
infix operator ⊆(a, b) := subset(a, b)
infix operator ⊇(a, b) := subset(b, a)
infix operator ⊂(a, b) := subset(a, b) and not subset(b, a)
infix operator ⊃(a, b) := subset(b, a) and not subset(a, b)
// ∩ binds tighter than ∪ as * does than +; the subset tests compare what the set operators build: a ⊆ b ∪ c
operator ∩ has precedence above +
operator ⊆ has precedence below +
operator ⊇ has precedence below +
operator ⊂ has precedence below +
operator ⊃ has precedence below +
