// The standard library module regex (notes/stdlib.md section 7): `use regex`, through the adapter std_pure: Rust's
// regex natively, JS RegExp in the browser, held to what both do alike (no look-around, no backreferences)
// `"abc" matches "a.c"` where regex is used (the parser scans a used module's operators), and `matches(s, p)`
infix operator matches(subject: any, pattern: any) := std_pure("regex", "matches", [subject, pattern])
public first_match(subject: any, pattern: any): any := std_pure("regex", "first", [subject, pattern])
// the host answers a malformed pattern with an error value ("regex (a: Unmatched ( or \\("): raised here, before the
// declared list or text would refuse it as "not a list" (card regex-malformed-message)
def regex_raised(answer: any): any {
	if answer is error { raise answer }
	answer
}
find_all(subject: any, pattern: any): list := regex_raised(std_pure("regex", "all", [subject, pattern]))
replace_all(subject: any, pattern: any, replacement: any): text := regex_raised(std_pure("regex", "replace", [subject, pattern, replacement]))
// Capture groups (card lib-regex-groups-tempfiles), through the host's replace and its $1 … $9: every match replaced by
// its groups between marker characters, read back in order, so each match keeps its context (^, \b) exactly as find_all
// sees it. The native host is POSIX extended regex: at most 9 groups, no named groups (a group that took no part is "")
REGEX_OPEN = chr(2)
REGEX_BETWEEN = chr(1)
REGEX_CLOSE = chr(3)
// the capturing groups of a pattern: each ( not escaped, not inside [ ], not (?…
def regex_group_count(re: text): int {
	cs = [c for c in re]
	n = 0
	escaped = no
	in_class = no
	for i in 0 ..< count(cs) {
		c = cs[i]
		if escaped { escaped = no }
		else if c == "\\" { escaped = yes }
		else if in_class { if c == "]" { in_class = no } }
		else if c == "[" { in_class = yes }
		else if c == "(" and not (i + 1 < count(cs) and cs[i + 1] == "?") { n += 1 }
	}
	n
}
// `find_all_groups("a=1, b=22", "([a-z])=([0-9]+)")` is [["a", "1"], ["b", "22"]]: the groups of every match
def find_all_groups(t: text, re: text): list {
	n = regex_group_count(re)
	if n > 9 { raise "find_all_groups: " + str(n) + " groups in " + re + ", the host captures at most 9" }
	if REGEX_OPEN in t or REGEX_CLOSE in t { raise "find_all_groups: the text holds the marker characters chr(2) or chr(3)" }
	if n == 0 { return [[] for m in find_all(t, re)] }
	marked = replace_all(t, re, REGEX_OPEN + join(["$" + str(i) for i in 1 to n], REGEX_BETWEEN) + REGEX_CLOSE)
	pieces = marked.split(REGEX_OPEN)
	[pieces[k].split(REGEX_CLOSE)[0].split(REGEX_BETWEEN) for k in 1 ..< count(pieces)]
}
// `match_groups("v1.22", "v([0-9]+)\\.([0-9]+)")` is ["1", "22"]: the groups of the first match, ø when none matches
def match_groups(t: text, re: text): any {
	all = find_all_groups(t, re)
	if count(all) == 0 { return ø }
	all[0]
}
