// The standard library module time (notes/stdlib.md): `use time`, the calendar over clock() (milliseconds since 1970, UTC)

// `now`: the Instant the run reads the wall clock, a library function like any other (bare `now` calls it), in the
// run's time zone (decision local-now): now.hour is the local hour, its text has the zone's offset; an Instant a
// program builds is UTC
now(): Instant := Instant(wall_clock_ms(), local_zone_name())
// the run's time zone: the environment's TZ, natively the system's zone where TZ names none (core/native/driver.warp),
// in the page the browser's (web/playground/wasi.js); UTC, warned, for a zone not in time_zones
local_zone_name(): text := {
	for entry in wasi_environment().split(chr(0)) { if entry.starts_with(TZ_ENTRY) { return known_zone(entry[#TZ_ENTRY ..]) } }
	UTC_ZONE
}
TZ_ENTRY = "TZ="
UTC_ZONE = "UTC"
known_zone(name: text): text := {
	if time_zones.any(zone => zone.name == name) { return name }
	warning("the time zone " + name + " is not in lib/time.warp time_zones: now is UTC")
	UTC_ZONE
}
// the one hook into the host: WASI's clock_time_get (core/analysis/host_words.warp) of the wall clock
// (CLOCK_REALTIME, 0), a millisecond's precision asked for. It writes the u64 nanoseconds since 1970 into linear
// memory's first 8 bytes (the scratch fd_write takes only within its call), read back little-endian
wall_clock_ms(): int := {
	nanos_per_milli = 1000000
	clock_time_get(0, nanos_per_milli, 0)
	nanos = 0
	for i in 0..<8 { nanos = nanos * 256 + memory_byte(7 - i) }
	nanos /! nanos_per_milli
}

// a span of time in milliseconds, which moves an Instant: a plain number is one (`Instant(0) + 2`), lib/units converts
// its quantities of time (`Instant(0) + 2 seconds`), one of another dimension a DimensionError (card instant-typed-duration)
// It shows in seconds as the shell's time does, `6s`, `0.207s`. Its operators take a Duration or a number, so one
// meeting lib/units' quantity of time converts it (decision as-promotes, one-duration): `time 6 == 6s`, `d + 1s` is 7s
class Duration {
	ms: number
	text() := units_text(int(round(ms)))
	format as text := units_text(int(round(ms)))
	equal(other: Duration) := ms == other.ms
	compare(other: Duration or number) := ms - duration_ms(other)
	+(other: Duration or number) := Duration(ms + duration_ms(other))
	-(other: Duration or number) := Duration(ms - duration_ms(other))
}
duration_ms(other: Duration or number) := if other is Duration then other.ms else other
n: number as Duration := Duration(n)
seconds_text(ms: int): text := (if ms < 0 then "-" else "") + abs(ms) /! 1000 + millis_fraction(abs(ms) % 1000) + "s"

// decision time-command: `time 6` is six seconds, `time { … }` runs the block, prints how long it took as the shell's
// time does and gives the block's value
time(n: number) := Duration(n * 1000)
time(b: block) := {
	start = now()
	value = b()
	print("time: " + Duration(now() - start))
	value
}
// `x is time` (kind "time") of an instant, a duration or a time the core holds (now.date, now.time), `x is duration`,
// `x is instant`, `x is date` of a time of that form, a Duration or Instant too (decision time-word): the emitter asks
// it (core/emitter/runtime_words.warp time_test_code), its own `x is time` the core's; lib/units asks it beside its
// quantities of time
time_valued(x, kind: text): bool := {
	if x is Duration { return kind == "time" or kind == "duration" }
	if x is Instant { return kind == "time" or kind == "instant" }
	x is time and (kind == "time" or time_form_names#(x.form + 1) == kind)
}
// the core time's forms, in the order of its form field (lib/time.warp TimeForm)
time_form_names = ["instant", "date", "local", "duration", "zoned", "clock"]

// a point in time: milliseconds since 1970-01-01T00:00:00Z. Everything on it is plain warp: ordering through
// compare (<, <=, >, >=), equality structural, the difference of two instants in milliseconds, a duration in
// milliseconds added or taken away, and its text in RFC 3339 (print, `"at " + now`)
class Instant {
	ms: int
	zone: text = "UTC"
	// another Instant: the earlier first. A duration (`now > 9.hours`, `now > 17h`) compares the matching part
	// (decision time-word, Interviewer REVISION 2026-11-05): under a day the time of day, else the day of the month
	compare(other: Instant or number or Duration) := if other is Instant then ms - other.ms else if other is number then bare_number_refused(other) else instant_part_compare(wall(), other)
	// seconds east of UTC its zone has then
	offset(): int := zone_offset(zone_named(zone), ms /! 1000)
	// its milliseconds on its zone's wall clock, which its calendar fields read: now.year, now.month, now.day,
	// now.hour, now.minute, now.second
	wall(): int := ms + offset() * 1000
	year() := date_of(wall()).year
	month() := date_of(wall()).month
	day() := date_of(wall()).day
	// the day of the week on its wall clock: now.weekday is Monday … Sunday
	weekday() := Weekday(weekday_of_day(day_number(wall())))
	hour(): int := wall() % 86400000 /! 3600000
	minute(): int := wall() % 3600000 /! 60000
	second(): int := wall() % 60000 /! 1000
	// its time of day and its day on its wall clock, times themselves (decision time-word): now.time, now.date
	time() := time_of(clock_form, wall() % 86400000 /! 1000 * nanos_per_second)
	date() := time_of(date_form, day_number(wall()))
	minus(other: Instant or Duration) := if other is Instant then ms - other.ms else Instant(ms - other.ms, zone)
	plus(duration: Duration) := Instant(ms + duration.ms, zone)
	// the same instant on the UTC wall clock: now.UTC, also now.utc
	UTC() := Instant(ms)
	utc() := Instant(ms)
	// the same instant on that zone's wall clock: zoned(now, "Asia/Kolkata"), now.zoned("Asia/Kolkata")
	zoned(zone_name: text) := Instant(ms, zone_name)
	// RFC 3339, the milliseconds without trailing zeros: 2026-10-25T11:43:40.692Z, 2026-10-25T11:43:40.5Z; in another
	// zone its wall clock and offset, 2026-10-25T12:43:40.692+01:00 (the zone's name is .zone)
	text() := date_text(wall()) + "T" + time_text(wall()) + millis_fraction(ms % 1000) + (if zone == UTC_ZONE then "Z" else offset_written(offset()))
}
// +01:00, -04:00, +05:30: seconds east of UTC as RFC 3339 writes them
offset_written(seconds: int): text := (if seconds < 0 then "-" else "+") + two_digits(abs(seconds) /! 3600) + ":" + two_digits(abs(seconds) % 3600 /! 60)

// a bare number beside an Instant names no unit (decision instant-bare-number): `t > 5` is refused
bare_number_refused(n: number) := raise "" + n + " what? write t > " + n + " h, or " + n + " AM"
// a duration (`now > 9.hours`, `now > 17h`) compared with the matching part, with a warning: a bare duration is
// mostly a clock time meant
instant_part_compare(ms: int, other: Duration) := {
	d = int(other.ms)
	if d < 86400000 { warning("comparing an Instant with the duration " + units_text(d) + " compares the time of day: did you mean " + clock_words(d) + "?") }
	else { warning("comparing an Instant with the duration " + units_text(d) + " compares the day of the month") }
	instant_part(ms, d) - d
}
// the matching part of an Instant's milliseconds for a duration of d ms: the time of day under a day, else the day of
// the month counted from 1 (`now >= 15 days`: the 15th or later)
instant_part(ms, d) := if d < 86400000 then ms % 86400000 else date_of(ms).day * 86400000
// "9 AM", "5 PM", "12 AM", "9:30 AM": the clock time a duration since midnight names
clock_words(d): text := {
	minutes = d % 86400000 /! 60000
	h = minutes /! 60
	m = minutes % 60
	shown = if h % 12 == 0 then 12 else h % 12
	"" + shown + (if m == 0 then "" else ":" + two_digits(m)) + (if h < 12 then " AM" else " PM")
}
// ".692", ".69", ".5", or nothing on a whole second
millis_fraction(millis): text := {
	if millis == 0 then return ""
	if millis % 100 == 0 then return "." + millis /! 100
	if millis % 10 == 0 then return "." + two_digits(millis /! 10)
	"." + two_digits(millis /! 10) + millis % 10
}

day_number(ms: int): int := ms /! 86400000
// the date of milliseconds as {year, month, day} (lib/prelude.warp civil_from_days)
public date_of(ms: int) := civil_from_days(day_number(ms))
// ISO weekday: Monday 1 … Sunday 7
weekday(ms: int): int := (day_number(ms) + 3) % 7 + 1
// the days of the week in ISO order, Monday 1 … Sunday 7: `match today.weekday { Saturday | Sunday => "weekend" }`
enum Weekday { Monday = 1, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }
// today's date on the run's wall clock as {year, month, day, weekday}
public today() := {
	wall = now().wall()
	date = date_of(wall)
	{year: date.year, month: date.month, day: date.day, weekday: Weekday(weekday(wall))}
}
public add_days(ms, n) := ms + n * 86400000
days_between(from, to): int := day_number(to) - day_number(from)
two_digits(n): text := if n < 0 then "-" + two_digits(0 - n) else if n < 10 then "0" + n else "" + n
// ISO 8601: 2026-10-07, what now.date shows
date_text(ms): text := {
	d = date_of(ms)
	// the year in 4 digits (0001), as RFC 3339 writes it
	padded(d.year, 4) + "-" + two_digits(d.month) + "-" + two_digits(d.day)
}
// the time of day, UTC: 13:05:09, what now.time shows
time_text(ms): text := {
	s = (ms % 86400000) /! 1000
	two_digits(s /! 3600) + ":" + two_digits(s % 3600 /! 60) + ":" + two_digits(s % 60)
}
// the day number of a proleptic Gregorian date (lib/prelude.warp days_from_civil)
days_from_date(year, month, day): int := days_from_civil(year, month, day)
// "2026-10-07" → milliseconds since 1970 at midnight UTC
// strict (card lib-audit-bugfixes-2): YYYY-MM-DD of digits (a 4-digit year; 1970-1-1 too), the month 1-12 and the day within it, else a raise
// naming the text, no silent roll-over into the next month or year. An RFC 3339 date-time is read too (card
// lib-json-time-conformance), its instant in milliseconds: "2026-11-04T14:05:09.5+01:00"; T, t or a space between
// date and time; Z, z or ±hh:mm (-00:00 the same instant as Z); a fraction of any length, cut to milliseconds; hours
// 0-23, minutes and seconds 0-59 (24:00 and the leap second 23:59:60 are refused: no leap seconds are kept); no
// week (2026-W45-3) or ordinal (2026-309) dates
t: text as Instant := Instant(date_ms(t))
date_ms(t): int := {
	if #t > 10 { return date_time_ms(t) }
	parts = split(t, "-")
	if count(parts) != 3 or not parts.all(p => is_digits(p)) or #(parts#1) != 4 or #(parts#2) > 2 or #(parts#3) > 2 { raise "\"" + t + "\" as Instant: no YYYY-MM-DD date" }
	year = int(parts#1)
	month = int(parts#2)
	day = int(parts#3)
	if month < 1 or month > 12 { raise "\"" + t + "\" as Instant: no month " + text(month) }
	if day < 1 or day > days_in_month(year, month) { raise "\"" + t + "\" as Instant: no day " + text(day) + " in that month" }
	days_from_date(year, month, day) * 86400000
}
// an RFC 3339 date-time's milliseconds since 1970 (date_ms)
date_time_ms(t: text): int := {
	no_time = "\"" + t + "\" as Instant: no YYYY-MM-DD date"
	sep = t[10: 11]
	if not (sep == "T" or sep == "t" or sep == " ") { raise no_time }
	day = date_ms(t[0: 10])
	rest = t[11: #t]
	if #rest < 9 or rest[2: 3] != ":" or rest[5: 6] != ":" or not is_digits(rest[0: 2] + rest[3: 5] + rest[6: 8]) { raise no_time }
	hour = int(rest[0: 2])
	minute = int(rest[3: 5])
	second = int(rest[6: 8])
	if hour > 23 or minute > 59 or second > 59 { raise "\"" + t + "\" as Instant: no time of day (hours 0-23, minutes and seconds 0-59, no leap seconds)" }
	at = 8
	millis = 0
	if rest[at: at + 1] == "." {
		start = at + 1
		at = start
		while at < #rest and is_digits(rest[at: at + 1]) { at += 1 }
		if at == start { raise no_time }
		millis = int((rest[start: at] + "00")[0: 3])
	}
	zone = rest[at: #rest]
	offset = 0
	if zone != "Z" and zone != "z" {
		if #zone != 6 or not (zone[0: 1] == "+" or zone[0: 1] == "-") or zone[3: 4] != ":" or not is_digits(zone[1: 3] + zone[4: 6]) { raise no_time }
		if int(zone[1: 3]) > 23 or int(zone[4: 6]) > 59 { raise "\"" + t + "\" as Instant: no offset " + zone }
		offset = (int(zone[1: 3]) * 60 + int(zone[4: 6])) * 60000
		if zone[0: 1] == "-" { offset = 0 - offset }
	}
	day + ((hour * 60 + minute) * 60 + second) * 1000 + millis - offset
}
// milliseconds as the largest units, the seconds as the shell's time writes them: 5430000 → "1h 30m 30s", 207 →
// "0.207s", 61500 → "1m 1.5s"; what `d as text` gives
units_text(ms: int): text := {
	if ms < 0 then return "-" + units_text(0 - ms)
	if ms < 60000 then return seconds_text(ms)
	parts = []
	if ms >= 86400000 { parts += [text(ms /! 86400000) + "d"] }
	if ms % 86400000 >= 3600000 { parts += [text(ms % 86400000 /! 3600000) + "h"] }
	if ms % 3600000 >= 60000 { parts += [text(ms % 3600000 /! 60000) + "m"] }
	if ms % 60000 > 0 { parts += [seconds_text(ms % 60000)] }
	join(parts, " ")
}
is_leap_year(year): bool := year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
days_in_month(year, month): int := {
	if not (month is int) or month < 1 or month > 12 { raise "days_in_month: the month " + text(month) + " is not 1 to 12" }
	if month == 2 then (if is_leap_year(year) then 29 else 28) else if month == 4 or month == 6 or month == 9 or month == 11 then 30 else 31
}

// Time zones (card time-zones-warp; Rust twin: rust-harness:src/time/calendar.rs Zone, rust-harness:src/wasm_emitter/time/time_zones.rs): the
// offset a zone has at an instant under the Europe and United States daylight saving rules, and the instant a wall
// time means there. Times here are whole seconds since 1970; offsets are seconds east of UTC.
hour_seconds = 3600
day_seconds = 86400

// the daylight saving rule of a zone
enum Dst {
	Never
	// last Sunday of March to last Sunday of October, switching at 01:00 UTC (since 1996)
	Europe
	// second Sunday of March to first Sunday of November, switching at 02:00 local time (since 2007)
	UnitedStates
}
// which instant a wall time means when a transition skips or repeats it
enum Disambiguation { Reject, Earlier, Later }

class Zone { name: text; standard: int; dst: Dst }

// the embedded subset of the IANA database, in the order of calendar.rs ZONES (the run-time zone codes)
time_zones = [
	Zone("UTC", 0, Dst.Never),
	Zone("Etc/UTC", 0, Dst.Never),
	Zone("Europe/London", 0, Dst.Europe),
	Zone("Europe/Dublin", 0, Dst.Europe),
	Zone("Europe/Lisbon", 0, Dst.Europe),
	Zone("Europe/Berlin", 3600, Dst.Europe),
	Zone("Europe/Paris", 3600, Dst.Europe),
	Zone("Europe/Madrid", 3600, Dst.Europe),
	Zone("Europe/Rome", 3600, Dst.Europe),
	Zone("Europe/Amsterdam", 3600, Dst.Europe),
	Zone("Europe/Brussels", 3600, Dst.Europe),
	Zone("Europe/Vienna", 3600, Dst.Europe),
	Zone("Europe/Zurich", 3600, Dst.Europe),
	Zone("Europe/Stockholm", 3600, Dst.Europe),
	Zone("Europe/Oslo", 3600, Dst.Europe),
	Zone("Europe/Copenhagen", 3600, Dst.Europe),
	Zone("Europe/Warsaw", 3600, Dst.Europe),
	Zone("Europe/Prague", 3600, Dst.Europe),
	Zone("Europe/Budapest", 3600, Dst.Europe),
	Zone("Europe/Athens", 7200, Dst.Europe),
	Zone("Europe/Helsinki", 7200, Dst.Europe),
	Zone("Europe/Kyiv", 7200, Dst.Europe),
	Zone("Europe/Bucharest", 7200, Dst.Europe),
	Zone("Europe/Istanbul", 10800, Dst.Never),
	Zone("Europe/Moscow", 10800, Dst.Never),
	Zone("Asia/Dubai", 14400, Dst.Never),
	Zone("Asia/Kolkata", 19800, Dst.Never),
	Zone("Asia/Shanghai", 28800, Dst.Never),
	Zone("Asia/Singapore", 28800, Dst.Never),
	Zone("Asia/Tokyo", 32400, Dst.Never),
	Zone("Australia/Brisbane", 36000, Dst.Never),
	Zone("America/Sao_Paulo", -10800, Dst.Never),
	Zone("America/New_York", -18000, Dst.UnitedStates),
	Zone("America/Chicago", -21600, Dst.UnitedStates),
	Zone("America/Denver", -25200, Dst.UnitedStates),
	Zone("America/Phoenix", -25200, Dst.Never),
	Zone("America/Los_Angeles", -28800, Dst.UnitedStates),
	Zone("America/Anchorage", -32400, Dst.UnitedStates),
	Zone("Pacific/Honolulu", -36000, Dst.Never)
]

zone_named(name: text): Zone := time_zones#(zone_index(name) + 1)
// a zone's place in time_zones from 0, as a zoned time's info holds it
zone_index(name: text): int := {
	for at in 0 ..< #time_zones { if time_zones#(at + 1).name == name { return at } }
	raise "unknown time zone " + name + ": not in the time zone rules (lib/time.warp time_zones)"
}
// ISO weekday of a day number: Monday 1 … Sunday 7
weekday_of_day(days: int): int := (days + 3) % 7 + 1
// the day number of the last Sunday of a month
last_sunday(year: int, month: int): int := {
	last = days_from_date(year, month, days_in_month(year, month))
	last - weekday_of_day(last) % 7
}
// the day number of the n-th Sunday of a month, counting from 1
nth_sunday(year: int, month: int, n: int): int := {
	first = days_from_date(year, month, 1)
	first + (7 - weekday_of_day(first)) % 7 + 7 * (n - 1)
}
// the year (UTC) of seconds since 1970
year_of_seconds(seconds: int): int := date_of(seconds * 1000).year
// European summer time: from 01:00 UTC on the last Sunday of March to 01:00 UTC on the last Sunday of October
european_summer(year: int, seconds: int): bool := {
	start = last_sunday(year, 3) * day_seconds + hour_seconds
	end = last_sunday(year, 10) * day_seconds + hour_seconds
	seconds >= start and seconds < end
}
// US daylight time: from 02:00 local standard time on the second Sunday of March to 02:00 local daylight time on the
// first Sunday of November
united_states_summer(year: int, seconds: int, standard: int): bool := {
	start = nth_sunday(year, 3, 2) * day_seconds + 2 * hour_seconds - standard
	end = nth_sunday(year, 11, 1) * day_seconds + 2 * hour_seconds - standard - hour_seconds
	seconds >= start and seconds < end
}
// seconds east of UTC in effect in a zone at seconds since 1970
zone_offset(zone: Zone, seconds: int): int := {
	year = year_of_seconds(seconds)
	summer = match zone.dst {
		Never: false
		Europe: european_summer(year, seconds)
		UnitedStates: united_states_summer(year, seconds, zone.standard)
	}
	if summer then zone.standard + hour_seconds else zone.standard
}
// the instant (seconds since 1970) a wall time (seconds since 1970 on the zone's wall clock) means in a zone: of the
// summer and the winter offset, those that hold at the instant they give; one is the answer, none (skipped by a
// transition) or both (repeated) need the choice, else it fails as calendar.rs Zone::resolve does
zone_instant(zone: Zone, wall: int, choice: Disambiguation): int := {
	later = wall - zone.standard
	if zone.dst == Dst.Never { return later }
	earlier = later - hour_seconds
	earlier_holds = zone_offset(zone, earlier) == zone.standard + hour_seconds
	later_holds = zone_offset(zone, later) == zone.standard
	if earlier_holds != later_holds { return if earlier_holds then earlier else later }
	match choice {
		Earlier: earlier
		Later: later
		Reject: {
			if earlier_holds { raise "that wall time is ambiguous in " + zone.name + ": it occurs twice, the clocks are set back by a daylight saving transition; choose disambiguation: earlier or later" }
			raise "that wall time does not exist in " + zone.name + ": it is skipped by a daylight saving transition; choose disambiguation: earlier or later"
		}
	}
}

// Zoned times (wiki/time.md "Time zones"): zoned(t, "Asia/Kolkata"), also t.zoned("Asia/Kolkata") (decision zone-word),
// the one conversion to a zone: a time node of the form Zoned, its position the instant in
// nanoseconds, its info the zone's index and offset in minutes above the form (extensions/time_values.warp), its zone's
// name beside them
nanos_per_second = 1000000000
date_form = 1
local_form = 2
zoned_form = 4
clock_form = 5
zone_index_unit = 8
offset_minute_unit = 2048
// an instant or a zoned time keeps its instant; a local time's wall clock resolves in the zone, a skipped or repeated
// one by the disambiguation (`zoned(2024-03-31T02:30, "Europe/Berlin", disambiguation: later)`); an Instant, `now`,
// takes its own zoned(zone_name) (card zoned-clock-utc; t: time or Instant here read t.form as an Instant's field)
zoned(t: time, zone_name: text, disambiguation: Disambiguation = Disambiguation.Reject) := {
	at = zone_index(zone_name)
	seconds = if t.form == local_form then zone_instant(time_zones#(at + 1), t.epoch_seconds, disambiguation) else t.epoch_seconds
	zoned_at(at, seconds * nanos_per_second)
}
// the zoned time of the zone at that index at an instant (nanoseconds since 1970), its offset the one in effect then
zoned_at(at: int, nanos: int) := {
	zone = time_zones#(at + 1)
	offset = zone_offset(zone, nanos /! nanos_per_second)
	time_of(zoned_form + at * zone_index_unit + offset /! 60 * offset_minute_unit, nanos, zone.name)
}
// the instant a wall time (seconds since 1970 on the zone's clock) means as a calendar shift lands on it: a repeated
// one the earlier, a skipped one moved past the gap (RFC 5545, Temporal's "compatible")
compatible_instant(zone: Zone, wall: int): int := {
	earlier = zone_instant(zone, wall, Disambiguation.Earlier)
	if earlier + zone_offset(zone, earlier) == wall then earlier else zone_instant(zone, wall, Disambiguation.Later)
}

// Date patterns (card lib-date-patterns): format(time, Pattern("yyyy-MM-dd HH:mm")) and parse(text, Pattern(…)), UTC.
// A run of one letter is a field: yyyy year, yy its last two digits, MMMM month name, MMM its first three letters,
// MM month 01-12, M 1-12, dd day 01-31, d 1-31, EEEE weekday name, EEE its first three letters, HH hour 00-23, H 0-23,
// mm minute, ss second, SSS millisecond; any other character, and text in 'single quotes', is itself
MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
WEEKDAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
PATTERN_LETTERS = "yMdEHmsS"
// the pattern as its parts: a field as [letter, run length], literal text as a text
pattern_parts(pattern: text): list := {
	parts = []
	i = 1
	while i <= #pattern {
		c = pattern#i
		if c == '\'' {
			close = i + 1
			while close <= #pattern and pattern#close != '\'' { close += 1 }
			parts += [if close == i + 1 then "'" else pattern[i: close - 1]]
			i = close + 1
		} else if PATTERN_LETTERS.contains(text(c)) {
			run = 1
			while i + run <= #pattern and pattern#(i + run) == c { run += 1 }
			parts += [[text(c), run]]
			i += run
		} else {
			parts += [text(c)]
			i += 1
		}
	}
	parts
}
padded(n: int, width: int): text := { t = text(abs(n)); sign = if n < 0 then "-" else ""; while #t + #sign < width { t = "0" + t }; sign + t }
// the time written in the pattern: format(Instant(0), Pattern("d MMM yyyy")) is "1 Jan 1970"
format(time: Instant, pattern: Pattern): text := pattern_text(time.ms, pattern.written)
pattern_text(ms: int, pattern: text): text := {
	d = date_of(ms)
	s = (ms % 86400000) /! 1000
	fields = {"y": d.year, "M": d.month, "d": d.day, "H": s /! 3600, "m": s % 3600 /! 60, "s": s % 60, "S": ms % 1000}
	pattern_parts(pattern).map(part => if part is list then field_text(part#1, part#2, fields, ms) else text(part)).join("")
}
field_text(letter: text, run: int, fields: map, ms: int): text := {
	if letter == "E" { name = WEEKDAY_NAMES#(weekday(ms) as int); return if run >= 4 then name else name[0: 3] }
	if letter == "M" and run >= 3 { name = MONTH_NAMES#(fields["M"] as int); return if run >= 4 then name else name[0: 3] }
	if letter == "y" and run == 2 { return padded(fields["y"] % 100, 2) }
	padded(fields[letter], run)
}
// the milliseconds since 1970 a text written in the pattern names (UTC; missing fields 1970-01-01 00:00:00.000); a text
// that does not follow the pattern raises, naming where: parse("2026-11-04 14:05", Pattern("yyyy-MM-dd HH:mm"))
parse(t: text, pattern: Pattern): Instant := Instant(pattern_ms(t, pattern.written))
pattern_ms(t: text, pattern: text): int := {
	values = {"y": 1970, "M": 1, "d": 1, "H": 0, "m": 0, "s": 0, "S": 0}
	at = 0
	for part in pattern_parts(pattern) {
		if not (part is list) {
			part = text(part)
			if t[at: at + #part] != part { pattern_mismatch(t, pattern, at, "'" + part + "'") }
			at += #part
		} else if part#1 == "M" and part#2 >= 3 {
			found = (1 to 12).filter(i => lower(t[at: at + #pattern_month(i, part#2)]) == lower(pattern_month(i, part#2)))
			if #found == 0 { pattern_mismatch(t, pattern, at, "a month name") }
			values["M"] = found#1
			at += #pattern_month(found#1, part#2)
		} else if part#1 == "E" {
			found = (1 to 7).filter(i => lower(t[at: at + #pattern_weekday(i, part#2)]) == lower(pattern_weekday(i, part#2)))
			if #found == 0 { pattern_mismatch(t, pattern, at, "a weekday name") }
			at += #pattern_weekday(found#1, part#2)
		} else {
			// a field of 1 letter takes as many digits as follow, else exactly its run
			width = if part#2 == 1 then digits_at(t, at) else part#2
			if width == 0 or digits_at(t, at) < width { pattern_mismatch(t, pattern, at, text(part#2) + " digits") }
			n = int(t[at: at + width])
			values[part#1] = if part#1 == "y" and part#2 == 2 then 2000 + n else n
			at += width
		}
	}
	if at != #t { pattern_mismatch(t, pattern, at, "the end") }
	if values["M"] < 1 or values["M"] > 12 or values["d"] < 1 or values["d"] > days_in_month(values["y"], values["M"]) { raise "parse: " + t + " names no date" }
	if values["H"] > 23 or values["m"] > 59 or values["s"] > 59 or values["S"] > 999 { raise "parse: " + t + " names no time of day (hours 0-23, minutes and seconds 0-59, milliseconds 0-999)" }
	days_from_date(values["y"], values["M"], values["d"]) * 86400000 + ((values["H"] * 60 + values["m"]) * 60 + values["s"]) * 1000 + values["S"]
}
pattern_month(i: int, run: int): text := if run >= 4 then MONTH_NAMES#i else MONTH_NAMES#i[0: 3]
pattern_weekday(i: int, run: int): text := if run >= 4 then WEEKDAY_NAMES#i else WEEKDAY_NAMES#i[0: 3]
// how many digits follow at the 0-based position
digits_at(t: text, at: int): int := { n = 0; while at + n < #t and is_digit(t#(at + n + 1)) { n += 1 }; n }
pattern_mismatch(t: text, pattern: text, at: int, expected: text) := raise "parse: \"" + t + "\" does not match \"" + pattern + "\": " + expected + " expected at character " + text(at + 1)

// Durations as text (card lib-durations): "1h30m" as Duration, "PT1H30M" as Duration; format(d, long: yes), format(d, iso: yes)
t: text as Duration := Duration(written_duration_ms(t))
// the ISO 8601 form when it starts with P, else the short one
written_duration_ms(t: text): int := if #t > 0 and t#1 == 'P' then iso_duration_ms(t) else short_duration_ms(t)
// a duration styled: format(d, long: yes) "1 hour 30 minutes", format(d, iso: yes) "PT1H30M"; its plain text is d as text
format(d: Duration, long = no, iso = no): text := {
	ms = int(round(d.ms))
	if long { return long_duration_text(ms) }
	if iso { return iso_duration_text(ms) }
	raise "format(" + units_text(ms) + ") names no style: write d as text, or format(d, long: yes), format(d, iso: yes)"
}
DURATION_UNITS = {"d": 86400000, "h": 3600000, "m": 60000, "s": 1000, "ms": 1}
// "1h30m", "2d 4h", "45s", "500ms" → milliseconds: whole numbers each with its unit (d h m s ms), blanks between
// them allowed; anything else raises naming what is wrong
short_duration_ms(t: text): int := {
	total = 0
	at = 1
	units = 0
	while at <= #t {
		if t#at == ' ' { at += 1; continue }
		start = at
		while at <= #t and is_digit(t#at) { at += 1 }
		if at == start { raise "\"" + t + "\" as Duration: a number expected at character " + text(at) + " (like 1h30m, 2d 4h, 500ms)" }
		n = int(t[start - 1: at - 1])
		unit_start = at
		while at <= #t and is_letter(t#at) { at += 1 }
		unit = t[unit_start - 1: at - 1]
		if unit == "" {
			// a word after blanks is the unit the writer meant: name it rather than calling the unit missing
			w = at
			while w <= #t and t#w == ' ' { w += 1 }
			word_end = w
			while word_end <= #t and is_letter(t#word_end) { word_end += 1 }
			unit = t[w - 1: word_end - 1]
			if unit == "" { duration_refused(t, "a unit is missing after " + text(n) + " (d, h, m, s or ms)") }
			if DURATION_UNITS.has(unit) { duration_refused(t, "the unit " + unit + " must follow " + text(n) + " without a blank (like 5" + unit + ")") }
		}
		if not DURATION_UNITS.has(unit) { duration_refused(t, "unknown unit \"" + unit + "\" after " + text(n) + " (d, h, m, s or ms)") }
		total += n * DURATION_UNITS[unit]
		units += 1
	}
	if units == 0 { raise "\"" + t + "\" as Duration: names no duration (like 1h30m, 2d 4h, 500ms)" }
	total
}
duration_refused(t: text, why: text) := raise "\"" + t + "\" as Duration: " + why
// the long form: 5400000 → "1 hour 30 minutes", 0 → "0 seconds", 1500 → "1 second 500 milliseconds"
long_duration_text(ms: int): text := {
	if ms == 0 { return "0 seconds" }
	sizes = [[86400000, "day"], [3600000, "hour"], [60000, "minute"], [1000, "second"], [1, "millisecond"]]
	rest = abs(ms)
	parts = []
	for size in sizes { n = rest /! size#1; if n > 0 { parts += [counted(n, size#2)] }; rest = rest % size#1 }
	(if ms < 0 then "-" else "") + parts.join(" ")
}
counted(n: int, word: text): text := text(n) + " " + word + (if n == 1 then "" else "s")
// ISO 8601 durations of days and times → milliseconds: "PT1H30M", "P2DT4H", "P1W", "PT0.5S"; years and months have no
// fixed length, so P1Y and P1M raise, as does any other text
iso_duration_ms(t: text): int := {
	if #t < 2 { raise "\"" + t + "\" as Duration: incomplete (like PT1H30M)" }
	if t#1 != 'P' { raise "\"" + t + "\" as Duration: no P at the start (like PT1H30M)" }
	total = 0
	in_time = no
	at = 2
	fields = 0
	while at <= #t {
		if t#at == 'T' { if in_time { iso_refused(t, "a second T") }; in_time = yes; at += 1; continue }
		start = at
		while at <= #t and (is_digit(t#at) or t#at == '.') { at += 1 }
		if at == start { iso_refused(t, "a number and its designator expected at character " + text(start)) }
		if at > #t { iso_refused(t, "a designator is missing after " + t[start - 1: at - 1]) }
		n = float(t[start - 1: at - 1])
		d = t#at
		at += 1
		fields += 1
		if not in_time and (d == 'Y' or d == 'M') { iso_refused(t, "years and months have no fixed length in milliseconds") }
		size = if not in_time and d == 'W' then 604800000 else if not in_time and d == 'D' then 86400000 else if in_time and d == 'H' then 3600000 else if in_time and d == 'M' then 60000 else if in_time and d == 'S' then 1000 else 0
		if size == 0 { iso_refused(t, "no designator " + text(d) + (if in_time then " after T" else " before T")) }
		total += round(n * size) as int
	}
	if fields == 0 { iso_refused(t, "it names no amount") }
	total
}
iso_refused(t: text, why: text) := raise "\"" + t + "\" as Duration: " + why
// milliseconds as ISO 8601: 5400000 → "PT1H30M", 187200000 → "P2DT4H", 500 → "PT0.5S", 0 → "PT0S"
iso_duration_text(ms: int): text := {
	if ms == 0 { return "PT0S" }
	rest = abs(ms)
	days = rest /! 86400000; rest = rest % 86400000
	hours = rest /! 3600000; rest = rest % 3600000
	minutes = rest /! 60000; rest = rest % 60000
	seconds = if rest == 0 then "" else if rest % 1000 == 0 then text(rest /! 1000) + "S" else text(rest /! 1000) + millis_fraction(rest % 1000) + "S"
	time = (if hours > 0 then text(hours) + "H" else "") + (if minutes > 0 then text(minutes) + "M" else "") + seconds
	(if ms < 0 then "-" else "") + "P" + (if days > 0 then text(days) + "D" else "") + (if time == "" then "" else "T" + time)
}
// t seen from now (each an Instant or milliseconds since 1970): "3 minutes ago", "in 2 days", "just now" within 5
// seconds; the largest whole unit of seconds, minutes, hours, days, weeks, months (30 days) and years (365 days)
relative_time(t: any, now: any): text := {
	diff = (if t is Instant then t.ms else t) - (if now is Instant then now.ms else now)
	size = abs(diff)
	if size < 5000 { return "just now" }
	sizes = [[31536000000, "year"], [2592000000, "month"], [604800000, "week"], [86400000, "day"], [3600000, "hour"], [60000, "minute"], [1000, "second"]]
	unit = sizes.filter(s => size >= s#1)#1
	amount = counted(size /! unit#1, unit#2)
	if diff < 0 then amount + " ago" else "in " + amount
}

# Arithmetic on times and durations at run time (card day-hour; Rust twin:
# rust-harness:src/wasm_emitter/time/time_arithmetic.rs, wiki/time.md): `d + 1 day`, `a - b`,
# `1 month + 2 days`, `3 * 1 day`, as calendar.rs `Time.add`, `since`, `Duration.plus` and `times` do for constants.
# The emitter hands `+`, `-` and `*` of a run-time time to time_operation, a time as its form, position, months and
# days (emitter/times.warp time_operation); a program writing a time literal brings this module
# (passes/prelude_words.warp). The calendar is plain integers here: a time is its form and position, a duration its
# month, day and nanosecond counts. Its names stay clear of the runtime's times.warp and durations.warp words and
# of the unit words (days, months, hours …), which the lowering reads as durations.
# A zoned time moves on its zone's wall clock by a calendar part, on its instant by an exact one (RFC 5545).

nanos_per_day = 86400000000000
nanos_per_hour = 3600000000000
months_per_year = 12
shortest_month = 28
longest_month = 31

no_time_of_day = "a date has no time of day: add that duration to a local time"
no_calendar = "an instant has no calendar: place it in a zone before adding months or days"
clock_without_calendar = "a time of day has no calendar: add months or days to a local time"
no_such_day = "the day does not exist in that month: use add(…, overflow: clamp) for the last day of the month"
mismatched = "cannot subtract a date, a local time, an instant and a zoned time from each other: no implicit conversion between kinds of time"
not_arithmetic = "a time takes + or - a duration, a duration takes + or - a duration and * a whole number: nothing else is arithmetic on times"
too_long = "a duration of 2^31 days (5.8 million years) or 2^20 months (87000 years) or more does not fit a time"
lengths_vary = "cannot order durations that compare differently on different dates (months and days have no fixed length)"

# the order of rust-harness:src/time/mod.rs TimeForm: a form's code is its index there
enum TimeForm { Instant, Date, Local, Duration, Zoned, Clock }
time_forms = [TimeForm.Instant, TimeForm.Date, TimeForm.Local, TimeForm.Duration, TimeForm.Zoned, TimeForm.Clock]
form_of(code: int): TimeForm := time_forms#(code + 1)

# the operators a time takes at run time, the operator index of the Rust twin (TIME_OPERATORS)
enum TimeOperator { Add, Sub, Mul }
time_operators = [TimeOperator.Add, TimeOperator.Sub, TimeOperator.Mul]
time_operator(code: int): TimeOperator := time_operators#(code + 1)

# an operand of + - *: a time, a duration or a whole number. A time of any form but Duration: its position is
# nanoseconds (Instant, Local, Zoned since 1970, Clock since midnight) or days since 1970 (Date); a zoned one's zone
# its index in time_zones, else -1. A duration: its month, day and nanosecond counts. Cases of one enum, no classes:
# a program's own `class Span` or `class Moment` stays its own, and time.classes lists only the module's values
enum TimeOperand { AtTime(form: TimeForm, position: int, zone: int), Lasting(month_count: int, day_count: int, nano_count: int), Whole(count: int) }

at_time(form: TimeForm, position: int): TimeOperand := AtTime(form, position, -1)
moved(moment: TimeOperand, position: int): TimeOperand := AtTime(moment.form, position, moment.zone)
span_plus(a: TimeOperand, b: TimeOperand): TimeOperand := Lasting(a.month_count + b.month_count, a.day_count + b.day_count, a.nano_count + b.nano_count)
span_scaled(span: TimeOperand, factor: int): TimeOperand := Lasting(span.month_count * factor, span.day_count * factor, span.nano_count * factor)
has_calendar_parts(span: TimeOperand): bool := span.month_count != 0 or span.day_count != 0

# the floor quotient and the remainder (0 ≤ r < divisor) of value by a positive divisor
floor_split(value: int, divisor: int): list := {
	quotient = value /! divisor
	[quotient, value - quotient * divisor]
}

# the day since 1970 and the nanoseconds into it of a date or local time (times.rs time_parts)
day_and_nanos(moment: TimeOperand): list := if moment.form == TimeForm.Date then [moment.position, 0] else floor_split(moment.position, nanos_per_day)

# `moment + span`, the span already signed: calendar.rs `Time.add`. The month count first, then the days: 2024-01-31
# + 1 month is refused, + 1 month 2 days too (no 2024-02-31 to add the days to)
shift_time(moment: TimeOperand, span: TimeOperand): TimeOperand := match moment.form {
	TimeForm.Zoned => shift_zoned(moment, span)
	TimeForm.Instant => {
		if has_calendar_parts(span) { raise no_calendar }
		moved(moment, moment.position + span.nano_count)
	}
	# a time of day goes round the clock: 23:00 + 2 hours is 01:00
	TimeForm.Clock => {
		if has_calendar_parts(span) { raise clock_without_calendar }
		moved(moment, floor_split(moment.position + span.nano_count, nanos_per_day)#2)
	}
	_ => {
		if moment.form == TimeForm.Date and span.nano_count != 0 { raise no_time_of_day }
		parts = day_and_nanos(moment)
		civil = date_of(parts#1 * 86400000)
		year_and_month = floor_split(civil.year * months_per_year + civil.month - 1 + span.month_count, months_per_year)
		shifted_year = year_and_month#1
		shifted_month = year_and_month#2 + 1
		if span.month_count != 0 and civil.day > days_in_month(shifted_year, shifted_month) { raise no_such_day }
		epoch_day = days_from_date(shifted_year, shifted_month, civil.day) + span.day_count
		# a date's position is its day, a local time's the nanoseconds since 1970 as if UTC
		if moment.form == TimeForm.Date then moved(moment, epoch_day) else moved(moment, epoch_day * nanos_per_day + parts#2 + span.nano_count)
	}
}

# `z + 1 day` keeps the wall clock across a clock change, `z + 24 hours` the elapsed time: the calendar part moves
# the wall clock, resolved in the zone as a calendar shift lands (compatible_instant), then the exact part the instant
shift_zoned(moment: TimeOperand, span: TimeOperand): TimeOperand := {
	zone = time_zones#(moment.zone + 1)
	seconds = floor_split(moment.position, nanos_per_second)
	wall = at_time(TimeForm.Local, (seconds#1 + zone_offset(zone, seconds#1)) * nanos_per_second)
	shifted = shift_time(wall, Lasting(span.month_count, span.day_count, 0))
	instant = compatible_instant(zone, shifted.position /! nanos_per_second) * nanos_per_second + seconds#2
	moved(moment, instant + span.nano_count)
}

# `a - b` of two times of one form: the days between dates, else an exact duration
time_difference(a: TimeOperand, b: TimeOperand): TimeOperand := {
	if a.form != b.form { raise mismatched }
	if a.form == TimeForm.Date { return Whole(a.position - b.position) }
	Lasting(0, 0, a.position - b.position)
}

operator_sign(op: TimeOperator): int := if op == TimeOperator.Add then 1 else -1

# `3 * d` is `d * 3`, `d + t` is `t + d`. The cases are told apart by `is` and built bare (`Whole(2)`): a match on
# an enum's cases with data and `Whole(2)` don't hold their data yet (card enum-case-data)
time_arithmetic(a: TimeOperand, b: TimeOperand, op: TimeOperator): TimeOperand := {
	if a is Lasting { return lasting_arithmetic(a, b, op) }
	if a is AtTime { return moment_arithmetic(a, b, op) }
	if b is Whole { raise not_arithmetic }
	time_arithmetic(b, a, op)
}

lasting_arithmetic(span: TimeOperand, b: TimeOperand, op: TimeOperator): TimeOperand := {
	if b is AtTime {
		if op != TimeOperator.Add { raise not_arithmetic }
		return time_arithmetic(b, span, op)
	}
	if b is Whole {
		if op != TimeOperator.Mul { raise not_arithmetic }
		return span_scaled(span, b.count)
	}
	if op == TimeOperator.Mul { raise not_arithmetic }
	span_plus(span, span_scaled(b, operator_sign(op)))
}

moment_arithmetic(moment: TimeOperand, b: TimeOperand, op: TimeOperator): TimeOperand := {
	if b is Lasting {
		if op == TimeOperator.Mul { raise not_arithmetic }
		return shift_time(moment, span_scaled(b, operator_sign(op)))
	}
	if b is AtTime {
		if op != TimeOperator.Sub { raise not_arithmetic }
		return time_difference(moment, b)
	}
	raise not_arithmetic
}

# -1, 0 or 1 as `a` is shorter, as long or longer than `b` on every date (Duration.compare); an order that depends
# on the date is an error. Daylight saving moves an exact part against the calendar part by at most an hour
duration_order(a: TimeOperand, b: TimeOperand): int := {
	difference = span_plus(a, span_scaled(b, -1))
	if not has_calendar_parts(difference) {
		if difference.nano_count > 0 { return 1 }
		if difference.nano_count < 0 { return -1 }
		return 0
	}
	fewest = difference.day_count + difference.month_count * shortest_month
	most = difference.day_count + difference.month_count * longest_month
	# negative months take more days off the longer they are
	if difference.month_count < 0 {
		longer = fewest
		fewest = most
		most = longer
	}
	dst = if difference.nano_count != 0 then nanos_per_hour else 0
	if fewest * nanos_per_day + difference.nano_count - dst > 0 { return 1 }
	if most * nanos_per_day + difference.nano_count + dst < 0 { return -1 }
	raise lengths_vary
}

# the form codes of the runtime's time nodes (core/analysis/kinds.warp TimeFormCode, TimeInfoUnit): a duration's days
# (32 bits) and months sit in its info above the form
duration_form_code = 3
info_days = 8
info_day_range = 4294967296
info_months = 34359738368
# the zone indexes a zoned time's info holds (8 bits)
zone_index_range = 256
# the signed range of a duration's days (32 bits) and months (the 21 bits above them, to the top of the kind word)
day_limit = 2147483648
month_limit = 1048576
# `a + b`, `a - b`, `a * b` (operator 0, 1, 2) of two run-time operands, each its form code (-1 a whole number, its
# position the number), position, months and days: the time node or whole number they make
# an operand of a time's + - * the emitter holds as a node, before its parts are read: a time, a duration or a whole
# number as it is; a quantity of lib/units the duration it lasts, by the Duration it converts to (as it moves lib/time's
# Instant): `2024-01-31T10:00 + 1 h`. Its milliseconds are a float (`24 h` is 86400000.0 ms): a duration counts whole nanoseconds,
# so they are rounded to the nearest one
time_operand(x: any) := {
	if x is number and not (x is int) { raise not_arithmetic }
	if x is int then x else lasting_of(x)
}
# a Duration as the exact duration it lasts; a value converting to one too, any other, a time, as it is
lasting_of(d: Duration or any) := if d is Duration then lasting_nanos(round(d.ms * 1000000) as int) else d
# the exact duration of nanoseconds, as a quantity of time moves a time
lasting_nanos(nanos: int) := time_of(duration_form_code, nanos)
time_operation(a_form: int, a_position: int, a_months: int, a_days: int, b_form: int, b_position: int, b_months: int, b_days: int, operator: int) := operand_value(time_arithmetic(operand_of(a_form, a_position, a_months, a_days), operand_of(b_form, b_position, b_months, b_days), time_operator(operator)))
operand_of(form: int, position: int, months: int, days: int): TimeOperand := {
	if form < 0 { return Whole(position) }
	if form == duration_form_code { return Lasting(months, days, position) }
	# a zoned time's info above its form, read as a duration's days: its zone's index, its offset above that
	if form == zoned_form { return AtTime(TimeForm.Zoned, position, floor_split(days, zone_index_range)#2) }
	at_time(form_of(form), position)
}
operand_value(operand: TimeOperand) := {
	if operand is Whole { return operand.count }
	if operand is Lasting { return duration_value(operand) }
	if operand.form == TimeForm.Zoned { return zoned_at(operand.zone, operand.position) }
	time_of(form_code(operand.form), operand.position)
}
# a duration made at run time beyond its info bits raises, never wraps
duration_value(span: TimeOperand) := {
	if not within_signed(span.day_count, day_limit) or not within_signed(span.month_count, month_limit) { raise too_long }
	time_of(duration_form_code + (span.day_count % info_day_range) * info_days + span.month_count * info_months, span.nano_count)
}
within_signed(count: int, limit: int): bool := count >= - limit and count < limit
form_code(form: TimeForm): int := (0 to 5).filter(code => form_of(code) == form)#1
