// The standard library module draw (notes/stdlib.md, card drawing-words): `use draw`, a canvas of colored pixels shown by
// paint (the playground's canvas, natively a PNG). A color is a number 0xAARRGGBB: rgb, hsv, the named colors, with_alpha
use math
// the canvas until canvas(width, height) sizes it: show() alone paints this one, the size of the playground's output pane,
// natively 640×480 (user 2026-10-10: defaults, no errors)
global canvas_width = view_width
global canvas_height = view_height
// natively in a window the shapes are drawn on the GPU (src/graphics/gpu_canvas.rs; WARP_DRAW=cpu or gpu chooses): no pixels
// here then, show() sends the shapes drawn since the last one
global drawing_on_gpu = gpu_drawing
global canvas_pixels = int[pixels_for(view_width, view_height)]
// paper: the canvas before anything is drawn, as paint shows 0 (src/graphics/paint.rs PAPER)
paper = 0xFFFAFAFA
black = 0xFF000000
white = 0xFFFFFFFF
gray = 0xFF808080
red = 0xFFFF0000
green = 0xFF00A000
blue = 0xFF0000FF
yellow = 0xFFFFD700
orange = 0xFFFF8C00
purple = 0xFF8000C0

// the pixel a coordinate falls in
cell(v) := floor(v) as int
// r, g, b from 0 to 255
rgb(r, g, b) := 0xFF000000 + (round(r) as int) * 65536 + (round(g) as int) * 256 + (round(b) as int)
// hue in degrees, saturation and value from 0 to 1
def hsv(h, s, v) {
	hue = (h % 360) / 60.0
	c = v * s
	x = c * (1 - abs(hue % 2 - 1))
	m = v - c
	sector = cell(hue)
	r = if sector == 0 or sector == 5 then c else if sector == 1 or sector == 4 then x else 0.0
	g = if sector == 1 or sector == 2 then c else if sector == 0 or sector == 3 then x else 0.0
	b = if sector == 3 or sector == 4 then c else if sector == 2 or sector == 5 then x else 0.0
	rgb((r + m) * 255, (g + m) * 255, (b + m) * 255)
}
// alpha from 0 (invisible) to 1 (opaque)
with_alpha(color, alpha) := (round(clamp(alpha, 0, 1) * 255) as int) * 16777216 + color % 16777216
alpha_of(color) := color//16777216

// what draw_shape's kind says (src/graphics/gpu_canvas.rs)
clear_shape = 0
rect_shape = 1
circle_shape = 2

// the pixels the canvas keeps here: none when they are on the GPU
pixels_for(width, height) := if drawing_on_gpu then 0 else width * height

def canvas(width, height) {
	canvas_width = width
	canvas_height = height
	canvas_pixels = int[pixels_for(width, height)]
}

def clear(color) {
	if drawing_on_gpu { draw_shape(clear_shape, 0, 0, 0, 0, color) }
	else { for i in 0..canvas_width * canvas_height { canvas_pixels[i] = color } }
}

// the color over what is there, mixed by its alpha
def mixed(below, color) {
	a = alpha_of(color)
	under = if below == 0 then paper else below
	if a >= 255 { return color }
	if a <= 0 { return under }
	0xFF000000 + channel_mix(color, under, a, 65536) * 65536 + channel_mix(color, under, a, 256) * 256 + channel_mix(color, under, a, 1)
}

// one channel (its place 65536, 256 or 1) of color over under, by alpha a from 0 to 255
channel_mix(color, under, a, place) := ((color//place % 256) * a + (under//place % 256) * (255 - a))//255

def dot(x, y, color) {
	col = cell(x)
	row = cell(y)
	if drawing_on_gpu { draw_shape(rect_shape, col, row, 1, 1, color) }
	else if col >= 0 and row >= 0 and col < canvas_width and row < canvas_height {
		at = row * canvas_width + col
		canvas_pixels[at] = mixed(canvas_pixels[at], color)
	}
}

def rect(x, y, width, height, color) {
	if drawing_on_gpu { draw_shape(rect_shape, x, y, width, height, color) }
	else { for row in cell(y)..cell(y + height) { for col in cell(x)..cell(x + width) { dot(col, row, color) } } }
}

// a filled circle around x, y
def circle(x, y, radius, color) {
	if drawing_on_gpu { draw_shape(circle_shape, x, y, radius, 0, color) }
	else { circle_pixels(x, y, radius, color) }
}

def circle_pixels(x, y, radius, color) {
	for row in cell(y - radius)..cell(y + radius) + 1 {
		for col in cell(x - radius)..cell(x + radius) + 1 {
			if (col + 0.5 - x) ^ 2 + (row + 0.5 - y) ^ 2 <= radius ^ 2 { dot(col, row, color) }
		}
	}
}

def line(x1, y1, x2, y2, color) {
	steps = max(abs(x2 - x1), abs(y2 - y1), 1)
	for i in 0 to cell(steps) { dot(x1 + (x2 - x1) * i / steps, y1 + (y2 - y1) * i / steps, color) }
}

def show() {
	if drawing_on_gpu { draw_show(canvas_width, canvas_height) }
	else { paint(canvas_pixels, canvas_width, canvas_height) }
}

// save canvas as: "painting.png", save(canvas, "painting.png") or save "painting.png" (card save-painting): the canvas
// as drawn so far as a PNG, natively that file, in the playground a download; the word canvas as save's argument is a
// Picture (src/lowering/words/saved_words.rs). On the GPU the pixels are there, not here: the host draws them again
class Picture {}
save(made: Picture, as file) := save_picture(canvas_pixels, canvas_width, canvas_height, file)
save(file: text) := save(Picture(), file)

// label(x, y, words, color, size): words set in a sans-serif font `size` pixels high from their top left corner, smooth
// edges mixed with what is below (card paint-text): the host sets them, the playground with the browser's canvas,
// natively a system font (src/graphics/text_raster.rs), so they look as text does on that system
def label(x, y, words, color, size = 12) {
	covered = text_coverage(words, size)
	width = covered[0]
	for at in 0..width * covered[1] {
		amount = covered[at + 2]
		if amount > 0 { dot(x + at % width, y + at//width, with_alpha(color, amount / 255)) }
	}
}

// glsl_shader(glsl, color): a WGSL shader for paint from GLSL 450 functions (card create-little): naga turns them into
// WGSL (crates/warp-glsl), and the shader's main gives each pixel the WGSL expression `color`, which calls them
// with `flipped`, the pixel as GLSL counts it (rows from the bottom), `size`, `pointer` (in pixels, y up) and the
// shader's built-in values (values.time, values.frame …). twigl and shadertoy are the dialects written so far
glsl_shader(glsl: text, color: text) := {
	wgsl = std_pure("draw", "glsl_wgsl", ["#version 450\n" + glsl + "\nvoid main() {}\n"])
	wgsl + "
@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	let size = values.size;
	let flipped = vec4f(at.x, size.y - at.y, at.z, at.w);
	let pointer = vec2f(values.mouse.x, size.y - values.mouse.y);
	return vec4f((" + color + ").rgb, 1.0);
}
"
	}

// twigl's noise (card twigl-glsl): fsnoise and fsnoiseDigits hash a point to [0, 1), snoise2D and snoise3D are simplex
// noise in [-1, 1] (Ian McEwan, Ashima Arts, webgl-noise, MIT license); a shader gets them only when it calls one
twigl_noise = "
float fsnoise(vec2 c) { return fract(sin(dot(c, vec2(12.9898, 78.233))) * 43758.5453); }
float fsnoiseDigits(vec2 c) { return fract(sin(dot(c, vec2(0.129898, 0.78233))) * 437.585453); }
vec2 mod289(vec2 x) { return x - floor(x * (1. / 289.)) * 289.; }
vec3 mod289(vec3 x) { return x - floor(x * (1. / 289.)) * 289.; }
vec4 mod289(vec4 x) { return x - floor(x * (1. / 289.)) * 289.; }
vec3 permute(vec3 x) { return mod289(((x * 34.) + 1.) * x); }
vec4 permute(vec4 x) { return mod289(((x * 34.) + 1.) * x); }
vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
float snoise2D(vec2 v) {
	const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
	vec2 i = floor(v + dot(v, C.yy));
	vec2 x0 = v - i + dot(i, C.xx);
	vec2 i1 = (x0.x > x0.y) ? vec2(1., 0.) : vec2(0., 1.);
	vec4 x12 = x0.xyxy + C.xxzz;
	x12.xy -= i1;
	i = mod289(i);
	vec3 p = permute(permute(i.y + vec3(0., i1.y, 1.)) + i.x + vec3(0., i1.x, 1.));
	vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.);
	m = m * m;
	m = m * m;
	vec3 x = 2. * fract(p * C.www) - 1.;
	vec3 h = abs(x) - 0.5;
	vec3 ox = floor(x + 0.5);
	vec3 a0 = x - ox;
	m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
	vec3 g;
	g.x = a0.x * x0.x + h.x * x0.y;
	g.yz = a0.yz * x12.xz + h.yz * x12.yw;
	return 130. * dot(m, g);
}
float snoise3D(vec3 v) {
	const vec2 C = vec2(1. / 6., 1. / 3.);
	const vec4 D = vec4(0., 0.5, 1., 2.);
	vec3 i = floor(v + dot(v, C.yyy));
	vec3 x0 = v - i + dot(i, C.xxx);
	vec3 g = step(x0.yzx, x0.xyz);
	vec3 l = 1. - g;
	vec3 i1 = min(g.xyz, l.zxy);
	vec3 i2 = max(g.xyz, l.zxy);
	vec3 x1 = x0 - i1 + C.xxx;
	vec3 x2 = x0 - i2 + C.yyy;
	vec3 x3 = x0 - D.yyy;
	i = mod289(i);
	vec4 p = permute(permute(permute(i.z + vec4(0., i1.z, i2.z, 1.)) + i.y + vec4(0., i1.y, i2.y, 1.)) + i.x + vec4(0., i1.x, i2.x, 1.));
	float n_ = 0.142857142857;
	vec3 ns = n_ * D.wyz - D.xzx;
	vec4 j = p - 49. * floor(p * ns.z * ns.z);
	vec4 x_ = floor(j * ns.z);
	vec4 y_ = floor(j - 7. * x_);
	vec4 x = x_ * ns.x + ns.yyyy;
	vec4 y = y_ * ns.x + ns.yyyy;
	vec4 h = 1. - abs(x) - abs(y);
	vec4 b0 = vec4(x.xy, y.xy);
	vec4 b1 = vec4(x.zw, y.zw);
	vec4 s0 = floor(b0) * 2. + 1.;
	vec4 s1 = floor(b1) * 2. + 1.;
	vec4 sh = -step(h, vec4(0.));
	vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
	vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
	vec3 p0 = vec3(a0.xy, h.x);
	vec3 p1 = vec3(a0.zw, h.y);
	vec3 p2 = vec3(a1.xy, h.z);
	vec3 p3 = vec3(a1.zw, h.w);
	vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
	p0 *= norm.x;
	p1 *= norm.y;
	p2 *= norm.z;
	p3 *= norm.w;
	vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.);
	m = m * m;
	return 42. * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}
"
// the noise of twigl_noise a twigl code calls: all of it or none
	noise_for(code: text) := if code contains "snoise" or code contains "fsnoise" then twigl_noise else ""

// twigl(code): a shader in the shorthand of twigl.app's geekest mode: the code draws the color o of the pixel FC from
// r, the size in pixels, t, the seconds, m, the pointer from 0 to 1, and f, the frame, with twigl's hsv, rotate2D,
// rotate3D and noise (twigl_noise). paint(twigl(code)) draws it, frame after frame in a loop
twigl(code: text) := {
	helpers = "
vec3 hsv(float h, float s, float v) {
	vec4 t = vec4(1., 2. / 3., 1. / 3., 3.);
	vec3 p = abs(fract(vec3(h) + t.xyz) * 6. - vec3(t.w));
	return v * mix(vec3(t.x), clamp(p - vec3(t.x), 0., 1.), s);
}
mat2 rotate2D(float r) { return mat2(cos(r), sin(r), -sin(r), cos(r)); }
mat3 rotate3D(float angle, vec3 axis) {
	vec3 a = normalize(axis);
	float s = sin(angle);
	float c = cos(angle);
	float r = 1. - c;
	return mat3(a.x * a.x * r + c, a.y * a.x * r + a.z * s, a.z * a.x * r - a.y * s, a.x * a.y * r - a.z * s,
		a.y * a.y * r + c, a.z * a.y * r + a.x * s, a.x * a.z * r + a.y * s, a.y * a.z * r - a.x * s, a.z * a.z * r + c);
}
"
		drawing = "vec4 warp_twigl(vec4 FC, vec2 r, float t, vec2 m, float f) {\nvec4 o = vec4(0.);\n" + code + "\nreturn o;\n}"
	glsl_shader(helpers + noise_for(code) + drawing, "warp_twigl(flipped, size, values.time, pointer / size, values.frame)")
}

// shadertoy(code): a shader as shadertoy.com writes them: mainImage(out vec4 fragColor, in vec2 fragCoord) with
// iResolution, iTime, iMouse (the pointer in pixels, also as the click) and iFrame; no iChannel textures
shadertoy(code: text) := {
	inputs = "vec3 iResolution;\nfloat iTime;\nvec4 iMouse;\nint iFrame;\n"
	drawing = "
vec4 warp_shadertoy(vec2 at, vec2 size, float time, vec2 pointer, float frame) {
	iResolution = vec3(size, 1.);
	iTime = time;
	iMouse = vec4(pointer, pointer);
	iFrame = int(frame);
	vec4 color = vec4(0.);
	mainImage(color, at);
	return color;
}
"
		glsl_shader(inputs + code + drawing, "warp_shadertoy(flipped.xy, size, values.time, pointer, values.frame)")
}
