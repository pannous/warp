// The standard library module draw (notes/stdlib.md, card drawing-words): `use draw`, a canvas of colored pixels shown by
// paint (the playground's canvas, natively a PNG). A color is a number 0xAARRGGBB: the color module's (rgb, hsv, the named colors, with_alpha)
use math
use color
// the paper and the ink of the system's theme as the program starts, dark_mode (the page's prefers-color-scheme,
// natively the system's appearance): clear(paper) clears to the paper, `ink` draws what stands out on it. The light
// paper is what paint shows 0 as (core/native/driver.warp PAPER, host-media.js PAINT_PAPER; test_paint_shades); dark
// mode swaps paper and ink, as the page shades paint's numbers and lib/shaders.warp a painted number
PALE = 0xFFFAFAFA
DARK = 0xFF1D1D1D
dark_theme = dark_mode
blank_color = if dark_theme then DARK else PALE
ink = if dark_theme then PALE else DARK
// the canvas until canvas.resize(width, height) sizes it: show() alone paints this one, the size of the playground's output pane,
// natively 640×480
global canvas_width: int = view_width
global canvas_height: int = view_height
// natively in a window the shapes are drawn on the GPU: no pixels
// here then, show() sends the shapes drawn since the last one
global drawing_on_gpu = gpu_drawing
// the device pixels a canvas pixel spans across: the display's density over the 96 dpi CSS counts a pixel at (a
// Retina display 2). Shapes and words are drawn at the screen's own pixels, edges smoothed, while a program keeps its
// sizes and coordinates; the host shows the painting at the canvas's size (paint_scale). The GPU's shapes are its own
PIXEL_DPI = 96
// (measured again as each canvas is made, so `display.dpi = 192 dpi` before canvas.resize draws at twice the pixels)
display_scale() as int := if drawing_on_gpu then 1 else max(1, round(display_dpi / PIXEL_DPI) as int)
global pixel_scale: int = display_scale()
// the canvas in device pixels
global device_width: int = view_width * pixel_scale
global device_height: int = view_height * pixel_scale
global canvas_pixels = blank_pixels(pixels_for(view_width, view_height))
// paper, the old word for the blank canvas: clear(paper) is clear(canvas)
paper() := canvas()
// the pixel a coordinate falls in
cell(v: float) as int := floor(v) as int

// what draw_shape's kind says to shape_shader (clear_shape: gpu_canvas.rs CLEAR; test_paint_shades)
clear_shape = 0
rect_shape = 1
circle_shape = 2
// the shader drawing the shapes on the GPU (rust-harness:src/graphics/gpu_canvas.rs), one instance of a box of two triangles each: a
// shape covers the pixels whose centers the CPU draw colors, so both give the same picture. show() and save give it
shape_shader = shader {
	struct Shape { @location(0) kind_color: vec2u, @location(1) place: vec4f }
	struct Covered { @builtin(position) at: vec4f, @location(0) @interpolate(flat) kind_color: vec2u, @location(1) @interpolate(flat) place: vec4f }
	@group(0) @binding(0) var<uniform> canvas: vec4f;
	// the pixels a shape may color: rect from cell(x) to cell(x + width), a circle its square, clear all
	fn box_of(kind: u32, place: vec4f) -> vec4f {
		if kind == 0u { return vec4f(0.0, 0.0, canvas.xy); }
		if kind == 1u { return vec4f(floor(place.xy), floor(place.xy + place.zw)); }
		return vec4f(floor(place.xy - place.z), floor(place.xy + place.z) + 1.0);
	}
	@vertex fn vertex(@builtin(vertex_index) corner: u32, shape: Shape) -> Covered {
		let box = box_of(shape.kind_color.x, shape.place);
		let corners = array(vec2u(0u, 0u), vec2u(1u, 0u), vec2u(0u, 1u), vec2u(0u, 1u), vec2u(1u, 0u), vec2u(1u, 1u));
		let pixel = mix(box.xy, box.zw, vec2f(corners[corner]));
		let clip = vec2f(pixel.x / canvas.x * 2.0 - 1.0, 1.0 - pixel.y / canvas.y * 2.0);
		return Covered(vec4f(clip, 0.0, 1.0), shape.kind_color, shape.place);
	}
	@fragment fn fragment(covered: Covered) -> @location(0) vec4f {
		let kind = covered.kind_color.x;
		let color = covered.kind_color.y;
		let place = covered.place;
		// the pixel's center, as CPU's circle tests col + 0.5, row + 0.5
		let center = covered.at.xy;
		if kind == 2u && dot(center - place.xy, center - place.xy) > place.z * place.z { discard; }
		let rgb = vec3f(f32((color >> 16u) & 255u), f32((color >> 8u) & 255u), f32(color & 255u)) / 255.0;
		// clear sets the color, as CPU's clear stores it unmixed
		let alpha = select(f32(color >> 24u) / 255.0, 1.0, kind == 0u);
		return vec4f(rgb, alpha);
	}
}

// the pixels the canvas keeps here: none when they are on the GPU
pixels_for(width, height) := if drawing_on_gpu then 0 else width * height * pixel_scale * pixel_scale
// the canvas's pixels before anything is drawn, each 0: ints 0xAARRGGBB as the host paints them, so show() hands them
// over as they are (a list of Colors converted 1M pixels a frame, 1.4 s, card finger-paint-demo); a Color equals its
// number, so `canvas_pixels[4] == red` holds (decision int-types-are-classes). A dark theme's paper is drawn on them
blank_pixels(count: int) := {
	pixels = int[count]
	if dark_theme { covered(pixels, blank_color) }
	pixels
}

// canvas.resize(width, height), also canvas(width, height), sizes the window too (card window-canvas-size), which then
// shows the canvas pixel for pixel
def canvas(width, height) {
	canvas_width = width
	canvas_height = height
	pixel_scale = display_scale()
	device_width = width * pixel_scale
	device_height = height * pixel_scale
	canvas_pixels = blank_pixels(pixels_for(width, height))
	window.width = width
	window.height = height
}
// a window sized apart from the canvas (`window.width = 800` after canvas.resize(200, 100)) shows it scaled: said once, a hint
// (on standard error as the page has it too: os's eprint is C's stdio, which no page has)
global size_difference_said = no
size_difference_told() := {
	if size_difference_said or (window.width == canvas_width and window.height == canvas_height) { return ø }
	size_difference_said = yes
	hint "the canvas is ${canvas_width}×${canvas_height}, the window ${window.width}×${window.height}: the canvas is shown scaled; canvas.resize(w, h) sizes both"
}
// the canvas's size as properties (decision property-accessors): written, it is a new blank canvas, as an HTML canvas is
canvas.width := canvas_width
canvas.width(new_width) := canvas(new_width, canvas_height)
canvas.height := canvas_height
canvas.height(new_height) := canvas(canvas_width, new_height)

// clear(red) fills the canvas with red; clear(canvas), canvas.clear(), clear it to its blank color
def clear(what) {
	// converted once: `as int` of a Color inside the loop cost 1 µs a pixel, a second a clear (card finger-paint-demo)
	color: int = if what is Canvas then blank_color else what as int
	covered(canvas_pixels, color)
}
// the pixels all one color, on the GPU one clear shape; written through the parameter, a local: a global list written
// a million times cost 10× (14 against 141 ms)
covered(pixels, color: int) := {
	if drawing_on_gpu { draw_shape(clear_shape, 0, 0, 0, 0, color) }
	else { for i in 0..#pixels { pixels[i] = color } }
}

// the color over what is there, mixed by its alpha
def mixed(below: int, color: int) as int {
	a = alpha_of(color)
	under = if below == 0 then blank_color else below
	if a >= 255 { return color }
	if a <= 0 { return under }
	0xFF000000 + channel_mix(color, under, a, 65536) * 65536 + channel_mix(color, under, a, 256) * 256 + channel_mix(color, under, a, 1)
}

// one channel (its place 65536, 256 or 1) of color over under, by alpha a from 0 to 255
channel_mix(color: int, under: int, a: int, place: int) as int := ((color /! place % 256) * a + (under /! place % 256) * (255 - a)) /! 255

// the device pixel col, row with color mixed over it
plot(col: int, row: int, color: int) := {
	if drawing_on_gpu { draw_shape(rect_shape, col, row, 1, 1, color) }
	else if col >= 0 and row >= 0 and col < device_width and row < device_height {
		// an int, not a number: int * int may grow past 64 bits, and an index of a number runs every write dynamically
		// (1.8 µs a dot against 0.27, card circle-dot-allocation)
		at: int = row * device_width + col
		canvas_pixels[at] = mixed(canvas_pixels[at], color)
	}
}
// the device pixel col, row covered by `coverage` (0 to 1) of a shape of color: an edge's pixel takes that share of it
shade(col: int, row: int, color: int, coverage: float) := {
	if coverage >= 1 { plot(col, row, color) }
	else if coverage > 0 { plot(col, row, color % 16777216 + 16777216 * round(alpha_of(color) * coverage) as int) }
}
// how much of a pixel an edge `inside` pixels away from its center covers (negative: outside), smoothed over one pixel
edge(inside: float) as float := min(max(inside + 0.5, 0.0), 1.0)
// the device pixels from col, row, `across` by `down` of them, one color
block(col: int, row: int, across: int, down: int, color: int) := {
	for r in row..row + down { for c in col..col + across { plot(c, r, color) } }
}

// the canvas pixel x, y: the device pixels it spans
def dot(x: float, y: float, color: any) {
	block(cell(x * pixel_scale), cell(y * pixel_scale), pixel_scale, pixel_scale, color as int)
}

public def rect(x, y, width, height, color) {
	if drawing_on_gpu { draw_shape(rect_shape, x, y, width, height, color as int) }
	else {
		left = cell(x * pixel_scale)
		top = cell(y * pixel_scale)
		block(left, top, cell((x + width) * pixel_scale) - left, cell((y + height) * pixel_scale) - top, color as int)
	}
}

// a filled circle around x, y
def circle(x, y, radius, color) {
	if drawing_on_gpu { draw_shape(circle_shape, x, y, radius, 0, color as int) }
	else { circle_pixels(x, y, radius, color) }
}

// the device pixels a circle covers, its rim smoothed; the distances squared by multiplying: ^ 2 is the general
// power, its logarithm and exponential (3× slower)
def circle_pixels(x: float, y: float, radius: float, color: any) {
	center_x = x * pixel_scale
	center_y = y * pixel_scale
	reach = radius * pixel_scale
	paint: int = color as int
	for row in cell(center_y - reach - 0.5)..cell(center_y + reach + 0.5) + 1 {
		down = row + 0.5 - center_y
		for col in cell(center_x - reach - 0.5)..cell(center_x + reach + 0.5) + 1 {
			across = col + 0.5 - center_x
			shade(col, row, paint, edge(reach - sqrt(across * across + down * down)))
		}
	}
}

// a line from the canvas pixel x1, y1 to x2, y2 as dot names them, `width` pixels wide with round ends, its edges smoothed
def line(x1, y1, x2, y2, color) {
	line_pixels(x1, y1, x2, y2, color, 1)
}
def line_pixels(x1: float, y1: float, x2: float, y2: float, color: any, width: float) {
	// walked along its longer side, the pixels across it within reach; steep: x and y swapped while walking
	steep = abs(y2 - y1) > abs(x2 - x1)
	// its ends in device pixels, at the centers of the pixels they name: [along the walk, across it]
	start = device_center(if steep then [y1, x1] else [x1, y1])
	end = device_center(if steep then [y2, x2] else [x2, y2])
	ahead: float = end#1 - start#1
	aside: float = end#2 - start#2
	length_squared = ahead * ahead + aside * aside
	slope = if ahead == 0 then 0.0 else aside / ahead
	half = width * pixel_scale / 2
	// the pixels across the line that can be in reach of it: half its width over the line's cosine, one more for the edge
	band = half * sqrt(1 + slope * slope) + 1
	low = min(start#1, end#1)
	high = max(start#1, end#1)
	paint: int = color as int
	for major in cell(low - half - 1)..cell(high + half + 1) + 1 {
		middle = start#2 + (min(max(major + 0.5, low), high) - start#1) * slope
		for minor in cell(middle - band)..cell(middle + band) + 1 {
			// the pixel's center from the start, and the share of the line to its nearest point
			x = major + 0.5 - start#1
			y = minor + 0.5 - start#2
			share = if length_squared == 0 then 0.0 else min(max((x * ahead + y * aside) / length_squared, 0.0), 1.0)
			coverage = edge(half - hypot(x - share * ahead, y - share * aside))
			if steep then shade(minor, major, paint, coverage) else shade(major, minor, paint, coverage)
		}
	}
}
// the device place of the center of canvas pixel [x, y]
device_center(at: list) as list := [(at#1 + 0.5) * pixel_scale, (at#2 + 0.5) * pixel_scale]

def show() {
	size_difference_told()
	if drawing_on_gpu {
		draw_shader(shape_shader)
		draw_show(canvas_width, canvas_height)
	}
	else {
		if pixel_scale != 1 { set_system_value("paint_scale", pixel_scale) }
		paint(canvas_pixels, device_width, device_height)
	}
}

// save canvas as: ./painting.png, save(canvas, ./painting.png) or canvas.save(./painting.png) (card save-painting;
// decision save-picture-word: save is typed by the Canvas, no bare save ./painting.png beside file's save): the canvas
// as drawn so far as a PNG, natively that file, in the playground a download. On the GPU the pixels are there, not
// here: the host draws them again
class Canvas {
	format as text := "canvas ${canvas_width}×${canvas_height}"
	// canvas.resize(width, height): a blank canvas of that size, the window too (not size: a class's size() is its count,
	// and a free size(…) would take the name from a program's own `size = …`)
	resize(width: int, height: int) := canvas(width, height)
}
// the canvas as drawn so far (decision saved-words): canvas() beside canvas(width, height), so the bare word canvas,
// its call, is the Canvas
canvas() := Canvas()
save(made: Canvas, as file) := {
	if drawing_on_gpu { draw_shader(shape_shader) }
	failed = save_picture(canvas_pixels, device_width, device_height, file)
	if failed { raise failed }
}

// label(x, y, words, color, size): words set in a sans-serif font `size` pixels high from their top left corner, smooth
// edges mixed with what is below (card paint-text): the host sets them, the playground with the browser's canvas,
// natively a system font (rust-harness:src/graphics/text_raster.rs), so they look as text does on that system;
// `font: ./my.ttf` names a font file instead (natively)
def label(x, y, words, color, size = 12, font = "") {
	covered = text_coverage(words, size * pixel_scale, font)
	width = covered[0]
	left = cell(x * pixel_scale)
	top = cell(y * pixel_scale)
	paint: int = color as int
	for at in 0..width * covered[1] { shade(left + at % width, top + at /! width, paint, covered[at + 2] / 255) }
}

// the host words of this module, which the host answers (natively core/native/driver.warp, the playground its JS)
draw_shape(kind: int, x: float, y: float, width: float, height: float, color: int) from host
draw_show(width: int, height: int) from host
draw_shader(shader: node) from host
text_coverage(words: node, size: int, font: node): node from host
// in the system font when none is named (a host line takes no default value yet)
text_coverage(words, size) := text_coverage(words, size, "")
paint(picture: node, width: int, height: int, values: node) from host
// why the picture could not be saved, else ""
save_picture(picture: node, width: int, height: int, file: node): node from host
