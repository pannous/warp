// The standard library module url: `use url`, percent-encoding of a text's UTF-8 bytes (RFC 3986) and query strings:
// url_encode("é") is "%C3%A9", query_map("a=1&b=x+y") is {a: "1", b: "x y"}, query_text({a: "1"}) is "a=1"
use text

URL_UNRESERVED = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
URL_HEX = "0123456789ABCDEF"

url_hex_value(c: any): int := { v = -1; u = upper(c); for i in 0 ..< 16 { if URL_HEX[i] == u { v = i } }; v }
url_byte(n: int): text := if URL_UNRESERVED.contains(chr(n)) and n < 128 then chr(n) else "%" + URL_HEX[n /! 16] + URL_HEX[n % 16]
url_encode(t: text): text := join([url_byte(n) for n in to_utf8(t)], "")

// %HH back to bytes, either case of hex; a stray % stays
def url_decode(t: text): text {
	bytes = []
	cs = [c for c in t]
	i = 0
	while i < count(cs) {
		high = if i + 2 < count(cs) then url_hex_value(cs[i + 1]) else -1
		low = if i + 2 < count(cs) then url_hex_value(cs[i + 2]) else -1
		if cs[i] == "%" and high >= 0 and low >= 0 { bytes = bytes + [high * 16 + low]; i = i + 3 }
		else { bytes = bytes + to_utf8(cs[i]); i = i + 1 }
	}
	from_utf8(bytes)
}

// a query component: + is a space here, then percent-decoding
query_decode(t: text): text := url_decode(replace(t, "+", " "))
// "a=1&b=x+y" (a leading ? is dropped) as a map of decoded keys to decoded values
def query_map(t: text): map {
	m = {}
	body = if t.starts_with("?") then t[1..] else t
	for pair in split(body, "&") {
		if pair != "" {
			parts = split(pair, "=")
			m[query_decode(parts[0])] = if count(parts) > 1 then query_decode(join(parts[1..], "=")) else ""
		}
	}
	m
}
// a map as a query string, keys and values percent-encoded
query_text(m: map): text := join([url_encode(str(k)) + "=" + url_encode(str(m[k])) for k in keys(m)], "&")
