// The units (decision units-as-values, card unit-literals): a unit is a value, the quantity of magnitude 1 of its
// dimension, `km` the Length of 1 km; `5km` is the number times the unit (implicit multiplication), `90km/h` and
// `9.81m/s²` their quotients and powers. A quantity keeps its amount in SI base units, exact where the written amount is,
// and shows in the unit written: `3km + 500m` is 3.5km, equal to 3500m. Quantities of different dimensions neither add
// nor compare (a DimensionError); `quantity("5 km")` and `quantity(5, "km")` read a unit given as data
// (notes/units_runtime.md)

// a dimension packs the power of each base quantity, one byte each (length + 256·mass + 65536·duration …), so
// multiplying quantities adds their dimensions
length_dimension() := 1
mass_dimension() := 256
duration_dimension() := 65536
temperature_dimension() := 16777216
pixels_dimension() := 4294967296

class Quantity {
	amount: number
	dims: int
	unit: text
	scale: number
	+(other) := measured(amount + same_quantity(this, other, "add").amount, dims, unit, scale)
	-(other) := measured(amount - same_quantity(this, other, "subtract").amount, dims, unit, scale)
	*(other) := if other is Quantity then measured(amount * other.amount, dims + other.dims, unit_product(unit, other.unit), scale * other.scale) else measured(amount * other, dims, unit, scale)
	/(other) := if other is Quantity then quotient(this, other) else measured(amount / other, dims, unit, scale)
	power(exponent) := measured(amount ^ exponent, dims * exponent, unit_power(unit, exponent), scale ^ exponent)
	equal(other) := other is Quantity and dims == other.dims and amount == other.amount
	compare(other) := amount - same_quantity(this, other, "compare").amount
	// the same quantity shown in another unit of its kind: `q.to("m")`
	to(u) := { target = same_quantity(this, quantity(1, u), "convert"); measured(amount, dims, u, target.scale) }
	// its amount counted in a unit of its kind: `q.in("m")` is a plain number
	in(u) := to(u).shown()
	shown() := amount / scale
	text() := quantity_text(this)
}

// the dimensions, each a class of its own: a parameter `duration: Time` takes a duration only
class Length extends Quantity {}
class Mass extends Quantity {}
class Time extends Quantity {}
class Temperature extends Quantity {}
class Pixels extends Quantity {}

// a quantity as the class of its dimension, a plain Quantity for a compound one (speed, area …)
measured(amount: number, dims: int, unit: text, scale: number) := {
	if dims == length_dimension { return Length(amount, dims, unit, scale) }
	if dims == mass_dimension { return Mass(amount, dims, unit, scale) }
	if dims == duration_dimension { return Time(amount, dims, unit, scale) }
	if dims == temperature_dimension { return Temperature(amount, dims, unit, scale) }
	if dims == pixels_dimension { return Pixels(amount, dims, unit, scale) }
	Quantity(amount, dims, unit, scale)
}
// `6km / 2000m` of one dimension is the plain number 3; `90km / h` a speed
quotient(above: Quantity, below: Quantity) := if above.dims == below.dims then above.amount / below.amount else measured(above.amount / below.amount, above.dims - below.dims, above.unit + "/" + below.unit, above.scale / below.scale)

// other when it measures what q measures, else the loud DimensionError
same_quantity(q: Quantity, other: any, action: text) := {
	if not (other is Quantity) { raise "DimensionError: cannot " + action + " " + quantity_text(q) + " and the plain number " + str(other) }
	if q.dims != other.dims { raise "DimensionError: cannot " + action + " " + quantity_text(q) + " and " + quantity_text(other) }
	other
}

// "5km": the amount in its own unit
quantity_text(q: Quantity) := str(q.shown()) + q.unit

// `m·m` is `m²`, `m²·m` `m³`
unit_product(first: text, second: text) := if first == second then unit_power(first, 2) else first + "·" + second
unit_power(u: text, power: int) := if power == 1 then u else if power == 2 then u + "²" else if power == 3 then u + "³" else u + "^" + str(power)

// the units by symbol, each [its SI amount, its dimension]; no unit is written in another, so a program's own `s` or
// `m` leaves every unit as it is
unit_table(): map := {
	"m": [1, length_dimension],
	"kg": [1, mass_dimension],
	"s": [1, duration_dimension],
	"K": [1, temperature_dimension],
	"px": [1, pixels_dimension],
	"mm": [1/1000, length_dimension],
	"cm": [1/100, length_dimension],
	"dm": [1/10, length_dimension],
	"km": [1000, length_dimension],
	"inch": [254/10000, length_dimension],
	"ft": [12 * 254/10000, length_dimension],
	"yd": [36 * 254/10000, length_dimension],
	"mi": [1760 * 36 * 254/10000, length_dimension],
	"g": [1/1000, mass_dimension],
	"mg": [1/1000000, mass_dimension],
	"lb": [45359237/100000000, mass_dimension],
	"ms": [1/1000, duration_dimension],
	"µs": [1/1000000, duration_dimension],
	"ns": [1/1000000000, duration_dimension],
	"min": [60, duration_dimension],
	"h": [3600, duration_dimension],
	"day": [86400, duration_dimension],
	"Hz": [1, 0 - duration_dimension],
	"kHz": [1000, 0 - duration_dimension],
	"N": [1, mass_dimension + length_dimension - 2 * duration_dimension],
	"L": [1/1000, 3 * length_dimension],
	"ml": [1/1000000, 3 * length_dimension],
	"ha": [10000, 2 * length_dimension],
	"dpi": [10000/254, pixels_dimension - length_dimension]
}
// the unit of that symbol, shown by it: `known_unit("km")` is the Length of 1000 m shown in km
known_unit(symbol: text) := { entry = unit_table()[symbol]; measured(entry#1, entry#2, symbol, entry#1) }

m() := known_unit("m")
kg() := known_unit("kg")
s() := known_unit("s")
K() := known_unit("K")
px() := known_unit("px")
mm() := known_unit("mm")
cm() := known_unit("cm")
dm() := known_unit("dm")
km() := known_unit("km")
inch() := known_unit("inch")
ft() := known_unit("ft")
yd() := known_unit("yd")
mi() := known_unit("mi")
g() := known_unit("g")
mg() := known_unit("mg")
lb() := known_unit("lb")
ms() := known_unit("ms")
µs() := known_unit("µs")
ns() := known_unit("ns")
// `min` stays the function min(a, b)
minute() := known_unit("min")
h() := known_unit("h")
day() := known_unit("day")
Hz() := known_unit("Hz")
kHz() := known_unit("kHz")
N() := known_unit("N")
L() := known_unit("L")
ml() := known_unit("ml")
ha() := known_unit("ha")
dpi() := known_unit("dpi")

// the long names a text may give a unit (`quantity(2, "hours")`), by its symbol
long_unit_names(): map := {
	"meter": "m", "meters": "m", "metre": "m", "kilogram": "kg", "second": "s", "seconds": "s",
	"kilometer": "km", "kilometers": "km", "inches": "inch", "foot": "ft", "feet": "ft", "yard": "yd", "mile": "mi",
	"miles": "mi", "gram": "g", "grams": "g", "pound": "lb", "lbs": "lb", "millisecond": "ms", "minute": "min",
	"minutes": "min", "hour": "h", "hours": "h", "days": "day", "litre": "L"
}

// a unit as written, `km`, `km/h`, `m²`, `kg·m/s²`: the quantity of one of it
unit_named(u: text) := {
	if u.contains("/") {
		parts = u.split("/")
		return unit_named(parts#1) / unit_named(parts#2)
	}
	if u.contains("*") { return unit_named(u.replace("*", "·")) }
	if u.contains("·") {
		parts = u.split("·")
		return unit_named(parts#1) * unit_named(parts[1 ..].join("·"))
	}
	if u.ends_with("²") or u.ends_with("^2") { return unit_named(u.replace("^2", "").replace("²", "")) ^ 2 }
	if u.ends_with("³") or u.ends_with("^3") { return unit_named(u.replace("^3", "").replace("³", "")) ^ 3 }
	symbol = long_unit_names().get(u) ?? u
	if not unit_table().has(symbol) { raise "unknown unit: " + u }
	known_unit(symbol)
}

// `quantity(5, "km")`: amount of the unit u, shown in it; `quantity("5 km")`, `quantity("2.5km/h")`: read from text
quantity(amount: number, u: text) := { one = unit_named(u); measured(amount * one.amount, one.dims, u, one.amount) }
quantity(t: text) := {
	var amount_text = ""
	var u = ""
	for c in t.trim() {
		if u is empty and "0123456789.+-".contains(c) { amount_text = amount_text + c } else if c != " " { u = u + c }
	}
	if amount_text is empty or u is empty { raise "not a quantity: " + t }
	quantity(exact_decimal(amount_text), u)
}

// "-2.5" as the exact -5/2 (`as number` would read a float)
exact_decimal(t: text) := {
	if not t.contains(".") { return t as int }
	parts = t.replace("-", "").replace("+", "").split(".")
	var denominator = 1
	for c in parts#2 { denominator = denominator * 10 }
	magnitude = ((parts#1 + parts#2) as int) / denominator
	if t.starts_with("-") then - magnitude else magnitude
}

// a duration sleeps that long: `sleep(300ms)`
sleep(duration: Time) := sleep_ms(duration.amount * 1000)
