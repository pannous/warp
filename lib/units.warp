// The units (decision units-as-values, card unit-literals): a unit is a value, the quantity of magnitude 1 of its
// dimension, `km` the Length of 1 km; `5km` is the number times the unit (implicit multiplication), `90km/h` and
// `9.81m/s²` their quotients and powers. A quantity keeps its amount in SI base units, exact where the written amount is,
// and shows in the unit written: `3km + 500m` is 3.5km, equal to 3500m. Quantities of different dimensions neither add
// nor compare (a DimensionError); `quantity("5 km")` and `quantity(5, "km")` read a unit given as data
// (notes/units_runtime.md)

use unit_names
use uncertain
use reals

class Quantity {
	amount: number
	dims: int
	unit: text
	scale: number
	// a sum or a difference of temperatures counts one zero: `20°C + 5°C` is 25°C
	+(other) := measured(amount + summand(this, other, "add").amount - unit_zero(unit), dims, unit, scale)
	-(other) := measured(amount - summand(this, other, "subtract").amount + unit_zero(unit), dims, unit, scale)
	*(other) := if other is Quantity then measured(amount * other.amount, dims + other.dims, unit_combined(unit, other.unit, 1), scale * other.scale) else measured(amount * other, dims, unit, scale)
	/(other) := if other is Quantity then quotient(this, other) else measured(amount / other, dims, unit, scale)
	power(exponent) := measured(amount ^ exponent, dims * exponent, unit_raised(unit, exponent), scale ^ exponent)
	equal(other) := other is Quantity and dims == other.dims and amount == other.amount
	compare(other) := amount - same_quantity(this, other, "compare").amount
	// the same quantity shown in another unit of its kind: `q.to("m")`, `q as m`, `q as cm^2` shown in cm²
	to(u) := { target = same_quantity(this, quantity(1, u), "convert"); measured(amount, dims, target.unit, target.scale) }
	// its amount counted in a unit of its kind: `q.in("m")` is a plain number
	in(u) := to(u).shown()
	shown() := (amount - unit_zero(unit)) / scale
	// its amount in SI base units as a plain float: what a shader reads of it (decision no-units-in-shaders)
	float() := amount as float
	text() := quantity_text(this)
	show() := quantity_text(this)
	// a tolerance's bounds and value, each a quantity in its unit: `(6m ± 0.3).low` is 5.7m
	low() := measured(as_interval(amount).low, dims, unit, scale)
	high() := measured(as_interval(amount).high, dims, unit, scale)
	value() := measured(as_interval(amount).value, dims, unit, scale)
}

// the dimensions, each a class of its own: a parameter `duration: Time` takes a duration only
class Length extends Quantity {}
class Mass extends Quantity {}
class Time extends Quantity {}
class Temperature extends Quantity {}
class Pixels extends Quantity {}
class Area extends Quantity {}
class Volume extends Quantity {}
class Speed extends Quantity {}
class Frequency extends Quantity {}
class Force extends Quantity {}
// pixels per length, the density of a screen or a print: dpi, ppi
class Density extends Quantity {}

// a duration moving lib/time's Instant (`now + 1h`): a quantity's milliseconds, a DimensionError of any other dimension
// than time; a plain number is milliseconds already
milliseconds_of(duration: any) := if duration is Quantity then duration.in("ms") else duration

// a quantity as the class of its dimension, a plain Quantity for one without a name (kg·m, m/s²)
measured(amount: number, dims: int, unit: text, scale: number) := {
	if dims == length_dimension { return Length(amount, dims, unit, scale) }
	if dims == mass_dimension { return Mass(amount, dims, unit, scale) }
	if dims == duration_dimension { return Time(amount, dims, unit, scale) }
	if dims == temperature_dimension { return Temperature(amount, dims, unit, scale) }
	if dims == pixels_dimension { return Pixels(amount, dims, unit, scale) }
	if dims == area_dimension { return Area(amount, dims, unit, scale) }
	if dims == volume_dimension { return Volume(amount, dims, unit, scale) }
	if dims == speed_dimension { return Speed(amount, dims, unit, scale) }
	if dims == frequency_dimension { return Frequency(amount, dims, unit, scale) }
	if dims == force_dimension { return Force(amount, dims, unit, scale) }
	if dims == density_dimension { return Density(amount, dims, unit, scale) }
	Quantity(amount, dims, unit, scale)
}
// a plain number as the dimensionless quantity it is: an operator meeting a number and a quantity promotes the number
// (decision as-promotes), so `2.0 / 4m` is 0.5/m and `1.0 - 4m` a DimensionError, never a plain number
n: number as Quantity := measured(n, 0, "", 1)
// `6km / 2000m` of one dimension is the plain number 3; `90km / h` a speed
quotient(above: Quantity, below: Quantity) := if above.dims == below.dims then above.amount / below.amount else measured(above.amount / below.amount, above.dims - below.dims, unit_combined(above.unit, below.unit, -1), above.scale / below.scale)

// other when it measures what q measures, else the loud DimensionError
same_quantity(q: Quantity, other: any, action: text) := {
	if not (other is Quantity) { raise "DimensionError: cannot " + action + " " + quantity_text(q) + " and the plain number " + str(other) }
	if q.dims != other.dims { raise "DimensionError: cannot " + action + " " + quantity_text(q) + " and " + quantity_text(other) }
	other
}

// other when it adds to q, a plain 0 as q's zero: of its quantity and, for temperatures, of its scale (`20°C + 50°F` asks to convert one)
summand(q: Quantity, other: any, action: text) := {
	# a plain 0 adds as nothing, the start of a sum: `sum(distances)`, `average(runs.map(r => r.distance))`
	if other == 0 and not (other is Quantity) { return measured(unit_zero(q.unit), q.dims, q.unit, q.scale) }
	same_quantity(q, other, action)
	if unit_zero(q.unit) != unit_zero(other.unit) { raise "DimensionError: cannot " + action + " " + quantity_text(q) + " and " + quantity_text(other) + ", temperatures of two scales: convert one first (`" + quantity_text(other) + " as " + q.unit + "`)" }
	other
}

// "5km": the amount in its own unit
quantity_text(q: Quantity) := str(q.shown()) + q.unit

// the unit of a product (sign 1) or a quotient (sign -1), its factors' powers summed: `m·m` is `m²`, `m/s · s` is
// `m`, `m/s / s` is `m/s²`, `km/h · h` is `km`
unit_combined(first: text, second: text, sign: int) := unit_shown(unit_powers(second, sign, unit_powers(first, 1, {})))
// `(m/s)^2` is `m²/s²`
unit_raised(u: text, exponent: number) := unit_shown(unit_powers(u, exponent, {}))
// the powers of a unit's factors, each times the exponent, added to powers: `kg·m/s²` gives kg 1, m 1, s -2; the
// factors after a `/` are all below it (`kg/m·s` is kg/(m·s), as unit_named reads it)
unit_powers(u: text, exponent: number, powers: map): map := {
	parts = u.split("/")
	added(parts#1, exponent, powers)
	for below in parts[1 ..] { added(below, 0 - exponent, powers) }
	powers
}
// the factors of `kg·m` or `s²`, each to its power times the exponent, added to powers
added(factors: text, exponent: number, powers: map) := {
	for factor in factors.split("·") {
		if factor is empty { continue }
		base = factor_base(factor)
		powers[base] = (powers.get(base) ?? 0) + exponent * factor_power(factor)
	}
}
// a factor's power written in superscripts, `m²`, `s⁻¹` (lib/reals.warp power_text), or after `^`, `m^1.5`
factor_base(factor: text): text := factor.split("^")#1.chars().filter(c => not (c in raised_marks)).join("")
factor_power(factor: text): number := if factor.contains("^") then factor.split("^")#2 as number else superscript_value(factor.chars().filter(c => c in raised_marks).join(""))
// the factors of positive power, then a `/` and those of negative power: `m/s²`; `/m` of a reciprocal
unit_shown(powers: map): text := {
	above = powers.keys.filter(k => powers[k] > 0).map(k => unit_power(k, powers[k]))
	below = powers.keys.filter(k => powers[k] < 0).map(k => unit_power(k, 0 - powers[k]))
	if below is empty then above.join("·") else above.join("·") + "/" + below.join("·")
}
unit_power(u: text, power: number) := if power is int then power_text(u, power) else u + "^" + str(power)

// the unit of that symbol, shown by it: `known_unit("km")` is the Length of 1000 m shown in km
known_unit(symbol: text) := { entry = unit_entry_of(symbol); measured(entry#1, entry#2, symbol, entry#1) }

m() := known_unit("m")
kg() := known_unit("kg")
s() := known_unit("s")
K() := known_unit("K")
px() := known_unit("px")
mm() := known_unit("mm")
cm() := known_unit("cm")
dm() := known_unit("dm")
km() := known_unit("km")
inch() := known_unit("inch")
ft() := known_unit("ft")
yd() := known_unit("yd")
mi() := known_unit("mi")
g() := known_unit("g")
mg() := known_unit("mg")
lb() := known_unit("lb")
ms() := known_unit("ms")
µs() := known_unit("µs")
ns() := known_unit("ns")
// `°C`, `°F`: the temperature scales, values (a glyph-led name is no function head: `°C()` reads °C then ()); a scale
// starts away from zero, so `20°C` is the temperature 20 on it, not 20 times one degree
°C = known_unit("°C")
°F = known_unit("°F")
rewrite $e * $u => quantity($e, $name) where $e is number and $u is symbol and $u in [°C, °F] and $name = spelled($u)
// `2 hours in minutes`: `in` is a word of the phrase, so the run is taken whole, before `2 hours` alone (rules try
// a phrase's runs in their order)
rewrite $e $u in $t => ($e $u) in $t where $e is number and unit_led($u) and $t is symbol and $t in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
// `20 °C`, `68 °F` spaced alike, and `q as °C`, `q in °F` converting to a scale
rewrite $e $u => quantity($e, $name) where $e is number and $u in [°C, °F] and $name = spelled($u)
rewrite $q as $u => $q.to($name) where $u in [°C, °F] and $name = spelled($u)
rewrite $q in $u => $q.to($name) where $u in [°C, °F] and $name = spelled($u)
// `[3, 4] cm`: a unit after a list measures each of its items
rewrite $xs $u => $xs.map(item => item * $u) where $xs is list and $u is symbol and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
// `sleep 5 ms`, `x = 3 kg`, `1 minute`: a number and a unit word spaced is their product, as glued `5ms` is; a unit
// after an expression belongs to its last amount, through comparisons, sums and assignments: `x > 1500 m` is
// x > 1500m (wiki/unit.md, extensions/rules/rule_words.warp unit_bound). A unit is a word, never the char 's' of `f(at + 1, 's')`
rewrite $e $u => $bound where $u is symbol and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $bound = unit_bound($e, $u)
// `30min`, `120 min`: min after a number is the minute (decision one-duration: `2 hours == 120 min`), anywhere else
// it stays the function min (decision #31)
rewrite $e * min => $e * minute where $e is number
rewrite $e min => $bound where $bound = unit_bound($e, minute)
// `4 m²`, `2 m³`: a number before a unit's power multiplies the power
rewrite $e $u^$n => $e * $u^$n where $e is number and $u is symbol and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
// `q as km/h`, `36km/h in m/s`: the quantity shown in a compound unit, the unit of one of it (lib/units unit_named),
// tried before the rules of a single unit word, which take a compound unit for its leading word
rewrite $q as $u => $q.to($unit) where not unit_led($q) and $w = leading_unit($u) and $w in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $unit = compound_unit($u)
rewrite $q in $u => $q.to($unit) where not unit_led($q) and $w = leading_unit($u) and $w in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $unit = compound_unit($u)
// `3km as m`: the quantity shown in that unit; `3 km as m`, parsed 3 (km as m), takes its amount first
rewrite $q as $u => $q.to($u.unit) where not unit_led($q) and $u is symbol and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
rewrite $e $u as $t => ($e $u) as $t where $e is number and unit_led($u) and $t is symbol and $t in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
// `2 hours in minutes`: the same, spelled with in
rewrite $q in $u => $q.to($u.unit) where not unit_led($q) and $u is symbol and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °]
// `q as km/h` binds as (q as km) / h, as tightly as `as` takes its type: the rest of a unit written whole joins the
// unit converted to, q as (km/h), taken top-down before its parts convert (`(q as km) / h` written so stays a quotient)
rewrite $a / $b => $converted where raw and $u = converted_unit($a) and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $converted = unit_regrouped($a / $b)
rewrite $a * $b => $converted where raw and $u = converted_unit($a) and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $converted = unit_regrouped($a * $b)
rewrite $a ^ $b => $converted where raw and $u = converted_unit($a) and $u in [m, kg, s, K, px, mm, cm, dm, km, inch, ft, yd, mi, g, mg, lb, ms, µs, ns, second, seconds, minute, minutes, hour, hours, h, day, Hz, kHz, N, L, ml, ha, dpi, ppi, °] and $converted = unit_regrouped($a ^ $b)
// `3 cm is Length` and `2 km/h is speed` parse as 3 (cm is Length): the unit goes with its amount first
rewrite $e $u is $t => ($e $u) is $t where $e is number and unit_led($u) and $t in [length, area, volume, mass, duration, time, temperature, speed, frequency, force, density, Quantity, Length, Mass, Time, Temperature, Pixels, Area, Volume, Speed, Frequency, Force, Density]
// `3 cm is length`, `2 km/h is speed`: a quantity measures a named dimension, after its unit went with its amount (no
// `cm is length` alone); a program's own `length` stays its own
rewrite $q is $d => measures($q, $name) where $d is symbol and $d in [length, area, volume, mass, duration, time, temperature, speed, frequency, force, density] and not unit_led($q) and $name = spelled($d)
named_dimensions() := {"length": length_dimension, "area": area_dimension, "volume": volume_dimension, "mass": mass_dimension, "duration": duration_dimension, "time": duration_dimension, "temperature": temperature_dimension, "speed": speed_dimension, "frequency": frequency_dimension, "force": force_dimension, "density": density_dimension}
measures(q: any, dimension: text) := q is Quantity and q.dims == named_dimensions()[dimension]
// `unit furlong := 201.168m`: a program's own unit, the quantity of one of it shown by its name (`1km as furlong` waits
// for card module-rule-unnamed), `quantity(1, "furlong")` (decision unit-definitions); `raw`: the spaced amount
// `201.168 m`, whose unit the parser leaves after the definition, joins its value before the definition is rewritten
rewrite (unit $name := $value $u) => (unit $name := ($value $u)) where raw
rewrite (unit $name := $value) => $name = defined_unit($written, $value) where $name is symbol and $written = spelled($name)
global program_units = {}
defined_unit(name: text, one: Quantity) := {
	program_units[name] = one
	measured(one.amount, one.dims, name, one.amount)
}
// an angle is a number of radians, as SI's radian is dimensionless (decision degree-constant), marked as an Angle that
// shows in degrees (decision marks-survive-arithmetic): `60°` is 1.0472 to sine and the GPU and prints 60°,
// `30° * 2` too
type Angle = float
° = 0.017453292519943295 as Angle # π / 180, a float as the GPU reads it (π is the exact Real of lib/reals)
// 60°, rounded to 12 digits so that 60° shows no 59.99999999999999°
show(a: Angle) := "${round(float(a) / 0.017453292519943295 * 1e12) / 1e12}°"
// `min` stays the function min(a, b)
minute() := known_unit("min")
minutes() := known_unit("min")
second() := known_unit("s")
seconds() := known_unit("s")
hour() := known_unit("h")
hours() := known_unit("h")
h() := known_unit("h")
day() := known_unit("day")
Hz() := known_unit("Hz")
kHz() := known_unit("kHz")
N() := known_unit("N")
L() := known_unit("L")
ml() := known_unit("ml")
ha() := known_unit("ha")
dpi() := known_unit("dpi")
ppi() := known_unit("ppi")

// a quantity shown in a unit of its own dimension, any other value as it is: a field `distance: km` given 1500m holds
// 1.5km (extensions/rules/rule_words.warp units_shown), never a conversion of another kind of value
shown_in(value: any, unit: text) := if value is Quantity then shown_in_dimension(value, unit) else value
shown_in_dimension(q: Quantity, unit: text) := if q.dims == unit_named(unit).dims then q.to(unit) else q

// a unit word names a type too, its dimension's class (card unit-fields): a field `distance: km` holds a Length,
// `time: min` a Time, `load: kg` a Mass, `area: ha` an Area, `push: N` a Force
type m = Length
type mm = Length
type cm = Length
type dm = Length
type km = Length
type inch = Length
type ft = Length
type yd = Length
type mi = Length
type kg = Mass
type g = Mass
type mg = Mass
type lb = Mass
type s = Time
type ms = Time
type µs = Time
type ns = Time
type min = Time
type minute = Time
type minutes = Time
type second = Time
type seconds = Time
type h = Time
type hour = Time
type hours = Time
type day = Time
type K = Temperature
type px = Pixels
type Hz = Frequency
type kHz = Frequency
type N = Force
type L = Volume
type ml = Volume
type ha = Area
type dpi = Density
type ppi = Density

// a unit as written, `km`, `km/h`, `m²`, `kg·m/s²`: the quantity of one of it
unit_named(u: text) := {
	if u.contains("/") {
		parts = u.split("/")
		return unit_named(parts#1) / unit_named(parts#2)
	}
	if u.contains("*") { return unit_named(u.replace("*", "·")) }
	if u.contains("·") {
		parts = u.split("·")
		return unit_named(parts#1) * unit_named(parts[1 ..].join("·"))
	}
	if u.ends_with("²") or u.ends_with("^2") { return unit_named(u.replace("^2", "").replace("²", "")) ^ 2 }
	if u.ends_with("³") or u.ends_with("^3") { return unit_named(u.replace("^3", "").replace("³", "")) ^ 3 }
	if program_units.has(u) { return defined_unit(u, program_units[u]) }
	symbol = unit_symbol(u)
	if symbol == ø { raise "unknown unit: " + u }
	known_unit(symbol)
}

// `quantity(5, "km")`: amount of the unit u, shown in its symbol, `quantity(3, "kilometers")` is 3km; `212°F` counts
// from its scale's zero; `quantity("5 km")`, `quantity("2.5km/h")`: read from text
quantity(amount: number, u: text) := { one = unit_named(u); measured(amount * one.amount + unit_zero(one.unit), one.dims, one.unit, one.amount) }
quantity(t: text) := {
	var amount_text = ""
	var u = ""
	for c in t.trim() {
		if u is empty and "0123456789.+-".contains(c) { amount_text = amount_text + c } else if c != " " { u = u + c }
	}
	if amount_text is empty or u is empty { raise "not a quantity: " + t }
	quantity(exact_decimal(amount_text), u)
}

// "-2.5" as the exact -5/2 (`as number` would read a float)
exact_decimal(t: text) := {
	if not t.contains(".") { return t as int }
	parts = t.replace("-", "").replace("+", "").split(".")
	var denominator = 1
	for c in parts#2 { denominator = denominator * 10 }
	magnitude = ((parts#1 + parts#2) as int) / denominator
	if t.starts_with("-") then - magnitude else magnitude
}

// a duration sleeps that long, `sleep(300ms)`; a plain number its seconds, as the prelude's sleep (one word: a module's
// sleep(d: Time) beside the prelude's sleep(x) would replace it, card typed-overload-replace)
sleep(duration) := slept((if duration is Time then duration.amount else duration) * 1000)

// `6.0m ± 0.3`: a tolerance of a quantity, its amount an interval; a plain spread counts in the value's unit, a
// quantity's converts to it: `5m ± 1cm` is 5.00 ± 0.01 m (notes/plus_minus.md P220)
infix operator ±(q: Quantity, spread: number) := measured(plus_minus(q.amount, spread * q.scale), q.dims, q.unit, q.scale)
infix operator ±(q: Quantity, spread: Quantity) := measured(plus_minus(q.amount, same_quantity(q, spread, "spread").amount), q.dims, q.unit, q.scale)
