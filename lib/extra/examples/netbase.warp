#!/usr/bin/env warp
# an example of lib/extra/netbase.warp: needs a netbase server with Wikidata loaded (`load`), so no sample
use ../netbase.warp // lib/extra is no module folder: its modules are used by path
load "wikidata"
results = query "all cities with population > 100000"
print first 10 of results
print results where it.country is "germany"
