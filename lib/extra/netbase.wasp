// `use netbase` (card netbase-package, notes/netbase.md): pannous/netbase, a semantic graph database answering natural
// queries over HTTP (`query "all cities with population > 100000"`). The server is the environment variable NETBASE,
// else a local `./netbase :server` on port 8181. Kept in warp's lib/ until netbase has a package of its own.
use os
use json

netbase_local_server = "http://localhost:8181"

netbase_server() := env("NETBASE") or netbase_local_server

// the query as a URL path segment
netbase_path(q) := q.replace("%", "%25").replace(" ", "%20").replace(">", "%3E").replace("<", "%3C").replace("#", "%23").replace("?", "%3F")

// the entities netbase finds at `server` for the query `q`, as records
query_at(server, q) := parse_json(fetch(server + "/json/query/" + netbase_path(q)))

query(q) := query_at(netbase_server(), q)
