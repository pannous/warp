# TODO move to lib/time  (card time-arithmetic-move)

# Arithmetic on times and durations at run time (card day-hour; Rust twin:
# rust-harness:src/wasm_emitter/time/time_arithmetic.rs, notes/dates_at_run_time.md): `d + 1 day`, `a - b`,
# `1 month + 2 days`, `3 * 1 day`, as calendar.rs `Time.add`, `since`, `Duration.plus` and `times` do for constants.
# The emitter hands `+`, `-` and `*` of a run-time time to time_operation, a time as its form, position, months and
# days (emitter/times.warp time_operation); a program writing a time literal brings this module
# (passes/prelude_words.warp). The calendar is plain integers here: a time is its form and position, a duration its
# month, day and nanosecond counts. Its names stay clear of the runtime's times.warp and durations.warp words and
# of the unit words (days, months, hours …), which the lowering reads as durations.
# Zoned times are refused here (their wall clock needs card time-zones-warp).
use time

nanos_per_day = 86400000000000
nanos_per_hour = 3600000000000
months_per_year = 12
shortest_month = 28
longest_month = 31

no_time_of_day = "a date has no time of day: add that duration to a local time"
no_calendar = "an instant has no calendar: place it in a zone before adding months or days"
clock_without_calendar = "a time of day has no calendar: add months or days to a local time"
no_such_day = "the day does not exist in that month: use add(…, overflow: clamp) for the last day of the month"
no_zones = "a zoned time at run time needs the time zone functions"
mismatched = "cannot subtract a date, a local time, an instant and a zoned time from each other: no implicit conversion between kinds of time"
not_arithmetic = "a time takes + or - a duration, a duration takes + or - a duration and * a whole number: nothing else is arithmetic on times"
lengths_vary = "cannot order durations that compare differently on different dates (months and days have no fixed length)"

# the order of rust-harness:src/time/mod.rs TimeForm: a form's code is its index there
enum TimeForm { Instant, Date, Local, Duration, Zoned, Clock }
time_forms = [TimeForm.Instant, TimeForm.Date, TimeForm.Local, TimeForm.Duration, TimeForm.Zoned, TimeForm.Clock]
form_of(code: int): TimeForm := time_forms#(code + 1)

# the operators a time takes at run time, the operator index of the Rust twin (TIME_OPERATORS)
enum TimeOperator { Add, Sub, Mul }
time_operators = [TimeOperator.Add, TimeOperator.Sub, TimeOperator.Mul]
time_operator(code: int): TimeOperator := time_operators#(code + 1)

class Span {
	month_count: int
	day_count: int
	nano_count: int
	plus(o: Span): Span := Span(month_count + o.month_count, day_count + o.day_count, nano_count + o.nano_count)
	scaled(factor: int): Span := Span(month_count * factor, day_count * factor, nano_count * factor)
	has_calendar_parts(): bool := month_count != 0 or day_count != 0
}

# a time of any form but Duration: its position is nanoseconds (Instant, Local, Zoned since 1970, Clock since
# midnight) or days since 1970 (Date)
class Moment {
	form: TimeForm
	position: int
}

# an operand of + - *: a time, a duration or a whole number
enum Operand { At(moment: Moment), Lasting(span: Span), Whole(count: int) }

# the floor quotient and the remainder (0 ≤ r < divisor) of value by a positive divisor
floor_split(value: int, divisor: int): list := {
	quotient = value /! divisor
	[quotient, value - quotient * divisor]
}

# the day since 1970 and the nanoseconds into it of a date or local time (times.rs time_parts)
day_and_nanos(moment: Moment): list := if moment.form == TimeForm.Date then [moment.position, 0] else floor_split(moment.position, nanos_per_day)

# `moment + span`, the span already signed: calendar.rs `Time.add`. The month count first, then the days: 2024-01-31
# + 1 month is refused, + 1 month 2 days too (no 2024-02-31 to add the days to)
shift_time(moment: Moment, span: Span): Moment := match moment.form {
	TimeForm.Zoned => raise no_zones
	TimeForm.Instant => {
		if span.has_calendar_parts() { raise no_calendar }
		Moment(moment.form, moment.position + span.nano_count)
	}
	# a time of day goes round the clock: 23:00 + 2 hours is 01:00
	TimeForm.Clock => {
		if span.has_calendar_parts() { raise clock_without_calendar }
		Moment(moment.form, floor_split(moment.position + span.nano_count, nanos_per_day)#2)
	}
	_ => {
		if moment.form == TimeForm.Date and span.nano_count != 0 { raise no_time_of_day }
		parts = day_and_nanos(moment)
		civil = date_of(parts#1 * 86400000)
		year_and_month = floor_split(civil.year * months_per_year + civil.month - 1 + span.month_count, months_per_year)
		shifted_year = year_and_month#1
		shifted_month = year_and_month#2 + 1
		if span.month_count != 0 and civil.day > days_in_month(shifted_year, shifted_month) { raise no_such_day }
		epoch_day = days_from_date(shifted_year, shifted_month, civil.day) + span.day_count
		# a date's position is its day, a local time's the nanoseconds since 1970 as if UTC
		if moment.form == TimeForm.Date then Moment(moment.form, epoch_day) else Moment(moment.form, epoch_day * nanos_per_day + parts#2 + span.nano_count)
	}
}

# `a - b` of two times of one form: the days between dates, else an exact duration
time_difference(a: Moment, b: Moment): Operand := {
	if a.form != b.form { raise mismatched }
	if a.form == TimeForm.Date { return Whole(a.position - b.position) }
	Lasting(Span(0, 0, a.position - b.position))
}

operator_sign(op: TimeOperator): int := if op == TimeOperator.Add then 1 else -1

# `3 * d` is `d * 3`, `d + t` is `t + d`. The cases are told apart by `is` and built bare (`Whole(2)`): a match on
# an enum's cases with data and `Whole(2)` don't hold their data yet (card enum-case-data)
time_arithmetic(a: Operand, b: Operand, op: TimeOperator): Operand := {
	if a is Lasting { return lasting_arithmetic(a.span, b, op) }
	if a is At { return moment_arithmetic(a.moment, b, op) }
	if b is Whole { raise not_arithmetic }
	time_arithmetic(b, a, op)
}

lasting_arithmetic(span: Span, b: Operand, op: TimeOperator): Operand := {
	if b is At {
		if op != TimeOperator.Add { raise not_arithmetic }
		return time_arithmetic(b, Lasting(span), op)
	}
	if b is Whole {
		if op != TimeOperator.Mul { raise not_arithmetic }
		return Lasting(span.scaled(b.count))
	}
	if op == TimeOperator.Mul { raise not_arithmetic }
	Lasting(span.plus(b.span.scaled(operator_sign(op))))
}

moment_arithmetic(moment: Moment, b: Operand, op: TimeOperator): Operand := {
	if b is Lasting {
		if op == TimeOperator.Mul { raise not_arithmetic }
		return At(shift_time(moment, b.span.scaled(operator_sign(op))))
	}
	if b is At {
		if op != TimeOperator.Sub { raise not_arithmetic }
		return time_difference(moment, b.moment)
	}
	raise not_arithmetic
}

# -1, 0 or 1 as `a` is shorter, as long or longer than `b` on every date (Duration.compare); an order that depends
# on the date is an error. Daylight saving moves an exact part against the calendar part by at most an hour
duration_order(a: Span, b: Span): int := {
	difference = a.plus(b.scaled(-1))
	if not difference.has_calendar_parts() {
		if difference.nano_count > 0 { return 1 }
		if difference.nano_count < 0 { return -1 }
		return 0
	}
	fewest = difference.day_count + difference.month_count * shortest_month
	most = difference.day_count + difference.month_count * longest_month
	# negative months take more days off the longer they are
	if difference.month_count < 0 {
		longer = fewest
		fewest = most
		most = longer
	}
	dst = if difference.nano_count != 0 then nanos_per_hour else 0
	if fewest * nanos_per_day + difference.nano_count - dst > 0 { return 1 }
	if most * nanos_per_day + difference.nano_count + dst < 0 { return -1 }
	raise lengths_vary
}

# the form codes of the runtime's time nodes (core/analysis/kinds.warp TimeFormCode, TimeInfoUnit): a duration's days
# (32 bits) and months sit in its info above the form
duration_form_code = 3
info_days = 8
info_day_range = 4294967296
info_months = 34359738368
# `a + b`, `a - b`, `a * b` (operator 0, 1, 2) of two run-time operands, each its form code (-1 a whole number, its
# position the number), position, months and days: the time node or whole number they make
time_operation(a_form: int, a_position: int, a_months: int, a_days: int, b_form: int, b_position: int, b_months: int, b_days: int, operator: int) := operand_value(time_arithmetic(operand_of(a_form, a_position, a_months, a_days), operand_of(b_form, b_position, b_months, b_days), time_operator(operator)))
operand_of(form: int, position: int, months: int, days: int): Operand := {
	if form < 0 { return Whole(position) }
	if form == duration_form_code { return Lasting(Span(months, days, position)) }
	At(Moment(form_of(form), position))
}
operand_value(operand: Operand) := {
	if operand is Whole { return operand.count }
	if operand is Lasting { return time_of(duration_form_code + (operand.span.day_count % info_day_range) * info_days + operand.span.month_count * info_months, operand.span.nano_count) }
	time_of(form_code(operand.moment.form), operand.moment.position)
}
form_code(form: TimeForm): int := (0 to 5).filter(code => form_of(code) == form)#1
