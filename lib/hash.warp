// The standard library module hash (notes/stdlib.md section 7): `use hash`, through the adapter std_pure, of a text's
// UTF-8 bytes or a list of 0 to 255, zero bytes and all: sha256 as lowercase hex, crc32 as a number
sha256(subject: text or list): text := std_pure("hash", "sha256", [subject])
crc32(subject: text or list): int := std_pure("hash", "crc32", [subject])
