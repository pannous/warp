# Counted loops (notes/layers.md, sugar): `n times {…}` (also `n times: …`, which the parser reads as its block) runs
# the block n times; `n times [x]` and `n times "ab"` repeat a list or a text (emitter.warp). Rust twin:
# times_phrases.rs
rewrite $n times $body => for $i in 1 to $n $body where $body is block
rewrite (once $body) => (1 times $body) where $body is block
rewrite (twice $body) => (2 times $body) where $body is block
rewrite (thrice $body) => (3 times $body) where $body is block
# The C-style head `for (i=0; i<n; i++) {…}` (the parser groups it as for(head) and the body): its start, then while
# the condition holds the body and the step (a `continue` in the body is refused until the step is marked `loop·step:` as
# for_loops.warp marks it, card lib-sugar-loops)
rewrite for($start; $condition; $step) {$body...} => ($start; while $condition { $body...; $step })
# `for xs {…}` loops with the variable `it`
rewrite (for $xs $body) => (for it in $xs $body) where $body is block
