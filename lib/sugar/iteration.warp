# `for` loops onto the one `while` loop (notes/layers.md, sugar). Each loop's step is marked `loop·step:`, so a
# `continue` still runs it, and the loop's hidden names are fresh, so two loops of one variable keep their own.
# A body without braces is a block of its one statement.
rewrite for $x in $xs $body => for $x in $xs {$body} where $x is symbol and $body is not block
# Counting over a range: `a..b` leaves b out, `a to b` takes it, `b down to a` (the parser's `reverse(a to b)`) counts
# down; the far end is computed once, before the loop, and the variable is past it afterwards.
rewrite for $i in $a..$b {$body...} => ($i = $a; $end = $b; while $i < $end { $body...; loop·step: $i++ }) where $i is symbol
rewrite for $i in $a to $b {$body...} => ($i = $a; $end = $b; while $i <= $end { $body...; loop·step: $i++ }) where $i is symbol
rewrite for $i in reverse($a to $b) {$body...} => ($i = $b; $end = $a; while $i >= $end { $body...; loop·step: $i-- }) where $i is symbol
# `for k, v in m` over a map (loop_heads.warp found it one): its keys, each with its value.
rewrite for ($k, $v) in map_keys($m) {$body...} => for $k in map_keys($m) { $v = $m#($k + 1); $body... }
# Any other iterable is walked item by item: a list, a text, the keys of a map.
rewrite for $x in $xs {$body...} => ($items = $xs; $index = 0; while $index < #$items { $x = $items#($index + 1); $body...; loop·step: $index++ }) where $x is symbol
