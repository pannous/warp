# Match arms as other languages spell them, in warp's own (notes/layers.md, sugar; Rust twin: welcome_forms.rs
# lower_match_arms): `k => v` is the arm `k: v` (of several patterns too, `1, 2 => v`), `_ => v` and `else -> v` the arm `default: v`, Swift's `case .north: 1`
# and `.north: 1` the arm of the case north, `case 1: v` the arm `1: v`. `switch` is match's other word.
rewrite match $s {$arms...} => match $s {($k: $v) for ($k => $v) in $arms...}
rewrite match $s {$arms...} => match $s {($ks..., $k: $v) for ($ks..., $k => $v) in $arms...}
rewrite match $s {$arms...} => match $s {(default: $v) for (_: $v) in $arms...}
rewrite match $s {$arms...} => match $s {(default: $v) for (else: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (case.$k: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (.$k: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (case $k: $v) in $arms...}
rewrite switch $s {$arms...} => match $s {$arms...}
# Tree patterns (notes/matching.md): `page find {type: "image", src}` every match at any depth, a pattern binding one
# name its values, none the matched parts, several their maps; `xs replace [1, x] with x` each match rewritten,
# children first (lib/prelude.warp find_matches, replace_matches)
rewrite $x find $p => find_matches($x, data($p))
rewrite $x replace $p with $t => replace_matches($x, data($p), data($t))
# the phrase as a call's argument, `count(page find {type: "text"})`, which the parser reads as count's four words
rewrite $f($x find $p) => $f(find_matches($x, data($p)))
rewrite $f($x replace $p with $t) => $f(replace_matches($x, data($p), data($t)))
