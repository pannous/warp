# A value or its fallback (notes/layers.md, sugar): `a ?? b` is b where a is missing (ø), else a; 0, "" and no stay.
# A name is tested as it is, any other operand computed once.
rewrite $a ?? $b => if $a == ø then $b else $a where $a is symbol
rewrite $a ?? $b => ($t = $a; if $t == ø then $b else $t)
# `a ?: b` is b where a is falsy (ø, 0, "", no), else a; the parser reads a name's as the ternary `a ? a : b`, any other
# operand is computed once
rewrite $a ?: $b => ($t = $a; $t ? $t : $b)
