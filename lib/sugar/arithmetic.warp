# Floor division (notes/layers.md, sugar): `a /! b` (also `a div b`, `a ÷ b`, lib/aliases.warp) is the call
# floor_quotient(a, b), and `x /!= b` (also `x ÷= b`) the assignment `x = floor_quotient(x, b)`
rewrite $a /! $b => floor_quotient($a, $b)
rewrite ($a /!= $b) => $a = floor_quotient($a, $b)
# The logical compound assignments: `x &&= y` (also `x and= y`) is `x = x and y`, `||=` (`or=`) and `^^=` (`xor=`) so
rewrite ($a &&= $b) => $a = $a and $b
rewrite ($a ||= $b) => $a = $a or $b
rewrite ($a ^^= $b) => $a = $a xor $b
# The element-wise operators (notes/layers.md, sugar; notes/broadcasting.md): `[1, 2] .* 2` applies `*` to each element,
# a map that fuses with sum; a side that may be a list or a number decides at run time (prelude element_wise_any): two
# lists pair their elements, a list and a number pair each element with it, two numbers are the plain operator
rewrite $xs: list .+ $y: number => $xs.map($e -> $e + $y)
rewrite $xs: list .- $y: number => $xs.map($e -> $e - $y)
rewrite $xs: list .* $y: number => $xs.map($e -> $e * $y)
rewrite $xs: list ./ $y: number => $xs.map($e -> $e / $y)
rewrite $xs: list .^ $y: number => $xs.map($e -> $e ^ $y)
rewrite $a .+ $b => element_wise_any($a, $b, ($l, $r) -> $l + $r)
rewrite $a .- $b => element_wise_any($a, $b, ($l, $r) -> $l - $r)
rewrite $a .* $b => element_wise_any($a, $b, ($l, $r) -> $l * $r)
rewrite $a ./ $b => element_wise_any($a, $b, ($l, $r) -> $l / $r)
rewrite $a .^ $b => element_wise_any($a, $b, ($l, $r) -> $l ^ $r)
