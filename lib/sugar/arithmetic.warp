# Floor division (notes/layers.md, sugar): `a /! b` (also `a div b`, `a ÷ b`, lib/aliases.warp) is the call
# floor_quotient(a, b)
rewrite $a /! $b => floor_quotient($a, $b)
# The dot-product operator reaches the library function without an explicit math import (decision dot-glyphs).
rewrite $a ∘ $b => dot($a, $b)
# Compound assignment (decision op-assign-general): `x op= y` is `x = x op y` for every operator, `x ^= 3`, `x &&= y`,
# `x and= y`, `x /!= b`, and the word of a function, `x max= 5` x = max(x, 5); the list and index of an element, the
# object of a field, are evaluated once (decision op-assign-target-once). The parser keeps += -= *= /= themselves, alike but faster
# `where $op is symbol` holds for every operator these forms bind; it keeps a seed that reads `$op=` as `$op =`
# (`return m[i] = 3`) and `.$op` as a field from firing them on the own code of the compiler
rewrite ($xs[$i] $op= $v) => ($list = $xs; $at = $i; $list[$at] = ($list[$at] $op $v)) where $op is symbol
rewrite ($o.$f $op= $v) => ($object = $o; $object.$f = ($object.$f $op $v)) where $op is symbol
rewrite ($a $op= $b) => $a = ($a $op $b) where $op is symbol
# The element-wise operators (decision dot-operators-now, notes/broadcasting.md): the `.op` of every operator, `[1, 2] .* 2`,
# `xs .< 3`, `u .== v`, applies it to each element; a side that may be a list or a number decides at run time (prelude
# element_wise_any): two lists pair their elements, a list and a number pair each element with it, two numbers are the
# plain operator. `xs .*= 2` is `xs = xs .* 2`
rewrite ($a .$op $b) => element_wise_any($a, $b, ($l, $r) -> ($l $op $r)) where $op is symbol
# `x as! int` converts no matter what (decision cast-checks): the parser reads `(x as !) int`, the emitter `x as !int`
rewrite $x as! $t => $x as !$t
# Trailing percent (decision Trailing percent): `10%` is 1/10, exact, and `50 % of 200` 100 (the parser's `50% * 200`);
# infix `%` stays the remainder
rewrite $n % ø => $n / 100
