# Floor division (notes/layers.md, sugar): `a /! b` (also `a div b`, `a ÷ b`, lib/aliases.warp) is the call
# floor_quotient(a, b)
rewrite $a /! $b => floor_quotient($a, $b)
# Compound assignment (decision op-assign-general): `x op= y` is `x = x op y` for every operator, `x ^= 3`, `x &&= y`,
# `x and= y`, `x /!= b`, and a function's word, `x max= 5` x = max(x, 5); an element's list and index, a field's
# object, are evaluated once (decision op-assign-target-once). The parser keeps += -= *= /= themselves, alike but faster
rewrite ($xs[$i] $op= $v) => ($list = $xs; $at = $i; $list[$at] = $list[$at] $op $v)
rewrite ($o.$f $op= $v) => ($object = $o; $object.$f = $object.$f $op $v)
rewrite ($a $op= $b) => $a = $a $op $b
# The element-wise operators (decision dot-operators-now, notes/broadcasting.md): every operator's `.op`, `[1, 2] .* 2`,
# `xs .< 3`, `u .== v`, applies it to each element; a side that may be a list or a number decides at run time (prelude
# element_wise_any): two lists pair their elements, a list and a number pair each element with it, two numbers are the
# plain operator. `xs .*= 2` is `xs = xs .* 2`
rewrite $a .$op $b => element_wise_any($a, $b, ($l, $r) -> $l $op $r)
