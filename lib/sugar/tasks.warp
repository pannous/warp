# Tasks in the pure lane (notes/layers.md, sugar): a task runs at once, where it's started, so `go x` is x's value and
# awaiting it is that value; `await all jobs` the values, `await any`/`first` the first one's, `await job within t or d`
# the job's value (it has finished); stopping a finished task does nothing. No thread runs beside it.
# A task keeps what a module holds per task (task_context, the prelude's nothing): sound's voice, so a task's sounds start
# where its starter stands and the starter goes on as if the task's were beside them, not before them
rewrite await go {$body...} => ($context = task_context(); $value = (if yes { $body... }); task_context_back($context); $value)
rewrite await go $x => ($context = task_context(); $value = $x; task_context_back($context); $value)
rewrite go {$body...} => ($context = task_context(); $value = (if yes { $body... }); task_context_back($context); $value)
rewrite go $x => ($context = task_context(); $value = $x; task_context_back($context); $value)
rewrite await all $xs => $xs
rewrite await any $xs => $xs#1
rewrite await first $xs => $xs#1
rewrite await $x within $t or $d => $x
rewrite await $x => $x
rewrite stop $x => ø where statement
rewrite cancel $x => ø where statement
