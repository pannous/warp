# Methods that change the list they are called on (notes/layers.md, sugar): `xs.push(v)` (also add, append, and insert
# of one value) appends, `xs += [v]`, which emitter.warp grows in place while the list is unshared; `xs.pop()` is the
# runtime word list_pop(xs), which shortens xs in place; an instance's own push and pop are its class's. Rust twin:
# list_mutations.rs appends
rewrite $xs.push($v...) => $xs += [$v...] where $xs is not instance
rewrite $xs.add($v...) => $xs += [$v...] where $xs is not instance
rewrite $xs.append($v...) => $xs += [$v...] where $xs is not instance
rewrite $xs.insert($v) => $xs += [$v] where $xs is not instance
# `xs.insert(i, v)`, the position first as in Python, `xs.insert(v, at: i)` by name: the runtime word list_insert, in
# xs itself (decision list-insert)
rewrite $xs.insert($v, at: $i) => list_insert($xs, $i, $v) where $xs is not instance
rewrite $xs.insert($i, $v) => list_insert($xs, $i, $v) where $xs is not instance
rewrite $xs.pop() => list_pop($xs) where $xs is not instance
# `x.json`: the JSON text of any value (lib/json.warp json_text), a map's field json where it has one
rewrite $x.json => json_text($x)

# `x in xs` (a list's item, a map's key, a text's part) is the runtime word collection_contains(xs, x); `xs contains x`,
# `xs has x`, `xs includes x` the same written the other way round. Rust twin: library_words.rs membership
rewrite ($x in $xs) => collection_contains($xs, $x)
rewrite ($xs contains $x) => collection_contains($xs, $x)
rewrite ($xs has $x) => collection_contains($xs, $x)
rewrite ($xs includes $x) => collection_contains($xs, $x)
# `count(2 in xs)` counts a yes/no question: refused, naming `xs.count(2)` (lib/rule_words.warp counted_question)
rewrite count(collection_contains($xs, $x)) => $refused where $refused = counted_question($xs, $x)
# `x.upper!`, `sort xs!` (the parser's unwrap of a marked call): a function's bang assigns its result back to the
# variable it was called on, as `upper(x)!` does (test/operators/test_mutating_bang.pairs.warp)
# (a printing word prints the forced value and keeps the variable: `print friends!`, test_print_bang.pairs.warp)
rewrite unwrap($x.$m) => $x = $x.$m where $x is value and $m is function
rewrite unwrap($x.$m()) => $x = $x.$m() where $x is value and $m is function
rewrite $f unwrap($x) => $x = $f($x) where $x is value and $f is function and not $f in [print, puts]
rewrite $f(unwrap($x)) => $x = $f($x) where $x is value and $f is function and not $f in [print, puts]
# `t.replace "tea" with: "coffee"`: a member followed by arguments, unbracketed, is its call
rewrite $x.$f $b $a... => $x.$f($b, $a...) where $f is symbol and $x is not enum and $b is not block

# `(p).a` is `p.a` (notes/layers.md, sugar): parentheses around a variable before a dot only group it; the parser gives
# the call `f()` the form of the group `(f)`, so a function's name keeps its call, `f().b`. Rust twin:
# grouped_receivers.rs
rewrite ($p).$m => $p.$m where $p is value and $p is not function
