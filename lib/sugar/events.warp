# Named events (wiki/events.md): `on alarm {…}` listens, its block reading the event's data as `event`; `once alarm {…}`
# listens for the first one only; `emit alarm{level: 3}` (also fire, send, trigger) runs the listeners in order and
# gives the last one's result. A listener is numbered within its event: `h = on alarm {…}`, `listeners of alarm`,
# `remove h from listeners of alarm`. The registry is the prelude's (lib/prelude.warp listen)
rewrite on $e $body => listen(data $e, event => $body, no) where $e is symbol
rewrite on $e: $body => listen(data $e, event => $body, no) where $e is symbol
rewrite once $e $body => listen(data $e, event => $body, yes) where $e is symbol
rewrite remove $h from listeners of $e => unlisten(data $e, $h) where $e is symbol
rewrite listeners of $e -= $h => unlisten(data $e, $h) where $e is symbol
rewrite listeners of $e => listeners_of(data $e) where $e is symbol
rewrite emit $e: $v => emitted(data $e, $v)
rewrite emit $e $v => emitted(data $e, $v) where $e is symbol
rewrite emit $e => emitted(data $e, ø) where $e is symbol
rewrite fire $e... => emit $e...
rewrite send $e... => emit $e...
rewrite trigger $e... => emit $e...
