// GPU-resident passes (card gpu-multipass). A field is a pair of targets that stay on the GPU: rgba16float
// where the device can render it, else rgba32float, else rgba8unorm. gpu_pass draws a fullscreen fragment
// into one field and swaps the pair. The passes of a frame share one command encoder, so nothing comes
// back to the CPU until gpu_picture. A shader reads field_<name>(uv), uv in 0..1, filtered when the format
// allows. gpu_show draws the last shader into the window (or the page canvas) and gpu_picture reads that
// one image back. Values are numbers and short vectors, the same holes paint fills ($width, $mouse, …).
gpu_fields(width: int, height: int, names: node): int from host
gpu_pass_recorded(shader: node, fields: int, into: node, values: node): int from host
gpu_show(shader: node, fields: int, values: node): int from host
gpu_picture(shader: node, fields: int, values: node): node from host
// the shading pass at width × height, the fields still sampled in 0..1. gpu_show_sized opens the window at
// that point size and, where the drawable is a larger same-aspect image, shades that drawable one pixel for one
gpu_show_sized(shader: node, fields: int, width: int, height: int, values: node): int from host
gpu_picture_sized(shader: node, fields: int, width: int, height: int, values: node): node from host
gpu_fields_format(): node from host
// the pass, or a catchable "no field" where `into` is not one of the fields
gpu_pass(shader: node, fields: int, into: node, values: node): int := {
	recorded = gpu_pass_recorded(shader, fields, into, values)
	if recorded < 0 { raise "no field " + text(into) }
	recorded
}

// --- paint([advect, pressure, show]) (wiki/graphics.md "Fields and passes"): the rule (extensions/rules/modules/gpu_passes.warp)
// gives each pass as [its name, its shader, its values]. Each pass but the last draws into the field of its name, kept
// from frame to frame at the painting's size; the last shows, in the window, else as the painting of its pixels, which it gives. A
// shader reads a field as `$name(at)`, at the pixel `at`: the latest written earlier in the frame, else last frame's,
// so a shader reading its own name reads what it drew the frame before.
// Passes of program functions, `paint([velocity: advect, show])` (lib/shaders.warp function_pass), give a fourth item, the
// size of the field they draw: the fields are made at it, and its functions read them at a cell, `velocity(x, y)`
global painted_fields = {}
paint_passes(passes: list, width: int, height: int) := {
	names = passes.map(pass => pass#1)
	shown = passes.last
	if names[.. #names - 1].any(name => name == "") { raise "each pass before the last draws into a field: fix: name it, `velocity: advect`" }
	size = fields_size(passes, width, height)
	// (a last shader whose field is read draws into it too, then shows it)
	drawn = if passes.any(pass => reads_field(pass#2, shown#1)) then passes else [passes#i for i in 1 ..< #passes]
	fields = fields_kept(drawn.map(pass => pass#1), size#1, size#2)
	for pass in drawn { gpu_pass(fields_placed(pass#2, names, read_scale(pass, size)), fields, pass#1, pass#3) }
	if drawn != passes { shown = [shown#1, fields_placed(shown#2, names, read_scale(shown, size)), shown#3] } else { shown = [shown#1, FIELD_SHOWN.replace(FIELD_HOLE, shown#1), {}] }
	if window_open() or window_possible() { return gpu_show_sized(shown#2, fields, width, height, shown#3) }
	pixels = gpu_picture_sized(shown#2, fields, width, height, shown#3)
	paint(pixels, width, height)
	pixels
}
// the fields of these names at this size, made once
fields_kept(names: list, width: int, height: int): int := {
	key = names.join(" ") + " " + width + "×" + height
	if not painted_fields.has(key) { painted_fields[key] = gpu_fields(width, height, names) }
	painted_fields[key]
}
// the size the fields are made at: the one their functions' passes declare, else the painting's. Declared fields keep
// numbers beyond 0..1, which a GPU storing 8 bits a channel cannot
NARROW_FORMAT = "rgba8unorm"
fields_size(passes: list, width: int, height: int): list := {
	declared = passes.filter(pass => #pass > 3 and pass#4 != ø).map(pass => pass#4)
	if #declared == 0 { return [width, height] }
	if declared.any(size => size != declared#1) { raise "paint's fields share one size; these declare " + declared.map(size => "${size#1}×${size#2}").join(", ") }
	if text(gpu_fields_format()) == NARROW_FORMAT { raise "this GPU keeps a field in 8 bits a channel, too few for numbers beyond 0..1" }
	declared#1
}
// what a pixel `at` is divided by to sample a field: a text shader's `$dye(at)` reads at a pixel of the painting, a
// function's `dye(x, y)` (a pass of four items) at a cell of the fields
read_scale(pass: list, size: list): text := if #pass > 3 then "vec2f(${size#1}.0, ${size#2}.0)" else "values.size"
// a shader's reads of the fields, `values.dye(at)` as its `$dye(at)` was written, as reads of the field at that pixel
FIELD_HOLE = "NAME"
FIELD_SCALE = "SCALE"
FIELD_AT = "\nfn field_NAME_at(at: vec2f) -> vec4f { return field_NAME(at / SCALE); }\n"
FIELD_SHOWN = "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return field_NAME(at.xy / values.size); }"
reads_field(shader: text, name: text): bool := shader.contains("values." + name + "(")
// a read of a field no shader of the list draws is refused, naming the shader to put before it
fields_placed(shader: text, names: list, scale: text): text := {
	placed = shader
	for name in names.filter(name => reads_field(shader, name)) { placed = placed.replace("values." + name + "(", "field_" + name + "_at(") + FIELD_AT.replace(FIELD_HOLE, name).replace(FIELD_SCALE, scale) }
	for rest in placed.split("values.")[1 ..] {
		name = leading_word(rest)
		if name != "" and rest[#name ..].starts_with("(") { raise "$" + name + "(at) reads a field no shader of paint's list draws: fix: put " + name + " in the list before the shader reading it" }
	}
	placed
}
leading_word(t: text): text := {
	end = 0
	while end < #t and is_word_char(t[end]) { end += 1 }
	t[.. end]
}
