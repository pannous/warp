// C functions a program calls through the native warp (notes/warp_host.md): one line each, the C function's
// own shape, `name(parameter: type…): result from 'library'` as lib/math.warp writes them. The pure emitter makes each a
// wasm import of the module 'library' and describes it in the warp.c_functions section (card pure-c-imports); the native warp
// loads the library (c: the process, m: libm, sqlite3: libsqlite3.so.0 or libsqlite3.dylib) and calls the function.
// `import strlen from "c"` takes one line of here, `use c` all of them (core/emitter/c_imports.warp).
// The types are those of a warp.c_functions line (rust-harness:crates/warp-runtime/src/c_signatures.rs):
//   i32 i64 f32 f64   a number of that width
//   text              a warp text, the host's NUL-terminated copy (a `const char *`); as a result, a `char *` read back
//   handle            a C pointer the program holds as an id (`sqlite3 *`, `sqlite3_stmt *`)
//   out               an out-pointer the call fills (`sqlite3 **`): no argument; the first one's pointer is the result
//   void              no result

// Sorted 2026-11-06 (card c-entries-sort). Nothing here is warp's own way of doing a thing: every line is the C
// function as C has it, for programs that call C on purpose (samples/native/c_calls.warp, samples/system/c_lines.warp,
// test/ffi/); where warp has the word itself, the warp word is the one to use. One line per C function: libm's f64
// functions are lib/math.warp's lines (`import sqrt from 'm'` reads them there), puts is the prelude's, isalpha and
// isspace its aliases. Any other C function is one line in the program itself (samples/system/c_lines.warp).

// texts (warp: count, compare, find, uppercase …)
strlen(s: text): i64 from 'c'
strcmp(a: text, b: text): i32 from 'c'
strncmp(a: text, b: text, n: i64): i32 from 'c'
strstr(haystack: text, needle: text): text from 'c'
strchr(s: text, c: i32): text from 'c'
strrchr(s: text, c: i32): text from 'c'
strcspn(s: text, reject: text): i64 from 'c'

// numbers from texts (warp: `as int`, `as float`)
atoi(s: text): i32 from 'c'
atol(s: text): i64 from 'c'
atof(s: text): f64 from 'c'
strtol(s: text, end: out, base: i32): i64 from 'c'
strtod(s: text, end: out): f64 from 'c'

// characters (warp: is_digit and its siblings in lib/prelude.warp)
toupper(c: i32): i32 from 'c'
tolower(c: i32): i32 from 'c'
isdigit(c: i32): i32 from 'c'

// integers and random numbers (warp: abs, random)
abs(x: i32): i32 from 'c'
labs(x: i64): i64 from 'c'
rand(): i32 from 'c'
srand(seed: i32): void from 'c'

// the process and its environment (warp: lib/os.warp)
getenv(name: text): text from 'c'
setenv(name: text, value: text, overwrite: i32): i32 from 'c'
unsetenv(name: text): i32 from 'c'
getpid(): i32 from 'c'
system(command: text): i32 from 'c'
strerror(code: i32): text from 'c'

// files (warp: lib/file.warp)
fopen(path: text, mode: text): handle from 'c'
fclose(file: handle): i32 from 'c'
fputs(s: text, file: handle): i32 from 'c'
fflush(file: handle): i32 from 'c'

// memory a program hands C to fill, and a field of a struct C filled read by its offset and C type (field_*: the
// native warp's own, lib/native/foreign.c): `event = calloc(1, 128)`, `SDL_PollEvent(event)`, `field_u32(event, 0)`
calloc(count: i64, size: i64): handle from 'c'
free(memory: handle): void from 'c'
field_u8(struct: handle, offset: i64): i32 from 'c'
field_i16(struct: handle, offset: i64): i32 from 'c'
field_i32(struct: handle, offset: i64): i32 from 'c'
field_u32(struct: handle, offset: i64): i64 from 'c'
field_i64(struct: handle, offset: i64): i64 from 'c'
field_f32(struct: handle, offset: i64): f64 from 'c'
field_f64(struct: handle, offset: i64): f64 from 'c'
field_pointer(struct: handle, offset: i64): handle from 'c'
field_text(struct: handle, offset: i64): text from 'c'
// a field written so (u32 fields by set_field_i32, which keeps the low 32 bits)
set_field_i32(struct: handle, offset: i64, value: i64): void from 'c'
set_field_i64(struct: handle, offset: i64, value: i64): void from 'c'
set_field_f64(struct: handle, offset: i64, value: f64): void from 'c'
set_field_pointer(struct: handle, offset: i64, pointer: handle): void from 'c'
// a C library's function by its name, as the native warp finds it (lib/native/foreign.c): 0 when the library or the
// function is not there, so a program asks before it calls an optional library (`library_function("SDL3", "SDL_Init")`)
library_function(library: text, name: text): handle from 'c'

// libm's functions lib/math.warp has no line of
ldexp(x: f64, exponent: i32): f64 from 'm'
cbrt(x: f64): f64 from 'm'
sqrtf(x: f32): f32 from 'm'
fabsf(x: f32): f32 from 'm'
ldexpf(x: f32, exponent: i32): f32 from 'm'

// SQLite's functions are in lib/native/sqlite3.warp (`use sqlite3`), other libraries' in lib/native/<library>.warp
