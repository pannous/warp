# The exact reals: `π`, `τ` and their rational multiples and powers, `π/2`, `2π`, `π²`, and the square roots, `√2`,
# `3√2`, `√π`, kept exact and printed so; a float or an unrelated sum makes a float. `∞` is the float infinity, `ℯ`
# Euler's number (decision exact-constants: the parser leaves these words alone, the library gives them their values;
# decision exact-roots: √ is one exact word, a perfect square's root whole, any other root kept)

def float_pi() := 3.141592653589793

# coefficient · √radicand · π^pi_power, the radicand without square factors (real_of)
class Real {
	coefficient: number
	pi_power: number
	radicand: int
	# (a float's operation with it takes this at once, decision float-contagion: no root of 1 nor power of 1 taken)
	def float() := coefficient * (if radicand == 1 then 1.0 else √(radicand as float)) * (if pi_power == 1 then float_pi else float_pi ^ pi_power)
	*(other) := if other is Real then real_of(coefficient * other.coefficient, pi_power + other.pi_power, radicand * other.radicand) else if other is float then float() * other else real_of(coefficient * other, pi_power, radicand)
	# a / (c√r) is a√r / (c·r): the root rises above the fraction line
	/(other) := if other is Real then real_of(coefficient / (other.coefficient * other.radicand), pi_power - other.pi_power, radicand * other.radicand) else if other is float then float() / other else real_of(coefficient / other, pi_power, radicand)
	+(other) := if alike(other) then real_of(coefficient + other.coefficient, pi_power, radicand) else float() + real_float(other)
	-(other) := if alike(other) then real_of(coefficient - other.coefficient, pi_power, radicand) else float() - real_float(other)
	def alike(other) := other is Real and other.pi_power == pi_power and other.radicand == radicand
	def compare(other) := float() - real_float(other)
	# √(c·π^p) of a rational c = n/d is √(n·d)/d · π^(p/2); of a root under it, a fourth root, a float or a fraction of
	# a denominator past largest_shown_denominator the float's
	def root() := {
		if radicand != 1 or coefficient is float or coefficient < 0 { return √float() }
		denominator = denominator_of(coefficient)
		under = coefficient * denominator * denominator
		if under is int then real_of(1 / denominator, pi_power / 2, under) else √float()
	}
	def text() := real_text(coefficient, pi_power, radicand)
	def show() := real_text(coefficient, pi_power, radicand)
}

# a number as an exact real, π to the power 0: `3 as Real`, and a number meeting a real under any operator becomes one
# first, so `3 / π` is 3/π exact (decision as-promotes)
n: number as Real := Real(n, 0, 1)
# the real c·√r·π^p at its simplest: the square factors of r out under the root, a plain number where no π or root is
# left, a float of a float coefficient or a radicand past largest_exact_radicand
def real_of(coefficient: number, pi_power: number, radicand: number) := {
	if coefficient == 0 { return 0 }
	if radicand > largest_exact_radicand { return coefficient * √(radicand as float) * float_pi ^ pi_power }
	parts = square_parts(radicand)
	coefficient = coefficient * parts#1
	if parts#2 == 1 and pi_power == 0 { return coefficient }
	real = Real(coefficient, pi_power, parts#2)
	if coefficient is float then real.float() else real
}
def real_float(x) := if x is Real then x.float() else x
# a root under it past this, a whole number beyond an int, is the float's
largest_exact_radicand = 1000000000000
# [s, r] of n = s²·r, the square factors of the primes up to largest_square_factor taken out, a perfect square whole
largest_square_factor = 100
def square_parts(n: int): list := {
	whole = floor(√(n as float)) as int
	if whole * whole == n { return [whole, 1] }
	outside = 1
	factor = 2
	while factor <= largest_square_factor and factor * factor <= n {
		while n % (factor * factor) == 0 {
			outside *= factor
			n = n /! (factor * factor)
		}
		factor += 1
	}
	[outside, n]
}
# √: a perfect square's root whole, √9 is 3, any other root of an exact number kept, √2, √(3/4) is √3/2; of a float the
# float's (the emitter's √ of a value not known to be a float)
def exact_root(x: any) := if x is Real then x.root() else if x is float then √(x as float) else Real(x, 0, 1).root()

# 2π, 3√2, √π, 3/π, √2/π: the powers of π and the root, a negative power of π below the fraction line; `3 as Real` as
# its number
def real_text(coefficient: number, pi_power: number, radicand: int) := {
	half = not (pi_power is int)
	whole = if half then pi_power - 1 / 2 else pi_power
	inside = (if radicand == 1 then "" else str(radicand)) + (if half then "π" else "")
	radical = if inside == "" then "" else if radicand != 1 and half then "√(" + inside + ")" else "√" + inside
	if whole < 0 { return inverse_text(coefficient, pi_power_text(-whole), radical) }
	power = (if whole == 0 then "" else pi_power_text(whole)) + radical
	if power == "" then str(coefficient) else coefficient_text(coefficient, power)
}
def pi_power_text(pi_power: int) := if pi_power == 1 then "π" else "π^" + str(pi_power)
def inverse_text(coefficient: number, power: text, radical: text) := {
	denominator = denominator_of(coefficient)
	numerator = coefficient * denominator
	above = if radical == "" then str(numerator) else if numerator == 1 then radical else if numerator == -1 then "-" + radical else str(numerator) + radical
	below = if denominator == 1 then power else "(" + str(denominator) + power + ")"
	above + "/" + below
}
# 2π, -π, 3π/4: the coefficient as the fraction it is, its numerator before the power, its denominator after it
def coefficient_text(coefficient: number, power: text) := {
	denominator = denominator_of(coefficient)
	numerator = coefficient * denominator
	over = if denominator == 1 then "" else "/" + str(denominator)
	# a fraction of a larger denominator kept whole ahead of the power: (3481/41375)π, not 3481/41375π
	if not (numerator is int) { return "(" + str(coefficient) + ")" + power }
	if numerator == 1 { return power + over }
	if numerator == -1 { return "-" + power + over }
	str(numerator) + power + over
}
largest_shown_denominator = 10000
# the least whole number making x whole, 1 for a float or a fraction of a larger denominator
def denominator_of(x: number) := {
	denominator = 1
	while not ((x * denominator) is int) and denominator < largest_shown_denominator { denominator += 1 }
	if denominator < largest_shown_denominator then denominator else 1
}

// sin and cos of a whole number of half π exactly, `sin π` is 0, `cos π` -1; of any other real the float's
def sin(x: Real) := if half_turns(x) then half_turns_sine(2 * x.coefficient) else sin(x.float())
def cos(x: Real) := if half_turns(x) then half_turns_sine(2 * x.coefficient + 1) else cos(x.float())
def half_turns(x: Real) := x.pi_power == 1 and x.radicand == 1 and (2 * x.coefficient) is int
// sin(n·π/2): 0, 1, 0, -1 around the circle
def half_turns_sine(n: int) := [0, 1, 0, -1][((n % 4) + 4) % 4]
// the other real functions of lib/math.warp the float's: tan(π/6), the camera's field of view in samples/gpu/ocean.warp
def tan(x: Real) := tan(x.float())
def exp(x: Real) := exp(x.float())

π() := Real(1, 1, 1)
def pi() := π
τ() := Real(2, 1, 1)
def tau() := τ
∞() := 1.0 / 0.0
ℯ() := 2.718281828459045
def euler() := ℯ
