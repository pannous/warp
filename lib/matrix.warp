// The standard library matrix module (notes/stdlib.md): `use matrix`. A matrix is a list of rows: m[i][j] (m#i#j)
// reads and writes an element, printing and equality are those of lists
# TODO Implement as class with operator overload  (card matrix-class)
# (the vectors' dot product is math's)
use math
def matrix(r, c, f) := [[f() for j in 1 to c] for i in 1 to r]
def filled_matrix(r, c, v) := [[v for j in 1 to c] for i in 1 to r]
def zeros(r, c) := filled_matrix(r, c, 0)
def ones(r, c) := filled_matrix(r, c, 1)
def random_matrix(r, c) := [[random() for j in 1 to c] for i in 1 to r]
def identity(n) := [[if i == j then 1 else 0 for j in 1 to n] for i in 1 to n]
def rows(m) := count(m)
def cols(m) := count(m#1)
def shape(m) := [rows(m), cols(m)]
def transpose(m) := [[m#i#j for i in 1 to rows(m)] for j in 1 to cols(m)]
def map_matrix(m, f) := [[f(x) for x in row] for row in m]
def matrix_add(a, b) := [[a#i#j + b#i#j for j in 1 to cols(a)] for i in 1 to rows(a)]
def scale(m, k) := map_matrix(m, x => k * x)
def matmul(a, b) := [[sum([a#i#k * b#k#j for k in 1 to cols(a)]) for j in 1 to cols(b)] for i in 1 to rows(a)]
