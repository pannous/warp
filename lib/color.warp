// The standard library module color (decision implicit-standard-words): a color is a number 0xAARRGGBB of its own type,
// a cheap class (extensions/int_types/classes.warp, decision int-types-are-classes) that prints as its name or as CSS
// writes it, #RRGGBB or #RRGGBBAA, and says `c as int` where its number is meant; the named colors, rgb, hsv,
// with_alpha and alpha_of; draw paints them
use math
type Color = int
opaque = 0xFF000000
// a number as a color, color(0xFF8000) or 0xFF8000 as Color, read as CSS reads hex (decision color-text-css): six
// digits are opaque, eight end in their alpha (0xFF800080 is half transparent); a fully transparent one is
// with_alpha(c, 0). A value computed, `(…) as Color`, is already a color's number
color(n: int): Color := (if n <= 0xFFFFFF then opaque + n else (n % 256) * 16777216 + n /! 256) as Color
rgb(n: int): Color := color(n)
// a CSS hex text as its color: color("#0000ff"), color("#0000ff80") with its alpha last, the short color("#00f")
color(css: text): Color := {
	digits = if css.starts_with("#") then css[1..] else css
	if #digits == 3 or #digits == 4 { digits = join([c + c for c in digits], "") }
	if not is_hex(digits) or not (#digits == 6 or #digits == 8) { raise "not a CSS hex color: " + css }
	n = from_base(digits, 16)
	(if #digits == 6 then opaque + n else (n % 256) * 16777216 + n /! 256) as Color
}
n: int as Color := color(n)
black = 0x000000 as Color
white = 0xFFFFFF as Color
gray = 0x808080 as Color
red = 0xFF0000 as Color
green = 0x00A000 as Color
blue = 0x0000FF as Color
yellow = 0xFFD700 as Color
orange = 0xFF8C00 as Color
purple = 0x8000C0 as Color
hex_digits = "0123456789ABCDEF"

// each named color with its name
named_colors = [[black, "black"], [white, "white"], [gray, "gray"], [red, "red"], [green, "green"], [blue, "blue"], [yellow, "yellow"], [orange, "orange"], [purple, "purple"]]
// red, else its hex text #RRGGBB
format Color c as text := {
	for pair in named_colors { if pair[0] == c { return pair[1] } }
	hex_text(c)
}
// the color named so, ø for no named color
color_named(name: text): any := {
	for pair in named_colors { if pair[1] == name { return pair[0] } }
	ø
}
// [red, green, blue], each from 0 to 1, as a painted pixel takes them (lib/shaders.warp)
channels(c: Color): list := [16, 8, 0].map(shift => float(channel_byte(c, shift)) / 255)
// the byte of 0xAARRGGBB at the shift: 24 its alpha, 16 red, 8 green, 0 blue
channel_byte(c: Color, shift: int): int := ((c as int) >> shift) % 256
channel_shifts = [24, 16, 8, 0]
// the color t of the way from a to b, each channel and the alpha alike: mix(red, blue) is #800080
mix(a: Color, b: Color, t: float = 0.5): Color := sum(channel_shifts.map(shift => (round(lerp(channel_byte(a, shift), channel_byte(b, shift), t)) as int) << shift)) as Color
// light adding (decision color-light-adding): red + blue is #FF00FF, each channel summed and capped at 255, `-` floored
// at 0, a color times a number scales its channels; the left color keeps its alpha
+(a: Color, b: Color): Color := channels_made(a, shift => channel_byte(a, shift) + channel_byte(b, shift))
-(a: Color, b: Color): Color := channels_made(a, shift => channel_byte(a, shift) - channel_byte(b, shift))
*(c: Color, f: number): Color := channels_made(c, shift => round(channel_byte(c, shift) * f) as int)
// a's alpha and each of red, green and blue the byte gives for its shift, kept from 0 to 255
channels_made(a: Color, byte: function): Color := ((alpha_of(a) << 24) + sum([16, 8, 0].map(shift => (clamp(byte(shift), 0, 255) as int) << shift))) as Color
// #FF0000, and #FF000080 when not opaque, its alpha last as in CSS (decision color-text-css)
hex_text(c: Color): text := "#" + padded_hex((c as int) % 16777216, 6) + (if alpha_of(c) == 255 then "" else padded_hex(alpha_of(c), 2))
// the number 0xAARRGGBB itself
hex(c: Color): int := c as int
// the low digits of n in upper-case hexadecimal, zeros in front
padded_hex(n: any, digits: any): text := join([hex_digits[(n >> 4 * (digits - 1 - i)) % 16] for i in 0..digits], "")
// r, g, b from 0 to 255
rgb(r: any, g: any, b: any): Color := (opaque + (round(r) as int) * 65536 + (round(g) as int) * 256 + (round(b) as int)) as Color
// hue in degrees, saturation and value from 0 to 1
hsv(h: any, s: any, v: any): Color := {
	hue = (h % 360) / 60.0
	c = v * s
	x = c * (1 - abs(hue % 2 - 1))
	m = v - c
	sector = floor(hue) as int
	r = if sector == 0 or sector == 5 then c else if sector == 1 or sector == 4 then x else 0.0
	g = if sector == 1 or sector == 2 then c else if sector == 0 or sector == 3 then x else 0.0
	b = if sector == 3 or sector == 4 then c else if sector == 2 or sector == 5 then x else 0.0
	rgb((r + m) * 255, (g + m) * 255, (b + m) * 255)
}
// alpha from 0 (invisible) to 1 (opaque)
with_alpha(color: any, alpha: any): Color := ((round(clamp(alpha, 0, 1) * 255) as int) * 16777216 + (color as int) % 16777216) as Color
alpha_of(color: any): int := (color as int) /! 16777216
