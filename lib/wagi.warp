// The standard library module wagi (card fermyon-hosting, notes/hosting.md "Fermyon"): `warp build --wagi` makes a
// program's routes answer one request the WAGI way (Spin's wagi executor, Akamai Functions): the request comes in the
// environment (REQUEST_METHOD, PATH_INFO, QUERY_STRING), the answer goes CGI-style to stdout: headers, a blank line, the
// body. A text answers as text, anything else as JSON, as `warp serve` answers (src/web/web_server.rs Answer::of).
// A route's `status 418` and `header "name" "value"` (card wagi-build, lowering/serve.rs with_answer_headers) are
// wagi_header calls: the answer carries them. Not yet: request bodies (stdin), percent-decoded query values.

// the answer's status and its other header lines, as the route set them; a set Content-Type replaces the answer's own
global wagi_status = 200
global wagi_content_type = ""
global wagi_header_lines = ""

wagi_header(name: any, value: any) := {
	let field = lower(str(name))
	if field == "status" { wagi_status = value }
	else if field == "content-type" { wagi_content_type = str(value) }
	else { wagi_header_lines = wagi_header_lines + "\n" + str(name) + ": " + str(value) }
}

wagi_variable(name: any) := {
	for entry in split(wasi_environment(), chr(0)) {
		if starts_with(entry, name + "=") { return entry[count(name) + 1:] }
	}
	""
}

wagi_query(query: any) := {
	var fields = {}
	for part in split(query, "&") {
		if part != "" {
			let pair = split(part, "=")
			fields[pair#1] = if count(pair) > 1 then pair#2 else ""
		}
	}
	fields
}

wagi_request() := {method: wagi_variable("REQUEST_METHOD"), path: wagi_variable("PATH_INFO"), query: wagi_query(wagi_variable("QUERY_STRING")), body: ""}

wagi_json_text(t: any) := {
	var out = "\""
	for c in t {
		if c == "\"" { out = out + "\\\"" }
		else if c == "\\" { out = out + "\\\\" }
		else if c == "\n" { out = out + "\\n" }
		else if c == "\t" { out = out + "\\t" }
		else { out = out + c }
	}
	out + "\""
}

// a map (`{n: 1, k: 2}` in a route) is a list of pairs; ["a", "b"] holds none
wagi_holds_pairs(value: any) := {
	for item in value { if item is pair { return true } }
	false
}

wagi_json_fields(value: any) := {
	let names = keys(value)
	let items = values(value)
	var fields = []
	for index in 1 to count(names) { fields = fields + [wagi_json_text(str(names#index)) + ":" + wagi_json(items#index)] }
	"{" + join(fields, ",") + "}"
}

wagi_json(value: any) := {
	if value == ø { return "null" }
	if value is bool { return if value then "true" else "false" }
	if value is number { return str(value) }
	if value is text { return wagi_json_text(value) }
	if value is pair or wagi_holds_pairs(value) { return wagi_json_fields(value) }
	if value is list or value is map { return "[" + join([wagi_json(item) for item in value], ",") + "]" }
	wagi_json_text(str(value))
}

wagi_reply(status: any, content_type: any, body: any) := puts "Status: " + str(status) + "\nContent-Type: " + content_type + "\n\n" + body

// the route's value with the status and headers it set
wagi_answer(value: any) := {
	let own_type = if value is text then "text/plain; charset=utf-8" else "application/json"
	let content_type = if wagi_content_type == "" then own_type else wagi_content_type
	let body = if value is text then value else wagi_json(value)
	puts "Status: " + str(wagi_status) + "\nContent-Type: " + content_type + wagi_header_lines + "\n\n" + body
}

// lowering/serve.rs page·submitted throws "no route answers …" for a request no route takes
wagi_failed(message: any) := wagi_reply(if starts_with(message, "no route answers") then 404 else 500, "text/plain; charset=utf-8", message)
