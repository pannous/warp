// The standard library module wagi (card fermyon-hosting, notes/hosting.md "Fermyon"): `warp build --wagi` makes a
// program's routes answer one request the WAGI way (Spin's wagi executor, Akamai Functions): the request comes in the
// environment (REQUEST_METHOD, PATH_INFO, QUERY_STRING), the answer goes CGI-style to stdout: headers, a blank line, the
// body. A text answers as text, anything else as JSON, as `warp serve` answers (rust-harness:src/web/web_server.rs Answer::of).
// A route's `status 418` and `header "name" "value"` (card wagi-build) are lib/router.warp's answer state: the answer
// carries them. Not yet: request bodies (stdin), percent-decoded query values.
use router

def wagi_variable(name: any) := {
	for entry in split(wasi_environment(), chr(0)) {
		if starts_with(entry, name + "=") { return entry[count(name) + 1:] }
	}
	""
}

def wagi_query(query: any) := {
	var fields = {}
	for part in split(query, "&") {
		if part {
			let pair = split(part, "=")
			fields[pair#1] = if count(pair) > 1 then pair#2 else ""
		}
	}
	fields
}

def wagi_request() := {method: wagi_variable("REQUEST_METHOD"), path: wagi_variable("PATH_INFO"), query: wagi_query(wagi_variable("QUERY_STRING")), body: ""}

def wagi_json_text(t: any) := {
	var out = "\""
	for c in t {
		if c == "\"" { out = out + "\\\"" }
		else if c == "\\" { out = out + "\\\\" }
		else if c == "\n" { out = out + "\\n" }
		else if c == "\t" { out = out + "\\t" }
		else { out = out + c }
	}
	out + "\""
}

// a map (`{n: 1, k: 2}` in a route) is a list of pairs; ["a", "b"] holds none
def wagi_holds_pairs(value: any) := {
	for item in value { if item is pair { return true } }
	false
}

def wagi_json_fields(value: any) := {
	let names = keys(value)
	let items = values(value)
	var fields = []
	for index in 1 to count(names) { fields = fields + [wagi_json_text(str(names#index)) + ":" + wagi_json(items#index)] }
	"{" + join(fields, ",") + "}"
}

def wagi_json(value: any) := {
	if value == ø { return "null" }
	if value is bool { return if value then "true" else "false" }
	if value is number { return str(value) }
	if value is text { return wagi_json_text(value) }
	if value is pair or wagi_holds_pairs(value) { return wagi_json_fields(value) }
	if value is list or value is map { return "[" + join([wagi_json(item) for item in value], ",") + "]" }
	wagi_json_text(str(value))
}

def wagi_reply(status: any, content_type: any, body: any) := puts "Status: " + str(status) + "\nContent-Type: " + content_type + "\n\n" + body

// the route's value with the status and headers it set
def wagi_answer(value: any) := puts "Status: " + str(answer_status) + "\n" + wagi_headers(value) + "\n\n" + wagi_body(value)
// its header lines, Content-Type first, and its body (also lib/web.warp's HTTP answer)
def wagi_headers(value: any) := {
	let own_type = if value is text then "text/plain; charset=utf-8" else "application/json"
	"Content-Type: " + (if answer_content_type is empty then own_type else answer_content_type) + answer_header_lines
}
def wagi_body(value: any) := if value is text then value else wagi_json(value)

// lowering/serve.rs page·submitted throws "no route answers …" for a request no route takes
def wagi_failed(message: any) := wagi_reply(if starts_with(message, "no route answers") then 404 else 500, "text/plain; charset=utf-8", message)
