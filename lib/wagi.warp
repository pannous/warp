// The standard library module wagi (card fermyon-hosting, notes/hosting.md "Fermyon"): `warp build --wagi` makes a
// program's routes answer one request the WAGI way (Spin's wagi executor, Akamai Functions): the request comes in the
// environment (REQUEST_METHOD, PATH_INFO, QUERY_STRING), the answer goes CGI-style to stdout: headers, a blank line, the
// body. A text answers as text, anything else as JSON, as `warp serve` answers (rust-harness:src/web/web_server.rs Answer::of).
// A route's `status 418` and `header "name" "value"` (card wagi-build) are lib/router.warp's answer state: the answer
// carries them. Not yet: request bodies (stdin).
use router

wagi_variable(name: any) := {
	for entry in split(wasi_environment(), chr(0)) {
		if starts_with(entry, name + "=") { return entry[count(name) + 1:] }
	}
	""
}

wagi_query(query: any) := {
	var fields = {}
	for part in split(query, "&") {
		if part {
			let pair = split(part, "=")
			fields[url_decoded(pair#1)] = if count(pair) > 1 then url_decoded(pair[1 ..].join("=")) else ""
		}
	}
	fields
}

// a query's or form's name or value as sent: `+` a space, `%XX` its byte, the bytes read as UTF-8 ("caf%C3%A9" is "café")
url_decoded(t: any) := {
	if not (t.contains("%") or t.contains("+")) { return t }
	sent = bytes(t)
	decoded = []
	at = 1
	while at <= count(sent) {
		if sent#at == PERCENT_BYTE and at + 2 <= count(sent) {
			decoded = decoded + [hex_value(sent#(at + 1)) * 16 + hex_value(sent#(at + 2))]
			at = at + 3
		} else {
			decoded = decoded + [if sent#at == PLUS_BYTE then SPACE_BYTE else sent#at]
			at = at + 1
		}
	}
	utf8_text(decoded)
}
PERCENT_BYTE = 37
PLUS_BYTE = 43
SPACE_BYTE = 32
hex_value(byte: int) := if byte >= 97 then byte - 87 else if byte >= 65 then byte - 55 else byte - 48
// the text of UTF-8 bytes: a lead byte's high bits say how many continuation bytes follow, each giving 6 bits
utf8_text(bytes: list) := {
	out = ""
	at = 1
	while at <= count(bytes) {
		lead = bytes#at
		width = if lead < 128 then 1 else if lead >= 240 then 4 else if lead >= 224 then 3 else 2
		code = if width == 1 then lead else lead % (1 << (7 - width))
		for k in 1 to width - 1 { code = code * 64 + bytes#(at + k) % 64 }
		out = out + chr(code)
		at = at + width
	}
	out
}

wagi_request() := {method: wagi_variable("REQUEST_METHOD"), path: wagi_variable("PATH_INFO"), query: wagi_query(wagi_variable("QUERY_STRING")), body: ""}

wagi_json_text(t: any) := {
	var out = "\""
	for c in t {
		if c == "\"" { out = out + "\\\"" }
		else if c == "\\" { out = out + "\\\\" }
		else if c == "\n" { out = out + "\\n" }
		else if c == "\t" { out = out + "\\t" }
		else { out = out + c }
	}
	out + "\""
}

// a map (`{n: 1, k: 2}` in a route) is a list of pairs; ["a", "b"] holds none
wagi_holds_pairs(value: any) := {
	for item in value { if item is pair { return true } }
	false
}

wagi_json_fields(value: any) := {
	let names = keys(value)
	let items = values(value)
	var fields = []
	for index in 1 to count(names) { fields = fields + [wagi_json_text(str(names#index)) + ":" + wagi_json(items#index)] }
	"{" + join(fields, ",") + "}"
}

wagi_json(value: any) := {
	if value == ø { return "null" }
	if value is bool { return if value then "true" else "false" }
	if value is number { return str(value) }
	if value is text { return wagi_json_text(value) }
	if value is pair or wagi_holds_pairs(value) { return wagi_json_fields(value) }
	if value is list or value is map { return "[" + join([wagi_json(item) for item in value], ",") + "]" }
	wagi_json_text(str(value))
}

wagi_reply(status: any, content_type: any, body: any) := puts "Status: " + str(status) + "\nContent-Type: " + content_type + "\n\n" + body

// the route's value with the status and headers it set
wagi_answer(value: any) := puts "Status: " + str(answer_status) + "\n" + wagi_headers(value) + "\n\n" + wagi_body(value)
// its header lines, Content-Type first, and its body (also lib/web.warp's HTTP answer)
wagi_headers(value: any) := {
	let own_type = if value is text then "text/plain; charset=utf-8" else "application/json"
	"Content-Type: " + (if answer_content_type is empty then own_type else answer_content_type) + answer_header_lines
}
wagi_body(value: any) := if value is text then value else wagi_json(value)

// lowering/serve.rs page·submitted throws "no route answers …" for a request no route takes
wagi_failed(message: any) := wagi_reply(if starts_with(message, "no route answers") then 404 else 500, "text/plain; charset=utf-8", message)
