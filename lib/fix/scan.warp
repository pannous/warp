# What each character of a line of warp source is, for the fix rules (as rust-harness:src/formatting/lines.rs scans it): code, a
# text's or a comment's. A text or a block comment that is still open carries over to the next line.
code_mark = "c"
text_mark = "t"
comment_mark = "m"
# nothing open at a line's end
in_code = ""
quotes = ["\"", "'", "`"]
# `/* … */` and `/# … #/`: the opening and its closing
block_comments = [["/*", "*/"], ["/#", "#/"]]
# `#use lib`, `#include x`: a directive at the line start is a comment too
directives = ["use", "include", "import"]
openers = ["(", "[", "{"]
closers = [")", "]", "}"]

# a line, one mark per character, where its comment to the line end starts (-1: none) and what is open at its start
# and its end: in_code, a quote or a block comment's closing
class Scanned { text: text; marks: text; comment: int; starts_inside: text; ends_inside: text }

# the character at index i, "" outside the line
def at(cs: list, i: int): text := if i >= 0 and i < #cs then "" + cs[i] else ""
# the n characters from index i
def piece(cs: list, i: int, n: int): text := {
	result = ""
	for k in 0 ..< n { result += at(cs, i + k) }
	result
}

def is_blank_character(c: text): bool := c == " " or c == "\t"
def is_word_character(c: text): bool := c != "" and (is_alphanumeric(c[0]) or c == "_")
def is_digit_character(c: text): bool := c != "" and is_digit(c[0])

# `//` or `#` starting a comment at index i: `//` anywhere but in a URL's `://`; `#` at the line start or after a
# blank, before a blank, `!`, `#` or the end (`# note`, `#!`, `##`), or a directive. `xs#1` and `#xs` are code
def starts_line_comment(cs: list, i: int): bool := {
	if piece(cs, i, 2) == "//" { return at(cs, i - 1) != ":" }
	if at(cs, i) != "#" { return no }
	if i > 0 and not is_blank_character(at(cs, i - 1)) { return no }
	next = at(cs, i + 1)
	if next == "" or next == " " or next == "!" or next == "#" { return yes }
	before = piece(cs, 0, i).trim()
	before == "" and directives.any(word => piece(cs, i + 1, #word) == word)
}

# the block comment opened at index i, its closing; "" when none opens there
def block_opened(cs: list, i: int): text := {
	two = piece(cs, i, 2)
	for pair in block_comments { if pair[0] == two { return pair[1] } }
	""
}

# the scan of every line, carrying texts and block comments from line to line
def scanned(lines: list): list := {
	result = []
	inside = in_code
	for line in lines {
		cs = chars(line)
		starts = inside
		marks = ""
		comment = -1
		i = 0
		while i < #cs {
			c = at(cs, i)
			if inside == in_code {
				closing = block_opened(cs, i)
				if c in quotes {
					inside = c
					marks += text_mark
					i += 1
				} else if closing != "" {
					inside = closing
					marks += comment_mark + comment_mark
					i += 2
				} else if starts_line_comment(cs, i) {
					comment = i
					while i < #cs { marks += comment_mark; i += 1 }
				} else {
					marks += code_mark
					i += 1
				}
			} else if #inside == 1 {
				if c == "\\" and i + 1 < #cs {
					marks += text_mark + text_mark
					i += 2
				} else {
					if c == inside { inside = in_code }
					marks += text_mark
					i += 1
				}
			} else if piece(cs, i, #inside) == inside {
				for k in 0 ..< #inside { marks += comment_mark }
				i += #inside
				inside = in_code
			} else {
				marks += comment_mark
				i += 1
			}
		}
		result += [Scanned(line, marks, comment, starts, inside)]
	}
	result
}

# whether the character at index i of the scanned line is code
def is_code(line: Scanned, i: int): bool := i >= 0 and i < #line.marks and line.marks[i] == code_mark
