# The rewrites of warp fix: hints, each naming what is written at a place and the warp spelling meant there, which the
# fix applies. They read the text only (as rust-harness:src/formatting/synonyms.rs's I-meant rewrites, without the compiler).
use "scan.warp"

# what is written at a line's column (from 0), the text meant instead, and the rule that says so; the finders below give
# a Hint or ø, their `: Hint?` unwritten while the Rust lane misreads `f(line: Scanned): Hint?` (line read as a key)
class Hint { line_number: int; column: int; written: text; replacement: text; rule: text }

# `ys = float[2]` → `ys = 2 floats`: the element type of a list of n zeros, of these types (`ys = 2 floats` runs by
# lib/prelude.warp's rewrite)
counted_types = ["int", "float"]
# `auto x = 3` (C++) → `var x = 3`
foreign_words = [["auto", "var"]]
# `7 div 2` (Pascal) → `7 /! 2`: floor division is `/!` (decision floor-division)
floor_division = "/!"
floor_division_words = ["div"]
# `alias acos = arc_cosine` → `alias acos => arc_cosine`: an alias says its direction (decision alias-arrows)
alias_word = "alias"
alias_arrow = "=>"
# `t.codepoints > 3` → `count t.codepoints > 3`; `t.bytes == 5` → `t.bytecount == 5` (decision text-unit-plurals)
unit_list_words = ["codepoints", "graphemes"]
unit_bytes_word = "bytes"
unit_count_words = unit_list_words + [unit_bytes_word]
# compare / arithmetic that read the field as a number (not bare `=` assignment)
numeric_op_starts = ["+", "-", "*", "/", "%", "<", ">", "=", "!"]

# every hint of the scanned lines, in the order of the source
hints_of(lines: list): list := {
	hints = []
	for k in 0 ..< #lines {
		hints += hints_of_line(lines[k], k + 1)
	}
	hints
}

hints_of_line(line: Scanned, number: int): list := {
	cs = chars(line.text)
	hints = []
	depth = 0
	i = 0
	while i < #cs {
		c = at(cs, i)
		if is_code(line, i) and c == "(" { depth += 1 }
		if is_code(line, i) and c == ")" { depth -= 1 }
		if is_code(line, i) and is_word_character(c) and not is_word_character(at(cs, i - 1)) {
			word = word_at(cs, i)
			hint = word_hint(line, cs, i, word, number, depth)
			if hint != ø { hints += [hint] }
			i += #word
		} else {
			if i == line.comment {
				hint = floor_division_hint(cs, i, number)
				if hint != ø { hints += [hint] }
			}
			i += 1
		}
	}
	hints
}

# the word starting at index i
word_at(cs: list, i: int): text := {
	n = 0
	while is_word_character(at(cs, i + n)) { n += 1 }
	piece(cs, i, n)
}

# the hint on a word: a counted type, another language's word, a floor division word; ø when none
word_hint(line: Scanned, cs: list, i: int, word: text, number: int, depth: int) := {
	if word in counted_types and depth == 0 { return counted_type_hint(line, cs, i, word, number) }
	if word == alias_word and starts_statement(cs, i) { return alias_arrow_hint(cs, i + #word, number) }
	for pair in foreign_words {
		if word == pair[0] and starts_statement(cs, i) and is_word_character(character_after_blanks(cs, i + #word)) and is_blank_character(at(cs, i + #word)) {
			return Hint(number, i, word, pair[1], word + " is " + pair[1])
		}
	}
	if word in floor_division_words and is_blank_character(at(cs, i - 1)) and is_blank_character(at(cs, i + #word)) {
		before = character_before_blanks(cs, i)
		after = character_after_blanks(cs, i + #word)
		if is_word_character(before) or before == ")" {
			if is_word_character(after) or after == "(" { return Hint(number, i, word, floor_division, "floor division " + floor_division) }
		}
	}
	if word in unit_count_words { return unit_count_hint(cs, i, word, number) }
	ø
}

# `float[2]` declared or assigned (`ys : float[2]`, `ys = float[2]`) is `2 floats`; `xs[2]`, `text[2]`, `int[]`, a
# count that is no number, and a parameter's type stay
counted_type_hint(line: Scanned, cs: list, i: int, word: text, number: int) := {
	if at(cs, i - 1) == "." { return ø }
	open = i + #word
	if at(cs, open) != "[" { return ø }
	n = 0
	while is_digit_character(at(cs, open + 1 + n)) { n += 1 }
	if n == 0 or at(cs, open + 1 + n) != "]" { return ø }
	end = open + 2 + n
	if at(cs, end) == "[" or at(cs, end) == "(" or is_word_character(at(cs, end)) { return ø }
	sign = i - 1 - blanks_before(cs, i)
	if not (at(cs, sign) in [":", "="]) or at(cs, sign - 1) in [":", "=", "!", "<", ">"] { return ø }
	count = piece(cs, open + 1, n)
	Hint(number, i, piece(cs, i, end - i), count + " " + word + "s", word + "[n] is n " + word + "s")
}

# the `=` of `alias name = word` (from index i, after the keyword) as the arrow; `alias = 3`, `==` and `=>` stay
alias_arrow_hint(cs: list, i: int, number: int) := {
	at_name = i + blanks_after(cs, i)
	name = word_at(cs, at_name)
	if #name == 0 { return ø }
	sign = at_name + #name + blanks_after(cs, at_name + #name)
	if at(cs, sign) != "=" or at(cs, sign + 1) in ["=", ">"] { return ø }
	Hint(number, sign, "=", alias_arrow, "an alias says its direction: " + alias_arrow)
}

# `t.codepoints` / `t.graphemes` / `t.bytes` read as a number → `count t.codepoints` / `t.bytecount`
unit_count_hint(cs: list, i: int, word: text, number: int) := {
	if at(cs, i - 1) != "." { return ø }
	dot = i - 1
	recv = receiver_start(cs, dot)
	if recv < 0 { return ø }
	if already_counted_unit(cs, recv) { return ø }
	if listish_after_unit(cs, i + #word) { return ø }
	if not numeric_unit_context(cs, recv, i + #word) { return ø }
	written = piece(cs, recv, i + #word - recv)
	if word == unit_bytes_word {
		replacement = piece(cs, recv, dot - recv) + ".bytecount"
		return Hint(number, recv, written, replacement, "t.bytes as a number is t.bytecount")
	}
	Hint(number, recv, written, "count " + written, "t." + word + " as a number is count t." + word)
}

# the start of the word right before the `.` at dot; -1 when none (quoted / `)` left for later)
receiver_start(cs: list, dot: int): int := {
	before = at(cs, dot - 1)
	if not is_word_character(before) { return -1 }
	pos = dot - 1
	while is_word_character(at(cs, pos - 1)) { pos -= 1 }
	pos
}

# already `count t.codepoints` (blanks allowed between count and the receiver)
already_counted_unit(cs: list, recv: int): bool := {
	before = character_before_blanks(cs, recv)
	if not is_word_character(before) { return no }
	end = recv - 1 - blanks_before(cs, recv)
	start = end
	while is_word_character(at(cs, start - 1)) { start -= 1 }
	piece(cs, start, end - start + 1) == "count"
}

# list use: another field, index, call — prefer leaving these
listish_after_unit(cs: list, after: int): bool := {
	c = character_after_blanks(cs, after)
	c == "." or c == "[" or c == "("
}

# compare / arithmetic around the field (bare `=` assignment stays a list)
numeric_unit_context(cs: list, recv: int, after: int): bool := {
	if numeric_op_at(cs, after + blanks_after(cs, after)) { return yes }
	before_at = recv - 1 - blanks_before(cs, recv)
	numeric_op_ending_at(cs, before_at)
}

# an operator starting at index i that reads a number (not bare `=` / `+=` …)
numeric_op_at(cs: list, i: int): bool := {
	c = at(cs, i)
	if c == "" or not (c in numeric_op_starts) { return no }
	n = at(cs, i + 1)
	if c == "=" { return n == "=" }  # ==
	if c == "!" { return n == "=" }  # !=
	if c == "<" or c == ">" { return yes }  # < <= > >=
	if c in ["+", "-", "*", "/", "%"] { return n != "=" }  # arithmetic, not += -= …
	no
}

# an operator ending at index i (`==` `!=` `<=` `>=` or a single `+` `-` `*` `/` `%` `<` `>`; not bare `=` / `+=`)
numeric_op_ending_at(cs: list, i: int): bool := {
	if i < 0 { return no }
	c = at(cs, i)
	prev = at(cs, i - 1)
	if c == "=" {
		if prev == "=" or prev == "!" or prev == "<" or prev == ">" { return yes }
		return no
	}
	if c in ["+", "-", "*", "/", "%", "<", ">"] { return yes }
	no
}

# the number of blanks right after index i, from it on
blanks_after(cs: list, i: int): int := {
	n = 0
	while is_blank_character(at(cs, i + n)) { n += 1 }
	n
}

# the number of blanks right before index i
blanks_before(cs: list, i: int): int := {
	n = 0
	while is_blank_character(at(cs, i - 1 - n)) { n += 1 }
	n
}

character_before_blanks(cs: list, i: int): text := at(cs, i - 1 - blanks_before(cs, i))

character_after_blanks(cs: list, i: int): text := at(cs, i + blanks_after(cs, i))

# the word at index i starts a statement: at the line's start or after `;` or `{`
starts_statement(cs: list, i: int): bool := {
	before = character_before_blanks(cs, i)
	before == "" or before == ";" or before == "{"
}

# `7//2` and `x //= 3` meant as floor division (decision floor-division): `//` glued between operands, or before `=`
# after an operand, is `/!`; `x = 7 // note` stays a comment
floor_division_hint(cs: list, i: int, number: int) := {
	if piece(cs, i, 2) != "//" { return ø }
	before = at(cs, i - 1)
	after = at(cs, i + 2)
	operand_before = is_word_character(before) or before == ")"
	if operand_before and (is_word_character(after) or after == "(") {
		return Hint(number, i, "//", floor_division, "floor division " + floor_division)
	}
	operand_before_blanks = is_word_character(character_before_blanks(cs, i)) or character_before_blanks(cs, i) == ")"
	if after == "=" and operand_before_blanks { return Hint(number, i, "//", floor_division, "floor division " + floor_division) }
	ø
}

# the lines with every hint's replacement, the last of a line first so the earlier columns stay
with_hints_applied(texts: list, hints: list): list := {
	result = []
	for k in 0 ..< #texts {
		cs = chars(texts[k])
		line_hints = hints.filter(hint => hint.line_number == k + 1)
		text = texts[k]
		for h in reverse(line_hints) {
			cs = chars(text)
			text = piece(cs, 0, h.column) + h.replacement + piece(cs, h.column + #h.written, #cs - h.column - #h.written)
		}
		result += [text]
	}
	result
}
