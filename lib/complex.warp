// The standard library module complex (card lib-complex): `use complex`, then (3 + 4ⅈ) * (1 + 2ⅈ) is -5+10ⅈ. Build values
// with ⅈ, Complex(re, im), polar(r, theta) or as_complex(x). + - * / and == are the class's operator methods (as in
// uncertain.warp) and take a Complex or a plain number on the right; free functions are complex_… where math already
// has the plain-number name (abs, arg, exp, log, sqrt, pow, sin, cos)
//
// Text form: each part prints as an integer when whole ("3", not "3.0"), else as the float. A zero part is left out
// ("3", "4ⅈ") unless both are zero ("0"); an imaginary part of 1 or -1 prints as "ⅈ" or "-ⅈ"; a negative imaginary
// part takes its own sign ("3-4ⅈ"), a positive one a "+" after a real part ("3+4ⅈ")

// its text names the imaginary part with ⅈ, the unit's own glyph, so a shown 3+4ⅈ reads back as the same number
IMAGINARY_UNIT_GLYPH = "ⅈ"

class Complex {
	re: float
	im: float
	plus(o: any) as Complex := { b = as_complex(o); Complex(re + b.re, im + b.im) }
	minus(o: any) as Complex := { b = as_complex(o); Complex(re - b.re, im - b.im) }
	times(o: any) as Complex := { b = as_complex(o); Complex(re * b.re - im * b.im, re * b.im + im * b.re) }
	divide(o: any) as Complex := {
		b = as_complex(o)
		d = b.re * b.re + b.im * b.im
		if d == 0 { raise "complex: division by zero" }
		Complex((re * b.re + im * b.im) / d, (im * b.re - re * b.im) / d)
	}
	// z² + c (card possible): a whole exponent by repeated multiplication, exact; any other through complex_pow
	power(o: any) as Complex := {
		if o is int and o >= 0 {
			result = Complex(1.0, 0.0)
			for _ in 0..o { result = result * this }
			return result
		}
		complex_pow(this, o)
	}
	// abs(z), its length, as on a number
	abs() as float := sqrt(re * re + im * im)
	equals(o: any) as bool := (o is Complex or o is number) and re == as_complex(o).re and im == as_complex(o).im
	// it shows as 3+4ⅈ, 3-4ⅈ, ⅈ (its text(), print and the value shown)
	format as text := complex_text(this)
}

// a plain number on the left: 3 - ⅈ, 1 / ⅈ, -ⅈ (+ and * take either order through the class's own operators)
infix operator -(a: number, b: Complex) := as_complex(a) - b
infix operator /(a: number, b: Complex) := as_complex(a) / b

// `c: complex`, the type's lowercase name as the other number types are spelled
type complex = Complex
// its real and imaginary parts: re(z), im(z), as z.re, z.im
re(z: Complex) as float := z.re
im(z: Complex) as float := z.im

// ⅈ, the imaginary unit (extensions/glyph_atoms.warp GLYPH_WORDS): -0.8 + 0.156ⅈ
imaginary_unit() as Complex := Complex(0.0, 1.0)
// a Complex or a plain number as a Complex
as_complex(x: any) as Complex := if x is Complex then x else Complex(x * 1.0, 0.0)
// r·e^(iθ)
polar(r: number, theta: number) as Complex := Complex(r * cos(theta), r * sin(theta))
// |z|
complex_abs(z: any) as float := as_complex(z).abs()
// the angle of z in (-π, π]
complex_arg(z: any) as float := { c = as_complex(z); atan2(c.im, c.re) }
// the conjugate re - im·i
conj(z: any) as Complex := { c = as_complex(z); Complex(c.re, -c.im) }
// e^z
complex_exp(z: any) as Complex := { c = as_complex(z); polar(exp(c.re), c.im) }
// the principal logarithm: ln|z| + i·arg z; log 0 raises
complex_log(z: any) as Complex := {
	if complex_abs(z) == 0 { raise "complex: the logarithm of 0" }
	Complex(log(complex_abs(z)), complex_arg(z))
}
// the principal square root: its real part ≥ 0
complex_sqrt(z: any) as Complex := {
	c = as_complex(z)
	r = complex_abs(c)
	a = sqrt((r + c.re) / 2)
	b = sqrt((r - c.re) / 2)
	Complex(a, if c.im < 0 then -b else b)
}
// z^w as e^(w·log z), 0^w is 0 (1 when w is 0)
complex_pow(z: any, w: any) as Complex := {
	if complex_abs(z) == 0 { return if complex_abs(w) == 0 then Complex(1.0, 0.0) else Complex(0.0, 0.0) }
	complex_exp(as_complex(w) * complex_log(z))
}
complex_sin(z: any) as Complex := { c = as_complex(z); Complex(sin(c.re) * cosh(c.im), cos(c.re) * sinh(c.im)) }
complex_cos(z: any) as Complex := { c = as_complex(z); Complex(cos(c.re) * cosh(c.im), -sin(c.re) * sinh(c.im)) }
// z within tolerance of w in both parts
complex_near(z: any, w: any, tolerance: float) as bool := complex_abs(as_complex(z) - as_complex(w)) <= tolerance

complex_part(x: float) as text := if x == floor(x) and abs(x) < 1000000000000000 then text(int(x)) else text(x)
complex_text(z: Complex) as text := {
	if z.im == 0 { return complex_part(z.re) }
	imaginary = if z.im == 1 then IMAGINARY_UNIT_GLYPH else if z.im == -1 then "-" + IMAGINARY_UNIT_GLYPH else complex_part(z.im) + IMAGINARY_UNIT_GLYPH
	if z.re == 0 { return imaginary }
	complex_part(z.re) + (if z.im > 0 then "+" else "") + imaginary
}

// the arithmetic as functions taking a Complex or a plain number on either side: `10 - z` and `10 / z` with a plain
// number on the left trap in the compiler (a core matter), so write csub(10, z) and cdiv(10, z)
cadd(a: any, b: any) as Complex := as_complex(a) + b
csub(a: any, b: any) as Complex := as_complex(a) - b
cmul(a: any, b: any) as Complex := as_complex(a) * b
cdiv(a: any, b: any) as Complex := as_complex(a) / b
