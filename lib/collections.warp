// The standard library module collections (notes/stdlib.md): `use collections`, classes over a list field
// Java's, Python's, Rust's and C#'s names of the classes are alias lines, read as warp's with a note; their names of
// the methods are methods calling warp's

class Stack { items = []
	def push(x) := items.add(x)
	def pop() := items.pop()
	def peek() := items#count(items)
	def size() := count(items)
	def append(x) := push(x)
}
class Queue { items = []
	def init(xs = []) := { items = xs }
	def enqueue(x) := items.add(x)
	def dequeue() := { first = items#1; items = items[1:]; first }
	def peek() := items#1
	def size() := count(items)
	def offer(x) := enqueue(x)
	def poll() := dequeue()
	def shift() := dequeue()
}
alias ArrayDeque = Deque
alias VecDeque = Deque
alias deque = Deque
class Deque { items = []
	def push_back(x) := items.add(x)
	def push_front(x) := { items = [x] + items }
	def pop_back() := items.pop()
	def pop_front() := { first = items#1; items = items[1:]; first }
	def size() := count(items)
	def append(x) := push_back(x)
	def appendleft(x) := push_front(x)
	def pop() := pop_back()
	def popleft() := pop_front()
	def addLast(x) := push_back(x)
	def addFirst(x) := push_front(x)
	def pollLast() := pop_back()
	def pollFirst() := pop_front()
}
alias HashSet = Set
alias TreeSet = Set
alias LinkedHashSet = Set
alias frozenset = Set
class Set { items = []
	def init(xs = []) := { for x in xs { if not (x in items) { items.add(x) } } }
	def add(x) := { if not (x in items) { items.add(x) } }
	def has(x) := x in items
	def remove(x) := { kept = []; for y in items { if y != x { kept.add(y) } }; items = kept }
	def size() := count(items)
	def contains(x) := x in items
	def delete(x) := remove(x)
}
class Counter { keys = []; counts = []
	def init(xs = []) := { for x in xs { add(x) } }
	def add(x) := { i = keys.index_of(x); if i { counts#i += 1 } else { keys.add(x); counts.add(1) } }
	def get(x) := { i = keys.index_of(x); if i { counts#i } else { 0 } }
	def most_common() := { best = 1; for i in 1 to count(counts) { if counts#i > counts#best { best = i } }; keys#best }
}
// warp maps keep insertion order: an ordered map is a map
alias OrderedDict = OrderedMap
alias LinkedHashMap = OrderedMap
OrderedMap() := {}
