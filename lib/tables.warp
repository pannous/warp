// The standard library module tables: `use tables`, texts measured as a terminal shows them and rows as aligned
// tables. display_width("中文") is 4: each character (a grapheme, so a ZWJ emoji sequence or a flag is one) counts
// 2 when it is East Asian Wide or Fullwidth (CJK ideographs, kana, Hangul syllables, fullwidth forms) or an emoji
// (emoji presentation code points, regional indicator flags, any character carrying the selector U+FE0F), 0 when
// it is only zero-width code points (combining marks Mn/Me such as U+0300-036F, ZWSP, ZWJ, ZWNJ, bidi marks,
// variation selectors, the BOM, tags) or a control character, else 1. The ranges are a pragmatic subset of
// Unicode's East Asian Width and emoji data (TABLES_WIDE, TABLES_ZERO below), not the full tables.
// table_text(rows, options) writes rows (lists, or maps whose keys are the headers) in the style "plain", "box" or
// "markdown"; the options are a map: {headers: [...], style: "box", align: "right" or [...] or {column: align},
// max_width: n or [n, ...] per column, width: n for the whole table}. Columns of numbers align right
use text

TABLES_WIDE = [[4352, 4447], [8986, 8987], [9001, 9002], [9193, 9196], [9200, 9200], [9203, 9203], [9725, 9726], [9748, 9749], [9800, 9811], [9855, 9855], [9875, 9875], [9889, 9889], [9898, 9899], [9917, 9918], [9924, 9925], [9934, 9934], [9940, 9940], [9962, 9962], [9970, 9971], [9973, 9973], [9978, 9978], [9981, 9981], [9989, 9989], [9994, 9995], [10024, 10024], [10060, 10060], [10062, 10062], [10067, 10069], [10071, 10071], [10133, 10135], [10160, 10160], [10175, 10175], [11035, 11036], [11088, 11088], [11093, 11093], [11904, 12350], [12353, 13311], [13312, 19903], [19968, 40959], [40960, 42191], [43360, 43391], [44032, 55203], [63744, 64255], [65040, 65049], [65072, 65103], [65280, 65376], [65504, 65510], [126980, 126980], [127183, 127183], [127374, 127374], [127377, 127386], [127462, 127487], [127488, 127743], [127744, 128591], [128640, 128767], [128992, 129003], [129292, 129535], [129648, 129791], [131072, 196605], [196608, 262141]]
TABLES_ZERO = [[0, 31], [127, 159], [768, 879], [1155, 1161], [1425, 1469], [1471, 1471], [1473, 1474], [1476, 1477], [1479, 1479], [1552, 1562], [1611, 1631], [1648, 1648], [1750, 1756], [1759, 1764], [1767, 1768], [1770, 1773], [2304, 2306], [2364, 2364], [2369, 2376], [2381, 2381], [3633, 3633], [3636, 3642], [3655, 3662], [4448, 4607], [6832, 6911], [7616, 7679], [8203, 8207], [8232, 8238], [8288, 8292], [8400, 8447], [65024, 65039], [65056, 65071], [65279, 65279], [917504, 917631], [917760, 917999]]

def tables_in(n: int, ranges: list): bool {
	for r in ranges {
		if n < r[0] { return no }
		if n <= r[1] { return yes }
	}
	no
}
// the columns one character (grapheme) takes
def char_width(c: any): int {
	points = [ord(p) for p in c.codepoints]
	base = points[0]
	if count(points) == 1 and base >= 32 and base < 127 { return 1 }
	if 65039 in points { return 2 }
	visible = [n for n in points if not tables_in(n, TABLES_ZERO)]
	if count(visible) == 0 { return 0 }
	if tables_in(visible[0], TABLES_WIDE) then 2 else 1
}
def display_width(t: any): int {
	sum = 0
	for c in str(t) { sum = sum + char_width(c) }
	sum
}
// t cut to at most `width` columns, ending in … when cut; a wide character never splits
def truncate_display(t: any, width: int): text {
	written = str(t)
	if display_width(written) <= width { return written }
	if width <= 0 { return "" }
	out = ""
	used = 0
	for c in written {
		w = char_width(c)
		if used + w > width - 1 { return out + "…" }
		out = out + c
		used = used + w
	}
	out + "…"
}
// t padded with spaces to `width` columns: align "left", "right" or "center" (its extra space on the right)
def pad_display(t: any, width: int, align: text): text {
	written = str(t)
	gap = width - display_width(written)
	if gap <= 0 { return written }
	if align == "right" { return repeat(" ", gap) + written }
	if align == "center" { return repeat(" ", gap /! 2) + written + repeat(" ", gap - gap /! 2) }
	if align != "left" { raise "pad_display: align is left, right or center, not " + align }
	written + repeat(" ", gap)
}
pad_display(t: any, width: int): text := pad_display(t, width, "left")

// --- tables
// a plain line without the spaces padding its end
def tables_spaceless(t: text): text {
	n = count(t)
	while n > 0 and t[n - 1] == " " { n = n - 1 }
	t[0 ..< n]
}
tables_option(options: map, name: text, otherwise: any): any := if name in options then options[name] else otherwise
tables_number(x: any): bool := x != ø and x is number and not (x is bool)
tables_cell(x: any): text := if x == ø then "" else replace(replace(str(x), "\r\n", " "), "\n", " ")
// the headers of map rows: their keys in the order first seen
def tables_keys(rows: list): list {
	keys = []
	for row in rows { if row != ø and row is map { for k in row.keys { if not (k in keys) { keys.add(k) } } } }
	keys
}
def tables_row(row: any, headers: list, size: int): list {
	if row != ø and row is map { return [if h in row then row[h] else ø for h in headers] }
	values = if row == ø then [] else row
	[if i < count(values) then values[i] else ø for i in 0 ..< size]
}
// a column's alignment: the option (one for all, a list by column, a map by header), else right for numbers
def tables_align(options: map, i: int, header: any, numeric: bool): text {
	choice = tables_option(options, "align", ø)
	picked = if choice == ø then ø else if choice is text then choice else if choice is map then (if header in choice then choice[header] else ø) else (if i < count(choice) then choice[i] else ø)
	if picked != ø then picked else if numeric then "right" else "left"
}
def tables_cap(options: map, i: int): int {
	cap = tables_option(options, "max_width", ø)
	if cap == ø { return 0 }
	if cap is list { return if i < count(cap) and cap[i] != ø then cap[i] else 0 }
	cap
}
def tables_line(cells: list, widths: list, aligns: list, left: text, middle: text, right: text): text {
	parts = [pad_display(cells[i], widths[i], aligns[i]) for i in 0 ..< count(cells)]
	left + join(parts, middle) + right
}
def tables_rule(widths: list, fill: text, left: text, middle: text, right: text): text {
	left + join([repeat(fill, w) for w in widths], middle) + right
}
def tables_markdown_rule(widths: list, aligns: list): text {
	parts = []
	for i in 0 ..< count(widths) {
		w = widths[i]
		a = aligns[i]
		parts.add(if a == "right" then repeat("-", w - 1) + ":" else if a == "center" then ":" + repeat("-", w - 2) + ":" else ":" + repeat("-", w - 1))
	}
	"| " + join(parts, " | ") + " |"
}
def table_text(rows: list, options: map): text {
	style = tables_option(options, "style", "plain")
	if not (style in ["plain", "box", "markdown"]) { raise "table_text: style is plain, box or markdown, not " + str(style) }
	given = tables_option(options, "headers", ø)
	headers = if given != ø then given else tables_keys(rows)
	size = count(headers)
	for row in rows { if row != ø and row is list and count(row) > size { size = count(row) } }
	values = [tables_row(row, headers, size) for row in rows]
	escape = (t => if style == "markdown" then replace(t, "|", "\\|") else t)
	head = [escape(if i < count(headers) then str(headers[i]) else "") for i in 0 ..< size]
	body = [[escape(tables_cell(v)) for v in row] for row in values]
	aligns = []
	widths = []
	for i in 0 ..< size {
		numeric = no
		other = no
		for row in values { if tables_number(row[i]) { numeric = yes } else if row[i] != ø and tables_cell(row[i]) != "" { other = yes } }
		header = if i < count(headers) then headers[i] else ø
		a = tables_align(options, i, header, numeric and not other)
		if not (a in ["left", "right", "center"]) { raise "table_text: align is left, right or center, not " + str(a) }
		aligns.add(a)
		w = if count(headers) > 0 then display_width(head[i]) else 0
		for row in body { w = max(w, display_width(row[i])) }
		cap = tables_cap(options, i)
		if cap > 0 { w = min(w, cap) }
		if style == "markdown" { w = max(w, 3) }
		widths.add(max(w, 1))
	}
	total_cap = tables_option(options, "width", 0)
	frame = if style == "plain" then 2 * (size - 1) else 3 * size + 1
	if total_cap > 0 {
		while sum(widths) + frame > total_cap and max(widths) > (if style == "markdown" then 3 else 1) {
			widest = widths.index_of(max(widths)) - 1
			widths[widest] = widths[widest] - 1
		}
	}
	fit = (cells => [truncate_display(cells[i], widths[i]) for i in 0 ..< size])
	lines = []
	if style == "plain" {
		if count(headers) > 0 { lines.add(tables_spaceless(tables_line(fit(head), widths, aligns, "", "  ", ""))); lines.add(tables_rule(widths, "-", "", "  ", "")) }
		for row in body { lines.add(tables_spaceless(tables_line(fit(row), widths, aligns, "", "  ", ""))) }
	} else if style == "box" {
		lines.add(tables_rule(widths, "─", "┌─", "─┬─", "─┐"))
		if count(headers) > 0 { lines.add(tables_line(fit(head), widths, aligns, "│ ", " │ ", " │")); lines.add(tables_rule(widths, "─", "├─", "─┼─", "─┤")) }
		for row in body { lines.add(tables_line(fit(row), widths, aligns, "│ ", " │ ", " │")) }
		lines.add(tables_rule(widths, "─", "└─", "─┴─", "─┘"))
	} else {
		lines.add(tables_line(fit(head), widths, aligns, "| ", " | ", " |"))
		lines.add(tables_markdown_rule(widths, aligns))
		for row in body { lines.add(tables_line(fit(row), widths, aligns, "| ", " | ", " |")) }
	}
	join(lines, "\n")
}
table_text(rows: list): text := table_text(rows, {})
