// The standard library module hyperreal (wiki/hyperreals.md): ε, the canonical infinitesimal, bigger than 0 and smaller
// than every positive real, and ω = 1/ε, bigger than every real; ε*ω is 1. Written as glyphs they bring this module
// along (extensions/glyph_atoms.warp GLYPH_WORDS), as `use hyperreal` does with epsilon() and omega().
//
// A hyperreal is a finite sum of powers of ε (ω being ε^-1), each times a real: 1+2ε+ε², 3ω-1. + - * and whole powers
// are exact; dividing by a single term (2ε, ω², a number) too, dividing by a sum (1+ε) would need an infinite series
// and raises. Comparison reads the term of the lowest power of ε, the largest one: ω-1000 < ω, 1+ε > 1, π*ε < 4ε.
// A result without ε or ω is the plain number again: ε*ω is 1.

use reals

EPSILON_GLYPH = "ε"
OMEGA_GLYPH = "ω"

// the sum of parts#i·ε^(low+i), i from 0; neither end of parts is zero
class Hyperreal {
	low: int
	parts: list
	plus(o: any): any := { b = as_hyperreal(o); summed(this, b, 1) }
	minus(o: any): any := { b = as_hyperreal(o); summed(this, b, -1) }
	times(o: any): any := {
		b = as_hyperreal(o)
		product = [0 for _ in 0..(#parts + #b.parts - 1)]
		for i in 0..#parts { for j in 0..#b.parts { product[i + j] += parts[i] * b.parts[j] } }
		hyperreal(low + b.low, product)
	}
	divide(o: any): any := {
		b = as_hyperreal(o)
		if #b.parts != 1 { raise "hyperreal: dividing by the sum ${b} has no finite result" }
		divisor = b.parts#1
		hyperreal(low - b.low, parts.map(part => part / divisor))
	}
	// (1+ε)^2, ε^-1: a whole exponent, by repeated multiplication; a negative one divides 1 by it
	power(o: any): any := {
		if not (o is int) { raise "hyperreal: only a whole power of a hyperreal is exact, not ^${o}" }
		result = as_hyperreal(1)
		for _ in 0..abs(o) { result = as_hyperreal(result * this) }
		if o < 0 then 1 / result else result
	}
	less(o: any): bool := leading_sign(this - o) < 0
	greater(o: any): bool := leading_sign(this - o) > 0
	equals(o: any): bool := (o is Hyperreal or o is number) and leading_sign(this - o) == 0
	format as text := hyperreal_text(this)
}

// a plain number on the left: 1/ε, 1000 - ω (+ and * take either order through the class's own operators)
infix operator -(a: number, b: Hyperreal) := as_hyperreal(a) - b
infix operator /(a: number, b: Hyperreal) := as_hyperreal(a) / b

// ε and ω, the glyphs' values
epsilon(): Hyperreal := Hyperreal(1, [1])
omega(): Hyperreal := Hyperreal(-1, [1])

// a Hyperreal or a plain number as a Hyperreal
as_hyperreal(x: any): Hyperreal := if x is Hyperreal then x else Hyperreal(0, [x])

// the sum of parts#i·ε^(low+i) with its zero ends dropped: the plain number when no ε or ω is left
hyperreal(low: int, parts: list): any := {
	first = 0
	while first < #parts and parts[first] == 0 { first += 1 }
	last = #parts
	while last > first and parts[last - 1] == 0 { last -= 1 }
	if first == last { return 0 }
	if last - first == 1 and low + first == 0 { return parts[first] }
	Hyperreal(low + first, parts[first .. last])
}
// a + factor·b, aligned by their powers of ε
summed(a: Hyperreal, b: Hyperreal, factor: int): any := {
	low = min(a.low, b.low)
	high = max(a.low + #a.parts, b.low + #b.parts)
	sums = [0 for _ in low..high]
	for i in 0..#a.parts { sums[a.low - low + i] += a.parts[i] }
	for i in 0..#b.parts { sums[b.low - low + i] += factor * b.parts[i] }
	hyperreal(low, sums)
}
// the sign of its largest term, the one of the lowest power of ε
leading_sign(x: any): int := {
	lead = if x is Hyperreal then x.parts#1 else x
	if lead > 0 then 1 else if lead < 0 then -1 else 0
}
// 1+2ε+ε², 3ω-1: each term with its power of ε or ω, largest first, as it reads back
hyperreal_text(x: Hyperreal): text := {
	shown = ""
	for i in 0..#x.parts {
		part = x.parts[i]
		if part != 0 { shown += term_text(part, x.low + i, shown == "") }
	}
	shown
}
term_text(part: any, power: int, leading: bool): text := {
	glyph = if power < 0 then OMEGA_GLYPH else EPSILON_GLYPH
	unit = if power == 0 then "" else power_text(glyph, abs(power))
	sign = if part < 0 then "-" else if leading then "" else "+"
	amount = if unit != "" and abs(part) == 1 then "" else "${abs(part)}"
	sign + amount + unit
}
