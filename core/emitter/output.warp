# Output (emitter.warp's part): the text a value shows as and print writing it to stdout through WASI's fd_write
# fd_write of the first `count` output bytes, its error code as an int
def write_output(count: list): list {
	word = [op.i32_store, 2, 0]
	iovec = [op.i32_const] + sleb(iovec_address) + [op.i32_const] + sleb(output_address) + word
	iovec += [op.i32_const] + sleb(iovec_address + 4) + count + word
	arguments = [op.i32_const] + sleb(stdout) + [op.i32_const] + sleb(iovec_address) + [op.i32_const, 1, op.i32_const] + sleb(written_address)
	iovec + arguments + call_code(import_index(fd_write_import)) + [op.i64_extend_i32_u]
}
import_index(entry: list): int := {
	index = -1
	for i in 0..<#module.imports { if module.imports[i] == entry { index = i } }
	if index < 0 { refuse("the import " + entry#2 + ", not declared") }
	index
}
# the dispatcher of the program's classes showing their instances by text() (class_methods.warp showing_dispatcher)
instance_text_word = HiddenWord.TextShown as text
instance_show_word = HiddenWord.ShowShown as text
# a value as the text `+` joins it with and print writes
def shown_text(value: TypedCode): TypedCode {
	# a number of a marked type shows by its type's show (int_types.warp), boxed with its mark
	if value.mark != 0 and (value.kind == ValueKind.Int or value.kind == ValueKind.Float) { return shown_text(TypedCode(ValueKind.Node, boxed(value))) }
	kind = value.kind
	if kind == ValueKind.Text { return value }
	if kind == pending { return TypedCode(ValueKind.Text, value.code) }
	if kind == ValueKind.List { return runtime_call("list_text", [value]) }
	if kind == ValueKind.Int { return runtime_call("int_text", [value]) }
	if kind == ValueKind.Float { return runtime_call("float_text", [value]) }
	if kind == ValueKind.Char { return runtime_call("char_text", [value]) }
	# a value that may be an instance of a class showing by its text() (class_methods.warp text·shown)
	if kind == ValueKind.Node and instance_text_word in module.functions { return TypedCode(ValueKind.Text, converted(call_values(module.functions[instance_text_word], [value]), ValueKind.Text)) }
	if kind == ValueKind.Node or kind == ValueKind.Time { return runtime_call("node_text", [value]) }
	if kind != ValueKind.Bool { return refuse("the text of a " + kind_spelling(kind)) }
	TypedCode(ValueKind.Text, value.code + [op.if] + gc_bytes(references.text) + text_value("yes").code + [op.else] + text_value("no").code + [op.end])
}
# a shown result as warp code that reads back (decision shown-warp-notation): a text quoted, a character in single
# quotes, an instance by its class's show(), else as its class and fields, `P{n: 3}` (runtime show.warp key_text);
# `print` writes texts (shown_text)
def shown_code(value: TypedCode): TypedCode {
	kind = value.kind
	if kind == ValueKind.Text { return runtime_call("text_code", [value]) }
	if kind == ValueKind.Node or kind == ValueKind.Char or kind == ValueKind.Time { return runtime_call("value_code", [TypedCode(ValueKind.Node, boxed(value))]) }
	shown_text(value)
}
# what `print` writes: `print a 3` each value as a list shows it, a space between; `print "x is " x "!"`, a text
# first, the values' texts joined without one (Rust's juxtaposed_text; a one-character text is a character)
def printed_value(body: Body, n: Node): TypedCode {
	# `print first xs`: a call of a program function prints its value
	if is_quote(n) or is_spaced_call(body, n) or not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n > 1) { return expression_code(body, n) }
	if n#1 is text and text_value(n#1).kind == ValueKind.Text { return texts_joined(body, items_of(n), "") }
	# `print 1+1 "b"`: numbers, texts and their arithmetic print their texts, a space between (Rust's spaced_values_text)
	if n.all(is_spaced_value) and not items_of(n)[1..].any(is_negative_literal) { return texts_joined(body, items_of(n), " ") }
	runtime_call("items_text", [list_value(body, items_of(n))])
}
# the texts of the values, the separator between
def texts_joined(body: Body, values: list, separator: text): TypedCode {
	printed_text = shown_text(expression_code(body, values#1))
	for x in values[1..] {
		if separator != "" { printed_text = runtime_call("text_join", [printed_text, TypedCode(ValueKind.Text, text_bytes(separator))]) }
		printed_text = runtime_call("text_join", [printed_text, shown_text(expression_code(body, x))])
	}
	printed_text
}
spaced_arithmetic = ["+", "-", "*", "/", "%", "^"]
is_spaced_value(n: Node): bool := {
	if n is number or n is text { return yes }
	if not (type(n) is key and op_of(n) in spaced_arithmetic) { return no }
	(key_of(n) == ø or is_spaced_value(key_of(n))) and (value_of(n) == ø or is_spaced_value(value_of(n)))
}
# `5 -2`: a glued sign, a value of its own
is_negative_literal(n: Node): bool := (n is number and n < 0) or (type(n) is key and op_of(n) == Op.Neg and key_of(n) == ø)
# `print x`: x's text and a newline to stdout, a statement: a body ending in it gives ø, as Rust's print does, and
# a program ending in it prints nothing more (_start)
def printed(value: TypedCode): TypedCode { TypedCode(no_kind, dropped(runtime_call("print_line", [shown_text(value)]))) }
# the export `show`: the text the host prints main's result as, as print shows it (3.5km by a class's text(), π/2).
# It takes main's result as main gives it, a boxed node unless an int or float; one main knows to be a text, list,
# character or bool is shown by that kind's word, so `"hi"` carries no node_text and the texts of every kind
def shown_result(result: ValueKind): any {
	kind = if result == ValueKind.Int or result == ValueKind.Float then result else ValueKind.Node
	f = exported_function("show", [kind], ValueKind.Text)
	f.code = shown_code(unboxed_to_show(TypedCode(kind, [op.local_get, 0]), result)).code
}
# main's value as given, unboxed when main knows its kind to be one shown by that kind's own word
def unboxed_to_show(given: TypedCode, result: ValueKind): TypedCode {
	# main's text is a Text node: its bytes taken unchecked, as text_of_node's check can raise (a program that cannot
	# keeps no error sentences, prebuilt.warp can_raise)
	if result == ValueKind.Text { return TypedCode(result, payload(given.code, gc_type(gc.text))) }
	if result in kinds_shown_unboxed { return TypedCode(result, converted(given, result)) }
	given
}
kinds_shown_unboxed = [ValueKind.Text, ValueKind.List, ValueKind.Char, ValueKind.Bool]
def runtime_call(name: text, values: list): TypedCode { call_values(module.runtime[name], values) }
