# Literals (emitter.warp's part): exact decimals, texts in the data segment, one code point as a character
# a decimal literal: exact, a rational, when it has at most 15 significant digits (0.1 is 1/10, so
# 0.1 + 0.2 == 0.3; 3.0 is the int 3); π's 16 stay a float
exact_decimal_digits = 15
# a decimal stays a ratio of ints while its denominator, 10 to its fraction digits, fits an int64 (10^18); past that the
# parser keeps its digits and big_decimal makes it exact all the same
exact_fraction_digits = 18
exact_decimal(n: float): any := {
	shown = "" + n
	if shown.contains("e") { return ø }
	# a whole decimal shows no point (2.0 as 2): the int it is (decision int-list)
	if not shown.contains(".") { shown += ".0" }
	negative = shown.starts_with("-")
	unsigned = if negative then shown[1..] else shown
	parts = unsigned.split(".")
	digits = parts#1 + parts#2
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	if #significant > exact_decimal_digits or #parts#2 > exact_fraction_digits { return ø }
	numerator = int(digits)
	if negative { numerator = -numerator }
	denominator = 1
	for i in 0..#parts#2 { denominator = denominator * 10 }
	divisor = gcd(numerator, denominator)
	if divisor < 0 { divisor = -divisor }
	if divisor == denominator { return number_value(numerator ÷ divisor) }
	ratio_node([op.i64_const] + sleb(numerator ÷ divisor), [op.i64_const] + sleb(denominator ÷ divisor))
}

# a decimal past 18 places as the parser keeps it, its own digits (decision exact-decimal-big): those digits over
# 10^places, a ratio of a big denominator
big_decimal(written: text): TypedCode := {
	parts = written.split(".")
	needed_call("extended_decimal", [text_value(parts#1 + parts#2), number_value(#parts#2)])
}

# the passive data segment of a text's bytes, each text stored once in a segment of its own, so a trimmer drops the
# texts no code reads (behind the runtime numbered from its segments on)
text_segment(t: text): int := {
	if t not in module.texts { module.texts[t] = module.first_text_segment + #module.texts }
	module.texts[t]
}
# a text as its bytes; one code point as its codepoint, as warp holds a literal "a" (a grapheme of more, "👍🏽", is a text)
one_code_point(t: text): bool := #t == 1 and #codepoints(t) == 1
def text_value(t: text): TypedCode {
	if one_code_point(t) { return TypedCode(ValueKind.Char, [op.i32_const] + sleb(ord(t))) }
	TypedCode(ValueKind.Text, text_bytes(t))
}
def text_bytes(t: text): list {
	code = [op.i32_const, 0, op.i32_const] + sleb(#t.bytes) + segment_read(t)
	# (known as a literal's, so a node of it is made once: emitter.warp literal_node)
	module.literal_texts["${code}"] = t
	code
}
# a text of the bytes of t's segment, from the start and count the code before it leaves
def segment_read(t: text): list := [gc_prefix] + uleb(gc_ops.array_new_data) + relocatable(relocated.types, gc_type(gc.text)) + relocatable(relocated.texts, text_segment(t))

# a data literal of PACKED_DATA_NODES nodes or more in main, `gc_names = [["text", []], …]`: one packed text main
# unpacks (runtime packed_nodes.warp) where the code would build it node by node (card globals-constant-init: warp.wasm's
# main built its 1,189 tables so, 10% of its code)
PACKED_DATA_NODES = 8
def packed_data_value(body: Body, n: Node): any {
	if body.function.name != "main" or module.prebuilding or not module.runtime.has("unpacked_node") { return ø }
	if #nodes_in(n) < PACKED_DATA_NODES { return ø }
	data = literal_data(n)
	if data is ø { return ø }
	value = runtime_call("unpacked_node", [text_value(pack(data))])
	if bracket_of(n) == "[" then TypedCode(ValueKind.List, converted(value, ValueKind.List)) else value
}
# the node a literal of ints, texts, yes/no, lists and maps evaluates to, as the emitter builds it (a text of one code
# point a character), made anew without the parse's positions (`"" + t`: a new text; a list bracketed anew, listed
# by no separator as a literal's); ø for any other form
literal_data(n: Node): Node? := {
	if n is bool { return if n then True else False }
	if n is text or n is number { return literal_atom(n) }
	if not is_group(n) or (bracket_of(n) == "{" and #n == 0) { return ø }
	if bracket_of(n) == "[" { return listed_data(items_of(n).map(literal_data), "[") }
	if bracket_of(n) != "{" or not n.all(is_map_entry) or n.any(entry => key_of(entry) is symbol and name_of(key_of(entry)) in module.classes) { return ø }
	listed_data(items_of(n).map(entry => literal_entry(key_of(entry), literal_data(value_of(entry)))), "{")
}
literal_atom(n: Node): Node? := match n {
	Symbol(name): Symbol("" + name)
	Text(t): if one_code_point(t) then Char(codepoints(t)#1) else Text("" + t)
	Number(value): if value is int then Number(value + 0) else ø
	_: ø
}
literal_entry(name: Node, value: Node?): Node? := if value is ø then ø else Key(literal_atom(name), Op.Colon, value)
listed_data(items: list, bracket: text): Node? := if items.any(item => item is ø) then ø else bracketed(items, bracket)
