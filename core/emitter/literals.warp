# Literals (emitter.warp's part): exact decimals, texts in the data segment, one code point as a character
# a decimal literal as Rust reads it: exact, a rational, when it has at most 15 significant digits (0.1 is 1/10, so
# 0.1 + 0.2 == 0.3; 3.0 is the int 3); π's 16 stay a float (Number::is_exact_decimal)
exact_decimal_digits = 15
exact_decimal(n: float): any := {
	shown = "" + n
	if shown.contains("e") { return ø }
	# a whole decimal shows no point (2.0 as 2): the int it is (decision int-list)
	if not shown.contains(".") { shown += ".0" }
	negative = shown.starts_with("-")
	unsigned = if negative then shown[1..] else shown
	parts = unsigned.split(".")
	digits = parts#1 + parts#2
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	if #significant > exact_decimal_digits { return ø }
	numerator = int(digits)
	if negative { numerator = -numerator }
	denominator = 1
	for i in 0..#parts#2 { denominator = denominator * 10 }
	divisor = gcd(numerator, denominator)
	if divisor < 0 { divisor = -divisor }
	if divisor == denominator { return number_value(numerator / divisor) }
	ratio_node([op.i64_const] + sleb(numerator / divisor), [op.i64_const] + sleb(denominator / divisor))
}

# the passive data segment of a text's bytes, each text stored once in a segment of its own, so a trimmer drops the
# texts no code reads (behind the runtime numbered from its segments on)
text_segment(t: text): int := {
	if t not in module.texts { module.texts[t] = module.first_text_segment + #module.texts }
	module.texts[t]
}
# a text as its bytes; one code point as its codepoint, as warp holds a literal "a" (a grapheme of more, "👍🏽", is a text)
one_code_point(t: text): bool := #t == 1 and #codepoints(t) == 1
def text_value(t: text): TypedCode {
	if one_code_point(t) { return TypedCode(ValueKind.Char, [op.i32_const] + sleb(ord(t))) }
	TypedCode(ValueKind.Text, text_bytes(t))
}
def text_bytes(t: text): list {
	[op.i32_const, 0, op.i32_const] + sleb(#t.bytes) + [gc_prefix] + uleb(gc_ops.array_new_data) + relocatable(relocated.types, gc_type(gc.text)) + relocatable(relocated.texts, text_segment(t))
}
