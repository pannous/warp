# Literals (emitter.warp's part): exact decimals, texts in the data segment, one code point as a character
# a decimal literal as Rust reads it: exact, a rational, when it has at most 15 significant digits (0.1 is 1/10, so
# 0.1 + 0.2 == 0.3; 3.0 is the int 3); π's 16 stay a float (Number::is_exact_decimal)
exact_decimal_digits = 15
# a decimal stays a ratio of ints while its denominator, 10 to its fraction digits, fits an int64 (10^18); past that the
# parser keeps its digits and big_decimal makes it exact all the same
exact_fraction_digits = 18
def exact_decimal(n: float): any := {
	shown = "" + n
	if shown.contains("e") { return ø }
	# a whole decimal shows no point (2.0 as 2): the int it is (decision int-list)
	if not shown.contains(".") { shown += ".0" }
	negative = shown.starts_with("-")
	unsigned = if negative then shown[1..] else shown
	parts = unsigned.split(".")
	digits = parts#1 + parts#2
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	if #significant > exact_decimal_digits or #parts#2 > exact_fraction_digits { return ø }
	numerator = int(digits)
	if negative { numerator = -numerator }
	denominator = 1
	for i in 0..#parts#2 { denominator = denominator * 10 }
	divisor = gcd(numerator, denominator)
	if divisor < 0 { divisor = -divisor }
	if divisor == denominator { return number_value(numerator / divisor) }
	ratio_node([op.i64_const] + sleb(numerator / divisor), [op.i64_const] + sleb(denominator / divisor))
}

# a decimal past 18 places as the parser keeps it, its own digits (decision exact-decimal-big): those digits over
# 10^places, a ratio of a big denominator
def big_decimal(written: text): TypedCode := {
	parts = written.split(".")
	runtime_call("decimal_ratio", [text_value(parts#1 + parts#2), number_value(#parts#2)])
}

# the passive data segment of a text's bytes, each text stored once in a segment of its own, so a trimmer drops the
# texts no code reads (behind the runtime numbered from its segments on)
def text_segment(t: text): int := {
	if t not in module.texts { module.texts[t] = module.first_text_segment + #module.texts }
	module.texts[t]
}
# a text as its bytes; one code point as its codepoint, as warp holds a literal "a" (a grapheme of more, "👍🏽", is a text)
def one_code_point(t: text): bool := #t == 1 and #codepoints(t) == 1
def text_value(t: text): TypedCode {
	if one_code_point(t) { return TypedCode(ValueKind.Char, [op.i32_const] + sleb(ord(t))) }
	TypedCode(ValueKind.Text, text_bytes(t))
}
def text_bytes(t: text): list := [op.i32_const, 0, op.i32_const] + sleb(#t.bytes) + segment_read(t)
# a text of the bytes of t's segment, from the start and count the code before it leaves
def segment_read(t: text): list := [gc_prefix] + uleb(gc_ops.array_new_data) + relocatable(relocated.types, gc_type(gc.text)) + relocatable(relocated.texts, text_segment(t))
# `baked_segment("…")`: a baked table's text (uses.warp baked_segment_text), its byte count read off the segment's
# first digits at run time, so `rebake` writes the segment anew and the code stays as it is
def baked_segment_code(body: Body, literal: Node): TypedCode {
	if not (literal is text) { return refuse("baked_segment of a text written out") }
	head = uleb(fresh_local(body, ValueKind.Text))
	read_head = [op.i32_const, 0, op.i32_const, BAKED_LENGTH_DIGITS] + segment_read(literal) + [op.local_set] + head
	digit_added = (at: int) => [op.i64_const, 10, op.i64_mul, op.local_get] + head + [op.i32_const, at] + gc_code(gc_ops.array_get_u, [gc_type(gc.text)]) + [op.i64_extend_i32_u, op.i64_const, 48, op.i64_sub, op.i64_add]
	count = [op.i64_const, 0] + concatenated(range_list(BAKED_LENGTH_DIGITS).map(digit_added)) + [op.i32_wrap_i64]
	TypedCode(ValueKind.Text, read_head + [op.i32_const] + sleb(BAKED_HEADER_BYTES) + count + segment_read(literal))
}
