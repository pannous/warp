# Quoted code (emitter.warp's part): `data e` as a node, the fields of a code view (line, column, comment)
# `data e`, glued `data(e)`: e as written, a node (Rust's blocks.rs as_data, written_quote); `parse("a + 1")` is
# `as_code(data a + 1)`
is_quote(n: Node): bool := (is_spaced(n) or (bracket_of(n) == "(" and separator_of(n) == "")) and #n == 2 and n#1 == quote_symbol
is_spliced_quote(n: Node): bool := bracket_of(n) == "(" and separator_of(n) == "" and #n == 2 and n#1 == spliced_quote_symbol
is_spaced(n: Node): bool := bracket_of(n) == "" and separator_of(n) == " "
# `print data (a + 1)`, `as_code(data (a + 1))`: a `data` after the head of a line or call quotes the item after it;
# its place, else 0
inline_quote_at(n: Node): int := {
	if not ((bracket_of(n) == "" and separator_of(n) == " ") or (bracket_of(n) == "(" and separator_of(n) == "")) { return 0 }
	for i in 2..<#n { if n#i == quote_symbol { return i } }
	0
}
quote_folded(n: Node, at: int): Node := {
	quote = separated(bracketed([n#at, n#(at + 1)], ""), " ")
	separated(bracketed(items_of(n)[..(at - 1)] + [quote] + items_of(n)[(at + 1)..], bracket_of(n)), separator_of(n))
}
# `code.line`, `code.column`, `e.comment` (Rust's view: `code#("line" + 1)`): the views carry no positions or comments
position_fields = ["line", "column", "comment"]
# the field a key reads, `x.name`, also as Rust's analysis view writes it, `x#("name" + 1)`; ø of another key
read_field(n: Node): text? := {
	if op_of(n) == Op.Dot and value_of(n) is symbol { return name_of(value_of(n)) }
	field = value_of(n)
	if op_of(n) == Op.Hash and is_key(field, Op.Add) and key_of(field) is text and value_of(field) == 1 { return key_of(field) }
	ø
}
reads_position(n: Node): bool := {
	if type(n) is key and read_field(n) in position_fields { return yes }
	if type(n) is key { return reads_position(key_of(n)) or reads_position(value_of(n)) }
	is_group(n) and items_of(n).any(reads_position)
}
def quoted_code(body: Body, e: Node): list {
	if module.reads_positions { return refuse("quoted code whose position or comment is read") }
	if e is symbol { return node(Kind.Symbol, text_bytes(name_of(e))) }
	if type(e) is key {
		parts = [TypedCode(ValueKind.Node, quoted_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, quoted_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	if is_group(e) {
		if #e == 0 { return [ref_null, gc_type(gc.node)] }
		items = TypedCode(ValueKind.Node, node(Marked.SquareList, vector_code(e.map(item => quoted_code(body, item)))))
		bracketed = TypedCode(ValueKind.Node, runtime_call("bracketed_node", [items, text_value(bracket_of(e))]).code)
		return runtime_call("separated_node", [bracketed, text_value(separator_of(e))]).code
	}
	boxed(expression_code(body, e))
}

# Data with its names spliced in (decisions data-names, data-parameters): a part naming only what the program binds is
# its value (`"Hi " + name`, `theme`, `Greeter("Ann")`), any other part is rebuilt as written, its parts so in turn;
# an entry's key stays a word, a block stays a block of its items
def spliced_code(body: Body, e: Node): list {
	# statements the passes made, a comprehension's loop: code, its value spliced in
	if is_group(e) and bracket_of(e) != "{" and separator_of(e) in statement_separators { return boxed(expression_code(body, e)) }
	if not is_curly_group(e) and not is_word_keyed(e) and #unbound_words(body, e) == 0 { return boxed(expression_code(body, e)) }
	if is_word_keyed(e) {
		parts = [TypedCode(ValueKind.Node, quoted_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, spliced_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	if type(e) is key {
		parts = [TypedCode(ValueKind.Node, spliced_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, spliced_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	if is_group(e) and #e > 0 {
		items = TypedCode(ValueKind.Node, node(Marked.SquareList, vector_code(e.map(item => spliced_code(body, item)))))
		bracketed = TypedCode(ValueKind.Node, runtime_call("bracketed_node", [items, text_value(bracket_of(e))]).code)
		return runtime_call("separated_node", [bracketed, text_value(separator_of(e))]).code
	}
	quoted_code(body, e)
}
# `class: "box"`, `"nav a": {…}`, `p{…}`: a key whose left is a word or text, kept as written
is_word_keyed(e: Node): bool := (is_key(e, Op.Colon) or is_key(e, Op.None)) and (key_of(e) is symbol or key_of(e) is text)
is_bound(body: Body, name: text): bool := name in body.names or is_global(body, name) or name in module.functions or name in module.variants
# the words of e nothing binds, a field's name (`todo.text`) and an entry's key not counted
unbound_words(body: Body, e: Node): list := {
	if e is symbol { return if is_bound(body, name_of(e)) then [] else [name_of(e)] }
	if is_quote(e) or is_spliced_quote(e) { return [] }
	# `.box` of a style sheet reads no field: a selector, its name a word
	if is_key(e, Op.Dot) { return if key_of(e) == ø then unbound_words(body, value_of(e)) else unbound_words(body, key_of(e)) }
	if is_word_keyed(e) { return unbound_words(body, value_of(e)) }
	if type(e) is key { return unbound_words(body, key_of(e)) + unbound_words(body, value_of(e)) }
	if is_group(e) then items_of(e).flat_map(item => unbound_words(body, item)) else []
}
# `div{ class: "box" p{"Hi"} }`: a word nothing binds, glued to its block, is the data pair `div: […]`, Warp's own data
# notation (decision data-parameters, option b), which lib/markup.warp's to_html renders by name
is_data_tag(body: Body, n: Node): bool := is_word_keyed(n) and key_of(n) is symbol and not is_bound(body, name_of(key_of(n))) and name_of(key_of(n)) not in module.classes and is_curly_group(value_of(n))
