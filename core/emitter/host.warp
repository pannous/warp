# Host words (emitter.warp's part): the imports of the "host" module, the builders a host word makes nodes with,
# exported functions, runtime globals
host_module = "host"
def host_import(name: text): list {
	signature = module.host[name]
	[if #signature > 2 then signature#3 else host_module, name, [function_type_byte] + vector(signature#1.map(host_type)) + vector(signature#2.map(host_type))]
}
# f32: a C float (c_imports.warp), the wasm f32 a float is demoted to and promoted from
f32_type = 125
f32_demote = 182
f64_promote = 187
def host_type(kind: ValueKind): list { if kind == ValueKind.I32 or kind == ValueKind.CText then [type_bytes.char] else if kind == ValueKind.F32 then [f32_type] else value_type(kind) }

# a host word's last parameters a call may leave out, their values: `exit()` is exit(0)
host_defaults = {exit: [0]}
left_out(name: text, missing: int): list := {
	defaults = host_defaults.get(name) ?? []
	if missing > 0 and missing <= #defaults then defaults[(#defaults - missing)..] else []
}
# `clock`, `sleep(ms)`: a call of the imported host word, its arguments in the kinds it takes; a host word taking or
# giving a node builds and reads nodes through the constructors the module exports for it (host_builders)
def host_call(body: Body, name: text, arguments: list): TypedCode {
	signature = module.host[name]
	if ValueKind.Node in signature#1 or ValueKind.Node in signature#2 { exported_builders() }
	arguments = arguments + left_out(name, #signature#1 - #arguments)
	if #arguments != #signature#1 { return refuse("a call of " + name + " with " + #arguments + " arguments") }
	code = []
	for i in 0..<#arguments { code += host_argument(expression_code(body, arguments[i]), signature#1[i]) }
	code += call_code(import_index(host_import(name)))
	if #signature#2 == 0 { return TypedCode(no_kind, code) }
	result = signature#2#1
	if result == ValueKind.I32 { return TypedCode(ValueKind.Int, code + [op.i64_extend_i32_s]) }
	if result == ValueKind.F32 { return TypedCode(ValueKind.Float, code + [f64_promote]) }
	TypedCode(result, code)
}
# the constructors a host word builds nodes with, as Rust's module exports them (rust-harness:src/host/tasks/values.rs
# CONSTRUCTORS): [export name, parameter kinds (char: an i32), runtime word of runtime/builders.warp]
host_builders = [["new_empty", [], "built_empty"], ["new_int", [ValueKind.Int], "built_int"], ["new_bool", [ValueKind.Int], "built_bool"],
	["new_float", [ValueKind.Float], "built_float"], ["new_codepoint", [ValueKind.Char], "built_codepoint"], ["new_text", [ValueKind.Char, ValueKind.Char], "built_text"],
	["new_symbol", [ValueKind.Char, ValueKind.Char], "built_symbol"], ["new_key", [ValueKind.Node, ValueKind.Node, ValueKind.Int], "built_key"],
	["new_list", [ValueKind.Node, ValueKind.Node, ValueKind.Int], "built_list"], ["new_type", [ValueKind.Node, ValueKind.Node], "built_type"], ["error_of", [ValueKind.Node], "built_error"],
	["new_bytes", [ValueKind.Char, ValueKind.Char, ValueKind.Int], "built_bytes"], ["new_spelled_key", [ValueKind.Node, ValueKind.Node, ValueKind.Node], "key_node"],
	["new_spelled_list", [ValueKind.Node, ValueKind.Node, ValueKind.Node], "built_spelled_list"]]
# made once: each builder calls its runtime word, an i32 widened to the int it takes; returned_error fails the run with
# the trap detail the host left (rust-harness:src/host/native.rs raised)
def exported_builders(): any {
	if module.builders.any(f => f.name == host_builders#1#1) { return ø }
	for builder in host_builders {
		parameters = builder#2
		values = range_list(#parameters).map(i => if parameters[i] == ValueKind.Char then TypedCode(ValueKind.Int, [op.local_get] + uleb(i) + [op.i64_extend_i32_u]) else TypedCode(parameters[i], [op.local_get] + uleb(i)))
		f = exported_function(builder#1, parameters, ValueKind.Node)
		f.code = runtime_call(builder#3, values).code
	}
	f = exported_function("returned_error", [], no_kind)
	f.code = error_throw("returned_error") + [op.unreachable]
	exported_shown_at()
	# a host word's list arguments for a host that reads no GC objects (the native driver): how many, and each from 1
	f = exported_function("item_count", [ValueKind.Node], ValueKind.Int)
	f.code = runtime_call("node_length", [TypedCode(ValueKind.Node, [op.local_get, 0])]).code
	f = exported_function("item_at", [ValueKind.Node, ValueKind.Int], ValueKind.Node)
	f.code = runtime_call("node_at", [TypedCode(ValueKind.Node, [op.local_get, 0]), TypedCode(ValueKind.Int, [op.local_get, 1])]).code
	# an int item, a yes/no's 1 or 0 too (paint's pixels), and whether a value is a text (a shader's)
	f = exported_function("int_item_at", [ValueKind.Node, ValueKind.Int], ValueKind.Int)
	f.code = runtime_call("int_admitted", [runtime_call("node_at", [TypedCode(ValueKind.Node, [op.local_get, 0]), TypedCode(ValueKind.Int, [op.local_get, 1])])]).code
	f = exported_function("is_textual", [ValueKind.Node], ValueKind.Bool)
	f.code = runtime_call("textual_node", [TypedCode(ValueKind.Node, [op.local_get, 0])]).code
}
# a node a host reads as the text print shows (runtime/text.warp shown_at), which no host walking GC objects needs:
# the native driver's host words, and what a program raised (its trap_detail), made once
def exported_shown_at(): any {
	if module.builders.any(f => f.name == "shown_at") { return ø }
	f = exported_function("shown_at", [ValueKind.Node], ValueKind.Int)
	f.code = runtime_call("shown_at", [TypedCode(ValueKind.Node, [op.local_get, 0])]).code
}
# trap_message(code): the sentence of the runtime error a run failed in, or of the engine's trap of that code (-1 for
# none), at its place in the program's file (runtime/error_sentences.warp), packed as shown_at's: what every host
# prints of a failed run, exported by a program that can raise (prebuilt.warp can_raise); without it a host says the
# engine's trap. The compiler's own source is no place of the user's program: its refusals say theirs
def exported_trap_message() {
	f = exported_function("trap_message", [ValueKind.Int], ValueKind.Int)
	position = if is_compiler_source(module.program_file) then [op.i64_const, 0] else [op.global_get] + relocatable(relocated.globals, declared_global("trap_position", ValueKind.I32)#1) + [op.i64_extend_i32_s]
	f.code = runtime_call("trap_sentence_at", [TypedCode(ValueKind.Text, text_bytes(module.program_file)), TypedCode(ValueKind.Int, position), TypedCode(ValueKind.Int, [op.local_get, 0])]).code
}
def is_compiler_source(file: text): bool := file.starts_with("core/") or "/core/" in file or "lib/compiler/" in file
# f at the module's next function index (results `any`: a declared Function result fails, card class-result-type),
# the functions counted as placed, not measured: a long list's count walks it
placed(f: Function): any := {
	f.index = #module.imports + module.placed
	module.placed += 1
	module.order += [f]
	f
}
# a function made by the emitter (no source), at the next index, its code written by the caller
added_function(name: text, kinds: list, result: ValueKind, local_names: list): any := {
	f = placed(bare_function(name))
	f.kinds = kinds
	f.result = result
	f.locals = []
	f.local_names = local_names
	f
}
# a function the host calls by its name, its code written by the caller
exported_function(name: text, kinds: list, result: ValueKind): any := {
	f = added_function(name, kinds, result, range_list(#kinds).map(i => "argument" + (i + 1)))
	f.is_runtime = yes
	module.builders += [f]
	f
}
def host_argument(value: TypedCode, kind: ValueKind): list {
	if kind == ValueKind.I32 { return host_int(value) + [op.i32_wrap_i64] }
	# a text as the C string a host word reads, `system_value("battery")`: its address in linear memory
	if kind == ValueKind.CText { return runtime_call("c_text", [value]).code + [op.i32_wrap_i64] }
	if kind == ValueKind.F32 { return converted(value, ValueKind.Float) + [f32_demote] }
	if kind == ValueKind.Int { return host_int(value) }
	converted(value, kind)
}
# `x!`, Rust's unwrap: a number or text is itself, and so is what a function taking nothing gives, `f!` of
# `f := {1+2}` (a node where a sum may grow); any other node may be data Rust runs as code (blocks.rs), which the core
# can't yet
def unwrapped(body: Body, n: Node): TypedCode {
	value = expression_code(body, n)
	called = n is symbol and name_of(n) not in body.names and name_of(n) in module.functions and #module.functions[name_of(n)].signature.parameters == 0
	if value.kind == ValueKind.Node and not called { return refuse("running a node as code (`x!`)") }
	value
}

# a number a host word takes as an int: a fraction or a float rounded to the nearest, as Rust passes `sleep(1/60*1000)`
def host_int(value: TypedCode): list {
	if value.kind == ValueKind.Node or value.kind == ValueKind.Float { return runtime_call("rounded", [TypedCode(ValueKind.Float, converted(value, ValueKind.Float))]).code }
	converted(value, ValueKind.Int)
}

# `global name = 0`, `= ""` or `= []` at the top of runtime.warp: a module variable of that kind its words share, from
# the kind's zero (ø for a text, an empty list); `[]` is held behind the opaque word (is_empty_list)
runtime_global(n: Node): any := {
	if not (is_key(n, Op.Colon) and key_of(n) == symbol("global")) { return ø }
	name = name_of(key_of(value_of(n)))
	# a table the runtime parts use for its numbers (kinds.warp, byte_codes.warp) is folded into the code, no variable
	# of the runtime: the program keeps its own `Kind` (card constants-exist)
	if name in constant_tables { return ø }
	# behind runtime.wasm its globals are declared already
	if name in module.globals { return ø }
	value = value_of(value_of(n))
	module.globals[name] = [#module.global_order, if value is number then ValueKind.Int else if type(value) is list or is_empty_list(value) then ValueKind.List else ValueKind.Text]
	module.global_order += [name]
}
