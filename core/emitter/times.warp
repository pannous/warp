# Times (emitter.warp's part): instants, durations and zoned times as $Nodes, their intrinsics and host words
## times (card time-primitives; Rust twin: rust-harness:src/wasm_emitter/time, layout: rust-harness:src/time/mod.rs TimeForm): a $Node of the
## Kind time, its info (form, then a duration's days and months or a zoned time's zone and offset) above the kind
## bits, its data an $i64box of the position (days since 1970 for a date, nanoseconds for the others)
nanos_per_milli = 1000000
# the info bits: a duration's days (32 bits, unsigned) above the form, its months above them; a zoned time's zone
# index (8 bits) above the form, its offset in minutes above that
form_bits = 3
form_mask = 7
# the form of a zoned time (TimeFormCode.Zoned): its text names its zone, which only Rust's zone table knows
months_shift = 35
zone_mask = 255
offset_shift = 11
seconds_per_minute = 60
shift_ops = {i64_or: 132, i64_shl: 134, i64_shr_s: 135, i64_shr_u: 136, i64_mul: 126}
# the calls a lowered program makes a time with (rust-harness:src/time/mod.rs: `now` is instant_at(clock()), a constant time_of)
time_words = {time_of: 2, instant_at: 1}
# the words runtime.warp reads a time with, one or two instructions each (runtime words only, as `intrinsics`)
time_intrinsics = {time_form: 1, time_position: 1, duration_months: 1, duration_days: 1, zone_index: 1, zone_offset: 1}
# the host words runtime words over times call, imported when the program makes a time (Rust: imports.rs makes_instant)
time_host_words = ["local_offset"]
makes_time(program: Node): bool := mentions(program, "instant_at") or mentions(program, "time_of")

# time_of(info, position): the time node; instant_at(milliseconds since 1970): an instant
def time_call(body: Body, name: text, arguments: list): TypedCode {
	if #arguments != time_words[name] { return refuse("a call of " + name + " with " + #arguments + " arguments") }
	if name == "time_of" and arguments#1 is number and arguments#1 % (form_mask + 1) == TimeFormCode.Zoned { return refuse("a zoned time") }
	values = arguments.map(a => expression_code(body, a))
	if name == "instant_at" {
		nanos = converted(values#1, ValueKind.Int) + [op.i64_const] + sleb(nanos_per_milli) + [shift_ops.i64_mul]
		return TypedCode(ValueKind.Time, time_node([op.i64_const, 0], nanos))
	}
	TypedCode(ValueKind.Time, time_node(converted(values#1, ValueKind.Int), converted(values#2, ValueKind.Int)))
}
def time_node(info: list, position: list): list {
	module.made["Time"] = yes
	kind =info + [op.i64_const] + sleb(kind_bits) + [shift_ops.i64_shl, op.i64_const] + sleb(Kind.Time) + [shift_ops.i64_or]
	kind + position + gc_code(gc_ops.struct_new, [gc_type(gc.int_box)]) + [ref_null, gc_type(gc.node)] + gc_code(gc_ops.struct_new, [gc_type(gc.node)])
}
# the kind word of a time node shifted right by `shift` bits, arithmetic (`signed`) or logical
def kind_word_shifted(code: list, shift: int, signed: bool): list {
	shifted = as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(shift)
	shift_op = if signed then shift_ops.i64_shr_s else shift_ops.i64_shr_u
	shifted + [shift_op]
}
def masked(code: list, mask: int): list { code + [op.i64_const] + sleb(mask) + [op.i64_and] }
def time_intrinsic(body: Body, name: text, arguments: list): TypedCode {
	t = expression_code(body, arguments#1).code
	if name == "time_form" { return TypedCode(ValueKind.Int, masked(kind_word_shifted(t, kind_bits, no), form_mask)) }
	if name == "time_position" { return TypedCode(ValueKind.Int, unboxed(t, gc_type(gc.int_box))) }
	if name == "duration_months" { return TypedCode(ValueKind.Int, kind_word_shifted(t, kind_bits + months_shift, yes)) }
	# the 32 days bits, sign-extended: shifted to the top of the word, then down again
	if name == "duration_days" {
		top = 64 - kind_bits - months_shift
		days = as_node(t) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(top) + [shift_ops.i64_shl]
		return TypedCode(ValueKind.Int, days + [op.i64_const] + sleb(32) + [shift_ops.i64_shr_s])
	}
	if name == "zone_index" { return TypedCode(ValueKind.Int, masked(kind_word_shifted(t, kind_bits + form_bits, no), zone_mask)) }
	# seconds east of UTC
	offset = kind_word_shifted(t, kind_bits + offset_shift, yes)
	TypedCode(ValueKind.Int, offset + [op.i64_const] + sleb(seconds_per_minute) + [shift_ops.i64_mul])
}
