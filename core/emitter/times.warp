# Times (emitter.warp's part): instants, durations and zoned times as $Nodes, their intrinsics and host words
## times (card time-primitives; Rust twin: rust-harness:src/wasm_emitter/time, layout: rust-harness:src/time/mod.rs TimeForm): a $Node of the
## Kind time, its info (form, then a duration's days and months or a zoned time's zone and offset) above the kind
## bits, its data an $i64box of the position (days since 1970 for a date, nanoseconds for the others)
nanos_per_milli = 1000000
# the info bits: a duration's days (32 bits, unsigned) above the form, its months above them; a zoned time's zone
# index (8 bits) above the form, its offset in minutes above that
form_bits = 3
form_mask = 7
# the form of a zoned time (TimeFormCode.Zoned): its text names its zone, which only Rust's zone table knows
months_shift = 35
zone_mask = 255
offset_shift = 11
seconds_per_minute = 60
shift_ops = {i64_or: 132, i64_shl: 134, i64_shr_s: 135, i64_shr_u: 136, i64_mul: 126}
# the calls a lowered program makes a time with (rust-harness:src/time/mod.rs: `now` is instant_at(clock()), a constant time_of)
time_words = {time_of: 2, instant_at: 1}
# the words runtime.warp reads a time with, one or two instructions each (runtime words only, as `intrinsics`)
time_intrinsics = {time_form: 1, time_position: 1, duration_months: 1, duration_days: 1, zone_index: 1, zone_offset: 1}
# the host words runtime words over times call, imported when the program makes a time (Rust: imports.rs makes_instant)
time_host_words = ["local_offset"]
def makes_time(program: Node): bool := mentions(program, "instant_at") or mentions(program, "time_of")

# time_of(info, position): the time node; instant_at(milliseconds since 1970): an instant
def time_call(body: Body, name: text, arguments: list): TypedCode {
	if #arguments != time_words[name] { return refuse("a call of " + name + " with " + #arguments + " arguments") }
	if name == "time_of" and arguments#1 is number and arguments#1 % (form_mask + 1) == TimeFormCode.Zoned { return refuse("a zoned time") }
	values = arguments.map(a => expression_code(body, a))
	if name == "instant_at" {
		nanos = converted(values#1, ValueKind.Int) + [op.i64_const] + sleb(nanos_per_milli) + [shift_ops.i64_mul]
		return TypedCode(ValueKind.Time, time_node([op.i64_const, 0], nanos))
	}
	TypedCode(ValueKind.Time, time_node(converted(values#1, ValueKind.Int), converted(values#2, ValueKind.Int)))
}
def time_node(info: list, position: list): list {
	module.made["Time"] = yes
	kind =info + [op.i64_const] + sleb(kind_bits) + [shift_ops.i64_shl, op.i64_const] + sleb(Kind.Time) + [shift_ops.i64_or]
	kind + position + gc_code(gc_ops.struct_new, [gc_type(gc.int_box)]) + [ref_null, gc_type(gc.node)] + gc_code(gc_ops.struct_new, [gc_type(gc.node)])
}
# the kind word of a time node shifted right by `shift` bits, arithmetic (`signed`) or logical
def kind_word_shifted(code: list, shift: int, signed: bool): list {
	shifted = as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(shift)
	shift_op = if signed then shift_ops.i64_shr_s else shift_ops.i64_shr_u
	shifted + [shift_op]
}
def masked(code: list, mask: int): list { code + [op.i64_const] + sleb(mask) + [op.i64_and] }
def time_intrinsic(body: Body, name: text, arguments: list): TypedCode {
	t = expression_code(body, arguments#1).code
	if name == "time_form" { return TypedCode(ValueKind.Int, masked(kind_word_shifted(t, kind_bits, no), form_mask)) }
	if name == "time_position" { return TypedCode(ValueKind.Int, unboxed(t, gc_type(gc.int_box))) }
	if name == "duration_months" { return TypedCode(ValueKind.Int, kind_word_shifted(t, kind_bits + months_shift, yes)) }
	# the 32 days bits, sign-extended: shifted to the top of the word, then down again
	if name == "duration_days" {
		top = 64 - kind_bits - months_shift
		days = as_node(t) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(top) + [shift_ops.i64_shl]
		return TypedCode(ValueKind.Int, days + [op.i64_const] + sleb(32) + [shift_ops.i64_shr_s])
	}
	if name == "zone_index" { return TypedCode(ValueKind.Int, masked(kind_word_shifted(t, kind_bits + form_bits, no), zone_mask)) }
	# seconds east of UTC
	offset = kind_word_shifted(t, kind_bits + offset_shift, yes)
	TypedCode(ValueKind.Int, offset + [op.i64_const] + sleb(seconds_per_minute) + [shift_ops.i64_mul])
}

## time literals (card triage-time-values; rust-harness:src/time/mod.rs time_info): the parser's data view of a time,
## `2024-02-29`, `2024-01-31T10:30:15.5Z`, `1 month 2 days`, as the time node it is
second_nanos = 1000000000
day_nanos = 86400 * second_nanos
unit_nanos = {hour: 3600 * second_nanos, minute: 60 * second_nanos, second: second_nanos}
# a time literal's [info, position], [] for a zoned one (its zone's rules are Rust's) or a text that is no time
def time_parts(written: text): list := if is_digit(written[0]) and #written >= 10 and written[4] == '-' then moment_parts(written) else duration_parts(written)
def is_time_literal(written: text): bool := #time_parts(written) > 0
def time_literal(written: text): TypedCode {
	parts = time_parts(written)
	TypedCode(ValueKind.Time, time_node([op.i64_const] + sleb(parts#1), [op.i64_const] + sleb(parts#2)))
}
# `2024-02-29` a date (days since 1970), `2024-01-31T10:30` a local time, `…Z` or `…+01:00` an instant (nanoseconds); [] for a zoned time
def moment_parts(written: text): list {
	# (days_from_civil: the prelude's calendar)
	day = days_from_civil(int(written[0 ..< 4]), int(written[5 ..< 7]), int(written[8 ..< 10]))
	if #written == 10 { return [TimeFormCode.Date, day] }
	at = 16
	nanos = int(written[11 ..< 13]) * unit_nanos.hour + int(written[14 ..< 16]) * unit_nanos.minute
	if at < #written and written[at] == ':' {
		nanos += int(written[at + 1 ..< at + 3]) * second_nanos
		at += 3
		if at < #written and written[at] == '.' {
			start = at + 1
			at = start
			while at < #written and is_digit(written[at]) { at += 1 }
			fraction = written[start ..< at]
			while #fraction < 9 { fraction += "0" }
			nanos += int(fraction[0 ..< 9])
		}
	}
	position = day * day_nanos + nanos
	if at == #written { return [TimeFormCode.Local, position] }
	if written[at] == 'Z' or written[at] == 'z' { return [TimeFormCode.Instant, position] }
	if written[at] == '+' or written[at] == '-' {
		offset = int(written[at + 1 ..< at + 3]) * unit_nanos.hour + int(written[at + 4 ..< at + 6]) * unit_nanos.minute
		return [TimeFormCode.Instant, if written[at] == '+' then position - offset else position + offset]
	}
	[]
}
# `1 month 2 days 3 hours`: the months and days in the info above the form, the rest as nanoseconds
def duration_parts(written: text): list {
	words = written.split(" ")
	if #words % 2 != 0 { return [] }
	months = 0
	days = 0
	nanos = 0
	for at in 0 ..< #words /! 2 {
		amount = int(words[2 * at])
		unit = words[2 * at + 1]
		if unit.ends_with("s") { unit = unit[0 ..< #unit - 1] }
		if unit == "month" { months += amount } else if unit == "day" { days += amount } else if unit_nanos.has(unit) { nanos += amount * unit_nanos[unit] } else { return [] }
	}
	[TimeFormCode.Duration + (days % TimeInfoUnit.DayRange) * TimeInfoUnit.Days + months * TimeInfoUnit.Months, nanos]
}

## time fields (card triage-time-values; rust-harness:src/time/times.rs TIME_FIELDS): `d.month`, `t.hour`, read at run time by
## the prelude's time_field_of, which a program writing a time literal brings (passes/prelude_words.warp emitted_words)
time_fields = {year: 0, month: 1, day: 2, weekday: 3, day_of_year: 4, hour: 5, minute: 6, second: 7, epoch_seconds: 8, offset: 9}
# the field of a time: its form and position given to time_field_of, no zone (a zoned time is refused as a literal)
def time_field(time: TypedCode, name: text): TypedCode {
	form = masked(kind_word_shifted(time.code, kind_bits, no), form_mask)
	position = unboxed(time.code, gc_type(gc.int_box))
	call_values(module.functions[time_field_word], [TypedCode(ValueKind.Int, form), TypedCode(ValueKind.Int, position), number_value(0), number_value(time_fields[name])])
}

## time arithmetic (card day-hour): `d + 1 day`, `a - b`, `2 * 1 day` of a run-time time, by lib/time_arithmetic.warp's
## time_operation, which a program writing a time literal and an operator brings (passes/prelude_words.warp)
time_operators = {"+": 0, "-": 1, "*": 2}
# the runtime words an operand's parts are read with: its form, position, months and days
operand_parts = ["operand_form", "operand_position", "duration_months", "duration_days"]
# each operand held in a local, read four times
def time_operation_call(body: Body, symbol: text, a: TypedCode, b: TypedCode): TypedCode {
	stored = []
	parts = []
	for operand in [a, b] {
		place = fresh_local(body, ValueKind.Node)
		stored += boxed(operand) + [op.local_set] + uleb(place)
		held = TypedCode(ValueKind.Node, [op.local_get] + uleb(place))
		parts += operand_parts.map(word => runtime_call(word, [held]))
	}
	result = call_values(module.functions[time_operation_word], parts + [number_value(time_operators[symbol])])
	TypedCode(result.kind, stored + result.code)
}
