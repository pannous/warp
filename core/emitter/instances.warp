# Maps and class instances (emitter.warp's part): literals, the declared classes and fields, field reads and writes
## maps and class instances, as Rust's (runtime.warp "a map is a curly list")
# `name: value` as a map entry: its name a symbol, its value boxed
def entry_code(name_code: list, value_code: list): list { keyed_code(node(Kind.Symbol, name_code), value_code) }
def keyed_code(name_node: list, value_code: list): list { key_code(Marked.Entry, name_node, value_code) }
def key_code(kind: int, name_node: list, value_code: list): list { [op.i64_const] + sleb(kind) + name_node + as_node(value_code) + gc_code(gc_ops.struct_new, [gc_type(gc.node)]) }
# an entry's name as Rust's holds it: `a` a symbol, a quoted "ab" a text, a quoted "+" a character
def name_node(name: any): list {
	if name is symbol { return node(Kind.Symbol, text_bytes(name_of(name))) }
	if one_code_point(name) { return node(Kind.Codepoint, [op.i32_const] + sleb(ord(name)) + gc_code(gc_ops.ref_i31, [])) }
	node(Kind.Text, text_bytes(name))
}
# (`global: n = 5`, `{ global n = 5 }` once parsed, declares n as Rust's analyzer reads it, no map entry; nor is an
# opaque view, `f() := {}` the body `{ {} }`, an empty map, card module-hygiene)
is_map_entry(n: Node): bool := is_key(n, Op.Colon) and (key_of(n) is symbol or key_of(n) is text) and key_of(n) != symbol("global") and key_of(n) != opaque_symbol
# `{a: 1, b: "x"}`: a map
def map_value(body: Body, entries: list): TypedCode { TypedCode(ValueKind.Node, entries_code(body, entries.map(e => key_of(e)), entries.map(e => value_of(e)))) }
# the map of the names to the values
def entries_code(body: Body, entry_names: list, entry_values: list): list {
	codes = []
	for i in 0..<#entry_names { codes += [keyed_code(name_node(entry_names[i]), boxed(expression_code(body, entry_values[i])))] }
	node(Marked.Map, vector_code(codes))
}
# `Point{x:1 y:2}`, an instance as lowered: the entry of the class name, its value the map of the fields
# an instance's key has no operator (Op::None), as Rust's has
# Rust checks each typed field's value (rust-harness:src/declared_values.rs): an instance is built here only when every value has
# its field's kind already or is checked at run time; a class not declared in the program (a markup tag, a module's)
# is refused
def instance_value(body: Body, class_name: text, fields: list): TypedCode {
	instance_of_fields(body, class_name, fields.map(field => name_of(key_of(field))), fields.map(field => value_of(field)))
}
# `Point(2, 3)`: the instance whose fields, in the order the class declares them, are the arguments
def positional_instance(body: Body, class_name: text, arguments: list): TypedCode {
	field_names = if class_name in module.classes then module.classes[class_name].keys else []
	slots = placed_arguments(field_names, arguments)
	if not (slots is list) { return refuse("an instance of " + class_name + " given more values than fields") }
	given = range_list(#slots).filter(i => slots[i] != ø)
	instance_of_fields(body, class_name, given.map(i => field_names[i]), given.map(i => slots[i]#1))
}
# the instance of the class whose fields of these names hold these values
def instance_of_fields(body: Body, class_name: text, field_names: list, field_values: list): TypedCode {
	if class_name not in module.classes { return refuse("an instance of " + class_name + ", a class not declared here") }
	declared = module.classes[class_name]
	# the fields left out take their defaults, else their type's zero, as Rust's type_constructor.rs with_defaults
	defaults = module.class_defaults[class_name]
	for name in declared.keys {
		if name not in field_names {
			field_names += [name]
			field_values += [if name in defaults then stage_node(defaults[name]#1) else field_zero(declared[name])]
		}
	}
	given = {}
	for i in 0..<#field_names {
		if field_names[i] not in declared { return refuse("a field " + class_name + " does not declare") }
		given[field_names[i]] = field_values[i]
	}
	# the fields in the order the class declares them, each its struct field (class_struct)
	codes = []
	for field_name in declared.keys {
		written_type = declared[field_name]
		# an optional field `b: text?` takes ø as it is, any other value as its base type
		field_type = if given[field_name] == ø and written_type != base_type(written_type) then ø else base_type(written_type)
		value = texted(field_type, expression_code(body, given[field_name]))
		if not checked_at_run_time(field_type, value.kind) and not admits(field_type, value.kind) { return refuse("a " + kind_spelling(value.kind) + " for a typed field of " + class_name) }
		codes += [as_node(boxed(field_value(field_type, value)))]
	}
	TypedCode(ValueKind.Node, instance_head(class_name) + concatenated(codes) + gc_code(gc_ops.struct_new, [gc_type(class_struct(class_name))]))
}
# a field's type's zero: 0, 0.0, "", no, [], else ø (an untyped or optional field, one of a class)
kind_zero(kind: ValueKind?): any := match kind {
	ValueKind.Int: 0
	ValueKind.Float: 0.0
	ValueKind.Text: ""
	ValueKind.Bool: no
	ValueKind.List: []
	_: ø
}
def field_zero(type: text?): any { if type == base_type(type) then kind_zero(field_kind(type)) else ø }
# A declared class's instance is its own struct type (card declared-class), a subtype of its parent's struct, else of
# $Instance: the node's kind (an instance), data (the class name) and value (the list of its field names, as the
# runtime and the host read an instance whose struct type they do not know), its extra fields (the map of those its
# class does not declare, ø until one is set), then each field the class declares, in declared order, a node or ø. A
# read of a receiver whose class is known is struct.get; any other read of a field some class declares is that field's
# getter (field_getter_code); the runtime sets and lists an instance's fields through instance_set / instance_entries,
# written once the classes are known
instance_struct_prefix = "class·"
def class_struct(class_name: text): text {
	name = instance_struct_prefix + class_name
	if name not in module.class_structs {
		super = if class_name in module.parents then class_struct(module.parents[class_name]) else instance_struct()
		fields = module.classes[class_name].keys
		definition = [subtype_prefix(class_name), 1, super, 95] + uleb(#instance_fields + #fields) + instance_field_types() + concatenated(fields.map(field => [99, gc.node, 1]))
		module.class_structs[name] = [definition, instance_fields + fields]
	}
	name
}
# a class no other class extends has a final struct (79), else an open one (80): wasmtime tests a value against a
# final type by comparing type indexes, against an open one of another type through its is_subtype libcall (each
# instance lookup tested every class in turn so: a quarter of the emit; notes/compile_speed.md "Emit")
def subtype_prefix(class_name: text): int { if class_name in module.parents.values then 80 else 79 }
# $Instance, every class's struct's supertype: a $Node with the map of its extra fields
instance_fields = ["kind", "data", "value", "extra"]
def instance_field_types(): list { node_fields + [99, gc.node, 1] }
extra_field = 3
def instance_struct(): text {
	name = "Instance"
	if name not in module.class_structs { module.class_structs[name] = [[80, 1, gc.node, 95] + uleb(#instance_fields) + instance_field_types(), instance_fields] }
	name
}
# every class's struct declared at once, a parent before its children, as one recursion group (module_layout.warp
# type_entries): wasm canonicalizes structurally equal types, so two classes of as many fields would be one type, and
# the test of one class's struct would pass the other's instance; inside one group each type is its own
def declare_class_structs() {
	for class_name in classes_parents_first() { gc_type(class_struct(class_name)) }
}
def classes_parents_first(): list {
	deepest = 0
	for class_name in module.classes.keys { if class_depth(class_name) > deepest { deepest = class_depth(class_name) } }
	ordered = []
	for level in 0 to deepest { ordered += module.classes.keys.filter(class_name => class_depth(class_name) == level) }
	ordered
}
# an instance's $Instance fields: the kind, the class name, the list of the field names (their items made once, a list
# global the class's instances share; a list global starts empty, a node global as 0), no extra fields
def instance_head(class_name: text): list {
	names = module.classes[class_name].keys.map(field => node(Kind.Symbol, text_bytes(field)))
	shared = relocatable(relocated.globals, declared_global(class_fields_prefix + class_name, ValueKind.List)#1)
	unmade = [op.global_get] + shared + gc_code(gc_ops.struct_get, [gc_type(gc.list), 0]) + [op.i32_eqz]
	made = unmade + [op.if, no_value] + vector_code(names) + [op.global_set] + shared + [op.end]
	[op.i64_const] + sleb(Marked.Instance) + node(Kind.Symbol, text_bytes(class_name)) + made + node(Kind.List, [op.global_get] + shared) + [ref_null, gc_type(gc.node)]
}
class_fields_prefix = "fields·"
# the struct field of a class's field `name` (its place after $Instance's), ø when the class lacks it
def struct_field(class_name: text, name: text): any {
	fields = module.classes[class_name].keys
	for i in 0..<#fields { if fields[i] == name { return i + #instance_fields } }
	ø
}
# `m.x`, lowered as the subscript `m#("x"+1)`: the name's text, else ø
subscript_name(index: Node): any := {
	# (type() of an arithmetic key is "operation", not key)
	if op_of(index) == Op.Add and value_of(index) == 1 and key_of(index) is text { return key_of(index) }
	ø
}
# `k+1`, the index `m[k]` lowers to
is_shifted_index(index: Node): bool := op_of(index) == Op.Add and value_of(index) == 1
# `m.name`, `m["name"]`: a map's or an instance's entry, a swizzle's components of a list of 2 to 4 numbers (`p.zy`),
# else the run ends in no_field_<name>, which Rust's run reports as "no field name"
def field_read(body: Body, target: Node, name: text, class_name: text = ""): TypedCode {
	held = TypedCode(ValueKind.Node, [op.local_get] + uleb(fresh_local(body, ValueKind.Node)))
	named = text_value_of(name)
	missing = ended_in(ValueKind.Node, no_field_prefix + name)
	if is_swizzle(name) {
		word = if #name == 1 then "swizzled_one" else "swizzled"
		fits = condition(runtime_call("swizzle_fits", [held, named]))
		missing = TypedCode(ValueKind.Node, fits + if_else_code(ValueKind.Node, runtime_call(word, [held, named]), missing))
	}
	# a receiver of a known class: its field, read from its struct; another value as any value
	if class_name != "" and struct_field(class_name, name) != ø {
		struct_index = gc_type(class_struct(class_name))
		read = TypedCode(ValueKind.Node, held.code + gc_code(gc_ops.ref_cast, [struct_index]) + gc_code(gc_ops.struct_get, [struct_index, struct_field(class_name, name)]))
		return TypedCode(ValueKind.Node, boxed(target) + [op.local_set] + held.code[1..] + held.code + gc_code(gc_ops.ref_test, [struct_index]) + if_else_code(ValueKind.Node, read, call_values(made_late(field_getter_prefix + name, ValueKind.Node, ["m"]), [held])))
	}
	# a field some class declares, of a receiver whose class is not known: that field's getter, which tests only the
	# classes declaring it
	if declares_field(name) and not is_swizzle(name) { return call_values(made_late(field_getter_prefix + name, ValueKind.Node, ["m"]), [TypedCode(ValueKind.Node, boxed(target))]) }
	found = condition(runtime_call("has_field", [held, named]))
	TypedCode(ValueKind.Node, boxed(target) + [op.local_set] + held.code[1..] + found + if_else_code(ValueKind.Node, runtime_call("map_get", [held, named]), missing))
}
# the class a receiver is declared as, a parameter written `p: Parser`; "" when not known. A subclass's instance passes
# too: its struct starts with its parent's fields
def receiver_class(body: Body, n: Node): text {
	if not (n is symbol) or body.function.signature == ø { return "" }
	for parameter in body.function.signature.parameters {
		if parameter.name == name_of(n) and parameter.type_name in module.classes { return parameter.type_name }
	}
	""
}
# The runtime's words over instances whose class it does not know (runtime intrinsics.warp instance_set …), written
# once every class is known: for each class whose struct the program makes, a subclass before its parent, an instance
# of that struct reads, sets or lists its fields by their names
instance_set_name = "instance_set"
instance_entries_name = "instance_entries"
instance_field_at_name = "instance_field_at"
instance_place_name = "instance_place"
is_class_instance_name = "is_class_instance"
instance_show_name = "instance_show"
instance_float_name = "instance_float"
def class_depth(class_name: text): int { if class_name in module.parents then 1 + class_depth(module.parents[class_name]) else 0 }
def made_classes(): list {
	made = module.classes.keys.filter(class_name => instance_struct_prefix + class_name in module.class_structs)
	deepest = 0
	for class_name in made { if class_depth(class_name) > deepest { deepest = class_depth(class_name) } }
	ordered = []
	level = deepest
	while level >= 0 {
		ordered += made.filter(class_name => class_depth(class_name) == level)
		level -= 1
	}
	ordered
}
# the code of a class's test on the instance (parameter 0): when its struct, `each(field, struct field)` for its
# fields, then `after` (an instance of the class lacking the field)
def each_class_field(each: function, after: function = (count => [])): list {
	code = []
	for class_name in made_classes() {
		struct_index = gc_type(class_struct(class_name))
		fields = module.classes[class_name].keys
		inner = []
		for i in 0..<#fields { inner += each(fields[i], [op.local_get, 0] + gc_code(gc_ops.ref_cast, [struct_index]), struct_index, i + #instance_fields) }
		code += [op.local_get, 0] + gc_code(gc_ops.ref_test, [struct_index]) + [op.if, no_value] + inner + after(#fields) + [op.end]
	}
	code
}
# whether the name (parameter 1, a text node) is this field's: its byte count first, then its bytes (a lookup tests
# each field of a class)
def names_field(field: text): list {
	name = payload([op.local_get, 1], gc_type(gc.text))
	same_count = name + gc_code(gc_ops.array_len, []) + [op.i32_const] + sleb(#field.bytes) + [op.i32_sub, op.i32_eqz]
	same_count + if_else_code(ValueKind.Bool, runtime_call("same_bytes", [TypedCode(ValueKind.Text, name), text_value_of(field)]), TypedCode(ValueKind.Bool, [op.i32_const, 0]))
}
# instance_set(m, name, value): 1 when m's class declares the field, set in its struct; 0 when it does not, the field
# set in m's extra fields; 2 when m is no instance of a class (an AST key without an operator is marked so too)
def instance_set_code(f: Function) {
	write = (field, instance, struct_index, place) => names_field(field) + [op.if, no_value] + instance + as_node([op.local_get, 2]) + gc_code(gc_ops.struct_set, [struct_index, place]) + [op.i64_const, 1, op.return, op.end]
	base = gc_type(instance_struct())
	extra = [op.local_get, 0] + gc_code(gc_ops.ref_cast, [base]) + gc_code(gc_ops.struct_get, [base, extra_field])
	name = payload([op.local_get, 1], gc_type(gc.text))
	put = runtime_call("field_with", [TypedCode(ValueKind.Node, extra), TypedCode(ValueKind.Text, name), TypedCode(ValueKind.Node, as_node([op.local_get, 2]))]).code
	extra_set = [op.local_get, 0] + gc_code(gc_ops.ref_cast, [base]) + as_node(put) + gc_code(gc_ops.struct_set, [base, extra_field]) + [op.i64_const, 0, op.return]
	f.code = each_class_field(write, count => extra_set) + [op.i64_const, 2]
}
# `field·code(m)`: m's field code read from the struct of whichever class declaring it m is an instance of, a subclass
# before its parent; any other value as map_get reads it
field_getter_prefix = "field·"
def field_getter_code(f: Function) {
	name = f.name[#field_getter_prefix ..]
	code = []
	for class_name in made_classes() {
		place = struct_field(class_name, name)
		if place != ø {
			struct_index = gc_type(class_struct(class_name))
			code += [op.local_get, 0] + gc_code(gc_ops.ref_test, [struct_index]) + [op.if, no_value, op.local_get, 0] + gc_code(gc_ops.ref_cast, [struct_index]) + gc_code(gc_ops.struct_get, [struct_index, place]) + [op.return, op.end]
		}
	}
	f.code = code + runtime_call("map_get", [TypedCode(ValueKind.Node, [op.local_get, 0]), text_value_of(name)]).code
}
# `set·code(m, value)`: m with its field code set in the struct of whichever class declaring it m is an instance of;
# any other value (a map, an instance whose class lacks the field) as field_with sets it
field_setter_prefix = "set·"
def field_setter_code(f: Function) {
	name = f.name[#field_setter_prefix ..]
	code = []
	for class_name in made_classes() {
		place = struct_field(class_name, name)
		if place != ø {
			struct_index = gc_type(class_struct(class_name))
			code += [op.local_get, 0] + gc_code(gc_ops.ref_test, [struct_index]) + [op.if, no_value, op.local_get, 0] + gc_code(gc_ops.ref_cast, [struct_index]) + as_node([op.local_get, 1]) + gc_code(gc_ops.struct_set, [struct_index, place]) + [op.local_get, 0, op.return, op.end]
		}
	}
	f.code = code + runtime_call("field_with", [TypedCode(ValueKind.Node, [op.local_get, 0]), text_value_of(name), TypedCode(ValueKind.Node, [op.local_get, 1])]).code
}
def instance_entries_code(f: Function) {
	code = []
	for class_name in made_classes() {
		struct_index = gc_type(class_struct(class_name))
		fields = module.classes[class_name].keys
		instance = [op.local_get, 0] + gc_code(gc_ops.ref_cast, [struct_index])
		entries = range_list(#fields).map(i => keyed_code(name_node(symbol(fields[i])), instance + gc_code(gc_ops.struct_get, [struct_index, i + #instance_fields])))
		declared = TypedCode(ValueKind.Node, node(Marked.Map, vector_code(entries)))
		extra = TypedCode(ValueKind.Node, instance + gc_code(gc_ops.struct_get, [struct_index, extra_field]))
		code += [op.local_get, 0] + gc_code(gc_ops.ref_test, [struct_index]) + [op.if, no_value] + runtime_call("with_entries_of", [declared, extra]).code + [op.return, op.end]
	}
	f.code = code + [ref_null, gc_type(gc.node)]
}
# The places of an instance's fields, as map_index counts them: its class's declared ones from 1, then its extra ones
# (card instance-words-build: a lookup reads the struct, the entries are built only to walk or show them)
# m's extra fields, the map or ø
def extra_of(): TypedCode {
	base = gc_type(instance_struct())
	TypedCode(ValueKind.Node, [op.local_get, 0] + gc_code(gc_ops.ref_cast, [base]) + gc_code(gc_ops.struct_get, [base, extra_field]))
}
# instance_field_at(m, index): the field at that place of whichever class m is an instance of, ø past its fields
def instance_field_at_code(f: Function) {
	index = unboxed([op.local_get, 1], gc_type(gc.int_box))
	read = (field, instance, struct_index, place) => index + [op.i64_const] + sleb(place - #instance_fields + 1) + [op.i64_eq, op.if, no_value] + instance + gc_code(gc_ops.struct_get, [struct_index, place]) + [op.return, op.end]
	extra = count => runtime_call("extra_value_at", [extra_of(), TypedCode(ValueKind.Int, index), TypedCode(ValueKind.Int, [op.i64_const] + sleb(count))]).code + [op.return]
	f.code = each_class_field(read, extra) + [ref_null, gc_type(gc.node)]
}
# instance_place(m, name): the place of m's field name, 0 when it has none
def instance_place_code(f: Function) {
	find = (field, instance, struct_index, place) => names_field(field) + [op.if, no_value, op.i64_const] + sleb(place - #instance_fields + 1) + [op.return, op.end]
	name = TypedCode(ValueKind.Text, payload([op.local_get, 1], gc_type(gc.text)))
	extra = count => runtime_call("extra_place", [extra_of(), name, TypedCode(ValueKind.Int, [op.i64_const] + sleb(count))]).code + [op.return]
	f.code = each_class_field(find, extra) + [op.i64_const, 0]
}
# is_class_instance(m): whether m is an instance of a class the program makes, a struct (an AST key without an
# operator is marked as an instance too): a test of each class's struct, not of the open $Instance (subtype_prefix)
def is_class_instance_code(f: Function) {
	tests = made_classes().map(class_name => [op.local_get, 0] + gc_code(gc_ops.ref_test, [gc_type(class_struct(class_name))]))
	f.code = if #tests == 0 then [op.i32_const, 0] else tests#1 + concatenated(tests[1 ..].map(test => test + [op.i32_or]))
}
# instance_show(m): the text m's class shows it as by its show() (decision show-hook), ø when the program's classes
# give none (class_methods.warp show·shown)
def instance_show_code(f: Function) { f.code = instance_converted_code(instance_show_word) }
# instance_float(m): m as its class's float() gives it (`sin(2km)`), ø when the program's classes give none
# (class_methods.warp float·hooked)
def instance_float_code(f: Function) { f.code = instance_converted_code(HiddenWord.FloatHooked as text) }
# the parameter as the program's conversion dispatcher named gives it, boxed; ø without that dispatcher
def instance_converted_code(dispatcher: text): list {
	converting = module.functions.get(dispatcher)
	if converting == ø then [ref_null, gc_type(gc.node)] else boxed(call_values(converting, [TypedCode(ValueKind.Node, [op.local_get, 0])]))
}
# whether a declared class has a field `name`: a read of it may meet an instance (field_value), else only a map
def declares_field(name: text): bool { module.classes.keys.any(class_name => name in module.classes[class_name]) }
def is_swizzle(name: text): bool { #name >= 1 and #name <= 4 and name.all(c => c in "xyzw") }
# a value of the kind given that ends the run in the error function named
def ended_in(kind: ValueKind, error: text): TypedCode { TypedCode(kind, call_code(error_function(error)) + [op.drop, op.unreachable]) }
# the index of a function that only traps, named so the run's error reads as Rust's does (rust-harness:src/wasm_emitter/control/traps.rs)
def error_function(name: text): int {
	if name in module.errors { return module.errors[name].index }
	f = added_function(name, [], ValueKind.Int, [])
	f.code = error_throw(name) + [op.unreachable]
	module.errors[name] = f
	f.index
}
# a recursive call not yet known (pending) is read as the node it may be, as element() takes it (card recursive-class-return);
# a list known as one swizzles too (`[1, 2, 3].xy`)
def field_of(body: Body, value: TypedCode, name: text, class_name: text = ""): TypedCode {
	if value.kind == ValueKind.Node or value.kind == pending { return field_read(body, TypedCode(ValueKind.Node, value.code), name, class_name) }
	if value.kind == ValueKind.List and is_swizzle(name) { return field_read(body, TypedCode(ValueKind.Node, boxed(value)), name, class_name) }
	if value.kind == ValueKind.Time and time_fields.has(name) and module.functions.has(time_field_word) { return time_field(value, name) }
	refuse("the field " + name + " of a " + kind_spelling(value.kind))
}
# `m.x = v`: the map with its entry x set to v
def field_assignment(map: TypedCode, name: TypedCode, value: TypedCode): TypedCode { runtime_call("field_with", [TypedCode(ValueKind.Node, boxed(map)), shown_text(name), TypedCode(ValueKind.Node, boxed(value))]) }
# a name as a text value, even of one character (text_value gives a "char" then)
def text_value_of(name: text): TypedCode { TypedCode(ValueKind.Text, text_bytes(name)) }
# the classes and enum cases the program declares, wherever it does (a declaration arrives as an opaque view
# ["type", name, body], its name an attribute layer for an enum's bare cases or a base class)
# the attribute layers naming a base class: parser.warp's `extends`, Rust's inherited_from
base_class_layers = ["extends", "inherited_from"]
collect_types(n: Node): any := {
	if declares_type(n) { return record_type(value_of(n)#2, value_of(n)#3) }
	if is_type_alias(n) { return module.aliases[value_of(key_of(n))#2#2] = aliased_spelling(value_of(n)) }
	if is_group(n) { for x in n { collect_types(x) } }
}
# a class or enum declaration, the opaque view ["type", name, body]
declares_type(n: Node): bool := type(n) is key and key_of(n) == opaque_symbol and kind_of(value_of(n)) == "type"
# `type Name = text`, `type View = list or int`: a declaration of no body naming another type or a union
is_type_alias(n: Node): bool := is_key(n, Op.Assign) and declares_type(key_of(n)) and value_of(key_of(n))#3 == ø and aliased_spelling(value_of(n)) != ø
aliased_spelling(type: Node): text? := if type is symbol then name_of(type) else union_spelling(type)
# a case of a variants declaration, `A`, or one spelled otherwise, `A = "a"`
variant_name(variant: any): text := if kind_of(variant) == "key" then variant#3#2 else variant#2
record_type(name: any, body: any): any := {
	if kind_of(name) == "symbol" {
		module.class_defaults[name#2] = field_defaults(body)
		if declared_members(body).any(member => member == ø) { module.member_classes[name#2] = yes }
		return module.classes[name#2] = field_types(body)
	}
	if kind_of(name) != "attribute" { return refuse("a type named by " + kind_of(name)) }
	if name#2 == "variants" {
		enum_name = declared_type_name(name)
		module.enum_cases[enum_name] = name#3[3..].map(variant => variant_name(variant))
		for variant in name#3[3..] { module.variants[variant_name(variant)] = (module.variants.get(variant_name(variant)) ?? []) + [enum_name] }
		module.case_spellings[enum_name] = {}
		for variant in name#3[3..].filter(variant => kind_of(variant) == "key") { module.case_spellings[enum_name][variant_name(variant)] = variant#4#2 }
		if #name#3 > 3 { module.sum_types[declared_type_name(name)] = "cases" }
	}
	if name#2 in base_class_layers and kind_of(name#3) == "symbol" {
		if name#3#2 not in module.sum_types { module.sum_types[name#3#2] = "subclasses" }
		if kind_of(name#4) == "symbol" { module.parents[name#4#2] = name#3#2 }
	}
	record_type(name#4, body)
}
# `class Dog extends Animal {…}`: Dog's fields and defaults are Animal's first, then its own; a chain of parents in any
# order of declaration (merging twice changes nothing)
inherit_fields(child: text): any := {
	if child not in module.parents { return module.classes[child] }
	parent = module.parents[child]
	if parent not in module.classes { return refuse("a class extending " + parent + ", a class not declared here") }
	module.classes[child] = entries_of_both(inherit_fields(parent), module.classes[child])
	module.class_defaults[child] = entries_of_both(module.class_defaults[parent], module.class_defaults[child])
	if parent in module.member_classes { module.member_classes[child] = yes }
	module.classes[child]
}
# the entries of inherited, then those of own, which win (no local is named like a map word: `entries` broke a map
# program in the pure lane)
entries_of_both(inherited: map, own: map): map := {
	both = {}
	for name in inherited.keys { both[name] = inherited[name] }
	for name in own.keys { both[name] = own[name] }
	both
}
# the kind a field typed `type` holds: a type word's of the core, a node of any value (a map, a node, a function), a
# list of a plural type word (`texts`), each through a type alias; ø untyped, an instance of a class or another type
def field_kind(type: text?): ValueKind? {
	if type == ø { return ø }
	word = aliased_type(base_type(type))
	if is_union(word) { return annotated_kind(word) }
	if word in module.classes { return ValueKind.Instance }
	if word in node_annotations { return ValueKind.Node }
	if word in declared_kinds { return declared_kinds[word] }
	if annotated_kind(word) == ValueKind.List { return ValueKind.List }
	ValueKind.Instance
}
# a character given to a field typed text is that text (`"r"` is a character here)
def texted(type: text?, value: TypedCode): TypedCode { if value.kind == ValueKind.Char and field_kind(type) == ValueKind.Text then shown_text(value) else value }
# whether a field typed `type` (ø: untyped) takes a value of the kind as it is, with no check or conversion; an
# instance of a class is a node, as Rust's class-typed fields take it
def admits(type: text?, kind: ValueKind): bool {
	if type != ø and is_union(aliased_type(type)) { return fits_union(aliased_type(type), kind) }
	type == ø or field_kind(type) == ValueKind.Node or field_kind(type) == kind or (kind == ValueKind.Node and aliased_type(type) in module.classes)
}
# a write to a field `name` of a target known only at run time: every class's field so named takes the kind; a value
# known only at run time too is written as it is, as Rust's field writes check no field type
def field_admits(name: text, kind: ValueKind): bool {
	if kind == ValueKind.Node { return yes }
	# the class of the target is not known here: a field of that name in any class admitting the kind may be the one
	# written (Function's `code: any` beside Parser's `code: text`)
	holders = module.classes.keys.filter(class_name => name in module.classes[class_name])
	#holders == 0 or holders.any(class_name => admits(module.classes[class_name][name], kind))
}
# the members a class body declares, a field as [name, type name (ø: untyped), default ([view], ø: none)]: `x`,
# `left?` (untyped, ø by default), `x: int`, `x: int = 0`, `n = 0`; any other member (a method `sq() := …`, an
# operator) as ø
declared_members(body: any): list := if kind_of(body) == "list" then body[3..].map(declared_field) else []
declared_fields(body: any): list := declared_members(body).filter(field => field != ø)
# a field's name as the view holds it: `x`, `"my field"`, `pi` (a constant's word)
field_name_kinds = ["symbol", "text", "number"]
without_optional_mark(name: text): text := name[0..<(#name - 1)]
declared_field(field: any): any := {
	kind = kind_of(field)
	if kind in field_name_kinds and field#2.ends_with("?") { return [without_optional_mark(field#2), ø, [ø]] }
	if kind in field_name_kinds { return [field#2, ø, ø] }
	if kind != "key" { return ø }
	if field#2 == ":" and kind_of(field#3) in field_name_kinds {
		type_name = type_name_of(field#4)
		# `b: text?`, optional: ø by default
		return [field#3#2, type_name, if type_name == base_type(type_name) then ø else [ø]]
	}
	if field#2 != "=" { return ø }
	named = declared_field(field#3)
	if named == ø { return ø }
	[named#1, named#2, [field#4]]
}
# an optional type's base, `text?` → text; any other type as it is
base_type(type: text?): text? := if type is text and #type > 1 and type.ends_with("?") then type[0..<(#type - 1)] else type
# a field's declared type as a name: `int` read as a type or as a symbol, `[int]` a list, else "?"
type_name_of(type: any): text := {
	if kind_of(type) == "symbol" { return type#2 }
	if kind_of(type) == "list" { return "list" }
	# `int or text`, a union (decision union-or)
	if kind_of(type) == "key" and type#2 == "or" { return type_name_of(type#3) + " or " + type_name_of(type#4) }
	if kind_of(type) == "type" and kind_of(type#2) == "symbol" { return type#2#2 }
	"?"
}
field_types(body: any): map := {
	types = {}
	for field in declared_fields(body) { types[field#1] = field#2 }
	types
}
field_defaults(body: any): map := {
	defaults = {}
	for field in declared_fields(body) { if field#3 != ø { defaults[field#1] = field#3 } }
	defaults
}

# a typed field's value of another kind, or known only at run time, is checked then: "not an int" as Rust's
# (rust-harness:src/wasm_emitter/declared_values.rs), a float field keeping an int
field_check(kind: ValueKind): text? := match kind {
	ValueKind.Int: "int_admitted"
	ValueKind.List: "list_admitted"
	ValueKind.Text: "text_checked"
	ValueKind.Bool: "bool_checked"
	ValueKind.Float: "float_checked"
	_: ø
}
def checked_at_run_time(field_type: text?, kind: ValueKind): bool { not admits(field_type, kind) and field_check(field_kind(field_type)) != ø }
def field_value(field_type: text?, value: TypedCode): TypedCode { if checked_at_run_time(field_type, value.kind) then runtime_call(field_check(field_kind(field_type)), [value]) else value }

# `m.x = v`, also as Rust lowers it, `m#("x"+1) = v`: the assignment gives v
def map_assignment(body: Body, target: Node, name: text, value: TypedCode): TypedCode {
	if checks_fields(body, target) and not field_admits(name, value.kind) { return refuse("a " + kind_spelling(value.kind) + " written to a typed field " + name) }
	# a field some class declares: that field's setter, which tests only the classes declaring it
	if declares_field(name) {
		held = [op.local_get] + uleb(fresh_local(body, value.kind))
		object = expression_code(body, target)
		setter = made_late(field_setter_prefix + name, ValueKind.Node, ["m", "value"])
		set = put_back(body, target, object, TypedCode(ValueKind.Node, call_values(setter, [object, TypedCode(value.kind, held)]).code))
		return TypedCode(value.kind, value.code + [op.local_set] + held[1..] + set + held)
	}
	entry_assignment(body, target, text_value_of(name), value)
}
# the entry named by the text `name` of the map `target` set to value, a variable target holding the result, a map
# made of ø; the assignment gives the value
def entry_assignment(body: Body, target: Node, name: TypedCode, value: TypedCode): TypedCode {
	if checks_fields(body, target) and name.kind != ValueKind.Text and #module.classes.keys > 0 { return refuse("a field write by a name a typed field may refuse") }
	held = [op.local_get] + uleb(fresh_local(body, value.kind))
	object = expression_code(body, target)
	set = put_back(body, target, object, TypedCode(ValueKind.Node, field_assignment(object, name, TypedCode(value.kind, held)).code))
	TypedCode(value.kind, value.code + [op.local_set] + held[1..] + set + held)
}
# `m[k] = v` of a value known only at run time, as lowered `m#(k+1) = v`: an int k sets the item k+1, any other key
# the entry named so (runtime.warp node_put); a variable m holds the result, a map made of ø; the assignment gives v
def keyed_assignment(body: Body, target: Node?, object: TypedCode, key: TypedCode, value: TypedCode): TypedCode {
	held = [op.local_get] + uleb(fresh_local(body, value.kind))
	put = TypedCode(ValueKind.Node, runtime_call("node_put", [object, TypedCode(ValueKind.Node, boxed(key)), TypedCode(ValueKind.Node, boxed(TypedCode(value.kind, held)))]).code)
	set = put_back(body, target, object, put)
	TypedCode(value.kind, value.code + [op.local_set] + held[1..] + set + held)
}
# the code of a put into the map node a place target holds (a variable, or a field or element of one: `p.b.c = 4`),
# which takes its result (ø becomes a map), else the put with its result dropped (a local named map reads as the word
# map: card local-named); a main-level variable a function changes an entry of is changed for every function, as a
# reference is in Rust's (`module.functions[name] = …`), not a new local of the function
def put_back(body: Body, target: Node?, object: TypedCode, put: TypedCode): list {
	if target is symbol and object.kind == ValueKind.Node and is_global(body, name_of(target)) { return dropped(global_assignment(global_key(body, name_of(target)), put)) }
	if is_place(target) and object.kind == ValueKind.Node then dropped(assignment(body, target, put)) else dropped(put)
}
# a variable, or a field or element of one: what an assignment can write
def is_place(target: Node?): bool {
	if target is symbol { return yes }
	type(target) is key and (op_of(target) == Op.Dot or op_of(target) == Op.Hash) and is_place(key_of(target))
}
# Rust checks a field write against the field's type only on a local it holds as an instance of the class
# (struct_backend.rs find_typed_structs), never on a parameter: `def ahead(p) { p.at = p.at + 1 }` writes as a map's
def checks_fields(body: Body, target: Node): bool {
	not (target is symbol and name_of(target) in body.names and body.names[name_of(target)] < #body.function.signature.parameters)
}
