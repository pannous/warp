# The runtime words a program links (emitter.warp's part): wasm intrinsics, library words, type tests on boxed values
# `name(a: float): float := wasm f64.floor`: the parameters in order, then the instruction, which leaves the result
def wasm_instruction(body: Body, name: text): TypedCode {
	if name in memory_instructions { return memory_instruction(body, name) }
	if name not in wasm_instructions { return refuse("wasm " + name) }
	code = []
	for i in 0..<#body.function.signature.parameters { code += [op.local_get] + uleb(i) }
	TypedCode(if name.starts_with("i64") then ValueKind.Int else ValueKind.Float, code + [wasm_instructions[name]])
}
# `get(address: int): float := wasm f64.load`: the first parameter, an address or a count of pages, wrapped to i32; a
# store leaves nothing, memory.size and memory.grow a count of pages (-1 where it can't grow)
def memory_instruction(body: Body, name: text): TypedCode {
	code = []
	for i in 0..<#body.function.signature.parameters { code += [op.local_get] + uleb(i) + (if i == 0 then [op.i32_wrap_i64] else []) }
	code += memory_instructions[name]
	if name.starts_with("memory") { return TypedCode(ValueKind.Int, code + [op.i64_extend_i32_s]) }
	TypedCode(if name.ends_with("store") then no_kind else if name.starts_with("i64") then ValueKind.Int else ValueKind.Float, code)
}
# a word runtime.warp's own functions call: theirs, even where the program defines a function of that name
# (shapes.warp's keyed(op, left, right) is no intrinsic keyed(kind, left, right))
def is_runtime_word(body: Body, name: text): bool {
	body.intrinsics and (name in intrinsics or name in time_intrinsics or name in module.runtime)
}
# a call of a function of the program that takes its arguments, not of a runtime word: a call it can't take is a form
# of the parser's or the lowering's of that name (`wasm f64.floor`, `try x`; emitter.warp compiling itself defines each)
def is_program_call(body: Body, name: text, arguments: list): bool {
	name in module.functions and not is_runtime_word(body, name) and takes_arguments(module.functions[name], arguments)
}
# whether f takes these arguments: no more than its parameters (any more after a rest one), a name given once, each
# place left out defaulted
def takes_arguments(f: Function, arguments: list): bool {
	if f.signature.parameters.any(parameter => parameter.rest) { return takes(f.signature, #arguments) }
	slots = placed_arguments(taken_names(f.signature), arguments)
	parameters = f.signature.parameters
	slots != ø and range_list(#parameters).all(i => (i < #slots and slots[i] != ø) or parameters[i].defaulted_to != ø)
}
# the words the runtime is written in, each one or two instructions
def intrinsic(body: Body, name: text, arguments: list): TypedCode {
	if name == "made_case" { return made_case(body, arguments) }
	if name == "baked_segment" { return baked_segment_code(body, arguments#1) }
	values = arguments.map(a => expression_code(body, a))
	if name in late_words { return call_values(late_word(name), values) }
	match name {
		"new_text": TypedCode(ValueKind.Text, index_code(values#1) + gc_code(gc_ops.array_new_default, [gc_type(gc.text)]))
		"byte_count": TypedCode(ValueKind.Int, converted(values#1, ValueKind.Text) + gc_code(gc_ops.array_len, []) + [op.i64_extend_i32_u])
		"byte_at": TypedCode(ValueKind.Int, converted(values#1, ValueKind.Text) + index_code(values#2) + gc_code(gc_ops.array_get_u, [gc_type(gc.text)]) + [op.i64_extend_i32_u])
		"kind_code": TypedCode(ValueKind.Int, kind_code_of(values#1.code))
		"unboxed_int": TypedCode(ValueKind.Int, unboxed(values#1.code, gc_type(gc.int_box)))
		"fresh_int_node": TypedCode(ValueKind.Node, fresh_int_code(converted(values#1, ValueKind.Int)))
		"marked_kind": TypedCode(ValueKind.Int, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]))
		"unboxed_list": unboxed_list_code(body, values#1)
		"unboxed_text": TypedCode(ValueKind.Text, payload(values#1.code, gc_type(gc.text)))
		"unboxed_char": TypedCode(ValueKind.Char, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_cast_null, []) + [i31_type] + gc_code(gc_ops.i31_get_u, []))
		"char_of": TypedCode(ValueKind.Char, index_code(values#1))
		"new_list": {
			count = [op.local_get] + uleb(fresh_local(body, ValueKind.Int))
			code = converted(values#1, ValueKind.Int) + [op.local_set] + count[1..] + count + [op.i32_wrap_i64] + count + [op.i32_wrap_i64]
			TypedCode(ValueKind.List, code + gc_code(gc_ops.array_new_default, [gc_type(gc.items)]) + gc_code(gc_ops.struct_new, [gc_type(gc.list)]))
		}
		"copy_items": {
			items = x => x + gc_code(gc_ops.struct_get, [gc_type(gc.list), 1])
			code = items(values#1.code) + index_code(values#2) + items(values#3.code) + index_code(values#4) + index_code(values#5)
			TypedCode(no_kind, code + gc_code(gc_ops.array_copy, [gc_type(gc.items), gc_type(gc.items)]))
		}
		# adopt_items(to, from): to takes from's length and items
		"adopt_items": {
			to = [op.local_get] + uleb(fresh_local(body, ValueKind.List))
			from = [op.local_get] + uleb(fresh_local(body, ValueKind.List))
			code = values#1.code + [op.local_set] + to[1..] + values#2.code + [op.local_set] + from[1..]
			taken = field => to + from + gc_code(gc_ops.struct_get, [gc_type(gc.list), field]) + gc_code(gc_ops.struct_set, [gc_type(gc.list), field])
			TypedCode(no_kind, code + taken(0) + taken(1))
		}
		# an entry's name, a symbol, text or character (name_node), as a text
		"key_name": TypedCode(ValueKind.Text, runtime_call("node_text", [TypedCode(ValueKind.Node, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]))]).code)
		"key_value": TypedCode(ValueKind.Node, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 2]))
		"map_of": TypedCode(ValueKind.Node, node(Marked.Map, values#1.code))
		"new_key": TypedCode(ValueKind.Node, entry_code(values#1.code, values#2.code))
		# item_room(list): the items its array holds, its length and the spare room after it; set_count(list, n)
		"item_room": TypedCode(ValueKind.Int, values#1.code + gc_code(gc_ops.struct_get, [gc_type(gc.list), 1]) + gc_code(gc_ops.array_len, []) + [op.i64_extend_i32_u])
		"set_count": TypedCode(no_kind, values#1.code + index_code(values#2) + gc_code(gc_ops.struct_set, [gc_type(gc.list), 0]))
		# keyed(kind, left, right): a $Node of the kind with the two nodes; entry_key(n) a key's left node
		# with_kind(n, kind): n's data and value in a $Node of that whole kind field
		"with_kind": {
			held = [op.local_get] + uleb(fresh_local(body, ValueKind.Node))
			part = i => as_node(held) + gc_code(gc_ops.struct_get, [gc_type(gc.node), i])
			TypedCode(ValueKind.Node, values#1.code + [op.local_set] + held[1..] + converted(values#2, ValueKind.Int) + part(1) + part(2) + gc_code(gc_ops.struct_new, [gc_type(gc.node)]))
		}
		"keyed": TypedCode(ValueKind.Node, values#1.code + values#2.code + as_node(values#3.code) + gc_code(gc_ops.struct_new, [gc_type(gc.node)]))
		"entry_key": TypedCode(ValueKind.Node, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_cast_null, [gc_type(gc.node)]))
		"symbol_of": TypedCode(ValueKind.Node, node(Kind.Symbol, values#1.code))
		# error_of(t): the Error of the message t, of no class (Rust's text_builtins.rs error_of)
		"error_of": TypedCode(ValueKind.Node, node(Kind.Error, values#1.code))
		# list_node(kind, list): a list's $Node of that whole kind field, its bracket and separator in it
		"list_node": TypedCode(ValueKind.Node, node_code(converted(values#1, ValueKind.Int), values#2.code))
		# meta_node(n, line, column): n's kind, data and value in a $MetaNode at that position, no comment
		"meta_node": {
			held = [op.local_get] + uleb(fresh_local(body, ValueKind.Node))
			part = i => as_node(held) + gc_code(gc_ops.struct_get, [gc_type(gc.node), i])
			code = values#1.code + [op.local_set] + held[1..] + part(0) + part(1) + part(2) + converted(values#2, ValueKind.Int) + converted(values#3, ValueKind.Int)
			TypedCode(ValueKind.Node, code + [ref_null, gc_type(gc.node), ref_null, gc_type(gc.node)] + gc_code(gc_ops.struct_new, [gc_type(gc.meta_node)]))
		}
		# meta_with_attributes(m, attributes): the $MetaNode m, its attributes these (a list's $Node)
		"meta_with_attributes": {
			held = [op.local_get] + uleb(fresh_local(body, ValueKind.Node))
			part = i => held + gc_code(gc_ops.ref_cast_null, [gc_type(gc.meta_node)]) + gc_code(gc_ops.struct_get, [gc_type(gc.meta_node), i])
			code = values#1.code + [op.local_set] + held[1..] + part(0) + part(1) + part(2) + part(3) + part(4) + part(5) + boxed(values#2)
			TypedCode(ValueKind.Node, code + gc_code(gc_ops.struct_new, [gc_type(gc.meta_node)]))
		}
		"meta_attributes": TypedCode(ValueKind.Node, values#1.code + gc_code(gc_ops.ref_cast_null, [gc_type(gc.meta_node)]) + gc_code(gc_ops.struct_get, [gc_type(gc.meta_node), 6]))
		"is_meta": TypedCode(ValueKind.Bool, values#1.code + gc_code(gc_ops.ref_test, [gc_type(gc.meta_node)]))
		"meta_line": TypedCode(ValueKind.Int, values#1.code + gc_code(gc_ops.ref_cast_null, [gc_type(gc.meta_node)]) + gc_code(gc_ops.struct_get, [gc_type(gc.meta_node), 3]))
		"meta_column": TypedCode(ValueKind.Int, values#1.code + gc_code(gc_ops.ref_cast_null, [gc_type(gc.meta_node)]) + gc_code(gc_ops.struct_get, [gc_type(gc.meta_node), 4]))
		"is_null": TypedCode(ValueKind.Bool, values#1.code + [op.ref_is_null])
		"same_text": TypedCode(ValueKind.Bool, values#1.code + values#2.code + [op.ref_eq])
		# same_list(a, b): the one list, not two lists of the same items (a map index finds its map so)
		"same_list": TypedCode(ValueKind.Bool, values#1.code + values#2.code + [op.ref_eq])
		# same_node(a, b): the one node, an enum case made once (decision enum-identity)
		"same_node": TypedCode(ValueKind.Bool, as_node(boxed(values#1)) + as_node(boxed(values#2)) + [op.ref_eq])
		# the error is the word's: a variant of it by arity is named `word·arity`
		"fail": TypedCode(pending, error_throw(body.function.name.split("·")#1) + [op.unreachable])
		"is_ratio": TypedCode(ValueKind.Bool, ratio_test(values#1.code))
		"is_plain_int": TypedCode(ValueKind.Bool, plain_int_test(values#1.code))
		"ratio_of": {
			ratio_node(converted(values#1, ValueKind.Int), converted(values#2, ValueKind.Int))
		}
		"ratio_numerator": TypedCode(ValueKind.Int, ratio_part(values#1.code, 0))
		"ratio_denominator": TypedCode(ValueKind.Int, ratio_part(values#1.code, 1))
		# ratio_of_parts(n, d): the $Ratio of two Int nodes, plain or big (a decimal past 10^18); numerator_part(r),
		# denominator_part(r) one of them as an Int node (runtime/extended/big_ratios.warp)
		"ratio_of_parts": made_by("Ratio", TypedCode(ValueKind.Node, node(Kind.Int, node_payload(values#1) + node_payload(values#2) + gc_code(gc_ops.struct_new, [gc_type(gc.ratio)]))))
		"numerator_part": TypedCode(ValueKind.Node, node(Kind.Int, payload(values#1.code, gc_type(gc.ratio)) + gc_code(gc_ops.struct_get, [gc_type(gc.ratio), 0])))
		"denominator_part": TypedCode(ValueKind.Node, node(Kind.Int, payload(values#1.code, gc_type(gc.ratio)) + gc_code(gc_ops.struct_get, [gc_type(gc.ratio), 1])))
		# has_plain_parts(r) of a local r: both parts in an $i64box (its code read twice)
		"has_plain_parts": TypedCode(ValueKind.Bool, plain_part_test(values#1.code, 0) + plain_part_test(values#1.code, 1) + [op.i32_and])
		# big_int_of(negative, count): an Int $Node of a $BigInt of count zero limbs; limb(n, i), set_limb(n, i, v) one
		# limb as an int from 0 to 2^32 - 1 (runtime/extended/big_ints.warp)
		"big_int_of": made_by("BigInt", TypedCode(ValueKind.Node, node(Kind.Int, converted(values#1, ValueKind.Bool) + index_code(values#2) + gc_code(gc_ops.array_new_default, [gc_type(gc.limbs)]) + gc_code(gc_ops.struct_new, [gc_type(gc.big_int)]))))
		"is_big_int": TypedCode(ValueKind.Bool, as_node(values#1.code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_test, [gc_type(gc.big_int)]))
		"big_int_negative": TypedCode(ValueKind.Bool, payload(values#1.code, gc_type(gc.big_int)) + gc_code(gc_ops.struct_get, [gc_type(gc.big_int), 0]))
		"limb_count": TypedCode(ValueKind.Int, limbs_of(values#1.code) + gc_code(gc_ops.array_len, []) + [op.i64_extend_i32_u])
		"limb": TypedCode(ValueKind.Int, limbs_of(values#1.code) + index_code(values#2) + gc_code(gc_ops.array_get, [gc_type(gc.limbs)]) + [op.i64_extend_i32_u])
		"set_limb": TypedCode(no_kind, limbs_of(values#1.code) + index_code(values#2) + index_code(values#3) + gc_code(gc_ops.array_set, [gc_type(gc.limbs)]))
		"unboxed_float": TypedCode(ValueKind.Float, unboxed(values#1.code, gc_type(gc.float_box)))
		"code_of": TypedCode(ValueKind.Int, values#1.code + [op.i64_extend_i32_u])
		"set_byte": TypedCode(no_kind, values#1.code + index_code(values#2) + index_code(values#3) + gc_code(gc_ops.array_set, [gc_type(gc.text)]))
		"output_byte": TypedCode(no_kind, index_code(values#1) + index_code(values#2) + [op.i32_store8, 0] + uleb(output_address))
		"write_output": TypedCode(ValueKind.Int, write_output(index_code(values#1)))
		# the address of the output bytes, where runtime/extended/wasi.warp lays out what WASI's calls read and write
		"output_address": TypedCode(ValueKind.Int, [op.i64_const] + sleb(output_address))
		"memory_byte": TypedCode(ValueKind.Int, index_code(values#1) + [op.i32_load8_u, 0, 0, op.i64_extend_i32_u])
		# the value written, as `x = v` is v
		"memory_set_byte": {
			written = uleb(fresh_local(body, ValueKind.Int))
			TypedCode(ValueKind.Int, index_code(values#1) + converted(values#2, ValueKind.Int) + [op.local_tee] + written + [op.i32_wrap_i64, op.i32_store8, 0, 0, op.local_get] + written)
		}
		# a GPU list's f32 cells (runtime/gpu_lists.warp): one read as a float, one written, pages added to the memory (the
		# page count before, -1 when it can't grow)
		"memory_f32": TypedCode(ValueKind.Float, index_code(values#1) + [op.f32_load, 2, 0, f64_promote])
		"memory_set_f32": TypedCode(no_kind, index_code(values#1) + converted(values#2, ValueKind.Float) + [f32_demote, op.f32_store, 2, 0])
		"memory_grown": TypedCode(ValueKind.Int, index_code(values#1) + [op.memory_grow, 0, op.i64_extend_i32_s])
		# copy_text(to, at, from, start, count)
		_: TypedCode(no_kind, values#1.code + index_code(values#2) + values#3.code + index_code(values#4) + index_code(values#5) + gc_code(gc_ops.array_copy, [gc_type(gc.text), gc_type(gc.text)]))
	}
}
# the intrinsics a program calls too, as Rust's text builtins byte_at(text, offset), memory_byte(address) and
# memory_set_byte(address, value)
program_intrinsics = ["byte_at", "memory_byte", "memory_set_byte", "same_node", "baked_segment"]
intrinsics = {baked_segment: 1, with_kind: 2, new_text: 1, copy_text: 5, byte_count: 1, byte_at: 2, code_of: 1, set_byte: 3,
	output_byte: 2, write_output: 1, output_address: 0, memory_byte: 1, memory_set_byte: 2, memory_f32: 1, memory_set_f32: 2, memory_grown: 1, kind_code: 1, unboxed_int: 1, unboxed_float: 1,
	marked_kind: 1, unboxed_text: 1, unboxed_char: 1, unboxed_list: 1, fail: 0, is_null: 1,
	char_of: 1, new_list: 1, copy_items: 5, adopt_items: 2, item_room: 1, set_count: 2, is_ratio: 1, is_plain_int: 1, shown_big_int: 1, made_case: 2, ratio_of: 2, ratio_numerator: 1, ratio_denominator: 1, ratio_of_parts: 2, numerator_part: 1, denominator_part: 1, has_plain_parts: 1,
	big_int_of: 2, is_big_int: 1, big_int_negative: 1, limb_count: 1, limb: 2, set_limb: 3,
	key_name: 1, key_value: 1, new_key: 2, map_of: 1, keyed: 3, entry_key: 1, symbol_of: 1, error_of: 1, list_node: 2, meta_node: 3, is_meta: 1, meta_line: 1, meta_column: 1, meta_with_attributes: 2, meta_attributes: 1, same_text: 2, same_list: 2, same_node: 2, fresh_int_node: 1, closure_text: 1, instance_set: 3, instance_entries: 1, instance_field_at: 2, instance_place: 2, is_class_instance: 1, instance_show: 1, instance_float: 1}
# the words a program calls that runtime.warp gives, by the runtime word's name
library_words = {gpu_zeros: "gpu_zeros", gpu_put: "gpu_put", gpu_list_of: "gpu_list_of", join: "joined", "float·cast": "float_cast", int_marked: "marked_int", int_mark_of: "int_mark", zero_fill: "zero_fill", round: "rounded", len: "node_length",
	text_form: "node_text", str: "node_text", split: "split_text", chars: "text_graphemes", code_point_list: "text_chars", reverse: "reversed", list_sum: "list_sum", list_pop: "list_pop", list_insert: "list_insert",
	floor_quotient: "floor_quotient", map_entries: "map_entries", map_keys: "map_keys", map_values: "map_values", keys: "map_keys", values: "map_values", has: "collection_contains", get: "map_get_or",
	collection_contains: "collection_contains", collection_position: "collection_position", key: "key_node", key_of: "key_left", value_of: "key_right", op_of: "key_operator",
	bracket_of: "list_bracket", separator_of: "list_separator", line_of: "node_line", column_of: "node_column", attributes_of: "attributes_of", with_attribute: "with_attribute", bracketed: "bracketed_node", separated: "separated_node", positioned: "positioned_node",
	name_of: "node_text", Symbol: "symbol_node", symbol: "symbol_node", sort: "sorted_node", sorted: "sorted_node", list_sorted_by: "sorted_node_by",
	slice: "node_slice", copy: "node_copy", starts_with: "node_starts_with", ends_with: "node_ends_with", lower: "text_lower", upper: "text_upper",
	trim: "node_trim", as_code: "code_node", read: "read_file", map_get_or: "map_get_or", removed_value: "removed_value", map_without: "map_without", contains: "collection_contains", is_error: "node_is_error", error: "error_node", caught_error: "caught_error", ord: "first_code_point", bytes: "text_byte_list", byte_size: "node_bytes", pack: "packed_node", unpack: "unpacked_node", byte_at: "text_byte", byte_slice: "bytes_between", float_bits: "bits_of_float", wasi_environment: "wasi_environment"}
# node_order knows no user compare: a program ordering instances by its own sorts outside the core
sort_words = ["sorted_node", "sorted_node_by"]
# a `compare(a: T, b: T)` of the program (its witness compare·T once Rust's traits.rs named it): the order of T's
# instances
def orders_instances(): bool { module.functions.keys.any(name => name == "compare" or name.starts_with("compare·")) }
# `x is spec`: the type words of Rust's BUILTIN_TYPES (rust-harness:src/lowering/types/type_tests.rs) the core holds, by their
# canonical name, and the kinds of the core each covers; an untyped value asks runtime.warp node_is_type
core_type_words = {int: "int", nat: "nat", integer: "int", long: "int", i64: "int", i32: "int", rational: "rational", real: "rational",
	exact: "rational", float: "float", double: "float", f64: "float", f32: "float", float32: "float", float64: "float",
	number: "number", text: "text", str: "text", string: "text", codepoint: "char", char: "char", character: "char",
	bool: "bool", boolean: "bool", list: "list", key: "key", pair: "key", symbol: "symbol", map: "map", error: "error", code: "code",
	function: "function", block: "function"}
# the kinds of a value known only at run time each type passes, as Rust's BUILTIN_TYPES masks take them: an int is a
# rational and a number, a float too, a character a text, a block a list; `code` none, it is a mark (runtime
# types.warp node_is_type, held_kind_bit)
passing_kinds = {int: [Kind.Int], nat: [Kind.Int], rational: [Kind.Int, HeldBit.Rational, Kind.Float], float: [Kind.Float],
	number: [Kind.Int, HeldBit.Rational, Kind.Float], text: [Kind.Text, Kind.Codepoint], char: [Kind.Codepoint],
	bool: [HeldBit.Bool], list: [Kind.List, Kind.Block], key: [Kind.Key], symbol: [Kind.Symbol], map: [HeldBit.Map],
	error: [Kind.Error], code: [], function: [Kind.Function]}
covered_kinds = {int: [ValueKind.Int], nat: [ValueKind.Int], rational: [ValueKind.Int], float: [ValueKind.Float], number: [ValueKind.Int, ValueKind.Float], text: [ValueKind.Text, ValueKind.Char],
	char: [ValueKind.Char], bool: [ValueKind.Bool], list: [ValueKind.List], key: [], symbol: [], map: [], error: [], code: [], function: []}
kind_bit(kind: int): int := 1 << kind
# whether the class is the ancestor or extends it
descends(name: text, ancestor: text): bool := name == ancestor or (name in module.parents and descends(module.parents[name], ancestor))
def type_test_code(body: Body, subject: Node, spec: text): TypedCode {
	if spec in module.sum_types and module.sum_types[spec] == "cases" { return refuse("a test of the type " + spec + ", which has cases") }
	# an instance of the class or of one extending it, whatever the subject: `(5ms) is Quantity` of a Time
	if spec in module.classes { return runtime_call("instance_among", [TypedCode(ValueKind.Node, boxed(expression_code(body, subject))), list_value(body, module.classes.keys.filter(name => descends(name, spec)))]) }
	if spec not in core_type_words { return refuse("a test of the type " + spec) }
	type = core_type_words[spec]
	value = expression_code(body, subject)
	if value.kind == ValueKind.Node { return node_type_test(body, value, type) }
	TypedCode(ValueKind.Bool, [op.i32_const, if covered_kinds[type].any(kind => same_kind(kind, value.kind)) then 1 else 0])
}
# (typed, so a kind from a table and one a cast spelled, `2 as float`, compare as kinds)
same_kind(a: ValueKind, b: ValueKind): bool := a == b
# `x is type` of a value known only at run time: its held kind bit against the kinds passing the type, inline, as
# Rust's kind masks; a type value (`int is number`) and `is code` ask runtime node_is_type
def node_type_test(body: Body, value: TypedCode, type: text): TypedCode {
	kinds = 0
	for kind in passing_kinds[type] { kinds = bit_or(kinds, kind_bit(kind)) }
	if kinds == 0 { return runtime_call("node_is_type", [value, text_value(type), number_value(kinds)]) }
	held = [op.local_get] + uleb(fresh_local(body, ValueKind.Node))
	bits = [op.local_get] + uleb(fresh_local(body, ValueKind.Int))
	read = value.code + [op.local_set] + held[1..] + held_kind_bit_code(body, held) + [op.local_tee] + bits[1..]
	type_value = read + [op.i64_const] + sleb(kind_bit(HeldBit.TypeValue)) + [op.i64_and, op.i64_eqz, op.i32_eqz]
	passes = TypedCode(ValueKind.Bool, bits + [op.i64_const] + sleb(kinds) + [op.i64_and, op.i64_eqz, op.i32_eqz])
	TypedCode(ValueKind.Bool, type_value + if_else_code(ValueKind.Bool, runtime_call("node_is_type", [TypedCode(ValueKind.Node, held), text_value(type), number_value(kinds)]), passes))
}
# the held kind of the node `held` as one bit, as runtime held_kind_bit places it: 1 << its Kind, a yes/no, type value,
# map or exact rational the bit of its HeldBit place, ø a list; no call, each mark picked by a select
def held_kind_bit_code(body: Body, held: list): list {
	field = [op.local_get] + uleb(fresh_local(body, ValueKind.Int))
	kind = field + [op.i64_const] + sleb(kind_mask) + [op.i64_and]
	is_field = marked => field + [op.i64_const] + sleb(marked) + [op.i64_eq]
	ratio = kind + [op.i64_const] + sleb(Kind.Int) + [op.i64_eq] + ratio_test(held) + [op.i32_and]
	marked = as_node(held) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.local_set] + field[1..] + [op.i64_const, 1] + kind + [shift_ops.i64_shl]
	marked += unless_held(HeldBit.Bool, is_field(Marked.Bool)) + unless_held(HeldBit.TypeValue, is_field(Marked.TypeValue))
	marked += unless_held(HeldBit.Map, is_field(Marked.Map)) + unless_held(HeldBit.Rational, ratio)
	held + [op.ref_is_null, op.if] + value_type(ValueKind.Int) + held_bit(Kind.List) + [op.else] + marked + [op.end]
}
def held_bit(place: int): list { [op.i64_const] + sleb(kind_bit(place)) }
# the bit on the stack, or the place's bit when the test holds
def unless_held(place: int, test: list): list { held_bit(place) + test + [op.i32_eqz, op.select] }
# a boxed value's code as a $Node; its Kind without the marks above it; its payload: the value in a box, or a text
def as_node(code: list): list { code + gc_code(gc_ops.ref_cast_null, [gc_type(gc.node)]) }
def kind_code_of(code: list): list { as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(kind_mask) + [op.i64_and] }
# a list node's $list; a GPU list's cells are no $list, so a list word given one refuses loudly naming it
# (runtime/gpu_lists.warp gpu_list_refused_as) rather than casting
def unboxed_list_code(body: Body, value: TypedCode): TypedCode {
	held = uleb(fresh_local(body, ValueKind.Node))
	data = [op.local_get] + held + as_node([]) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1])
	code = value.code + [op.local_set] + held + data + gc_code(gc_ops.ref_test, [gc_type(gc.list)]) + [op.if] + gc_bytes(references.list)
	code += data + gc_code(gc_ops.ref_cast_null, [gc_type(gc.list)]) + [op.else]
	code += dropped(runtime_call("gpu_list_refused_as", [TypedCode(ValueKind.Node, [op.local_get] + held)])) + [op.unreachable, op.end]
	TypedCode(ValueKind.List, code)
}
def payload(code: list, held: int): list { as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_cast_null, [held]) }
def unboxed(code: list, box: int): list { payload(code, box) + gc_code(gc_ops.struct_get, [box, 0]) }
# an Int node's data, its $i64box or $BigInt, as a $Ratio holds a part
def node_payload(value: TypedCode): list { as_node(boxed(value)) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) }
# whether an Int $Node holds a $Ratio (an i32); the numerator (0) or denominator (1) of one
# whether an Int $Node holds its number in an $i64box (an i32), neither a ratio nor a big int
def plain_int_test(code: list): list { as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_test, [gc_type(gc.int_box)]) }
# an Int $Node of the $Ratio of the two ints' code, numerator and denominator, the program then making ratios
def ratio_node(numerator: list, denominator: list): TypedCode {
	box = code => code + gc_code(gc_ops.struct_new, [gc_type(gc.int_box)])
	made_by("Ratio", TypedCode(ValueKind.Node, node(Kind.Int, box(numerator) + box(denominator) + gc_code(gc_ops.struct_new, [gc_type(gc.ratio)]))))
}
def ratio_test(code: list): list { as_node(code) + gc_code(gc_ops.struct_get, [gc_type(gc.node), 1]) + gc_code(gc_ops.ref_test, [gc_type(gc.ratio)]) }
def plain_part_test(code: list, field: int): list { payload(code, gc_type(gc.ratio)) + gc_code(gc_ops.struct_get, [gc_type(gc.ratio), field]) + gc_code(gc_ops.ref_test, [gc_type(gc.int_box)]) }
def ratio_part(code: list, field: int): list { payload(code, gc_type(gc.ratio)) + gc_code(gc_ops.struct_get, [gc_type(gc.ratio), field]) + gc_code(gc_ops.ref_cast_null, [gc_type(gc.int_box)]) + gc_code(gc_ops.struct_get, [gc_type(gc.int_box), 0]) }
# the $Limbs array of an Int $Node holding a $BigInt
def limbs_of(code: list): list { payload(code, gc_type(gc.big_int)) + gc_code(gc_ops.struct_get, [gc_type(gc.big_int), 1]) }
# `shown_big_int(n)`: a big int's text, a function made at its first call whose code is written last (as closure_text):
# big_ints.warp's big_int_text when the program makes big ints (big_int_of compiled), else a trap, so
# that a program printing only plain ints carries neither big_int_text nor the $Limbs and $BigInt types
shown_big_int_name = "shown_big_int"
shown_big_int_code(f: Function): any := {
	f.code = [op.unreachable]
	if "BigInt" in module.made { f.code = call_values(module.runtime["big_int_text"], [TypedCode(ValueKind.Node, [op.local_get, 0])]).code }
}
# `made_case(Made.BigInt, big_int_sum(a, b))` in a runtime word: once the program makes values of that kind
# (module.made), the return of the call where one of its arguments holds such a value; before that nothing, so a
# program making none carries neither the call nor the words it reaches (a shown value no time's text). Its function
# is noted (module.made_sites) and read again when a kind is first made (module_compiled): each maker notes its kind
# (made_by: big_int_of, ratio_node, times.warp time_node)
made_tests = {BigInt: "holds_big_int", Ratio: "holds_ratio", Time: "holds_time"}
# the words making a value of each kind, compiled into the prepended runtime (made_by, times.warp time_node)
made_makers = {BigInt: ["big_int_of"], Ratio: ["ratio_of_parts"], Time: ["time_of", "instant_at"]}
def made_case(body: Body, arguments: list): TypedCode {
	made = name_of(value_of(arguments#1))
	if made not in module.made {
		if not module.made_sites.any(f => f.name == body.function.name) { module.made_sites += [body.function] }
		return TypedCode(no_kind, [])
	}
	call = arguments#2
	values = items_of(call)[1 ..].map(a => expression_code(body, a))
	test = []
	for i in 0..<#values {
		test += condition(call_values(module.runtime[made_tests[made]], [values[i]]))
		if i > 0 { test += [op.i32_or] }
	}
	called = return_value(body, call_values(module.runtime[name_of(call#1)], values))
	TypedCode(no_kind, test + [op.if, no_value] + called.code + [op.end])
}
# the code of a value of that kind (a case of kinds.warp Made), the program then making it
def made_by(made: text, code: TypedCode): TypedCode {
	module.made[made] = yes
	code
}
