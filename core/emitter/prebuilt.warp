# runtime.wasm (emitter.warp's part; card runtime-prebuilt, notes/runtime_linking.md "runtime.wasm format"): every
# runtime word compiled once, no program deciding its kinds or what it makes, and the hooks a program gives the code of
# the module of the runtime words alone, its bytes: read again while a reading leaves out a word more
runtime_wasm_module(runtime: Node, host: map): any := {
	module.prebuilding = yes
	module.relocating = yes
	module.left_out = {}
	made = ø
	while made == ø { made = typed_wasm_module(Node.Empty, runtime, host, {}) }
	module.prebuilding = no
	module.relocating = no
	made
}
# every word compiled in name order, but those outside the core on their own (an enum's method naming the program's
# enum): left out, and named in warp.runtime, for a program to compile as today; then the hooks: the closure calls of
# each arity up to hook_arities and the late words, each a stub calling its slot of the table `hooks`
def prebuilt_runtime(): any {
	left = #module.left_out.keys
	for name in module.runtime.keys {
		f = module.runtime[name]
		if f.kinds == ø and name not in module.left_out {
			try { compile_function(f, f.signature.parameters.map(p => ValueKind.Node)) } catch refusal {
				if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
				module.left_out[name] = "" + refusal
			}
		}
	}
	if #module.left_out.keys > left { return ø }
	all_hooks()
	for f in module.rereads {
		module.saw_pending = no
		body_code(f)
	}
	for slot in 0..<#module.dispatchers { hook_stub(module.dispatchers[slot], slot) }
	if module.widened_now { return ø }
	module_bytes(module.order)
}
# a hook's code in runtime.wasm: its parameters passed to the function in its slot of the table, of the hook's own type
def hook_stub(f: Function, slot: int) {
	f.code = concatenated(range_list(#f.kinds).map(i => [op.local_get] + uleb(i))) + [op.i32_const] + sleb(slot)
	f.code += [call_indirect] + uleb(#module.gc_order + f.index) + [0]
}
# the closure calls of each arity up to hook_arities and the late words: runtime.wasm's hooks
def all_hooks() {
	for arity in 0..(hook_arities + 1) { dispatcher(arity) }
	for name in late_words.keys { late_word(name) }
}

## a program behind runtime.wasm (card runtime-prepended, notes/runtime_linking.md): the runtime's imports, types,
## functions, globals and texts first, as runtime.wasm has them; the program's numbered behind them
# runtime.wasm read back (prepend_runtime), ø while a program compiles the runtime words it calls itself
global runtime_image = ø
class RuntimeImage { wasm: list; types: int; imports: int; functions: int; data: int; globals: list; words: map; hooks: list }
def prepend_runtime(wasm: any) { runtime_image = if wasm == ø then ø else runtime_image_of(wasm) }
def prepended(): bool { runtime_image != ø and not module.prebuilding }
# its layout, the binary warp.runtime: the counts, the hooks' and left words' names, each global's name and kind, each
# word's name, index, parameter kinds and result kind
def runtime_image_of(wasm: list): any {
	place = section_place(wasm, section_ids.custom, runtime_section)
	if place == ø { throw "runtime.wasm without its " + runtime_section + " section: warp rebuild writes it anew" }
	layout = ByteReader(wasm, place#1)
	if read_number(layout) != #gc_names { throw "runtime.wasm of other GC types: warp rebuild writes it anew" }
	imports = read_number(layout)
	functions = read_number(layout)
	read_number(layout)
	texts_size = read_number(layout)
	hooks = read_names(layout)
	left = read_names(layout)
	globals = []
	for i in 0..<read_number(layout) { globals += [[read_name(layout), read_kind(layout)]] }
	words = {}
	for i in 0..<read_number(layout) {
		name = read_name(layout)
		index = read_number(layout)
		kinds = []
		for j in 0..<read_number(layout) { kinds += [read_kind(layout)] }
		result = read_kind(layout)
		words[name] = [index, kinds, result, read_signature(layout)]
	}
	types = uleb_read(wasm, section_place(wasm, section_ids.type)#1)#1
	RuntimeImage(wasm, types, imports, functions, texts_size, globals, words, hooks)
}
# a reading of bytes from a place on: LEB128 numbers, names (a length and UTF-8 bytes), kinds (held_kinds' places)
class ByteReader { bytes: list; offset: int }
def read_number(reader: ByteReader): int {
	read = uleb_read(reader.bytes, reader.offset)
	reader.offset = read#2
	read#1
}
def read_name(reader: ByteReader): text {
	count = read_number(reader)
	name = utf8_text(reader.bytes[reader.offset ..< reader.offset + count])
	reader.offset += count
	name
}
def read_names(reader: ByteReader): list {
	names = []
	for i in 0..<read_number(reader) { names += [read_name(reader)] }
	names
}
def read_kind(reader: ByteReader): ValueKind { held_kinds[read_number(reader)] }
def read_signature(reader: ByteReader): any {
	parameters = []
	for i in 0..<read_number(reader) {
		name = read_name(reader)
		type_name = read_name(reader)
		flags = read_number(reader)
		default = if bit_and(flags, default_flag) != 0 then [unpack(read_name(reader))] else ø
		parameters += [Parameter(name, type_name, default, bit_and(flags, rest_flag) != 0)]
	}
	Signature(parameters, read_name(reader))
}
# the kinds a function or global of runtime.wasm holds, each written as its place here
held_kinds = [ValueKind.Int, ValueKind.Float, ValueKind.Bool, ValueKind.Char, ValueKind.I32, ValueKind.Text, ValueKind.List, ValueKind.Node, ValueKind.Time, ValueKind.Nothing]
def held_code(kind: ValueKind): int {
	for i in 0..<#held_kinds { if held_kinds[i] == kind { return i } }
	throw "runtime.wasm holds no " + kind + " value"
}
# UTF-8 bytes as their text, a code point at a time
def utf8_text(bytes: list): text {
	characters = []
	i = 0
	while i < #bytes {
		lead = bytes[i]
		count = if lead < 128 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4
		code = if count == 1 then lead else bit_and(lead, 255 >> (count + 1))
		for j in 1..<count { code = code * 64 + bit_and(bytes[i + j], 63) }
		characters += [chr(code)]
		i += count
	}
	characters.join("")
}
# the module behind the runtime: its globals, texts and functions numbered from the runtime's, a class struct's type
# from the runtime's type count; every Made kind made and errors caught, as the runtime does
def behind_runtime() {
	module.catches_errors = yes
	module.globals = {}
	module.global_order = []
	for entry in runtime_image.globals { declared_global(entry#1, entry#2) }
	module.placed = runtime_image.functions
	# the program's texts in a data segment of its own (own_texts_segment), so its code is the same linked as prepended
	module.text_size = 0
	module.runtime_types = runtime_image.types - #gc_names
}
# the runtime's imports, as runtime_wasm_module declared them: WASI's fd_write, then every host word
# then the program's C functions, which move the runtime's functions up by their count (runtime_shift)
def runtime_imports(host: map): list {
	held = module.host
	module.host = host
	imports = imported_words(host.keys.filter(name => not is_c_function(host[name])), yes)
	if #imports != runtime_image.imports { throw "runtime.wasm imports other host words than this harness has: warp rebuild writes it anew" }
	imports += imported_words(host.keys.filter(name => is_c_function(host[name])), no)
	module.host = held
	imports
}
def runtime_shift(): int := #module.imports - runtime_image.imports
# the runtime words a program calls: runtime.wasm's, each at its index, of its kinds and signature; none is lowered or
# compiled again (the runtime's sources are read only to build runtime.wasm)
def bind_runtime_words() {
	for name in runtime_image.words.keys {
		if name not in runtime_image.hooks {
			word = runtime_image.words[name]
			f = Function(name, word#4, ø)
			f.index = word#1 + runtime_shift()
			f.kinds = word#2
			f.result = word#3
			f.is_runtime = yes
			module.runtime[name] = f
		}
	}
}
# a hook of runtime.wasm, whose code the program writes (late_code) over the stub's
runtime_hook(name: text, parameters: list): any := {
	word = runtime_image.words[name]
	f = bare_function(name)
	f.index = word#1 + runtime_shift()
	f.kinds = word#2
	f.result = word#3
	f.locals = []
	f.local_names = parameters
	f.code = [op.unreachable]
	f
}
is_runtime_hook(name: text): bool := prepended() and name in runtime_image.hooks

# the content of runtime.wasm's section of this id, a custom one by its name; the vector it holds with more entries
def runtime_part(id: int, name: text = ""): list {
	place = section_place(runtime_image.wasm, id, name)
	runtime_image.wasm[place#1 ..< place#2]
}
def with_entries(content: list, more: list): list {
	count = uleb_read(content, 0)
	uleb(count#1 + #more) + content[count#2 ..] + concatenated(more)
}
# the runtime's code, each call of a runtime function moved by the C functions' imports (not those of host words)
def rebased_runtime_code(): list {
	content = runtime_part(section_ids.code)
	if runtime_shift() == 0 { return content }
	calls = relocations_of(runtime_image.wasm).filter(entry => entry#2 == relocated.calls and entry#3 == runtime_space and uleb_read(content, entry#1)#1 >= runtime_image.imports)
	rebased(content, calls, [[runtime_shift()]])
}
# the code section's content: the runtime's functions, a hook's the program's code, then the program's functions, each
# body knowing where it starts (its relocations' offsets)
def prepended_code(functions: list): list {
	runtime = rebased_runtime_code()
	count = uleb_read(runtime, 0)
	at = count#2
	content = uleb(count#1 + #functions)
	for p in 0..<count#1 {
		size = uleb_read(runtime, at)
		end = size#2 + size#1
		hook = module.dispatchers.filter(f => f.index == #module.imports + p)
		content += if #hook > 0 then function_body(hook#1, #content) else runtime[at ..< end]
		at = end
	}
	for f in functions { content += function_body(f, #content) }
	content
}
# the runtime's texts: its one passive segment's bytes
def runtime_texts(): list {
	content = runtime_part(section_ids.data)
	size = uleb_read(content, 2)
	content[size#2 ..< size#2 + size#1]
}
# a subsection of runtime.wasm's names by its id, its content (an empty vector when it has none); with more entries
def runtime_subsection(id: int): list {
	content = runtime_part(section_ids.custom, "name")
	at = 0
	while at < #content {
		size = uleb_read(content, at + 1)
		if content[at] == id { return content[size#2 ..< size#2 + size#1] }
		at = size#2 + size#1
	}
	uleb(0)
}
def runtime_names(id: int, more: list): list { subsection(id, with_entries(runtime_subsection(id), more)) }
# the runtime's local names, each function's moved by runtime_shift, then more
def shifted_locals(content: list, more: list): list {
	if runtime_shift() == 0 { return with_entries(content, more) }
	count = uleb_read(content, 0)
	at = count#2
	entries = []
	for i in 0..<count#1 {
		index = uleb_read(content, at)
		end = name_map_end(content, index#2)
		entries += [uleb(index#1 + runtime_shift()) + content[index#2 ..< end]]
		at = end
	}
	uleb(count#1 + #more) + concatenated(entries) + concatenated(more)
}
# where a name map (a vector of index and name) that starts at `at` ends
def name_map_end(content: list, at: int): int {
	count = uleb_read(content, at)
	at = count#2
	for i in 0..<count#1 {
		at = uleb_read(content, at)#2
		size = uleb_read(content, at)
		at = size#2 + size#1
	}
	at
}
def own_function_type(f: Function): int := runtime_image.types + #module.gc_order - #gc_names + f.index - #module.imports - runtime_image.functions
def prepended_bytes(functions: list): list {
	function_types = functions.map(function_type)
	classes = module.gc_order[#gc_names ..]
	class_types = if #classes == 0 then [] else [[rec_group_byte] + uleb(#classes) + concatenated(classes.map(name => gc_bytes(gc_definition(name))))]
	types = section(section_ids.type, with_entries(runtime_part(section_ids.type), class_types + function_types + c_import_types()))
	c_entries = c_import_entries(runtime_image.types + #classes + #functions)
	declared = section(section_ids.function, with_entries(runtime_part(section_ids.function), functions.map(f => uleb(own_function_type(f)))))
	own_globals = module.global_order[#runtime_image.globals ..]
	globals = section(section_ids.globals, with_entries(runtime_part(section_ids.globals), own_globals.map(global_entry)))
	codes = section(section_ids.code, prepended_code(functions))
	texts = section(section_ids.data, vector([passive(runtime_texts()), passive(data_bytes())]))
	memory = section(section_ids.memory, vector([[0] + uleb(memory_pages)]))
	parts = [types, section(section_ids.import, with_entries(runtime_part(section_ids.import), c_entries)), declared, section(table_section_id, runtime_part(table_section_id)), memory,
		section(section_ids.tag, runtime_part(section_ids.tag)), globals, section(section_ids.export, vector(program_exports(functions))), section(section_ids.data_count, uleb(2)), codes, texts]
	wasm_header + concatenated(parts) + prepended_names(functions, classes, own_globals) + program_marks() + runtime_sections(functions)
}
# the program's C functions, imported behind the runtime's host words; their types after every other: no runtime type moves
def c_imports(): list { module.imports[runtime_image.imports ..] }
def c_import_types(): list { c_imports().map(entry => entry#3) }
def c_import_entries(first_type: int): list {
	imports = c_imports()
	range_list(#imports).map(k => name_bytes(imports[k]#1) + name_bytes(imports[k]#2) + [import_function_byte] + uleb(first_type + k))
}
# what the harness reads of a program: whether it counts fuel, its C functions
def program_marks(): list {
	fuel = if module.counts_fuel then section(section_ids.custom, name_bytes(fuel_section)) else []
	fuel + c_functions_custom_section()
}
# runtime.wasm's names and the program's behind them
def prepended_names(functions: list, classes: list, own_globals: list): list {
	imported = range_list(#module.imports).map(i => index_name(i, module.imports#(i + 1)#2))
	words = runtime_image.words.keys.map(name => index_name(runtime_image.words[name]#1 + runtime_shift(), name))
	content = subsection(names_subsections.functions, vector(imported + words + functions.map(f => index_name(f.index, f.name))))
	content += subsection(names_subsections.locals, shifted_locals(runtime_subsection(names_subsections.locals), functions.map(local_name_map)))
	content += runtime_names(names_subsections.types, classes.map(name => index_name(module.gc_indices[name], name)))
	content += runtime_names(names_subsections.globals, own_globals.map(name => index_name(module.globals[name]#1, name)))
	content += runtime_names(names_subsections.fields, classes.map(name => uleb(module.gc_indices[name]) + name_map(gc_field_names(name))))
	content += runtime_names(names_subsections.tags, [])
	section(section_ids.custom, name_bytes("name") + content)
}

## a library module prebuilt (card modules-prebuilt, notes/runtime_linking.md "Library modules"): its words compiled
## once behind runtime.wasm from their declared kinds, its own items numbered from the runtime's counts, every index
## operand padded and listed, so a link appends it behind the runtime and the modules before it
# where the module's own items start in each index space (relocated): behind the runtime's imports and functions,
# types and globals; its texts in a segment of their own
def own_items_from(): list := [#module.imports + runtime_image.functions, runtime_image.types, #runtime_image.globals, 0]

## a program linked to runtime.wasm (card runtime-separate-modules, notes/runtime_linking.md "Separate modules"): numbered
## as behind it, but every runtime function, global, the memory, the error tag and the hooks table imported from its
## instance (`warp_runtime`), so no index moves; the hooks' code the program's own, set into the table at instantiation
runtime_module_name = "warp_runtime"
element_section_id = 9
# the runtime's names by function index, as warp.runtime gives them
def runtime_function_names(): map {
	names = {}
	for name in runtime_image.words.keys { names[runtime_image.words[name]#1] = name }
	names
}
# an import of runtime.wasm's: its export of this name, of this kind and description
def runtime_import(name: text, kind: int, description: list): list { name_bytes(runtime_module_name) + name_bytes(name) + [kind] + description }
# the entries after the count of one of runtime.wasm's sections
def runtime_entries(id: int): list {
	content = runtime_part(id)
	content[uleb_read(content, 0)#2 ..]
}
# the C functions' imports right after the host words, as when prepended, so the runtime's functions move alike
def linked_imports(c_first_type: int): list {
	names = runtime_function_names()
	types = runtime_part(section_ids.function)
	at = uleb_read(types, 0)#2
	functions = []
	for i in 0..<runtime_image.functions {
		type = uleb_read(types, at)
		functions += [runtime_import(names[runtime_image.imports + i], export_function_byte, uleb(type#1))]
		at = type#2
	}
	memory = runtime_import("memory", export_memory_byte, [0] + uleb(memory_pages))
	table = runtime_import(hooks_table, export_table_byte, runtime_entries(table_section_id))
	tag = runtime_import(error_tag_name, export_tag_byte, runtime_entries(section_ids.tag))
	globals = runtime_image.globals.map(entry => runtime_import(entry#1, export_global_byte, value_type(entry#2) + [mutable]))
	with_entries(runtime_part(section_ids.import), c_import_entries(c_first_type) + functions + [memory, table, tag] + globals)
}
# the program's hooks: its own functions behind the others, the i-th at the first free index + i, each set into its
# slot of the runtime's table at instantiation
def own_hooks(): list { module.dispatchers.filter(f => f.name in runtime_image.hooks) }
def hook_elements(hooks: list, first: int): list {
	vector(range_list(#hooks).map(i => [0, op.i32_const] + sleb(runtime_image.hooks.index_of(hooks[i].name) - 1) + [op.end] + vector([uleb(first + i)])))
}
def linked_bytes(functions: list): list {
	hooks = own_hooks()
	first_hook = functions.last.index + 1
	hook_types = hooks.map(f => uleb(runtime_type_of(f)))
	classes = module.gc_order[#gc_names ..]
	class_types = if #classes == 0 then [] else [[rec_group_byte] + uleb(#classes) + concatenated(classes.map(name => gc_bytes(gc_definition(name))))]
	types = section(section_ids.type, with_entries(runtime_part(section_ids.type), class_types + functions.map(function_type) + c_import_types()))
	declared = section(section_ids.function, vector(functions.map(f => uleb(own_function_type(f))) + hook_types))
	own_globals = module.global_order[#runtime_image.globals ..]
	globals = section(section_ids.globals, vector(own_globals.map(global_entry)))
	elements = section(element_section_id, hook_elements(hooks, first_hook))
	codes = section(section_ids.code, vector(functions.map(f => function_body(f, 0)) + hooks.map(f => function_body(f, 0))))
	# segment 0 the runtime's, empty here: array.new_data reads only its own module's segments
	texts = section(section_ids.data, vector([passive([]), passive(data_bytes())]))
	parts = [types, section(section_ids.import, linked_imports(runtime_image.types + #classes + #functions)), declared, globals, section(section_ids.export, vector(program_exports(functions))), elements, section(section_ids.data_count, uleb(2)), codes, texts]
	names = vector(functions.map(f => index_name(f.index, f.name)) + range_list(#hooks).map(i => index_name(first_hook + i, hooks[i].name)))
	wasm_header + concatenated(parts) + section(section_ids.custom, name_bytes("name") + subsection(names_subsections.functions, names)) + program_marks()
}
# the type runtime.wasm declares its function of this index with
def runtime_type_of(f: Function): int {
	types = runtime_part(section_ids.function)
	at = uleb_read(types, 0)#2
	for i in 0..<(f.index - #module.imports) { at = uleb_read(types, at)#2 }
	uleb_read(types, at)#1
}
