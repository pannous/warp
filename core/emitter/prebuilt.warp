# runtime.wasm (emitter.warp's part; card runtime-prebuilt, notes/runtime_linking.md "runtime.wasm format"): every
# runtime word compiled once, no program deciding its kinds or what it makes, and the hooks a program gives the code of
# the module of the runtime words alone, its bytes: read again while a reading leaves out a word more
runtime_wasm_module(runtime: Node, host: map): any := {
	module.prebuilding = yes
	module.relocating = yes
	module.left_out = {}
	made = ø
	while made == ø { made = typed_wasm_module(Node.Empty, runtime, host, {}) }
	module.prebuilding = no
	module.relocating = no
	dropped = module.left_out.keys.filter(name => not is_programs_method(name))
	if #dropped > 0 then dropped_words_refusal(dropped) else made
}
# only a method of a type the program declares (Separator·text, its enum unknown to the runtime) may stay outside
# runtime.wasm: any other word left out would vanish from every program built on it, as an older seed's runtime of
# newer sources lost read_file (a word reaching a new enum case it does not know; card seed-compiles), the build
# failing much later as "no field read_file". Refused, saying why
is_programs_method(name: text): bool := {
	owner = name.split("·")#1
	name.contains("·") and not module.enum_cases.has(owner) and not module.classes.has(owner)
}
# (the first few words and why: one cause usually drops hundreds of callers, a table case named by the first)
dropped_words_refusal(dropped: list): text := {
	why = dropped[0 ..< min(3, #dropped)].map(name => name + " (" + module.left_out[name] + ")").join(", ")
	more = if #dropped > 3 then " and " + (#dropped - 3) + " more words" else ""
	"runtime.wasm would leave out " + why + more + ": this compiler cannot compile the runtime it builds; an older seed than its sources? scripts/refresh-seed.sh makes a newer one"
}
# every word compiled in name order, but those outside the core on their own (an enum's method naming the program's
# enum): left out, and named in warp.runtime, for a program to compile as today; then the closure calls of each arity
# up to hook_arities and the late words, which call through a closure's entry or an instance's descriptor
def prebuilt_runtime(): any {
	left = #module.left_out.keys
	for name in module.runtime.keys {
		f = module.runtime[name]
		if f.kinds == ø and name not in module.left_out {
			try { compile_function(f, f.signature.parameters.map(p => ValueKind.Node)) } catch refusal {
				if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
				module.left_out[name] = "" + refusal
			}
		}
	}
	if #module.left_out.keys > left { return ø }
	late_runtime_words()
	for f in module.rereads {
		module.saw_pending = no
		body_code(f)
	}
	for f in module.dispatchers { late_code(f) }
	if module.widened_now { return ø }
	module_bytes(module.order)
}
# the closure calls of each arity up to hook_arities and the late words: in runtime.wasm, a program calls them there
def late_runtime_words() {
	for arity in 0..(hook_arities + 1) { dispatcher(arity) }
	for name in late_words.keys { late_word(name) }
}

## a program behind runtime.wasm (card runtime-prepended, notes/runtime_linking.md): the runtime's imports, types,
## functions, globals and texts first, as runtime.wasm has them; the program's numbered behind them
# runtime.wasm read back (module.runtime_image)
class RuntimeImage { wasm: list; types: int; imports: int; functions: int; data: int; globals: list; words: map }
def prepend_runtime(wasm: any) {
	module.runtime_image = if wasm == ø then ø else runtime_image_of(wasm)
	raisers_read = ø
	fingerprint_read = ø
}
def prepended(): bool { module.runtime_image != ø and not module.prebuilding }
# whether the code's index operands are emitted relocatable (padded, marked): in a prebuilt module (relocating), and
# in a program that is also written as a separate module (relocates_program; linked_bytes moves them to its numbering)
def relocate_program(wanted: bool) { module.relocates_program = wanted }
def relocates(): bool { module.relocating or module.relocates_program or module.shakes_runtime }
# its layout, the binary warp.runtime: the counts, the left words' names, each global's name and kind, each
# word's name, index, parameter kinds and result kind
def runtime_image_of(wasm: list): any {
	place = section_place(wasm, section_ids.custom, runtime_section)
	if place == ø { throw "runtime.wasm without its " + runtime_section + " section: warp rebuild writes it anew" }
	layout = ByteReader(wasm, place#1)
	if read_number(layout) != #gc_names { throw "runtime.wasm of other GC types: warp rebuild writes it anew" }
	imports = read_number(layout)
	functions = read_number(layout)
	read_number(layout)
	segments = read_number(layout)
	left = read_names(layout)
	globals = []
	for i in 0..<read_number(layout) { globals += [read_global(layout)] }
	words = {}
	for i in 0..<read_number(layout) {
		name = read_name(layout)
		index = read_number(layout)
		kinds = []
		for j in 0..<read_number(layout) { kinds += [read_kind(layout)] }
		result = read_kind(layout)
		words[name] = [index, kinds, result, read_signature(layout)]
	}
	types = uleb_read(wasm, section_place(wasm, section_ids.type)#1)#1
	RuntimeImage(wasm, types, imports, functions, segments, globals, words)
}
# a reading of bytes from a place on: LEB128 numbers, names (a length and UTF-8 bytes), kinds (held_kinds' places)
class ByteReader { bytes: list; offset: int }
def read_number(reader: ByteReader): int {
	read = uleb_read(reader.bytes, reader.offset)
	reader.offset = read#2
	read#1
}
def read_name(reader: ByteReader): text {
	count = read_number(reader)
	name = utf8_text(reader.bytes[reader.offset ..< reader.offset + count])
	reader.offset += count
	name
}
def read_names(reader: ByteReader): list {
	names = []
	for i in 0..<read_number(reader) { names += [read_name(reader)] }
	names
}
def read_kind(reader: ByteReader): ValueKind { held_kinds[read_number(reader)] }
# a global of warp.runtime or warp.module: [name, kind, mark]
def read_global(reader: ByteReader): list := [read_name(reader), read_kind(reader), read_number(reader)]
# a prebuilt global declared, its int type's mark kept, as the module that built it held it
def declared_linked_global(entry: list) {
	declared_global(entry#1, entry#2)
	if entry#3 != 0 { module.global_marks[entry#1] = entry#3 }
}
def read_signature(reader: ByteReader): any {
	parameters = []
	for i in 0..<read_number(reader) {
		name = read_name(reader)
		type_name = read_name(reader)
		flags = read_number(reader)
		default = if bit_and(flags, default_flag) != 0 then [unpack(read_name(reader))] else ø
		parameters += [Parameter(name, type_name, default, bit_and(flags, rest_flag) != 0)]
	}
	Signature(parameters, read_name(reader))
}
# the kinds a function or global of runtime.wasm holds, each written as its place here
held_kinds = [ValueKind.Int, ValueKind.Float, ValueKind.Bool, ValueKind.Char, ValueKind.I32, ValueKind.Text, ValueKind.List, ValueKind.Node, ValueKind.Time, ValueKind.Nothing]
def held_code(kind: ValueKind): int {
	for i in 0..<#held_kinds { if held_kinds[i] == kind { return i } }
	throw "runtime.wasm holds no " + kind + " value"
}
# UTF-8 bytes as their text, a code point at a time
def utf8_text(bytes: list): text {
	characters = []
	i = 0
	while i < #bytes {
		lead = bytes[i]
		count = if lead < 128 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4
		code = if count == 1 then lead else bit_and(lead, 255 >> (count + 1))
		for j in 1..<count { code = code * 64 + bit_and(bytes[i + j], 63) }
		characters += [chr(code)]
		i += count
	}
	characters.join("")
}
# the module behind the runtime: its globals, texts and functions numbered from the runtime's, a class struct's type
# from the runtime's type count; every Made kind made and errors caught, as the runtime does
def behind_runtime() {
	module.catches_errors = yes
	module.globals = {}
	module.global_order = []
	for entry in module.runtime_image.globals { declared_linked_global(entry) }
	module.placed = module.runtime_image.functions
	# the program's texts in segments behind the runtime's, numbered so in the linked module too (empty ones there)
	module.first_text_segment = module.runtime_image.data
	module.runtime_types = module.runtime_image.types - #gc_names
	behind_libraries()
}
# the runtime's imports, as runtime_wasm_module declared them: WASI's fd_write, then every host word
# then the program's C functions, which move the runtime's functions up by their count (runtime_shift)
def runtime_imports(host: map): list {
	held = module.host
	module.host = host
	imports = imported_words(host.keys.filter(name => not is_c_function(host[name])), yes)
	if #imports != module.runtime_image.imports { throw "runtime.wasm imports other host words than this harness has: warp rebuild writes it anew" }
	imports += imported_words(host.keys.filter(name => is_c_function(host[name])), no)
	module.host = held
	imports
}
def runtime_shift(): int := #module.imports - module.runtime_image.imports
# the runtime words a program calls: runtime.wasm's, each at its index, of its kinds and signature; none is lowered or
# compiled again (the runtime's sources are read only to build runtime.wasm)
def bind_runtime_words() {
	for name in module.runtime_image.words.keys {
		word = module.runtime_image.words[name]
		f = Function(name, word#4, ø)
		f.index = word#1 + runtime_shift()
		f.kinds = word#2
		f.result = word#3
		f.is_runtime = yes
		module.runtime[name] = f
	}
}

# the content of runtime.wasm's section of this id, a custom one by its name; the vector it holds with more entries
def runtime_part(id: int, name: text = ""): list {
	place = section_place(module.runtime_image.wasm, id, name)
	module.runtime_image.wasm[place#1 ..< place#2]
}
def with_section_entries(content: list, more: list): list {
	count = uleb_read(content, 0)
	uleb(count#1 + #more) + content[count#2 ..] + concatenated(more)
}
# the runtime's code, each call of a runtime function moved by the C functions' imports (not those of host words); a
# call of a host word too when some are dropped
def rebased_runtime_code(): list {
	content = runtime_part(section_ids.code)
	if runtime_shift() == 0 and not drops_imports() { return content }
	sites = if drops_imports() then operand_sites(relocated.calls) else runtime_call_sites()
	rebased(content, sites.map(site => site#1), [[import_move(runtime_shift(), {})]])
}
# the code section's content: the runtime's functions, then the program's functions, each body knowing where it starts
# (its relocations' offsets)
def prepended_code(functions: list): list {
	if shaken() {
		moves = shaken_moves()
		bodies = shaken_runtime_code(moves) + functions.map(f => moved_body(f, moves))
		return uleb(#bodies) + concatenated(bodies)
	}
	runtime = rebased_runtime_code()
	count = uleb_read(runtime, 0)
	at = count#2
	stubs = unreached_import_stubs()
	content = uleb(count#1 + #functions + #stubs)
	content += runtime[at ..]
	for f in functions { content += own_body(f, #content) }
	for body in stubs { content += body }
	content
}
# a subsection of runtime.wasm's names by its id, its content (an empty vector when it has none); with more entries
def runtime_subsection(id: int): list {
	content = runtime_part(section_ids.custom, "name")
	at = 0
	while at < #content {
		size = uleb_read(content, at + 1)
		if content[at] == id { return content[size#2 ..< size#2 + size#1] }
		at = size#2 + size#1
	}
	uleb(0)
}
def runtime_names(id: int, more: list): list { subsection(id, with_section_entries(runtime_subsection(id), more)) }
# the runtime's local names, each function's moved by runtime_shift, then more
def shifted_locals(content: list, more: list): list {
	if runtime_shift() == 0 and not shaken() and not drops_imports() { return with_section_entries(content, more) }
	count = uleb_read(content, 0)
	at = count#2
	entries = []
	for i in 0..<count#1 {
		index = uleb_read(content, at)
		end = name_map_end(content, index#2)
		landed = runtime_index(index#1)
		if landed != ø { entries += [uleb(landed) + content[index#2 ..< end]] }
		at = end
	}
	uleb(#entries + #more) + concatenated(entries) + concatenated(more)
}
# where a name map (a vector of index and name) that starts at `at` ends
def name_map_end(content: list, at: int): int {
	count = uleb_read(content, at)
	at = count#2
	for i in 0..<count#1 {
		at = uleb_read(content, at)#2
		size = uleb_read(content, at)
		at = size#2 + size#1
	}
	at
}
def own_function_type(f: Function): int := module.runtime_image.types + #module.gc_order - #gc_names + f.index - #module.imports - module.runtime_image.functions
def prepended_bytes(functions: list): list {
	if module.shakes_runtime and not module.relocating { module.shaking = shaking_of(functions) }
	forget_import_drop()
	if relocates() and not module.relocating and not shaken() { drop_imports(functions) }
	function_types = functions.map(function_type)
	classes = module.gc_order[#gc_names ..]
	class_types = if #classes == 0 then [] else [[rec_group_byte] + uleb(#classes) + concatenated(classes.map(name => gc_bytes(gc_definition(name))))]
	types = section(section_ids.type, with_section_entries(runtime_part(section_ids.type), class_types + function_types + c_import_types()))
	c_entries = c_import_entries(module.runtime_image.types + #classes + #functions)
	declared = section(section_ids.function, with_section_entries(if shaken() then shaken_function_types() else runtime_part(section_ids.function), functions.map(f => uleb(own_function_type(f))) + stub_types()))
	own_globals = module.global_order[#module.runtime_image.globals ..]
	globals = section(section_ids.globals, with_section_entries(runtime_part(section_ids.globals), own_globals.map(global_entry)))
	codes = section(section_ids.code, prepended_code(functions))
	# the exports and names by the shaken numbering, or behind the host words dropped
	for f in functions { f.index -= dropped() }
	texts = section(section_ids.data, with_section_entries(runtime_part(section_ids.data), text_segments()))
	memory = section(section_ids.memory, vector([[0] + uleb(memory_pages)]))
	parts = [types, section(section_ids.import, host_imports(c_entries)), declared, memory,
		section(section_ids.tag, runtime_part(section_ids.tag)), globals, section(section_ids.export, vector(program_exports(functions))), element_section(references_declared(functions.map(f => [f.name, f.index]))), section(section_ids.data_count, uleb(module.runtime_image.data + #module.texts)), codes, texts]
	made = wasm_header + concatenated(parts) + prepended_names(functions, classes, own_globals) + program_marks() + runtime_sections(functions)
	# the separate module (separate_module) is numbered behind the whole runtime, every host word kept
	for f in functions { f.index += imports_dropped() }
	forget_import_drop()
	made
}
# the program's C functions, imported behind the runtime's host words; their types after every other: no runtime type moves
def c_imports(): list { module.imports[module.runtime_image.imports ..] }
def c_import_types(): list { c_imports().map(entry => entry#3) }
def c_import_entries(first_type: int): list {
	imports = c_imports()
	range_list(#imports).map(k => name_bytes(imports[k]#1) + name_bytes(imports[k]#2) + [import_function_byte] + uleb(first_type + k))
}
# what the harness reads of a program: whether it counts fuel, its C functions
def program_marks(): list {
	fuel = if module.counts_fuel then section(section_ids.custom, name_bytes(fuel_section)) else []
	fuel + c_functions_custom_section()
}
# runtime.wasm's names and the program's behind them
def prepended_names(functions: list, classes: list, own_globals: list): list {
	imported = range_list(#module.imports).filter(i => import_kept(i)).map(i => index_name(import_place(i), module.imports#(i + 1)#2)) + stub_names()
	words = module.runtime_image.words.keys.filter(name => runtime_index(module.runtime_image.words[name]#1) != ø).map(name => index_name(runtime_index(module.runtime_image.words[name]#1), name))
	content = subsection(names_subsections.functions, vector(imported + words + functions.map(f => index_name(f.index, f.name))))
	content += subsection(names_subsections.locals, shifted_locals(runtime_subsection(names_subsections.locals), functions.map(local_name_map)))
	content += runtime_names(names_subsections.types, classes.map(name => index_name(module.gc_indices[name], name)))
	content += runtime_names(names_subsections.globals, own_globals.map(name => index_name(module.globals[name]#1, name)))
	content += runtime_names(names_subsections.fields, classes.map(name => uleb(module.gc_indices[name]) + name_map(gc_field_names(name))))
	content += runtime_names(names_subsections.tags, [])
	section(section_ids.custom, name_bytes("name") + content)
}

## a library module prebuilt (card modules-prebuilt, notes/runtime_linking.md "Library modules"): its words compiled
## once behind runtime.wasm from their declared kinds, its own items numbered from the runtime's counts, every index
## operand padded and listed, so a link appends it behind the runtime and the modules before it
# where the module's own items start in each index space (relocated): behind the runtime's imports and functions,
# types, globals and text segments
# (its functions behind its C imports too, which follow the runtime's)
def own_items_from(): list := [runtime_counts()#1 + #c_imports()] + runtime_counts()[1 ..]
def runtime_counts(): list := [module.runtime_image.imports + module.runtime_image.functions, module.runtime_image.types, #module.runtime_image.globals, module.runtime_image.data]
# what a module was built behind: where its items start, and runtime.wasm itself by its fingerprint; a runtime of the
# same counts in another order (the seed's own beside lib/'s) moves its words, so a module of another one is refused
def runtime_behind(): list := runtime_counts() + [runtime_fingerprint()]
# runtime.wasm's bytes folded to one number, once per runtime (prepend_runtime forgets it)
global fingerprint_read = ø
def runtime_fingerprint(): int {
	if fingerprint_read != ø { return fingerprint_read }
	folded = 0
	for byte in module.runtime_image.wasm { folded = (folded * 257 + byte) % 1000000007 }
	fingerprint_read = folded
	folded
}

## a program linked to prebuilt library modules (card modules-prebuilt, notes/runtime_linking.md "Library modules"):
## each module's own functions, types, globals and texts appended behind the runtime's in the order given, its operands
## moved to where they land (rebased); the program's own numbered behind them. A module word the program calls is the
## module's, at its index, of its kinds: never compiled again
# a module's warp.module read back: its own functions (index, kinds, result, signature), globals [name, kind], text
# segments, what it was built behind, and where each kind of its items lands here (base: placed, type, text)
class LibraryImage { name: text; functions: list; globals: list; classes: list; builders: list; base: list }
def link_libraries(images: list, own_names: list) {
	module.linked_images = images
	module.linked_own_names = own_names
	module.linked_words = {}
	# (a lifted lambda is reached through its closure only: its name may be one the program lifts too)
	for image in images { for word in image.functions { if linkable(image, word) and word.name not in own_names and not is_lifted_lambda(word.name) { module.linked_words[word.name] = (module.linked_words.get(word.name) ?? []) + [word] } } }
}
# a module's word a program may call: not one of the builders it exports for the host (its show(x) is the host's,
# beside draw's own show()), which a program linking it exports its own of
linkable(image: LibraryImage, word: Function): bool := word.name not in image.builders
# the variant of a linked name that takes that many values (card module-export-arity), ø for none
linked_variant(name: text, parameters: int): any := {
	fitting = (module.linked_words.get(name) ?? []).filter(word => #word.kinds == parameters)
	if #fitting == 0 then ø else fitting#1
}
# a call of a linked name with a count of values none of its variants takes: refused naming theirs, never another's
linked_arity_refusal(name: text, parameters: int): text := name + " of " + parameters + " values is no word of its linked module, whose " + name + " takes " + module.linked_words[name].map(word => "" + #word.kinds).join(" or ") + " values"
# the program's own definitions, as parsed (a line holding several, `use units; m(x) := 7; m(1)`, the source's slices
# miss): never a linked module's word
def own_words_unlinked(names: list) {
	for name in names {
		if name is text and name in module.linked_words {
			module.linked_words = map_without(module.linked_words, name)
			module.linked_own_names += [name]
		}
	}
}
# the names the program needs of each linked module even when it never says them: its classes and globals
def linked_needs(): list {
	names = []
	for image in module.linked_images { names += image.classes.map(entry => entry#1[#instance_struct_prefix ..]) + image.globals.map(entry => entry#1).filter(name => name.starts_with(program_global_prefix)).map(name => name[#program_global_prefix ..]) }
	names
}
# a linked module's image, the part of its warp.signature (signature.warp) its linked form's compile writes: its
# words (each name, parameter kinds, result kind), its globals [name, kind, mark], its own class structs [name,
# definition written], the host's builders it exports (by name), the methods its classes route (class_methods
# methods.warp lifted_routes) and the runtime it was built behind
def image_fields(functions: list): list {
	images_classes = concatenated(module.linked_images.map(image => image.classes.map(entry => entry#1)))
	own_classes = module.gc_order[#gc_names ..].filter(name => name not in images_classes)
	own_globals = module.global_order[#module.runtime_image.globals + #linked_globals_imported() ..]
	words = functions[1 ..].filter(f => not f.is_runtime and not f.name.starts_with(closure_entry_prefix))
	[field_node("words", square_list(words.map(f => square_list([Text(f.name), square_list(f.kinds.map(kind => Number(held_code(kind)))), Number(held_code(f.result))])))),
		field_node("globals", square_list(own_globals.map(name => square_list([Text(name), Number(held_code(module.globals[name]#2)), Number(module.global_marks.get(name) ?? 0)])))),
		field_node("classes", square_list(own_classes.map(name => square_list([Text(name), Text(struct_written(name))])))),
		field_node("builders", square_list(module.builders.map(f => Text(f.name)))),
		field_node("routes", square_list(lifted_routes.map(method => Text(method)))),
		field_node("runtime", square_list(runtime_behind().map(n => Number(n))))]
}
# the image of a linked module read back from its signature; why it is not linkable behind this runtime, a text
def library_image_of(name: text, signature: ModuleSignature): any {
	if #signature.words == 0 { return "no words in its " + SIGNATURE_SECTION + " (built before L5e)" }
	if signature.runtime.map(number_read) != runtime_behind() { return "built behind another runtime.wasm (warp rebuild writes it anew)" }
	functions = signature.words.map(entry => image_word(entry))
	globals = signature.globals.map(entry => [text_read(entry#1), held_kinds[number_read(entry#2)], number_read(entry#3)])
	classes = signature.classes.map(entry => [text_read(entry#1), text_read(entry#2)])
	LibraryImage(name, functions, globals, classes, signature.builders.map(text_read), [])
}
def image_word(entry: Node): Function {
	word = Function(text_read(entry#1), ø, ø)
	word.kinds = items_of(entry#2).map(code => held_kinds[number_read(code)])
	word.result = held_kinds[number_read(entry#3)]
	word
}
def text_read(n: Node): text := "${n}"
def number_read(n: Node): int := int("${n}")
# each linked module's place: its functions numbered behind those placed so far (the program imports those it calls),
# its globals declared by name (one the runtime or a module before it declares is theirs)
def behind_libraries() {
	for image in module.linked_images {
		image.base = [module.placed]
		for entry in image.globals { declared_linked_global(entry) }
		module.placed += #image.functions
	}
}
# the module words the program reaches: the first module's of a name, unless the program defines the name itself;
# the module's class structs the program's of their names, which it declares alike (its classes from the module's
# text), else the program compiles the module from its source
def bind_library_words() {
	for image in module.linked_images {
		for entry in image.classes {
			# (a class the program never reached: its struct declared as the module wrote it)
			if entry#1 not in module.class_structs { module.class_structs[entry#1] = [struct_read(entry#2), instance_fields] }
			if struct_written(entry#1) != entry#2 { refuse("the class struct " + entry#1 + " of the linked module " + image.name + ", " + entry#2 + ", is " + struct_written(entry#1) + " in the program") }
			gc_type(entry#1)
		}
		for k in 0..<#image.functions {
			word = image.functions[k]
			f = module.functions.get(word.name)
			if f != ø and f.kinds == ø and linkable(image, word) and linked_variant(word.name, #f.signature.parameters) == word {
				f.index = linked_index(image, k)
				f.kinds = word.kinds
				f.result = word.result
			}
		}
	}
}
# the program's index of a linked module's k-th function
def linked_index(image: LibraryImage, k: int): int := #module.imports + image.base#1 + k - dropped()
# the host's builders, exported once main is placed (the first function, which a program's exports name), for a
# linked module that calls them
def linked_builders() { if module.linked_images.any(image => #image.builders > 0) { exported_builders() } }
# a section's entries after the first `skip` (those of the runtime it was built behind), each its bytes: a code
# section's, each its size first, or a data section's passive segments, a flag byte before the size
def entries_after(content: list, skip: int, flagged: bool): list {
	count = uleb_read(content, 0)
	at = count#2
	entries = []
	for i in 0..<count#1 {
		size = uleb_read(content, if flagged then at + 1 else at)
		end = size#2 + size#1
		if i >= skip { entries += [content[at ..< end]] }
		at = end
	}
	entries
}
# a class struct's definition from its written form (module_layout.warp struct_written): numbers, and the types it
# names by their names
def struct_read(written: text): list := written.split(" ").map(part => if is_digits(part) then int(part) else part)

# each of runtime.wasm's imports (host words, every one a function): its entry's bytes up to its type, and its type
def runtime_import_entries(): list {
	content = runtime_part(section_ids.import)
	count = uleb_read(content, 0)
	at = count#2
	entries = []
	for i in 0..<count#1 {
		start = at
		for name in 0..<2 {
			size = uleb_read(content, at)
			at = size#2 + size#1
		}
		type = uleb_read(content, at + 1)
		entries += [[content[start ..< at + 1], type#1]]
		at = type#2
	}
	entries
}
# the operands of one kind (relocated) the functions' code holds, each a key
def relocated_operands(functions: list, kind: int): map {
	found = {}
	for f in functions {
		code = f.code
		at = 0
		while at < #code {
			if code[at] < 0 {
				operand = uleb_read(code, at + 1)
				if kind_marked(code[at]) == kind { found[operand#1] = yes }
				at = operand#2
			} else { at += 1 }
		}
	}
	found
}
# the runtime positions reached from these: the functions they call, through the runtime
def runtime_reach(called: list): map {
	graph = runtime_call_graph()
	reached = {}
	pending = called
	i = 0
	while i < #pending {
		p = pending[i]
		i += 1
		if not reached.has(p) {
			reached[p] = yes
			if graph.has(p) and not cut_positions.has(p) { pending += graph[p] }
		}
	}
	reached
}
# the runtime functions these functions call, by their position among the runtime's functions
def runtime_positions_called(functions: list): list {
	called = relocated_operands(functions, relocated.calls)
	positions = []
	for p in 0..<module.runtime_image.functions { if called.has(#module.imports + p) { positions += [p] } }
	positions
}
# each runtime function's position → the positions of the runtime functions it calls, read from its relocations once
# (module.runtime_calls)
def runtime_call_graph(): map {
	if module.runtime_calls != ø { return module.runtime_calls }
	graph = {}
	for site in runtime_call_sites() {
		if not graph.has(site#2) { graph[site#2] = [] }
		graph[site#2] = graph[site#2] + [site#3]
	}
	module.runtime_calls = graph
	graph
}
# [relocation, caller position, callee position] of each call of a runtime function in runtime.wasm's code, read once
# (module.runtime_sites) from its warp.calls section, which write_runtime bakes in (card measure: worked out from the
# relocations on each compile it took ~20 ms)
def runtime_call_sites(): list {
	if module.runtime_sites != ø { return module.runtime_sites }
	place = section_place(module.runtime_image.wasm, section_ids.custom, call_sites_section)
	if place == ø { throw "runtime.wasm without its " + call_sites_section + " section: warp rebuild writes it anew" }
	sites = []
	at = place#1
	count = uleb_read(module.runtime_image.wasm, at)
	at = count#2
	for i in 0..<count#1 {
		site = []
		for part in 0..<3 {
			read = uleb_read(module.runtime_image.wasm, at)
			site += [read#1]
			at = read#2
		}
		sites += [[[site#1, relocated.calls, runtime_space], site#2, site#3]]
	}
	module.runtime_sites = sites
	sites
}
# runtime.wasm with its call sites baked in, a warp.calls section of each one's [offset, caller, callee], and its
# raisers, a warp.raises section of their positions
call_sites_section = "warp.calls"
raisers_section = "warp.raises"
def with_call_sites(wasm: list): list {
	prepend_runtime(wasm)
	sites = worked_out_call_sites().map(site => concatenated([site#1#1, site#2, site#3].map(uleb)))
	raisers = worked_out_raisers().map(uleb)
	wasm + section(section_ids.custom, name_bytes(call_sites_section) + vector(sites)) + section(section_ids.custom, name_bytes(raisers_section) + vector(raisers))
}
# the call sites read off runtime.wasm's relocations and code
def worked_out_call_sites(): list {
	sites = operand_sites(relocated.calls).filter(site => site#3 >= module.runtime_image.imports)
	sites.map(site => [site#1, site#2, site#3 - module.runtime_image.imports])
}
# the runtime functions that raise, by position: those setting a global a host reads after a run failed in a runtime
# error (raising_globals), once each
def worked_out_raisers(): list {
	content = runtime_part(section_ids.code)
	names = module.runtime_image.globals.map(entry => entry#1)
	raisers = []
	for site in operand_sites(relocated.globals) { if content[site#1#1 - 1] == op.global_set and site#3 < #names and names[site#3] in raising_globals and not (site#2 in raisers) { raisers += [site#2] } }
	raisers
}
# [relocation, caller position, operand] of each relocated operand of this kind in runtime.wasm's code
def operand_sites(kind: int): list {
	content = runtime_part(section_ids.code)
	ends = body_ranges(content).map(range => range#2)
	sites = []
	caller = 0
	code_end = ends[#ends - 1]
	# a global's relocation can lie outside the code (a global's initializer)
	for entry in relocations_of(module.runtime_image.wasm).filter(entry => entry#2 == kind and entry#3 == runtime_space and entry#1 < code_end) {
		# the entries come in code order; one before the last caller's start is looked up from the first
		if caller > 0 and ends[caller - 1] > entry#1 { caller = 0 }
		while ends[caller] <= entry#1 { caller += 1 }
		sites += [[entry, caller, uleb_read(content, entry#1)#1]]
	}
	sites
}
# the positions of runtime.wasm's raisers, read once per runtime (prepend_runtime forgets them) from its warp.raises
# section; a global, as a Module field more fails the seed's compile (index out of range)
global raisers_read = ø
def runtime_raisers(): list {
	if raisers_read != ø { return raisers_read }
	place = section_place(module.runtime_image.wasm, section_ids.custom, raisers_section)
	if place == ø { throw "runtime.wasm without its " + raisers_section + " section: warp rebuild writes it anew" }
	count = uleb_read(module.runtime_image.wasm, place#1)
	at = count#2
	raisers = []
	for i in 0..<count#1 {
		read = uleb_read(module.runtime_image.wasm, at)
		raisers += [read#1]
		at = read#2
	}
	raisers_read = raisers
	raisers
}
# whether the functions can fail in a runtime error: their code or a runtime function they reach sets a raising global
def can_raise(functions: list): bool {
	raising = raising_globals.map(name => module.globals.get(name)).filter(entry => entry != ø).map(entry => entry#1)
	own = exports_reach(functions)
	if sets_global(own, raising) { return yes }
	reached = runtime_reach(runtime_positions_called(own))
	runtime_raisers().any(p => reached.has(p))
}
# the functions the module's exports reach (main, _start, the builders, the program's own words), through the calls
# of their code (a closure's entry by its ref.func): a prelude word compiled but never called raises in no run
def exports_reach(functions: list): list {
	at = {}
	for f in functions { at[f.index] = f }
	builders = module.builders.map(f => f.name)
	pending = functions.filter(f => f.name == "main" or f.name == wasi_start or f.name in builders or not f.is_runtime)
	reached = {}
	found = []
	i = 0
	while i < #pending {
		f = pending[i]
		i += 1
		if not reached.has(f.index) {
			reached[f.index] = yes
			found += [f]
			for index in relocated_operands([f], relocated.calls).keys { if at.has(index) { pending += [at[index]] } }
		}
	}
	found
}
# whether the functions' code sets one of these globals (relocatable code: a marked operand behind global.set)
def sets_global(functions: list, indices: list): bool {
	for f in functions {
		code = f.code
		at = 0
		while at < #code {
			if code[at] < 0 {
				operand = uleb_read(code, at + 1)
				if kind_marked(code[at]) == relocated.globals and at > 0 and code[at - 1] == op.global_set and operand#1 in indices { return yes }
				at = operand#2
			} else { at += 1 }
		}
	}
	no
}
# [start, end] of each function's entry in a code section's content, its size included
def body_ranges(content: list): list {
	ranges = []
	count = uleb_read(content, 0)
	at = count#2
	for p in 0..<count#1 {
		size = uleb_read(content, at)
		ranges += [[at, size#2 + size#1]]
		at = size#2 + size#1
	}
	ranges
}

## a program carrying only the runtime it reaches (card runtime-shaking, notes/runtime_linking.md "Removing the unused
## runtime"): the runtime functions its code, its hooks and its linked modules' code reach, kept in their order behind
## the imports, every function behind them moved down by the count dropped. A call of one dropped fails the compile,
## never the run (Move's gap)
# kept: the runtime positions kept, in order; places: each position's new index, -1 of one dropped; dropped: how many go
class Shaking { kept: list; places: list; dropped: int }
def shake_runtime(wanted: bool) { module.shakes_runtime = wanted }
# the runtime positions of the words a build leaves out (decision extension-row-optional, compiler.warp
# left_out_runtime_words): one reached is kept as a trapping stub, and nothing it calls is reached through it. A global,
# as a Module field more fails the seed's compile
global cut_positions = {}
# those words by name, for needed_call
global cut_names = {}
def cut_runtime_words(names: list) {
	cut_positions = {}
	cut_names = {}
	for name in names { cut_names[name] = yes }
	if module.runtime_image == ø { return }
	for name in names { if module.runtime_image.words.has(name) { cut_positions[module.runtime_image.words[name]#1 - module.runtime_image.imports] = yes } }
}
# a function body that only traps
def trapping_body(): list := uleb(3) + [0, op.unreachable, op.end]
def shaken(): bool := module.shaking != ø
def dropped(): int := if shaken() then module.shaking.dropped else imports_dropped()
def shaking_of(functions: list): any {
	reached = runtime_reach(runtime_positions_called(functions))
	kept = range_list(module.runtime_image.functions).filter(p => reached.has(p))
	places = range_list(module.runtime_image.functions).map(p => -1)
	for k in 0..<#kept { places[kept[k]] = #module.imports + k }
	Shaking(kept, places, module.runtime_image.functions - #kept)
}
# where a call of runtime function `first + p` goes: a kept one to its place; a dropped one is the gap
def kept_calls(first: int, more: map): Move {
	table = {}
	for i in more.keys { table[i] = more[i] }
	places: list = module.shaking.places
	kept: list = module.shaking.kept
	for p in kept { table[first + p] = places[p] }
	Move(0, table, [first, first + module.runtime_image.functions])
}
# where the program's operands go: its calls by kept_calls, an import's in place, a function behind the runtime's down
# by the dropped; the other kinds stay
def shaken_moves(): list {
	imports = {}
	for i in 0..<#module.imports { imports[i] = i }
	calls = kept_calls(#module.imports, imports)
	[Move(-module.shaking.dropped, calls.table, calls.gap)] + range_list(#relocated.keys - 1).map(k => shifted(0))
}
# the kept runtime functions' entries of the code section, their calls moved
def shaken_runtime_code(moves: list): list {
	content = runtime_part(section_ids.code)
	ranges = body_ranges(content)
	kept = {}
	for p in module.shaking.kept { kept[p] = yes }
	calls = runtime_call_sites().filter(site => kept.has(site#2) and not cut_positions.has(site#2)).map(site => site#1)
	moved = rebased(content, calls, [[kept_calls(module.runtime_image.imports, {})]])
	module.shaking.kept.map(p => if cut_positions.has(p) then trapping_body() else moved[ranges[p]#1 ..< ranges[p]#2])
}
# the types runtime.wasm declares its kept functions with
def shaken_function_types(): list {
	types = runtime_part(section_ids.function)
	at = uleb_read(types, 0)#2
	declared = []
	for p in 0..<module.runtime_image.functions {
		read = uleb_read(types, at)
		declared += [read#1]
		at = read#2
	}
	uleb(#module.shaking.kept) + concatenated(module.shaking.kept.map(p => uleb(declared[p])))
}
# where runtime.wasm's function of this index lands: behind the program's C imports; ø when shaken out
def runtime_index(index: int): int? {
	if index < module.runtime_image.imports { return index }
	if not shaken() { return index + runtime_shift() - imports_dropped() }
	places: list = module.shaking.places
	if places[index - module.runtime_image.imports] < 0 then ø else places[index - module.runtime_image.imports]
}

## a built program's full module importing only the host words its code reaches (card module-imports, decision
## unused-imports-pass): every function behind the host imports moved down by the count dropped; the runtime functions
## it never reaches stay, their calls of a dropped host word going to one trapping stub per type behind all functions.
## The program's code is relocatable (relocates), so each call is moved as the runtime's (import_move)
# each host import's new index, the stub's of a dropped one (import_places); the host imports kept; each stub's type;
# the index of the first stub; how many go. Globals, as a Module field more fails the seed's compile (raisers_read),
# set only while prepended_bytes writes
global import_places = []
global kept_imports = {}
global stub_type_list = []
global first_stub = 0
global imports_gone = 0
def drops_imports(): bool := imports_gone > 0
def imports_dropped(): int := imports_gone
def forget_import_drop() {
	import_places = []
	kept_imports = {}
	stub_type_list = []
	imports_gone = 0
}
def drop_imports(functions: list) {
	called = host_words_called(functions)
	host_types = runtime_import_entries().map(entry => entry#2)
	# each stub's type, and the stub of each type
	trapping = []
	stub_of = {}
	for i in 0..<#host_types {
		if not called.has(i) and not stub_of.has(host_types[i]) {
			stub_of[host_types[i]] = #trapping
			trapping += [host_types[i]]
		}
	}
	gone = #host_types - #called.keys
	first_stub = #module.imports + module.runtime_image.functions + #functions - gone
	places = []
	count_kept = 0
	for i in 0..<#host_types {
		places += [if called.has(i) then count_kept else first_stub + stub_of[host_types[i]]]
		if called.has(i) { count_kept += 1 }
	}
	import_places = places
	kept_imports = called
	stub_type_list = trapping
	imports_gone = gone
}
# the host words called by the program's own code and the runtime functions it reaches
def host_words_called(functions: list): map {
	own = exports_reach(functions)
	reached = runtime_reach(runtime_positions_called(own))
	called = {}
	own_calls = relocated_operands(own, relocated.calls)
	for index in 0..<module.runtime_image.imports { if own_calls.has(index) { called[index] = yes } }
	for site in operand_sites(relocated.calls) { if site#3 < module.runtime_image.imports and reached.has(site#2) { called[site#3] = yes } }
	called
}
# where a function index goes, as behind the whole runtime: a host word to its place, one in more to its entry there,
# every other by shift, all behind the host words moved down by the count dropped
def import_move(shift: int, more: map): Move {
	table = {}
	for i in more.keys { table[i] = more[i] - imports_dropped() }
	if drops_imports() { for i in 0..<#import_places { table[i] = import_places[i] } }
	Move(shift - imports_dropped(), table)
}
# a program function's entry of the code section, its calls moved past the host words dropped
def own_body(f: Function, at: int): list {
	if not drops_imports() { return function_body(f, at) }
	moved_body(f, [import_move(0, {})] + range_list(#relocated.keys - 1).map(k => shifted(0)))
}
# the import section's content: the host words kept, then the program's C functions
def host_imports(c_entries: list): list {
	if not drops_imports() { return with_section_entries(runtime_part(section_ids.import), c_entries) }
	entries = runtime_import_entries()
	kept = range_list(#entries).filter(i => kept_imports.has(i)).map(i => entries[i]#1 + uleb(entries[i]#2))
	uleb(#kept + #c_entries) + concatenated(kept) + concatenated(c_entries)
}
def import_kept(i: int): bool := not drops_imports() or i >= module.runtime_image.imports or kept_imports.has(i)
def import_place(i: int): int := if drops_imports() and i < module.runtime_image.imports then import_places[i] else i - imports_dropped()
def stub_types(): list := if drops_imports() then stub_type_list.map(typed => uleb(typed)) else []
def stub_names(): list := if drops_imports() then range_list(#stub_type_list).map(k => index_name(first_stub + k, unreached_import)) else []
unreached_import = "unreached_import"
# a stub's entry of the code section: no locals, a trap
def unreached_import_stubs(): list := if drops_imports() then stub_type_list.map(typed => trapping_body()) else []
