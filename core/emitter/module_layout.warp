# The module's sections in order (emitter.warp's part): types, imports, functions, memory, globals, exports, code, data
# and the names section
## the module
def value_type(kind: ValueKind): list { if is_reference(kind) then gc_bytes(reference_of(kind)) else [number_byte(kind)] }
# a global's first value, before its declaration sets it
def zero_code_of(kind: ValueKind): list {
	if kind == ValueKind.Int { return [op.i64_const, 0] }
	if kind == ValueKind.Float { return [op.f64_const] + le64(0) }
	# a node global holds 0 until assigned, as Rust's `global x; x` gives (struct.new is a constant expression)
	if kind == ValueKind.Node { return boxed(number_value(0)) }
	if kind == ValueKind.List { return vector_code([]) }
	if is_reference(kind) { return [ref_null] + (if kind == ValueKind.Time then [110] else uleb(gc_type(reference_of(kind)#2))) }
	[op.i32_const, 0]
}
# (a first value names only the fixed GC types: no relocation, its marks dropped)
def global_entry(name: text): list { value_type(module.globals[name]#2) + [mutable] + zero_code_of(module.globals[name]#2).filter(byte => byte >= 0) + [op.end] }
def function_type(f: Function): list { [function_type_byte] + vector(f.kinds.map(value_type)) + (if f.result == no_kind then [0] else [1] + value_type(f.result)) }
# a function's entry of the code section, which starts at the offset `at` of the section's content: each relocatable
# operand noted in module.relocations as [offset, kind, space], its mark dropped
def function_body(f: Function, at: int): list {
	locals = vector(f.locals.map(k => [1] + value_type(k)))
	code = f.code + [op.end]
	if not module.relocating { return uleb(#locals + #code) + locals + code }
	marks = []
	unmarked = []
	for byte in code { if byte < 0 { marks += [[#unmarked, byte]] } else { unmarked += [byte] } }
	size = uleb(#locals + #unmarked)
	for mark in marks { module.relocations += [[at + #size + #locals + mark#1, kind_marked(mark#2), space_marked(mark#2)]] }
	size + locals + unmarked
}
# the code section's content: the functions' entries, each knowing where it starts
def code_entries(functions: list): list {
	content = uleb(#functions)
	for f in functions { content += function_body(f, #content) }
	content
}
def index_name(i: int, name: text): list { uleb(i) + name_bytes(name) }
def name_map(names: list): list { vector(range_list(#names).map(i => index_name(i, names#(i + 1)))) }
def local_name_map(f: Function): list { uleb(f.index) + name_map(f.local_names) }
def range_list(n: int): list {
	out = []
	for i in 0..n { out += [i] }
	out
}
def subsection(id: int, content: list): list { [id] + uleb(#content) + content }
def names_section(functions: list): list {
	imported = range_list(#module.imports).map(i => index_name(i, module.imports#(i + 1)#2))
	function_names = vector(imported + functions.map(f => index_name(f.index, f.name)))
	locals = vector(functions.map(local_name_map))
	types = name_map(module.gc_order)
	fields = vector(range_list(#module.gc_order).map(i => uleb(i) + name_map(gc_field_names(module.gc_order#(i + 1)))))
	content = subsection(names_subsections.functions, function_names) + subsection(names_subsections.locals, locals)
	globals = name_map(module.global_order)
	content += subsection(names_subsections.types, types) + subsection(names_subsections.globals, globals)
	content += subsection(names_subsections.fields, fields)
	if module.catches_errors { content += subsection(names_subsections.tags, name_map([error_tag_name])) }
	section(section_ids.custom, name_bytes("name") + content)
}

# the type section's entries of the GC types, in index order: each its own, but the class structs (contiguous:
# instances.warp declare_class_structs) one recursion group, its types told apart by their place in it
def type_entries(): list {
	entries = []
	group = []
	for name in module.gc_order {
		if name in module.class_structs { group += [gc_bytes(gc_definition(name))] } else { entries += [gc_bytes(gc_definition(name))] }
	}
	if #group == 0 { return entries }
	first = module.gc_indices[module.gc_order.filter(name => name in module.class_structs)#1]
	entries[0 ..< first] + [[rec_group_byte] + uleb(#group) + concatenated(group)] + entries[first ..< #entries]
}
# main, memory, the globals the runner reads after a trap, then the program's functions under the names left free, as
# Rust's export_names: a module imported compiled calls them
def program_exports(functions: list): list {
	exports = [name_bytes("main") + [export_function_byte] + uleb(functions#1.index), name_bytes("memory") + [export_memory_byte, 0]]
	for name in exported_globals {
		if name in module.globals { exports += [name_bytes(name) + [export_global_byte] + uleb(module.globals[name]#1)] }
	}
	taken = ["main", "memory"] + exported_globals
	for f in module.builders {
		exports += [name_bytes(f.name) + [export_function_byte] + uleb(f.index)]
		taken += [f.name]
	}
	for f in functions[1..] {
		if not f.is_runtime and f.name not in taken {
			exports += [name_bytes(f.name) + [export_function_byte] + uleb(f.index)]
			taken += [f.name]
		}
	}
	exports
}
def module_bytes(functions: list): list {
	if prepended() { return prepended_bytes(functions) }
	# what names a value type first (functions' signatures and locals, globals), so the GC types the module declares
	# are all known: those its code used, then these (gc_type)
	function_types = functions.map(function_type)
	codes = section(section_ids.code, code_entries(functions))
	globals = section(section_ids.globals, vector(module.global_order.map(global_entry)))
	# an import's type follows the GC types in the imports' order, so a function's type is #gc_order + its index too
	# the tag's type after every function's
	tag_types = if module.catches_errors then [[function_type_byte] + vector([value_type(ValueKind.Bool)]) + [0]] else []
	gc_declared = type_entries()
	types = section(section_ids.type, vector(gc_declared + module.imports.map(i => i#3) + function_types + tag_types))
	imported = section(section_ids.import, vector(range_list(#module.imports).map(i => import_entry(i))))
	declared = section(section_ids.function, vector(functions.map(f => uleb(#module.gc_order + f.index))))
	# always a memory, exported as Rust's: the host of a program importing this module compiled reads it
	memory = section(section_ids.memory, vector([[0] + uleb(memory_pages)]))
	if #module.imports == 0 { imported = [] }
	exports = program_exports(functions)
	tables = []
	if module.prebuilding {
		exports = runtime_exports(functions)
		tables = section(table_section_id, vector([[funcref_byte, 0] + uleb(#module.dispatchers)]))
	}
	exported = section(section_ids.export, vector(exports))
	# the texts' bytes: one passive segment, which array.new_data reads
	segments = section(section_ids.data_count, uleb(1))
	texts = section(section_ids.data, vector([passive(data_bytes())]))
	tags = []
	if module.catches_errors { tags = section(section_ids.tag, vector([[0] + uleb(#module.gc_order + #module.imports + #functions)])) }
	parts = [types, imported, declared, tables, memory, tags, globals, exported, segments, codes, texts]
	marks = if module.counts_fuel then section(section_ids.custom, name_bytes(fuel_section)) else []
	wasm_header + concatenated(parts) + names_section(functions) + marks + c_functions_custom_section() + runtime_sections(functions)
}
# runtime.wasm's exports: memory, every function and global by its name, the error tag, the table of hooks
def runtime_exports(functions: list): list {
	exports = [name_bytes("memory") + [export_memory_byte, 0], name_bytes(error_tag_name) + [export_tag_byte, 0], name_bytes(hooks_table) + [export_table_byte, 0]]
	taken = ["memory", error_tag_name, hooks_table]
	for f in functions {
		if f.name not in taken {
			exports += [name_bytes(f.name) + [export_function_byte] + uleb(f.index)]
			taken += [f.name]
		}
	}
	for name in module.global_order {
		if name not in taken {
			exports += [name_bytes(name) + [export_global_byte] + uleb(module.globals[name]#1)]
			taken += [name]
		}
	}
	exports
}
# a prebuilt module's layout (binary: notes/runtime_linking.md "warp.runtime") and its relocations (warp.relocations,
# a vector of [offset in the code section's content, kind, space]): runtime.wasm's (warp.runtime), a library module's
# own items behind the runtime (warp.module); none in a program's module
def runtime_sections(functions: list): list {
	if not module.relocating { return [] }
	own_globals = module.global_order[(if module.prebuilding then 0 else #runtime_image.globals) ..]
	counts = concatenated([#module.gc_order, #module.imports, #functions, #own_globals, #data_bytes()].map(uleb))
	names = vector(module.dispatchers.map(f => name_bytes(f.name))) + vector(module.left_out.keys.map(name_bytes))
	globals = vector(own_globals.map(name => name_bytes(name) + uleb(held_code(module.globals[name]#2))))
	words = vector(functions.map(f => name_bytes(f.name) + uleb(f.index) + vector(f.kinds.map(k => uleb(held_code(k)))) + uleb(held_code(f.result)) + signature_bytes(f.signature)))
	name = if module.prebuilding then runtime_section else library_section
	section(section_ids.custom, name_bytes(name) + counts + names + globals + words) + section(section_ids.custom, name_bytes(relocations_section) + vector(module.relocations.map(entry => concatenated(entry.map(uleb)))))
}
# a word's signature in warp.runtime, what a call of it reads (named arguments, defaults, a rest parameter, the declared
# result): each parameter's name, type, flags (rest 1, a default 2) and default, packed; the result as written
rest_flag = 1
default_flag = 2
def signature_bytes(signature: any): list {
	parameters = signature.parameters.map(p => name_bytes(p.name) + name_bytes(p.type_name) + uleb((if p.rest then rest_flag else 0) + (if p.defaulted_to != ø then default_flag else 0)) + (if p.defaulted_to != ø then name_bytes(pack(p.defaulted_to#1)) else []))
	vector(parameters) + name_bytes(signature.result)
}
# A prebuilt module read back for a link (notes/runtime_linking.md "Relocations"): its relocations, and its code
# section's content with each relocated operand moved by shifts[space][kind], the one rule for every index space (a
# module appended behind others; the runtime's functions behind a program's C imports); a shift not given is 0
def relocations_of(wasm: list): list {
	place = section_place(wasm, section_ids.custom, relocations_section)
	if place == ø { return [] }
	entries = []
	at = place#1
	count = uleb_read(wasm, at)
	at = count#2
	for i in 0..<count#1 {
		entry = []
		for part in 0..<3 {
			read = uleb_read(wasm, at)
			entry += [read#1]
			at = read#2
		}
		entries += [entry]
	}
	entries
}
def rebased(code: list, relocations: list, shifts: list): list {
	for entry in relocations {
		space = entry#3
		shift = if space < #shifts and entry#2 < #shifts[space] then shifts[space][entry#2] else 0
		if shift != 0 {
			moved = padded_uleb(uleb_read(code, entry#1)#1 + shift)
			for i in 0..<padded_width { code[entry#1 + i] = moved[i] }
		}
	}
	code
}
# [start, end] of the content of a module's section of this id, a custom one by its name; ø when it has none
def section_place(wasm: list, id: int, name: text = ""): list? {
	at = #wasm_header
	while at < #wasm {
		size = uleb_read(wasm, at + 1)
		start = size#2
		end = start + size#1
		if wasm[at] == id and id != section_ids.custom { return [start, end] }
		if wasm[at] == id {
			named = uleb_read(wasm, start)
			if wasm[named#2 ..< named#2 + named#1] == name.bytes { return [named#2 + named#1, end] }
		}
		at = end
	}
	ø
}
# the data segment: each text's bytes once, in the order text_offset gave them their offsets
def data_bytes(): list { concatenated(module.texts.keys.map(t => t.bytes)) }
def passive(bytes: list): list { [passive_segment] + uleb(#bytes) + bytes }
def import_entry(i: int): list {
	entry = module.imports#(i + 1)
	name_bytes(entry#1) + name_bytes(entry#2) + [import_function_byte] + uleb(#module.gc_order + i)
}
