# Functions (emitter.warp's part): calls and their arguments, each function's kinds and code, analyzer.warp's kinds
def call(body: Body, f: Function, arguments: list): TypedCode {
	parameters = f.signature.parameters
	if parameters and parameters.last.rest { return rest_call(body, f, arguments) }
	if #arguments > #parameters { return refuse_arguments(f, #arguments) }
	slots = placed_arguments(taken_names(f.signature), arguments, f.signature.parameters.map(p => p.label))
	if slots == ø { return refuse_arguments(f, #arguments) }
	given = range_list(#slots).map(i => if slots[i] == ø then default_value(body, f, i, #arguments) else expression_code(body, slots[i]#1))
	call_values(f, defaulted(body, f, given, #arguments))
}
# `f(1, 2, 3)` of `f(a, *xs)`: the arguments after the fixed ones go as one list, a lone spread `f(1, *ys)` as ys
def rest_call(body: Body, f: Function, arguments: list): TypedCode {
	fixed = #f.signature.parameters - 1
	if #arguments < fixed { return refuse_arguments(f, #arguments) }
	extra = arguments[fixed..]
	spread = if #extra == 1 then rest_name(extra#1) else ø
	rest = if spread != ø then expression_code(body, symbol(spread)) else list_value(body, extra)
	call_values(f, arguments[..fixed].map(argument => expression_code(body, argument)) + [rest])
}
# the values given, then the defaults of the parameters after them
def defaulted(body: Body, f: Function, given: list, count: int): list {
	given + range_list(#f.signature.parameters - #given).map(i => default_value(body, f, #given + i, count))
}
# `name = value` or `name: value` naming one of `names` (P37), as Rust's calls and constructors take both
is_named_argument(argument: Node, names: list): bool := type(argument) is key and (op_of(argument) == Op.Assign or op_of(argument) == Op.Colon) and key_of(argument) is symbol and name_of(key_of(argument)) in names
# the place a named argument names, by a parameter's name or its label (`with: "coffee"` of `with new`)
named_place(name: text, names: list, labels: list): int := range_list(#names).filter(i => names[i] == name or (labels and labels[i] == name))#1
# the arguments in the places of `names`: the positional ones first, each named one (`f(b=2, a=7)`) in its name's place,
# [argument] each, ø for a place left out; ø when a name is given twice or more are given than places (test
# `slots == ø`: `ø is list` holds, so a nullary f took `m.f`'s receiver; card member-read). (The values are computed in the places'
# order, not as written: P216 wants written order, which differs only for arguments with effects)
placed_arguments(names: list, arguments: list, labels: list = []): any := {
	slots = []
	for argument in arguments {
		if is_named_argument(argument, names + labels.filter(label => label != "")) {
			at: int = named_place(name_of(key_of(argument)), names, labels)
			while #slots <= at { slots += [ø] }
			if slots[at] != ø { return ø }
			slots[at] = [value_of(argument)]
		} else {
			if #slots >= #names { return ø }
			slots += [[argument]]
		}
	}
	slots
}
refuse_arguments(f: Function, count: int): any := refuse("a call of " + f.name + " with " + count + " arguments")
# the default of f's parameter i a call leaves out, compiled where the call is: refused when it reads a parameter
def default_value(body: Body, f: Function, i: int, count: int): TypedCode {
	default = f.signature.parameters[i].defaulted_to
	if default == ø { return refuse_arguments(f, count) }
	for name in taken_names(f.signature) { if mentions(default#1, name) { return refuse("a default of " + f.name + " reading " + name) } }
	expression_code(body, default#1)
}
def call_values(f: Function, values: list): TypedCode {
	# a marked number given an unannotated parameter is given boxed, where its static mark runs out (decision
	# marks-unboxed-first): `k(x) := x` of an Angle keeps it an Angle
	values = range_list(#values).map(i => if values[i].mark != 0 and i < #f.signature.parameters and f.signature.parameters[i].type_name == "" then TypedCode(ValueKind.Node, boxed(values[i])) else values[i])
	if f.kinds == ø { compile_function(f, values.map(v => v.kind)) }
	# a function still compiling gives the kind it declares; without one its result is not known yet, and the caller
	# is read again once every function is compiled
	result = if f.result == pending then declared_result(f) ?? pending else f.result
	if result == pending { module.saw_pending = yes }
	code = []
	for i in 0..<#values {
		widen_parameter(f, i, values[i]#1)
		code += passed(f, i, values[i])
	}
	TypedCode(result, code + call_code(f.index), if result == ValueKind.Node then 0 else declared_mark(f))
}
# a value a compiled function's unannotated parameter cannot take, `last(t)` after `last(xs)`: the module is compiled
# again, the parameter of their joint kind from the start (module.later_kinds, typed_wasm_module). A reading that widened
# one goes on to find the others (module.widened_now): it is read again anyway, and stopping at the second call of a
# widened parameter took a reading of the whole compiler for each (card speed-parallel-emit)
def passed(f: Function, i: int, value: TypedCode): list {
	slot = parameter_key(f.name, i)
	declared = if i < #f.signature.parameters then aliased_type(f.signature.parameters[i].type_name) else ""
	if is_union(declared) and not fits_union(declared, value.kind) { refuse("a " + kind_spelling(value.kind) + " where a " + declared + " is needed") }
	try {
		# a node may hold any kind (`v.x * s` of a float s): read as an unannotated parameter's int it would trap, so the
		# parameter widens, as widen_parameter does for a call still compiling
		if value.kind == ValueKind.Node and f.kinds[i] != ValueKind.Node and slot in module.unannotated { refuse("a node where a " + f.kinds[i] + " is needed") }
		converted(value, f.kinds[i])
	} catch refusal {
		joint = parameter_joint(f.kinds[i], value.kind)
		if slot not in module.unannotated or not widens_later(slot, joint) { throw refusal }
		value.code
	}
}
# whether a slot (an unannotated parameter, a global) takes the joint kind of its own and a value it cannot hold from
# the module's next reading on: no when the joint kind is no value's, or this reading already holds it so
def widens_later(slot: text, joint: ValueKind): bool {
	if not (is_held_kind(joint)) { return no }
	known = module.later_kinds.get(slot) == joint
	if known and slot not in module.widened_now { return no }
	if not known {
		module.later_kinds[slot] = joint
		module.widened_now[slot] = yes
		module.widenings += 1
	}
	yes
}
# a call of a function still compiling (its own body, a cycle) passing an argument its unannotated parameter does not
# hold, `f(xs#1)` inside `f(n)` first called with a list: the parameter takes their joint kind from f's next reading on
widen_parameter(f: Function, i: int, kind: ValueKind) := {
	held = f.kinds[i]
	if f.result != pending or parameter_key(f.name, i) not in module.unannotated or kind == pending or held_as(kind, held) { return }
	joint = joint_kind(held, kind)
	if is_held_kind(joint) { f.widened[parameter_key(f.name, i)] = joint }
}

## functions
# the locals of f's body, its parameters first
# (a function whose first parameter is a class sees that class's fields bare: its locals are named apart)
new_body(f: Function): Body := {
	scope = Body({}, [], [], 0, f.is_runtime, f, [], {}, 0, [], [], [], {})
	for i in 0..<#f.signature.parameters {
		parameter = f.signature.parameters[i]
		name = parameter_local_name(scope, parameter.name, i)
		local_index(scope, name, f.kinds[i])
		# a parameter of a marked type, `a: Angle`, holds the number unboxed, its mark known (decision marks-unboxed-first)
		if parameter.type_name in module.marks and f.kinds[i] != ValueKind.Node { scope.marks[name] = module.marks[parameter.type_name] }
	}
	scope
}
# every parameter has a local of its own: a name given twice, `middle(_, value, _)`, names only the first
parameter_local_name(scope: Body, name: text, i: int): text := if name in scope.names then "·parameter" + i else name

# is the program analyzed (WARP_SELF_ANALYSIS): then a node meeting a list or text holds one, as analyzer.warp found
analyzed_program(): bool := module.kinds != ø and "value" in module.kinds
# the kinds analyzer.warp finds that the emitter holds as found; a node stays the emitter's own reading of the value
# not int: analyzer.warp's int is warp's unbounded one, a node holding a big number would trap as an i64
kept_kind(kind: ValueKind?): ValueKind? := if kind == ValueKind.Float or kind == ValueKind.Char or kind == ValueKind.Text or kind == ValueKind.List then kind else ø
# whether a value of the emitter's kind `from` is held as the analyzed kind `to` without loss: a character as a text, an
# int as a float; a node the emitter boxed (`if c then "a" else 2`, analyzer.warp's text) stays one
held_as(from: ValueKind, to: ValueKind): bool := from == to or (from == ValueKind.Char and to == ValueKind.Text) or (from == ValueKind.Int and to == ValueKind.Float)
# what analyzer.warp found for the program's function f, main's being the program's variables and value; ø if nothing
analyzed_function(f: Function): any := {
	if f.is_runtime or not analyzed_program() { return ø }
	if f.name == "main" { return {params: [], result: module.kinds["value"], locals: module.kinds["variables"], elements: module.kinds["elements"]} }
	functions = module.kinds["functions"]
	if functions == ø or f.name not in functions { return ø }
	functions[f.name]
}
# the kind analyzer.warp found for f's i-th parameter (counted from 0), its result, a local, if the emitter holds it
analyzed_parameter_kind(f: Function, i: int): any := {
	found = analyzed_function(f)
	if found == ø or i >= #found["params"] { return ø }
	kept_kind(found["params"][i])
}
# the kind a definition declares it gives, `f(x): text := …`: once lowered its body, or a block's last statement, is
# `… as text`, or the block `{the result: text = …; the result}` (definitions.warp result_held)
declared_result(f: Function): any := {
	declaration = result_declared(f.body)
	if declaration == ø { return ø }
	if is_key(declaration, Op.As) {
		kind = annotated_kind(name_of(value_of(declaration)))
		return if is_held_kind(kind) then kind else ValueKind.Node
	}
	result_type_kind(held_result_type(declaration))
}
# the mark of a number type the definition declares it gives, `f(c: Color): Color := c`, so its caller holds the
# result unboxed with its mark; 0 for any other result
declared_mark(f: Function): int := {
	declaration = result_declared(f.body)
	if declaration == ø { return 0 }
	type = if is_key(declaration, Op.As) then name_of(value_of(declaration)) else held_result_type(declaration)
	module.marks.get(type) ?? 0
}
# the part of a body that declares its result: `… as T`, or `the result: T = …` of a block, ø when none does
result_declared(n: Node): Node? := {
	if is_key(n, Op.As) and value_of(n) is symbol { return n }
	if not (is_group(n) and #n > 0 and (bracket_of(n) == "{" or separator_of(n) == ";")) { return ø }
	if held_result_type(n#1) != ø { return n#1 }
	result_declared(n#(#n))
}
# `T` of `the result: T = …`, else ø
held_result_type(n: Node): any := {
	if not (is_key(n, Op.Assign) and is_key(key_of(n), Op.Colon)) { return ø }
	declared = key_of(n)
	if key_of(declared) == symbol("the result") and value_of(declared) is symbol then name_of(value_of(declared)) else ø
}
# the kind a result declared `T` is held as: an instance or `any` a node; ø for a type word the core holds no kind of
result_type_kind(type_name: text): any := {
	word = aliased_type(type_name)
	if word in declared_kinds then declared_kinds[word] else if type_name == "any" or type_name in module.classes then ValueKind.Node else ø
}
analyzed_result_kind(f: Function): any := {
	found = analyzed_function(f)
	if found == ø { return ø }
	kept_kind(found["result"])
}
# (an empty map of locals comes as null: card lib-json)
analyzed_local_kind(f: Function, name: text): any := {
	found = analyzed_function(f)
	if found == ø or found["locals"] == ø or name not in found["locals"] { return ø }
	kept_kind(found["locals"][name])
}
# the kind of the elements analyzer.warp found for f's list `name`, if the emitter unboxes it from a node
analyzed_element_kind(f: Function, name: text): any := {
	found = analyzed_function(f)
	if found == ø or found["elements"] == ø or name not in found["elements"] { return ø }
	kind = found["elements"][name]
	if kind == ValueKind.Float or kind == ValueKind.Text or kind == ValueKind.List then kind else ø
}

compile_function(f: Function, argument_kinds: list): any := {
	outer = module.saw_pending
	if not module.surveying { function_compiled(f, argument_kinds) } else {
		try { function_compiled(f, argument_kinds) } catch refusal {
			if not ("" + refusal).starts_with(outside_the_core) { throw refusal }
			module.refusals += [outside_the_core + f.name + ": " + ("" + refusal)[(#outside_the_core)..]]
			if f.kinds == ø { f.kinds = argument_kinds.map(k => ValueKind.Node) }
			f.result = ValueKind.Node
		}
	}
	module.saw_pending = outer
}
# an unannotated parameter takes the kind of its first call's argument joined with those of every literal any call
# passes it: `binding_powers("=")` (a char) and `binding_powers("to")` make a text parameter, which a node converts to
parameter_joint(a: ValueKind, b: ValueKind): ValueKind := if (a == ValueKind.Char and b == ValueKind.Text) or (a == ValueKind.Text and b == ValueKind.Char) then ValueKind.Text else joint_kind(a, b)
literal_kind(n: Node): any := {
	if n is bool { return ValueKind.Bool }
	if n is text { return if #n == 1 then ValueKind.Char else ValueKind.Text }
	if n is int { return ValueKind.Int }
	if n is float { return ValueKind.Float }
	ø
}
def collect_literal_arguments(n: Node) {
	if is_group(n) and bracket_of(n) == "(" and #n > 1 and n#1 is symbol and name_of(n#1) in module.functions {
		for i in 1..<#n {
			kind = literal_kind(n#(i + 1))
			slot = parameter_key(name_of(n#1), i - 1)
			if kind != ø { module.literal_arguments[slot] = (if slot in module.literal_arguments then module.literal_arguments[slot] else []) + [kind] }
		}
	}
	if type(n) is key {
		collect_literal_arguments(key_of(n))
		collect_literal_arguments(value_of(n))
	}
	if is_group(n) { for x in n { collect_literal_arguments(x) } }
}
# the annotations of a parameter held as a node: any value, a node, a function, a type value `int`, a map, a number
# (an int or a float), a symbol or a key (node_cases.warp holds a written case `Key` as any); an optional `text?` is
# one too, ø or the value
node_annotations = ["any", "Node", "function", "type", "map", "number", "symbol", "Symbol", "key", "data"]
# the kind a parameter annotated `word` holds: a type alias's type's, a node for a class, a list for a type word's
# plural (`ints`, `texts`, `Points`)
annotated_kind(written: text): ValueKind := {
	# `(samples, float) -> any`: a function, held as a node
	if written.contains(" -> ") { return ValueKind.Node }
	if written.starts_with("[") { return ValueKind.List }
	word = aliased_type(written)
	if is_union(word) { return shared_kind(union_members(word).map(annotated_kind)) }
	if word in node_annotations or word in module.classes or word.ends_with("?") { return ValueKind.Node }
	# Rust twin: type_names.rs plural_element_type
	if word.ends_with("s") and names_a_type(word[0..<(#word - 1)]) { return ValueKind.List }
	# `list of text`, `map of int`: the collection the phrase starts with (parser.warp with_type_phrases)
	if word.contains(" of ") { return annotated_kind(word.split(" of ")#1) }
	word as ValueKind
}
# the kind every member holds, else a node, which holds any of them
shared_kind(kinds: list): ValueKind := if kinds.all(kind => kind == kinds#1) then kinds#1 else ValueKind.Node
# whether `converted` takes a value of kind `from` where `to` is needed: as it is, boxed into a node, read from a node,
# an int as a float or bool, a bool as an int, a character as a text
converts(from: ValueKind, to: ValueKind): bool := from == to or from == ValueKind.Node or to == ValueKind.Node or (from == ValueKind.Int and (to == ValueKind.Float or to == ValueKind.Bool)) or (from == ValueKind.Bool and to == ValueKind.Int) or (from == ValueKind.Char and to == ValueKind.Text)
# whether a value of the kind is one of the union's members, as far as the compile knows it: a node is checked when it
# runs, ø among them; an optional member `text?` takes a text
fits_union(type: text, kind: ValueKind): bool := union_members(type).any(member => converts(kind, annotated_kind(member.remove_suffix("?"))))
# the type a type alias names in the end, `Years?` of `type Years = Age; type Age = int` gives `int?`, the core's word of
# a type word's other spelling (`string`, `integer`: type_synonyms); any other word itself
aliased_type(word: text): text := {
	optional = word.ends_with("?")
	resolved = if optional then word[0..<(#word - 1)] else word
	while resolved in module.aliases { resolved = module.aliases[resolved] }
	if optional then resolved + "?" else resolved
}
# the type words' other spellings as the aliases every program starts with, so aliased_type resolves them in its one loop
type_synonyms(): map := {
	found = {}
	for word in core_type_words.keys { if core_type_words.get(word) != word { found[word] = core_type_words.get(word) } }
	found
}
names_a_type(word: text): bool := is_held_kind(word) or word in node_annotations or word in module.classes or word in module.aliases
function_compiled(f: Function, argument_kinds: list): any := {
	# a linked module's word the program only declares (no body): its code is the module's (bind_library_words)
	if f.name in module.linked_words and f.body == Node.Empty { return refuse(linked_arity_refusal(f.name, #f.signature.parameters)) }
	placed(f)
	if is_primitive_function(f) { return primitive_compiled(f) }
	parameter_kinds = []
	for i in 0..<#f.signature.parameters {
		declared = f.signature.parameters[i].type_name
		annotation = if declared is empty then ø else annotated_kind(declared)
		# an argument of a call still compiling (a cycle of functions) is not known yet: the parameter takes a node
		# (in runtime.wasm, any argument: no program decides it)
		given = if argument_kinds[i] == pending or module.relocating then ValueKind.Node else argument_kinds[i]
		# analyzer.warp's kind, but a node stays one where it found a list: it may be a list of other brackets (`{1 2}`)
		# (not in a prebuilt module, whose callers are programs the analyzer never saw: `osc(440, 2ms)` of a parameter
		# its own calls give floats)
		analyzed = if module.relocating and not module.prebuilding then ø else analyzed_parameter_kind(f, i)
		if annotation == ø and analyzed != ø and not (given == ValueKind.Node and analyzed == ValueKind.List) { annotation = analyzed }
		if parameter_key(f.name, i) in module.literal_arguments {
			for kind in module.literal_arguments[parameter_key(f.name, i)] { given = parameter_joint(given, kind) }
		}
		if parameter_key(f.name, i) in module.later_kinds { given = parameter_joint(given, module.later_kinds[parameter_key(f.name, i)]) }
		if annotation == ø { module.unannotated[parameter_key(f.name, i)] = yes }
		parameter_kinds += [if annotation == ø then given else annotation]
	}
	for kind in parameter_kinds { if not (is_held_kind(kind)) { return refuse("a parameter of kind " + kind_spelling(kind)) } }
	f.kinds = parameter_kinds
	# the first readings find the result kind and the kinds of locals assigned values of two kinds (`widens`), the
	# last gives the code with every recursive call knowing the result
	widened = -1
	while widened != #f.widened.keys {
		widened = #f.widened.keys
		f.kinds = range_list(#parameter_kinds).map(i => if parameter_key(f.name, i) in f.widened then f.widened[parameter_key(f.name, i)] else parameter_kinds[i])
		f.result = pending
		first = new_body(f)
		given = expression_code(first, statements_block(f.body))
		result = given.kind
		for kind in first.returned { result = joint_kind(result, kind) }
	}
	if result != no_kind and analyzed_result_kind(f) != ø and (result == pending or held_as(result, analyzed_result_kind(f))) { result = analyzed_result_kind(f) }
	# the kind a definition declares is the one its callers took while it was compiling (call_values), whatever its body
	# gave in a first reading of a cycle
	if result != no_kind and declared_result(f) != ø { result = declared_result(f) }
	if result == ValueKind.Mixed { return refuse(f.name + " giving a " + kind_spelling(result)) }
	# a body giving a number of a marked type gives it boxed, so its mark survives the call (decision
	# marks-unboxed-first: no inference of the result's mark)
	if given.mark != 0 and declared_result(f) == ø { result = ValueKind.Node }
	# a body ending in a statement (a loop, a print) gives ø, as Rust's does; one giving only the result of a call
	# still compiling gives a node
	f.result = if result == no_kind or result == pending then ValueKind.Node else result
	f.gives_nothing = result == no_kind
	module.saw_pending = no
	body_code(f)
	if module.saw_pending { module.rereads += [f] }
}
# the last reading of f, every call's result known but those of functions still compiling; a function that called
# one of those is read again once every function is compiled (module.rereads)
body_code(f: Function) := {
	scope = new_body(f)
	value = expression_code(scope, statements_block(f.body))
	value = TypedCode(value.kind, position_code(scope, f.body) + value.code, value.mark)
	f.code = if f.gives_nothing then value.code + [ref_null, gc_type(gc.node)] else converted(value, f.result)
	f.locals = scope.kinds[(#f.signature.parameters)..]
	f.local_names = scope.order
}
