# Closures (emitter.warp's part): closure values, their calls through dispatchers, the text a closure shows
## closures (Rust's lowering: rust-harness:src/lowering/definitions/closures.rs)
# `closure_new(target, captured…)`: a Function $Node holding the list [the target's number, the captured values…], its
# value the target's name, as Rust's reads back; module.closures holds [target name, captured count] by number.
# `closure_call_<n>(f, a…)`: a function made once per arity n, its code written last (dispatcher_code), that calls the
# target f's number names; `<target>·captured·<i>(f)`: f's i-th captured value
closure_call_prefix = "closure_call_"
captured_marker = "·captured·"
# what joins the parts of a lifted name: a method's witness `len·Point`, a nested `outer·inner`
name_joiner = "·"
# `closure_text(f)`: the text of a closure, its lambda as written (`x => x*2`) or its target's name, a function made
# once, its code written last (closure_text_code), as Rust's function_text table
closure_text_name = "closure_text"
# the targets Rust's lowering lifts from a lambda (rust-harness:src/lowering/definitions/closures.rs is_lambda_function)
lambda_prefixes = ["closure_lambda_", "lambda_value_"]
is_lifted_lambda(name: text): bool := lambda_prefixes.any(prefix => name.starts_with(prefix))
# the operators a closure takes part in (node_equal compares closures)
closure_comparisons = ["==", "!="]
is_closure_value(n: Node) := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 == symbol("closure_new")
def closure_value(body: Body, target: Node, captured: list): TypedCode {
	if not (target is symbol and name_of(target) in module.functions) { return refuse("a closure of " + form_of(target)) }
	number = closure_number(name_of(target), #captured)
	items = [boxed(closure_number_code(number))] + captured.map(c => boxed(expression_code(body, c)))
	TypedCode(ValueKind.Node, key_code(Kind.Function, vector_code(items), name_node(target)))
}
closure_number(name: text, captured: int): int := {
	for i in 0..<#module.closures { if module.closures[i]#1 == name { return i } }
	module.closures += [[name, captured]]
	#module.closures - 1
}
# a closure's number, in a prebuilt module relocatable: a link numbers a module's closures behind those before it
def closure_number_code(number: int): TypedCode { if module.relocating then TypedCode(ValueKind.Int, [op.i64_const] + relocatable(relocated.closures, number)) else number_value(number) }
# the item i of a closure's list: 0 its number, then its captured values
def closure_item(closure: list, i: int): TypedCode { TypedCode(ValueKind.Node, payload(closure, gc_type(gc.list)) + gc_code(gc_ops.struct_get, [gc_type(gc.list), 1]) + [op.i32_const] + sleb(i) + gc_code(gc_ops.array_get, [gc_type(gc.items)])) }
captured_index(name: text): int := int(name.split(captured_marker)#2) + 1
def closure_call(body: Body, arity: int, arguments: list): TypedCode {
	if #arguments != arity + 1 { return refuse("a closure call of " + #arguments + " values") }
	callee = expression_code(body, arguments#1)
	# `(2)(3)`, `(a + b)(c)`: a number glued to a group multiplies it, as `3(4)` does; a variable keeps its call
	numeric = callee.kind == ValueKind.Int or callee.kind == ValueKind.Float or grows(arguments#1)
	if numeric and arity == 1 and not (arguments#1 is symbol) { return expression_code(body, Key(arguments#1, Op.Mul, arguments#2)) }
	call_values(dispatcher(arity), [callee] + arguments[1..].map(a => expression_code(body, a)))
}
# `(a + b)`: a sum, difference or product, held boxed where a whole number may grow (operators.warp arithmetic), a
# number all the same
grows(n: Node): bool := {
	inner = if is_group(n) and bracket_of(n) == "(" and #n == 1 then n#1 else n
	type(inner) is key and op_of(inner) in grown_words and key_of(inner) != ø
}
# the name of a dispatcher's argument i, from 0
dispatcher_argument(i: int): text := "argument" + (i + 1)
dispatcher(arity: int): any := {
	made_late(closure_call_prefix + arity, ValueKind.Node, ["closure"] + range_list(arity).map(dispatcher_argument))
}
# a function over closures whose code is written once the program's closures are known, made at its first call
made_late(name: text, result: ValueKind, parameters: list): any := {
	# (a list: `name in module.dispatchers` of a map missed the name just set, card emitter-name)
	for known in module.dispatchers { if known.name == name { return known } }
	f = if is_runtime_hook(name) then runtime_hook(name, parameters) else added_function(name, parameters.map(p => ValueKind.Node), result, parameters)
	f.code = [op.unreachable]
	module.dispatchers += [f]
	f
}
# the runtime's words whose code the program decides (late_code), each its result and parameters: with the closure
# calls runtime.wasm's hooks
late_words = {closure_text: [ValueKind.Text, ["closure"]], instance_set: [ValueKind.Int, ["m", "name", "value"]],
	instance_entries: [ValueKind.Node, ["m"]], instance_field_at: [ValueKind.Node, ["m", "index"]], instance_place: [ValueKind.Int, ["m", "name"]],
	is_class_instance: [ValueKind.Bool, ["m"]], shown_big_int: [ValueKind.Text, ["n"]], instance_show: [ValueKind.Node, ["m"]], instance_float: [ValueKind.Node, ["m"]]}
late_word(name: text): any := made_late(name, late_words[name]#1, late_words[name]#2)
# for each closure: if the closure's number is its own, the text it shows; another value shows "function"
closure_text_code(f: Function): any := {
	number = unboxed(closure_item([op.local_get, 0], 0).code, gc_type(gc.int_box))
	f.code = text_bytes("function")
	for k in 0..<#module.closures {
		shown = text_bytes(closure_shown(module.closures[k]#1, module.closures[k]#2))
		f.code = number + [op.i64_const] + sleb(k) + [op.i64_eq, op.if, no_value] + shown + [op.return, op.end] + f.code
	}
}
# a lifted lambda as written, its parameters but the captured ones (`x => x*2`); another target by its name
closure_shown(name: text, captured: int): text := {
	if name in module.linked_closures_shown { return module.linked_closures_shown[name] }
	if not is_lifted_lambda(name) { return function_name(name) }
	f = module.functions[name]
	names = taken_names(f.signature)[captured..]
	(if #names == 1 then names#1 else "(" + names.join(", ") + ")") + " => " + str(f.body)
}
# the name a function value shows, as Rust's (closures.rs function_name): `len` of a class's method that became the
# witness `len·Point`, the last part of a nested `outer·inner`
function_name(target: text): text := {
	parts = target.split(name_joiner)
	if #parts == 1 { return target }
	last = parts.last
	if last in module.classes then parts[0..<(#parts - 1)].join(name_joiner) else last
}
# the code of a function made late (made_late), once the program's closures and classes are known
late_code(f: Function): int := {
	if f.name == closure_text_name { closure_text_code(f) } else if f.name == shown_big_int_name { shown_big_int_code(f) } else if f.name == instance_set_name { instance_set_code(f) } else if f.name == instance_entries_name { instance_entries_code(f) } else if f.name == instance_field_at_name { instance_field_at_code(f) } else if f.name == instance_place_name { instance_place_code(f) } else if f.name == is_class_instance_name { is_class_instance_code(f) } else if f.name == instance_show_name { instance_show_code(f) } else if f.name == instance_float_name { instance_float_code(f) } else if f.name.starts_with(field_getter_prefix) { field_getter_code(f) } else if f.name.starts_with(field_setter_prefix) { field_setter_code(f) } else { dispatcher_code(f) }
	0
}
# a class value called, `make(c, xs) := c(xs#1, xs#2)` of `make(P, [3, "a"])`: the instance `P(3, "a")` makes, for each
# class of at least that many fields, built from the dispatcher's arguments as positional_instance builds a call's
def class_value_calls(f: Function, arity: int): list {
	scope = new_body(f)
	# a runtime hook's signature names no parameters: its locals in their order, the closure, then the arguments
	parameters = ["closure"] + range_list(arity).map(dispatcher_argument)
	for name in parameters { if name not in scope.names { local_index(scope, name, ValueKind.Node) } }
	code = []
	for class_name in module.classes.keys.filter(name => #module.classes[name].keys >= arity) {
		named = runtime_call("names_class", [TypedCode(ValueKind.Node, [op.local_get, 0]), text_value_of(class_name)])
		code += named.code + [op.if, no_value] + boxed(positional_instance(scope, class_name, parameters[1 ..].map(name => symbol(name)))) + [op.return, op.end]
	}
	f.locals = scope.kinds[#parameters ..]
	code
}
# a value called that is no closure fails in not_a_function; the closure's number picks, in one br_table jump, the
# target's call on the captured values and the arguments (a test per closure made every call scan them all); a closure
# of another arity fails in wrong_number_of_arguments (the runtime errors of Rust's rust-harness:src/wasm_emitter/functions/closures.rs)
dispatcher_code(f: Function): any := {
	arity = #f.kinds - 1
	closure = [op.local_get, 0]
	number = unboxed(closure_item(closure, 0).code, gc_type(gc.int_box))
	not_a_function = dropped(runtime_call("not_a_function", [])) + [op.unreachable]
	code = closure + [op.ref_is_null, op.if, no_value] + not_a_function + [op.end]
	code += class_value_calls(f, arity)
	code += kind_code_of(closure) + [op.i64_const] + sleb(Kind.Function) + [op.i64_ne, op.if, no_value] + not_a_function + [op.end]
	# the arms in closure order, each the block its br_table label leaves; the outermost block (label #arms) fails
	arms = []
	labels = []
	for k in 0..<#module.closures {
		target = module.functions[module.closures[k]#1]
		captured = module.closures[k]#2
		if #target.signature.parameters - captured == arity {
			labels += [#arms]
			values = range_list(captured).map(i => closure_item(closure, i + 1)) + range_list(arity).map(j => TypedCode(ValueKind.Node, [op.local_get] + uleb(j + 1)))
			arms += [boxed(call_values(target, values)) + [op.return]]
		} else {
			labels += [-1]
		}
	}
	failing = #arms
	table = uleb(#labels)
	for label in labels { table += uleb(if label < 0 then failing else label) }
	for i in 0..<(failing + 1) { code += [op.block, no_value] }
	code += number + [op.i32_wrap_i64, op.br_table] + table + uleb(failing)
	for arm in arms { code += [op.end] + arm }
	f.code = code + [op.end] + dropped(runtime_call("wrong_number_of_arguments", [])) + [op.unreachable]
}
