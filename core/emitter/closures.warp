# Closures (emitter.warp's part): closure values, their calls through dispatchers, the text a closure shows
## closures
# `closure_new(target, captured…)`: a Function $Node holding the list [its entry, the captured values…], its value the
# target's name. The entry, a Closure struct, holds a reference to the target's closure entry and the text the closure
# shows: a closure is called by that reference, in whichever module made it (card closure-funcref).
# `closure_entry·<target>(closure, a…)`: made once per target, it calls the target on the closure's captured values
# and the arguments, of the fixed type closure_call_type_<n> of its n arguments.
# `closure_call_<n>(f, a…)`: a function made once per arity n, its code written last (dispatcher_code), that calls the
# entry f holds; `<target>·captured·<i>(f)`: f's i-th captured value
closure_call_prefix = "closure_call_"
closure_entry_prefix = "closure_entry·"
captured_marker = "·captured·"
# what joins the parts of a lifted name: a method's witness `len·Point`, a nested `outer·inner`
name_joiner = "·"
# `closure_text(f)`: the text of a closure, its lambda as written (`x => x*2`) or its target's name, as its entry holds it
closure_text_name = "closure_text"
# the targets the lowering lifts from a lambda
lambda_prefixes = ["closure_lambda_", "lambda_value_"]
is_lifted_lambda(name: text): bool := lambda_prefixes.any(prefix => name.starts_with(prefix))
# the operators a closure takes part in (node_equal compares closures)
closure_comparisons = ["==", "!="]
is_closure_value(n: Node) := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 == symbol("closure_new")
def closure_value(body: Body, target: Node, captured: list): TypedCode {
	if not (target is symbol and name_of(target) in module.functions) { return refuse("a closure of " + form_of(target)) }
	name = name_of(target)
	arity = #module.functions[name].signature.parameters - #captured
	if arity > hook_arities { return refuse("a closure of " + arity + " parameters, more than " + hook_arities) }
	entry = closure_entry(name, #captured, arity)
	held = [op.i64_const] + sleb(Kind.Data) + [ref_null, any_reference, ref_null, gc_type(gc.node), op.ref_func] + relocatable(relocated.calls, entry#3.index) + text_bytes(entry#4) + gc_code(gc_ops.struct_new, [gc_type(gc.closure)])
	items = [held] + captured.map(c => boxed(expression_code(body, c)))
	TypedCode(ValueKind.Node, key_code(Kind.Function, vector_code(items), name_node(symbol(without_arity(written_word(name))))))
}
# the closure entry of a target, the first of its captured values those given: [target, captured count, the entry,
# the text the closure shows]
closure_entry(target: text, captured: int, arity: int): any := {
	name = closure_entry_prefix + target
	if name not in module.closures {
		f = added_function(name, range_list(arity + 1).map(i => ValueKind.Node), ValueKind.Node, ["closure"] + range_list(arity).map(dispatcher_argument))
		f.code = [op.unreachable]
		module.closures[name] = [target, captured, f, closure_shown(target, captured)]
	}
	module.closures[name]
}
# its code: the target called on the captured values, then the arguments
closure_entry_code(f: Function): any := {
	made = module.closures[f.name]
	closure = [op.local_get, 0]
	values = range_list(made#2).map(i => closure_item(closure, i + 1)) + range_list(#f.kinds - 1).map(j => TypedCode(ValueKind.Node, [op.local_get] + uleb(j + 1)))
	f.code = boxed(call_values(module.functions[made#1], values))
}
# a closure's list item i: its entry (0) a $Closure, its captured values (from 1)
def closure_slot(closure: list, i: int): list { payload(closure, gc_type(gc.list)) + gc_code(gc_ops.struct_get, [gc_type(gc.list), 1]) + [op.i32_const] + sleb(i) + gc_code(gc_ops.array_get, [gc_type(gc.items)]) }
def closure_item(closure: list, i: int): TypedCode { TypedCode(ValueKind.Node, closure_slot(closure, i)) }
# a field of a closure's entry: 0 the reference it calls, 1 its text (after the $Node's three)
def entry_field(closure: list, field: int): list { closure_slot(closure, 0) + gc_code(gc_ops.ref_cast_null, [gc_type(gc.closure)]) + gc_code(gc_ops.struct_get, [gc_type(gc.closure), field + 3]) }
captured_index(name: text): int := int(name.split(captured_marker)#2) + 1
def closure_call(body: Body, arity: int, arguments: list): TypedCode {
	if #arguments != arity + 1 { return refuse("a closure call of " + #arguments + " values") }
	if arity > hook_arities { return refuse("a closure call of " + arity + " arguments, more than " + hook_arities) }
	callee = expression_code(body, arguments#1)
	# `(2)(3)`, `(a + b)(c)`: a number glued to a group multiplies it, as `3(4)` does; a variable keeps its call
	numeric = callee.kind == ValueKind.Int or callee.kind == ValueKind.Float or grows(arguments#1)
	if numeric and arity == 1 and not (arguments#1 is symbol) { return expression_code(body, Key(arguments#1, Op.Mul, arguments#2)) }
	called = call_values(dispatcher(arity), [callee] + arguments[1..].map(a => expression_code(body, a)))
	# a parameter `f: (float) -> float` gives what its type says: `whole(t) := 3` passed for it gives 3.0
	result = if arguments#1 is symbol then parameter_result(body.function, name_of(arguments#1)) else ValueKind.Node
	if result == ValueKind.Node then called else TypedCode(result, converted(called, result))
}
# the kind a function-typed parameter's result is declared, a number, a text or a bool; a node for another or none
def parameter_result(f: Function, name: text): ValueKind {
	for i in 0..<#f.signature.parameters {
		written = aliased_type(f.signature.parameters[i].type_name)
		if f.signature.parameters[i].name == name and written.contains(" -> ") {
			parts = written.split(" -> ")
			kind = annotated_kind(parts[#parts - 1].trim())
			if kind == ValueKind.Int or kind == ValueKind.Float or kind == ValueKind.Text or kind == ValueKind.Bool { return kind }
		}
	}
	ValueKind.Node
}
# `(a + b)`: a sum, difference or product, held boxed where a whole number may grow (operators.warp arithmetic), a
# number all the same
grows(n: Node): bool := {
	inner = if is_group(n) and bracket_of(n) == "(" and #n == 1 then n#1 else n
	type(inner) is key and op_of(inner) in grown_words and key_of(inner) != ø
}
# the name of a dispatcher's argument i, from 0
dispatcher_argument(i: int): text := "argument" + (i + 1)
dispatcher(arity: int): any := {
	made_late(closure_call_prefix + arity, ValueKind.Node, ["closure"] + range_list(arity).map(dispatcher_argument))
}
# a function whose code is written once the module's closures and classes are known, made at its first call; behind
# runtime.wasm a runtime word of that name is runtime.wasm's (the closure calls and late words, written there once)
made_late(name: text, result: ValueKind, parameters: list): any := {
	if prepended() and name in module.runtime { return module.runtime[name] }
	# (a list: `name in module.dispatchers` of a map missed the name just set, card emitter-name)
	for known in module.dispatchers { if known.name == name { return known } }
	f = added_function(name, parameters.map(p => ValueKind.Node), result, parameters)
	f.code = [op.unreachable]
	module.dispatchers += [f]
	f
}
# the runtime's words over closures and instances (late_code), each its result and parameters: written once in
# runtime.wasm, calling through the value's entry or descriptor
late_words = {closure_text: [ValueKind.Text, ["closure"]], instance_set: [ValueKind.Int, ["m", "name", "value"]],
	instance_entries: [ValueKind.Node, ["m"]], instance_field_at: [ValueKind.Node, ["m", "index"]], instance_place: [ValueKind.Int, ["m", "name"]],
	is_class_instance: [ValueKind.Bool, ["m"]], instance_show: [ValueKind.Node, ["m"]], instance_float: [ValueKind.Node, ["m"]],
	instance_operated: [ValueKind.Node, ["m", "a", "b", "operator"]]}
late_word(name: text): any := made_late(name, late_words[name]#1, late_words[name]#2)
# the text its entry holds
closure_text_code(f: Function): any := { f.code = entry_field([op.local_get, 0], 1) }
# a lifted lambda as written, its parameters but the captured ones (`x => x*2`); another target by its name
closure_shown(name: text, captured: int): text := {
	if not is_lifted_lambda(name) { return function_name(name) }
	f = module.functions[name]
	names = taken_names(f.signature)[captured..]
	(if #names == 1 then names#1 else "(" + names.join(", ") + ")") + " => " + str(f.body)
}
# the name a function value shows, as written (`twice` of the program's own `twice·own`): `len` of a class's
# method that became the witness `len·Point`, the last part of a nested `outer·inner`
function_name(target: text): text := {
	written = without_arity(written_word(target))
	parts = written.split(name_joiner)
	if #parts == 1 { return written }
	last = parts.last
	if last in module.classes then parts[0..<(#parts - 1)].join(name_joiner) else last
}
# a variant of a name defined with several parameter counts as written: `low` of low·0 (passes/walk.warp
# overload_variant_name)
without_arity(name: text): text := {
	parts = name.split(name_joiner)
	if #parts > 1 and (is_digits(parts.last) or parts.last == "more") then parts[0..<(#parts - 1)].join(name_joiner) else name
}
# the code of a function made late (made_late), once the program's closures and classes are known
late_code(f: Function): int := {
	if f.name == closure_text_name { closure_text_code(f) } else if f.name == instance_set_name { instance_set_code(f) } else if f.name == instance_entries_name { instance_entries_code(f) } else if f.name == instance_field_at_name { instance_field_at_code(f) } else if f.name == instance_place_name { instance_place_code(f) } else if f.name == is_class_instance_name { is_class_instance_code(f) } else if f.name == instance_show_name { instance_show_code(f) } else if f.name == instance_float_name { instance_float_code(f) } else if f.name == instance_operated_name { instance_operated_code(f) } else if f.name.starts_with(field_getter_prefix) { field_getter_code(f) } else if f.name.starts_with(field_setter_prefix) { field_setter_code(f) } else { dispatcher_code(f) }
	0
}
# an instance called, `room(signal)`, `A(1)(2)`: its module's call taking it first (trait Callable), its method or
# function `call(self, …)`
callable_words = ["call", "call·method"]
# a value called: a class value, `make(c, xs) := c(xs#1, xs#2)` of `make(P, [3, "a"])`, constructs by its descriptor
# (`P(3, "a")`); an instance calls its descriptor's call; a closure's entry is called by reference; any other value fails
# in not_a_function, a closure or instance's call of another arity in wrong_number_of_arguments
dispatcher_code(f: Function): any := {
	arity = #f.kinds - 1
	closure = [op.local_get, 0]
	not_a_function = dropped(runtime_call("not_a_function", [])) + [op.unreachable]
	wrong_arity = dropped(runtime_call("wrong_number_of_arguments", [])) + [op.unreachable]
	arguments = parameters_code(#f.kinds)
	code = closure + [op.ref_is_null, op.if, no_value] + not_a_function + [op.end]
	# a type value's value is its class's descriptor, ø of a type that is no class
	type_value = closure + gc_code(gc_ops.struct_get, [gc_type(gc.node), 0]) + [op.i64_const] + sleb(Marked.TypeValue) + [op.i64_eq]
	described = closure + gc_code(gc_ops.struct_get, [gc_type(gc.node), 2])
	construct = described + gc_code(gc_ops.ref_cast, [gc_type(gc.class)]) + gc_code(gc_ops.struct_get, [gc_type(gc.class), slot_field("construct")])
	values = node(Kind.List, vector_code(range_list(arity).map(i => [op.local_get] + uleb(i + 1))))
	constructed = entered_node(closure + values + construct + gc_code(gc_ops.ref_cast, [gc_type(closure_call_type_prefix + 1)]) + [op.call_ref] + relocatable(relocated.types, gc_type(closure_call_type_prefix + 1)))
	code += type_value + [op.if, no_value] + described + gc_code(gc_ops.ref_test, [gc_type(gc.class)]) + [op.if, no_value] + constructed + [op.return, op.end] + not_a_function + [op.end]
	call_type = gc_type(closure_call_type_prefix + arity)
	# an instance: its descriptor's call, of this arity
	called = descriptor_of(closure) + gc_code(gc_ops.ref_cast, [gc_type(gc.class)]) + gc_code(gc_ops.struct_get, [gc_type(gc.class), slot_field("call")])
	instance = called + [op.ref_is_null, op.if, no_value] + not_a_function + [op.end] + called + gc_code(gc_ops.ref_test, [call_type]) + [op.i32_eqz, op.if, no_value] + wrong_arity + [op.end] + entered_node(arguments + called + gc_code(gc_ops.ref_cast, [call_type]) + [op.call_ref] + relocatable(relocated.types, call_type)) + [op.return]
	code += kind_code_of(closure) + [op.i64_const] + sleb(Kind.Function) + [op.i64_ne, op.if, no_value] + is_described(closure) + [op.if, no_value] + instance + [op.end] + not_a_function + [op.end]
	entry = entry_field(closure, 0)
	code += entry + gc_code(gc_ops.ref_test, [call_type]) + [op.i32_eqz, op.if, no_value] + wrong_arity + [op.end]
	f.code = code + entered_node(arguments + entry + gc_code(gc_ops.ref_cast, [call_type]) + [op.call_ref] + relocatable(relocated.types, call_type))
}
