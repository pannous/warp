# Statements and control flow (emitter.warp's part): try, if, loops with break and continue, statements for effect,
# sequences, appends in place
# `ran·without·error{statement}`, what `try` lowers to: 1 when the statement finished, 0 when a runtime error was thrown
# in it; the depth goes up for the statement and back down on both paths (a jump out of it would skip that: refused)
def ran_without_error(body: Body, statement: Node): TypedCode {
	for jump in ["return", "break", "continue"] { if mentions(statement, jump) { return refuse("a " + jump + " out of a try") } }
	guarded = [op.try_table, no_value] + uleb(1) + [catch_clause_byte, 0, 0] + nested_effect(body, statement, 3) + [op.end]
	finished = try_depth_step(op.i64_sub) + [op.i64_const, 1, op.br, 1, op.end]
	caught = [op.drop] + try_depth_step(op.i64_sub) + [op.i64_const, 0]
	# the inner block's value: the thrown error's id, an i32
	TypedCode(ValueKind.Int, try_depth_step(op.i64_add) + [op.block] + value_type(ValueKind.Int) + [op.block] + value_type(ValueKind.Bool) + guarded + finished + caught + [op.end])
}
def try_depth_step(instruction: int): list {
	depth = relocatable(relocated.globals, module.globals[try_depth_name]#1)
	[op.global_get] + depth + [op.i64_const, 1, instruction, op.global_set] + depth
}
# a runtime error ahead of its trap: the global trap_name names `name`, the function it fails in, whose words the
# run's error says (runtime/error_sentences.warp); while a try runs, it throws for `catch e` (runtime.warp caught_error)
def error_throw(name: text): list {
	named = boxed(TypedCode(ValueKind.Text, text_bytes(name))) + [op.global_set] + relocatable(relocated.globals, declared_global(trap_name_global, ValueKind.Node)#1)
	if not module.catches_errors { return named }
	named + [op.global_get] + relocatable(relocated.globals, module.globals[try_depth_name]#1) + [op.i64_eqz, op.i32_eqz, op.if, no_value, op.i32_const, 0, op.throw, 0, op.end]
}
# `if c then a else b`, `if c then a`: the parser's keys else(then(if(ø, c), a), b)
# has_else: `else ø` is a branch giving ø, no missing one
def conditional(body: Body, test: Node, yes_branch: Node, no_branch: Node, has_else: bool): TypedCode {
	c = condition_of(body, test, 0)
	# a branch the kinds rule out is not compiled, as it may not fit them: `if x is text { count(x) }` of a float
	if c == known_condition(yes) { return nested(body, statements_block(yes_branch), 0) }
	if c == known_condition(no) { return if has_else then nested(body, statements_block(no_branch), 0) else TypedCode(ValueKind.Node, [ref_null, gc_type(gc.node)]) }
	a = nested(body, statements_block(yes_branch), 1)
	if not has_else { return unmatched(c, a, yes_branch is number) }
	b = nested(body, statements_block(no_branch), 1)
	kind = joint_kind(a.kind, b.kind)
	# a first reading whose branches both wait on calls still compiling: its kind is not known yet either (its code is
	# not kept), so the function's other readings decide it
	if kind == pending and body.function.result == pending { return TypedCode(pending, c + [op.if] + value_type(ValueKind.Node) + a.code + [op.else] + b.code + [op.end]) }
	if kind == pending { kind = ValueKind.Int }
	if kind == no_kind or kind == ValueKind.Mixed { return TypedCode(no_kind, c + [op.if, no_value] + dropped(a) + [op.else] + dropped(b) + [op.end]) }
	TypedCode(kind, c + [op.if] + value_type(kind) + converted(a, kind) + [op.else] + converted(b, kind) + [op.end])
}
# `if c then a` without else: a, or when c fails the 0 of a number or yes/no, else ø, as Rust gives
def unmatched(c: list, a: TypedCode, numeric: bool): TypedCode {
	if a.kind == no_kind { return TypedCode(no_kind, c + [op.if, no_value] + a.code + [op.end]) }
	if a.kind == ValueKind.Int or a.kind == pending { return TypedCode(ValueKind.Int, c + [op.if] + value_type(ValueKind.Int) + converted(a, ValueKind.Int) + [op.else, op.i64_const, 0, op.end]) }
	otherwise = if numeric or a.kind == ValueKind.Float or a.kind == ValueKind.Bool then boxed(number_value(0)) else [ref_null, gc_type(gc.node)]
	TypedCode(ValueKind.Node, c + [op.if] + value_type(ValueKind.Node) + boxed(a) + [op.else] + otherwise + [op.end])
}
# `while c do body`: block { loop { exit unless c; block { body }; step; again } }; a `break` in body branches to the
# outer block's end, a `continue` to the inner one's, so the step a `for` lowering appends (`loop·step: i++`) still runs.
# Its value is that of the body's last run, ø when it never ran (the local `last` keeps it)
def loop_of(body: Body, test: Node, block: Node): TypedCode {
	last = fresh_local(body, ValueKind.Node)
	code = loop_code(body, test, block, last)
	# `while true` without a break ends only by a return: no value, the function's result is its returns' alone
	if is_endless(test, block) { return TypedCode(never, code + [op.unreachable]) }
	TypedCode(ValueKind.Node, code + [op.local_get] + uleb(last))
}
# the code of a loop; each run of its body sets the local `last` to its value, or, with last -1, runs it for its effect
def loop_code(body: Body, test: Node, block: Node, last: int): list {
	exit_unless = condition_of(body, test, 2) + [op.i32_eqz, op.br_if, 1]
	parts = block_statements(block)
	has_step = #parts > 0 and is_loop_step(parts.last)
	again = if has_step then dropped(nested(body, value_of(parts.last), 2)) + [op.br, 0] else [op.br, 0]
	if has_step { parts = parts[0..<(#parts - 1)] }
	body.exits += [body.depth + 1]
	body.continuable += [has_step or continued_safely(test, parts)]
	body.depth += 3
	looped = if #parts == 0 then TypedCode(no_kind, []) else if last < 0 then TypedCode(no_kind, effects(body, parts)) else sequence(body, parts)
	body.depth -= 3
	body.exits = body.exits[0..<(#body.exits - 1)]
	body.continuable = body.continuable[0..<(#body.continuable - 1)]
	kept = if looped.kind == no_kind then looped.code else boxed(looped) + [op.local_set] + uleb(last)
	[op.block, no_value, op.loop, no_value] + exit_unless + [op.block, no_value] + kept + [op.end] + again + [op.end, op.end]
}
is_endless(test: Node, block: Node): bool := test == yes and not mentions(block, "break")
is_loop_step(n: Node): bool := is_key(n, Op.Colon) and key_of(n) == symbol(HiddenWord.LoopStep as text)
# whether a continue may skip the loop's last statement: not when it assigns a name the test reads, the shape of a
# lowered `for`'s step that came unmarked (Rust's iterator loops: `x = x·iterator.next()`)
step_operators = ["=", "+=", "-=", "++", "--"]
continued_safely(test: Node, parts: list): bool := {
	if #parts == 0 { return yes }
	final_statement = parts.last
	not (type(final_statement) is key and op_of(final_statement) in step_operators and key_of(final_statement) is symbol and mentions(test, name_of(key_of(final_statement))))
}
# n for its effect alone, its value never made: a statement, so an `if` or a loop only runs its branches or body as
# statements too (no value boxed for nothing)
def effect(body: Body, n: Node): list {
	if is_group(n) {
		if not is_code_block(n) or is_lowered_try(n) { return discarded(body, statement(body, n), n) }
		return effects(body, items_of(n))
	}
	if not (type(n) is key) { return discarded(body, statement(body, n), n) }
	operator = op_of(n)
	left = key_of(n)
	if operator == Op.Then and is_key(left, Op.If) { return conditional_effect(body, right_of_if(left), value_of(n), ø, no) }
	if operator == Op.Else and is_key(left, Op.Then) and is_key(key_of(left), Op.If) { return conditional_effect(body, right_of_if(key_of(left)), value_of(left), value_of(n), yes) }
	if operator == Op.Do and is_key(left, Op.While) { return loop_code(body, value_of(left), value_of(n), -1) }
	discarded(body, statement(body, n), n)
}
# a statement's value dropped (decision dropped-error-raises): an Error raises, its message stopping the run, but the
# value of an assignment or definition is kept, a try's is the one it caught, and a runtime word drops its own on purpose
kept_value_ops = ["=", ":=", ":"]
def discarded(body: Body, value: TypedCode, n: Node): list {
	kept = body.function.is_runtime or (type(n) is key and op_of(n) in kept_value_ops) or is_lowered_try(n)
	if value.kind != ValueKind.Node or kept { return dropped(value) }
	# the statement's place again, which the words it called moved on: the raise names where the Error was dropped
	dropped(runtime_call("dropped_value", [TypedCode(value.kind, value.code + position_code(body, n))]))
}
# what tries.warp lowers a try to: (try·finished = ran·without·error({…}); …)
def is_lowered_try(n: Node): bool := is_group(n) and #n > 0 and is_key(n#1, Op.Assign) and mentions(value_of(n#1), HiddenWord.RanWithoutError as text)
# an if run for its effect, a branch the kinds rule out not compiled (as conditional)
def conditional_effect(body: Body, test: Node, yes_branch: Node, no_branch: Node?, has_else: bool): list {
	c = condition_of(body, test, 0)
	if c == known_condition(yes) { return nested_effect(body, yes_branch, 0) }
	if c == known_condition(no) { return if has_else then nested_effect(body, no_branch, 0) else [] }
	otherwise = if has_else then [op.else] + nested_effect(body, no_branch, 1) else []
	c + [op.if, no_value] + nested_effect(body, yes_branch, 1) + otherwise + [op.end]
}
def effects(body: Body, items: list): list {
	code = []
	for item in items { code += effect(body, item) }
	code
}
# a group of statements: a block, not a map or the spaced `y = 2 x`
is_code_block(n: Node): bool := #n > 0 and separator_of(n) != " " and (bracket_of(n) == "{" or bracket_of(n) == "" or separator_of(n) == ";") and not items_of(n).all(is_map_entry)
def nested_effect(body: Body, n: Node, blocks: int): list {
	body.depth += blocks
	code = effect(body, n)
	body.depth -= blocks
	code
}

# the code of n read inside `blocks` more blocks, loops or ifs
def nested(body: Body, n: Node, blocks: int): TypedCode {
	body.depth += blocks
	code = expression_code(body, n)
	body.depth -= blocks
	code
}

# `break`: to the end of the innermost loop's block
def loop_exit(body: Body): TypedCode {
	if #body.exits == 0 { return refuse("a break outside a loop") }
	TypedCode(no_kind, [op.br] + uleb(body.depth - body.exits.last))
}

# `continue`: to the end of the block around the innermost loop's body, before its step
def loop_again(body: Body): TypedCode {
	if #body.exits == 0 { return refuse("a continue outside a loop") }
	if not body.continuable.last { return refuse("a continue in a loop whose last statement may be its step") }
	TypedCode(no_kind, [op.br] + uleb(body.depth - body.exits.last - 2))
}

# a statement's code, its value dropped
# `m.size`, `m.keys`: the entry of that name of a map that has one (`{size: 7}.size` is 7), else the word applied to m
def field_or_word(body: Body, value: TypedCode, name: text, word: function): TypedCode {
	if value.kind != ValueKind.Node { return word(value) }
	held = uleb(fresh_local(body, ValueKind.Node))
	receiver = TypedCode(ValueKind.Node, [op.local_get] + held)
	has_it = condition(runtime_call("has_field", [receiver, text_value_of(name)]))
	read = boxed(runtime_call("map_get", [receiver, text_value_of(name)]))
	TypedCode(ValueKind.Node, value.code + [op.local_set] + held + has_it + [op.if] + value_type(ValueKind.Node) + read + [op.else] + boxed(word(receiver)) + [op.end])
}
# the program's statement n about to run, its position in trap_position: a runtime error names it, as Rust's
# (emit_trap_position); a runtime word's statements leave it
def position_code(body: Body, n: Node): list {
	at = if body.intrinsics then ø else written_at(n)
	if not at { return [] }
	line: int = at#1
	column: int = min(at#2, columns_per_line - 1)
	[op.i32_const] + sleb(line * columns_per_line + column) + [op.global_set] + relocatable(relocated.globals, declared_global("trap_position", ValueKind.I32)#1)
}
def dropped(value: TypedCode): list { if value.kind == no_kind then value.code else value.code + [op.drop] }

# `xs += e`: e's items appended to the list xs holds, in place, so every alias sees them; ø when xs holds no list
appended(body: Body, target_name: Node, addition: Node): TypedCode? := {
	target = expression_code(body, target_name)
	added = expression_code(body, addition)
	# a list takes any other value than a list as one item: `xs = []; xs += 3` is [3]
	if target.kind == ValueKind.List and added.kind != ValueKind.List and added.kind != ValueKind.Node { added = TypedCode(ValueKind.List, vector_code([boxed(added)])) }
	# `for w in words { xs += w }`: an addition known only at run time is its items or one item (runtime appended_items)
	if target.kind == ValueKind.List and added.kind == ValueKind.Node { added = runtime_call("appended_items", [added]) }
	if target.kind == ValueKind.List { return runtime_call("list_append", [target, added]) }
	if target.kind == ValueKind.Node { return assignment(body, target_name, runtime_call("node_append", [target, added])) }
	ø
}
# the statements in order, the value that of the last
def sequence(body: Body, items: list): TypedCode {
	if #items == 0 { return refuse("an empty block") }
	# a class or enum declaration is no value (collect_types reads it): the block's value is its last other statement,
	# also where a used class's declaration was brought in after the program (the prelude's `class Error` that `x =
	# Error; 7` reaches made the program show nothing)
	valued = items
	while #valued > 1 and declares_type(valued.last) { valued = valued[0..<(#valued - 1)] }
	code = effects(body, valued[0..<(#valued - 1)])
	last = statement(body, valued.last)
	TypedCode(last.kind, code + last.code, last.mark)
}
# a statement of a sequence: a local stays unshared while statements only append to it (Rust's list_sharing.rs,
# simpler); a fresh list makes it unshared, a list made inside a block of the statement does not outlast it
def statement(body: Body, n: Node): TypedCode {
	kept = []
	for name in body.unshared { if appends_only(n, name) { kept += [name] } }
	body.unshared = kept
	value = expression_code(body, n)
	value = TypedCode(value.kind, position_code(body, n) + value.code, value.mark)
	after = []
	for name in body.unshared { if name in kept { after += [name] } }
	made = fresh_list_name(n)
	if made != ø and made in body.names { after += [made] }
	body.unshared = after
	value
}
# `xs = []`, `xs = ø`, `xs = [a, b]`: the local name holds a list made right here
fresh_list_name(n: Node): text? := {
	if not (is_key(n, Op.Assign) and key_of(n) is symbol) { return ø }
	if value_of(n) is ø or is_empty_list(value_of(n)) or bracket_of(value_of(n)) == "[" { return name_of(key_of(n)) }
	ø
}
# `xs = xs + e`, `xs += e` of e not mentioning xs: the name xs, else ø
self_append_name(n: Node): text? := {
	if not (type(n) is key and key_of(n) is symbol) { return ø }
	name = name_of(key_of(n))
	sum = value_of(n)
	if op_of(n) == Op.AddAssign and not mentions(sum, name) { return name }
	if op_of(n) != Op.Assign or not (is_key(sum, Op.Add) and key_of(sum) == key_of(n)) { return ø }
	if mentions(value_of(sum), name) { return ø }
	name
}
# whether n mentions the local name only in appends to it
appends_only(n: Node, name: text): bool := {
	if self_append_name(n) == name { return yes }
	if n is symbol { return name_of(n) != name }
	if type(n) is key { return appends_only(key_of(n), name) and appends_only(value_of(n), name) }
	if is_group(n) { for x in n { if not appends_only(x, name) { return no } } }
	yes
}
