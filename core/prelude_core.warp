# The prelude's core part (decision core-takes-what-it-uses, card baked-lib-split): the prelude words and aliases the
# compiler itself is written with, so its build reads nothing of lib/. Every program's prelude is this text before
# lib/prelude.warp (core/passes/library.warp std_module_text), the compiler's own too
// the first element, combined with every later one in turn: `[3, 1, 2].reduce((a, b) => a + b)` is 6
reduce(xs: list, f: function) := {
	if count(xs) == 0 { raise "reduce of an empty list" }
	combined = xs#1
	for i in 2 to count(xs) { combined = f(combined, xs#i) }
	combined
}
// a class place's refusal (decision class-types-checked, extensions/conversions.warp argument_conversion):
// `f takes a Length, not 5s (a Time)`
place_refused(value, taker: text, needed: text) := raise taker + " takes " + with_article(needed) + ", not " + value + " (" + with_article(type(value).name) + ")"
// `a word`, `an item`: the word after its indefinite article (the compiler's messages too)
with_article(word: text): text := (if "AEIOUaeiou".contains(word#1) then "an " else "a ") + word
// whether an instance or a map has every one of the fields, as a class extending none takes it
has_fields(value, names: list): bool := names.all(name => value.has(name))
last(xs: list or text) := xs#(count(xs))
find(t: text, part: text) := count(split(t, present_part(t, part))#1) + 1
present_part(t: text, part: text) := { if not (part in t) { raise "ValueError: \"" + part + "\" is not in \"" + t + "\"" }; part }
// the sum of the items, a fold like any other: a program's own sum replaces it (the Rust compiler still expands its
// own sum: rust-harness:src/lowering/words/library_words.rs)
// `list or number`, not `list`: a list parameter gets the items as a $list, so a range would make all of them first;
// not `any`, which takes a yes/no: `sum xs == 3` would be sum(xs == 3) (card xs-sum). Of one number that number, as max
// A list sums from its first item, so a class's own + adds its items (decision class-operators-generic):
// `sum([5km, 1500m])` is 6.5km; an empty list sums to 0
sum(xs: list or number) := if is_range(xs) then range_sum(xs) else if xs is number then xs else if count(xs) == 0 then 0 else fold(xs[1 ..], xs#1, +)
// the UTF-8 bytes of a text, `t.bytes` (decision text-unit-plurals)
bytes(t: text) := (0..byte_size(t)).map(at => byte_at(t, at))
// `for byte in t` (decision loop-variable): the value walked by that unit when its type has one, a text's bytes,
// chars or code points, a map's [key, value] pairs; else by its own items, a map's keys, a list's items (a list of bytes
// stays one), so the loop needs no type at the sugar
walked_by(value: any, unit: text): list := {
	if value is text { return if unit == "bytes" then bytes(value) else if unit == "codepoints" then code_point_list(value) else chars(value) }
	if value is map { return if unit == "pairs" then map_keys(value).map(key => [key, value[key]]) else map_keys(value) }
	value
}
replace(t, old, with new) := join(split(t, old), new)
// ASCII character tests; a character compares by its code point
is_digit(c) := c >= '0' and c <= '9'
is_digit(c: codepoint): bool := c >= '0' and c <= '9'
is_alpha(c) := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
is_alphanumeric(c) := is_alpha(c) or is_digit(c)
is_space(c) := c == ' ' or c == '\t' or c == '\n' or c == '\r'
// the day number of a proleptic Gregorian date
days_from_civil(year: int, month: int, day: int): int := {
	march_year = if month <= 2 then year - 1 else year
	era = march_year /! 400
	year_of_era = march_year - era * 400
	march_month = if month > 2 then month - 3 else month + 9
	day_of_year = (153 * march_month + 2) /! 5 + day - 1
	era * 146097 + year_of_era * 365 + year_of_era /! 4 - year_of_era /! 100 + day_of_year - 719468
}
// the compiler's spellings (wiki/alias.md)
alias keys => map_keys
alias values => map_values
alias contains => collection_contains
alias has => collection_contains
alias get => map_get_or
alias index_of => collection_position
alias codepoints => code_point_list
alias str => text
alias size => count
alias len => count
alias length => count
alias sorted => sort
