# Primitive mode (extension, decision primitive-annotation, notes/primitive.md): code marked `@primitive` is emitted as
# plain MVP wasm, no GC types, no runtime words, no exceptions, so wasm2c and cc make it a native program. A file
# whose first line is `@primitive` builds so whole: its definitions become exported functions, its other statements
# `main`. Values are the FFI types (D16) plus pointer; a form the mode cannot emit is refused at its line.
PRIMITIVE_ATTRIBUTE = "primitive"
PRIMITIVE_MARK = "@" + PRIMITIVE_ATTRIBUTE
# `@primitive f(…) := …` in a GC program: plain_node notes the name it marks (walk.warp read_attributes)

# a primitive type: the wasm value type it is held as, whether it is signed, its width in memory in bytes
class Scalar { wasm: text; signed: bool; width: int }
signed_byte = Scalar("i32", yes, 1)
unsigned_byte = Scalar("i32", no, 1)
signed_short = Scalar("i32", yes, 2)
unsigned_short = Scalar("i32", no, 2)
signed_word = Scalar("i32", yes, 4)
unsigned_word = Scalar("i32", no, 4)
signed_long = Scalar("i64", yes, 8)
unsigned_long = Scalar("i64", no, 8)
single_float = Scalar("f32", yes, 4)
double_float = Scalar("f64", yes, 8)
# each type word and its scalar (decision primitive-int-width): `int` is warp's 64-bit int here too, and so is an
# untyped int literal; 32 bits are spelled `i32` (C's 32-bit int is only a foreign line's reading)
scalars = {i8: signed_byte, int8: signed_byte, u8: unsigned_byte, uint8: unsigned_byte, byte: unsigned_byte,
	bool: unsigned_byte, i16: signed_short, int16: signed_short, u16: unsigned_short, uint16: unsigned_short,
	i32: signed_word, int32: signed_word, u32: unsigned_word, uint32: unsigned_word, char: unsigned_word,
	pointer: unsigned_word, handle: unsigned_long, i64: signed_long, int64: signed_long, int: signed_long, long: signed_long,
	u64: unsigned_long, uint64: unsigned_long, f32: single_float, float32: single_float, f64: double_float,
	float: double_float, double: double_float, number: double_float}
NO_VALUE = ""
INT_TYPE = "int"
FLOAT_TYPE = "float"
BOOL_TYPE = "bool"
# the types a GC program's ints and floats cross into primitive code as
BOUNDARY_INT = "i64"
BOUNDARY_FLOAT = "f64"

# per wasm value type: its byte in a signature, its const opcode, the first of its comparisons and of its arithmetic
value_bytes = {i32: 127, i64: 126, f32: 125, f64: 124}
const_codes = {i32: 65, i64: 66, f32: 67, f64: 68}
comparison_codes = {i32: 70, i64: 81, f32: 91, f64: 97}
arithmetic_codes = {i32: 106, i64: 124, f32: 146, f64: 160}
eqz_codes = {i32: 69, i64: 80}
# an operation's place after its type's first code; an integer's unsigned twin is the next code
integer_comparisons = {eq: 0, ne: 1, lt: 2, gt: 4, le: 6, ge: 8}
float_comparisons = {eq: 0, ne: 1, lt: 2, gt: 3, le: 4, ge: 5}
integer_arithmetic = {add: 0, sub: 1, mul: 2, div: 3, rem: 5, and: 7, or: 8, xor: 9, shl: 10, shr: 11}
float_arithmetic = {add: 0, sub: 1, mul: 2, div: 3}
unsigned_twins = ["lt", "gt", "le", "ge", "div", "rem", "shr"]
# a conversion between wasm value types: [from, to] → [signed opcode, unsigned opcode]
conversion_codes = {"i64 i32": [167, 167], "i32 i64": [172, 173], "f32 i32": [168, 169], "f64 i32": [170, 171],
	"f32 i64": [174, 175], "f64 i64": [176, 177], "i32 f32": [178, 179], "i64 f32": [180, 181], "f64 f32": [182, 182],
	"i32 f64": [183, 184], "i64 f64": [185, 186], "f32 f64": [187, 187]}
MEMORY_PAGES = 16
# a struct value is the address of its fields in linear memory, taken from a bump arena that starts behind the data of
# the text literals (address 0 stays the null pointer); its fields laid out as C does, each at a multiple of its width
POINTER_TYPE = "pointer"
DATA_START = 16
# each struct taken from the arena starts at a multiple of the widest scalar
ARENA_ALIGNMENT = 8
ARENA_TOP = 0
# the arena's top exported, so a native build's C glue takes a C function's text result from it too
ARENA_EXPORT = "arena"
# per wasm value type and width in memory: the load opcode [signed, unsigned] and the store opcode
load_codes = {"i32 1": [44, 45], "i32 2": [46, 47], "i32 4": [40, 40], "i64 8": [41, 41], "f32 4": [42, 42], "f64 8": [43, 43]}
store_codes = {"i32 1": 58, "i32 2": 59, "i32 4": 54, "i64 8": 55, "f32 4": 56, "f64 8": 57}
alignment_exponents = {1: 0, 2: 1, 4: 2, 8: 3}
global_get = 35
global_set = 36
import_function_kind = 0
# a text is the address of its (address, length) pair, the $String layout of the host edge: a WASI iovec as it is
TEXT_TYPE = "text"
text_layout = StructLayout({address: [0, POINTER_TYPE], length: [4, "u32"]}, 8)
# a C pointer outside the module's memory, held as an id (a C function's `FILE *`, getenv's result before it is copied)
HANDLE_TYPE = "handle"
# the library of the WASI calls; any other library of a foreign line is C's, which a native build links
WASI_LIBRARY = "wasi_snapshot_preview1"
# a C type of a catalog line (c_imports.warp c_type_words) → the primitive type it is held as; the others (out, bytes,
# length, owned_text) primitive mode cannot pass yet
c_primitive_types = {i32: "i32", bool: BOOL_TYPE, i64: "i64", f64: "f64", f32: "f32", text: TEXT_TYPE, handle: HANDLE_TYPE, void: NO_VALUE}
# `allocate(bytes)`: an address of that many bytes taken from the arena
ALLOCATE_WORD = "allocate"
# the code of primitive files: lib/primitive.warp, their prelude, its words reached as the GC prelude's are
PRIMITIVE_PRELUDE = module_source("primitive")

class PrimitiveCode { type: text; code: list }
# a primitive function: its parameters' names and types, its result type ("" none, ø not yet known), its locals by
# name (index and type), the blocks around the code read now and each enclosing loop's exit depth
# an imported one names its library, a function of the module none
class PrimitiveFunction { name: text; parameters: list; types: list; result: any; body: Node; index: int; library: text = ""; locals: map = {}; local_types: list = []; depth: int = 0; exits: list = []; scratch: int = 0; code: any = ø; emitting: bool = no }

# a struct: each field's [offset, type] and its size, a multiple of its widest field
class StructLayout { fields: map; size: int }

global primitive_functions = {}
# whether primitive functions are compiled into a GC program (else a primitive file is the module)
global primitive_hosted = no
global primitive_structs = {}
global primitive_place = ""
# the bytes of the text literals from DATA_START on, and each text's address there
global primitive_data = []
global text_addresses = {}
# whether the module is compiled for a native build (commands.warp build_native), the only one that answers C calls:
# warp's own host would answer them with its GC conventions, wrongly
global native_build = no

# a source whose first line, after a `#!` line, is the mark builds whole in primitive mode
is_primitive_file(source: text): bool := mark_line(source.split("\n")) != ø
mark_line(lines: list): int? := {
	first = if lines#1.starts_with("#!") and #lines > 1 then 2 else 1
	if lines#first.trim() == PRIMITIVE_MARK then first else ø
}

# the MVP wasm module of a primitive file: the mark's line left empty, so lines keep their numbers; lowered with the
# primitive prelude instead of the GC one
primitive_module(source: text, folder: text): list := {
	lines = source.split("\n")
	lines[mark_line(lines) - 1] = ""
	c_functions = c_imported(lines)
	program = lowered_program(lines.join("\n"), folder, PRIMITIVE_PRELUDE)
	primitive_functions = {}
	primitive_hosted = no
	primitive_structs = {text: text_layout}
	primitive_data = []
	text_addresses = {}
	statements = statements_in(program)
	# the prelude's imports and structs as declared, which no reach brings in; the imports first, as wasm numbers them
	declarations = statements_in(plain_node(parsed(PRIMITIVE_PRELUDE))) + statements
	for n in declarations {
		if struct_declared(n) { declare_struct(n) }
		if foreign_import(n) != ø { declare_import(foreign_import(n)) }
	}
	for imported in c_functions { declare_c_function(imported#1, imported#2) }
	main_statements = []
	for n in statements.filter(n => not struct_declared(n) and foreign_import(n) == ø) {
		head = function_head(n)
		if head == ø { main_statements += [n] } else if not forwards_to_library(name_of(head#1), value_of(n)) { declare_primitive(head, value_of(n)) }
	}
	main = PrimitiveFunction("main", [], [], ø, List(main_statements, Bracket.Curly, Separator.Semicolon), #primitive_functions)
	primitive_functions["main"] = main
	functions = primitive_functions.keys.map(name => primitive_functions[name])
	for f in functions { emit_primitive(f) }
	primitive_bytes(functions)
}

# `add·list·any(value·1: list, value·2: any) := {add(value·1, value·2)}`, the variant arity_overloads.warp makes of a
# library word beside a definition of the file: primitive code reaches no library word, so it is left out (a call of
# it is refused as any unknown call)
forwards_to_library(name: text, body: Node): bool := {
	word = written_name(name)
	call = if is_group(body) and bracket_of(body) == "{" and #body == 1 then body#1 else body
	word != name and is_group(call) and #call > 0 and call#1 == symbol(word)
}
# the name a definition is written with, `add` of its typed variant `add·i32·i32`
written_name(name: text): text := name.split("·")#1
# a function's export: its written name, unless several of its variants are exported
export_name(f: PrimitiveFunction): text := {
	word = written_name(f.name)
	if #primitive_functions.keys.filter(name => written_name(name) == word) == 1 then word else f.name
}

# `fd_write(fd: i32, pieces: pointer, count: i32, written: pointer): i32 from 'wasi_snapshot_preview1'`: [the head, its
# result type node or ø, the library]; ø for any other statement
foreign_import(n: Node): any := {
	if not (is_group(n) and bracket_of(n) == "" and #n == 3 and n#2 == symbol("from") and n#3 is text) { return ø }
	head = n#1
	if is_key(head, Op.Colon) then [key_of(head), value_of(head), "" + n#3] else [head, ø, "" + n#3]
}
declare_import(foreign: list) := {
	head = items_of(foreign#1)
	parameters = head[1 ..< #head]
	result = if foreign#2 == ø then NO_VALUE else primitive_type_name(foreign#2)
	name = name_of(head#1)
	primitive_functions[name] = PrimitiveFunction(name, parameters.map(p => name_of(key_of(p))), parameters.map(p => primitive_parameter_type(p)), result, ø, #primitive_functions, foreign#3)
}

# `import strlen from "c"`: each line of lib/c.warp or lib/math.warp it names, read as a GC program reads it
# (c_imports.warp c_functions_of), as [declaration, line number]; the statement's line left empty
c_imported(lines: list): list := {
	catalog = c_catalog(run_library(), [])
	found = []
	for i in 0..#lines {
		imported = c_import(lines#(i + 1).trim())
		if imported != ø {
			for name in imported#2 {
				lines_of_name = catalog.filter(d => d#1 == name and (d#2 == imported#1 or (imported#1 in c_and_m and d#2 in c_and_m)))
				if #lines_of_name == 0 { throw "primitive mode cannot emit `import " + name + "`: no line of lib/c.warp or lib/math.warp declares it from '" + imported#1 + "'" + place_text([i + 1, 1], module.program_file) }
				found += [[lines_of_name#1, i + 1]]
			}
			lines[i] = ""
		}
	}
	found
}
# a catalog line's [name, library, parameter types, parameter names, result type] as an import of the module
declare_c_function(d: list, line: int) := {
	if not native_build { throw "primitive mode cannot emit " + d#1 + " from '" + d#2 + "' but in a native build: a primitive file's C calls run by `warp build native`" + place_text([line, 1], module.program_file) }
	refused = (d#3 + [d#5]).filter(type => type not in c_primitive_types)
	if #refused > 0 { throw "primitive mode cannot emit " + d#1 + "'s " + refused#1 + place_text([line, 1], module.program_file) }
	primitive_functions[d#1] = PrimitiveFunction(d#1, d#4, d#3.map(type => c_primitive_types[type]), c_primitive_types[d#5], ø, #primitive_functions, d#2)
}

declare_primitive(head: list, body: Node) := {
	name = name_of(head#1)
	parameters = head[1 ..< #head]
	types = parameters.map(p => primitive_parameter_type(p))
	f = PrimitiveFunction(name, parameters.map(p => name_of(key_of(p))), types, primitive_result(body), giving_body(body), #primitive_functions)
	primitive_functions[name] = f
}
# `struct Header { len: u32; tag: u8 }` (or `class`), which the passes leave as the opaque view ["type", name, body]:
# its fields' [offset, type] laid out
struct_declared(n: Node): bool := declares_type(n)
declare_struct(n: Node) := {
	view = value_of(n)
	fields = {}
	end = 0
	widest = 1
	for field in view#3[3..] {
		if kind_of(field) != "key" or field#2 != ":" { primitive_refusal(n, "a struct field without a primitive type: write `len: u32`") }
		type = primitive_type_name(symbol(type_name_of(field#4)))
		width = mvp_scalar(type).width
		end = aligned(end, width)
		fields[field#3#2] = [end, type]
		end += width
		widest = max(widest, width)
	}
	primitive_structs[struct_name(view#2)] = StructLayout(fields, aligned(end, widest))
}
# the name of a declaration, under its attribute layers (`class` marks it bare_class)
struct_name(name: any): text := if kind_of(name) == "attribute" then struct_name(name#4) else name#2
# widths are powers of two
aligned(offset: int, width: int): int := bit_and(offset + width - 1, -width)

primitive_parameter_type(p: Node): text := {
	if not is_key(p, Op.Colon) { primitive_refusal(p, "a parameter without a primitive type: write `x: i32`") }
	primitive_type_name(value_of(p))
}
# a scalar or a struct of the file
primitive_type_name(n: Node): text := {
	if n is symbol and (name_of(n) in scalars or name_of(n) in primitive_structs) { return name_of(n) }
	primitive_refusal(n, "the type " + form_of(n) + ", not a primitive type (" + scalars.keys.join(", ") + ") or a struct of the file")
}
# `f(x): T := e` comes lowered as `{the result: T = e; the result}`: T, "" for `nothing` (a foreign line's word for no
# value); else ø, known once the body is read
primitive_result(body: Node): any := {
	declaration = result_declaration(body)
	if declaration == ø { return ø }
	declared = value_of(key_of(declaration))
	if declared == ø or (declared is symbol and name_of(declared) in nothing_words) { return NO_VALUE }
	primitive_type_name(declared)
}
# (the passes leave `: nothing` as ø)
nothing_words = ["nothing", "void"]
# `the result: T = e`, else ø
result_declaration(body: Node): any := {
	first = if is_group(body) and #body > 0 then body#1 else ø
	if first != ø and is_key(first, Op.Assign) and is_key(key_of(first), Op.Colon) and key_of(key_of(first)) == symbol("the result") then first else ø
}
# the body to emit: e of a function giving nothing, whose value is dropped, else the body
giving_body(body: Node): Node := if primitive_result(body) == NO_VALUE then value_of(body#1) else body

primitive_refusal(n: Node, why: text) := {
	at = written_at(n)
	place = if at then place_text(at, module.program_file) else primitive_place
	throw "primitive mode cannot emit " + why + place
}

# the function's code, its result type once read
emit_primitive(f: PrimitiveFunction) := {
	if f.code != ø or f.library { return }
	f.emitting = yes
	for i in 0..#f.parameters { mvp_local_of(f, f.parameters#(i + 1), f.types#(i + 1)) }
	body = mvp_emitted(f, f.body, f.result ?? "")
	if f.result == ø { f.result = body.type }
	f.code = if f.result == NO_VALUE and body.type != NO_VALUE then body.code + [op.drop] else mvp_converted(body, f.result, f.body).code
	f.emitting = no
}
# a function's result type, its body read first when not declared
mvp_result_of(f: PrimitiveFunction, call: Node): text := {
	if f.result != ø { return f.result }
	if f.emitting { primitive_refusal(call, "the call of " + f.name + " in its own body before its result type is known: declare `" + f.name + "(…): T`") }
	emit_primitive(f)
	f.result
}

mvp_local_of(f: PrimitiveFunction, name: text, type: text): int := {
	if name not in f.locals {
		f.locals[name] = [#f.locals, type]
		f.local_types += [type]
	}
	f.locals[name]#1
}

# a struct is held as its address, a pointer
mvp_scalar(type: text): Scalar := scalars.get(type) ?? scalars[POINTER_TYPE]
mvp_wasm_of(type: text): text := mvp_scalar(type).wasm
mvp_is_float(type: text): bool := mvp_wasm_of(type).starts_with("f")

# n's code; `expected` the type an untyped literal takes, "" for none
mvp_emitted(f: PrimitiveFunction, n: Node, expected: text): PrimitiveCode := {
	at = written_at(n)
	if at { primitive_place = place_text(at, module.program_file) }
	if n is int or n is float { return mvp_literal(n, expected) }
	if n === ø { return PrimitiveCode(NO_VALUE, []) }
	if n is text { return PrimitiveCode(TEXT_TYPE, [op.i32_const] + sleb(text_address(n))) }
	if n == true or n == false { return PrimitiveCode(BOOL_TYPE, [op.i32_const, if n == true then 1 else 0]) }
	if n is symbol { return mvp_variable(f, n) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in primitive_structs { return mvp_constructed(f, name_of(n#1), items_of(n)[1 ..< #n], n) }
	if is_group(n) and bracket_of(n) == "(" and #n == 2 and n#1 == symbol(ALLOCATE_WORD) and primitive_callee(ALLOCATE_WORD) == ø { return PrimitiveCode(POINTER_TYPE, arena_taken(mvp_typed(f, n#2, "i32"))) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and primitive_callee(name_of(n#1)) != ø { return mvp_call(f, n#1, items_of(n)[1 ..< #n], n) }
	if is_group(n) and bracket_of(n) == "(" and #n > 1 and n#1 is symbol and name_of(n#1) not in f.locals { primitive_refusal(n, form_of(n) + ", not a primitive function: primitive code calls only primitive code") }
	if is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n > 1 and n#1 is symbol { return mvp_spaced(f, n) }
	if is_group(n) and (bracket_of(n) == "{" or bracket_of(n) == "" or bracket_of(n) == "(") { return mvp_block(f, items_of(n), expected) }
	match n {
		Key(left, operator, right): mvp_keyed(f, left, operator, right, n, expected)
		_: primitive_refusal(n, form_of(n))
	}
}

mvp_literal(n: Node, expected: text): PrimitiveCode := {
	type = if expected and (n is int or mvp_is_float(expected)) then expected else if n is int then INT_TYPE else FLOAT_TYPE
	wasm = mvp_wasm_of(type)
	bytes = match wasm {
		"f64": le64(float_bits(n * 1.0))
		"f32": le64(float_bits(n * 1.0)) + [conversion_codes["f64 f32"]#1]
		_: sleb(n)
	}
	PrimitiveCode(type, [const_codes[if wasm == "f32" then "f64" else wasm]] + bytes)
}

mvp_variable(f: PrimitiveFunction, n: Node): PrimitiveCode := {
	name = name_of(n)
	if name == "break" { return mvp_breaking(f, n) }
	if name not in f.locals { primitive_refusal(n, "the unknown name " + name) }
	PrimitiveCode(f.locals[name]#2, [op.local_get] + uleb(f.locals[name]#1))
}

# `fib 30`, `return x`
mvp_spaced(f: PrimitiveFunction, n: Node): PrimitiveCode := {
	head = name_of(n#1)
	rest = items_of(n)[1 ..< #n]
	if head == "return" {
		value = mvp_emitted(f, if #rest == 1 then rest#1 else List(rest, Bracket.None, Separator.Space), f.result ?? "")
		return PrimitiveCode(NO_VALUE, mvp_converted(value, f.result ?? value.type, n).code + [op.return])
	}
	if primitive_callee(head) != ø { return mvp_call(f, n#1, rest, n) }
	primitive_refusal(n, form_of(n))
}

mvp_call(f: PrimitiveFunction, callee: Node, arguments: list, n: Node): PrimitiveCode := {
	g = primitive_callee(name_of(callee))
	if #arguments != #g.types { primitive_refusal(n, g.name + " with " + #arguments + " arguments, it takes " + #g.types) }
	code = []
	for i in 0..#arguments { code += mvp_typed(f, arguments#(i + 1), g.types#(i + 1)) }
	PrimitiveCode(mvp_result_of(g, n), code + call_code(g.index))
}

# n's code as a `type`
mvp_typed(f: PrimitiveFunction, n: Node, type: text): list := mvp_converted(mvp_emitted(f, n, type), type, n).code

# a value widened to `type` (an int into a wider int or float, f32 into f64), the same wasm type as it is; a narrowing
# needs `as`
mvp_converted(value: PrimitiveCode, type: text, n: Node): PrimitiveCode := {
	if type == "" or value.type == type { return value }
	if value.type == NO_VALUE { primitive_refusal(n, "a statement where " + type + " is wanted") }
	if value.type in primitive_structs or type in primitive_structs {
		if value.type == POINTER_TYPE or type == POINTER_TYPE { return PrimitiveCode(type, value.code) }
		primitive_refusal(n, value.type + " where " + type + " is wanted")
	}
	if mvp_widens(value.type, type) or (mvp_wasm_of(value.type) == mvp_wasm_of(type) and mvp_scalar(value.type).width == mvp_scalar(type).width) { return mvp_cast(value, type) }
	primitive_refusal(n, value.type + " where " + type + " is wanted: convert it, `x as " + type + "`")
}
mvp_widens(from: text, to: text): bool := mvp_scalar(from).width < mvp_scalar(to).width and (mvp_is_float(to) or not mvp_is_float(from))
mvp_cast(value: PrimitiveCode, type: text): PrimitiveCode := {
	from = mvp_wasm_of(value.type)
	to = mvp_wasm_of(type)
	codes = conversion_codes.get(from + " " + to)
	converted = if codes == ø then value.code else value.code + [if mvp_scalar(value.type).signed then codes#1 else codes#2]
	PrimitiveCode(type, converted + narrowed(type, mvp_scalar(value.type).width))
}
# an i32 cut to a narrower type's bits: masked when unsigned, its sign spread back when signed
narrowed(type: text, from_width: int): list := {
	scalar = mvp_scalar(type)
	if scalar.wasm != "i32" or scalar.width >= 4 or scalar.width >= from_width { return [] }
	bits = 8 * scalar.width
	if not scalar.signed { return [op.i32_const] + sleb((1 << bits) - 1) + [op.i32_and] }
	shift = [op.i32_const] + sleb(32 - bits)
	shift + [arithmetic_codes.i32 + integer_arithmetic.shl] + shift + [arithmetic_codes.i32 + integer_arithmetic.shr]
}

mvp_block(f: PrimitiveFunction, statements: list, expected: text): PrimitiveCode := {
	code = []
	last = PrimitiveCode(NO_VALUE, [])
	for i in 0..#statements {
		value = mvp_emitted(f, statements#(i + 1), if i == #statements - 1 then expected else "")
		code += value.code
		if i < #statements - 1 and value.type != NO_VALUE { code += [op.drop] }
		last = value
	}
	PrimitiveCode(last.type, code)
}

mvp_keyed(f: PrimitiveFunction, left: Node, operator: Op, right: Node, n: Node, expected: text): PrimitiveCode := {
	if operator == Op.Assign { return mvp_assigned(f, left, right, n) }
	if operator == Op.Colon { return mvp_declared(f, left, right, n) }
	if operator == Op.Then or operator == Op.Else { return mvp_conditional(f, n, expected) }
	if operator == Op.Do and is_key(left, Op.While) { return mvp_looped(f, value_of(left), right) }
	if operator == Op.Dot { return mvp_field_read(f, left, right) }
	if operator == Op.As { return mvp_cast_as(f, left, right) }
	if operator == Op.And or operator == Op.Or { return mvp_logical(f, left, operator, right) }
	if operator == Op.Not { return PrimitiveCode(BOOL_TYPE, mvp_condition(f, right) + [op.i32_eqz]) }
	if operator == Op.Sub and left === ø { return mvp_arithmetic(f, Key(0, Op.Sub, right), "sub", expected) }
	if operator == Op.Inc or operator == Op.Dec { return mvp_assigned(f, left, Key(left, if operator == Op.Inc then Op.Add else Op.Sub, 1), n) }
	operation = mvp_operation_of(operator)
	if operation in integer_comparisons { return mvp_compared(f, left, operation, right) }
	if operation in integer_arithmetic { return mvp_arithmetic(f, n, operation, expected) }
	assigning = mvp_assigned_operation(operator)
	if assigning != ø { return mvp_assigned(f, left, Key(left, assigning, right), n) }
	primitive_refusal(n, form_of(n))
}

mvp_operation_of(op: Op): text := match op {
	Op.Add: "add"
	Op.Sub: "sub"
	Op.Mul: "mul"
	Op.Div: "div"
	Op.FloorDiv: "div"
	Op.Mod: "rem"
	Op.Rem: "rem"
	Op.BitAnd: "and"
	Op.BitOr: "or"
	Op.Xor: "xor"
	Op.Shl: "shl"
	Op.Shr: "shr"
	Op.Lt: "lt"
	Op.Gt: "gt"
	Op.Le: "le"
	Op.Ge: "ge"
	Op.Eq: "eq"
	Op.Is: "eq"
	Op.Ne: "ne"
	_: ""
}
mvp_assigned_operation(op: Op): any := match op {
	Op.AddAssign: Op.Add
	Op.SubAssign: Op.Sub
	Op.MulAssign: Op.Mul
	Op.DivAssign: Op.Div
	Op.ModAssign: Op.Mod
	Op.AndAssign: Op.BitAnd
	Op.OrAssign: Op.BitOr
	Op.XorAssign: Op.Xor
	_: ø
}

# `x = e`: a new local of e's type, else e as the local's type
mvp_assigned(f: PrimitiveFunction, target: Node, value: Node, n: Node): PrimitiveCode := {
	if is_key(target, Op.Colon) { return mvp_declared(f, key_of(target), value_of(target), n, value) }
	if is_key(target, Op.Dot) { return mvp_field_written(f, key_of(target), value_of(target), value) }
	if not (target is symbol) { primitive_refusal(n, "an assignment to " + form_of(target)) }
	name = name_of(target)
	if name in f.locals { return PrimitiveCode(NO_VALUE, mvp_typed(f, value, f.locals[name]#2) + [op.local_set] + uleb(f.locals[name]#1)) }
	given = mvp_emitted(f, value, "")
	if given.type == NO_VALUE { primitive_refusal(n, "an assignment of a statement") }
	PrimitiveCode(NO_VALUE, given.code + [op.local_set] + uleb(mvp_local_of(f, name, given.type)))
}
# `x: T = e`, `x: T` (0); a label of a statement, `loop·step: i++`, is the statement
mvp_declared(f: PrimitiveFunction, target: Node, type: Node, n: Node, value: Node = 0): PrimitiveCode := {
	if not (type is symbol and name_of(type) in scalars) and is_key(n, Op.Colon) { return mvp_emitted(f, type, "") }
	if not (target is symbol) { primitive_refusal(n, "a declaration of " + form_of(target)) }
	written = primitive_type_name(type)
	index = mvp_local_of(f, name_of(target), written)
	PrimitiveCode(NO_VALUE, mvp_typed(f, value, written) + [op.local_set] + uleb(index))
}

# both operands as the type of the typed one, the wider one of two when one widens to the other
mvp_operand_type(f: PrimitiveFunction, left: Node, right: Node, expected: text): text := {
	literal = (left is int or left is float)
	if not literal and not (right is int or right is float) { return mvp_wider(mvp_emitted_type(f, left), mvp_emitted_type(f, right)) }
	if not literal { return mvp_emitted_type(f, left) }
	if not (right is int or right is float) { return mvp_emitted_type(f, right) }
	if expected and expected != BOOL_TYPE then expected else if left is float or right is float then FLOAT_TYPE else INT_TYPE
}
mvp_wider(a: text, b: text): text := if mvp_widens(a, b) then b else a
# the type of n's value, its code thrown away (a local it declares stays declared)
mvp_emitted_type(f: PrimitiveFunction, n: Node): text := mvp_emitted(f, n, "").type

mvp_arithmetic(f: PrimitiveFunction, n: Node, operation: text, expected: text): PrimitiveCode := {
	type = mvp_operand_type(f, key_of(n), value_of(n), expected)
	if type == BOOL_TYPE and operation in ["and", "or", "xor"] { type = BOOL_TYPE }
	table = if mvp_is_float(type) then float_arithmetic else integer_arithmetic
	if operation not in table { primitive_refusal(n, "`" + operation + "` of " + type + "s") }
	code = mvp_typed(f, key_of(n), type) + mvp_typed(f, value_of(n), type)
	PrimitiveCode(type, code + [mvp_operation_code(arithmetic_codes, table, operation, type)])
}
mvp_compared(f: PrimitiveFunction, left: Node, operation: text, right: Node): PrimitiveCode := {
	type = mvp_operand_type(f, left, right, "")
	table = if mvp_is_float(type) then float_comparisons else integer_comparisons
	code = mvp_typed(f, left, type) + mvp_typed(f, right, type)
	PrimitiveCode(BOOL_TYPE, code + [mvp_operation_code(comparison_codes, table, operation, type)])
}
mvp_operation_code(first_codes: map, table: map, operation: text, type: text): int := {
	twin = if not mvp_is_float(type) and not mvp_scalar(type).signed and operation in unsigned_twins then 1 else 0
	first_codes[mvp_wasm_of(type)] + table[operation] + twin
}

# a test's code, an i32 that is 0 for no: an int is yes when not 0
mvp_condition(f: PrimitiveFunction, test: Node): list := {
	value = mvp_emitted(f, test, BOOL_TYPE)
	if value.type == NO_VALUE or mvp_is_float(value.type) { primitive_refusal(test, "a test of a " + (value.type or "statement")) }
	if mvp_wasm_of(value.type) == "i32" { return value.code }
	value.code + [eqz_codes.i64, op.i32_eqz]
}
mvp_logical(f: PrimitiveFunction, left: Node, operator: Op, right: Node): PrimitiveCode := {
	a = mvp_condition(f, left)
	f.depth += 1
	b = mvp_condition(f, right)
	f.depth -= 1
	bool_byte = value_bytes.i32
	code = if operator == Op.And then a + [op.if, bool_byte] + b + [op.else, op.i32_const, 0, op.end] else a + [op.if, bool_byte, op.i32_const, 1, op.else] + b + [op.end]
	PrimitiveCode(BOOL_TYPE, code)
}

# `if c then a else b` lowered as Key(Key(Key(ø, If, c), Then, a), Else, b); without `else` it gives no value
mvp_conditional(f: PrimitiveFunction, n: Node, expected: text): PrimitiveCode := {
	otherwise = if is_key(n, Op.Else) then value_of(n) else ø
	then_part = if is_key(n, Op.Else) then key_of(n) else n
	if not (is_key(then_part, Op.Then) and is_key(key_of(then_part), Op.If)) { primitive_refusal(n, form_of(n)) }
	test = mvp_condition(f, value_of(key_of(then_part)))
	f.depth += 1
	yes_value = mvp_emitted(f, value_of(then_part), if otherwise == ø then "" else expected)
	type = if otherwise == ø then NO_VALUE else yes_value.type
	yes_code = if otherwise == ø and yes_value.type != NO_VALUE then yes_value.code + [op.drop] else yes_value.code
	no_code = if otherwise == ø then [] else [op.else] + mvp_typed(f, otherwise, type)
	f.depth -= 1
	block_type = if type == NO_VALUE then no_value else value_bytes[mvp_wasm_of(type)]
	PrimitiveCode(type, test + [op.if, block_type] + yes_code + no_code + [op.end])
}

# `while c do body`: block { loop { if not c break; body; continue } }
mvp_looped(f: PrimitiveFunction, test: Node, body: Node): PrimitiveCode := {
	f.depth += 1
	f.exits += [f.depth]
	f.depth += 1
	stop = mvp_condition(f, test) + [op.i32_eqz, op.br_if, 1]
	steps = mvp_block(f, if is_group(body) then items_of(body) else [body], "")
	dropped = if steps.type == NO_VALUE then [] else [op.drop]
	f.depth -= 2
	f.exits = f.exits[0 ..< #f.exits - 1]
	PrimitiveCode(NO_VALUE, [op.block, no_value, op.loop, no_value] + stop + steps.code + dropped + [op.br, 0, op.end, op.end])
}
mvp_breaking(f: PrimitiveFunction, n: Node): PrimitiveCode := {
	if #f.exits == 0 { primitive_refusal(n, "a break outside a loop") }
	PrimitiveCode(NO_VALUE, [op.br] + uleb(f.depth - f.exits#(#f.exits)))
}

# `x as i32`: any number type into any other
mvp_cast_as(f: PrimitiveFunction, value: Node, type: Node): PrimitiveCode := {
	given = mvp_emitted(f, value, "")
	if given.type == NO_VALUE { primitive_refusal(value, "a statement converted") }
	mvp_cast(given, primitive_type_name(type))
}

## the module
# a type per function, the imports first; the arena's top starting behind the data of the texts
def primitive_bytes(functions: list): list {
	types = functions.map(f => [function_type_byte] + vector(f.types.map(t => [value_bytes[mvp_wasm_of(t)]])) + (if f.result == NO_VALUE then [0] else [1, value_bytes[mvp_wasm_of(f.result)]]))
	imported = functions.filter(f => f.library)
	defined = functions.filter(f => not f.library)
	imports = vector(imported.map(f => name_bytes(f.library) + name_bytes(written_name(f.name)) + [import_function_kind] + uleb(f.index)))
	declared = vector(defined.map(f => uleb(f.index)))
	memory = vector([[0] + uleb(MEMORY_PAGES)])
	arena = vector([[value_bytes.i32, 1, op.i32_const] + sleb(aligned(DATA_START + #primitive_data, ARENA_ALIGNMENT)) + [op.end]])
	exports = vector([name_bytes("memory") + [export_memory_byte, 0], name_bytes(ARENA_EXPORT) + [export_global_byte, ARENA_TOP]] + defined.map(f => name_bytes(export_name(f)) + [export_function_byte] + uleb(f.index)))
	code = vector(defined.map(primitive_body))
	data = vector([[0, op.i32_const] + sleb(DATA_START) + [op.end] + vector(primitive_data.map(b => [b]))])
	wasm_header + section(section_ids.type, vector(types)) + section(section_ids.import, imports) + section(section_ids.function, declared) + section(section_ids.memory, memory) + section(section_ids.globals, arena) + section(section_ids.export, exports) + section(section_ids.code, code) + section(section_ids.data, data)
}
def primitive_body(f: PrimitiveFunction): list {
	locals = vector(f.local_types[#f.parameters ..< #f.local_types].map(t => [1, value_bytes[mvp_wasm_of(t)]]))
	content = locals + f.code + [op.end]
	uleb(#content) + content
}

## structs
# `Header(5, 2)`, `Header(len: 5, tag: 2)`: the fields stored at an address taken from the arena
mvp_constructed(f: PrimitiveFunction, name: text, arguments: list, n: Node): PrimitiveCode := {
	layout = primitive_structs[name]
	names = layout.fields.keys
	if #arguments != #names { primitive_refusal(n, name + " with " + #arguments + " values, it has " + #names + " fields") }
	f.scratch += 1
	address = mvp_local_of(f, "·struct" + f.scratch, name)
	code = arena_taken([op.i32_const] + sleb(layout.size)) + [op.local_set] + uleb(address)
	for i in 0..#arguments {
		argument = arguments#(i + 1)
		named = is_key(argument, Op.Colon) and key_of(argument) is symbol
		field = if named then name_of(key_of(argument)) else names#(i + 1)
		if field not in layout.fields { primitive_refusal(argument, name + " has no field " + field) }
		code += [op.local_get] + uleb(address) + mvp_stored(f, layout.fields[field], if named then value_of(argument) else argument)
	}
	PrimitiveCode(name, code + [op.local_get] + uleb(address))
}
# the struct `owner` is and the field's [offset, type]
mvp_field(f: PrimitiveFunction, owner: Node, field: Node): list := {
	value = mvp_emitted(f, owner, "")
	layout = primitive_structs.get(value.type)
	if layout == ø { primitive_refusal(owner, "a field of a " + (value.type or "statement") + ", not a struct") }
	if not (field is symbol and name_of(field) in layout.fields) { primitive_refusal(field, value.type + " has no field " + form_of(field)) }
	[value.code, layout.fields[name_of(field)]]
}
mvp_field_read(f: PrimitiveFunction, owner: Node, field: Node): PrimitiveCode := {
	found = mvp_field(f, owner, field)
	type = found#2#2
	scalar = mvp_scalar(type)
	codes = load_codes[scalar.wasm + " " + scalar.width]
	PrimitiveCode(type, found#1 + [if scalar.signed then codes#1 else codes#2] + memory_argument(found#2))
}
mvp_field_written(f: PrimitiveFunction, owner: Node, field: Node, value: Node): PrimitiveCode := {
	found = mvp_field(f, owner, field)
	PrimitiveCode(NO_VALUE, found#1 + mvp_stored(f, found#2, value))
}
# with the address on the stack: the value stored into the field [offset, type]
mvp_stored(f: PrimitiveFunction, field: list, value: Node): list := {
	scalar = mvp_scalar(field#2)
	mvp_typed(f, value, field#2) + [store_codes[scalar.wasm + " " + scalar.width]] + memory_argument(field)
}
memory_argument(field: list): list := uleb(alignment_exponents[mvp_scalar(field#2).width]) + uleb(field#1)

# with the byte count `size` computes: the arena's top as the address taken, the top moved on by the count rounded up
# to ARENA_ALIGNMENT
arena_taken(size: list): list := {
	rounded = size + [op.i32_const] + sleb(ARENA_ALIGNMENT - 1) + [op.i32_add, op.i32_const] + sleb(-ARENA_ALIGNMENT) + [op.i32_and]
	[global_get, ARENA_TOP, global_get, ARENA_TOP] + rounded + [op.i32_add, global_set, ARENA_TOP]
}

# the address of a text literal's (address, length) pair in the data, its bytes in front of it; each text once
text_address(t: text): int := {
	if t not in text_addresses {
		bytes = t.bytes
		start = DATA_START + #primitive_data
		pair = aligned(start + #bytes, 4)
		primitive_data += bytes + range_list(pair - start - #bytes).map(i => 0) + le_word(start) + le_word(#bytes)
		text_addresses[t] = pair
	}
	text_addresses[t]
}
le_word(n: int): list := le64(n)[0 ..< 4]

## primitive functions in a GC program
# a function the program marks `@primitive`, called from GC code (decision primitive-annotation)
is_primitive_function(f: Function): bool := written_name(f.name) in (marked_names.get(PRIMITIVE_ATTRIBUTE) ?? [])

# a primitive function the code may call: one of the file, or in a GC program one marked, compiled at its first call
primitive_callee(name: text): any := {
	hosted = if primitive_hosted then module.functions.get(name) else ø
	if hosted != ø and hosted.kinds == ø and is_primitive_function(hosted) { compile_function(hosted, hosted.signature.parameters.map(p => ValueKind.Int)) }
	primitive_functions.get(name)
}

# f as GC code calls it, converting at the boundary like a C call: its ints come as i64 and its floats as f64, each
# wrapped to the primitive type, the result widened back; behind it the primitive function itself, `f·primitive`,
# which other primitive code calls directly
primitive_compiled(f: Function) := {
	primitive_hosted = yes
	parameters = f.signature.parameters
	types = parameters.map(p => primitive_type_name(symbol(if p.type_name then p.type_name else "?")))
	inner = added_function(f.name + "·primitive", types.map(hosted_kind), ValueKind.Int, [])
	primitive = PrimitiveFunction(f.name, parameters.map(p => p.name), types, primitive_result(f.body), giving_body(f.body), inner.index)
	primitive_functions[f.name] = primitive
	f.kinds = types.map(boundary_kind)
	f.locals = []
	f.local_names = parameters.map(p => p.name)
	emit_primitive(primitive)
	inner.result = if primitive.result == NO_VALUE then no_kind else hosted_kind(primitive.result)
	inner.code = primitive.code
	inner.locals = primitive.local_types[#types ..< #primitive.local_types].map(hosted_kind)
	inner.local_names = primitive.locals.keys
	passed = []
	for i in 0..#types { passed += mvp_cast(PrimitiveCode(boundary_type(types#(i + 1)), [op.local_get] + uleb(i)), types#(i + 1)).code }
	f.gives_nothing = primitive.result == NO_VALUE
	result = if f.gives_nothing then BOUNDARY_INT else boundary_type(primitive.result)
	f.result = if primitive.result == BOOL_TYPE then ValueKind.Bool else boundary_kind(result)
	called = passed + call_code(inner.index)
	f.code = if f.gives_nothing then called + [ref_null, gc_type(gc.node)] else mvp_cast(PrimitiveCode(primitive.result, called), if primitive.result == BOOL_TYPE then BOOL_TYPE else result).code
}
# the kind a primitive type is held as inside the GC module; f32 has none there yet
hosted_kind(type: text): ValueKind := match mvp_wasm_of(type) {
	"i32": ValueKind.I32
	"i64": ValueKind.Int
	"f64": ValueKind.Float
	_: primitive_refusal(ø, "an f32 in a primitive function of a GC program (card f32-primitive-refused)")
}
# the GC value a primitive type crosses the boundary as: an int as i64, a float as f64
boundary_type(type: text): text := if mvp_is_float(type) then BOUNDARY_FLOAT else BOUNDARY_INT
boundary_kind(type: text): ValueKind := if mvp_is_float(type) then ValueKind.Float else ValueKind.Int

## the native build's C (core/commands.warp build_native)
# the main.c of a native build: wasm2c's header of the module, lib/native/wasi.c and lib/native/foreign.c, each C
# function the module imports, the instantiation and run_main, which prints what main gives
native_main(header: text, library: text): text := {
	includes = ["<stdio.h>", "\"" + header + "\"", "\"" + library + "/native/wasi.c\"", "\"" + library + "/native/foreign.c\""]
	foreign = c_functions_imported()
	libraries = c_libraries(foreign)
	instances = ["wasi"] + libraries.map(l => "(struct " + wasm2c_name(l) + "*)wasi")
	includes.map(file => "#include " + file + "\n").join("") + libraries.map(l => "struct " + wasm2c_name(l) + " { struct " + wasm2c_name(WASI_LIBRARY) + " wasi; };\n").join("") +
		foreign.map(c_function_glue).join("") +
		"void instantiate(w2c_program* program, struct " + wasm2c_name(WASI_LIBRARY) + "* wasi) { wasm2c_program_instantiate(program, " + instances.join(", ") + "); }\n" +
		"void run_main(w2c_program* program) { " + printed_main[main_value_kind()] + " }\n"
}
c_functions_imported(): list := primitive_functions.keys.map(name => primitive_functions[name]).filter(f => f.library and f.library != WASI_LIBRARY)
# the C libraries of the imports, in the order wasm2c's instantiate takes them, which a native build links
c_libraries(foreign: list): list := {
	found = []
	for f in foreign { if f.library not in found { found += [f.library] } }
	found
}
# the C name wasm2c gives a module or an import of it: w2c_wasi__snapshot__preview1, w2c_c_getenv
wasm2c_name(module_name: text): text := "w2c_" + module_name.replace("_", "__")
# what run_main prints of each kind of value main gives
printed_main = {"": "w2c_program_main(program);", signed: "printf(\"%lld\\n\", (long long)w2c_program_main(program));",
	unsigned: "printf(\"%llu\\n\", (unsigned long long)w2c_program_main(program));", float: "printf(\"%g\\n\", (double)w2c_program_main(program));"}
main_value_kind(): text := {
	type = primitive_functions["main"].result
	if type == NO_VALUE { return "" }
	if mvp_is_float(type) then "float" else if mvp_scalar(type).signed then "signed" else "unsigned"
}
# the import wasm2c calls, which calls the C function of the process by that name (foreign.c native_function) with
# each value as C takes it: a text a NUL-terminated copy, freed after, a pointer an address in the module's memory
c_function_glue(f: PrimitiveFunction): text := {
	numbers = range_list(#f.types).map(i => i + 1)
	parameters = ["struct " + wasm2c_name(f.library) + "* library"] + numbers.map(i => wasm2c_types[mvp_wasm_of(f.types#i)] + " value" + i)
	texts = numbers.filter(i => f.types#i == TEXT_TYPE)
	arguments = numbers.map(i => c_argument(f.types#i, "value" + i, "text" + i))
	call = "function(" + arguments.join(", ") + ")"
	result = if f.result == NO_VALUE then "void" else c_type_of_primitive(f.result)
	body = ["static " + result + " (*function)(" + (if #f.types == 0 then "void" else f.types.map(c_type_of_primitive).join(", ")) + ")",
		"if (!function) function = native_function(\"" + written_name(f.name) + "\")"] +
		texts.map(i => "char* text" + i + " = native_text(&library->wasi, value" + i + ")") +
		[if f.result == NO_VALUE then call else result + " result = " + call] + texts.map(i => "free(text" + i + ")") +
		(if f.result == NO_VALUE then [] else ["return " + module_value(f.result, "result")])
	(if f.result == NO_VALUE then "void" else wasm2c_types[mvp_wasm_of(f.result)]) + " " + wasm2c_name(f.library) + "_" + written_name(f.name).replace("_", "__") +
		"(" + parameters.join(", ") + ") {\n" + body.map(line => "\t" + line + ";\n").join("") + "}\n"
}
wasm2c_types = {i32: "u32", i64: "u64", f32: "f32", f64: "f64"}
# the C type a primitive type is passed to C as
c_type_of_primitive(type: text): text := {
	if type == TEXT_TYPE { return "char*" }
	if type == POINTER_TYPE or type == HANDLE_TYPE { return "void*" }
	if type == BOOL_TYPE { return "_Bool" }
	scalar = mvp_scalar(type)
	if mvp_is_float(type) then (if scalar.width == 4 then "float" else "double") else (if scalar.signed then "int" else "uint") + scalar.width * 8 + "_t"
}
# a value of the module as C takes it
c_argument(type: text, value: text, copy: text): text := {
	if type == TEXT_TYPE { return copy }
	if type == POINTER_TYPE { return "native_address(&library->wasi, " + value + ")" }
	if type == HANDLE_TYPE { return "(void*)(uintptr_t)" + value }
	"(" + c_type_of_primitive(type) + ")" + value
}
# a C value as the module holds it: a text copied into its arena, a pointer into its memory its address there
module_value(type: text, value: text): text := {
	if type == TEXT_TYPE { return "module_text(&library->wasi, " + value + ")" }
	if type == POINTER_TYPE { return "module_address(&library->wasi, " + value + ")" }
	if type == HANDLE_TYPE { return "(u64)(uintptr_t)" + value }
	"(" + wasm2c_types[mvp_wasm_of(type)] + ")" + value
}
