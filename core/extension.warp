# What an extension registers (decision core-is-self, notes/core_extensions_roadmap.md "Hook table design"): one
# Extension row each in extensions/extensions.warp, every field but its name optional. The core names no extension: it
# knows this shape and walks the rows. Later fields join here: keyword handlers, passes. Its runtime words are
# extensions/runtime.warp's, which joins them to the extended runtime, its list kinds too.
#   operator_rows: the extension's operators, rows in lib/aliases.warp's format, its file's text (parser.warp bundled_module)
#   library_words: a program's word → the runtime word it calls (emitter runtime_words.warp library_words)
#   host_exports: runtime words every program exports under their own names, for a host (emitter host.warp)
#   constant_tables: tables whose numbers its runtime words read by name, `GpuCell.I32` (emitter.warp constant_tables)
#   atom_readers: the first character of an atom it reads → its reader, given the parser there, which reads the atom
#   and moves past it (`°C`); glued after a number or a name such an atom multiplies it, `30°`, `x°`
#   number_readers: functions reading a number form at a digit (`0xff`, `2024-01-31`), each ø where its form is not
#   number_suffix_readers: functions reading what follows a decimal number, given the parser after it, the number as
#   decimal_number wrote it and as the source did (`0.1f`, `1 month`), each ø where its form is not
#   suffix_readers: functions reading what follows an operand, given the parser after it, the operand and the binding
#   power the context needs (`x²`), each ø where its form is not or binds looser
#   keyword_readers: a word → the reader of the phrase it starts, given the parser at the word and the word, ø where
#   its form is not there (`emit alarm`)
#   block_words: words that take a block glued to them as theirs, `go{…}`, never the tagged block `go:{…}`
#   commands: the command words it answers (`warp help`), and runs: the function running one, given its word
#   runtime: its runtime root under extensions/, whose definitions (the bridge hooks' bodies) are trapping stubs in a
#   build leaving the row out (decision extension-row-optional, compiler.warp left_out_runtime_words)
class Extension { name: text; operator_rows: text = ""; library_words: map = {}; host_exports: list = []; constant_tables: map = {}; atom_readers: map = {}; number_readers: list = []; number_suffix_readers: list = []; suffix_readers: list = []; keyword_readers: map = {}; block_words: list = []; commands: list = []; runs: any = ø; runtime: text = "" }

# every extension's operator rows, as one text per extension
def extension_operator_rows(): list := EXTENSIONS.map(extension => extension.operator_rows).filter(rows => rows != "")
# base's entries and each of tables' (a later table's entry wins)
with_entries(base: map, tables: list): map := {
	merged = {}
	for table in [base] + tables { for name in table.keys { merged[name] = table[name] } }
	merged
}
extended_library_words(base: map): map := with_entries(base, EXTENSIONS.map(extension => extension.library_words))
extended_constant_tables(base: map): map := with_entries(base, EXTENSIONS.map(extension => extension.constant_tables))
# every map of entries as one map, a later one's entry winning
joined_maps(maps: list): map := {
	joined = {}
	for entries in maps { for key in entries.keys { joined[key] = entries[key] } }
	joined
}
# the reader of an atom starting with the character, else ø
global atom_reader_table = ø
atom_reader(c: any): any := {
	if atom_reader_table == ø { atom_reader_table = joined_maps(EXTENSIONS.map(extension => extension.atom_readers)) }
	atom_reader_table.get("$(c)")
}
# the reader of the phrase a word starts, else ø
global keyword_reader_table = ø
keyword_reader_of(word: text): any := {
	if keyword_reader_table == ø { keyword_reader_table = joined_maps(EXTENSIONS.map(extension => extension.keyword_readers)) }
	keyword_reader_table.get(word)
}
# every word an extension takes a glued block for
extension_block_words(): list := concatenated(EXTENSIONS.map(extension => extension.block_words))
# what an extension reads after the operand, else ø
global suffix_reader_list = ø
read_suffix(p: Parser, operand: Node, min_power: int): Node := {
	if suffix_reader_list == ø { suffix_reader_list = concatenated(EXTENSIONS.map(extension => extension.suffix_readers)) }
	for reader in suffix_reader_list {
		suffixed = reader(p, operand, min_power)
		if suffixed != ø { return suffixed }
	}
	ø
}
# every extension's number suffix readers
global number_suffix_reader_list = ø
number_suffix_readers(): list := {
	if number_suffix_reader_list == ø { number_suffix_reader_list = concatenated(EXTENSIONS.map(extension => extension.number_suffix_readers)) }
	number_suffix_reader_list
}
# every extension's number readers
global number_reader_list = ø
number_readers(): list := {
	if number_reader_list == ø { number_reader_list = concatenated(EXTENSIONS.map(extension => extension.number_readers)) }
	number_reader_list
}
extension_host_exports(): list := concatenated(EXTENSIONS.map(extension => extension.host_exports))
# every command word an extension answers
extension_command_words(): list := concatenated(EXTENSIONS.map(extension => extension.commands))
# the command run by the extension answering its word
run_extension_command(command: text) := {
	for extension in EXTENSIONS {
		if command in extension.commands {
			run = extension.runs
			return run(command)
		}
	}
	raise "no extension answers the command " + command
}
