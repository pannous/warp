# What an extension registers (decision core-is-self, notes/core_extensions_roadmap.md "Hook table design"): one
# Extension row each in extensions/extensions.warp, every field but its name optional. The core names no extension: it
# knows this shape and walks the rows. Later fields join here: keyword handlers, passes. Its runtime words are
# extensions/runtime.warp's, which joins them to the extended runtime, its list kinds too. One field a line, each
# with what it holds above it (a new field is its own lines, so two cards adding fields merge cleanly).
class Extension {
	name: text
	# the extension's operators, rows in lib/aliases.warp's format, its file's text (library.warp bundled_module)
	operator_rows: text = ""
	# a program's word → the runtime word it calls (emitter runtime_words.warp library_words)
	library_words: map = {}
	# runtime words every program exports under their own names, for a host (emitter host.warp)
	host_exports: list = []
	# tables whose numbers its runtime words read by name, `GpuCell.I32` (emitter.warp constant_tables)
	constant_tables: map = {}
	# the first character of an atom it reads → its reader, given the parser there, which reads the atom and moves past
	# it (`°C`); glued after a number or a name such an atom multiplies it, `30°`, `x°`
	atom_readers: map = {}
	# functions reading a number form at a digit (`0xff`, `2024-01-31`), each ø where its form is not
	number_readers: list = []
	# functions reading what follows a decimal number, given the parser after it, the number as decimal_number wrote it
	# and as the source did (`0.1f`, `1 month`), each ø where its form is not
	number_suffix_readers: list = []
	# functions reading what follows an operand, given the parser after it, the operand and the binding power the
	# context needs (`x²`), each ø where its form is not or binds looser
	suffix_readers: list = []
	# functions reading an operator after an operand inside an expression, given the parser there, the operand and the
	# binding power the context needs, each ø where its form is not, OPERAND_ENDS where it binds looser and so ends the
	# operand (`a ⊕ b` of a declared ⊕)
	infix_readers: list = []
	# functions reading an operator and its operand where an expression starts, each ø where its form is not (`√16` of a
	# declared √)
	prefix_readers: list = []
	# functions telling whether the parse reads the glyph as the extension's, never a free symbol
	glyph_owners: list = []
	# a name → the function scanning a source before it is parsed, whose value the parser keeps under the name
	# (Parser.scans: the operators a program declares)
	prescans: map = {}
	# a word → the reader of the phrase it starts, given the parser at the word and the word, ø where its form is not
	# there, nothing read; one that read its statement to nothing (applied by a prescan) answers ø past it (`emit
	# alarm`)
	keyword_readers: map = {}
	# words that take a block glued to them as theirs, `go{…}`, never the tagged block `go:{…}`
	block_words: list = []
	# functions run on the source before it is parsed, each giving [the new source, its shifts]: where the new source
	# got shorter, [offset after the change, columns taken out], so nodes keep their written columns
	source_passes: list = []
	# the character after a `\` in a text → the reader of the escape, given the text, the offset of the `\` and its
	# length, giving [the characters, the length read], ø where its form is not (`\:alpha`)
	text_escape_readers: map = {}
	# a word starting a value that comes later → the word a place declared as a value calls on it, brought wherever the
	# program calls the first (`task_go` → `task_awaited`: `n: int = go f(3)` awaits)
	value_settlers: map = {}
	# functions a program goes through before its texts interpolate (`sql "… $name"` built as a query)
	text_passes: list = []
	# a core pass's name → the extension's pass running right after it (`{"arity_overloads": clauses}`, decision
	# extension-passes); a name of no core pass is refused
	passes: map = {}
	# functions lowering a match's arms past the core's (cases, values, types, `_`), given the arms, the subject and the
	# enum variants, each giving arms the core lowers (`n if n > 5 => e` as an arm `_`)
	arm_lowerings: list = []
	# functions finding the standard modules a source uses without saying it, given the source and its folder
	implicit_uses: list = []
	# functions given each node of the program as written and the program, each diagnosing what it finds (source_checks.warp,
	# beside the core's own lints)
	lints: list = []
	# the command words it answers (`warp help`), and runs: the function running one, given its word
	commands: list = []
	runs: any = ø
	# its runtime root under extensions/, whose definitions (the bridge hooks' bodies) are trapping stubs in a build
	# leaving the row out (decision extension-row-optional, compiler.warp left_out_runtime_words)
	runtime: text = ""
}

# every extension's operator rows, as one text per extension
def extension_operator_rows(): list := EXTENSIONS.map(extension => extension.operator_rows).filter(rows => rows != "")
# base's entries and each extension's (a later entry wins)
extended_library_words(base: map): map := joined_maps([base] + EXTENSIONS.map(extension => extension.library_words))
extended_constant_tables(base: map): map := joined_maps([base] + EXTENSIONS.map(extension => extension.constant_tables))
# every map of entries as one map, a later one's entry winning
joined_maps(maps: list): map := {
	joined = {}
	for entries in maps { for key in entries.keys { joined[key] = entries[key] } }
	joined
}
# every map of rows as one map, refused loudly when two claim one key
claimed_once(maps: list): map := {
	joined = {}
	for rows in maps {
		for key in rows.keys {
			if joined.has(key) { raise "two rows claim `" + key + "`" }
			joined[key] = rows[key]
		}
	}
	joined
}
# every extension's entries of one Extension field, joined once: its lists as one list, its maps as one map
extension_list(field: text): list := extension_table(field, concatenated)
extension_map(field: text): map := extension_table(field, joined_maps)
global extension_tables = {}
extension_table(field: text, joining: function): any := {
	if not extension_tables.has(field) { extension_tables[field] = joining(EXTENSIONS.map(extension => extension[field])) }
	extension_tables[field]
}
# the reader of an atom starting with the character, else ø
atom_reader(c: any): any := extension_map("atom_readers").get("$(c)")
# the reader of the phrase a word starts, else ø
keyword_reader_of(word: text): any := extension_map("keyword_readers").get(word)
# the source after every extension's pass, [text, shifts] (an earlier pass's shifts moved by a later one's)
passed_source(source: text): list := {
	shifts = []
	for extension in EXTENSIONS {
		for pass in extension.source_passes {
			passed = pass(source)
			later = passed#2
			shifts = shifts.map(shift => [shift#1 - taken_before(later, shift#1), shift#2]) + later
			source = passed#1
		}
	}
	[source, shifts]
}
# the columns the shifts took out before the offset
taken_before(shifts: list, at: int): int := {
	taken = 0
	for shift in shifts { if shift#1 <= at { taken = taken + shift#2 } }
	taken
}
# the escape an extension reads in a text at the `\` at `at`: [its characters, the length read], else ø
text_escape_at(source: any, at: int, n: int): list? := {
	if at + 1 >= n { return ø }
	reader = extension_map("text_escape_readers").get("$(source[at + 1])")
	if reader == ø then ø else reader(source, at, n)
}
# every word an extension takes a glued block for
extension_block_words(): list := extension_list("block_words")
# the core passes with each extension's pass after the one it names, rows in order
with_extension_passes(core: list): list := {
	follows = concatenated(EXTENSIONS.map(extension => extension.passes.keys.map(name => [name, extension.passes[name]])))
	for pair in follows { if not core.any(pass => "${pass}" == pair#1) { raise "an extension's pass follows " + pair#1 + ", which is no core pass" } }
	concatenated(core.map(pass => [pass] + follows.filter(pair => pair#1 == "${pass}").map(pair => pair#2)))
}
# the program through every extension's text passes, in row order
with_text_passes(program: Node): Node := {
	passed = program
	for pass in extension_list("text_passes") { passed = pass(passed) }
	passed
}
# the standard modules the source uses without saying it, as the extensions find them
implicit_modules_of(source: text, folder: text = "."): list := concatenated(extension_list("implicit_uses").map(modules_found => modules_found(source, folder)))
# a match's arms through every extension's arm lowerings, in row order
with_arm_lowerings(arms: list, subject: Node, variants: map): list := {
	lowered = arms
	for lowering in extension_list("arm_lowerings") { lowered = lowering(lowered, subject, variants) }
	lowered
}
# every starter word → the word settling its value
extension_value_settlers(): map := extension_map("value_settlers")
# what an extension reads after the operand, else ø
read_suffix(p: Parser, operand: Node, min_power: int): Node := first_answer(extension_list("suffix_readers"), reader => reader(p, operand, min_power))
# what an infix reader answers for an operator binding looser than the context: the operand ends before it
OPERAND_ENDS = symbol("operand ends")
# what an extension reads after the operand inside an expression, OPERAND_ENDS, else ø
read_infix(p: Parser, operand: Node, min_power: int): Node := first_answer(extension_list("infix_readers"), reader => reader(p, operand, min_power))
# the operator and operand an extension reads where an expression starts, else ø
read_prefix(p: Parser): Node := first_answer(extension_list("prefix_readers"), reader => reader(p))
# whether an extension reads the glyph as its own in this parse
owned_glyph(p: Parser, glyph: text): bool := EXTENSIONS.any(extension => extension.glyph_owners.any(owns => owns(p, glyph)))
# each extension's prescan of the source, by its name
extension_scans(source: text): map := {
	scans = {}
	for extension in EXTENSIONS {
		for name in extension.prescans.keys {
			scan = extension.prescans[name]
			scans[name] = scan(source)
		}
	}
	scans
}
number_suffix_readers(): list := extension_list("number_suffix_readers")
number_readers(): list := extension_list("number_readers")
extension_host_exports(): list := extension_list("host_exports")
# every command word an extension answers
extension_command_words(): list := extension_list("commands")
# the command run by the extension answering its word
run_extension_command(command: text) := {
	for extension in EXTENSIONS {
		if command in extension.commands {
			run = extension.runs
			return run(command)
		}
	}
	raise "no extension answers the command " + command
}
