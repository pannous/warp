#!/usr/bin/env warp
@primitive

# see extensions/commands/commands.warp

# The native warp (decision native-warp-in-core, AGENTS.md "Native warp"): the warp command as a native
# executable, warp.wasm hosted through driver.warp. It only tells apart what the words name:
#   warp app.wasm args…   the module run
#   warp app.warp args…   compiled by warp.wasm, then run with the arguments (a `--` before them left out)
#   warp run app.…        the same; `warp pure …` and `warp eval <code>` too (warp.wasm is the pure compiler);
#                         `warp fast …` at full precision yet; `warp fuel <steps> …` counting steps
#   warp self …           the same by warp-self.wasm, warp.wasm's build of itself
#   warp                  on a terminal the version, the help and the console; a piped program run, its value shown
#   warp beautify|fix …   lib/fix/command.warp with the words; warp format|lint … too, the layout only
#   warp lsp              lib/lsp/lsp.warp: the language server over standard input and output, for an editor
#   warp docs|wiki|home   where the documentation is, opened
#   warp app [check] …    lib/app/command.warp: a markup program's page in the system's web view
#   warp repl|start       the console: each line a module of its own, linked to the earlier lines' kept instances
#   warp rebuild [pure]   warp.wasm built anew from lib/ by the seed (rebuilt)
#   warp rebuild from <step>  the same from that step on (seed, optimize, runtime, modules); pure … to <step>: through it
#   warp rebuild self     warp.wasm promoted to warp-self.wasm once it compiles itself (promoted)
#   warp rebuild seed     the seed's machine code made (seed_shipped)
#   warp <words…>         warp.wasm with the words: its own command (core/commands/commands.warp and extensions/commands/commands.warp), any
#                         other words code it compiles to its run-to option (compiler.warp), which then runs
# The host words warp.wasm's commands call are answered by driver.warp host_word; library words (graphics, sound, web)
# are not the core binary's (decision libraries-not-core) and say so
use "driver.warp"
use "tests.warp"

getline(line: pointer, capacity: pointer, stream: handle): i64 from "c"
isatty(descriptor: i32): i32 from "c"
read(descriptor: i32, data: pointer, size: i64): i64 from "c"
STDIN = 0
STDOUT = 1
DASH = 45
KEY_ESCAPE = 27
KEY_BRACKET = 91
ARROW_UP = 65
ARROW_DOWN = 66
ARROW_RIGHT = 67
ARROW_LEFT = 68
KEY_DELETE = 127
KEY_BACKSPACE = 8
KEY_END_OF_INPUT = 4
KEY_INTERRUPT = 3
KEY_RETURN = 13
KEY_SPACE = 32
KEY_LINE_START = 1
KEY_LINE_END = 5
# the bytes of a key's escape sequence (card repl-editing-keys): ESC [ <number>;<modifier> <final>, ESC O <final>, ESC <key>
KEY_APPLICATION = 79
KEY_ALT_D = 100
# Alt+←/→ as macOS Terminal sends them with Option as Meta: ESC b, ESC f (cards repl-alt-arrows, alt-arrow-navigation)
KEY_ALT_B = 98
KEY_ALT_F = 102
FINAL_HOME = 72
FINAL_END = 70
FINAL_NUMBERED = 126
NINE = 57
NUMBERED_HOME = 1
NUMBERED_HOME_VT = 7
NUMBERED_END = 4
NUMBERED_END_VT = 8
NUMBERED_DELETE = 3
MODIFIER_ALT = 3
# what a line editing key does, past the byte values a typed key has
EDIT_NONE = 0
EDIT_LEFT = 256
EDIT_RIGHT = 257
EDIT_UP = 258
EDIT_DOWN = 259
EDIT_START = 260
EDIT_END = 261
EDIT_DELETE = 262
EDIT_WORD_AFTER = 263
EDIT_WORD_BEFORE = 264
EDIT_BACK = 265
EDIT_WORD_LEFT = 266
EDIT_WORD_RIGHT = 267

# a compiler with this executable's words from `first` on: a command runs, code is compiled to the run-to option's file and run after
hosted(compiler: text, first: int): nothing := {
	given = compiler_arguments(compiler)
	for i in first..arg_count() { added(given, reachable_word(arg(i))) }
	words_ran(compiler, given)
}
# a program piped to bare `warp` (no terminal): the whole input one program, run, its value printed
piped_program(compiler: text): nothing := {
	printed = piped(fdopen(STDIN, c_string("r")))
	given = compiler_arguments(compiler)
	added(given, native_copy(printed.at, printed.size))
	words_ran(compiler, given)
}
# the option one warp gives its own compiler: the file a program's module goes to (texts are words in primitive code)
run_to_option(): text := "run-to"
# the compiler run with the words; when they were code, the module it wrote to the run-to option run after
words_ran(compiler: text, given: Arguments): nothing := {
	output = compiled_path()
	option_given(run_to_option(), output)
	file_ran(compiler, given)
	option_dropped(run_to_option())
	if read_file(output).length > 0 { written_run(output, "code", arg_count()) }
}
# `warp rebuild`: warp.wasm built anew from lib/: the seed compiles compiler.warp
# behind its own runtime, then the new warp.wasm optimizes itself and writes runtime.wasm and the modules beside it;
# warp.wasm is replaced, with its machine code, only once all of that worked. Any step failing stops the rebuild with
# its message. Each step is said before it runs (`rebuild step <name>`), so a failed rebuild names the step it failed
# in; `warp rebuild from <step>` starts there, on the warp.wasm.new and runtime.wasm the earlier steps left (scripts/rebuild.sh
# keeps those of a failed build in the store and resumes it, notes/compiler_rebuilds.md "Failed builds").
# The last step, native, builds this executable anew (core/native/warp.warp, `warp build native`) by the new warp.wasm,
# so a failed native build leaves warp.wasm as it was too; `warp rebuild pure` stops before it, the compilers alone
# (scripts/rebuild.sh, the smoke test: card rebuild-native)
rebuilt(first: text, last: text): nothing := {
	library = library_folder()
	compiler = real_path(joined(library, "/compiler/compiler.warp"))
	built = joined(compiler_path(), ".new")
	runtime = joined(library, "/runtime.wasm")
	modules = joined(library, "/modules")
	start = step_number(first)
	end = step_number(last)
	seed = seed_path()
	if step_runs("seed", start, end) {
		# the seed's runtime in a folder of its own: a compile links the modules beside its runtime, and lib/modules/
		# were built behind lib/runtime.wasm, whose words may sit elsewhere (an old seed checks only their counts)
		seed_folder = joined(built, ".seed")
		mkdir(c_string(seed_folder), FOLDER_MODE)
		seed_runtime = joined(seed_folder, "/runtime.wasm")
		file_ran(seed, words(seed, "runtime", seed_runtime, "", "", ""))
		builder_ran(seed, words(seed, compiler, built, folder_of(compiler), library, seed_runtime))
		unlink(seed_runtime)
		rmdir(seed_folder)
	}
	if step_runs("optimize", start, end) {
		optimized = joined(built, ".optimized")
		file_ran(built, words(built, "optimize", built, optimized, "", ""))
		rename(c_string(optimized), c_string(built))
		stamped(built, library)
	}
	if step_runs("runtime", start, end) { file_ran(built, words(built, "runtime", runtime, "", "", "")) }
	if step_runs("modules", start, end) {
		mkdir(c_string(modules), FOLDER_MODE)
		file_ran(built, words(built, "modules", modules, runtime, "", ""))
	}
	# `warp rebuild from native` builds no compiler: the installed one builds the native warp
	compiled = start < step_number("native")
	native_builder = if compiled then built else compiler_path()
	if step_runs("native", start, end) {
		file_ran(native_builder, words(native_builder, "build", "native", joined(library, "/compiler/native/warp.warp"), "", ""))
	}
	# (a rebuild stopped before the modules leaves warp.wasm.new for the one that goes on: scripts/rebuild.sh)
	if compiled and end >= step_number("modules") {
		machine_code_moved(built, compiler_path())
		rename(c_string(built), c_string(compiler_path()))
		print(joined("rebuilt ", compiler_path()))
	}
}
# a step of `warp rebuild` from the first one to the last, said before it runs
step_runs(name: text, start: int, end: int): bool := {
	if step_number(name) < start or step_number(name) > end { return false }
	print(joined("rebuild step ", name))
	true
}
# a rebuild step's place in the order; the first step for no name, and an unknown name refused
step_number(name: text): int := {
	if name.length == 0 or same_text(name, "seed") { return 1 }
	if same_text(name, "optimize") { return 2 }
	if same_text(name, "runtime") { return 3 }
	if same_text(name, "modules") { return 4 }
	if same_text(name, "native") { return 5 }
	complain(joined(joined("warp rebuild: no step ", name), "; the steps are seed, optimize, runtime, modules, native"))
	exit(1)
	0
}
# the build stamp appended to a build file, a custom section warp.build of lines:
# lib/, its compiler inputs hash (left empty: no run compares it, decision
# compilers-delivered), the warp that built it, lib/'s commit, then when it was built. `warp version` shows it
stamped(file: text, library: text): nothing := {
	commit = command_output(joined(joined("git -C '", library), "' rev-parse HEAD 2>/dev/null"))
	built = local_minute(milliseconds_now() / 1000)
	data = joined(joined(joined(joined(library, "\n\nthe native warp\n"), commit), "\n"), built)
	name = "warp.build"
	header = allocate(16)
	byte_at(header).value = 0
	size = leb_written(header + 1, 1 + name.length + data.length)
	byte_at(header + 1 + size).value = name.length as u8
	stream = fopen(c_string(file), c_string("ab"))
	fwrite(native_pointer(header), 1, 2 + size, stream)
	fwrite(native_pointer(name.address), 1, name.length, stream)
	fwrite(native_pointer(data.address), 1, data.length, stream)
	fclose(stream)
}
# n as unsigned LEB128 at `at`, its byte count
leb_written(at: pointer, n: i64): i64 := {
	rest = n
	count = 0
	while rest >= 128 {
		byte_at(at + count).value = (rest % 128 + 128) as u8
		rest = rest / 128
		count = count + 1
	}
	byte_at(at + count).value = rest as u8
	count + 1
}
# `warp rebuild self` (scripts/promote-self.sh): warp.wasm compiles compiler.warp once more, and when it does it is
# promoted to warp-self.wasm, with its machine code; whether that build is warp.wasm's own bytes (a fixpoint) is said,
# not required
promoted(): nothing := {
	library = library_folder()
	compiler = compiler_path()
	source = real_path(joined(library, "/compiler/compiler.warp"))
	next = joined(compiler, ".next")
	builder_ran(compiler, words(compiler, source, next, folder_of(source), library, joined(library, "/runtime.wasm")))
	fixpoint = same_text(read_file(next), read_file(compiler))
	unlink(next)
	promoted_file = joined(library, "/warp-self.wasm")
	copied(compiler, promoted_file)
	for kind in 0..MACHINE_CODE_KINDS { machine_code_copied(compiler, promoted_file, machine_code_suffix_of(kind)) }
	said = if fixpoint then " compiles compiler.warp once more (to its own bytes, a fixpoint), promoted to " else " compiles compiler.warp once more (to other bytes, no fixpoint), promoted to "
	print(joined(joined(compiler, said), promoted_file))
}
# `warp rebuild seed`: the seed's machine code beside it, made when missing, so no build compiles it. Its runtime is
# no file kept beside it: each rebuild's seed step compiles it from the sources being built, as CI's fresh checkout
# does (card seed-compiles: a kept one made of older sources hid a seed that no longer compiled them, 16 s a rebuild)
seed_shipped(): nothing := {
	seed = seed_path()
	machine_code_kept(seed)
	print(joined("precompiled ", seed))
}
# a build's machine code (the driver's .cwasm and its key) moved to another build file of the same bytes
machine_code_moved(from: text, to: text): nothing := {
	for kind in 0..MACHINE_CODE_KINDS { machine_code_renamed(from, to, machine_code_suffix_of(kind)) }
}
machine_code_renamed(from: text, to: text, suffix: text): nothing := {
	rename(c_string(joined(from, suffix)), c_string(joined(to, suffix)))
	rename(c_string(joined(joined(from, suffix), ".key")), c_string(joined(joined(to, suffix), ".key")))
}
# a build's machine code of one heap copied beside another build file, when it has that one
machine_code_copied(from: text, to: text, suffix: text): nothing := {
	if read_file(joined(joined(from, suffix), ".key")).length > 0 {
		copied(joined(from, suffix), joined(to, suffix))
		copied(joined(joined(from, suffix), ".key"), joined(joined(to, suffix), ".key"))
	}
}
# a file's copy, written aside and renamed, so a run beside this one never reads half of it
copied(from: text, to: text): nothing := {
	aside = joined(to, ".new")
	write_file(aside, read_file(from))
	rename(c_string(aside), c_string(to))
}
# `warp rebuild [pure] [from <step>] | self | seed`, its word at `at`: bare, every step through native; pure, the
# compilers alone (through modules, or `to <step>`: scripts/rebuild.sh builds the modules itself, in parallel)
rebuild_command(at: int): nothing := {
	which = if arg_count() > at + 1 then arg(at + 1) else ""
	if which.length == 0 { return rebuilt("", "native") }
	if same_text(which, "from") { return rebuilt(step_given(at + 2), "native") }
	if same_text(which, "pure") {
		last = step_after("to", at + 2)
		return rebuilt(step_after("from", at + 2), if last.length > 0 then last else "modules")
	}
	if same_text(which, "self") { return promoted() }
	if same_text(which, "seed") { return seed_shipped() }
	complain(joined(joined("warp rebuild: no compiler ", which), "; say `warp rebuild`, `warp rebuild pure`, `warp rebuild [pure] from <step>`, `warp rebuild self` or `warp rebuild seed`"))
	exit(1)
}
# the step named at `at`, the first one when none is
step_given(at: int): text := if arg_count() > at then arg(at) else ""
# the step after the word among the arguments from `at` on (`warp rebuild pure from runtime to runtime`), "" without it
step_after(word: text, at: int): text := {
	place = at
	while place + 1 < arg_count() {
		if same_text(arg(place), word) { return arg(place + 1) }
		place = place + 1
	}
	""
}
# the seed, the compiler that compiles compiler.warp: --seed <file>, else warp-seed.wasm beside this executable (as invoked,
# then where its links lead), else beside the installed warp, the first on $PATH: a tree's core/native/warp has none
# beside it (card tree-seed-lookup); none found names the one beside this executable
seed_path(): text := {
	if has_option("seed") { return option_of("seed") }
	own = seed_beside(invoked_path())
	if own.length > 0 { return own }
	installed = path_found("warp")
	found = if installed.length > 0 then seed_beside(installed) else ""
	if found.length > 0 then found else joined(folder_of(executable_path()), "/warp-seed.wasm")
}
# warp-seed.wasm beside an executable as named, else beside the one its links lead to; empty for neither
seed_beside(executable: text): text := {
	named = joined(folder_of(executable), "/warp-seed.wasm")
	if access(c_string(named), READABLE) == 0 { return named }
	linked = joined(folder_of(resolved_path(executable)), "/warp-seed.wasm")
	if access(c_string(linked), READABLE) == 0 then linked else ""
}
# a module's arguments: its path, then the words that are not empty
words(module: text, a: text, b: text, c: text, d: text, e: text): Arguments := {
	list = arguments()
	added(list, module)
	if a.length > 0 { added(list, a) }
	if b.length > 0 { added(list, b) }
	if c.length > 0 { added(list, c) }
	if d.length > 0 { added(list, d) }
	if e.length > 0 { added(list, e) }
	list
}
# `warp repl`, the console: each line compiled by warp.wasm's repl-step as a module of its own in the session's folder,
# linked to the earlier lines' modules, and run in the console's session, which keeps every line's instance: what a
# line declares and its values stay for the next lines (card warp-repl-instance). A line that fails ends only itself;
# one that calls exit() ends the console. The engine and the machine code of the compiler and modules load once
console(compiler: text): nothing := {
	print("Interactive console (Ctrl+D to exit)")
	folder = joined(text_from(compiled_path().address, compiled_path().length - 5), ".repl")
	mkdir(c_string(folder), FOLDER_MODE)
	resident_loaded(compiler, yes)
	session = session_opened()
	# Ctrl+C stops the running line or its compile, never the console (lib/native/foreign.c)
	interrupts_engine(long_at(resident_block()).value)
	number = 0
	ended: i32 = -1
	input = fdopen(STDIN, c_string("r"))
	line_cell = allocate(8)
	capacity = allocate(8)
	editing = isatty(STDIN) != 0
	history = read_file(history_path())
	lines = line_count(history)
	while yes {
		fd_write(STDOUT, prompt(), 1, allocate(4))
		line = ""
		if editing {
			line = edited_line(history, lines)
			if same_text(line, input_ended()) then break
		} else {
			length = getline(line_cell, capacity, input)
			if length < 0 then break
			line = trimmed_end(native_copy(long_at(line_cell).value, length))
		}
		if line.length > 0 {
			history = joined(joined(history, line), "\n")
			lines = lines + 1
			if editing { write_file(history_path(), history) }
			number = number + 1
			module = joined(joined(joined(folder, "/line_"), text_of(number)), ".wasm")
			interrupts_running(yes)
			if line_compiled(compiler, folder, line, module) { ended = session_line_run(session, module) }
			interrupts_running(no)
			if ended >= 0 then break
		}
	}
	print("")
	command_output(joined(joined("rm -r '", folder), "'"))
	if ended > 0 { exit(ended) }
}
# the console's line compiled to `module` by warp.wasm's repl-step, what the compile said shown; whether it compiled
line_compiled(compiler: text, folder: text, line: text, module: text): bool := {
	said = joined(folder, "/compile.out")
	given = words(compiler, "repl-step", folder, line, module, joined(library_folder(), "/runtime.wasm"))
	failure = run_into(read_file(compiler), given, machine_code_file(compiler, RUN_GC_HEAP_BYTES), RUN_GC_HEAP_BYTES, said)
	output = read_file(said)
	unlink(said)
	fd_write(STDOUT, output, 1, allocate(4))
	if failure.length > 0 { complain(failure) }
	failure.length == 0
}
# where the lines typed on a terminal stay for the next console, ↑ reaching them as the shells' history does (card
# repl-alt-arrows): ~/.warp_history
history_path(): text := joined(getenv("HOME"), "/.warp_history")
line_count(lines: text): i64 := {
	count = 0
	for i in 0..lines.length {
		if byte_at(lines.address + i).value == NEWLINE { count = count + 1 }
	}
	count
}
# The console's line on a terminal (card repl-arrow-escape): the terminal reads a key at a time without echo while
# the line is edited, ←/→ move the cursor, ↑/↓ step through the earlier lines, ⌫ deletes before the cursor, Ctrl+D on
# an empty line ends the console (input_ended), Ctrl+C drops the line, and on an empty line a second Ctrl+C ends it. Home/End (or Ctrl+A/E) go to the line's start and end, Delete removes
# the character under the cursor, Alt+Delete the word after it and Alt+⌫ the word before it (card repl-editing-keys);
# Alt+←/→ move a word back and on (card alt-arrow-navigation), and ↑ reaches the earlier consoles' lines (history_path, card repl-alt-arrows).
# The cursor steps over a character's UTF-8 bytes whole
edited_line(history: text, lines: i64): text := {
	settings = command_output("stty -g")
	# (-isig: Ctrl+C is a key while the line is edited, a SIGINT only while a line runs)
	command_output("stty -icanon -echo -isig min 1")
	line = ""
	at = 0
	back = 0
	interrupted = no
	while yes {
		c = key()
		if c < 0 or (c == KEY_END_OF_INPUT and line.length == 0) or (c == KEY_INTERRUPT and interrupted) {
			line = input_ended()
			break
		}
		if c == KEY_INTERRUPT {
			fd_write(STDOUT, if line.length == 0 then "\n(Ctrl+C again or Ctrl+D to exit)\n" else "^C\n", 1, allocate(4))
			interrupted = line.length == 0
			line = ""
			at = 0
			back = 0
		} else { interrupted = no }
		if c == KEY_RETURN or c == NEWLINE then break
		edit = edit_of(c)
		if edit == EDIT_LEFT and at > 0 { at = character_before(line, at) }
		if edit == EDIT_RIGHT and at < line.length { at = character_after(line, at) }
		if edit == EDIT_UP and back < lines { back = back + 1 }
		if edit == EDIT_DOWN and back > 0 { back = back - 1 }
		if edit == EDIT_UP or edit == EDIT_DOWN {
			line = if back == 0 then "" else history_line(history, lines - back)
			at = line.length
		}
		if edit == EDIT_START { at = 0 }
		if edit == EDIT_END { at = line.length }
		if edit == EDIT_WORD_LEFT { at = word_before(line, at) }
		if edit == EDIT_WORD_RIGHT { at = word_after(line, at) }
		if edit == EDIT_DELETE and at < line.length { line = cut(line, at, character_after(line, at)) }
		if edit == EDIT_WORD_AFTER { line = cut(line, at, word_after(line, at)) }
		if edit == EDIT_WORD_BEFORE {
			start = word_before(line, at)
			line = cut(line, start, at)
			at = start
		}
		if edit == EDIT_BACK and at > 0 {
			start = character_before(line, at)
			line = cut(line, start, at)
			at = start
		}
		if edit == EDIT_NONE and c >= KEY_SPACE {
			line = joined(joined(text_from(line.address, at as u32), byte_text(c)), after(line, at))
			at = at + 1
		}
		redrawn(line, at)
	}
	command_output(joined("stty ", settings))
	fd_write(STDOUT, "\n", 1, allocate(4))
	line
}
prompt(): text := "🌀"
# what edited_line gives at the input's end: a line no key makes, the one byte Ctrl+D
input_ended(): text := byte_text(KEY_END_OF_INPUT)
byte_text(value: i32): text := {
	cell = allocate(1)
	byte_at(cell).value = value as u8
	text_from(cell, 1)
}
# a terminal control sequence: ESC [ and the rest
control(rest: text): text := joined(joined(byte_text(KEY_ESCAPE), "["), rest)
# the next byte the terminal gives, -1 at its end
key(): i32 := {
	cell = allocate(1)
	if read(STDIN, cell, 1) <= 0 then -1 else byte_at(cell).value as i32
}
# the edit a key asks for, EDIT_NONE for a typed character
edit_of(c: i32): i32 := {
	if c == KEY_ESCAPE { return escaped_edit() }
	if c == KEY_DELETE or c == KEY_BACKSPACE { return EDIT_BACK }
	if c == KEY_LINE_START { return EDIT_START }
	if c == KEY_LINE_END { return EDIT_END }
	EDIT_NONE
}
# the edit of the escape sequence after ESC, as macOS Terminal, iTerm and xterm send them: ESC [ <number>;<modifier>
# <final> or ESC O <final> (Home ESC[H ESC[1~ ESC OH, End ESC[F ESC[4~ ESC OF, Delete ESC[3~, Alt+Delete ESC[3;3~), or
# Alt with a key, ESC <key> (Alt+Delete ESC d, Alt+⌫ ESC DEL)
escaped_edit(): i32 := {
	c = key()
	if c == KEY_DELETE or c == KEY_BACKSPACE { return EDIT_WORD_BEFORE }
	if c == KEY_ALT_D { return EDIT_WORD_AFTER }
	if c == KEY_ALT_B { return EDIT_WORD_LEFT }
	if c == KEY_ALT_F { return EDIT_WORD_RIGHT }
	# ESC ESC [D, iTerm's Option+← (Option as Esc+): the arrow with Alt
	if c == KEY_ESCAPE { return with_alt(escaped_edit()) }
	if c != KEY_BRACKET and c != KEY_APPLICATION { return EDIT_NONE }
	number = 0
	modifier = 0
	given = 0
	c = key()
	while c == SEMICOLON or (c >= ZERO and c <= NINE) {
		if c == SEMICOLON {
			number = given
			given = 0
		} else {
			given = given * 10 + c - ZERO
		}
		c = key()
	}
	if number == 0 { number = given } else { modifier = given }
	arrow = arrow_edit(c)
	if arrow != EDIT_NONE { return if modifier == MODIFIER_ALT then with_alt(arrow) else arrow }
	if c == FINAL_HOME { return EDIT_START }
	if c == FINAL_END { return EDIT_END }
	if c != FINAL_NUMBERED { return EDIT_NONE }
	if number == NUMBERED_HOME or number == NUMBERED_HOME_VT { return EDIT_START }
	if number == NUMBERED_END or number == NUMBERED_END_VT { return EDIT_END }
	if number == NUMBERED_DELETE and modifier == MODIFIER_ALT { return EDIT_WORD_AFTER }
	if number == NUMBERED_DELETE { return EDIT_DELETE }
	EDIT_NONE
}
arrow_edit(c: i32): i32 := {
	if c == ARROW_LEFT { return EDIT_LEFT }
	if c == ARROW_RIGHT { return EDIT_RIGHT }
	if c == ARROW_UP { return EDIT_UP }
	if c == ARROW_DOWN { return EDIT_DOWN }
	EDIT_NONE
}
# an arrow with Alt: ← a word back, → a word on (user 11-10, card alt-arrow-navigation)
with_alt(edit: i32): i32 := if edit == EDIT_LEFT then EDIT_WORD_LEFT else if edit == EDIT_RIGHT then EDIT_WORD_RIGHT else edit
# the line from byte at on
after(line: text, at: i64): text := text_from(line.address + at, (line.length - at) as u32)
# the line without its bytes from start until end
cut(line: text, start: i64, end: i64): text := joined(text_from(line.address, start as u32), after(line, end))
blank(line: text, at: i64): bool := byte_at(line.address + at).value == KEY_SPACE
# where the word before the cursor starts, past the blanks right before it
word_before(line: text, at: i64): i64 := {
	start = at
	while start > 0 and blank(line, start - 1) { start = start - 1 }
	while start > 0 and not blank(line, start - 1) { start = start - 1 }
	start
}
# where the word after the cursor ends, past the blanks right after it
word_after(line: text, at: i64): i64 := {
	end = at
	while end < line.length and blank(line, end) { end = end + 1 }
	while end < line.length and not blank(line, end) { end = end + 1 }
	end
}
# a UTF-8 byte that continues a character
continues(line: text, at: i64): bool := byte_at(line.address + at).value / 64 == 2
character_before(line: text, at: i64): i64 := {
	start = at - 1
	while start > 0 and continues(line, start) { start = start - 1 }
	start
}
character_after(line: text, at: i64): i64 := {
	end = at + 1
	while end < line.length and continues(line, end) { end = end + 1 }
	end
}
# the prompt and the line written anew, the cursor moved back over the characters after it
redrawn(line: text, at: i64): nothing := {
	fd_write(STDOUT, joined(joined(joined("\r", prompt()), line), control("K")), 1, allocate(4))
	after = 0
	for i in at..line.length { if not continues(line, i) { after = after + 1 } }
	if after > 0 { fd_write(STDOUT, control(joined(text_of(after), "D")), 1, allocate(4)) }
}
# the history's line at that index from 0, its lines each ended by a newline
history_line(history: text, index: i64): text := {
	start = 0
	seen = 0
	for i in 0..history.length {
		if byte_at(history.address + i).value == NEWLINE {
			if seen == index { return text_from(history.address + start, (i - start) as u32) }
			seen = seen + 1
			start = i + 1
		}
	}
	""
}
# `warp version`: warp.wasm's version line, then when this executable and warp.wasm were built
versioned(compiler: text): nothing := {
	given = compiler_arguments(compiler)
	added(given, "version")
	file_ran(compiler, given)
	print(joined("the native warp · built ", built_minute()))
	print(compiler_stamp(compiler_path(), "warp.wasm"))
}
# when this executable was built, as `warp build native` baked it (primitive.warp built_function, cc's `Oct 30 2026
# 12:07:33`), shown as the stamps are: `2026-10-30 12:07`
warp_built(): text from "c"
built_minute(): text := {
	said = warp_built()
	months = "JanFebMarAprMayJunJulAugSepOctNovDec"
	month = 0
	while month < 11 and memcmp(months.address + (month * 3) as u32, said.address, 3) != 0 { month = month + 1 }
	shown = allocate(16)
	memcpy(shown, native_pointer(said.address + 7), 4)
	byte_at(shown + 4).value = DASH
	memcpy(shown + 5, native_pointer("010203040506070809101112".address + (month * 2) as u32), 2)
	byte_at(shown + 7).value = DASH
	memcpy(shown + 8, native_pointer(said.address + 4), 2)
	if byte_at(shown + 8).value == 32 { byte_at(shown + 8).value = 48 }
	byte_at(shown + 10).value = 32
	memcpy(shown + 11, native_pointer(said.address + 12), 5)
	text_from(shown, 16)
}
# a compiler's build stamp (stamped): `warp.wasm of 1792a05d8a · built 2026-10-28 20:25`
compiler_stamp(file: text, name: text): text := {
	wasm = read_file(file)
	if wasm.length == 0 { return joined(name, " missing (warp rebuild)") }
	stamp = custom_section(wasm, "warp.build")
	if stamp.length == 0 { return joined(name, " unstamped") }
	commit = field(stamp, 3, NEWLINE)
	built = field(stamp, 4, NEWLINE)
	shown_length = if commit.length > 10 then 10 else commit.length
	of = if commit.length > 0 then joined(" of ", text_from(commit.address, shown_length as u32)) else " of no commit"
	if built.length > 0 then joined(joined(joined(name, of), " · built "), built) else joined(name, of)
}
# a file of warp code: its name ends in .warp, or a file of that name exists
is_warp_file(name: text): bool := ends_with(name, ".warp") or read_file(name).length > 0

# the words that only say how to run what follows: `run`, `pure` and `eval` what the bare words do, `self` by
# warp-self.wasm, `fast` (lib/fast_math.warp) at full precision yet
is_prefix(word: text): bool := same_text(word, "run") or same_text(word, "pure") or same_text(word, "eval") or same_text(word, "self") or same_text(word, "fast")
self_named(compiler: text): bool := ends_with(compiler, "/warp-self.wasm")
# what the words from `first` on ask for, by the compiler: a command the native warp runs itself, a module, a file,
# else warp.wasm's command or code
dispatched(compiler: text, prefixed: bool, first: int): nothing := {
	if arg_count() <= first {
		if prefixed { return helped(compiler) }
		if isatty(STDIN) == 0 { return piped_program(compiler) }
		# bare `warp` on a terminal: the version and the help first, then the console
		versioned(compiler)
		helped(compiler)
		return console(compiler)
	}
	word = arg(first)
	if ends_with(word, ".wasm") { return module_ran(first) }
	if not prefixed {
		if same_text(word, "rebuild") { return rebuild_command(first) }
		if same_text(word, "beautify") or same_text(word, "fix") or same_text(word, "format") or same_text(word, "lint") { return compiled_and_run(compiler, joined(library_folder(), "/fix/command.warp"), first) }
		if same_text(word, "docs") or same_text(word, "wiki") or same_text(word, "home") { return documentation_opened() }
		if same_text(word, "lsp") { return compiled_and_run(compiler, joined(library_folder(), "/lsp/lsp.warp"), first) }
		if same_text(word, "app") { return compiled_and_run(compiler, joined(library_folder(), "/app/command.warp"), first) }
		if same_text(word, "dev") { return compiled_and_run(compiler, joined(library_folder(), "/dev/command.warp"), first) }
	}
	# `warp test`, and `warp self test` as `warp test --self`: the native warp runs the cases, each by the compiler named
	if same_text(word, "test") and (not prefixed or self_named(compiler)) { return tests_run(compiler, flagged("--self") or self_named(compiler), first) }
	if same_text(word, "repl") or same_text(word, "console") or same_text(word, "start") { return console(compiler) }
	if same_text(word, "version") or same_text(word, "--version") { return versioned(compiler) }
	# a plain `warp app.warp` serves its routes (lib/web.warp routes_end), `warp run app.warp` runs it once
	if is_warp_file(word) and not prefixed { option_given("serve", "yes") }
	# and the program knows its file (lib/storage.warp keeps its tables beside it)
	if is_warp_file(word) { option_given("program", word) }
	if is_warp_file(word) { return compiled_and_run(compiler, word, first + 1) }
	hosted(compiler, first)
}
# warp.wasm's help
helped(compiler: text): nothing := {
	given = compiler_arguments(compiler)
	added(given, "help")
	file_ran(compiler, given)
}
# `warp docs`: where the documentation is, opened in the browser where one opens
documentation_opened(): nothing := {
	print("Warp documentation can be found at https://github.com/pannous/warp/wiki")
	command_output("open https://github.com/pannous/warp/ 2>/dev/null || xdg-open https://github.com/pannous/warp/ 2>/dev/null")
}

# the options warp takes before or after its command word (wiki/cli.md; `warp help options` describes them,
# extensions/commands/commands.warp option_help), kept without their dashes for run_option (core/host_io.warp):
# flags, and options with a value (--lib <folder>); the ones after the --profile and --slots are the tools' (the test
# harness, the build scripts, `warp app check`), which `warp help options` leaves out. Words after the file or code are
# the program's
is_flag(word: text): bool := same_text(word, "--no-hints") or same_text(word, "--no-window") or same_text(word, "--mute") or same_text(word, "--backtrace") or same_text(word, "--profile") or same_text(word, "--times") or same_text(word, "--value-as-data") or same_text(word, "--one-thread") or same_text(word, "--emit-survey") or same_text(word, "--rules-fired") or same_text(word, "--fast") or same_text(word, "--strict")
is_valued(word: text): bool := same_text(word, "--lib") or same_text(word, "--slots") or same_text(word, "--seed") or same_text(word, "--events-for") or same_text(word, "--page-steps") or same_text(word, "--app-window")
# the words of the option at `at`, kept: 1 a flag, 2 an option with its value, 0 no option
option_words(at: int): int := {
	word = arg(at)
	name = text_from(word.address + 2, word.length - 2)
	if is_flag(word) {
		option_given(name, "")
		return 1
	}
	if not is_valued(word) or at + 1 >= arg_count() { return 0 }
	option_given(name, arg(at + 1))
	2
}
# warp's two machine switches (decision no-bash-exports): --no-window is WARP_WINDOW=0, --mute WARP_SOUND=0, either
# spelling sets both, so the warps and programs this one starts are switched too (lib/os.warp windowless, muted)
switched(option: text, variable: text): nothing := {
	if same_text(getenv(variable), "0") { option_given(option, "") }
	if has_option(option) { setenv(c_string(variable), c_string("0"), 1) }
}
# the first word from `at` on that is no option, the options before it kept
past_options(at: int): int := {
	i = at
	taken = 1
	while i < arg_count() and taken > 0 {
		taken = option_words(i)
		i = i + taken
	}
	i
}
# what this executable's words ask for, done: the process's own, and each `warp test` case's (tests.warp case_ran).
# `warp fuel <steps> <file|code…>`: the program counts steps (the run's option fuel), out of fuel after them
command_ran(): nothing := {
	start = past_options(1)
	# a CI machine runs without windows and sound (its CI variable is the CI system's, not warp's)
	if getenv("CI").length > 0 {
		option_given("no-window", "")
		option_given("mute", "")
	}
	counting = arg_count() > start + 2 and same_text(arg(start), "fuel")
	if counting { option_given("fuel", arg(start + 1)) }
	prefixed = counting or (arg_count() > start and is_prefix(arg(start)))
	first = past_options(if counting then start + 2 else if prefixed then start + 1 else start)
	switched("no-window", "WARP_WINDOW")
	switched("mute", "WARP_SOUND")
	# warp.wasm's own commands (build) read the same lib/ as this executable, resolved, as the module's WASI reaches it
	# (no link to an absolute path), and its stable name, the run path of the executables `warp build native` makes
	# (commands.warp native_links)
	option_given("lib-link", library_found())
	option_given("lib", library_folder())
	# and know the native warp hosts them (commands.warp: what it runs itself, what it lacks yet)
	option_given("host", "the native warp")
	# and where it is, so a command runs a program by this warp (`warp build --site` prerenders its page, warp_command)
	option_given("executable", executable_path())
	# `warp fast <program>` is `warp --fast <program>`: untyped whole numbers as i64, wrapping, with no overflow checks
	if prefixed and same_text(arg(start), "fast") {
		option_given("fast", "")
		complain("note: warp fast is written warp --fast; untyped whole numbers wrap as i64")
	}
	dispatched(if prefixed and same_text(arg(start), "self") then joined(library_folder(), "/warp-self.wasm") else compiler_path(), prefixed, first)
}
command_ran()
