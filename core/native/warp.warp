#!/usr/bin/env warp
@primitive
# The native warp (decision native-warp-in-core, notes/roadmap_native_harness.md step 2): the warp command as a native
# executable, warp.wasm hosted through driver.warp. It only tells apart what the words name:
#   warp app.wasm args…   the module run
#   warp app.warp args…   compiled by warp.wasm, then run with the arguments (a `--` before them left out)
#   warp run app.…        the same; `warp pure …` and `warp eval <code>` too (warp.wasm is the pure compiler);
#                         `warp fast …` at full precision yet; `warp fuel <steps> …` counting steps (WARP_FUEL)
#   warp self …           the same by warp-self.wasm, warp.wasm's build of itself
#   warp                  on a terminal the version, the help and the console; a piped program run, its value shown
#   warp beautify|fix …   lib/fix/command.warp with the words; warp format|lint … too, the layout only
#   warp docs|wiki|home   where the documentation is, opened
#   warp repl|start       the console: each line compiled by warp.wasm's repl-step after the lines that stay, then run
#   warp rebuild [pure]   warp.wasm built anew from lib/ by the seed (rebuilt)
#   warp rebuild from <step>  the same from that step on (seed, stage-two, optimize, runtime, modules)
#   warp rebuild self     warp.wasm promoted to warp-self.wasm once it compiles itself (promoted)
#   warp rebuild seed     the seed's runtime and machine code made (seed_shipped)
#   warp <words…>         warp.wasm with the words: its own command (core/commands/commands.warp, the one command table), any
#                         other words code it compiles to WARP_RUN_TO (compiler.warp), which then runs
# The host words warp.wasm's commands call are answered by driver.warp host_word; library words (graphics, sound, web)
# are not the core binary's (decision libraries-not-core) and say so
use "driver.warp"
use "tests.warp"

setenv(name: pointer, value: pointer, overwrite: i32): i32 from "c"
unsetenv(name: pointer): i32 from "c"
fork(): i32 from "c"
waitpid(child: i32, status: pointer, options: i32): i32 from "c"
fdopen(descriptor: i32, mode: pointer): handle from "c"
getline(line: pointer, capacity: pointer, stream: handle): i64 from "c"
isatty(descriptor: i32): i32 from "c"
execv(path: pointer, arguments: pointer): i32 from "c"
execvp(name: pointer, arguments: pointer): i32 from "c"
read(descriptor: i32, data: pointer, size: i64): i64 from "c"
STDIN = 0
STDOUT = 1
KEY_ESCAPE = 27
KEY_BRACKET = 91
ARROW_UP = 65
ARROW_DOWN = 66
ARROW_RIGHT = 67
ARROW_LEFT = 68
KEY_DELETE = 127
KEY_BACKSPACE = 8
KEY_END_OF_INPUT = 4
KEY_RETURN = 13
KEY_SPACE = 32

# a compiler with this executable's words from `first` on: a command runs, code is compiled to WARP_RUN_TO and run after
def hosted(compiler: text, first: int): nothing := {
	given = compiler_arguments(compiler)
	for i in first..arg_count() { added(given, reachable_word(arg(i))) }
	words_ran(compiler, given)
}
# a program piped to bare `warp` (no terminal): the whole input one program, run, its value printed
def piped_program(compiler: text): nothing := {
	printed = piped(fdopen(STDIN, c_string("r")))
	given = compiler_arguments(compiler)
	added(given, native_copy(printed.at, printed.size))
	words_ran(compiler, given)
}
# the compiler run with the words; when they were code, the module it wrote to WARP_RUN_TO run after
def words_ran(compiler: text, given: Arguments): nothing := {
	output = compiled_path()
	setenv(c_string("WARP_RUN_TO"), c_string(output), 1)
	file_ran(compiler, given)
	unsetenv(c_string("WARP_RUN_TO"))
	if read_file(output).length > 0 { written_run(output, "code", arg_count()) }
}
# `warp rebuild`: warp.wasm built anew from lib/, as rust-harness:src/compiler/standalone.rs build did: the seed compiles compiler.warp
# behind its own runtime, then the new warp.wasm optimizes itself and writes runtime.wasm and the modules beside it;
# warp.wasm is replaced, with its machine code, only once all of that worked. Any step failing stops the rebuild with
# its message. Each step is said before it runs (`rebuild step <name>`), so a failed rebuild names the step it failed
# in; `warp rebuild from <step>` starts there, on the warp.wasm.new and runtime.wasm the earlier steps left (scripts/rebuild.sh
# keeps those of a failed build in the store and resumes it, notes/compiler_rebuilds.md "Failed builds")
def rebuilt(first: text): nothing := {
	library = library_folder()
	compiler = real_path(joined(library, "/compiler/compiler.warp"))
	built = joined(compiler_path(), ".new")
	runtime = joined(library, "/runtime.wasm")
	modules = joined(library, "/modules")
	start = step_number(first)
	if step_runs("seed", start) {
		seed = seed_path()
		builder_ran(seed, words(seed, compiler, built, folder_of(compiler), library, seed_prepared(seed)))
	}
	if step_runs("stage-two", start) { rebaked(built, compiler, library) }
	if step_runs("optimize", start) {
		optimized = joined(built, ".optimized")
		file_ran(built, words(built, "optimize", built, optimized, "", ""))
		rename(c_string(optimized), c_string(built))
		stamped(built, library)
	}
	if step_runs("runtime", start) { file_ran(built, words(built, "runtime", runtime, "", "", "")) }
	if step_runs("modules", start) {
		mkdir(c_string(modules), FOLDER_MODE)
		file_ran(built, words(built, "modules", modules, runtime, "", ""))
	}
	machine_code_moved(built, compiler_path())
	rename(c_string(built), c_string(compiler_path()))
	print(joined("rebuilt ", compiler_path()))
}
# a step of `warp rebuild` from the first one on, said before it runs
def step_runs(name: text, start: int): bool := {
	if step_number(name) < start { return false }
	print(joined("rebuild step ", name))
	true
}
# a rebuild step's place in the order; the first step for no name, and an unknown name refused
def step_number(name: text): int := {
	if name.length == 0 or same_text(name, "seed") { return 1 }
	if same_text(name, "stage-two") { return 2 }
	if same_text(name, "optimize") { return 3 }
	if same_text(name, "runtime") { return 4 }
	if same_text(name, "modules") { return 5 }
	complain(joined(joined("warp rebuild: no step ", name), "; the steps are seed, stage-two, optimize, runtime, modules"))
	exit(1)
	0
}
# the seed's build carries the library as the seed cut and parsed it: where its own cut differs (a changed slicer or
# parser), it writes its own tables over the baked ones (rebake); only a build whose tables are no segments of their
# own (an older seed's) compiles compiler.warp once more, so the library baked into warp.wasm is always its own (card
# once-seed, decision rebake-tables)
def rebaked(built: text, compiler: text, library: text): nothing := {
	if not baked_current(built) {
		builder_ran(built, words(built, "rebake", built, "", "", ""))
		said = baked_said(built)
		if not same_text(said, "yes") { compiled_once_more(built, compiler, library, said) }
	}
}
def compiled_once_more(built: text, compiler: text, library: text, said: text): nothing := {
	print(joined(joined("rebuild: the baked library is not this compiler's (", said), "), built once more"))
	runtime = joined(built, ".runtime.wasm")
	file_ran(built, words(built, "runtime", runtime, "", "", ""))
	again = joined(built, ".again")
	builder_ran(built, words(built, compiler, again, folder_of(compiler), library, runtime))
	rename(c_string(again), c_string(built))
	unlink(runtime)
}
# what `baked-current` says of a build: yes, or no and the tables it baked otherwise
def baked_said(built: text): text := {
	answer = joined(built, ".baked")
	file_ran(built, words(built, "baked-current", answer, "", "", ""))
	said = read_file(answer)
	unlink(answer)
	said
}
def baked_current(built: text): bool := same_text(baked_said(built), "yes")
# the build stamp appended to a build file, a custom section warp.build of lines as the Rust harness wrote them
# (rust-harness:src/compiler/standalone.rs current_build): lib/, its compiler inputs hash (left empty: no run compares it, decision
# compilers-delivered), the warp that built it, lib/'s commit, then when it was built. `warp version` shows it
def stamped(file: text, library: text): nothing := {
	commit = command_output(joined(joined("git -C '", library), "' rev-parse HEAD 2>/dev/null"))
	built = local_minute(milliseconds_now() / 1000)
	data = joined(joined(joined(joined(library, "\n\nthe native warp\n"), commit), "\n"), built)
	name = "warp.build"
	header = allocate(16)
	byte_at(header).value = 0
	size = leb_written(header + 1, 1 + name.length + data.length)
	byte_at(header + 1 + size).value = name.length as u8
	stream = fopen(c_string(file), c_string("ab"))
	fwrite(native_pointer(header), 1, 2 + size, stream)
	fwrite(native_pointer(name.address), 1, name.length, stream)
	fwrite(native_pointer(data.address), 1, data.length, stream)
	fclose(stream)
}
# n as unsigned LEB128 at `at`, its byte count
def leb_written(at: pointer, n: i64): i64 := {
	rest = n
	count = 0
	while rest >= 128 {
		byte_at(at + count).value = (rest % 128 + 128) as u8
		rest = rest / 128
		count = count + 1
	}
	byte_at(at + count).value = rest as u8
	count + 1
}
# `warp rebuild self` (scripts/promote-self.sh): warp.wasm compiles compiler.warp once more, and when it does it is
# promoted to warp-self.wasm, with its machine code; whether that build is warp.wasm's own bytes (a fixpoint) is said,
# not required (user 2026-10-26)
def promoted(): nothing := {
	library = library_folder()
	compiler = compiler_path()
	source = real_path(joined(library, "/compiler/compiler.warp"))
	next = joined(compiler, ".next")
	builder_ran(compiler, words(compiler, source, next, folder_of(source), library, joined(library, "/runtime.wasm")))
	fixpoint = same_text(read_file(next), read_file(compiler))
	unlink(next)
	promoted_file = joined(library, "/warp-self.wasm")
	copied(compiler, promoted_file)
	machine_code_copied(compiler, promoted_file, machine_code_suffix(COMPILER_GC_HEAP_BYTES))
	machine_code_copied(compiler, promoted_file, machine_code_suffix(BUILDER_GC_HEAP_BYTES))
	said = if fixpoint then " compiles compiler.warp once more (to its own bytes, a fixpoint), promoted to " else " compiles compiler.warp once more (to other bytes, no fixpoint), promoted to "
	print(joined(joined(compiler, said), promoted_file))
}
# `warp rebuild seed`: the seed's runtime and machine code beside it, made when missing, so no build compiles them
def seed_shipped(): nothing := {
	seed = seed_path()
	seed_prepared(seed)
	machine_code_kept(seed)
	print(joined("precompiled ", seed))
}
# the seed's own runtime.wasm (warp-seed.runtime.wasm), written by the seed's runtime command once per seed; its path
def seed_prepared(seed: text): text := {
	seed_runtime = joined(text_from(seed.address, seed.length - 5), ".runtime.wasm")
	if read_file(seed_runtime).length == 0 { file_ran(seed, words(seed, "runtime", seed_runtime, "", "", "")) }
	seed_runtime
}
# a build's machine code (the driver's .cwasm and its key) moved to another build file of the same bytes
def machine_code_moved(from: text, to: text): nothing := {
	machine_code_renamed(from, to, machine_code_suffix(COMPILER_GC_HEAP_BYTES))
	machine_code_renamed(from, to, machine_code_suffix(BUILDER_GC_HEAP_BYTES))
}
def machine_code_renamed(from: text, to: text, suffix: text): nothing := {
	rename(c_string(joined(from, suffix)), c_string(joined(to, suffix)))
	rename(c_string(joined(joined(from, suffix), ".key")), c_string(joined(joined(to, suffix), ".key")))
}
# a build's machine code of one heap copied beside another build file, when it has that one
def machine_code_copied(from: text, to: text, suffix: text): nothing := {
	if read_file(joined(joined(from, suffix), ".key")).length > 0 {
		copied(joined(from, suffix), joined(to, suffix))
		copied(joined(joined(from, suffix), ".key"), joined(joined(to, suffix), ".key"))
	}
}
# a file's copy, written aside and renamed, so a run beside this one never reads half of it
def copied(from: text, to: text): nothing := {
	aside = joined(to, ".new")
	write_file(aside, read_file(from))
	rename(c_string(aside), c_string(to))
}
# `warp rebuild [pure|self|seed]`, its word at `at`
def rebuild_command(at: int): nothing := {
	which = if arg_count() > at + 1 then arg(at + 1) else "pure"
	if same_text(which, "pure") { return rebuilt("") }
	if same_text(which, "from") { return rebuilt(if arg_count() > at + 2 then arg(at + 2) else "") }
	if same_text(which, "self") { return promoted() }
	if same_text(which, "seed") { return seed_shipped() }
	complain(joined(joined("warp rebuild: no compiler ", which), "; say `warp rebuild`, `warp rebuild pure`, `warp rebuild from <step>`, `warp rebuild self` or `warp rebuild seed`"))
	exit(1)
}
# the seed, the compiler that compiles compiler.warp: $WARP_SEED, else warp-seed.wasm beside this executable
def seed_path(): text := {
	given = getenv("WARP_SEED")
	if given.length > 0 then given else joined(folder_of(executable_path()), "/warp-seed.wasm")
}
# a module's arguments: its path, then the words that are not empty
def words(module: text, a: text, b: text, c: text, d: text, e: text): Arguments := {
	list = arguments()
	added(list, module)
	if a.length > 0 { added(list, a) }
	if b.length > 0 { added(list, b) }
	if c.length > 0 { added(list, c) }
	if d.length > 0 { added(list, d) }
	if e.length > 0 { added(list, e) }
	list
}
# `warp repl`, the console: each line compiled by warp.wasm's repl-step after the lines that stayed (declarations,
# uses: its state file), then run, in a child process of its own, so a line that fails ends only its child. The child
# is this warp started anew (`warp repl-line <state> <line>`), never a fork that runs on: a forked copy of a process
# whose libraries started threads (Cocoa, SDL) aborts (card repl-aborts)
def console(compiler: text): nothing := {
	print("Interactive console (Ctrl+D to exit)")
	state = joined(text_from(compiled_path().address, compiled_path().length - 5), ".repl.warp")
	write_file(state, "")
	input = fdopen(STDIN, c_string("r"))
	line_cell = allocate(8)
	capacity = allocate(8)
	editing = isatty(STDIN) != 0
	history = ""
	lines = 0
	while yes {
		fd_write(STDOUT, prompt(), 1, allocate(4))
		line = ""
		if editing {
			line = edited_line(history, lines)
			if same_text(line, input_ended()) then break
		} else {
			length = getline(line_cell, capacity, input)
			if length < 0 then break
			line = trimmed_end(native_copy(long_at(line_cell).value, length))
		}
		if line.length > 0 {
			history = joined(joined(history, line), "\n")
			lines = lines + 1
			child = fork()
			if child == 0 { line_started(state, line) }
			waitpid(child, allocate(4), 0)
		}
	}
	print("")
	unlink(state)
}
# The console's line on a terminal (card repl-arrow-escape): the terminal reads a key at a time without echo while
# the line is edited, ←/→ move the cursor, ↑/↓ step through the earlier lines, ⌫ deletes before the cursor, Ctrl+D on
# an empty line ends the console (input_ended). The cursor steps over a character's UTF-8 bytes whole
def edited_line(history: text, lines: i64): text := {
	settings = command_output("stty -g")
	command_output("stty -icanon -echo min 1")
	line = ""
	at = 0
	back = 0
	while yes {
		c = key()
		if c < 0 or (c == KEY_END_OF_INPUT and line.length == 0) {
			line = input_ended()
			break
		}
		if c == KEY_RETURN or c == NEWLINE then break
		if c == KEY_ESCAPE {
			if key() == KEY_BRACKET {
				arrow = key()
				if arrow == ARROW_LEFT and at > 0 { at = character_before(line, at) }
				if arrow == ARROW_RIGHT and at < line.length { at = character_after(line, at) }
				if arrow == ARROW_UP and back < lines { back = back + 1 }
				if arrow == ARROW_DOWN and back > 0 { back = back - 1 }
				if arrow == ARROW_UP or arrow == ARROW_DOWN {
					line = if back == 0 then "" else history_line(history, lines - back)
					at = line.length
				}
			}
		} else if (c == KEY_DELETE or c == KEY_BACKSPACE) and at > 0 {
			start = character_before(line, at)
			line = joined(text_from(line.address, start as u32), text_from(line.address + at, (line.length - at) as u32))
			at = start
		} else if c >= KEY_SPACE {
			line = joined(joined(text_from(line.address, at as u32), byte_text(c)), text_from(line.address + at, (line.length - at) as u32))
			at = at + 1
		}
		redrawn(line, at)
	}
	command_output(joined("stty ", settings))
	fd_write(STDOUT, "\n", 1, allocate(4))
	line
}
def prompt(): text := "🌀"
# what edited_line gives at the input's end: a line no key makes, the one byte Ctrl+D
def input_ended(): text := byte_text(KEY_END_OF_INPUT)
def byte_text(value: i32): text := {
	cell = allocate(1)
	byte_at(cell).value = value as u8
	text_from(cell, 1)
}
# a terminal control sequence: ESC [ and the rest
def control(rest: text): text := joined(joined(byte_text(KEY_ESCAPE), "["), rest)
# the next byte the terminal gives, -1 at its end
def key(): i32 := {
	cell = allocate(1)
	if read(STDIN, cell, 1) <= 0 then -1 else byte_at(cell).value as i32
}
# a UTF-8 byte that continues a character
def continues(line: text, at: i64): bool := byte_at(line.address + at).value / 64 == 2
def character_before(line: text, at: i64): i64 := {
	start = at - 1
	while start > 0 and continues(line, start) { start = start - 1 }
	start
}
def character_after(line: text, at: i64): i64 := {
	end = at + 1
	while end < line.length and continues(line, end) { end = end + 1 }
	end
}
# the prompt and the line written anew, the cursor moved back over the characters after it
def redrawn(line: text, at: i64): nothing := {
	fd_write(STDOUT, joined(joined(joined("\r", prompt()), line), control("K")), 1, allocate(4))
	after = 0
	for i in at..line.length { if not continues(line, i) { after = after + 1 } }
	if after > 0 { fd_write(STDOUT, control(joined(text_of(after), "D")), 1, allocate(4)) }
}
# the history's line at that index from 0, its lines each ended by a newline
def history_line(history: text, index: i64): text := {
	start = 0
	seen = 0
	for i in 0..history.length {
		if byte_at(history.address + i).value == NEWLINE {
			if seen == index { return text_from(history.address + start, (i - start) as u32) }
			seen = seen + 1
			start = i + 1
		}
	}
	""
}
# the forked child replaced by `warp repl-line <state> <line>` at once
def line_started(state: text, line: text): nothing := {
	given = arguments()
	added(given, executable_path())
	added(given, "repl-line")
	added(given, state)
	added(given, line)
	long_at(given.pointers + given.count * 8).value = 0
	execv(c_string(executable_path()), given.pointers)
	exit(1)
}
# one console line compiled after the state's lines (repl-step keeps its declarations there), then its module run
def line_ran(compiler: text, state: text, line: text): nothing := {
	module = compiled_path()
	file_ran(compiler, words(compiler, "repl-step", state, line, module, joined(library_folder(), "/runtime.wasm")))
	written_run(module, "repl", arg_count())
}
# `warp version`: warp.wasm's version line, then when this executable was built and the stamps of the compilers
def versioned(compiler: text): nothing := {
	given = compiler_arguments(compiler)
	added(given, "version")
	file_ran(compiler, given)
	print(joined("the native warp · built ", built_minute()))
	self_compiler = joined(library_folder(), "/warp-self.wasm")
	print(joined(joined(compiler_stamp(compiler_path(), "warp.wasm", "pure"), ", "), compiler_stamp(self_compiler, "warp-self.wasm", "self")))
}
# when this executable was built, as `warp build native` baked it (primitive.warp built_function, cc's `Oct 30 2026
# 12:07:33`), shown as the stamps are: `2026-10-30 12:07`
warp_built(): text from "c"
def built_minute(): text := {
	said = warp_built()
	months = "JanFebMarAprMayJunJulAugSepOctNovDec"
	month = 0
	while month < 11 and memcmp(months.address + (month * 3) as u32, said.address, 3) != 0 { month = month + 1 }
	shown = allocate(16)
	memcpy(shown, native_pointer(said.address + 7), 4)
	byte_at(shown + 4).value = 45
	memcpy(shown + 5, native_pointer("010203040506070809101112".address + (month * 2) as u32), 2)
	byte_at(shown + 7).value = 45
	memcpy(shown + 8, native_pointer(said.address + 4), 2)
	if byte_at(shown + 8).value == 32 { byte_at(shown + 8).value = 48 }
	byte_at(shown + 10).value = 32
	memcpy(shown + 11, native_pointer(said.address + 12), 5)
	text_from(shown, 16)
}
# a compiler's build stamp (stamped): `warp.wasm of 1792a05d8a · built 2026-10-28 20:25`
def compiler_stamp(file: text, name: text, rebuild: text): text := {
	wasm = read_file(file)
	if wasm.length == 0 { return joined(joined(joined(name, " missing (warp rebuild "), rebuild), ")") }
	stamp = custom_section(wasm, "warp.build")
	if stamp.length == 0 { return joined(name, " unstamped") }
	commit = field(stamp, 3, NEWLINE)
	built = field(stamp, 4, NEWLINE)
	shown_length = if commit.length > 10 then 10 else commit.length
	of = if commit.length > 0 then joined(" of ", text_from(commit.address, shown_length as u32)) else " of no commit"
	if built.length > 0 then joined(joined(joined(name, of), " · built "), built) else joined(name, of)
}
# a file of warp code: its name ends in .warp, or a file of that name exists
def is_warp_file(name: text): bool := ends_with(name, ".warp") or read_file(name).length > 0

# the words that only say how to run what follows: `run`, `pure` and `eval` what the bare words do, `self` by
# warp-self.wasm, `fast` (lib/fast_math.warp) at full precision yet
def is_prefix(word: text): bool := same_text(word, "run") or same_text(word, "pure") or same_text(word, "eval") or same_text(word, "self") or same_text(word, "fast")
# what the words from `first` on ask for, by the compiler: a command the native warp runs itself, a module, a file,
# else warp.wasm's command or code
def dispatched(compiler: text, prefixed: bool, first: int): nothing := {
	if arg_count() <= first {
		if prefixed { return helped(compiler) }
		if isatty(STDIN) == 0 { return piped_program(compiler) }
		# bare `warp` on a terminal: the version and the help first, then the console
		versioned(compiler)
		helped(compiler)
		return console(compiler)
	}
	word = arg(first)
	if ends_with(word, ".wasm") { return module_ran(first) }
	if not prefixed {
		if same_text(word, "rebuild") { return rebuild_command(first) }
		if same_text(word, "test") { return tests_run(compiler, flagged("--self")) }
		if same_text(word, "beautify") or same_text(word, "fix") or same_text(word, "format") or same_text(word, "lint") { return compiled_and_run(compiler, joined(library_folder(), "/fix/command.warp"), 1) }
		if same_text(word, "docs") or same_text(word, "wiki") or same_text(word, "home") { return documentation_opened() }
	}
	if same_text(word, "repl") or same_text(word, "console") or same_text(word, "start") { return console(compiler) }
	if same_text(word, "repl-line") { return line_ran(compiler, arg(first + 1), arg(first + 2)) }
	if same_text(word, "version") or same_text(word, "--version") { return versioned(compiler) }
	# a plain `warp app.warp` serves its routes (lib/web.warp routes_end), `warp run app.warp` runs it once
	if is_warp_file(word) and not prefixed { setenv(c_string("WARP_SERVE"), c_string("yes"), 1) }
	# and the program knows its file (lib/storage.warp keeps its tables beside it)
	if is_warp_file(word) { setenv(c_string("WARP_PROGRAM"), c_string(word), 1) }
	if is_warp_file(word) { return compiled_and_run(compiler, word, first + 1) }
	hosted(compiler, first)
}
# warp.wasm's help
def helped(compiler: text): nothing := {
	given = compiler_arguments(compiler)
	added(given, "help")
	file_ran(compiler, given)
}
# `warp docs`: where the documentation is, opened in the browser where one opens
def documentation_opened(): nothing := {
	print("Warp documentation can be found at https://github.com/pannous/warp/wiki")
	command_output("open https://github.com/pannous/warp/ 2>/dev/null || xdg-open https://github.com/pannous/warp/ 2>/dev/null")
}

# the options warp takes before or after its command word (wiki/cli.md), each a setting of the environment the
# compiler reads: `--no-hints` is WARP_HINTS=0 (wiki/warning.md). Words after the file or code are the program's
def option_set(word: text): bool := {
	if same_text(word, "--no-hints") {
		setenv(c_string("WARP_HINTS"), c_string("0"), 1)
		return yes
	}
	no
}
# the first word from `at` on that is no option, the options before it set
def past_options(at: int): int := {
	i = at
	while i < arg_count() and option_set(arg(i)) { i = i + 1 }
	i
}
# `warp fuel <steps> <file|code…>`: the program counts steps (WARP_FUEL), out of fuel after them
start = past_options(1)
counting = arg_count() > start + 2 and same_text(arg(start), "fuel")
if counting { setenv(c_string("WARP_FUEL"), c_string(arg(start + 1)), 1) }
prefixed = counting or (arg_count() > start and is_prefix(arg(start)))
first = past_options(if counting then start + 2 else if prefixed then start + 1 else start)
# warp.wasm's own commands (build) read the same lib/ as this executable, and its stable name, the run path of the
# executables `warp build native` makes (commands.warp native_links); WARP_LIB names it resolved, as the module's WASI
# reaches it (no link to an absolute path)
setenv(c_string("WARP_LIB_LINK"), c_string(library_found()), 0)
setenv(c_string("WARP_LIB"), c_string(library_folder()), 1)
# and know the native warp hosts them (commands.warp: what it runs itself, what it lacks yet)
setenv(c_string("WARP_HOST"), c_string("the native warp"), 1)
if prefixed and same_text(arg(start), "fast") { complain("note: warp fast is not in the native warp yet; running at full precision") }
dispatched(if prefixed and same_text(arg(start), "self") then joined(library_folder(), "/warp-self.wasm") else compiler_path(), prefixed, first)
