#!/usr/bin/env warp
@primitive
# `warp test [--self] [--each] [folder or file…]` on the native warp (card native-warp-test):
# warp.wasm lists the cases into a work folder (extensions/commands/tests.warp test-list), each
# run of a case's code is a child process this warp forks (as `warp run <code>`, `warp self <code>` for --self, would
# run it, card resident-wasm-instance: the engine and the machine code of the compiler and modules loaded once before,
# resident_loaded; a trap, crash or hang ends only its own child) in the test file's folder with the value printed as data (WARP_VALUE_AS_DATA), its output, errors and exit status written beside
# its code, and how long it took (<run>.ms); the children run in parallel, each in a slot of the machine's pool, each
# with CPU_SECONDS of CPU, one still running after WALL_SECONDS killed (either a TIME, no failure); then warp.wasm
# prints the verdicts, the cases over a second and the total (test-verdicts), the exit status 1 when one failed

creat(path: pointer, mode: i32): i32 from "c"
chdir(path: pointer): i32 from "c"
flock(descriptor: i32, operation: i32): i32 from "c"
kill(child: i32, signal: i32): i32 from "c"
usleep(microseconds: i32): i32 from "c"
setrlimit(resource: i32, limit: pointer): i32 from "c"
getloadavg(loads: pointer, count: i32): i32 from "c"

# a case's budget is CPU time, which a loaded machine doesn't shrink; the wall clock only ends a case that waits
# forever, WALL_SECONDS stretched by the runnable processes per core (load 40 on 10 cores gave a case a quarter of one,
# so its 30 s of CPU outlasted 120 s; scripts/samples.sh keeps the same rule)
CPU_SECONDS = 30
WALL_SECONDS = 120
RLIMIT_CPU = 0
# 128 + SIGXCPU
CPU_LIMIT_HIT = 152
FILE_MODE = 420
# flock's LOCK_EX | LOCK_NB
LOCKED_NOW = 6
# waitpid's WNOHANG
NOT_WAITING = 1
KILLED = 9
POLL_MICROSECONDS = 5000
SLOT_WAIT_MICROSECONDS = 20000
# how often a run says on stderr how far it got: a long run, or one waiting for a slot every other `warp test` holds,
# is never silent
PROGRESS_MILLISECONDS = 60000
MAX_SLOTS = 256
# how often a run counts the compiler builds again, its slots following them (slot_count)
SLOT_RECOUNT_MILLISECONDS = 3000
# a slot's child: its pid (0 for a free slot), its run's line, when it started, its slot's lock
struct Child { pid: i32; run: i64; started: i64; lock: i32 }
CHILD_BYTES = 32

tests_run(compiler: text, by_self: bool, first: int): nothing := {
	work = joined(text_from(compiled_path().address, compiled_path().length - 5), ".tests")
	command_output(joined(joined("rm -rf '", work), "'"))
	mkdir(c_string(work), FOLDER_MODE)
	# before any other engine: one with wasmtime's cache starts its worker thread, whose locks a fork can leave held
	setenv(c_string("WARP_ONE_THREAD"), c_string("1"), 1)
	resident_loaded(compiler)
	listed_apart(compiler, test_words(compiler, "test-list", work, first))
	required(joined(work, "/runs"), work)
	runs = read_file(joined(work, "/runs"))
	setenv(c_string("WARP_NO_WINDOW"), c_string("1"), 1)
	setenv(c_string("WARP_HINTS"), c_string("0"), 1)
	setenv(c_string("WARP_VALUE_AS_DATA"), c_string("1"), 1)
	# a test checks what main gives: its timers fire none (core/native/driver.warp events; the samples sweep runs them)
	setenv(c_string("WARP_EVENTS_FOR"), c_string("0"), 0)
	all_ran(work, runs, if by_self then "self" else "run")
	unsetenv(c_string("WARP_VALUE_AS_DATA"))
	unsetenv(c_string("WARP_ONE_THREAD"))
	required(compiler, work)
	file_ran(compiler, test_words(compiler, "test-verdicts", work, first))
	required(joined(work, "/failed"), work)
	failed = read_file(joined(work, "/failed"))
	command_output(joined(joined("rm -rf '", work), "'"))
	if not same_text(failed, "0") { exit(1) }
}
# the cases listed by the compiler in a child, this process waiting for it, its failure the run's: a module's WASI
# calls start wasmtime's tokio threads, which a case forked later would wait on forever (they stay behind in a fork)
listed_apart(compiler: text, given: Arguments): nothing := {
	pid = fork()
	if pid == 0 {
		file_ran(compiler, given)
		exit(0)
	}
	status = allocate(4)
	waitpid(pid, status, 0)
	code = exit_code(word_at(status).value as i32)
	if code != 0 { exit(code) }
}
# a file the run needs, said missing on stderr with the work folder (kept to look into), status 1: a compiler an
# install pruned mid-run, verdicts that never got written
required(path: text, work: text): nothing := {
	if access(c_string(path), READABLE) != 0 {
		complain(joined(joined(joined(joined("warp test: ", path), " is missing (the run's work folder: "), work), ")"))
		exit(1)
	}
}
# the compiler's arguments for a test command: the command, the work folder, then this warp's words after `test` (at
# `first`, after a `self` before it)
test_words(compiler: text, command: text, work: text, first: int): Arguments := {
	given = words(compiler, command, work, "", "", "")
	for i in (first + 1)..arg_count() { added(given, arg(i)) }
	given
}

# every run of the work folder's list run by a child, as many at once as the machine's pool has slots
all_ran(work: text, runs: text, prefix: text): nothing := {
	total = if runs.length == 0 then 0 else field_count(runs, NEWLINE)
	# (the children's table holds the most slots a run can have; how many of them it fills follows the builds)
	capacity = slot_capacity()
	slots = slot_count()
	counted = milliseconds_now()
	pool = slots_folder()
	children = allocate(capacity * CHILD_BYTES)
	next = 0
	done = 0
	status = allocate(4)
	reported = milliseconds_now()
	cores = machine_cores()
	loads = allocate(8)
	while done < total {
		if milliseconds_now() - counted > SLOT_RECOUNT_MILLISECONDS {
			slots = slot_count()
			counted = milliseconds_now()
		}
		for k in 0..capacity {
			child = child_at(children + k * CHILD_BYTES)
			if child.pid == 0 and next < total and running_count(children, capacity) < slots {
				lock = taken_slot(pool, slots)
				if lock >= 0 {
					child.pid = started_run(work, field(runs, next, NEWLINE), prefix, children, capacity)
					child.run = next
					child.started = milliseconds_now()
					child.lock = lock
					next = next + 1
					# a failed fork's -1 is no child: kill(-1) would end every process of the user
					if child.pid < 0 {
						run_ended(work, field(runs, child.run, NEWLINE), "fork failed", child)
						done = done + 1
					}
				}
			}
		}
		ended = waitpid(-1, status, NOT_WAITING)
		for k in 0..capacity {
			child = child_at(children + k * CHILD_BYTES)
			if child.pid > 0 and child.pid == ended {
				run_ended(work, field(runs, child.run, NEWLINE), status_said(exit_code(word_at(status).value as i32)), child)
				done = done + 1
			}
			if child.pid > 0 and milliseconds_now() - child.started > WALL_SECONDS * 1000 and milliseconds_now() - child.started > wall_seconds(cores, loads) * 1000 {
				kill(child.pid, KILLED)
				waitpid(child.pid, status, 0)
				run_ended(work, field(runs, child.run, NEWLINE), time_status("still running after ", wall_seconds(cores, loads), " s"), child)
				done = done + 1
			}
		}
		if ended <= 0 { usleep(POLL_MICROSECONDS) }
		if milliseconds_now() - reported > PROGRESS_MILLISECONDS {
			complain(progress_line(done, total, running_count(children, capacity), slots))
			reported = milliseconds_now()
		}
	}
}
# `warp test: 812 of 4561 runs done, 3 running`; none running: every slot of the shared pool is another run's
progress_line(done: int, total: int, running: i32, slots: i32): text := {
	line = joined(joined(joined(joined(joined("warp test: ", text_of(done)), " of "), text_of(total)), " runs done, "), joined(text_of(running), " running"))
	if running > 0 { return line }
	joined(line, joined(joined(", waiting for one of the ", text_of(slots)), " test slots every `warp test` shares (~/.cache/warp/test-slots)"))
}
running_count(children: pointer, slots: i32): i32 := {
	running = 0 as i32
	for k in 0..slots { if child_at(children + k * CHILD_BYTES).pid > 0 { running = running + 1 } }
	running
}
child_at(address: pointer): Child := address
# a run's status and milliseconds written, its slot freed
run_ended(work: text, run: text, status: text, child: Child): nothing := {
	id = joined(joined(work, "/"), field(run, 0, TAB))
	write_file(joined(id, ".status"), status)
	write_file(joined(id, ".ms"), text_of(milliseconds_now() - child.started))
	close(child.lock)
	child.pid = 0
}
# a run's exit code as its status, `time` and why for one that used its CPU budget
status_said(code: i32): text := if code == CPU_LIMIT_HIT then time_status("used its ", CPU_SECONDS, " s of CPU") else text_of(code)
time_status(before: text, seconds: int, after: text): text := joined(joined(joined("time ", before), text_of(seconds)), after)
# waitpid's status as the exit code, 128 and the signal for a child a signal ended
exit_code(status: i32): i32 := if status % 256 == 0 then status / 256 % 256 else 128 + status % 128

# a child running the run `<id>\t<folder>`: this warp's command `run` (or `self`) with the code, in the folder, its
# output and errors into the run's files; the locks of the other slots closed in it
started_run(work: text, run: text, prefix: text, children: pointer, slots: i32): i32 := {
	id = joined(joined(work, "/"), field(run, 0, TAB))
	folder = c_string(field(run, 1, TAB))
	given = arguments()
	added(given, executable_path())
	added(given, prefix)
	added(given, read_file(joined(id, ".code")))
	output = c_string(joined(id, ".out"))
	errors = c_string(joined(id, ".err"))
	budget = allocate(16)
	long_at(budget).value = CPU_SECONDS
	long_at(budget + 8).value = CPU_SECONDS
	pid = fork()
	if pid == 0 {
		setrlimit(RLIMIT_CPU, budget)
		for k in 0..slots {
			other = child_at(children + k * CHILD_BYTES)
			if other.pid != 0 { close(other.lock) }
		}
		chdir(folder)
		dup2(creat(output, FILE_MODE), 1)
		dup2(creat(errors, FILE_MODE), 2)
		arguments_replaced(given.pointers, given.count)
		command_ran()
		exit(0)
	}
	pid
}

# the number of slots in the machine's pool: WARP_TEST_SLOTS, else the cores, each compiler build taking BUILD_CORES
# of them and the tests one more back, at least WHILE_BUILDING (scripts/rebuild.sh's build slots: a load of 33 on 10
# cores came from tests beside 3 builds; card shared-test-slot: one slot for every test run beside a build starved
# them, so the count follows the builds as they start and end)
BUILD_CORES = 2
WHILE_BUILDING = 2
machine_cores(): i32 := number_of(trimmed_end(command_output("getconf _NPROCESSORS_ONLN")))
# the wall clock a case may take: WALL_SECONDS, stretched by the machine's runnable processes per core (loads: room
# for getloadavg's one double)
wall_seconds(cores: i32, loads: pointer): i64 := {
	share = if getloadavg(loads, 1) == 1 and cores > 0 then float_at(loads).value / (cores as f64) else 1.0
	(WALL_SECONDS as f64 * (if share > 1.0 then share else 1.0)) as i64
}
slot_count(): i32 := {
	given = getenv("WARP_TEST_SLOTS")
	if given.length > 0 { return within_slots(number_of(given)) }
	cores = machine_cores()
	builds = builds_running()
	beside = cores - BUILD_CORES * builds + 1
	within_slots(if builds == 0 then cores else if beside < WHILE_BUILDING then WHILE_BUILDING else beside)
}
# the most slots a run can fill: those it is given, else the cores
slot_capacity(): i32 := {
	given = getenv("WARP_TEST_SLOTS")
	within_slots(if given.length > 0 then number_of(given) else machine_cores())
}
within_slots(count: i32): i32 := if count < 1 then 1 else if count > MAX_SLOTS then MAX_SLOTS else count
# the compiler builds running: each holds one of the store's build slots (<store>/build-slots/1 …, WARP_COMPILER_STORE,
# else /Volumes/Build/compilers, else ~/.cache/warp/compilers), its lock taken by another
MAX_BUILD_SLOTS = 16
builds_running(): i32 := {
	given = getenv("WARP_COMPILER_STORE")
	store = if given.length > 0 then given else if access(c_string("/Volumes/Build/compilers"), READABLE) == 0 then "/Volumes/Build/compilers" else joined(getenv("HOME"), "/.cache/warp/compilers")
	builds = 0 as i32
	for slot in 1..MAX_BUILD_SLOTS + 1 {
		path = c_string(joined(joined(store, "/build-slots/"), text_of(slot)))
		if access(path, READABLE) != 0 { return builds }
		lock = creat(path, FILE_MODE)
		if lock >= 0 and flock(lock, LOCKED_NOW) != 0 { builds = builds + 1 }
		if lock >= 0 { close(lock) }
	}
	builds
}
# the folder of the machine's pool of slots (card shared-test-slots: lock files shared by every `warp test` there is),
# made once a run (a shell made it at each try for a slot: 50 a second while all were taken)
slots_folder(): text := {
	folder = joined(getenv("HOME"), "/.cache/warp/test-slots")
	command_output(joined(joined("mkdir -p '", folder), "'"))
	folder
}
# a free slot of that pool, its lock held until closed; -1 after waiting a while for one
taken_slot(folder: text, slots: i32): i32 := {
	first = getpid() % slots
	for offset in 0..slots {
		lock = creat(c_string(joined(joined(folder, "/"), text_of((first + offset) % slots))), FILE_MODE)
		if lock >= 0 and flock(lock, LOCKED_NOW) == 0 { return lock }
		if lock >= 0 { close(lock) }
	}
	usleep(SLOT_WAIT_MICROSECONDS)
	-1
}
# the digits of a text as a number, 0 for none
number_of(t: text): i32 := {
	n = 0 as i32
	for i in 0..t.length {
		digit = byte_at(t.address + i).value as i32 - 48
		if digit >= 0 and digit <= 9 { n = n * 10 + digit }
	}
	n
}
# one of this warp's words is the flag
flagged(flag: text): bool := {
	for i in 1..arg_count() { if same_text(arg(i), flag) { return yes } }
	no
}
