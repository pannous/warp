## texts
# the i64 at a C pointer
native_long(at: handle): i64 := {
	cell = allocate(8)
	memcpy(cell, at, 8)
	long_at(cell).value
}
# the bytes of a wasm_byte_vec_t (its size, then its data) at a C pointer, as a text; a trailing NUL left out
native_vector_text(vector: handle): text := {
	size = native_long(vector)
	copy = allocate(size as i32)
	memcpy(copy, native_long(vector + 8), size)
	if size > 0 and byte_at(copy + size - 1).value == 0 { size = size - 1 }
	text_from(copy, size as u32)
}
same_text(a: text, b: text): bool := a.length == b.length and memcmp(a.address, b.address, a.length) == 0
starts_with(t: text, start: text): bool := t.length >= start.length and memcmp(t.address, start.address, start.length) == 0
ends_with(t: text, end: text): bool := t.length >= end.length and memcmp(t.address + t.length - end.length, end.address, end.length) == 0
joined(a: text, b: text): text := {
	copy = allocate((a.length + b.length) as i32)
	memcpy(copy, native_pointer(a.address), a.length)
	memcpy(copy + a.length, native_pointer(b.address), b.length)
	text_from(copy, a.length + b.length)
}
# the folder of a path, "." for a bare name
folder_of(path: text): text := {
	last = -1
	for i in 0..path.length { if byte_at(path.address + i).value == SLASH { last = i } }
	if last < 0 then "." else text_from(path.address, last as u32)
}
# t and a zero byte after it, as C reads a string
c_string(t: text): pointer := {
	copy = allocate((t.length + 1) as i32)
	memcpy(copy, native_pointer(t.address), t.length)
	byte_at(copy + t.length).value = 0
	copy
}

# a line on stderr
complain(line: text): nothing := {
	fd_write(STDERR, line, 1, allocate(4))
	fd_write(STDERR, "\n", 1, allocate(4))
}
# a failed call: the module's exit status if it exited, else the error's or the trap's message, status 1
failed(error: handle, trap: pointer): nothing := failed_raising(error, trap, "")
# a failed call of a module that may have raised: the module's exit status if it exited, else the sentence of the
# runtime error it failed in (raised_message) or, when none failed, the error's or the trap's message, status 1
failed_raising(error: handle, trap: pointer, raised: text): nothing := {
	message = allocate(VECTOR_BYTES)
	if error != 0 {
		status = allocate(4)
		if wasmtime_error_exit_status(error, status) { exit(word_at(status).value as i32) }
	}
	# the engine's message carries the wasm backtrace, by function name: WARP_BACKTRACE=1 shows it beside the sentence
	if raised.length == 0 or same_text(getenv("WARP_BACKTRACE"), "1") {
		if error != 0 { wasmtime_error_message(error, message) } else { wasm_trap_message(long_at(trap).value, message) }
		complain(native_vector_text(native_pointer(message)))
	}
	if raised.length > 0 { complain(place_first(raised)) }
	exit(1)
}
# "<words> at f.warp:16:7<; fix: …>" said as "f.warp:16:7 <words><; fix: …>", the place first so
# editors and build tools jump there (a space after it, no colon: their patterns take that whether or not they allow one); a sentence naming no file:line:column stays as it is
place_first(sentence: text): text := {
	for at in 0..sentence.length {
		if starts_with(text_from(sentence.address + at, (sentence.length - at) as u32), " at ") {
			stop = at + 4
			while stop < sentence.length and byte_at(sentence.address + stop).value != SPACE and byte_at(sentence.address + stop).value != SEMICOLON { stop = stop + 1 }
			place = text_from(sentence.address + at + 4, (stop - at - 4) as u32)
			if is_file_place(place) {
				words = joined(text_from(sentence.address, at as u32), text_from(sentence.address + stop, (sentence.length - stop) as u32))
				return joined(joined(place, " "), words)
			}
		}
	}
	sentence
}
# `f.warp:16:7`: a file, a colon, digits, a colon, digits
is_file_place(word: text): bool := {
	column = digits_start(word, word.length)
	if column == word.length or column < 2 or byte_at(word.address + column - 1).value != COLON { return no }
	line = digits_start(word, column - 1)
	line > 1 and line < column - 1 and byte_at(word.address + line - 1).value == COLON
}
# where the run of digits that ends before `end` begins
digits_start(word: text, end: int): int := {
	start = end
	while start > 0 and is_digit(byte_at(word.address + start - 1).value) { start = start - 1 }
	start
}
# a run's stdout and stderr: this process's, else the file `output`
output_to(config: handle, output: text): nothing := {
	if output.length == 0 {
		wasi_config_inherit_stdout(config)
		return wasi_config_inherit_stderr(config)
	}
	wasi_config_set_stdout_file(config, output)
	wasi_config_set_stderr_file(config, output)
}
# what a run that failed says, as failed_raising says it without ending this process: "" for an exit with status 0
failure_said(error: handle, trap: pointer, raised: text): text := {
	status = allocate(4)
	if error != 0 and wasmtime_error_exit_status(error, status) {
		if word_at(status).value == 0 { return "" }
		return joined("exit status ", text_of(word_at(status).value as i64))
	}
	if raised.length > 0 { return raised }
	message = allocate(VECTOR_BYTES)
	if error != 0 { wasmtime_error_message(error, message) } else { wasm_trap_message(long_at(trap).value, message) }
	native_vector_text(native_pointer(message))
}
checked(error: handle, trap: pointer): nothing := {
	if error != 0 or long_at(trap).value != 0 { failed(error, trap) }
}

## where things are
# this executable's own path
executable_path(): text := {
	path = allocate(PATH_BYTES)
	# Linux: the link /proc/self/exe names it (macOS has no /proc)
	length = readlink(c_string("/proc/self/exe"), path, PATH_BYTES)
	if length > 0 { return text_from(path, length as u32) }
	# macOS: dyld says it (a C function Linux lacks, looked up only when called)
	size = allocate(4)
	word_at(size).value = PATH_BYTES
	if _NSGetExecutablePath(path, size) == 0 { return text_from(path, c_length(path)) }
	complain("this executable's path is unknown: neither /proc/self/exe (Linux) nor _NSGetExecutablePath (macOS) says it")
	exit(1)
	text_from(path, 0)
}
# this executable's path as the shell named it, its links kept (~/dev/bin/warp, not the build it links to): arg 0 when
# it names a folder, else the first of $PATH's folders holding it; else its own path
invoked_path(): text := {
	named = arg(0)
	if starts_with(named, "/") { return named }
	if contains_byte(named, SLASH) { return joined(joined(current_folder(), "/"), named) }
	folders = getenv("PATH")
	for i in 0..field_count(folders, COLON) {
		candidate = joined(joined(field(folders, i, COLON), "/"), named)
		if access(c_string(candidate), EXECUTABLE) == 0 { return candidate }
	}
	executable_path()
}
contains_byte(t: text, byte: int): bool := field_count(t, byte) > 1
current_folder(): text := {
	folder = allocate(PATH_BYTES)
	getcwd(folder, PATH_BYTES)
	text_from(folder, c_length(folder))
}
# the module appended to this executable, else the empty text: at its end, or, in a Mach-O executable signed after
# the module was appended (`warp build`), where its signature begins
appended_module(): text := {
	self = read_file(executable_path())
	at_end = module_before(self, self.length)
	if at_end.length > 0 then at_end else module_before(self, signature_offset(self))
}
# the module whose trailer ends at `end` of the image, else the empty text
module_before(image: text, end: u32): text := {
	last = image.address + end
	# the zeros that pad the trailer to a multiple of 16
	for i in 0..TRAILER_BYTES { if end >= TRAILER_BYTES and byte_at(last - 1).value == 0 { last = last - 1 } }
	if end < TRAILER_BYTES or long_at(last - 8).value != MODULE_MAGIC { return text_from(0, 0) }
	size = long_at(last - TRAILER_BYTES).value as u32
	text_from(last - TRAILER_BYTES - size, size)
}
# where the code signature of a Mach-O executable begins (its LC_CODE_SIGNATURE's data offset), else its length
signature_offset(image: text): u32 := {
	if image.length < MACHO_HEADER or word_at(image.address).value != MACHO_MAGIC { return image.length }
	at = image.address + MACHO_HEADER
	for i in 0..word_at(image.address + COMMAND_COUNT_AT).value {
		if word_at(at).value == CODE_SIGNATURE { return word_at(at + SIGNATURE_OFFSET_AT).value }
		at = at + word_at(at + 4).value
	}
	image.length
}
# warp's lib/, whose warp.wasm compiles a .warp file, in one search order: $WARP_LIB, else the first folder holding a
# lib/ (its prelude.warp) of this executable's folder (a tarball), its lib/ (~/dev/bin/lib, which the install keeps
# linked to the current build), the folder its links lead to, and <prefix>/share/warp beside that folder's bin/ (brew,
# deb, pip: bin/warp links to it); none is an error naming them. The folder as found, its links kept, is a stable
# name for it (an install replaces the build behind the link): what a native build's executables find libraries by
library_folder(): text := resolved_path(library_found())
library_found(): text := {
	given = getenv("WARP_LIB")
	if given.length > 0 { return given }
	found = installed_found()
	if found.length > 0 { return found }
	own = folder_of(invoked_path())
	linked = folder_of(resolved_path(executable_path()))
	complain(joined(joined(joined(joined(joined(joined("warp: no lib/ (prelude.warp) in ", own), ", "), linked), " or "), joined(folder_of(linked), "/share/warp")), "; WARP_LIB names one"))
	exit(1)
	own
}
# the installed warp's lib/, whatever $WARP_LIB names: its runtime and modules of a finished build; a copy of the
# executable without one (self-check.sh runs one in a scratch folder) has the library folder
installed_library(): text := {
	found = installed_found()
	if found.length > 0 then resolved_path(found) else library_folder()
}
# the first folder holding a lib/ beside the executable, its links followed, or of its share/warp; empty for none
installed_found(): text := {
	own = folder_of(invoked_path())
	linked = folder_of(resolved_path(executable_path()))
	shared = joined(folder_of(linked), "/share/warp")
	if holds_library(own) { return own }
	if holds_library(joined(own, "/lib")) { return joined(own, "/lib") }
	if holds_library(linked) { return linked }
	if holds_library(shared) { return shared }
	""
}
holds_library(folder: text): bool := access(c_string(joined(folder, "/prelude.warp")), READABLE) == 0
# the path with its links resolved, the path itself when it names no file
resolved_path(path: text): text := {
	resolved = realpath(c_string(path), 0)
	if resolved == 0 { return path }
	copy = native_copy(resolved, strlen(resolved))
	free(resolved)
	copy
}
# real_path(path_at, length, result_at, room) of the runtime's file words (core/runtime/extended/wasi.warp
# opened_entry), its memory's path at path_at: its real path written at result_at, its length the result; -1 for the
# path itself
real_path_written(caller: handle, context: handle, given: pointer, results: pointer): nothing := {
	memory = guest_memory(caller, context)
	path = native_copy(memory + word_at(given + VALUE_OFFSET).value as i64, word_at(given + VALUE_BYTES + VALUE_OFFSET).value as i64)
	real = real_path_of(path)
	room = word_at(given + 3 * VALUE_BYTES + VALUE_OFFSET).value
	written = if same_text(real, path) or real.length > room then -1 else real.length as i32
	if written >= 0 { memmove(memory + word_at(given + 2 * VALUE_BYTES + VALUE_OFFSET).value as i64, native_pointer(real.address), real.length as i64) }
	byte_at(results).value = KIND_I32
	word_at(results + VALUE_OFFSET).value = written as u32
}
# the path with the links on its way followed, as WASI follows none to an absolute path; a file not there yet at its
# folder's real path; the path itself when neither resolves
real_path_of(path: text): text := {
	whole = resolved_path(path)
	if not same_text(whole, path) { return whole }
	folder = folder_of(path)
	real_folder = resolved_path(if folder.length == 0 then "/" else folder)
	if same_text(real_folder, folder) then path else joined(joined(real_folder, "/"), last_name(path))
}
# the run's time zone named in TZ, which lib/time.warp's now reads (decision local-now): where TZ names none (unset, or
# a path such as macOS's /etc/localtime) the system's zone, the end of /etc/localtime's link after zoneinfo/
name_time_zone(): i32 := {
	given = getenv("TZ")
	zone = system_zone_name()
	if (given.length == 0 or starts_with(given, "/") or starts_with(given, ":")) and zone.length > 0 then setenv(c_string("TZ"), c_string(zone), 1) else 0
}
system_zone_name(): text := {
	target = allocate(PATH_BYTES)
	length = readlink(c_string("/etc/localtime"), target, PATH_BYTES)
	if length <= 0 { return "" }
	link = text_from(target, length as u32)
	for i in 0..link.length {
		rest = text_from(link.address + i, (link.length - i) as u32)
		if starts_with(rest, "zoneinfo/") { return text_from(rest.address + 9, rest.length - 9) }
	}
	""
}
# the name after a path's last slash
last_name(path: text): text := {
	last = -1
	for i in 0..path.length { if byte_at(path.address + i).value == SLASH { last = i } }
	text_from(path.address + last + 1, (path.length - last - 1) as u32)
}
# where the compiled module goes for its run: a file of this process in $TMPDIR
compiled_path(): text := joined(joined(joined(temporary_folder(), "warp-native-"), text_of(getpid())), ".wasm")
# $TMPDIR, ending in a slash
temporary_folder(): text := {
	folder = getenv("TMPDIR")
	if folder.length == 0 { folder = "/tmp/" }
	if ends_with(folder, "/") then folder else joined(folder, "/")
}

## a module's run
# the WASI arguments of a module: C strings, an array of their pointers
struct Arguments { pointers: pointer; count: i32 }
arguments(): Arguments := Arguments(allocate(MAX_ARGUMENTS * 8), 0)
added(list: Arguments, t: text): nothing := {
	long_at(list.pointers + list.count * 8).value = native_pointer(c_string(t))
	list.count = list.count + 1
}
# the driver's own arguments from `first` on
given_from(first: int): Arguments := {
	list = arguments()
	for i in first..arg_count() { added(list, arg(i)) }
	list
}
# a program's arguments: its name, then the driver's from `first` on, a `--` there left out (`warp app.warp -- a b`)
program_arguments(name: text, first: int): Arguments := {
	list = arguments()
	added(list, name)
	start = if first < arg_count() and same_text(arg(first), "--") then first + 1 else first
	for i in start..arg_count() { added(list, arg(i)) }
	list
}
# the module the driver's word `at` names, run with the words after it
module_ran(at: int): nothing := {
	module = read_file(arg(at))
	if module.length == 0 {
		complain(joined("no module at ", arg(at)))
		exit(1)
	}
	run(module, program_arguments(arg(at), at + 1), "", PROGRAM_GC_HEAP_BYTES)
}

# what main gave, printed as its kind is
print_result(result: pointer): nothing := {
	kind = byte_at(result).value
	value = result + VALUE_OFFSET
	if kind == KIND_I32 { print text_of(word_at(value).value as i32) }
	if kind == KIND_I64 { print text_of(long_at(value).value) }
	if kind == KIND_F32 or kind == KIND_F64 {
		number = if kind == KIND_F64 then float_at(value).value else single_at(value).value
		buffer = allocate(32)
		gcvt(number, FLOAT_DIGITS, buffer)
		print text_from(buffer, c_length(buffer))
	}
}
struct Double { value: f64 }
struct Single { value: f32 }
float_at(address: pointer): Double := address
single_at(address: pointer): Single := address

# The GC heap a run starts with: reserved, committed lazily, growing as the
# run needs (decision heap-per-run). A compiler building the compiler starts large: one starting small collects at each
# of its many growths (the native `warp rebuild` 6:03 -> ~2 min, card wasmtime-native-rebuild; at 128 MB 698 -> 1408 s);
# 1 GB over 512 MB: the self compile 75.6 -> 68.6 s CPU (-9%), peak RSS 595 -> 1107 MB (card gc-heap-measure).
# A compiler compiling a program starts small, as a program does: one that never fills its heap never collects, so
# every byte it makes stays (hello 218 -> 101 MB RSS, sudoku 663 -> 106 MB, as fast; card compile-memory-limit). The
# machine code holds the size, so each is kept apart (machine_code_file)
BUILDER_GC_HEAP_BYTES = 1073741824
COMPILER_GC_HEAP_BYTES = 67108864
PROGRAM_GC_HEAP_BYTES = 67108864
# A program's fuel when it counts steps (decision fuel-metering): wasmtime burns about one
# a WASM instruction; counting makes calls about four times slower, so only runs that ask for it count
DEFAULT_FUEL = 100000000000
OUT_OF_FUEL = 11
ZERO = 48
UNDERSCORE = 95
# the steps a program run counts: WARP_FUEL's (`warp fuel <steps>`), else the default when the module asks for fuel
# (`use fuel`: its section warp.fuel), else none; a compiler's run (its machine code kept) never counts
fuel_of(module: text, machine_code: text): i64 := {
	if machine_code.length > 0 { return 0 }
	given = getenv("WARP_FUEL")
	if given.length > 0 { return steps_of(given) }
	if custom_section(module, "warp.fuel").address != 0 then DEFAULT_FUEL else 0
}
# the number a text of digits names, underscores between them allowed (1_000_000)
steps_of(digits: text): i64 := {
	steps = 0
	for i in 0..digits.length {
		digit = byte_at(digits.address + i).value
		if digit != UNDERSCORE { steps = steps * 10 + (digit - ZERO) }
	}
	steps
}
# a run out of its fuel, said as every host says it
out_of_fuel(trap: pointer, fuel: i64): nothing := {
	code = allocate(1)
	if fuel > 0 and long_at(trap).value != 0 and wasmtime_trap_code(long_at(trap).value, code) and byte_at(code).value == OUT_OF_FUEL {
		complain(joined(joined("out of fuel after ", text_of(fuel)), " steps: the program may not terminate (raise the budget with WARP_FUEL=<steps> or warp fuel <steps>)"))
		exit(1)
	}
}
# what warp's modules use beside the MVP: GC, typed function references, exceptions,
# fuel metering when the run counts steps,
# warp_wasmtime's copying collector with its initial heap; a program's machine code kept in wasmtime's own cache,
# warp.wasm's beside it (compiled_module); compiled on one thread with WARP_ONE_THREAD (a `warp test` case: its slot
# is one core, else every case compiles on all of them, a load of 200 on 16 cores)
# WARP_PROFILE=perfmap writes each compiled function's address range to /tmp/perf-<pid>.map, which
# scripts/profile.sh maps `sample`'s addresses through (notes/compile_speed.md)
warp_config(fuel: bool, heap_bytes: i64): handle := {
	config = wasm_config_new()
	wasmtime_config_consume_fuel_set(config, fuel)
	wasmtime_config_parallel_compilation_set(config, getenv("WARP_ONE_THREAD").length == 0)
	warp_config_gc_heap_initial_size_set(config, heap_bytes)
	wasmtime_config_wasm_gc_set(config, yes)
	wasmtime_config_wasm_function_references_set(config, yes)
	wasmtime_config_wasm_exceptions_set(config, yes)
	wasmtime_config_cache_config_load(config, 0)
	if same_text(getenv("WARP_PROFILE"), "perfmap") { wasmtime_config_profiler_set(config, PROFILING_PERFMAP) }
	config
}

# the host words the module imports, each defined as its callback (lib/native/foreign.c warp_host_callback, which calls
# host_word) with the type the module declares: std_io, exit, and each C function its warp.c_functions section
# describes; a word the driver doesn't answer as a library's own (library_bound). `guarded`: a C function that opens a
# window refused (headless_checked), but in a module the driver links on its own question, warp's own, which minds
# WARP_NO_WINDOW itself (lazily_linked: the native host module's window)
host_words_defined(linker: handle, engine: handle, context: handle, compiled: handle, module: text, guarded: bool, trap: pointer): nothing := {
	table = custom_section(module, "warp.c_functions")
	imports = allocate(VECTOR_BYTES)
	wasmtime_module_imports(compiled, imports)
	for i in 0..long_at(imports).value {
		import = native_long(long_at(imports + 8).value + i * 8)
		from = native_vector_text(wasm_importtype_module(import))
		name = native_vector_text(wasm_importtype_name(import))
		line = c_line(table, from, name)
		# (a wasm module's export is linked as its instance's, instances_linked, unless values cross into its memory)
		if line.length > 0 and not is_wasm_path(from) {
			if guarded { headless_checked(name, field(line, 1, TAB)) }
			word_defined(linker, import, foreign_of(line, 0), trap)
		}
		if line.length > 0 and is_wasm_path(from) and crosses_memory(line) { word_defined(linker, import, foreign_of(line, wasm_exports_of(linker, context, from, name)), trap) }
		if same_text(from, "host") { host_word_defined(linker, engine, import, name, trap) }
	}
}
# a C function that opens a native window (raylib's InitWindow, SDL's, GLFW's) ends the run before it starts under
# WARP_NO_WINDOW or CI, so no test or agent run pops one up
headless_checked(name: text, library: text): nothing := {
	if opens_window(name) and (getenv("WARP_NO_WINDOW").length > 0 or getenv("CI").length > 0) {
		complain(joined(joined(joined(name, " from "), library), " opens a window: refused under WARP_NO_WINDOW or CI"))
		exit(1)
	}
}
opens_window(name: text): bool := same_text(name, "InitWindow") or same_text(name, "SDL_CreateWindow") or same_text(name, "SDL_CreateWindowAndRenderer") or same_text(name, "glfwCreateWindow")
# the number of a host word the driver answers, else a word that names it when called
answered_word(name: text): i64 := {
	if same_text(name, "std_io") { return STD_IO_WORD }
	if same_text(name, "canonical_text") { return CANONICAL_TEXT_WORD }
	if same_text(name, "channel_listen") { return CHANNEL_LISTEN_WORD }
	if same_text(name, "channel_pending") { return CHANNEL_PENDING_WORD }
	if same_text(name, "channel_next") { return CHANNEL_NEXT_WORD }
	if same_text(name, "channel_send") { return CHANNEL_SEND_WORD }
	if same_text(name, "exit") { return EXIT_WORD }
	if same_text(name, "sleep_ms") { return SLEEP_WORD }
	if same_text(name, "clock") { return CLOCK_WORD }
	if same_text(name, "random") { return RANDOM_WORD }
	if same_text(name, "random_below") { return RANDOM_BELOW_WORD }
	if same_text(name, "random_seed") { return RANDOM_SEED_WORD }
	if same_text(name, "system_value") { return SYSTEM_VALUE_WORD }
	if same_text(name, "set_system_value") { return SET_SYSTEM_VALUE_WORD }
	if same_text(name, "parse_code") { return PARSE_CODE_WORD }
	if same_text(name, "eval_code") { return EVAL_CODE_WORD }
	if same_text(name, "real_path") { return REAL_PATH_WORD }
	if same_text(name, "std_pure") { return STD_PURE_WORD }
	if same_text(name, "paint") { return PAINT_WORD }
	if same_text(name, "save_picture") { return SAVE_PICTURE_WORD }
	if same_text(name, "key_held") { return KEY_HELD_WORD }
	if same_text(name, "signal_listen") { return SIGNAL_LISTEN_WORD }
	unanswered_word(name)
}
# a host word the driver doesn't answer (a library's: draw_shape, gpu_compute, …), as a word that names it when called:
# the address of its name's (address, length), negated
unanswered_word(name: text): i64 := {
	cell = allocate(8)
	word_at(cell).value = name.address as u32
	word_at(cell + 4).value = name.length
	0 - (cell as i64)
}
# a host word neither the driver nor a library beside warp answers, answered by the native host module's
# host_<word> (host_text_coverage) with the values as they are; one it lacks ends the run naming it
host_word_answered(caller: handle, name: text, given: pointer, count: i64, results: pointer, results_count: i64): nothing := {
	context = wasmtime_caller_context(caller)
	function = allocate(EXTERN_BYTES)
	if not host_export(context, joined("host_", name), function) { return unanswered(name) }
	trap = allocate(8)
	long_at(trap).value = 0
	checked(wasmtime_func_call(context, function + 8, given, count, results, results_count, trap), trap)
}
# the run ended naming a host word it called that this host lacks
unanswered(name: text): nothing := {
	complain(joined(joined("the host word ", name), " is not in warp yet"))
	exit(1)
}
# a host word the driver answers, else one a library beside warp owns, bound to that library's callback
# warp_word_<name> (lib/native/foreign.c library_word) with the engine as its data: it reads and builds the module's
# values in place (lib/native/warp_node.h, decision library-direct-refs); else a word naming it when called
host_word_defined(linker: handle, engine: handle, import: handle, name: text, trap: pointer): nothing := {
	word = answered_word(name)
	if word >= 0 { return word_defined(linker, import, word, trap) }
	# (its library looked for at its first call, lib/native/foreign.c warp_lazy_host_callback: a module importing it
	# whose program never calls it opens none)
	type = wasm_externtype_as_functype_const(wasm_importtype_type(import))
	checked(wasmtime_linker_define_func(linker, "host", 4, name, name.length, type, c_function("warp_lazy_host_callback"), lazy_library_word(c_string(name), engine, word), 0), trap)
}
# the import defined as warp_host_callback, `word` its data
word_defined(linker: handle, import: handle, word: i64, trap: pointer): nothing := {
	from = native_vector_text(wasm_importtype_module(import))
	name = native_vector_text(wasm_importtype_name(import))
	type = wasm_externtype_as_functype_const(wasm_importtype_type(import))
	checked(wasmtime_linker_define_func(linker, from, from.length, name, name.length, type, c_function("warp_host_callback"), word, 0), trap)
}

## linked instances (card wasm-module-linking; notes/library_zero_bake.md "The module interface")
# a module importing `warp_runtime` gets runtime.wasm's instance, one importing `warp/<m>` the standard module
# modules/<m>.wasm's, both from the library folder; each instantiated once per run, its own imports linked first, with
# the run's host words, and its `warp/start` (its global initializers) run before what imports it
# (primitive mode has no text constants: the names `warp_runtime`, `warp/` and `warp/start` are written where read)
# `linked`: a cell holding the instance names already defined in the run's linker, each followed by a newline;
# `library`: the folder of runtime.wasm and modules/, built together
instances_linked(linker: handle, engine: handle, context: handle, compiled: handle, linked: pointer, library: text, trap: pointer): nothing := {
	imports = allocate(VECTOR_BYTES)
	wasmtime_module_imports(compiled, imports)
	for i in 0..long_at(imports).value {
		from = native_vector_text(wasm_importtype_module(native_long(long_at(imports + 8).value + i * 8)))
		path = instance_path(from, library)
		if path.length > 0 and not contains_line(cell_text(linked), from) { instance_defined(linker, engine, context, from, path, linked, library, yes, trap) }
	}
}
# where the instance of that import module is: runtime.wasm or modules/<m>.wasm of the library folder, a module the
# program uses by its path (`use counter.wasm`, extensions/c_imports/wasm_modules.warp), else ""
instance_path(from: text, library: text): text := {
	if same_text(from, "warp_runtime") { return joined(library, "/runtime.wasm") }
	if is_wasm_path(from) { return rooted_path(from) }
	prefix = "warp/"
	if not starts_with(from, prefix) { return "" }
	name = text_from(from.address + prefix.length, from.length - prefix.length)
	joined(joined(joined(library, "/modules/"), name), ".wasm")
}
is_wasm_path(from: text): bool := ends_with(from, ".wasm")
# `•/test/fixtures/wasm/counter.wasm` (or `@/…`): the project root, the nearest folder above the working one holding
# .git, plus the rest (decision project-root-paths), so a program and a module it links name one file alike; another
# path as it is
rooted_path(path: text): text := {
	mark = if starts_with(path, "•/") then "•/" else if starts_with(path, "@/") then "@/" else ""
	if mark.length == 0 { return path }
	joined(joined(project_root(current_folder()), "/"), text_from(path.address + mark.length, path.length - mark.length))
}
project_root(folder: text): text := {
	at = folder
	while at.length > 1 {
		if access(c_string(joined(at, "/.git")), READABLE) == 0 { return at }
		at = folder_of(at)
	}
	complain(joined(joined("no folder above ", folder), " holds .git, so a •/ path has no project root"))
	exit(1)
	folder
}
# a text kept in a cell of two longs, its address and length
cell_text(cell: pointer): text := text_from(long_at(cell).value as u32, long_at(cell + 8).value as u32)
text_kept(cell: pointer, t: text): nothing := {
	long_at(cell).value = t.address as i64
	long_at(cell + 8).value = t.length as i64
}
contains_line(lines: text, line: text): bool := {
	at = 0
	while at < lines.length {
		end = at
		while byte_at(lines.address + end).value != NEWLINE { end = end + 1 }
		if same_text(text_from(lines.address + at, (end - at) as u32), line) { return yes }
		at = end + 1
	}
	no
}
# the module at `path` instantiated and defined in the linker as `name`, its start run
instance_defined(linker: handle, engine: handle, context: handle, name: text, path: text, linked: pointer, library: text, guarded: bool, trap: pointer): pointer := {
	text_kept(linked, joined(joined(cell_text(linked), name), "\n"))
	module = read_file(path)
	if module.length == 0 {
		complain(joined(joined(joined("the program links ", name), ", but there is no "), path))
		exit(1)
	}
	compiled = compiled_module(engine, module, machine_code_file(path, PROGRAM_GC_HEAP_BYTES), trap)
	instances_linked(linker, engine, context, compiled, linked, library, trap)
	host_words_defined(linker, engine, context, compiled, module, guarded, trap)
	checked(wasmtime_linker_define_unknown_imports_as_traps(linker, compiled), trap)
	instance = allocate(INSTANCE_BYTES)
	checked(wasmtime_linker_instantiate(linker, context, compiled, instance, trap), trap)
	checked(wasmtime_linker_define_instance(linker, context, name, name.length, instance), trap)
	start = allocate(EXTERN_BYTES)
	start_name = "warp/start"
	if wasmtime_instance_export_get(context, instance, start_name, start_name.length, start) {
		# (a module's start is its main: its value, if any, dropped)
		results_count = native_long(wasm_functype_results(wasmtime_func_type(context, start + 8)))
		checked(wasmtime_func_call(context, start + 8, 0, 0, allocate(VALUE_BYTES * MAX_RESULTS), results_count, trap), trap)
	}
	instance
}

# the module run with the arguments and a GC heap starting at `heap_bytes`; its machine code kept in the file
# `machine_code` when one is named
run(module: text, given: Arguments, machine_code: text, heap_bytes: i64): nothing := run_into(module, given, machine_code, heap_bytes, "")
# so, what it prints written to the file `output` when one is named (an eval's run): its failure then said in the text
# given back ("" for none) instead of ending this process
run_into(module: text, given: Arguments, machine_code: text, heap_bytes: i64, output: text): text := {
	outer = crash_context_running(given.pointers, given.count)
	fuel = fuel_of(module, machine_code)
	engine = wasm_engine_new_with_config(warp_config(fuel > 0, heap_bytes))
	store = wasmtime_store_new(engine, 0, 0)
	context = wasmtime_store_context(store)
	if fuel > 0 { wasmtime_context_set_fuel(context, fuel) }
	linker = wasmtime_linker_new(engine)
	trap = allocate(8)
	checked(wasmtime_linker_define_wasi(linker), trap)
	config = wasi_config_new()
	wasi_config_set_argv(config, given.count, given.pointers)
	wasi_config_inherit_stdin(config)
	output_to(config, output)
	name_time_zone()
	wasi_config_inherit_env(config)
	# the current folder for relative paths and the root for absolute ones, as warp's own host opens them
	wasi_config_preopen_dir(config, ".", ".", yes)
	wasi_config_preopen_dir(config, "/", "/", yes)
	checked(wasmtime_context_set_wasi(context, config), trap)
	srand48(milliseconds_now() xor (getpid() as i64))
	compiled = compiled_module(engine, module, machine_code, trap)
	# (an instance it links and the program define the same host words)
	wasmtime_linker_allow_shadowing(linker, yes)
	linked = allocate(16)
	text_kept(linked, "")
	outer_run = kept_value(RUN_SLOT)
	if outer_run == 0 { timers_forgotten() }
	keep_value(RUN_SLOT, run_state(linker, engine, linked, context) as i64)
	instances_linked(linker, engine, context, compiled, linked, library_folder(), trap)
	host_words_defined(linker, engine, context, compiled, module, yes, trap)
	checked(wasmtime_linker_define_unknown_imports_as_traps(linker, compiled), trap)
	instance = allocate(INSTANCE_BYTES)
	checked(wasmtime_linker_instantiate(linker, context, compiled, instance, trap), trap)
	entry = allocate(EXTERN_BYTES)
	# a GC program's _start runs main and prints its value itself (the stub's ENTRY_POINTS), a primitive one has main
	if not wasmtime_instance_export_get(context, instance, "_start", 6, entry) and not wasmtime_instance_export_get(context, instance, "main", 4, entry) {
		complain("the module exports neither _start nor main")
		exit(1)
	}
	function = entry + 8
	results_count = native_long(wasm_functype_results(wasmtime_func_type(context, function)))
	results = allocate(VALUE_BYTES * MAX_RESULTS)
	error = wasmtime_func_call(context, function, 0, 0, results, results_count, trap)
	out_of_fuel(trap, fuel)
	failure = call_failure(context, instance, error, trap, output)
	if results_count > 0 and output.length == 0 { print_result(results) }
	if failure.length == 0 and outer_run == 0 { failure = events_run(linker, context, instance, output) }
	if failure.length == 0 and outer_run == 0 { host_run_ended(context) }
	crash_context_restored(outer)
	keep_value(RUN_SLOT, outer_run)
	# the run's GC heap, instance and machine code given back: `warp rebuild` runs four compilers in one process, each
	# behind the last (it peaked at 4.8 GB with all of them kept)
	wasmtime_store_delete(store)
	wasmtime_linker_delete(linker)
	wasmtime_module_delete(compiled)
	wasm_engine_delete(engine)
	failure
}
# a run's linker, engine, linked-instances cell and store context, and whether it linked unicode and the native host
# module yet, kept in the run's block: what a host word allocates is given back when it returns (foreign.c
# warp_host_callback)
run_state(linker: handle, engine: handle, linked: pointer, context: handle): pointer := {
	run = allocate((LISTENERS_AT + 8 + LISTENERS_MAX * LISTENER_BYTES) as i32)
	long_at(run + LISTENERS_AT as i32).value = 0
	long_at(run).value = linker
	long_at(run + 8).value = engine
	long_at(run + 16).value = linked as i64
	long_at(run + 24).value = context
	long_at(run + UNICODE_LINKED_AT as i32).value = 0
	long_at(run + HOST_LINKED_AT as i32).value = 0
	run
}
run_context(): handle := long_at(kept_value(RUN_SLOT) as i32 + 24).value
# the export `name` of the standard module `module_name` into `function`, no when it has none: the module linked into
# the run at the first ask, never at its start, so a run that never asks links none; whether it did is kept at `flag`
# of the run's block. A program linked to a runtime gets the module of that runtime's library; a module without one
# (the compiler) the installed warp's, both of a finished build: a `warp rebuild` runs its compilers beside a lib/ whose
# runtime.wasm and modules/ it is writing, which do not fit together until it ends. A library folder without the module
# ends the run naming the file (instance_defined)
lazily_linked(context: handle, module_name: text, flag: i64, name: text, function: pointer): bool := {
	run = kept_value(RUN_SLOT) as i32
	if long_at(run + flag as i32).value == 0 {
		trap = allocate(8)
		long_at(trap).value = 0
		linked = long_at(run + 16).value as i32
		library = if contains_line(cell_text(linked), "warp_runtime") then library_folder() else installed_library()
		instance_defined(long_at(run).value, long_at(run + 8).value, context, module_name, instance_path(module_name, library), linked, library, no, trap)
		# (linked in a host word, its records kept past the word's end)
		arena_kept()
		long_at(run + flag as i32).value = 1
	}
	wasmtime_linker_get(long_at(run).value, context, module_name, module_name.length, name, name.length, function)
}
# `"é" == "e◌́"` (decisions nfc-tables, nfc-slot; notes/text_equality_nfc.md): the runtime's canonical_text, a text's
# NFC by lib/unicode, whose module (modules/unicode.wasm) the run links on this first call (lazily_linked), never a
# silent byte compare
canonical_text_answered(context: handle, given: pointer, result: pointer): nothing := {
	function = allocate(EXTERN_BYTES)
	if not lazily_linked(context, "warp/unicode", UNICODE_LINKED_AT, "canonical_text", function) {
		complain("modules/unicode.wasm exports no canonical_text: warp rebuild writes it anew")
		exit(1)
	}
	trap = allocate(8)
	long_at(trap).value = 0
	checked(wasmtime_func_call(context, function + 8, given, 1, result, 1, trap), trap)
}
## machine-wide channels (lib/channels.warp; the page's are BroadcastChannels, web/playground/host-tasks.js): every
# sender appends to the channel's file, each listener reads it from where it was when it began listening
channel_folder(): text := joined("/tmp/warp-channels-", getenv("USER"))
channel_path(caller: handle, context: handle, name_value: pointer): text := {
	name = shown(caller, context, name_value)
	for i in 0..name.length {
		if byte_at(name.address + i).value == SLASH {
			complain(joined(joined("channel \"", name), "\": a channel to an address runs only in a page"))
			exit(1)
		}
	}
	mkdir(c_string(channel_folder()), OWNER_ONLY)
	joined(joined(channel_folder(), "/"), name)
}
channel_listened(caller: handle, context: handle, given: pointer): nothing := {
	listeners = listeners_block()
	count = long_at(listeners).value
	path = channel_path(caller, context, given + VALUE_BYTES)
	if count == LISTENERS_MAX or path.length > LISTENER_NAME_BYTES {
		complain(joined(path, ": too many channel listeners or too long a channel name for one run"))
		exit(1)
	}
	entry = listeners + 8 + (count * LISTENER_BYTES) as i32
	long_at(entry).value = long_at(given + VALUE_OFFSET).value
	long_at(entry + 8).value = read_file(path).length as i64
	long_at(entry + 16).value = path.length as i64
	memcpy(entry + 24, native_pointer(path.address), path.length as i64)
	long_at(listeners).value = count + 1
}
listeners_block(): pointer := (kept_value(RUN_SLOT) + LISTENERS_AT) as i32
listener_entry(id: i64): pointer := {
	listeners = listeners_block()
	for i in 0..long_at(listeners).value {
		entry = listeners + 8 + (i * LISTENER_BYTES) as i32
		if long_at(entry).value == id { return entry }
	}
	complain(joined("no channel listener ", text_of(id)))
	exit(1)
	0
}
# what a listener has not read yet of its channel's file
unread_of(entry: pointer): text := {
	content = read_file(text_from(entry + 24, long_at(entry + 16).value as u32))
	read = long_at(entry + 8).value as u32
	if read > content.length { return text_from(0, 0) }
	text_from(content.address + read, content.length - read)
}
# where a frame's bytes start in t and how many, packed as shown_at packs (start, length)
frame_at(t: text, at: u32): i64 := {
	length = 0 as i64
	while byte_at(t.address + at).value != NEWLINE {
		length = length * 10 + (byte_at(t.address + at).value - 48) as i64
		at = at + 1
	}
	(at + 1) as i64 * TEXT_SHIFT + length
}
frames_in(t: text): i64 := {
	count = 0 as i64
	at = 0 as u32
	while at < t.length {
		frame = frame_at(t, at)
		at = (frame / TEXT_SHIFT + frame % TEXT_SHIFT) as u32
		count = count + 1
	}
	count
}
# a listener's oldest unread message, ø when none waits
channel_taken(caller: handle, context: handle, entry: pointer, result: pointer): nothing := {
	unread = unread_of(entry)
	if unread.length == 0 { return guest_call(caller, context, "new_empty", 0, 0, result) }
	frame = frame_at(unread, 0)
	start = (frame / TEXT_SHIFT) as u32
	length = (frame % TEXT_SHIFT) as u32
	long_at(entry + 8).value = long_at(entry + 8).value + (start + length) as i64
	guest_text_of(caller, context, text_from(unread.address + start, length), result)
	guest_call(caller, context, "unpacked_node", result, 1, result)
}
channel_sent(caller: handle, context: handle, given: pointer): nothing := {
	path = channel_path(caller, context, given)
	packed = guest_result(caller, context, "packed_node", given + VALUE_BYTES)
	message = shown(caller, context, packed)
	frame = joined(joined(text_of(message.length as i64), "\n"), message)
	file = fopen(c_string(path), c_string("a"))
	if file == 0 { return complain(joined(path, ": not writable, the message is not sent")) }
	fwrite(native_pointer(frame.address), 1, frame.length as i64, file)
	fclose(file)
}
# what the run failed in, as every host says it: the module's trap_message (core/runtime/error_sentences.warp) of the
# engine's trap code (-1 for none), the runtime error's or that trap's sentence at its place; empty for neither (the
# error's own message tells then)
raised_message(context: handle, instance: pointer, failed: pointer): text := {
	function = allocate(EXTERN_BYTES)
	memory = allocate(EXTERN_BYTES)
	code = allocate(8)
	argument = allocate(VALUE_BYTES)
	byte_at(argument).value = KIND_I64
	long_at(argument + VALUE_OFFSET).value = if long_at(failed).value != 0 and wasmtime_trap_code(long_at(failed).value, code) then byte_at(code).value as i64 else -1
	result = allocate(VALUE_BYTES)
	trap = allocate(8)
	long_at(trap).value = 0
	if not wasmtime_instance_export_get(context, instance, "trap_message", 12, function) or not wasmtime_instance_export_get(context, instance, "memory", 6, memory) { "" } else {
		# a compiler the seed built before trap_message took the code exports it without one
		taken = native_long(wasm_functype_params(wasmtime_func_type(context, function + 8)))
		checked(wasmtime_func_call(context, function + 8, argument, taken, result, 1, trap), trap)
		text_in(wasmtime_memory_data(context, memory + 8), long_at(result + VALUE_OFFSET).value)
	}
}

# `driver app.warp args…`: warp.wasm compiles the file as the native warp has it compile, then the module runs with the arguments
compiled_and_run(compiler: text, given: text, first: int): nothing := {
	file = reachable_path(given)
	library = library_folder()
	output = compiled_path()
	compiling = compiler_arguments(compiler)
	added(compiling, file)
	added(compiling, output)
	added(compiling, folder_of(file))
	added(compiling, library)
	added(compiling, joined(library, "/runtime.wasm"))
	file_ran(compiler, compiling)
	written_run(output, given, first)
}
# the path absolute, its links resolved (lib/compiler links to core): a compile's folder is the real one, and a file
# above the current folder (`../a.warp`) is one the module reaches through the preopened root
real_path(path: text): text := {
	if access(c_string(path), READABLE) != 0 {
		complain(joined("no file ", path))
		exit(1)
	}
	resolved_path(path)
}
# a path the module reaches: as given when it is the current folder's real path and that (its messages name it so),
# else absolute and resolved. The module's WASI resolves relative paths in the preopened current folder, never above
# it (`../a.warp`), and follows no link to an absolute path (data/ linked to another volume: WASI error 63)
reachable_path(path: text): text := {
	absolute = real_path(path)
	if same_text(absolute, joined(joined(real_path("."), "/"), path)) then path else absolute
}
# a word of a command as the module reaches it: an existing path (reachable_path), a new file in an existing folder
# by that folder's, any other word (code, a name) as it is
reachable_word(word: text): text := {
	if access(c_string(word), READABLE) == 0 { return reachable_path(word) }
	folder = folder_of(word)
	if same_text(folder, ".") or access(c_string(folder), READABLE) != 0 { return word }
	joined(joined(reachable_path(folder), "/"), text_from(word.address + folder.length + 1, word.length - folder.length - 1))
}
# warp.wasm of lib/, the compiler and its commands
compiler_path(): text := joined(library_folder(), "/warp.wasm")
# a compiler's arguments: its own path, the words after it added
compiler_arguments(compiler: text): Arguments := {
	list = arguments()
	added(list, compiler)
	list
}
# the module of a file (a compiler) run with the arguments, its machine code kept beside it (compiled_module)
file_ran(path: text, given: Arguments): nothing := heap_file_ran(path, given, COMPILER_GC_HEAP_BYTES)
# the compiler at `path` run to build the compiler (warp rebuild), with the builder's heap and machine code
builder_ran(path: text, given: Arguments): nothing := heap_file_ran(path, given, BUILDER_GC_HEAP_BYTES)
heap_file_ran(path: text, given: Arguments, heap_bytes: i64): nothing := {
	module = read_file(path)
	if module.length == 0 {
		complain(joined("no module at ", path))
		exit(1)
	}
	run(module, given, machine_code_file(path, heap_bytes), heap_bytes)
}
# the module warp.wasm wrote to `output` run, named `name`, with this executable's arguments from `first` on
written_run(output: text, name: text, first: int): nothing := {
	program = read_file(output)
	unlink(output)
	if program.length == 0 {
		complain(joined("warp.wasm wrote no module of ", name))
		exit(1)
	}
	run(program, program_arguments(name, first), "", PROGRAM_GC_HEAP_BYTES)
}

## machine code
# warp.wasm's machine code for this driver's wasmtime, kept beside it with the fingerprint of the warp.wasm it is of:
# the harness's warp.wasm.cwasm is another wasmtime's, never loadable here.
# Machine code that won't load (another wasmtime) is said in one line, then compiled anew
FNV_OFFSET = -3750763034362895579
FNV_PRIME = 1099511628211
compiled_module(engine: handle, module: text, machine_code: text, trap: pointer): handle := {
	compiled = allocate(8)
	key = joined(machine_code, ".key")
	fingerprint = text_of(fingerprint_of(module))
	if machine_code.length > 0 and same_text(read_file(key), fingerprint) {
		error = wasmtime_module_deserialize_file(engine, c_string(machine_code), compiled)
		if error == 0 { return long_at(compiled).value }
		message = allocate(VECTOR_BYTES)
		wasmtime_error_message(error, message)
		complain(joined(joined(machine_code, ": not this wasmtime's machine code, compiled anew: "), last_line(native_vector_text(native_pointer(message)))))
	}
	checked(wasmtime_module_new(engine, module.address, module.length, compiled), trap)
	if machine_code.length > 0 { kept_machine_code(long_at(compiled).value, machine_code, key, fingerprint, trap) }
	long_at(compiled).value
}
# the machine code of the module at `path` kept beside it, current for this wasmtime, nothing run
machine_code_kept(path: text): nothing := {
	trap = allocate(8)
	long_at(trap).value = 0
	compiled_module(wasm_engine_new_with_config(warp_config(no, BUILDER_GC_HEAP_BYTES)), read_file(path), machine_code_file(path, BUILDER_GC_HEAP_BYTES), trap)
}
# where a module's machine code is kept: beside it, else (an installed lib/ this user can't write) in the user's cache
# folder under the module's whole path; "" when neither can be written: compiled anew each run, never failing. A
# builder's heap has its own (machine code holds the heap size)
machine_code_file(path: text, heap_bytes: i64): text := {
	suffix = machine_code_suffix(heap_bytes)
	if access(c_string(folder_of(path)), WRITABLE) == 0 { return joined(path, suffix) }
	cache = cache_folder()
	if cache.length == 0 { return "" }
	joined(joined(cache, flattened(resolved_path(path))), suffix)
}
# a compiler's machine code beside it, and a builder's (primitive mode has no text constants)
machine_code_suffix(heap_bytes: i64): text := if heap_bytes == BUILDER_GC_HEAP_BYTES then ".driver.build.cwasm" else ".driver.cwasm"

# $XDG_CACHE_HOME/warp, else ~/Library/Caches/warp (macOS), else ~/.cache/warp, made when missing, ending in a slash;
# "" when it can't be written
cache_folder(): text := {
	base = getenv("XDG_CACHE_HOME")
	home = getenv("HOME")
	if base.length == 0 and access(c_string(joined(home, "/Library/Caches")), WRITABLE) == 0 { base = joined(home, "/Library/Caches") }
	if base.length == 0 { base = joined(home, "/.cache") }
	mkdir(c_string(base), FOLDER_MODE)
	folder = joined(base, "/warp")
	mkdir(c_string(folder), FOLDER_MODE)
	if access(c_string(folder), WRITABLE) == 0 then joined(folder, "/") else ""
}
# the path as one file name, its slashes underscores
flattened(path: text): text := {
	name = joined(path, "")
	for i in 0..name.length { if byte_at(name.address + i).value == SLASH { byte_at(name.address + i).value = UNDERSCORE } }
	name
}
# the text without its trailing newlines
trimmed_end(t: text): text := {
	end = t.length
	while end > 0 and byte_at(t.address + end - 1).value == NEWLINE { end = end - 1 }
	text_from(t.address, end)
}
# the last line of a text that isn't empty: the cause in a wasmtime error's chain
last_line(t: text): text := {
	end = trimmed_end(t).length
	start = end
	while start > 0 and byte_at(t.address + start - 1).value != NEWLINE { start = start - 1 }
	while start < end and byte_at(t.address + start).value == SPACE { start = start + 1 }
	text_from(t.address + start, end - start)
}
# the module's FNV-1a hash
fingerprint_of(module: text): i64 := {
	hash = FNV_OFFSET
	for i in 0..module.length { hash = (hash xor byte_at(module.address + i).value as i64) * FNV_PRIME }
	hash
}
# the compiled module's machine code written to its file, then the fingerprint that names it current; written aside
# and renamed, so a run beside this one never reads half of it
kept_machine_code(compiled: handle, machine_code: text, key: text, fingerprint: text, trap: pointer): nothing := {
	bytes = allocate(VECTOR_BYTES)
	checked(wasmtime_module_serialize(compiled, bytes), trap)
	aside = joined(joined(machine_code, "."), text_of(getpid()))
	file = fopen(c_string(aside), c_string("wb"))
	if file == 0 { return complain(joined(machine_code, ": not writable, warp.wasm compiles anew each run")) }
	fwrite(native_long(native_pointer(bytes) + 8), 1, native_long(native_pointer(bytes)), file)
	fclose(file)
	rename(c_string(aside), c_string(machine_code))
	write_file(key, fingerprint)
}

## host words
# a host word the module calls (answered_word), its arguments and results wasmtime_val_t's, through the caller
# (foreign.c warp_host_callback). std_io and std_pure(module, member, arguments) of a member the driver lacks are the
# Error that says so
host_word(word: i64, caller: handle, given: pointer, count: i64, results: pointer, results_count: i64): nothing := {
	number = long_at(given + VALUE_OFFSET).value
	if word == EXIT_WORD { exit(number as i32) }
	if word < 0 { return host_word_answered(caller, text_from(word_at((0 - word) as i32).value, word_at((0 - word) as i32 + 4).value), given, count, results, results_count) }
	if word == SLEEP_WORD { return slept(number) }
	if word == CLOCK_WORD { return int_result(milliseconds_now(), results) }
	if word == RANDOM_WORD { return float_result(drand48(), results) }
	if word == RANDOM_BELOW_WORD { return int_result((drand48() * (number as f64)) as i64, results) }
	if word == RANDOM_SEED_WORD { return srand48(number) }
	# no window, no key held
	if word == KEY_HELD_WORD { return int_result(0, results) }
	if word == SIGNAL_LISTEN_WORD { return timer_listened(given) }
	context = wasmtime_caller_context(caller)
	if word == PAINT_WORD { return painted(caller, context, given) }
	if word == SAVE_PICTURE_WORD { return guest_text_of(caller, context, picture_saved(caller, context, given), results) }
	if word == SYSTEM_VALUE_WORD { return int_result(system_value(guest_c_text(caller, context, word_at(given + VALUE_OFFSET).value as i64)), results) }
	if word == PARSE_CODE_WORD { return code_parsed(caller, context, given, results) }
	if word == EVAL_CODE_WORD { return code_evaluated(caller, context, given, results) }
	if word == CANONICAL_TEXT_WORD { return canonical_text_answered(context, given, results) }
	if word == CHANNEL_LISTEN_WORD { return channel_listened(caller, context, given) }
	if word == CHANNEL_PENDING_WORD { return int_result(frames_in(unread_of(listener_entry(number))), results) }
	if word == CHANNEL_NEXT_WORD { return channel_taken(caller, context, listener_entry(number), results) }
	if word == CHANNEL_SEND_WORD { return channel_sent(caller, context, given) }
	if word == REAL_PATH_WORD { return real_path_written(caller, context, given, results) }
	if word == SET_SYSTEM_VALUE_WORD { return system_value_set(guest_c_text(caller, context, word_at(given + VALUE_OFFSET).value as i64), long_at(given + VALUE_BYTES + VALUE_OFFSET).value) }
	if word != STD_IO_WORD and word != STD_PURE_WORD { return c_called(foreign_at(word as i32), caller, context, given, results, results_count) }
	module = shown(caller, context, given)
	member = shown(caller, context, given + VALUE_BYTES)
	listed = given + 2 * VALUE_BYTES
	if same_text(module, "os") and same_text(member, "command") { return os_command(caller, context, listed, results) }
	if same_text(module, "os") and same_text(member, "exec") { return os_exec(caller, context, listed, results) }
	# net.start (lib/net.warp fetch_later): the page answers later, the native warp at once, as net.get
	if same_text(module, "net") and (same_text(member, "get") or same_text(member, "start")) { return url_got(caller, context, shown(caller, context, item_of(caller, context, listed, 1)), results) }
	if same_text(module, "regex") { return regex_answered(caller, context, member, listed, results) }
	if same_text(module, "hash") { return hash_answered(caller, context, member, listed, results) }
	# a live loop's cycle starts: only the playground hands loops over between runs; a fade or stop save sound applies
	# (lib/sound.warp), a sound on the device has no handle to ramp or stop natively yet (card libwarp-sound-handle)
	if same_text(module, "sound") and (same_text(member, "live_cycle") or same_text(member, "fade") or same_text(member, "stop")) { return guest_call(caller, context, "new_empty", 0, 0, results) }
	guest_error(caller, context, lacking(module, member), results)
}
# the Error message of a std_io or std_pure member the driver lacks
lacking(module: text, member: text): text := joined(joined(joined(joined("the host word ", module), "."), member), " is not in warp yet")
# an i64 or f64 result of a host word
int_result(n: i64, result: pointer): nothing := {
	byte_at(result).value = KIND_I64
	long_at(result + VALUE_OFFSET).value = n
}
float_result(x: f64, result: pointer): nothing := {
	byte_at(result).value = KIND_F64
	float_at(result + VALUE_OFFSET).value = x
}
# the item of a list value of the module, counted from 1, as a value (its export item_at)
item_of(caller: handle, context: handle, list: pointer, index: i64): pointer := indexed(caller, context, "item_at", list, index)
# the module's export `name` of a list value and an index, its result
indexed(caller: handle, context: handle, name: text, list: pointer, index: i64): pointer := {
	values = allocate(2 * VALUE_BYTES)
	memcpy(values, native_pointer(list), VALUE_BYTES)
	byte_at(values + VALUE_BYTES).value = KIND_I64
	long_at(values + VALUE_BYTES + VALUE_OFFSET).value = index
	item = allocate(VALUE_BYTES)
	guest_call(caller, context, name, values, 2, item)
	item
}
# the module's export `name` of one value, its int result
guest_number(caller: handle, context: handle, name: text, value: pointer): i64 := long_at(guest_result(caller, context, name, value) + VALUE_OFFSET).value
# … its yes/no result
guest_flag(caller: handle, context: handle, name: text, value: pointer): bool := word_at(guest_result(caller, context, name, value) + VALUE_OFFSET).value != 0
guest_result(caller: handle, context: handle, name: text, value: pointer): pointer := {
	result = allocate(VALUE_BYTES)
	guest_call(caller, context, name, value, 1, result)
	result
}

## the host words of warp's commands (core/commands/commands.warp), warp over libc
COMMAND_OUTPUT_BYTES = 4096
# os.command(line): the line run by sh, what it printed, its trailing newlines left off; else the Error naming its exit
# status and what it said on stderr
os_command(caller: handle, context: handle, listed: pointer, result: pointer): nothing := line_run(caller, context, shown(caller, context, item_of(caller, context, listed, 1)), result)
# os.exec(words): the argument vector (`exec sh "crontab -l"`, lib/os.warp) run as that command, each word a word of
# its own however it reads (quoted for sh, no expansion), what it printed; else the Error naming the command (card
# crontab-sample-error)
os_exec(caller: handle, context: handle, listed: pointer, result: pointer): nothing := {
	words = item_of(caller, context, listed, 1)
	# (a command of one word, `sh "date"`, is that word)
	if guest_flag(caller, context, "is_textual", words) { return line_run(caller, context, sh_quoted(shown(caller, context, words)), result) }
	count = guest_number(caller, context, "item_count", words)
	line = ""
	for i in 1..(count + 1) { line = joined(joined(line, " "), sh_quoted(shown(caller, context, item_of(caller, context, words, i)))) }
	line_run(caller, context, line, result)
}
# a text as one sh word: in single quotes, each ' in it as '\''
sh_quoted(t: text): text := {
	quoted = "'"
	start = 0
	for i in 0..t.length {
		if byte_at(t.address + i).value == 39 {
			quoted = joined(joined(quoted, text_from(t.address + start, (i - start) as u32)), "'\\''")
			start = i + 1
		}
	}
	joined(joined(quoted, text_from(t.address + start, (t.length - start) as u32)), "'")
}
# net.get(url), lib/net.warp's fetch: the answer's text by curl, run by its argument vector (no shell sees the URL),
# a URL without its scheme (`fetch "://host/x"`) over https; an answer of status 400 or more, or no curl, is the Error
# with curl's complaint
url_got(caller: handle, context: handle, url: text, result: pointer): nothing := {
	words = arguments()
	added(words, "curl")
	added(words, "-sSL")
	added(words, "--fail-with-body")
	added(words, if starts_with(url, "://") then joined("https", url) else url)
	words_run(caller, context, "curl", words, result)
}
# a command run by its argument vector, without a shell: what it printed, else the Error naming its exit status
# (EXEC_FAILED_STATUS: not found) and what it said on stderr
words_run(caller: handle, context: handle, command: text, words: Arguments, result: pointer): nothing := {
	said = joined(compiled_path(), ".stderr")
	ends = allocate(8)
	errors = fopen(c_string(said), c_string("w"))
	if pipe(ends) != 0 or errors == 0 { return guest_error(caller, context, joined("cannot run ", command), result) }
	reading = word_at(ends).value as i32
	writing = word_at(ends + 4).value as i32
	file = c_string(command)
	# (the child only rewires its outputs and execs: no allocation between fork and exec)
	child = fork()
	if child == 0 {
		dup2(writing, 1)
		dup2(fileno(errors), 2)
		close(reading)
		execvp(file, words.pointers)
		_exit(EXEC_FAILED_STATUS)
	}
	close(writing)
	fclose(errors)
	stream = fdopen(reading, c_string("r"))
	printed = piped(stream)
	fclose(stream)
	status = allocate(4)
	waitpid(child, status, 0)
	exit_status = (word_at(status).value as i32) / 256
	if exit_status == EXEC_FAILED_STATUS {
		unlink(said)
		free(printed.at)
		return guest_error(caller, context, joined(joined("cannot run ", command), ": not found on PATH"), result)
	}
	answered(caller, context, command, printed, exit_status, said, result)
}
line_run(caller: handle, context: handle, line: text, result: pointer): nothing := {
	said = joined(compiled_path(), ".stderr")
	pipe = popen(c_string(joined(joined(joined("{ ", line), "\n} 2>"), said)), c_string("r"))
	if pipe == 0 { return guest_error(caller, context, joined("cannot run sh for ", line), result) }
	printed = piped(pipe)
	answered(caller, context, joined("sh -c ", line), printed, pclose(pipe) / 256, said, result)
}
# what a command printed, its trailing newlines left off, else (exit status not 0) the Error naming the status and
# what it said on stderr
answered(caller: handle, context: handle, command: text, printed: Printed, exit_status: i32, said: text, result: pointer): nothing := {
	size = printed.size
	while size > 0 and native_byte(printed.at + size - 1) == NEWLINE { size = size - 1 }
	if exit_status == 0 { guest_text(caller, context, printed.at, size, result) } else {
		guest_error(caller, context, joined(joined(joined(joined(command, " failed (exit status: "), text_of(exit_status)), "): "), trimmed_end(read_file(said))), result)
	}
	unlink(said)
	free(printed.at)
}

## the core host words, warp over libc
CLOCK_REALTIME = 0
TIME_BYTES = 16
CALENDAR_BYTES = 64
MILLION = 1000000
# sleep_ms(ms): the run waits that long
slept(milliseconds: i64): nothing := {
	wanted = allocate(TIME_BYTES)
	long_at(wanted).value = milliseconds / 1000
	long_at(wanted + 8).value = milliseconds % 1000 * MILLION
	nanosleep(wanted, 0)
}
# clock(): milliseconds since the epoch
milliseconds_now(): i64 := {
	now = allocate(TIME_BYTES)
	clock_gettime(CLOCK_REALTIME, now)
	long_at(now).value * 1000 + long_at(now + 8).value / MILLION
}

## events (card native-timers): the page's event loop natively, its semantics web/playground/host-timers.js's
# The program tells each timer by signal_listen(kind, id, argument) while main runs (lib/timers.warp); once main
# returned, the loop sleeps until the earliest is due and calls the program's export timer_fired(id). An `every` timer
# keeps the run going, as a page's does, until exit() or Ctrl-C; a run whose timers are all once ends after the last
# fired; WARP_EVENTS_FOR=<ms> ends it sooner (the test harness and the samples sweep set it). Channels' `on message
# from` polls through a timer (lib/channels.warp), so it runs in this loop too.
TIMER_EVERY = 0
TIMER_FRAME = 1
TIMER_CLOCK = 2
FRAME_MILLISECONDS = 16
# a clock timer's argument: weekdays * 10000 + minute of the day, the weekdays a mask (bit 0 Sunday), 0 once
WEEKDAYS_SHIFT = 10000
EVERY_DAY = 127
DAY_MILLISECONDS = 86400000
WEEKDAY_FIELD = 24
# a table entry: id, kind, argument, due (ms since the epoch, 0 once a once-timer fired); the table: count, entries
TIMER_BYTES = 32
TIMERS_HEADER = 8
MAX_TIMERS = 256
# the table's bytes: TIMERS_HEADER + MAX_TIMERS * TIMER_BYTES
TIMERS_BYTES = 8200

timer_listened(given: pointer): nothing := {
	kind = long_at(given + VALUE_OFFSET).value
	id = long_at(given + VALUE_BYTES + VALUE_OFFSET).value
	argument = long_at(given + 2 * VALUE_BYTES + VALUE_OFFSET).value
	table = kept_value(TIMERS_SLOT) as i32
	count = long_at(table).value
	if count == MAX_TIMERS {
		complain(joined(joined("more than ", text_of(MAX_TIMERS)), " timers in one run"))
		exit(1)
	}
	entry = table + TIMERS_HEADER + (count as i32) * TIMER_BYTES
	long_at(entry).value = id
	long_at(entry + 8).value = kind
	long_at(entry + 16).value = argument
	long_at(entry + 24).value = next_due(kind, argument, milliseconds_now())
	long_at(table).value = count + 1
}
# when a timer is next due after `now`, 0 for none (a once clock timer that fired)
next_due(kind: i64, argument: i64, now: i64): i64 := {
	if kind == TIMER_EVERY { return now + argument }
	if kind == TIMER_FRAME { return now + FRAME_MILLISECONDS }
	weekdays = argument / WEEKDAYS_SHIFT
	minute = argument % WEEKDAYS_SHIFT
	midnight = now - time_of_day()
	today = weekday_now()
	for ahead in 0..8 {
		due = midnight + ahead * DAY_MILLISECONDS + minute * 60000
		mask = if weekdays == 0 then EVERY_DAY else weekdays
		if due > now and ((mask >> ((today + ahead) % 7)) & 1) == 1 { return due }
	}
	now + 7 * DAY_MILLISECONDS
}
# the local weekday, 0 Sunday
weekday_now(): i64 := {
	seconds = allocate(8)
	long_at(seconds).value = milliseconds_now() / 1000
	fields = allocate(CALENDAR_BYTES)
	localtime_r(seconds, fields)
	word_at(fields + WEEKDAY_FIELD).value as i64
}
# the loop: what the run failed in, empty when it ended as it should; a run without an output file ends there, saying
# so, as main's failure does
events_run(linker: handle, context: handle, instance: pointer, output: text): text := {
	table = kept_value(TIMERS_SLOT) as i32
	if long_at(table).value == 0 { return "" }
	fired = allocate(EXTERN_BYTES)
	# (the program's own, or the linked standard module timers' that the program's timers call)
	if not wasmtime_instance_export_get(context, instance, "timer_fired", 11, fired) and not wasmtime_linker_get(linker, context, "warp/timers", 11, "timer_fired", 11, fired) {
		refused = joined(text_of(long_at(table).value), " timer(s) refused: the program exports no timer_fired(id)")
		if output.length == 0 {
			complain(refused)
			exit(1)
		}
		return refused
	}
	limit = getenv("WARP_EVENTS_FOR")
	ends = if limit.length > 0 then milliseconds_now() + atoll(limit) else 0
	failure = ""
	at = earliest_timer(table)
	while at != 0 and failure.length == 0 {
		due = long_at(at + 24).value
		if ends > 0 and due > ends {
			if ends > milliseconds_now() { slept(ends - milliseconds_now()) }
			at = 0
		} else {
			wait = due - milliseconds_now()
			if wait > 0 { slept(wait) }
			long_at(at + 24).value = if long_at(at + 8).value == TIMER_CLOCK and long_at(at + 16).value / WEEKDAYS_SHIFT == 0 then 0 else next_due(long_at(at + 8).value, long_at(at + 16).value, due)
			failure = timer_fired(context, instance, fired, long_at(at).value, output)
			at = earliest_timer(table)
		}
	}
	failure
}
# a run starts with an empty table: a later run in this process (`warp test`'s next program) never fires an earlier one's
timers_forgotten(): nothing := {
	table = allocate(TIMERS_BYTES)
	long_at(table).value = 0
	keep_value(TIMERS_SLOT, table as i64)
}
# the entry of the timer due first, 0 when none is due any more
earliest_timer(table: pointer): pointer := {
	earliest = 0 as pointer
	for i in 0..long_at(table).value {
		entry = table + TIMERS_HEADER + (i as i32) * TIMER_BYTES
		if long_at(entry + 24).value != 0 and (earliest == 0 or long_at(entry + 24).value < long_at(earliest + 24).value) { earliest = entry }
	}
	earliest
}
# the program's timer_fired(id): what it failed in, empty when it ran
timer_fired(context: handle, instance: pointer, fired: pointer, id: i64, output: text): text := {
	argument = allocate(VALUE_BYTES)
	byte_at(argument).value = KIND_I64
	long_at(argument + VALUE_OFFSET).value = id
	results = allocate(VALUE_BYTES * MAX_RESULTS)
	trap = allocate(8)
	long_at(trap).value = 0
	results_count = native_long(wasm_functype_results(wasmtime_func_type(context, fired + 8)))
	error = wasmtime_func_call(context, fired + 8, argument, 1, results, results_count, trap)
	call_failure(context, instance, error, trap, output)
}
# what a call of the module failed in, empty when it ran; a run without an output file ends there, saying so
call_failure(context: handle, instance: pointer, error: handle, trap: pointer, output: text): text := {
	if error == 0 and long_at(trap).value == 0 { return "" }
	if output.length == 0 { failed_raising(error, trap, raised_message(context, instance, trap)) }
	failure_said(error, trap, raised_message(context, instance, trap))
}
# system_value(name): the machine's readings that are plain libc; the others (mouse, window, keys …) come with the
# native host module (decision libraries-not-core, host_owns); one it does not own ends the run naming it
system_value(name: text): i64 := {
	if same_text(name, "time of day") { return time_of_day() }
	if same_text(name, "view_width") { return terminal_extent(0, "COLUMNS", 80) }
	if same_text(name, "view_height") { return terminal_extent(1, "LINES", 24) }
	if same_text(name, "display_dpi") { return kept_or(DISPLAY_DPI_SLOT, DEFAULT_DPI) }
	if same_text(name, "display_width") { return display_side(0, "display.width") }
	if same_text(name, "display_height") { return display_side(1, "display.height") }
	if same_text(name, "online") { return route_online() as i64 }
	if same_text(name, "gpu_paints") { return gpu_paints() as i64 }
	# (an open window tells its size as its user made it; before, the size the program set, else the view's)
	if host_asked("host_owns", name) != 0 { return host_asked("host_value", name) }
	if same_text(name, "window_width") { return kept_or(WINDOW_WIDTH_SLOT, NATIVE_VIEW_WIDTH) }
	if same_text(name, "window_height") { return kept_or(WINDOW_HEIGHT_SLOT, NATIVE_VIEW_HEIGHT) }
	complain(joined(joined("the system value ", name), " is not in warp yet"))
	exit(1)
	0
}
# eval_code(t) (decision N31, the prelude's eval): warp.wasm compiles t as a program of its own,
# beside the compiled program, its value printed as data after the value mark; it runs with what it prints written to a
# file, what it printed before the value goes on to this run's output, and the value is built again in the module as
# parse_code builds a tree. A text that fails to compile or run gives an Error saying why
code_evaluated(caller: handle, context: handle, given: pointer, result: pointer): nothing := {
	stem = joined(compiled_path(), ".eval")
	source = joined(stem, ".warp")
	module = joined(stem, ".wasm")
	printed = joined(stem, ".out")
	write_file(source, shown(caller, context, given))
	library = library_folder()
	compiling = compiler_arguments(compiler_path())
	added(compiling, source)
	added(compiling, module)
	added(compiling, ".")
	added(compiling, library)
	added(compiling, joined(library, "/runtime.wasm"))
	setenv(value_as_data_variable(), c_string("1"), 1)
	failure = run_into(read_file(compiler_path()), compiling, machine_code_file(compiler_path(), COMPILER_GC_HEAP_BYTES), COMPILER_GC_HEAP_BYTES, printed)
	unsetenv(value_as_data_variable())
	if failure.length == 0 { failure = run_into(read_file(module), program_arguments(source, arg_count()), "", PROGRAM_GC_HEAP_BYTES, printed) }
	output = read_file(printed)
	unlink(source)
	unlink(module)
	unlink(printed)
	mark = text_found(output, value_mark())
	if failure.length > 0 or mark < 0 {
		if failure.length == 0 { failure = output }
		guest_text_of(caller, context, joined("eval: ", failure), result)
		return guest_call(caller, context, "error_of", result, 1, result)
	}
	before: u32 = mark as u32
	fd_write(1, text_from(output.address, before), 1, allocate(4))
	start: u32 = before + value_mark().length + 1
	code_parsed_from(caller, context, text_from(output.address + start as i32, output.length - start), result)
}
# an eval's program prints its value as data after a line of the mark (core/emitter/emitter.warp VALUE_MARK); a
# primitive program's texts are words, not globals
value_as_data_variable(): pointer := c_string("WARP_VALUE_AS_DATA")
value_mark(): text := "§warp value§"
# where `part` first starts in t, -1 when nowhere
text_found(t: text, part: text): i64 := {
	at = 0
	while at + part.length <= t.length {
		if memcmp(t.address + at, part.address, part.length) == 0 { return at as i64 }
		at = at + 1
	}
	-1
}
# parse_code(t): warp.wasm parses t (its parse-code command, the compiler's own parser) and the tree is built again in
# the module, node by node through its builders
code_parsed(caller: handle, context: handle, given: pointer, result: pointer): nothing := code_parsed_from(caller, context, shown(caller, context, given), result)
code_parsed_from(caller: handle, context: handle, code: text, result: pointer): nothing := {
	output = joined(compiled_path(), ".code")
	parsing = compiler_arguments(compiler_path())
	added(parsing, "parse-code")
	added(parsing, code)
	added(parsing, output)
	file_ran(compiler_path(), parsing)
	encoding = read_file(output)
	unlink(output)
	at = allocate(8)
	long_at(at).value = 0
	code_built(caller, context, encoding, at, result)
}
# the node encoded at `at` (advanced past it) built in the module into `result`
code_built(caller: handle, context: handle, encoding: text, at: pointer, result: pointer): nothing := {
	tag = byte_at(encoding.address + long_at(at).value as i32).value
	long_at(at).value = long_at(at).value + 1
	if tag == 101 { return guest_call(caller, context, "new_empty", 0, 0, result) }
	if tag == 84 or tag == 70 {
		int_result(if tag == 84 then 1 else 0, result)
		return guest_call(caller, context, "new_bool", result, 1, result)
	}
	field = encoded_field(encoding, at)
	if tag == 105 { return guest_int(caller, context, "new_int", atoll(field), result) }
	if tag == 102 {
		float_result(atof(c_string(field)), result)
		return guest_call(caller, context, "new_float", result, 1, result)
	}
	if tag == 99 {
		byte_at(result).value = KIND_I32
		word_at(result + VALUE_OFFSET).value = atoll(field) as u32
		return guest_call(caller, context, "new_codepoint", result, 1, result)
	}
	if tag == 115 { return guest_bytes_built(caller, context, native_pointer(field.address), field.length as i64, "new_symbol", result) }
	if tag == 120 {
		guest_text_of(caller, context, field, result)
		return guest_call(caller, context, "error_of", result, 1, result)
	}
	if tag == 107 {
		parts = allocate(3 * VALUE_BYTES)
		code_built(caller, context, encoding, at, parts)
		guest_text_of(caller, context, field, parts + VALUE_BYTES)
		code_built(caller, context, encoding, at, parts + 2 * VALUE_BYTES)
		return guest_call(caller, context, "new_spelled_key", parts, 3, result)
	}
	if tag == 108 { return code_list_built(caller, context, encoding, at, atoll(field), result) }
	guest_text_of(caller, context, field, result)
}
# a list of `count` items encoded after its bracket and separator: its items a square list built from the last one
# on, a cell at a time (new_list), then given the bracket and separator their spellings name
code_list_built(caller: handle, context: handle, encoding: text, at: pointer, count: i64, result: pointer): nothing := {
	parts = allocate(3 * VALUE_BYTES)
	guest_text_of(caller, context, encoded_field(encoding, at), parts + VALUE_BYTES)
	guest_text_of(caller, context, encoded_field(encoding, at), parts + 2 * VALUE_BYTES)
	items = allocate((count as i32 + 1) * VALUE_BYTES)
	for i in 0..count { code_built(caller, context, encoding, at, items + (i as i32) * VALUE_BYTES) }
	cell = allocate(3 * VALUE_BYTES)
	byte_at(cell + VALUE_BYTES).value = ANYREF
	long_at(cell + VALUE_BYTES + VALUE_OFFSET).value = 0
	byte_at(cell + 2 * VALUE_BYTES).value = KIND_I64
	long_at(cell + 2 * VALUE_BYTES + VALUE_OFFSET).value = SQUARE_LIST
	i = count - 1
	while i >= 0 {
		memcpy(cell, native_pointer(items + (i as i32) * VALUE_BYTES), VALUE_BYTES)
		guest_call(caller, context, "new_list", cell, 3, cell + VALUE_BYTES)
		i = i - 1
	}
	memcpy(parts, native_pointer(cell + VALUE_BYTES), VALUE_BYTES)
	guest_call(caller, context, "new_spelled_list", parts, 3, result)
}
# the field at `at`, up to its FIELD_END, `at` advanced past that
encoded_field(encoding: text, at: pointer): text := {
	start = long_at(at).value
	end = start
	while byte_at(encoding.address + end as i32).value != FIELD_END { end = end + 1 }
	long_at(at).value = end + 1
	text_from(encoding.address + start as i32, (end - start) as u32)
}
# the value a program set in that slot, else the default
kept_or(slot: i64, default: i64): i64 := if kept_value(slot) != 0 then kept_value(slot) else default
# the main screen's side in points; a machine showing none stops the run saying so, never a made-up reading
display_side(height: i32, name: text): i64 := {
	side = display_extent(height)
	if side == 0 {
		complain(joined(name, ": this machine shows no display"))
		exit(1)
	}
	side
}
# `window.width = 800` (the size a window opens at, told the native host module too), `display.dpi = 300 dpi`, the
# others the native host module's (window_open) or read only
system_value_set(name: text, value: i64): nothing := {
	if host_told("host_value_set", name, value, 1) == 0 { slot_set(name, value) }
}
## the native host module (decision window-in-warp): what the playground's JavaScript answers beyond the driver's own
## words, natively in warp, lib/native_host.warp (its window over SDL3 and the system's fonts, its sound over SDL3's audio
## and the system's decoders): its system values, the layer a painting shows in, the host words it answers as
## host_<word>, the run's end (a still picture held open, the sounds heard out)
# (primitive mode has no text constants: its name `warp/native_host` and the prefix `host_` are written where read)
host_export(context: handle, name: text, function: pointer): bool := lazily_linked(context, "warp/native_host", HOST_LINKED_AT, name, function)
# the run's end told the native host module, when the run linked it: a still picture stays shown till its window
# closes, the sounds play out
host_run_ended(context: handle): nothing := {
	if long_at(kept_value(RUN_SLOT) as i32 + HOST_LINKED_AT as i32).value != 0 { guest_call(0, context, "host_run_ended", 0, 0, allocate(VALUE_BYTES)) }
}
# its export `export` of a system value's name, its number; host_told also of a number after it (`numbers`: 1)
host_asked(export: text, name: text): i64 := host_told(export, name, 0, 0)
host_told(export: text, name: text, value: i64, numbers: i64): i64 := {
	context = run_context()
	values = allocate(2 * VALUE_BYTES)
	guest_text(0, context, native_pointer(name.address), name.length as i64, values)
	byte_at(values + VALUE_BYTES).value = KIND_I64
	long_at(values + VALUE_BYTES + VALUE_OFFSET).value = value
	result = allocate(VALUE_BYTES)
	guest_call(0, context, export, values, 1 + numbers, result)
	value_number(result)
}
slot_set(name: text, value: i64): nothing := {
	slot = if same_text(name, "window_width") then WINDOW_WIDTH_SLOT else if same_text(name, "window_height") then WINDOW_HEIGHT_SLOT else if same_text(name, "display_dpi") then DISPLAY_DPI_SLOT else -1
	if slot < 0 {
		complain(joined(name, " cannot be set; settable: window_width, window_height, display_dpi"))
		exit(1)
	}
	if value <= 0 {
		complain(joined(name, ": a size or density is positive"))
		exit(1)
	}
	keep_value(slot, value)
}
# outside a window the view is the terminal: its columns (rows), else the variable's, else the default
terminal_extent(rows: i32, variable: text, default: i64): i64 := {
	measured = terminal_size(rows)
	if measured > 0 { return measured as i64 }
	given = getenv(variable)
	if given.length > 0 then atoll(given) else default
}
# the local time of day in milliseconds since midnight
time_of_day(): i64 := {
	now = milliseconds_now()
	seconds = allocate(8)
	long_at(seconds).value = now / 1000
	fields = allocate(CALENDAR_BYTES)
	localtime_r(seconds, fields)
	hours = word_at(fields + 8).value as i64
	minutes = hours * 60 + (word_at(fields + 4).value as i64)
	(minutes * 60 + (word_at(fields).value as i64)) * 1000 + now % 1000
}
# seconds since 1970 as the local minute, `2026-10-30 12:05`, by libc: no `date`, no PATH
local_minute(since_epoch: i64): text := {
	seconds = allocate(8)
	long_at(seconds).value = since_epoch
	fields = allocate(CALENDAR_BYTES)
	localtime_r(seconds, fields)
	shown = allocate(32)
	text_from(shown, strftime(shown, 32, c_string("%Y-%m-%d %H:%M"), fields) as u32)
}
# a C text argument (c_text) of the module, copied out of its memory
guest_c_text(caller: handle, context: handle, address: i64): text := {
	at = guest_memory(caller, context) + address
	native_copy(at, strlen(at))
}
# a node of the module's, made by its builder export `name` of one i64
guest_int(caller: handle, context: handle, name: text, n: i64, result: pointer): nothing := {
	values = allocate(VALUE_BYTES)
	int_result(n, values)
	guest_call(caller, context, name, values, 1, result)
}
# a text of the driver's as a text node of the module's
guest_text_of(caller: handle, context: handle, t: text, result: pointer): nothing := guest_text(caller, context, native_pointer(t.address), t.length as i64, result)

## paint (card paint-native): the pixels as a PNG in the temporary folder, warp-paint/paint.png, then paint-2.png …
## within one run, named on stderr: 0 paper, a value with
## an alpha byte its color, any other ink. A shader paints on the GPU, which the native warp has not yet
PAPER = 250
INK = 29
COLOR_FROM = 16777216
STORED_MOST = 65535
ADLER_MODULUS = 65521
FOLDER_MODE = 493
# the PNG signature: 89, P N G, CR LF, 1A, LF
PNG_SIGNATURE_HIGH = 2303741511
PNG_SIGNATURE_LOW = 218765834
painted(caller: handle, context: handle, given: pointer): nothing := {
	width = picture_width(given)
	height = picture_height(given)
	if width > 0 and height > 0 {
		pixels = painted_pixels(caller, context, given, width, height)
		if pixels != 0 {
			path = painting_path()
			failed = png_written(pixels, width, height, path)
			if failed.length > 0 { return complain(failed) }
			complain(joined(joined(joined(joined(joined("painted ", text_of(width)), "×"), text_of(height)), ": "), path))
		}
	}
}
# the width and height a painting's values (picture, width, height, …) give
picture_width(given: pointer): i64 := long_at(given + VALUE_BYTES + VALUE_OFFSET).value
picture_height(given: pointer): i64 := long_at(given + 2 * VALUE_BYTES + VALUE_OFFSET).value
# the next painting's file in the temporary folder: warp-paint/paint.png, then paint-2.png …
painting_path(): text := {
	folder = joined(temporary_folder(), "warp-paint")
	mkdir(c_string(folder), FOLDER_MODE)
	number = next_painting()
	joined(folder, if number == 1 then "/paint.png" else joined(joined("/paint-", text_of(number)), ".png"))
}
# save(canvas, "hello.png") of lib/draw: the canvas's pixels (picture, width, height, file) as a PNG in that file; why
# it could not, else "" (lib/draw raises it)
picture_saved(caller: handle, context: handle, given: pointer): text := {
	width = picture_width(given)
	height = picture_height(given)
	png_written(pixels_of(caller, context, given, width * height), width, height, shown(caller, context, given + 3 * VALUE_BYTES))
}
# the picture's pixels: a WGSL shader's, its values the uniform, from the GPU (lib/native/foreign.c, libwarp_gpu),
# else the list's; 0 when a library showed them in its open window (foreign.c shader_shown, pixels_shown)
painted_pixels(caller: handle, context: handle, given: pointer, width: i64, height: i64): pointer := {
	if guest_flag(caller, context, "is_textual", given) {
		shader = shown(caller, context, given)
		values = shown(caller, context, given + 3 * VALUE_BYTES)
		in_window = shader_shown(c_string(shader), c_string(values), window_layer(width, height), width, height)
		if in_window < 0 { exit(1) }
		if in_window > 0 { return 0 }
		pixels = allocate((width * height * 8) as i32)
		if gpu_painted(c_string(shader), c_string(values), width, height, pixels) != 0 { exit(1) }
		pixels
	} else {
		count = guest_number(caller, context, "item_count", given)
		if count < width * height {
			complain(joined(joined(joined(joined("paint: ", text_of(width)), "x"), text_of(height)), joined(" needs more pixels than ", text_of(count))))
			exit(1)
		}
		pixels = pixels_of(caller, context, given, width * height)
		in_window = pixels_shown(pixels, window_layer(width, height), width, height)
		if in_window < 0 { exit(1) }
		if in_window > 0 then 0 else pixels
	}
}
# the layer of the native host module's window for a painting of width × height, the window opened by the first; 0
# where none shows it: no window, or no GPU to show it with (libwarp_gpu)
window_layer(width: i64, height: i64): handle := {
	if gpu_paints() == 0 { return 0 }
	sides = allocate(2 * VALUE_BYTES)
	int_result(width, sides)
	int_result(height, sides + VALUE_BYTES)
	layer = allocate(VALUE_BYTES)
	guest_call(0, run_context(), "host_window_layer", sides, 2, layer)
	handle_pointer(value_number(layer) as i32)
}
# the first n pixels of the picture, as ints, a chunk of PIXEL_CHUNK at a time by the module's pixels_at (4 bytes each
# in its memory): one call a chunk, not one a pixel (card native-show-paint: 1280×800 took 360 ms)
PIXEL_CHUNK = 16372 # runtime/show.warp pixel_chunk(): the output area past its C string's start, 4 bytes a pixel
pixels_of(caller: handle, context: handle, picture: pointer, n: i64): pointer := {
	pixels = allocate((n * 8) as i32)
	words = allocate((PIXEL_CHUNK * 4) as i32)
	values = allocate(3 * VALUE_BYTES)
	memcpy(values, native_pointer(picture), VALUE_BYTES)
	byte_at(values + VALUE_BYTES).value = KIND_I64
	byte_at(values + 2 * VALUE_BYTES).value = KIND_I64
	result = allocate(VALUE_BYTES)
	done = 0
	while done < n {
		count = if n - done < PIXEL_CHUNK then n - done else PIXEL_CHUNK
		long_at(values + VALUE_BYTES + VALUE_OFFSET).value = done + 1
		long_at(values + 2 * VALUE_BYTES + VALUE_OFFSET).value = count
		guest_call(caller, context, "pixels_at", values, 3, result)
		memcpy(words, guest_memory(caller, context) + long_at(result + VALUE_OFFSET).value, count * 4)
		for i in 0..count { long_at(pixels + (done + i) * 8).value = word_at(words + i * 4).value as i64 }
		done = done + count
	}
	pixels
}
# the pixels as a PNG in the file; why it could not, else ""
png_written(pixels: pointer, width: i64, height: i64, path: text): text := {
	colored = no
	for i in 0..width * height { if long_at(pixels + i * 8).value >= COLOR_FROM { colored = yes } }
	channels = if colored then 3 else 1
	row = 1 + width * channels
	rows = allocate((row * height) as i32)
	for y in 0..height {
		byte_at(rows + y * row).value = 0
		for x in 0..width { shaded(long_at(pixels + (y * width + x) * 8).value, rows + y * row + 1 + x * channels, colored) }
	}
	header = allocate(13)
	big_endian(header, width)
	big_endian(header + 4, height)
	byte_at(header + 8).value = 8
	byte_at(header + 9).value = if colored then 2 else 0
	for i in 10..13 { byte_at(header + i).value = 0 }
	deflated = zlib_stored(rows, row * height)
	png = allocate((8 + 25 + 12 + deflated.length + 12) as i32)
	big_endian(png, PNG_SIGNATURE_HIGH)
	big_endian(png + 4, PNG_SIGNATURE_LOW)
	at = chunk(png + 8, "IHDR", header, 13)
	at = chunk(at, "IDAT", deflated.address, deflated.length as i64)
	at = chunk(at, "IEND", 0, 0)
	file = fopen(c_string(path), c_string("wb"))
	if file == 0 { return os_failure(joined("save: cannot write ", path)) }
	fwrite(native_pointer(png), 1, at - png, file)
	fclose(file)
	""
}
# what failed, why the system says it did and its error number: "…: No such file or directory (os error 2)"
os_failure(what: text): text := {
	code = last_error()
	reason = strerror(code)
	joined(joined(joined(joined(joined(what, ": "), native_copy(reason, strlen(reason))), " (os error "), text_of(code as i64)), ")")
}
# a pixel's bytes: gray, or red, green and blue
shaded(value: i64, at: pointer, colored: bool): nothing := {
	if value >= COLOR_FROM {
		byte_at(at).value = ((value >> 16) & 255) as u8
		if colored { byte_at(at + 1).value = ((value >> 8) & 255) as u8 }
		if colored { byte_at(at + 2).value = (value & 255) as u8 }
	} else {
		shade = if value == 0 then PAPER else INK
		for c in 0..(if colored then 3 else 1) { byte_at(at + c).value = shade as u8 }
	}
}
big_endian(at: pointer, value: i64): nothing := {
	for i in 0..4 { byte_at(at + i).value = ((value >> (24 - 8 * i)) & 255) as u8 }
}
# a PNG chunk at `at`: length, type, data, the CRC of type and data; where the next goes
chunk(at: pointer, type: text, data: pointer, length: i64): pointer := {
	big_endian(at, length)
	memcpy(at + 4, native_pointer(type.address), 4)
	if length > 0 { memcpy(at + 8, native_pointer(data), length) }
	big_endian(at + 8 + length, crc32_of(text_from(at + 4, (length + 4) as u32)) as i64)
	at + 12 + length
}
# the bytes as a zlib stream of stored (uncompressed) deflate blocks
zlib_stored(bytes: pointer, length: i64): text := {
	blocks = (length + STORED_MOST - 1) / STORED_MOST
	if blocks == 0 { blocks = 1 }
	size = 2 + blocks * 5 + length + 4
	out = allocate(size as i32)
	byte_at(out).value = 120
	byte_at(out + 1).value = 1
	at = out + 2
	for b in 0..blocks {
		start = b * STORED_MOST
		part = if length - start < STORED_MOST then length - start else STORED_MOST
		byte_at(at).value = if b == blocks - 1 then 1 else 0
		byte_at(at + 1).value = (part & 255) as u8
		byte_at(at + 2).value = (part >> 8) as u8
		byte_at(at + 3).value = ((part & 255) xor 255) as u8
		byte_at(at + 4).value = ((part >> 8) xor 255) as u8
		if part > 0 { memcpy(at + 5, native_pointer(bytes + start), part) }
		at = at + 5 + part
	}
	low = 1
	high = 0
	for i in 0..length {
		low = (low + byte_at(bytes + i).value as i64) % ADLER_MODULUS
		high = (high + low) % ADLER_MODULUS
	}
	big_endian(at, high * 65536 + low)
	text_from(out, size as u32)
}

## regex: POSIX's extended syntax, on macOS enhanced (\s \w \d \b, (?:…)), as common regex engines read them
REGEX_BYTES = 256
GROUPS = 10
# the regmatch_t's of them, room for 8-byte offsets
GROUP_BYTES = 160
EXTENDED = 1
ENHANCED = 256
NOT_LINE_START = 1
ANYREF = 7
SQUARE_LIST = 1
DOLLAR = 36
OPEN_CURLY = 123
CLOSE_CURLY = 125
# regex.matches, first, all and replace of (subject, pattern[, replacement])
regex_answered(caller: handle, context: handle, member: text, listed: pointer, result: pointer): nothing := {
	subject = c_string(shown(caller, context, item_of(caller, context, listed, 1)))
	pattern = shown(caller, context, item_of(caller, context, listed, 2))
	compiled = allocate(REGEX_BYTES)
	code = regcomp(compiled, pattern, if on_linux() then EXTENDED else EXTENDED + ENHANCED)
	if code != 0 {
		message = allocate(PATH_BYTES)
		regerror(code, compiled, message, PATH_BYTES)
		return guest_error(caller, context, joined(joined(joined("regex ", pattern), ": "), text_from(message, c_length(message))), result)
	}
	groups = allocate(GROUP_BYTES)
	found = match_from(compiled, subject, 0, groups)
	if same_text(member, "matches") { guest_int(caller, context, "new_bool", if found then 1 else 0, result) } else {
		if same_text(member, "first") {
			if found { guest_text_of(caller, context, group_text(subject, groups, 0), result) } else { guest_call(caller, context, "new_empty", 0, 0, result) }
		} else {
			if same_text(member, "all") { all_matches(caller, context, compiled, subject, result) } else {
				if same_text(member, "replace") {
					replacement = shown(caller, context, item_of(caller, context, listed, 3))
					guest_text_of(caller, context, replaced(compiled, subject, replacement, groups), result)
				} else { guest_error(caller, context, lacking("regex", member), result) }
			}
		}
	}
	regfree(compiled)
}
# whether the pattern matches the C text at `subject` from byte `from` on; the groups' offsets from `subject`
match_from(compiled: pointer, subject: pointer, from: i64, groups: pointer): bool := {
	if regexec(compiled, subject + from, GROUPS, groups, if from > 0 then NOT_LINE_START else 0) != 0 { return no }
	for i in 0..GROUPS {
		if group_start(groups, i) >= 0 {
			set_offset(groups, 2 * i, group_start(groups, i) + from)
			set_offset(groups, 2 * i + 1, group_end(groups, i) + from)
		}
	}
	yes
}
# where the next match is looked for: past this one, a byte further when it was empty
next_from(groups: pointer): i64 := if group_end(groups, 0) > group_start(groups, 0) then group_end(groups, 0) else group_end(groups, 0) + 1
# regmatch_t's offsets: off_t on macOS, int on Linux; -1 for a group that took no part
offset_at(groups: pointer, index: i64): i64 := if on_linux() then (word_at(groups + index * 4).value as i32) as i64 else long_at(groups + index * 8).value
set_offset(groups: pointer, index: i64, offset: i64): nothing := {
	if on_linux() { word_at(groups + index * 4).value = offset as u32 } else { long_at(groups + index * 8).value = offset }
}
group_start(groups: pointer, group: i64): i64 := offset_at(groups, 2 * group)
group_end(groups: pointer, group: i64): i64 := offset_at(groups, 2 * group + 1)
group_text(subject: pointer, groups: pointer, group: i64): text := {
	if group_start(groups, group) < 0 { return text_from(0, 0) }
	text_from(subject + group_start(groups, group), (group_end(groups, group) - group_start(groups, group)) as u32)
}
on_linux(): bool := access(c_string("/proc/self/exe"), READABLE) == 0
# regex.all: each match's text, a list built from its last item (the module's new_list); none an empty node
all_matches(caller: handle, context: handle, compiled: pointer, subject: pointer, result: pointer): nothing := {
	length = c_length(subject) as i64
	count = 0
	groups = allocate(GROUP_BYTES)
	from = 0 as i64
	while from <= length and match_from(compiled, subject, from, groups) {
		count = count + 1
		from = next_from(groups)
	}
	if count == 0 { return guest_call(caller, context, "new_empty", 0, 0, result) }
	spans = allocate((count * 16) as i32)
	from = 0
	for i in 0..count {
		match_from(compiled, subject, from, groups)
		long_at(spans + i * 16).value = group_start(groups, 0)
		long_at(spans + i * 16 + 8).value = group_end(groups, 0)
		from = next_from(groups)
	}
	values = allocate(3 * VALUE_BYTES)
	byte_at(values + VALUE_BYTES).value = ANYREF
	byte_at(values + 2 * VALUE_BYTES).value = KIND_I64
	long_at(values + 2 * VALUE_BYTES + VALUE_OFFSET).value = SQUARE_LIST
	i = count - 1
	while i >= 0 {
		start = long_at(spans + i * 16).value
		guest_text(caller, context, native_pointer(subject + start), long_at(spans + i * 16 + 8).value - start, values)
		guest_call(caller, context, "new_list", values, 3, result)
		memcpy(values + VALUE_BYTES, native_pointer(result), VALUE_BYTES)
		i = i - 1
	}
}
# regex.replace: each match replaced, $1 or ${1} its group, $$ a dollar
replaced(compiled: pointer, subject: pointer, replacement: text, groups: pointer): text := {
	length = c_length(subject) as i64
	output = text_from(0, 0)
	kept = 0 as i64
	from = 0 as i64
	while from <= length and match_from(compiled, subject, from, groups) {
		output = joined(joined(output, text_from(subject + kept, (group_start(groups, 0) - kept) as u32)), expanded(replacement, subject, groups))
		kept = group_end(groups, 0)
		from = next_from(groups)
	}
	joined(output, text_from(subject + kept, (length - kept) as u32))
}
# the replacement with its group references filled in
expanded(replacement: text, subject: pointer, groups: pointer): text := {
	output = text_from(0, 0)
	at = 0
	while at < replacement.length {
		c = byte_at(replacement.address + at).value
		next = if at + 1 < replacement.length then byte_at(replacement.address + at + 1).value else 0
		if c == DOLLAR and next == DOLLAR {
			output = joined(output, "$")
			at = at + 2
		} else {
			braced = c == DOLLAR and next == OPEN_CURLY
			digits = at + 1 + (if braced then 1 else 0)
			end = digits
			while end < replacement.length and is_digit(byte_at(replacement.address + end).value) { end = end + 1 }
			if c == DOLLAR and end > digits {
				group = number_in(text_from(replacement.address + digits, (end - digits) as u32))
				if group < GROUPS { output = joined(output, group_text(subject, groups, group)) }
				at = end + (if braced then 1 else 0)
			} else {
				output = joined(output, text_from(replacement.address + at, 1))
				at = at + 1
			}
		}
	}
	output
}
is_digit(c: u8): bool := c >= 48 and c <= 57
number_in(digits: text): i64 := {
	n = 0 as i64
	for i in 0..digits.length { n = n * 10 + ((byte_at(digits.address + i).value - 48) as i64) }
	n
}

## hash: sha256 as lowercase hex, crc32 as a number, of a text's UTF-8 bytes or a list of 0 to 255, NULs and all
HEX_DIGITS = 16
CRC_POLYNOMIAL = 3988292384
ALL_BITS = 4294967295
BLOCK = 64
hash_answered(caller: handle, context: handle, member: text, listed: pointer, result: pointer): nothing := {
	given = item_of(caller, context, listed, 1)
	subject = text_from(c_bytes(caller, context, given), c_bytes_length(caller, context, given) as u32)
	if same_text(member, "sha256") { return guest_text_of(caller, context, sha256_hex(subject), result) }
	if same_text(member, "crc32") { return guest_int(caller, context, "new_int", crc32_of(subject) as i64, result) }
	guest_error(caller, context, lacking("hash", member), result)
}
crc32_of(bytes: text): u32 := {
	crc = ALL_BITS as u32
	for i in 0..bytes.length {
		crc = crc xor (byte_at(bytes.address + i).value as u32)
		for bit in 0..8 { crc = if (crc & 1 as u32) != 0 then (crc >> 1 as u32) xor CRC_POLYNOMIAL as u32 else crc >> 1 as u32 }
	}
	crc xor ALL_BITS as u32
}
# FIPS 180-4's SHA-256, its constants the first 32 bits of the fractions of the first primes' square and cube roots
sha256_hex(bytes: text): text := {
	state = allocate(32)
	rounds = allocate(256)
	prime = 2 as i64
	for i in 0..BLOCK {
		if i < 8 { word_at(state + i * 4).value = fraction_bits(sqrt(prime as f64)) }
		word_at(rounds + i * 4).value = fraction_bits(cbrt(prime as f64))
		prime = prime_after(prime)
	}
	padded_length = (bytes.length as i64 + 9 + BLOCK - 1) / BLOCK * BLOCK
	padded = allocate(padded_length as i32)
	memcpy(padded, native_pointer(bytes.address), bytes.length as i64)
	byte_at(padded + bytes.length).value = 128
	bits = bytes.length as i64 * 8
	for i in 0..8 { byte_at(padded + padded_length - 1 - i).value = ((bits >> (8 * i) as i64) % 256) as u8 }
	schedule = allocate(256)
	for block in 0..(padded_length / BLOCK) { compressed(state, rounds, schedule, padded + block * BLOCK) }
	hex = allocate(64)
	for i in 0..32 {
		b = byte_at(state + (i / 4) * 4 + 3 - i % 4).value
		byte_at(hex + i * 2).value = hex_digit(b / HEX_DIGITS)
		byte_at(hex + i * 2 + 1).value = hex_digit(b % HEX_DIGITS)
	}
	text_from(hex, 64)
}
fraction_bits(x: f64): u32 := (((x - ((x as i64) as f64)) * 4294967296.0) as i64) as u32
prime_after(p: i64): i64 := {
	n = p + 1
	while not is_prime(n) { n = n + 1 }
	n
}
is_prime(n: i64): bool := {
	d = 2 as i64
	while d * d <= n {
		if n % d == 0 { return no }
		d = d + 1
	}
	yes
}
hex_digit(n: u8): u8 := if n < 10 then n + 48 else n + 87
rotated(x: u32, n: u32): u32 := (x >> n) | (x << (32 - n) as u32)
# one 64-byte block folded into the state
compressed(state: pointer, rounds: pointer, schedule: pointer, block: pointer): nothing := {
	for i in 0..16 {
		word = 0 as u32
		for j in 0..4 { word = (word << 8 as u32) | (byte_at(block + i * 4 + j).value as u32) }
		word_at(schedule + i * 4).value = word
	}
	for i in 16..64 {
		w15 = word_at(schedule + (i - 15) * 4).value
		w2 = word_at(schedule + (i - 2) * 4).value
		s0 = rotated(w15, 7 as u32) xor rotated(w15, 18 as u32) xor (w15 >> 3 as u32)
		s1 = rotated(w2, 17 as u32) xor rotated(w2, 19 as u32) xor (w2 >> 10 as u32)
		word_at(schedule + i * 4).value = word_at(schedule + (i - 16) * 4).value + s0 + word_at(schedule + (i - 7) * 4).value + s1
	}
	a = word_at(state).value
	b = word_at(state + 4).value
	c = word_at(state + 8).value
	d = word_at(state + 12).value
	e = word_at(state + 16).value
	f = word_at(state + 20).value
	g = word_at(state + 24).value
	h = word_at(state + 28).value
	for i in 0..64 {
		choice = (e & f) xor ((e xor ALL_BITS as u32) & g)
		first = h + (rotated(e, 6 as u32) xor rotated(e, 11 as u32) xor rotated(e, 25 as u32)) + choice + word_at(rounds + i * 4).value + word_at(schedule + i * 4).value
		majority = (a & b) xor (a & c) xor (b & c)
		second = (rotated(a, 2 as u32) xor rotated(a, 13 as u32) xor rotated(a, 22 as u32)) + majority
		h = g
		g = f
		f = e
		e = d + first
		d = c
		c = b
		b = a
		a = first + second
	}
	word_at(state).value = word_at(state).value + a
	word_at(state + 4).value = word_at(state + 4).value + b
	word_at(state + 8).value = word_at(state + 8).value + c
	word_at(state + 12).value = word_at(state + 12).value + d
	word_at(state + 16).value = word_at(state + 16).value + e
	word_at(state + 20).value = word_at(state + 20).value + f
	word_at(state + 24).value = word_at(state + 24).value + g
	word_at(state + 28).value = word_at(state + 28).value + h
}

# what a pipe gives until its end, in a C buffer
struct Printed { at: handle; size: i64 }
piped(pipe: handle): Printed := {
	room = COMMAND_OUTPUT_BYTES
	at = malloc(room)
	size = 0
	got = 1
	while got > 0 {
		if size == room {
			room = room * 2
			at = realloc(at, room)
		}
		got = fread(at + size, 1, room - size, pipe)
		size = size + got
	}
	Printed(at, size)
}
# what a sh line printed on stdout, its trailing newlines left off; "" when sh cannot run
command_output(line: text): text := {
	pipe = popen(c_string(line), c_string("r"))
	if pipe == 0 { return "" }
	printed = piped(pipe)
	pclose(pipe)
	output = trimmed_end(native_copy(printed.at, printed.size))
	free(printed.at)
	output
}
# the `length` bytes at a C pointer, copied into a text
native_copy(at: handle, length: i64): text := {
	copy = allocate(length as i32)
	memcpy(copy, at, length)
	text_from(copy, length as u32)
}
# the byte at a C pointer
native_byte(at: handle): u8 := {
	cell = allocate(1)
	memcpy(cell, at, 1)
	byte_at(cell).value
}
# an export of the module calling the host (caller), else (0) of the native host module (host_export)
exported(caller: handle, context: handle, name: text, into: pointer): bool := if caller != 0 then wasmtime_caller_export_get(caller, name, name.length, into) else host_export(context, name, into)
# the module's export `name` called on the values, its result into `result`
guest_call(caller: handle, context: handle, name: text, values: pointer, count: i64, result: pointer): nothing := {
	function = allocate(EXTERN_BYTES)
	if not exported(caller, context, name, function) {
		complain(joined("the module exports no ", name))
		exit(1)
	}
	trap = allocate(8)
	long_at(trap).value = 0
	checked(wasmtime_func_call(context, function + 8, values, count, result, 1, trap), trap)
}
# where the module's memory starts, for the driver
guest_memory(caller: handle, context: handle): handle := {
	memory = allocate(EXTERN_BYTES)
	wasmtime_caller_export_get(caller, "memory", 6, memory)
	wasmtime_memory_data(context, memory + 8)
}
# the module's shown_at of a value: its address and length in the module's memory, packed
shown_packed(caller: handle, context: handle, value: pointer): i64 := {
	result = allocate(VALUE_BYTES)
	guest_call(caller, context, "shown_at", value, 1, result)
	packed = long_at(result + VALUE_OFFSET).value
	if packed < 0 {
		complain("a host word's argument too long to show")
		exit(1)
	}
	packed
}
# a value of the module as print shows it, of any length: part by part through the output area (runtime/show.warp
# shown_from), a whole file's text for sha256 too; a module built before shown_from shows it at once (shown_at)
shown(caller: handle, context: handle, value: pointer): text := {
	probe = allocate(EXTERN_BYTES)
	if not wasmtime_caller_export_get(caller, "shown_from", 10, probe) { return text_in(guest_memory(caller, context), shown_packed(caller, context, value)) }
	whole = ""
	at = 0 as i64
	part = SHOWN_PART
	while part == SHOWN_PART {
		chunk = text_in(guest_memory(caller, context), long_at(indexed(caller, context, "shown_from", value, at) + VALUE_OFFSET).value)
		whole = joined(whole, chunk)
		part = chunk.length as i64
		at = at + part
	}
	whole
}
# the text shown_at packed (address, length) in the module's memory at `memory`, copied out
text_in(memory: handle, packed: i64): text := {
	length = packed % TEXT_SHIFT
	copy = allocate(length as i32)
	memcpy(copy, memory + packed / TEXT_SHIFT, length)
	text_from(copy, length as u32)
}
# the module's Error of the message
guest_error(caller: handle, context: handle, message: text, result: pointer): nothing := {
	built = allocate(VALUE_BYTES)
	guest_text(caller, context, native_pointer(message.address), message.length as i64, built)
	guest_call(caller, context, "error_of", built, 1, result)
}

## C calls
# a module calling C describes each C function in its warp.c_functions section, a line of tab-separated fields each:
# import module, library, name, parameters, C result register, what the result
# crosses as, the first out-pointer's pointee, struct layouts, how a failure shows. One the driver can't make (bytes,
# structs) stops the run saying so
WASM_HEADER = 8
CUSTOM_SECTION = 0
TAB = 9
NEWLINE = 10
COMMA = 44
REGISTERS = 8
WASM_PAGE_BYTES = 65536
# the section `name` of a wasm module, else the empty text
custom_section(module: text, name: text): text := {
	at = module.address + WASM_HEADER
	end = module.address + module.length
	while at < end {
		size = leb_at(at + 1)
		content = at + 1 + leb_length(at + 1)
		if byte_at(at).value == CUSTOM_SECTION {
			named = text_from(content + leb_length(content), leb_at(content))
			body = named.address + named.length
			if same_text(named, name) { return text_from(body, (content + size - body) as u32) }
		}
		at = content + size
	}
	text_from(0, 0)
}
# the unsigned LEB128 number at `at`, and how many bytes it takes
leb_at(at: pointer): u32 := {
	n = 0 as u32
	for i in 0..leb_length(at) { n = n + ((byte_at(at + i).value % 128) as u32 << (7 * i) as u32) }
	n
}
leb_length(at: pointer): u32 := {
	length = 1 as u32
	while byte_at(at + length - 1).value >= 128 { length = length + 1 }
	length
}
# the field `index` of a text split by `separator`, the empty text past its last
field(line: text, index: int, separator: int): text := {
	start = 0
	seen = 0
	for i in 0..line.length {
		if byte_at(line.address + i).value == separator {
			if seen == index { return text_from(line.address + start, (i - start) as u32) }
			seen = seen + 1
			start = i + 1
		}
	}
	if seen == index then text_from(line.address + start, (line.length - start) as u32) else text_from(0, 0)
}
field_count(line: text, separator: int): int := {
	if line.length == 0 { return 0 }
	count = 1
	for i in 0..line.length { if byte_at(line.address + i).value == separator { count = count + 1 } }
	count
}
# the line of the C function the module imports as `from`.`name`, else the empty text
c_line(table: text, from: text, name: text): text := {
	for i in 0..field_count(table, NEWLINE) {
		line = field(table, i, NEWLINE)
		if same_text(field(line, 0, TAB), from) and same_text(field(line, 2, TAB), name) { return line }
	}
	text_from(0, 0)
}
# a C function as its callback's data, its line read once: its address and name, each parameter's kind (a byte each),
# its result's register and what it crosses as, how a failure shows, the first out-pointer's pointee
# (`wasm`: a wasm module's function, wasm_exports_of, else 0)
struct Foreign { function: handle; name: pointer; name_length: u32; kinds: pointer; count: i32; register: i32; crossing: i32; failure: i32; pointee: pointer; pointee_length: u32; wasm: pointer }
foreign_at(address: pointer): Foreign := address
# the kinds of the words the C signatures name them by, each word's kind in one place (parameter_kind, register_of, …);
# 0 is a word the driver doesn't know
PARAMETER_I32 = 1
PARAMETER_I64 = 2
PARAMETER_F32 = 3
PARAMETER_F64 = 4
PARAMETER_TEXT = 5
PARAMETER_HANDLE = 6
PARAMETER_OUT = 7
PARAMETER_TEXTS = 8
PARAMETER_BYTES = 9
PARAMETER_LENGTH = 10
REGISTER_I32 = 1
REGISTER_I64 = 2
REGISTER_F32 = 3
REGISTER_F64 = 4
REGISTER_BOOL = 5
REGISTER_VOID = 6
CROSSING_NUMBER = 1
CROSSING_TEXT = 2
CROSSING_OWNED_TEXT = 3
CROSSING_HANDLE = 4
CROSSING_U32 = 5
FAILURE_NONE = 1
FAILURE_NOT_NULL = 2
FAILURE_FALSE = 3
parameter_kind(name: text): i32 := {
	if same_text(name, "i32") { return PARAMETER_I32 }
	if same_text(name, "i64") { return PARAMETER_I64 }
	if same_text(name, "f32") { return PARAMETER_F32 }
	if same_text(name, "f64") { return PARAMETER_F64 }
	if same_text(name, "ptr") { return PARAMETER_TEXT }
	if same_text(name, "handle") { return PARAMETER_HANDLE }
	if same_text(name, "out") { return PARAMETER_OUT }
	if same_text(name, "texts") { return PARAMETER_TEXTS }
	if same_text(name, "bytes") { return PARAMETER_BYTES }
	if same_text(name, "length") { return PARAMETER_LENGTH }
	0
}
register_of(name: text): i32 := {
	if same_text(name, "i32") { return REGISTER_I32 }
	if same_text(name, "i64") { return REGISTER_I64 }
	if same_text(name, "f32") { return REGISTER_F32 }
	if same_text(name, "f64") { return REGISTER_F64 }
	if same_text(name, "bool") { return REGISTER_BOOL }
	if same_text(name, "void") { return REGISTER_VOID }
	0
}
crossing_of(name: text): i32 := {
	if same_text(name, "number") { return CROSSING_NUMBER }
	if same_text(name, "text") { return CROSSING_TEXT }
	if same_text(name, "owned_text") { return CROSSING_OWNED_TEXT }
	if same_text(name, "handle") { return CROSSING_HANDLE }
	if same_text(name, "u32") { return CROSSING_U32 }
	0
}
failure_of(name: text): i32 := {
	if name.length == 0 { return FAILURE_NONE }
	if same_text(name, "not_null") { return FAILURE_NOT_NULL }
	if same_text(name, "false") { return FAILURE_FALSE }
	0
}
# a field of a C function's line the driver doesn't know stops the run naming it
known(kind: i32, name: text, what: text, word: text): i32 := {
	if kind == 0 { failed_call(joined(joined(joined(joined(name, ": "), what), word), ", not in the native driver yet")) }
	kind
}
# the C function of a line, found in its library; one the driver can't call stops the run naming it. One its library
# lacks, or a library not found, stops the run only when called: a program may ask for an optional library first
# (lib/native_host.warp's SDL3 and mpg123: a machine without them stays windowless and silent)
foreign_of(line: text, wasm: pointer): i64 := {
	library = field(line, 1, TAB)
	name = field(line, 2, TAB)
	function = if wasm == 0 then library_function(c_string(library), c_string(name)) else 0
	parameters = field(line, 3, TAB)
	count = field_count(parameters, COMMA)
	kinds = allocate(count as i32)
	floats = 0
	for p in 0..count {
		type = field(parameters, p, COMMA)
		kind = known(parameter_kind(type), name, "a parameter ", type)
		byte_at(kinds + p).value = kind as u8
		if kind == PARAMETER_F32 or kind == PARAMETER_F64 { floats = floats + 1 }
	}
	if floats > REGISTERS or count - floats > REGISTERS { failed_call(joined(name, ": more than 8 integer or float parameters, not in the native driver yet")) }
	register = known(register_of(field(line, 4, TAB)), name, "a result register ", field(line, 4, TAB))
	crossing = known(crossing_of(field(line, 5, TAB)), name, "a result crossing as ", field(line, 5, TAB))
	failure = known(failure_of(field(line, 8, TAB)), name, "a failure shown as ", field(line, 8, TAB))
	pointee = field(line, 6, TAB)
	Foreign(function, name.address, name.length, kinds, count as i32, register, crossing, failure, pointee.address, pointee.length, wasm) as i64
}
failed_call(message: text): nothing := {
	complain(message)
	exit(1)
}

# the call of a C function with the module's values: numbers as they are, a text NUL-terminated, bytes copied and their
# count the length after them, a handle id its C pointer, the first out-pointer a slot that becomes the result; its
# result crossed back the same way
# 1 for a parameter the program passes a value for, 0 for the out pointer and the length the call adds itself
program_argument(kind: i32): i32 := if kind == PARAMETER_OUT or kind == PARAMETER_LENGTH then 0 else 1
c_called(c: Foreign, caller: handle, context: handle, given: pointer, results: pointer, results_count: i64): nothing := {
	if c.wasm != 0 { wasm_called(c, caller, context, given, results, results_count) } else { library_called(c, caller, context, given, results, results_count) }
}
# the call of a C library's function (dlopen'd)
library_called(c: Foreign, caller: handle, context: handle, given: pointer, results: pointer, results_count: i64): nothing := {
	name = text_from(c.name, c.name_length)
	if c.function == 0 { failed_call(joined(joined("no C function ", name), " in its library, or the library not found")) }
	integers = allocate(REGISTERS * 8)
	floats = allocate(REGISTERS * 8)
	out = allocate(8)
	integer_count = 0
	float_count = 0
	passed = 0
	outs = 0
	bytes_length = 0
	for p in 0..c.count {
		kind = byte_at(c.kinds + p).value as i32
		value = given + passed * VALUE_BYTES + VALUE_OFFSET
		if kind == PARAMETER_F32 or kind == PARAMETER_F64 {
			long_at(floats + float_count * 8).value = if kind == PARAMETER_F64 then long_at(value).value else word_at(value).value as i64
			float_count = float_count + 1
		} else {
			long_at(integers + integer_count * 8).value = if kind == PARAMETER_LENGTH then bytes_length else c_argument(caller, context, name, kind, value, if outs == 0 then out else 0)
			integer_count = integer_count + 1
		}
		if kind == PARAMETER_BYTES { bytes_length = c_bytes_length(caller, context, value - VALUE_OFFSET) }
		if kind == PARAMETER_OUT { outs = outs + 1 }
		passed = passed + program_argument(kind)
	}
	returned = native_call(c.function, integers, floats, if c.register == REGISTER_F32 or c.register == REGISTER_F64 then 1 else 0)
	c_finished(c, caller, context, returned, long_at(out).value, results, results_count)
}
## C functions of a wasm module (card wasm-instance-c-calls)
# A module the program uses by its path whose foreign lines cross texts, bytes or an out-pointer (test/fixtures/wasm/
# zlib.warp beside zlib.wasm): each such argument copied into a block of the module's own memory, from its malloc,
# freed by its free after the call; a text result read from its memory. As web/playground/host-foreign.js callC does;
# numbers only, its export is linked as it is (instances_linked)
crosses_memory(line: text): bool := {
	parameters = field(line, 3, TAB)
	numbers = yes
	for p in 0..field_count(parameters, COMMA) {
		kind = parameter_kind(field(parameters, p, COMMA))
		if kind != PARAMETER_I32 and kind != PARAMETER_I64 and kind != PARAMETER_F32 and kind != PARAMETER_F64 { numbers = no }
	}
	not numbers or not same_text(field(line, 5, TAB), "number")
}
# the module's function, memory, malloc and free (each an extern of EXTERN_BYTES, then a byte each: whether the module
# exports it), got from the linker before the function's name is shadowed by the call through the driver
WASM_FUNCTION = 0
WASM_MEMORY = 1
WASM_MALLOC = 2
WASM_FREE = 3
WASM_EXPORTS = 4
wasm_exports_of(linker: handle, context: handle, module: text, name: text): pointer := {
	exports = allocate((WASM_EXPORTS * EXTERN_BYTES + WASM_EXPORTS) as i32)
	wasm_export_got(linker, context, module, name, exports, WASM_FUNCTION)
	wasm_export_got(linker, context, module, "memory", exports, WASM_MEMORY)
	wasm_export_got(linker, context, module, "malloc", exports, WASM_MALLOC)
	wasm_export_got(linker, context, module, "free", exports, WASM_FREE)
	if not wasm_exported(exports, WASM_FUNCTION) or not wasm_exported(exports, WASM_MEMORY) { failed_call(joined(joined(joined(module, " exports no "), name), " or no memory")) }
	exports
}
wasm_export_got(linker: handle, context: handle, module: text, name: text, exports: pointer, which: i64): nothing := {
	byte_at(exports + WASM_EXPORTS * EXTERN_BYTES + which).value = if wasmtime_linker_get(linker, context, module, module.length, name, name.length, wasm_export(exports, which)) then 1 else 0
}
wasm_export(exports: pointer, which: i64): pointer := exports + which * EXTERN_BYTES
wasm_exported(exports: pointer, which: i64): bool := byte_at(exports + WASM_EXPORTS * EXTERN_BYTES + which).value == 1
wasm_memory(context: handle, exports: pointer): handle := wasmtime_memory_data(context, wasm_export(exports, WASM_MEMORY) + 8)
# the module's export called with the values, its first result as an i64 (an i32 unsigned), 0 for none
wasm_function_called(context: handle, exports: pointer, which: i64, arguments: pointer, count: i64): i64 := {
	function = wasm_export(exports, which) + 8
	results_count = native_long(wasm_functype_results(wasmtime_func_type(context, function)))
	results = allocate(VALUE_BYTES * MAX_RESULTS)
	trap = allocate(8)
	long_at(trap).value = 0
	checked(wasmtime_func_call(context, function, arguments, count, results, results_count, trap), trap)
	if results_count == 0 then 0 else value_number(results)
}
# a value's number as an i64, an i32's unsigned
value_number(value: pointer): i64 := if byte_at(value).value == KIND_I32 then word_at(value + VALUE_OFFSET).value as i64 else long_at(value + VALUE_OFFSET).value
# an i32 as the call's value
wasm_i32(values: pointer, at: i64, value: i64): nothing := {
	byte_at(values + at * VALUE_BYTES).value = KIND_I32
	word_at(values + at * VALUE_BYTES + VALUE_OFFSET).value = value as u32
}
# a block of `size` bytes in the module's memory, from its malloc, holding the bytes at `host` (zeros for 0)
wasm_block(c: Foreign, context: handle, host: handle, size: i64): i64 := {
	if not wasm_exported(c.wasm, WASM_MALLOC) { failed_call(joined(text_from(c.name, c.name_length), " takes a text or out-pointer, but its module exports no malloc(size)")) }
	argument = allocate(VALUE_BYTES)
	wasm_i32(argument, 0, size)
	block = wasm_function_called(context, c.wasm, WASM_MALLOC, argument, 1)
	if block == 0 { failed_call(joined(text_from(c.name, c.name_length), ": the module's malloc gave no memory")) }
	place = wasm_memory(context, c.wasm) + block
	if host == 0 { memset(place, 0, size) } else { memmove(place, host, size) }
	block
}
wasm_freed(c: Foreign, context: handle, block: i64): nothing := {
	if wasm_exported(c.wasm, WASM_FREE) and block != 0 {
		argument = allocate(VALUE_BYTES)
		wasm_i32(argument, 0, block)
		wasm_function_called(context, c.wasm, WASM_FREE, argument, 1)
	}
}
WASM_POINTER_BYTES = 4
wasm_called(c: Foreign, caller: handle, context: handle, given: pointer, results: pointer, results_count: i64): nothing := {
	name = text_from(c.name, c.name_length)
	arguments = allocate((c.count * VALUE_BYTES) as i32)
	blocks = allocate((c.count * 8) as i32)
	block_count = 0
	out = 0 as i64
	passed = 0
	bytes_length = 0 as i64
	for p in 0..c.count {
		kind = byte_at(c.kinds + p).value as i32
		value = given + passed * VALUE_BYTES + VALUE_OFFSET
		argument = arguments + p * VALUE_BYTES
		if kind == PARAMETER_HANDLE or kind == PARAMETER_TEXTS { failed_call(joined(name, ": a handle or a list of texts into a wasm module, not in the native driver yet")) }
		if kind == PARAMETER_TEXT or kind == PARAMETER_BYTES or kind == PARAMETER_OUT {
			# (a later out-pointer is NULL, as for a C library)
			block = 0 as i64
			if kind == PARAMETER_TEXT {
				host = c_argument(caller, context, name, kind, value, 0)
				block = wasm_block(c, context, host, strlen(host) + 1)
			}
			if kind == PARAMETER_BYTES {
				bytes_length = c_bytes_length(caller, context, value - VALUE_OFFSET)
				block = wasm_block(c, context, c_argument(caller, context, name, kind, value, 0), bytes_length)
			}
			if kind == PARAMETER_OUT and out == 0 {
				block = wasm_block(c, context, 0, WASM_POINTER_BYTES)
				out = block
			}
			long_at(blocks + block_count * 8).value = block
			block_count = block_count + 1
			wasm_i32(arguments, p, block)
		} else if kind == PARAMETER_LENGTH {
			wasm_i32(arguments, p, bytes_length)
		} else {
			byte_at(argument).value = if kind == PARAMETER_I32 then KIND_I32 else if kind == PARAMETER_I64 then KIND_I64 else if kind == PARAMETER_F32 then KIND_F32 else KIND_F64
			long_at(argument + VALUE_OFFSET).value = long_at(value).value
		}
		passed = passed + program_argument(kind)
	}
	returned = wasm_function_called(context, c.wasm, WASM_FUNCTION, arguments, c.count as i64)
	pointed = if out == 0 then 0 else (native_long(wasm_memory(context, c.wasm) + out) % 4294967296 + 4294967296) % 4294967296
	gives_text = c.crossing == CROSSING_TEXT or c.crossing == CROSSING_OWNED_TEXT
	# (a text result read where it is in the module's memory)
	c_finished(c, caller, context, if gives_text and returned != 0 then wasm_memory(context, c.wasm) + returned else returned, pointed, results, results_count)
	if c.crossing == CROSSING_OWNED_TEXT { wasm_freed(c, context, returned) }
	for i in 0..block_count { wasm_freed(c, context, long_at(blocks + i * 8).value) }
}
# a C call's result checked as its line says how a failure shows, then crossed back: the first out-pointer's value
# (`pointed`) where the line names its pointee, else what the function returned
c_finished(c: Foreign, caller: handle, context: handle, returned: i64, pointed: i64, results: pointer, results_count: i64): nothing := {
	name = text_from(c.name, c.name_length)
	if (c.failure == FAILURE_NOT_NULL and returned != 0) or (c.failure == FAILURE_FALSE and returned % 256 == 0) { failed_call(joined(joined(name, " failed, C result "), text_of(returned))) }
	if c.pointee_length > 0 and pointed == 0 { failed_call(joined(joined(joined(joined(name, " gave no "), text_from(c.pointee, c.pointee_length)), ", C status "), text_of(returned % 4294967296))) }
	if results_count > 0 { c_result(caller, context, c, if c.pointee_length > 0 then pointed else returned, results) }
}
# the register of a parameter that is no float: a number, a text's C copy, a handle's pointer, an out-pointer's slot
c_argument(caller: handle, context: handle, name: text, kind: i32, value: pointer, out: pointer): i64 := {
	if kind == PARAMETER_I32 { return word_at(value).value as i64 }
	if kind == PARAMETER_I64 { return long_at(value).value }
	if kind == PARAMETER_TEXT { return native_pointer(c_string(shown(caller, context, value - VALUE_OFFSET))) }
	if kind == PARAMETER_OUT { return if out == 0 then 0 else native_pointer(out) }
	if kind == PARAMETER_TEXTS { return native_pointer(c_strings(caller, context, value - VALUE_OFFSET)) }
	if kind == PARAMETER_BYTES { return native_pointer(c_bytes(caller, context, value - VALUE_OFFSET)) }
	id = word_at(value).value as i32
	if not handle_known(id) { failed_call(joined(joined(name, ": no handle "), text_of(id))) }
	handle_pointer(id)
}
# a text's bytes or a list of 0 to 255 of the module, copied into the arena, and how many they are
c_bytes(caller: handle, context: handle, given: pointer): pointer := {
	if guest_flag(caller, context, "is_textual", given) { return c_string(shown(caller, context, given)) }
	count = guest_number(caller, context, "item_count", given)
	bytes = allocate(count as i32)
	for i in 0..count { byte_at(bytes + i).value = (long_at(indexed(caller, context, "int_item_at", given, i + 1) + VALUE_OFFSET).value % 256) as u8 }
	bytes
}
c_bytes_length(caller: handle, context: handle, given: pointer): i64 := if guest_flag(caller, context, "is_textual", given) then shown(caller, context, given).length as i64 else guest_number(caller, context, "item_count", given)
# a list of texts of the module as a NULL-terminated array of C strings (argv), the strings and it in the arena
c_strings(caller: handle, context: handle, list: pointer): pointer := {
	counted = allocate(VALUE_BYTES)
	guest_call(caller, context, "item_count", list, 1, counted)
	count = long_at(counted + VALUE_OFFSET).value
	array = allocate(((count + 1) * 8) as i32)
	for i in 0..count { long_at(array + i * 8).value = native_pointer(c_string(shown(caller, context, item_of(caller, context, list, i + 1)))) }
	array
}
# the C result as the module's value: a text, a handle id, else the number in its register
c_result(caller: handle, context: handle, c: Foreign, returned: i64, result: pointer): nothing := {
	value = result + VALUE_OFFSET
	if c.crossing == CROSSING_TEXT or c.crossing == CROSSING_OWNED_TEXT {
		if returned == 0 { guest_call(caller, context, "new_empty", 0, 0, result) } else { guest_text(caller, context, returned, strlen(returned), result) }
		# (a wasm module's own text is freed by its free, wasm_called)
		if c.crossing == CROSSING_OWNED_TEXT and returned != 0 and c.wasm == 0 { free(returned) }
	} else {
		if c.crossing == CROSSING_HANDLE {
			byte_at(result).value = KIND_I32
			word_at(value).value = handle_id(returned) as u32
		} else if c.crossing == CROSSING_U32 {
			# an unsigned 32-bit result as the int it means: zlib's crc32 3400449319, never -894517977
			byte_at(result).value = KIND_I64
			long_at(value).value = (returned % 4294967296 + 4294967296) % 4294967296
		} else {
			byte_at(result).value = register_kind(c.register)
			long_at(value).value = if c.register == REGISTER_BOOL then (if returned % 256 == 0 then 0 else 1) else (if c.register == REGISTER_I64 or c.register == REGISTER_F64 then returned else returned % 4294967296)
		}
	}
}
register_kind(register: i32): u8 := if register == REGISTER_I64 then KIND_I64 else if register == REGISTER_F64 then KIND_F64 else if register == REGISTER_F32 then KIND_F32 else KIND_I32
# the module's text of `length` bytes at a C pointer, into `result`: written where its text_heap global says (a module
# calling C exports it), else at the end of its memory, grown for them
guest_text(caller: handle, context: handle, bytes: handle, length: i64, result: pointer): nothing := guest_bytes_built(caller, context, bytes, length, "new_text", result)
# the bytes in the module's memory, built into a node by its builder of an (address, length): new_text, new_symbol
guest_bytes_built(caller: handle, context: handle, bytes: handle, length: i64, builder: text, result: pointer): nothing := {
	heap = allocate(EXTERN_BYTES)
	has_heap = exported(caller, context, "text_heap", heap)
	memory = allocate(EXTERN_BYTES)
	exported(caller, context, "memory", memory)
	top = allocate(VALUE_BYTES)
	place = 0 as i64
	if has_heap {
		wasmtime_global_get(context, heap + 8, top)
		place = word_at(top + VALUE_OFFSET).value as i64
	}
	size = wasmtime_memory_data_size(context, memory + 8)
	if place == 0 or place + length > size {
		if wasmtime_memory_grow(context, memory + 8, length / WASM_PAGE_BYTES + 1, allocate(8)) != 0 { failed_call("the module's memory would not grow for a host text") }
		place = size
	}
	memmove(wasmtime_memory_data(context, memory + 8) + place, bytes, length)
	if has_heap {
		word_at(top + VALUE_OFFSET).value = (place + length) as u32
		if wasmtime_global_set(context, heap + 8, top) != 0 { failed_call("the module's text_heap would not move") }
	}
	values = allocate(2 * VALUE_BYTES)
	byte_at(values).value = KIND_I32
	word_at(values + VALUE_OFFSET).value = place as u32
	byte_at(values + VALUE_BYTES).value = KIND_I32
	word_at(values + VALUE_BYTES + VALUE_OFFSET).value = length as u32
	guest_call(caller, context, builder, values, 2, result)
}

appended = appended_module()
if appended.length > 0 { run(appended, given_from(0), "", PROGRAM_GC_HEAP_BYTES) } else {
	if arg_count() < 2 {
		complain("usage: driver <app.warp | app.wasm> [arguments…]")
		exit(2)
	}
	if ends_with(arg(1), ".warp") { compiled_and_run(compiler_path(), arg(1), 2) } else { module_ran(1) }
}
