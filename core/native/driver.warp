#!/usr/bin/env warp
@primitive
# The native runner (notes/roadmap_native_harness.md milestone 3, notes/primitive.md "Driver"): a primitive file that
# runs wasm modules through wasmtime's C API, called as any C library. `warp build native core/native/driver.warp`
# makes the executable:
#   driver app.warp args…   compiled by warp.wasm (of $WARP_LIB, else beside the driver), then run
#   driver app.wasm args…   the module run
#   a driver with a module appended (<module><its length, u64 little-endian><MODULE_MAGIC><zeros to a multiple of
#   16>, as `warp build` writes it) runs that one
# A module's WASI calls are wasmtime's (the environment inherited, the current folder and the root opened); of the host
# words the driver answers std_io (host_word), any other is a trap naming it. Its _start runs (a GC program prints its
# own value), else its main, whose value is printed; a failure's message goes to stderr with status 1, the module's
# own exit status kept.

# "WRPMwasm" as a little-endian u64, the last bytes of a driver with a module appended
MODULE_MAGIC = 7886754537481982551
TRAILER_BYTES = 16
# 64-bit Mach-O: its header, the count of load commands in it, and LC_CODE_SIGNATURE's command, data offset 8 bytes in
MACHO_MAGIC = 4277009103
MACHO_HEADER = 32
COMMAND_COUNT_AT = 16
CODE_SIGNATURE = 29
SIGNATURE_OFFSET_AT = 8
STDERR = 2
# access()'s R_OK, W_OK and X_OK
READABLE = 4
WRITABLE = 2
EXECUTABLE = 1
COLON = 58
# wasmtime_val_t's kinds, its value 8 bytes in; the sizes of the C structs the calls fill
KIND_I32 = 0
KIND_I64 = 1
KIND_F32 = 2
KIND_F64 = 3
VALUE_OFFSET = 8
EXTERN_BYTES = 32
INSTANCE_BYTES = 16
VALUE_BYTES = 32
VECTOR_BYTES = 16
MAX_RESULTS = 8
MAX_ARGUMENTS = 256
FLOAT_DIGITS = 17
PATH_BYTES = 4096
SLASH = 47
SPACE = 32
SEMICOLON = 59
TEXT_SHIFT = 4294967296
# the exit status of a child whose exec failed (words_run): the command is not found
EXEC_FAILED_STATUS = 127
# the most bytes shown_from gives at once: the output area past its scratch (runtime/text.warp output_room, c_text_at)
SHOWN_PART = 65488
# the host words the driver answers, the number its callback is defined with (answered_word); exit(code) ends the run
# with that status
STD_IO_WORD = 1
EXIT_WORD = 2
SLEEP_WORD = 3
CLOCK_WORD = 4
RANDOM_WORD = 5
RANDOM_BELOW_WORD = 6
RANDOM_SEED_WORD = 7
SYSTEM_VALUE_WORD = 8
STD_PURE_WORD = 9
PAINT_WORD = 10
KEY_HELD_WORD = 11
SET_SYSTEM_VALUE_WORD = 12
PARSE_CODE_WORD = 13
REAL_PATH_WORD = 14
SIGNAL_LISTEN_WORD = 15
EVAL_CODE_WORD = 16
CANONICAL_TEXT_WORD = 17
CHANNEL_LISTEN_WORD = 18
CHANNEL_PENDING_WORD = 19
CHANNEL_NEXT_WORD = 20
CHANNEL_SEND_WORD = 21
SAVE_PICTURE_WORD = 22
# the end of a field in warp.wasm's parse-code encoding (extensions/parse_words.warp FIELD_END)
FIELD_END = 1
# the system values a program sets (set_system_value), kept by foreign.c by slot; before that, the size a window opens
# at and the dots per inch of one CSS pixel per CSS inch
WINDOW_WIDTH_SLOT = 0
WINDOW_HEIGHT_SLOT = 1
DISPLAY_DPI_SLOT = 2
# the running run's linker, engine, linked instances and store context (run_state), for a host word that links a
# module on its first call (lazily_linked); a nested run (eval) keeps its own and gives the outer one back
RUN_SLOT = 3
# the run's timers (signal_listen): a table the run allocates, since a host word's own allocations end with it (events)
TIMERS_SLOT = 4
# whether the run linked unicode (canonical_text), the native host module (host_export), at these places of its block
UNICODE_LINKED_AT = 32
HOST_LINKED_AT = 40
# a run's channel listeners (lib/channels.warp), in its block past those: how many, then each one's
# id, the bytes of its channel's file read so far, its name's length and the name
LISTENERS_AT = 48
LISTENERS_MAX = 32
LISTENER_BYTES = 128
LISTENER_NAME_BYTES = 104
# a machine-wide channel is a file of frames, each a value packed (runtime/packed_nodes.warp): its length in digits, a
# newline and its bytes; the channels' folder only the user's
OWNER_ONLY = 448
NATIVE_VIEW_WIDTH = 640
NATIVE_VIEW_HEIGHT = 480
DEFAULT_DPI = 96
# wasmtime.h's WASMTIME_PROFILING_STRATEGY_PERFMAP
PROFILING_PERFMAP = 3

