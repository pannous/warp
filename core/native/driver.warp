#!/usr/bin/env warp
@primitive
# The native runner (notes/roadmap_native_harness.md milestone 3, notes/primitive.md "Driver"): a primitive file that
# runs wasm modules through wasmtime's C API, called as any C library. `warp build native core/native/driver.warp`
# makes the executable:
#   driver app.warp args…   compiled by warp.wasm (of $WARP_LIB, else beside the driver), then run
#   driver app.wasm args…   the module run
#   a driver with a module appended (<module><its length, u64 little-endian><MODULE_MAGIC><zeros to a multiple of
#   16>, as `warp build` writes it) runs that one
# A module's WASI calls are wasmtime's (the environment inherited, the current folder and the root opened); of the host
# words the driver answers std_io (host_word), any other is a trap naming it. Its _start runs (a GC program prints its
# own value), else its main, whose value is printed; a failure's message goes to stderr with status 1, the module's
# own exit status kept.

# "WRPMwasm" as a little-endian u64, the last bytes of a driver with a module appended
MODULE_MAGIC = 7886754537481982551
TRAILER_BYTES = 16
# 64-bit Mach-O: its header, the count of load commands in it, and LC_CODE_SIGNATURE's command, data offset 8 bytes in
MACHO_MAGIC = 4277009103
MACHO_HEADER = 32
COMMAND_COUNT_AT = 16
CODE_SIGNATURE = 29
SIGNATURE_OFFSET_AT = 8
STDERR = 2
# wasmtime_val_t's kinds, its value 8 bytes in; the sizes of the C structs the calls fill
KIND_I32 = 0
KIND_I64 = 1
KIND_F32 = 2
KIND_F64 = 3
VALUE_OFFSET = 8
EXTERN_BYTES = 32
INSTANCE_BYTES = 16
VALUE_BYTES = 32
VECTOR_BYTES = 16
MAX_RESULTS = 8
MAX_ARGUMENTS = 256
FLOAT_DIGITS = 17
PATH_BYTES = 4096
SLASH = 47
SPACE = 32
TEXT_SHIFT = 4294967296
# the host words the driver answers, the number its callback is defined with
STD_IO_WORD = 1

wasm_config_new(): handle from "wasmtime"
wasmtime_config_wasm_gc_set(config: handle, enabled: bool) from "wasmtime"
wasmtime_config_wasm_function_references_set(config: handle, enabled: bool) from "wasmtime"
wasmtime_config_wasm_exceptions_set(config: handle, enabled: bool) from "wasmtime"
wasmtime_config_cache_config_load(config: handle, path: handle): handle from "wasmtime"
wasm_engine_new_with_config(config: handle): handle from "wasmtime"
wasmtime_store_new(engine: handle, data: handle, finalizer: handle): handle from "wasmtime"
wasmtime_store_context(store: handle): handle from "wasmtime"
wasmtime_linker_new(engine: handle): handle from "wasmtime"
wasmtime_linker_define_wasi(linker: handle): handle from "wasmtime"
wasmtime_linker_define_unknown_imports_as_traps(linker: handle, module: handle): handle from "wasmtime"
wasmtime_linker_define_func(linker: handle, module: text, module_size: i64, name: text, size: i64, type: handle, callback: handle, data: handle, finalizer: handle): handle from "wasmtime"
wasi_config_new(): handle from "wasmtime"
wasi_config_set_argv(config: handle, count: i64, arguments: pointer): bool from "wasmtime"
wasi_config_inherit_stdin(config: handle) from "wasmtime"
wasi_config_inherit_env(config: handle) from "wasmtime"
wasi_config_inherit_stdout(config: handle) from "wasmtime"
wasi_config_inherit_stderr(config: handle) from "wasmtime"
wasi_config_preopen_dir(config: handle, host_path: text, guest_path: text, mutable: bool): bool from "wasmtime"
wasmtime_context_set_wasi(context: handle, config: handle): handle from "wasmtime"
wasmtime_module_new(engine: handle, wasm: pointer, size: i64, module: pointer): handle from "wasmtime"
wasmtime_module_imports(module: handle, imports: pointer) from "wasmtime"
wasm_importtype_module(import: handle): handle from "wasmtime"
wasm_importtype_name(import: handle): handle from "wasmtime"
wasm_importtype_type(import: handle): handle from "wasmtime"
wasm_externtype_as_functype_const(type: handle): handle from "wasmtime"
wasmtime_linker_instantiate(linker: handle, context: handle, module: handle, instance: pointer, trap: pointer): handle from "wasmtime"
wasmtime_instance_export_get(context: handle, instance: pointer, name: text, size: i64, item: pointer): bool from "wasmtime"
wasmtime_caller_context(caller: handle): handle from "wasmtime"
wasmtime_caller_export_get(caller: handle, name: text, size: i64, item: pointer): bool from "wasmtime"
wasmtime_memory_data(context: handle, memory: pointer): handle from "wasmtime"
wasmtime_func_type(context: handle, function: pointer): handle from "wasmtime"
wasm_functype_results(type: handle): handle from "wasmtime"
wasmtime_func_call(context: handle, function: pointer, arguments: pointer, count: i64, results: pointer, results_count: i64, trap: pointer): handle from "wasmtime"
wasmtime_error_message(error: handle, message: pointer) from "wasmtime"
wasmtime_error_exit_status(error: handle, status: pointer): bool from "wasmtime"
wasm_trap_message(trap: handle, message: pointer) from "wasmtime"
wasmtime_global_get(context: handle, global: pointer, value: pointer) from "wasmtime"
wasmtime_global_set(context: handle, global: pointer, value: pointer): handle from "wasmtime"
wasmtime_memory_data_size(context: handle, memory: pointer): i64 from "wasmtime"
wasmtime_memory_grow(context: handle, memory: pointer, delta: i64, previous: pointer): handle from "wasmtime"
library_function(library: pointer, name: pointer): handle from "c"
native_call(function: handle, integers: pointer, floats: pointer, float_result: i32): i64 from "c"
handle_id(pointer: handle): i32 from "c"
handle_known(id: i32): bool from "c"
handle_pointer(id: i32): handle from "c"
strlen(text: handle): i64 from "c"
free(pointer: handle) from "c"
memcpy(destination: pointer, source: handle, size: i64): handle from "c"
fopen(path: pointer, mode: pointer): handle from "c"
fwrite(data: handle, size: i64, count: i64, file: handle): i64 from "c"
fclose(file: handle): i32 from "c"
rename(from: pointer, to: pointer): i32 from "c"
popen(command: pointer, mode: pointer): handle from "c"
pclose(stream: handle): i32 from "c"
fread(data: handle, size: i64, count: i64, stream: handle): i64 from "c"
malloc(size: i64): handle from "c"
realloc(pointer: handle, size: i64): handle from "c"
wasmtime_module_serialize(module: handle, bytes: pointer): handle from "wasmtime"
wasmtime_module_deserialize_file(engine: handle, path: pointer, module: pointer): handle from "wasmtime"
memmove(destination: handle, source: handle, size: i64): handle from "c"
memcmp(a: pointer, b: pointer, size: i64): i32 from "c"
gcvt(value: f64, digits: i32, buffer: pointer): handle from "c"
getenv(name: text): text from "c"
getpid(): i32 from "c"
unlink(path: text): i32 from "c"
_NSGetExecutablePath(buffer: pointer, size: pointer): i32 from "c"
native_pointer(address: pointer): handle from "c"
c_function(name: text): handle from "c"

## texts
# the i64 at a C pointer
native_long(at: handle): i64 := {
	cell = allocate(8)
	memcpy(cell, at, 8)
	long_at(cell).value
}
# the bytes of a wasm_byte_vec_t (its size, then its data) at a C pointer, as a text; a trailing NUL left out
native_vector_text(vector: handle): text := {
	size = native_long(vector)
	copy = allocate(size as i32)
	memcpy(copy, native_long(vector + 8), size)
	if size > 0 and byte_at(copy + size - 1).value == 0 { size = size - 1 }
	text_from(copy, size as u32)
}
same_text(a: text, b: text): bool := a.length == b.length and memcmp(a.address, b.address, a.length) == 0
ends_with(t: text, end: text): bool := t.length >= end.length and memcmp(t.address + t.length - end.length, end.address, end.length) == 0
joined(a: text, b: text): text := {
	copy = allocate((a.length + b.length) as i32)
	memcpy(copy, native_pointer(a.address), a.length)
	memcpy(copy + a.length, native_pointer(b.address), b.length)
	text_from(copy, a.length + b.length)
}
# the folder of a path, "." for a bare name
folder_of(path: text): text := {
	last = -1
	for i in 0..path.length { if byte_at(path.address + i).value == SLASH { last = i } }
	if last < 0 then "." else text_from(path.address, last as u32)
}
# t and a zero byte after it, as C reads a string
c_string(t: text): pointer := {
	copy = allocate((t.length + 1) as i32)
	memcpy(copy, native_pointer(t.address), t.length)
	byte_at(copy + t.length).value = 0
	copy
}

# a line on stderr
complain(line: text): nothing := {
	fd_write(STDERR, line, 1, allocate(4))
	fd_write(STDERR, "\n", 1, allocate(4))
}
# a failed call: the module's exit status if it exited, else the error's or the trap's message, status 1
failed(error: handle, trap: pointer): nothing := {
	message = allocate(VECTOR_BYTES)
	if error != 0 {
		status = allocate(4)
		if wasmtime_error_exit_status(error, status) { exit(word_at(status).value as i32) }
		wasmtime_error_message(error, message)
	} else {
		wasm_trap_message(long_at(trap).value, message)
	}
	complain(native_vector_text(native_pointer(message)))
	exit(1)
}
checked(error: handle, trap: pointer): nothing := {
	if error != 0 or long_at(trap).value != 0 { failed(error, trap) }
}

## where things are
# this executable's own path
executable_path(): text := {
	size = allocate(4)
	word_at(size).value = PATH_BYTES
	path = allocate(PATH_BYTES)
	_NSGetExecutablePath(path, size)
	text_from(path, c_length(path))
}
# the module appended to this executable, else the empty text: at its end, or, in a Mach-O executable signed after
# the module was appended (`warp build`), where its signature begins
appended_module(): text := {
	self = read_file(executable_path())
	at_end = module_before(self, self.length)
	if at_end.length > 0 then at_end else module_before(self, signature_offset(self))
}
# the module whose trailer ends at `end` of the image, else the empty text
module_before(image: text, end: u32): text := {
	last = image.address + end
	# the zeros that pad the trailer to a multiple of 16
	for i in 0..TRAILER_BYTES { if end >= TRAILER_BYTES and byte_at(last - 1).value == 0 { last = last - 1 } }
	if end < TRAILER_BYTES or long_at(last - 8).value != MODULE_MAGIC { return text_from(0, 0) }
	size = long_at(last - TRAILER_BYTES).value as u32
	text_from(last - TRAILER_BYTES - size, size)
}
# where the code signature of a Mach-O executable begins (its LC_CODE_SIGNATURE's data offset), else its length
signature_offset(image: text): u32 := {
	if image.length < MACHO_HEADER or word_at(image.address).value != MACHO_MAGIC { return image.length }
	at = image.address + MACHO_HEADER
	for i in 0..word_at(image.address + COMMAND_COUNT_AT).value {
		if word_at(at).value == CODE_SIGNATURE { return word_at(at + SIGNATURE_OFFSET_AT).value }
		at = at + word_at(at + 4).value
	}
	image.length
}
# warp's lib/, whose warp.wasm compiles a .warp file: $WARP_LIB, else the folder of the driver
library_folder(): text := {
	given = getenv("WARP_LIB")
	if given.length > 0 then given else folder_of(executable_path())
}
# where the compiled module goes for its run: a file of this process in $TMPDIR
compiled_path(): text := {
	folder = getenv("TMPDIR")
	if folder.length == 0 { folder = "/tmp/" }
	if not ends_with(folder, "/") { folder = joined(folder, "/") }
	joined(joined(joined(folder, "warp-native-"), text_of(getpid())), ".wasm")
}

## a module's run
# the WASI arguments of a module: C strings, an array of their pointers
struct Arguments { pointers: pointer; count: i32 }
arguments(): Arguments := Arguments(allocate(MAX_ARGUMENTS * 8), 0)
added(list: Arguments, t: text): nothing := {
	long_at(list.pointers + list.count * 8).value = native_pointer(c_string(t))
	list.count = list.count + 1
}
# the driver's own arguments from `first` on
given_from(first: int): Arguments := {
	list = arguments()
	for i in first..arg_count() { added(list, arg(i)) }
	list
}

# what main gave, printed as its kind is
print_result(result: pointer): nothing := {
	kind = byte_at(result).value
	value = result + VALUE_OFFSET
	if kind == KIND_I32 { print text_of(word_at(value).value as i32) }
	if kind == KIND_I64 { print text_of(long_at(value).value) }
	if kind == KIND_F32 or kind == KIND_F64 {
		number = if kind == KIND_F64 then float_at(value).value else single_at(value).value
		buffer = allocate(32)
		gcvt(number, FLOAT_DIGITS, buffer)
		print text_from(buffer, c_length(buffer))
	}
}
struct Double { value: f64 }
struct Single { value: f32 }
float_at(address: pointer): Double := address
single_at(address: pointer): Single := address

# what warp's modules use beside the MVP: GC, typed function references, exceptions (crates/warp-runtime engine.rs);
# a program's machine code kept in wasmtime's own cache, warp.wasm's beside it (compiled_module)
warp_config(): handle := {
	config = wasm_config_new()
	wasmtime_config_wasm_gc_set(config, yes)
	wasmtime_config_wasm_function_references_set(config, yes)
	wasmtime_config_wasm_exceptions_set(config, yes)
	wasmtime_config_cache_config_load(config, 0)
	config
}

# the host words the module imports that the driver answers, each defined as its callback (lib/native/foreign.c
# warp_host_callback, which calls host_word) with the type the module declares: std_io, and each C function its
# warp.c_functions section describes
host_words_defined(linker: handle, compiled: handle, module: text, trap: pointer): nothing := {
	table = custom_section(module, "warp.c_functions")
	imports = allocate(VECTOR_BYTES)
	wasmtime_module_imports(compiled, imports)
	for i in 0..long_at(imports).value {
		import = native_long(long_at(imports + 8).value + i * 8)
		from = native_vector_text(wasm_importtype_module(import))
		name = native_vector_text(wasm_importtype_name(import))
		if same_text(from, "host") and same_text(name, "std_io") { word_defined(linker, import, STD_IO_WORD, trap) }
		line = c_line(table, from, name)
		if line.length > 0 { word_defined(linker, import, foreign_of(line), trap) }
	}
}
# the import defined as warp_host_callback, `word` its data
word_defined(linker: handle, import: handle, word: i64, trap: pointer): nothing := {
	from = native_vector_text(wasm_importtype_module(import))
	name = native_vector_text(wasm_importtype_name(import))
	type = wasm_externtype_as_functype_const(wasm_importtype_type(import))
	checked(wasmtime_linker_define_func(linker, from, from.length, name, name.length, type, c_function("warp_host_callback"), word, 0), trap)
}

# the module run with the arguments; its machine code kept in the file `machine_code` when one is named
run(module: text, given: Arguments, machine_code: text): nothing := {
	engine = wasm_engine_new_with_config(warp_config())
	context = wasmtime_store_context(wasmtime_store_new(engine, 0, 0))
	linker = wasmtime_linker_new(engine)
	trap = allocate(8)
	checked(wasmtime_linker_define_wasi(linker), trap)
	config = wasi_config_new()
	wasi_config_set_argv(config, given.count, given.pointers)
	wasi_config_inherit_stdin(config)
	wasi_config_inherit_stdout(config)
	wasi_config_inherit_stderr(config)
	wasi_config_inherit_env(config)
	# the current folder for relative paths and the root for absolute ones, as warp's own host opens them
	wasi_config_preopen_dir(config, ".", ".", yes)
	wasi_config_preopen_dir(config, "/", "/", yes)
	checked(wasmtime_context_set_wasi(context, config), trap)
	compiled = compiled_module(engine, module, machine_code, trap)
	host_words_defined(linker, compiled, module, trap)
	checked(wasmtime_linker_define_unknown_imports_as_traps(linker, compiled), trap)
	instance = allocate(INSTANCE_BYTES)
	checked(wasmtime_linker_instantiate(linker, context, compiled, instance, trap), trap)
	entry = allocate(EXTERN_BYTES)
	# a GC program's _start runs main and prints its value itself (the stub's ENTRY_POINTS), a primitive one has main
	if not wasmtime_instance_export_get(context, instance, "_start", 6, entry) and not wasmtime_instance_export_get(context, instance, "main", 4, entry) {
		complain("the module exports neither _start nor main")
		exit(1)
	}
	function = entry + 8
	results_count = native_long(wasm_functype_results(wasmtime_func_type(context, function)))
	results = allocate(VALUE_BYTES * MAX_RESULTS)
	checked(wasmtime_func_call(context, function, 0, 0, results, results_count, trap), trap)
	if results_count > 0 { print_result(results) }
}

# `driver app.warp args…`: warp.wasm compiles the file as the native warp has it compile (src/compiler/standalone.rs
# run_compiler: the file, the module, its folder, lib/, runtime.wasm), then the module runs with the arguments
compiled_and_run(file: text): nothing := {
	library = library_folder()
	output = compiled_path()
	compiling = compiler_arguments()
	added(compiling, file)
	added(compiling, output)
	added(compiling, folder_of(file))
	added(compiling, library)
	added(compiling, joined(library, "/runtime.wasm"))
	compiler_ran(compiling)
	written_run(output, file, 2)
}
# warp.wasm of lib/, the compiler and its commands
compiler_path(): text := joined(library_folder(), "/warp.wasm")
# its arguments: its own path, the words after it added
compiler_arguments(): Arguments := {
	list = arguments()
	added(list, compiler_path())
	list
}
# warp.wasm run with the arguments, its machine code kept beside it (compiled_module)
compiler_ran(given: Arguments): nothing := {
	compiler = read_file(compiler_path())
	if compiler.length == 0 {
		complain(joined("no warp compiler at ", compiler_path()))
		exit(1)
	}
	run(compiler, given, joined(compiler_path(), ".driver.cwasm"))
}
# the module warp.wasm wrote to `output` run, named `name`, with this executable's arguments from `first` on
written_run(output: text, name: text, first: int): nothing := {
	program = read_file(output)
	unlink(output)
	if program.length == 0 {
		complain(joined("warp.wasm wrote no module of ", name))
		exit(1)
	}
	running = arguments()
	added(running, name)
	for i in first..arg_count() { added(running, arg(i)) }
	run(program, running, "")
}

## machine code
# warp.wasm's machine code for this driver's wasmtime, kept beside it with the fingerprint of the warp.wasm it is of:
# the harness's warp.wasm.cwasm is another wasmtime's (crates/warp-runtime 49, other flags), never loadable here.
# Machine code that won't load (another wasmtime) is said in one line, then compiled anew
FNV_OFFSET = -3750763034362895579
FNV_PRIME = 1099511628211
compiled_module(engine: handle, module: text, machine_code: text, trap: pointer): handle := {
	compiled = allocate(8)
	key = joined(machine_code, ".key")
	fingerprint = text_of(fingerprint_of(module))
	if machine_code.length > 0 and same_text(read_file(key), fingerprint) {
		error = wasmtime_module_deserialize_file(engine, c_string(machine_code), compiled)
		if error == 0 { return long_at(compiled).value }
		message = allocate(VECTOR_BYTES)
		wasmtime_error_message(error, message)
		complain(joined(joined(machine_code, ": not this wasmtime's machine code, compiled anew: "), last_line(native_vector_text(native_pointer(message)))))
	}
	checked(wasmtime_module_new(engine, module.address, module.length, compiled), trap)
	if machine_code.length > 0 { kept_machine_code(long_at(compiled).value, machine_code, key, fingerprint, trap) }
	long_at(compiled).value
}
# the text without its trailing newlines
trimmed_end(t: text): text := {
	end = t.length
	while end > 0 and byte_at(t.address + end - 1).value == NEWLINE { end = end - 1 }
	text_from(t.address, end)
}
# the last line of a text that isn't empty: the cause in a wasmtime error's chain
last_line(t: text): text := {
	end = trimmed_end(t).length
	start = end
	while start > 0 and byte_at(t.address + start - 1).value != NEWLINE { start = start - 1 }
	while start < end and byte_at(t.address + start).value == SPACE { start = start + 1 }
	text_from(t.address + start, end - start)
}
# the module's FNV-1a hash
fingerprint_of(module: text): i64 := {
	hash = FNV_OFFSET
	for i in 0..module.length { hash = (hash xor byte_at(module.address + i).value as i64) * FNV_PRIME }
	hash
}
# the compiled module's machine code written to its file, then the fingerprint that names it current; written aside
# and renamed, so a run beside this one never reads half of it
kept_machine_code(compiled: handle, machine_code: text, key: text, fingerprint: text, trap: pointer): nothing := {
	bytes = allocate(VECTOR_BYTES)
	checked(wasmtime_module_serialize(compiled, bytes), trap)
	aside = joined(joined(machine_code, "."), text_of(getpid()))
	file = fopen(c_string(aside), c_string("wb"))
	if file == 0 { return complain(joined(machine_code, ": not writable, warp.wasm compiles anew each run")) }
	fwrite(native_long(native_pointer(bytes) + 8), 1, native_long(native_pointer(bytes)), file)
	fclose(file)
	rename(c_string(aside), c_string(machine_code))
	write_file(key, fingerprint)
}

## host words
# a host word the module calls (STD_IO_WORD), its arguments and results wasmtime_val_t's, through the caller
# (foreign.c warp_host_callback). std_io(module, member, arguments) is the Error that says the driver lacks it
host_word(word: i64, caller: handle, given: pointer, count: i64, results: pointer, results_count: i64): nothing := {
	context = wasmtime_caller_context(caller)
	if word != STD_IO_WORD { return c_called(foreign_at(word as i32), caller, context, given, results, results_count) }
	module = shown(caller, context, given)
	member = shown(caller, context, given + VALUE_BYTES)
	listed = given + 2 * VALUE_BYTES
	if same_text(module, "os") and same_text(member, "command") { return os_command(caller, context, listed, results) }
	guest_error(caller, context, joined(joined(joined(joined("std_io ", module), "."), member), ": not in the native driver yet"), results)
}
# the item of a list value of the module, counted from 1, as a value (its export item_at)
item_of(caller: handle, context: handle, list: pointer, index: i64): pointer := {
	values = allocate(2 * VALUE_BYTES)
	memcpy(values, native_pointer(list), VALUE_BYTES)
	byte_at(values + VALUE_BYTES).value = KIND_I64
	long_at(values + VALUE_BYTES + VALUE_OFFSET).value = index
	item = allocate(VALUE_BYTES)
	guest_call(caller, context, "item_at", values, 2, item)
	item
}

## the host words of warp's commands (core/commands/commands.warp), warp over libc
COMMAND_OUTPUT_BYTES = 4096
# os.command(line): the line run by sh, what it printed, its trailing newlines left off; else the Error naming its exit
# status and what it said on stderr (as crates/warp-runtime std_adapters.rs executed)
os_command(caller: handle, context: handle, listed: pointer, result: pointer): nothing := {
	line = shown(caller, context, item_of(caller, context, listed, 1))
	said = joined(compiled_path(), ".stderr")
	pipe = popen(c_string(joined(joined(joined("{ ", line), "\n} 2>"), said)), c_string("r"))
	if pipe == 0 { return guest_error(caller, context, joined("cannot run sh for ", line), result) }
	room = COMMAND_OUTPUT_BYTES
	printed = malloc(room)
	size = 0
	got = 1
	while got > 0 {
		if size == room {
			room = room * 2
			printed = realloc(printed, room)
		}
		got = fread(printed + size, 1, room - size, pipe)
		size = size + got
	}
	status = pclose(pipe)
	while size > 0 and native_byte(printed + size - 1) == NEWLINE { size = size - 1 }
	if status == 0 { guest_text(caller, context, printed, size, result) } else {
		guest_error(caller, context, joined(joined(joined(joined(joined("sh -c ", line), " failed (exit status: "), text_of(status / 256)), "): "), trimmed_end(read_file(said))), result)
	}
	unlink(said)
	free(printed)
}
# the byte at a C pointer
native_byte(at: handle): u8 := {
	cell = allocate(1)
	memcpy(cell, at, 1)
	byte_at(cell).value
}
# the module's export `name` called on the values, its result into `result`
guest_call(caller: handle, context: handle, name: text, values: pointer, count: i64, result: pointer): nothing := {
	function = allocate(EXTERN_BYTES)
	if not wasmtime_caller_export_get(caller, name, name.length, function) {
		complain(joined("the module exports no ", name))
		exit(1)
	}
	trap = allocate(8)
	long_at(trap).value = 0
	checked(wasmtime_func_call(context, function + 8, values, count, result, 1, trap), trap)
}
# where the module's memory starts, for the driver
guest_memory(caller: handle, context: handle): handle := {
	memory = allocate(EXTERN_BYTES)
	wasmtime_caller_export_get(caller, "memory", 6, memory)
	wasmtime_memory_data(context, memory + 8)
}
# the module's shown_at of a value: its address and length in the module's memory, packed
shown_packed(caller: handle, context: handle, value: pointer): i64 := {
	result = allocate(VALUE_BYTES)
	guest_call(caller, context, "shown_at", value, 1, result)
	packed = long_at(result + VALUE_OFFSET).value
	if packed < 0 {
		complain("a host word's argument too long to show")
		exit(1)
	}
	packed
}
# a value of the module as print shows it
shown(caller: handle, context: handle, value: pointer): text := {
	packed = shown_packed(caller, context, value)
	length = packed % TEXT_SHIFT
	copy = allocate(length as i32)
	memcpy(copy, guest_memory(caller, context) + packed / TEXT_SHIFT, length)
	text_from(copy, length as u32)
}
# the module's Error of the message
guest_error(caller: handle, context: handle, message: text, result: pointer): nothing := {
	built = allocate(VALUE_BYTES)
	guest_text(caller, context, native_pointer(message.address), message.length as i64, built)
	guest_call(caller, context, "error_of", built, 1, result)
}

## C calls
# a module calling C describes each C function in its warp.c_functions section, a line of tab-separated fields each
# (crates/warp-runtime c_signatures.rs): import module, library, name, parameters, C result register, what the result
# crosses as, the first out-pointer's pointee, struct layouts, how a failure shows. One the driver can't make (bytes,
# structs) stops the run saying so
WASM_HEADER = 8
CUSTOM_SECTION = 0
TAB = 9
NEWLINE = 10
COMMA = 44
REGISTERS = 8
WASM_PAGE_BYTES = 65536
# the section `name` of a wasm module, else the empty text
custom_section(module: text, name: text): text := {
	at = module.address + WASM_HEADER
	end = module.address + module.length
	while at < end {
		size = leb_at(at + 1)
		content = at + 1 + leb_length(at + 1)
		if byte_at(at).value == CUSTOM_SECTION {
			named = text_from(content + leb_length(content), leb_at(content))
			body = named.address + named.length
			if same_text(named, name) { return text_from(body, (content + size - body) as u32) }
		}
		at = content + size
	}
	text_from(0, 0)
}
# the unsigned LEB128 number at `at`, and how many bytes it takes
leb_at(at: pointer): u32 := {
	n = 0 as u32
	for i in 0..leb_length(at) { n = n + ((byte_at(at + i).value % 128) as u32 << (7 * i) as u32) }
	n
}
leb_length(at: pointer): u32 := {
	length = 1 as u32
	while byte_at(at + length - 1).value >= 128 { length = length + 1 }
	length
}
# the field `index` of a text split by `separator`, the empty text past its last
field(line: text, index: int, separator: int): text := {
	start = 0
	seen = 0
	for i in 0..line.length {
		if byte_at(line.address + i).value == separator {
			if seen == index { return text_from(line.address + start, (i - start) as u32) }
			seen = seen + 1
			start = i + 1
		}
	}
	if seen == index then text_from(line.address + start, (line.length - start) as u32) else text_from(0, 0)
}
field_count(line: text, separator: int): int := {
	if line.length == 0 { return 0 }
	count = 1
	for i in 0..line.length { if byte_at(line.address + i).value == separator { count = count + 1 } }
	count
}
# the line of the C function the module imports as `from`.`name`, else the empty text
c_line(table: text, from: text, name: text): text := {
	for i in 0..field_count(table, NEWLINE) {
		line = field(table, i, NEWLINE)
		if same_text(field(line, 0, TAB), from) and same_text(field(line, 2, TAB), name) { return line }
	}
	text_from(0, 0)
}
# a C function as its callback's data, its line read once: its address and name, each parameter's kind (a byte each),
# its result's register and what it crosses as, how a failure shows, the first out-pointer's pointee
struct Foreign { function: handle; name: pointer; name_length: u32; kinds: pointer; count: i32; register: i32; crossing: i32; failure: i32; pointee: pointer; pointee_length: u32 }
foreign_at(address: pointer): Foreign := address
# the kinds of the words c_signatures.rs names them by, each word's kind in one place (parameter_kind, register_of, …);
# 0 is a word the driver doesn't know
PARAMETER_I32 = 1
PARAMETER_I64 = 2
PARAMETER_F32 = 3
PARAMETER_F64 = 4
PARAMETER_TEXT = 5
PARAMETER_HANDLE = 6
PARAMETER_OUT = 7
REGISTER_I32 = 1
REGISTER_I64 = 2
REGISTER_F32 = 3
REGISTER_F64 = 4
REGISTER_BOOL = 5
REGISTER_VOID = 6
CROSSING_NUMBER = 1
CROSSING_TEXT = 2
CROSSING_OWNED_TEXT = 3
CROSSING_HANDLE = 4
FAILURE_NONE = 1
FAILURE_NOT_NULL = 2
FAILURE_FALSE = 3
parameter_kind(name: text): i32 := {
	if same_text(name, "i32") { return PARAMETER_I32 }
	if same_text(name, "i64") { return PARAMETER_I64 }
	if same_text(name, "f32") { return PARAMETER_F32 }
	if same_text(name, "f64") { return PARAMETER_F64 }
	if same_text(name, "ptr") { return PARAMETER_TEXT }
	if same_text(name, "handle") { return PARAMETER_HANDLE }
	if same_text(name, "out") { return PARAMETER_OUT }
	0
}
register_of(name: text): i32 := {
	if same_text(name, "i32") { return REGISTER_I32 }
	if same_text(name, "i64") { return REGISTER_I64 }
	if same_text(name, "f32") { return REGISTER_F32 }
	if same_text(name, "f64") { return REGISTER_F64 }
	if same_text(name, "bool") { return REGISTER_BOOL }
	if same_text(name, "void") { return REGISTER_VOID }
	0
}
crossing_of(name: text): i32 := {
	if same_text(name, "number") { return CROSSING_NUMBER }
	if same_text(name, "text") { return CROSSING_TEXT }
	if same_text(name, "owned_text") { return CROSSING_OWNED_TEXT }
	if same_text(name, "handle") { return CROSSING_HANDLE }
	0
}
failure_of(name: text): i32 := {
	if name.length == 0 { return FAILURE_NONE }
	if same_text(name, "not_null") { return FAILURE_NOT_NULL }
	if same_text(name, "false") { return FAILURE_FALSE }
	0
}
# a field of a C function's line the driver doesn't know stops the run naming it
known(kind: i32, name: text, what: text, word: text): i32 := {
	if kind == 0 { failed_call(joined(joined(joined(joined(name, ": "), what), word), ", not in the native driver yet")) }
	kind
}
# the C function of a line, found in its library; one the driver can't call stops the run naming it
foreign_of(line: text): i64 := {
	library = field(line, 1, TAB)
	name = field(line, 2, TAB)
	function = library_function(c_string(library), c_string(name))
	if function == 0 { failed_call(joined(joined(joined("no C function ", name), " in the library "), library)) }
	parameters = field(line, 3, TAB)
	count = field_count(parameters, COMMA)
	kinds = allocate(count as i32)
	floats = 0
	for p in 0..count {
		type = field(parameters, p, COMMA)
		kind = known(parameter_kind(type), name, "a parameter ", type)
		byte_at(kinds + p).value = kind as u8
		if kind == PARAMETER_F32 or kind == PARAMETER_F64 { floats = floats + 1 }
	}
	if floats > REGISTERS or count - floats > REGISTERS { failed_call(joined(name, ": more than 8 integer or float parameters, not in the native driver yet")) }
	register = known(register_of(field(line, 4, TAB)), name, "a result register ", field(line, 4, TAB))
	crossing = known(crossing_of(field(line, 5, TAB)), name, "a result crossing as ", field(line, 5, TAB))
	failure = known(failure_of(field(line, 8, TAB)), name, "a failure shown as ", field(line, 8, TAB))
	pointee = field(line, 6, TAB)
	Foreign(function, name.address, name.length, kinds, count as i32, register, crossing, failure, pointee.address, pointee.length) as i64
}
failed_call(message: text): nothing := {
	complain(message)
	exit(1)
}

# the call of a C function with the module's values: numbers as they are, a text NUL-terminated, a handle id its C
# pointer, the first out-pointer a slot that becomes the result; its result crossed back the same way
c_called(c: Foreign, caller: handle, context: handle, given: pointer, results: pointer, results_count: i64): nothing := {
	name = text_from(c.name, c.name_length)
	integers = zeroed(REGISTERS * 8)
	floats = zeroed(REGISTERS * 8)
	out = zeroed(8)
	integer_count = 0
	float_count = 0
	passed = 0
	outs = 0
	for p in 0..c.count {
		kind = byte_at(c.kinds + p).value as i32
		value = given + passed * VALUE_BYTES + VALUE_OFFSET
		if kind == PARAMETER_F32 or kind == PARAMETER_F64 {
			long_at(floats + float_count * 8).value = if kind == PARAMETER_F64 then long_at(value).value else word_at(value).value as i64
			float_count = float_count + 1
		} else {
			long_at(integers + integer_count * 8).value = c_argument(caller, context, name, kind, value, if outs == 0 then out else 0)
			integer_count = integer_count + 1
		}
		if kind == PARAMETER_OUT { outs = outs + 1 } else { passed = passed + 1 }
	}
	returned = native_call(c.function, integers, floats, if c.register == REGISTER_F32 or c.register == REGISTER_F64 then 1 else 0)
	if (c.failure == FAILURE_NOT_NULL and returned != 0) or (c.failure == FAILURE_FALSE and returned % 256 == 0) { failed_call(joined(joined(name, " failed, C result "), text_of(returned))) }
	if c.pointee_length > 0 and long_at(out).value == 0 { failed_call(joined(joined(joined(joined(name, " gave no "), text_from(c.pointee, c.pointee_length)), ", C status "), text_of(returned % 4294967296))) }
	if results_count > 0 { c_result(caller, context, c, if c.pointee_length > 0 then long_at(out).value else returned, results) }
}
# allocated bytes, all zero
zeroed(size: i32): pointer := {
	bytes = allocate(size)
	for i in 0..size { byte_at(bytes + i).value = 0 }
	bytes
}
# the register of a parameter that is no float: a number, a text's C copy, a handle's pointer, an out-pointer's slot
c_argument(caller: handle, context: handle, name: text, kind: i32, value: pointer, out: pointer): i64 := {
	if kind == PARAMETER_I32 { return word_at(value).value as i64 }
	if kind == PARAMETER_I64 { return long_at(value).value }
	if kind == PARAMETER_TEXT { return native_pointer(c_string(shown(caller, context, value - VALUE_OFFSET))) }
	if kind == PARAMETER_OUT { return if out == 0 then 0 else native_pointer(out) }
	id = word_at(value).value as i32
	if not handle_known(id) { failed_call(joined(joined(name, ": no handle "), text_of(id))) }
	handle_pointer(id)
}
# the C result as the module's value: a text, a handle id, else the number in its register
c_result(caller: handle, context: handle, c: Foreign, returned: i64, result: pointer): nothing := {
	value = result + VALUE_OFFSET
	if c.crossing == CROSSING_TEXT or c.crossing == CROSSING_OWNED_TEXT {
		if returned == 0 { guest_call(caller, context, "new_empty", 0, 0, result) } else { guest_text(caller, context, returned, strlen(returned), result) }
		if c.crossing == CROSSING_OWNED_TEXT and returned != 0 { free(returned) }
	} else {
		if c.crossing == CROSSING_HANDLE {
			byte_at(result).value = KIND_I32
			word_at(value).value = handle_id(returned) as u32
		} else {
			byte_at(result).value = register_kind(c.register)
			long_at(value).value = if c.register == REGISTER_BOOL then (if returned % 256 == 0 then 0 else 1) else (if c.register == REGISTER_I64 or c.register == REGISTER_F64 then returned else returned % 4294967296)
		}
	}
}
register_kind(register: i32): u8 := if register == REGISTER_I64 then KIND_I64 else if register == REGISTER_F64 then KIND_F64 else if register == REGISTER_F32 then KIND_F32 else KIND_I32
# the module's text of `length` bytes at a C pointer, into `result`: written where its text_heap global says (a module
# calling C exports it), else at the end of its memory, grown for them (crates/warp-runtime gc_values.rs write_to_heap)
guest_text(caller: handle, context: handle, bytes: handle, length: i64, result: pointer): nothing := {
	heap = allocate(EXTERN_BYTES)
	has_heap = wasmtime_caller_export_get(caller, "text_heap", 9, heap)
	memory = allocate(EXTERN_BYTES)
	wasmtime_caller_export_get(caller, "memory", 6, memory)
	top = allocate(VALUE_BYTES)
	place = 0 as i64
	if has_heap {
		wasmtime_global_get(context, heap + 8, top)
		place = word_at(top + VALUE_OFFSET).value as i64
	}
	size = wasmtime_memory_data_size(context, memory + 8)
	if place == 0 or place + length > size {
		if wasmtime_memory_grow(context, memory + 8, length / WASM_PAGE_BYTES + 1, allocate(8)) != 0 { failed_call("the module's memory would not grow for a host text") }
		place = size
	}
	memmove(wasmtime_memory_data(context, memory + 8) + place, bytes, length)
	if has_heap {
		word_at(top + VALUE_OFFSET).value = (place + length) as u32
		if wasmtime_global_set(context, heap + 8, top) != 0 { failed_call("the module's text_heap would not move") }
	}
	values = allocate(2 * VALUE_BYTES)
	byte_at(values).value = KIND_I32
	word_at(values + VALUE_OFFSET).value = place as u32
	byte_at(values + VALUE_BYTES).value = KIND_I32
	word_at(values + VALUE_BYTES + VALUE_OFFSET).value = length as u32
	guest_call(caller, context, "new_text", values, 2, result)
}

appended = appended_module()
if appended.length > 0 { run(appended, given_from(0), "") } else {
	if arg_count() < 2 {
		complain("usage: driver <app.warp | app.wasm> [arguments…]")
		exit(2)
	}
	if ends_with(arg(1), ".warp") { compiled_and_run(arg(1)) } else {
		module = read_file(arg(1))
		if module.length == 0 {
			complain(joined("no module at ", arg(1)))
			exit(1)
		}
		run(module, given_from(1), "")
	}
}
