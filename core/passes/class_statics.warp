# A class's static field (`class Clicker{static clicks = 0; click() := clicks += 1}`) is one global of the class,
# Clicker·clicks, not a field of each instance: read and changed bare in the class's members, and outside as
# `Clicker.clicks` or through an instance, `Clicker(1).clicks` (card class-ticket). A static method needs nothing:
# `Circle.doubled(4)` calls it already
use "walk.warp"

static_word = "static"

# the program with each class's static fields as globals in front of it
def statics_hoisted(program: Node): Node := {
	statements = statements_in(program)
	statics = {}
	for statement in statements {
		view = class_view(statement)
		fields = if view == ø then [] else view#3[3 ..].map(member => static_field(node_of(member))).filter(field => field != ø)
		if #fields > 0 { statics[declared_type_name(view#2)] = fields }
	}
	if #statics == 0 { return program }
	types = assigned_types(statements, statics)
	globals = statics.keys.flat_map(owner => statics[owner].map(field => Key(symbol("global"), Op.Colon, Key(static_name(owner, key_of(field)), Op.Assign, value_of(field)))))
	group_like(program, globals + statements.map(statement => bottom_up(without_statics(statement, statics), part => static_read(part, statics, types))))
}
# `static k = 3`: the field `k = 3`, else ø
def static_field(member: Node): Node? := {
	if not (is_group(member) and #member == 2 and member#1 == symbol(static_word)) { return ø }
	field = member#2
	if is_key(field, Op.Assign) and key_of(field) is symbol then field else ø
}
def static_name(owner: text, name: Node): Node := symbol(owner + "·" + name_of(name))
# the class declaration without its static fields, its members naming them bare naming the globals
def without_statics(statement: Node, statics: map): Node := {
	view = class_view(statement)
	owner = if view == ø then "" else declared_type_name(view#2)
	if owner not in statics { return statement }
	names = statics[owner].map(field => name_of(key_of(field)))
	members = view#3[3 ..].filter(member => static_field(node_of(member)) == ø).map(member => {
		named = statics_named(node_of(member), owner, names)
		if named == node_of(member) then member else view_of(named)
	})
	match statement {
		Key(left, key_op, right): Key(left, key_op, [view#1, view#2, view#3[0 ..< 3] + members])
		_: statement
	}
}
# a bare name of a static field as its global; a name after a dot stays the member it is
def statics_named(n: Node, owner: text, names: list): Node := match n {
	Symbol(name): { if name in names then static_name(owner, n) else n }
	Key(left, Op.Dot, right): Key(statics_named(left, owner, names), Op.Dot, right)
	_: children(n, part => statics_named(part, owner, names))
}
# `Clicker.clicks`, `c.clicks` of a Clicker c, `Circle(1).k`: the global of the static field
def static_read(n: Node, statics: map, types: map): Node := match n {
	Key(left, Op.Dot, Symbol(name)): {
		owner = if left is symbol and name_of(left) in statics then name_of(left) else if left is symbol and name_of(left) in types then types[name_of(left)] else written_type(left, statics) ?? ""
		if owner in statics and statics[owner].any(field => name_of(key_of(field)) == name) then static_name(owner, value_of(n)) else n
	}
	_: n
}
