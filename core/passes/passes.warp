# The warp pipeline so far (card parser-tree, notes/self_hosting.md step 13): a source parsed by parser.warp, then
# each pass in order.
use "../parsing/parser.warp"
use "../parsing/interpolation.warp"
use "../parsing/number_words.warp"
use "of_lookups.warp"
use "definitions.warp"
use "../parsing/phrase_blocks.warp"
use "loop_heads.warp"
use "node_matches.warp"
use "../../extensions/code_templates.warp"
use "node_cases.warp"
use "../analysis/type_tests.warp"
use "number_keys.warp"
use "tries.warp"
use "../../extensions/components.warp"
use "prelude_words.warp"
use "plain_enums.warp"
use "uses.warp"
use "prefix_calls.warp"
use "data_items.warp"
use "lambdas.warp"
use "arity_overloads.warp"
use "kind_changes.warp"
use "../analysis/source_checks.warp"
use "main_globals.warp"
use "rewrites.warp"
use "library_calls.warp"

# the keyword rewrites among the sugar passes, one walk (`xs .* 2` and `(p).a` are
# extensions/sugar/arithmetic.warp's and methods.warp's rules): `a of b`
sugar_phrases_table = [[is_lookup_word, lookup_phrase]]
sugar_phrases(program: Node): Node := keyword_rewrites(program, sugar_phrases_table)

# The pass order, by stage (card pass-order-owners). Before the passes (compiler.warp compile): c_imports reads the
# foreign lines and C imports off the source. with_used: interpolation, then used_passes (the program's rewrite rules,
# extensions' index_positions and property_accessors, the used files and modules), the prelude's definitions it reaches. Then pure_passes in order:
#   (extensions' passes before tries: `parse` words, then checked tries, extensions/parse_words.warp and
#   checked_tries.warp)
#   tries                                  try/catch
#   definition_heads definitions           which functions answer ø, class fields; definitions and their heads
#   (extensions' passes after definition_heads: class methods, int types, conversions)
#   preposition_heads arity_overloads      `f of x` heads, several definitions of one name by arity
#   (extensions' passes after arity_overloads: function clauses, then `a, b = …`, extensions/function_clauses.warp
#   and multiple_assignments.warp)
#   type_tests spaced_prefix_calls         `x is T`, `f x` calls
#   interpolation sugar_phrases            `"…${x}…"` holes, `a of b`
#   number_words_pass                      number words
#   first_sugar node_matches node_cases    extensions/sugar's first rules (arms, heads), `match`, node cases
#   enums_declared plain_enums             enums
#   phrase_blocks comprehensions           phrase blocks, `[x for x in xs]`
#   data_items library_calls sugar         data items, library calls, extensions/sugar's main rules (fallbacks, places)
#   lambdas loop_heads iteration_sugar     lambdas, `for` heads, the `for` loops lowered onto `while`
#   late_sugar list_methods number_keys    late rules, `xs.add(x)`-style methods, number keys

# the pass that owns each form the emitter may refuse: a refusal of that form names it, so a form that reaches the
# emitter unlowered says which pass did not claim it
pass_owners = {"foreign C call": "c_imports", "runtime declaration": "definitions", "try": "tries", "multiple assignment": "multiple_assignments",
	"for loop": "loop_heads and iteration_sugar", "match": "node_matches", "match arm": "first_sugar (extensions/sugar/arms.warp)", "pattern arm": "match_patterns (extensions/match_patterns.warp)", "enum": "enums_declared",
	"comprehension": "comprehensions", "lambda": "lambdas", "number word": "number_words_pass", "fallback": "sugar (extensions/sugar/fallbacks.warp)"}

# the emitter's refusal naming its form and owner pass: `form` one of pass_owners, ø for a form no pass owns
owned_refusal(refusal: text, form: text?): text := {
	if form == ø { return refusal + " (no owner)" }
	refusal + " (" + form + "; owner " + (pass_owners.get(form) ?? "none") + " did not claim it)"
}

# the pure lane's passes (card pure-runs)
pure_passes = [tries, components, definition_heads, definitions, arity_overloads, type_tests, spaced_prefix_calls, interpolation, sugar_phrases, number_words_pass, first_sugar, code_templates, node_matches, node_cases, enums_declared, plain_enums, phrase_blocks, comprehension_sugar, data_items, library_calls, sugar, lambdas, loop_heads, iteration_sugar, late_sugar, number_keys]

# the pure passes with the extensions' between them (core/extension.warp with_extension_passes), made once
global lowering_passes = ø
# a node after every pure pass, in order
lowered_node(n: Node): Node := {
	if lowering_passes == ø { lowering_passes = with_extension_passes(pure_passes, every_pass) }
	for pass in lowering_passes {
		timed("pass " + "${pass}")
		n = pass(n)
	}
	timed("called_only, checks")
	n
}
# WARP_TIMES set: `§T <milliseconds> <label>` printed where a phase of the compile starts, so a build's log (its
# record's build.log) holds its phases; scripts/phase-times.py sums the spans (notes/compile_speed.md). Silent unset
TIMES = env("WARP_TIMES") ?? ""
def timed(label: text) := { if TIMES != "" { print "§T " + "${clock()}" + " " + label } }

# the program as the passes leave it, from parser.warp's nodes (card rest-node), with the declarations of the files
# it uses from `folder` (uses.warp) and the definitions they reach of the standard modules they use and of the
# prelude (prelude_words.warp)
lowered_program(source: text, folder: text, prelude: text): Node := {
	lowering_from(prelude)
	lowered_reached(plain_node(parsed(rules_ended(source))), source, folder, prelude)
}
# the program with the definitions it reaches, after every pure pass, those it doesn't call after all dropped
lowered_reached(program: Node, source: text, folder: text, prelude: text): Node := called_only(lowered_node(with_used(program, source, folder, prelude)))
# the sugar rules the program at hand keeps (with_used), of each sugar step
global kept_first_sugar = []
global kept_sugar = []
# the late sugar rules it keeps (rewrites.warp late_sugar_module_names)
global kept_iteration_sugar = []
global kept_late_sugar = []
# the comprehension rules it keeps (rewrites.warp comprehension_sugar_module_names)
global kept_comprehension_sugar = []
# (the rewrite rules first, before any pass: a fired module's `use` brings its words;
# after interpolation, so that a rule sees the code in a text's holes, `"$(2 in xs)"`; declared counts before the
# prelude is reached, so the words index_positions answers with, `byte_index_of` for a `byte index b = t.find(part)`,
# bring their definitions; the source tells a rule's `·` from `*`; the early sugar before all of them, the function keywords gone). The sugar rules the program keeps are chosen here,
# by its own bindings, before the definitions it reaches join it.
with_used(program: Node, source: text, folder: text, prelude: text): Node := {
	brought_names = {}
	exported_names = {}
	defined_origins = {}
	local_declarations = {}
	timed("with_uses")
	used = with_uses(program, folder)
	timed("interpolation, early sugar")
	own = with_result_word(early_sugared(interpolation(used)))
	writes_templates = writes_template_in(own)
	timed("sugar rules kept")
	bindings = rule_bindings(own)
	kept_first_sugar = sugar_rules(bindings, first_sugar_module_names)
	kept_sugar = sugar_rules(bindings, sugar_module_names())
	kept_iteration_sugar = sugar_rules(bindings, iteration_sugar_module_names)
	kept_late_sugar = sugar_rules(bindings, late_sugar_module_names)
	kept_comprehension_sugar = sugar_rules(bindings, comprehension_sugar_module_names)
	used_source = source
	used_folder = folder
	used_prelude = prelude
	if used_lowering == ø { used_lowering = with_extension_passes(used_passes, every_pass) }
	passed = own
	for pass in used_lowering {
		timed("${pass}")
		passed = pass(passed)
	}
	timed("with_reached")
	with_reached(passed, prelude, no, [std_module_path("prelude")])
}
# the source, folder and prelude of the compile at hand, which the used stage's passes read (set by with_used)
global used_source = ""
global used_folder = ""
global used_prelude = ""
# the used stage's passes, in order: the program's rewrite rules, the type modules, the expected types and the modules it
# uses; extensions place theirs between them as between the pure passes (index_positions, property_accessors)
used_passes = [rules_rewritten, with_type_module_uses, expected_types_used, modules_used]
rules_rewritten(program: Node): Node := rewritten_program(program, used_source)
expected_types_used(program: Node): Node := with_expected_type_uses(program, used_prelude)
modules_used(program: Node): Node := with_used_modules(program, used_folder)
# every stage's passes: the names an extension's pass is placed by
every_pass = pure_passes + used_passes
global used_lowering = ø
# the words code will say once the sugar the program keeps rewrote it: `twice {…}` says the prelude's times, a module's
# `a .+ b` element_wise_any
sugar_words_of(code: Node): list := reaching_template_words(code, kept_first_sugar + kept_sugar + kept_iteration_sugar + kept_late_sugar + kept_comprehension_sugar)

# the sugar rules (extensions/sugar/) the program keeps, over it and the definitions it reached: the first before the passes
# that would read its forms as something else (rewrites.warp first_sugar_module_names), the others where the passes
# before them have made their forms (definitions' `?? []` of a list result) and read the written ones (data_items
# `xs.add(x)`, of_lookups `keys in m`)
first_sugar(program: Node): Node := sugared(program, kept_first_sugar)
sugar(program: Node): Node := sugared(program, kept_sugar)
# the iteration sugar rules, which lower the `for` loops the passes before them made and loop_heads.warp read, while a
# range in a loop's head is not yet a list
iteration_sugar(program: Node): Node := sugared(program, kept_iteration_sugar)
# the late sugar rules, after the iteration sugar took the loops over a range
late_sugar(program: Node): Node := sugared(program, kept_late_sugar)
# the comprehension rules, where the comprehensions pass ran
comprehension_sugar(program: Node): Node := sugared(program, kept_comprehension_sugar)

# the program as the passes leave it, its checks run (card pure-diagnostics): those of the program as written, then
# those of the lowered program; what they find goes to `diagnosed` (diagnostics.warp)
checked_program(source: text, folder: text, prelude: text): Node := {
	lowering_from(prelude)
	program = plain_node(source_checks(parsed(rules_ended(source)), prelude))
	own_names = statements_in(program).map(declared_name)
	main_globals(kind_changes(lowered_reached(program, source, folder, prelude)), own_names)
}
