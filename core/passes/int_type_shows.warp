# The int types' declarations and show hooks, as int_types.warp marks and renames them: class_methods.warp reads them
# too, so a class's routed show() never falls back to a hook that int_types.warp renames away (card
# module-arity-overloads)
use "walk.warp"
use "../analysis/kinds.warp"

showing_word = "show"

# the number types a marked type is held as: `type Color = int`, `type Angle = float`
MARKED_NUMBER_KINDS = {int: Kind.Int, float: Kind.Float}
# `type Color = int`, `type Angle = float`: Color, Angle; ø for any other statement
int_type_name(statement: Node): text? := {
	if not is_key(statement, Op.Assign) or not (value_of(statement) is symbol) or name_of(value_of(statement)) not in MARKED_NUMBER_KINDS { return ø }
	declared = key_of(statement)
	if not (is_key(declared, Op.Colon) and key_of(declared) == opaque_symbol) { return ø }
	view = value_of(declared)
	if kind_of(view) == "type" and view#3 == ø then declared_type_name(view#2) else ø
}
# each number type the statements declare, its marked kind: the number's Kind with the type's mark above it, the
# marks numbered in order of declaration (int_types.warp marks the values, the emitter the values it holds unboxed)
int_type_kinds(statements: list): map := {
	kinds = {}
	for statement in statements {
		name = int_type_name(statement)
		if name != ø and name not in kinds { kinds[name] = MARKED_NUMBER_KINDS[name_of(value_of(statement))] + (FIRST_INT_MARK + #kinds) * KindUnit.Info }
	}
	kinds
}
# `show(c: Color) := …`: Color; ø for any other statement
shower_of(statement: Node): text? := {
	if not is_key(statement, Op.Define) { return ø }
	head = key_of(statement)
	if not (is_group(head) and #head == 2 and head#1 == symbol(showing_word) and is_key(head#2, Op.Colon)) { return ø }
	typed = value_of(head#2)
	if typed is symbol then name_of(typed) else ø
}
# the statements showing a value of one of the program's int types
int_type_showers(statements: list): list := {
	types = statements.map(int_type_name).filter(name => name != ø)
	statements.filter(statement => shower_of(statement) in types)
}
