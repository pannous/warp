# A match over a node's cases (card pure-runs):
# each arm tests the subject's kind and spelled parts, binds its named parts, then gives its result; an arm of a value,
# `1: e`, `Color.Red: e`, `Red: e` of a declared variant, tests the subject equals it:
#   match n { Key(left, Op.Colon, right): e; _: d }
#   → if is_type(n, "key") and op_of(n) == Op.Colon then (left = key_of(n); right = value_of(n); e) else d
# A part of Op, Bracket or Separator binds the case, `op = Op·case(op_of(n))` (node_cases.warp spells the cases). A
# subject other than a name is evaluated once, into match·subject. Guards, binding names, structural and named patterns
# are extensions/match_patterns.warp's.
use "walk.warp"
use "../parsing/phrase_blocks.warp"
use "enum_declarations.warp"
use "../analysis/words.warp"

# the node cases: the type a case tests as (a List is any group) and the reader of each part, in order
case_types = {"Number": "number", "Char": "codepoint", "Text": "text", "Symbol": "symbol", "Key": "key"}
case_readers = {"Number": ["itself"], "Char": ["itself"], "Text": ["itself"], "Symbol": ["name_of"],
	"Key": ["key_of", "op_of", "value_of"], "List": ["itself", "bracket_of", "separator_of"]}
subject_name = HiddenWord.MatchSubject as text
match_bound = HiddenWord.MatchBound as text
# the readers whose part is a case of an enum spelled as the node carries it
spelled_readers = {"op_of": "Op", "bracket_of": "Bracket", "separator_of": "Separator"}
# `Op·case(t)`: the case spelled t, `Op·text(c)`: the spelling of a case (node_cases.warp spelling_functions)
spelled_function(enum_name: text, function: text): text := enum_name + "·" + function

# a part as a pattern binds it: a spelled part as its case
bound_part(read: Node, reader: text): Node := if reader in spelled_readers then applied(spelled_function(spelled_readers[reader], "case"), read) else read

applied(word: text, argument: Node): Node := List([symbol(word), argument], Bracket.Round, Separator.None)

part_of(subject: Node, reader: text): Node := if reader == "itself" then subject else applied(reader, subject)

# `Key(left, Op.Colon, right)`: the case's name and its parts, else ø
case_pattern(pattern: Node): list? := match pattern {
	List(call, Bracket.Round, Separator.None): {
		if #call > 1 and is_name(call#1) and name_of(call#1) in case_readers and #call - 1 == #case_readers[name_of(call#1)] { return call }
		ø
	}
	_: ø
}

# the arm taking any other subject: `_`, `other`, `default`, `else`
default_arms = [other_arm, "other", "default", "else"]
is_other_arm(pattern: Node): bool := is_name(pattern) and default_arms contains name_of(pattern)

# an arm `pattern: result` or `pattern => result` (read as `->`); `n: digits => e`, read `n: (digits => e)` as digits is
# no type word, is the arm of the pattern `n: digits`, a hole typed by a class of characters (lib/prelude.warp)
character_class_words = ["digit", "digits", "letter", "letters", "hex"]
arm_pattern(arm: Node): Node := match arm {
	Key(pattern, Op.Colon, Key(Symbol(word), Op.Arrow, result)): if word in character_class_words then Key(pattern, Op.Colon, symbol(word)) else pattern
	Key(pattern, Op.Colon, result): pattern
	Key(pattern, Op.Arrow, result): pattern
	_: arm
}

arm_result(arm: Node): Node := match arm {
	Key(pattern, Op.Colon, Key(Symbol(word), Op.Arrow, result)): if word in character_class_words then result else value_of(arm)
	Key(pattern, Op.Colon, result): result
	Key(pattern, Op.Arrow, result): result
	_: arm
}

# `1`, "a", 'c', ø, yes, an enum case `Color.Red` or `Color::Red` (`Op.Colon` is ":" by then), a variant the program declares
# (`Red` of `enum Color { Red, Green }`), a constant `True`, `no`: an arm the subject equals; `"b" | "c"` (read as
# `or`): one it equals one of
is_value_pattern(pattern: Node, variants: map): bool := pattern is bool or match pattern {
	ø: yes
	# `1 | 2`, read as the bits' or between whole numbers (parser.warp bit_operator), names alternatives too
	Key(left, Op.BitOr, right): is_value_pattern(left, variants) and is_value_pattern(right, variants)
	Symbol(name): name in variants
	Number(value): yes
	Text(value): yes
	Char(value): yes
	Key(type_name, Op.Dot, case_name): is_name(type_name) and is_name(case_name)
	Key(type_name, Op.Scope, case_name): is_name(type_name) and is_name(case_name)
	# alternatives `"number" | "bool"`, each a value
	Key(left, Op.Or, right): is_value_pattern(left, variants) and is_value_pattern(right, variants)
	# a value kept as written, the empty list `[]`
	Key(left, op, right): left == opaque_symbol
	# `ø: e`, `True: e` (the parser reads True as yes): Node.Empty and Node.True
	_: pattern == ø or pattern is bool
}

# the subject equals the value, or one of the alternatives
value_test(subject: Node, pattern: Node): Node := match pattern {
	Key(left, Op.Or, right): Key(value_test(subject, left), Op.Or, value_test(subject, right))
	Key(left, Op.BitOr, right): Key(value_test(subject, left), Op.Or, value_test(subject, right))
	_: Key(subject, Op.Eq, pattern)
}

# `int: e`: an arm of a type word tests the subject's type, `match 3 { int: … }`
is_type_pattern(pattern: Node): bool := match pattern {
	Symbol(word): is_tested_type_word(word)
	_: no
}

# `n if n > 5 => e` (parsed as `if n > 5 then n`): the pattern and its guard, else ø
guard_of(pattern: Node): Node := match pattern {
	Key(Key(ø, Op.If, guard), Op.Then, arm_body): guard
	_: ø
}

guarded_pattern(pattern: Node): Node := if guard_of(pattern) == ø then pattern else value_of(pattern)

# `n => "hi " + n`: a bare name its result mentions binds the subject, a guard's name too
is_name_arm(pattern: Node, result: Node, variants: map): bool := is_name(pattern) and not is_other_arm(pattern) and not is_type_pattern(pattern) and not is_value_pattern(pattern, variants) and mentions(result, name_of(pattern))

# an arm of today's if-chain tests, else one for the matcher
is_case_arm(arm: Node, variants: map): bool := {
	pattern = guarded_pattern(arm_pattern(arm))
	is_name(pattern) or is_value_pattern(pattern, variants) or is_type_pattern(pattern) or case_pattern(pattern) != ø
}

# the prelude's matcher (lib/prelude.warp), which a structural arm calls
matcher_word = "pattern_bindings"

# `match v {…}` with an arm for the matcher, its definition brought from the prelude before the match is lowered
is_structural_match(n: Node): bool := match n {
	List(parts, Bracket.None, Separator.Space): has_structural_arms(parts)
	_: no
}

has_structural_arms(parts: list): bool := {
	for i in 1 ..< #parts {
		block = if parts#i == symbol("match") and i + 2 <= #parts then parts#(i + 2) else if is_match_head(parts#i) then parts#(i + 1) else ø
		if block != ø and is_curly_group(block) and items_of(block).any(arm => not is_case_arm(arm, {})) { return yes }
	}
	no
}

# the names a structural pattern binds (lib/prelude.warp pattern_names): its names but `_` and the type words, `$x`
# and `...rest` unmarked; of quoted code only its holes, a map's fields by their patterns
structural_names(pattern: Node, quoted: bool): list := {
	if is_quote(pattern) { return structural_names(pattern#2, yes) }
	match pattern {
		Symbol(name): marked_name(name, quoted)
		# `"/u/" + id: int + "/p/" + p: int` reads `(("/u/" + id): (int + "/p/" + p)): int`: a text cut's later holes
		Key(Key(cut_left, Op.Add, cut_right), Op.Colon, right): structural_names(key_of(pattern), quoted) + structural_names(right, quoted)
		Key(Key(cut_left, Op.Colon, cut_right), Op.Colon, right): structural_names(key_of(pattern), quoted) + structural_names(right, quoted)
		Key(left, Op.Colon, right): structural_names(left, quoted)
		Key(left, op, right): structural_names(left, quoted) + structural_names(right, quoted)
		List(items, Bracket.Curly, separator): items.flat_map(field => field_names(field, quoted))
		List(items, bracket, separator): items.flat_map(item => structural_names(item, quoted))
		_: []
	}
}

field_names(field: Node, quoted: bool): list := match field {
	Key(name, Op.Colon, value): structural_names(value, quoted)
	_: structural_names(field, quoted)
}

marked_name(name: text, quoted: bool): list := {
	if name.starts_with("$") or name.starts_with("*") { return [name[1..]] }
	if quoted or name == other_arm or is_tested_type_word(name) { return [] }
	[name]
}

kind_test(case_name: text, subject: Node): Node := {
	if case_name in case_types { return List([symbol("is_type"), subject, case_types[case_name]], Bracket.Round, Separator.None) }
	Key(applied("bracket_of", subject), Op.Ne, ø)
}

# a part written as a name binds it (`_` binds nothing), a case `Key(…)` matches that part in turn; any other part is
# a value the part equals
is_binding(part: Node): bool := is_name(part)

arm_test(pattern: list, subject: Node): Node := {
	tests = part_tests(pattern, subject)
	conjunction_of(tests#1, tests[1..])
}

# the kind test of a case, then the tests of its parts, those of a nested case's after the kind test it reads them by
part_tests(pattern: list, subject: Node): list := {
	readers = case_readers[name_of(pattern#1)]
	tests = [kind_test(name_of(pattern#1), subject)]
	for i in 1 to #readers {
		part = pattern#(i + 1)
		read = part_of(subject, readers#i)
		nested = case_pattern(part)
		if nested != ø { tests += part_tests(nested, read) } else if not is_binding(part) { tests += [Key(read, Op.Eq, part)] }
	}
	tests
}

conjunction_of(test: Node, equalities: list): Node := if #equalities == 0 then test else conjunction_of(Key(test, Op.And, equalities#1), equalities[1..])

# a part the result never names is not read: `Key(left, op, right): [left, right]` spells no op (an operator's case
# looked up at every key was a sixth of the sugar passes, card sugar-rule-passes)
arm_value(pattern: list, subject: Node, result: Node): Node := {
	bound = part_bindings(pattern, subject).filter(binding => mentions(result, name_of(key_of(binding))))
	if #bound == 0 { return result }
	List(bound + [result], Bracket.Round, Separator.Semicolon)
}

# `left = key_of(n)` for each part a case names, a nested case's too
part_bindings(pattern: list, subject: Node): list := {
	readers = case_readers[name_of(pattern#1)]
	bindings = []
	for i in 1 to #readers {
		part = pattern#(i + 1)
		read = part_of(subject, readers#i)
		nested = case_pattern(part)
		if nested != ø { bindings += part_bindings(nested, read) } else if is_binding(part) and part != symbol(other_arm) { bindings += [Key(part, Op.Assign, bound_part(read, readers#i))] }
	}
	bindings
}

# the arms from the last back: an arm's test chooses its value, else what the arms after it give
arm_chain(arms: list, subject: Node, variants: map): Node := {
	if #arms == 0 { return applied("switch_no_case", subject) }
	pattern = arm_pattern(arms#1)
	if guard_of(pattern) != ø or is_name_arm(pattern, arm_result(arms#1), variants) or not is_case_arm(arms#1, variants) { throw owned_refusal(outside_the_core + "the match arm " + arms#1, "pattern arm") }
	# an unbound bare name its result does not use is the value it names
	if is_name(pattern) and not is_other_arm(pattern) and not is_type_pattern(pattern) { return chosen(value_test(subject, pattern), arm_result(arms#1), arm_chain(arms[1..], subject, variants)) }
	if is_other_arm(pattern) { return arm_result(arms#1) }
	if is_value_pattern(pattern, variants) { return chosen(value_test(subject, pattern), arm_result(arms#1), arm_chain(arms[1..], subject, variants)) }
	if is_type_pattern(pattern) {
		test = List([symbol("is_type"), subject, name_of(pattern)], Bracket.Round, Separator.None)
		return chosen(test, arm_result(arms#1), arm_chain(arms[1..], subject, variants))
	}
	case_parts = case_pattern(pattern)
	chosen(arm_test(case_parts, subject), arm_value(case_parts, subject, arm_result(arms#1)), arm_chain(arms[1..], subject, variants))
}

chosen(test: Node, value: Node, otherwise: Node): Node := Key(Key(Key(ø, Op.If, test), Op.Then, value), Op.Else, otherwise)

# the arms lowered, an extension's past the core's first (extension.warp with_arm_lowerings)
chained_arms(arms: list, subject: Node, variants: map): Node := arm_chain(with_arm_lowerings(arms, subject, variants), subject, variants)

matched(subject: Node, arms: list, n: Node, variants: map): Node := {
	if #arms == 0 { return n }
	if is_name(subject) { return chained_arms(arms, subject, variants) }
	List([Key(symbol(subject_name), Op.Assign, tuple_as_list(subject)), chained_arms(arms, symbol(subject_name), variants)], Bracket.Round, Separator.Semicolon)
}

# `match (1, 2) {…}`: the tuple a list, as `p = (1, 2)` makes it (the passes that do so ran before this one)
tuple_as_list(subject: Node): Node := if is_round(subject) and separator_of(subject) == "," then List(items_of(subject), Bracket.Square, Separator.Comma) else subject

match_block(subject: Node, block: Node, n: Node, variants: map): Node := match block {
	List(arms, Bracket.Curly, separator): matched(subject, joined_arms(arms), n, variants)
	_: n
}

# `1, 2 => "small"`: the values written before an arm are its alternatives, `1 or 2 => "small"`
joined_arms(arms: list): list := {
	joined = []
	waiting = []
	for arm in arms.flat_map(comma_items) {
		if is_arm(arm) {
			joined += [with_alternatives(waiting, arm)]
			waiting = []
		} else { waiting += [arm] }
	}
	joined + waiting
}

comma_items(n: Node): list := match n {
	List(items, Bracket.None, Separator.Comma): items
	_: [n]
}

is_arm(n: Node): bool := is_key(n, Op.Colon) or is_key(n, Op.Arrow)

with_alternatives(values: list, arm: Node): Node := {
	if #values == 0 { return arm }
	pattern = values.reverse().fold(arm_pattern(arm), (alternatives, value) => Key(value, Op.Or, alternatives))
	if is_arm(arm) then Key(pattern, Op.Colon, arm_result(arm)) else arm
}

# `match f(x)` of `match f(x) {…}` as a value, the subject a call ending before the block: `((match f(x)) {…})`
is_match_head(n: Node): bool := match n {
	List(parts, Bracket.None, Separator.Space): #parts == 2 and parts#1 == symbol("match")
	_: no
}

match_of(rest: Node, n: Node, variants: map): Node := match rest {
	List(parts, Bracket.None, Separator.Space): { if #parts == 2 then match_block(parts#1, parts#2, n, variants) else n }
	_: n
}

# `match x {…}` among a list's parts, as in the call `print(match x {…})` read as `(print match x {…})`
parts_matched(parts: list, variants: map): list := {
	if #parts < 3 { return parts }
	if parts#1 == symbol("match") {
		lowered = match_block(parts#2, parts#3, ø, variants)
		if lowered != ø { return [lowered] + parts_matched(parts[3..], variants) }
	}
	[parts#1] + parts_matched(parts[1..], variants)
}

list_match(n: Node, parts: list, bracket: Node, separator: Node, variants: map): Node := {
	if not parts.any(part => part == symbol("match")) { return n }
	List(parts_matched(parts, variants), bracket, separator)
}

node_match(n: Node, variants: map): Node := match n {
	List(parts, Bracket.None, Separator.Space): spaced_match(parts, n, Bracket.None, variants)
	# a block of the one statement: `{ match word {…} }`
	List(parts, Bracket.Curly, Separator.Space): spaced_match(parts, n, Bracket.Curly, variants)
	List(parts, bracket, separator): list_match(n, parts, bracket, separator, variants)
	_: n
}

spaced_match(parts: list, n: Node, bracket: Node, variants: map): Node := {
	if #parts == 2 and is_match_head(parts#1) { return match_block(parts#1#2, parts#2, n, variants) }
	# `match n {…}` as a statement, `match (n {…})` as a value
	if #parts == 3 and parts#1 == symbol("match") { return match_block(parts#2, parts#3, n, variants) }
	if #parts == 2 and parts#1 == symbol("match") { return match_of(parts#2, n, variants) }
	list_match(n, parts, bracket, Separator.Space, variants)
}

node_matches(program: Node): Node := {
	variants = case_names_of(enums_in(program, {}))
	bottom_up(program, n => node_match(n, variants))
}
