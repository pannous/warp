# The `for` heads a rule cannot take yet, made plain for lib/sugar/iteration.warp's rules, which lower every `for` onto
# `while` (Rust twin: rust-harness:src/lowering/control/for_loop.rs); a bare body becomes a `{…}` block:
# `for k, v in m` binds the value beside the key: `for k in m { v = m#(k + 1); body }`, whose map the rule `where $m is
#   map` walks by its keys (Rust twin: library_words.rs for_over_map); a rule's pattern cannot bind two names yet
# `for int in xs body` (a type word as the variable) visits only the items of that type, tested as read, before the
#   variable holds one (a character held by a text variable is a text): `for int·typed in xs { if is_type(int·typed,
#   "int") { int = int·typed; body } }` (Rust twin: for_loop/headers.rs type_test)
use "walk.warp"
use "../parsing/phrase_blocks.warp"
use "../analysis/words.warp"

loop_word = "for"
loop_in_word = "in"
# the type words whose loop over a text walks a unit instead of filtering (Rust: for_loop/headers.rs bytes_of)
unit_type_words = ["byte", "codepoint", "char", "character"]

# `k, v` or `(k, v)`: the two names a loop over a map binds
is_name_pair(n: Node): bool := is_group(n) and #n == 2 and is_name(n#1) and is_name(n#2)

# `for int in xs body`: a type word as the loop variable, not one of a text's units
filters_by_type(variable: Node): bool := variable is symbol and is_type_word(name_of(variable)) and name_of(variable) not in unit_type_words

# the statements of a `{…}` body, a bare body as it is
loop_statements(body: Node): list := match body {
	List(items, Bracket.Curly, separator): items
	_: [body]
}

loop_head(variable: Node, iterable: Node, body: Node): Node := List([symbol(loop_word), variable, symbol(loop_in_word), iterable, body], Bracket.None, Separator.Space)

loop_block(statements: list): Node := List(statements, Bracket.Curly, Separator.Semicolon)

# `for int·typed in xs { if is_type(int·typed, "int") { int = int·typed; body } }`
type_filtered(variable: Node, iterable: Node, body: list): Node := {
	item = symbol(name_of(variable) + "·typed")
	test = call_of("is_type", [item, name_of(variable)])
	loop_head(item, iterable, loop_block([Key(Key(ø, Op.If, test), Op.Then, loop_block([Key(variable, Op.Assign, item)] + body))]))
}

# a loop of two names, of a type word, or of a bare body as the rules take it; any other node as it is
loop_heads_of(n: Node): Node := match n {
	List(parts, Bracket.None, Separator.Space): {
		if #parts != 5 or parts#1 != symbol(loop_word) or parts#3 != symbol(loop_in_word) { return n }
		variable = parts#2
		iterable = parts#4
		body = loop_statements(parts#5)
		if is_name_pair(variable) {
			lookup = Key(variable#2, Op.Assign, Key(iterable, Op.Hash, Key(variable#1, Op.Add, 1)))
			return loop_head(variable#1, iterable, loop_block([lookup] + body))
		}
		if filters_by_type(variable) { return type_filtered(variable, iterable, body) }
		if is_curly_group(parts#5) then n else loop_head(variable, iterable, loop_block(body))
	}
	_: n
}

loop_heads(program: Node): Node := bottom_up(program, loop_heads_of)
