# The standard library a compile reads and bundles: lib/'s folder for this run, its modules' texts baked into the
# compiler (comments blanked) and their baked parses, and a source file's text by its path. Reading lib/ is no
# parsing: the parser, uses.warp and compiler.warp read through these words.
use os
use file
# The lib/ a run reads a program's standard modules from (its own data is built in, module_source): the one the run was
# given (compiler.warp's fourth argument, given_library), else WARP_LIB, else the one above this file, or beside it when
# the file was reached as core/ (card compiler-core-link). A compiled stage is kept for every identical lib/ and runs
# from wherever that is now, so nothing reads the folder it was compiled in (card pure-lane-nondeterministic): that
# folder, a build machine's, is only the last resort
global given_library = ""
def run_library(): text := if given_library != "" then given_library else (warp_lib() ?? library_of_core(folder_of(module_directory)))
# WARP_LIB, asked of the host once a compile: file_source asks for every file it gives, ~50 µs a host call
global warp_lib_asked = no
global warp_lib_given = ø
def warp_lib(): text? {
	if not warp_lib_asked {
		warp_lib_given = env("WARP_LIB")
		warp_lib_asked = yes
	}
	warp_lib_given
}
# this file lies in core/passes/, reached as core/ or as lib/'s link compiler/
def library_of_core(core: text): text := if core.ends_with("/core") then folder_of(core) + "/lib" else folder_of(core)
# The lib/ the run was given, which run_library answers from now on
def use_library(folder: text) { given_library = folder }
# Every module of lib/ by its path within lib/ ("prelude.warp", "native/z.warp", "extensions/sugar/lists.warp"), bundled into the
# built compiler: uses.warp's module_text writes them in where library_sources() stands when it compiles the compiler,
# so a compiler needs no lib/ on any disk (decision built-in-lib). A compiler built by one that bundles none yet (an
# older seed) calls library_sources below and reads them where it runs
# lib/'s folders the bundle leaves out: core's link and extensions/, the compiler itself, which is compiled in, and the
# files a build makes; of those, the folders the compiler reads as data while it runs: the sugar's rules, the uncertain
# extension's operator rows, the modules' compile-time rules (card library-removal-core L1: the extensions' source was 487 KB of the bundle, and their
# parses beside it, the library baked a second time)
UNBUNDLED_FOLDERS = ["compiler", "data", "extensions"]
BUNDLED_DATA_FOLDERS = ["extensions/sugar", "extensions/uncertain", "extensions/rules/modules"]
LIBRARY_FILES = library_sources()
# (its parameter keeps this head apart from the empty call module_text writes the bundle in for)
def library_sources(within: text = ""): map := library_texts(run_library(), within)
# A bundled module's text as the bundle carries it: each line that is only a comment ("# …", "## …", "// …") left
# empty, so the compiler carries no comment text and every line and position stays where it was (a shebang `#!` and
# a line inside a text literal spanning lines are kept). Only the bundle: a module read from disk keeps its comments
def blanked_comments(source: text): text {
	lines = source.split("\n")
	quote = ""
	for at in 0 ..< #lines {
		line = lines[at]
		if quote == "" and is_comment_line(line.trim()) { lines[at] = "" } else if quote != "" or line.contains("\"") or line.contains("'") or line.contains("`") { quote = quote_open_after(line, quote) }
	}
	lines.join("\n")
}
def is_comment_line(line: text): bool := line == "#" or line.starts_with("# ") or line.starts_with("##") or line.starts_with("//")
# the quote a text literal still open after the line opened with (open: "" outside one), as far as a quote, its
# backslash escapes and a trailing comment (`# `, `//` outside a text) tell
def quote_open_after(line: text, open: text): text {
	quote = open
	at = 0
	while at < #line {
		c = line[at ..< at + 1]
		if quote != "" {
			if c == "\\" { at += 1 } else if c == quote { quote = "" }
		} else if c == "\"" or c == "'" or c == "`" {
			quote = c
		} else if (c == "#" or c == "/") and (line[at ..< at + 2] == "# " or line[at ..< at + 2] == "//") {
			return ""
		}
		at += 1
	}
	quote
}
# a bundled module's text, the bundle's one copy (module_source would bake a second one, with its comments)
def bundled_module(within: text): text := LIBRARY_FILES.get(within) ?? ""
# whether source is a bundled module's text but for its comments: each line the same, or blank in the bundle where
# source has a comment (a walk, no copy: asked of every bundled module a compile reads from disk)
def same_but_comments(bundled: text, source: text): bool {
	ours = bundled.split("\n")
	theirs = source.split("\n")
	if #ours != #theirs { return no }
	for at in 0 ..< #ours { if ours[at] != theirs[at] and not (ours[at] == "" and is_comment_line(theirs[at].trim())) { return no } }
	yes
}

# the .warp files of lib/<within> and its folders, by their paths within lib/
def library_texts(library: text, within: text): map {
	found = {}
	entry_names = try list_files(library + "/" + within) else []
	# a compiler without the runtime's own listing (one an older seed built) lists nothing: it reads lib/ where it runs
	if not (type(entry_names) is list) { return found }
	for name in entry_names.sort() {
		path = within + name
		if name.ends_with(".warp") {
			found[path] = blanked_comments(try read(library + "/" + path) else "")
		} else if not name.contains(".") and not UNBUNDLED_FOLDERS.contains(path) {
			inner = library_texts(library, path + "/")
			for inner_path in inner.keys { found[inner_path] = inner[inner_path] }
		}
	}
	if within == "" {
		for folder in BUNDLED_DATA_FOLDERS {
			data = library_texts(library, folder + "/")
			for path in data.keys { found[path] = data[path] }
		}
	}
	found
}
# A source file's text: a bundled module of lib/ from the bundle, unless WARP_LIB is set and has the file changed
# after the build (beyond its comments; per module); any other file (the program's own, core reached as lib/compiler) from the disk;
# ø for none
def file_source(path: text): text? {
	bundled = LIBRARY_FILES.get(library_path(path))
	if bundled != ø and warp_lib() == ø { return bundled }
	read_text = try read(path) else ø
	if read_text == ø or bundled == ø { return read_text ?? bundled }
	# the bundle's very text when the file differs from it only in its comments, so its baked parse, rules and slices
	# apply (the bundle carries no comment, blanked_comments); walked once per file and text a run
	kept = bundled_reads.get(path)
	if kept == ø or kept#1 != read_text {
		kept = [read_text, if same_but_comments(bundled, read_text) then bundled else read_text]
		bundled_reads[path] = kept
	}
	kept#2
}
global bundled_reads = {}
# a path's place within lib/ ("native/z.warp"), "" outside it
def library_path(path: text): text {
	library = run_library() + "/"
	if path.starts_with(library) then path[library.length .. path.length] else ""
}

# modules/index.tsv: what a compile has to know of the standard library before a program's uses are resolved, a cache
# derived from lib/ by `warp rebuild` beside the modules it prebuilt (notes/library_zero_bake.md L2): the words taking
# a block last, the global words, classes and tags of the top modules, the words each module defines (implicit uses),
# the words each module's rules need, the host lines, each module's source hash, lib/aliases.warp's entries and the
# sugar's files. A line `<section>\t<key>\t<value>`,
# read once a compile (scanning the modules' texts was the compiler's baked tables, or ~5 ms of a small compile).
# Without one (the seed's build, a fresh lib/) a section is scanned off lib/ where it runs
LIBRARY_INDEX = "index.tsv"
INDEX_SECTIONS = ["block", "global", "class", "tag", "word", "needs", "host", "hash", "alias", "sugar"]
# the modules beside the runtime a compile runs behind, as the modules it links (compiler.warp linked_libraries)
index_file(): text := folder_of(runtime_path()) + "/" + MODULES_FOLDER + "/" + LIBRARY_INDEX
global index_sections_held = ø
library_index_section(section: text): map := {
	if index_sections_held == ø { index_sections_held = index_sections_read(file_text(index_file())) }
	if not index_sections_held.has(section) { index_sections_held[section] = index_section_scanned(section) }
	index_sections_held[section]
}
# an index's sections, each one it holds (empty or not, a line `section\t<name>\t` names it): a section an older
# index lacks is scanned
index_sections_read(index: text?): map := {
	sections = {}
	for line in (index ?? "").split("\n") {
		fields = line.split("\t")
		if #fields == 3 and fields#1 == SECTION_MARK and fields#2 in INDEX_SECTIONS { sections[fields#2] = {} }
		if #fields == 3 and sections.has(fields#1) { sections[fields#1][fields#2] = fields#3 }
	}
	sections
}
SECTION_MARK = "section"
index_section_scanned(section: text): map := match section {
	"block": block_heads_in(library_on_disk())
	"global": declarations_scanned(library_on_disk())["words"]
	"class": declarations_scanned(library_on_disk())["classes"]
	"tag": declarations_scanned(library_on_disk())["tags"]
	"word": module_word_definers()
	"needs": scanned_rule_needs()
	"host": host_lines_in(library_on_disk())
	"hash": module_hashes()
	"alias": alias_entries_scanned()
	"sugar": sugar_modules_scanned()
}
# lib/aliases.warp's entries, each word with its fields as the index holds them (parser.warp alias_rows)
alias_entries_scanned(): map := {
	entries = {}
	for row in table_rows(source_parse(run_library() + "/" + ALIAS_FILE, library_on_disk()[ALIAS_FILE])) { entries[row#1] = alias_fields_written(row#1, row#2) }
	entries
}
ALIAS_FILE = "aliases.warp"
# the sugar's rule files, extensions/sugar/<name>.warp each by its path without .warp (rewrites.warp sugar_module_names)
sugar_modules_scanned(): map := {
	found = {}
	for path in library_on_disk().keys { if path.starts_with(sugar_folder) and path.ends_with(module_extension) { found[path[0 ..< #path - #module_extension]] = "" } }
	found
}
global library_on_disk_held = ø
library_on_disk(): map := {
	if library_on_disk_held == ø { library_on_disk_held = library_texts(run_library(), "") }
	library_on_disk_held
}
# each standard module's source hash, against which a prebuilt module is checked
module_hashes(): map := {
	hashes = {}
	for module in std_module_names { hashes[module] = source_hash(try read(std_module_path(module)) else "") }
	hashes
}
# a text's length and the djb2 hash of its bytes (the host's sha256 takes no text a compiler's scratch can't show)
SOURCE_HASH_MODULUS = 4294967291
source_hash(source: text): text := {
	hash = 5381
	for byte in source.bytes { hash = (hash * 33 + byte) % SOURCE_HASH_MODULUS }
	"${#source}-${hash}"
}
# the index as lib/ lies now, written into the modules folder; this run goes on with it, the host words made anew
write_library_index(folder: text) := {
	# (each section scanned, none read off an earlier index: the word section asks the host words)
	index_sections_held = {}
	host_words_held = ø
	for section in INDEX_SECTIONS { library_index_section(section) }
	write(folder + "/" + LIBRARY_INDEX, INDEX_SECTIONS.flat_map(section => index_lines(section, index_sections_held[section])).join("\n"))
	host_words_held = ø
}
index_lines(section: text, entries: map): list := [SECTION_MARK + "\t" + section + "\t"] + entries.keys.map(key => section + "\t" + key + "\t" + entries[key])

# Every bundled module's parse, packed (pack), baked in beside its text: module_text writes them in where
# library_parses() stands as it does the texts (decision runtime-prepended: a compile derives no table of its own
# library). A compiler built by one that bakes none yet (an older seed) parses them where it runs
LIBRARY_PARSES = library_parses()
def library_parses(within: text = ""): map := {}
# a source's parse, the baked one when the file at `path` is the bundled module of this very text
def source_parse(path: text, source: text): Node {
	within = library_path(path)
	packed = if LIBRARY_FILES.get(within) == source then LIBRARY_PARSES.get(within) else ø
	if packed != ø then unpack(packed) else plain_node(parsed(rules_ended(source)))
}
# the source with each rule ending its line in `$s...` ended by `;`: the parser reads `...` at the end of a line as a
# range going on into the next line (`rewrite loudly $s... => $s...` and the line after it as `$s ... (next line)`),
# which swallowed the next rule or statement
rewrite_line_start = "rewrite "
def rules_ended(source: text): text {
	if not source.contains(rewrite_line_start) { return source }
	lines = source.split("\n")
	ended = []
	changed = no
	for line in lines {
		rule = line.trim()
		ending = rule.starts_with(rewrite_line_start) and rule.contains("=>") and rule.ends_with("...")
		if ending { changed = yes }
		ended += [if ending then line + ";" else line]
	}
	if changed then ended.join("\n") else source
}
