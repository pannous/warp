# The standard library a compile reads: lib/'s folder for this run, a source file's text by its path, read from disk,
# and the library index. The parser, uses.warp and compiler.warp read lib/ through these words.
use os
use file
# The lib/ a run reads a program's standard modules from (its own data is built in, module_source): the one the run was
# given (compiler.warp's fourth argument, given_library), else WARP_LIB, else the one above this file, or beside it when
# the file was reached as core/ (card compiler-core-link). A compiled stage is kept for every identical lib/ and runs
# from wherever that is now, so nothing reads the folder it was compiled in (card pure-lane-nondeterministic): that
# folder, a build machine's, is only the last resort
global given_library = ""
def run_library(): text := if given_library != "" then given_library else (warp_lib() ?? library_of_core(folder_of(module_directory)))
# WARP_LIB, asked of the host once a compile: file_source asks for every file it gives, ~50 µs a host call
global warp_lib_asked = no
global warp_lib_given = ø
def warp_lib(): text? {
	if not warp_lib_asked {
		warp_lib_given = env("WARP_LIB")
		warp_lib_asked = yes
	}
	warp_lib_given
}
# this file lies in core/passes/, reached as core/ or as lib/'s link compiler/
def library_of_core(core: text): text := if core.ends_with("/core") then folder_of(core) + "/lib" else folder_of(core)
# The lib/ the run was given, which run_library answers from now on
def use_library(folder: text) { given_library = folder }
# whether a line is only a comment ("# …", "## …", "// …")
def is_comment_line(line: text): bool := line == "#" or line.starts_with("# ") or line.starts_with("##") or line.starts_with("//")
# lib/'s folders read as no module: core's link, extensions/ (compiled into the compiler) and the files a build makes;
# of those, the folders the compiler reads as data while it runs: the sugar's rules, the uncertain extension's operator
# rows, the modules' compile-time rules
UNREAD_FOLDERS = ["compiler", "data", "extensions"]
DATA_FOLDERS = ["extensions/sugar", "extensions/uncertain", "extensions/rules/modules"]
# a file of lib/ by its path within lib/ ("prelude.warp", "extensions/sugar/lists.warp"), read from disk: the compiler
# carries no library text (notes/library_zero_bake.md L4), "" for none
def library_text(within: text): text := file_source(run_library() + "/" + within) ?? ""

# the .warp files of lib/<within> and its folders, by their paths within lib/
def library_texts(library: text, within: text): map {
	found = {}
	entry_names = try list_files(library + "/" + within) else []
	# a compiler without the runtime's own listing (one an older seed built) lists nothing: it reads lib/ where it runs
	if not (type(entry_names) is list) { return found }
	for name in entry_names.sort() {
		path = within + name
		if name.ends_with(".warp") {
			found[path] = try read(library + "/" + path) else ""
		} else if not name.contains(".") and not UNREAD_FOLDERS.contains(path) {
			inner = library_texts(library, path + "/")
			for inner_path in inner.keys { found[inner_path] = inner[inner_path] }
		}
	}
	if within == "" {
		for folder in DATA_FOLDERS {
			data = library_texts(library, folder + "/")
			for path in data.keys { found[path] = data[path] }
		}
	}
	found
}
# a source file's text, read once a compile; ø for none
def file_source(path: text): text? {
	if not file_texts.has(path) { file_texts[path] = try read(path) else ø }
	file_texts[path]
}
global file_texts = {}

# modules/index.tsv: what a compile has to know of the standard library before a program's uses are resolved, a cache
# derived from lib/ by `warp rebuild` beside the modules it prebuilt (notes/library_zero_bake.md L2): the words taking
# a block last, the global words, classes, tags and constants of the top modules, the words each module defines (implicit uses),
# the words each module's rules need, the host lines, each module's source hash, lib/aliases.warp's entries, the
# sugar's files and the cuts of the modules every compile reads (prelude_words.warp slices_of). A line `<section>\t<key>\t<value>`,
# read once a compile (scanning the modules' texts was the compiler's baked tables, or ~5 ms of a small compile).
# Without one (the seed's build, a fresh lib/) a section is scanned off lib/ where it runs
LIBRARY_INDEX = "index.tsv"
INDEX_SECTIONS = ["block", "global", "class", "tag", "const", "word", "needs", "host", "hash", "alias", "sugar", "slice"]
# the modules beside the runtime a compile runs behind, as the modules it links (compiler.warp linked_libraries)
index_file(): text := modules_file(LIBRARY_INDEX)
modules_file(name: text): text := folder_of(runtime_path()) + "/" + MODULES_FOLDER + "/" + name
global index_sections_held = ø
library_index_section(section: text): map := {
	if index_sections_held == ø { index_sections_held = index_sections_read(file_text(index_file())) }
	if not index_sections_held.has(section) { index_sections_held[section] = index_section_scanned(section) }
	index_sections_held[section]
}
# an index's sections, each one it holds (empty or not, a line `section\t<name>\t` names it): a section an older
# index lacks is scanned
index_sections_read(index: text?): map := {
	sections = {}
	for line in (index ?? "").split("\n") {
		fields = line.split("\t")
		if #fields == 3 and fields#1 == SECTION_MARK and fields#2 in INDEX_SECTIONS { sections[fields#2] = {} }
		if #fields == 3 and sections.has(fields#1) { sections[fields#1][fields#2] = fields#3 }
	}
	sections
}
SECTION_MARK = "section"
index_section_scanned(section: text): map := match section {
	"block": block_heads_in(library_on_disk())
	"global": declarations_scanned(library_on_disk())["words"]
	"class": declarations_scanned(library_on_disk())["classes"]
	"tag": declarations_scanned(library_on_disk())["tags"]
	"const": declarations_scanned(library_on_disk())["constants"]
	"word": module_word_definers()
	"needs": scanned_rule_needs()
	"host": host_lines_in(library_on_disk())
	"hash": module_hashes()
	"alias": alias_entries_scanned()
	"sugar": sugar_modules_scanned()
	"slice": sliced_modules_scanned()
}
# lib/aliases.warp's entries, each word with its fields as the index holds them (parser.warp alias_rows)
alias_entries_scanned(): map := {
	entries = {}
	for row in table_rows(source_parse(library_text(ALIAS_FILE))) { entries[row#1] = alias_fields_written(row#1, row#2) }
	entries
}
ALIAS_FILE = "aliases.warp"
# the sugar's rule files, extensions/sugar/<name>.warp each by its path without .warp (rewrites.warp sugar_module_names)
sugar_modules_scanned(): map := {
	found = {}
	for path in library_on_disk().keys { if path.starts_with(sugar_folder) and path.ends_with(module_extension) { found[path[0 ..< #path - #module_extension]] = "" } }
	found
}
global library_on_disk_held = ø
library_on_disk(): map := {
	if library_on_disk_held == ø { library_on_disk_held = library_texts(run_library(), "") }
	library_on_disk_held
}
# each standard module's source hash, against which a prebuilt module is checked
module_hashes(): map := {
	hashes = {}
	for module in std_module_names { hashes[module] = source_hash(try read(std_module_path(module)) else "") }
	hashes
}
# a text's length and the host's sha256 of its bytes (djb2 in warp, ~1.3 K instructions a byte, was 5 % of a compile
# under WARP_LIB, card signature-sha256)
source_hash(source: text): text := "${#source}-" + std_pure("hash", "sha256", [source])
# the index and the sugar's rules packed as lib/ lies now, written into the modules folder; this run goes on with
# them, the host words made anew
write_library_index(folder: text) := {
	# (each section scanned, none read off an earlier index: the word section asks the host words)
	index_sections_held = {}
	host_words_held = ø
	for section in INDEX_SECTIONS { library_index_section(section) }
	write(folder + "/" + LIBRARY_INDEX, INDEX_SECTIONS.flat_map(section => index_lines(section, index_sections_held[section])).join("\n"))
	sugar_rules_held = sugar_rules_packed()
	write(folder + "/" + SUGAR_RULES_FILE, packed_table(sugar_rules_held))
	host_words_held = ø
}
index_lines(section: text, entries: map): list := [SECTION_MARK + "\t" + section + "\t"] + entries.keys.map(key => section + "\t" + key + "\t" + entries[key])

# a source's parse
def source_parse(source: text): Node := plain_node(parsed(rules_ended(source)))
# the source with each rule ending its line in `$s...` ended by `;`: the parser reads `...` at the end of a line as a
# range going on into the next line (`rewrite loudly $s... => $s...` and the line after it as `$s ... (next line)`),
# which swallowed the next rule or statement
rewrite_line_start = "rewrite "
def rules_ended(source: text): text {
	if not source.contains(rewrite_line_start) { return source }
	lines = source.split("\n")
	ended = []
	changed = no
	for line in lines {
		rule = line.trim()
		ending = rule.starts_with(rewrite_line_start) and rule.contains("=>") and rule.ends_with("...")
		if ending { changed = yes }
		ended += [if ending then line + ";" else line]
	}
	if changed then ended.join("\n") else source
}
