# Int types (card color-prints): `type Color = int`, in a program or a module it uses, makes a Color an int with a
# mark of its own above its Kind, as a yes/no is a marked Int: `x as Color` marks it, `x is Color` tests the mark and
# the type's `show(c: Color)` gives its text wherever it prints (class_methods.warp's text·shown); arithmetic,
# comparisons and C calls see the plain int. Core names no such type: each declaration gets the next mark.
# `type Angle = float` marks a float alike. Arithmetic keeps a mark (decision marks-survive-arithmetic), held unboxed
# by the emitter as long as it can (decision marks-unboxed-first: TypedCode.mark, stamped where the value is boxed)
use "int_type_shows.warp"
use "class_methods.warp"

shown_parameter = symbol("self")

# the program with its int types marked and shown
int_types(program: Node): Node := {
	kinds = int_type_kinds(statements_in(program))
	if #kinds == 0 { return program }
	marked = bottom_up(program, n => int_type_used(n, kinds))
	showers = kinds.keys.filter(name => statements_in(marked).any(statement => shower_of(statement) == name))
	if #showers == 0 { return marked }
	statements = statements_in(marked).map(statement => if shower_of(statement) in showers then shower_renamed(statement) else statement)
	group_like(marked, with_int_types_shown(statements, showers, kinds))
}
# `x as Color` marks x, `x is Color` tests its mark
int_type_used(n: Node, kinds: map): Node := {
	if not (n is key and value_of(n) is symbol and name_of(value_of(n)) in kinds) { return n }
	kind = kinds[name_of(value_of(n))]
	if is_key(n, Op.As) { return call_of("int_marked", [key_of(n), kind]) }
	if is_key(n, Op.Is) { return Key(call_of("int_mark_of", [key_of(n)]), Op.Eq, kind) }
	n
}
# a type's show under its own name, show·Color, so that every int type has one
shower_renamed(statement: Node): Node := {
	head = key_of(statement)
	Key(group_like(head, [symbol(shower_word(shower_of(statement)))] + items_of(head)[1 ..]), Op.Define, value_of(statement))
}
shower_word(type_name: text): text := showing_word + name_joiner + type_name
# the program's text·shown, the classes' if it has one: a value of an int type first shown by its type's show
with_int_types_shown(statements: list, showers: list, kinds: map): list := {
	head = call_of(showing_dispatcher, [Key(shown_parameter, Op.Colon, symbol("any"))])
	dispatchers = statements.filter(statement => is_key(statement, Op.Define) and is_group(key_of(statement)) and key_of(statement)#1 == symbol(showing_dispatcher))
	classes = if #dispatchers > 0 then dispatchers#1 else ø
	fallback = if classes != ø then value_of(classes) else call_of("str", [shown_parameter])
	shown = Key(head, Op.Define, int_types_dispatch(showers, kinds, fallback))
	if classes == ø then statements + [shown] else statements.map(statement => if statement == classes then shown else statement)
}
int_types_dispatch(showers: list, kinds: map, fallback: Node): Node := {
	otherwise = if #showers == 1 then fallback else int_types_dispatch(showers[1 ..], kinds, fallback)
	test = Key(ø, Op.If, Key(call_of("int_mark_of", [shown_parameter]), Op.Eq, kinds[showers#1]))
	Key(Key(test, Op.Then, call_of(shower_word(showers#1), [shown_parameter])), Op.Else, otherwise)
}
