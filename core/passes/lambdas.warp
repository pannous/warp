# Lambdas and functions as values (card pure-lambdas):
# - an iteration word over a list and a function, `map(xs, x => x + 1)`, `xs.filter(even)`, `xs.map(f)` of a variable or
#   parameter f, is a loop, the lambda's body inlined with its parameters renamed, a function name or value
#   called on each item:
#     xs.map(F)  → (map·1 = []; for item·1 in xs { map·1 = map·1 + [F(item·1)] }; map·1)
# - any other lambda is a closure: a top-level function closure_lambda_<n> whose first parameters are the variables it
#   captures (by value, decision D7), and in its place `closure_new(closure_lambda_<n>, captured…)`
# - a function of the program named as a value, `apply(square, 7)`, is the closure `closure_new(square)`; one without
#   parameters stays its bare call
# - a call of a variable or parameter, `f(x)`, calls the function value it holds: `closure_call_1(f, x)`
# emitter.warp and analyzer.warp read closure_new and closure_call_<n>.
use "walk.warp"
use "../parsing/phrase_blocks.warp"
use "scope.warp"
use "../analysis/signatures.warp"
use "kind_changes.warp"

lifted_prefix = "closure_lambda_"
closure_call_word = "closure_call_"

# the words that walk a list with a function: [the arguments between the list and the function]
# the operators written as words, which name no function
operator_words = {and: Op.And, or: Op.Or, xor: Op.Xor}
iteration_extras = {"map": 0, "filter": 0, "each": 0, "for_each": 0, "forEach": 0, "find": 0, "any": 0, "all": 0, "fold": 1}

# the items after a call's head
arguments_of(call: list): list := call[1..]
call_node(signature: Node, arguments: list): Node := List([signature] + arguments, Bracket.Round, Separator.None)
set_to(target: Node, value: Node): Node := Key(target, Op.Assign, value)
if_block(test: Node, parts: list): Node := Key(Key(ø, Op.If, test), Op.Then, block_of(parts))
for_each(item: Node, list: Node, parts: list): Node := List([symbol("for"), item, symbol("in"), list, block_of(parts)], Bracket.None, Separator.Space)
# `for item in xs.map(f) {parts}` fused into `for source in xs { item = f(source); parts }`: the mapped list is never
# built, for every iteration word (map-fold fusion: `sum(xs .* 2)` is one loop)
each_of(item: Node, list: Node, parts: list): Node := {
	inner = iteration_of(list)
	mapping = if inner != ø and inner.word == "map" then round_code("map", inner.callee) else ø
	if mapping == ø then for_each(item, list, parts) else fused(item, inner.source, mapping, parts)
}
fused(item: Node, list: Node, mapping: function, parts: list): Node := {
	source = fresh_name("source", fresh_number())
	each_of(source, list, [set_to(item, mapping([source]))] + parts)
}
operated(op: Op, values: list): Node := Key(values#1, op, values#2)
grown(out: Node, value: Node): Node := set_to(out, Key(out, Op.Add, List([value], Bracket.Square, Separator.Comma)))

## lambdas

# the lambda itself, without the parentheses around it: `(x => x * 2)`
lambda_of(n: Node): Node := match n {
	List(items, Bracket.Round, separator): lambda_of(items#1)
	_: n
}

# `x`, `(a, b)`, `x: int` of a lambda's head: its parameters as written, a literal refused at its line (`1 => 2`
# names no parameter: it dropped its argument); `()`, which reaches the passes as ø, none
written_parameters(signature: Node): list := {
	parameters = match signature {
		List(names, Bracket.Round, separator): items_of(signature)
		_: if signature == ø then [] else [signature]
	}
	for parameter in parameters.filter(is_literal) { diagnose(call_of("literal_parameter", ["${parameter}"]), parameter) }
	parameters
}

# (a result type after the parentheses, `(a, b): int => a + b`, is no parameter: the parser reads the head as
# `(a, b): int`, which only `x: int => …` without parentheses is, a typed parameter; card lambda-own)
arrow_parameters(n: Node): Node := match lambda_of(n) {
	Key(parameters, arrow, body): if is_key(parameters, Op.Colon) and is_round(key_of(parameters)) then key_of(parameters) else parameters
	_: n
}
arrow_result(n: Node): Node := match lambda_of(n) {
	Key(parameters, arrow, body): body
	_: n
}

lambda_parameter_names(arrow: Node): list := written_parameters(arrow_parameters(arrow)).map(parameter_name)

## renaming

# n with the symbol `from` read as `to`, a field after `.` and a key before `:` kept
renamed(n: Node, from: text, to: Node): Node := match n {
	Symbol(name): { if name == from then to else n }
	Key(left, Op.Dot, right): Key(renamed(left, from, to), Op.Dot, renamed_call(right, from, to))
	Key(left, op, right): Key(renamed(left, from, to), op, renamed(right, from, to))
	List(items, Bracket.Curly, separator): List(items.map(item => if is_key(item, Op.Colon) and key_of(item) is symbol then Key(key_of(item), Op.Colon, renamed(value_of(item), from, to)) else renamed(item, from, to)), Bracket.Curly, separator)
	List(items, bracket, separator): List(items.map(item => renamed(item, from, to)), bracket, separator)
	_: n
}

# the method call after a `.`: its name kept, its arguments renamed
renamed_call(n: Node, from: text, to: Node): Node := match n {
	List(items, Bracket.Round, Separator.None): List([items#1] + arguments_of(items).map(item => renamed(item, from, to)), Bracket.Round, Separator.None)
	_: n
}

# the lambda's body called on the values, its parameters renamed to them
inlined_body(arrow: Node, values: list): Node := {
	body = arrow_result(arrow)
	names = lambda_parameter_names(arrow)
	for i in 1 to #names { body = renamed(body, names#i, values#i) }
	body
}

## iterations

# `xs.map(f)`, `map(xs, f)`: the word, the list it walks, the extra arguments (fold's start) and the function called
class Iteration { word: text; source: Node; extras: list; callee: Node }
# the iteration of a call, else ø
iteration_of(n: Node): Iteration? := match n {
	Key(list, Op.Dot, called): method_iteration(list, called)
	List(call, Bracket.Round, Separator.None): {
		if #call >= 3 and call#1 is symbol and name_of(call#1) in iteration_extras then iteration_parts(name_of(call#1), arguments_of(call)) else ø
	}
	_: ø
}

method_iteration(list: Node, called: Node): Iteration? := match called {
	List(call, Bracket.Round, Separator.None): {
		if #call >= 2 and call#1 is symbol and name_of(call#1) in iteration_extras then iteration_parts(name_of(call#1), [list] + arguments_of(call)) else ø
	}
	_: ø
}

# the list, the extra arguments and the function of the word, when it has as many as it takes
iteration_parts(word: text, arguments: list): Iteration? := {
	if #arguments != 2 + iteration_extras[word] { return ø }
	Iteration(word, arguments#1, arguments[1 ..< #arguments - 1], arguments#(#arguments))
}

# the loop of the word over list, `apply` giving the function's call on the values of each round
iteration_loop(word: text, list: Node, extras: list, apply: function): Node := {
	number = fresh_number()
	item = fresh_name("item", number)
	result = fresh_name(word, number)
	if word == "fold" { return statements([set_to(result, extras#1), each_of(item, list, [set_to(result, apply([result, item]))]), result]) }
	called = apply([item])
	gathered = List([], Bracket.Square, Separator.Comma)
	searching = fresh_name("searching", number)
	match word {
		"map": statements([set_to(result, gathered), each_of(item, list, [grown(result, called)]), result])
		"filter": statements([set_to(result, gathered), each_of(item, list, [if_block(called, [grown(result, item)])]), result])
		"find": statements([set_to(result, ø), set_to(searching, yes), each_of(item, list, [if_block(Key(searching, Op.And, called), [set_to(result, item), set_to(searching, no)])]), result])
		# the answer once known, f is called no more: `[1, 0].all(x => 10 / x < 3)` never divides by 0
		"any": statements([set_to(result, no), each_of(item, list, [if_block(Key(Key(ø, Op.Not, result), Op.And, called), [set_to(result, yes)])]), result])
		"all": statements([set_to(result, yes), each_of(item, list, [if_block(Key(result, Op.And, Key(ø, Op.Not, called)), [set_to(result, no)])]), result])
		_: statements([set_to(result, ø), each_of(item, list, [set_to(result, called)]), result])
	}
}

## the program's functions and values

# `f(a, b) := body`: its name, its parameters as written and its body
class Definition { name: text; parameters: list; body: Node }
# the definition a statement is, else ø
definition_of(n: Node): Definition? := match n {
	Key(signature, Op.Define, body): defined_head(signature, body)
	_: ø
}
# the writes among the statements outside the definitions among them, `x = 1`, `x += 1`: a function's local of the
# same name (lib/math.warp norm's `var total` that `use math` brings) is no write of the program's own `total`
# (cards reactive-ports-test, core-analysis)
own_writes(statements: list): list := statements.filter(statement => definition_of(plain_node(statement)) == ø).flat_map(nodes_in).filter(n => n is key and op_of(n) in assigning_operators)
defined_head(signature: Node, body: Node): Definition? := match signature {
	List(call, Bracket.Round, Separator.None): { if #call >= 1 and call#1 is symbol then Definition(name_of(call#1), arguments_of(call), body) else ø }
	Key(call, Op.Colon, type): defined_head(call, body)
	_: ø
}

# the names a body assigns or declares `x: T = v`, each once; `x := v` defines, it binds no variable. A `for` binds its
# variable inside its loop only (loop_variables): `for slice in slices {…}` leaves a `slice(xs, 1)` before it the library word
names_bound(n: Node, found: list): list := {
	found = newly_bound(n, found)
	if is_lambda(n) or definition_of(n) != ø { return found }
	for part in parts_of(n) { found = names_bound(part, found) }
	found
}
newly_bound(n: Node, found: list): list := match n {
	Key(target, Op.Assign, value): bound_target(target, found)
	List(parts, Bracket.None, Separator.Space): found + arm_names(parts).filter(name => name not in found)
	_: found
}
# the names the arms of `match x { List(items, bracket, separator): … }` bind, before node_matches lowers it: items,
# bracket and separator there are the arm's, not a function of the program
arm_names(parts: list): list := {
	if #parts < 2 or not is_curly_group(parts#(#parts)) { return [] }
	if not ((#parts == 3 and parts#1 == symbol("match")) or (#parts == 2 and is_match_head(parts#1))) { return [] }
	items_of(parts#(#parts)).filter(arm => is_key(arm, Op.Colon)).flat_map(arm => case_pattern_names(key_of(arm)))
}
# [x] of `for x in xs {…}`, else none; a comprehension `[x * 2 for x in xs]` holds its loop as an item, whose x is the
# whole comprehension's
loop_variables(n: Node): list := match n {
	List(parts, Bracket.Square, separator): iteration_variables(parts) + parts.flat_map(loop_variables)
	List(parts, bracket, separator): iteration_variables(parts)
	_: []
}
bound_target(target: Node, found: list): list := match target {
	Symbol(name): { if name in found then found else found + [name] }
	Key(name, Op.Colon, type): bound_target(name, found)
	# `for (input, target) in examples`
	List(items, Bracket.Round, separator): items_bound(items, found)
	_: found
}
items_bound(items: list, found: list): list := {
	for item in items { found = bound_target(item, found) }
	found
}

# every name the node mentions, each once, in order
mentioned_names(n: Node, found: list): list := {
	if n is symbol {
		if name_of(n) not in found { found += [name_of(n)] }
		return found
	}
	for part in parts_of(n) { found = mentioned_names(part, found) }
	found
}

# What the walk knows: the program's functions with their parameter counts, the lifted lambdas so far
# The names a walk sees as variables: the function's own, and those of the program's main level it sees (a map built
# once: a list of them, searched name by name, grew a long program's lambdas pass with the square of its length)
class Locals { own: map; outer: map }
locals_of(names: list, outer: map = {}): Locals := Locals{own: word_set(names), outer: outer}
with_locals(scope: Locals, names: list): Locals := if #names == 0 then scope else Locals{own: word_set(scope.own.keys + names), outer: scope.outer}
is_local(name: text, scope: Locals): bool := scope.own.has(name) or scope.outer.has(name)

class Lowering { arities: map; bound: map = {}; defaulted: map = {}; lambdas_lifted: list; callable_fields: map = {}; function_values: map = {}; field_names: map = {}; globals: map = {}; main_globals: map = {}; function_positions: map = {} }

## the walk

# a ternary's `yes : no`: both branches are code, unlike a pair's key (`c ? xs.map(f) : n`)
lowered_branches(branches: Node, locals: Locals, lowering: Lowering): Node := {
	if not is_key(branches, Op.Colon) { return lowered_lambdas(branches, locals, lowering) }
	Key(lowered_lambdas(key_of(branches), locals, lowering), Op.Colon, lowered_lambdas(value_of(branches), locals, lowering))
}

# n with its lambdas lifted, its iterations looped, its function names as values and its calls of variables as
# closures; `locals` the variables and parameters in scope; quoted code stays as written
lowered_lambdas(n: Node, locals: Locals, lowering: Lowering): Node := {
	if is_quote(n) { return n }
	iteration = iteration_of(n)
	if iteration != ø {
		looped = iteration_over(iteration, locals, lowering)
		if looped != ø { return lowered_lambdas(looped, with_locals(locals, names_bound(looped, [])), lowering) }
	}
	if is_lambda(n) { return lifted(lambda_of(n), locals, lowering) }
	match n {
		Symbol(name): function_value(name, n, locals, lowering)
		Key(left, Op.Dot, right): dotted_lowered(left, right, locals, lowering)
		Key(condition, Op.Question, branches): Key(lowered_lambdas(condition, locals, lowering), Op.Question, lowered_branches(branches, locals, lowering))
		Key(left, Op.Colon, right): Key(left, Op.Colon, lowered_lambdas(right, locals, lowering))
		# `p as text` names a type, also where the program defines a function text()
		Key(left, Op.As, type): Key(lowered_lambdas(left, locals, lowering), Op.As, type)
		# a type's value names a type, `type P = int -> bool` a function type, no lambda
		Key(left, Op.Assign, right): if is_type_view(left) then n else Key(lowered_lambdas(left, locals, lowering), Op.Assign, lowered_lambdas(assigned_values(right, locals, lowering), locals, lowering))
		# `x=5; -x 1` parses as -(x 1) (decision negated-call): a value heads no call, the minus negates it alone, [-5, 1]
		Key(left, Op.Sub, right): if left == ø and are_values(right, locals, lowering) then List([Key(ø, Op.Sub, right#1)] + items_of(right)[1 ..], Bracket.Square, Separator.Comma) else Key(lowered_lambdas(left, locals, lowering), Op.Sub, lowered_lambdas(right, locals, lowering))
		Key(left, op, right): Key(lowered_lambdas(left, locals, lowering), op, lowered_lambdas(right, locals, lowering))
		List(items, Bracket.Round, Separator.None): lowered_call(items_of(n), n, locals, lowering)
		List(items, Bracket.None, Separator.Space): lowered_phrase(items_of(n), n, with_locals(locals, loop_variables(n)), lowering)
		List(items, Bracket.Round, Separator.Space): lowered_phrase(items_of(n), n, locals, lowering)
		List(items, Bracket.None, Separator.Comma): comma_call(n, locals, lowering)
		List(items, Bracket.Curly, Separator.Comma): comma_call(n, locals, lowering)
		List(items, bracket, separator): List(items.map(item => lowered_lambdas(item, locals, lowering)), bracket, separator)
		_: n
	}
}

# a function of the program with parameters, named where a value goes (by an alias too, `is_letter` of is_alpha): its
# closure; one without, or with each defaulted, stays its bare call (decision defaults-bare-call); a library word,
# `sqrt`, the lambda calling it (library_word_value)
function_value(name: text, n: Node, locals: Locals, lowering: Lowering): Node := {
	if is_local(name, locals) { return n }
	# (a name the program binds, a parameter `size` too, is its own: never an alias's word, count)
	word = if name in lowering.arities or lowering.bound.has(name) then name else unaliased(name)
	if word not in lowering.arities {
		lambda = library_word_value(name, lowering.bound)
		return if lambda == ø then n else lowered_lambdas(lambda, locals, lowering)
	}
	if lowering.arities[word] == 0 or lowering.defaulted.has(word) { return n }
	call_node(symbol("closure_new"), [symbol(word)])
}
# a library word named as a value, `f = sqrt`, `xs.map(upper)`, `f(is_letter)`: the lambda calling it with as many
# arguments as its declarations agree on (card library-word-value); ø for a name the program binds itself, a type
# word (`any` too, beside the word any(xs, f)), or a word declared with no parameters or several counts
library_word_value(name: text, bound: map): Node? := {
	if bound.has(name) or is_tested_type_word(name) or name == any_word { return ø }
	counts = library_lines_of(name).map(line => #line.signature.parameters)
	if #counts == 0 or counts#1 == 0 or counts.any(count => count != counts#1) { return ø }
	lambda_calling(unaliased(name), counts#1)
}
# the declarations of the library word a name says: the runtime's, the emitter's and libm's
library_lines_of(name: text): list := lines_of(typed_lines + math_runtime_lines + foreign_math_lines, unaliased(name))

# an argument as passed: a function without parameters given for a parameter declared a function, `g(d)` of
# `g(c: function)`, is its closure, not its call; so is the parameterless variant of a name defined with several
# parameter counts (arity_overloads: `low() := …` beside a used module's `low(g: Gaussian)`), where its bare name is
# that variant's call
passed_value(argument: Node, at: int, callee: Node, locals: Locals, lowering: Lowering): Node := {
	# (a word only the compiler's passes write takes a name as written, extremes.warp's `empty_extremum(min)`: never the
	# library word's function value)
	if argument is symbol and callee is symbol and #lines_of(compiler_lines, name_of(callee)) > 0 { return argument }
	takes_function = callee is symbol and function_named_at(lowering.function_positions, name_of(callee), at) != ""
	target = if argument is symbol and not is_local(name_of(argument), locals) then parameterless_function(name_of(argument), lowering) else ""
	if takes_function and target != "" then call_node(symbol("closure_new"), [symbol(target)]) else lowered_lambdas(argument, locals, lowering)
}
# the function a bare name calls without arguments: its own, or its parameterless variant; "" for none
parameterless_function(name: text, lowering: Lowering): text := {
	variant = overload_variant_name(name, 0)
	if lowering.arities.get(name) == 0 or lowering.defaulted.has(name) then name else if lowering.arities.get(variant) == 0 then variant else ""
}
# `f(a, b)`: a call of a variable is a call of the function value it holds, a function's call keeps its name; a call
# of any other expression calls the function value it gives: `(x => x*2)(5)`, `adder(5)(1)`, `fs[0](3)`
lowered_call(call: list, n: Node, locals: Locals, lowering: Lowering): Node := {
	if #call == 0 { return n }
	given = arguments_of(call)
	arguments = (1 to #given).map(at => passed_value(given#at, at, call#1, locals, lowering))
	signature = call#1
	if signature is symbol and is_variable(name_of(signature), if is_inserted_word(signature) then locals_of([]) else locals, lowering) { return call_node(symbol(closure_call_word + #arguments), [signature] + arguments) }
	if signature is symbol { return call_node(signature, arguments) }
	callee = lowered_lambdas(signature, locals, lowering)
	if is_callee(signature) or is_lambda(signature) { return call_node(symbol(closure_call_word + #arguments), [callee] + arguments) }
	call_node(callee, arguments)
}

# a variable in scope: a local, or a global no function of the program is named as (`global filler = ø`, set to a
# function value elsewhere)
# (a word a pass inserted, walk.warp call_of, is looked up among the globals only: an open·… slot is one)
is_variable(name: text, locals: Locals, lowering: Lowering): bool := is_local(name, locals) or (lowering.globals.has(name) and name not in lowering.arities)

# `xs = a b 3` of variables a and b (the parser's `a (b 3)`): a name bound to a value heads no call, the values side by
# side are their list (decision reconsider-spaced); any other value as it is
assigned_values(n: Node, locals: Locals, lowering: Lowering): Node := {
	words = side_by_side_words(n)
	if #words > 1 and words.all(word => is_plain_value(word, locals, lowering)) then List(words, Bracket.Square, Separator.Comma) else n
}
side_by_side_words(n: Node): list := {
	if not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " ") { return [n] }
	words = []
	for item in items_of(n) { words += side_by_side_words(item) }
	words
}
# values side by side, `x 1` of a variable x
are_values(n: Node, locals: Locals, lowering: Lowering): bool := is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n > 1 and items_of(n).all(word => is_plain_value(word, locals, lowering))
# a number, a text, or a variable holding no function
is_plain_value(word: Node, locals: Locals, lowering: Lowering): bool := word is number or word is text or (word is symbol and is_variable(name_of(word), locals, lowering) and not lowering.function_values.has(name_of(word)))
# `f 3 4`, words side by side: the first calls the others, its name kept; a lambda first is called with them,
# `(x => x*2) 4` as `(x => x*2)(4)` (and `{it*2} 4`, extensions/sugar/calls.warp)
lowered_phrase(words: list, n: Node, locals: Locals, lowering: Lowering): Node := {
	# `(a -1)`, `(a b)` of variables: a bound value heads no call, the values side by side are their list
	if #words > 1 and words.all(word => is_plain_value(word, locals, lowering)) { return List(words, Bracket.Square, Separator.Comma) }
	if #words > 1 and is_lambda(words#1) { return lowered_call(words, call_node(words#1, arguments_of(words)), locals, lowering) }
	if #words == 0 or not (words#1 is symbol) { return group_like(n, words.map(word => lowered_lambdas(word, locals, lowering))) }
	# `sq 3` of `sq = x => x*x`: a variable holding a function, given its arguments, calls it
	if #words > 1 and is_variable(name_of(words#1), locals, lowering) and lowering.function_values.has(name_of(words#1)) { return lowered_call(words, call_node(words#1, arguments_of(words)), locals, lowering) }
	nested = if is_local(name_of(words#1), locals) then ø else nested_phrase(words, lowering)
	if nested != ø { return lowered_phrase(nested, n, locals, lowering) }
	group_like(n, [words#1] + arguments_of(words).map(word => lowered_lambdas(word, locals, lowering)))
}
# `show a, b`, `puts add 1, 2`, also a block's `{ show a, b }` (decision function-words-consume): a phrase before commas takes the items after them
# its function words still miss, show(a, b); the items left stay the comma list's
comma_call(n: Node, locals: Locals, lowering: Lowering): Node := {
	items = items_of(n)
	# `x = add 1, 2` parses as `(x = add 1), 2`: the assigned phrase takes them
	assigned = is_key(items#1, Op.Assign)
	first = if assigned then value_of(items#1) else items#1
	missing = if is_phrase(first) and #first > 1 and first#1 is symbol and not is_local(name_of(first#1), locals) then missing_arguments(items_of(first), lowering) else 0
	taken = min(missing, #items - 1)
	if taken == 0 { return group_like(n, items.map(item => lowered_lambdas(item, locals, lowering))) }
	phrase = List(items_of(first) + items[1 .. taken + 1], Bracket.None, Separator.Space)
	call = if assigned then Key(key_of(items#1), Op.Assign, phrase) else phrase
	regrouped = if taken == #items - 1 then call else List([call] + items[taken + 1 ..], Bracket.None, Separator.Comma)
	# `{ show a, b }`: a block of that one statement
	lowered_lambdas(if bracket_of(n) == "{" then List([regrouped], Bracket.Curly, Separator.Semicolon) else regrouped, locals, lowering)
}
# the arguments a phrase's function words still miss: `add 1` 1, `puts add 1` 1 (puts takes the phrase add 1)
missing_arguments(words: list, lowering: Lowering): int := {
	nested = nested_phrase(words, lowering)
	if nested != ø { return missing_arguments(items_of(nested.last), lowering) }
	wanted = (lowering.arities.get(name_of(words#1)) ?? 0) - (#words - 1)
	if wanted > 0 then wanted else 0
}
# `f g 1`, `first add 1 2`: more words than the function takes, a function word where its last argument goes: that
# word's phrase is the argument, f(g(1)), as words take their arguments by their parameters (card
# prelude-word-calls); ø for other words
nested_phrase(words: list, lowering: Lowering): list? := {
	taken = lowering.arities.get(name_of(words#1)) ?? 0
	if taken == 0 or #words <= taken + 1 { return ø }
	last = words#(taken + 1)
	if not (last is symbol and (lowering.arities.get(name_of(last)) ?? 0) > 0) { return ø }
	words[0 ..< taken] + [List(words[taken ..], Bracket.None, Separator.Space)]
}

# `x.f(a)`: of a field the program gives a function value (callable_fields), the function it holds called,
# `closure_call_1(x.f, a)`; else a method call, its name kept. Where f is also a word, the program's or the library's,
# the receiver decides as it runs: one holding the field f calls it, any other the word, so a `{click: e => …}` leaves
# `button.click(5)` and `xs.reverse()` their methods (decision fields-are-functions: own fields first)
dotted_lowered(left: Node, right: Node, locals: Locals, lowering: Lowering): Node := {
	receiver = lowered_lambdas(left, locals, lowering)
	# `3.g`, `x.g(a)` of a local variable or parameter holding a function: the function it holds called, g(x, a), where
	# no object of the program has its own g (decision fields-are-functions: own fields first)
	method = if is_round(right) then items_of(right) else [right]
	if #method > 0 and method#1 is symbol and is_local(name_of(method#1), locals) and lowering.function_values.has(name_of(method#1)) and not lowering.field_names.has(name_of(method#1)) {
		arguments = [receiver] + arguments_of(method).map(argument => lowered_lambdas(argument, locals, lowering))
		return call_node(symbol(closure_call_word + #arguments), [method#1] + arguments)
	}
	if not is_round(right) { return Key(receiver, Op.Dot, lowered_method(right, locals, lowering)) }
	called = items_of(right)
	if not (#called > 0 and called#1 is symbol and lowering.callable_fields.has(name_of(called#1))) {
		return Key(receiver, Op.Dot, lowered_method(right, locals, lowering))
	}
	arguments = arguments_of(called).map(argument => lowered_lambdas(argument, locals, lowering))
	name = name_of(called#1)
	if not names_word(name, #arguments + 1, lowering) { return call_node(symbol(closure_call_word + #arguments), [Key(receiver, Op.Dot, called#1)] + arguments) }
	held = if receiver is symbol then receiver else fresh_name("receiver", fresh_number())
	field_call = call_node(symbol(closure_call_word + #arguments), [Key(held, Op.Dot, called#1)] + arguments)
	either = chosen(call_of(HiddenWord.FieldHeld as text, [held, name]), field_call, Key(held, Op.Dot, lowered_method(right, locals, lowering)))
	if receiver is symbol then either else statements([set_to(held, receiver), either])
}
# a function of that name taking count arguments: the program's, the prelude's or a built-in word
names_word(name: text, count: int, lowering: Lowering): bool := lowering.arities.get(name) == count or library_lines_of(name).any(line => #line.signature.parameters == count)

# the names the program gives a function value by op, named unlike any of its functions: the fields (Op.Colon)
# `{answer: answer}` of a parameter `answer: function`, `{d: x => x + 1}`, `{f: square}` of a function with parameters;
# the variables (Op.Assign) `sq = x => x*x`
# (a field may share a function's name, the receiver choosing at run time, dotted_lowered; a variable may not)
callable_names_of(program: Node, op: Op, arities: map, function_parameters: map, bound: map): map := keyed_names(program, op, n => not (op == Op.Assign and arities.has(name_of(key_of(n)))) and gives_function(value_of(n), arities, function_parameters, bound))
# the names the program keys by op whose key holds: by Op.Colon its objects' fields, `{a: 1}`, `class T { a: int }`
keyed_names(program: Node, op: Op, holds: function): map := {
	names = {}
	for n in nodes_in(program) {
		if is_key(n, op) and key_of(n) is symbol and holds(n) { names[name_of(key_of(n))] = yes }
	}
	names
}
gives_function(value: Node, arities: map, function_parameters: map, bound: map): bool := {
	if is_lambda(value) { return yes }
	if not (value is symbol) { return no }
	function_parameters.has(name_of(value)) or (arities.has(name_of(value)) and arities[name_of(value)] > 0) or library_word_value(name_of(value), bound) != ø
}
# the parameters declared functions, `answer: function`, of the program's definitions
function_parameters_of(written: list): map := {
	found = {}
	for statement in written {
		parts = definition_of(statement)
		if parts != ø {
			for parameter in parts.parameters { if is_key(parameter, Op.Colon) and key_of(parameter) is symbol and value_of(parameter) == symbol("function") { found[name_of(key_of(parameter))] = yes } }
		}
	}
	found
}

# the parameters declared functions (found) and those a call of their function is given one for: `f` of
# `apply(f, x) := f x` in `apply(inc, 1)`
parameters_given_functions(written: list, arities: map, found: map, bound: map): map := {
	# (by name, each call looking up its own: a filter of every definition for every call was 4 % of the self compile)
	definitions = {}
	for statement in written {
		parts = definition_of(statement)
		if parts != ø { definitions[parts.name] = (definitions.get(parts.name) ?? []) + [parts] }
	}
	for n in nodes_in(block_of(written)) {
		if not (is_round(n) and #n > 1 and n#1 is symbol and definitions.has(name_of(n#1))) { continue }
		for parts in definitions[name_of(n#1)] {
			given = arguments_of(items_of(n))
			for i in 1 to min(#given, #parts.parameters) { if gives_function(given#i, arities, {}, bound) { found[parameter_name(parts.parameters#i)] = yes } }
		}
	}
	found
}

# the method call after a `.`: its name kept
lowered_method(n: Node, locals: Locals, lowering: Lowering): Node := match n {
	List(items, Bracket.Round, Separator.None): call_node(items#1, arguments_of(items).map(item => lowered_lambdas(item, locals, lowering)))
	_: n
}

# the operator a function value names, `fold(xs, 0, +)`, `fold(bits, no, or)`: a bare operator (the parser's key with
# neither side) or an operator word, else ø
operator_function(function: Node): Op? := match function {
	Key(left, op, right): if left is ø and right is ø then op else ø
	Symbol(name): operator_words.get(name)
	_: ø
}

# the loop of an iteration whose function is a lambda, a function of the program or a function value, else ø
iteration_over(iteration: Iteration, locals: Locals, lowering: Lowering): Node? := {
	apply = round_code(iteration.word, iteration.callee)
	if apply == ø then ø else iteration_loop(iteration.word, iteration.source, iteration.extras, apply)
}

# the word's function as the code of its call on the values of a round, else ø
round_code(word: text, function: Node): function? := {
	if is_lambda(function) {
		arrow = lambda_of(function)
		if #lambda_parameter_names(arrow) != iteration_extras[word] + 1 { return ø }
		return values => inlined_body(arrow, values)
	}
	operator = operator_function(function)
	if operator != ø and iteration_extras[word] == 1 { return values => operated(operator, values) }
	# a name: a variable's function value, a function of the program or a library word, `xs.map(len)`
	if not (function is symbol) { return ø }
	values => call_node(function, values)
}

# a lambda as the closure of a top-level function taking its captured variables first
lifted(arrow: Node, locals: Locals, lowering: Lowering): Node := {
	parameters = written_parameters(arrow_parameters(arrow))
	names = parameters.map(parameter_name)
	body = arrow_result(arrow)
	captured = mentioned_names(body, []).filter(name => is_local(name, locals) and name not in names).map(name => symbol(name))
	name = lifted_prefix + fresh_number()
	inner = captured.map(c => name_of(c)) + names + names_bound(body, [])
	lowering.arities[name] = #captured + #names
	lifted_body = lowered_lambdas(body, locals_of(inner), lowering)
	lowering.lambdas_lifted += [Key(call_node(symbol(name), captured + parameters), Op.Define, lifted_body)]
	call_node(symbol("closure_new"), [symbol(name)] + captured)
}

## the pass

## shared captures

# A variable of a scope that a lambda in it changes, `n += 1` or `n = 5`, is shared (P124, decision
# lambda-assign-writes-through): it lives in a cell, `n·cell = Cell(n)`, each mention `n·cell.value`, and the lambda
# captures the cell by value; a lambda's `let n = 5` is its own n (card let-inside: the declaration rules drop the
# `let` but note where its name was written, local_declarations). A block
# is of its scope (decision handler-blocks-share): each name of the scope it assigns is shared. A name only the lambda
# or block binds stays its own, a `global` one global
cell_class = "Cell"
cell_suffix = "·cell"
counting_steps = ["++", "--"]
shared_names(statements: list, locals: list, blocks: list): list := {
	changed = blocks.flat_map(block => assigned_names(block, assigning_operators))
	for lambda in statements.flat_map(nodes_in).filter(is_lambda) {
		own = lambda_parameter_names(lambda_of(lambda))
		declared = declared_locally(arrow_result(lambda))
		changed += assigned_names(arrow_result(lambda), assigning_operators).filter(name => name not in own and name not in declared)
	}
	changed += captures_assigned_later(statements)
	globals = global_variables(block_of(statements))
	shared = []
	for name in changed { if name in locals and name not in globals and name not in shared { shared += [name] } }
	shared
}
# where each name a local declaration word declared was written (extensions/rules/rule_words.warp declared_local), set anew for
# each program (passes.warp with_used)
global local_declarations = {}
# a name a declaration word declared, noted where it was written (a name a pass made is written nowhere)
declared_at(name: Node) := if written_at(name) != ø { local_declarations["${written_at(name)}"] = yes }
# the names a node declares as its own, `let n = 5`
declared_locally(n: Node): list := {
	declared = []
	for part in nodes_in(n) { if is_key(part, Op.Assign) and key_of(part) is symbol and local_declarations.has("${written_at(key_of(part))}") { declared += [name_of(key_of(part))] } }
	declared
}
# `x=1; f=()=>x; x=2; f()` is 2: a captured variable is the same variable, so a name a lambda reads that a later
# statement of its scope assigns is shared (decision captured-same-variable); a read-only capture stays a copy
captures_assigned_later(statements: list): list := {
	shared = []
	last = last_assignments(statements)
	for at in 1 to #statements {
		for lambda in nodes_in(statements#at).filter(is_lambda) {
			own = lambda_parameter_names(lambda_of(lambda))
			shared += nodes_in(arrow_result(lambda)).filter(part => part is symbol and (last.get(name_of(part)) ?? 0) > at and name_of(part) not in own).map(name_of)
		}
	}
	shared
}
# name → the last of the statements that assigns it: a statement after `at` assigns the names whose last is beyond at,
# gathered in one walk (each statement gathering its later ones' was quadratic: 10% of compiling compiler.warp)
last_assignments(statements: list): map := {
	last = {}
	for at in 1 to #statements { for name in assigned_names(statements#at, assigning_operators) { last[name] = at } }
	last
}
# the names a node changes with one of the operators, `n += …`, `n++`
assigned_names(n: Node, operators: list): list := nodes_in(n).filter(part => part is key and (op_of(part) in operators or op_of(part) in counting_steps) and key_of(part) is symbol).map(part => name_of(key_of(part)))
cell_of(name: text): Node := Key(symbol(name + cell_suffix), Op.Dot, symbol("value"))
# a shared name declared with a type, `guests: int = 2`, takes each value through a typed local of its own, the cell
# holding what it took, `guests = (guests·typed: int = 5)`: the cell's value has no declared type to check, convert or
# refuse a value by, so `guests = 2.5` in a lambda is refused as at the main level (card lambda-captured-assignment)
typed_suffix = "·typed"
typed_through_local(n: Node, name: text, type: any): Node := if type == ø then n else bottom_up(n, part => through_type(part, name, type))
through_type(part: Node, name: text, type: Node): Node := {
	value = value_given(part, name)
	if value == ø { return part }
	# the made local stands where this assignment wrote the name: a refusal names it, not the declaration (card typed-refusal-position)
	written = if declares_typed(part, name) then key_of(key_of(part)) else key_of(part)
	Key(symbol(name), Op.Assign, Key(Key(placed(symbol(name + typed_suffix), written), Op.Colon, type), Op.Assign, value))
}
# the value an assignment gives the name: `name: T = v` and `name = v` give v, `name += v` name + v
value_given(part: Node, name: text): any := {
	if declares_typed(part, name) { return value_of(part) }
	if not (part is key and key_of(part) == symbol(name)) { return ø }
	if is_key(part, Op.Assign) { return value_of(part) }
	if op_of(part) in compound_ops { return Key(symbol(name), compound_ops[op_of(part)] as Op, value_of(part)) }
	ø
}
declares_typed(part: Node, name: text): bool := is_key(part, Op.Assign) and is_key(key_of(part), Op.Colon) and key_of(key_of(part)) == symbol(name)
# the type the statements first declare the name with, `guests: int = 2`, else ø
type_declared(statements: list, name: text): any := {
	for part in statements.flat_map(nodes_in) { if declares_typed(part, name) { return value_of(key_of(part)) } }
	ø
}
# the statements of a scope, its parameters and the blocks it gives functions as lambdas, its shared names in cells
# made first, a parameter's holding its value. A shared name the program's functions read too (`read_elsewhere`, main's
# `price` of `total := price * count` beside `on key { price = 10 }`) is one variable for them all: a global, its first
# `price = 3` declaring it, as `global price = 3` would (card lambda-mutable-capture)
celled_scope(statements: list, parameters: list, positions: map, read_elsewhere: list): list := {
	blocks = statements.flat_map(statement => blocks_given(statement, positions))
	statements = statements.map(statement => with_block_arguments(statement, positions))
	locals = parameters + statements.fold([], (found, statement) => names_bound(statement, found))
	statements = statements.map(statement => undeclared_in_lambdas(statement, locals))
	shared = shared_names(statements, locals, blocks)
	made_global = shared.filter(name => name in read_elsewhere and first_assignment(statements, name) >= 0)
	statements = made_global.fold(statements, with_global_declaration)
	shared = shared.filter(name => name not in made_global)
	types = {}
	for name in shared { types[name] = type_declared(statements, name) }
	celled = statements.map(statement => shared.fold(statement, (part, name) => renamed(typed_through_local(part, name, types[name]), name, cell_of(name))))
	made = shared.map(name => set_to(symbol(name + cell_suffix), call_node(symbol(cell_class), [if name in parameters then symbol(name) else ø])))
	made + celled.map(statement => with_celled_lambdas(statement, positions))
}
# each lambda with a block body a scope of its own, as a definition's body is: `g = () -> { n = 0; thrice { n += 1 };
# n }` shares n with its block (card core-lambda-block-capture); a scope's lambdas are celled after it, so a name it
# shares is already its cell there
with_celled_lambdas(n: Node, positions: map): Node := {
	if is_lambda(n) and is_block_argument(arrow_result(n)) { return celled_lambda(lambda_of(n), positions) }
	children(n, part => with_celled_lambdas(part, positions))
}
celled_lambda(arrow: Node, positions: map): Node := match arrow {
	Key(head, op, body): {
		statements = celled_scope(items_of(body), lambda_parameter_names(arrow), positions, [])
		if statements == items_of(body) then arrow else Key(head, op, block_of(statements))
	}
	_: arrow
}
# where the scope first assigns the name as a statement of its own, `price = 3`, else -1
first_assignment(statements: list, name: text): int := {
	for at in 0 ..< #statements { if is_key(statements[at], Op.Assign) and key_of(statements[at]) == symbol(name) { return at } }
	-1
}
with_global_declaration(statements: list, name: text): list := {
	at = first_assignment(statements, name)
	statements[0 ..< at] + [Key(symbol(global_word), Op.Colon, statements[at])] + statements[at + 1 ..]
}
# the names a function definition reads from outside it: not its parameters, nor what it binds itself
read_from_outside(statement: Node): list := {
	parts = definition_of(statement)
	if parts == ø { return [] }
	own = parts.parameters.map(parameter_name) + names_bound(parts.body, [])
	mentioned_names(parts.body, []).filter(name => name not in own)
}
# a lambda's `global n` or `nonlocal n` of a name its scope binds says what sharing does already: it goes, else it
# would declare a global n of the lambda's own
undeclared_in_lambdas(statement: Node, locals: list): Node := bottom_up(statement, part => if is_lambda(part) then bottom_up(part, inner => if is_redeclaration(inner, locals) then ø else inner) else part)
is_redeclaration(n: Node, locals: list): bool := {
	parts = if is_key(n, Op.Colon) then [key_of(n), value_of(n)] else if is_group(n) and bracket_of(n) == "" and #n == 2 then items_of(n) else []
	#parts == 2 and parts#1 is symbol and name_of(parts#1) in sharing_declarations and parts#2 is symbol and name_of(parts#2) in locals
}
sharing_declarations = ["global", "nonlocal"]
# a definition with its body in that form
celled_definition(statement: Node, positions: map): Node := {
	parts = definition_of(statement)
	if parts == ø { return statement }
	statements = (if is_curly_group(parts.body) then items_of(parts.body) else [parts.body]).map(local_function)
	match statement {
		Key(signature, Op.Define, body): Key(signature, Op.Define, block_of(celled_scope(statements, parts.parameters.map(parameter_name), positions, [])))
		_: statement
	}
}
# `inner(x) := e` among a function's statements is its local function `inner = (x) => e`, a closure sharing what it
# changes (decision P124), its own local functions so too
local_function(statement: Node): Node := {
	parts = definition_of(statement)
	if parts == ø { return statement }
	body = if is_curly_group(parts.body) then group_like(parts.body, items_of(parts.body).map(local_function)) else parts.body
	Key(symbol(parts.name), Op.Assign, Key(List(parts.parameters, Bracket.Round, Separator.Comma), Op.Arrow, body))
}

# a definition with its body lowered, its parameters and variables the locals, and the program's variables it sees: a
# global holding a function value, `g = (x => x * 2); h(t) := g(t)`, is called as one
lowered_statement(statement: Node, main_names: map, seen_by_functions: map, lowering: Lowering): Node := {
	parts = definition_of(statement)
	if parts == ø { return lowered_lambdas(statement, locals_of([], main_names), lowering) }
	# a loop variable and a `let n = …` are the function's own, never the main-level global of that name (decision
	# loop-locals): renamed apart as a module's own locals are
	own = (nodes_in(statement).flat_map(loop_variables) + declared_locally(statement)).filter(name => lowering.main_globals.has(name))
	if #own > 0 {
		statement = with_own_locals(statement, own)
		parts = definition_of(statement)
	}
	# (a main-level global the body assigns stays the global: `flag = no; turned(() => flag)` reads it, never a copy
	# of then)
	locals = locals_of(parts.parameters.map(parameter_name) + names_bound(parts.body, []).filter(name => name not in lowering.main_globals), seen_by_functions)
	match statement {
		Key(signature, Op.Define, body): Key(signature, Op.Define, lowered_lambdas(body, locals, lowering))
		_: statement
	}
}

## blocks given to function parameters

# A `{…}` given to a parameter typed `function` or `block` is its lazy body (decision block-lazy-body): the lambda of
# no parameters, of `it` when it mentions it, a closure sharing what it changes; a `block` parameter is a function
# a parameter named `block` is a block too, untyped (wiki/block.md)
block_types = [symbol("function"), symbol("block")]
block_word = symbol("block")
is_function_parameter(parameter: Node): bool := parameter == block_word or (is_key(parameter, Op.Colon) and value_of(parameter) in block_types)
as_function_parameter(parameter: Node): Node := {
	if parameter == block_word { return Key(block_word, Op.Colon, symbol("function")) }
	if is_function_parameter(parameter) then Key(key_of(parameter), Op.Colon, symbol("function")) else parameter
}
with_function_parameters(statement: Node): Node := match statement {
	Key(List(call, Bracket.Round, Separator.None), Op.Define, body): {
		blocks = arguments_of(call).filter(is_function_parameter).map(parameter_name)
		for parameter in arguments_of(call).filter(p => p is symbol and p != block_word) {
			if unwrapped_in(body, parameter) { raise undeclared_use(name_of(parameter), "run as a block", "block, and run it " + name_of(parameter) + "()") }
			if called_in(body, parameter) { raise undeclared_use(name_of(parameter), "called as a function", "function") }
		}
		for block in blocks { if unwrapped_in(body, symbol(block)) { raise block_bang(block) } }
		Key(call_node(call#1, arguments_of(call).map(as_function_parameter)), Op.Define, body)
	}
	_: statement
}
# `body!` of a block parameter: a block runs only by a call, `!` is unwrap, in place or an operator (decision
# blocks-run-by-call)
block_bang(name: text): text := name + "! runs no block; fix: " + name + "()"
is_unwrapping(n: Node): bool := is_round(n) and #n == 2 and n#1 == symbol(unwrap_word)
# `body!` or `f(x)` of an untyped parameter: a parameter is a block or function only when declared one, never inferred
# from its use (decision declared-block-parameters)
undeclared_use(name: text, use: text, type: text): text := name + " is " + use + "; fix: declare it " + name + ": " + type
unwrapped_in(body: Node, name: Node): bool := nodes_in(body).any(part => is_unwrapping(part) and part#2 == name)
# each function's parameter names, "" where a parameter takes no function, by the function's name
function_positions_of(written: list): map := {
	found = {}
	for statement in written {
		parts = definition_of(statement)
		if parts == ø { continue }
		names = parts.parameters.map(parameter => if takes_function_at(parts, parameter) then parameter_name(parameter) else "")
		if names.any(name => name != "") { found[parts.name] = names }
	}
	found
}
# a parameter declared a function, or one the body calls (`f: any`; an untyped one is refused, undeclared_use):
# `matrix(r, c, f: function) := [[f() …]]` takes a function, so a function of no parameters given for it is passed, not
# called (`matrix(2, 4, weight)`)
takes_function_at(parts: Definition, parameter: Node): bool := is_function_parameter(parameter) or called_in(parts.body, symbol(parameter_name(parameter)))
called_in(body: Node, name: Node): bool := nodes_in(body).any(part => is_call_headed(part, name))
# a name of its own: a word of the same name and arity elsewhere in the compiler (the rule words) would hide one of the two
is_call_headed(n: Node, name: Node): bool := match n {
	List(items, Bracket.Round, Separator.None): #items > 0 and items#1 == name
	_: no
}
block_lambda(block: Node): Node := Key(if mentions(block, "it") then symbol("it") else ø, Op.Arrow, block)
takes_function(n: Node, positions: map): bool := n is symbol and positions.has(name_of(n))
# `f(a) {…}` and `f{…}` as the calls `f(a, {…})` and `f({…})` where f takes a function, else n
joined_block_call(n: Node, positions: map): Node := {
	n = regrouped_block(glued_block_call(n, name => positions.has(name)), positions)
	if not (n is list and #n == 2 and is_round(n#1) and #n#1 > 0 and takes_function(n#1#1, positions) and is_block_argument(n#2)) { return n }
	call_node(n#1#1, arguments_of(items_of(n#1)) + [n#2])
}
# `at bars(0) {…}`, which the parser reads as `at (bars(0) {…})`: the phrase `at bars(0) {…}` where bars takes no block
regrouped_block(n: Node, positions: map): Node := {
	if not (n is list and #n >= 2 and takes_function(n#1, positions)) { return n }
	items = items_of(n)
	last = items.last
	if not (is_round(last) and #last == 2) { return n }
	call = last#1
	block = last#2
	if not (is_round(call) and #call > 0 and not takes_function(call#1, positions) and is_block_argument(block)) { return n }
	group_like(n, items[0 ..< #items - 1] + [call, block])
}
# the function parameter's name at a function's position, else ""
function_named_at(positions: map, function: text, at: int): text := {
	names = positions.get(function) ?? []
	if at <= #names then names#at else ""
}
# the arguments of the call or phrase `f a {…}` that are blocks given to a function parameter of f, by position or by
# its label: `f(a, body: {…})`
given_positions(n: Node, positions: map): list := {
	if not (n is list and #n >= 2 and takes_function(n#1, positions)) { return [] }
	names = positions[name_of(n#1)]
	(1 ..< #n).filter(i => is_block_argument(block_given(n#(i + 1))) and (if is_labeled(n#(i + 1)) then name_of(key_of(n#(i + 1))) in names else function_named_at(positions, name_of(n#1), i) != ""))
}
is_labeled(argument: Node): bool := is_key(argument, Op.Colon) and key_of(argument) is symbol
# the block an argument gives, its label's value for a labeled one
block_given(argument: Node): Node := if is_labeled(argument) then value_of(argument) else argument
blocks_given(n: Node, positions: map): list := nodes_in(n).map(part => joined_block_call(part, positions)).flat_map(call => given_positions(call, positions).map(i => block_given(call#(i + 1))))
# `f {…}`, `f(a) {…}`, `f(a, {…})`, `f(a, body: {…})` with those blocks as lambdas
with_block_arguments(n: Node, positions: map): Node := {
	n = joined_block_call(children(n, part => with_block_arguments(part, positions)), positions)
	given = given_positions(n, positions)
	if #given == 0 then n else group_like(n, (1 to #n).map(i => if i - 1 in given then block_lambda_given(n#i) else n#i))
}
block_lambda_given(argument: Node): Node := if is_labeled(argument) then Key(key_of(argument), Op.Colon, block_lambda(value_of(argument))) else block_lambda(argument)

# the definitions of the linked modules' words the program mentions: what their parameters take, so that
# `matrix(2, 4, weight)` passes weight to a linked lib/matrix as it does to a matrix written in the program
linked_definitions(program: Node): list := {
	mentioned = {}
	for part in nodes_in(program) { if part is symbol { mentioned[name_of(part)] = yes } }
	found = []
	for image in module.linked_images {
		for slice in linked_signature(image.name).slices.filter(slice => mentioned.has(slice#1)) { found += statements_in(slice_tree(slice#3, slice#4)) }
	}
	found
}

# `square := it * it` as the definition `square(it) := it * it` it is, so `g = square` or `apply(square, 3)` passes it
# as a function value
explicit_definition(statement: Node): Node := {
	call = implicit_call(statement)
	if call == ø then statement else Key(call, Op.Define, value_of(statement))
}
# `twice := doubled`, `inc := add(1, _)`, `h := g` of such a g: a name defined as a function value, the definition
# `twice(x) := doubled(x)` it is, so a call, `map(twice)` and an alias of it work as the function's own (wiki function
# "Partial application"); each statement's arity known to those after it
aliased_definitions(statements: list, bound: map): list := {
	arities = {}
	aliased = []
	for statement in statements {
		lambda = if is_key(statement, Op.Define) and key_of(statement) is symbol then function_named(value_of(statement), arities, bound) else ø
		written = if lambda == ø then statement else lambda_definition(key_of(statement), lambda)
		parts = definition_of(written)
		if parts != ø { arities[parts.name] = #parts.parameters }
		aliased += [written]
	}
	aliased
}
# the lambda a definition's body names: a lambda as written, a function of the program by its name, a library word's
function_named(value: Node, arities: map, bound: map): Node? := {
	if is_lambda(value) { return lambda_of(value) }
	if not (value is symbol) { return ø }
	if arities.has(name_of(value)) { return if arities[name_of(value)] > 0 then lambda_calling(name_of(value), arities[name_of(value)]) else ø }
	library_word_value(name_of(value), bound)
}
# the definition `name(parameters) := result` of a lambda named so
lambda_definition(name: Node, lambda: Node): Node := Key(call_node(name, written_parameters(arrow_parameters(lambda))), Op.Define, arrow_result(lambda))
# `f = (a, b = 1) => a + b`, f written once, as the definition `f(a, b = 1) := a + b` it is, so a call leaving out b
# takes its default as a definition's does (a lambda is a definition, card lambda-own); a result type after its
# parentheses is dropped, as a lifted lambda's is (arrow_parameters)
defaulted_lambda_definition(statement: Node, statements: list): Node := {
	if not (is_key(statement, Op.Assign) and key_of(statement) is symbol and is_lambda(lambda_of(value_of(statement)))) { return statement }
	arrow = lambda_of(value_of(statement))
	if not written_parameters(arrow_parameters(arrow)).any(parameter => parameter_of(parameter).defaulted_to != ø) or writes_of(key_of(statement), statements) != 1 { return statement }
	lambda_definition(key_of(statement), arrow)
}
writes_of(name: Node, statements: list): int := #statements.flat_map(nodes_in).filter(n => n is key and op_of(n) in [Op.Assign, Op.AddAssign, Op.SubAssign] and key_of(n) == name)

# a global or main-level variable named as one of the program's functions, `global marks = {}` beside
# `marks(n) := …`, in one file or two: the function's name read as a value is its closure, which takes no assignment,
# so the compile is refused naming each place the name is declared
refuse_variables_named_as_functions(main_statements: list, globals: map, arities: map) := {
	assigned = main_statements.filter(statement => is_key(statement, Op.Assign) and key_of(statement) is symbol).map(statement => name_of(key_of(statement)))
	for name in (globals.keys + assigned).filter(name => arities.has(name)) {
		places = written_places(name, used_source)
		raise written_word(name) + " is declared " + (if #places > 1 then "${#places} times, at " + and_listed(places) else "twice") + ": a variable and a function share the name; give one another name"
	}
}

# the functions of parameters each defaulted, `f(x = 3)`: a bare name calls them, passed for a function they are
# their closure (decision defaults-bare-call)
defaulted_functions(statements: list): map := {
	defaulted = {}
	for statement in statements {
		parts = definition_of(statement)
		if parts != ø and #parts.parameters > 0 and parts.parameters.all(p => parameter_of(p).defaulted_to != ø) { defaulted[parts.name] = yes }
	}
	defaulted
}
lambdas(program: Node): Node := {
	given = statements_in(program)
	statements = aliased_definitions(given.map(statement => defaulted_lambda_definition(explicit_definition(statement), given)), names_bound_in(program))
	positions = function_positions_of(statements + linked_definitions(program))
	written = statements.map(statement => with_function_parameters(celled_definition(statement, positions)))
	main_statements = written.filter(statement => definition_of(statement) == ø)
	read_by_functions = written.flat_map(statement => read_from_outside(statement))
	written = written.filter(statement => definition_of(statement) != ø) + celled_scope(main_statements, [], positions, read_by_functions)
	arities = {}
	for statement in written {
		parts = definition_of(statement)
		if parts != ø { arities[parts.name] = #parts.parameters }
	}
	lowering = Lowering{arities: arities, bound: names_bound_in(program), lambdas_lifted: [], function_positions: positions, defaulted: defaulted_functions(written)}
	function_parameters = parameters_given_functions(written, arities, function_parameters_of(written), lowering.bound)
	lowering.callable_fields = callable_names_of(program, Op.Colon, arities, function_parameters, lowering.bound)
	lowering.function_values = callable_names_of(program, Op.Assign, arities, function_parameters, lowering.bound)
	# (a parameter declared `f: function` is no field)
	lowering.field_names = keyed_names(program, Op.Colon, n => value_of(n) != symbol("function"))
	# a parameter holding a function, declared so or given one, is called spaced too: `f x` as `f(x)`
	for name in function_parameters.keys { lowering.function_values[name] = yes }
	# a global is no lambda's capture: it reads and changes the one global, as a function does
	globals = global_variables(block_of(written))
	lowering.globals = globals
	# (those the main level declares: a `global results` within a function is that function's alone)
	lowering.main_globals = global_variables(block_of(written.filter(statement => definition_of(statement) == ø)))
	refuse_variables_named_as_functions(main_statements, globals, arities)
	top_locals = []
	for statement in written {
		if definition_of(statement) == ø { top_locals = names_bound(statement, top_locals) }
	}
	top_locals = top_locals.filter(name => name not in globals)
	main_names = word_set(top_locals)
	seen_by_functions = word_set(top_locals.filter(name => name not in arities))
	lowered = written.map(statement => lowered_statement(statement, main_names, seen_by_functions, lowering))
	if is_statement_sequence(program) { return group_like(program, lowering.lambdas_lifted + lowered) }
	if #lowering.lambdas_lifted == 0 { return lowered#1 }
	List(lowering.lambdas_lifted + lowered, Bracket.None, Separator.Semicolon)
}
