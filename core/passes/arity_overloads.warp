# Definitions of one name with different parameter counts (card pure-lane-merges):
# `twice(n) := …` and `twice(a, b) := …` are the functions twice·1 and twice·2,
# and every call names the one its argument count fits, `x.twice(y)` counting its receiver; passed as a value,
# `bottom_up(n, twice)`, it is the one the called function calls that parameter with. Definitions of one count stay
# one function, whose clauses extensions/function_clauses.warp merges, unless their parameter types tell them apart (typed_overloads).
use "walk.warp"
use "../analysis/diagnostics.warp"
use "../parsing/phrase_blocks.warp"
use "scope.warp"
use "../analysis/signatures.warp"
use "../analysis/builtin_signatures.warp"
use "../analysis/words.warp"
use "classes.warp"
use "definitions.warp"

# the call `f(a, b)` a definition's target names: `f(a, b)`, `f(a, b): T`, `f(a, b) as T`; ø for another target
target_call(target: Node): Node := match target {
	Key(head, op, result): { if op == Op.Colon or op == Op.As then target_call(head) else ø }
	List(call, Bracket.Round, Separator.None): { if #call > 0 and is_name(call#1) then target else ø }
	_: ø
}

# the call a definition `f(a, b) := body` names, ø for anything else
definition_call(n: Node): Node := match n {
	Key(target, op, body): { if op == Op.Define then target_call(target) else ø }
	_: ø
}

# [how many arguments a call must pass, how many it may, -1 for any more]: `b = 1` may be left out, `more...` hold none
arity_of(call: Node): list := {
	signature = signature_of(items_of(call))
	span = arity(signature)
	if signature.parameters.any(parameter => parameter.rest) then [span#1 - 1, -1] else span
}
span_takes(span: list, count: int): bool := span#1 <= count and (span#2 < 0 or count <= span#2)

# name → its arities, for each name defined with several parameter counts, no two of them the same
overloaded_arities(program: Node): map := {
	arities = {}
	for n in nodes_in(program) {
		call = definition_call(n)
		if call != ø {
			name = name_of(call#1)
			span = arity_of(call)
			if name not in arities { arities[name] = [] }
			if not (span in arities[name]) { arities[name] = arities[name] + [span] }
		}
	}
	overloaded = {}
	for name in arities.keys {
		if #arities[name] > 1 and all_distinct(arities[name].map(span => span#2)) { overloaded[name] = arities[name] }
	}
	overloaded
}



# the definition's target naming its variant: `twice(a, b): int` as `twice·2(a, b): int`
renamed_target(target: Node, name: text): Node := match target {
	Key(head, op, result): Key(renamed_target(head, name), op, result)
	_: group_like(target, [symbol(name)] + items_of(target)[1 ..])
}

# `f(a, b)` or the words side by side, `play C4`
is_call_form(n: Node): bool := is_group(n) and ((bracket_of(n) == "(" and separator_of(n) == "") or (bracket_of(n) == "" and separator_of(n) == " "))
# the call naming the variant that takes its arguments, `receivers` of them before the dot; the call itself when its
# name is not overloaded or no single variant takes them
variant_call(n: Node, overloaded: map, receivers: int): Node := {
	if not (is_call_form(n) and #n > 0 and n#1 is symbol) { return n }
	name = name_of(n#1)
	if name not in overloaded { return n }
	count = #n - 1 + receivers
	fitting = overloaded[name].filter(span => span_takes(span, count))
	if #fitting != 1 { return n }
	group_like(n, [symbol(overload_variant_name(name, fitting#1#2))] + items_of(n)[1 ..])
}

# how many arguments `body` calls `parameter` with: 1 of `f(x)`; ø when its calls differ or there are none
called_count(body: Node, parameter: text): int? := {
	counts = []
	for n in nodes_in(body) {
		if is_group(n) and bracket_of(n) == "(" and separator_of(n) == "" and #n > 0 and n#1 == symbol(parameter) and not (#n - 1 in counts) { counts += [#n - 1] }
	}
	if #counts == 1 then counts#1 else ø
}

# how many arguments a function passed on is called with: 1 of `apply(f, x)` when apply calls f(x)
passed_on_count(body: Node, parameter: text, called: map): int? := {
	for n in nodes_in(body) {
		if is_group(n) and bracket_of(n) == "(" and #n > 1 and n#1 is symbol {
			for at in 2 to #n {
				if n#at == symbol(parameter) and parameter_key(name_of(n#1), at - 1) in called { return called[parameter_key(name_of(n#1), at - 1)] }
			}
		}
	}
	ø
}

# function·index → how many arguments the function calls that parameter with, also by passing it on
called_parameters(program: Node): map := {
	definitions = nodes_in(program).filter(n => definition_call(n) != ø)
	called = {}
	for n in definitions { called = remember_calls(n, called, (body, name) => called_count(body, name)) }
	known = -1
	while #called != known {
		known = #called
		for n in definitions { called = remember_calls(n, called, (body, name) => passed_on_count(body, name, called)) }
	}
	called
}

# `called` with the counts `counted_in(body, name)` gives the definition's parameters that have none yet
remember_calls(n: Node, called: map, counted_in: function): map := {
	call = definition_call(n)
	parameters = items_of(call)[1 ..]
	for index in 1 to #parameters {
		name = binding_name(parameters#index)
		key = parameter_key(name_of(call#1), index)
		if name != ø and key not in called {
			found = counted_in(value_of(n), name)
			if found != ø { called[key] = found }
		}
	}
	called
}

overloaded_phrase(n: Node, overloaded: map): Node := if is_curly_group(n) and #n > 1 and n#1 is symbol and name_of(n#1) in overloaded then phrase_block(n) else n
# top-down, so a definition is renamed by its own parameters and a method call counts its receiver
resolved(n: Node, overloaded: map): Node := {
	call = definition_call(n)
	if call != ø and name_of(call#1) in overloaded {
		return Key(renamed_target(key_of(n), overload_variant_name(name_of(call#1), arity_of(call)#2)), Op.Define, resolved(value_of(n), overloaded))
	}
	match n {
		Key(receiver, Op.Dot, method): Key(resolved(receiver, overloaded), Op.Dot, variant_call(children(method, x => resolved(x, overloaded)), overloaded, 1))
		# a one-line block calling an overloaded word, `{sum [1 2]}`, is its phrase, as typed_resolved reads it (card
		# prelude-word-in-block); a class's fields, `{name text}`, stay as they are
		_: children(variant_call(overloaded_phrase(n, overloaded), overloaded, 0), x => resolved(x, overloaded))
	}
}

arity_overloads(program: Node): Node := {
	program = result_overloads(program)
	overload_classes = declared_classes(program)
	overload_bases = declared_bases(program)
	defined_twice = defined_more_than_once(program)
	if #defined_twice > 0 { program = passed_lambdas(program, shadowed(defined_twice, names_bound(program, [])), called_parameters(program)) }
	overloaded = overloaded_arities(program)
	if #overloaded == 0 { return typed_overloads(program) }
	resolved_program = resolved(program, overloaded)
	refused_overload_values(resolved_program, without_bare_calls(overloaded), program)
	typed_overloads(resolved_program)
}

# A function defined more than once passed where the call says how many arguments it gets, `xs.map(quoted)` (map
# calls it with one) or `apply(scaled, 3)` (apply calls its f(x)), is the lambda calling it, `x => quoted(x)`, so each
# call takes the variant fitting it (decision function-redefinition-error, option A); a parameter or variable of the
# name is its own
passed_lambdas(n: Node, names: map, called: map): Node := {
	bound = bound_at(n)
	if #bound > 0 { names = shadowed(names, bound) }
	if #names == 0 { return n }
	match n {
		Key(receiver, Op.Dot, method): Key(passed_lambdas(receiver, names, called), Op.Dot, children(lambda_arguments(method, names, called, 1), x => passed_lambdas(x, names, called)))
		_: children(lambda_arguments(n, names, called, 0), x => passed_lambdas(x, names, called))
	}
}
# the call with each argument naming one of `names` the lambda of as many parameters as the callee calls it with;
# `receivers` arguments stand before the dot
lambda_arguments(call: Node, names: map, called: map, receivers: int): Node := {
	if not (is_group(call) and bracket_of(call) == "(" and #call > 1 and call#1 is symbol) { return call }
	callee = name_of(call#1)
	arguments = items_of(call)[1 ..]
	group_like(call, [call#1] + (1 to #arguments).map(index => lambda_argument(arguments#index, names, passed_count(callee, index + receivers, called))))
}
lambda_argument(argument: Node, names: map, count: int?): Node := if argument is symbol and names.has(name_of(argument)) and count != ø then lambda_calling(name_of(argument), count) else argument
lambda_calling(name: text, count: int): Node := {
	parameters = (1 to count).map(index => symbol("argument" + name_joiner + "${index}"))
	Key(if count == 1 then parameters#1 else List(parameters, Bracket.Round, Separator.Comma), Op.Arrow, call_of(name, parameters))
}
# how many arguments the callee calls its parameter at `index` with: its body's calls (called_parameters), or the
# parameter's function type, `f: (any) -> any` of the library's map
passed_count(callee: text, index: int, called: map): int? := called.get(parameter_key(callee, index)) ?? declared_arity(unaliased(callee), index)
declared_arity(callee: text, index: int): int? := {
	for line in lines_of(typed_lines, callee) {
		if index <= #line.signature.parameters {
			count = function_type_arity(line.signature.parameters#index.type_name)
			if count != ø { return count }
		}
	}
	ø
}
# the functions the program defines more than once, by arity or by type
defined_more_than_once(program: Node): map := {
	counts = {}
	for n in nodes_in(program) {
		call = definition_call(n)
		if call != ø { counts[name_of(call#1)] = (counts.get(name_of(call#1)) ?? 0) + 1 }
	}
	twice = {}
	for name in counts.keys { if counts[name] > 1 { twice[name] = yes } }
	twice
}
# the names n binds for its parts: a definition's parameters and variables, a lambda's, a loop's
bound_at(n: Node): list := {
	call = definition_call(n)
	bound = if call != ø then items_of(call)[1 ..].map(parameter_name) + names_bound(value_of(n), []) else if is_key(n, Op.Arrow) then parameters_of(key_of(n)) + pattern_names(key_of(n)) + names_bound(value_of(n), []) else []
	bound + loop_variables(n)
}

# A function defined more than once named as a value, `xs.map(quoted)`, `g = quoted`: its definitions are variants by
# now and the name means none of them, refused naming them and the lambda that says which; inside a definition or a
# lambda, a parameter or variable of the name is its own (`sum = hi + lo`, `for tested in …`), at the top too
refused_overload_values(program: Node, overloaded: map, written: Node) := refuse_overload_values(program, shadowed(overloaded, names_bound(program, [])), written)
refuse_overload_values(n: Node, overloaded: map, written: Node) := {
	bound = bound_at(n)
	if #bound > 0 { overloaded = shadowed(overloaded, bound) }
	if #overloaded == 0 { return ø }
	for part in value_parts(n) {
		if part is symbol and overloaded.has(name_of(part)) { raise overload_value_refusal(name_of(part), defined_heads(written, name_of(part)), part) }
	}
	for part in parts_of(n) { refuse_overload_values(part, overloaded, written) }
	ø
}
# a name defined with no parameters too, `f() := 3; f(x) := x`, or a builtin word taking none, the host's `random`, is
# that one's call where it stands bare (`f + 1`, `random < 1`), never refused
without_bare_calls(overloaded: map): map := without_keys(overloaded, overloaded.keys.filter(name => overloaded[name].any(span => span#1 == 0) or builtin_takes_nothing(name)))
builtin_takes_nothing(name: text): bool := lines_of(typed_lines + foreign_math_lines, unaliased(name)).any(line => #line.signature.parameters == 0) or (host_words().has(name) and #host_words()[name]#1 == 0)
# the parts of n where a value is demanded: the bare name assigned, `g = twice`, an argument of a call no call fixes
# the arity of (passed_lambdas took the others), an element of a list or a value of a map literal; a name anywhere
# else (a phrase, a `use`, a condition, the name `help(save)` asks about) is left alone
naming_words = ["help"]
value_parts(n: Node): list := match n {
	Key(left, Op.Assign, right): [right]
	Key(left, Op.Define, right): { if left is symbol then [right] else [] }
	List(items, Bracket.Round, Separator.None): { if items#1 is symbol and name_of(items#1) in naming_words then [] else items[1 ..] }
	List(items, Bracket.Round, Separator.Comma): items
	List(items, Bracket.None, Separator.Comma): items
	List(items, Bracket.Square, separator): { if separator == Separator.Space then [] else items }
	List(items, Bracket.Curly, separator): { if separator == Separator.Space then [] else items.filter(item => is_key(item, Op.Colon)).map(value_of) }
	_: []
}
# `save is defined 2 times: save(made: Picture, as file) and save(file: text); …`, the definitions themselves (card
# help-shows-overloads)
overload_value_refusal(name: text, heads: list, at: Node): text := written_word(name) + " is defined " + "${#heads}" + " times: " + and_listed(heads) + "; pass a lambda that calls the one you mean, e.g. x => " + written_word(name) + "(x)" + place_text(written_at(at), "")
# the heads of the program's definitions of name as written, before the variants renamed them, in the order written
# (nodes_in pops siblings last first)
defined_heads(program: Node, name: text): list := nodes_in(program).map(definition_call).filter(call => call != ø and name_of(call#1) == name).map(head_written).reverse()
head_written(call: Node): text := written_word(name_of(call#1)) + "(" + items_of(call)[1 ..].map(parameter => "${parameter}").join(", ") + ")"
# `a`, `a and b`, `a, b and c`
and_listed(words: list): text := if #words < 2 then words.join("") else words[0 ..< #words - 1].join(", ") + " and " + words.last

# --- by parameter types (card pure-lane-refuses) ---
# `f(a: int) := 1; f(a: text) := 2` are the variants f·int and f·text, in a program or across the files it uses; a
# call takes the variant its arguments fit best (an exact type before an int widened to a float, any last), and where
# only the run time knows an argument's type, the first variant whose test it passes

# how well a value fits `any`: worse than every typed fit; a list of known elements fits a plain `list` worse than a
# list of its elements
any_fit = 100
list_fit = 2
# the kind each type word an overload tells apart stands for
overload_kinds = {int: "int", integer: "int", long: "int", i64: "int", i32: "int", float: "float", double: "float",
	f64: "float", f32: "float", number: "number", text: "text", str: "text", string: "text",
	codepoint: "codepoint", char: "codepoint", character: "codepoint", bool: "bool", boolean: "bool", function: "function",
	block: "function"}

# the program's classes, whose plurals are list types too (`xs: notes` of `class note`)
global overload_classes = []
# the element type of a list type: int of `[int]`, `ints`, `notes`, `list of int`; ø of another type
element_of(type: text): text? := {
	if type.starts_with("[") { return type.replace("[", "").replace("]", "").trim() }
	if type.starts_with("list of ") { return type.replace("list of ", "") }
	singular = type[0 ..< #type - 1]
	if type.ends_with("s") and (singular in overload_kinds or singular in overload_classes) then singular else ø
}

# the kind of value a parameter type takes: list, map or one of overload_kinds; ø of `any` and of another type
overload_kind(type: text): text? := {
	if type == "list" or element_of(type) != ø { return "list" }
	# `(samples, float) -> any`: a function
	if ["->", "=>", "→"].any(arrow => type.contains(arrow)) { return "function" }
	if type == "map" { return "map" }
	if type in overload_kinds then overload_kinds[type] else ø
}

# also a class the program declares, `x: Real`, which the run time tells by `is`
is_overload_type(type: text, classes: list): bool := type == any_word or overload_kind(type) != ø or type in classes or (is_union(type) and union_members(type).all(member => is_overload_type(member, classes)))
declared_classes(program: Node): list := statements_in(program).map(class_view).filter(view => view != ø).map(view => declared_type_name(view#2))
# class → the class it extends ("" of none), of the program's classes
global overload_bases = {}
declared_bases(program: Node): map := {
	bases = {}
	for view in statements_in(program).map(class_view).filter(view => view != ø) { bases[declared_type_name(view#2)] = base_of(view#2) }
	bases
}
# how many classes a type's class extends, 0 of a type no class of the program
variant_class_depth(type: text): int := if type in overload_bases and overload_bases[type] != "" then 1 + variant_class_depth(overload_bases[type]) else 0
variant_depth(types: list): int := types.map(variant_class_depth).fold(0, (total, depth) => total + depth)
# `speak(d: Dog)` before `speak(a: Animal)` of `class Dog extends Animal`: a subclass's variant is tested first, as
# the base's test passes for its instances too; else in the order given
deeper_classes_first(candidates: list): list := {
	ordered = []
	for types in candidates {
		insert_at = #ordered.filter(other => variant_depth(other) >= variant_depth(types))
		ordered = ordered[0..<insert_at] + [types] + ordered[insert_at..]
	}
	ordered
}
# how many classes up from the kind's class the type is, 0 of the class itself, ø of a kind that is no instance of it
class_distance(kind: text, type: text): int? := {
	if kind == type { return 0 }
	if not (kind in overload_bases) or overload_bases[kind] == "" { return ø }
	above = class_distance(overload_bases[kind], type)
	if above == ø then ø else above + 1
}

# `x: int` → "int", an untyped parameter "any"; a definition taking a pattern apart, `len([h, t...])`, is a clause of
# extensions/function_clauses.warp, no overload (card pattern-clause-refusal)
parameter_types(call: Node): list := {
	if items_of(call)[1..].any(is_list_pattern) { return [pattern_type] }
	signature_of(items_of(call)).parameters.map(p => if p.type_name == "" then any_word else p.type_name)
}
pattern_type = "pattern"
is_list_pattern(written: Node): bool := is_empty_list(written) or (is_group(written) and bracket_of(written) == "[")

# `f·list_of_int·text`: one word
typed_variant(name: text, types: list): text := name + types.map(t => "·" + (if element_of(t) != ø then "list_of_" + element_of(t) else union_members(t).join("_or_"))).join("")

# name → the parameter types of each of its definitions, for each name defined with several, all different, all of
# the types above and some typed (a class's parameters dispatch through its methods instead)
overloaded_types(program: Node): map := {
	classes = declared_classes(program)
	signatures = defined_types(program)
	for name in signatures.keys { signatures[name] = signatures[name] + library_variants(name, signatures[name]) }
	overloaded = {}
	for name in signatures.keys {
		variants = signatures[name]
		typed = variants.any(types => types.any(t => t != any_word))
		if #variants > 1 and typed and all_distinct(variants) and variants.all(types => types.all(type => is_overload_type(type, classes))) { overloaded[name] = variants }
	}
	overloaded
}

# name → the calls its definitions name, `f(a, b)` of `f(a, b) := …`, in declaration order
definitions_named(program: Node): map := {
	named = {}
	# nodes_in walks the last part first: reversed, the definitions come in declaration order
	for n in nodes_in(program).reverse() {
		call = definition_call(n)
		if call != ø {
			name = name_of(call#1)
			if name not in named { named[name] = [] }
			named[name] = named[name] + [call]
		}
	}
	named
}
# name → the parameter types of each of the program's definitions of it
defined_types(program: Node): map := {
	named = definitions_named(program)
	signatures = {}
	for name in named.keys { signatures[name] = named[name].map(call => parameter_types(call)) }
	signatures
}
# name → how many arguments each variant must be given, its parameters without a default (a library line's all)
variant_least(program: Node, overloaded: map): map := {
	named = definitions_named(program)
	least = {}
	for name in overloaded.keys {
		own = named[name].map(call => arity_of(call)#1)
		least[name] = own + overloaded[name][#own ..].map(types => #types)
	}
	least
}

# a library word the program defines for other types, `sin(x: Real) := …` beside math's `sin(x: float)`: the library's
# lines join its variants (decision sound-core-order), so a float still reaches the library's sin; an untyped
# definition, `add(a, b) := …`, `def clear(color)`, takes every type itself and shadows the word
library_variants(name: text, defined: list): list := {
	if not defined.all(own => own.any(type => type != any_word)) { return [] }
	written = if word_lines().has(name) then word_lines()[name].map(line => line.signature.parameters.map(p => if p.type_name == "" then any_word else p.type_name)) else []
	joining = []
	# math declares sin twice, from warp and from 'm': one variant
	for types in written { if types not in defined and types not in joining and defined.any(own => #own == #types) { joining += [types] } }
	# a linked module's definition of as many parameters, all typed and of types the dispatch tells from the program's
	# (decision cross-module-overload): the prelude's log(x: number, base: number) beside a program's log(level: text,
	# parts: texts), each call reaching the body of its arguments' types (card program-own-log)
	# (only the program's own definitions: one a module brought is that module's word already)
	linked = if brought_names.has(name) then [] else linked_word_types(name)
	for types in linked {
		told = defined.filter(own => #own == #types)
		if #told > 0 and any_word not in types and told.all(own => told_apart(own, types, [])) and types not in joining { joining += [types] }
	}
	joining
}
# the parameter types of each linked module's definition of the name
linked_word_types(name: text): list := {
	found = []
	# (a program's definitions only: a module being built joins its uses' words as prelude_words.warp brings them; and
	# only a word linked under its own name, which a variant's call reaches: the prelude's find is linked as its typed
	# variants find·text·text…, which the program declares none of, so a program's find(a: int, b: int) is its own)
	if building_a_module() or not module.linked_words.has(name) { return found }
	for image in module.linked_images {
		signature = linked_signature(image.name)
		if signature == ø { continue }
		for slice in signature.slices.filter(slice => slice#1 == name) {
			for statement in statements_in(unpack(slice#3)) {
				call = definition_call(statement)
				if call != ø { found += [parameter_types(call)] }
			}
		}
	}
	found
}
# `sin·float(value·1: float) := sin(value·1)`: a library line as a variant, the call of the library's word
library_variant(name: text, types: list): Node := {
	values = (1 to #types).map(at => symbol("value·" + at))
	parameters = (1 to #types).map(at => Key(values#at, Op.Colon, symbol(types#at)))
	Key(call_of(typed_variant(name, types), parameters), Op.Define, call_of(name, values))
}


# [kind, element kind or ø] of an argument whose type the compile knows, a literal; ø for one only the run time knows
static_kind(n: Node): list? := {
	if n is bool { return ["bool", ø] }
	if n is int { return ["int", ø] }
	if n is float { return ["float", ø] }
	if n is codepoint { return ["codepoint", ø] }
	if n is text { return ["text", ø] }
	if is_group(n) and bracket_of(n) == "[" { return ["list", element_kind(items_of(n))] }
	# `note(60)`: an instance of the program's class
	if is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in overload_classes { return [name_of(n#1), ø] }
	# a block, `3 times {…}`, is the function lambdas.warp makes of it
	if is_lambda(n) or is_block_argument(n) { return ["function", ø] }
	ø
}

# variable → the static_kind of the values assigned to it, [] where they differ: by name across the program,
# so an `xs` of other values in another function leaves both to the run-time test
assigned_kinds(program: Node): map := {
	kinds = {}
	for n in nodes_in(program) {
		if is_key(n, Op.Assign) and key_of(n) is symbol {
			name = name_of(key_of(n))
			kind = static_kind(value_of(n))
			kinds[name] = if kind == ø or (name in kinds and kinds[name] != kind) then [] else kind
		}
		# a parameter takes any value, whatever a variable of its name is given: the `e` of `e -> tan(e)` beside the
		# case `e = "e"` of keys.warp
		for name in parameters_bound(n) { kinds[name] = [] }
	}
	kinds
}
# the names a lambda or a definition binds as its parameters
parameters_bound(n: Node): list := {
	if is_key(n, Op.Arrow) { return parameters_of(key_of(n)) }
	call = definition_call(n)
	if call == ø then [] else items_of(call)[1 ..].map(parameter_name)
}

# what the compile knows of an argument's kind (card number-computed-float): a literal's, a variable's assigned
# values', the result a builtin declares (`floor(x)` a float), `-x`, `√x` and `a + b`, `a - b`, `a * b` of known numbers
# least: each overloaded name's variants' least argument counts (variant_least)
class ArgumentJudge { variables: map; own: map; least: map = {}; program: Node = Node.Empty }
keeps_numbers(op: Op): bool := match op {
	Op.Add: yes
	Op.Sub: yes
	Op.Mul: yes
	_: no
}
# `-x` and abs(x) (‖x‖) keep a number's kind, sqrt(x) (√x) a float's (any other root is exact, lib/reals.warp),
# cbrt(x) (∛x) gives a float
magnitude_kind(word: text, number: list?): list? := {
	if word == "abs" { return number }
	if word == "sqrt" { return if number != ø and number#1 == "float" then number else ø }
	if number != ø then ["float", ø] else ø
}
numeric_kinds = ["int", "float"]
known_kind(n: Node, judge: ArgumentJudge): list? := {
	# a name assigned is a variable, its kind known only when all its values agree: the `rest = value` of the prelude's
	# fits_text_cut beside text's Cursor.rest() is no function
	if n is symbol and name_of(n) in judge.variables { return if judge.variables[name_of(n)] then judge.variables[name_of(n)] else ø }
	# a function the program defines, passed by name (`play(hum, 2s)`): a function of its parameters' count; one of
	# none read bare is its call, `sin(π)` of a π() := Real(1, 1)
	if n is symbol and name_of(n) in judge.own and is_group(judge.own[name_of(n)]) and #judge.own[name_of(n)] > 1 { return ["function", #judge.own[name_of(n)] - 1] }
	# `(2)`, the operand of `sqrt(2)`, is 2
	if is_group(n) and bracket_of(n) == "(" and #n == 1 { return known_kind(n#1, judge) }
	if n is key and is_empty(key_of(n)) { return if op_of(n) == Op.Sub or op_of(n) == Op.Neg then numeric(known_kind(value_of(n), judge)) else ø }
	if is_group(n) and #n == 2 and n#1 is symbol and name_of(n#1) in magnitude_words and name_of(n#1) not in judge.own { return magnitude_kind(name_of(n#1), numeric(known_kind(n#2, judge))) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) not in judge.own { return declared_result(name_of(n#1), #n - 1) }
	if n is key and not is_empty(key_of(n)) and keeps_numbers(op_of(n)) { return joined_numbers(known_kind(key_of(n), judge), known_kind(value_of(n), judge)) }
	static_kind(n)
}
# the kind of a builtin's call by the one result type all its lines taking that many arguments declare
declared_result(word: text, count: int): list? := {
	results = lines_of(typed_lines + foreign_math_lines, unaliased(word)).filter(line => takes(line.signature, count)).map(line => line.signature.result)
	if #results == 0 or results.any(result => result != results#1) or argument_result(word) != ø or results#1 not in overload_kinds { return ø }
	[overload_kinds[results#1], ø]
}
numeric(kind: list?): list? := if kind != ø and kind#1 in numeric_kinds then kind else ø
# an int with an int stays an int, a float makes a float
joined_numbers(a: list?, b: list?): list? := {
	if numeric(a) == ø or numeric(b) == ø { return ø }
	[if a#1 == "float" or b#1 == "float" then "float" else "int", ø]
}

# the kind all the items share, ø when they differ, are lists or are not known
element_kind(items: list): text? := {
	if not items { return ø }
	kinds = items.map(static_kind)
	first = kinds#1
	if first != ø and first#1 != "list" and kinds.all(kind => kind == first) then first#1 else ø
}

# how well a value of `kind` fits a parameter of `type`: 0 exactly, 1 widened (an int to a float, a number to number,
# a codepoint to a text); ø when it does not
fit(kind: text, type: text): int? := {
	if type == any_word { return any_fit }
	if type in overload_classes { return class_distance(kind, type) }
	if type == "number" { return if kind == "int" or kind == "float" then 1 else ø }
	wanted = overload_kind(type)
	if kind == wanted { return 0 }
	if (kind == "int" and wanted == "float") or (kind == "codepoint" and wanted == "text") then 1 else ø
}

# how well a list of `element`s fits a parameter of `type`; a list of untold elements fits every list type
element_fit(element: text?, type: text): int? := {
	wanted = element_of(type)
	if wanted == ø {
		if type == any_word { return any_fit }
		if overload_kind(type) != "list" { return ø }
		return if element == ø then 0 else list_fit
	}
	if element == ø then 0 else fit(element, wanted)
}

# an argument the run time tells fits every type for now
argument_fit(kind: list?, type: text): int? := {
	if kind == ø { return 0 }
	# a union fits as well as its best fitting member (decision union-or)
	if is_union(type) { return union_members(type).map(member => argument_fit(kind, member)).filter(fits => fits != ø).fold(ø, (best, fits) => if best == ø or fits < best then fits else best) }
	if kind#1 == "function" and kind#2 != ø and function_type_arity(type) not in [ø, kind#2] { return ø }
	if kind#1 == "list" then element_fit(kind#2, type) else fit(kind#1, type)
}
# the parameters a function type names, 2 of `(samples, float) -> any`; ø of a type without them, `function`
function_type_arity(type: text): int? := {
	arrows = ["->", "=>", "→"].filter(arrow => type.contains(arrow))
	if #arrows == 0 { return ø }
	head = type.split(arrows#1)#1.trim()
	if head.starts_with("(") and head.ends_with(")") { head = head[1 ..< #head - 1].trim() }
	if head == "" then 0 else #outer_parts(head)
}

# the sum of the arguments' fits, ø when one does not fit
variant_fit(kinds: list, types: list): int? := {
	total = 0
	for at in 1 to #kinds {
		one = argument_fit(kinds#at, types#at)
		if one == ø { return ø }
		total += one
	}
	total
}

# `float` and `number` take any number, as fit() widens an int: at run time `1.5` may be exact
takes_widened(type: text): bool := type == "float" or type == "number"

# the run-time test of an argument for a parameter type; of a list type also of its first item, as a list keeps no
# item type at run time (an empty list fits every list type)
run_time_test(argument: Node, type: text): Node := {
	if is_union(type) { return union_members(type).map(member => run_time_test(argument, member)).fold(ø, (tests, test) => if tests == ø then test else Key(tests, Op.Or, test)) }
	element = element_of(type)
	# a class's variant takes its instances: `x is real` of any number (decision real-canonical) chooses no variant
	if element == ø and type in overload_classes { return call_of(HiddenWord.InstanceOf as text, [argument, type]) }
	if element == ø {
		word = if takes_widened(type) then "number" else if overload_kind(type) == "function" then "function" else type
		test = call_of("is_type", [argument, word])
		# an instance converting itself to a float takes a float or number variant: √2 picks f(x: float)
		return if word == "float" or word == "number" then Key(test, Op.Or, call_of(HiddenWord.FloatConvertible as text, [argument])) else test
	}
	no_items = Key(call_of("count", [argument]), Op.Eq, 0)
	first_item = run_time_test(Key(argument, Op.Hash, 1), element)
	Key(call_of("is_type", [argument, "list"]), Op.And, Key(no_items, Op.Or, first_item))
}

# the places of the arguments a variant tests at run time: those of untold kind it takes no `any` for
tested_places(kinds: list, types: list): list := (1 to #kinds).filter(at => kinds#at == ø and types#at != any_word)

# the candidates testing more arguments first, of those the one widening fewer first, else in declaration order; a
# narrower variant always before a wider one
in_test_order(candidates: list, kinds: list): list := {
	ordered = []
	for tested in (0 to #kinds).reverse() {
		for widened in 0 to #kinds {
			ordered += deeper_classes_first(candidates.filter(types => #tested_places(kinds, types) == tested and #tested_places(kinds, types).filter(at => takes_widened(types#at)) == widened))
		}
	}
	narrower_first(ordered)
}

# `f(g(), 1)`: `(overload·1 = g(); if is_type(overload·1, "text") then f·text·int(overload·1, 1) else if … else raise
# "… fits no single variant …")`, each argument evaluated once
dispatched(name: text, candidates: list, kinds: list, arguments: list, refusal: text): Node := {
	bindings = []
	passed = []
	values = []
	for at in 1 to #arguments {
		argument = arguments#at
		value = argument
		if kinds#at == ø and (argument is key or is_group(argument)) {
			# a named argument, `save sound as: "a.wav"`, holds its value and passes it by its name
			label = if is_key(argument, Op.Colon) and key_of(argument) is symbol then key_of(argument) else ø
			value = symbol("overload·" + at)
			bindings += [Key(value, Op.Assign, if label == ø then argument else value_of(argument))]
			argument = if label == ø then value else Key(label, Op.Colon, value)
		}
		passed += [argument]
		values += [value]
	}
	chain = call_of(raise_word, [refusal])
	for types in in_test_order(candidates, kinds).reverse() {
		variant = call_of(typed_variant(name, types), passed)
		tests = tested_places(kinds, types).map(at => run_time_test(values#at, types#at))
		chain = if not tests then variant else chosen(joined(tests), variant, chain)
	}
	if not bindings then chain else List(bindings + [chain], Bracket.Round, Separator.Semicolon)
}

# whether the other type admits every value this one admits, and more: text of `text or int`, Dog of Animal, any type of any
admits_less(narrow: text, wide: text): bool := narrow != wide and (wide == any_word or union_members(narrow).all(member => member in union_members(wide) or union_members(wide).any(type => class_distance(member, type) != ø)))
# a variant no wider than the other at any parameter and narrower at one: the one a call fitting both takes
narrower_variant(narrow: list, wide: list): bool := #narrow == #wide and (1 to #narrow).all(at => narrow#at == wide#at or admits_less(narrow#at, wide#at)) and (1 to #narrow).any(at => admits_less(narrow#at, wide#at))
# the variants, each before the first wider one, else in the order given: a run-time test passing both takes the
# narrower whatever order the definitions came in
narrower_first(variants: list): list := {
	placed = []
	for types in variants {
		wider = (1 to #placed).filter(at => narrower_variant(types, placed#at))
		placed = if #wider == 0 then placed + [types] else placed[0 ..< wider#1 - 1] + [types] + placed[wider#1 - 1 ..]
	}
	placed
}
# the variants the known arguments fit best, the narrowest of those that fit equally well
best_fitting(candidates: list, kinds: list): list := {
	best = candidates.filter(types => candidates.all(other => variant_fit(kinds, other) >= variant_fit(kinds, types)))
	best.filter(types => not best.any(other => narrower_variant(other, types)))
}
# the variants the known arguments fit better first, in declaration order among equals: a run-time test that passes
# both takes the better, `play(hum, 2s)` of a hum(block, t) the block filler, not play(tone, …)
best_first(candidates: list, kinds: list): list := {
	ordered = []
	left = candidates
	while #left > 0 {
		best = best_fitting(left, kinds)
		ordered += best
		left = left.filter(types => types not in best)
	}
	ordered
}
# `f(1.5)`, `f 1.5`: the call of the variant its arguments fit best; a call of a name not overloaded by type as it is
typed_call(n: Node, overloaded: map, judge: ArgumentJudge): Node := {
	n = glued_block_call(n, name => name in overloaded)
	if not (is_call_form(n) and #n > 1 and n#1 is symbol) { return n }
	name = name_of(n#1)
	if name not in overloaded { return n }
	arguments = items_of(n)[1 ..]
	# a call may leave out the defaulted parameters at the end, `lowpass(sig, 800)` of `lowpass(signal, frequency, q = 0.707)`
	least = judge.least[name]
	variants = (1 to #overloaded[name]).filter(at => least#at <= #arguments and #arguments <= #overloaded[name]#at).map(at => overloaded[name]#at)
	kinds = arguments.map(argument => known_kind(argument, judge))
	fitting = variants.filter(types => variant_fit(kinds, types) != ø)
	written = "${n}"
	listed = overloaded[name].map(types => name + "(" + types.join(", ") + ")").join(", ")
	if not kinds.all(kind => kind != ø) and #fitting > 1 {
		return dispatched(name, best_first(fitting, kinds), kinds, arguments, "`" + written + "` fits no single variant of " + listed)
	}
	if not fitting { return diagnose(call_of("no_single_variant", [written, listed]), n) }
	chosen = best_fitting(fitting, kinds)
	if #chosen != 1 { return diagnose(call_of("tied_variants", [written, listed]), n) }
	call_of(typed_variant(name, chosen#1), arguments)
}

# top-down, so a definition is renamed by its own parameter types
typed_resolved(n: Node, overloaded: map, judge: ArgumentJudge): Node := {
	call = definition_call(n)
	if call != ø {
		head = if name_of(call#1) in overloaded then renamed_target(key_of(n), typed_variant(name_of(call#1), parameter_types(call))) else key_of(n)
		return Key(head, Op.Define, typed_resolved(value_of(n), shadowed(overloaded, items_of(call)[1 ..].map(parameter_name)), judge))
	}
	if is_key(n, Op.Arrow) { return Key(key_of(n), Op.Arrow, typed_resolved(value_of(n), shadowed(overloaded, parameters_of(key_of(n))), judge)) }
	# a method call `xs.find(f)` is the call find(xs, f), its receiver the first argument; a module's word called through
	# its name, `memory.copy(bytes, at)`, the word's own call, copy(bytes, at)
	method = if is_key(n, Op.Dot) then value_of(n) else ø
	if method != ø and is_group(method) and bracket_of(method) == "(" and #method > 0 and method#1 is symbol and name_of(method#1) in overloaded {
		receiver = key_of(n)
		receivers = if receiver is symbol and qualifies_by_module(name_of(receiver), judge.program) then [] else [receiver]
		return typed_resolved(group_like(method, [method#1] + receivers + items_of(method)[1 ..]), overloaded, judge)
	}
	# a one-line block's words are its phrase already, `{ thrice {n += 1} }` (phrase_blocks.warp)
	children(typed_call(phrase_block(n), overloaded, judge), x => typed_resolved(x, overloaded, judge))
}

# inside a definition or a lambda its parameters are its own, never an overloaded function of their name: the prelude's
# `f(item)` of map(xs, f) calls its f, `find => find(a, b)` its find, not the program's or a library's variants
shadowed(overloaded: map, parameters: list): map := if parameters.any(name => name in overloaded) then without_keys(overloaded, parameters) else overloaded
typed_overloads(program: Node): Node := {
	overloaded = overloaded_types(program)
	if #overloaded == 0 { return program }
	resolved = typed_resolved(program, overloaded, ArgumentJudge(assigned_kinds(program), own_heads(program), variant_least(program, overloaded), program))
	refused_overload_values(resolved, overloaded, program)
	# after the resolving, so a library variant's own call stays the library's
	defined = defined_types(program)
	variants = overloaded.keys.flat_map(name => library_variants(name, defined[name]).map(types => library_variant(name, types)))
	if #variants == 0 then resolved else separated(bracketed(statements_in(resolved) + variants, ""), ";")
}

# --- by result type (decision cleanup-cuts; notes/dispatch.md "Dispatch on return type") ---
# `to render text as pdf: …` beside `to render text as docx: …` are the variants render·pdf and render·docx, each
# declaring its result; a call takes the one its expected type names, `(render "x") as pdf`, `docx d = render "x"`,
# `d: docx = render "x"`, an argument for a parameter declared docx; any other call the first declared, with a warning
# naming the explicit form

# `pdf` of `f(t) as pdf := …` and `f(t): pdf := …`, which definitions.warp holds as `{the result: pdf = …; the result}`;
# ø of a definition declaring no result
written_result(n: Node): text? := {
	held = held_result(n)
	if definition_call(n) != ø and held is symbol then required_type(name_of(held)) else ø
}

# name → the result types of its definitions in declaration order, for each name defined with several, all written
# and all different, all taking the same parameters (parameter types tell `f(x: int): int` and `f(x: float): float` apart)
overloaded_results(program: Node): map := {
	results = {}
	taken = {}
	for n in nodes_in(program).reverse() {
		call = definition_call(n)
		if call != ø {
			name = name_of(call#1)
			if name not in results {
				results[name] = []
				taken[name] = []
			}
			results[name] = results[name] + [written_result(n)]
			taken[name] = taken[name] + [parameter_types(call)]
		}
	}
	overloaded = {}
	for name in results.keys {
		if #results[name] > 1 and results[name].all(type => type != ø) and all_distinct(results[name]) and taken[name].all(types => types == taken[name]#1) { overloaded[name] = results[name] }
	}
	overloaded
}

result_variant(name: text, type: text): text := name + "·" + type

# the call `(f x)` or `f x` of an overloaded f, ø of another node
overloaded_call(n: Node, overloaded: map): Node? := {
	call = if is_round(n) and #n == 1 then n#1 else if is_round(n) and separator_of(n) == " " then List(items_of(n), Bracket.None, Separator.Space) else n
	if is_call_form(call) and #call > 0 and call#1 is symbol and name_of(call#1) in overloaded then call else ø
}

# the call of f's variant returning `type`; n itself when it calls no overloaded f or none of f's returns it
returning(n: Node, type: any, overloaded: map): Node := {
	call = overloaded_call(n, overloaded)
	if call == ø or not (type is symbol) or not (name_of(type) in overloaded[name_of(call#1)]) { return n }
	group_like(call, [symbol(result_variant(name_of(call#1), name_of(type)))] + items_of(call)[1 ..])
}

# the type an assignment's target declares: docx of `d: docx`; ø of another target
declared_type(target: Node): Node? := if is_key(target, Op.Colon) then value_of(target) else ø

# the call `g(a, b)` with each argument for a parameter g's one definition declares a type of that type's variant
for_parameters(n: Node, overloaded: map, parameters: map): Node := {
	if not (is_call_form(n) and #n > 1 and n#1 is symbol and name_of(n#1) in parameters and #parameters[name_of(n#1)] == 1) { return n }
	types = parameters[name_of(n#1)]#1
	if #types != #n - 1 { return n }
	group_like(n, [n#1] + (1 to #types).map(at => returning(n#(at + 1), symbol(types#at), overloaded)))
}

# top-down: each definition renamed to its variant, each call to the variant its expected type names
result_resolved(n: Node, overloaded: map, parameters: map): Node := {
	call = definition_call(n)
	if call != ø {
		name = name_of(call#1)
		target = if name in overloaded then renamed_target(key_of(n), result_variant(name, written_result(n))) else key_of(n)
		return Key(target, Op.Define, result_resolved(value_of(n), overloaded, parameters))
	}
	if is_key(n, Op.As) and overloaded_call(key_of(n), overloaded) != ø and returning(key_of(n), value_of(n), overloaded) != key_of(n) {
		return result_resolved(returning(key_of(n), value_of(n), overloaded), overloaded, parameters)
	}
	if is_key(n, Op.Assign) and declared_type(key_of(n)) != ø {
		n = Key(key_of(n), Op.Assign, returning(value_of(n), declared_type(key_of(n)), overloaded))
	}
	# `docx d = render "x"`, which the parser reads as `docx (d = render "x")`
	if is_group(n) and bracket_of(n) == "" and #n == 2 and n#1 is symbol and is_key(n#2, Op.Assign) {
		n = group_like(n, [n#1, Key(key_of(n#2), Op.Assign, returning(value_of(n#2), n#1, overloaded))])
	}
	n = for_parameters(n, overloaded, parameters)
	untold = overloaded_call(n, overloaded)
	if untold != ø and untold == n {
		name = name_of(n#1)
		taken = overloaded[name]#1
		diagnose(call_of("result_variant_taken", [name, overloaded[name].join(", "), taken, "${n}"]), n)
		n = returning(n, symbol(taken), overloaded)
	}
	children(n, x => result_resolved(x, overloaded, parameters))
}

result_overloads(program: Node): Node := {
	overloaded = overloaded_results(program)
	parameters = defined_types(program)
	result_resolved(program, overloaded, parameters)
}
