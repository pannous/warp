# `rewrite PATTERN => TEMPLATE` (cards compiler-modules, pure-rewrite): code extending the compiler. A pattern's holes
# `$a` and `$xs...` bind as in a code pattern of a match, the template splices them in. `where $c = channel()` holds
# where the hole binds a variable assigned code of that shape, or a parameter of a function called with one; `$x: text`
# (also symbol, list, block, map, int, number) only code of that kind, a block code in braces and a map their
# entries `{a: 1}` or a name holding only maps. More conditions follow `where`, joined by `and`:
# `$t is type` (a type word no value is named), `$x is unbound` (a word the program binds nothing to), `$x is value`,
# `$f is function`, `$h is varying` (a value definition reading a variable, lib/sugar/heads.warp), `$d is definition` (a
# function's, `f(x) := …`), `$x is literal`, `$w is label` (a word labelling a parameter, `with new`), `$x is missing` (ø,
# also an operand not written: `rest...`), `$x is text` (a hole kind), each also `is not`, `$n < 0` (a number literal
# compared, also > <= >= == !=), `$f takes value` (f's first parameter is typed, not yes/no: of a function of the
# program or a typed library word), `$f takes int` (typed int), `$f takes number` (typed a number: int, float…), `$x is
# vector` (code that may give a list: lib/sugar/broadcasting.warp) and `$f takes one` (a library word the program leaves
# free, of exactly one typed value); `$e is enum` (a name or text of an enum the program declares), `$c is case` (a
# case of the one enum declaring it) and `$c is case of $e` (of the enum $e names; $e unbound, the condition binds it
# to that enum), whose cases `cases of $e` lists among a template's items. A place word among them, `statement`, `condition`
# (of an if or while), `member` (of a class body), `key` or `value` (of `k: v`), `parameter` (of a definition's head,
# F10), lets the rule rewrite code only
# standing there: `rewrite $s except_if $c => if not $c then $s where statement`. The mark `alias` says the
# pattern's first word is another spelling of the template's, which each firing notes as Rust's note_alias does ("warp
# says for", until "got it"): `rewrite each $xs $body => for $xs $body where statement and alias`. A phrase pattern
# (`$n beat`) matches each run of those words in a longer phrase (of `x = 2 beats`, which the parser keeps as `(x = 2) beats`, the value), a statement
# pattern also a block of just that statement, and a template of several statements `($a; $b)` takes the statement's
# place. Rules go bottom-up, children first, each node rewritten once. A program's own rules apply to it; a standard
# module's rules apply to every program mentioning their words but binding none itself, and one that fires brings its
# module along with `use` (lib/channels.warp, lib/english.warp). A template's hole the pattern doesn't bind is a fresh
# name each firing (`$t` → `t·3`, a compiler temporary no program can write), so `rewrite $a ?: $b => ($t = $a; if $t
# then $t else $b)` computes a once; a pattern of statements `($a; $b)` matches a run of them in a block; a rule's result is rewritten again until no rule fires; `T for $x in $xs...` splices T once for each item of a rest hole; a template of statements in a value's place is that value's block; `·` glues
# words and holes into a name (`square·$a`, `$i·end`, F5). What the
# template adds sits where the rewritten code was written, so errors point at the user's code (notes/rewrites.md).
# Rust twin: rust-harness:src/modules/rewrites.rs lower
use "walk.warp"
use "scope.warp"
use "uses.warp"
use "prelude_words.warp"
use "../analysis/type_tests.warp"
use "../analysis/diagnostics.warp"
use "../analysis/builtin_signatures.warp"
use "enum_declarations.warp"
use "../analysis/words.warp"
use rule_words

rewrite_word = "rewrite"
where_word = "where"
rule_hole_mark = "$"
# the characters of a word in a rule's text besides letters and digits
rule_word_marks = "_$"
# the kinds a typed hole `$x: text` names
hole_kinds = ["text", "symbol", "list", "block", "map", "int", "number"]
# what `where $x is …` asks of the code a hole binds, besides a hole kind
code_properties = ["type", "unbound", "value", "function", "literal", "enum", "missing", "label", "varying", "definition", "function_block", "instance", "vector"]
# `where not method`, `where not shadowed`: conditions about where the matched code stands, asked of the word it starts
# with (card engine-rule-conditions)
context_words = ["method", "shadowed"]
# `where $f is in [add, push]`: the hole bound one of the words listed
listed_word = "in"
# `cases of $e` in a template: the cases of the enum the hole names, among the items there (F9)
cases_words = ["cases", "of"]
# `where $n < 0`: the comparisons of a number literal
literal_comparisons = [Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.Eq, Op.Ne]
and_word = "and"
# how many times a rule's result may be rewritten again in a row before the rules count as a loop (F7)
rewrite_depth_limit = 64
# `square·$a` in a template: `·` glues words and holes into one name (F5, decision name-glue), joined by name_joint;
# the parser reads it as `*`, so the rule's text tells the two apart, and the parts wait in a glue_marker group
glue_mark = "·"
glue_marker = HiddenWord.GlueName as text
name_joint = "_"
# `loop··step`: `··` glues with the mark itself, a hidden compiler name (notes/compiler_temporaries.md) no program can
# write; the parser reads it as the call operator_··(loop, step), whose parts wait beside hidden_joint in the glue
hidden_glue = "··"
hidden_joint = HiddenWord.GlueHidden as text
# `T for $x in $xs...` in a template: T once for each item of the rest hole (F4)
each_word = "for"
each_in_word = "in"
# `T for $x at $i in $xs...`: $i the item's position, from 1
each_at_word = "at"
# the places a rule may ask for (F1), each written as a bare word among the `where` conditions (`key` and `value` of
# `k: v` the PairKey and PairValue); Anywhere a rule asking none
enum Place { Anywhere, Statement, Condition, Member, PairKey, PairValue, Parameter, Element, Program }
PLACE_WORDS = {"statement": Place.Statement, "condition": Place.Condition, "member": Place.Member, "key": Place.PairKey, "value": Place.PairValue, "parameter": Place.Parameter, "element": Place.Element, "program": Place.Program}
# the mark of a rule whose pattern's first word spells the template's another way
alias_mark = "alias"
takes_word = "takes"
# `where $f takes value`: any first parameter typed, except these
yes_no_types = ["bool"]
value_word = "value"
# `where $f takes number`: a first parameter typed one of these
number_word = "number"
numeric_parameter_types = ["number", "int", "float", "i32", "i64", "f32", "f64", "u8", "u32", "Real"]
# `where $f takes one`: a library word the program leaves free whose first line takes exactly one typed value
one_word = "one"
# the sugar of the language (notes/layers.md), lib/sugar/<name>.warp: rewrite lines only, whose rules apply to every
# program as a standard module's do, bringing no `use` along; a rule of no word (`$a ?? $b`) applies everywhere.
# Four steps of the passes apply them (passes.warp): the first sugar before the passes that would read its forms as
# something else (library_calls takes `int[3]`, the subscript `int#4`, for a call of int), the sugar after those
# making or reading the forms its rules take, the iteration sugar lowering the `for` loops once loop_heads.warp read
# their heads, and the late sugar after it took the loops a range counts: a range left is a value (sugar/ranges)
# the compiler extensions (notes/agents/common.md: new capabilities, one file each in core/extensions/), applied
# with the first sugar, ahead of it: data_items reads the names in `[a, b]` before the later sugar steps could see them.
# A new extension adds its line here.
extension_module_names = [
	"compiler/extensions/tuples"
	"compiler/extensions/safe_navigation"
]
first_sugar_module_names = extension_module_names + ["sugar/lists", "sugar/arms", "sugar/heads", "sugar/test_words"]
# every other file of lib/sugar/ is sugar applied where the sugar pass stands: a new rule file needs no line here
sugar_folder = "sugar/"
placed_sugar_modules(): list := first_sugar_module_names + iteration_sugar_module_names + late_sugar_module_names + comprehension_sugar_module_names + declaration_sugar_module_names + early_sugar_module_names
sugar_module_names(): list := {
	placed = placed_sugar_modules()
	LIBRARY_FILES.keys.filter(path => path.starts_with(sugar_folder) and path.ends_with(module_extension)).map(path => path[0 ..< #path - #module_extension]).filter(name => name not in placed)
}
iteration_sugar_module_names = ["sugar/iteration"]
late_sugar_module_names = ["sugar/ranges", "sugar/method_calls"]
# the comprehension sugar, where the comprehensions pass ran: after phrase_blocks, before data_items marks the items of
# a list literal (card sugar-comprehensions)
comprehension_sugar_module_names = ["sugar/comprehensions"]
# the sugar of declarations (lib/sugar/declarations.warp): rules applied with the program's own, before every pass reads a definition
declaration_sugar_module_names = ["sugar/declarations"]
# the standard modules (Rust's STD_MODULES): those with `rewrite` lines lend their rules to the programs mentioning them
std_module_names = ["prelude", "memory", "net", "collections", "hash", "regex", "file", "json", "os", "shell", "list", "math", "fast_math", "text", "random", "map", "time", "matrix", "color", "keys", "draw", "compute_toys", "markup", "router", "wagi", "i18n", "units", "agent", "sound", "R", "PHP", "channels", "extrema", "english", "case_table", "case_tables", "uncertain", "wasmtime", "web", "storage", "frames", "signals"]
# the sugar modules whose rules rewrite the program before any pass, for forms no pass is to see: a function keyword
# or a declaration word before definitions.warp, also behind another language's modifier (`public static fun f() {3}`:
# sugar/declarations strips it, and the function keyword's rule rewrites the rest)
early_sugar_module_names = ["sugar/functions", "sugar/declarations", "sugar/events"]

# a rule: `where $hole = shape` its origin (ø both without one), `conditions` the other `where` conditions, `place`
# the one Place it rewrites only, else Anywhere, `module` the standard module declaring it, else ""; `whole` for a
# phrase pattern that matches only a whole phrase, not its runs; `alias` for a rule marked alias
class Rule { pattern: Node; template: Node; hole: Node; shape: Node; conditions: list; place: Place; module: text; whole: bool; alias: bool; head: text }

# the early sugar modules' rules once read (early_module_rules)
global early_rules_read = no
global early_rules = []
# the standard modules whose rules fired during a rewrite
global fired_modules = []
# the fresh names made so far, numbering each one
global fresh_names = 0
# how many results are being rewritten again right now, one inside the other
global rewrite_depth = 0
# the names the program being rewritten binds, which `where $x is type` and its kin ask
global rule_scope = {}
# function → the type of its first parameter, of the program being rewritten (`where $f takes value`)
global first_parameter_types = {}
# function → the signature of each of its definitions, of the program being rewritten (`where $f takes number`)
global rule_signatures = {}
# the names that hold a map, of the program being rewritten (`where $m is map`)
global rule_maps = {}
# name → the enum whose cases it holds, of the program being rewritten (`where $c is case of $e`)
global rule_case_holders = {}
# enum → its case names, of the program being rewritten (`where $c is case of $e`, `cases of $e`), read before
# plain_enums.warp lowers the declarations: by rewritten_program, and by the pass enums_declared for the sugar rules
global rule_enums = {}
# the names that hold only instances of the program's classes (`where $s is instance`)
global rule_instances = {}
# the program's classes, whose construction `Counter(3)` is an instance (`where $o is instance`)
global rule_classes = {}
# the program being rewritten, and its varying values (`where $h is varying`), worked out when a rule first asks
global rule_program = Node.Empty
# the text of the program being compiled, `$source` of a rule word: what its parse drops, the comment above a definition
global rule_source = ""
global rule_varying = {}
global rule_varying_known = no
# the program's names and functions that may give a list (`where $x is vector`), worked out when a rule first asks
global rule_vectors = []
global rule_vectors_known = no
# the definition whose statement the rules walk, "" at the main level: whose names `where $x is vector` asks of
global rule_vector_scope = ""
# where the node the rules try stands, for `where not method` and `where not shadowed`: the method part of the `.`
# being walked (the right of `x.f(…)`), else ø; the names the definitions around it bind
global rule_method_part = ø
global rule_binding = []
# the word whose definition the rules walk inside: a rule producing that word leaves its definition as written, so
# frames' `listen(data frame, …) => frame_listened(…)` never makes frame_listened call itself (card frame-self-rule)
global rule_defining = ""
# the code the rule being tried matched, for the context conditions; ø for a run of statements
global rule_matched = ø

# the program rewritten by its own rules and those of the standard modules it mentions, its own rules taken out, its
# stores assignments; `source` is the text the program was parsed from, which tells a template's `·` from `*`
rewritten_program(program: Node, source: text): Node := {
	rule_source = source
	stored(own_rules_applied(program, source))
}
own_rules_applied(program: Node, source: text): Node := {
	ruled = statements_ruled(statements_in(program), "", source)
	rules = ruled#1
	if #rules > 0 { program = separated(bracketed(ruled#2, ""), ";") }
	mentioned = word_set(symbol_words(program))
	module_rules = []
	needs = rule_needs_by_module()
	for module in std_module_names.filter(module => needs.has(module)) {
		if needs[module].split(" ").any(word => mentioned.has(word)) {
			# (a rule of the whole program, `where program`, comes with the module's others)
			module_rules += module_rules_of(std_module_path(module), module).filter(rule => rule.place == Place.Program or needed_words(rule).any(word => mentioned.has(word)))
		}
	}
	for module in declaration_sugar_module_names { module_rules += module_rules_of(std_module_path(module), "").filter(rule => mentioned.has(needed_word(rule))) }
	rules += unbound_rules(module_rules, program)
	if #rules == 0 { return program }
	rule_scope = scope_of(program)
	first_parameter_types = typed_first_parameters(program)
	rule_signatures = definitions_signatures(program)
	rule_enums = enums_in(program, {})
	rule_case_holders = case_holders_of(program)
	origins = rules.map(rule => if rule.shape == ø then {} else names_assigned_shape(program, rule.shape))
	fired_modules = []
	rule_program = program
	program = placed_map_scoped(program, n => rule_rewritten(n, rules, origins), map_names_of(program))
	program = with_program_rules(program, rules, origins)
	uses = []
	for module in fired_modules {
		statement = plain_node(parsed("use " + module))
		if statement not in uses { uses += [statement] }
	}
	if #uses == 0 then program else separated(bracketed(uses + statements_in(program), ""), ";")
}

# each plain store `x ← v` (the parser's store·value(x, v)) the assignment `x = v`, once the rules of a step ran: a
# rule's template stores without its own pattern taking the store for an assignment again (notify in lib/sugar/signals)
store_word = HiddenWord.StoredValue as text
stored(n: Node): Node := if mentions(n, store_word) then bottom_up(n, part => if is_store(part) then Key(part#2, Op.Assign, part#3) else part) else n
is_store(n: Node): bool := is_group(n) and bracket_of(n) == "(" and #n == 3 and n#1 == symbol(store_word)

# the program rewritten by the rules of its whole, `where program`, each once, after the rules inside it fired
# (`$program` their program): lib/web.warp's ending of a program with routes
with_program_rules(program: Node, rules: list, origins: list): Node := {
	for index in 0 ..< #rules {
		if rules[index].place == Place.Program {
			rule_program = program
			result = rule_applied(rules[index], origins[index], program)
			if result != ø { program = result }
		}
	}
	program
}

# `class Bag { max() := 7 }`: a type declaration; its method named like a library word binds that name in the class
# only (class_methods.warp routes the calls), so a sugar rule of it (lib/sugar/extremes.warp's max) still reaches the
# other values
is_type_declaration(statement: Node): bool := match statement {
	Key(left, op, right): left == opaque_symbol and kind_of(right) == "type"
	_: no
}

# the module rules none of whose words the program binds itself: a program's own word keeps its meaning
unbound_rules(module_rules: list, program: Node): list := if #module_rules == 0 then [] else rules_unbound_by(module_rules, rule_bindings(program))
# [the program's scope, its scope outside its type declarations]: the bindings unbound_rules reads, worked out once for
# all the sugar steps of a program (card speed-module-cache)
rule_bindings(program: Node): list := [scope_of(program), scope_with({}, statements_in(program).filter(statement => not is_type_declaration(statement)).flat_map(nodes_in))]
# (a class's method binds no word of the program: `in(u)` of a class keeps `for x in xs`)
rules_unbound_by(module_rules: list, bindings: list): list := module_rules.filter(rule => not literal_words(rule.pattern).any(word => binds_value(bindings#1, word) or binds_as(bindings#2, word, Meaning.Function)))

# the rules of the sugar modules that the program keeps, chosen by the program's own bindings (rule_bindings: a
# program's own `push` keeps its own), before the definitions it reaches from the prelude and the modules join it
sugar_rules(bindings: list, modules: list): list := rules_unbound_by(modules.flat_map(module => module_rules_of(std_module_path(module), "")), bindings)

# the program as it is, the enums it declares kept for the sugar rules: a pass right before plain_enums.warp lowers
# their declarations, after node_cases.warp declared node.warp's Op, Bracket and Separator for a program naming them
enums_declared(program: Node): Node := {
	rule_enums = enums_in(program, {})
	program
}

# the program with the sugar rules applied everywhere, the definitions it reached from the prelude and the modules too,
# its stores assignments; the rules of a place apply only there
sugared(program: Node, rules: list): Node := stored(sugar_applied(program, rules))
sugar_applied(program: Node, rules: list): Node := {
	if #rules == 0 { return program }
	# the program's nodes listed once for all that its rules ask of it (each listing them anew was ~6% of a compile)
	nodes = nodes_in(program)
	rule_scope = scope_with({}, nodes)
	first_parameter_types = typed_first_parameters_in(nodes)
	rule_signatures = definitions_signatures_in(nodes)
	rule_case_holders = case_holders_in(nodes)
	rule_instances = instance_names_in(program, nodes)
	rule_classes = class_names_of(program)
	rule_program = program
	rule_varying_known = no
	rule_vectors_known = no
	maps = map_names_of(program)
	# a program of one statement: that statement, so the rules `where statement` apply to it too
	if not is_statement_sequence(program) { return sugar_at_place(placed_map_scoped(program, n => sugared_node(n, rules), maps), Place.Statement, rules) }
	# each statement walked with the rules that can fire in it (rules_reaching), the program's runs with them all
	needs = rules.map(needed_tokens)
	results = rules.map(rule => tokens_within(rule.template))
	walked = children(program, statement => sugared_statement(statement, rules_reaching(rules, needs, results, statement), maps))
	rule_maps = maps
	sugared_node(walked, rules)
}
sugared_statement(statement: Node, rules: list, maps: map): Node := {
	rule_vector_scope = function_defined(statement)
	walked = placed_map_scoped(statement, n => sugared_node(n, rules), maps)
	rule_vector_scope = ""
	walked
}

# the words of the templates of the rules that can fire in the program
reaching_template_words(program: Node, rules: list): list := rules_reaching(rules, rules.map(needed_tokens), rules.map(rule => tokens_within(rule.template)), program).flat_map(rule => words_within(rule.template))

# the rules that can fire in the statement (card speed-module-cache): those whose pattern's words it mentions, or the
# result of such a rule does (a result is rewritten again); a rule missing one matches nowhere in it, so walking it
# with these alone gives what all the rules give, without trying the others at each node
rules_reaching(rules: list, needs: list, results: list, statement: Node): list := {
	mentioned = word_set(tokens_within(statement))
	picked = []
	grew = yes
	while grew {
		grew = no
		for index in 0 ..< #rules {
			if index not in picked and needs[index].all(word => mentioned.has(word)) {
				picked += [index]
				for word in results[index] { mentioned[word] = yes }
				grew = yes
			}
		}
	}
	reaching = []
	for index in 0 ..< #rules { if index in picked { reaching += [rules[index]] } }
	reaching
}

# what code must hold for the rule to fire in it (tokens_within): its pattern's words outside holes, and the operator
# of the key its pattern is (`$a ?? $b` fires only where code has a `??`)
needed_tokens(rule: Rule): list := required_words(rule.pattern) + (if rule.pattern is key and rule.head != "" then [rule.head] else [])
# the words code must hold for the pattern to match it (rule_matches): its words outside holes
required_words(pattern: Node): list := {
	if rule_hole(pattern) != ø or typed_hole(pattern) != ø or rest_hole_name(pattern) != ø or affixed_hole(pattern) != ø { return [] }
	if pattern is symbol { return [name_of(pattern)] }
	if pattern is key { return required_words(key_of(pattern)) + required_words(value_of(pattern)) }
	if is_group(pattern) then items_of(pattern).flat_map(item => required_words(item)) else []
}

# `[a, b]`: a list literal, whose items are rewritten by the rules `where element`
is_element_list(n: Node): bool := is_group(n) and bracket_of(n) == "["

# the node with the sugar rules applied, a class's body too (the walk passes over its opaque view)
sugared_node(n: Node, rules: list): Node := {
	n = with_changed_members(n, member => sugar_at_place(bottom_up(member, part => sugared_node(part, rules)), Place.Member, rules))
	if holds_statements(n) {
		n = group_like(n, sugar_runs(spliced_statements(items_of(n).map(statement => sugar_at_place(statement, Place.Statement, rules))), rules))
	} else if is_element_list(n) {
		n = group_like(n, items_of(n).map(element => sugar_at_place(element, Place.Element, rules)))
	} else if n is key and key_of(n) != opaque_symbol {
		n = with_placed_parts(n, (code, place) => sugar_at_place(code, place, rules))
	}
	sugar_rewritten(n, rules)
}

# what a pattern needs of the top of the code it matches, as rule_matches tests it first: "" for a hole (any code), the
# operator of a key, the bracket of a group and its first word when the pattern spells one, an atom; a rule whose head
# the code lacks is not tried there (card sugar-rule-passes)
pattern_head(pattern: Node): text := {
	if rule_hole(pattern) != ø or typed_hole(pattern) != ø { return "" }
	if pattern is key { return key_head(pattern) }
	if is_group(pattern) { return group_head(pattern, if #pattern > 0 and rule_hole(pattern#1) == ø and rest_hole_name(pattern#1) == ø and pattern#1 is symbol then name_of(pattern#1) else "") }
	atom_head
}
atom_head = "atom"
key_head(n: Node): text := match n {
	Key(_, op, _): "key " + op as text
	_: ""
}
group_head(n: Node, first_word: text): text := "group " + bracket_of(n) + " " + first_word
# the heads code has, its own and, as rule_applied and sugar_rewritten also try them, those of its statements as one
# line (a curly group) and of its phrase as written
code_heads(n: Node, written: any): map := {
	heads = {}
	for code in [n, written] {
		if code != ø {
			own_heads_of(code, heads)
			if is_curly_group(code) { own_heads_of(separated(bracketed(items_of(code), ""), separator_of(code)), heads) }
		}
	}
	heads
}
own_heads_of(code: Node, heads: map) := {
	if code is key { heads[key_head(code)] = yes } else if is_group(code) {
		heads[group_head(code, "")] = yes
		if #code > 0 and code#1 is symbol { heads[group_head(code, name_of(code#1))] = yes }
	} else { heads[atom_head] = yes }
}
fits_head(rule: Rule, heads: map): bool := rule.head == "" or heads.has(rule.head)

# the statements with each run a sugar rule of several statements `($a; $b)` matches rewritten, as statement_runs
# does for the program's own rules: right to left, a run made shorter tried again where it stands (F6, F12, F13)
sugar_runs(statements: list, rules: list): list := {
	run_rules = rules.filter(rule => rule.place == Place.Anywhere and is_statements_pattern(rule.pattern))
	if #run_rules == 0 { return statements }
	no_origins = run_rules.map(rule => {})
	at = #statements - 1
	while at >= 0 {
		found = statement_run_at(statements[at ..], run_rules, no_origins)
		shorter = no
		if found != ø {
			made = spliced_statements([bottom_up(as_value(found#2), part => sugar_rewritten(part, rules))])
			statements = statements[0 ..< at] + made + statements[at + found#1 ..]
			shorter = #made < found#1
		}
		if not shorter { at -= 1 }
	}
	statements
}

# the statements of a block or the program, a block of one statement too (`if c { twice{…} }`); a map written out
# `{a: 1}` holds entries
holds_statements(n: Node): bool := is_group(n) and (separator_of(n) in statement_separators or (is_curly_group(n) and #n == 1 and not is_braced_map(n)))

# the code rewritten by the first sugar rule of the place matching it, the result rewritten again
sugar_at_place(n: Node, place: Place, rules: list): Node := {
	heads = code_heads(n, ø)
	for rule in rules {
		if rule.place == place and fits_head(rule, heads) {
			result = rule_applied(rule, {}, n)
			if changes(result, n) { return bottom_up(as_value(result), part => sugar_rewritten(part, rules)) }
		}
	}
	n
}

# the program with the rules of the early sugar modules applied, before the passes; also each library definition the
# program reaches (prelude_words.warp with_reached: math's `norm` declares `var total = 0`), whose words are its own.
# A program with no phrase holding a rule's first word stays as it is (a rule's result may need another's, `fun` `def`)
early_sugared(program: Node): Node := {
	rules = early_module_rules()
	words = phrase_words(program)
	if not rules.any(rule => words.has(needed_word(rule))) { return program }
	sugared(program, unbound_rules(rules, program))
}
# the rules of the early sugar modules, read once
early_module_rules(): list := {
	if not early_rules_read {
		early_rules = early_sugar_module_names.flat_map(module => module_rules_of(std_module_path(module), ""))
		early_rules_read = yes
	}
	early_rules
}
# the words of the phrases in the node (`var total = 0`'s var, `square of number = …`'s of), also as the parser writes
# a declaration word (uses.warp declaration_keywords), the key of `global: (play(tone) := …)`
phrase_words(n: Node): map := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is key {
			if op_of(part) == Op.Colon and key_of(part) is symbol and name_of(key_of(part)) in declaration_keywords { found[name_of(key_of(part))] = yes }
			waiting += [key_of(part), value_of(part)]
		} else if is_group(part) {
			phrase = bracket_of(part) == "" and separator_of(part) == " " and #part > 1
			for item in part {
				if phrase and item is symbol { found[name_of(item)] = yes }
				waiting += [item]
			}
		}
	}
	found
}

# the node rewritten by the first sugar rule matching it, its result rewritten again (F7); a node no rule matches stays
# as the passes left it
sugar_rewritten(n: Node, rules: list): Node := {
	written = flattened_phrase(n)
	heads = code_heads(n, written)
	for rule in rules {
		if rule.place == Place.Anywhere and fits_head(rule, heads) {
			result = rule_applied(rule, {}, n)
			if not changes(result, n) and written != ø { result = regrouped(rule_applied(rule, {}, written), n) }
			if changes(result, n) { return bottom_up(as_value(result), part => sugar_rewritten(part, rules)) }
		}
	}
	n
}

# a result of a phrase matched in its parentheses, `(match x {…})`, back in them
regrouped(result: Node, n: Node): Node := if result != ø and is_round(n) then List([as_value(result)], Bracket.Round, separator_of(n)) else result

# whether a rule's result changes the code it rewrote, positions aside: a rule whose result is that code didn't fire (else a rule
# matching its own result, `match $s {…}` of the arms it left, would rewrite it forever)
changes(result: Node, n: Node): bool := result != ø and not same_view(result, n)

# a phrase holding phrases as its words as written, which a phrase rule matches as the module rules do (the parser
# nests `print each xs` as `print (each xs)`), also a phrase in parentheses; else ø
flattened_phrase(n: Node): Node := match n {
	List(items, Bracket.None, Separator.Space): {
		if items.any(item => is_group(item) and bracket_of(item) == "" and separator_of(item) == " ") then List(words_of_all(items), Bracket.None, Separator.Space) else ø
	}
	# `print(match x {…})`: parentheses around a phrase only group it
	List(items, Bracket.Round, Separator.Space): List(words_of_all(items), Bracket.None, Separator.Space)
	_: ø
}

word_set(words: list): map := {
	set = {}
	for word in words { set[word] = yes }
	set
}

# the words each rule of a module needs, read off its text: a program mentioning none parses no rules. The first word of
# the origin's shape after `where … =`, else of the pattern, else (a pattern starting with a hole, `$n $u`) the words
# its `in [ms, kg]` listing names
rule_needs(source: text): list := {
	if not source.contains(rewrite_line_start) { return [] }
	needs = []
	for line in source.split("\n") {
		if line.starts_with(rewrite_line_start) {
			rule = line[#rewrite_line_start ..]
			parts = rule.split(" " + where_word + " ")
			origin = if #parts > 1 then parts#2.split("=") else []
			# (a hole a rule word binds, `$names = path_parameters($path)`, is no origin)
			needing = if #origin > 1 and rule_hole(symbol(origin#1.trim())) != ø and not is_rule_word(first_alphabetic_word(origin#2)) then origin#2 else rule.split("=>")#1
			word = first_alphabetic_word(needing)
			needs += if word != "" then [word] else listed_in_text(rule)
		}
	}
	needs
}

# the words of a rule's `in [a, b]` listing, as written
listed_in_text(rule: text): list := {
	if not rule.contains(" " + listed_word + " [") { return [] }
	start = rule.find(" " + listed_word + " [")
	listing = rule[start - 1 + #listed_word + 3 ..]
	listing[0 ..< listing.find("]") - 1].split(",").map(word => word.trim())
}

# the first run of letters, digits, `_` and `$` starting with a letter
first_alphabetic_word(written: text): text := {
	start = 0
	while start < #written {
		end = start
		while end < #written and (is_alphanumeric(written[end]) or rule_word_marks.contains(written[end])) { end += 1 }
		if end > start and is_alpha(written[start]) { return written[start ..< end] }
		start = end + 1
	}
	""
}

# the rules of the module at `path`, of its baked parse when it is the bundled one
module_rules_of(path: text, module: text): list := {
	source = file_text(path) ?? ""
	within = library_path(path)
	baked = if LIBRARY_FILES.get(within) == source then LIBRARY_RULES.get(within) else ø
	if baked != ø { return items_of(unpack(baked)).map(packed => unpacked_rule(packed, module)) }
	written_rules(path, source, module)
}
# (a rule line the parse doesn't give a rule of fails loudly, naming it: a line before it left an apostrophe or a
# bracket open, which took the rules after it in, and they were gone without a word)
written_rules(path: text, source: text, module: text): list := {
	rules = rules_parsed(source_parse(path, source), module, source)
	lines = lines_of(source)
	rule_lines = (1 to #lines).filter(i => lines#i.trim().starts_with(rewrite_line_start))
	if #rules < #rule_lines { throw dropped_rules(path, lines, rule_lines, rules, module) }
	rules
}
rules_parsed(parse: Node, module: text, source: text): list := statements_ruled(statements_in(parse), module, source)#1
# [the rules the statements declare, the other statements]: each `rewrite` line's, and in place of the first overload
# of a built-in operator those of all its overloads (operator_rules)
statements_ruled(statements: list, module: text, source: text): list := {
	rules = []
	kept = []
	overloads = statements.map(operator_overload)
	ruled = {}
	for at in 1 to #statements {
		overload = overloads#at
		if overload != ø {
			glyph = overload.glyph
			if not ruled.has(glyph) {
				ruled[glyph] = yes
				rules += operator_rules(overloads.filter(other => other != ø and other.glyph == glyph), module)
			}
		} else {
			rule = rule_of(statements#at, module, source)
			if rule == ø { kept += [statements#at] } else { rules += [rule] }
		}
	}
	[rules, kept]
}

# Overloads of a built-in operator by its operands' kinds (decision rules-to-typed-operators, user OK 2026-10-31):
# `infix operator |(x: any, g: function) := g(x)` is the rule `$x | $g => $g($x)`, its parameter types its conditions
# (overload_conditions), so dispatch costs nothing at run time. The overloads of one operator are tried most specific
# first (fewer `any`), one whose body is the operator itself, `infix operator |(a: type, b: type) := a | b`, keeps the
# built-in where it fits (the later ones hold only where it doesn't), and where none fits the built-in stays. A
# class's operand (`+(a: Vec, b: Vec)`) leaves the definition to class_methods.warp
class OperatorOverload { glyph: text; names: list; types: list; pattern: Node; template: Node; builtin: bool }
# each kind's alternative conditions, each a list of conditions joined by `and`; `any` none
overload_conditions = {any: [[]], function: [["is function"], ["takes one"]], block: [["is function"], ["takes one"]], type: [["is type"]], enum: [["is enum"]], text: [["is text"]], symbol: [["is symbol"]], list: [["is list"]], map: [["is map"]], int: [["is int"]], number: [["is number"]]}

# the definition `operator_|(a: T, b: U) := body` (also `+(a: T, b: U)`, the method form) of a built-in operator, as
# its overload, else ø
operator_overload(statement: Node): OperatorOverload? := {
	if not is_key(statement, Op.Define) or not is_round(key_of(statement)) or #key_of(statement) != 3 or not (key_of(statement)#1 is symbol) { return ø }
	glyph = overloaded_spelling(name_of(key_of(statement)#1))
	if glyph == ø { return ø }
	parameters = items_of(key_of(statement))[1 ..]
	types = parameters.map(parameter => if parameter is symbol then any_word else if is_key(parameter, Op.Colon) and value_of(parameter) is symbol then name_of(value_of(parameter)) else "")
	if not types.all(type => overload_conditions.has(type)) { return ø }
	names = parameters.map(parameter_name)
	pattern = statements_in(plain_node(parsed(hole_word(names#1) + " " + glyph + " " + hole_word(names#2))))#1
	if not (pattern is key and key_of(pattern) == symbol(hole_word(names#1)) and value_of(pattern) == symbol(hole_word(names#2))) { return ø }
	template = holes_for(plain_node(value_of(statement)), names + introduced_names(value_of(statement)))
	OperatorOverload(glyph, names, types, pattern, template, same_view(template, pattern))
}
# the built-in operator a definition's name spells: `operator_|` |, `operator_as` as, the method form's `+`; else ø
overloaded_spelling(name: text): text? := {
	spelling = if name.starts_with(OPERATOR_FUNCTION_PREFIX) then name[#OPERATOR_FUNCTION_PREFIX ..] else if first_alphabetic_word(name) == "" then name else ""
	if symbol_operator(spelling) != ø or word_operator(spelling) != ø then spelling else ø
}
hole_word(name: text): text := rule_hole_mark + name
# the body with each of the names a hole: the parameters, also the names its lambdas and assignments introduce, fresh
# at each firing (a key of a map it writes stays a key)
holes_for(body: Node, names: list): Node := bottom_up(body, part => if part is symbol and name_of(part) in names then placed(symbol(hole_word(name_of(part))), part) else part)
introduced_names(body: Node): list := nodes_in(body).flat_map(n => if is_key(n, Op.Arrow) then parameters_of(key_of(n)) else if is_key(n, Op.Assign) and key_of(n) is symbol then [name_of(key_of(n))] else [])

# the rules of one operator's overloads, most specific first, a built-in arm before the overloads as specific as it:
# each alternative of a variant's operands (a function, or a library word of one value), held only where no earlier
# arm fits, one of the arm's typed operands failing its kind
operator_rules(overloads: list, module: text): list := {
	ordered = (0 to 2).flat_map(untyped => [yes, no].flat_map(builtin => overloads.filter(overload => overload.builtin == builtin and #overload.types.filter(type => type == any_word) == untyped)))
	rules = []
	arms = []
	for overload in ordered {
		if overload.builtin { arms += [overload] } else {
			unfitting = [[]]
			for arm in arms { unfitting = unfitting.flat_map(guards => arm_misfits(arm, overload).map(misfit => guards + misfit)) }
			for alternative in operand_alternatives(overload) {
				for guards in unfitting { rules += [Rule(overload.pattern, overload.template, ø, ø, alternative + guards, Place.Anywhere, module, no, no, pattern_head(overload.pattern))] }
			}
		}
	}
	rules
}
# the conditions a kind's alternatives make of the overload's operand holes, as `where` parses them (rule_of), each
# alternative of each operand, combined
operand_alternatives(overload: OperatorOverload): list := {
	combined = [[]]
	for at in 1 to 2 {
		combined = combined.flat_map(before => overload_conditions[overload.types#at].map(alternative => before + parsed_conditions(overload.names#at, alternative)))
	}
	combined
}
# the ways the arm's operands may not fit, in the holes of `named`: one typed operand failing each of its kind's
# alternatives (each one condition)
arm_misfits(arm: OperatorOverload, named: OperatorOverload): list := (1 to 2).filter(at => arm.types#at != any_word).map(at => overload_conditions[arm.types#at].flat_map(alternative => parsed_conditions(named.names#at, alternative)).map(condition => Key(ø, Op.Not, condition)))
parsed_conditions(name: text, alternative: list): list := {
	if #alternative == 0 { return [] }
	hole = hole_word(name)
	rule = rule_of(statements_in(plain_node(parsed(rewrite_word + " " + hole + " => " + hole + " " + where_word + " " + alternative.map(condition => hole + " " + condition).join(" " + and_word + " "))))#1, "", "")
	rule.conditions
}
# the rule lines of a module the parse of the whole lost, each by its file and line
dropped_rules(path: text, lines: list, rule_lines: list, rules: list, module: text): text := {
	patterns = rules.map(rule => rule.pattern)
	dropped = rule_lines.filter(i => rules_parsed(plain_node(parsed(rules_ended(lines#i))), module, lines#i).all(rule => rule.pattern not in patterns))
	dropped.map(i => path + ":" + i + ": the rule `" + lines#i.trim() + "` was dropped").join("\n") + "\n(a line before it left an apostrophe or a bracket open, even in a comment: `#` starts one only before a blank)"
}
# every bundled module's rules, packed (rule_node), baked in beside its parse: uses.warp module_text writes them in where
# library_rules() stands; reading them off each parse at every compile was a tenth of a small program's (card
# fixed-startup-cost). A compiler built by one that bakes none reads them where it runs
LIBRARY_RULES = library_rules()
library_rules(within: text = ""): map := {}
# each file's rewrite rules, packed (LIBRARY_RULES): those of a file with any, read off its fresh parse, never the building
# compiler's baked one (uses.warp baked_tables)
packed_rules(files: map): map := {
	packed = {}
	for path in files.keys {
		if files[path].contains(rewrite_line_start) { packed[path] = pack(List(rules_parsed(plain_node(parsed(rules_ended(files[path]))), "", files[path]).map(rule_node), Bracket.Square, Separator.Comma)) }
	}
	packed
}
# each standard module with rules, the words they need (rule_needs) joined by spaces, baked in: module_text writes
# std_rule_needs() in, so a compile reads no other module's text (38 of them at every compile were ~5 ms of a small one).
# With WARP_LIB (a module edited after the build) and in a compiler built by one that bakes none: read off the texts
STD_RULE_NEEDS = std_rule_needs()
std_rule_needs(within: text = ""): map := {}
rule_needs_by_module(): map := if #STD_RULE_NEEDS > 0 and warp_lib() == ø then STD_RULE_NEEDS else scanned_rule_needs()
scanned_rule_needs(): map := {
	found = {}
	for module in std_module_names {
		source = file_text(std_module_path(module))
		needs = if source == ø then [] else rule_needs(source)
		if #needs > 0 { found[module] = needs.join(" ") }
	}
	found
}
# a rule as one node, its fields in order, and back: its place, head, whole and alias as words (a place's word, "·"
# anywhere; yes/no)
rule_node(rule: Rule): Node := {
	place_word = "·"
	for word in PLACE_WORDS.keys { if PLACE_WORDS[word] == rule.place { place_word = word } }
	flags = [symbol(place_word), symbol(if rule.whole then "yes" else "no"), symbol(if rule.alias then "yes" else "no"), symbol(rule.head ?? "")]
	List([rule.pattern, rule.template, rule.hole ?? Node.Empty, rule.shape ?? Node.Empty, List(rule.conditions, Bracket.Square, Separator.Comma)] + flags, Bracket.Square, Separator.Comma)
}
unpacked_rule(n: Node, module: text): Rule := {
	fields = items_of(n)
	hole = if fields#3 == ø then ø else fields#3
	shape = if fields#4 == ø then ø else fields#4
	conditions = items_of(fields#5)
	# an origin the baking compiler (an older seed) took a call of a rule word it did not know yet for: a computed binding
	if hole != ø and is_computed_binding(Key(hole, Op.Assign, shape)) {
		conditions += [Key(hole, Op.Assign, shape)]
		hole = ø
		shape = ø
	}
	Rule(fields#1, fields#2, hole, shape, conditions, PLACE_WORDS.get(name_of(fields#6)) ?? Place.Anywhere, module, name_of(fields#7) == "yes", name_of(fields#8) == "yes", name_of(fields#9))
}

# the rule's code with each hole written right before `(`, `$t($a...)`, the call it is, as the code's `P(1)` is: the
# parser reads it as the hole and a group, `$t ($a...)` (card engine-guarded-call-phrase)
with_called_holes(n: Node, lines: list): Node := if #lines == 0 then n else bottom_up(n, part => called_holes_in(part, lines))

# the group with each hole and the round group written right after it one call
called_holes_in(n: Node, lines: list): Node := {
	if not (is_group(n) and bracket_of(n) == "" and #n > 1) { return n }
	items = items_of(n)
	merged = []
	index = 0
	while index < #items {
		item = items[index]
		next = if index + 1 < #items then items[index + 1] else ø
		if next != ø and is_group(next) and bracket_of(next) == "(" and called_hole(item, lines) {
			merged += [placed(List([item] + items_of(next), Bracket.Round, Separator.None), item)]
			index += 2
		} else {
			merged += [item]
			index += 1
		}
	}
	if #merged == #items { return n }
	if #merged == 1 and separator_of(n) == " " then merged#1 else placed(group_like(n, merged), n)
}

# whether the source writes `(` right after the hole
called_hole(n: Node, lines: list): bool := {
	if rule_hole(n) == ø { return no }
	line = line_of(n)
	column = column_of(n)
	if not (line is int and column is int) or line < 1 or line > #lines { return no }
	written: text = lines[line - 1]
	at = column - 1 + #name_of(n)
	at < #written and written[at ..< at + 1] == "("
}

# the word a program must mention for the rule to fire: the first of its origin's shape, else of its pattern
needed_word(rule: Rule): text := first_word_of(rule.shape ?? rule.pattern) ?? ""
# that word, else the words its listings name: `$n $u where $u in [ms, kg]` is needed by ms and kg
needed_words(rule: Rule): list := {
	word = needed_word(rule)
	if word != "" { return [word] }
	rule.conditions.map(membership).filter(listing => listing != ø).flat_map(listing => listing.words)
}

# `rewrite p => t` and `rewrite p => t where $c = shape`, as parser.warp reads them: the words before the arrow's key
# start the pattern (`rewrite channel $name => …` reads as `rewrite channel ($name => …)`), the words after it continue
# the template up to `where`, whose `=` holds only the shape's first word (`where $c = channel $name`); `source` is the
# text the statement was parsed from
# a pattern ending in a typed hole, `rewrite whenever $c $body: block => …`, which the parser reads as
# `$body: (block => …)`: the arrow after the typed hole
typed_hole_arrow(item: Node): Node := match item {
	Key(hole, Op.Colon, Key(kind, Op.Arrow, template)): if rule_hole(hole) != ø and kind is symbol and name_of(kind) in hole_kinds then Key(Key(hole, Op.Colon, kind), Op.Arrow, template) else item
	_: item
}
rule_of(statement: Node, module: text, source: text): Rule? := {
	if not is_group(statement) or bracket_of(statement) != "" or separator_of(statement) != " " { return ø }
	items = items_of(statement).map(typed_hole_arrow)
	if #items < 2 or items#1 != symbol(rewrite_word) { return ø }
	arrow_at = 0
	for index in 1 ..< #items { if arrow_at == 0 and is_key(items[index], Op.Arrow) { arrow_at = index } }
	if arrow_at == 0 { return ø }
	arrow = items[arrow_at]
	words = items[1 ..< arrow_at]
	whole = #words == 0 and is_parenthesized(key_of(arrow))
	pattern = if whole then key_of(arrow)#1 else if #words == 0 then statement_pattern(key_of(arrow)) else rule_phrase(words_of_all(words + [key_of(arrow)]))
	after = items[arrow_at + 1 ..]
	written = value_of(arrow)
	where_at = #after
	for index in 0 ..< #after { if where_at == #after and after[index] == symbol(where_word) { where_at = index } }
	cut = split_at_where(written)
	if cut != ø {
		written = cut.template
		after = cut.conditions + after
		where_at = -1
	}
	continued = after[0 ..< max(where_at, 0)]
	template = statements_template(each_clauses(glued(if #continued == 0 then written else rule_phrase(words_of_all([written] + continued)), source)))
	lines = if source.contains(rule_hole_mark) then lines_of(source) else []
	pattern = with_called_holes(pattern, lines)
	template = with_called_holes(template, lines)
	if where_at == #after { return Rule(pattern, template, ø, ø, [], Place.Anywhere, module, whole, no, pattern_head(pattern)) }
	conditions = []
	for run in split_at_word(after[where_at + 1 ..], and_word) { conditions += conjuncts(continued_key(run)) }
	aliased = conditions.any(condition => condition == symbol(alias_mark))
	conditions = conditions.filter(condition => condition != symbol(alias_mark))
	places = conditions.filter(is_place_word)
	conditions = conditions.filter(condition => not is_place_word(condition))
	if #places > 1 or not conditions.all(is_condition) { return ø }
	place = if #places == 0 then Place.Anywhere else PLACE_WORDS[name_of(places#1)]
	origins = conditions.filter(condition => is_key(condition, Op.Assign) and not is_computed_binding(condition))
	if #origins > 1 { return ø }
	if #origins == 0 { return Rule(pattern, template, ø, ø, conditions, place, module, whole, aliased, pattern_head(pattern)) }
	Rule(pattern, template, key_of(origins#1), value_of(origins#1), conditions.filter(condition => condition != origins#1), place, module, whole, aliased, pattern_head(pattern))
}

# a rule source's lines, split once for all its rules (rule_of and glued ask at each rule)
global split_source = ""
global split_lines = []
lines_of(source: text): list := {
	if source != split_source {
		split_lines = source.split("\n")
		split_source = source
	}
	split_lines
}

# a template cut at a `where` its last words swallowed (`$c + $n where`, `$s where statement`): the template before it
# and the words after it
class WhereCut { template: Node; conditions: list }

# the template cut at a `where` inside it, else ø
split_at_where(n: Node): WhereCut? := {
	if n is key {
		inner = split_at_where(value_of(n))
		if inner == ø {
			# `$p where parameter and $w is label`: the parser joined a condition after `where` to the next by the
			# operator, the `where` inside its left side; the operator joins them again after the cut
			left = split_at_where(key_of(n))
			return if left == ø then ø else WhereCut(left.template, [Key(as_phrase(left.conditions), op_of(n), value_of(n))])
		}
		# `$s... where statement`: the parser read the conditions as the end of the rest's range, which ends nowhere
		before = inner.template
		if is_group(before) and #before == 0 { before = ø }
		return WhereCut(Key(key_of(n), op_of(n), before), inner.conditions)
	}
	if not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n > 0) { return ø }
	items = items_of(n)
	for index in 0 ..< #items {
		if items[index] == symbol(where_word) { return WhereCut(words_phrase(items[0 ..< index]), items[index + 1 ..]) }
	}
	inner = split_at_where(items[#items - 1])
	if inner == ø then ø else WhereCut(words_phrase(items[0 ..< #items - 1] + [inner.template]), inner.conditions)
}

# the words in runs between the word, `$a is type and $n < 0` as [[$a is type], [$n < 0]]
split_at_word(words: list, word: text): list := {
	runs = []
	run = []
	for item in words {
		if item == symbol(word) {
			runs += [run]
			run = []
		} else {
			run += [item]
		}
	}
	runs + [run]
}

# `$c = channel $name`: the key's value continued by the words after it
continued_key(words: list): Node := {
	if #words == 0 { return ø }
	first = words#1
	if #words == 1 or not (first is key) { return if #words == 1 then first else rule_phrase(words) }
	Key(key_of(first), op_of(first), rule_phrase(words_of_all([value_of(first)] + words[1 ..])))
}

# the conditions joined by `and`, also around an assignment, which the parser let take the `and`s beside it: `$c =
# channel() and $x is type`, `$m in [get, post] and $verb = route_verb($m) and $names = path_parameters($path)`
conjuncts(condition: Node): list := match condition {
	Key(left, Op.And, right): conjuncts(left) + conjuncts(right)
	Key(left, Op.Assign, right): {
		before = and_parts(left)
		chained = is_key(right, Op.Assign)
		after = and_parts(if chained then key_of(right) else right)
		rest = after[1 ..]
		more = if #rest == 0 then [] else if chained then conjuncts(Key(and_joined(rest), Op.Assign, value_of(right))) else rest.flat_map(conjuncts)
		before[0 ..< #before - 1].flat_map(conjuncts) + [Key(before.last(), Op.Assign, after#1)] + more
	}
	_: [condition]
}
and_parts(n: Node): list := if is_key(n, Op.And) then and_parts(key_of(n)) + and_parts(value_of(n)) else [n]
and_joined(parts: list): Node := if #parts == 1 then parts#1 else Key(and_joined(parts[0 ..< #parts - 1]), Op.And, parts.last())

# `$c = shape`, `$t is type`, `not $t is type` (also written `$t is not type`), `$n < 0`, `$f takes value`, a rule
# word's call or the hole it binds
is_condition(condition: Node): bool := {
	if is_takes(condition) or is_rule_word_call(condition) or is_computed_binding(condition) { return yes }
	if is_negation(condition) { return is_condition(value_of(condition)) and not is_key(value_of(condition), Op.Assign) }
	if is_context_word(condition) or membership(condition) != ø { return yes }
	if not (condition is key and rule_hole(key_of(condition)) != ø) { return no }
	wanted = value_of(condition)
	if op_of(condition) == Op.Assign { return yes }
	if op_of(condition) == Op.Is { return is_property(wanted) or is_case_property(wanted) }
	literal_comparisons.any(op => is_key(condition, op)) and is_number_literal(wanted)
}

# `routed($program)`: a call of a word of lib/rule_words.warp, run at compile time (decision computed-hole)
is_rule_word_call(n: Node): bool := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and is_rule_word(name_of(n#1))
# a word of lib/rule_words.warp: one this compiler has, or, when a rule names a word it lacks (an older seed building a
# newer compiler, card rule-whose), one the library's file defines, read only then
is_rule_word(word: text): bool := rule_words.has(word) or library_rule_word_names().has(word)
global library_rule_words = ø
library_rule_word_names(): map := {
	if library_rule_words == ø {
		library_rule_words = {}
		for cut in definition_slices(used_module_text("rule_words")) { library_rule_words[cut#1] = yes }
	}
	library_rule_words
}
# a rule word this compiler lacks: the rules calling it don't fire, said once a word
global skipped_rule_words = {}
skipped_rule_word(word: text): any := {
	if not skipped_rule_words.has(word) {
		warn "the rule word " + word + " is not in this compiler (an older seed): its rules are skipped"
		skipped_rule_words[word] = yes
	}
	ø
}
# `$names = path_parameters($path)`: a hole bound to a rule word's result
is_computed_binding(n: Node): bool := is_key(n, Op.Assign) and (rule_hole(key_of(n)) != ø or rest_hole_name(key_of(n)) != ø) and is_rule_word_call(value_of(n))
# the rule word's result for the code its arguments' holes bound, `$program` the whole program, `$source` its text
program_hole = "$program"
source_hole = "$source"
computed(call: Node, bound: map): any := {
	if not rule_words.has(name_of(call#1)) { return skipped_rule_word(name_of(call#1)) }
	word = rule_words[name_of(call#1)]
	given = items_of(call)[1 ..].map(argument => if argument == symbol(program_hole) then rule_program else if argument == symbol(source_hole) then rule_source else rule_spliced(argument, bound, argument))
	if #given == 0 { return word() }
	if #given == 1 { return word(given#1) }
	if #given == 2 { return word(given#1, given#2) }
	word(given#1, given#2, given#3)
}
# `$f takes value`, `$f takes int`
is_takes(condition: Node): bool := is_group(condition) and bracket_of(condition) == "" and separator_of(condition) == " " and #condition == 3 and rule_hole(condition#1) != ø and condition#2 == symbol(takes_word) and condition#3 is symbol

# whether the code names a function whose first parameter is typed as wanted: `value` any type but yes/no
first_parameter_fits(code: Node, wanted: text): bool := {
	if not (code is symbol) or locally_bound(code) { return no }
	word = name_of(code)
	if wanted == one_word { return not rule_scope.has(word) and takes_one_typed_value(unaliased(word)) }
	if wanted == number_word { return takes_only_numbers(word, matched_arity(code)) }
	typed = if first_parameter_types.has(word) then first_parameter_types[word] else library_first_type(word)
	if typed == ø or typed == "" { typed = conversion_type(word) }
	if typed == ø { return no }
	if wanted == value_word { return not (typed in yes_no_types) }
	typed == wanted
}
# every definition the word has, the program's, else the library's, that a call of that many arguments fits (ø: any)
# takes numbers only, so none takes a list as it is: `min(xs: list)` beside `min(a: number, b: number, more...)`, and
# `gc_code(op: int, immediates: list)`, never broadcast; `max(v, 0.5)` does
takes_only_numbers(word: text, arity: int?): bool := {
	defined = if rule_signatures.has(word) then rule_signatures[word] else if word_lines().has(word) then word_lines()[word].map(line => line.signature) else []
	fitting = defined.filter(signature => arity == ø or takes(signature, arity))
	#fitting > 0 and fitting.all(signature => #signature.parameters > 0 and signature.parameters.filter(parameter => not parameter.rest).all(parameter => parameter.type_name in numeric_parameter_types))
}
# how many arguments the call the rule matched passes the word, ø when it matched no call of it
matched_arity(word: Node): int? := if rule_matched != ø and is_round(rule_matched) and #rule_matched > 0 and rule_matched#1 == word then #rule_matched - 1 else ø

# what a type word converts, unless the program binds it: a value of another type (`int 3.7 == 3` is int(3.7) == 3),
# yes or no for the yes/no type's own (`bool x == y` stays bool(x == y)), decision function-words-consume
conversion_type(word: text): text? := if word in type_words and not rule_scope.has(word) then (if word in ["bool", "boolean"] then "bool" else any_word) else ø
# the type of a typed library word's first parameter (lib/prelude.warp, lib/math.warp), else ø (builtin_signatures.warp
# word_lines)
library_first_type(word: text): text? := {
	lines = word_lines()
	if not lines.has(word) or rule_scope.has(word) { return ø }
	parameters = lines[word]#1.signature.parameters
	if #parameters == 0 then ø else parameters#1.type_name
}

# `f(x: int, y) := …`: f → the signature of each definition of the program
definitions_signatures(program: Node): map := definitions_signatures_in(nodes_in(program))
definitions_signatures_in(nodes: list): map := {
	signatures = {}
	for n in nodes {
		call = definition_call(n)
		if call != ø {
			word = name_of(call#1)
			signatures[word] = (if signatures.has(word) then signatures[word] else []) + [signature_of(items_of(call))]
		}
	}
	signatures
}
# `f(x: int) := …`: f → "int", for each definition of the program with a typed first parameter
typed_first_parameters(program: Node): map := typed_first_parameters_in(nodes_in(program))
typed_first_parameters_in(nodes: list): map := {
	types = {}
	for n in nodes {
		if is_key(n, Op.Define) and is_round(key_of(n)) and #key_of(n) >= 2 and key_of(n)#1 is symbol {
			parameter = key_of(n)#2
			if is_key(parameter, Op.Colon) and value_of(parameter) is symbol { types[name_of(key_of(n)#1)] = name_of(value_of(parameter)) }
		}
	}
	types
}

is_place_word(condition: Node): bool := condition is symbol and name_of(condition) in PLACE_WORDS

is_negation(condition: Node): bool := is_key(condition, Op.Not) and key_of(condition) == ø

is_property(word: Node): bool := word is symbol and (name_of(word) in code_properties or name_of(word) in hole_kinds)

# `case`, `case of $e` after `is`
is_case_property(wanted: Node): bool := wanted == symbol(case_word) or enum_hole_of(wanted) != ø

# the hole of `case of $e`, else ø
enum_hole_of(wanted: Node): text? := {
	if not (is_group(wanted) and bracket_of(wanted) == "" and #wanted == 3 and wanted#1 == symbol(case_word) and wanted#2 == symbol(cases_words#2)) { return ø }
	rule_hole(wanted#3)
}

# `$c is case of $e`: the code names a case of the enum $e names; with $e unbound (also `$c is case`), of the one enum
# declaring it, which $e is bound to
case_holds(code: Node, hole: text?, bound: map): bool := {
	# a case written with its enum, `Coin.Dime`, the enum named there
	if is_key(code, Op.Dot) and key_of(code) is symbol and value_of(code) is symbol {
		owner = name_of(key_of(code))
		if not (rule_enums.has(owner) and name_of(value_of(code)) in rule_enums[owner]) { return no }
		if hole != ø and bound.has(hole) { return named_enum(bound[hole]) == owner }
		if hole != ø { bound[hole] = key_of(code) }
		return yes
	}
	if not (code is symbol) { return no }
	case = name_of(code)
	if hole != ø and bound.has(hole) {
		name = named_enum(bound[hole])
		return rule_enums.has(name) and (case in rule_enums[name] or rule_case_holders.get(case) == name)
	}
	owners = rule_enums.keys.filter(name => case in rule_enums[name] or rule_case_holders.get(case) == name)
	if #owners != 1 { return no }
	if hole != ø { bound[hole] = symbol(owners#1) }
	yes
}

# the enum a name or a text names (`Coin`, `"Coin"` as type_tests.warp's is_type gets it), else ""
named_enum(code: Node): text := {
	name = if code is symbol then name_of(code) else if code is text then code else ""
	if rule_enums.has(name) then name else ""
}

# whether the code a hole bound passes the condition
condition_holds(condition: Node, bound: map): bool := {
	if is_negation(condition) { return not condition_holds(value_of(condition), bound) }
	if is_rule_word_call(condition) { return computed(condition, bound) == yes }
	if is_computed_binding(condition) {
		result = computed(value_of(condition), bound)
		target = key_of(condition)
		# a list the word gives, `[…]`, is a rest hole's items; any other node, a program's statements too, the hole's code
		bound[rest_hole_name(target) ?? rule_hole(target)] = if is_group(result) and bracket_of(result) == "[" then List(items_of(result), Bracket.None, Separator.Space) else result
		return result != ø
	}
	if is_takes(condition) {
		hole = rule_hole(condition#1)
		if not first_parameter_fits(bound[hole], name_of(condition#3)) { return no }
		# `$f takes one` binds the word the synonym calls: `size xs` is count(xs)
		if name_of(condition#3) == one_word { bound[hole] = placed(symbol(unaliased(name_of(bound[hole]))), bound[hole]) }
		return yes
	}
	if is_context_word(condition) { return context_holds(rule_matched, name_of(condition)) }
	listing = membership(condition)
	# a listed word the program binds as a value is its own, never the rule's: `g = "ab"; 3 times g` is no 3 grams
	if listing != ø { return bound.has(listing.hole) and word_listed(bound[listing.hole], listing.words) and not (bound[listing.hole] is symbol and binds_value(rule_scope, name_of(bound[listing.hole]))) }
	hole = rule_hole(key_of(condition))
	if not bound.has(hole) { return no }
	code = bound[hole]
	wanted = value_of(condition)
	if op_of(condition) == Op.Is { return if is_case_property(wanted) then case_holds(code, enum_hole_of(wanted), bound) else has_property(code, name_of(wanted)) }
	is_number_literal(code) and literal_compared(number_of(code), condition, number_of(wanted))
}

has_property(code: Node, property: text): bool := {
	if property in hole_kinds { return is_hole_kind(code, property) }
	if property == "literal" { return is_number_literal(code) or code is text }
	if property == "enum" { return named_enum(code) != "" }
	if property == "missing" { return code == ø }
	if property == "definition" { return definition_of(code) != ø }
	if property == "vector" { return may_be_list(code, rule_vector_scope, vector_names()) }
	# `{it*2}`: a block reading `it`, a function of it (definitions.warp is_function_block)
	if property == "function_block" { return bracket_of(code) == "{" and mentions(code, implicit_parameter) }
	# `x -> x * 2`, `(x -> x * 2)`: a lambda is a function too
	if property == "function" and (is_lambda(code) or (is_round(code) and #code == 1 and is_lambda(code#1))) { return yes }
	if property == "instance" and is_group(code) and bracket_of(code) == "(" and #code > 0 and code#1 is symbol { return rule_classes.has(name_of(code#1)) }
	if not (code is symbol) { return no }
	word = name_of(code)
	if property == "label" { return word in label_words }
	if property == "varying" { return varying_values().has(word) }
	if property == "instance" { return rule_instances.has(word) }
	if property == "type" { return word == any_word or is_tested_type(word, rule_scope) }
	if property == "value" { return binds_value(rule_scope, word) }
	# the program's function, else a builtin or the prelude's where the program binds nothing of the name (`x.upper!`'s upper)
	if property == "function" { return (binds_as(rule_scope, word, Meaning.Function) or (not rule_scope.has(word) and (is_declared_word(word) or word in prelude_definitions()))) and not locally_bound(code) }
	not rule_scope.has(word)
}

# The program's names and functions that may give a list (notes/broadcasting.md "Vector parameters"): a name assigned
# a value that may be one, a parameter some call passes one, a function whose result may be one; worked out to a
# fixpoint, [names, functions]. A name is its definition's (scoped_name: a function's own and its parameters, the main
# level's apart), so `xs = [1]` in one function marks no `xs` of another
vector_names(): list := {
	if not rule_vectors_known {
		rule_vectors = vectors_of(statements_in(rule_program))
		rule_vectors_known = yes
	}
	rule_vectors
}
# the name of the function a statement defines, "" of any other statement
function_defined(statement: Node): text := if is_key(statement, Op.Define) and is_round(key_of(statement)) and #key_of(statement) >= 1 and key_of(statement)#1 is symbol then name_of(key_of(statement)#1) else ""
scoped_name(scope: text, name: text): text := scope + name_joiner + name
vectors_of(statements: list): list := {
	parameters = {}
	for statement in statements { if function_defined(statement) != "" { parameters[function_defined(statement)] = key_of(statement)[1 ..].map(parameter_name) } }
	names = {}
	functions = {}
	vectors = [names, functions]
	scoped = statements.map(statement => [function_defined(statement), nodes_in(statement), statement])
	grown = yes
	while grown {
		grown = no
		for entry in scoped {
			scope = entry#1
			for n in entry#2 {
				if is_key(n, Op.Assign) and key_of(n) is symbol and not names.has(scoped_name(scope, name_of(key_of(n)))) and may_be_list(value_of(n), scope, vectors) {
					names[scoped_name(scope, name_of(key_of(n)))] = yes
					grown = yes
				}
				callee = if is_round(n) and #n > 0 and n#1 is symbol then name_of(n#1) else ""
				taken = parameters.get(callee)
				if taken != ø and scope != callee {
					for i in 1 ..< min(#n, #taken + 1) {
						name = taken[i - 1]
						if name != "" and not names.has(scoped_name(callee, name)) and may_be_list(n[i], scope, vectors) {
							names[scoped_name(callee, name)] = yes
							grown = yes
						}
					}
				}
			}
			if scope != "" and not functions.has(scope) {
				if may_be_list(result_of(value_of(entry#3)), scope, vectors) {
					functions[scope] = yes
					grown = yes
				}
			}
		}
	}
	vectors
}
# the value a body gives: a block's last statement
result_of(body: Node): Node := if is_curly_group(body) and #body > 0 then result_of(body[#body - 1]) else body
# whether the code, in the scope's definition, may give a list: a list written out, a word giving one (an element-wise
# operator, a map), a swizzle of two or more components `p.xy`, or one of the vectors' names or functions
list_giving_words = ["element_wise_any", "each_any", "map"]
may_be_list(code: Node, scope: text, vectors: list): bool := {
	if code is symbol { return vectors#1.has(scoped_name(scope, name_of(code))) }
	if is_group(code) and bracket_of(code) == "[" { return yes }
	# a range, `1 to 4`, `1..4`, is a list of its numbers; `xs...`, read `xs to ø`, is a rest parameter's mark
	if (is_key(code, Op.To) or is_key(code, Op.Range)) and rest_name(code) == ø { return yes }
	if is_key(code, Op.Dot) and value_of(code) is symbol { return is_swizzle_word(name_of(value_of(code))) }
	# a value in parentheses, `sqrt([4, 9])`: as the value
	if is_round(code) and #code == 1 and may_be_list(code#1, scope, vectors) { return yes }
	if is_element_wise_phrase(code) { return yes }
	if not (is_round(code) and #code > 0 and code#1 is symbol) { return no }
	name_of(code#1) in list_giving_words or vectors#2.has(name_of(code#1))
}
# `v .* 2` as the parser leaves it, before lib/sugar/arithmetic.warp spells it element_wise_any
is_element_wise_phrase(code: Node): bool := is_spaced(code) and #code == 3 and code#2 is symbol and #name_of(code#2) > 1 and name_of(code#2).starts_with(".") and name_of(code#2)#2 != '.'
is_swizzle_word(name: text): bool := #name >= 2 and #name <= 4 and name.all(c => c in "xyzw")

# the program's classes by name
class_names_of(program: Node): map := {
	classes = {}
	for statement in statements_in(program) {
		view = class_view(statement)
		if view != ø { classes[declared_type_name(view#2)] = yes }
	}
	classes
}
# the names the program assigns only instances of its classes, `s = Stack()` (class_methods.warp written_type), of its
# nodes as the caller listed them
instance_names_in(program: Node, nodes: list): map := {
	classes = class_names_of(program)
	found = {}
	if #classes == 0 { return found }
	types = assigned_types_in(nodes, classes)
	for name in types.keys { if types[name] in classes { found[name] = yes } }
	found
}

# The program's value definitions `A4 := midi_hertz(69)` that read a variable, directly or through any chain of words,
# `tuning` of midi_hertz: charged (P71, wiki/charged.md), they follow it. One reading only constants is none (P70), nor
# one whose name is assigned too, a variable
varying_values(): map := {
	if not rule_varying_known {
		rule_varying = varying_of(statements_in(rule_program))
		rule_varying_known = yes
	}
	rule_varying
}
varying_of(statements: list): map := {
	varying = {}
	for name in statements.fold([], (bound, statement) => names_bound(statement, bound)) { varying[name] = yes }
	readings = statements.map(reading).filter(read => read != ø and not varying.has(read#1))
	grown = yes
	while grown {
		grown = no
		for read in readings {
			if not varying.has(read#1) and read#2.any(name => varying.has(name)) {
				varying[read#1] = yes
				grown = yes
			}
		}
	}
	assigned = {}
	for n in nodes_in(rule_program) { if is_key(n, Op.Assign) and key_of(n) is symbol { assigned[name_of(key_of(n))] = yes } }
	values = {}
	for statement in statements {
		if is_charged_value(statement) and varying.has(name_of(key_of(statement))) and not assigned.has(name_of(key_of(statement))) { values[name_of(key_of(statement))] = yes }
	}
	values
}
# [name, the names it mentions] of a function or value definition, else ø
reading(statement: Node): list? := {
	parts = definition_of(statement)
	if parts != ø { return [parts.name, mentioned_names(parts.body, [])] }
	if is_charged_value(statement) then [name_of(key_of(statement)), mentioned_names(value_of(statement), [])] else ø
}
is_charged_value(n: Node): bool := is_key(n, Op.Define) and key_of(n) is symbol and not is_lambda(value_of(n)) and not mentions(value_of(n), implicit_parameter)

# a name a definition around the code binds, a parameter or a local (`listed = …; assigned or listed`): it shadows the
# program's function and the library word of that name (notes/dispatch.md: shadowing is scoped), so `x | listed` is
# no pipe and `count xs` of a local count no call
locally_bound(code: Node): bool := code is symbol and name_of(code) in rule_binding

# `method`, `shadowed`: a condition about where the matched code stands, not about a hole
is_context_word(condition: Node): bool := condition is symbol and name_of(condition) in context_words

# `$f in [add, push]` (the parser reads `$f is in […]` as it): the hole and the words listed (names, or texts naming
# them)
class Membership { hole: text; words: list }

membership(condition: Node): Membership? := {
	if not (is_group(condition) and bracket_of(condition) == "" and #condition == 3 and condition#2 == symbol(listed_word)) { return ø }
	hole = rule_hole(condition#1)
	words = listed_words(condition#3)
	if hole == ø or words == ø then ø else Membership{hole: hole, words: words}
}

# `[add, "push"]`: the words listed, names or texts naming them, else ø
listed_words(listing: Node): list? := {
	if not (is_group(listing) and bracket_of(listing) == "[") { return ø }
	words = items_of(listing)
	if words.all(word => word is symbol or word is text) then words.map(word => if word is symbol then name_of(word) else word) else ø
}

# whether the code is a word of the list, as a name or a text
word_listed(code: Node, words: list): bool := (code is symbol and name_of(code) in words) or (code is text and code in words)

# the word the code starts with: itself, a call's or a phrase's first word, else ø
starting_word(code: Node): Node := {
	if code is symbol { return code }
	if is_group(code) and #code > 0 and (bracket_of(code) == "(" or bracket_of(code) == "") and code#1 is symbol then code#1 else ø
}

# `method`: the code is the method part of the `.` being walked, `f(…)` of `x.f(…)`, `f` of `x.f`; `shadowed`: a
# definition around it binds the word it starts with, as a parameter or in its body (`f(t) := { parse = x => 7;
# parse(t) }`, notes/dispatch.md: shadowing is scoped)
context_holds(code: Node, context: text): bool := {
	if code == ø { return no }
	if context == "method" { return rule_method_part != ø and code == rule_method_part }
	locally_bound(starting_word(code))
}

# bottom_up for the rules, keeping where the node they try stands (rule_method_part, rule_binding): the method part
# of a `.` is tried as such, a definition's parts inside the names it binds
bottom_up_placed(n: Node, f: function): Node := {
	if is_key(n, Op.Dot) {
		left = bottom_up_placed(key_of(n), f)
		part = children(value_of(n), x => bottom_up_placed(x, f))
		outer_part = rule_method_part
		rule_method_part = part
		right = f(part)
		rule_method_part = outer_part
		return f(Key(left, Op.Dot, right))
	}
	if not is_key(n, Op.Define) { return f(children(n, x => bottom_up_placed(x, f))) }
	outer = rule_binding
	rule_binding = rule_binding + bound_by_definition(n)
	walked = children(n, x => bottom_up_placed(x, f))
	rule_binding = outer
	f(walked)
}

# the names a definition binds inside it: its parameters, the names its body's statements declare
bound_by_definition(definition: Node): list := {
	names = []
	head = untyped_head(key_of(definition))
	if is_group(head) and #head > 1 {
		for parameter in items_of(head)[1 ..] {
			name = leftmost_name(parameter)
			if name != ø { names += [name] }
		}
	}
	declared_within(value_of(definition), names)
}
# the call `f(x)` of a definition's head `f(x): T` typing its result, else the head
untyped_head(head: Node): Node := if is_key(head, Op.Colon) then key_of(head) else head
# the names the statements of a body declare, those of its nested blocks too (an if's branch, the block `the result:
# T = {…}` of a typed result), added to `names`; not inside a definition of its own, which binds its names itself
declared_within(code: Node, names: list): list := {
	if is_key(code, Op.Define) { return names }
	found = names
	name = declared_name(code)
	if name != ø and name not in found { found += [name] }
	if code is key { return declared_within(value_of(code), declared_within(key_of(code), found)) }
	if is_group(code) { for part in items_of(code) { found = declared_within(part, found) } }
	found
}

# `3`, `-1`, `(-1)`: a number written as such
is_number_literal(code: Node): bool := {
	written = unparenthesized(code)
	written is number or (is_minus(written) and value_of(written) is number)
}

unparenthesized(code: Node): Node := if is_group(code) and bracket_of(code) == "(" and #code == 1 then unparenthesized(code#1) else code

is_minus(code: Node): bool := is_key(code, Op.Neg) or (is_key(code, Op.Sub) and key_of(code) == ø)

# the number a literal writes
number_of(code: Node): number := {
	written = unparenthesized(code)
	if written is number then written else 0 - value_of(written)
}

# `a < b` as the comparison asks it
literal_compared(a: number, comparison: Node, b: number): bool := {
	if is_key(comparison, Op.Lt) { return a < b }
	if is_key(comparison, Op.Gt) { return a > b }
	if is_key(comparison, Op.Le) { return a <= b }
	if is_key(comparison, Op.Ge) { return a >= b }
	if is_key(comparison, Op.Eq) { return a == b }
	a != b
}

# `($a; $b)`: statements that take the rewritten statement's place, also `($v += 1 for $v in $vs...)`, one for each
# item; `(f(x) := …)`: the definition, its parentheses only keep the rule's `=>` off it; parentheses around any one
# template only group it, so that an operator binding looser than `=>` stays in it (`=> ($h($p...): $t := {$b...})`)
statements_template(template: Node): Node := {
	if is_round(template) and #template == 1 and is_key(template#1, Op.Define) { return template#1 }
	if is_group(template) and bracket_of(template) == "(" and separator_of(template) in statement_separators {
		return separated(bracketed(items_of(template), ""), separator_of(template))
	}
	if is_group(template) and bracket_of(template) == "(" and (is_each(template) or (#template == 1 and is_each(template#1))) {
		return separated(bracketed([if #template == 1 then template#1 else rule_phrase(items_of(template))], ""), ";")
	}
	if is_parenthesized(template) { return template#1 }
	template
}

# `(for $x in $c $body)`: parentheses around the words of a statement only group them
statement_pattern(pattern: Node): Node := {
	if is_group(pattern) and (bracket_of(pattern) == "(" or bracket_of(pattern) == "") and separator_of(pattern) == " " and #pattern > 1 {
		return rule_phrase(words_of_all(items_of(pattern)))
	}
	pattern
}

rule_phrase(words: list): Node := List(words, Bracket.None, Separator.Space)

# the words of a phrase, its unbracketed groups taken apart
words_of(part: Node): list := match part {
	List(items, Bracket.None, Separator.Space): words_of_all(items)
	_: [part]
}
words_of_all(parts: list): list := {
	words = []
	for part in parts { words += words_of(part) }
	words
}

# `$x`: the hole's name, else ø
rule_hole(n: Node): text? := {
	if not (n is symbol) { return ø }
	name = name_of(n)
	if #name > 1 and name.starts_with(rule_hole_mark) then name else ø
}

# `$xs...`: the rest hole's name, else ø
rest_hole_name(n: Node): text? := match n {
	Key(start, op, end): { if (op == Op.Range or op == Op.To) and end == ø then rule_hole(start) else ø }
	_: ø
}

# `$x: text`: the hole and the kind of code it takes
class TypedHole { hole: text; kind: text }

typed_hole(n: Node): TypedHole? := match n {
	Key(hole, Op.Colon, kind): { if rule_hole(hole) != ø and kind is symbol and name_of(kind) in hole_kinds then TypedHole{hole: rule_hole(hole), kind: name_of(kind)} else ø }
	_: ø
}

is_hole_kind(code: Node, kind: text): bool := {
	if kind == "text" { return code is text }
	if kind == "number" { return code is number or is_big_number_view(code) }
	if kind == "int" { return code is int or (is_big_number_view(code) and not value_of(code)#2.contains(".")) }
	if kind == "list" { return is_group(code) and bracket_of(code) == "[" }
	if kind == "block" { return is_curly_group(code) and not is_braced_map(code) }
	if kind == "map" { return (is_curly_group(code) and is_braced_map(code)) or (code is symbol and rule_maps.has(name_of(code))) }
	code is symbol and rule_hole(code) == ø
}

# the names a program gives only maps: a parameter typed map (`f(m: map)`), or a name every assignment of which is a
# map written out (`m = {a: 1}`); a name also given anything else holds no map for sure
map_names_of(program: Node): map := map_names_in(outer_nodes_in(program), {})

# the names among the outer maps and those the nodes assign a written map or declare a parameter `map` that hold
# only maps there: a name the nodes assign another value or declare another type (`found: list`) is no map
map_names_in(nodes: list, outer: map): map := {
	maps = {}
	others = {}
	for n in nodes {
		if is_key(n, Op.Assign) and key_of(n) is symbol {
			name = name_of(key_of(n))
			if is_curly_group(value_of(n)) and is_braced_map(value_of(n)) { maps[name] = yes } else { others[name] = yes }
		}
		if is_key(n, Op.Colon) and key_of(n) is symbol and value_of(n) is symbol {
			if value_of(n) == symbol("map") { maps[name_of(key_of(n))] = yes } else { others[name_of(key_of(n))] = yes }
		}
	}
	only_maps = {}
	for name in outer.keys { if not others.has(name) { only_maps[name] = yes } }
	for name in maps.keys { if not others.has(name) { only_maps[name] = yes } }
	only_maps
}

# the node walked bottom-up by f, rule_maps holding the names that hold a map where f meets each node: those of the
# program, inside a function its own over them, as Rust's Names::within (a list `found` beside another function's
# map `found`; a nested function's maps stay its own)
map_scoped_bottom_up(n: Node, f: function, maps: map): Node := {
	inner = if is_function_definition(n) then map_names_in(nodes_in(key_of(n)) + outer_nodes_in(value_of(n)), maps) else maps
	walked = children(n, x => map_scoped_bottom_up(x, f, inner))
	rule_maps = maps
	f(walked)
}

# bottom_up_placed and map_scoped_bottom_up in one walk, for the rules: the method part of a `.` tried as such, a
# definition's parts inside the names it binds (rule_method_part, rule_binding), and rule_maps holding the names that
# hold a map where f meets each node, a function's own inside it (merge of engine-rule-conditions with main's
# map scoping)
placed_map_scoped(n: Node, f: function, maps: map): Node := {
	inner = if is_function_definition(n) then map_names_in(nodes_in(key_of(n)) + outer_nodes_in(value_of(n)), maps) else maps
	if is_key(n, Op.Dot) {
		left = placed_map_scoped(key_of(n), f, inner)
		part = children(value_of(n), x => placed_map_scoped(x, f, inner))
		outer_part = rule_method_part
		rule_method_part = part
		rule_maps = maps
		right = f(part)
		rule_method_part = outer_part
		rule_maps = maps
		return f(Key(left, Op.Dot, right))
	}
	if not is_key(n, Op.Define) {
		walked = children(n, x => placed_map_scoped(x, f, inner))
		rule_maps = maps
		return f(walked)
	}
	outer = rule_binding
	outer_defining = rule_defining
	rule_binding = rule_binding + bound_by_definition(n)
	rule_defining = head_word(key_of(n))
	walked = children(n, x => placed_map_scoped(x, f, inner))
	rule_binding = outer
	rule_defining = outer_defining
	rule_maps = maps
	f(walked)
}

# name → the enum whose cases it holds: a parameter typed with an enum (`c: Coin`), or a name every assignment of which
# is a case of one enum (`c = Coin.Dime`, `c = Dime`); a name also given anything else holds no case for sure
case_holders_of(program: Node): map := case_holders_in(nodes_in(program))
case_holders_in(nodes: list): map := {
	holders = {}
	others = {}
	for n in nodes {
		if is_key(n, Op.Assign) and key_of(n) is symbol {
			name = name_of(key_of(n))
			enum_name = enum_of_case(value_of(n))
			if enum_name != "" and (not holders.has(name) or holders[name] == enum_name) { holders[name] = enum_name } else { others[name] = yes }
		}
		if is_key(n, Op.Colon) and key_of(n) is symbol and named_enum(value_of(n)) != "" { holders[name_of(key_of(n))] = named_enum(value_of(n)) }
	}
	only_cases = {}
	for name in holders.keys { if not others.has(name) { only_cases[name] = holders[name] } }
	only_cases
}

# the enum a case written belongs to, `Dime` of the one enum declaring it, `Coin.Dime`, `Coin::Dime`; else ""
enum_of_case(code: Node): text := {
	if (is_key(code, Op.Dot) or is_key(code, Op.Scope)) and named_enum(key_of(code)) != "" and value_of(code) is symbol {
		return if name_of(value_of(code)) in rule_enums[named_enum(key_of(code))] then named_enum(key_of(code)) else ""
	}
	if not (code is symbol) { return "" }
	owners = rule_enums.keys.filter(name => name_of(code) in rule_enums[name])
	if #owners == 1 then owners#1 else ""
}

# `{a: 1, b: 2}`: braces of entries only, a map written out, not a block of code
is_braced_map(code: Node): bool := #code > 0 and items_of(code).all(item => is_key(item, Op.Colon) and key_of(item) != opaque_symbol)

# the pattern's words that are no holes
literal_words(pattern: Node): list := mentioned_names(pattern, []).filter(name => not name.starts_with(rule_hole_mark))

first_word_of(pattern: Node): text? := {
	if pattern is symbol { return if rule_hole(pattern) == ø then name_of(pattern) else ø }
	for part in parts_of(pattern) {
		word = first_word_of(part)
		if word != ø { return word }
	}
	ø
}

# `($a /!= $b)`, `($x in $xs)`: parentheses around one pattern only group it, so that an operator binding looser than
# `=>` stays in the pattern; a phrase in them matches only a phrase of just those words (`y = 2 in xs`), never a run
# of a longer one (`[x for x in xs]`)
is_parenthesized(pattern: Node): bool := is_group(pattern) and bracket_of(pattern) == "(" and #pattern == 1

# a rule whose phrase pattern matches runs of a phrase
matches_runs(rule: Rule): bool := not rule.whole and is_run_pattern(rule.pattern)

# a pattern of words without a rest: it matches runs of a phrase
is_run_pattern(pattern: Node): bool := match pattern {
	List(words, Bracket.None, Separator.Space): not words.any(word => rest_hole_name(word) != ø)
	_: no
}

# the node rewritten by the first rule matching it, a statement sequence's statement sequences spliced in, a phrase's
# runs rewritten, over its words as written (the parser nests `keep 1 past 3` as `keep 1 (past 3)`); the rules of a
# place rewrite the node's parts standing there first
rule_rewritten(n: Node, rules: list, origins: list): Node := {
	if is_group(n) and separator_of(n) in statement_separators {
		n = group_like(n, statement_runs(spliced_statements(items_of(n).map(statement => at_place(statement, Place.Statement, rules, origins))), rules, origins))
	} else if is_group(n) and #n > 0 {
		if is_element_list(n) { n = group_like(n, items_of(n).map(element => at_place(element, Place.Element, rules, origins))) }
		phrase = bracket_of(n) == "" and separator_of(n) == " "
		items = items_of(n)
		runs = with_runs(if phrase then words_of_all(items) else items, rules, origins)
		if phrase and runs == words_of_all(items) { runs = items }
		# a phrase all one run takes the place the phrase stands in: a statement's template of statements stays the
		# statements (`$f(x) := …` defines f where the phrase stood), a value's turns into its block (as_value) there
		n = if phrase and #runs == 1 then runs#1 else group_like(n, runs.map(as_value))
	} else if n is key {
		n = if key_of(n) == opaque_symbol then with_changed_members(n, member => at_place(member, Place.Member, rules, origins)) else with_placed_parts(n, (code, place) => at_place(code, place, rules, origins))
	}
	for index in 0 ..< #rules {
		if rules[index].place == Place.Anywhere and not matches_runs(rules[index]) {
			result = rule_applied(rules[index], origins[index], n)
			if result != ø { return rewritten_again(result, rules, origins) }
		}
	}
	n
}

# the statements with each run a rule of several statements `($a; $b)` matches rewritten (F6), right to left (F13): a
# run is rewritten after the runs that follow it, so a rule for the first two clauses of `fib(0) := 0; fib(1) := 1;
# fib(n) := …` sees the last two already joined, what follows them
statement_runs(statements: list, rules: list, origins: list): list := {
	at = #statements - 1
	while at >= 0 {
		found = statement_run_at(statements[at ..], rules, origins)
		shorter = no
		if found != ø {
			made = spliced_statements([rewritten_again(found#2, rules, origins)])
			statements = statements[0 ..< at] + made + statements[at + found#1 ..]
			# a run made shorter is tried again where it stands, with the statements after it (F12): a pairwise rule
			# `(add_up($a); add_up($b)) => add_up($a + $b)` folds a whole run; a run as long or longer moves on, so the
			# rules can't loop here
			shorter = #made < found#1
		}
		if not shorter { at -= 1 }
	}
	statements
}

# [how many statements starting the list a rule of several statements matches, its rewrite], else ø
statement_run_at(statements: list, rules: list, origins: list): list? := {
	for index in 0 ..< #rules {
		rule = rules[index]
		if rule.place == Place.Anywhere and is_statements_pattern(rule.pattern) and #statements >= #rule.pattern {
			run = statements[0 ..< #rule.pattern]
			bound = {}
			if each_matches(items_of(rule.pattern), run, bound) and conditions_hold(rule, origins[index], bound) {
				return [#rule.pattern, fired(rule, rule_spliced(rule.template, bound, run#1))]
			}
		}
	}
	ø
}

# `($a; $b)`: a pattern of several statements
is_statements_pattern(pattern: Node): bool := is_group(pattern) and bracket_of(pattern) == "(" and separator_of(pattern) in statement_separators and #pattern > 1

# the statements, those a template made of several spliced in
spliced_statements(statements: list): list := {
	spliced = []
	for statement in statements { spliced += if is_group(statement) and bracket_of(statement) == "" and separator_of(statement) in statement_separators then items_of(statement) else [statement] }
	spliced
}

# the key with its condition (`if c`, `while c`), its key and value (`k: v`), a definition's parameters (F10) rewritten
# by `placed_code` (code, place) with the rules of that place, a template's statements in its parts their blocks
with_placed_parts(n: Node, placed_code: function): Node := {
	left = key_of(n)
	right = value_of(n)
	if (is_key(n, Op.If) or is_key(n, Op.While)) and left == ø { right = placed_code(right, Place.Condition) }
	if is_key(n, Op.Colon) {
		left = placed_code(left, Place.PairKey)
		right = placed_code(right, Place.PairValue)
	}
	if is_key(n, Op.Define) { left = head_with_parameters(left, parameter => placed_code(parameter, Place.Parameter)) }
	if not changes(left, key_of(n)) and not changes(right, value_of(n)) and not is_statements_template(left) and not is_statements_template(right) { return n }
	placed(Key(as_value(left), op_of(n), as_value(right)), n)
}

# the head of `f(a, b) := …` (also `f(a): T`) with each parameter changed, its name kept (F10)
head_with_parameters(head: Node, changed: function): Node := {
	if is_key(head, Op.Colon) {
		inner = head_with_parameters(key_of(head), changed)
		return if inner == key_of(head) then head else placed(Key(inner, Op.Colon, value_of(head)), head)
	}
	if not (is_round(head) and #head > 1 and head#1 is symbol) { return head }
	parameters = items_of(head)[1 ..]
	rewritten = parameters.map(changed)
	if rewritten == parameters then head else placed(group_like(head, [head#1] + rewritten), head)
}

# a class with each item of its body changed: the passes see it as the opaque view ["type", name, body]
with_changed_members(n: Node, changed: function): Node := {
	if not (n is key and key_of(n) == opaque_symbol) { return n }
	view = value_of(n)
	if kind_of(view) != "type" { return n }
	# stage_node keeps an empty map `{}` (a field default) as the opaque `{}`; node_of would read it as ø
	body = stage_node(view#3)
	if not is_group(body) { return n }
	members = spliced_statements(items_of(body).map(changed))
	Key(key_of(n), op_of(n), [view#1, view#2, view_of(group_like(body, members))])
}

# the code rewritten by the first rule of the place matching it, its result again by the rules of the place, until none
# matches (`loudly gently f() := 3` loses both words to the rules `loudly $s...` and `gently $s...`, card
# engine-placed-where-chain)
at_place(n: Node, place: Place, rules: list, origins: list): Node := {
	for index in 0 ..< #rules {
		if rules[index].place == place {
			result = rule_applied(rules[index], origins[index], n)
			if result != ø {
				again = rewritten_again(result, rules, origins)
				if rewrite_depth >= rewrite_depth_limit { return error_node("the rewrite rules loop: each result matches a rule again, " + rewrite_depth_limit + " times in a row") }
				rewrite_depth += 1
				chained = at_place(again, place, rules, origins)
				rewrite_depth -= 1
				return chained
			}
		}
	}
	n
}

# a template's statements in a value's place: their block `(t = a; t)`
as_value(n: Node): Node := if is_statements_template(n) then placed(separated(bracketed(items_of(n), "("), separator_of(n)), n) else n

is_statements_template(n: Node): bool := is_group(n) and bracket_of(n) == "" and separator_of(n) in statement_separators and #n > 1

# the items with each run a phrase rule matches rewritten, left to right
with_runs(items: list, rules: list, origins: list): list := {
	at = 0
	while at < #items {
		found = run_at(items[at ..], rules, origins)
		if found == ø {
			at += 1
		} else {
			replaced = words_of(rewritten_again(found#2, rules, origins))
			items = items[0 ..< at] + replaced + items[at + found#1 ..]
			at += #replaced
		}
	}
	items
}

# a rule's result rewritten again by the rules, its parts first, until none fires (F7): `quadruple 3` → `double
# (double 3)` → `(3 * 2) * 2`; a result rewritten more than rewrite_depth_limit times in a row is the rules' loop
rewritten_again(result: Node, rules: list, origins: list): Node := {
	if rewrite_depth >= rewrite_depth_limit { return error_node("the rewrite rules loop: each result matches a rule again, " + rewrite_depth_limit + " times in a row") }
	rewrite_depth += 1
	again = bottom_up(result, n => rule_rewritten(n, rules, origins))
	rewrite_depth -= 1
	again
}

# [the length of a run starting the items that a phrase rule matches, its rewrite], else ø; a run starting with `x = v`
# or `x: v`, also bound again (`global: x = v`, the parser's `global x = 7 m/s`), rewrites v
run_at(items: list, rules: list, origins: list): list? := {
	for index in 0 ..< #rules {
		rule = rules[index]
		if rule.place == Place.Anywhere and matches_runs(rule) and #items >= #rule.pattern {
			run = items[0 ..< #rule.pattern]
			first = run#1
			run = [bound_value(first)] + run[1 ..]
			result = rule_applied(rule, origins[index], rule_phrase(run))
			if result != ø { return [#rule.pattern, rebound(first, result)] }
			split = operand_run(rule, origins[index], run + items[#rule.pattern ..])
			if split != ø { return [split#1, rebound(first, split#2)] }
		}
	}
	ø
}
holds_binding(n: Node): bool := is_key(n, Op.Assign) or (is_key(n, Op.Colon) and not is_big_number_view(n))
# the value innermost in the bindings `x = v`, `global: x = v`, else the node
bound_value(n: Node): Node := if holds_binding(n) then bound_value(value_of(n)) else n
# the bindings with the value innermost in them changed (bound_value)
rebound(n: Node, value: Node): Node := if not holds_binding(n) then value else placed(Key(key_of(n), op_of(n), if holds_binding(value_of(n)) then rebound(value_of(n), value) else as_value(value)), n)
# `2 km + 500 m`, which the parser keeps as `2 (km + 500) m`: a run whose last word stands as the leftmost operand of
# an arithmetic or ordering operation; the run's rewrite takes that operand's place, and the words after the operation
# join its rightmost operand: `(2 * km) + (500 m)` (card int-text)
operand_run(rule: Rule, origin: map, items: list): list? := {
	last = items[#rule.pattern - 1]
	if not is_infix_operation(last) { return ø }
	result = rule_applied(rule, origin, rule_phrase(items[0 ..< #rule.pattern - 1] + [leftmost_operand(last)]))
	if result == ø { return ø }
	[#items, with_rightmost(with_leftmost(last, as_value(result)), items[#rule.pattern ..])]
}
is_infix_operation(n: Node): bool := n is key and key_of(n) != ø and (op_of(n) in arithmetic_operators or op_of(n) in ordering_operators)
leftmost_operand(n: Node): Node := if is_infix_operation(n) then leftmost_operand(key_of(n)) else n
with_leftmost(n: Node, operand: Node): Node := if is_infix_operation(n) then placed(Key(with_leftmost(key_of(n), operand), op_of(n), value_of(n)), n) else operand
with_rightmost(n: Node, words: list): Node := {
	if #words == 0 { return n }
	if is_infix_operation(n) { return placed(Key(key_of(n), op_of(n), with_rightmost(value_of(n), words)), n) }
	rule_phrase([n] + words)
}

# the rule's template for the node; a block of a statement the pattern matches keeps its block
rule_applied(rule: Rule, origin: map, n: Node): Node := {
	if rule_defining != "" and first_word_of(rule.template) == rule_defining { return ø }
	bound = {}
	if rule_matches(rule.pattern, n, bound) and conditions_hold_at(rule, origin, bound, n) { return fired(rule, rule_spliced(rule.template, bound, n)) }
	if not (is_group(rule.pattern) and bracket_of(rule.pattern) == "" and is_curly_group(n)) { return ø }
	bound = {}
	statement = separated(bracketed(items_of(n), ""), separator_of(n))
	if not (rule_matches(rule.pattern, statement, bound) and conditions_hold_at(rule, origin, bound, n)) { return ø }
	fired(rule, List(statements_in(rule_spliced(rule.template, bound, n)), Bracket.Curly, Separator.Semicolon))
}

fired(rule: Rule, result: Node): Node := {
	# (the prelude is in every program already: a use of it once more is none, card prelude-rule)
	if rule.module != "" and rule.module != "prelude" { fired_modules += [rule.module] }
	if rule.alias { diagnose(call_of("alias_word", [symbol(first_word_of(rule.pattern)), symbol(first_word_of(rule.template))]), result) }
	result
}

# the rule's `where` conditions hold of what its holes bound
conditions_hold(rule: Rule, origin: map, bound: map): bool := origin_holds(rule, origin, bound) and rule.conditions.all(condition => condition_holds(condition, bound))

# the conditions hold of the code n the rule matched, which the context conditions ask where it stands
conditions_hold_at(rule: Rule, origin: map, bound: map, n: Node): bool := {
	rule_matched = n
	holding = conditions_hold(rule, origin, bound)
	rule_matched = ø
	holding
}

# `where $c = shape`: the hole binds a name of the variables assigned that shape
origin_holds(rule: Rule, origin: map, bound: map): bool := {
	if rule.shape == ø { return yes }
	code = bound[name_of(rule.hole)]
	code is symbol and origin.has(name_of(code))
}

# whether the code has the pattern's shape: a hole binds the subtree there, a repeated hole must be the same subtree, a
# key has the same operator, a group the same bracket and length (a rest hole binds the items from there on), other
# parts are equal
rule_matches(pattern: Node, code: Node, bound: map): bool := {
	affix = affixed_hole(pattern)
	if affix != ø { return affix_matches(affix, code, bound) }
	hole = rule_hole(pattern)
	if hole != ø { return hole_binding(hole, code, bound) }
	typed = typed_hole(pattern)
	if typed != ø { return is_hole_kind(code, typed.kind) and hole_binding(typed.hole, code, bound) }
	if pattern is key { return code is key and op_of(code) == op_of(pattern) and rule_matches(key_of(pattern), key_of(code), bound) and rule_matches(value_of(pattern), value_of(code), bound) }
	if is_group(pattern) { return is_group(code) and bracket_of(code) == bracket_of(pattern) and tuple_fits(pattern, code) and phrase_fits(pattern, code) and items_match(items_of(pattern), items_of(code), bound) and one_statement_kept(pattern, code, bound) }
	if code is key or is_group(code) { return no }
	pattern == code
}

# a tuple pattern `($a, $b)` matches a tuple, never the call `f(a, b)`, whose parentheses hold no commas
tuple_fits(pattern: Node, code: Node): bool := not (bracket_of(pattern) == "(" and separator_of(pattern) == ",") or separator_of(code) == ","
# an unbracketed phrase pattern `$x.$f $b $a...` matches a phrase, never a sequence of statements (a block `{$b...}`
# matches its statements)
phrase_fits(pattern: Node, code: Node): bool := bracket_of(pattern) != "" or separator_of(pattern) != " " or not (separator_of(code) in statement_separators)

items_match(patterns: list, items: list, bound: map): bool := {
	rest_at = ø
	for index in 0 ..< #patterns { if rest_at == ø and rest_hole_name(patterns[index]) != ø { rest_at = index } }
	if rest_at == ø { return each_matches(patterns, items, bound) }
	after = #patterns - rest_at - 1
	if #items < rest_at + after { return no }
	rest_end = #items - after
	each_matches(patterns[0 ..< rest_at], items[0 ..< rest_at], bound) and each_matches(patterns[rest_at + 1 ..], items[rest_end ..], bound) and hole_binding(rest_hole_name(patterns[rest_at]), rule_phrase(items[rest_at ..< rest_end]), bound)
}

each_matches(patterns: list, items: list, bound: map): bool := {
	if #patterns != #items { return no }
	for index in 0 ..< #patterns { if not rule_matches(patterns[index], items[index], bound) { return no } }
	yes
}

# `{$b...}` matching a block of one statement, `{sum xs}` (its words the curly group's own, no statements): the rest
# binds that block itself, so a template's `{$b...}` gives it back as one statement (is_one_statement)
one_statement_kept(pattern: Node, code: Node, bound: map): bool := {
	if is_block_of_rest(pattern) and separator_of(code) == " " and #code > 1 { bound[rest_hole_name(pattern#1)] = code }
	yes
}
# a rest hole's binding that is a block of one statement (one_statement_kept)
is_one_statement(binding: Node): bool := is_curly_group(binding) and separator_of(binding) == " "

# `$op=`, `.$op`: a hole of the operator a compound assignment or an element-wise form is written with (decisions
# op-assign-general, dot-operators-now) as [hole, before, after]: `x ^= 3` binds ^, `xs .< 2` binds <
affixed_hole(n: Node): list? := {
	if not (n is symbol) { return ø }
	name = name_of(n)
	if #name > 2 and name.starts_with(rule_hole_mark) and name.ends_with("=") { return [name[0 ..< #name - 1], "", "="] }
	if #name > 2 and name.starts_with("." + rule_hole_mark) { return [name[1 ..], ".", ""] }
	ø
}
affix_matches(affix: list, code: Node, bound: map): bool := {
	if not (code is symbol) { return no }
	written = name_of(code)
	before = affix#2
	after = affix#3
	inner = #written - #before - #after
	if inner <= 0 or not written.starts_with(before) or not written.ends_with(after) or canonical_operator(written) != "" { return no }
	spelling = written[#before ..< #before + inner]
	if not (operates(spelling) and hole_binding(affix#1, symbol(spelling), bound)) { return no }
	bound[affixed_mark(affix#1)] = yes
	yes
}
# the note in a binding that a hole holds an operator (affix_matches), for bound_operation
affixed_mark(hole: text): text := "affixed·" + hole
# an operator's spelling `x op= y` and `xs .op ys` are written with: one computing a value (parser computes), or a
# function's word, `x max= 5`, also an element-wise one, `xs .*= 2`; `<=` and `:=` are operators of their own (affix_matches)
operates(spelling: text): bool := if spelling#1 == '.' and #spelling > 1 then operates(spelling[1 ..]) else if is_name_start(spelling#1) then canonical_operator(spelling) == "" or computes(canonical_operator(spelling)) else computes(canonical_operator(spelling))
# `$a $op $b` of a template, its hole bound to an operator's spelling (affixed_hole): the operation, a function's word
# its call, `x max 5` max(x, 5), an element-wise form the phrase the sugar reads on
bound_operation(template: Node, items: list, bound: map): Node? := {
	if not (is_group(template) and separator_of(template) == " " and bracket_of(template) in ["", "("] and #template == 3 and #items == 3 and rule_hole(template#2) != ø and items#2 is symbol) { return ø }
	if not bound.has(affixed_mark(rule_hole(template#2))) or bound.get(rule_hole(template#2)) != items#2 { return ø }
	spelling = name_of(items#2)
	if spelling.starts_with(".") { return ø }
	canonical = canonical_operator(spelling)
	if canonical != "" { return operation(items#1, canonical, items#3) }
	if is_name_start(spelling#1) then call_of(spelling, [items#1, items#3]) else operator_call(spelling, [items#1, items#3])
}
hole_binding(name: text, code: Node, bound: map): bool := {
	if bound.has(name) { return bound[name] == code }
	bound[name] = code
	yes
}

# the template with each hole's code, a rest hole's items in its place, a hole the pattern didn't bind a fresh name;
# what the template itself adds is placed at the rewritten code `at`
rule_spliced(template: Node, bound: map, at: Node): Node := {
	hole = rule_hole(template)
	if hole != ø {
		if not bound.has(hole) { bound[hole] = placed(fresh_name(hole), at) }
		return bound[hole]
	}
	# a bare rest template `$s...` is the words its hole bound, rebuilt as a phrase: `public static fun f() := 3`
	# under `rewrite public $s... => $s...` is `static fun f() := 3`
	rest = rest_hole_name(template)
	if rest != ø and bound.has(rest) { return as_phrase(items_of(bound[rest])) }
	if is_glue(template) { return placed(glued_name(items_of(template)[1 ..].map(part => rule_spliced(part, bound, at))), at) }
	if template is key { return placed(Key(rule_spliced(key_of(template), bound, at), op_of(template), rule_spliced(value_of(template), bound, at)), at) }
	if not is_group(template) { return placed(template, at) }
	parts = items_of(template)
	items = []
	index = 0
	while index < #parts {
		each = if index + 3 <= #parts then each_spliced(parts[index ..< index + 3], bound, at) ?? cases_spliced(parts[index ..< index + 3], bound, at) else ø
		if each != ø {
			items += each
			index += 3
		} else {
			item = parts[index]
			rest = rest_hole_name(item)
			inner = if is_group(item) and bracket_of(item) == "" then each_spliced(items_of(item), bound, at) else ø
			items += if inner != ø then inner else if rest != ø and bound.has(rest) then items_of(bound[rest]) else [rule_spliced(item, bound, at)]
			index += 1
		}
	}
	operated = bound_operation(template, items, bound)
	if operated != ø { return placed(operated, at) }
	if is_phrase(template) { return placed(as_phrase(items), at) }
	if is_block_of_rest(template) and bound.has(rest_hole_name(template#1)) and is_one_statement(bound[rest_hole_name(template#1)]) { return bound[rest_hole_name(template#1)] }
	placed(if is_block_of_rest(template) and #items > 1 then List(items, Bracket.Curly, Separator.Semicolon) else group_like(template, items), at)
}

# `{$b...}`: a block of a rest hole, whose statements a template gives back as statements
is_block_of_rest(n: Node): bool := is_curly_group(n) and #n == 1 and rest_hole_name(n#1) != ø

# the words as a phrase, one word as itself: `$a $b...` with $b binding nothing is $a
as_phrase(words: list): Node := if #words == 1 then words#1 else rule_phrase(words)
# the template with each `·` written between words and holes a name to build (F5, decision name-glue): `square·$a`,
# `$i·end`, `km·per·hour`, also the head of a call or definition `twice·$f(x)`; `·` beside anything else (`2·$x`) stays
# the product. The parser reads `·` as `*`, so the source text the rule was parsed from tells them apart
glued(template: Node, source: text): Node := {
	lines = if source.contains(glue_mark) then lines_of(source) else []
	bottom_up(template, n => headed_definition(if #lines == 0 then n else glued_key(hidden_glued(n), lines)))
}

# `a··b`, the parser's operator_··(a, b): their glue, joined by the mark
hidden_glued(n: Node): Node := {
	if not (is_round(n) and #n == 3 and n#1 == symbol(OPERATOR_FUNCTION_PREFIX + hidden_glue)) { return n }
	glue_of(glue_parts(n#2) + [symbol(hidden_joint)] + glue_parts(n#3))
}

# the parts a glue holds, else the one part
glue_parts(n: Node): list := if is_glue(n) then items_of(n)[1 ..] else [n]

# `a·b` of words and holes: their glue_marker group, a call `a·b(x)` with it as the head; else the node (a rest hole's
# words glue through its plain name: `$f·$ws` of `$ws...`)
glued_key(n: Node, lines: list): Node := {
	if not (is_key(n, Op.Mul) and glue_written(glue_parts(value_of(n))#1, lines)) { return n }
	left = key_of(n)
	right = value_of(n)
	parts = if is_glue(left) then items_of(left)[1 ..] else if is_glued_part(left) then [left] else ø
	if parts == ø { return n }
	if is_glued_part(right) or is_glue(right) { return glue_of(parts + glue_parts(right)) }
	if (is_round(right) or is_phrase(right)) and #right > 0 and is_glued_part(right#1) { return group_like(right, [glue_of(parts + [right#1])] + items_of(right)[1 ..]) }
	n
}

is_phrase(n: Node): bool := is_group(n) and bracket_of(n) == "" and separator_of(n) == " "

# `$f(x) := body` in a template, which the parser reads as `$f ((x) := body)`, and `twice·$f(x) := body`, read as
# `(twice·$f (x)) := body`: the definition of a function the holes name
headed_definition(n: Node): Node := {
	if is_phrase(n) and #n == 2 and is_head_part(n#1) and is_key(n#2, Op.Define) and is_round(key_of(n#2)) {
		return Key(bracketed([n#1] + items_of(key_of(n#2)), "("), Op.Define, value_of(n#2))
	}
	head = if is_key(n, Op.Define) then key_of(n) else ø
	if is_phrase(head) and #head == 2 and is_head_part(head#1) and is_round(head#2) {
		return Key(bracketed([head#1] + items_of(head#2), "("), Op.Define, value_of(n))
	}
	n
}

is_head_part(n: Node): bool := rule_hole(n) != ø or is_glue(n)

# a word or a hole: what `·` glues
is_glued_part(n: Node): bool := n is symbol

glue_of(parts: list): Node := List([symbol(glue_marker)] + parts, Bracket.Round, Separator.None)

is_glue(n: Node): bool := is_group(n) and bracket_of(n) == "(" and #n > 1 and n#1 == symbol(glue_marker)

# whether the source writes `·` right before the code, spaces between
glue_written(code: Node, lines: list): bool := {
	first = first_leaf(code)
	if first == ø { return no }
	line = line_of(first)
	column = column_of(first)
	if not (line is int and column is int) or line < 1 or line > #lines { return no }
	written: text = lines[line - 1]
	before = written[0 ..< min(column - 1, #written)]
	while before.ends_with(" ") { before = before[0 ..< #before - 1] }
	before.ends_with(glue_mark)
}

# the code's first word, number or text as written
first_leaf(n: Node): Node := {
	if not (n is key or is_group(n)) { return n }
	for part in parts_of(n) {
		if part != ø {
			leaf = first_leaf(part)
			if leaf != ø { return leaf }
		}
	}
	ø
}

# the name the spliced parts glue into, their words joined by name_joint (`square`, `a number` → square_a_number); a
# number among them makes it their product (`$n·ten` of 3 → 3 * ten)
glued_name(parts: list): Node := {
	if parts.any(is_number_literal) {
		product = parts#1
		for part in parts[1 ..] { product = Key(product, Op.Mul, part) }
		return product
	}
	name = ""
	joint = ""
	for part in parts {
		if part == symbol(hidden_joint) {
			joint = glue_mark
		} else {
			part_words = words_of(part)
			if not part_words.all(word => word is symbol) { return error_node("`·` builds a name of words, and a hole beside it bound other code") }
			name += joint + part_words.map(word => name_of(word)).join(name_joint)
			joint = name_joint
		}
	}
	symbol(name)
}

# `T for $x in $xs...`: T spliced once for each item the rest hole bound, $x bound to that item (and fresh names
# fresh for each), else ø. `$x at $i` also binds the item's position, from 1; `($a, $b) in ($as..., $bs...)` zips rest
# holes of as many items; any other pattern, `($k => $v)`, takes an item apart, an item it doesn't match staying as it
# is (F4)
each_spliced(parts: list, bound: map, at: Node): list? := {
	if #parts != 3 or parts#2 != symbol(each_word) { return ø }
	clause = parts#3
	if not (is_phrase(clause) and #clause == 3 and clause#2 == symbol(each_in_word)) { return ø }
	pattern = clause#1
	index_hole = ø
	if is_phrase(pattern) and #pattern == 3 and pattern#2 == symbol(each_at_word) and rule_hole(pattern#3) != ø {
		index_hole = rule_hole(pattern#3)
		pattern = pattern#1
	}
	rows = each_rows(clause#3, bound, at)
	if rows == ø { return ø }
	each = ungrouped_one(parts#1)
	spliced = []
	for position in 1 to #rows {
		binding = item_binding(pattern, rows#position, bound)
		if binding == ø {
			spliced += [rows#position#1]
		} else {
			if index_hole != ø { binding[index_hole] = position }
			spliced += [rule_spliced(each, binding, at)]
		}
	}
	spliced
}

# the items an each clause walks, a list per item: of a rest hole, the cases of an enum (`cases of $e`), or of several
# rest holes zipped (`($as..., $bs...)`, as many items each); else ø
each_rows(iterable: Node, bound: map, at: Node): list? := {
	rest = rest_hole_name(iterable)
	if rest != ø { return if bound.has(rest) then items_of(bound[rest]).map(item => [item]) else ø }
	cases = if is_phrase(iterable) then cases_spliced(items_of(iterable), bound, at) else ø
	if cases != ø { return cases.map(case => [case]) }
	if not (is_round(iterable) and #iterable > 1) { return ø }
	zipped = items_of(iterable).map(rest_hole_name)
	if zipped.any(name => name == ø) { return ø }
	known = zipped.filter(name => bound.has(name))
	if #known == 0 { return ø }
	count = #items_of(bound[known#1])
	# a rest hole the pattern didn't bind is as many fresh names as the others hold items, bound for the rest of the
	# firing (F11): `(($t = $x) for ($t, $x) in ($ts..., $xs...); [$ts...])`
	for name in zipped {
		if not bound.has(name) { bound[name] = rule_phrase(if count == 0 then [] else (1 to count).map(position => placed(fresh_name(name), at))) }
	}
	lists = zipped.map(name => items_of(bound[name]))
	if not lists.all(items => #items == count) { return ø }
	(1 to #lists#1).map(position => lists.map(items => items#position))
}

# the holes bound with an item's row: the pattern's hole its item, a tuple of holes the zipped items, any other pattern
# what matching the item binds; ø when the item doesn't match
item_binding(pattern: Node, row: list, bound: map): map? := {
	if rule_hole(pattern) != ø and #row == 1 { return with_binding(bound, rule_hole(pattern), row#1) }
	if is_round(pattern) and #pattern == #row and #row > 1 and items_of(pattern).all(part => rule_hole(part) != ø) {
		binding = with_binding(bound, rule_hole(pattern#1), row#1)
		for position in 2 to #row { binding[rule_hole(pattern#position)] = row#position }
		return binding
	}
	if #row != 1 { return ø }
	binding = copied_binding(bound)
	if rule_matches(ungrouped_one(pattern), ungrouped_one(row#1), binding) then binding else ø
}

# `(x)`, `(case $k: $v)`, `($ks..., $k => $v)`: parentheses around one item, a phrase or a comma list only group it
ungrouped_one(n: Node): Node := {
	if is_round(n) and #n == 1 { return n#1 }
	if is_round(n) and (separator_of(n) == " " or separator_of(n) == ",") { return separated(bracketed(items_of(n), ""), separator_of(n)) }
	n
}

# `cases of $e`: the cases of the enum the hole names, placed at `at`, else ø (F9)
cases_spliced(parts: list, bound: map, at: Node): list? := {
	if parts#1 != symbol(cases_words#1) or parts#2 != symbol(cases_words#2) { return ø }
	hole = rule_hole(parts#3)
	if hole == ø or not bound.has(hole) or named_enum(bound[hole]) == "" { return ø }
	enum_name = named_enum(bound[hole])
	rule_enums[enum_name].map(case => placed(Key(symbol(enum_name), Op.Dot, symbol(case)), at))
}

# `T for $x in $xs...`
is_each(n: Node): bool := is_group(n) and #n == 3 and n#2 == symbol(each_word)

# the template with `T for $x in $xs...` as each_spliced reads it, `T`, `for`, `$x in $xs...`: the parser groups the
# loop of a hole, `for $x in $xs...` with no body, as a loop of its own
each_clauses(template: Node): Node := bottom_up(template, n => if is_group(n) then group_like(n, indexed_clauses(items_of(n).flat_map(each_clause_parts))) else n)

# the items with `for $x at ($i in $xs...)`, as the parser reads the index, as `for` and `($x at $i) in $xs...`
indexed_clauses(items: list): list := {
	found = []
	at = 0
	while at < #items {
		indexed = at + 3 < #items and items[at] == symbol(each_word) and items[at + 2] == symbol(each_at_word) and is_phrase(items[at + 3]) and #items[at + 3] == 3 and items[at + 3]#2 == symbol(each_in_word)
		if indexed {
			clause = items[at + 3]
			# the iterable's words the parser left after the clause, `cases of` `$e`, up to the end or an `if`
			last = at + 4
			while last < #items and items[last] != symbol("if") { last += 1 }
			iterable = if last == at + 4 then clause#3 else List(words_of(clause#3) + items[at + 4 ..< last], Bracket.None, Separator.Space)
			found += [items[at], List([List([items[at + 1], items[at + 2], clause#1], Bracket.None, Separator.Space), clause#2, iterable], Bracket.None, Separator.Space)]
			at = last
		} else {
			found += [items[at]]
			at += 1
		}
	}
	found
}

# `for $x in $xs...` with no body as the parts `for` and `$x in $xs...`, any other item as it is
each_clause_parts(item: Node): list := {
	if not (is_phrase(item) and #item == 5 and item#1 == symbol(each_word) and item#3 == symbol(each_in_word) and item#5 == ø) { return [item] }
	[symbol(each_word), List([item#2, item#3, item#4], Bracket.None, Separator.Space)]
}

# a copy of the holes bound, the hole bound to the code
with_binding(bound: map, hole: text, code: Node): map := {
	copy = copied_binding(bound)
	copy[hole] = code
	copy
}

# a copy of the holes bound
copied_binding(bound: map): map := {
	copy = {}
	for name in bound.keys { copy[name] = bound[name] }
	copy
}

# `$t` → `t·3`: a compiler temporary (notes/compiler_temporaries.md), apart from every other firing's
fresh_name(hole: text): Node := {
	fresh_names += 1
	symbol(hole.remove_prefix(rule_hole_mark) + "·" + fresh_names)
}

# the variables assigned code of the shape, then the parameters of the functions called with one, until none is new
names_assigned_shape(program: Node, shape: Node): map := {
	names = {}
	functions = {}
	nodes = nodes_in(program)
	for n in nodes {
		if is_key(n, Op.Assign) and key_of(n) is symbol and rule_matches(shape, value_of(n), {}) { names[name_of(key_of(n))] = yes }
		if is_key(n, Op.Define) and is_round(key_of(n)) and #key_of(n) > 0 {
			head = items_of(key_of(n))
			functions[head_word(head#1)] = head[1 ..].map(parameter => head_word(parameter))
		}
	}
	growing = #names.keys > 0 and #functions.keys > 0
	while growing {
		growing = no
		for n in nodes {
			if is_round(n) and #n > 1 and n#1 is symbol and functions.has(name_of(n#1)) {
				parameters = functions[name_of(n#1)]
				arguments = items_of(n)[1 ..]
				for index in 0 ..< min(#parameters, #arguments) {
					argument = arguments[index]
					if argument is symbol and names.has(name_of(argument)) and not names.has(parameters[index]) {
						names[parameters[index]] = yes
						growing = yes
					}
				}
			}
		}
	}
	names
}
