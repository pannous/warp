# `print -1`, `f -x` parse as `print - 1`, `f - x`: a word that takes a value calls it with the negative, `f(-x)`
# (card pure-lane-print); a spaced `#xs` is the count already (decision spaced-hash-count).
# A name the program binds as a value subtracts: `size -1` of a variable size. A pass, not a rewrite
# rule: which words take a value (the program's functions with a parameter, untyped too, and the builtins of one
# value) is no `where` condition yet. `max xs > 0` before a comparison is fitted_comparison below.
use "walk.warp"
use "scope.warp"
use "../analysis/builtin_signatures.warp"
use "../parsing/parser.warp"

spaced_prefix_calls(program: Node) as Node := {
	takers = value_takers(program)
	own_types = own_parameter_types(program)
	bottom_up(prefix_calls(program, takers), n => fitted_comparison(n, own_types))
}


# the words of the program that take a value: print, its functions with a parameter (`f(x) := …`, `f := { it * 2 }`,
# `f = x => …`), a builtin of one value; not a name it binds as a value
value_takers(program: Node) as list := {
	scope = scope_of(program)
	(value_taking_functions(program) + value_taking_words()).filter(name => not binds_value(scope, name))
}

# the program's functions that take a value
value_taking_functions(program: Node) as list := nodes_in(program).map(n => value_function(n)).filter(name => name != ø)


value_function(n: Node) as any := match n {
	Key(head, op, body): {
		if not (op == Op.Define or op == Op.Assign) { return ø }
		if is_round(head) { return if #items_of(head) > 1 then head_word(head) else ø }
		if head is symbol and (is_lambda(body) or (op == Op.Define and mentions(body, implicit_parameter))) then name_of(head) else ø
	}
	_: ø
}

takes_value(word: Node, takers: list) as bool := word is symbol and name_of(word) in takers

prefix_calls(n: Node, takers: list) as Node := match n {
	Key(word, Op.Sub, argument): if takes_value(word, takers) then bracketed([word, negated(prefix_calls(argument, takers))], "(") else children(n, x => prefix_calls(x, takers))
	_: children(n, x => prefix_calls(x, takers))
}

# `-x` as the parser writes it
negated(argument: Node) as Node := if argument is number then 0 - argument else Key(ø, Op.Sub, argument)

# `f a > b` read by the fit of f's parameter, never by where the phrase stands (decision juxtaposition): f(a > b) when
# f takes a yes/no (print), (f a) > b when it doesn't (max of a list); the parser reads the first at a statement's start
# and the second after `=` or `if`. A function of the program whose parameter is untyped reads both ways: refused,
# naming both (decision untyped-fit-ambiguous); a word of no typed line stays as written
fitted_comparison(n: Node, own_types: map) as Node := {
	arms = compared_arms(n)
	if arms != ø { return arms }
	if n is key and op_of(n) in comparing_ops and is_word_phrase(key_of(n)) { return fitted(key_of(n)#1, key_of(n)#2, op_of(n), value_of(n), n, own_types) }
	if is_word_phrase(n) or is_round_word_phrase(n) { return chain_fitted(n#1, n#2, n, own_types) }
	n
}
# `sq 2 == 4 and yes`: the word fitted against the comparison its phrase's logical chain starts with, which it reads
# two ways as `sq 2 == 4` does: (sq 2) == 4 and yes, or sq(2 == 4 and yes); the written phrase for no comparison
chain_fitted(word: Node, chain: Node, written: Node, own_types: map) as Node := {
	if chain is key and op_of(chain) in comparing_ops { return fitted(word, key_of(chain), op_of(chain), value_of(chain), written, own_types) }
	if not (chain is key and op_of(chain) in logical_ops) { return written }
	first = chain_fitted(word, key_of(chain), written, own_types)
	if first is key then Key(first, op_of(chain), value_of(chain)) else written
}
logical_ops = [Op.And, Op.Or, Op.Xor]
# `switch 3 {1: "one" 3: "three"} == "three"`: the spaced phrase reads the comparison as its last item's, `{…} == "three"`;
# a clause word's arms are a block, never a comparison, so the match is compared (decision comparison-after-arms);
# ø for any other node
compared_arms(n: Node) as Node? := {
	if not (is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n >= 3) { return ø }
	last = n#(#n)
	clause = n#(#n - 2)
	if not (last is key and op_of(last) in comparing_ops and is_curly_group(key_of(last)) and clause is symbol and keyword_form(name_of(clause)) == "clause") { return ø }
	compared = Key(spaced(items_of(n)[#n - 3 ..< #n - 1] + [key_of(last)]), op_of(last), value_of(last))
	if #n == 3 then compared else spaced(items_of(n)[0 ..< #n - 3] + [compared])
}
# `(sq 2 == 4)`: the phrase in parentheses, read so too; a call `sq(2 == 4)` is no phrase
is_round_word_phrase(n: Node) as bool := is_round(n) and separator_of(n) == " " and #n == 2 and n#1 is symbol
fitted(word: Node, left: Node, op: Op, right: Node, written: Node, own_types: map) as Node := {
	fit = condition_fit(word, own_types)
	if fit == ambiguous_fit {
		compared = op as text
		throw "`${word} ${left} ${compared} ${right}` reads two ways: ${word}(${left} ${compared} ${right}) or (${word} ${left}) ${compared} ${right}; ${word}'s parameter is untyped: write the parentheses or declare its type"
	}
	if fit == yes { return spaced([word, Key(left, op, right)]) }
	if fit == no { return Key(spaced([word, left]), op, right) }
	written
}
comparing_ops = [Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.Eq, Op.Ne]
# `all xs > 0`: the words that compare each element of their list (extensions/sugar/broadcasting.warp, decision
# each-all-broadcast), their rules matching `all (xs > 0)`
element_comparing_words = ["all", "any"]
is_word_phrase(n: Node) as bool := is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n == 2 and n#1 is symbol
# each function of the program taking a value by name, the type its first parameter is declared ("" untyped)
own_parameter_types(program: Node) as map := {
	types = {}
	for name in value_taking_functions(program) { types[name] = "" }
	typed = typed_first_parameters(program)
	for name in typed.keys { types[name] = typed[name] }
	types
}
ambiguous_fit = "ambiguous"
condition_takers = ["any", "bool"]
# a parameter type takes a yes/no when it, or a member of its union, is a condition taker: `bool or int` does
takes_condition(type: text) as bool := union_members(type).any(member => member in condition_takers)
# whether the word's first parameter takes a yes/no: yes for any, bool or an untyped rest (`print(values...)`), no for
# another declared type, ambiguous_fit for a program's function of an untyped parameter, ø for a word of no typed line
condition_fit(word: Node, own_types: map) as any := {
	name = unaliased(name_of(word))
	if name in element_comparing_words { return yes }
	if own_types.has(name) { return if own_types[name] == "" then ambiguous_fit else takes_condition(own_types[name]) }
	lines = lines_of(typed_lines, name) + (word_lines().get(name) ?? [])
	firsts = lines.filter(line => #line.signature.parameters > 0).map(line => line.signature.parameters#1)
	if #firsts == 0 { return ø }
	firsts.any(p => takes_condition(p.type_name) or (p.rest and p.type_name == ""))
}
