# The definitions of a module's text a program reaches, for the prelude and
# each standard module the program uses (`use case_tables`): a call of a word the program defines nowhere brings that
# word's definition, and those it calls in turn. The text is cut into slices, one per
# top-level `name(…) := …` or `name = …`; the reached ones are parsed after the program's own statements, so its
# positions stay as written. It runs on the parsed program after uses.warp: the source is parsed
# once (twice put parser.warp's lowering past the stage's 60 s).
use "../parsing/parser.warp"
use "walk.warp"
use "uses.warp"
use "../analysis/builtin_signatures.warp"
use "scope.warp"
use "lambdas.warp"
use "../../extensions/c_imports.warp"
use "../../extensions/components.warp"

# each function a library file brought, by name: [the file, the line its definition starts on], the place a refusal
# inside it names (emitter.warp note_emitting): its slice was parsed alone, its nodes keep no line of the file
global defined_origins = {}
# [file, line] of each definition slice of the files, by the slice's text
slice_origins(files: list): map := {
	found = {}
	for path in files {
		source = file_text(path) ?? ""
		line = 1
		at = 0
		for span in spans_of(source) {
			line += #source[at ..< span#2].split("\n") - 1
			at = span#2
			found[source[span#2 ..< span#3]] = [working_relative(path), line]
		}
	}
	found
}
# the place of each definition of a used file, as brought from it
note_file_origins(file: text, source: text) := {
	origins = slice_origins([file])
	for slice in definition_slices(source) { if origins.has(slice#2) { defined_origins[slice#1] = origins[slice#2] } }
}
# source → its slices: the passes ask for each library module's slices per call and argument, cut once
global source_slices = {}
definition_slices(source: text): list := {
	if not source_slices.has(source) { source_slices[source] = spans_of(source).map(span => [span#1, source[span#2 ..< span#3]]) }
	source_slices[source]
}
# [name, start, end] of each slice of the source (slice_spans), once a text: a module every compile reads off the
# library index while source is its text as the index was written, cut otherwise: cutting the prelude and the type
# modules was ~70 ms of a small compile (notes/library_zero_bake.md L4)
global source_spans = {}
spans_of(source: text): list := {
	if not source_spans.has(source) {
		module = indexed_module(source)
		source_spans[source] = if module != ø then indexed_spans(library_index_section("slice").get(module) ?? "") else slice_spans(source)
	}
	source_spans[source]
}
# the module of sliced_modules whose file the source is, its length the index's: the index is lib/ as the build left it
# (decision no-lib-reads: an edited lib/ is a rebuild); ø for any other text
indexed_module(source: text): text? := {
	for module in sliced_modules() {
		hash = library_index_section("hash").get(module) ?? ""
		if hash.starts_with("${#source}-") and source == file_text(std_module_path(module)) { return module }
	}
	ø
}
# the modules every compile cuts: the prelude, lib/math.warp beside it (builtin_signatures.warp library_texts_seen) and
# the type modules
sliced_modules(): list := ["prelude", "math"] + type_modules
# each sliced module's cut as the index holds it, `name start end` of each slice joined by ";"
sliced_modules_scanned(): map := {
	found = {}
	for module in sliced_modules() { found[module] = slice_spans(file_text(std_module_path(module)) ?? "").map(span => "${span#1} ${span#2} ${span#3}").join(";") }
	found
}
indexed_spans(spans: text): list := spans.split(";").filter(span => span != "").map(span => span.split(" ")).map(span => [span#1, span#2 as int, span#3 as int])
# [name, start, end] of each definition in source, by code point: a line starting with a name and its parameters,
# with the indented or closing lines below it
slice_spans(source: text): list := {
	spans = []
	name = ""
	written = ""
	start = 0
	at = 0
	for line in source.split("\n") {
		if name and (continues(line) or is_open(written)) {
			written = written + "\n" + line
		} else {
			if name { spans += [[name, start, at - 1]] }
			name = name_defined_in(line)
			written = line
			start = at
		}
		at += #line + 1
	}
	if name { spans += [[name, start, at - 1]] }
	spans
}
# `export f(…) := …` in a library: a word a host calls back (timers' timer_fired), kept whenever the module is used and
# exported under its name (decision host-callback-exports)
export_word = "export"
is_exported_slice(slice: list): bool := leading_name(slice#2) == export_word
# `public f(x) := …`: an untyped library word its importers may call (decision library-word-visibility), no host export
public_word = "public"
# the words that start a definition of the name after them: `def f(x) …`, `const X = 1`, `class Table {…}`
defining_keywords = function_keywords + declaration_keywords + ["class", "enum", "struct", "trait", "type"]
# `f` of `f(x) := …`, a value `f = …`, `def f(x)`, `enum F {…}` (a defining keyword's name), operator_↑ of
# `infix operator ↑(x: number, n: number) := …`, else ""
name_defined_in(line: text): text := {
	declared = operator_declared(operator_statement(blank_words(line)))
	if #declared > 0 { return OPERATOR_FUNCTION_PREFIX + declared#1.glyph }
	leading = leading_name(line)
	if leading == export_word or leading == public_word { return name_defined_in(line[#leading ..].trim()) }
	if leading in defining_keywords { return leading_name(line[#leading ..].trim()) }
	if count(leading) == 0 or leading == rewrite_word { return "" }
	following = line[#leading ..].trim()
	converted = conversion_target(following)
	if converted != "" { return converted }
	# `convert!(n, to: byte) := …`, `is!(warp, expected) := …`: the slice name is the bang word
	is_bang = following.starts_with("!(")
	is_function = (following.starts_with("(") or is_bang) and line.contains(":=")
	is_value = following.starts_with(":=") or (following.starts_with("=") and not following.starts_with("=="))
	if is_bang and is_function { return leading + "!" }
	if is_function or is_value then leading else ""
}
# the type a conversion converts to, of the line's rest after its first name: `n: number as Real := …` and
# `int as Real := …` are Real's slices, reached with the class; "" of any other line
conversion_target(following: text): text := {
	if not following.contains(":=") or not (following.starts_with(":") or following.starts_with("as ")) { return "" }
	parts = (" " + following.split(":=")#1).split(" as ")
	if #parts != 2 { return "" }
	target = parts#2.trim()
	if target != "" and leading_name(target) == target then target else ""
}
# the name a line starts with, "" when it starts with another character; one beyond ASCII is a name's, `π() := …`
leading_name(line: text): text := {
	stop = 0
	while stop < #line and is_name_part(line#(stop + 1)) { stop += 1 }
	line[0 ..< stop]
}
is_name_part(c: char): bool := (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c > '~'
# a line inside the definition above it: indented, the brace closing it, or a word no statement starts with, `else if …`
# of an if over several lines
continues(line: text): bool := #line > 0 and (line#1 == '\t' or line#1 == ' ' or line#1 == '}' or leading_name(line) in continuing_words)
continuing_words = ["else", "then", "and", "or"]
# a definition so far leaves a bracket, a text or a shader block open: the lines below go on with it, unindented ones
# too (a value `[` … `]`, a text over lines)
is_open(written: text): bool := {
	source = written + "\n"
	n = source.length
	depth = 0
	at = 0
	while at < n {
		skipped = skipped_end(source, at, n)
		if skipped == n { return yes }
		if skipped > at { at = skipped } else {
			c = source[at]
			if c == '(' or c == '[' or c == '{' { depth += 1 }
			if c == ')' or c == ']' or c == '}' { depth -= 1 }
			at += 1
		}
	}
	depth > 0
}

# the words a node mentions as symbols, each once (a map as the set: an 89 KB program has tens of thousands); a map
# literal's key, `{reduce: 1}`, names no word, so it brings no library word or module of the name, but a key glued to
# a block, `if yes { twice{n+=1} }`, may be the word's call (phrase_blocks.warp glued_block_call)
symbol_words(n: Node): list := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is symbol { found[name_of(part)] = yes }
		else if is_named_type(part) { found[declared_type_name(value_of(part)#2)] = yes }
		else if part is key and key_of(part) == opaque_symbol { for word in class_words(part) { found[word] = yes } }
		else if part is key { waiting += [key_of(part), value_of(part)] }
		else if is_group(part) { for item in part { waiting += [if is_curly_group(part) and is_map_entry(item) and key_of(item) is symbol and not is_block_argument(value_of(item)) then value_of(item) else item] } }
	}
	found.keys
}

# the words a class's body mentions but its own fields and methods: `class C{pi = 3; f() := pi * r}` names no library pi
# a type named with no body, a field's `x: Int` (sugar.warp typed_fields): it uses the type, as a prelude alias
is_named_type(n: Node): bool := is_key(n, Op.Colon) and key_of(n) == opaque_symbol and kind_of(value_of(n)) == "type" and value_of(n)#3 == ø
class_words(view: Node): list := {
	parts = parts_within(view)
	own = parts.flat_map(part => if is_group(part) then items_of(part) else [part]).map(member_name)
	parts.flat_map(symbol_words).filter(word => word not in own)
}

# the field `r: int` or `pi = 3`, the method `f() := …`, one read as the class reads it, `int bar(){ 42 }`: a
# method's name is the class's own, never a module's word (sound's bar)
member_name(statement: Node): any := match statement {
	Symbol(name): name
	Key(Symbol(name), op, value): name
	_: declared_name(statement) ?? defined_word(member_node_read(statement))
}

# the words a slice mentions, those inside a class's methods too (the opaque view of `class Instant { … text() :=
# format_date(ms) }` holds its body as nodes, parts_within): a module's class brings the functions its methods call
words_within(n: Node): list := names_within(n, no)
# its words and the heads of its keys ("key =="), what a rule needs and gives (rewrites.warp rules_reaching)
tokens_within(n: Node): list := names_within(n, yes)
names_within(n: Node, with_keys: bool): list := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is symbol {
			found[name_of(part)] = yes
			for name in operated_within(name_of(part)) {
				found[name] = yes
				# the operation a rule makes of it, `x = x /! 2` (rules_reaching)
				if with_keys and canonical_operator(name) != "" { found[key_head(operation(part, canonical_operator(name), part))] = yes }
			}
		} else {
			if with_keys and part is key { found[key_head(part)] = yes }
			waiting += parts_within(part)
		}
	}
	found.keys
}

# the operator inside an element-wise one or a compound assignment, which a rule makes it into: `/!` of `x /!= 2`,
# `max` of `x max= 5` (its library word), `*` of `.*=`
# (`div` of `x div= 2` and its operator, `/!`; a few too many, `<` of `<=`, cost nothing)
operated_within(name: text): list := {
	inner = if #name > 1 and name.ends_with("=") then name[0 ..< #name - 1] else if #name > 1 and name#1 == '.' and name#2 != '.' then name[1 ..] else ""
	if inner == "" then [] else [inner, canonical_operator(inner)] + operated_within(inner)
}

# the words a later step writes: the cell of a shared capture, for a lambda or a block given to a parameter (lambdas.warp),
# the matcher of a structural match arm (node_matches.warp), an int type's show (extensions/int_types.warp)
function_types = [symbol("function"), symbol("block")]
lowering_words(program: Node): list := {
	nodes = nodes_in(program)
	(if nodes.any(n => is_lambda(n) or n in function_types) then ["Cell"] else []) + (if nodes.any(n => is_structural_match(n) or is_quoted_arm(n) or (is_key(n, Op.Is) and is_shape_pattern(value_of(n)))) then [matcher_word] else []) + (if nodes.any(is_pattern_definition) then [matcher_word, pattern_converter_word, kept_pattern_word] else []) + (if writes_templates then [template_word] else []) + (if statements_in(program).any(statement => int_type_name(statement) != ø) then [showing_word] else []) + emitted_words(program)
}
# `data($a * 1) => a`, an arm of quoted code wherever a sugar word holds it (`rules {…}`, extensions/sugar/arms.warp): its
# match is written only once the sugar fires
is_quoted_arm(n: Node): bool := is_key(n, Op.Arrow) and is_quote(key_of(n))
# the words the emitter calls itself, kept though no statement does: of a program writing a time literal (the parser's
# data view) a time's fields (extensions/time_values.warp time_field), its + - * where the program writes one
# (time_operation_call); the exact root of a program taking one (root_words); the library words the extension passes
# write calls of (extension_writes)
emitted_words(program: Node): list := time_literal_words(program) + root_words(program) + extension_writes.flat_map(writes => writes(program))
# each extension pass that writes calls of library words the program may never write declares them here, by its
# function of the program giving them: the next such pass is one entry, no other edit
# `x as! T` is a call of convert! written by extensions/conversions.warp, so the prelude's overloads are reached
# though the program never writes the word. A program whose forced casts are only the 64-bit int wrap needs none
is_forced_as(n: Node): bool := is_key(n, Op.As) and is_key(value_of(n), Op.Not) and key_of(value_of(n)) == ø
forced_cast_words(program: Node): list := {
	for n in nodes_in(program) {
		if is_forced_as(n) and value_of(value_of(n)) is symbol {
			word = name_of(value_of(value_of(n)))
			if word in wrapping_byte_words or not names_int(word) { return ["convert!"] }
		}
	}
	[]
}
extension_writes = [component_words, forced_cast_words, fetched_later_words]
# a value called, `room(signal)` (closure_call_1 once lowered), may be an instance its class's `call` takes (emitter
# closures.warp instance_calls): the module's call is reached and kept for it
callable_word = "call"
calls_a_value(program: Node): bool := {
	bound = names_bound_in(program)
	nodes_in(program).any(n => is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol and name_of(n#1) in bound)
}
time_literal_words(program: Node): list := {
	nodes = nodes_in(program)
	# a time literal, or a name typed time whose fields it reads, `zoned(t: time, …) := … t.form` (lib/time.warp)
	if not nodes.any(n => is_time_view(n) or is_time_typed(n)) { return [] }
	[time_field_word] + (if nodes.any(n => time_operator_symbols.any(symbol => is_operator(n, symbol))) then [time_operation_word, time_operand_word] else [])
}
is_time_typed(n: Node): bool := is_operator(n, ":") and value_of(n) == symbol(time_module)
# the modules of the emitted words: lib/time_arithmetic.warp for a time's + - *, lib/time.warp for a time placed in a
# zone, `t in "Europe/Berlin"`, which the sugar makes zoned(t, "Europe/Berlin") (extensions/sugar/methods.warp)
emitted_modules(program: Node): list := (if time_operation_word in time_literal_words(program) then [time_arithmetic_module] else []) + (if places_in_zone(program) then [time_module] else [])
time_module = "time"
# (`t in "Europe/Berlin"` read as the group of its three words, the sugar's form)
places_in_zone(program: Node): bool := nodes_in(program).any(n => is_group(n) and #n == 3 and n#2 == symbol(placed_in_word) and zone_written(n#3))
placed_in_word = "in"

# the names of the functions with_reached brought from the prelude and the modules, of the compile at hand
global brought_names = {}
# those of them a library exports, which called_only keeps uncalled
global exported_names = {}
# the reach's last step, once the passes ran (passes.warp lowered_reached): the program without the brought functions
# nothing calls. What a sugar rule might write is brought before it fires (sugar_words_of: `each_any` for any call,
# `count_in` for any count), and typing and emitting the unused ones cost each compile (card measure). A module being
# built keeps all of its words
called_only(program: Node): Node := {
	if module.relocating or #brought_names == 0 { return program }
	statements = statements_in(program)
	names = statements.map(statement => declared_name(statement) ?? "")
	# the brought definitions by name, each word's found at once (a scan of every statement per word was 10% of
	# compiling the compiler, card cpu-compiling)
	brought = {}
	pending = emitted_words(program) + exported_names.keys
	for i in 0 ..< #statements {
		if brought_names.has(names[i]) { brought[names[i]] = (brought.get(names[i]) ?? []) + [statements[i]] } else { pending += words_within(statements[i]) }
	}
	if pending.any(word => word.starts_with(closure_call_word)) { pending += [callable_word] }
	settlers = extension_value_settlers()
	pending += pending.filter(word => settlers.has(word)).map(word => settlers[word])
	called = {}
	at = 0
	while at < #pending {
		word = pending[at]
		at += 1
		if not called.has(word) {
			called[word] = yes
			for statement in brought.get(word) ?? [] { pending += words_within(statement) }
		}
	}
	kept = (0 ..< #statements).filter(i => not brought_names.has(names[i]) or called.has(names[i])).map(i => statements[i])
	separated(bracketed(kept, ""), ";")
}
# the program with the definitions of `module` (a module's text) it reaches, in the module's order, each slice parsed
# once and on its own (the program's positions stay as written); the program itself when it reaches none. A used
# module's in front of the program, the prelude's after it. The words the program (a used
# module's definitions in front of it too) will say once the sugar rewrote it are reached too (sugar_words_of), and
# those the program doesn't call after all dropped once the passes ran (called_only)
with_reached(program: Node, module: text, in_front: bool, files: list = [], linked: list = []): Node := {
	# [name, text, parse, identity] of each definition: a linked module's from its signature, its head line and parse
	# (signature.warp), declared only; else a slice of the text, parsed when reached
	given = linked.map(slice => [slice#1, slice#2, slice#3, slice#4 + " " + slice#1 + " " + slice#2]) + definition_slices(module).map(slice => [slice#1, slice#2, ø, slice#2])
	module_names = given.map(slice => slice#1)
	# a program's function named as a library word is the program's own (decision library-words-lexical): the program's
	# calls it takes reach it, under its own name, any other call and every library body the library's word, so
	# round_to's round stays math's beside a program's round(x), and round(2.345, 2) is round_to; a module brought in
	# front replaces the prelude's word as it is. A library module being built exports its words under their written
	# names, which a program linking it calls (units' sleep beside the prelude's, card program-file): the prelude's word
	# is the one set aside, as kept() sets it; beside a module it uses its word stays its own (storage's column_value
	# beside sqlite3's)
	if in_front or not building_a_module() { program = with_own_words(program, module_names + (if in_front then [] else runtime_words_of_math)) }
	own_names = statements_in(program).map(declared_name)
	own = with_c_heads(own_heads(program))
	# (a linked module's aliases from its signature, its text being none)
	written_aliases = module_aliases(module)
	owners = {}
	# (only the modules whose slices are given: the prelude's pass never applies math's `alias log2 => binary_log` to
	# math's own text a module build reads, whose log2 is C's)
	if #linked > 0 {
		for module_name in linked_signatures.keys.filter(name => linked.any(slice => slice#4 == name)) {
			signature = linked_signatures[module_name]
			for name in signature.aliases.keys {
				written_aliases[name] = signature.aliases[name]
				owners[name] = module_name
			}
		}
	}
	aliases = with_call_forms(written_aliases, module_names + own.keys)
	program = aliased_in_scope(program, aliases, own, owners)
	# a program's operator declaration overloads the module's beside it (`infix operator ↑(v: V, n: int)` beside the
	# numbers' ↑), a program's assignment to a module's global sets it (`tuning = 442` retunes sound's notes), any other
	# definition replaces the module's
	assigned = statements_in(program).filter(statement => is_key(statement, Op.Assign) and key_of(statement) is symbol).map(declared_name)
	# a class of the program sets aside a module's word of its name too, `class square {…}` the prelude's square(x), so
	# square(4) constructs (card field-side); a module's own class, brought in front, is no such word
	own_classes = statements_in(program).filter(is_type_declaration).map(statement => declared_type_name(value_of(statement)#2))
	replaced = slice => slice#1 in own_names or (slice#1 in own_classes and leading_name(slice#2) not in defining_keywords)
	kept = slice => not replaced(slice) or slice#1.starts_with(OPERATOR_FUNCTION_PREFIX) or (slice#2.starts_with("global ") and slice#1 in assigned)
	# the program's globals, `global hue = 10`, which every function of its own shares, are no module's: hsv's `hue`
	# stays its local
	program_globals = statements_in(program).filter(is_global_declaration).map(declared_name).filter(name => name != ø and name not in module_names)
	# [name, text, the name written, parse, identity] of each slice: a replaced one under its library_word, for an
	# alias's call
	slices = given.map(slice => [if kept(slice) then slice#1 else library_word(slice#1), slice#2, slice#1, slice#3, slice#4])
	# the statements of each reached slice, by its identity
	reached = {}
	if in_front { own_words_unlinked(own_names) }
	# (a linked module's classes and globals, the prelude's Cell of its closures too)
	program_words = symbol_words(program)
	foreign = foreign_types(module)
	for signature in linked_signatures.values { for type in signature.foreign.keys { foreign[type] = signature.foreign[type] } }
	if program_words.any(word => word in foreign) { hint_foreign_types(program, foreign, own_names) }
	exported = slices.filter(is_exported_slice).map(slice => slice#1)
	for name in exported { exported_names[name] = yes }
	# (an alias the program writes where the sugar makes its call later, `3 squared`, wants its word: square)
	wanted = exported + program_words + program_words.filter(word => written_aliases.has(word)).map(word => written_aliases[word]) + variant_words(program_words) + lowering_words(program) + sugar_words_of(program) + linked_needs() + (if callable_word in module_names and calls_a_value(program) then [callable_word] else []) + extension_value_settlers().values.filter(word => word in module_names)
	uses = ø
	origins = {}
	while #wanted > 0 {
		word = wanted#1
		wanted = wanted[1 ..]
		for slice in slices {
			if slice#1 == word and slice#5 not in reached {
				if slice#4 == ø and uses == ø { uses = use_lines(module) }
				# (a linked one's parse packed alone in its signature, unpacked once reached)
				slice_node = early_sugared(if slice#4 != ø then unpack(slice#4) else plain_node(parsed(slice#2, uses)))
				# (a linked module's word under its library_word is compiled here: the module exports its written name)
				if slice#1 != slice#3 { slice_node = renamed(slice_node, slice#3, symbol(slice#1)) }
				else if slice#4 != ø { slice_node = declared_only(slice_node) }
				slice_node = with_own_locals(slice_node, program_globals)
				reached[slice#5] = statements_in(slice_node)
				if slice#4 == ø {
					if #origins == 0 { origins = slice_origins(files) }
					origin = origins.get(slice#2)
					if origin != ø { defined_origins[slice#1] = origin }
				}
				wanted += words_within(slice_node) + lowering_words(slice_node)
			}
		}
	}
	if #reached == 0 { return program }
	brought = []
	for slice in slices { if slice#5 in reached { brought += reached[slice#5] } }
	# a value the program reaches, `online := system_value("online") != 0`, holds before the program reads it; a
	# function goes where the module wants its definitions (card prelude-definition-reachability)
	values = brought.filter(goes_in_front)
	functions = brought.filter(statement => not goes_in_front(statement))
	for statement in functions {
		name = declared_name(statement)
		if name != ø { brought_names[name] = yes }
	}
	own_statements = statements_in(program)
	parts = if in_front then values + functions + own_statements else values + own_statements + functions
	separated(bracketed(parts, ""), ";")
}
# a linked module's definition as the program needs it: a function's head, its body left to the module's code, a
# class with its methods so; a value, whose initializer the program runs, and a field as they are
declared_only(n: Node): Node := {
	if is_group(n) { return children(n, declared_only) }
	if class_view(n) != ø { return with_members(n, declared_only) }
	head = if n is key then key_of(n) else ø
	if is_group(head) and bracket_of(head) == "(" {
		# (a word taking a block keeps its body: extensions/block_inlining.warp runs a literal block in it in place,
		# `3 times {…}` a loop of the caller's own, card times-infix-operator)
		if takes_block(head) { return n }
		if is_key(n, Op.Define) { return Key(head, Op.Define, Node.Empty) }
		if is_key(n, Op.Assign) { return Key(head, Op.Assign, Node.Empty) }
	}
	# `A4 := midi_hertz(69)`, a value the module made a function of (charged, P71): its head, called at each use
	if is_key(n, Op.Define) and head is symbol and name_of(head) in module.linked_words { return Key(call_of(name_of(head), []), Op.Define, Node.Empty) }
	if is_key(n, Op.Colon) and is_declaration_keyword(head) then Key(head, Op.Colon, declared_only(value_of(n))) else n
}
takes_block(head: Node): bool := items_of(head)[1 ..].any(parameter => parameter_type(parameter) == "block")
# `name := …`, `name = …`, `global name = …`: a value's definition, no function's
# a value, and a type the program's declarations name (`type fraction = rational`), whose statement is no program's
# last
goes_in_front(statement: Node): bool := is_value_definition(statement) or is_type_naming(statement)
is_type_naming(statement: Node): bool := is_key(statement, Op.Assign) and is_key(key_of(statement), Op.Colon) and key_of(key_of(statement)) == opaque_symbol
is_value_definition(statement: Node): bool := {
	if is_key(statement, Op.Colon) and key_of(statement) == symbol("global") { return is_value_definition(value_of(statement)) }
	(is_key(statement, Op.Define) or is_key(statement, Op.Assign)) and key_of(statement) is symbol
}

# `alias keys => map_keys` of a module: the word by each alias (an alias declares
# nothing, its calls call the word)
module_aliases(source: text): any := {
	aliases = {}
	for line in source.split("\n") {
		if line.starts_with("alias ") {
			pair = alias_pair(line[6 ..])
			if #pair == 2 { aliases[pair#1] = pair#2 }
		}
	}
	aliases
}
# the foreign type names of a module, the `type Int = int` lines of its block under FOREIGN_TYPES_HEADER (the
# prelude's): each name by warp's type, which a program writing it hears of (foreign_type in hints.data)
FOREIGN_TYPES_HEADER = "// Foreign type names"
foreign_types(source: text): map := {
	found = {}
	if not source.contains(FOREIGN_TYPES_HEADER) { return found }
	inside = no
	for line in source.split("\n") {
		if line.starts_with(FOREIGN_TYPES_HEADER) { inside = yes }
		else if inside and line.trim() == "" { return found }
		else if inside and line.starts_with("type ") {
			sides = line[5 ..].split("=")
			if #sides == 2 { found[sides#1.trim()] = sides#2.trim() }
		}
	}
	found
}
# [name, node] of each type the program names in a type's place: `x: Int`, `real x = 3`, `f(n: Int)`, a class field's `w: Int`
# (not an enum case `Kind.Int`)
written_types(n: Node): list := {
	found = []
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if is_named_type(part) { found += [[declared_type_name(value_of(part)#2), part]] }
		else if is_type_first_declaration(part) {
			found += [[name_of(part#1), part#1]]
			waiting += [part#2]
		}
		else if is_key(part, Op.Colon) and value_of(part) is symbol {
			found += [[name_of(value_of(part)), value_of(part)]]
			waiting += [key_of(part)]
		}
		else if part is key or is_group(part) { waiting += parts_within(part) }
	}
	found
}
# `real x = 3`: the type word before a name it binds
is_type_first_declaration(n: Node): bool := is_group(n) and #n == 2 and n#1 is symbol and is_key(n#2, Op.Assign) and key_of(n#2) is symbol
# `x: Int`: the hint naming warp's type, once a name, unless the program declares a type of that name itself
hint_foreign_types(program: Node, foreign: map, own_names: list) := {
	hinted = {}
	for written in written_types(program) {
		name = written#1
		if name in foreign and name not in own_names and name not in hinted {
			hinted[name] = yes
			diagnose(call_of("foreign_type", [symbol(name), symbol(foreign[name])]), written#2)
		}
	}
}
# aliases with the call form of each word operator the names define: `divides(3, 12)` calls operator_divides unless
# a function divides is defined
with_call_forms(aliases: map, names: list): any := {
	for name in names {
		word = if name.starts_with(OPERATOR_FUNCTION_PREFIX) then name[#OPERATOR_FUNCTION_PREFIX ..] else ""
		if word and is_name_start(word#1) and word not in names { aliases[word] = name }
	}
	aliases
}
# The program aliased, each definition a used module brought by the aliases its module sees (card module-name-leak):
# those of the modules it uses, at any depth, and the prelude's, never another used module's (math's
# `alias log2 => binary_log` stays out of sound's plain_midi). owners: the linked module of each alias
aliased_in_scope(program: Node, aliases: map, own: map, owners: map): Node := {
	if not statements_in(program).any(is_brought) { return aliased(program, aliases, own) }
	seen_by = {}
	children(program, statement => aliased(statement, if is_brought(statement) then aliases_seen(statement, aliases, owners, seen_by) else aliases, own))
}
is_brought(statement: Node): bool := {
	name = declared_name(statement)
	name != ø and brought_names.has(name) and defined_origins.has(name)
}
# the aliases the module of a brought definition sees, once a module (seen_by)
aliases_seen(statement: Node, aliases: map, owners: map, seen_by: map): map := {
	module_name = module_of_path(defined_origins[declared_name(statement)]#1)
	if not seen_by.has(module_name) {
		visible = modules_used_by(module_name, ["prelude"])
		seen = {}
		for name in aliases.keys { if not owners.has(name) or owners[name] in visible { seen[name] = aliases[name] } }
		seen_by[module_name] = seen
	}
	seen_by[module_name]
}
module_of_path(path: text): text := {
	parts = path.split("/")
	file = parts#(#parts)
	if file.ends_with(module_extension) then file[0 ..< #file - #module_extension] else file
}
# the module and the modules it uses, at any depth, beside those seen
modules_used_by(module_name: text, seen: list): list := {
	if module_name in seen { return seen }
	seen += [module_name]
	signature = linked_signature(module_name)
	for used in (if signature != ø then signature.uses else used_modules(used_module_text(module_name))) { seen = modules_used_by(used, seen) }
	seen
}
# `keys(m)` as `map_keys(m)`: a call of an alias calls the word unless the program defines that name, as a variable
# or a function taking as many arguments (shadowing is per arity: a program's
# `index_of(source, part, from, n)` leaves `"abc".index_of(c)` to the library); top-down, so a method call
# `x.f(a)` counts its receiver
aliased(n: Node, aliases: map, own: map): any := if class_view(n) != ø then with_members(n, member => aliased_member(member, aliases, own)) else match n {
	Key(receiver, Op.Dot, call): Key(aliased(receiver, aliases, own), Op.Dot, aliased_call(children(call, x => aliased(x, aliases, own)), aliases, own, 1))
	_: children(aliased_call(n, aliases, own, 0), x => aliased(x, aliases, own))
}
# a method's body aliased, its head named by an alias as a call on its instance is (`has(x)` as collection_contains(x),
# as `s.has(x)` calls it), but an operator's (`times(k) := …` stays the class's own `*`) or a word another arity
# varies (`sum()`), never a field (`m: map = {}`)
aliased_member(member: Node, aliases: map, own: map): any := if is_key(member, Op.Define) and is_group(key_of(member)) then Key(aliased_head(key_of(member), aliases, own), Op.Define, aliased(value_of(member), aliases, own)) else member
aliased_head(head: Node, aliases: map, own: map): Node := if head#1 is symbol and name_of(head#1) in aliases and name_of(head#1) not in operator_spellings() then aliased_call(head, aliases, own, 1) else head
# a class declaration with each member, read as the definitions pass reads it, changed by f: a class body is a type
# view the walks don't enter (`keys.index_of(x)` in a method is aliased so)
with_members(n: Node, f: function): Node := {
	view = class_view(n)
	opaque([view#1, view#2, view#3[0 ..< 3] + view#3[3 ..].map(member => changed_member(member, f))] + view[3 ..])
}
# a member f leaves as it is stays the very view (read back and viewed anew, a field `m: map = {}` loses its default)
changed_member(member: any, f: function): any := {
	read = member_read(member)
	changed = f(read)
	if changed == read then member else view_of(changed)
}

aliased_call(n: Node, aliases: map, own: map, receivers: int): any := {
	if not (is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol) { return n }
	called = name_of(n#1)
	count = #n - 1 + receivers
	# an arity variant fits the call's count, before the module's word: first(xs, 2) of a program's own first(x) is first_items
	word = arity_variant(called, count) ?? aliases.get(called)
	if word == ø or shadows(own, called, count, if receivers == 0 then items_of(n)[1 ..] else []) { return n }
	# (a C function is never set aside as a program's definition is: its name stays the alias's word)
	group_like(n, [symbol(if word in own and not word.starts_with(OPERATOR_FUNCTION_PREFIX) and not used_c_functions.has(word) then library_word(word) else word)] + items_of(n)[1 ..])
}
is_global_declaration(statement: Node): bool := is_key(statement, Op.Colon) and key_of(statement) == symbol("global")
# a module's definition with each of the program's globals it binds itself renamed apart (card module-hygiene)
with_own_locals(definition: Node, program_globals: list): Node := {
	bound = names_bound_in(definition)
	for name in program_globals.filter(name => name in bound) { definition = renamed(definition, name, symbol(name + name_joiner + "local")) }
	definition
}
# the module's own definition of a word the program defines too, which an alias or variant means: `round(x, 2)` calls
# the prelude's round_to beside a program's round_to (card module-hygiene); an operator's function is overloaded
# beside the module's, never replaced (with_reached's kept), so its alias calls it as it is (shell's matches)
library_word(word: text): text := word + name_joiner + "library"

# words that mean another word with that many arguments, the receiver counted: `round(x, 3)` is round_to,
# `xs.first(3)` first_items
arity_variants = [["round", 2, "round_to"], ["first", 2, "first_items"], ["count", 2, "count_in"], ["last", 2, "last_items"], ["list", 1, "as_list"], ["tuple", 1, "as_list"]]
# the variants of the words a program names, which of_lookups may call (`last 2 of xs` is last_items)
variant_words(words: list): list := arity_variants.filter(variant => variant#1 in words).map(variant => variant#3)
arity_variant(name: text, count: int): any := {
	for variant in arity_variants { if variant#1 == name and variant#2 == count { return variant#3 } }
	ø
}

# whether the program's own `name` hides the library word from a call of `count` arguments: a variable always, a
# function when it takes them (a parameter `b = 1` may be left out, a rest one takes any more) and no argument written
# into the call is of a kind its parameter's type refuses: an alias and the program's word are one overload set
# picked by the arguments' types (decision library-word-visibility: `use c; isdigit('7')` is the prelude's is_digit)
shadows(own: map, name: text, count: int, arguments: list): bool := {
	if name not in own { return no }
	head = own[name]
	if not is_group(head) { return yes }
	signature = signature_of(items_of(head))
	if not takes(signature, count) { return no }
	for at in 0 ..< min(#arguments, #signature.parameters) { if refuses_written(signature.parameters[at].type_name, arguments[at]) { return no } }
	yes
}
# a value written into a call that a parameter's type refuses: a character or text given a number, a number given a text
NUMBER_PARAMETER_TYPES = ["i32", "i64", "f32", "f64", "int", "float", "number"]
refuses_written(type: text, argument: Node): bool := if type in NUMBER_PARAMETER_TYPES then argument is codepoint or argument is text else type == "text" and argument is number
# the C functions the program's modules declare (`use c`'s `isdigit(c: i32): i32 from 'c'`), own words as the
# program's are: a library alias of the name (the prelude's isdigit => is_digit) no longer hides them
with_c_heads(own: map): map := {
	for name in used_c_functions.keys { if not own.has(name) { own[name] = c_head(used_c_functions[name]) } }
	own
}
# the head `isdigit(c: i32)` of a C declaration [name, library, types, names, result]
c_head(declaration: list): Node := List([symbol(declaration#1)] + (0 ..< #declaration#3).map(at => Key(symbol(declaration#4[at]), Op.Colon, symbol(declaration#3[at]))), Bracket.Round, Separator.Comma)

# the program with each function it defines named as one of `library` under its own name (name·own): its definitions,
# one overload set of the program's when it defines the name by several arities, its value and the calls one of them
# takes; a call none takes keeps the library's word
with_own_words(program: Node, library: list): Node := {
	heads = own_heads(program)
	owned = heads.keys.filter(name => is_group(heads[name]) and name in library and not brought_names.has(name) and not name.starts_with(OPERATOR_FUNCTION_PREFIX) and not is_typed_overload(name, heads[name]))
	for name in owned {
		mine = own_word(name)
		arities = heads_defining(program, name).map(head => signature_of(items_of(head)))
		program = separated(bracketed(statements_in(program).map(statement => if binds_locally(statement, name) then statement else own_named(statement, name, mine, arities)), ""), ";")
	}
	program
}
own_named(code: Node, name: text, mine: text, arities: list): Node := owned_calls(renamed(code, name, symbol(mine)), name, mine, arities)
# each call of the word the program's own when one of its definitions takes it, else the library's, a method call's
# receiver counted (`xs.reduce(f, 0)` is reduce(xs, f, 0)), as aliased counts it; renamed leaves a method's name as
# written, so the call decides it here
owned_calls(n: Node, name: text, mine: text, arities: list): Node := match n {
	Key(receiver, Op.Dot, call): Key(owned_calls(receiver, name, mine, arities), Op.Dot, owned_call(children(call, x => owned_calls(x, name, mine, arities)), name, mine, arities, 1))
	_: owned_call(children(n, x => owned_calls(x, name, mine, arities)), name, mine, arities, 0)
}
owned_call(n: Node, name: text, mine: text, arities: list, receivers: int): Node := {
	if not (is_group(n) and bracket_of(n) == "(" and #n > 0 and (n#1 == symbol(mine) or n#1 == symbol(name))) { return n }
	taken = arities.any(signature => takes(signature, #n - 1 + receivers))
	group_like(n, [symbol(if taken then mine else name)] + items_of(n)[1 ..])
}
# the heads of the program's top-level definitions of the function name, `f(a)` and `f(a, b)`
heads_defining(program: Node, name: text): list := statements_in(program).filter(statement => declared_name(statement) == name).map(definition_head_of).filter(head => head != ø)
# a statement binding the name itself, not defining it: a local `handler = page_handlers#n` (lib/markup.warp
# page_event beside its handler(name, action)), whose uses are that local's
binds_locally(statement: Node, name: text): bool := declared_name(statement) != name and names_bound_in(statement).has(name)
own_word(name: text): text := name + name_joiner + "own"
# the name as the program wrote it, of its own word too
written_word(name: text): text := if name.ends_with(own_word("")) then name.replace(own_word(""), "") else name
# whether a library module is being built (prebuilt.warp sets it), not a program
building_a_module(): bool := module.relocating
# `sin(x: Real) := …`: a definition typing its parameters overloads the library's typed word beside it
# (arity_overloads.warp library_variants joins the library's lines), so a call of another type, `sin(x.float())` in its
# own body too, reaches the library's; an untyped one, `round(x) := …`, and one of a word with no typed line to join,
# `add(a: int, b: int) := …` beside the prelude's `add(xs, x) := …`, is the program's own
is_typed_overload(name: text, head: Node): bool := word_lines().has(name) and #head > 1 and items_of(head)[1 ..].all(parameter => is_key(parameter, Op.Colon) and value_of(parameter) != symbol(any_word))

# name → the head `f(a, b)` of each top-level statement defining a function, `yes` for one defining another name
own_heads(program: Node): any := {
	heads = {}
	for statement in statements_in(program) {
		name = declared_name(statement)
		if name != ø { heads[name] = definition_head_of(statement) ?? yes }
	}
	heads
}

# the head of `f(a) := …`, `f(a): int := …`, `def f(a) {…}`; ø for another statement
definition_head_of(statement: Node): any := {
	n = if is_keyword_group(statement) then statement#2 else statement
	while n is key { n = key_of(n) }
	if is_group(n) and bracket_of(n) == "(" and #n > 0 then n else ø
}

# the standard modules named after a builtin type word (lib/<word>.warp for a built-in type word), and the reals, whose `π` a program names bare
type_modules = ["list", "map", "text", "time", "reals"]

# `xs.flatten()`, `unique(xs)`: a program calling a word of exactly one type module, a word it defines nowhere and no
# library word, uses that module, a `use` in front of it
with_type_module_uses(program: Node): Node := {
	own = own_heads(program)
	used = flat_statements(program).map(use_target).filter(target => target is symbol).map(name_of)
	providers = type_module_providers()
	wanted = {}
	# a function taking nothing is called bare too: `now` as `now()`, one of one value read as its member, `t.words`
	for word in called_words(program) + bare_calls(program, providers) + member_reads(program) + named_types(program) + root_words(program) {
		if word in providers and word not in own and not is_declared_word(word) { wanted[providers[word]] = yes }
	}
	# in the order of type_modules, sorted
	modules = type_modules.filter(module => module in wanted and module not in used)
	with_module_uses(program, modules + global_word_modules(program, own, used) + emitted_modules(program).filter(module => module not in used) + tag_modules(program, used))
}
# the modules giving the tags a program writes their meaning, `div{…}` markup's (a text of a module's global list,
# parser.warp declared_tags; decision html-render-mode: its value renders as a page). A tag `div: {…}` reads as
# binding div, so neither the names bound nor the program's own are a test
tag_modules(program: Node, used: list): list := {
	tags = declared_tags()
	modules = []
	for n in nodes_in(program) {
		parts = tag_parts(n)
		if #parts == 2 {
			name = name_of(parts#1)
			module = tags.get(name)
			if module != ø and module not in used and module not in modules { modules += [module] }
		}
	}
	modules
}
# the modules of the global words a program names, or a sugar rule reaching it writes (`x.json` json_text), and binds
# nothing to, each once
global_word_modules(program: Node, own: any, used: list): list := {
	bound = names_bound_in(program)
	words = global_words()
	modules = []
	for word in symbol_words(program) + sugar_words_of(program) {
		module = words.get(word)
		if module != ø and word not in own and word not in bound and word not in used and module not in used and module not in modules { modules += [module] }
	}
	modules
}
# the runtime words lib/math.warp declares, `max(a, b, more...) from warp`, which a program calls without its use
runtime_words_of_math = library_text("math.warp").split("\n").map(line => typed_line(line, runtime_library)).filter(line => line != ø).map(line => line.name)
# the source with a `use` line of each module it uses without saying it, after its last line (no position moves)
# a used module's source: lib/<module>.warp, else a C library's words, lib/native/<module>.warp (`use sqlite3`'s rows)
# read once a module: a rule word asks it at each call site it tries (extensions/rules/rule_words.warp module_named)
global used_module_texts = {}
used_module_text(module: text): text := {
	if not used_module_texts.has(module) {
		native = native_path(run_library(), module)
		used_module_texts[module] = file_text(std_module_path(module)) ?? (if native == ø then "" else file_text(native) ?? "")
	}
	used_module_texts[module]
}
# `use strict`, `use m`: a mode (lib/modes.data) or a C library, which a `use` names without a module file
use_modes = module_source("modes.data").split("\n").filter(line => line != "" and not line.starts_with("#")).map(line => line.split("\t")#1)
names_no_module(name: text): bool := name in use_modes or is_c_library(name)
# the names the prelude defines, read once
global prelude_definition_names = ø
prelude_definitions(): list := {
	if prelude_definition_names == ø { prelude_definition_names = definition_slices(library_text("prelude.warp")).map(slice => slice#1) }
	prelude_definition_names
}
# (an implicit use is always the standard module, never a same-named file beside the program: only an explicit
# `use x` takes one, decision implicit-use-lib-first)
global implicitly_used = []
with_implicit_uses(source: text, folder: text = "."): text := {
	implicitly_used = implicit_modules_of(source, folder)
	source + implicitly_used.map(module => "\nuse " + module).join("")
}
# the standard modules defining a word, from the library index (library.warp library_index_section "word")
defining_modules(word: text): list := {
	found = library_index_section("word").get(word)
	if found == ø then [] else found.split(" ")
}
# the seed compiles compiler.warp with the rule_words it bundles (lib/rule_words.warp before 1b), which asks the
# word index by these words: kept until a seed carries extensions/rules/rule_words.warp (card seed-bundled-rule-words)
word_index_file(): text := LIBRARY_INDEX
word_index(file: text): map := {
	words = library_index_section("word")
	index = {}
	for word in words.keys { index[word] = words[word].split(" ") }
	index
}
# the words each standard module defines (an `alias ln => natural_log` too) but the prelude, each with its modules joined by spaces: a word of letters
# (`red`, `minute`), no operator or made name (an operator's function, operator_·, kept: is_made_name); also the word leading a rule of the module that means nothing else
# (storage's `stored users: [User]`), never one the core or the prelude gives a meaning (english's `add $x to`)
module_word_definers(): map := {
	definers = {}
	for module in std_module_names.filter(name => name != "prelude") {
		source = file_text(std_module_path(module)) ?? ""
		for word in definition_slices(source).map(slice => slice#1) + module_aliases(source).keys + rule_heads(source).filter(word => not has_meaning(word)) {
			if word is text and #word > 0 and is_name_start(word[0]) and not is_made_name(word) {
				known = definers.get(word) ?? []
				if module not in known { definers[word] = known + [module] }
			}
		}
	}
	joined = {}
	for word in definers.keys { joined[word] = definers[word].join(" ") }
	joined
}
# the word each `rewrite` line of a source starts its pattern with: `stored` of `rewrite stored $name: [$kind] => …`
# (none of a pattern starting with a hole, `rewrite $p => …`)
rule_heads(source: text): list := rule_patterns(source).map(leading_word).filter(word => #word > 0)
rule_patterns(source: text): list := source.split("\n").filter(line => line.starts_with("rewrite ")).map(line => line[#"rewrite " ..])
leading_word(pattern: text): text := {
	start = if pattern.starts_with("(") then 1 else 0
	pattern[start ..< name_end(pattern, start, #pattern)]
}
has_meaning(word: text): bool := is_declared_word(word) or word in prelude_definitions() or is_operator_spelling(word) or keyword_form(word) != ""
# the program with a `use` of each module in front of it
with_module_uses(program: Node, modules: list): Node := {
	if #modules == 0 { return program }
	use_statements = modules.map(module => plain_node(parsed("use " + module)))
	separated(bracketed(use_statements + statements_in(program), ""), ";")
}

# `sleep(3ms)`: an argument naming a word nothing defines finds it in the module of the class its parameter is typed
# with, which the program then uses: `sleep(duration: Time)` names Time, units.warp declares it and defines ms
# (decision expected-type-names), also as a phrase `sleep 50ms`; `x = 3ms` expects no type and stays an unknown name
with_expected_type_uses(program: Node, prelude: text): Node := {
	own = own_heads(program)
	bound = names_bound_in(program)
	prelude_slices = definition_slices(prelude)
	prelude_names = prelude_slices.map(slice => slice#1)
	is_unknown = word => word not in own and word not in bound and word not in prelude_names and not is_declared_word(word)
	calls = nodes_in(program).filter(n => is_group(n) and (bracket_of(n) == "(" or bracket_of(n) == "") and #n > 1 and n#1 is symbol and items_of(n)[1 ..].any(argument => symbol_words(argument).any(is_unknown)))
	if #calls == 0 { return program }
	classes = declared_classes_modules()
	used = flat_statements(program).map(use_target).filter(target => target is symbol).map(name_of)
	wanted = []
	# each called word's definition heads, parsed once a word and only for an argument naming an unknown word
	heads = {}
	for call in calls {
		name = name_of(call#1)
		arguments = items_of(call)[1 ..]
		for i in 0 ..< #arguments {
			words = symbol_words(arguments[i]).filter(is_unknown)
			if #words == 0 { continue }
			if not heads.has(name) { heads[name] = definitions_of(name, prelude_slices).map(definition_text_head) }
			for type in parameter_types(heads[name], i) {
				module = classes.get(type) ?? ""
				defines = word => module in defining_modules(word)
				if module and module not in wanted and module not in used and words.any(defines) { wanted += [module] }
			}
		}
	}
	with_module_uses(program, wanted)
}
# the module that defines a word a program names without using it, as the fix of its unknown name: `x = 3ms` gives
# ": `use units` defines it" (decision expected-type-names); "" when none or several do. Never the prelude: every
# program has it, so a `use prelude` fixes nothing (`animation: pop 400ms` names a CSS keyframes, not its pop)
module_hint(word: text): text := {
	definers = defining_modules(word)
	if #definers == 1 then ": `use " + definers#1 + "` defines it" else ""
}
# the texts of the word's definitions, the prelude's first, then those of each module defining it (library index)
definitions_of(word: text, prelude_slices: list): list := (prelude_slices + defining_modules(word).flat_map(module => definition_slices(file_text(std_module_path(module)) ?? ""))).filter(slice => slice#1 == word).map(slice => slice#2)
# the head of a definition's text, `sleep(duration: Time)` of `sleep(duration: Time) := …`
definition_text_head(definition: text): Node? := definition_head_of(statements_in(plain_node(parsed(definition)))#1)
# the types written for parameter `at` (from 0) of each definition head, `[Time]` of `sleep(duration: Time)`
parameter_types(heads: list, at: int): list := {
	types = []
	for head in heads {
		parameter = if head != ø and at + 1 < #head then head#(at + 2) else ø
		if parameter != ø and is_key(parameter, Op.Colon) and value_of(parameter) is symbol { types += [name_of(value_of(parameter))] }
	}
	types
}
# the words the program names bare that a type module defines as a function taking nothing, `now() := …`
bare_calls(program: Node, providers: map): list := {
	nullary = {}
	for module in type_modules {
		path = std_module_path(module)
		for slice in definition_slices(file_text(path) ?? "") { if without_keyword(slice#2).starts_with(slice#1 + "()") { nullary[slice#1] = yes } }
	}
	bound = names_bound_in(program)
	symbol_words(program).filter(word => word in nullary and providers[word] != "" and word not in bound)
}
# `t.words`: the names read as a member, each a type module's function of one value (words(t)), called so as t.words()
member_reads(program: Node): list := {
	unary = {}
	for module in type_modules {
		for slice in definition_slices(file_text(std_module_path(module)) ?? "") { if takes_one_value(without_keyword(slice#2), slice#1) { unary[slice#1] = yes } }
	}
	nodes_in(program).filter(n => is_key(n, Op.Dot) and value_of(n) is symbol and name_of(value_of(n)) in unary).map(n => name_of(value_of(n)))
}
# `words(t): list := …`: a definition's head of one parameter
takes_one_value(written: text, name: text): bool := {
	if not written.starts_with(name + "(") { return no }
	parameters = written[#name + 1 ..].split(")")#1
	parameters.trim() != "" and not parameters.contains(",")
}
# a definition's text after the keyword declaring it: `π() := …` of `const π() := …`
without_keyword(written: text): text := if leading_name(written) in defining_keywords then written[#leading_name(written) ..].trim() else written
# the names the program binds anywhere, its own wherever it says them, never a module's word (card module-hygiene):
# a variable `now = …`, a function and its parameters `f(was, now)`, a key `{g: 5}`, `x: int`, `Person{name: …}`, a
# lambda's or an arm's pattern `(a, b) => …`, `for now in …`, a class, an enum and its cases
names_bound_in(n: Node): any := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is key and key_of(part) == opaque_symbol {
			# a class, a type and its variants `type Color = red | rgb(r, g, b)`: each name of its head (its members bind
			# only within it, class_words: `class C{pi: int}` leaves the program's pi the reals')
			view = value_of(part)
			if kind_of(view) == "type" { for name in view_symbols(view#2) { found[name] = yes } }
		} else if part is key {
			left = key_of(part)
			if is_key(part, Op.Assign) or is_key(part, Op.Define) {
				while left is key { left = key_of(left) }
				if left is symbol { found[name_of(left)] = yes }
				# (a clause's list pattern binds its names too, `total([first, rest...])` its rest)
				if is_group(left) { for item in left { found[name_of(leftmost_symbol(item))] = yes; if is_group(item) and bracket_of(item) == "[" { for name in pattern_names(item) { found[name] = yes } } } }
				# the variants of a sum type, `type D = A | E(x)`
				if is_type_view(key_of(part)) { for variant in alternatives(value_of(part)) { found[name_of(leftmost_symbol(variant))] = yes } }
			}
			if is_key(part, Op.Colon) and left is symbol and left != symbol("global") { found[name_of(left)] = yes }
			if is_key(part, Op.Arrow) { for name in pattern_names(left) { found[name] = yes } }
			# a ternary's `then : else` is its two branches, no `pi: 4` binding pi
			branches = value_of(part)
			waiting += if is_key(part, Op.Question) and is_key(branches, Op.Colon) then [key_of(part), key_of(branches), value_of(branches)] else [key_of(part), branches]
		} else if is_group(part) {
			for name in iteration_variables(items_of(part)) { found[name] = yes }
			# a named pattern, `pattern Definition = Key(head, Op.Define, body)`: head and body, never shell's head
			if is_pattern_definition(part) { for name in case_pattern_names(value_of(part#2)) { found[name] = yes } }
			# an enum and its cases, `enum K { B, D }`: B is the program's, never sound's note
			enum = declared_enum(part)
			if enum != ø { for name in [enum#1] + enum#2 { found[name] = yes } }
			for item in part { waiting += [item] }
		}
	}
	found
}
# names_bound_in of the node last asked, kept: a rule word asks it of the one $program at each call site it tries
# (extensions/rules/rule_words.warp module_named at each `xs.f()`), which walked the whole program each time
global bound_names_node = Node.Empty
global bound_names_found = {}
names_bound_in_kept(program: Node): any := {
	if not same(program, bound_names_node) {
		bound_names_found = names_bound_in(program)
		bound_names_node = program
	}
	bound_names_found
}
# the names in a view, `["attribute", "variants", ["list", ["symbol", "red"]], ["symbol", "Color"]]`'s red and Color
view_symbols(view: any): list := if kind_of(view) == "symbol" then [view#2] else if view is list then view.flat_map(view_symbols) else []
# the names a pattern binds: `x`, `(a, b)`, `x: int`, `[first, rest...]`, `Point{x, y}` (its x and y, not Point), the
# holes of a text pattern `"/users/" + id: int`
pattern_names(pattern: Node): list := match pattern {
	Symbol(name): [rest_name(pattern) ?? name]
	Key(head, Op.Colon, type): pattern_names(head) + names_after_type(type)
	Key(head, Op.Add, tail): pattern_names(head) + pattern_names(tail)
	Key(head, op, fields): if rest_name(pattern) != ø then [rest_name(pattern)] else if is_group(fields) then pattern_names(fields) else []
	_: if is_group(pattern) then items_of(pattern).flat_map(pattern_names) else []
}
# the names a case's pattern binds, `Key(head, Op.Define, body)` its parts', the case itself none
case_pattern_names(pattern: Node): list := if is_round(pattern) and #pattern > 0 and pattern#1 is symbol then items_of(pattern)[1 ..].flat_map(pattern_names) else pattern_names(pattern)
# a text pattern goes on after a hole's type, `id: int + "/posts/" + post: int` parsing as `id: (int + "/posts/" + post)`
names_after_type(type: Node): list := match type {
	Key(left, Op.Add, right): names_after_type(left) + pattern_names(right)
	_: []
}
# the variables a `for x in …` among the items binds, also inside a comprehension `[x * 2 for x in xs]`
iteration_variables(items: list): list := {
	found = []
	for i in 1 .. #items - 2 { if items#i == symbol("for") and items#(i + 2) == symbol("in") { found = bound_target(items#(i + 1), found) } }
	found
}
# `x` of a parameter `x`, `x: int`, `x = 1`
# `A | E(x) | F`: A, E(x) and F
alternatives(n: Node): list := if is_key(n, Op.Or) or is_key(n, Op.BitOr) then alternatives(key_of(n)) + alternatives(value_of(n)) else [n]
leftmost_symbol(n: Node): Node := {
	while n is key { n = key_of(n) }
	if n is symbol then n else symbol("")
}
# word → the type module defining it, "" for a word two of them define
type_module_providers(): map := {
	providers = {}
	for module in type_modules {
		path = std_module_path(module)
		source = file_text(path)
		if source != ø {
			for slice in definition_slices(source) {
				word = slice#1
				providers[word] = if word in providers and providers[word] != module then "" else module
			}
		}
	}
	providers
}
# the word of a root, `√2`, sqrt(2), which lib/reals.warp keeps exact (emitter.warp exact_root_word); a program's own
# sqrt wins, driver.warp's `sqrt(x: f64): f64 from "c"`
root_words(program: Node): list := if not own_heads(program).has("sqrt") and nodes_in(program).any(n => is_group(n) and #n == 2 and n#1 == symbol("sqrt") and not surely_float(n#2)) then [exact_root_word] else []
# `2.5`, `x as f64`, `(n as float)`: a value written a float, whose root is the float's (a primitive program's too)
surely_float(n: Node): bool := if is_round(n) and #n == 1 then surely_float(n#1) else n is float or (is_key(n, Op.As) and value_of(n) is symbol and type_word_kind(name_of(value_of(n))) == "float")
# the classes the program converts to, tests for or types a name with (written_types), `3 as real`, `x is real`, `b: real`: a type
# module's class comes with its conversions (`x as text` brings no text module)
type_naming_ops = [Op.As, Op.Is]
named_types(program: Node): list := {
	named = nodes_in(program).filter(n => type_naming_ops.any(op => is_key(n, op)) and value_of(n) is symbol).map(n => name_of(value_of(n)))
	(named + written_types(program).map(written => written#1)).filter(name => is_capitalized(name) or not is_tested_type_word(name))
}
# the words the program calls, `f(x)` and `x.f(y)`, each once
called_words(n: Node): list := {
	found = {}
	waiting = [n]
	at = 1
	while at <= #waiting {
		part = waiting#at
		at += 1
		if part is key { waiting += [key_of(part), value_of(part)] } else if is_group(part) {
			if bracket_of(part) == "(" and #part > 0 and part#1 is symbol { found[name_of(part#1)] = yes }
			for item in part { waiting += [item] }
		}
	}
	found.keys
}

# the program with the definitions it reaches of the standard modules it uses, those they use in turn included: `use
# case_tables` names lib/case_tables.warp when the program's folder has no case_tables.warp (uses.warp brings that)
with_used_modules(program: Node, folder: text): Node := {
	sources = used_module_sources(flat_statements(program), folder, [])
	for source in sources#1 { for d in c_declarations_in(source) { used_c_functions[d#1] = d } }
	if #sources#1 == 0 and #sources#3 == 0 then program else with_reached(program, sources#1.join("\n"), yes, sources#2.map(std_module_path), sources#3)
}
# [the sources of the standard modules the statements use, each after those it uses, the module names seen, the
# slices of the linked ones (signature.warp), whose text is never read]; a file in the program's folder takes a use of
# the program's own, never a standard module's (`within_module`): samples/web/html.warp is no lib/html for markup's `use html`
used_module_sources(statements: any, folder: text, seen: any, within_module: bool = no): list := {
	sources = []
	linked = []
	for statement in statements {
		used = use_target(statement)
		if used is symbol and not taken_as_file(statement, folder, within_module) and name_of(used) not in seen {
			seen += [name_of(used)]
			signature = linked_signature(name_of(used))
			source = if signature == ø then used_module_text(name_of(used)) else ""
			if signature != ø {
				inner = used_module_sources(use_statements(signature.uses), folder, seen, yes)
				sources += inner#1
				seen = inner#2
				linked += inner#3 + signature.slices
			} else if source != "" {
				inner = used_module_sources(use_statements(used_modules(source)), folder, seen, yes)
				sources += inner#1 + [source]
				seen = inner#2
				linked += inner#3
			} else if not names_no_module(name_of(used)) and not own_module_wasm.has(name_of(used)) {
				raise "no module, library or package named " + name_of(used) + ": no " + name_of(used) + ".warp beside the program or in lib/; a package is used by its path, use \"packages/" + name_of(used) + "/" + name_of(used) + ".warp\""
			}
		}
	}
	[sources, seen, linked]
}
# whether a file the folder holds takes the use (uses.warp file_used): of the program's own uses any file, of a standard
# module's uses only the module's own file (a module built in lib/ uses its neighbours so)
taken_as_file(statement: Node, folder: text, within_module: bool): bool := {
	file = file_used(statement, folder)
	file != ø and (not within_module or without_steps_up(file) == without_steps_up(std_module_path(name_of(use_target(statement)))))
}
# `use <module>` of each module, as a program's statements say them (a module's own read off its use lines, no parse
# of all of it)
use_statements(modules: list): list := modules.map(module => plain_node(parsed("use " + module)))
