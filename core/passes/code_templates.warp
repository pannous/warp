# Code templates (notes/quasi_quote.md): quoted code with holes, where no pattern stands, builds code: `$a` splices the
# value of a, `$(expr)` the value of expr, `$xs...` the items of xs. A pattern stands in the matcher's call, where
# type_tests puts the right side of `is`, an arm's key and the right side of `==`:
#   data($b - $a)            → filled_template(data($b - $a), {"b": b, "a": a})
#   data(m.pop($(str(k))))   → filled_template(data(m.pop($·1)), {"·1": str(k)})
# The prelude's filled_template puts the values in at run time; a quote without holes stays as it is.
use "walk.warp"
use "node_matches.warp"

template_word = "filled_template"
hole_mark = "$"
computed_mark = "·"

# whether the program's own code (with_used, before the prelude joins it) writes a template: no walk at all without one
global writes_templates = no
code_templates(program: Node): Node := if writes_templates then templated(program) else program

templated(n: Node): Node := {
	if is_quote(n) { return template_of(n) }
	if is_matcher_call(n) { return n }
	if is_key(n, Op.Eq) and is_quote(value_of(n)) { return Key(templated(key_of(n)), Op.Eq, value_of(n)) }
	if is_spaced(n) and items_of(n).any(item => item == symbol("match") or is_match_head(item)) { return group_like(n, matched_items(items_of(n))) }
	children(n, templated)
}

# `match c { data($a - $b) => data($b - $a) }`, before node_matches binds the names a result mentions: each arm's key
# a pattern, its result a template
matched_items(items: list): list := {
	made = []
	for at in 1 to #items {
		block = items#at
		made += [if is_arms_block(items, at) then group_like(block, items_of(block).map(templated_arm)) else templated(block)]
	}
	made
}
# the block after `match subject` (or after the head `(match subject)`)
is_arms_block(items: list, at: int): bool := is_curly_group(items#at) and ((at > 2 and items#(at - 2) == symbol("match")) or (at > 1 and is_match_head(items#(at - 1))))
templated_arm(arm: Node): Node := match arm {
	Key(pattern, op, result): Key(pattern, op, templated(result))
	_: templated(arm)
}

is_matcher_call(n: Node): bool := is_round(n) and #n > 0 and n#1 == symbol(matcher_word)

# `$a` (not `$0`, a function's first parameter): the name a
hole_name(n: Node): text? := {
	if not (n is symbol) { return ø }
	name = name_of(n)
	if #name > 1 and name.starts_with(hole_mark) and not is_digit(name#2) then name[1 ..] else ø
}

# the `$` of `$(expr)`, which the parser reads as the character
is_computed_hole_mark(n: Node): bool := match n {
	Char(c): "" + c == hole_mark
	Symbol(name): name == hole_mark
	_: no
}
# the holes of a quote found so far, name → the code of its value
global template_holes = {}
template_of(quote: Node): Node := {
	template_holes = {}
	content = holed(quote#2)
	if #template_holes.keys == 0 { return quote }
	values = List(template_holes.keys.map(name => Key(name, Op.Colon, template_holes[name])), Bracket.Curly, Separator.Comma)
	call_of(template_word, [group_like(quote, [quote#1, content]), values])
}

# the content with each `$(expr)` a numbered hole, every hole remembered; a quote within stays sealed
holed(n: Node): Node := {
	if is_quote(n) { return n }
	name = hole_name(n)
	if name != ø {
		template_holes[name] = symbol(name)
		return n
	}
	match n {
		Key(left, op, right): if left == opaque_symbol then n else Key(holed(left), op, holed(right))
		List(items, bracket, separator): group_like(n, holed_items(items))
		_: n
	}
}

holed_items(items: list): list := {
	made = []
	at = 1
	while at <= #items {
		if is_computed_hole_mark(items#at) and at < #items {
			name = computed_mark + (#template_holes.keys + 1)
			template_holes[name] = items#(at + 1)
			made += [symbol(hole_mark + name)]
			at += 2
		} else {
			made += [holed(items#at)]
			at += 1
		}
	}
	made
}

# a quote with a hole anywhere, whose filling the prelude gives (prelude_words.warp lowering_words)
writes_template_in(own: Node): bool := nodes_in(own).any(is_template)
has_holes(n: Node): bool := hole_name(n) != ø or is_computed_hole_mark(n) or (not is_quote(n) and parts_within(n).any(has_holes))
is_template(n: Node): bool := is_quote(n) and has_holes(n#2)
