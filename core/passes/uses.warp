# The pure lane follows `use` (card pure-follows-use): a program's `use "../parsing/lexer.warp"` brings in the declarations of
# that file, read from the program's folder; each used file once, the files it
# uses ahead of it. A `use` naming no file of the folder (`use os`, a std module) stays as written, a used file's too,
# so prelude_words.warp brings the words reached of that module.
use "../host_io.warp"
use "walk.warp"
use "../parsing/parser.warp"
use "scope.warp"
use "enum_declarations.warp"
use "../analysis/signatures.warp"

import_keywords = ["use", "require", "import", "include"]
# (function_keywords: words.warp's)
declaration_keywords = ["let", "var", "global", "stored", "const", "constant", "final", "val"]
# the declarations that keep a name main's: `global n = 0`; the others make it the function's own, `let n = 5`
global_declaration_keywords = ["global", "stored"]
local_declaration_keywords = declaration_keywords.filter(word => word not in global_declaration_keywords)
module_extension = ".warp"
# the word a module reads as the folder of its own file
module_directory_word = "module_directory"

# the program with the declarations of the files its uses name, read from `folder`, in front of it, and each
# `module_source("compiler/analysis/errors.data")` the text of that file of the compiler
with_uses(program: Node, folder: text): Node := {
	directed = with_own_aliases(with_module_directory(with_imports_as_uses(program), folder))
	timed("uses: used files")
	brought = used_in(directed, folder)
	timed("uses: module texts")
	bottom_up(brought, module_text)
}
# `from shapes import box`, `from palette import bright, dim` (decision modules-triage): Python's import of named words
# is warp's `use shapes`, every word of the module visible (extensions/from_imports.warp hints so); a used file's too
with_imports_as_uses(program: Node): Node := {
	statements = flat_statements(program)
	if not statements.any(statement => from_import(statement) != ø) { return program }
	separated(bracketed(statements.map(statement => if from_import(statement) == ø then statement else use_of(from_import(statement))), ""), ";")
}
# the module of `from shapes import box` (the comma statement `from palette import bright, dim` leads with it), else ø
from_import(statement: Node): any := {
	line = without_mark(statement)
	from_line(if is_group(line) and separator_of(line) == "," and #line > 0 then without_mark(line#1) else line)
}
from_line(n: Node): any := if is_group(n) and #n >= 4 and n#1 == symbol("from") and n#3 == symbol("import") then n#2 else ø
use_of(module: Node): Node := plain_node(parsed("use " + (if module is text then "\"" + module + "\"" else name_of(module))))
# `read(module_directory + "/data/x")`: module_directory is the folder of the file it is written in
with_module_directory(n: Node, folder: text): Node := bottom_up(n, x => if x == symbol(module_directory_word) then folder else x)
used_in(program: Node, folder: text): any := {
	written = flat_statements(program)
	statements = with_scope_declarations(written, folder)
	modules = written.map(use_target).filter(target => target is symbol and not names_no_module(name_of(target))).map(name_of)
	for statement in written { warn_replaced(statement, modules) }
	brought = declarations_used(statements, folder, [], {})
	if #brought#1 == 0 and not written.any(s => scope_used(s) != ø) { return program }
	kept = statements.filter(s => file_used(s, folder) == ø)
	separated(bracketed(brought#1 + kept, ""), ";")
}

# `use folder`, `use package`, `use project` (decision D15, wiki/use.md): a name the program binds nowhere itself comes
# from the files of that scope, together with the definitions it needs and its file's uses; a file is parsed only when
# its text holds a needed name. A needed name two files declare differently is the error naming both
SCOPE_WORDS = ["folder", "package", "project"]
# folders below a scope that stay outside it, besides hidden ones and nested repositories
OUTSIDE_SCOPES = ["packages", "target"]
# the scope a `use folder|package|project` names, ø for another statement
scope_used(statement: Node): any := {
	target = use_target(statement)
	if target is symbol and name_of(target) in SCOPE_WORDS then name_of(target) else ø
}
with_scope_declarations(statements: list, folder: text): list := {
	scopes = statements.map(scope_used).filter(scope => scope != ø)
	if #scopes == 0 { return statements }
	files = []
	for scope in scopes { files += files_below(scope_root(scope, folder), scope != "folder") }
	own = statements.filter(s => scope_used(s) == ø)
	bound = {}
	for name in own.map(declared_name).filter(name => name != ø) { bound[name] = yes }
	pending = own.flat_map(names_in)
	brought = []
	parses = {}
	taken = {}
	while #pending > 0 {
		name = pending#1
		pending = pending[1 ..< #pending]
		if not bound.has(name) {
			bound[name] = yes
			more = scope_brought(name, files, parses, taken)
			brought += more
			pending += more.flat_map(names_in)
		}
	}
	brought + own
}
# the declarations of `name` in one file of the scope, after that file's uses when it is the first file taken (noted in
# `taken`); a needed name two files declare differently is refused
scope_brought(name: text, files: list, parses: map, taken: map): list := {
	found = scope_declarations(name, files, parses)
	if #found == 0 { return [] }
	file = found#1#1
	clash = found.filter(pair => pair#1 != file and "${pair#2}" != "${found#1#2}")
	if #clash > 0 { raise name + " is declared in both " + working_relative(file) + " and " + working_relative(clash#1#1) + ": rename one, or keep one of them" }
	declarations = found.filter(pair => pair#1 == file).map(pair => pair#2)
	if taken.has(file) { return declarations }
	taken[file] = yes
	parses[file].filter(s => use_target(s) != ø).map(s => if file_used(s, folder_of(file)) == ø then s else use_of(file_used(s, folder_of(file)))) + declarations
}
# the names a node reads and binds nowhere itself: a parameter, a local or a loop variable is its own
names_in(n: Node): list := {
	own = names_bound_in(n)
	nodes_in(n).filter(x => x is symbol and not own.has(name_of(x))).map(name_of)
}
# [file, declaration] of each declaration of `name` in the files, each file parsed once, kept in `parses`; only a file
# with a line starting with the name, or with a keyword and the name, is parsed (a parameter `x` is in nearly every file)
scope_declarations(name: text, files: list, parses: map): list := {
	found = []
	heads = (["", "class ", "enum ", "type "] + function_keywords.map(word => word + " ") + declaration_keywords.map(word => word + " ")).map(word => "\n" + word + name)
	for file in files {
		lines = "\n" + file_text(file)
		if not heads.any(head => lines.contains(head)) { continue }
		if not parses.has(file) { parses[file] = flat_statements(with_module_directory(file_parsed(file), folder_of(file))) }
		for statement in parses[file] { if is_declaration(statement) and declared_name(statement) == name { found += [[file, statement]] } }
	}
	found
}
# the folder a scope covers: the program's own, the nearest above holding <its name>.warp, or the one holding .git
scope_root(scope: text, folder: text): text := {
	at = without_steps_up(absolute_folder(folder))
	root = if scope == "folder" then at else if scope == "project" then project_root(at) else package_root(at)
	if root == ø { raise "use " + scope + ": no folder above " + working_relative(at) + (if scope == "project" then " holds .git" else " holds a package file, <folder>/<folder>.warp") }
	root
}
package_root(at: text): any := {
	for folder in folders_upward(at) {
		parts = folder.split("/")
		if file_text(folder + "/" + parts#(#parts) + module_extension) != ø { return folder }
	}
	ø
}
# the module files in a folder, and with `deep` those of its folders, nested repositories left out
files_below(root: text, deep: bool): list := {
	listed = try list_files(root) else []
	if not (type(listed) is list) { return [] }
	files = []
	for name in listed.sort() {
		path = root + "/" + name
		if name.ends_with(module_extension) {
			files += [path]
		} else if deep and not name.contains(".") and name not in OUTSIDE_SCOPES and file_text(path + "/.git") == ø and file_text(path + "/.git/HEAD") == ø {
			files += files_below(path, yes)
		}
	}
	files
}

# `alias deque => Deque` (wiki/alias.md): the program's alias lines taken out, each alias naming its word wherever the
# program declares nothing of that name
alias_keyword = "alias"
# `twice => double` or `double <= twice`, an alias line after its keyword: [the new name, the word it names]; a plain
# `twice = double` says no direction and is refused (decision alias-arrows); [] for any other text, a WGSL `alias int =
# i32;` in a text (lib/compute_toys.warp)
alias_pair(written: text): list := {
	sides = alias_sides(written, "=>")
	if #sides == 0 { sides = alias_sides(written, "<=").reverse() }
	if #sides > 0 { return sides }
	plain = alias_sides(written, "=")
	if #plain == 2 { raise "`alias " + written + "`: " + alias_direction_fix(plain#1, plain#2) }
	[]
}
# the two plain names an arrow stands between, else []
alias_sides(written: text, arrow: text): list := {
	sides = written.split(arrow).map(side => side.trim())
	if #sides == 2 and is_plain_name(sides#1) and is_plain_name(sides#2) then sides else []
}
alias_direction_fix(name: text, word: text): text := "an alias says its direction with => or <=: alias " + name + " => " + word
with_own_aliases(program: Node): Node := {
	statements = statements_in(program)
	aliases = statements.map(word_alias).filter(pair => pair != ø)
	if #aliases == 0 { return program }
	own = statements.map(declared_name)
	renamed = aliases.filter(pair => pair#1 not in own)
	kept = statements.filter(s => word_alias(s) == ø)
	bottom_up(separated(bracketed(kept, ""), ";"), n => aliased(n, renamed))
}
# [alias, word] of an alias line, ø for another statement
word_alias(statement: Node): any := {
	if not (is_group(statement) and #statement == 2 and statement#1 == symbol(alias_keyword)) { return ø }
	match statement#2 {
		Key(alias, op, word): if op == Op.Assign and alias is symbol and word is symbol then [name_of(alias), name_of(word)] else ø
		_: ø
	}
}
aliased(n: Node, aliases: list): any := {
	if not (n is symbol) { return n }
	for pair in aliases { if name_of(n) == pair#1 { return symbol(pair#2) } }
	n
}

# `module_source("compiler/analysis/errors.data")`: that file's text, read at compile time: the compiler's own data, never a library's (decision core-takes-what-it-uses); a name with an
# extension, that file of lib/ (its links compiler/ and extensions/). A compiled compiler reads its own data from nowhere (decision built-in-lib)
module_text(n: Node): any := {
	if not (is_group(n) and bracket_of(n) == "(" and #n == 2 and n#1 == symbol("module_source") and n#2 is text) { return n }
	# the file itself, never a bundled copy: the compiler being built carries this tree's lib/
	path = module_source_path(n#2)
	source = try read(path) else ø
	if source == ø then n else source
}
# a table of texts by name packed, as `warp rebuild` writes one beside the modules, and read back
packed_table(table: map): text := pack(List(table.keys.map(key => keyed(":", key, table[key])), Bracket.Curly, Separator.Comma))
unpacked_table(body: text): map := {
	table = {}
	for entry in items_of(unpack(body)) {
		key: text = key_of(entry)
		table[key] = value_of(entry)
	}
	table
}
# the file module_source names: lib/<name>.warp, or the file within lib/ a name with an extension names
module_source_path(name: text): text := if name.contains(".") then run_library() + "/" + name else std_module_path(name)

# [the declarations, the files read]: those of each file the statements use, not yet among `seen`; each file's own
# declarations claim their signatures in `claimed` (claim_signatures)
declarations_used(statements: list, folder: text, seen: list, claimed: map): list := {
	declarations = []
	for statement in statements {
		file = file_used(statement, folder)
		# (by its absolute path: svg's `from colors` takes the very packages/colors/colors.warp a program's
		# `use "../../packages/colors/colors.warp"` names)
		if file != ø and without_steps_up(absolute_folder(file)) not in seen {
			seen += [without_steps_up(absolute_folder(file))]
			used = flat_statements(with_module_directory(file_parsed(file), folder_of(file)))
			note_file_origins(file, file_text(file))
			inner = declarations_used(used, folder_of(file), seen, claimed)
			seen = inner#2
			# a primitive file's foreign lines are its imports, declared as its functions are (primitive.warp declare_import)
			primitive = is_primitive_file(file_text(file))
			own = used.filter(s => (is_declaration(s) or use_target(s) is symbol or (primitive and foreign_import(s) != ø)) and file_used(s, folder_of(file)) == ø)
			claim_signatures(own, working_relative(file), claimed)
			declarations += inner#1 + own
		}
	}
	[declarations, seen]
}

# a used file's parse, parsed again each compile: keeping parses across runs saved about 1 % (card kept-values-retire)
# (each file parsed once for all its readers, kept with the text it was parsed from: a host compiling again after an
# edit, the repl or the page, parses the new text)
global file_trees = {}
file_parsed(file: text): Node := {
	source = file_text(file)
	if source is ø { raise working_relative(file) + ": no such file to use" }
	kept = file_trees.get(file)
	if kept == ø or kept#1 != source { file_trees[file] = [source, with_imports_as_uses(checked_parse(file, without_primitive_mark(source)))] }
	file_trees[file]#2
}
# a used file's tree; one that does not parse is the error naming the file, never a file of no declarations (card
# unclosed-core: an unclosed ( in a core file hid its later definitions)
checked_parse(file: text, source: text): Node := {
	timed("parse " + working_relative(file))
	tree = plain_node(parsed_from(source, shown_file(file), 1))
	for n in nodes_in(tree) {
		message = parse_error_message(n)
		if message != ø { raise working_relative(file) + ": " + message }
	}
	timed("after parsing")
	tree
}

# `use sound; play(x) := …`: a function of the program with the name and argument count of a module it uses replaces
# that module's in the program, and says so (wiki/use.md "your own function of the same name"); another count adds to
# the module's word, and a module the program needs without a `use` never warns
warn_replaced(statement: Node, modules: list) := {
	head = declared_head(statement)
	if head == ø { return }
	name = declared_name(statement)
	for module in modules {
		replaced = module_definitions(module, name).filter(definition => declared_head(definition) != ø and #declared_head(definition) == #head)
		if #replaced > 0 {
			diagnose(call_of(REPLACED_FACT, [name, module, written_head(declared_head(replaced#1))]), statement)
			return
		}
	}
}
REPLACED_FACT = "replaces_module_word"
# `(play tone)` as its definition writes it, play(tone)
written_head(head: Node): text := name_of(head#1) + "(" + items_of(head)[1..].map(parameter => "${parameter}").join(", ") + ")"

# A used file's declarations claim their signatures: another file declaring one already, differently, is the error
# naming both, since the later would silently replace the earlier (card module-name-clash); the same declaration in
# both is one
claim_signatures(declarations: list, file: text, claimed: map) := {
	for declaration in declarations {
		signature = declared_signature(declaration)
		if signature == ø { continue }
		if signature not in claimed {
			claimed[signature] = [file, declaration]
			continue
		}
		earlier = claimed[signature]
		# written out only on a clash: serializing every declaration of the compiler's files took the self build minutes
		if earlier#1 != file and "${earlier#2}" != "${declaration}" {
			raise signature + " is declared in both " + earlier#1 + " and " + file + ": rename one, or keep one of them"
		}
	}
}

# `f(x: int, y)` → "f(int, any)", the name and parameter types a declaration claims; a value's name alone, ø for
# another statement
declared_signature(statement: Node): any := {
	conversion = declared_conversion(statement) ?? shown_conversion(statement)
	if conversion != ø { return name_of(key_of(conversion)) + " as " + name_of(value_of(conversion)) }
	name = declared_name(statement)
	if name == ø { return ø }
	head = declared_head(statement)
	if head == ø { return name }
	name + "(" + items_of(head)[1..].map(parameter_type).join(", ") + ")"
}
parameter_type(parameter: Node): text := match parameter {
	Key(typed, op, kind): if op == Op.Colon then type_text(kind) else if op == Op.Assign then parameter_type(typed) else "any"
	_: "any"
}
# the head `(f x y)` of a function declaration, as declared_name finds its name; ø for a value
declared_head(statement: Node): any := match statement {
	Key(left, op, right): {
		if assigns_or_defines(op) { return call_head(left) }
		if op != Op.Colon { return ø }
		if is_keyword_group(left) then call_head(left#2) else ø
	}
	_: if is_keyword_group(statement) then call_head(statement#2) else ø
}
# `(f x)`, also typed `f(x): int` or before its block, `(f x) {…}`
call_head(n: Node): any := {
	if n is key { return call_head(key_of(n)) }
	if not (is_group(n) and #n > 0) { return ø }
	if n#1 is symbol then (if bracket_of(n) == "(" then n else ø) else call_head(n#1)
}

# lib/<name>.warp, a standard module's file (the std modules are the files of lib/, the folder above this one), or
# extensions/rules/<name>.warp, a module only the compiler uses: its rule words, run at compile time (decision
# library-zero-bake-plan 1b). It stays a module: brought in as its own file, its words reached, as from lib/ (an
# include of it as the compiler's own code typed the emitter's values anew: shown_text refused), or lib/host/<name>.warp,
# a module the native driver links itself (decision host-folder)
# the standard modules' files in positions.warp source_files, after the program's, numbered alike in every compile
numbered_module_files() := { global source_files; if #source_files == 1 { source_files += std_module_names.map(name => shown_file(std_module_path(name))) } }
std_module_path(name: text): text := own_module_files.get(name) ?? run_library() + module_folder(name) + name + module_extension
module_folder(name: text): text := if modules_in(COMPILER_MODULES).has(name) then COMPILER_MODULES else if is_host_module(name) then HOST_MODULES else if is_runtime_module(name) then "/extensions/" + name + "/" else "/"
# a standard module of runtime words, built apart from runtime.wasm (extension.warp runtime_modules)
is_runtime_module(name: text): bool := name in hooks().runtime_modules
# the words of the runtime modules a compile brings the source of: their functions compile as runtime words do
# (intrinsics, the runtime's own words). Only the module being written, or any a `warp build` compiles in: a program
# links them, and hello reads none of their files
# (found again only when the compile they depend on changes: the module written, whether modules are linked)
global runtime_module_words = ø
global runtime_module_words_for = ø
is_runtime_module_word(name: text): bool := {
	compile = [module_written, modules_linked]
	if runtime_module_words_for != compile {
		compiled = compiled_runtime_modules()
		runtime_module_words = word_set(compiled.flat_map(module => file_words(std_module_path(module))))
		runtime_module_words_for = compile
	}
	runtime_module_words.has(name)
}
compiled_runtime_modules(): list := hooks().runtime_modules.filter(module => module == module_written or not modules_linked)
# the definitions of a file and of the files beside it that it uses by path (never one above it, the core's runtime)
file_words(file: text): list := {
	source = file_text(file) ?? ""
	# (its parse's use statements: used_modules reads module names, a quoted path is no code to it)
	beside = statements_in(plain_node(parsed(source))).filter(statement => use_target(statement) is text and not use_target(statement).contains(".."))
	definition_slices(source).map(slice => slice#1) + beside.flat_map(statement => file_words(file_used(statement, folder_of(file))))
}
# a module of lib/host/: no program uses it, so none of its words brings it in (prelude_words.warp module_word_definers)
is_host_module(name: text): bool := modules_in(HOST_MODULES).has(name)
# A program's own module, compiled as a standard module is and linked like one (decision samples-modules-wasm:
# `import shapes` of a shapes.wasm with its warp.signature beside the program, which `warp build --module shapes.warp`
# writes): name → its .warp file, and name → its .wasm, which a program imports by that path (driver instance_path)
global own_module_files = {}
global own_module_wasm = {}
own_module(name: text, file: text, wasm: text) := {
	own_module_files[name] = file
	own_module_wasm[name] = wasm
}
COMPILER_MODULES = "/extensions/rules/"
HOST_MODULES = "/host/"
# the modules each such folder holds, by name, listed once
global modules_by_folder = {}
modules_in(folder: text): map := {
	if not modules_by_folder.has(folder) {
		names = {}
		listed = try list_files(run_library() + folder) else []
		if type(listed) is list { for file in listed { if file.ends_with(module_extension) { names[file[0 ..< #file - #module_extension]] = yes } } }
		modules_by_folder[folder] = names
	}
	modules_by_folder[folder]
}

# what a `use` statement names, ø for another statement
use_target(statement: Node): any := {
	if not (is_group(statement) and #statement == 2 and statement#1 is symbol and name_of(statement#1) in import_keywords) { return ø }
	target = path_text(statement#2)
	# a quoted name without an extension is the bare one: `use "list"` is `use list`, a file of the folder or a std module
	if target is text and not target.contains(".") { return symbol(target) }
	target
}
# the text a path literal marks, `./x.warp` parsed as `"./x.warp" as path` (core/parsing/parser.warp), so `use ./x.warp`
# names the file `use "./x.warp"` does (card colors-package-import); any other node as it is
path_text(n: Node): Node := if is_key(n, Op.As) and value_of(n) == symbol("path") and key_of(n) is text then key_of(n) else n

# the path of the file of the folder a `use` statement names, ø for another statement or a module of no such file
file_used(statement: Node, folder: text): any := {
	module = use_target(statement)
	if module is text { return rooted(module, folder) }
	# (a runtime module a build compiles in is its root file, whose own uses of the files beside it it brings)
	if module is symbol and name_of(module) in compiled_runtime_modules() { return std_module_path(name_of(module)) }
	if not (module is symbol) or name_of(module) in implicitly_used { return ø }
	path = path_in(folder, name_of(module) + module_extension)
	if file_text(path) != ø then path else package_file(name_of(module), folder)
}
# `use colors` naming no file beside and no standard module (decision packages-by-name): the main file of the package
# of that name in the project's packages/ (scripts/link-packages.sh links the registry's there), else in the registry's
# clone; its own files are then beside it (svg's shapes.warp)
REGISTRY_CLONE = "/.cache/warp/packages/.registry/"
package_file(name: text, folder: text): any := {
	if is_module_name(name) or names_no_module(name) { return ø }
	root = project_root(folder)
	places = (if root == ø then [] else [root + "/packages/"]) + [(started_env("HOME") ?? "") + REGISTRY_CLONE]
	found = places.map(place => place + name + "/" + name + module_extension).filter(file => file_text(file) != ø)
	if #found > 0 then found#1 else ø
}
# a file as messages name it: below the working folder relative to it, else as found
working_relative(file: text): text := {
	below = cwd + "/"
	if file.starts_with(below) then file.replace(below, "") else file
}
# a source file as a message names it: below the library folder `lib/…`, else working_relative, without `./` steps
shown_file(file: text): text := {
	library = run_library() + "/"
	if file.starts_with(library) { return "lib/" + file[#library ..] }
	shown = working_relative(file).replace("/./", "/")
	if shown.starts_with("./") then shown[2 ..] else shown
}
# `use "•/lib/x.warp"` (alias `@/`): the project root, the nearest folder above `folder` holding `.git`, plus the
# rest; no such folder refuses (decision project-root-paths). Any other name is relative to `folder`: a relative root
# (the page's `.`) is never joined to it
root_markers = ["•/", "@/"]
rooted(name: text, folder: text): text := {
	marker = root_markers.filter(m => name.starts_with(m))
	if #marker == 0 { return path_in(folder, name) }
	root = project_root(folder)
	if root == ø { raise name + ": no folder above " + working_relative(folder) + " holds .git; run `git init` at the project root or use a relative path" }
	without_steps_up(root + "/" + name[#marker#1 ..< #name])
}
project_root(folder: text): any := {
	# from the absolute folder: a relative one (`samples/wasm` of `warp samples/wasm/x.warp`) ran out before the
	# working folder that holds .git
	start = without_steps_up(absolute_folder(folder))
	for at in folders_upward(start) {
		if file_text(at + "/.git") != ø or file_text(at + "/.git/HEAD") != ø { return at }
	}
	# a relative working folder (the page's `.`, the served repository) is its own project when the climb ends at it
	if start == "." or start.starts_with("./") then "." else ø
}
# the folder and each above it: an absolute one up to /, a relative one up to its top, as the page's working folder
# is `.` (`./samples/wasm`, `./samples`), never on past it into `./..`
folders_upward(at: text): list := {
	folders = []
	while at != "" and at != "/" and at != "." and not at.ends_with("..") {
		folders += [at]
		at = without_steps_up(at + "/..")
	}
	folders
}
absolute_folder(folder: text): text := if folder.starts_with("/") then folder else cwd + "/" + folder
path_in(folder: text, name: text): text := without_steps_up(if name.starts_with("/") then name else folder + "/" + name)
# the path with each `folder/..` and inner `.` taken out, so a file two folders use is one file (runtime/extended/../text.warp is
# runtime/text.warp, card runtime-split), and `/project/test/./..` walks up to /project (card wasm-fixture-root)
without_steps_up(path: text): text := {
	kept = []
	for part in path.split("/") {
		if part == "." and #kept > 0 { continue }
		if part == ".." and #kept > 0 and kept#(#kept) not in ["..", "."] { kept = kept[0 ..< #kept - 1] } else { kept += [part] }
	}
	kept.join("/")
}
# a file comes as library.warp file_source gives it: read from the disk once a compile
file_text(path: text): any := file_source(path)

# what a used file brings: a class, `x = …`, `f(x) := …`,
# `global x = 0`, `def f(x) …`, a plain `enum Meaning {…}` (plain_enums.warp lowers it with the program), a named
# pattern; not its main-level statements
is_declaration(statement: Node): bool := match statement {
	Key(left, op, right): {
		if left == opaque_symbol { return kind_of(right) == "type" }
		if assigns_or_defines(op) { return yes }
		# `def f(x): list {…}`: the key of the head and its result type
		op == Op.Colon and (is_keyword_group(left) or is_declaration_keyword(left))
	}
	_: declared_enum(statement) != ø or is_keyword_group(statement) or is_pattern_definition(statement)
}
assigns_or_defines(op: Op): bool := op == Op.Assign or op == Op.Define
is_declaration_keyword(n: Node): bool := n is symbol and name_of(n) in declaration_keywords
# `def f(x) …`, `global x = 0`: a group a function or declaration keyword starts
is_keyword_group(n: Node): bool := is_group(n) and #n >= 2 and n#1 is symbol and (name_of(n#1) in function_keywords or is_declaration_keyword(n#1))

# the name a declaration defines: `f(x) := …`, `x = …`,
# `def f(x) …`, `def f(x): T {…}`, `global x = 0`, a foreign line `f(x): T from "c"`; ø for another statement
declared_name(statement: Node): any := match statement {
	Key(left, op, right): {
		if declared_conversion(statement) != ø { return ø }
		if assigns_or_defines(op) { return aliased_type_name(left) ?? leftmost_name(left) }
		if op != Op.Colon { return ø }
		if is_keyword_group(left) { return leftmost_name(left#2) }
		if is_declaration_keyword(left) then declared_name(right) else ø
	}
	_: if is_keyword_group(statement) or is_pattern_definition(statement) then leftmost_name(statement#2) else if is_foreign_line(statement) then leftmost_name(statement#1) else ø
}
# `n: number as Real := …`, `int as Real := …`: the conversion `number as Real`; it declares no name, its parameter n
# is its own (card conversion-name-declare); else ø
declared_conversion(statement: Node): any := {
	if not is_key(statement, Op.Define) { return ø }
	left = as_phrase_read(key_of(statement))
	conversion = if is_key(left, Op.Colon) and key_of(left) is symbol then value_of(left) else left
	if is_key(conversion, Op.As) and key_of(conversion) is symbol and value_of(conversion) is symbol then conversion else ø
}
# `Person as text` heading a definition, which the parser reads as a phrase of three words (`fib i as int := …` names a
# result so), as the conversion `Person as text`; any other head as it is
as_phrase_read(head: Node): Node := if is_group(head) and #head == 3 and head#2 == symbol("as") then Key(head#1, Op.As, head#3) else head
# `format Color c as text := …`: the conversion `Color as text` it claims, one per type, so two modules each formatting
# their own type don't clash; else ø
shown_conversion(statement: Node): any := {
	head = if is_key(statement, Op.Define) then key_of(statement) else ø
	if is_group(head) and #head == 5 and head#1 == symbol("format") and head#4 == symbol("as") then Key(head#2, Op.As, head#5) else ø
}
# `sqrt(x: f64): f64 from "c"`: a foreign line, whose word is the program's own (a library's sqrt is not the one called)
is_foreign_line(n: Node): bool := is_group(n) and bracket_of(n) == "" and #n == 3 and n#2 == symbol("from")
# `type View = list or int`: the alias's name, View (its left side is the opaque view ["type", name, ø]), else ø
aliased_type_name(left: Node): text? := if is_key(left, Op.Colon) and key_of(left) == opaque_symbol and kind_of(value_of(left)) == "type" then declared_type_name(value_of(left)#2) else ø
leftmost_name(n: Node): any := {
	if n is symbol { return name_of(n) }
	if n is key { return leftmost_name(key_of(n)) }
	if is_group(n) and #n > 0 { return leftmost_name(n#1) }
	ø
}
