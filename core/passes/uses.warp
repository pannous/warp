# The pure lane follows `use` (card pure-follows-use): a program's `use "../parsing/lexer.warp"` brings in the declarations of
# that file, read from the program's folder, as rust-harness:src/modules/loader.rs brings them; each used file once, the files it
# uses ahead of it. A `use` naming no file of the folder (`use os`, a std module) stays as written, a used file's too,
# so prelude_words.warp brings the words reached of that module.
use os
use "walk.warp"
use "../parsing/parser.warp"
use "scope.warp"
use "enum_declarations.warp"
use "../analysis/signatures.warp"

import_keywords = ["use", "require", "import", "include"]
# (function_keywords: words.warp's)
# rust-harness:src/modules/declarations.rs DECLARATION_KEYWORDS and CONSTANT_KEYWORDS
declaration_keywords = ["let", "var", "global", "stored", "const", "constant", "final", "val"]
# the declarations that keep a name main's: `global n = 0`; the others make it the function's own, `let n = 5` (Rust
# is_declaration_word)
global_declaration_keywords = ["global", "stored"]
local_declaration_keywords = declaration_keywords.filter(word => word not in global_declaration_keywords)
module_extension = ".warp"
# the word a module reads as the folder of its own file (Rust twin: rust-harness:src/modules/loader.rs MODULE_DIRECTORY)
module_directory_word = "module_directory"

# the program with the declarations of the files its uses name, read from `folder`, in front of it, and each
# `module_source("prelude")` the text of that standard module
with_uses(program: Node, folder: text): Node := {
	directed = with_own_aliases(with_module_directory(program, folder))
	timed("uses: used files")
	brought = used_in(directed, folder)
	timed("uses: module texts")
	bottom_up(brought, module_text)
}
# `read(module_directory + "/data/x")`: module_directory is the folder of the file it is written in (Rust's
# loader.rs with_module_directory)
with_module_directory(n: Node, folder: text): Node := bottom_up(n, x => if x == symbol(module_directory_word) then folder else x)
used_in(program: Node, folder: text): any := {
	statements = flat_statements(program)
	brought = declarations_used(statements, folder, [], {})
	if #brought#1 == 0 { return program }
	kept = statements.filter(s => file_used(s, folder) == ø)
	separated(bracketed(brought#1 + kept, ""), ";")
}

# `alias deque = Deque` (wiki/alias.md): the program's alias lines taken out, each alias naming its word wherever the
# program declares nothing of that name, as Rust's modules.rs with_own_aliases
alias_keyword = "alias"
with_own_aliases(program: Node): Node := {
	statements = statements_in(program)
	aliases = statements.map(word_alias).filter(pair => pair != ø)
	if #aliases == 0 { return program }
	own = statements.map(declared_name)
	renamed = aliases.filter(pair => pair#1 not in own)
	kept = statements.filter(s => word_alias(s) == ø)
	bottom_up(separated(bracketed(kept, ""), ";"), n => aliased(n, renamed))
}
# [alias, word] of an alias line, ø for another statement (Rust twin: rust-harness:src/modules/declarations.rs word_alias)
word_alias(statement: Node): any := {
	if not (is_group(statement) and #statement == 2 and statement#1 == symbol(alias_keyword)) { return ø }
	match statement#2 {
		Key(alias, op, word): if op == Op.Assign and alias is symbol and word is symbol then [name_of(alias), name_of(word)] else ø
		_: ø
	}
}
aliased(n: Node, aliases: list): any := {
	if not (n is symbol) { return n }
	for pair in aliases { if name_of(n) == pair#1 { return symbol(pair#2) } }
	n
}

# the empty call `library_sources()` … of the baked table `name`, its computing marked (WARP_TIMES)
def is_baking(n: Node, word: text, name: text): bool := {
	if not is_empty_call(n, word) { return no }
	timed("computing " + name)
	yes
}
# `module_source("prelude")`: lib/prelude.warp's text, read at compile time as rust-harness:src/lowering/words/library_words.rs
# writes it out (the std modules are lib/<name>.warp); `module_source("compiler/analysis/errors.data")`, a name with an
# extension, that file of lib/; `library_sources()`, every module of lib/ (parser.warp LIBRARY_FILES), `library_parses()`
# their parses (LIBRARY_PARSES), `slice_parses()` their definitions' parses (SLICE_PARSES). A compiled
# compiler reads its own data from nowhere (user 2026-10-25: "These should all be built in"; decision built-in-lib)
module_text(n: Node): any := {
	if is_baking(n, "library_sources", "LIBRARY_FILES") { return baked_literal("LIBRARY_FILES", library_texts(run_library(), "")) }
	if is_baking(n, "library_parses", "LIBRARY_PARSES") { return baked_literal("LIBRARY_PARSES", packed_parses(library_texts(run_library(), ""))) }
	if is_baking(n, "library_slices", "LIBRARY_SLICES") { return baked_literal("LIBRARY_SLICES", baked_slices(library_texts(run_library(), ""))) }
	if is_baking(n, "std_rule_needs", "STD_RULE_NEEDS") { return baked_literal("STD_RULE_NEEDS", scanned_rule_needs()) }
	if is_baking(n, "library_rules", "LIBRARY_RULES") { return baked_literal("LIBRARY_RULES", packed_rules(library_texts(run_library(), ""))) }
	if is_baking(n, "block_heads", "BLOCK_HEADS") { return baked_literal("BLOCK_HEADS", block_heads_in(library_texts(run_library(), ""))) }
	if is_baking(n, "slice_parses", "SLICE_PARSES") { return baked_literal("SLICE_PARSES", packed_slice_parses(library_texts(run_library(), ""))) }
	if not (is_group(n) and bracket_of(n) == "(" and #n == 2 and n#1 == symbol("module_source") and n#2 is text) { return n }
	# the file itself, never a bundled copy: the compiler being built carries this tree's lib/
	path = module_source_path(n#2)
	source = try read(path) else ø
	if source == ø then n else source
}
is_empty_call(n: Node, name: text): bool := is_group(n) and bracket_of(n) == "(" and #n == 1 and n#1 == symbol(name)
# each file's parse, packed (parser.warp LIBRARY_PARSES), made here: never the building compiler's own baked one
packed_parses(files: map): map := {
	parses = {}
	for path in files.keys { parses[path] = pack(file_parse(path, files[path])) }
	parses
}
# a library file's parse, parsed once for both tables of parses
global file_parses = {}
file_parse(path: text, source: text): Node := {
	kept = file_parses.get(path)
	if kept != ø and kept#1 == source { return kept#2 }
	tree = plain_node(parsed(rules_ended(source)))
	file_parses[path] = [source, tree]
	tree
}
# each top-level module's slices, by their place (prelude_words.warp SLICE_PARSES, slice_key): its statements cut
# from the file's parse, so the file is parsed once and a definition keeps its line in the file
packed_slice_parses(files: map): map := {
	parses = {}
	for path in files.keys {
		if not path.contains("/") and path.ends_with(module_extension) {
			source = files[path]
			spans = slice_spans(source)
			held = statements_by_slice(statements_in(file_parse(path, source)), spans, span_lines(source, spans))
			for index in 0 ..< #spans {
				owned = held.get("${index}") ?? []
				cut = if #owned == 1 then owned#1 else separated(bracketed(owned, ""), ";")
				parses[slice_key(path, "${spans[index]#2}")] = pack(cut)
			}
		}
	}
	parses
}
# each slice's statements of the file's parse, by the slice's index: a statement goes to the slice its line falls in,
# a class to the next slice of its name (its node is placed where the statement before it ended, so its line misleads)
statements_by_slice(statements: list, spans: list, ranges: list): map := {
	slices_named = {}
	for index in 0 ..< #spans { slices_named[spans[index]#1] = (slices_named.get(spans[index]#1) ?? []) + [index] }
	taken = {}
	held = {}
	for statement in statements {
		name = aliased_type_name(statement)
		named = if name is text then slices_named.get(name) ?? [] else []
		used = if name is text then taken.get(name) ?? 0 else 0
		owner = if used < #named then named[used] else slice_holding(ranges, (written_at(statement) ?? [0])#1)
		if used < #named { taken[name] = used + 1 }
		if owner != ø { held["${owner}"] = (held.get("${owner}") ?? []) + [statement] }
	}
	held
}
# the index of the slice whose lines hold the line, ø for none
slice_holding(ranges: list, wanted_line: int): int? := {
	for index in 0 ..< #ranges { if ranges[index]#1 <= wanted_line and wanted_line <= ranges[index]#2 { return index } }
	ø
}
# [first, last] line of each slice in its file
span_lines(source: text, spans: list): list := {
	ranges = []
	first_line = 1
	at = 0
	for span in spans {
		first_line += #source[at ..< span#2].split("\n") - 1
		at = span#2
		ranges += [[first_line, first_line + #source[span#2 ..< span#3].split("\n") - 1]]
	}
	ranges
}
# each file's slices (prelude_words.warp LIBRARY_SLICES), a line `name start end` per slice
baked_slices(files: map): map := {
	slices = {}
	for path in files.keys { slices[path] = slice_spans(files[path]).map(span => "${span#1} ${span#2} ${span#3}").join("\n") }
	slices
}
# `baked-current <file>`: yes when the library baked into this compiler is cut and parsed as this very compiler cuts
# and parses it, else no. One built by an older compiler (the seed) carries that one's slices and parses, so `warp
# rebuild` builds it once more by itself: the baked library is always the built compiler's (card once-seed)
write_baked_current(file: text) := {
	stale = baked_tables().filter(table => not same_texts(table#2, table#3)).map(table => table#1)
	write(file, if #stale == 0 then "yes" else "no: " + stale.join(", "))
}
# [name, baked in, as this compiler makes it of lib/ as it lies now] of each table module_text bakes from the library:
# `rebake` writes the third over the second, so a lib/-only change needs no compile (decision lib-hash-rebake); a new
# baked table joins here
baked_tables(): list := {
	files = library_texts(run_library(), "")
	[["LIBRARY_FILES", LIBRARY_FILES, files], ["BLOCK_HEADS", BLOCK_HEADS, block_heads_in(files)], ["LIBRARY_SLICES", LIBRARY_SLICES, baked_slices(files)], ["LIBRARY_PARSES", LIBRARY_PARSES, packed_parses(files)], ["SLICE_PARSES", SLICE_PARSES, packed_slice_parses(files)], ["LIBRARY_RULES", LIBRARY_RULES, packed_rules(files)], ["STD_RULE_NEEDS", STD_RULE_NEEDS, scanned_rule_needs()]]
}
# a baked table as the code of its read: one segment of its own (baked_segment_text) that `rebake` can write anew
baked_literal(name: text, table: map): Node := List([symbol("unbaked_table"), List([symbol("baked_segment"), baked_segment_text(name, table)], Bracket.Round, Separator.None)], Bracket.Round, Separator.None)
# a baked table's segment: its body's byte count in BAKED_LENGTH_DIGITS digits, the line `warp.baked <name>` padded to
# BAKED_HEADER_BYTES, then the body, its entries packed
BAKED_LENGTH_DIGITS = 10
BAKED_HEADER_BYTES = 42
BAKED_MARK = "warp.baked "
baked_segment_text(name: text, table: map): text := {
	body: text = pack(List(table.keys.map(key => keyed(":", key, table[key])), Bracket.Curly, Separator.Comma))
	body_bytes: int = byte_size(body)
	count_text: text = "${body_bytes}"
	zeros: int = BAKED_LENGTH_DIGITS - #count_text
	head: text = ("0" * zeros) + count_text + BAKED_MARK + name
	spaces: int = BAKED_HEADER_BYTES - 1 - #head
	head + (" " * spaces) + "\n" + body
}
unbaked_table(body: text): map := {
	table = {}
	for entry in items_of(unpack(body)) {
		key: text = key_of(entry)
		table[key] = value_of(entry)
	}
	table
}
# `rebake <file>`: the compiler at file with each baked table as this compiler makes it (baked_tables), written over
# its segment: code and numbering stay, so `warp rebuild` needs no second compile where the seed cut and parsed the
# library otherwise (decision rebake-tables). A compiler whose tables are no segments (built by an older seed) stays
write_rebaked(file: text) := {
	wasm = read_bytes(file)
	place = section_place(wasm, section_ids.data)
	made = {}
	for table in baked_tables() { made[table#1] = table#3 }
	segments = []
	rebaked = []
	for segment in entries_after(wasm[place#1 ..< place#2], 0, yes) {
		name = baked_name(segment, made.keys)
		if name == ø { segments += [segment] } else {
			segments += [passive(baked_segment_text(name, made[name]).bytes)]
			rebaked += [name]
		}
	}
	found = #rebaked
	tables = #made
	if found < tables { print "rebake: ${file} carries ${found} of the ${tables} baked tables as segments of their own, left as it is" } else {
		size_bytes = uleb(place#2 - place#1)
		section_start = place#1 - 1 - #size_bytes
		ahead = wasm[0 ..< section_start]
		behind = wasm[place#2 ..< #wasm]
		write_bytes(file, ahead + section(section_ids.data, vector(segments)) + behind)
	}
}
# the baked table a data segment holds (its mark after the digits), ø for any other segment
baked_name(segment: list, names: list): text? := {
	size = uleb_read(segment, 1)
	bytes_at = size#2 + BAKED_LENGTH_DIGITS
	for name in names {
		mark = (BAKED_MARK + name + " ").bytes
		if bytes_at + #mark <= #segment and segment[bytes_at ..< bytes_at + #mark] == mark { return name }
	}
	ø
}
same_texts(a: map, b: map): bool :=#a == #b and a.keys.all(key => b.get(key) == a[key])
# a map of texts as the code of its literal, `{"prelude.warp": "…", …}`: a map value is no code the passes can walk
library_literal(files: map): Node := listed("{", ",", files.keys.map(path => keyed(":", path, files[path])))
# the file module_source names: lib/<name>.warp, or the file within lib/ a name with an extension names
module_source_path(name: text): text := if name.contains(".") then run_library() + "/" + name else std_module_path(name)

# [the declarations, the files read]: those of each file the statements use, not yet among `seen`; each file's own
# declarations claim their signatures in `claimed` (claim_signatures)
declarations_used(statements: list, folder: text, seen: list, claimed: map): list := {
	declarations = []
	for statement in statements {
		file = file_used(statement, folder)
		if file != ø and file not in seen {
			seen += [file]
			used = flat_statements(with_module_directory(file_parsed(file), folder_of(file)))
			note_file_origins(file, file_text(file))
			inner = declarations_used(used, folder_of(file), seen, claimed)
			seen = inner#2
			# a primitive file's foreign lines are its imports, declared as its functions are (primitive.warp declare_import)
			primitive = is_primitive_file(file_text(file))
			own = used.filter(s => (is_declaration(s) or use_target(s) is symbol or (primitive and foreign_import(s) != ø)) and file_used(s, folder_of(file)) == ø)
			claim_signatures(own, working_relative(file), claimed)
			declarations += inner#1 + own
		}
	}
	[declarations, seen]
}

# a used file's parse, parsed again each compile: keeping parses across runs saved about 1 % (card kept-values-retire)
file_parsed(file: text): Node := {
	source = file_text(file)
	if source is ø { raise working_relative(file) + ": no such file to use" }
	checked_parse(file, without_primitive_mark(source))
}
# a used file's tree; one that does not parse is the error naming the file, never a file of no declarations (card
# unclosed-core: an unclosed ( in a core file hid its later definitions)
checked_parse(file: text, source: text): Node := {
	timed("parse " + working_relative(file))
	tree = plain_node(parsed(source))
	for n in nodes_in(tree) {
		message = parse_error_message(n)
		if message != ø { raise working_relative(file) + ": " + message }
	}
	timed("after parsing")
	tree
}

# A used file's declarations claim their signatures: another file declaring one already, differently, is the error
# naming both, since the later would silently replace the earlier (card module-name-clash); the same declaration in
# both is one
# Rust twin: rust-harness:src/modules/loader.rs claim_signatures
claim_signatures(declarations: list, file: text, claimed: map) := {
	for declaration in declarations {
		signature = declared_signature(declaration)
		if signature == ø { continue }
		if signature not in claimed {
			claimed[signature] = [file, declaration]
			continue
		}
		earlier = claimed[signature]
		# written out only on a clash: serializing every declaration of the compiler's files took the self build minutes
		if earlier#1 != file and "${earlier#2}" != "${declaration}" {
			raise signature + " is declared in both " + earlier#1 + " and " + file + ": rename one, or keep one of them"
		}
	}
}

# `f(x: int, y)` → "f(int, any)", the name and parameter types a declaration claims; a value's name alone, ø for
# another statement
# Rust twin: rust-harness:src/modules/declarations.rs declared_signature, parameter_type
declared_signature(statement: Node): any := {
	name = declared_name(statement)
	if name == ø { return ø }
	head = declared_head(statement)
	if head == ø { return name }
	name + "(" + items_of(head)[1..].map(parameter_type).join(", ") + ")"
}
parameter_type(parameter: Node): text := match parameter {
	Key(typed, op, kind): if op == Op.Colon then type_text(kind) else if op == Op.Assign then parameter_type(typed) else "any"
	_: "any"
}
# the head `(f x y)` of a function declaration, as declared_name finds its name; ø for a value
declared_head(statement: Node): any := match statement {
	Key(left, op, right): {
		if assigns_or_defines(op) { return call_head(left) }
		if op != Op.Colon { return ø }
		if is_keyword_group(left) then call_head(left#2) else ø
	}
	_: if is_keyword_group(statement) then call_head(statement#2) else ø
}
# `(f x)`, also typed `f(x): int` or before its block, `(f x) {…}`
call_head(n: Node): any := {
	if n is key { return call_head(key_of(n)) }
	if not (is_group(n) and #n > 0) { return ø }
	if n#1 is symbol then (if bracket_of(n) == "(" then n else ø) else call_head(n#1)
}

# lib/<name>.warp, a standard module's file (the std modules are the files of lib/, the folder above this one)
std_module_path(name: text): text := run_library() + "/" + name + module_extension

# what a `use` statement names, ø for another statement
use_target(statement: Node): any := {
	if not (is_group(statement) and #statement == 2 and statement#1 is symbol and name_of(statement#1) in import_keywords) { return ø }
	# a quoted name without an extension is the bare one: `use "list"` is `use list`, a file of the folder or a std module
	if statement#2 is text and not statement#2.contains(".") { return symbol(statement#2) }
	statement#2
}

# the path of the file of the folder a `use` statement names, ø for another statement or a module of no such file
file_used(statement: Node, folder: text): any := {
	module = use_target(statement)
	if module is text { return path_in(folder, module) }
	if not (module is symbol) { return ø }
	path = path_in(folder, name_of(module) + module_extension)
	if file_text(path) == ø then ø else path
}
# a file as Rust's messages name it (loader.rs relative_path): below the working folder relative to it, else as found
working_relative(file: text): text := {
	below = cwd + "/"
	if file.starts_with(below) then file.replace(below, "") else file
}
path_in(folder: text, name: text): text := without_steps_up(if name.starts_with("/") then name else folder + "/" + name)
# the path with each `folder/..` taken out, so a file two folders use is one file (runtime/extended/../text.warp is
# runtime/text.warp, card runtime-split)
without_steps_up(path: text): text := {
	kept = []
	for part in path.split("/") {
		if part == ".." and #kept > 0 and kept#(#kept) != ".." { kept = kept[0 ..< #kept - 1] } else { kept += [part] }
	}
	kept.join("/")
}
# a file of lib/ comes as parser.warp file_source gives it: from the disk under WARP_LIB, else from the bundle, whose
# texts are lib/ as it was when the compiler was built (a module changed since must be read)
file_text(path: text): any := file_source(path)

# what a used file brings, as rust-harness:src/modules/declarations.rs is_declaration: a class, `x = …`, `f(x) := …`,
# `global x = 0`, `def f(x) …`, a plain `enum Meaning {…}` (plain_enums.warp lowers it with the program), a named
# pattern; not its main-level statements
is_declaration(statement: Node): bool := match statement {
	Key(left, op, right): {
		if left == opaque_symbol { return kind_of(right) == "type" }
		if assigns_or_defines(op) { return yes }
		# `def f(x): list {…}`: the key of the head and its result type
		op == Op.Colon and (is_keyword_group(left) or is_declaration_keyword(left))
	}
	_: declared_enum(statement) != ø or is_keyword_group(statement) or is_pattern_definition(statement)
}
assigns_or_defines(op: Op): bool := op == Op.Assign or op == Op.Define
is_declaration_keyword(n: Node): bool := n is symbol and name_of(n) in declaration_keywords
# `def f(x) …`, `global x = 0`: a group a function or declaration keyword starts
is_keyword_group(n: Node): bool := is_group(n) and #n >= 2 and n#1 is symbol and (name_of(n#1) in function_keywords or is_declaration_keyword(n#1))

# the name a declaration defines, as rust-harness:src/modules/declarations.rs name_declared_by: `f(x) := …`, `x = …`,
# `def f(x) …`, `def f(x): T {…}`, `global x = 0`, a foreign line `f(x): T from "c"`; ø for another statement
declared_name(statement: Node): any := match statement {
	Key(left, op, right): {
		if assigns_or_defines(op) { return aliased_type_name(left) ?? leftmost_name(left) }
		if op != Op.Colon { return ø }
		if is_keyword_group(left) { return leftmost_name(left#2) }
		if is_declaration_keyword(left) then declared_name(right) else ø
	}
	_: if is_keyword_group(statement) or is_pattern_definition(statement) then leftmost_name(statement#2) else if is_foreign_line(statement) then leftmost_name(statement#1) else ø
}
# `sqrt(x: f64): f64 from "c"`: a foreign line, whose word is the program's own (a library's sqrt is not the one called)
is_foreign_line(n: Node): bool := is_group(n) and bracket_of(n) == "" and #n == 3 and n#2 == symbol("from")
# `type View = list or int`: the alias's name, View (its left side is the opaque view ["type", name, ø]), else ø
aliased_type_name(left: Node): text? := if is_key(left, Op.Colon) and key_of(left) == opaque_symbol and kind_of(value_of(left)) == "type" then declared_type_name(value_of(left)#2) else ø
leftmost_name(n: Node): any := {
	if n is symbol { return name_of(n) }
	if n is key { return leftmost_name(key_of(n)) }
	if is_group(n) and #n > 0 { return leftmost_name(n#1) }
	ø
}
