# The tree walk every lowering pass shares (notes/self_hosting.md step 10), and the bridge between a node and its
# plain-data view (the form serializer.warp documents). A pass is a word from node to node.
use "../analysis/words.warp"

# a view kind with no node of its own in warp (an error, a type, sealed data): kept as written, behind this word
opaque_word = HiddenWord.ViewOpaque as text
# the word as a symbol, made once: the walks compare the left side of every key they pass with it
opaque_symbol = symbol(opaque_word)
# a time literal as the parser views it, ["data", "2024-02-29"]; the prelude word its fields are read with
# (extensions/time_values.warp time_field)
is_time_view(n: Node): bool := n is key and key_of(n) == opaque_symbol and kind_of(value_of(n)) == "data"
time_field_word = "time_field_of"
# a number literal past int64 or past 18 places as the parser views it, ["number", "100000000000000000000"] (parser.warp
# whole_number, decimal_value): a number to the rules all the same
is_big_number_view(n: Node): bool := n is key and key_of(n) == opaque_symbol and kind_of(value_of(n)) == "number"
# `+ - *` of a run-time time: lib/time_arithmetic.warp's word, its module (extensions/time_values.warp time_operation_call)
time_operation_word = "time_operation"
# what an operand of those is before its parts are read: a time, or a quantity lib/units moves it by (`t + 1 h`)
time_operand_word = "time_operand"
time_arithmetic_module = "time_arithmetic"
time_operator_symbols = ["+", "-", "*"]

# the arm of a match any value takes, `_: …`
other_arm = "_"

kind_of(view: View): text := if view is list and #view > 0 then view#1 else ""
# a group, whatever its bracket: `{…}` deeper in a tree is a map at run time, `is list` holds only for the others
is_group(n: Node): bool := bracket_of(n) != ø
# the separators of a group of statements, `a; b` and lines
statement_separators = [";", "\n"]
is_curly_group(n: Node): bool := is_group(n) and bracket_of(n) == "{"
# [word, block] of a word keying a block, `div{…}`, or written before it, `div {…}` (one form, as `Person { … }` is
# the class's); [] of other code
tag_parts(n: Node): list := {
	parts = if is_key(n, Op.Colon) or is_key(n, Op.None) then [key_of(n), value_of(n)] else if is_group(n) and bracket_of(n) == "" and separator_of(n) == " " and #n == 2 then [n#1, n#2] else []
	if #parts == 2 and parts#1 is symbol and is_curly_group(parts#2) then parts else []
}
# a key of that operator, `is_key(n, Op.Colon)` of `a: 1`
is_key(n: Node, op: Op): bool := match n {
	Key(_, written, _): written == op
	_: no
}
# every value `name = v` or `name: T = v` assigns in n, outside the definitions and lambdas inside
assigned_values(n: Node, name: text): list := {
	if is_key(n, Op.Define) or is_key(n, Op.Arrow) { return [] }
	inner = parts_of(n).flat_map(part => assigned_values(part, name))
	if is_key(n, Op.Assign) and assigned_variable(key_of(n)) == symbol(name) { return [value_of(n)] + inner }
	inner
}
assigned_variable(target: Node): Node := match target {
	Key(variable, Op.Colon, _): variable
	_: target
}

# an attribute layer (`@name(v) x`, the mark of `x!`) as a node: [name, value, node] behind this word, which a pass
# walks into
attribute_word = HiddenWord.ViewAttribute as text
# `x!` of a name no mutation takes: `unwrap(x)` (parser.warp forced)
unwrap_word = "unwrap"
# the number a subscript was written with, `1` of `d[1]` on its shifted index `d#2`
written_index_mark = "written_index"
# the `1` `xs[i]` adds to i for `xs#(i+1)` (Rust: warp_parser SubscriptOffset): a position i meets the brackets as it
# is, `xs#i` (index_positions.warp); plain_node keeps it for a program's own code, index_positions drops it
subscript_offset_mark = "subscript_offset"

# the view of `{}`, `[]`, `()`: no items
is_empty_group(view: View): bool := kind_of(view) == "list" and #view == 3
# the bracket of an empty map `{}` or list `[]` as plain_node keeps it, behind the opaque word; "" for any other node
empty_group_bracket(n: Node): text := match n {
	Key(left, op, right): { if left == opaque_symbol and is_empty_group(right) then right#2 else "" }
	_: ""
}
is_empty_map(n: Node): bool := empty_group_bracket(n) == "{"
is_empty_list(n: Node): bool := empty_group_bracket(n) == "["

# the node parser.warp builds as plain gives its view: no attribute layers but the mark of `x!`, an empty group as ø but
# the empty map `{}` (number_keys.warp keys a variable that starts as one by texts) and the empty list `[]`,
# a character as a text, an opaque type or error whole
# the node made at the place of `at`, where the user wrote the code it stands for (a rewritten form, a rebuilt group)
placed(made: Node, at: Node): Node := {
	line = line_of(at)
	column = column_of(at)
	if line is int and column is int then positioned(made, line, column) else made
}

# n without its attributes, opaque empty groups and characters, keeping the place it was written at: the parser places a
# call on its group, which a rebuilt group would lose, so a refusal of the call would name the node before it
# kept: the attributes left in the tree for a later pass to read, the subscript offset of a program's own `xs[i]`
plain_node(n: Node, kept: list = []): Node := {
	plain = plain_parts(n, kept)
	if plain === ø or is_positioned(plain) then plain else placed(plain, n)
}
# the attributes the extensions read past plain_node (their rows' attributes), each noting the names it marks:
# `@primitive add(…) := …` marks add, `@pure f(x) := …` f
read_attributes(): list := hooks().attributes
global marked_names = {}
marked(attribute: any, n: Node): Node := {
	name = if n is symbol then name_of(n) else if is_group(n) and #n > 0 and n#1 is symbol then name_of(n#1) else ø
	if attribute in read_attributes() and name != ø { marked_names[attribute] = (marked_names.get(attribute) ?? []) + [name] }
	n
}
function_reference_mark = "function_reference"
# `(function f)`: the function named alone in a group, its value as `function f` is (parser.warp function_reference),
# never the call `(f)` the group would make without its mark
# (a rule's `(function $d)` keeps its group: its hole alone would match anything)
is_referenced_alone(n: Node): bool := {
	if not (is_group(n) and bracket_of(n) == "(" and #n == 1 and type(n#1) is key and key_of(n#1) == symbol(attribute_word)) { return no }
	marking = value_of(n#1)
	marking#1 == function_reference_mark and marking#3 is symbol and not name_of(marking#3).starts_with("$")
}
plain_parts(n: Node, kept: list): Node := match n {
	Key(left, op, right): {
		if left == symbol(attribute_word) {
			if right#1 in kept { return n }
			return marked(right#1, plain_node(right#3, kept))
		}
		if left == opaque_symbol { return if is_empty_group(right) and right#2 not in ["{", "["] then ø else n }
		Key(plain_node(left, kept), op, plain_node(right, kept))
	}
	List(items, bracket, separator): if is_referenced_alone(n) then plain_node(items#1, kept) else List(items.map(item => plain_node(item, kept)), bracket, separator)
	// lowering reads a one-character literal as a text, as node_of does
	Char(c): "" + c
	_: n
}

# the node a view stands for
node_of(view: View): Node := node_from(view, no)
# the node of a view handed to a pass stage: the empty map `{}` behind the opaque word, as plain_node keeps it for
# number_keys
stage_node(view: View): Node := node_from(view, yes)
node_from(view: View, keeps_maps: bool): Node := {
	kind = kind_of(view)
	part = inner => node_from(inner, keeps_maps)
	if kind == "symbol" { return symbol(view#2) }
	if kind == "text" { return view#2 }
	// lowering reads a one-character literal as a text
	if kind == "char" { return "" + view#2 }
	if kind == "key" { return Key(part(view#3), view#2 as Op, part(view#4)) }
	if keeps_maps and is_empty_group(view) and view#2 == "{" { return Key(symbol(opaque_word), Op.Colon, view) }
	if kind == "list" { return List(view[3..].map(item => part(item)), view#2 as Bracket, view#3 as Separator) }
	if kind == "at" { return positioned(part(view#4), view#2, view#3) }
	# (a subscript's offset is read by index_positions, before a class body or other view becomes code: here it is its 1)
	if kind == "attribute" { return if view#2 == subscript_offset_mark then part(view#4) else Key(symbol(attribute_word), Op.Colon, [view#2, part(view#3), part(view#4)]) }
	if count(kind) == 0 { return view }
	Key(symbol(opaque_word), Op.Colon, view)
}

# the head of a type declaration, `type P` of `type P = int -> bool`, as the parser views it
is_type_view(n: Node): bool := is_key(n, Op.Colon) and key_of(n) == opaque_symbol and kind_of(value_of(n)) == "type"
# the view of a node (`[]` equals ø but is not ø itself: the empty list, square bracketed as parser.warp's grouped
# builds it)
view_of(n: Node): View := if n == ø and n !== ø then ["list", "[", ""] else match n {
	Key(left, op, right): key_view(left, op as text, right)
	Symbol(name): ["symbol", name]
	Char(c): ["char", c]
	Text(t): ["text", t]
	List(items, bracket, separator): ["list", bracket as text, separator as text] + items.map(view_of)
	_: n
}

# the members of a union type, `list or text`, `int | text` (decision union-or); a single type is its own one member
union_members(type: text): list := type.split(" or ").flat_map(part => part.split(" | ")).map(member => member.trim())
is_union(type: text): bool := #union_members(type) > 1
# a union type as written, `int or text` (`int | text` parses so too), its members type words; ø for any other node
union_spelling(type: Node): text? := {
	if not is_key(type, Op.Or) { return ø }
	members = [key_of(type), value_of(type)].map(member => if member is symbol then name_of(member) else union_spelling(member))
	if members.any(member => member == ø) then ø else members.join(" or ")
}
# the name of the variant of a word overloaded by arity that takes `total` arguments, `sum·1`, any number from there
# on `sum·more` (arity_overloads.warp; the emitter's method_function calls it by it)
overload_variant_name(name: text, total: int): text := name + "·" + (if total < 0 then "more" else "" + total)
# the name of a type declaration's view: `P` of ["symbol", "P"], under the attribute layers of an enum's cases or a
# base class
declared_type_name(name: any): text? := {
	if name#1 == "symbol" { return name#2 }
	if name#1 == "attribute" { return declared_type_name(name#4) }
	ø
}

# the view of a key: an opaque view and an attribute layer as they were written
key_view(left: Node, op: text, right: Node): View := {
	if left == opaque_symbol { return right }
	if left == symbol(attribute_word) { return ["attribute", right#1, view_of(right#2), view_of(right#3)] }
	["key", op, view_of(left), view_of(right)]
}

# whether a and b have the same view, compared as they are walked, no view built (the sugar passes ask it of every
# rule that fired, card sugar-rule-passes); the forms whose view is not their shape, `[]`, an opaque or attribute key,
# by their views
same_view(a: Node, b: Node): bool := {
	if viewed_as_other(a) or viewed_as_other(b) { return view_of(a) == view_of(b) }
	match a {
		Key(left, op, right): same_key_view(left, op, right, b)
		Symbol(name): b is symbol and name_of(b) == name
		List(items, bracket, separator): same_list_view(items, bracket, separator, b)
		_: not (b is key or b is symbol or is_group(b)) and view_of(a) == view_of(b)
	}
}
same_key_view(left: Node, op: Op, right: Node, b: Node): bool := match b {
	Key(other_left, other_op, other_right): op == other_op and same_view(left, other_left) and same_view(right, other_right)
	_: no
}
same_list_view(items: list, bracket: Bracket, separator: Separator, b: Node): bool := match b {
	List(others, other_bracket, other_separator): bracket == other_bracket and separator == other_separator and same_items_view(items, others)
	_: no
}
same_items_view(items: list, others: list): bool := {
	if #items != #others { return no }
	for i in 0 ..< #items { if not same_view(items[i], others[i]) { return no } }
	yes
}
viewed_as_other(n: Node): bool := (n == ø and n !== ø) or (n is key and (key_of(n) == opaque_symbol or key_of(n) == symbol(attribute_word)))

# one node of several juxtaposed words: `upper w`
words_phrase(words: list): Node := if #words == 1 then words#1 else List(words, Bracket.None, Separator.Space)

# a group of the items, bracketed and separated as n
group_like(n: Node, items: list): Node := match n {
	List(_, bracket, separator): List(items, bracket, separator)
	_: separated(bracketed(items, bracket_of(n)), separator_of(n))
}

# the call `name(arguments…)`
# the symbol `word`
is_word(n: Node, word: text): bool := n == symbol(word)
# `pattern Definition = Key(head, Op.Define, body)`, a named pattern (node_matches.warp)
is_pattern_definition(n: Node): bool := is_group(n) and #n == 2 and is_word(n#1, "pattern") and is_key(n#2, Op.Assign)
call_of(name: text, arguments: list): Node := bracketed([symbol(name)] + arguments, "(")
# the statements as a block, `{ a; b }`
block_of(parts: list): Node := List(parts, Bracket.Curly, Separator.Semicolon)

# the numbers of the names the passes make, counted across all of them
global names_made = 0
fresh_number(): int := {
	names_made += 1
	names_made
}
# `item·3`: a name a pass makes, its role and its number
fresh_name(role: text, number: int): Node := symbol(role + "·" + number)

# a program's statements: a sequence's, by `;` or by lines, else the one statement it is
is_statement_sequence(program: Node): bool := bracket_of(program) == "" and (separator_of(program) == ";" or separator_of(program) == "\n")
statements_in(program: Node): list := if is_statement_sequence(program) then items_of(program) else [program]
# the statements of a program, those of its nested sequences among them: a `;` line among lines (`use os; x = 1⏎…`
# uses os), an included module
flat_statements(program: Node): list := if is_statement_sequence(program) then items_of(program).flat_map(flat_statements) else [program]

# a node with f applied to each of its children; n itself when every child came back the very same node, so a pass
# makes new nodes only on the path from a change to the root (decision shared-subtrees)
children(n: Node, f: function): Node := match n {
	Key(left, op, right): {
		if left == opaque_symbol { return n }
		walked_left = f(left)
		walked_right = f(right)
		if same(walked_left, left) and same(walked_right, right) then n else Key(walked_left, op, walked_right)
	}
	List(items, bracket, separator): {
		if is_quote(n) or is_spliced_quote(n) { return n }
		walked = items_walked(items, is_spaced(n), f)
		if same_items(walked, items) then n else List(walked, bracket, separator)
	}
	_: n
}
# whether each item is the very same node as the other's at its place
same_items(items: list, others: list): bool := {
	for i in 0..<#items { if not same(items[i], others[i]) { return no } }
	yes
}

# the parts of a node, as `children` walks them: a key's two sides, a group's items; none of an opaque view
parts_of(n: Node): list := match n {
	Key(left, op, right): { if left == opaque_symbol then [] else [left, right] }
	List(items, bracket, separator): items
	_: []
}
# the parts of a node, an opaque view's too: a type's name and body as nodes
parts_within(n: Node): list := match n {
	Key(left, op, right): { if left == opaque_symbol then opaque_parts(right) else [left, right] }
	_: parts_of(n)
}
opaque_parts(view: View): list := view.filter(part => part is list).map(node_of)

# `data e`, `print data e`, `f(data e)`: in a line or a call the item after the word is code as written, which no
# pass rewrites
quote_word = "data"
quote_symbol = symbol(quote_word)
# data with its names spliced in (data_blocks.warp), which no pass rewrites either
spliced_quote_symbol = symbol(HiddenWord.DataSpliced as text)
# `data e`, glued `data(e)`, and its spliced form: what every pass leaves alone (the code they make:
# extensions/quotes.warp)
is_quote(n: Node): bool := (is_spaced(n) or (bracket_of(n) == "(" and separator_of(n) == "")) and #n == 2 and n#1 == quote_symbol
is_spliced_quote(n: Node): bool := bracket_of(n) == "(" and separator_of(n) == "" and #n == 2 and n#1 == spliced_quote_symbol
is_spaced(n: Node): bool := bracket_of(n) == "" and separator_of(n) == " "
def items_walked(items: list, quoting_allowed: bool, f: function): list {
	walked = []
	quoting = no
	for item in items {
		walked += [if quoting then item else f(item)]
		quoting = quoting_allowed and (item == quote_symbol or item == spliced_quote_symbol)
	}
	walked
}

# f applied to every node, children first: a pass rewriting the forms it knows and leaving the rest
bottom_up(n: Node, f: function): Node := f(children(n, x => bottom_up(x, f)))

# a group's items as a list
items_of(n: Node): list := {
	gathered = []
	for item in n { gathered += [item] }
	gathered
}

# What a pass reports (card carries-line): `report(n, message, preferred)` says it at n's position and gives n,
# [line, column, message, preferred] each
global said = []
# whether n has where it was written (`line_of(n)`, `column_of(n)`): a node a pass made has none, and the statement
# `line = 1` answers `.line` with its value, not a position
is_positioned(n: Node): bool := line_of(n) != ø
report(n: T, message: text, preferred: any): T := {
	said += [[line_of(n), column_of(n), message, preferred]]
	n
}
# where n was written, [line, column]: its own position, else its first positioned part's (only atoms carry one), ø
# for a node a pass made of none
written_at(n: Node): list? := {
	if is_positioned(n) { return [line_of(n), column_of(n)] }
	for part in parts_of(n) {
		found = written_at(part)
		if found { return found }
	}
	ø
}
# ` at file:line:column` of a place written_at found; ` at line:column` without a file,
# "" without a place
place_text(at: list?, file: text): text := {
	if not at { return "" }
	" at " + (if file then file + ":" else "") + at#1 + ":" + at#2
}
# whether the symbol `word` occurs anywhere in n, inside an opaque layer too
mentions(n: Node, word: text): bool := match n {
	Symbol(name): name == word
	Key(left, _, right): { if left == opaque_symbol then view_has(right, part => part == ["symbol", word]) else mentions(left, word) or mentions(right, word) }
	List(items, _, _): items.any(item => mentions(item, word))
	_: no
}

# the view kind of a text `"a \(x) b"` the parser keeps whole: ["template", "a ${x} b"] (holes `${expr}`, a literal
# dollar `$$`), which interpolation.warp builds
template_kind = "template"

# the end of the hole whose `{` is before `at`: after its closing `}`
hole_close(template: text, at: int): int := {
	depth = 1
	while at < #template {
		if template[at] == '{' { depth += 1 }
		if template[at] == '}' {
			depth -= 1
			if depth == 0 { return at + 1 }
		}
		at += 1
	}
	at
}

# the pieces of a template in order: a literal as its text, a hole as [its code]; an empty literal is none
template_pieces(template: text): list := holed_pieces(template, no)

# the end of the hole whose `$` is at `at`, `at` when none starts there; with bare_names a `$name` is one too
piece_hole_end(template: text, at: int, bare_names: bool): int := {
	if template[at] != '$' or at + 1 >= #template { return at }
	next = template[at + 1]
	if next == '{' { return hole_close(template, at + 2) }
	if not bare_names or not (is_alpha(next) or next == '_') { return at }
	end = at + 2
	while end < #template and (is_alphanumeric(template[end]) or template[end] == '_') { end += 1 }
	end
}

# the pieces of a template as template_pieces; with bare_names a `$name` is a hole too, as sql and sh templates
# read it (a text's holes need braces, decision D1)
holed_pieces(template: text, bare_names: bool): list := {
	found = []
	literal = ""
	at = 0
	while at < #template {
		c = template[at]
		next = if at + 1 < #template then template[at + 1] else ' '
		end = piece_hole_end(template, at, bare_names)
		if c == '$' and next == '$' {
			literal = literal + '$'
			at += 2
		} else if end > at {
			if literal != "" { found += [literal] }
			literal = ""
			found += [[if next == '{' then template[at + 2 .. end - 1] else template[at + 1 .. end]]]
			at = end
		} else {
			literal = literal + c
			at += 1
		}
	}
	if literal != "" { found += [literal] }
	found
}

# whether `found` holds for the code of a hole of a template in n, kept whole in an opaque view (`"caught: \(e)"`)
has_hole(n: Node, found: function): bool := match n {
	Key(left, _, right): { if left == opaque_symbol then view_has(right, part => kind_of(part) == template_kind and template_pieces(part#2).any(piece => piece is list and found(piece#1))) else has_hole(left, found) or has_hole(right, found) }
	List(items, _, _): items.any(item => has_hole(item, found))
	_: no
}

# whether `found` holds for the view or a part of it
view_has(view: View, found: function): bool := {
	if found(view) { return yes }
	if view is list {
		for part in view {
			if view_has(part, found) { return yes }
		}
	}
	no
}
# a literal a pattern or a declaration may hold: a number, a text, a bool
is_literal(n: Node): bool := n is number or n is text or n is bool
# the conditions joined by `and`, `a and b and c`
joined(conditions: list): Node := {
	condition = conditions#1
	for more in conditions[1..] { condition = Key(condition, Op.And, more) }
	condition
}
# the statements as one round group, `(a; b; c)`
statements(list: list): Node := List(list, Bracket.Round, Separator.Semicolon)
# the first answer of asking each item in turn that is not ø, else ø
first_answer(items: list, asking: function): any := {
	for item in items {
		answer = asking(item)
		if answer != ø { return answer }
	}
	ø
}
# `if test then value else otherwise`, as a node
chosen(test: Node, value: Node, otherwise: Node): Node := Key(Key(Key(ø, Op.If, test), Op.Then, value), Op.Else, otherwise)
# whether no item comes twice
all_distinct(items: list): bool := {
	seen = []
	for item in items {
		if item in seen { return no }
		seen += [item]
	}
	yes
}
# the map without the entries of these keys
without_keys(m: map, names: list): map := {
	kept = {}
	for key in m.keys { if key not in names { kept[key] = m[key] } }
	kept
}
# what reading finds in the tree, by name: reading gives [name, value] of a node it finds, else ø, and a found node
# is not searched further
declarations_found(n: Node, reading: function, found: map): map := {
	declared = reading(n)
	if declared != ø { found[declared#1] = declared#2 } else if is_group(n) { for part in items_of(n) { declarations_found(part, reading, found) } }
	found
}
