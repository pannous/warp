# `try x else y` and `try x catch e { y }` (card pure-runs):
# x runs inside ran·without·error, which says whether it finished (a runtime error deep inside throws the wasm tag
# the try catches); x's value counts unless it is an Error, else y. The errors wasm cannot catch (a division by 0,
# an index out of a list written in place) extensions/checked_tries.warp checks before they happen.
#   try x else y        → (try·finished = ran·without·error({try·value = x});
#                          if try·finished and not is_error(try·value) then {try·value} else {y})
#   try x catch e { y } → … else {e = placed_at(caught_error(try·finished, try·value), trap_place()); y}, the Error at
#                          the program's statement it happened in
# Each try's names carry its number (try·value·3), so two tries of a function keep their own kinds.
use "walk.warp"
use "../parsing/phrase_blocks.warp"
use "../analysis/words.warp"

applied_to(word: text, arguments: list): Node := List([symbol(word)] + arguments, Bracket.Round, Separator.None)
# `{n}`, a block of one item
braced(n: Node): Node := List([n], Bracket.Curly, Separator.Space)
try_assigned(name: Node, value: Node): Node := Key(name, Op.Assign, value)

try_name(role: text, number: int): Node := fresh_name("try·" + role, number)

# `try x else y`; with a catch binding (a name, else ø) the else branch binds it to the error before y
guarded_try(value: Node, fallback: Node, binding: Node?, number: int): Node := {
	finished = try_name("finished", number)
	result = try_name("value", number)
	ran = try_assigned(finished, applied_to(HiddenWord.RanWithoutError as text, [braced(try_assigned(result, value))]))
	succeeded = Key(finished, Op.And, Key(ø, Op.Not, applied_to("is_error", [result])))
	# the caught Error's name is a handler's place, `e: error`, where it raises no more (decision errors-one-rule)
	caught = try_assigned(Key(binding, Op.Colon, symbol("error")), applied_to("placed_at", [applied_to("caught_error", [finished, result]), applied_to("trap_place", [])]))
	otherwise = if binding == ø then braced(fallback) else List([caught, fallback], Bracket.Curly, Separator.Semicolon)
	statements([ran, chosen(succeeded, braced(result), otherwise)])
}

# the value under try, its fallback, the catch binding or ø
lowered_try(value: Node, fallback: Node, binding: Node?): Node := {
	number = fresh_number()
	match value {
		Key(target, Op.Assign, assigned_value): { if is_name(target) and binding == ø then try_assigned(target, lowered_try(assigned_value, fallback, binding)) else guarded_try(value, fallback, binding, number) }
		# `try { x } …`: a block of one statement guards the statement (held as a value, `{x}` would be data)
		List(statements, Bracket.Curly, separator): {
			if #statements == 1 and not is_key(statements#1, Op.Colon) { return guarded_try(statements#1, fallback, binding, number) }
			guarded_try(value, fallback, binding, number)
		}
		_: guarded_try(value, fallback, binding, number)
	}
}

# a raise in v kept as the Error it raised (decision errors-one-rule): `try v catch e { e }`
kept_raise(v: Node): Node := {
	number = fresh_number()
	guarded_try(v, try_name("error", number), try_name("error", number), number)
}
# where an Error stops the run no more (decision errors-one-rule): an optional place `r: T? = v` keeps it (a value's
# `a or b`, emitter.warp logical, too)
handled_form(n: Node): Node := match n {
	Key(Key(target, Op.Colon, declared), Op.Assign, v): if admits_errors_type(declared) and is_name(target) and is_call(v) then Key(key_of(n), Op.Assign, kept_raise(v)) else n
	# `x ?? y`, `x default y` (decision nullish-default): y when x raises or is ø, a falsy x kept
	Key(x, Op.Coalesce, y): if is_call(x) then Key(lowered_try(x, ø, ø), Op.Coalesce, y) else n
	_: n
}

# parser.warp reads `try x else y` as `try·else(x, y)`, `try x catch e { y }` as `try·else(x, {y}, e)` (and
# `assert c else m` as `assert·else(c, m)`, extensions/checked_tries.warp's)
try_form(n: Node): Node := match n {
	List(parts, Bracket.Round, Separator.None): {
		if #parts < 3 or parts#1 != symbol(HiddenWord.TryElse as text) { return n }
		if #parts == 3 { return lowered_try(parts#2, parts#3, ø) }
		if #parts == 4 and is_name(parts#4) { return lowered_try(parts#2, parts#3, parts#4) }
		n
	}
	_: handled_form(n)
}

tries(program: Node): Node := bottom_up(program, try_form)
