# The files and environment variables the compiler reads and writes, over the host's std_io: the file system natively,
# the page's in-memory files in the browser (decision core-takes-what-it-uses). lib/host_io.warp links here, the module
# lib/file.warp and lib/os.warp build on
URL_SCHEMES = ["https://", "http://", "://"]
AS_BYTES = "bytes"
global write(path: any, text: any) := std_io("file", "write", [home_expanded(path), text])
# a file's bytes as a list of ints 0 to 255 (a .wasm a warp-written emitter writes)
global write_bytes(path: any, bytes: any) := std_io("file", "write_bytes", [home_expanded(path), bytes])
# a file's text, or the Error of why not
global read(path: any) := if is_url(path) then asked("net", "get", [path]) else asked("file", "read", [home_expanded(path)])
global read_bytes(path: any) := if is_url(path) then url_bytes(path) else asked("file", "read_bytes", [home_expanded(path)])
# a path that is a URL, `https://…`, `http://…` or `://host/…` (over https): read and read_bytes read it over HTTP,
# as fetch does
is_url(path: any) as bool := path is text and URL_SCHEMES.any(scheme => path.starts_with(scheme))
# a URL's bytes: the native host answers net.get's bytes as a text, a page's as a list of them
url_bytes(url: text) := {
	answer = asked("net", "get", [url, AS_BYTES])
	if answer is text then bytes(answer) else answer
}
# "" names no file (python's os.path.exists)
global exists(path: any) := if path == "" then no else asked("file", "exists", [home_expanded(path)])
list_files(folder: any) := asked("file", "list", [home_expanded(folder)])
# `~/notes.txt`: a path's leading ~ is the home folder ($HOME), expanded where the path is used (wiki/script.md),
# so a quoted "~/x" works too and a program expands it on the machine it runs on; any other value stays as it is
# a run without one (a browser page) is told so, never handed "ø/…"
home_expanded(path: any) as any := if path is text and (path == "~" or path.starts_with("~/")) then home_folder() + path[1..] else path
home_folder() as text := started_env("HOME") ?? raise("~ is the home folder, and this run has none ($HOME is unset; a page answers its own files, wasi.js HOME_DIRECTORY)")
# `started_env("HOME")`: the variable as the program's environment started with it, ø when unset (os.warp env adds
# the ones the program set)
started_env(name: any) := asked("os", "env", [name])
# an option of this run (`warp --no-window app.warp`, `warp help options`): its value, "" for a flag, ø when not given
run_option(name: any) := asked("warp", "option", [name])
# a shell line running this warp on the words, with this run's lib/ and, in a windowless run, --no-window: how a
# command or a program starts warp
warp_command(words: text) as text := {
	lib = run_option("lib")
	quiet = if run_option("no-window") == ø then "" else "--no-window "
	"\"" + (run_option("executable") ?? "warp") + "\" " + (if lib == ø then "" else "--lib \"" + lib + "\" ") + quiet + words
}
# A compile the native warp caches (the run option cache names the module's file, core/native/driver.warp
# compiled_and_run) records every question it asks the host here, [the answer's fingerprint, module, member,
# arguments…]: the module keeps them, and stays current while each gets the same answer (compiler.warp cached_current)
global questions_asked = []
global asking_recorded = ø
asked(module: text, member: text, arguments: list) := {
	global questions_asked
	global asking_recorded
	answer = std_io(module, member, arguments)
	if asking_recorded == ø { asking_recorded = (std_io("warp", "option", ["cache"]) ?? "") != "" }
	if asking_recorded { questions_asked += [[text(answer_fingerprint(answer)), module, member] + arguments.map(argument => text(argument))] }
	answer
}
# a fingerprint of an answer: a file's bytes folded as they are, any other answer as warp writes it
answer_fingerprint(answer: any) as int := folded_bytes(if answer is list and #answer > 0 and answer#1 is int then answer else "${answer}".bytes)
def folded_bytes(bytes: list) as int {
	folded = 0
	# `part`, not `byte`: `for byte in xs` walks xs.bytes (decision text-unit-plurals)
	for part in bytes { folded = (folded * 257 + part) % 1000000007 }
	folded
}
