# The files and environment variables the compiler reads and writes, over the host's std_io: the file system natively,
# the page's in-memory files in the browser (decision core-takes-what-it-uses). lib/host_io.warp links here, the module
# lib/file.warp and lib/os.warp build on
global write(path: any, text: any) := std_io("file", "write", [home_expanded(path), text])
# a file's bytes as a list of ints 0 to 255 (a .wasm a warp-written emitter writes)
global write_bytes(path: any, bytes: any) := std_io("file", "write_bytes", [home_expanded(path), bytes])
global read_bytes(path: any) := std_io("file", "read_bytes", [home_expanded(path)])
# "" names no file (python's os.path.exists)
global exists(path: any) := if path == "" then no else std_io("file", "exists", [home_expanded(path)])
list_files(folder: any) := std_io("file", "list", [home_expanded(folder)])
# `~/notes.txt`: a path's leading ~ is the home folder ($HOME), expanded where the path is used (wiki/script.md),
# so a quoted "~/x" works too and a program expands it on the machine it runs on; any other value stays as it is
# a run without one (a browser page) is told so, never handed "ø/…"
home_expanded(path: any): any := if path is text and (path == "~" or path.starts_with("~/")) then home_folder() + path[1..] else path
home_folder(): text := started_env("HOME") ?? raise("~ is the home folder, and this run has none ($HOME is unset; a page answers its own files, wasi.js HOME_DIRECTORY)")
# `started_env("HOME")`: the variable as the program's environment started with it, ø when unset (os.warp env adds
# the ones the program set)
started_env(name: any) := std_io("os", "env", [name])
# an option of this run (`warp --no-window app.warp`, `warp help options`): its value, "" for a flag, ø when not given
run_option(name: any) := std_io("warp", "option", [name])
# a shell line running this warp on the words, with this run's lib/ and, in a windowless run, --no-window: how a
# command or a program starts warp
warp_command(words: text): text := {
	lib = run_option("lib")
	quiet = if run_option("no-window") == ø then "" else "--no-window "
	"\"" + (run_option("executable") ?? "warp") + "\" " + (if lib == ø then "" else "--lib \"" + lib + "\" ") + quiet + words
}
