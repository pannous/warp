# The warp compiler as one warp program (card standalone, notes/standalone_compiler.md): source text in, wasm bytes out,
# its stages handing each other plain warp values. `warp core/compiler.warp app.warp app.wasm`, then
# `warp app.wasm`; a form beyond the emitter's core is the compile's error ("outside the core: …")
use "passes.warp"
use "analyzer.warp"
use "emitter.warp"
use "host_words.warp"
use "commands.warp"
use "c_imports.warp"
use "extensions/primitive.warp"
use os
use file

# a command (commands.warp), else the source file of a compile
command = if #args > 0 and is_command(args#1) then args#1 else ""

# lib/: the fourth argument of a compile (the native `warp` gives it), else WARP_LIB, else the folder above this file's
library_folder = if not command and #args > 3 then args#4 else run_library()
# the parser's and the uses' standard modules from that lib/ too, never the folder this compiler was built in
use_library(library_folder)

# the prelude's text, whose definitions a program reaches (prelude_words.warp), built in as the compiler's other data
prelude_source = module_source("prelude")

# the files of the runtime words, each with the files its `use` lines name: the core and, never used by it, the
# extended runtime (decision runtime-split)
RUNTIME_ROOTS = ["runtime.warp", "runtime/extended.warp"]
# the text of each file the roots reach by `use`, by its path in core, built into the compiler as it is built
# (module_source; user 2026-10-26: "this should be baked in by now"): its runtime words never read the lib/ it runs
# with. A file missing here is read from lib/ (uses.warp file_text)
// TODO get rid of these, just load via loop (card core-compiler)
RUNTIME_FILES = {
	"runtime.warp": module_source("compiler/runtime.warp"),
	"runtime/extended.warp": module_source("compiler/runtime/extended.warp"),
	"runtime/instructions.warp": module_source("compiler/runtime/instructions.warp"),
	"runtime/walks.warp": module_source("compiler/runtime/walks.warp"),
	"runtime/text.warp": module_source("compiler/runtime/text.warp"),
	"runtime/case.warp": module_source("compiler/runtime/case.warp"),
	"runtime/show.warp": module_source("compiler/runtime/show.warp"),
	"runtime/arithmetic.warp": module_source("compiler/runtime/arithmetic.warp"),
	"runtime/equality.warp": module_source("compiler/runtime/equality.warp"),
	"runtime/maps.warp": module_source("compiler/runtime/maps.warp"),
	"runtime/fields.warp": module_source("compiler/runtime/fields.warp"),
	"runtime/types.warp": module_source("compiler/runtime/types.warp"),
	"runtime/characters.warp": module_source("compiler/runtime/characters.warp"),
	"runtime/lists.warp": module_source("compiler/runtime/lists.warp"),
	"runtime/text_words.warp": module_source("compiler/runtime/text_words.warp"),
	"runtime/library_words.warp": module_source("compiler/runtime/library_words.warp"),
	"runtime/floats.warp": module_source("compiler/runtime/floats.warp"),
	"runtime/conversions.warp": module_source("compiler/runtime/conversions.warp"),
	"runtime/bridge.warp": module_source("compiler/runtime/bridge.warp"),
	"runtime/errors.warp": module_source("compiler/runtime/errors.warp"),
	"runtime/nodes.warp": module_source("compiler/runtime/nodes.warp"),
	"runtime/builders.warp": module_source("compiler/runtime/builders.warp"),
	"runtime/ordering.warp": module_source("compiler/runtime/ordering.warp"),
	"runtime/text_numbers.warp": module_source("compiler/runtime/text_numbers.warp"),
	"runtime/extended/big_ints.warp": module_source("compiler/runtime/extended/big_ints.warp"),
	"runtime/extended/exact.warp": module_source("compiler/runtime/extended/exact.warp"),
	"runtime/durations.warp": module_source("compiler/runtime/durations.warp"),
	"runtime/extended/times.warp": module_source("compiler/runtime/extended/times.warp"),
	"runtime/extended/pow_tables.warp": module_source("compiler/runtime/extended/pow_tables.warp"),
	"runtime/extended/pow.warp": module_source("compiler/runtime/extended/pow.warp"),
	"runtime/extended/exact_rounding.warp": module_source("compiler/runtime/extended/exact_rounding.warp"),
	"runtime/extended/wasi.warp": module_source("compiler/runtime/extended/wasi.warp"),
	"runtime/intrinsics.warp": module_source("compiler/runtime/intrinsics.warp"),
	"kinds.warp": module_source("compiler/kinds.warp"),
	"byte_codes.warp": module_source("compiler/byte_codes.warp")
}
# a root's text, its `use` paths named from core, where the roots are lowered together: runtime/extended.warp's
# `use "extended/exact.warp"` is core/runtime/extended/exact.warp
root_text(file: text): text := {
	text = RUNTIME_FILES[file]
	steps = file.split("/")
	if #steps == 1 { return text }
	text.replace("use \"", "use \"" + steps[0 ..< #steps - 1].join("/") + "/")
}

# the runtime words, lowered by the same passes as a program, only to build runtime.wasm: a compile takes them from it
lowered_runtime_words(): Node := {
	global built_in_files
	roots = RUNTIME_ROOTS.map(file => root_text(file))
	built_in_files = {}
	for file in RUNTIME_FILES.keys { built_in_files[library_folder + "/compiler/" + file] = RUNTIME_FILES[file] }
	words = lowered_program(roots.join("\n"), library_folder + "/compiler", prelude_source)
	built_in_files = {}
	words
}

# the wasm module of the source, as bytes; the refusal, a text, of a program outside the emitter's core. Given a
# runtime.wasm, a library module behind it, its operands relocatable (write_module)
compile(source: text, folder: text, library_runtime: any = ø): any := {
	global module
	module.relocating = library_runtime != ø
	if is_primitive_file(source) { return primitive_module(source, folder) }
	known = #diagnosed
	# the C functions it calls, its foreign lines left out (c_imports.warp)
	foreign = c_functions_of(source, library_folder)
	unknown = foreign#3
	if #unknown > 0 { throw outside_the_core + "no C signature for " + unknown.join(", ") + ": declare it with a foreign line, `name(x: i32): i32 from 'library'`" }
	program = checked_program(foreign#1, folder, prelude_source)
	found = diagnosed_since(known)
	# an error the checks diagnosed fails the compile with Rust's text (card pure-self-ignores-errors)
	failing = first_error(found, module.program_file)
	if failing { throw failing }
	// TODO runtime_words Instead of work-based, should we create a class for (partial) modules?  (card runtime-words-modules)
	# behind runtime.wasm
	prepend_runtime(library_runtime ?? runtime_bytes())
	relocate_program(separate_file() != "")
	made = typed_wasm_module(program, Node.Empty, with_c_functions(host_words, foreign#2), emitter_kinds(program))
	# a form beyond the emitter's core gives the refusal's text, the compile's error
	if made is text { throw owned_refusal(made, c_refused_form(made, foreign#2, library_folder)) }
	# the warnings once the module is made, as Rust's pure lane says them
	for warning in warnings_said(found, module.program_file) { warn warning }
	made
}

# an output ending so gets parser.warp's view of the source as JSON, no module: how the host reads warp text into a
# node without a Rust parser (a channel's message, a console line, a test file; card rust-bootstrap)
VIEW_SUFFIX = ".view.json"

# the module of the source file written to the wasm file, the source's uses found in folder; parser.warp's view of it
# when the output ends in VIEW_SUFFIX
compile_file(source_file: text, wasm_file: text, folder: text) := {
	if wasm_file.ends_with(VIEW_SUFFIX) {
		write(wasm_file, view_json(bridged(stage_view(parsed(read(source_file))))))
	} else {
		emitting_file(working_relative(source_file))
		source = read(source_file)
		compiled = compile(source, folder)
		# a program outside the emitter's core: the run fails with the refusal, no module written (card compiler-refusal-loud)
		if compiled is text { raise compiled }
		write_bytes(wasm_file, compiled)
		# a primitive module imports no runtime: its separate form is itself
		if separate_file() != "" { write_bytes(separate_file(), if is_primitive_file(source) then compiled else separate_module()) }
	}
}

# the REPL (`warp repl`): the lines that stay for the next ones, a program's declarations and uses, as warp text
REPL_STATE = ".warp-repl-state.warp"
staying_lines(line: text): text := {
	statements = statements_in(plain_node(parsed(line)))
	staying = statements.filter(statement => is_declaration(statement) or is_import(statement))
	staying.map(statement => "${statement}").join("\n")
}
# one line of the REPL: its module written to wasm_file, compiled after the state file's lines; the line's
# declarations added to the state once it compiled
repl_step(state_file: text, line: text, wasm_file: text) := {
	state = try read(state_file) else ""
	compiled = compile(state + "\n" + line, ".")
	if compiled is text { raise compiled }
	write_bytes(wasm_file, compiled)
	staying = staying_lines(line)
	if staying { write(state_file, state + "\n" + staying) }
}
# `warp repl` under plain WASI: each line compiled, its declarations kept; running it needs the native warp
repl() := {
	write(REPL_STATE, "")
	line = input(REPL_PROMPT)
	while line != ø {
		if line.trim() {
			try {
				repl_step(REPL_STATE, line, ".warp-repl-line.wasm")
				print "compiled; running it needs the native warp (plain WASI has no instantiate): warp repl"
			} catch failure { print failure }
		}
		line = input(REPL_PROMPT)
	}
}

# runtime.wasm beside this compiler, the harness's fifth argument of a compile: the program is compiled behind it (card
# runtime-prepended), read once. A compile has no other runtime: without it, it fails
RUNTIME_ARGUMENT = 5
# the sixth, of `warp build`: where the same program goes as a separate module, importing runtime.wasm's instance
# (card wasm-output-variants, notes/runtime_linking.md "Separate modules")
SEPARATE_ARGUMENT = 6
separate_file(): text := if command == "" and #args >= SEPARATE_ARGUMENT then args#SEPARATE_ARGUMENT else ""
global runtime_held = ø
runtime_bytes(): list := {
	if runtime_held == ø {
		if #args < RUNTIME_ARGUMENT or args#RUNTIME_ARGUMENT == "" { throw "no runtime.wasm given (the fifth argument): `warp rebuild` writes it beside warp.wasm" }
		runtime_held = read_bytes(args#RUNTIME_ARGUMENT)
	}
	runtime_held
}
# the program just compiled behind runtime.wasm, as a module importing it instead
separate_module(): list := linked_bytes(module.order)
# runtime.wasm, the runtime words compiled once (emitter/prebuilt.warp), written beside warp.wasm by `warp rebuild`
RUNTIME_WASM = "runtime.wasm"
write_runtime(file: text) := {
	made = runtime_wasm_module(lowered_runtime_words(), host_words)
	if made is text { raise made }
	write_bytes(file, made)
}
# <name>.wasm, the bundled module compiled once behind runtime.wasm (emitter/prebuilt.warp own_items_from), for
# programs to be linked to; `warp rebuild` writes one beside warp.wasm for each. Every program has the prelude, used
# again it would define its words twice
write_module(name: text, runtime_file: text, file: text) := {
	write_bytes(file, compile(if name == "prelude" then "ø" else "use " + name + "\nø", library_folder, read_bytes(runtime_file)))
}
# every standard module (rewrites.warp std_module_names) as <name>.wasm in the folder; one refusing to prebuild is
# named and stays compiled from source
write_modules(folder: text, runtime_file: text) := {
	for name in std_module_names {
		try { write_module(name, runtime_file, folder + "/" + name + ".wasm") } catch refusal { print name + ".wasm not prebuilt: " + refusal }
	}
}
source_or_code(position: int): text := if #args > position then source_of(args#(position + 1)) else ""
show_version() := print version_text(library_folder)
show_parsed() := print structure(plain_node(parsed(source_or_code(1))))
show_data() := print plain_node(parsed(source_or_code(1)))
show_lowered() := print lowered_program(source_or_code(1), ".", prelude_source)
match command {
	"": compile_file(args#1, args#2, if #args > 2 then args#3 else folder_of(args#1))
	"help": show_help()
	"version": show_version()
	"parse": show_parsed()
	"data": show_data()
	"lower": show_lowered()
	"compile": compile_file(args#2, if #args > 2 then args#3 else args#2 + ".wasm", folder_of(args#2))
	"build": if args#2 == NATIVE_WORD and #args > 2 then build_native(args#3, library_folder) else compile_file(args#2, args#2 + ".wasm", folder_of(args#2))
	"repl": repl()
	"repl-step": repl_step(args#2, args#3, args#4)
	"runtime": write_runtime(if #args > 1 then args#2 else RUNTIME_WASM)
	"module": write_module(args#2, if #args > 2 then args#3 else RUNTIME_WASM, if #args > 3 then args#4 else args#2 + ".wasm")
	"modules": write_modules(args#2, if #args > 2 then args#3 else RUNTIME_WASM)
	_: if command in running_commands then refuse_running(command) else refuse_native(command)
}
