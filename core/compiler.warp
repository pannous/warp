# The warp compiler as one warp program (card standalone, notes/standalone_compiler.md): source text in, wasm bytes out,
# its stages handing each other plain warp values. `warp core/compiler.warp app.warp app.wasm`, then
# `warp app.wasm`; a form beyond the emitter's core is the compile's error ("outside the core: …")
use "passes/passes.warp"
use "analysis/analyzer.warp"
use "emitter/emitter.warp"
use "analysis/host_words.warp"
use "commands/commands.warp"
use "../extensions/c_imports.warp"
use "../extensions/primitive.warp"
use "../extensions/extensions.warp"
use os
use file

# a command (commands.warp), else the source file of a compile
command = if #args > 0 and is_command(args#1) then args#1 else ""

# lib/: the fourth argument of a compile (the native `warp` gives it), else WARP_LIB, else the folder above this file's
library_folder = if not command and #args > 3 then args#4 else run_library()
# the parser's and the uses' standard modules from that lib/ too, never the folder this compiler was built in
use_library(library_folder)

# the prelude's text, whose definitions a program reaches (prelude_words.warp), built in as the compiler's other data
prelude_source = bundled_module("prelude.warp")

# the files of the runtime words, each with the files its `use` lines name: the core and, never used by it, the
# extended runtime (decision runtime-split)
RUNTIME_ROOTS = ["runtime.warp", "runtime/extended.warp"]
# a root's text, its `use` paths named from core, where the roots are lowered together: runtime/extended.warp's
# `use "extended/wasi.warp"` is core/runtime/extended/wasi.warp
root_text(file: text): text := {
	text = file_text(runtime_folder() + "/" + file)
	if text == ø { raise "no runtime file " + runtime_folder() + "/" + file }
	steps = file.split("/")
	if #steps == 1 { return text }
	text.replace("use \"", "use \"" + steps[0 ..< #steps - 1].join("/") + "/")
}
# core, as lib/ links it: the runtime's sources, which only `warp runtime` reads (a compile takes runtime.wasm)
runtime_folder(): text := library_folder + "/compiler"

# the runtime words, lowered by the same passes as a program, only to build runtime.wasm: a compile takes them from it
lowered_runtime_words(): Node := lowered_program(RUNTIME_ROOTS.map(file => root_text(file)).join("\n"), runtime_folder(), prelude_source)

# the compiler's own build, this library's compiler.warp (by its text): its runtime carries only the rows of
# COMPILER_BUILD_EXTENSIONS (decision extension-row-optional). Its file as written: file_text may answer the bundle's
# text, blanked of comments
own_build(source: text): bool := source == (try read(runtime_folder() + "/compiler.warp") else "")
# the runtime words of the extension rows a build leaves out: the definitions of each one's runtime root
left_out_runtime_words(kept: list): list := {
	words = []
	for row in EXTENSIONS {
		if row.runtime != "" and not kept.any(k => k.name == row.name) {
			root = file_text(library_folder + "/extensions/" + row.runtime)
			if root == ø { raise "no runtime root extensions/" + row.runtime + " of the extension " + row.name }
			words += definition_slices(root).map(slice => slice#1)
		}
	}
	words
}

# the wasm module of the source, as bytes; the refusal, a text, of a program outside the emitter's core. Given a
# runtime.wasm, a library module behind it, its operands relocatable (write_module)
compile(source: text, folder: text, library_runtime: any = ø): any := {
	fresh_module()
	module.relocating = library_runtime != ø
	if is_primitive_file(source) { return primitive_module(source, folder) }
	known = #diagnosed
	own = own_build(source)
	# (the standard modules it names words of without their `use`, as if it said them)
	timed("implicit uses")
	source = with_implicit_uses(source, folder)
	timed("c functions, runtime, linking")
	# the C functions it calls, its foreign lines left out (c_imports.warp)
	foreign = c_functions_of(source, library_folder)
	unknown = foreign#3
	if #unknown > 0 { throw outside_the_core + "no C signature for " + unknown.join(", ") + ": declare it with a foreign line, `name(x: i32): i32 from 'library'`" }
	# behind runtime.wasm and the prebuilt modules it uses, whose words it declares and never lowers (with_reached)
	prepend_runtime(library_runtime ?? runtime_bytes())
	relocate_program(separate_module_wanted)
	shake_runtime(library_runtime == ø and not separate_module_wanted)
	cut_runtime_words(if own then left_out_runtime_words(COMPILER_BUILD_EXTENSIONS) else [])
	linking = library_runtime == ø and prepended()
	link_libraries(if linking then linked_libraries(source) else [], if linking then definition_slices(source).map(slice => slice#1) else [])
	used_c_functions = {}
	timed("checked_program")
	program = checked_program(foreign#1, folder, prelude_source)
	timed("checked_program done")
	c_functions = with_linked_c_functions(with_used_c_functions(foreign#2), library_folder)
	found = checked_facts(known)
	// TODO runtime_words Instead of work-based, should we create a class for (partial) modules?  (card runtime-words-modules)
	timed("emit")
	made = typed_wasm_module(program, Node.Empty, with_c_functions(host_words(), c_functions), emitter_kinds(program))
	timed("emit done")
	# a linked module whose words won't take the program's values: said, and the program compiled with its source
	if made is text and #module.linked_images > 0 {
		warn module.linked_images.map(image => image.name).join(", ") + ": the linked module didn't bind (" + made + "); compiled from source"
		link_libraries([], [])
		relinked = #diagnosed
		program = checked_program(foreign#1, folder, prelude_source)
		checked_facts(relinked)
		made = typed_wasm_module(program, Node.Empty, with_c_functions(host_words(), with_used_c_functions(foreign#2)), emitter_kinds(program))
	}
	# a form beyond the emitter's core gives the refusal's text, the compile's error
	if made is text { throw owned_refusal(made, c_refused_form(made, foreign#2, library_folder)) }
	# the warnings once the module is made
	for warning in said_at(found, Level.Warning, module.program_file) { warn warning }
	# and its hints: `A4 is sound's; fix: use sound`, the use warp beautify writes
	# unless the run asked for none (`warp --no-hints`, WARP_HINTS=0: wiki/warning.md)
	if env("WARP_HINTS") != "0" { for said in said_at(found, Level.Hint, module.program_file) { hint said } }
	made
}

# what the checks diagnosed past the first `known` facts; an error among them fails the compile with its text (card
# pure-self-ignores-errors), the program compiled from source after a linked module didn't bind too
checked_facts(known: int): list := {
	found = diagnosed_since(known)
	failing = first_error(found, module.program_file)
	if failing { throw failing }
	found
}

# the standard modules the source uses, each prebuilt beside runtime.wasm (`warp rebuild`) and linked behind it
# when its signature's source hash is its file's (signature.warp); any other compiles from its source, said in one
# line when it was prebuilt (a WARP_LIB edit; a module that calls C is not prebuilt, its file left empty)
MODULES_FOLDER = "modules"
linked_libraries(source: text): list := {
	linked_signatures = {}
	if #args < RUNTIME_ARGUMENT or args#RUNTIME_ARGUMENT == "" { return [] }
	folder = folder_of(args#RUNTIME_ARGUMENT) + "/" + MODULES_FOLDER + "/"
	images = []
	# the modules it uses and those they use in turn (sound's units): each one's words declared, not brought whole
	names = used_modules(source)
	at = 0
	while at < #names {
		name = names[at]
		at += 1
		wasm = try read_bytes(folder + name + SPLICED_SUFFIX) else ø
		# (the prelude is every program's own, its words reached as it reaches them)
		if name != "prelude" and wasm != ø and #wasm > 0 {
			signature = module_signature(name, wasm)
			image = if signature == ø then "no " + SIGNATURE_SECTION + " (built before it)" else if signature.source != source_hash(try read(std_module_path(name)) else "") then "lib/" + name + ".warp differs from the text it was built of" else library_image_of(name, wasm)
			if image is text { warn name + ".wasm not linked: " + image + "; compiled from source" } else {
				images += [image]
				linked_signatures[name] = signature
				for inner in signature.uses { if inner not in names { names += [inner] } }
			}
		}
	}
	images
}

# the module of the source file written to the wasm file, the source's uses found in folder
compile_file(source_file: text, wasm_file: text, folder: text) := {
	emitting_file(working_relative(source_file))
	compile_written(read(source_file), wasm_file, folder)
}
# the module of the source written to the wasm file
compile_written(source: text, wasm_file: text, folder: text) := {
	compiled = compile(source, folder)
	# a program outside the emitter's core: the run fails with the refusal, no module written (card compiler-refusal-loud)
	if compiled is text { raise compiled }
	write_bytes(wasm_file, compiled)
}

# runtime.wasm beside this compiler, the harness's fifth argument of a compile: the program is compiled behind it (card
# runtime-prepended), read once. A compile has no other runtime: without it, it fails
RUNTIME_ARGUMENT = 5
# whether the program compiled goes as a separate module too, importing runtime.wasm's instance (`warp build`'s
# x.mod.wasm, extensions/commands/separate_module.warp): its code emitted relocatable, the runtime kept whole
global separate_module_wanted = no
global runtime_held = ø
# runtime.wasm: a compile's fifth argument, else lib/'s (the native warp's, core/native/warp.warp)
runtime_path(): text := if command == "" and #args >= RUNTIME_ARGUMENT and args#RUNTIME_ARGUMENT != "" then args#RUNTIME_ARGUMENT else library_folder + "/" + RUNTIME_WASM
runtime_bytes(): list := {
	if runtime_held == ø { runtime_held = read_bytes(runtime_path()) }
	runtime_held
}
# runtime.wasm, the runtime words compiled once (emitter/prebuilt.warp), written beside warp.wasm by `warp rebuild`
RUNTIME_WASM = "runtime.wasm"
write_runtime(file: text) := {
	# the library index first: a runtime's host words are lib/'s as it lies now, never an earlier build's
	write_library_index(folder_of(file) + "/" + MODULES_FOLDER)
	made = runtime_wasm_module(lowered_runtime_words(), host_words())
	if made is text { raise made }
	write_bytes(file, with_call_sites(made))
}
# <name>.wasm, the bundled module compiled once behind runtime.wasm, for programs to link at load time (card
# wasm-module-linking, notes/library_zero_bake.md "The module interface"): its runtime words, memory, error tag and
# hooks imported from `warp_runtime`, its words exported by name, its global initializers the export `warp/start`.
# Beside it <name>.splice.wasm, the whole module behind the runtime (emitter/prebuilt.warp own_items_from), which a
# compile splices into the program until programs import the linked one. `warp rebuild` writes both for each module.
# Every program has the prelude, used again it would define its words twice
write_module(name: text, runtime_file: text, file: text) := {
	spliced = compile(if name == "prelude" then "ø" else "use " + name + "\nø", library_folder, read_bytes(runtime_file))
	if spliced is text { throw spliced }
	write_bytes(spliced_file(file), with_signature(spliced, name))
	write_bytes(file, with_signature(linked_bytes(module.order, MODULE_START), name))
}
MODULE_START = "warp/start"
SPLICED_SUFFIX = ".splice.wasm"
spliced_file(file: text): text := file.remove_suffix(".wasm") + SPLICED_SUFFIX
# every standard module (rewrites.warp std_module_names) as <name>.wasm in the folder; one refusing to prebuild keeps
# an empty file, never an older build linked in its place. A module calling C by its foreign lines (`… from "c"`) may
# refuse and stays compiled from source with the program; any other refusal fails the rebuild, naming the module and
# why (decision prebuild-fails-loudly)
write_modules(folder: text, runtime_file: text) := {
	write_library_index(folder)
	refused = []
	for name in std_module_names {
		file = folder + "/" + name + ".wasm"
		try { write_module(name, runtime_file, file) } catch refusal {
			write_bytes(file, [])
			write_bytes(spliced_file(file), [])
			calls_c = #c_declarations_in(LIBRARY_FILES.get(name + module_extension) ?? "") > 0
			if calls_c { print name + ".wasm not prebuilt (it calls C, compiled with the program): " + refusal } else { refused += [name + ".wasm: " + refusal] }
		}
	}
	if #refused > 0 { raise "standard modules that don't prebuild: " + refused.join("; ") }
}
# where the native warp (core/native/warp.warp) wants the module of words that are neither a command nor a file:
# they are code, compiled there for it to run; no other harness sets it
RUN_TO_VARIABLE = "WARP_RUN_TO"
run_to = env(RUN_TO_VARIABLE) ?? ""
match command {
	"": if run_to then compile_written(args.join(" ") + "\n", run_to, ".") else compile_file(args#1, args#2, if #args > 2 then args#3 else folder_of(args#1))
	"baked-current": write_baked_current(args#2)
	"rebake": write_rebaked(args#2)
	"compile": compile_file(args#2, if #args > 2 then args#3 else args#2 + ".wasm", folder_of(args#2))
	"runtime": write_runtime(if #args > 1 then args#2 else RUNTIME_WASM)
	"module": write_module(args#2, if #args > 2 then args#3 else RUNTIME_WASM, if #args > 3 then args#4 else args#2 + ".wasm")
	"modules": write_modules(args#2, if #args > 2 then args#3 else RUNTIME_WASM)
	"optimize": trim(args#2, args#3, "optimize")
	_: run_extension_command(command)
}
