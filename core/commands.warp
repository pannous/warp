# warp's commands in warp (card wasm-commands, notes/standalone.md): `wasmtime warp-self.wasm <command> …`, `warp
# pure <command> …` and `warp self <command> …` all come here through compiler.warp. Plain WASI runs no module the
# compiler makes, so the commands that run code say so and name the native warp; those that need a host (a server,
# a window, the network) refuse naming it too
use os
use file

REPL_PROMPT = "warp> "
NATIVE = "the native warp"
HELP_COLUMN = 38

# each command and what it does, in `warp help`'s order
command_help = [
	["help", "Show this help"],
	["version", "Show version"],
	["repl", "Start interactive console: definitions stay for the next lines"],
	["parse <code|file>", "Show the parsed program"],
	["data <file>", "Read untrusted data without evaluating it"],
	["lower <code|file>", "Show the program after the lowering passes"],
	["compile <file> [out.wasm]", "Only the module, <file>.wasm, without running"],
	["build <file>", "The module <file>.wasm (no executable under WASI)"],
	["<file> <out.wasm> [folder [lib]]", "Compile the file to the module, as `warp pure` calls it"]
]
# the commands that run what they compile: plain WASI cannot instantiate the module
running_commands = ["run", "eval", "test", "verify", "fuel", "fast", "console"]
# the commands that need the native warp's host: a server, a window, the network, the Lean model, the build files
native_commands = ["pure", "self", "rebuild", "tool", "fetch", "dev", "serve", "deploy", "link", "app", "docs", "wiki",
	"home", "lsp", "start", "types", "format", "lint", "beautify", "fix"]

command_name(entry: list): text := entry#1.split(" ")#1
command_words(): list := command_help.map(command_name).filter(word => not word.starts_with("<")) + ["repl-step"] + running_commands + native_commands
is_command(word: text): bool := word in command_words()

# the text of the file `target` names, else `target` itself as code
source_of(target: text): text := try read(target) else target

show_help() := {
	print "warp, the compiler written in warp (core/compiler.warp), its commands:"
	for entry in command_help { print "  " + padded("warp " + entry#1, HELP_COLUMN) + entry#2 }
	print "  need the native warp: " + (running_commands + native_commands).join(" ")
}

# words, then spaces up to width, at least one
padded(words: text, width: int): text := {
	line = words + " "
	while #line < width { line = line + " " }
	line
}

# the version of the lib/ beside the compiler: its checkout's Cargo.toml
version_text(library: text): text := {
	manifest = try read(folder_of(library) + "/Cargo.toml") else ""
	for line in manifest.split("\n") {
		if line.starts_with("version") { return "🌀 Warp " + line.split("\"")#2 + " (compiler.warp of " + library + ")" }
	}
	"🌀 Warp (compiler.warp of " + library + ", no Cargo.toml beside it)"
}

# the parsed program as `warp parse` shows it, each operation a prefix group: 1+2*x as (+ 1 (* 2 x)) (Rust twin:
# src/cli/display.rs structure)
structure(n: Node): text := match n {
	Key(left, op, right): "(" + (op as text) + " " + structure(left) + " " + structure(right) + ")"
	List(items, bracket, separator): grouped_structure(items.map(structure), bracket as text, separator as text)
	_: "${n}"
}
# the items' texts in their brackets, between them the separator ("⏎" for a line break)
grouped_structure(items: list, bracket: text, separator: text): text := {
	joiner = if separator == "\n" then "⏎ " else if separator == "" or separator == " " then " " else separator + " "
	if #bracket == 2 { return bracket#1 + items.join(joiner) + bracket#2 }
	closing = {"{": "}", "[": "]", "(": ")", "<": ">", "": ""}
	bracket + items.join(joiner) + closing[bracket]
}

refuse_running(command: text) := {
	raise "warp " + command + " runs the module it compiles, which plain WASI cannot (no instantiate in WASI preview 1): use " + NATIVE + ", `warp " + command + "` or `warp pure " + command + "`"
}
refuse_native(command: text) := {
	raise "warp " + command + " needs " + NATIVE + "'s host: run `warp " + command + "`"
}
