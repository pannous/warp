# The compiler's domain types, shared by its stages (cards types-front, types-back): what a plain text or int means
# where the stages hand it on. The node itself is node.warp's Node.

# a word of the program: a variable's, function's, field's or type's name
type Name = text
# the kind analyzer.warp infers for a value: one of Rust's Kinds or a finer one, Unknown while nothing flowed in; each
# spelled as the type word it reads as (decision kinds-as-cases: cases inside, spellings only at the edges)
enum ValueKind { Unknown = "", Int = "int", Float = "float", Text = "text", Codepoint = "codepoint", List = "list",
	Symbol = "symbol", Data = "data", Empty = "empty", Nil = "nil", Rational = "rational", Function = "function", Key = "key",
	Error = "error", Pointer = "pointer", I32 = "i32", F32 = "f32", Char = "char", Node = "node", Map = "map", Bool = "bool",
	Time = "time" }
# the kind emitter.warp holds a value as, spelled: "int", "float", "char", "text", "list", "node" (analyzer.warp emitter_kind)
type KindName = text
# a type word, one naming the elements of a list or map as well: `int`, `list of int`, `map of text`
type TypeWord = text
# a value's code in the emitter: [its KindName, its wasm bytes], `["int", [op.i64_const, 7]]`
type TypedCode = list
