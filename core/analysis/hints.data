# The hints of the warp compiler (core/diagnostics.warp): pattern TAB message, the first match wins
alias_word($written, $canonical)	"warp says {canonical}"	"{canonical}"	"alias-{written}@{written}"
# a word of a standard module the program names without its use (prelude_words.warp implicit_modules)
implicit_use($word, $module)	"{word} is {module}'s"	"use {module}"
