# The compile errors of the warp compiler (core/diagnostics.warp): pattern TAB message, the first match wins

# P45: a variable given values of two kinds that do not mix (kind_changes.warp)
kind_change($name, $was, $now)	"{name} was {a was}, is given {a now}: use another name"
# P71: a charged `z := …` assigned afterwards, `z = 7`, `z += 1` (source_checks.warp)
charged_assignment($name)	"{name} is defined with `:=`, charged: evaluated at each use, it takes no assignment; define it with `{name} = …` for a variable"	"{name} = …"
# decisions let-reassign, const-deep: a `let`/`const` name assigned again (source_checks.warp)
constant_assignment($name)	"{name} is a constant: declared with let or const, it binds once; declare it `var {name} = …` for a variable"	"var {name}"
# decision library-constant-refused: a library constant assigned at the top level, `pi = 4` (source_checks.warp)
library_constant($name)	"{name} is a constant"	"another name"
# decision path-after-operand: `width /height` with height a variable reads /height as a path (source_checks.warp)
division_path($before, $name)	"{before} /{name} gives {before} the path /{name}: write {before} / {name} for division"	"{before} / {name}"
# a function changing a main-level variable not declared global (main_globals.warp)
main_variable_change($name)	"{name} is a main-level variable: declare it `global {name}` to change it from a function, or use a new local name"	"global {name}"
# a lambda whose parameter is a literal, `1 => 2` (lambdas.warp written_parameters, card pure-lane-traps-2)
literal_parameter($written)	"{written} => … names no parameter: a lambda takes a name, x => …; a value written before => is a match arm"
# an error the parser leaves in the tree (sugar.warp subscript), the program's value
parse_error($message)	"{message}"
# a call no variant of a function overloaded by parameter types takes, or two take equally well (arity_overloads.warp)
no_single_variant($written, $variants)	"`{written}` fits no single variant of {variants}"
tied_variants($written, $variants)	"`{written}` fits no single variant of {variants}: give the arguments a type, e.g. `x as float`"	"x as float"
# adding two positions or indexes (index_positions.warp)
added_counts($sum)	"{sum} adds two positions or indexes: subtract them for a count"
# decision index-units: a count of bytes given to one of characters, or the other way (index_positions.warp)
mixed_count_units($given, $declared)	"{a given} given to {a declared}: bytes and characters count differently; find counts characters, byte_index_of bytes"
# `Person as Person := it`: a conversion of a type to itself (conversions.warp)
own_type_conversion($type)	"{type} as {type}: a value is already of its own type, no conversion to define"
unreachable_clause($name, $first)	"a second definition of {name} taking as many arguments can never run: {first} takes every call first; give one another name, or parameter types or patterns that tell them apart"
untellable_clause($name, $clause)	"the definitions of {name} taking as many arguments cannot be told apart at {clause}: give the parameters types the dispatch tells apart (int, float, text, a class, …), literals or list patterns, or give one another name"
