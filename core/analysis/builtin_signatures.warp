# What the builtins take and give, as their typed lines of lib/prelude.warp declare it, read once when the file loads:
# the analyzer's signature table (decision compiler-typed; Rust twin: rust-harness:src/ffi/mod.rs foreign_line, library_words.rs
# emitted_call_kind, call_result_kind and argument_result): `upper(t: text): text from warp` a runtime function,
# `count(xs: list): int from emitter` a word the emitter expands. A word may have several lines, one per type of its
# first value (`reverse(xs: list)`, `reverse(t: text)`).
use "words.warp"
use "../passes/walk.warp"
use "signatures.warp"
use "../parsing/parser.warp"
use "host_words.warp"

# a builtin word as a typed line of lib/prelude.warp declares it
class Builtin { name: text; signature: Signature }

prelude_text = module_source("prelude")
runtime_library = "warp"
emitter_library = "emitter"
alias_start = "alias "
rest_mark = "..."
# a result the call's value decides: `same as object` its kind, `element of xs`, `value of m`, `key of m` an element's
argument_results = {"same as ": "same", "element of ": "element", "value of ": "element", "key of ": "element"}

# `separator: text = " "` of a typed line → Parameter(separator, text, defaulted_to [" "]), `values...` a rest parameter
written_parameter(written: text): Parameter := {
	parts = written.split("=")
	declared = parts#1.trim().split(":")
	name = declared#1.trim()
	type_name = if #declared > 1 then declared#2.trim() else ""
	defaulted_to = if #parts > 1 then [parts[1..].join("=").trim()] else ø
	Parameter(name: name.remove_suffix(rest_mark), type_name: type_name, defaulted_to: defaulted_to, rest: name.ends_with(rest_mark))
}

# `upper(t: text): text from warp` → Builtin; ø for a line of another library
typed_line(line: text, library: text): Builtin? := {
	line = line.trim()
	suffix = " from " + library
	if not line.ends_with(suffix) { return ø }
	signature = line.remove_suffix(suffix)
	# split, not index_of: it counts bytes where slices count characters (a name with `·`)
	head = signature.split("(")
	if #head < 2 { return ø }
	tail = head[1..].join("(").split(")")
	if #tail < 2 { return ø }
	written = tail[0 ..< #tail - 1].join(")").trim()
	parameters = if written is empty then [] else written.split(",").map(part => written_parameter(part))
	result = tail#(#tail).trim().remove_prefix(":").trim()
	Builtin(name: head#1, signature: Signature(parameters: parameters, result: result))
}

library_lines(library: text): list := prelude_text.split("\n").map(line => typed_line(line, library)).filter(line => line != ø)

runtime_lines = library_lines(runtime_library)
# the words only the compiler's passes write, which no program calls (closures, cells and signals, memos, linear
# arrays, the switch and extremum errors, times, Uniscript; ran·without·error, declared as the prelude declares the words programs call
compiler_lines = [
# Todo bring all of these for discussion And explanation to the interviewer 
	"ran·without·error(statement): bool from emitter",
	"positioned(n, line, column): any from emitter",
	"closure_new(values...): function from emitter",
	"cell_get(cell): any from emitter",
	"cell_set(cell, value): any from emitter",
	"signal_new(value): signal from emitter",
	"signal_listeners(signal): any from emitter",
	"signal_listeners_set(signal, listeners): any from emitter",
	"memo_known(values...): int from emitter",
	"memo_value(values...): int from emitter",
	"memo_store(values...): int from emitter",
	"linear_new(values...): int from emitter",
	"linear_count(values...): int from emitter",
	"linear_getf(values...): float from emitter",
	"linear_setf(values...): float from emitter",
	"linear_dotf(values...): float from emitter",
	"switch_no_case(values...): int from emitter",
	"empty_extremum(word): int from emitter",
	"instant_at(values...): time from emitter",
	"time_of(info, position): time from emitter",
	"floor_quotient(a, b): int from emitter",
	"zero_fill(count, filler): list from emitter",
	"instance_of(x, class_name): bool from emitter",
	"caught_error(finished, value): error from emitter",
	"byte_at(t, offset): int from emitter",
	# todo Can we move all the uniscript to a later extension pass because the core compiler does not use any uniscript
	"uniscript_error(values...): int from emitter",
	"uniscript_warnings(values...): int from emitter",
	"uniscript_to_unicode(values...): int from emitter",
	"uniscript_to_uniscript(values...): int from emitter",
	"uniscript_explicit(values...): int from emitter"
].map(line => typed_line(line, emitter_library))
emitter_lines = library_lines(emitter_library) + compiler_lines
typed_lines = runtime_lines + emitter_lines

# `alias size = count` → ["size", "count"]
alias_pairs = prelude_text.split("\n").filter(line => line.starts_with(alias_start)).map(line => line.remove_prefix(alias_start).split("=").map(word => word.trim()))

# the library word a word names: its canonical word (lib/aliases.warp: `size` is count), through the prelude's
# `alias keys = map_keys` lines
unaliased(written: text): text := {
	word = canonical_word(written) ?? written
	for pair in alias_pairs { if pair#1 == word { return pair#2 } }
	word
}

lines_of(lines: list, word: text): list := lines.filter(line => line.name == word)


# the kind a line's result is held as when it is a text or a list (`list of text` too); ø for another
line_result_kind(line: Builtin): text? := if line.signature.result == "text" then "text" else if line.signature.result.starts_with("list") then "list" else ø

# the kind a call of `arguments` values to a word the emitter expands gives, as its first fitting line declares it; ø
# when the call decides it (`number("2.5")`, a bool the emitter marks) or the line names no kind
emitted_call_kind(word: text, arguments: int): text? := {
	fitting = lines_of(emitter_lines, unaliased(word)).filter(line => takes(line.signature, arguments))
	if #fitting == 0 { return ø }
	line = fitting#1
	match line.signature.result {
		"nothing" => "empty"
		"symbol" => "symbol"
		"number" | "bool" => ø
		"any" => "empty"
		_ => if line_result_kind(line) != ø then line_result_kind(line) else type_word_kind(line.signature.result)
	}
}

# the argument a word's result follows, and how: `field_with(object, name, value): same as object` → ["same", 1],
# `map_get_or(m, key, default): value of m` → ["element", 1]; ø for a result of its own
argument_result(word: text): list? := {
	lines = lines_of(typed_lines, unaliased(word))
	if #lines == 0 { return ø }
	line = lines#1
	for spelling in argument_results.keys() {
		if line.signature.result.starts_with(spelling) {
			followed = line.signature.result.remove_prefix(spelling)
			names = taken_names(line.signature)
			return if names contains followed then [argument_results[spelling], names.index_of(followed)] else ø
		}
	}
	ø
}

# the result of a runtime word for a first value of kind `first`: its overload's for that kind (`reverse(t: text): text`),
# else the one all its overloads share; ø when the overloads give no text or list
overload_kind(word: text, first: text): text? := {
	overloads = lines_of(runtime_lines, unaliased(word))
	if #overloads == 0 { return ø }
	kinds = overloads.map(line => line_result_kind(line))
	if kinds.all(kind => kind == kinds#1) { return kinds#1 }
	if first == "empty" { return "empty" }
	fitting = if first == "codepoint" then "text" else first
	for line in overloads {
		if #line.signature.parameters > 0 and type_word_kind(line.signature.parameters#1.type_name) == fitting { return line_result_kind(line) }
	}
	kinds#1
}

# the kind a value of a built-in type word is held as: `int` int, `text` text; ø for a list, a map or no type
type_word_kind(word: text): text? := type_kinds.get(word)

# libm's functions as lib/math.warp's foreign lines declare them, `floor(x: float): float from 'm'`: what a call of
# floor compiles to, so its result is the call's
foreign_math_lines = module_source("math").split("\n").map(line => typed_line(line, "'m'")).filter(line => line != ø)
# the words lib/math.warp declares from the runtime, `max(a, b, more...) from warp`, which a program calls without its use
math_runtime_lines = module_source("math").split("\n").map(line => typed_line(line, runtime_library)).filter(line => line != ø)
# the lines declaring a word a program may name as a function value (lambdas.warp declared_word_value)
value_word_lines(word: text): list := lines_of(typed_lines + math_runtime_lines + foreign_math_lines, unaliased(word))

# the kind a declared result is held as: `nothing` and `any` a node of run-time kind, a yes/no an int, a type of
# values its kind, any other type (`time`, `signal`) an object; ø for `number`, decided where the value is made
declared_result_kind(result: text): text? := {
	if result == "" or result == "nothing" or result == "any" { return "empty" }
	if result == "number" { return ø }
	if result == "bool" { return "int" }
	if result == "symbol" or result == "error" { return result }
	if result == "text" { return "text" }
	if result.starts_with("list") { return "list" }
	type_word_kind(result) ?? "data"
}

# the builtins taking one value, `upper(t)`, or only a rest of values, `print(values...)`, and their other spellings:
# `print #xs` counts, `print -1` negates the value after them
takes_one_value(signature: Signature): bool := arity(signature) == [1, 1] or (#signature.parameters == 1 and signature.parameters#1.rest)
value_taking_names = typed_lines.filter(line => takes_one_value(line.signature)).map(line => line.name)
value_taking_words = value_taking_names + alias_pairs.filter(pair => pair#2 in value_taking_names).map(pair => pair#1)

# a builtin all of whose lines give nothing, `print(values...): nothing`
gives_nothing(word: text): bool := {
	lines = lines_of(typed_lines, unaliased(word))
	#lines > 0 and lines.all(line => line.signature.result == "nothing")
}

# a member of every map, `m.keys`, `m.get(k)`: a builtin whose line takes a map first
takes_map_first(word: text): bool := lines_of(typed_lines, unaliased(word)).any(line => #line.signature.parameters > 0 and line.signature.parameters#1.type_name == "map")

# a word the prelude, libm or the host declares
is_declared_word(word: text): bool := #lines_of(typed_lines + foreign_math_lines, unaliased(word)) > 0 or host_words.has(word)

# a host word's result kinds as host_words.warp declares them: one int or float, else a node or none
host_result_kind(results: list): text := if #results == 1 and results#1 != "node" then type_word_kind(results#1) ?? "int" else "empty"

# the kind a call of `arguments` values to a declared word gives, by the one result all its fitting lines declare: a
# prelude typed line, a libm foreign line, a host word; ø when its lines differ by the argument (`reverse` of a text
# or list, `same as object`) or nothing declares it
declared_call_kind(word: text, arguments: int): text? := {
	fitting = lines_of(typed_lines + foreign_math_lines, unaliased(word)).filter(line => takes(line.signature, arguments))
	if #fitting > 0 {
		results = fitting.map(line => line.signature.result)
		if results.any(result => result != results#1) or argument_result(word) != ø { return ø }
		return declared_result_kind(results#1)
	}
	if host_words.has(word) { host_result_kind(host_words[word]#2) } else { ø }
}

# the libraries of the typed lines: warp's runtime, the emitter's expansions, libm
typed_libraries = ["warp", "emitter", "'m'"]

# word → its typed lines of the prelude the lowering reads (lowering_from) and, beside lib/prelude.warp, of the
# lib/math.warp it reaches, the first written first. A primitive file's prelude (lib/primitive.warp) has none: no GC
# library word joins its definitions as a variant (arity_overloads.warp library_variants)
global typed_word_lines = ø
global word_lines_prelude = prelude_text
# a lowering of a program behind this prelude: the library words it sees are the prelude's
lowering_from(prelude: text) := {
	if prelude != word_lines_prelude {
		word_lines_prelude = prelude
		typed_word_lines = ø
	}
}
word_lines(): map := {
	if typed_word_lines != ø { return typed_word_lines }
	typed_word_lines = {}
	sources = if word_lines_prelude == prelude_text then prelude_text + "\n" + module_source("math") else word_lines_prelude
	for line in sources.split("\n") {
		for library in typed_libraries {
			typed = typed_line(line, library)
			if typed != ø {
				if not typed_word_lines.has(typed.name) { typed_word_lines[typed.name] = [] }
				typed_word_lines[typed.name] = typed_word_lines[typed.name] + [typed]
			}
		}
	}
	typed_word_lines
}

# a word of the runtime, the emitter or a typed line of the library (lib/math.warp's `max`), which a class's method of
# that name must not hide from the other values (class_methods.warp routes it, rewrites.warp keeps its sugar rules)
is_library_word(word: text): bool := typed_lines.any(line => line.name == word) or word_lines().has(word)

# whether the word's first line takes exactly one value, typed
takes_one_typed_value(word: text): bool := {
	lines = word_lines()
	if not lines.has(word) { return no }
	parameters = lines[word]#1.signature.parameters
	#parameters == 1 and parameters#1.type_name != "" and not parameters#1.rest
}
