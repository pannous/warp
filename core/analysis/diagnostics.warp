# The diagnostics of the warp compiler (card pure-diagnostics, decision diagnostics-files): a check finds a fact, a
# node such as `kind_change(x, Int, List)`, and `diagnose(fact, about)` says it where the program wrote the node
# `about`, with the message of the first row it matches in errors.data, then warnings.data, then hints.data. A row is `pattern TAB message`, optionally `TAB fix`
# and then `TAB topic@expression`, what "got it" silences:
# the pattern a node whose `$name` parts take any node (`data(…)` quotes it), the message and fix texts whose
# `{name}` holes give that part and `{a name}` it with its article. compiler.warp says
# the warnings and fails on an error.
use "../parsing/parser.warp"
use "words.warp"

# the message files in the order a fact is looked up, each with the level of its messages and its text, built into the
# compiler when it is compiled, never read from a lib/ when it runs 
# how much a diagnostic matters, spelled as `diagnosed` holds it
# (a reading: what the compiler chose where the program left it unwritten, never said on a run; `warp format` writes it)
enum Level { Error = "error", Warning = "warning", Hint = "hint", Reading = "reading" }
message_files = [["errors.data", Level.Error, module_source("compiler/analysis/errors.data")], ["warnings.data", Level.Warning, module_source("compiler/analysis/warnings.data")], ["hints.data", Level.Hint, module_source("compiler/analysis/hints.data")], ["readings.data", Level.Reading, module_source("compiler/analysis/readings.data")]]
quoting_word = "data"
hole_mark = "$"

# [level, message, fix, topic@expression, [line, column] or ø, key] of each fact diagnosed so far ("" when it names none),
# the place where the program wrote the node the fact is about
global diagnosed = []
# [level, pattern, message] of every row of the message files, read at the first fact
global message_rows = ø

# the node a check looks at: a key of the operator
is_operator(n: any, op: text) as bool := n is key and op_of(n) == op

# the fact about the program's node `about`, which names where it is written
diagnose(fact: Node, about: Node) as Node := diagnosed_at(fact, written_at(about))
# the fact about the place [line, column] of the source, for a check of its text (a comment holds no node)
# (once: a source the compiler parses twice says each fact once)
diagnosed_at(fact: Node, place: list?) as Node := {
	fact_said = said_fact(fact) + [place, fact_key(fact)]
	if fact_said not in diagnosed { diagnosed += [fact_said] }
	fact
}

# the name of the fact, its message row's key (`charged_assignment` of `charged_assignment(z)`)
fact_key(fact: Node) as text := if fact is symbol then name_of(fact) else head_name(fact)

# [level, message, fix, topic@expression] of the first row the fact matches; a fact no row matches is an error
# naming it, loudly
said_fact(fact: Node) as list := {
	for row in rows() {
		bound = {}
		if matches(row#2, fact, bound) { return [row#1] + row[2..].map(message => filled(message, bound)) }
	}
	[Level.Error as text, "no message for the diagnostic ${fact} in core/" + message_files.map(file => file#1).join(", "), "", ""]
}

rows() as list := {
	if message_rows == ø { message_rows = message_files.map(file => rows_of(file#3, file#2)).flatten() }
	message_rows
}

# the rows of a message file's text as plain warp data: a list of lines, each a tab-separated [pattern, message] with
# an optional fix and topic@expression after it, as [level, pattern, message, fix, topic@expression]
rows_of(source: text, level: Level) as list := {
	spelled = level as text
	lines = statements_in(plain_node(parsed(source)))
	lines.filter(line => line != ø).map(line => [spelled, unquoted(line#1), line#2, column(line, 3), column(line, 4)])
}
column(line: any, index: int) as text := if #line >= index then line#index else ""
unquoted(pattern: any) as any := if is_group(pattern) and #pattern == 2 and pattern#1 == symbol(quoting_word) then pattern#2 else pattern

# whether n has the pattern's shape, each part a hole takes put in `bound`: a hole takes any node, a key or group
# matches part by part, any other node only itself
matches(pattern: Node, n: Node, bound: map) as bool := {
	if pattern is symbol and name_of(pattern).starts_with(hole_mark) {
		bound[name_of(pattern)[1..]] = n
		return yes
	}
	if pattern is key {
		return n is key and op_of(n) == op_of(pattern) and matches(key_of(pattern), key_of(n), bound) and matches(value_of(pattern), value_of(n), bound)
	}
	if is_group(pattern) {
		if not is_group(n) or bracket_of(n) != bracket_of(pattern) or #n != #pattern { return no }
		for index in 0 ..< #pattern { if not matches(pattern[index], n[index], bound) { return no } }
		return yes
	}
	pattern == n
}

# the message with each hole `{name}` or `{a name}` filled from the bound parts
filled(message: text, bound: map) as text := {
	pieces = message.split("{")
	result = pieces#1
	for piece in pieces[1..] {
		hole = piece.split("}")#1
		words = hole.split(" ")
		part = shown(bound[words#(#words)])
		result += (if #words == 2 and words#1 == "a" then with_article(part) else part) + piece[(#hole + 1)..]
	}
	result
}
shown(part: any) as text := if part is symbol then name_of(part) else if part is text then part else "${part}"

# what was diagnosed after the first `known` facts: a compile's own, past those of the runtime words lowered before it
diagnosed_since(known: int) as list := diagnosed[known ..]

# the first error among the diagnosed in the program's file; ø when none is an error
# todo (card diagnostics-list-of-what) list of what?
# (`keyed`: led by `error(<key>)`, the row's key, for `warp test` to tell errors apart by; never shown to people)
first_error(found: list, file: text, keyed: bool) as text? := {
	# todo (card said-field-names) BIG refactor said#1 =>  said.name Or whatever the number one here and everywhere applies to 
	failing = found.find(said => said#1 == Level.Error)
	if not failing { return ø }
	(if keyed then "error(" + failing#6 + ") " else "") + said_text(failing, file)
}

# the diagnosed of a level in the program's file: its warnings, its hints
said_at(found: list, level: Level, file: text) as list := found.filter(said => said#1 == level).map(said => said_text(said, file))

# a diagnosed [level, message, fix, topic, place] as diagnostic says it: the message and where in the file,
# todo (card diagnostic-class) wrap [level, message, fix, topic, place] as small type / class
# then `; fix: ` and the fix when it names one
said_text(said: list, file: text) as text := {
	text = said#2 + place_text(said#5, file)
	if said#3 then text + "; fix: " + said#3 else text
}
