	task_failure: [[ValueKind.Int], [ValueKind.Node]]
	task_status: [[ValueKind.Int], [ValueKind.Int]]
	task_poll: [[], []]
	task_inside: [[], [ValueKind.Int]]
	task_forks: [[], [ValueKind.Int]]
	task_split_mapf: [[ValueKind.I32, ValueKind.Int], [ValueKind.Int]]
	signal_send: [[ValueKind.I32, ValueKind.Node], [ValueKind.Int]]
	shared_new: [[ValueKind.Int], [ValueKind.Int]]
	shared_get: [[ValueKind.Int, ValueKind.Int], [ValueKind.Int]]
	shared_set: [[ValueKind.Int, ValueKind.Int, ValueKind.Int], [ValueKind.Int]]
