	clipboard_text: [[], [ValueKind.Node]]
	page_path: [[], [ValueKind.Node]]
	notify: [[ValueKind.Node], []]
	channel_send: [[ValueKind.Node, ValueKind.Node], []]
	dispatch_event: [[ValueKind.Node, ValueKind.Node], []]
	guarded_call: [[ValueKind.I32, ValueKind.Node], [ValueKind.Node]]
	paint: [[ValueKind.Node, ValueKind.Int, ValueKind.Int, ValueKind.Node], []]
	save_picture: [[ValueKind.Node, ValueKind.Int, ValueKind.Int, ValueKind.Node], []]
	sound_samples: [[ValueKind.Node, ValueKind.Int, ValueKind.Int, ValueKind.Int], []]
	run_block: [[ValueKind.Node, ValueKind.Node, ValueKind.Node, ValueKind.Node], [ValueKind.Node]]
	parse_code: [[ValueKind.Node], [ValueKind.Node]]
	# a path with the links on its way followed (libc realpath; a file not there yet, its folder's): what the runtime's file
