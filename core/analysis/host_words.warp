	real_path: [[ValueKind.Node], [ValueKind.Node]]
	"block·value": [[ValueKind.Int], [ValueKind.Node]]
	foreign_call: [[ValueKind.Node, ValueKind.Node, ValueKind.Node, ValueKind.Node, ValueKind.Node], [ValueKind.Node]]
	sleep_ms: [[ValueKind.Int], []]
	random: [[], [ValueKind.Float]]
	random_below: [[ValueKind.Int], [ValueKind.Int]]
	random_seed: [[ValueKind.Int], []]
	clock: [[], [ValueKind.Int]]
	local_offset: [[ValueKind.Int], [ValueKind.Int]]
	signal_poll: [[], []]
	signal_listen: [[ValueKind.Int, ValueKind.Int, ValueKind.Int], []]
	signal_watch: [[ValueKind.Int, ValueKind.I32], []]
	system_value: [[ValueKind.CText], [ValueKind.Int]]
	set_system_value: [[ValueKind.CText, ValueKind.Int], []]
