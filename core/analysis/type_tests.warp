# `x is int`, `n is symbol` (card pure-type-tests): `x is T` of a type word T no variable, parameter or loop variable
# in reach names (a field `{symbol: …}` does not), or of a type the program declares, is the type test
# is_type(x, "T") (plain_enums.warp answers it for an enum);
# every other `x is v` is `x == v`. Only `is` tests a type: `3 == int` compares 3 with the type (no)
use "../passes/walk.warp"
use "words.warp"
use "../passes/scope.warp"

tested_word_call(subject: Node, word: text, equality: Node, scope: map): Node :=
	if is_tested_type(word, scope) then call_of("is_type", [tested(subject), word]) else held_type_test(subject, word, scope) ?? equality

# `Paint = Color; c is Paint` tests Color, `t = type(-3); 5 is t` is `type(5) is t`: a type is a value, a variable holding
# one is tested against it (decision type-text); one assigned again reads two ways, so it is refused
global assigned_values = {}
held_type_test(subject: Node, word: text, scope: map): Node? := {
	values = assigned_values.get(word) ?? []
	held = values.filter(value => holds_type(value, scope))
	if #held == 0 { return ø }
	if #values > 1 { raise word + " is reassigned: write `type " + word + " = ${held#1}`, or compare values with ==" + place_text(written_at(subject), "") }
	if held#1 is symbol then tested_type_call(subject, held#1, scope) else Key(call_of("type", [subject]), Op.Is, symbol(word))
}
holds_type(value: Node, scope: map): bool := (value is symbol and is_tested_type(name_of(value), scope)) or tested(value) != value

# name → the values the program's assignments give it
assignments_found(program: Node): map := {
	found = {}
	for n in nodes_in(program) { if is_key(n, Op.Assign) and key_of(n) is symbol { found[name_of(key_of(n))] = found.get(name_of(key_of(n))) + [value_of(n)] } }
	found
}

# `type(x) is int` tests x, as the type of x is what it names (card type-int)
tested(subject: Node): Node := match subject {
	List(items, bracket, separator): { if #items == 2 and items#1 == symbol("type") then items#2 else subject }
	_: subject
}

# a type word no value of the program is named, or a type it declares (`enum Coin {…}`, `class P {…}`)
is_tested_type(word: text, scope: map): bool :=
	not binds_value(scope, word) and (is_tested_type_word(word) or binds_as(scope, word, Meaning.Type))

tested_type_call(subject: Node, type: Node, scope: map): Node := match type {
	Symbol(word): tested_word_call(subject, word, Key(subject, Op.Eq, type), scope)
	# `x is (int or text)`: x is one of the alternatives, `x is (1 or 2)` too
	Key(left, Op.Or, right): Key(tested_type_call(subject, left, scope), Op.Or, tested_type_call(subject, right, scope))
	Key(left, Op.BitOr, right): Key(tested_type_call(subject, left, scope), Op.Or, tested_type_call(subject, right, scope))
	List(items, bracket, separator): if #items == 1 and bracket == Bracket.Round then tested_type_call(subject, items#1, scope) else Key(subject, Op.Eq, type)
	_: Key(subject, Op.Eq, type)
}

# `xs is [a, b]`, `"v12" is "v" + n`, `r is {status: s}`: a list, tuple, map or text cut naming what nothing binds yet
# (or `_`, `...rest`) tests the shape and binds those names, as a match arm does (node_matches.warp, lib/prelude.warp
# pattern_bindings); one naming only known values still compares, `xs is [a, b]` of a = 1, b = 2
is_shape_pattern(p: Node): bool := (is_group(p) and (bracket_of(p) == "[" or bracket_of(p) == "{" or (bracket_of(p) == "(" and separator_of(p) == ","))) or is_text_cut_pattern(p)
is_text_cut_pattern(p: Node): bool := (is_key(p, Op.Add) and nodes_in(p).any(part => part is text)) or (is_key(p, Op.Colon) and (is_key(key_of(p), Op.Add) or is_key(key_of(p), Op.Colon)))
new_pattern_names(p: Node, scope: map): list := structural_names(p, no).filter(name => not binds_own_value(scope, name))
# a value the program binds itself, not a global only a used module brought (units' s, m, px), which a pattern's name
# shadows as a match arm's does: `r is {status: s}` binds s
binds_own_value(scope: map, name: text): bool := binds_value(scope, name) and not brought_names.has(name) and not brought_value_names.has(name)
binds_new_names(p: Node, scope: map): bool := is_shape_pattern(p) and (#new_pattern_names(p, scope) > 0 or nodes_in(p).any(part => part == symbol(other_arm)))
shape_test(subject: Node, p: Node, scope: map): Node := {
	bound = new_pattern_names(p, scope).map(name => Key(symbol(name), Op.Assign, subscript(symbol(match_bound), name)))
	Key(structural_test(subject, p), Op.And, List(bound + [yes], Bracket.Round, Separator.Semicolon))
}

# `n is Key(h, Op.Define, b)`: a node case tests the subject's kind and parts and binds the parts it names, as a match
# arm does (node_matches.warp arm_test, part_bindings); a subject other than a name is evaluated once
case_test(subject: Node, pattern: list): Node := {
	held = if is_name(subject) then subject else symbol(subject_name)
	test = Key(arm_test(pattern, held), Op.And, List(part_bindings(pattern, held) + [yes], Bracket.Round, Separator.Semicolon))
	if held == subject then test else List([Key(held, Op.Assign, subject), test], Bracket.Round, Separator.Semicolon)
}

type_test_node(n: Node, scope: map): Node := match n {
	Key(subject, Op.Is, type): if case_pattern(type) != ø then case_test(subject, case_pattern(type)) else if binds_new_names(type, scope) then shape_test(subject, type, scope) else tested_type_call(subject, type, scope)
	_: n
}

# a function's body sees the program's names outside function bodies and its own parameters and locals:
# `x is key` in one function stays a type test beside a local `key` of another
type_tests(program: Node): Node := { assigned_values = assignments_found(program); lexical_bottom_up(program, scope_with({}, outer_nodes_in(program)), type_test_node) }
