# The checks of a program as written (card pure-diagnostics): they read parser.warp's nodes with their attribute layers (the mark of
# `x.upper!`) and diagnose facts, whose messages are in warnings.data
use "../passes/walk.warp"
use "../passes/scope.warp"
use "../passes/prelude_words.warp"
use "diagnostics.warp"
use "lints.warp"

# words whose result is a changed copy of their argument: dropping it changes nothing
copy_words = ["upper", "lower", "trim", "reverse", "sort", "replace", "capitalize"]
sleep_word = "sleep"
error_word = "error"
fail_word = "fail"

# the program, each check's facts diagnosed; `prelude` names the other spellings of the words (`uppercase`)
source_checks(program: Node, prelude: text): Node := {
	aliases = module_aliases(prelude)
	library_constant_assignments(program)
	for n in nodes_in(program) {
		located_error(n)
		for lint in hooks().lints { lint(n, program) }
		bare_sleep(n)
		spaced_sign(n)
		uneven_spacing(n)
		assigned_mutation(n, aliases)
		lints_of(without_mark(n))
		if is_group(n) and separator_of(n) in statement_separators {
			listed_statements = items_of(n)
			for statement in listed_statements[0 ..< (#listed_statements - 1)] { dropped_value(statement, aliases) }
			charged_assignments(n)
			constant_assignments(n)
		}
	}
	program
}

# P71 (wiki/charged.md): `z := 6` is charged, evaluated at each use, so assigning it afterwards in its block, `z = 7`,
# `z += 1`, is an error naming the definition (P138: also Go's `total := 0; total += n`)
charged_assignments(block: Node) := {
	charged = items_of(block).map(plain_node).filter(is_charged_value).map(statement => name_of(key_of(statement)))
	if #charged == 0 { return ø }
	for n in nodes_in(block) {
		if n is key and op_of(n) in assigning_operators and "${without_mark(key_of(n))}" in charged { diagnose(call_of("charged_assignment", ["${without_mark(key_of(n))}"]), n) }
	}
	ø
}
# decisions let-reassign, const-deep: a name declared `let k = 7` (also const, constant, final, val) binds once, so
# assigning it again in its block, `k = 8`, `k += 1`, is an error whose fix is the variable, `var k = 7`; a function's
# body keeps its own locals (lambda-assign-writes-through); its own value again, `const x=7; x=7`, changes nothing (P159)
constant_words = ["let", "const", "constant", "final", "val"]
constant_assignments(block: Node) := {
	constants = {}
	for statement in items_of(block).map(plain_node) {
		bound = declared_constant(statement)
		if bound != ø { constants[name_of(key_of(bound))] = "${value_of(bound)}" }
	}
	if #constants == 0 { return ø }
	for statement in items_of(block).filter(statement => declared_constant(plain_node(statement)) == ø) {
		for n in outer_nodes_in(statement) {
			name = if n is key and op_of(n) in assigning_operators then "${without_mark(key_of(n))}" else ""
			if constants.has(name) and not (op_of(n) == "=" and "${value_of(n)}" == constants[name]) { diagnose(call_of("constant_assignment", [name]), n) }
		}
	}
	ø
}
# decision library-constant-refused: a library's constant, `const pi() := π` of reals, is no variable of the program, so
# a top-level `pi = 4` is an error; a local inside a function may shadow it
library_constant_assignments(program: Node) := {
	constants = library_constants()
	for statement in statements_in(program) {
		name = if statement is key and op_of(statement) in assigning_operators then "${without_mark(key_of(statement))}" else ""
		if constants.has(name) { diagnose(call_of("library_constant", [name]), statement) }
	}
	ø
}
# the binding `k = 7` of `let k = 7` declaring a constant, else ø
declared_constant(statement: Node): any := {
	if not (is_group(statement) and #statement == 2 and statement#1 is symbol and name_of(statement#1) in constant_words) { return ø }
	bound = statement#2
	if bound is key and op_of(bound) == "=" and key_of(bound) is symbol then bound else ø
}
# an error the parser leaves in the tree (a negative index), the program's value
located_error(n: Node) := {
	message = parse_error_message(n)
	if message != ø { diagnose(call_of("parse_error", [message]), n) }
	ø
}

# `1 +1`, `x -1`: a sign spaced before but not after starts an item of its own (parser.warp signed_item_at), which
# reads as an operation spaced unevenly: the fix spaces it evenly, `1 + 1`
spaced_sign(n: Node) := {
	if not (n is key and key_of(n) == symbol(attribute_word) and value_of(n)#1 == SPACED_SIGN_MARK) { return ø }
	written = items_of(value_of(n)#2)
	item = written#2
	diagnose(call_of("spaced_sign", [written#1, item, written#1 + " " + item[0 ..< 1] + " " + item[1 ..]]), n)
}
# `a *b`: an operator spaced on one side only computes; the fix spaces it evenly, `a * b`
uneven_spacing(n: Node) := {
	if not (n is key and key_of(n) == symbol(attribute_word) and value_of(n)#1 == UNEVEN_SPACING_MARK) { return ø }
	written = items_of(value_of(n)#2)
	diagnose(call_of("uneven_spacing", [written#1, written#2, written#3 + " " + written#2 + " " + written#4]), n)
}
# `x!` as parser.warp writes it, `unwrap(x)`, and the node it marks
has_mutation_mark(n: Node): bool := is_round(n) and #n == 2 and n#1 == symbol(unwrap_word)
without_mark(n: Node): Node := if has_mutation_mark(n) then without_mark(n#2) else if n is key and key_of(n) == symbol(attribute_word) then without_mark(value_of(n)#3) else n

# --- `sleep(1)` needs a unit  ---

bare_sleep(n: Node) := {
	if is_group(n) and #n == 2 and n#1 == symbol(sleep_word) and n#2 is number { diagnose(call_of("bare_sleep", ["${n#2}"]), n#2) }
	ø
}

# --- values a statement drops (wiki/mutable.md) ---

# `uppercase x;` drops the copy; a dropped `error "…"` makes an error value nothing raises (card error-if)
dropped_value(statement: Node, aliases: map) := {
	call = copy_call(statement, aliases)
	if call != ø { diagnose(call_of("dropped_copy", call), statement) }
	for dropped in dropped_errors(statement) { diagnose(call_of("dropped_error", ["\"" + dropped + "\""]), statement) }
	ø
}

# `y = x.upper!` changes x too
assigned_mutation(n: Node, aliases: map) := {
	if not (is_operator(n, "=") or is_operator(n, ":=")) { return ø }
	variable = marked_copy_variable(value_of(n), aliases)
	if variable != ø { diagnose(call_of("assigned_mutation", ["${without_mark(key_of(n))}", variable]), n) }
	ø
}

# [word, variable, marked] of a copy word called on a variable as written: `upper x`, `upper(x)`, `x.upper`,
# `x.upper()`, marked by a `!` on the call or the variable (`x.upper!`, `upper x!`)
copy_word_call(call: Node, aliases: map): list? := {
	parts = word_and_variable(without_mark(call))
	if #parts != 2 { return ø }
	copy_word_of(callee_of(parts#1), without_mark(parts#2), has_mutation_mark(call) or has_mutation_mark(parts#2), aliases)
}
# [word, variable] of `x.word` and `word x`, else []
word_and_variable(inner: Node): list := if is_operator(inner, ".") then [value_of(inner), key_of(inner)] else if is_group(inner) and #inner == 2 then items_of(inner) else []
# `upper` of `x.upper()`
callee_of(word: Node): Node := if is_group(word) and bracket_of(word) == "(" and #word == 1 then word#1 else word
copy_word_of(callee: Node, variable: Node, marked: bool, aliases: map): list? := {
	if not (callee is symbol) or not (variable is symbol) { return ø }
	called = name_of(callee)
	canonical = if called in aliases then aliases[called] else called
	if canonical in copy_words then [called, name_of(variable), marked] else ø
}
# [word, variable] of an unmarked copy call
copy_call(call: Node, aliases: map): list? := {
	found = copy_word_call(call, aliases)
	if found == ø { return ø }
	if found#3 then ø else [found#1, found#2]
}
# the variable a marked copy call changes
marked_copy_variable(value: Node, aliases: map): text? := {
	found = copy_word_call(value, aliases)
	if found == ø { return ø }
	if found#3 then found#2 else ø
}

# the messages of the `error "…"` calls a dropped statement drops: the statement itself, the branches of an if, the
# last statement of a block
dropped_errors(statement: Node): list := {
	n = without_mark(statement)
	if is_group(n) and #n == 2 and n#1 == symbol(error_word) and separator_of(n) != ";" { return ["" + n#2] }
	if is_operator(n, "then") { return dropped_errors(value_of(n)) }
	if is_operator(n, "else") { return dropped_errors(key_of(n)) + dropped_errors(value_of(n)) }
	if is_group(n) and #n > 0 and (bracket_of(n) == "{" or separator_of(n) in statement_separators) { return dropped_errors(n#(#n)) }
	[]
}
