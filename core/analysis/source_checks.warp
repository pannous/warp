# The checks of a program as written (card pure-diagnostics): they read parser.warp's nodes with their attribute layers (the mark of
# `x.upper!`) and diagnose facts, whose messages are in warnings.data
use "../passes/walk.warp"
use "../passes/scope.warp"
use "../passes/prelude_words.warp"
use "diagnostics.warp"
use "lints.warp"

# words whose result is a changed copy of their argument: dropping it changes nothing
copy_words = ["upper", "lower", "trim", "reverse", "sort", "replace", "capitalize"]
sleep_word = "sleep"
error_word = "error"

# the program, each check's facts diagnosed; `prelude` names the other spellings of the words (`uppercase`)
source_checks(program: Node, prelude: text) as Node := {
	aliases = module_aliases(prelude)
	own_names = statements_in(program).map(declared_name)
	library_constant_assignments(program)
	for n in nodes_in(program) {
		located_error(n)
		for lint in hooks().lints { lint(n, program) }
		bare_sleep(n)
		spaced_sign(n)
		imaginary_i(n, program)
		division_path(n, program)
		uneven_spacing(n)
		spaced_operand(n, program)
		assigned_mutation(n, aliases)
		literal_targets(n)
		foreign_spelling(n, own_names)
		lints_of(without_mark(n))
		if is_group(n) and separator_of(n) in statement_separators {
			listed_statements = items_of(n)
			for statement in listed_statements[0 ..< (#listed_statements - 1)] { dropped_value(statement, aliases) }
			charged_assignments(n)
			constant_assignments(n)
		}
	}
	program
}

# `len(xs)`: another language's spelling of a word (lib/aliases.warp's foreign), the hint naming warp's, count; not of
# a name the program defines itself; said at the call, whose head the parser places nowhere, else at the name
foreign_spelling(n: Node, own_names: list) := {
	spelled = if is_group(n) and #n > 0 and n#1 is symbol then n#1 else if n is symbol and is_positioned(n) then n else ø
	word = if spelled != ø then alias_spellings().foreign.get(name_of(spelled)) else ø
	if word != ø and name_of(spelled) not in own_names { diagnose(call_of("alias_word", [symbol(name_of(spelled)), symbol(word)]), n) }
}

# P71 (wiki/charged.md): `z := 6` is charged, evaluated at each use, so assigning it afterwards in its block, `z = 7`,
# `z += 1`, is an error naming the definition (P138: also Go's `total := 0; total += n`)
charged_assignments(block: Node) := {
	charged = items_of(block).map(plain_node).filter(is_charged_value).map(statement => name_of(key_of(statement)))
	if #charged == 0 { return ø }
	for n in own_writes(items_of(block)) {
		name = "${written_root(key_of(n))}"
		if name in charged { diagnose(call_of("charged_assignment", [name]), n) }
	}
	ø
}
# decisions let-reassign, const-deep: a name declared `let k = 7` (also const, constant, final, val) binds once, so
# assigning it again in its block, `k = 8`, `k += 1`, is an error whose fix is the variable, `var k = 7`; a function's
# body keeps its own locals (lambda-assign-writes-through); its own value again, `const x=7; x=7`, changes nothing (P159)
constant_words = ["let", "const", "constant", "final", "val"]
# the variable a write changes: `x` of `x = …`, and of `x.a.b = …` and `x#i = …` too, which change inside it (const-deep)
written_root(target: Node) as Node := {
	plain = without_mark(target)
	if is_key(plain, Op.Dot) or is_key(plain, Op.Hash) then written_root(key_of(plain)) else plain
}
constant_assignments(block: Node) := {
	constants = {}
	for statement in items_of(block).map(plain_node) {
		bound = declared_constant(statement)
		if bound != ø { constants[name_of(key_of(bound))] = "${value_of(bound)}" }
	}
	if #constants == 0 { return ø }
	for statement in items_of(block).filter(statement => declared_constant(plain_node(statement)) == ø) {
		for n in outer_nodes_in(statement) {
			name = if n is key and op_of(n) in assigning_operators then "${written_root(key_of(n))}" else ""
			if constants.has(name) and not (op_of(n) == "=" and "${value_of(n)}" == constants[name]) { diagnose(call_of("constant_assignment", [name]), n) }
		}
	}
	ø
}
# decision library-constant-refused: a library's constant, `const pi() := π` of reals, is no variable of the program, so
# a top-level `pi = 4` is an error; a local inside a function may shadow it
library_constant_assignments(program: Node) := {
	constants = library_constants()
	for statement in statements_in(program) {
		name = if statement is key and op_of(statement) in assigning_operators then "${without_mark(key_of(statement))}" else ""
		if name != "" and constants.has(name) { diagnose(call_of("library_constant", [name]), statement) }
	}
	ø
}
# decision literal-targets: a value where a variable changes, `1 = 2`, `1 += 3`, `1++`, is an error whose fix names
# the readings: a variable, or the operation the spacing hid (`1 ++ 3` as 1 + +3, `1 = 2` as 1 == 2). A group's
# `1++` before an item (not a statement) is checked there, which knows the item, ahead of the key's own check
literal_targets(n: Node) := {
	if is_group(n) and separator_of(n) not in statement_separators {
		items = items_of(n)
		for i in 0 ..< #items - 1 { literal_target(items[i], items[i + 1]) }
	}
	literal_target(n, ø)
}
literal_target(n: Node, next: any) := {
	if not (n is key and (op_of(n) in assigning_operators or op_of(n) in counting_operators)) { return ø }
	target = without_mark(key_of(n))
	if not (is_literal(target) or target is codepoint) { return ø }
	value = if target is text or target is codepoint then "\"${target}\"" else "${target}"
	op = op_of(n)
	counting = op in counting_operators
	variable = "x = " + value + ", then x" + (if counting then op else " " + op + " ${value_of(n)}")
	sign = op[0 ..< 1]
	operation = if counting and next != ø then value + " " + sign + " " + sign + "${next}" else if op == "=" then value + " == ${value_of(n)}" else ø
	diagnose(call_of("literal_target", [value, op, if operation then variable + "; or " + operation else variable]), n)
}
# the binding `k = 7` of `let k = 7` declaring a constant, else ø
declared_constant(statement: Node) as any := {
	if not (is_group(statement) and #statement == 2 and statement#1 is symbol and name_of(statement#1) in constant_words) { return ø }
	bound = statement#2
	if bound is key and op_of(bound) == "=" and key_of(bound) is symbol then bound else ø
}
# an error the parser leaves in the tree (a negative index), the program's value
located_error(n: Node) := {
	message = parse_error_message(n)
	if message != ø { diagnose(call_of("parse_error", [message]), n) }
	ø
}

# a node parser.warp wraps in an attribute layer of that mark, holding the written parts and the node it marks
marked_with(n: Node, mark: text) as bool := n is key and key_of(n) == symbol(attribute_word) and value_of(n)#1 == mark
# `.16i`, `2i`: a number glued to an `i` the program never binds means ⅈ, the imaginary unit; the unknown name's error
# stays and gains this hint
imaginary_i(n: Node, program: Node) := {
	if not marked_with(n, GLUED_FACTOR_MARK) { return ø }
	product = value_of(n)#3
	if value_of(product) == symbol(IMAGINARY_LOOKALIKE) and not scope_of(program).has(IMAGINARY_LOOKALIKE) { diagnose(call_of("imaginary_i", [key_of(product)]), n) }
}
IMAGINARY_LOOKALIKE = "i"
# `1 +1`, `x -1`: a sign spaced before but not after starts an item of its own (parser.warp signed_item_at), which
# reads as an operation spaced unevenly: the fix spaces it evenly, `1 + 1`
spaced_sign(n: Node) := {
	if not marked_with(n, SPACED_SIGN_MARK) { return ø }
	written = items_of(value_of(n)#2)
	item = written#2
	diagnose(call_of("spaced_sign", [written#1, item, written#1 + " " + item[0 ..< 1] + " " + item[1 ..]]), n)
}
# `width /height` (decision path-after-operand): a path after an operand, the name one the program binds or reads (a
# variable, a parameter), means a division; `show /tmp` stays the path
division_path(n: Node, program: Node) := {
	if not marked_with(n, PATH_AFTER_OPERAND_MARK) { return ø }
	written = items_of(value_of(n)#2)
	# the path, `"/height" as path`: the name is its spelling after the slash
	name = key_of(written#2)[1 ..]
	if name.all(c => is_name_char(c)) and nodes_in(program).any(part => part == symbol(name)) { diagnose(call_of("division_path", [written#1, name]), n) }
}
# `a *b`: an operator spaced on one side only computes; the fix spaces it evenly, `a * b`
uneven_spacing(n: Node) := {
	if not marked_with(n, UNEVEN_SPACING_MARK) { return ø }
	written = items_of(value_of(n)#2)
	diagnose(call_of("uneven_spacing", [written#1, written#2, written#3 + " " + written#2 + " " + written#4]), n)
}
# `[a + b c]` with b a value: one item `a + [b c]` or two, `[a+b c]`, `[a + b, c]`, is never guessed (decision
# glued-binds-tighter); `[a + f 3]` of a function f calls it
spaced_operand(n: Node, program: Node) := {
	if not marked_with(n, SPACED_OPERAND_MARK) { return ø }
	written = items_of(value_of(n)#2)
	phrase = written#3
	head = phrase.split(" ")#1
	if binds_value(scope_of(program), head) { diagnose(call_of("spaced_operand", [written#1, written#2, head, phrase[head.length ..].trim()]), n) }
}
# `x!` as parser.warp writes it, `unwrap(x)`, and the node it marks
has_mutation_mark(n: Node) as bool := is_round(n) and #n == 2 and n#1 == symbol(unwrap_word)
without_mark(n: Node) as Node := if has_mutation_mark(n) then without_mark(n#2) else if n is key and key_of(n) == symbol(attribute_word) then without_mark(value_of(n)#3) else n

# --- `sleep(1)` needs a unit  ---

bare_sleep(n: Node) := {
	if is_group(n) and #n == 2 and n#1 == symbol(sleep_word) and n#2 is number { diagnose(call_of("bare_sleep", ["${n#2}"]), n#2) }
	ø
}

# --- values a statement drops (wiki/mutable.md) ---

# `uppercase x;` drops the copy; a dropped `error "…"` makes an error value nothing raises (card error-if)
dropped_value(statement: Node, aliases: map) := {
	call = copy_call(statement, aliases)
	if call != ø { diagnose(call_of("dropped_copy", call), statement) }
	for dropped in dropped_errors(statement) { diagnose(call_of("dropped_error", ["\"" + dropped + "\""]), statement) }
	ø
}

# `y = x.upper!` changes x too
assigned_mutation(n: Node, aliases: map) := {
	if not (is_operator(n, "=") or is_operator(n, ":=")) { return ø }
	variable = marked_copy_variable(value_of(n), aliases)
	if variable != ø { diagnose(call_of("assigned_mutation", ["${without_mark(key_of(n))}", variable]), n) }
	ø
}

# [word, variable, marked] of a copy word called on a variable as written: `upper x`, `upper(x)`, `x.upper`,
# `x.upper()`, marked by a `!` on the call or the variable (`x.upper!`, `upper x!`)
copy_word_call(call: Node, aliases: map) as list? := {
	parts = word_and_variable(without_mark(call))
	if #parts != 2 { return ø }
	copy_word_of(callee_of(parts#1), without_mark(parts#2), has_mutation_mark(call) or has_mutation_mark(parts#2), aliases)
}
# [word, variable] of `x.word` and `word x`, else []
word_and_variable(inner: Node) as list := if is_operator(inner, ".") then [value_of(inner), key_of(inner)] else if is_group(inner) and #inner == 2 then items_of(inner) else []
# `upper` of `x.upper()`
callee_of(word: Node) as Node := if is_group(word) and bracket_of(word) == "(" and #word == 1 then word#1 else word
copy_word_of(callee: Node, variable: Node, marked: bool, aliases: map) as list? := {
	if not (callee is symbol) or not (variable is symbol) { return ø }
	called = name_of(callee)
	canonical = if called in aliases then aliases[called] else called
	if canonical in copy_words then [called, name_of(variable), marked] else ø
}
# [word, variable] of an unmarked copy call
copy_call(call: Node, aliases: map) as list? := {
	found = copy_word_call(call, aliases)
	if found == ø { return ø }
	if found#3 then ø else [found#1, found#2]
}
# the variable a marked copy call changes
marked_copy_variable(value: Node, aliases: map) as text? := {
	found = copy_word_call(value, aliases)
	if found == ø { return ø }
	if found#3 then found#2 else ø
}

# the messages of the `error "…"` calls a dropped statement drops: the statement itself, the branches of an if, the
# last statement of a block
dropped_errors(statement: Node) as list := {
	n = without_mark(statement)
	if is_group(n) and #n == 2 and n#1 == symbol(error_word) and separator_of(n) != ";" { return ["" + n#2] }
	if is_operator(n, "then") { return dropped_errors(value_of(n)) }
	if is_operator(n, "else") { return dropped_errors(key_of(n)) + dropped_errors(value_of(n)) }
	if is_group(n) and #n > 0 and (bracket_of(n) == "{" or separator_of(n) in statement_separators) { return dropped_errors(n#(#n)) }
	[]
}

# `7//2`, `x//=3` meant as floor division (decision floor-division): `//` glued after an operand, before one or `=`,
# starts a comment all the same, so the line ends before it; the warning names `/!`. `x = 7 // note` stays quiet
floor_division_comments(source: text) := {
	n = source.length
	line_starts = line_starts_of(source)
	at = 0
	while at < n {
		end = skipped_end(source, at, n)
		if end > at and divides_glued(source, at, end) { floor_division_comment(source, at, end, line_starts) }
		at = if end > at then end else at + 1
	}
}
# a `//` comment from at to end, glued after an operand and followed by one or by `=`
divides_glued(source: text, at: int, end: int) as bool := {
	if at == 0 or end - at < 3 or source[at ..< at + 2] != "//" { return no }
	after = source[at + 2]
	ends_operand(source[at - 1]) and (is_name_char(after) or after == '(' or after == '=')
}
ends_operand(c: text) as bool := is_name_char(c) or c == ')' or c == ']'
# the line as written and as floor division: `x = 7//2` is `x = 7 /! 2`, `x//=3` `x /!= 3`
floor_division_comment(source: text, at: int, end: int, line_starts: list) := {
	line = line_starts.filter(start => start <= at).length
	start = line_starts#line
	before = source[start ..< at].trim()
	comment = source[at + 2 ..< end]
	divided = if comment.starts_with("=") then before + " /!= " + comment[1 ..].trim() else before + " /! " + comment.trim()
	diagnosed_at(call_of("floor_division_comment", [source[start ..< end].trim(), divided]), [line, at - start + 1])
}
