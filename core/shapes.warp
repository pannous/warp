// The tree parser.warp builds and the sugar pass reads: nodes of core/node.warp. A type declaration, an error,
// a template and an empty group have no node warp builds yet (card node-more-cases): each travels as walk.warp's opaque
// view, an attribute layer as its attribute key; view_of gives the view node_view writes (tests/common/twins.rs)
use "words.warp"
use "walk.warp"

def listed(bracket: Bracket, separator: Separator, nodes: list): Node := {
	if #nodes == 0 { return opaque(["list", bracket as text, separator as text]) }
	List(nodes, bracket, separator)
}

// `f(a, b)` as the node (f a b) that calls f
def call_of(nodes: list): Node := listed(Bracket.Round, Separator.None, nodes)

// Words side by side without brackets: `print x`
def spaced(nodes: list): Node := listed(Bracket.None, Separator.Space, nodes)

// The key of an operator given by its spelling: `keyed("+", a, b)` is a+b
def keyed(op: text, left: Node, right: Node): Node := Key(left, op as Op, right)

def opaque(view: list): Node := Key(symbol(opaque_word), Op.Colon, view)
def type_node(name: Node, body: Node): Node := opaque(["type", view_of(name), view_of(body)])
def error_node(message: text): Node := opaque(["error", ["text", message]])
def template_node(holed: text): Node := opaque(["template", holed])
def attributed(name: text, value: Node, node: Node): Node := Key(symbol(attribute_word), Op.Colon, [name, value, node])

// [bracket, separator, items] of a group, an empty one too; ø for any other node
def group_parts(node: Node): list? := match node {
	List(items, bracket, separator): [bracket as text, separator as text, items_of(node)]
	Key(word, Op.Colon, view): { if word == opaque_symbol and kind_of(view) == "list" then [view#2, view#3, []] else ø }
	_: ø
}

// `value |> f(args)` is `f(value, args)`, `value |> f` is `f(value)`; a braceless call is grouped, one argument:
// `square xs |> filter(p)` is `filter((square xs), p)`
// Rust twin: pipes.rs piped
def piped(operand: Node, receiver: Node): Node := {
	parts = group_parts(operand)
	if parts != ø and parts#1 == "" and parts#2 == " " { operand = call_of([operand]) }
	receiver_parts = group_parts(receiver)
	if receiver_parts != ø and receiver_parts#1 == "(" and receiver_parts#2 == "" and #receiver_parts#3 > 0 and receiver_parts#3#1 is symbol {
		items = receiver_parts#3
		return call_of([items#1, operand] + items[1 .. #items])
	}
	call_of([receiver, operand])
}

def is_list_of(node: Node, bracket: text): bool {
	parts = group_parts(node)
	parts != ø and parts#1 == bracket
}

def is_block(node: Node): bool := is_list_of(node, "{")
def is_symbol(node: Node): bool := node is symbol
def is_call_head(node: Node): bool {
	parts = group_parts(node)
	parts != ø and parts#1 == "(" and #parts#3 > 0
}
