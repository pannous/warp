// The parser written in warp (card self-parser, notes/self_hosting.md step 6): a source's tree as nodes
// (core/passes/shapes.warp)
use "lexer.warp"
use "../passes/shapes.warp"
use "../analysis/words.warp"
use "../passes/sugar.warp"
use "foreign_forms.warp"
use "../extension.warp"
use os
use file
use "../passes/library.warp"

// Where the items being read stand: the bracket of their group, whether that group is closed by a bracket or a word
// (`grouped`), whether a Ruby block's `end` closes it (`stops_at_end`), whether an `else` ends it too (`in_branch`) and
// whether a glued operator's operand is read, which a blank ends (`glued`, decision glued-binds-tighter)
class GroupContext { bracket: Bracket = Bracket.None; grouped: bool = no; in_branch: bool = no; stops_at_end: bool = no; glued: bool = no }

// What closes the items of items_until: the end of the source, the closing bracket, a Ruby block's `end`, that or a
// `then` block's `else` (kept for the branch), or, for the rest of an enclosing group or block, whatever closes that one
enum ItemsEnd { Source, Closer, End, EndOrElse, Rest }

class Parser { code: text; n: int; at: int = 0; header: bool = no; iterable: bool = no; indexing: bool = no; indent: int = 0; spaces: bool = no; group: GroupContext; branch_power: int = 0; enum_cases: bool = no; resumes: list; breaks: list; finally_blocks: int = 0; types: list; bangs: list; type_body: bool = no; scans: map = {}; aliases: map; phrases: list = []; closing_ends: map = {}; word_types: list; line_starts: list; shifts: list = [] }
// What stands at the parser's position (card parser-checklist-idioms): its character, the one k further, the one at
// any offset, each a line break past the end; whether the character or a text stands there
def char_here(p: Parser): text := peek(p.code, p.at, p.n)
def char_ahead(p: Parser, k: int): text := peek(p.code, p.at + k, p.n)
def char_at(p: Parser, at: int): text := peek(p.code, at, p.n)
def at_char(p: Parser, c: text): bool := is_at(p.code, p.at, c, p.n)
def at_text(p: Parser, written: text): bool := starts_at(p.code, written, p.at, p.n)
// one character on
def advance(p: Parser) { p.at += 1 }
// the reader's node, read with the holder's field (a Parser flag, a GroupContext's) set to value, as it was after
def with_field(holder: any, field: text, value: any, reader: function): any := {
	outer = holder[field]
	holder[field] = value
	read = reader()
	holder[field] = outer
	read
}

// The view of a source's tree, as the pipeline hands it on
def tree(source: text): View := view_of(parsed(source))

// The tree of a source: one statement as itself, several as a list
def parsed(source: text, uses: text = ""): Node := {
	try {
		written_tree(source, uses)
	} catch failure {
		error_node(failure.message)
	}
}

// The words that take a block last, as `if` does (user 2026-10-29: derived from the signature): a function whose last
// parameter is `body: block` (`once(body: block)`), a rewrite rule whose pattern ends in a `: block` hole (`rewrite
// whenever $c $body: block`), read off the library index (library.warp library_index_section)
def is_block_head(word: text): bool := library_index_section("block").has(word)
def block_heads_in(files: map): map {
	heads = {}
	for path in files.keys {
		for line in files[path].split("\n") {
			word = block_head_of(line)
			if word != "" { heads[word] = word }
		}
	}
	heads
}
// the word a line declares taking a block last, else ""
def block_head_of(line: text): text {
	if line.starts_with(rewrite_line_start) and line.contains(" => ") {
		pattern = line[rewrite_line_start.length .. line.find(" => ")].trim()
		words = pattern.split(" ")
		return if pattern.ends_with(": block") and words.length > 2 and is_name_start(words#1[0]) then words#1 else ""
	}
	if not (line.contains("body: block) :=") and is_name_start(line[0])) { return "" }
	name = line[0 .. name_end(line, 0, line.length)]
	if line[name.length] == '(' then name else ""
}
// The tree as the source writes it; `uses`, the use lines of the module a slice of it comes from, whose operators
// the slice reads as the module does (compute_toys' `use regex`: `code matches rule#1`)
def written_tree(written: text, uses: text = ""): Node := {
	passed = passed_source(written)
	source = passed#1
	found = gaps(source, source.length)
	word_types = multi_word_types(source)
	statements = source_operator_statements(source)
	p = Parser{code: source, n: source.length, group: GroupContext(), resumes: found.resumes, breaks: found.breaks, types: declared_type_names(source) + word_types.map(type_words => type_words.join("-")), bangs: bang_words(source), scans: extension_scans(source + uses), aliases: by_first_character(aliases_among(statements) + aliases_among(math_operator_statements()), alias => alias.spelling), word_types: word_types, line_starts: line_starts_of(source), shifts: passed#2}
	items_until(p, Bracket.None, ItemsEnd.Source)
}

// The names glued to `!` a source defines as words of their own: `def is!(warp, expected) := …`, `is!(…) := …`;
// any other `!` after a name stays a suffix (`x!`), a macro (`println!(…)`) or `!=` (card parser-reads-2)
def bang_words(source: text): list {
	found = []
	# only a line with `!(` can define one: the prelude's scan, at every start of a stage program, took 60 ms
	for line in source.split("\n") {
		if not line.contains("!(") { continue }
		n = line.length
		at = blanks_end(line, 0, n)
		if starts_at(line, "def ", at, n) { at = blanks_end(line, at + 4, n) }
		end = name_end(line, at, n)
		if end > at and starts_at(line, "!(", end, n) { found += [line[at .. end] + "!"] }
	}
	found
}
// the prelude's bang words, scanned the first time a `name!` needs them: scanning the prelude on every parse made the
// front stage 5× slower (card front-stage-5x-slower)
global prelude_bangs = ø
def prelude_bang_words(): list {
	if prelude_bangs == ø { prelude_bangs = bang_words(prelude_text) }
	prelude_bangs
}

// The width of the bang word at the parser's position (`is!`), else 0
def bang_word_at(p: Parser): int {
	end = name_end(p.code, p.at, p.n)
	if end == p.at or char_at(p, end) != '!' or char_at(p, end + 1) == '=' { return 0 }
	word = p.code[p.at .. end] + "!"
	if p.bangs contains word or prelude_bang_words() contains word then end + 1 - p.at else 0
}

// `{if: 4, from: 1 to: 2}`: a keyword or operator word glued to a key's colon names the key; `else:`, `then:` and
// `do:` open blocks
BLOCK_COLON_WORDS = ["then", "else", "do"]
def word_names_key(p: Parser, word: text): bool {
	after = p.at + word.length
	count(word) > 0 and not BLOCK_COLON_WORDS.contains(word) and char_at(p, after) == ':' and char_at(p, after + 1) != ':' and char_at(p, after + 1) != '='
}

// The blank-separated words of the statement at the parser's position
def statement_words_at(p: Parser): list := blank_words(p.code[p.at .. statement_end(p)])
// Where the statement at the parser's position ends: at its line's end or `;`
def statement_end(p: Parser): int {
	end = p.at
	while end < p.n and p.code[end] != '\n' and p.code[end] != ';' { end += 1 }
	end
}
// (infix|prefix|suffix|postfix|circumfix)? operator $op := body
// One operator statement as written (decision one-operator-reader): `operator × := *`, `prefix operator √ := sqrt`,
// `infix operator ⊕(a, b) := a + 2*b`, `circumfix operator ⌊ ⌋ := floor` and the pattern `a ⊕ b := a * b`. `keyword`:
// the word `operator` stands in it (no for `prefix ∆ := …` and the pattern), `head` the words up to `:=`, `body` those
// after it; `spelling` the operator the statement defines ("" when none: a built-in word, an overload)
class OperatorStatement { fixity: Fixity; keyword: bool; spelling: text; head: list; body: list }
def operator_statement(words: list): OperatorStatement? {
	position = words.index_of(":=")
	if position < 2 { return ø }
	// the offset of `:=`, where the head ends
	define = position - 1
	if not (words#1 in FIXITY_WORDS) { return operator_pattern(words, define) }
	start = if words#1 != "operator" and define > 1 and words#2 == "operator" then 2 else 1
	keyword = words#start == "operator"
	head = words[start .. define]
	body = words[define + 1 .. words.length]
	fixity = if words#1 == "operator" then given_fixity(head, body) else FIXITY_WORDS[words#1]
	statement = OperatorStatement{fixity: fixity, keyword: keyword, spelling: "", head: head, body: body}
	statement.spelling = defined_spelling(statement)
	statement
}
// `operator` without a fixity word (one of the two words does, card operator-word-optional): the fixity its parameters
// give, `⊕(a, b)` infix and `∆(x)` prefix; else a body saying `it` or naming a function, `operator √ := sqrt`, prefix;
// else infix, `operator × := *`, `operator ≈ := approximately`
def given_fixity(head: list, body: list): Fixity {
	written = head.join(" ")
	if written.contains("(") { return if written.contains(",") then Fixity.Infix else Fixity.Prefix }
	if body.any(says_it) { return Fixity.Prefix }
	if #body == 1 and is_plain_name(body#1) and not is_operator_spelling(body#1) { return Fixity.Prefix }
	Fixity.Infix
}
// whether a word of code holds the name `it` whole, `it*it`, `f(it)`
def says_it(word: text): bool {
	at = 0
	while at + 1 < word.length {
		if word[at .. at + 2] == "it" and (at == 0 or not is_name_char(word[at - 1])) and (at + 2 == word.length or not is_name_char(word[at + 2])) { return true }
		at += 1
	}
	false
}
// `a ⊕ b := …`: an infix operator declared by a pattern of two plain names around its glyph
def operator_pattern(words: list, define: int): OperatorStatement? {
	if define != 3 or not is_operator_glyph(words#2) or not is_plain_name(words#1) or not is_plain_name(words#3) { return ø }
	OperatorStatement{fixity: Fixity.Infix, keyword: no, spelling: words#2, head: words[0 .. 3], body: words[4 .. words.length]}
}
// the operator a statement defines: its one glyph (`operator ⊕ := …`), or a word or glyph with its parameters,
// `infix operator divides(d, n) := …`, `infix operator ↑(x: number, n: number)`, `prefix ∆(x) := …`; a built-in word,
// `infix operator as(n: any, e: enum) := …`, is no new operator but an overload of it (operator_method_definition)
def defined_spelling(statement: OperatorStatement): text {
	if #statement.head == 0 or statement.fixity == Fixity.Circumfix { return "" }
	first = statement.head#1
	if #statement.head == 1 and is_definable_glyph(first) { return first }
	if statement.fixity != Fixity.Infix and not first.contains("(") { return "" }
	named = is_name_start(first#1)
	end = if named then name_end(first, 0, first.length) else 0
	if not named { while end < first.length and first[end] != '(' { end += 1 } }
	word = first[0 .. end]
	operator = (named and word != "operator") or is_definable_glyph(word)
	if operator and (end == first.length or first[end] == '(') and word_operator(word) == ø then word else ""
}
// `operator × := *` (lib/math.warp): another spelling of a built-in operator; `prefix operator √ := sqrt` one of a
// function, `√x` is sqrt(x) (the pre-scan made the spelling an operator: aliases_among)
class OperatorAlias { spelling: text; target: text }
// A prefix alias names a function by the whole word: `prefix operator ∆ := it*it` defines ∆, aliases no `it*it`;
// either word declares one, `prefix √ := sqrt` as `operator √ := sqrt`
def alias_of(statement: OperatorStatement?): OperatorAlias? {
	if statement == ø or #statement.head != 1 or #statement.body != 1 { return ø }
	target = statement.body#1
	prefix = statement.fixity == Fixity.Prefix
	if (statement.fixity == Fixity.Infix or prefix) and (is_operator_spelling(target) or (prefix and is_plain_name(target))) then OperatorAlias{spelling: statement.head#1, target: target} else ø
}
// a statement that only spells: an alias, applied by the pre-scan (a circumfix: extensions/circumfixes.warp)
def only_spells(statement: OperatorStatement?): bool := alias_of(statement) != ø
// The operator a statement declares, as a list of it, else []: its spelling, unless the statement only spells
def operator_declared(statement: OperatorStatement?): list := if statement == ø or statement.spelling == "" or only_spells(statement) then [] else [declared_of(statement.spelling, statement.fixity)]
// An alias spelling a function, `√` of sqrt, no operator
def spells_function(alias: OperatorAlias): bool := is_name_start(alias.target#1) and not is_operator_spelling(alias.target)
// the operator statements among statements, read once
def operator_statements(statements: list): list := statements.filter(statement => statement.contains(":=")).map(statement => operator_statement(blank_words(statement))).filter(statement => statement != ø)
def source_operator_statements(source: text): list := if source.contains(":=") then operator_statements(code_statements(source)) else []
// lib/math.warp's operator statements (its text built in), which every program reads (decision operator-alias), read the first time a
// parse needs them
global math_statements = ø
def math_operator_statements(): list {
	if math_statements == ø { math_statements = operator_statements(code_statements(math_text)) }
	math_statements
}
// the aliases among statements
def aliases_among(statements: list): list := statements.map(alias_of).filter(alias => alias != ø)
// A library's code statements by its name ("math"), split once a compile for every scanner of them: splitting math's
// text for its operators, its aliases and its circumfixes each was a tenth of a small program's compile
global library_code_statements = {}
def code_statements_of(name: text): list {
	if not library_code_statements.has(name) { library_code_statements[name] = code_statements(join(module_sources([name]), "")) }
	library_code_statements[name]
}
// `x ← v` (also `<-`), the plain store: the hidden call store·value(x, v), an assignment no rewrite rule takes for one
// (rewrites.warp stored), so a rule's template writes it without matching itself again; `x = v` once the rules ran
STORE_OPERATOR = "←"
// The canonical names of the alias targets parser.warp's operator lists spell otherwise
ALIAS_TARGET_NAMES = {"approximately": "≈", "<-": STORE_OPERATOR}

// The parser's spellings: its own operators and keyword forms, with lib/aliases.warp's (card alias-mechanism,
// notes/aliases.md: one entry per canonical word, `add { operator: "+", aliases: [plus] }`), made the first time a
// parse asks; reading the table sees the parser's own spellings only. Its rows come from the library index, each
// entry's fields read off once by `warp rebuild` (alias_rows): parsing the table at every run was a sixth of a small
// program's compile (card speed-module-rules)
// operator symbols and words: [spelling, operator] pairs, the symbols longest first; forms: keyword_form's; canonical:
// each alias with its entry's word (`plus` → add); infix words: the table's (`mod`, `upto`)
// powers: each operator's [left, right] binding power, its row's `power` (binding_powers); declared: the operators a
// declaration gives their meaning, `declared: yes` (`2 ↑ 3` is operator_↑(2, 3))
class Spellings { operator_symbols: list; operator_words: list; forms: map; canonical: map; infix_words: list; powers: map; declared: list }
global spelling_tables = ø
def alias_spellings(): Spellings := {
	if spelling_tables == ø {
		spelling_tables = own_spellings()
		spelling_tables = aliased_spellings()
	}
	spelling_tables
}
// lib/aliases.warp's entries, each [word, its fields by name]
def alias_rows(): list := {
	entries = library_index_section("alias")
	entries.keys.map(word => [word, alias_fields_read(entries[word])])
}
// a table's entries as alias_rows gives them, read off its parse (an extension's rows, the index's scan)
def table_rows(table: Node): list := statements_in(table).map(row => [spelling_text(row#1), alias_fields(row#2)])
// an entry's fields by name, `{ operator: "+", aliases: [plus] }` {operator: "+", aliases: ["plus"]}
def alias_fields(fields: Node): map {
	found = {}
	for field in items_of(fields) { found["${name_of(key_of(field))}"] = spelling_text(value_of(field)) }
	found
}
// an entry's fields as the index holds them, `operator:+ aliases:[plus,minus]`, and back; a field
// spelling a blank or comma would be cut, so the index refuses it
def alias_fields_written(word: text, fields: map): text := fields.keys.map(name => name + ":" + alias_value_written(word, fields[name])).join(" ")
def alias_value_written(word: text, value: any): text {
	written = if value is list then "[" + value.join(",") + "]" else "${value}"
	inner = if value is list then value.join("") else written
	if inner.contains(" ") or inner.contains(",") { raise "lib/aliases.warp: the entry " + word + " spells " + written + ", with a blank or comma the library index can't hold" }
	written
}
def alias_fields_read(written: text): map {
	fields = {}
	for pair in written.split(" ").filter(pair => pair) {
		name = pair.split(":")#1
		value = pair[#name + 1 ..]
		fields[name] = if value.starts_with("[") then value[1 ..< #value - 1].split(",").filter(item => item) else value
	}
	fields
}
def own_spellings(): Spellings := {
	symbols = pairs_of(SYMBOL_OPERATORS)
	Spellings{operator_symbols: symbols, operator_words: pairs_of(WORD_OPERATORS), forms: copied(KEYWORD_FORMS), canonical: {}, infix_words: [], powers: copied(STRUCTURE_POWERS), declared: []}
}
def aliased_spellings(): Spellings := {
	tables = own_spellings()
	for row in alias_rows() + extension_operator_rows().flat_map(rows => table_rows(source_parse(rows))) { add_alias_entry(tables, row#1, row#2) }
	tables.operator_symbols = longest_first(tables.operator_symbols)
	tables
}
// The spellings an entry gives: a symbol alias spells the entry's operator (its `operator`, else the entry itself), a
// word alias its word (also a keyword form when the word is one); `infix: yes` makes the word and its word aliases
// infix, `infix: [plus]` only the words listed: `1 plus 2` adds while `print add(1, 2)` stays a call
def add_alias_entry(tables: Spellings, word: text, fields: map) {
	target = fields.get("operator") ?? word
	infix = fields.get("infix") ?? "no"
	if infix == "yes" { add_infix_word(tables, word, target) }
	if fields.get("declared") == "yes" { tables.declared += [target] }
	power = if fields.has("power") then fields["power"].map(level => int(level)) else ø
	if power != ø {
		tables.powers[target] = power
		# an operator row named by its symbol spells it (an extension's `"±" { power: … }`)
		if not is_name_start(word#1) and spelled_by(tables.operator_symbols, word) == ø { tables.operator_symbols += [[word, target]] }
	}
	for spelling in fields.get("aliases") ?? [] {
		tables.canonical[spelling] = word
		if not is_name_start(spelling#1) { tables.operator_symbols += [[spelling, target]] }
		else if spelled_infix(infix, spelling) { add_infix_word(tables, spelling, target) }
		if word in tables.forms { tables.forms[spelling] = tables.forms[word] }
	}
}
def spelled_infix(infix: any, spelling: text): bool := if infix is list then infix.contains(spelling) else infix == "yes"
def add_infix_word(tables: Spellings, word: text, target: text) {
	tables.operator_words += [[word, target]]
	tables.infix_words += [word]
}
// A spelling as text, each of a list's
def spelling_text(n: Node): any := match n {
	Char(c): "${c}"
	Text(t): t
	Symbol(name): name
	True: "yes"
	List(items, bracket, separator): items.map(item => spelling_text(item))
	_: "${n}"
}
def symbol_operators(): list := alias_spellings().operator_symbols
def word_operators(): list := alias_spellings().operator_words
def keyword_forms(): map := alias_spellings().forms
// The canonical word an alias spells (`plus` gives add), else ø
def canonical_word(spelling: text): text? := alias_spellings().canonical.get(spelling)
// The operator a symbol or word spells (`≤` gives <=, `mod` %), else ø
def symbol_operator(written: text): text? := spelled_by(symbol_operators(), written)
def word_operator(written: text): text? := spelled_by(word_operators(), written)
def spelled_by(pairs: list, written: text): text? {
	for pair in pairs { if pair#1 == written { return pair#2 } }
	ø
}
def pairs_of(table: map): list {
	pairs = []
	for key, value in table { pairs += [[key, value]] }
	pairs
}
def copied(table: map): map {
	copy = {}
	for key, value in table { copy[key] = value }
	copy
}
// [spelling, …] pairs ordered longest first, so the first spelling written at a position is the longest
def longest_first(pairs: list): list {
	width = 0
	for pair in pairs { if pair#1.length > width { width = pair#1.length } }
	ordered = []
	while width > 0 {
		ordered += pairs.filter(pair => pair#1.length == width)
		width -= 1
	}
	ordered
}
// The canonical name of the operator an alias spells, else ""
def canonical_operator(target: text): text := symbol_operator(target) ?? word_operator(target) ?? ALIAS_TARGET_NAMES.get(target) ?? ""
// The alias written at the parser's position, a word one as a whole word, the longest, else ø
def alias_at(p: Parser): OperatorAlias? := longest_spelled_at(p, starting_here(p.aliases, p, p.at), alias => alias.spelling)
// Spellings (or entries, each spelled as `spelling` gives) by the character each starts with, in their order: a position tries only those
// that can be written there (trying every alias at every token was 55% of a parse, card compiler-parse-timing)
def by_first_character(entries: list, spelling: function): map {
	starting = {}
	for entry in entries {
		first = "$(spelling(entry)[0])"
		starting[first] = (starting.get(first) ?? []) + [entry]
	}
	starting
}
// the entries of such an index that start with the character at `at`
def starting_here(index: map, p: Parser, at: int): list := if at >= p.n then [] else index.get("$(p.code[at])") ?? []
def aliases_starting(p: Parser, c: text): list := p.aliases.get("$(c)") ?? []
// Of `candidates`, each spelled as `spelling` gives, the one written at the parser's position with the longest spelling,
// a word one as a whole word, else ø
def longest_spelled_at(p: Parser, candidates: list, spelling: function): any {
	longest = ø
	longest_length = 0
	for candidate in candidates {
		spelled = spelling(candidate)
		here = at_text(p, spelled) and not (is_name_start(spelled#1) and is_at_name_char(p, p.at + spelled.length))
		if here and (longest == ø or spelled.length > longest_length) {
			longest = candidate
			longest_length = spelled.length
		}
	}
	longest
}
// The infix operator an alias at the parser's position spells, as [written, canonical], else []; a word alias with a
// block after it stays a name: `div {…}` is the html tag, `7 div 2` the floor division
def aliased_operator_at(p: Parser): list {
	alias = alias_at(p)
	canonical = if alias == ø then "" else canonical_operator(alias.target)
	if count(canonical) == 0 or (is_name_start(alias.spelling#1) and opens_block(p, alias.spelling.length)) then [] else [alias.spelling, canonical]
}
// A spelling of a built-in operator: symbols (`*`, `/!=`, `->`), or an operator word (`and`, `in`, `contains`)
def is_operator_spelling(word: text): bool {
	if not is_name_start(word#1) or word_operator(word) != ø { return true }
	keyword_form(word) == "contains" or word == "in" or word == "approximately"
}
// The statement at the parser's position skipped: ø
def skip_statement(p: Parser): Node := {
	p.at = statement_end(p)
	ø
}

// The words a type's name follows where it is declared
TYPE_SCAN_WORDS = ["class", "struct", "record", "type"]

// The type names a source declares: the word after class, struct, record or type within a line, outside comments
// and texts, with nothing or a bracket, `:` or `;` glued after it (`record = find(…)` declares nothing)
def declared_type_names(source: text): list {
	type_names = []
	for line in code_only(source).split("\n") {
		previous = ""
		for word_written in line.replace("\t", " ").split(" ") {
			if count(word_written) == 0 { continue }
			if TYPE_SCAN_WORDS.contains(previous) {
				end = symbol_end(word_written, 0, word_written.length)
				if end > 0 and (end == word_written.length or "({<[:;".contains(word_written[end])) { type_names += [word_written[0 .. end]] }
			}
			previous = word_written
		}
	}
	type_names
}

// The words naming a body before it, `class full name extends person {`: no word of the type's name
WORDS_BEFORE_TYPE_BODY = ["extends", "with", "implements", "interface", "gc", "struct"]

// The type names of several words a source declares, by their words: `class full name {…}` declares `full name`,
// written `full-name`; only on one line, up to the body's `{` (glued to the last word or the body too)
def multi_word_types(source: text): list {
	found = []
	for line in code_only(source).split("\n") {
		name = []
		naming = false
		for word in line.replace("\t", " ").split(" ") {
			if word == "" { continue }
			if naming {
				before_body = word.split("{")#1
				name_word = is_plain_name(before_body) and not WORDS_BEFORE_TYPE_BODY.contains(before_body)
				if word.contains("{") {
					if name_word { name += [before_body] }
					if name.length > 1 { found += [name] }
					naming = false
				} else if name_word {
					name += [word]
				} else {
					naming = false
				}
			}
			if not naming and TYPE_SCAN_WORDS.contains(word) {
				name = []
				naming = true
			}
		}
	}
	found
}

// Words naming one built-in type: warp's `x: fast int` is i64, `fast float` f64; C's names of several words the fixed
// width they mean there, `unsigned int` uint32; `byte index`, `byte position`, `byte offset`
// the count types of bytes (decision index-units, index_positions.warp). The longest first.
COMPOUND_TYPES = [[["unsigned", "long", "long"], "uint64"], [["long", "long", "int"], "int64"], [["unsigned", "long"], "uint64"], [["long", "long"], "int64"], [["long", "int"], "int64"], [["unsigned", "int"], "uint32"], [["signed", "int"], "int32"], [["unsigned", "short"], "uint16"], [["short", "int"], "int16"], [["unsigned", "char"], "byte"], [["signed", "char"], "int8"], [["fast", "int"], "i64"], [["fast", "float"], "f64"], [["byte", "index"], "byte index"], [["byte", "position"], "byte position"], [["byte", "offset"], "byte offset"]]

// `full name` of a declared `class full name {…}` is the one name `full-name`, `unsigned int` uint32, any other word
// itself: [the name, the end of its words] for the word ending at `end`
def joined_type_name(p: Parser, word: text, word_end: int): list {
	for compound in COMPOUND_TYPES {
		compound_end = if compound#1#1 == word then words_ahead_end(p, compound#1, word_end) else 0
		if compound_end > 0 { return [compound#2, compound_end] }
	}
	joined = [word, word_end]
	joined_words = 1
	for type_words in p.word_types {
		type_end = if type_words#1 == word and type_words.length > joined_words then words_ahead_end(p, type_words, word_end) else 0
		if type_end > 0 {
			joined = [type_words.join("-"), type_end]
			joined_words = type_words.length
		}
	}
	joined
}

// The end of the blanks and whole words after the first of `words` from `at` on: ` name` of `full name`, else 0
def words_ahead_end(p: Parser, words: list, first_end: int): int {
	end = first_end
	for word in words[1 .. words.length] {
		start = spaces_end(p, end)
		if start == end or not starts_at(p.code, word, start, p.n) { return 0 }
		end = start + word.length
		following = char_at(p, end)
		if is_name_char(following) or following == '-' { return 0 }
	}
	end
}

// The keyword forms: each word with a form of its own and the form's shape, a constant word's the constant (any case: `True`, `NULL`); their aliases come from
// lib/aliases.warp (spellings)
KEYWORD_FORMS = {"return": "return", "if": "condition", "while": "condition", "unless": "condition", "until": "condition", "for": "loop", "loop": "endless",
	"class": "type", "struct": "type", "type": "type", "global": "global", "export": "global", "not": "not",
	"else if": "else if", "where": "clause", "match": "clause", "switch": "clause",
	"contains": "contains", "function": "reference", "func": "reference", "yes": "true", "no": "false", "ø": "empty", "empty": "empty"}

// The shape of the keyword form `word` opens, else ""
def keyword_form(word: text): text := if word in keyword_forms() then keyword_forms()[word] else ""

// The name at the parser's position, "" before anything else
def word_at(p: Parser): text := p.code[p.at .. name_end(p.code, p.at, p.n)]

// The items of a group in `bracket` up to what `ends` them, grouped by their separators; outside brackets the lines
// indented below an item are its body (`repeat⏎⇥x` is `repeat: x`) and a line indented less ends the items
def items_until(p: Parser, bracket: Bracket, ends: ItemsEnd): Node := {
	found = []
	// where the item before started, for the mark of a signed item after it (spaced_sign_marked)
	previous_start = p.at
	opener = p.at - 1
	outer = p.group
	closer = closer_of(bracket, ends)
	rest = ends == ItemsEnd.Rest
	enclosed = ends != ItemsEnd.Source and not rest
	// the rest of the enclosing group or block stops where that one stops
	if not rest { p.group = GroupContext{bracket: bracket, grouped: outer.grouped or enclosed, in_branch: ends == ItemsEnd.EndOrElse, stops_at_end: ends == ItemsEnd.End or ends == ItemsEnd.EndOrElse} }
	while true {
		skip_blanks(p)
		if closes_block(p) {
			if keyword_at(p, "end") and not rest { p.at += 3 }
			break
		}
		if p.at >= p.n {
			if enclosed { raise "`" + closer + "` is missing: the group opened at " + line_and_column(p.code, opener) + " runs to the end of the input" }
			break
		}
		c = p.code[p.at]
		if c == closer {
			advance(p)
			break
		}
		stray = c == ')' or c == ']' or c == '}'
		if stray and enclosed { raise "`" + c + "` closes the group opened at " + line_and_column(p.code, opener) + ", which needs `" + closer + "`" }
		// the lines indented inside a group end at its closer: `{ for x in xs:⏎    a }`
		if stray and p.group.grouped { break }
		if stray { raise "`" + c + "` closes no group" }
		before = p.at
		spaced = found and found#(found.length)#2 == Separator.Space
		signed = spaced and signed_item_at(p)
		pathed = spaced and at_char(p, '/') and starts_path(p)
		item = if follows_clause_word(found) then header_expression(p, 0) else if heads_block(p, found) then head_item(p) else expression(p, 0)
		if signed { item = spaced_sign_marked(p, p.code[previous_start ..< before].trim(), before, item) }
		if pathed { item = attributed(PATH_AFTER_OPERAND_MARK, listed(Bracket.Square, Separator.Space, [p.code[previous_start ..< before].trim(), item]), item) }
		previous_start = before
		// `def f(x)` ending its line: its body the lines below, indented or a `{…}` opening the next line (Allman), as
		// `if c` reads its own (card def-body-next-line); without one the header stays as it is
		if found and found#(found.length)#2 == Separator.Space and found#(found.length)#1 is symbol and name_of(found#(found.length)#1) in function_keywords and code_after(p, p.at) == '\n' {
			body = indented_block(p)
			if body != ø { item = call_of([item, body]) }  // as name_or_call glues a same-line `{…}`
		}
		tabbed = tab_separates(p)
		newline = skip_blanks(p)
		if bracket == Bracket.None and newline and line_indent(p) > p.indent {
			body = lines_below(p)
			skip_end_line(p)
			lines = group_parts(body)
			item = Key(item, Op.Colon, if lines != ø and lines#1 == "" and lines#2 == "\n" then listed(Bracket.Curly, Separator.Newline, lines#3) else body)
			newline = skip_blanks(p)
		}
		dedent = bracket == Bracket.None and newline and line_indent(p) < p.indent
		after = if dedent then Separator.None else separator(p, closer, newline)
		if tabbed and after == Separator.Space { after = Separator.Tab }
		// `ys = xs.map { |x| x+1 }`, `n = t.split " "`: what follows an assigned method belongs to its call, not to the
		// statement
		// `xs.map { |x| x + 1 }`: a block of a lambda between bars after a method is its last argument, xs.map(x => x + 1)
		if found and found#(found.length)#2 == Separator.Space and names_method(found#(found.length)#1) and bar_lambda(item) != ø {
			item = method_given(found#(found.length)#1, bar_lambda(item))
			found = found[0 .. found.length - 1]
		} else if found and found#(found.length)#2 == Separator.Space and assigned_method_call(found#(found.length)#1) {
			item = with_trailing_item(found#(found.length)#1, item)
			found = found[0 .. found.length - 1]
		}
		found += [[statement, after] for statement in statements_of(item)]
		if dedent { break }
		if p.at == before { advance(p) }
	}
	p.group = outer
	grouped(found, bracket)
}

// `ys = xs.map`, `f(xs) := xs.map`, `n = t.replace "a"`: an assignment of a method, which a block or value after it is
// given to
def assigned_method_call(n: Node): bool := match n {
	Key(target, op, value): ["=", ":=", "->"].contains(op as text) and (method_phrase(value) or assigned_method_call(value))
	_: false
}
// `t.split`, `t.replace "a"`: a method, alone or with values after it already
def method_phrase(n: Node): bool {
	parts = group_parts(n)
	names_method(n) or (parts != ø and parts#1 == "" and parts#2 == " " and #parts#3 > 0 and names_method(parts#3#1))
}

def names_method(n: Node): bool := match n {
	Key(receiver, Op.Dot, method): method is symbol
	_: false
}

// The assignment with `item` given to the method call it assigns: `ys = (xs.map {…})`, `n = (t.split " ")`
def with_trailing_item(assignment: Node, item: Node): Node := match assignment {
	Key(target, op, value): Key(target, op, if assigned_method_call(value) then with_trailing_item(value, item) else if names_method(value) and bar_lambda(item) != ø then method_given(value, bar_lambda(item)) else spaced((if names_method(value) then [value] else group_parts(value)#3) + [item]))
	_: assignment
}
// `{ |x| x + 1 }`, `{ |a, b| a + b }`: the one lambda a block holds, its parameters between bars (extensions/pipe_lambdas.warp); else ø
def bar_lambda(block: Node): any {
	parts = group_parts(block)
	if parts == ø or not is_block(block) or #parts#3 != 1 { return ø }
	match parts#3#1 {
		Key(parameters, Op.Arrow, body): parts#3#1
		_: ø
	}
}
// `xs.map` given the function f: the call xs.map(f)
def method_given(method: Node, f: Node): Node := match method {
	Key(receiver, Op.Dot, name): Key(receiver, Op.Dot, call_of([name, f]))
	_: method
}

// `match f(x) {…}`: the subject after a clause word ends before the block, no call `f(x) {…}` takes it
// `whenever x > y {…}`, `on change x: n += 1`: the words after a block head (is_block_head) starting the statement are
// its head, as `if`'s condition is, up to its body, `{…}` or `: …` (a block); not the body once it was read
def heads_block(p: Parser, found: list): bool {
	if found.length == 0 or is_block(found#(found.length)#1) or found#(found.length)#2 != Separator.Space { return false }
	first = found.length
	while first > 1 and found#(first - 1)#2 == Separator.Space { first -= 1 }
	found#first#1 is symbol and is_block_head(name_of(found#first#1)) and body_follows(p)
}
// whether the statement goes on to a body, `{` or `:` outside brackets and texts before its end: without one a block
// head is an ordinary call, the program's own `twice square 3` of a twice(f, x) beside the prelude's twice(body: block)
def body_follows(p: Parser): bool {
	depth = 0
	at = p.at
	while at < p.n {
		c = p.code[at]
		if c == '"' or c == '\'' {
			at += 1
			while at < p.n and p.code[at] != c { at += 1 }
		} else if depth == 0 and (c == '{' or c == ':') {
			return true
		} else if c == '(' or c == '[' {
			depth += 1
		} else if c == ')' or c == ']' {
			if depth == 0 { return false }
			depth -= 1
		} else if depth == 0 and (c == '\n' or c == ';' or c == '}') {
			return false
		}
		at += 1
	}
	false
}
def head_item(p: Parser): Node := if body_word_width(p) == 1 then listed(Bracket.Curly, Separator.Semicolon, [colon_body(p, 1)]) else header_expression(p, CONDITION_POWER)
// `alarm = whenever t > 30 {…}`, `h = on change x: n += 1`: an assigned block head with its body takes its whole head
// up to the body, as the statement it would start does (decision prefix-keyword-condition)
def block_head_at(p: Parser): bool := is_block_head(p.code[p.at .. name_end(p.code, p.at, p.n)]) and body_follows(p)
def headed_phrase(p: Parser): Node := {
	words = [prefixed(p)]
	while not is_block(words#(words.length)) {
		skip_spaces(p)
		if ends_branch(p) or not (starts_atom(p) or body_word_width(p) == 1) { break }
		words += [head_item(p)]
	}
	spaced(words)
}
// `on every day at 9:30 {…}`: in a block head, where a colon ends the head, a time glued as digits:digits stays one
// value (decision prefix-keyword-condition) where the block follows it; `if 2:3` keeps its colon body
def glued_time_at(p: Parser, left: Node): bool := p.header and left is int and p.at > 0 and is_digit(p.code[p.at - 1]) and is_digit(char_ahead(p, 1)) and block_after_digits(p, p.at + 1)
def block_after_digits(p: Parser, at: int): bool := {
	while at < p.n and is_digit(p.code[at]) { at += 1 }
	char_at(p, blank_end(p, at)) == '{'
}
def follows_clause_word(found: list): bool := found.length > 0 and ends_with_clause_word(found#(found.length)#1)

// `where`, `match`, alone or the last word of `for i in xs where`: a word whose condition or subject follows
def ends_with_clause_word(node: Node): bool := match node {
	Symbol(word): keyword_form(word) == "clause"
	List(parts, Bracket.None, separator): parts.length > 0 and ends_with_clause_word(parts#(parts.length))
	_: false
}

// `line:column` of the character at `at`, both from 1
def line_and_column(code: text, at: int): text {
	line = 1
	start = 0
	for i in 0 ..< at {
		if code[i] == '\n' {
			line += 1
			start = i + 1
		}
	}
	"$(line):$(at - start + 1)"
}

// The indent of the parser's position on its line: its tabs, its spaces too inside a block indented by spaces
def line_indent(p: Parser): int {
	at = p.at
	indent = 0
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') {
		at -= 1
		if p.code[at] == '\t' or p.spaces { indent += 1 }
	}
	indent
}

// The items of the lines indented below, the parser at the line they end before
def lines_below(p: Parser): Node := {
	block = with_field(p, "indent", line_indent(p), () => items_until(p, Bracket.None, ItemsEnd.Source))
	// the line break after the block still separates the next statement
	while p.at > 0 and is_blank(p.code[p.at - 1]) { p.at -= 1 }
	block
}

// The block indented below a head that ends its line, `for x in xs:` and its lines; ø with nothing read if none
def indented_block(p: Parser): Node := {
	before = p.at
	outer_spaces = p.spaces
	newline = skip_blanks(p)
	p.spaces = outer_spaces or p.code[p.at - line_blanks(p) .. p.at].contains(" ")
	// Allman style: the header's `{…}` block opening the next line at its indent, `if c` / `{ … }`, `def f(x)` / `{ … }`
	if newline and line_indent(p) == p.indent and at_char(p, '{') {
		p.spaces = outer_spaces
		return atom(p)
	}
	if not newline or line_indent(p) <= p.indent {
		p.spaces = outer_spaces
		p.at = before
		return ø
	}
	block = lines_below(p)
	p.spaces = outer_spaces
	skip_end_line(p)
	lines = group_parts(block)
	if lines != ø and lines#1 == "" { return listed(Bracket.Curly, lines#2 as Separator, lines#3) }
	// one statement, as `{ statement }` reads it
	phrase(Bracket.Curly, [block])
}

// The words that may stand alone on the line after a block read by indentation: Ruby's `end`, the shell's `fi`
INDENTED_BLOCK_ENDS = ["end", "fi"]
// One of INDENTED_BLOCK_ENDS alone on the line after a block read by indentation, at the head's indent, read; the
// line break before the next statement stays
def skip_end_line(p: Parser) {
	before = p.at
	newline = skip_blanks(p)
	for closer in INDENTED_BLOCK_ENDS {
		if newline and keyword_at(p, closer) and line_indent(p) == p.indent and line_ends_after(p, p.at + closer.length) {
			p.at += closer.length
			return
		}
	}
	p.at = before
}

def line_blanks(p: Parser): int {
	at = p.at
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') { at -= 1 }
	p.at - at
}

// Only blanks follow `at` on its line
def ends_line(p: Parser, at: int): bool := line_ends_after(p, at)

// The body after `:` or `do`: the block indented below when the line ends, else the rest of the line
def colon_body(p: Parser, width: int): Node := {
	p.at += width
	if only_blanks_before_newline(p) {
		block = indented_block(p)
		if block != ø { return block }
	}
	skip_spaces(p)
	statement_words(p)
}

// The separator after an item, consumed: a comma, a semicolon, a newline, a blank, or none before the closer
def separator(p: Parser, closer: text, newline: bool): Separator {
	if p.at >= p.n or p.code[p.at] == closer or closes_block(p) { return Separator.None }
	c = p.code[p.at]
	if c == ',' {
		advance(p)
		return Separator.Comma
	}
	if c == ';' {
		advance(p)
		return if only_blanks_before_newline(p) then Separator.Newline else Separator.Semicolon
	}
	if newline then Separator.Newline else Separator.Space
}

def only_blanks_before_newline(p: Parser): bool := line_ends_after(p, p.at)

// A tab between two items of a line separates columns: `'1+1'⇥2` is a list of two (tab-separated test pairs);
// indentation and a tab before a comment or the line's end separate nothing
def tab_separates(p: Parser): bool {
	start = p.at - line_blanks(p)
	end = blank_end(p, p.at)
	if start == 0 or p.code[start - 1] == '\n' or line_ends_after(p, p.at) { return false }
	p.code[start ..< end].contains('\t')
}

// How loosely a separator groups: a blank tightest, a newline loosest, none (the end) never
def precedence(separator: Separator): int := match separator {
	Separator.Space: 0
	Separator.Comma: 2
	Separator.Semicolon: 3
	Separator.Tab: 4
	Separator.Newline: 5
	_: NEVER_SPLITS
}
NEVER_SPLITS = 255

// [[item, separator], …] as one list: the loosest separator splits first, the groups between split by the tighter ones
def grouped(pairs: list, bracket: Bracket): Node := {
	if pairs.length == 0 { return if bracket == Bracket.Curly or bracket == Bracket.Square then listed(bracket, Separator.None, []) else ø }
	if pairs.length == 1 and bracket == Bracket.None { return pairs#1#1 }
	loosest = -1
	for pair in pairs {
		level = precedence(pair#2)
		if level < NEVER_SPLITS and level > loosest { loosest = level }
	}
	if loosest < 0 { return phrase(bracket, [pair#1 for pair in pairs]) }
	split = Separator.None
	for pair in pairs {
		if split == Separator.None and precedence(pair#2) == loosest { split = pair#2 }
	}
	groups = []
	group = []
	for pair in pairs {
		if precedence(pair#2) == loosest {
			group += [[pair#1, Separator.None]]
			groups += [group]
			group = []
		} else {
			group += [pair]
		}
	}
	if group.length > 0 { groups += [group] }
	nodes = [if group.length == 1 and group#1#2 == Separator.None then group#1#1 else grouped(group, Bracket.None) for group in groups]
	if bracket == Bracket.Curly { nodes = entries_spliced(nodes) }
	if nodes.length == 1 and bracket == Bracket.None { return nodes#1 }
	if split == Separator.Space { return phrase(bracket, nodes) }
	if split == Separator.Comma { return comma_list(bracket, nodes) }
	listed(bracket, split, nodes)
}
// `{ a: 1, b: 2 ⏎ c: 3 }`: commas, semicolons and lines all separate a block's entries, as in JSON5 (wiki/list.md); a
// list's runs stay its rows, `[1, 2 ⏎ 3, 4]`
def entries_spliced(nodes: list): list := if nodes.any(is_entry_run) and nodes.all(n => is_colon_entry(n) or is_entry_run(n)) then nodes.flat_map(run_entries) else nodes
def run_entries(n: Node): list := if is_entry_run(n) then items_of(n).flat_map(run_entries) else [n]
def is_colon_entry(n: Node): bool := is_key(n, Op.Colon)
def is_entry_run(n: Node): bool := is_group(n) and bracket_of(n) == "" and separator_of(n) != " " and #n > 1 and items_of(n).all(item => is_colon_entry(item) or is_entry_run(item))

// Words side by side; `print ord c` and `{ print ord c }` print the rest of the line as one value
def phrase(bracket: Bracket, nodes: list): Node := {
	guarded = if bracket == Bracket.Square then ø else guarded_command(nodes)
	if guarded != ø { return guarded }
	assigned = if bracket == Bracket.Square then ø else of_assignment(nodes)
	if assigned != ø { return if bracket == Bracket.None then assigned else listed(bracket, Separator.Space, [assigned]) }
	if not (bracket == Bracket.None or bracket == Bracket.Curly) or nodes.length < 3 or nodes#1 != PRINT { return listed(bracket, Separator.Space, nodes) }
	listed(bracket, Separator.Space, [nodes#1, spaced(nodes[1:])])
}
PRINT = symbol("print")
OF = symbol("of")

// `of` binds tighter than `=`: `width of canvas = 12` and `square of int = it * it` assign to the phrase, not to its
// last word
def of_assignment(nodes: list): Node? := {
	if nodes.length < 3 or not nodes[0 ..< nodes.length - 1].contains(OF) { return ø }
	match nodes#(nodes.length) {
		Key(target, Op.Assign, value): Key(listed(Bracket.None, Separator.Space, nodes[0 ..< nodes.length - 1] + [target]), Op.Assign, value)
		_: ø
	}
}

// `print a, b` and `{ print i, i*2 }`: the comma binds looser than the space, so [[print a], b] is the call print(a, b)
def comma_list(bracket: Bracket, nodes: list): Node := {
	head = group_parts(nodes#1)
	if not (bracket == Bracket.None or bracket == Bracket.Curly) or not (prints(head) or returns(head)) { return listed(bracket, Separator.Comma, nodes) }
	// `return a, b` so too: [[return a], b] gives back the tuple [a, b] (decision P2, tuple returns)
	call = if returns(head) then spaced([RETURN, listed(Bracket.Square, Separator.Comma, head#3[1:] + nodes[1 ..])]) else call_of([PRINT] + head#3[1:] + nodes[1 ..])
	// a block of this one statement, as any other (card block-comma-list)
	if bracket == Bracket.Curly then listed(Bracket.Curly, Separator.Semicolon, [call]) else call
}
RETURN = symbol("return")
def returns(phrase: list): bool := #phrase > 0 and phrase#1 == "" and phrase#2 == " " and #phrase#3 == 2 and phrase#3#1 == RETURN

// The parts of an unbracketed phrase `print a`
def prints(phrase: list): bool := #phrase > 0 and phrase#1 == "" and phrase#2 == " " and #phrase#3 > 0 and phrase#3#1 == PRINT

// Spaces, tabs, newlines and comments skipped; whether a newline was among them
def skip_blanks(p: Parser): bool {
	newline = line_breaks_after(p, p.at)
	p.at = p.resumes[p.at]
	if char_here(p) == '\\' and line_continuation_length(p) > 0 {
		p.at += line_continuation_length(p)
		return skip_blanks(p)
	}
	newline
}

// A line break lies between `at` and the code after it, or the source ends there
def line_ends_after(p: Parser, at: int): bool := p.resumes[at] >= p.n or line_breaks_after(p, at)
def line_breaks_after(p: Parser, at: int): bool := p.breaks[at] == true

// The character the code goes on with after `at` and its blanks and comments: '\n' where the line ends first
def code_after(p: Parser, at: int): text := if line_ends_after(p, at) then '\n' else p.code[p.resumes[at]]

def skip_spaces(p: Parser) {
	p.at = blank_end(p, p.at)
	continuation = line_continuation_length(p)
	if continuation > 0 {
		p.at += continuation
		skip_spaces(p)
	}
}

// The width of `\` ending its line with the newline, or of a line break and the indentation before what continues the
// line: a method call or `|>` starting the next line (`numbers⏎    .map(square)`), `else` starting it, or the line
// ending in then/else (`if c then⏎ a⏎ else⏎ b`); else 0
def line_continuation_length(p: Parser): int {
	c = char_here(p)
	// `1 + \` at a line's end continues the statement on the next line (was the symbol `\`, the line its own statement)
	if c == '\\' {
		at = p.at + 1
		while at < p.n and (p.code[at] == ' ' or p.code[at] == '\t' or p.code[at] == '\r') { at += 1 }
		if at >= p.n or p.code[at] != '\n' { return 0 }
		while at < p.n and is_blank(p.code[at]) { at += 1 }
		return at - p.at
	}
	if c == '\n' or c == '\r' {
		at = p.at
		while at < p.n and is_blank(p.code[at]) { at += 1 }
		next = char_at(p, at + 1)
		starts_method = char_at(p, at) == '.' and is_name_char(next) and not is_digit(next)
		starts_pipeline = char_at(p, at) == '|' and next == '>'
		ends_in_branch_word = ["then", "else"] contains word_before(p)
		return if starts_method or starts_pipeline or keyword_at_position(p, "else", at) or ends_in_branch_word then at - p.at else 0
	}
	if c != '\\' { return 0 }
	end = spaces_end(p, p.at + 1)
	if char_at(p, end) == '\r' { end += 1 }
	if is_at(p.code, end, '\n', p.n) then end + 1 - p.at else 0
}

// An expression of operators binding at least `min_power` on the left
def expression(p: Parser, min_power: int): Node := continued(p, prefixed(p), min_power)

// The head of `if`, `while` or `for`: a `{` after it opens the body, so `f(x) {` calls f rather than defining it
def header_expression(p: Parser, min_power: int): Node := with_field(p, "header", true, () => expression(p, min_power))

// what stands in `xs[…]`: a slice from the start, `xs[..3]`, else an expression
def index_expression(p: Parser): Node := {
	slice = slice_from_start(p)
	if slice == ø then expression(p, 0) else slice
}

// `left` and the operators after it binding at least `min_power`
def continued(p: Parser, left: Node, min_power: int): Node := {
	// a prefix `if` inside a tighter operand took its own `then` (owns_branches), so its `else` too
	took_own_then = false
	// left is the phrase an implicit application made in the round before
	applied = false
	while true {
		follows_application = applied
		applied = false
		if tab_separates(p) { break }
		skip_spaces(p)
		c = char_here(p)
		// `cd ~/notes`: a path after an operand is the next word, no operator
		if starts_path(p) { return left }
		continued = read_infix(p, left, min_power)
		if continued != ø {
			if continued == OPERAND_ENDS { break }
			left = continued
			continue
		}
		suffixed = read_suffix(p, left, min_power)
		if suffixed != ø {
			left = suffixed
			continue
		}
		test = if left == ø then [] else test_word_at(p, min_power)
		if test.length > 0 {
			p.at = test#1
			left = tested(left, test#2, test#3)
			continue
		}
		if (c == '+' or c == '-') and is_at(p.code, p.at + 1, c, p.n) and SUFFIX_POWER >= min_power {
			op = p.code[p.at .. p.at + 2]
			p.at += 2
			left = keyed(op, left, ø)
		} else if c == '!' and SUFFIX_POWER >= min_power and bang_suffix_at(p) {
			advance(p)
			# `x!!` is `x!`
			if at_char(p, '!') and char_ahead(p, 1) != '=' { advance(p) }
			left = forced(left)
		} else if c == '[' and p.at > 0 and not is_blank(p.code[p.at - 1]) and INDEX_POWER >= min_power {
			advance(p)
			skip_blanks(p)
			index = with_field(p, "indexing", true, () => index_expression(p))
			skip_blanks(p)
			if at_char(p, ']') { advance(p) }
			left = subscript(left, index, written_offset())
		} else if c == '(' and p.at > 0 and not is_blank(p.code[p.at - 1]) and INDEX_POWER >= min_power and is_callee(left) {
			advance(p)
			left = call_of([left] + spread(items_until(p, Bracket.Round, ItemsEnd.Closer)))
		} else if membership_at(p).length > 0 and not counts_units(left) {
			membership = membership_at(p)
			if MEMBERSHIP_POWERS#1 < min_power { break }
			p.at += membership#1.length
			skip_blanks(p)
			left = membership_test(left, membership#2, expression(p, MEMBERSHIP_POWERS#2))
		} else if negated_at(p) {
			// `x is not 4`, `x not in xs`, `a nand b`: `not (x is 4)`, `not (x in xs)`, `not (a and b)`
			written = negated_at(p)
			positive = NEGATED_SPELLINGS[written]
			powers = if positive == "in" then MEMBERSHIP_POWERS else binding_powers(positive)
			if powers#1 < min_power { break }
			p.at += written.length
			skip_blanks(p)
			left = Key(ø, Op.Not, operation(left, positive, expression(p, powers#2)))
		} else if down_to_at(p) > 0 {
			// `10 down to 1` is `reverse(1 to 10)`, which for_loop counts down
			powers = binding_powers("to")
			if powers#1 < min_power { break }
			p.at += down_to_at(p)
			skip_blanks(p)
			left = call_of([symbol("reverse"), Key(expression(p, powers#2), Op.To, left)])
		} else if trailing_guard_at(p) != "" {
			// `a = 2 if c`, `x++ while c`: guards the whole statement (left power 0)
			if min_power > 0 { break }
			word = trailing_guard_at(p)
			p.at += word.length
			skip_blanks(p)
			left = guarded_statement(left, word, condition_expression(p))
		} else {
			op = operator_at(p)
			if op.length == 0 and free_infix_at(p, left) {
				if fixity_level(Fixity.Infix) < min_power { break }
				glyph = "$(c)"
				advance(p)
				skip_blanks(p)
				left = operator_call(glyph, [left, expression(p, fixity_level(Fixity.Infix) + 1)])
				continue
			}
			signed = signed_item_at(p)
			if op.length == 0 or signed {
				if not applies(p, left, min_power) or comprehension_filter_at(p) { break }
				sign_at = p.at
				// `s + f 2 each: 3`: the labelled arguments after the argument are the call's too
				labelled = labelled_argument(p)
				// `ys = xs where it > 2`: after a clause word its whole condition or subject, as a statement's (follows_clause_word)
				given = [if labelled != ø then labelled else if ends_with_clause_word(left) then header_expression(p, 0) else argument(p, not applies_otherwise(p, min_power))]
				if signed and labelled == ø { given = [spaced_sign_marked(p, written_before(p, left, sign_at), sign_at, given#1)] }
				labelled = labelled_argument(p)
				while labelled != ø {
					given = given + [labelled]
					labelled = labelled_argument(p)
				}
				// `x = name of q with a`: the next word after an applied phrase joins it, one flat phrase as the statement is
				left = spaced((if follows_application then items_of(left) else [left]) + given)
				applied = true
				continue
			}
			powers = binding_powers(op#2)
			// one arrow, but `=>` binds as written: its body takes an assignment
			if op#1 == "=>" { powers = binding_powers("=>") }
			if op#1 == ":" and glued_time_at(p, left) {
				advance(p)
				left = Key(left, Op.Colon, prefixed(p))
				continue
			}
			owns = owns_branches(left, op#2, took_own_then)
			if powers#1 < min_power and not owns { break }
			// `match -3 {…}`, `xs where #it > 1`, `where to#i == n`: after a clause word a glued `#` or `-`, or an
			// operator word, starts its subject
			glued_sign = (op#1 == "-" or op#1 == "#") and not is_blank(char_ahead(p, 1))
			if (glued_sign or is_alpha(c)) and ends_with_clause_word(left) { break }
			took_own_then = owns and powers#1 < min_power and op#2 == "then"
			operator_start = p.at
			p.at += op#1.length
			// `f(n):` ending its line: the block indented below is its value
			block = if op#1 == ":" and ends_line(p, p.at) then indented_block(p) else ø
			if block != ø {
				left = Key(left, Op.Colon, block)
				continue
			}
			if op#1 == "." and char_here(p) == "(" { raise dot_call_refused(left) }
			glued = glued_at(p, operator_start, op#1)
			skip_blanks(p)
			if is_phrase_operator(op) {
				left = phrase_operation(left, op#1, expression(p, powers#2))
			} else if alias_spellings().declared contains op#2 {
				left = operator_call(op#2, [left, expression(p, powers#2)])
			} else if op#2 == STORE_OPERATOR {
				left = call_of([symbol(HiddenWord.StoredValue as text), left, expression(p, powers#2)])
			} else if op#2 == "|>" {
				left = piped(left, expression(p, powers#2))
			} else if (op#2 == ".." or op#2 == "to") and (at_text(p, "=>") or ",;)]}".contains(char_here(p)) or (left is symbol and name_of(left).starts_with("$") and keyword_at(p, "for"))) {
				// the match arm `65.. => "senior"`, the rest hole `$xs... => …`, `($as..., $bs...)`: a range without end; also a
				// rule's rest hole before a comprehension's clause, `[$e... for $x in $xs]` (card sugar-comprehensions)
				left = keyed(op#2, left, ø)
			} else {
				right = if END_BLOCK_WORDS contains op#2 then end_block_operand(p, op#2, powers#2) else if (op#2 == "=" or op#2 == ":=") and block_head_at(p) then headed_phrase(p) else right_operand(p, powers#2, glued)
				// `x(p: P) -> int := …`, Swift's and Rust's result arrow, is the typed head `x(p: P): int := …`
				if op#2 == ":=" or op#2 == "=" { left = result_typed(left) }
				operand = left
				left = keyed(bit_operator(op#1, left, right, op#2), left, if op#2 == ":" then with_switch_cases(p, right) else right)
				if spaced_operand_in_list(p, op#1, glued, right) { left = attributed(SPACED_OPERAND_MARK, listed(Bracket.Square, Separator.Space, [written_before(p, operand, operator_start), op#1, written_before(p, right, p.at)]), left) }
				if unevenly_spaced(p, operator_start, op#1) { left = attributed(UNEVEN_SPACING_MARK, listed(Bracket.Square, Separator.Space, [written_before(p, operand, p.at), op#1, written_before(p, operand, operator_start), p.code[operator_start + op#1.length ..< p.at].trim()]), left) }
				// `{f: x => x * 2}`: the field f holds the lambda; `f: (float) -> float` stays a typed name
				if op#1 == "=>" { left = field_holding_lambda(left) }
			}
		}
	}
	left
}

// `3 & 5`, `a & 1`: a single `&` between operands that may be whole numbers combines their bits, between others it is
// and (`yes & no`, `a > 1 & b`); `|` is never the logical or (decision bar-never-or): bits of numbers, a pipe into a
// function (`xs | sort`), a union of types (`int | text`), as the rules after the parse tell; else `spelled`
// `x(p: P) -> int` before `:=` or `=`, a call's result arrow, as the typed head `x(p: P): int`; any other target as it is
def result_typed(target: Node): Node := match target {
	Key(head, Op.Arrow, result): { if calls_by_name(head) then Key(head, Op.Colon, result) else target }
	_: target
}
def calls_by_name(n: Node): bool := match n {
	List(parts, Bracket.Round, separator): #parts > 0 and parts#1 is symbol
	_: no
}

def bit_operator(written: text, left: Node, right: Node, spelled: text): text {
	if written == "|" or (written == "&" and may_be_whole_number(left) and may_be_whole_number(right)) then written else spelled
}

// A number, a name or an operation that may give a whole number: no float, text, list, type word, capitalized name,
// comparison or logical operation; `a xor b` of whole numbers is their bits' xor, `(e xor m) & g` bits again
def may_be_whole_number(n: Node): bool := match n {
	Symbol(name): not is_type_word(name) and not is_capitalized(name)
	Key(left, op, right): if op == Op.Xor then may_be_whole_number(left) and may_be_whole_number(right) else not (NOT_WHOLE_OPERATORS contains op)
	List(items, bracket, separator): bracket != Bracket.Square and (count(items) == 0 or may_be_whole_number(items#1))
	_: n is int and not (n is bool)
}
NOT_WHOLE_OPERATORS = [Op.Eq, Op.Is, Op.Ne, Op.Identical, Op.NotIdentical, Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.And, Op.Or, Op.Not]

// Ruby/Lua `do … end`, `then … else … end`: the words whose body an `end` may close, and those that open such a body
END_BLOCK_WORDS = ["do", "then", "else"]
END_BLOCK_OPENERS = ["do", "then"]

// The `end` keywords and openers of a source in order, as running balances: an opener adds one, an `end` takes one
// away. A body opened before a word closes when the balance later falls below the one before that word, so the lowest
// balance from each word on answers every search with one lookup (parsing stays linear, test_parse_long_definitions)
class ClosingEnds { word_starts: list; balances: list; lowest_from: list }

def closing_ends_of(code: text, n: int, openers: list): ClosingEnds := {
	word_starts = []
	balances = []
	balance = 0
	names_end = false
	at = 0
	while at < n {
		skipped = skipped_end(code, at, n)
		if skipped > at {
			at = skipped
		} else if is_name_start(code[at]) {
			end = name_end(code, at, n)
			word = code[at .. end]
			// `items.end` is a member, no keyword
			member = at > 0 and code[at - 1] == '.'
			names_end = names_end or (word == "end" and names_word(code, at, end, n))
			step = if member then 0 else if word == "end" then -1 else if openers contains word then 1 else 0
			if step != 0 {
				balance += step
				word_starts += [at]
				balances += [balance]
			}
			at = end
		} else {
			at += 1
		}
	}
	// a program naming a variable `end` closes no block with it: `if a == 0 then 1 else end` hands back the variable
	if names_end { return ClosingEnds{word_starts: [], balances: [], lowest_from: []} }
	lowest_from = [balance for balance in balances]
	index = lowest_from.length - 1
	while index > 0 {
		lowest_from[index - 1] = min(lowest_from[index - 1], lowest_from[index])
		index -= 1
	}
	ClosingEnds{word_starts: word_starts, balances: balances, lowest_from: lowest_from}
}

// Whether the word from `start` to `end` is used as a name: an assigned variable (`end = 3`), a key or field
// (`{block: 2, end: 11}`, `end: int`) or a parameter or argument between separators (`f(a, end)`; `foo(if c then 1
// else 2 end)` closes a block)
def names_word(code: text, start: int, end: int, n: int): bool {
	before = start - 1
	while before >= 0 and is_blank(code[before]) { before -= 1 }
	after = end
	while after < n and is_blank(code[after]) { after += 1 }
	following = peek(code, after, n)
	assigned = following == '=' and peek(code, after + 1, n) != '='
	keyed = following == ':'
	listed = before >= 0 and "(,".contains(code[before]) and ",)".contains(following)
	assigned or keyed or listed
}

// Whether an `end` after the parser's position closes the body opened here: the openers between count, each closed by
// an `end` of its own; an `end` that closes nothing leaves the one-statement body
def closing_end_follows(p: Parser, openers: list): bool {
	key = openers.join(" ")
	if not (key in p.closing_ends) { p.closing_ends[key] = closing_ends_of(p.code, p.n, openers) }
	ends = p.closing_ends[key]
	// the first word from the parser's position on, by bisection
	first = 0
	last = ends.word_starts.length
	while first < last {
		middle = (first + last) ÷ 2
		if ends.word_starts[middle] < p.at { first = middle + 1 } else { last = middle }
	}
	before = if first == 0 then 0 else ends.balances[first - 1]
	first < ends.lowest_from.length and ends.lowest_from[first] < before
}

// The operand after `do`, `then` or `else`: the statements up to its closing `end`, else the one-statement body
def end_block_operand(p: Parser, word: text, power: int): Node := {
	if closing_end_follows(p, END_BLOCK_OPENERS) { return end_block(p, word == "then") }
	// `do a; if c then b end`
	if word == "do" and closing_end_follows(p, ["do"]) { raise AMBIGUOUS_END }
	if word == "do" then expression(p, power) else branch(p, power)
}

AMBIGUOUS_END = "ambiguous `end`: it closes either the `then` or the `do`; as in Ruby and Lua every `then … end` and `do … end` needs its own: write `while c do … if x then … end end` or `while c { … if x { … } }`"

// The statements up to the closing `end` (consumed) as a `{…}` block; a `then` block also ends at its `else`
def end_block(p: Parser, stops_at_else: bool): Node := items_until(p, Bracket.Curly, if stops_at_else then ItemsEnd.EndOrElse else ItemsEnd.End)

// What closes the items, as the messages name it; ' ' where no character does
def closer_of(bracket: Bracket, ends: ItemsEnd): text := match ends {
	ItemsEnd.Closer: closing_of(bracket as text)
	ItemsEnd.End: "end"
	ItemsEnd.EndOrElse: "end else"
	_: ' '
}

// Whether the parser stands at the word closing the Ruby block `closer`
def closes_block(p: Parser): bool := p.group.stops_at_end and (keyword_at(p, "end") or (p.group.in_branch and keyword_at(p, "else")))

// The control words that guard or loop the statement before them: `a = 2 if c`, `a = 2 unless c`, `x++ while c`,
// `x++ until c`
TRAILING_GUARD_WORDS = ["if", "unless", "while", "until"]
// The trailing guard word at the parser's position, else ""; an `if` with its own `then` or block starts a branch, an
// `until` in a loop's iterable is the range word (`for i in 1 until 5`)
def trailing_guard_at(p: Parser): text {
	for word in TRAILING_GUARD_WORDS {
		if keyword_at(p, word) and operand_after(p, word.length) and not starts_branch(p, word) and not (word == "until" and p.iterable) { return word }
	}
	""
}
def starts_branch(p: Parser, word: text): bool := word == "if" and condition_has_branch(p, p.at + word.length)

// Whether the condition from `at` to the end of its statement has a branch: a spaced `{` outside brackets
// (`point{x:1}` is data) or `then`. A match arm's guard has none: `n if n > 3 => {…}` ends at the `=>`, and
// `if k in {a: 1} => …` holds a map
def condition_has_branch(p: Parser, at: int): bool {
	depth = 0
	spaced_brace_open = false
	// ' ' while outside quotes
	open_quote = ' '
	for i in at ..< p.n {
		c = p.code[i]
		if open_quote != ' ' {
			if c == closing_of(open_quote) { open_quote = ' ' }
		} else if opens_text(c) {
			open_quote = c
		} else if c == '{' and depth == 0 {
			// a comparison, not is_blank: a `: bool` call is an Int to the analyzer (card bool-call-int)
			spaced_brace_open = p.code[i - 1] == ' ' or p.code[i - 1] == '\t'
			depth += 1
		} else if c == '(' or c == '[' or c == '{' {
			depth += 1
		} else if c == ')' or c == ']' or c == '}' {
			if depth == 0 { return false }
			if c == '}' and depth == 1 and spaced_brace_open {
				if not starts_at(p.code, "=>", blank_end(p, i + 1), p.n) { return true }
				spaced_brace_open = false
			}
			depth -= 1
		} else if depth == 0 {
			if starts_at(p.code, "=>", i, p.n) or c == '\n' or c == ';' { return false }
			if c == 't' and not is_name_char(p.code[i - 1]) and keyword_at_position(p, "then", i) { return true }
		}
	}
	spaced_brace_open
}

// `x if c` is `if c then x`, `x unless c` is `if not c then x`, `x while c` is `while c do x`, `x until c` is `while
// not c do x`; a trailing `while` tests before the first round like the leading one 
def guarded_statement(statement: Node, word: text, condition: Node): Node := {
	guard = control_condition(word, condition)
	if CONTROL_WORDS[word] == "while" then Key(Key(ø, Op.While, guard), Op.Do, statement) else Key(Key(ø, Op.If, guard), Op.Then, statement)
}

// `pattern: match v {…}`: the arm's value is the whole inner match, its subject and its cases on the line, though `:`
// binds tighter than the words after it (card match-arm-whose)
def with_switch_cases(p: Parser, value: Node): Node {
	opens_switch = value == symbol("match") or value == symbol("switch")
	if not opens_switch or not starts_atom_at(p, blank_end(p, p.at)) { return value }
	skip_blanks(p)
	parts = [value, argument(p, true)]
	if char_at(p, blank_end(p, p.at)) == '{' {
		skip_blanks(p)
		parts = parts + [atom(p)]
	}
	spaced(parts)
}

// A prefix `if` takes its own `then` and `else` wherever it stands: `pattern: if c then a else b` is the arm giving the
// whole if, though `:` binds tighter than `then`. Only an `else` after a `then` the if took this way: `if a then if b
// then c else d` keeps its else for the outer if.
def owns_branches(left: Node, op: text, took_own_then: bool): bool := match left {
	Key(condition, Op.If, test): op == "then" and condition == ø
	Key(branches, Op.Then, value): op == "else" and took_own_then
	_: false
}

// The name before the parser's position and blanks, else ""
def word_before(p: Parser): text {
	end = p.at
	while end > 0 and is_blank(p.code[end - 1]) { end -= 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start -= 1 }
	p.code[start .. end]
}

// An infix word of lib/aliases.warp before a block or right before `(` names a word: `div {…}` is the html tag,
// `print add(2, 3)` calls add, `7 div 2` divides
def names_word(p: Parser, word: text): bool := alias_spellings().infix_words.contains(word) and (opens_block(p, word.length) or char_ahead(p, word.length) == '(')
// A block opens after the `width` characters at the parser's position and blanks: `div {…}` is the html tag
def opens_block(p: Parser, width: int): bool {
	char_at(p, blank_end(p, p.at + width)) == '{'
}

// `is not`, `isn't` at the parser's position, else ""
// Spellings of a negated operator, each with the spelling it negates: `a nand b` is `not (a and b)`, `x isn't 4`
// `not (x is 4)`, Python's `x not in xs` `not (x in xs)`
NEGATED_SPELLINGS = {"nand": "and", "¬&": "and", "⊼": "and", "is not": "is", "isn't": "is", "isn’t": "is", "not in": "in", "∉": "in"}
NEGATED_STARTS = by_first_character(NEGATED_SPELLINGS.keys, word => word)
def negated_at(p: Parser): text := starting_here(NEGATED_STARTS, p, p.at).find(written => keyword_at(p, written)) ?? ""

// how tightly `x in xs` binds on its left and right
MEMBERSHIP_POWERS = [115, 116]
def membership_test(left: Node, word: text, right: Node): Node := spaced([left, symbol(word), right])
// `a and b`, `x is 4`, `x in xs` of the operator's spelling
def operation(left: Node, spelling: text, right: Node): Node := if spelling == "in" then membership_test(left, spelling, right) else keyed(spelling, left, right)

// `x in xs`, `xs contains x`: the membership word at the parser's position as [written, word], else []; `x is in xs` is
// `x in xs`
def membership_at(p: Parser): list {
	if keyword_at(p, "is in") { return ["is in", "in"] }
	if keyword_at(p, "in") { return ["in", "in"] }
	word = word_at(p)
	if keyword_form(word) == "contains" and operand_after(p, word.length) and not assigned_at(p, p.at + word.length) { return [word, word] }
	// `x ∈ xs`, `xs ∋ x`: an alias of a membership word
	alias = alias_at(p)
	if alias != ø and (alias.target == "in" or keyword_form(alias.target) == "contains") { return [alias.spelling, alias.target] }
	[]
}

// A unit word stays in the flat counting phrase `number of chars in t`
def counts_units(left: Node): bool := left is symbol and UNIT_WORDS.contains(name_of(left))

UNIT_WORDS = ["byte", "bytes", "char", "chars", "character", "characters", "codepoint", "codepoints", "grapheme", "graphemes"]

// An operand follows `width` characters on: blanks, then no end of the expression
// `contains = …`: an assignment's `=` (no `==`) after the blanks at `at`
def assigned_at(p: Parser, at: int): bool {
	sign = blank_end(p, at)
	char_at(p, sign) == '=' and char_at(p, sign + 1) != '='
}
def operand_after(p: Parser, width: int): bool {
	at = p.at + width
	if not (char_at(p, at) == ' ' or char_at(p, at) == '\t') { return false }
	not "\n)]};,".contains(code_after(p, at))
}

// `x = f y`, `1 + count xs`: a name before an operand is called with it, as an assignment's value, in an operand from
// `or` up to `+` (not in an argument or a loop header) or with an argument that is no name, never before `for`
def applies(p: Parser, left: Node, min_power: int): bool {
	if min_power == 0 or min_power > 151 { return false }
	// `[a+b c]`: a glued operator's operand ends at a blank (decision glued-binds-tighter)
	if p.group.glued and p.at > 0 and is_blank(p.code[p.at - 1]) { return false }
	// `do r += i end`: the `end` closing the block is no argument
	if p.group.stops_at_end and keyword_at(p, "end") { return false }
	// `ys = @parallel square all xs`: a word an attribute marks applies as the word itself
	marked = attribute_marked(left)
	callable = marked is symbol or is_list_of(marked, "")
	if not callable { return false }
	c = char_here(p)
	if c == '{' and p.header { return false }
	// `[if c then 1 else c for c in t]`: a `for` clause takes no argument of the word before it (`for:` labels one)
	if keyword_at(p, "for") and char_ahead(p, 3) != ':' { return false }
	in_operand = min_power >= OPERAND_POWERS#1 and min_power <= OPERAND_POWERS#2 and min_power != ARGUMENT_POWER and (if p.iterable then word_ends_header(p) else not word_begins_item(p))
	(applies_otherwise(p, min_power) or in_operand) and (unnamed_at(p) or is_name_start(c) or hole_at(p))
}
// whether an argument, no operator or guard word, stands here: `x 1`, `x -1`, not `x - 1` or `x and y` (continued)
def argument_here(p: Parser): bool := (operator_at(p).length == 0 or signed_item_at(p)) and trailing_guard_at(p) == ""
// a rule's hole `$t` here, which stands where a name does: `$x is a $t` reads as `x is a number` does
def hole_at(p: Parser): bool := char_here(p) == '$' and is_name_start(char_ahead(p, 1))

// `r = move 1 from: 10 to: 3`: a label word with a colon and a blank after it labels the argument after them, also
// where the call is an operand (decision labels-calls); ø where no label stands
def labelled_argument(p: Parser): Node := {
	at = blank_end(p, p.at)
	end = name_end(p.code, at, p.n)
	if end == at or not label_words.contains(p.code[at .. end]) or char_at(p, end) != ':' or not " \t".contains(char_at(p, end + 1)) { return ø }
	p.at = end + 1
	skip_spaces(p)
	Key(symbol(p.code[at .. end]), Op.Colon, expression(p, ARGUMENT_POWER))
}

// `x empty`, `x missing`, `x is absent` … ending a condition (wiki/null.md): [the end of the word, the word, whether
// `is` stood before it], else []; the word ends the condition where no operand follows it, or a block, a colon or an
// operator word does
TEST_WORDS = ["empty", "missing", "absent", "unknown", "undefined", "failed"]
TEST_WORD_STARTS = by_first_character(TEST_WORDS, word => word)
NOT_POWER = 105
def test_word_at(p: Parser, min_power: int): list {
	if min_power > NOT_POWER { return [] }
	after_is = keyword_at(p, "is")
	start = if after_is then blank_end(p, p.at + 2) else p.at
	word = starting_here(TEST_WORD_STARTS, p, start).find(candidate => keyword_at_position(p, candidate, start)) ?? ""
	if word == "" { return [] }
	end = start + word.length
	after = blank_end(p, end)
	next = char_at(p, after)
	following = p.code[after .. name_end(p.code, after, p.n)]
	ends = not operand_follows_at(p, end) or next == '{' or next == ':' or word_operators().any(op => op#1 == following)
	if ends then [end, word, after_is] else []
}
// `x is empty`, `x failed` as their phrase, the test word kept as written (`empty` alone reads as ø): its meaning is
// extensions/sugar/test_words.warp's rules
def tested(left: Node, word: text, after_is: bool): Node := spaced([left] + (if after_is then [symbol("is")] else []) + [symbol(word)])

// The word here begins what follows the operand: a loop clause, a block's `end`, a key (`_: 0`) or an element (`p{m}`)
def word_begins_item(p: Parser): bool {
	if keyword_at(p, "for") or keyword_at(p, "end") or else_if_at(p) { return true }
	at = p.at
	while at < p.n and is_name_char(p.code[at]) { at += 1 }
	if at == p.at { return false }
	c = char_at(p, at)
	next = char_at(p, at + 1)
	c == '{' or (c == ':' and not (next == ':' or next == '='))
}

// The word here is a loop header's last, the body follows it (`for i in 1 to count xs {…}`, `… do …`, `…:` or an
// indented line): it is the argument of the word before rather than that word's body
def word_ends_header(p: Parser): bool {
	if not is_name_start(char_here(p)) { return false }
	start = p.at
	p.at = name_end(p.code, p.at, p.n)
	skip_spaces(p)
	indented_line_follows = at_char(p, '\n') and " \t".contains(char_ahead(p, 1))
	ends = at_to_header_end(p) or keyword_at(p, "do") or indented_line_follows
	p.at = start
	ends
}

// An assignment's value, a branch or an argument that is no name is called with whatever the operand is
def applies_otherwise(p: Parser, min_power: int): bool := min_power <= 60 or min_power == p.branch_power or unnamed_at(p)

def unnamed_at(p: Parser): bool {
	c = char_here(p)
	is_digit(c) or opens_text(c) or c == '(' or c == '[' or c == '{' or c == '-'
}

// The argument of a braceless call; `while i < count t {…}`: a block after an operand's argument is the body
def argument(p: Parser, block_ends: bool): Node := with_field(p, "header", p.header or block_ends, () => expression(p, ARGUMENT_POWER))

// The operands a braceless call binds in: the right sides of `or` to `+`
OPERAND_POWERS = [91, 141]

// A braceless argument takes arithmetic and ranges, stops at comparisons: `f 3-1 > 5`, `y = sum 1..4`
ARGUMENT_POWER = 130

// The marks of a slice from the start, `xs[:3]`, `xs[...3]`, each with its operator
SLICE_FROM_START = [[":", ":"], ["…", "to"], ["...", "to"], ["..", ".."]]

// `[:end]`, `[...last]`, `[..end]`, `[:]`: a slice from the start, `ø:end`, else ø with nothing read
def slice_from_start(p: Parser): Node := {
	for mark in SLICE_FROM_START {
		if at_text(p, mark#1) {
			p.at += mark#1.length
			skip_blanks(p)
			if at_char(p, ']') { return keyed(mark#2, ø, ø) }
			return keyed(mark#2, ø, expression(p, 0))
		}
	}
	ø
}

// Below member access and indexing: `xs#1++`, `xs#2!`
SUFFIX_POWER = 165

// The `!` at the parser's position is the suffix `x!`, not a `!=` nor a prefix `!` of the operand after it: glued to
// its operand and followed by a blank, an infix operator or `)` (`name! email?`, `x!+1`), or no operand follows
def bang_suffix_at(p: Parser): bool {
	next = char_ahead(p, 1)
	if next == '=' { return false }
	glued = p.at > 0 and not is_blank(p.code[p.at - 1]) and " \t!+-*/%^<>)".contains(next)
	glued or not operand_follows(p, 1)
}

// `left!` (or `left!!`): `upper(x)!` assigns the result back to x, `{…}!` runs the block anyway, anything else
// is `unwrap(left)`, which extensions/sugar/methods.warp turns into an assignment back where a function's call is marked
// (`x.upper!`, `upper x!`), and which runs a lone `x!` as it is
def forced(left: Node): Node := {
	if left == ø { return call_of([symbol("unwrap"), ø]) }
	variable = mutated_variable(left)
	if variable != ø and not is_member(left) { return Key(variable, Op.Assign, left) }
	if is_block(left) { return left }
	call_of([symbol("unwrap"), left])
}

def is_member(node: Node): bool := match node {
	Key(receiver, Op.Dot, member): yes
	_: no
}

// The variable a call written before `!` changes: x in `x.upper`, `x.upper()` and `upper(x)`
def mutated_variable(call: Node): Node := match call {
	Key(receiver, Op.Dot, method): { if receiver is symbol and is_method(method) then receiver else ø }
	List(parts, Bracket.Round, separator): { if #parts == 2 and parts#1 is symbol and parts#2 is symbol then parts#2 else ø }
	_: ø
}

def is_method(node: Node): bool {
	parts = group_parts(node)
	node is symbol or (parts != ø and #parts#3 > 0 and parts#3#1 is symbol)
}
// An operand a glued `(` calls, as `f(x)` calls a name: a group `(x => x*2)(5)`, a call's result `adder(5)(1)`, an
// element `fs[0](3)`; a number it multiplies (`(2)(3)`, emitter closure_call). A block `{it*2}(5)` stays side by side
// with its argument, the one shape `{it*2} 5` applies by
def is_callee(left: Node): bool := is_list_of(left, "(") or is_element(left)
def is_element(n: Node): bool := match n {
	Key(target, op, index): op == Op.Hash
	_: false
}
// `[a -1]`, `f it -1`, `x -1`, `1 +1`: a sign spaced before and glued after starts a signed operand, a new item, not a
// subtraction or sum: a binary operator is spaced evenly (decisions glued-negative, binary-operator-spacing); `a - 1`
// and `a-1` compute, so does a sign inside an index, `xs[i -1]`
def signed_item_at(p: Parser): bool {
	if p.indexing or p.at == 0 or not is_blank(p.code[p.at - 1]) or not (at_char(p, '-') or at_char(p, '+')) { return false }
	next = char_ahead(p, 1)
	not is_blank(next) and not "=->+".contains(next)
}
// the signed item, written from the source's offset `sign_at` to the parser's position, marked with what was written
// before it, `1` of `1 +1`: the analyzer warns that these are two items (source_checks.warp spaced_sign)
def spaced_sign_marked(p: Parser, before: text, sign_at: int, item: Node): Node := attributed(SPACED_SIGN_MARK, listed(Bracket.Square, Separator.Space, [before, p.code[sign_at ..< p.at].trim()]), item)
// `a *b`, `a* b`: an arithmetic or comparing operator spaced on one side only, which computes but reads as a sign or a
// suffix; the analyzer warns (decision binary-operator-spacing, source_checks.warp uneven_spacing)
def unevenly_spaced(p: Parser, at: int, glyph: text): bool := EVENLY_SPACED_OPERATORS contains glyph and at > 0 and is_blank(p.code[at - 1]) != is_blank(char_at(p, at + glyph.length))
// `[a+b c]`: in a square list an arithmetic operator glued to both its operands joins them into one item, `[(a+b), c]`; its right operand
// ends at a blank (decision glued-binds-tighter); precedence stays: `1+2 * 3` is 7
def glued_at(p: Parser, at: int, glyph: text): bool := p.group.bracket == Bracket.Square and GLUED_OPERATORS contains glyph and at > 0 and not is_blank(p.code[at - 1]) and not is_blank(char_here(p))
GLUED_OPERATORS = ["+", "-", "*", "/", "%", "^"]
def right_operand(p: Parser, min_power: int, glued: bool): Node := if glued then with_field(p.group, "glued", yes, () => expression(p, min_power)) else expression(p, min_power)
// `[a + b c]`: a spaced operator in a square list whose right operand is a phrase `b c`, which the analyzer refuses where
// b is a value, naming both readings (source_checks.warp spaced_operand)
def spaced_operand_in_list(p: Parser, glyph: text, glued: bool, right: Node): bool := not glued and p.group.bracket == Bracket.Square and GLUED_OPERATORS contains glyph and is_group(right) and bracket_of(right) == "" and separator_of(right) == " " and #right > 1 and right#1 is symbol
EVENLY_SPACED_OPERATORS = ["*", "/", "%", "^", "==", "!=", "<", ">", "<=", ">="]
// the source written from the node's place to the offset `end`, "" for a node of no place
def written_before(p: Parser, n: Node, end: int): text := {
	line = line_of(n)
	column = column_of(n)
	if not (line is int and column is int) { return if is_group(n) and #n > 0 then written_before(p, n#1, end) else "" }
	p.code[code_offset(p, p.line_starts[line - 1], column) ..< end].trim()
}

// The left power of `#`, which a glued `[` indexes with
INDEX_POWER = 170

// The operators written with symbols, longest first, each with its canonical name; alias_spellings() adds their other
// spellings (lib/aliases.warp)
SYMBOL_OPERATORS = {"?.": "?.", "===": "===", "!==": "!==", "/!": "/!", "??": "??", "?:": "?:", "··": "··", ":=": ":=", "::": "::", "->": "->", "|>": "|>", "+=": "+=", "-=": "-=", "*=": "*=", "/=": "/=", "<<": "<<", ">>": ">>", "<=": "<=", ">=": ">=", "==": "==", "!=": "!=", "..": "..", ":": ":", "=": "=", "←": "←", "<-": "←", ".": ".", "+": "+", "-": "-", "*": "*", "/": "/", "%": "%", "^": "^", "<": "<", ">": ">", "≈": "≈", "~": "~", "#": "#", "?": "?", "↑": "↑", "↓": "↓"}
// The operators kept as the phrase [a op b] for the sugar to read: `a ?: b` is a or its fallback
// (extensions/sugar/fallbacks.warp); so are each operator's element-wise form `.op` and compound assignment `op=`
PHRASE_OPERATORS = ["?:"]
// the canonical name of a compound assignment `x op= y`, which binds as `=`
COMPOUND_ASSIGNMENT = "op="
def is_phrase_operator(op: list): bool := PHRASE_OPERATORS.contains(op#1) or op#2 == COMPOUND_ASSIGNMENT or is_dotted(op)
// `.<` of `xs .< 2`: an operator's element-wise form, its canonical name the operator's (it binds as that one does)
def is_dotted(op: list): bool := op#1.length > 1 and op#1#1 == '.' and op#1[1 ..] == op#2
// `abs.(xs)`, Julia's dot call: warp has none (decision no-dot-call-broadcast), a function of numbers broadcasts by itself
// and `each` applies any other to every item
def dot_call_refused(f: Node): text {
	name = if f is symbol then name_of(f) else "f"
	"no dot call " + name + ".(…): did you mean `" + name + " xs`, or `" + name + " each xs` for a function taking a list?"
}
// `left op right` as its phrase, for the sugar to read (extensions/sugar/arithmetic.warp, fallbacks.warp)
def phrase_operation(left: Node, op: text, right: Node): Node := spaced([left, symbol(op), right])
// The operators written as words, each with its canonical name; alias_spellings() adds the infix words of lib/aliases.warp
WORD_OPERATORS = {"then": "then", "else": "else", "and": "and", "xor": "xor", "or": "or", "is": "is", "do": "do", "to": "to", "as": "as", "rem": "rem"}
// The words that are operators in a loop's iterable alone: Kotlin's `for i in 0 until n` (elsewhere `until` guards)
ITERABLE_WORD_OPERATORS = [["until", ".."]]
// The iterable's own operator at the parser's position as [written, canonical], else []
def iterable_operator_at(p: Parser): list {
	for op in ITERABLE_WORD_OPERATORS { if keyword_at(p, op#1) { return op } }
	[]
}

// The operator at the parser's position as [written, canonical], else []: a spelled one, the element-wise form `.op`
// of one, or the compound assignment `op=` of one or of a function's word (decisions dot-operators-now,
// op-assign-general): `xs .< 2`, `x ^= 3`, `x max= 5`, `xs .*= 2`; in a rule its operator hole, `.$op`, `$op=`
def operator_at(p: Parser): list {
	spelled = dotted_operator_at(p)
	if spelled.length == 0 { spelled = spelled_operator_at(p) }
	written = if spelled.length > 0 then spelled#1 else operand_word_at(p)
	if written != "" and assigns_after(p, written.length) and (if spelled.length == 0 then not declares_before(p) else computes(spelled#2)) { return [written + "=", COMPOUND_ASSIGNMENT] }
	spelled
}
// the word before the operand is one declaring it, `const x=5`, `let n=5`, or its type, `int i=2*3`: its `x=` an
// assignment, no `x max= 5`
DECLARING_WORDS = ["let", "var", "global", "export", "import", "const", "constant", "final", "mutable", "mut", "val", "static"]
def declares_before(p: Parser): bool {
	end = p.at
	while end > 0 and is_blank(p.code[end - 1]) { end -= 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start -= 1 }
	word = p.code[start ..< end]
	word in DECLARING_WORDS or (end < p.at and known_type(word, p.types))
}
// `=` alone (no `==`) right after `width` characters
def assigns_after(p: Parser, width: int): bool := char_ahead(p, width) == '=' and char_ahead(p, width + 1) != '='
// an operator computing a value of its two sides, which has an element-wise form and a compound assignment: one
// binding between `or` and `^` (binding_powers), but for the range, the pipe, the cast and the fallback there
def computes(canonical: text): bool {
	power = binding_powers(canonical)#1
	power >= binding_powers("or")#1 and power <= binding_powers("^")#1 and canonical not in ["..", "to", "|>", "as", "??"]
}
// `.<`, `.*`: a `.` glued to a computing operator; a word's after a blank, `xs .and ys` (`x.is(y)` calls the method
// is), and so `.$op`, a rule's hole of one
def dotted_operator_at(p: Parser): list {
	if char_here(p) != '.' { return [] }
	spaced = p.at > 0 and is_blank(p.code[p.at - 1])
	if is_name_start(char_ahead(p, 1)) and not spaced { return [] }
	if char_ahead(p, 1) == '$' and spaced {
		hole = operand_word_at_from(p, p.at + 1)
		return if hole == "" then [] else ["." + hole, hole]
	}
	advance(p)
	inner = unassigned(spelled_operator_at(p))
	p.at -= 1
	if inner.length > 0 and inner#1#1 != '.' and computes(inner#2) then ["." + inner#1, inner#2] else []
}
// the operator of a compound assignment the parser keeps, `*` of `*=` (`xs .*= 2`), else the spelled one
def unassigned(spelled: list): list {
	if spelled.length == 0 or not spelled#1.ends_with("=") or spelled#1.length < 2 or computes(spelled#2) { return spelled }
	written = spelled#1[0 ..< spelled#1.length - 1]
	canonical = canonical_operator(written)
	if canonical == "" then spelled else [written, canonical]
}
// the word at the parser's position, `$op` a rule's hole too, else ""
def operand_word_at(p: Parser): text := operand_word_at_from(p, p.at)
def operand_word_at_from(p: Parser, at: int): text {
	start = if char_at(p, at) == '$' then at + 1 else at
	if not is_name_start(char_at(p, start)) { return "" }
	p.code[at .. name_end(p.code, start, p.n)]
}
// The operator spelled at the parser's position as [written, canonical], else []
// (each text read is a walk from its start, card text-costs: the character is read once and picks the candidates)
def spelled_operator_at(p: Parser): list {
	c = char_here(p)
	if is_name_start(c) {
		if bang_word_at(p) > 0 or word_names_key(p, word_at(p)) or follows_naming_keyword(p) { return [] }
		word = word_operator_at(p, c)
		if word.length > 0 { return word }
		if p.iterable and iterable_operator_at(p).length > 0 { return iterable_operator_at(p) }
		return aliased_operator_at(p)
	}
	if at_text(p, "//") { return [] }
	// `x = 1  # one` is a comment, `xs #1` the index operator (card parser-parses)
	if c == '#' and skipped_end(p.code, p.at, p.n) > p.at { return [] }
	spelled_symbol = symbol_operator_at(p, c)
	if spelled_symbol.length > 0 then spelled_symbol else aliased_operator_at(p)
}
// The operator word at the parser's position as [written, canonical], else []
def word_operator_at(p: Parser, c: text): list {
	for pair in word_operators() {
		written = pair#1
		if written#1 == c and keyword_at(p, written) and not (p.group.in_branch and written == "else") and not names_word(p, written) and not heads_rule(p) { return pair }
	}
	[]
}
// The parser's position is the first word after a line-leading `rewrite`: an infix word there is the rule's own first
// word, `rewrite upto $n => …` (card hCz9o0)
def heads_rule(p: Parser): bool {
	start = p.at
	while start > 0 and p.code[start - 1] != '\n' { start -= 1 }
	p.code[start .. p.at].trim() == "rewrite"
}
// The parser's position is the name a function keyword defines: `def add(a, b)` defines add, never `def + (a, b)`;
// `$f is function and …` goes on with its operator
NAMING_KEYWORDS = function_keywords + ["override"]
def follows_naming_keyword(p: Parser): bool := word_before(p) in NAMING_KEYWORDS and char_ahead(p, word_at(p).length) == '('
// The operator symbol at the parser's position as [written, canonical], the longest, else []
// (`c ?.5 : 1` keeps its ternary: `?.` before a digit is `?` and the number .5)
def symbol_operator_at(p: Parser, c: text): list {
	for pair in symbol_operators() {
		written = pair#1
		if written#1 == c and at_text(p, written) and (written != ">>" or operand_follows(p, 2)) and (written != "?." or not is_digit(char_ahead(p, 2))) { return pair }
	}
	[]
}

// An operand follows `width` characters on, after any blanks: `n >> 7` shifts, `list<list<int>>` closes two generics
def operand_follows(p: Parser, width: int): bool := operand_follows_at(p, p.at + width)
def operand_follows_at(p: Parser, at: int): bool := not "\n>)]},;=".contains(code_after(p, at))

// `word` at the parser's position as a whole word
def keyword_at(p: Parser, word: text): bool := keyword_at_position(p, word, p.at)

// `10 down to 1`: the length of the words `down to` (Kotlin's `downTo`), else 0
def down_to_at(p: Parser): int {
	if not keyword_at(p, "down") { return 0 }
	at = blank_end(p, p.at + 4)
	if at > p.at + 4 and keyword_at_position(p, "to", at) then at + 2 - p.at else 0
}

// The operators only a declaration gives meaning (lib/prelude.warp `infix operator ↑`): `2↑3` calls operator_↑(2, 3);
// `loop··step` in a rule's template glues the hidden name loop·step (rewrites.warp), elsewhere the call of no operator
// The name of the function an operator declaration defines: `infix operator ⊕` defines operator_⊕
OPERATOR_FUNCTION_PREFIX = "operator_"
// Where a declared operator stands to its operands: `prefix operator ∆`, `suffix operator ³`, `infix operator ⊕`
enum Fixity { Prefix, Suffix, Infix, Circumfix }
// The words declaring an operator of a fixity; `operator ⊕` alone is infix, `postfix` is `suffix`
FIXITY_WORDS = {"prefix": Fixity.Prefix, "suffix": Fixity.Suffix, "postfix": Fixity.Suffix, "infix": Fixity.Infix, "circumfix": Fixity.Circumfix, "operator": Fixity.Infix}
// An operator a program or module declares, `infix operator ⊕ := …`, binding as tight as its level
class DeclaredOperator { glyph: text; fixity: Fixity; level: int }

// How tight a declared operator binds unless a precedence declaration says otherwise, as the built-ins it resembles;
// an infix one's right power is one more than its level
def fixity_level(fixity: Fixity): int := match fixity {
	Fixity.Prefix: 155
	Fixity.Suffix: 165
	_: 140
}

// The call of a declared operator's function: `2 ⊕ 3` is operator_⊕(2, 3)
def operator_call(glyph: text, arguments: list): Node := call_of([symbol(OPERATOR_FUNCTION_PREFIX + glyph)] + arguments)


// A glyph a declaration may define: one beyond ASCII, or one the aliases leave to a declaration (`~`, `declared: yes`)
def is_definable_glyph(glyph: text): bool := is_operator_glyph(glyph) or alias_spellings().declared contains glyph
// A glyph a program may declare as an operator: symbols with a non-ASCII character (`‼`, `⊕`), no letter or digit;
// raised digits too (`suffix operator ³`)
def is_operator_glyph(glyph: text): bool {
	beyond_ascii = false
	for c in glyph {
		if not SUPERSCRIPT_DIGITS.contains(c) and (is_name_char(c) or is_digit(c) or is_blank(c)) { return false }
		if c > '~' { beyond_ascii = true }
	}
	beyond_ascii
}

// The blank-separated words of a statement
def blank_words(statement: text): list := statement.replace("\t", " ").split(" ").filter(word => word)

// What the modules at the top of lib/ declare for every program, from the library index (library.warp): "words",
// word → the module declaring it global, `global play(file: text) := …` (decision bizarre-global: a program naming it
// uses the module without its `use`); "classes", class → its module, `class Time` of units (decision
// expected-type-names: a parameter typed Time finds its values there); "tags", tag → its module, each text of a global
// list, `global html_elements = ["div", …]` of markup (decision html-render-mode: a program writing `div{…}` uses it);
// "constants", constant → its module, `const pi() := π` of reals (decision library-constant-refused: `pi = 4` is refused);
// "typed", a name assigned an instance of a class → that class, `km = Unit("km")` of units (a rule's `$u is Unit`)
def global_words(): map := library_index_section("global")
def library_typed_constants(): map := library_index_section("typed")
def library_constants(): map := library_index_section("const")
def declared_classes_modules(): map := library_index_section("class")
def declarations_scanned(files: map): map {
	words = {}
	classes = {}
	tags = {}
	constants = {}
	assigned = []
	for path in files.keys {
		if not path.contains("/") and path.ends_with(module_extension) {
			module = path[0 ..< #path - #module_extension]
			listing = no
			for line in files[path].split("\n") {
				if listing {
					for tag in quoted_texts(line) { tags[tag] = module }
					listing = not line.contains("]")
				} else if line.starts_with(GLOBAL_MARK) {
					word = name_starting(line[#GLOBAL_MARK ..])
					rest = line[#GLOBAL_MARK + #word ..]
					if word and rest.starts_with("(") { words[word] = module }
					if word and rest.starts_with(" = [") {
						for tag in quoted_texts(rest) { tags[tag] = module }
						listing = not rest.contains("]")
					}
				}
				if line.starts_with(CLASS_MARK) { classes[name_starting(line[#CLASS_MARK ..])] = module }
				if line.starts_with(CONSTANT_MARK) { constants[name_starting(line[#CONSTANT_MARK ..])] = module }
				instance = instance_constant(line)
				if instance != ø { assigned += [instance] }
			}
		}
	}
	typed = {}
	for instance in assigned { if classes.has(instance#2) { typed[instance#1] = instance#2 } }
	{"words": words, "classes": classes, "tags": tags, "constants": constants, "typed": typed}
}
// a top-level line `km = Unit("km")`: [the name, the word called], else ø
def instance_constant(line: text): list? {
	sides = line.split(" = ")
	if #sides < 2 or sides#1 == "" or sides#1.contains(" ") or is_blank(line[0]) { return ø }
	called = name_starting(sides#2)
	if called and sides#2[#called ..].starts_with("(") then [sides#1, called] else ø
}
def declared_tags(): map := library_index_section("tag")
// the texts quoted in a line of a list, `"a", "b",` → ["a", "b"]: every other piece between its quotes
def quoted_texts(line: text): list {
	pieces = line.split("\"")
	texts = []
	for i in 1 to #pieces { if i % 2 == 0 { texts += [pieces#i] } }
	texts
}
GLOBAL_MARK = "global "
CLASS_MARK = "class "
CONSTANT_MARK = "const "
// the name a text starts with, "" when none
def name_starting(line: text): text {
	stop = 0
	while stop < #line and is_name_char(line[stop]) { stop += 1 }
	line[0 ..< stop]
}

// The words of a statement that uses a module: `use regex`, `require regex`, `import regex`
USE_KEYWORDS = ["use", "require", "import"]
// The folder holding the file of a path: core of core/parsing/parser.warp
def folder_of(path: text): text {
	parts = path.split("/")
	parts[0 ..< #parts - 1].join("/")
}
// The sources of the standard modules a source uses by name, read from lib/ beside this compiler (module_source takes
// a name written out only), and of those whose global words it names (`play "mozart.mp3"`, words.warp global_words)
def used_module_sources(source: text): list := module_sources(reached_modules(source))
// the standard modules a source uses by name or reaches by one of their global words
def reached_modules(source: text): list {
	modules = used_modules(source)
	names = names_mentioned(code_only(source))
	words = global_words()
	for word in words.keys {
		if not modules.contains(words[word]) and names.has(word) { modules += [words[word]] }
	}
	modules
}
def module_sources(modules: list): list {
	sources = []
	for module in modules {
		module_source = std_module_text(module)
		if module_source { sources += [module_source] }
	}
	sources
}
// the modules the source's use lines name, each once: `use regex`, `import sound`
def used_modules(source: text): list {
	modules = []
	for statement in code_statements(use_candidates(source)) {
		words = blank_words(statement)
		module = if words.length == 2 and USE_KEYWORDS.contains(words#1) then words#2 else if words.length >= 4 and words#1 == FROM_WORD and words#3 == "import" then words#2 else ""
		if module != "" and not modules.contains(module) { modules += [module] }
	}
	modules
}
// `from list import zip` uses list as `use list` does (core/passes/uses.warp with_imports_as_uses)
FROM_WORD = "from"
// the lines of a source a use statement may start or stand in: one leads a line, unindented, or follows a `;` (the
// statements of all the prelude were ~20 ms a compile)
def use_candidates(source: text): text := source.split("\n").filter(line => (USE_KEYWORDS + [FROM_WORD]).any(keyword => line.starts_with(keyword + " ") or line.contains("; " + keyword + " "))).join("\n")
// the use lines of a source, as a slice of it reads them (written_tree's `uses`)
def use_lines(source: text): text := used_modules(source).map(module => "\nuse " + module).join("")
// the names the code says, found in one walk (a caller asking of many words asks this once), each as a whole name:
// `play` of `play(A4)`, no `play` of `display`; each run of name characters starting a name, and every end of a run
// glued to a number, as no name starts with a digit (`km` of `3km`, a number times km)
def names_mentioned(code: text): map {
	names = {}
	run = ""
	for c in code + " " {
		if is_name_char(c) { run += c } else {
			if #run > 0 and is_name_start(run[0]) { names[run] = yes } else if #run > 1 { for start in 1 ..< #run { names[run[start ..]] = yes } }
			run = ""
		}
	}
	names
}

// The statements of a source's code, outside comments and texts, split at line ends and `;`
def code_statements(source: text): list {
	statements = []
	for line in code_only(source).split("\n") { statements += line.split(";") }
	statements
}

def declared_of(glyph: text, fixity: Fixity): DeclaredOperator := DeclaredOperator{glyph: glyph, fixity: fixity, level: fixity_level(fixity)}
// `square x := x*x`, `add a b := a + b` (decision spaced-definition-head): at a statement's start, plain names before
// `:=` are a definition's head without its parentheses, square(x) := x*x; `f x` elsewhere stays a call
def spaced_definition(p: Parser): Node {
	if not at_statement_start(p) { return ø }
	line = p.code[p.at .. statement_end(p)]
	if not line.contains(" := ") { return ø }
	head = line.split(" := ")#1
	names = blank_words(head)
	// (no keyword: `def f x := …` stays the def rule's)
	if names.length < 2 or not names.all(name => is_plain_name(name) and keyword_form(name) == "") or names#1 == "def" { return ø }
	p.at += head.length + 4
	skip_spaces(p)
	Key(call_of(names.map(name => symbol(name))), Op.Define, expression(p, 0))
}
// whether only blanks stand between the parser and its statement's start: the input's, a line's, after `;` or `{`
def at_statement_start(p: Parser): bool {
	before = p.at - 1
	while before >= 0 and (p.code[before] == ' ' or p.code[before] == '\t') { before -= 1 }
	before < 0 or p.code[before] == '\n' or p.code[before] == ';' or p.code[before] == '{'
}
def is_plain_name(word: text): bool := word.length > 0 and name_end(word, 0, word.length) == word.length

def is_at_name_char(p: Parser, at: int): bool := at < p.n and is_name_char(p.code[at])

// The items of a parenthesized group, the one item of any other node, none of ø: the parameters of `⊕(a, b)`
def group_items(declared: Node): list {
	if declared == ø { return [] }
	parts = group_parts(declared)
	if parts != ø and parts#1 == "(" then parts#3 else [declared]
}

// The operators a class defines as methods by their glyph: `+(o) := …` is its plus, `#(n) := …` its index
METHOD_OPERATORS = ["+", "-", "*", "/", "%", "<", ">", "≈", "~", "#"]

// `+(o) := …` defines a class's method of an operator by its glyph (its plus): the head is the call `+(o)`, no unary
// plus, no count `#`; ø where no `:=` follows the parentheses. After the keyword (`infix operator |(x: any, g:
// function) := …`, `infix operator as(…)`, `declared`) any built-in operator, its function named as written
// (`operator_|`): an overload by its operands' kinds (rewrites.warp operator_rules)
def operator_method_head(p: Parser, declared: bool = false): Node {
	op = operator_at(p)
	if op.length == 0 or not (declared or METHOD_OPERATORS.contains(op#2)) { return ø }
	open = p.at + op#1.length
	if char_at(p, open) != '(' { return ø }
	if not starts_at(p.code, ":=", blank_end(p, hole_end(p.code, open + 1, '(', ')', p.n)), p.n) { return ø }
	p.at = open
	parameters = group_items(expression(p, binding_powers(":=")#1 + 1))
	call_of([symbol(if METHOD_OPERATORS.contains(op#2) then op#2 else OPERATOR_FUNCTION_PREFIX + op#1)] + parameters)
}

// `operator #(n) := …`, `infix operator +(a: V, b: V) := …`: the method of a built-in operator, its keywords
// superfluous; ø for any other statement starting with the word
def operator_method_definition(p: Parser, word: text): Node {
	start = p.at
	p.at += word.length
	skip_spaces(p)
	if word != "operator" and keyword_at(p, "operator") {
		p.at += 8
		skip_spaces(p)
	}
	head = operator_method_head(p, true)
	if head == ø {
		p.at = start
		return ø
	}
	skip_spaces(p)
	p.at += 2
	skip_spaces(p)
	Key(head, Op.Define, expression(p, 0))
}

// Left and right binding power of an operator: its row's `power` in lib/aliases.warp (card parser-rows), the data
// format's own operators STRUCTURE_POWERS, any other DEFAULT_POWERS
def binding_powers(op: text): list := alias_spellings().powers.get(op) ?? DEFAULT_POWERS
// The binding powers of the data format's member `.`, `?.`, `::` and key `:`, which reading the rows of
// lib/aliases.warp needs before any row is read
STRUCTURE_POWERS = {".": [180, 181], "?.": [180, 181], "::": [175, 176], ":": [80, 81]}
// how tightly an operator no row names binds: `=`, `:=`, as `=` does
DEFAULT_POWERS = [60, 59]

// The words that guard a statement and the marker call each becomes: `check C` is `assert C` (card check-assert)
GUARD_MARKERS = {"try": HiddenWord.TryElse as text, "assert": HiddenWord.AssertElse as text, "check": HiddenWord.AssertElse as text}
// The words that start the fallback of `try X else Y`: classical `catch`, Python's `except` (P60)
FALLBACK_WORDS = ["else", "catch", "except"]
// The hidden name `try X` binds X's Error to, to hand it on as the value
UNCAUGHT_ERROR = HiddenWord.UncaughtError as text
// The hidden name `except ParseError:` binds the Error to, to test its class
CAUGHT_ERROR = HiddenWord.CaughtError as text

// `try` or `assert` followed by an operand
def guard_word_at(p: Parser, word: text): bool := word in GUARD_MARKERS and " \t{:".contains(char_ahead(p, word.length))

// `try X else Y`, `assert C else X`: the marker call `marker(X, Y)`; `try X catch e {e}` adds the caught name the
// fallback reads, `r = try X` keeps X's Error as the value, `assert C` alone fails naming C as written
def guarded(p: Parser, word: text): Node := {
	marker = GUARD_MARKERS[word]
	p.at += word.length
	skip_spaces(p)
	python_block = at_char(p, ':')
	skip_python_colon(p)
	start = p.at
	guarded_part = guarded_phrase(p)
	written_part = p.code[start .. p.at].trim()
	skip_spaces(p)
	// the one-line `try x except y` is `x default y`, y when x raises or is ø (decision nullish-default); the block
	// `try: … except: …` handles errors
	if word == "try" and not python_block and fallback_word_ahead(p) == "except" {
		p.at = p.resumes[p.at] + 6
		skip_spaces(p)
		return Key(guarded_part, Op.Coalesce, guarded_phrase(p))
	}
	if fallback_word_ahead(p) {
		// `except A: a except B: b`: an Error A does not catch passes on to the next one; an `else` after the
		// fallback is an enclosing `if`'s
		guard = guarded_part
		first = yes
		fallback_word = fallback_word_ahead(p)
		while fallback_word and (first or fallback_word != "else") {
			first = no
			p.at = p.resumes[p.at] + fallback_word.length
			skip_spaces(p)
			caught = if fallback_word == "else" then ["", ""] else caught_parts(p, fallback_word)
			skip_python_colon(p)
			guard = guarded_by(marker, guard, guarded_phrase(p), caught)
			skip_spaces(p)
			fallback_word = fallback_word_ahead(p)
		}
		return with_finally(p, guard)
	}
	caught = ["", ""]
	fallback = ø
	if word == "try" {
		caught = [UNCAUGHT_ERROR, ""]
		fallback = symbol(UNCAUGHT_ERROR)
	} else if marker == HiddenWord.AssertElse {
		fallback = "assertion failed: " + written_part
	}
	with_finally(p, guarded_by(marker, guarded_part, fallback, caught))
}

// The marker call `marker(X, Y)`, with the name Y reads the caught Error by as a fourth item (`catch e { … }`);
// `except ParseError as e` binds `e: ParseError`, which lowering tests before Y runs
def guarded_by(marker: text, guarded_part: Node, fallback: Node, caught: list): Node := {
	parts = [symbol(marker), guarded_part, fallback]
	name = caught#1
	caught_class = caught#2
	if caught_class {
		bound = if count(name) == 0 then CAUGHT_ERROR else name
		parts = parts + [keyed(":", symbol(bound), symbol(caught_class))]
	} else if name and reads_name(fallback, name) {
		parts = parts + [symbol(name)]
	}
	call_of(parts)
}

// whether n reads the name, in the holes of its texts too (`catch e { "caught: \(e)" }`): the parser keeps a text's
// holes as written
def reads_name(n: Node, name: text): bool := mentions(n, name) or has_hole(n, code => mentions(parsed(code), name))

// `try: x` as Python writes it; the block may start on the next line
def skip_python_colon(p: Parser) {
	if at_char(p, ':') {
		advance(p)
		skip_blanks(p)
	}
}

// The fallback word after the blanks and line breaks ahead, else ""
def fallback_word_ahead(p: Parser): text {
	at = p.resumes[p.at]
	for word in FALLBACK_WORDS { if keyword_at_position(p, word, at) { return word } }
	""
}

// `catch e`, `except ZeroDivisionError`, `except ValueError as e`: [the name the Error is bound to, the class it must
// be], "" for none
def caught_parts(p: Parser, fallback_word: text): list {
	if not is_name_start(char_here(p)) { return ["", ""] }
	first = word_at(p)
	p.at += first.length
	skip_spaces(p)
	if keyword_at(p, "as") {
		p.at += 2
		skip_spaces(p)
		name = word_at(p)
		p.at += name.length
		skip_spaces(p)
		return [name, first]
	}
	if fallback_word == "catch" then [first, ""] else ["", first]
}

// Either part of `try X else Y`: one expression, or a braceless call of several (`try raise "boom" else print 3`)
def guarded_phrase(p: Parser): Node := {
	parts = with_field(p.group, "in_branch", true, () => guarded_parts(p))
	if parts.length == 1 then parts#1 else spaced(parts)
}
def guarded_parts(p: Parser): list := {
	parts = [expression(p, 0)]
	while true {
		skip_spaces(p)
		if fallback_word_ahead(p) or keyword_at(p, "finally") or not starts_atom(p) { return parts }
		parts += [expression(p, 0)]
	}
}

// `… finally {Z}` after a guard: `(finally·N = guard; Z; finally·N)`, Z runs and the guard's value stays
def with_finally(p: Parser, guard: Node): Node := {
	if not keyword_at_position(p, "finally", p.resumes[p.at]) { return guard }
	p.at = p.resumes[p.at] + 7
	skip_spaces(p)
	cleanup = if at_char(p, ':') then colon_body(p, 1) else statement_words(p)
	p.finally_blocks += 1
	value = symbol("finally·" + str(p.finally_blocks))
	listed(Bracket.Round, Separator.Semicolon, [Key(value, Op.Assign, guard), cleanup, value])
}

// An expression's start: a prefix operator and its operand, else an atom
def prefixed(p: Parser): Node := {
	c = char_here(p)
	if starts_path(p) { return path_literal(p) }
	prefixed_operand = read_prefix(p)
	if prefixed_operand != ø { return prefixed_operand }
	if not is_name_start(c) { return prefixed_by_symbol(p, c) }
	word = word_at(p)
	// `try: x except: y` guards as `try x except y` does: Python's colon names no key (the guard comes first)
	if guard_word_at(p, word) and not after_member_dot(p) { return guarded(p, word) }
	// `op.if`, `math.sqrt`: a member's name is no keyword
	if word_names_key(p, word) or after_member_dot(p) { return atom(p) }
	form = keyword_form(word)
	if form == "return" { return returned(p) }
	if form == "condition" {
		p.at += word.length
		skip_spaces(p)
		return conditioned(CONTROL_WORDS[word], control_condition(word, condition_expression(p)), p)
	}
	if form == "loop" {
		loop = looped(p)
		return if loop == ø then atom(p) else loop
	}
	foreign = foreign_form(p, word)
	if foreign != ø { return foreign }
	// a phrase an extension reads from its word, `emit alarm` (core/extension.warp keyword_readers)
	keyword_reader = keyword_reader_of(word)
	word_start = p.at
	phrase = if keyword_reader == ø then ø else keyword_reader(p, word)
	// a reader that moved on read its statement, if only to nothing (a declaration a prescan applied)
	if phrase != ø or p.at != word_start { return phrase }
	spaced = spaced_definition(p)
	if spaced != ø { return spaced }
	if word in FIXITY_WORDS {
		// an alias the pre-scan applied
		if only_spells(operator_statement(statement_words_at(p))) { return skip_statement(p) }
		method = operator_method_definition(p, word)
		if method != ø { return method }
	}
	declared = if form == "type" then type_declaration(p, word) else if form == "global" then global_declaration(p, word) else if form == "endless" then endless_loop(p) else ø
	if declared != ø { return declared }
	if word == DATA_WORD and char_ahead(p, word.length) == ' ' {
		literal = data_literal(p)
		if literal != ø { return literal }
	}
	if form == "not" or no_asks_emptiness(p, word) {
		p.at += word.length
		skip_spaces(p)
		return Key(ø, Op.Not, expression(p, 105))
	}
	atom(p)
}

// `x = data a and b` is the data `a and b`, also as an operand (`string(data a and b)`); parentheses around all of it
// only group it (`data (a and b)`); ø for `data = …`, `data.x`, glued `data(x)` and `data class`, where data stays a word
DATA_WORD = "data"
def data_literal(p: Parser): Node := {
	before = p.at
	p.at += DATA_WORD.length
	skip_spaces(p)
	if "}]);,\n\r".contains(char_here(p)) or operator_at(p).length > 0 or word_at(p) == "class" {
		p.at = before
		return ø
	}
	read = expression(p, binding_powers("=")#2)
	written = match read {
		List(parts, Bracket.Round, separator): { if #parts == 1 then parts#1 else read }
		_: read
	}
	spaced([symbol(DATA_WORD), written])
}

// `if no xs`: in a condition `no` before an operand asks for emptiness as `not xs` does; elsewhere, or before an
// operator word or a block, `no` is false (decision empty-is-not-missing)
def no_asks_emptiness(p: Parser, word: text): bool {
	if word != "no" or not p.header or not operand_follows(p, 2) { return false }
	after = blank_end(p, p.at + 2)
	if "{:".contains(char_at(p, after)) { return false }
	follower = p.code[after .. name_end(p.code, after, p.n)]
	not word_operators().any(pair => pair#1 == follower)
}

// Whether the word at the parser's position follows a member's dot: `op.if` names the member if, no keyword (a
// range's `..if` keeps it)
def after_member_dot(p: Parser): bool := p.at > 0 and p.code[p.at - 1] == '.' and not (p.at > 1 and p.code[p.at - 2] == '.')

PREFIX_POWER = 162

// The dashes 0x2010..0x2015 and the minus sign: each means `-` (infix ones: lib/aliases.warp, the minus sign
// lib/math.warp's alias line)
DASH_GLYPHS = "‐‑‒–—―−"

def prefixed_by_symbol(p: Parser, c: text): Node := {
	head = operator_method_head(p)
	if head != ø { return head }
	alone = operator_value(p)
	if alone != ø { return alone }
	next = char_ahead(p, 1)
	reference = reference_prefix_length(p, c, next)
	if reference > 0 {
		p.at += reference
		return prefixed(p)
	}
	if (c == '-' or DASH_GLYPHS.contains(c)) and next != '>' and next != '-' {
		sign = p.at
		advance(p)
		skip_spaces(p)
		operand = expression(p, 155)
		// a word's argument is the minus's operand too, `-f x` is -(f x), as an operator's operand takes it (decision
		// negated-call); a list's items stay apart, `[-x 1]`
		skip_spaces(p)
		if p.group.bracket != Bracket.Square and argument_here(p) and applies(p, operand, OPERAND_POWERS#2) { operand = spaced([operand, argument(p, not applies_otherwise(p, OPERAND_POWERS#2))]) }
		// `-7` is the number, written where its sign is
		// 9223372036854775808 reads as the int -2^63 where ints are 64 bits: `-9223372036854775808` is that int itself
		if operand is number { return placed_at(p, if operand is int and operand == -9223372036854775807 - 1 then operand else 0 - operand, sign) }
		return keyed("-", ø, operand)
	}
	// `+5` is 5, `+x` x: a glued plus is the sign of its operand (it was the symbol '+' beside it)
	if c == '+' and next != '+' and next != '=' and not is_blank(next) and operand_follows(p, 1) {
		advance(p)
		return expression(p, 155)
	}
	if c == '!' or c == '¬' {
		advance(p)
		# `as! int` is `as` of `!int`: the type may be a word after a blank (decision cast-checks)
		skip_spaces(p)
		return Key(ø, Op.Not, expression(p, 105))
	}
	if c == '#' and not is_blank(next) {
		advance(p)
		return Key(ø, Op.Hash, expression(p, INDEX_POWER - 1))
	}
	// `√x`, `∛x`: a glyph spelling a function calls it (lib/math.warp `prefix operator √ := sqrt`)
	spelled = alias_at(p)
	if spelled != ø and spells_function(spelled) {
		p.at += spelled.spelling.length
		skip_spaces(p)
		return call_of([symbol(spelled.target), expression(p, PREFIX_POWER)])
	}
	// `> 100 => "big"` (C#'s relational pattern): a comparison without its left side, a match arm compares the
	// subject; a glued `<tag` stays a bracket
	if c == '<' or c == '>' {
		relation = if next == '=' then "" + c + "=" else "" + c
		spacing = char_ahead(p, relation.length)
		if spacing == ' ' or spacing == '\t' {
			p.at += relation.length
			skip_spaces(p)
			return keyed(relation, ø, expression(p, binding_powers(relation)#2))
		}
	}
	// `&lerp`: a reference to the function, an `&` glued to the word after it and not to one before it (`a &b`)
	if c == '&' and is_alpha(next) and not (p.at > 0 and is_name_char(p.code[p.at - 1])) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return attributed(FUNCTION_REFERENCE_MARK, true, symbol(name))
	}
	if c == ':' and explicit_symbol_at(p) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return call_of([symbol("symbol"), name])
	}
	atom(p)
}

// Rust's reference `&x`, `&mut x`, `&&x`, `&5`, `&(a + b)` and dereference `*r`, `**r`, `*(&x)`: a value needs no
// reference, so the prefix's length goes and the value is read itself; 0 for a function reference `&name` or a star of
// a rest or spread
def reference_prefix_length(p: Parser, c: text, next: text): int {
	if c == '&' {
		if mutable_reference_at(p) { return 1 + MUT_WORD.length + 1 }
		if next == '&' or next == '(' or next == '[' or next == '"' or is_digit(next) { return 1 }
		return 0
	}
	operand = is_name_start(next) or next == '(' or next == '*' or next == '&'
	if c == '*' and operand and not star_is_rest_or_spread(p) then 1 else 0
}
MUT_WORD = "mut"
def mutable_reference_at(p: Parser): bool {
	end = name_end(p.code, p.at + 1, p.n)
	p.code[p.at + 1 .. end] == MUT_WORD and is_spacing(char_at(p, end))
}
def is_spacing(c: text): bool := c == ' ' or c == '\t'

// `a, *rest = xs`, `f(*xs)`, `*init, last = xs`, Python's `**kw`: a star after a comma or an opening bracket, or at a
// statement's start before a comma or `=`, gathers or spreads items
def star_is_rest_or_spread(p: Parser): bool {
	back = p.at - 1
	while back >= 0 and is_spacing(p.code[back]) { back -= 1 }
	before = if back < 0 then '\n' else p.code[back]
	if before == ',' or before == '(' or before == '[' { return true }
	if not (before == '\n' or before == ';' or before == '{') { return false }
	end = name_end(p.code, p.at + 1, p.n)
	after = end
	while is_spacing(char_at(p, after)) { after += 1 }
	char_at(p, after) == ',' or (char_at(p, after) == '=' and char_at(p, end + 1) != '=')
}

// `sorted(xs, >)`, `fold(xs, +)`, `[<, >=]`: an operator standing alone before a closing parenthesis or bracket or a
// comma is the operator itself, both sides ø; `..` also at the end of a pattern's rest (Point with x and the rest)
def operator_value(p: Parser): Node := {
	found = operator_at(p)
	if found.length == 0 { return ø }
	next_char = char_at(p, blank_end(p, p.at + found#1.length))
	ends_rest = next_char == '}' and (found#2 == ".." or found#2 == "to")
	if not (next_char == ')' or next_char == ',' or next_char == ']' or ends_rest) { return ø }
	p.at += found#1.length
	keyed(found#2, ø, ø)
}

// `a, *rest = xs`: the starred name takes the items the other names leave; JS's `...rest` is the starred `*rest` too,
// Python's `**kw` the starred `**kw`; ø unless a name follows the prefix
STAR_PREFIXES = [["...", "*"], ["**", "**"], ["*", "*"]]
def starred_name(p: Parser): Node := {
	for prefix in STAR_PREFIXES {
		start = p.at + prefix#1.length
		if at_text(p, prefix#1) and is_name_start(char_at(p, start)) {
			end = name_end(p.code, start, p.n)
			p.at = end
			return symbol(prefix#2 + p.code[start .. end])
		}
	}
	ø
}

// `:post` (wiki/symbol.md): the symbol itself, written as the call symbol("post"), never evaluated
def explicit_symbol_at(p: Parser): bool {
	before = if p.at == 0 then ' ' else p.code[p.at - 1]
	is_name_start(char_ahead(p, 1)) and (is_blank(before) or "([{,=".contains(before))
}

// `return x`, `return` alone: ø; `return = 1` assigns a name
def returned(p: Parser): Node := {
	before = p.at
	p.at += 6
	skip_spaces(p)
	op = operator_at(p)
	if op.length > 0 and binding_operators.contains(op#2) {
		p.at = before
		return atom(p)
	}
	c = char_here(p)
	value = ø
	if not (c == '}' or c == ';' or c == '\n' or c == '\r') { value = continued(p, expression(p, 59), 0) }
	// `return` alone is the word
	if value === ø then symbol("return") else spaced([symbol("return"), value])
}

// Binds a condition until `then`, `do` or the colon of `if c: x`
CONDITION_POWER = 81
// The condition of `if` and `while`: a braceless call takes a variable argument as in a branch (`if area certainly > 10
// then`, `while square i < 10`)
def condition_expression(p: Parser): Node := with_field(p, "branch_power", CONDITION_POWER, () => header_expression(p, CONDITION_POWER))

// Rust's `loop { … }` as `while true { … }`, ø when no block follows the word
def endless_loop(p: Parser): Node := {
	at = blank_end(p, p.at + 4)
	if char_at(p, at) != '{' { return ø }
	p.at = at + 1
	Key(Key(ø, Op.While, true), Op.Do, items_until(p, Bracket.Curly, ItemsEnd.Closer))
}

// `if c {…} else {…}`, `while c {…}`, `if c` and the lines indented below: the block after the condition is its
// branch or body
def conditioned(word: text, condition: Node, p: Parser): Node := {
	skip_spaces(p)
	body = ø
	if at_char(p, ':') {
		// `if c: x = 1 else: x = 2`: the body ends before the else
		body = with_field(p.group, "in_branch", word == "if", () => colon_body(p, 1))
	} else if at_char(p, '{') {
		advance(p)
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
	} else if at_body_start(p) {
		// `if a == 1 print "ok"`, `if (x < 0) return -1`, `while (i < 9) i++`: the statement on the condition's line
		body = with_field(p.group, "in_branch", word == "if", () => statement_words(p))
	} else {
		// `while m > 1` ending its line: the lines indented below; without
		// them `while x-- > 0` is a loop without a body, its condition does the work; `while c do …` takes its body
		// from the `do` that follows, as `if c then …` from its `then`
		body = if only_blanks_before_newline(p) then indented_block(p) else ø
		if body == ø { return if word == "while" and not keyword_at(p, "do") then Key(keyed(word, ø, condition), Op.Do, ø) else keyed(word, ø, condition) }
	}
	head = keyed(word, ø, condition)
	if word == "while" { return Key(head, Op.Do, body) }
	branches = Key(head, Op.Then, body)
	otherwise = else_branch(p)
	if otherwise.length == 0 { return branches }
	Key(branches, Op.Else, otherwise#1)
}

// The control words and the condition word each reads as: `unless c` is `if not c`, `until c` is `while not c`
CONTROL_WORDS = {"if": "if", "unless": "if", "while": "while", "until": "while"}
NEGATED_CONTROL_WORDS = ["unless", "until"]
def control_condition(word: text, condition: Node): Node := if NEGATED_CONTROL_WORDS contains word then Key(ø, Op.Not, condition) else condition

// `print it if it%2`, `do {i++} while c`: a trailing `if` guards and a trailing `while` loops the whole command, not its
// last word; else ø
def guarded_command(nodes: list): Node := {
	if nodes.length < 2 or nodes#1 is not symbol { return ø }
	match nodes#(nodes.length) {
		Key(head, Op.Do, body): { if bare_control(head, "while") then Key(head, Op.Do, command_with(nodes, body)) else ø }
		Key(head, Op.Then, body): { if bare_control(head, "if") then Key(head, Op.Then, command_with(nodes, body)) else ø }
		_: ø
	}
}
// `if c`, `while c` with nothing before the word
def bare_control(n: Node, control: text): bool := match n {
	Key(before, Op.If, test): control == "if" and before == ø
	Key(before, Op.While, test): control == "while" and before == ø
	_: no
}
// the command's words with its last one replaced by `tail`
def command_with(nodes: list, tail: Node): Node := spaced(nodes[0 .. nodes.length - 1] + [tail])

// `:` (no `:=`) or `{`: where a `to` header ends and its body starts
def at_to_header_end(p: Parser): bool := (at_char(p, ':') and char_ahead(p, 1) != '=') or at_char(p, '{')

// A type word, its plural (`numbers`) or a type the source declares
def known_type(word: text, types: list): bool := is_type_word(word) or plural_type_word(word) or types.contains(word)

// Whether a statement starts at the parser's position, no end of one, `then`, `else` or `do`
def at_body_start(p: Parser): bool {
	// the code after blanks and comments: `if n == 0 // zero` ends its line, its body on the next (card comment-after)
	c = if p.at >= p.n then '\n' else code_after(p, p.at)
	not (p.at >= p.n or "\n;,})]".contains(c)) and not keyword_at(p, "do") and not keyword_at(p, "then") and not keyword_at(p, "else")
}

// `else body`, also on the line after the branch, `else: body`, and `elif`/`elsif`/`elseif` chaining a new if; [] if
// no else follows
def else_branch(p: Parser): list {
	skip_spaces(p)
	at = p.at
	while at < p.n and is_blank(p.code[at]) { at += 1 }
	if at > p.at and p.code[p.at .. at].contains("\n") and keyword_at_position(p, "else", at) { p.at = at }
	if else_if_at(p) {
		p.at += word_at(p).length
		skip_spaces(p)
		return [conditioned("if", condition_expression(p), p)]
	}
	if not keyword_at(p, "else") { return [] }
	p.at += 4
	skip_spaces(p)
	if not at_char(p, ':') { return [branch(p, 74)] }
	advance(p)
	skip_spaces(p)
	[branch(p, 0)]
}

// A branch of an if; `then print x, y` and `else print ord x` are the call print(…) of the expressions after it
// A `then` or `else` branch is a statement: a braceless call there takes a variable, `then count xs`
def branch(p: Parser, min_power: int): Node := with_field(p, "branch_power", min_power, () => branch_assignment(p, branch_value(p, min_power), min_power))

// `if c then s += 5 else s = 0` assigns in the branch, the value stopping at `else`
def branch_assignment(p: Parser, target: Node, min_power: int): Node := {
	skip_spaces(p)
	op = operator_at(p)
	if op.length == 0 or not assigning_operators.contains(op#2) { return target }
	p.at += op#1.length
	skip_spaces(p)
	keyed(op#2, target, expression(p, min_power))
}

def branch_value(p: Parser, min_power: int): Node := {
	at = blank_end(p, p.at + 5)
	if not (keyword_at(p, "print") and at > p.at + 5 and starts_atom_at(p, at)) { return expression(p, min_power) }
	p.at = at
	print_call_from(p, one_expression(words_binding(p, min_power)), min_power)
}

def keyword_at_position(p: Parser, word: text, at: int): bool := starts_at(p.code, word, at, p.n) and not (at + word.length < p.n and is_name_char(p.code[at + word.length]))

// `for x in xs {…}` or `for each x in xs {…}`: the loop variable, the iterable and the body, else ø, nothing read
def looped(p: Parser): Node := {
	before = p.at
	p.at += 3
	skip_spaces(p)
	if keyword_at(p, "each") and not keyword_at_position(p, "in", spaces_end(p, p.at + 4)) {
		p.at += 4
	}
	named = named_loop(p)
	if named != ø { return named }
	p.at = before + 3
	skip_spaces(p)
	// `for(i=0;i<n;i++)`
	if at_c_style_for_head(p) { return c_style_for(p) }
	ranged = ranged_loop(p)
	if ranged == ø { p.at = before }
	ranged
}

// `(i=0;i<n;i++)`: a group here whose top level holds a `;`
def at_c_style_for_head(p: Parser): bool {
	if not at_char(p, '(') { return false }
	at = p.at
	depth = 0
	while at < p.n {
		c = p.code[at]
		skipped = if opens_text(c) then text_end(p.code, at + 1, closing_of(c), p.n) else comment_end(p.code, at, p.n)
		if skipped > at {
			at = skipped
		} else if "([{".contains(c) {
			depth += 1
		} else if ")]}".contains(c) {
			if depth == 1 { return false }
			depth -= 1
		} else if c == ';' and depth == 1 {
			return true
		}
		at += 1
	}
	false
}

// `for (i=0;i<3;i++) {…}`, `… : body`, `… do body`, the lines indented below or the rest of the statement: the call
// for(head) glued to the body as a block
def c_style_for(p: Parser): Node := {
	head = atom(p)
	skip_spaces(p)
	width = body_word_width(p)
	body = ø
	if width > 0 {
		body = colon_body(p, width)
	} else if at_char(p, '{') {
		body = atom(p)
	} else {
		body = indented_block(p)
		if body == ø { body = statement_words(p) }
	}
	listed(Bracket.None, Separator.None, [call_of([symbol("for"), head]), if is_block(body) then body else listed(Bracket.Curly, Separator.Semicolon, [body])])
}

// `each x in xs {…}` is `for each x in xs {…}`, else ø, nothing read
def each_loop(p: Parser): Node := {
	before = p.at
	p.at += 4
	skip_spaces(p)
	named = named_loop(p)
	if named == ø { p.at = before }
	named
}

// `x in xs {…}` after `for`: the loop over the named variable, else ø
def named_loop(p: Parser): Node := {
	variable = loop_variable(p)
	if variable == ø { return ø }
	skip_spaces(p)
	if not keyword_at(p, "in") { return ø }
	p.at += 2
	skip_spaces(p)
	iterable = iterable_words(p)
	skip_spaces(p)
	spaced([symbol("for"), variable, symbol("in"), iterable, loop_body(p)])
}

// A loop's iterable: one expression, or the words up to the body as a space list, `reverse xs` of
// `for x in reverse xs {…}`; in a comprehension, whose loop has no body, the words up to the closer or its
// `if`: `[c * 2 for c in reverse xs]`, `[c for c in cases of Coin]`
def iterable_words(p: Parser): Node := {
	p.iterable = true
	first = header_expression(p, 81)
	after_first = p.at
	words = [first]
	while true {
		skip_spaces(p)
		start = p.at
		if p.at >= p.n or at_loop_body(p) or ITERABLE_ENDS.contains(char_here(p)) or keyword_at(p, "if") or comprehension_clause_at(p) or comprehension_filter_at(p) { break }
		// a rule's hole after the iterable is the loop's body, `for $i in 1 to $n $body` (card sugar-comprehensions)
		if words.length == 1 and at_char(p, '$') and is_name_start(char_ahead(p, 1)) {
			p.iterable = false
			return first
		}
		words += [header_expression(p, 81)]
		if p.at == start { break }
	}
	p.iterable = false
	ends_clause = in_comprehension(p) and (p.at >= p.n or ITERABLE_ENDS.contains(char_here(p)) or keyword_at(p, "if") or keyword_at(p, "for") or keyword_at(p, "where"))
	if words.length == 1 or not (at_loop_body(p) or ends_clause) {
		p.at = after_first
		return first
	}
	spaced(words)
}

ITERABLE_ENDS = ";}]),"

// A loop's body starts here: `{…}`, `: …`, `do …`, or the next line
def at_loop_body(p: Parser): bool {
	c = char_here(p)
	c == '{' or c == ':' or c == '\n' or at_text(p, "//") or keyword_at(p, "do") or body_hole_at(p)
}

// In a list or braces, where a loop is a comprehension's clause: `[x * 2 for x in reverse xs]`
def in_comprehension(p: Parser): bool := p.group.bracket == Bracket.Square or p.group.bracket == Bracket.Curly

// A comprehension's next clause, which ends the iterable before it: `for b` of `[a + b for a in xs for b in ys]`
def comprehension_clause_at(p: Parser): bool := in_comprehension(p) and keyword_at(p, "for")
// A comprehension's filter, which ends the iterable before it as `if` does: `where x > 2` of `[x for x in xs where x > 2]`
def comprehension_filter_at(p: Parser): bool := p.iterable and in_comprehension(p) and keyword_at(p, "where")

// A rule's hole ending a loop's header is its body: `$body` of `for $i in 1 to $n $body`, then the line's end, a
// closer or the rule's `where`; in a comprehension the loop is an each clause (`[$c for $c in cases of $e]`), its
// iterable ending there
def body_hole_at(p: Parser): bool {
	if in_comprehension(p) or not (at_char(p, '$') and is_name_start(char_ahead(p, 1))) { return false }
	after = spaces_end(p, name_end(p.code, p.at + 1, p.n))
	after >= p.n or "\n;)}]".contains(p.code[after]) or keyword_at_position(p, "where", after)
}

// `for 1…100: print it`, `for xs {…}` and `for 0 to 2` with the lines indented below: a loop over the iterable without
// a name, its body a block; ø if no body follows
def ranged_loop(p: Parser): Node := {
	iterable = iterable_words(p)
	skip_spaces(p)
	width = body_word_width(p)
	body = ø
	if width > 0 {
		body = colon_body(p, width)
	} else if at_char(p, '{') {
		body = atom(p)
	} else {
		body = indented_block(p)
	}
	if body == ø { return ø }
	// a colon body stays bare, as in `for i in xs: x`
	spaced([symbol("for"), iterable, body])
}

// A loop's body: `{…}`, `: words`, `do words`
def loop_body(p: Parser): Node := {
	width = body_word_width(p)
	if width == 2 {
		p.at += width
		if closing_end_follows(p, END_BLOCK_OPENERS) { return end_block(p, false) }
		p.at -= width
	}
	if width > 0 { return colon_body(p, width) }
	block = indented_block(p)
	if block != ø { return block }
	// `[x for x in xs where x > 2]`: a comprehension's `where` filters as its `if`
	if in_comprehension(p) and keyword_at(p, "where") {
		p.at = p.at + "where".length
		return symbol("if")
	}
	atom(p)
}

def body_word_width(p: Parser): int {
	if at_char(p, ':') { return 1 }
	if keyword_at(p, "do") { return 2 }
	0
}

// The words up to the end of the statement, one expression: `print ord c` of `for c in s: print ord c`
def statement_words(p: Parser): Node := {
	words = words_binding(p, 0)
	// `for i in 1…3: print i, i*2` prints both
	if words.length >= 2 and words#1 == PRINT and at_char(p, ',') { return print_call_from(p, one_expression(words[1:]), 0) }
	if words.length == 1 { return words#1 }
	phrase(Bracket.None, words)
}

// The words of an expression up to a comma, the line's end or an `else`, each binding at least `min_power`
def words_binding(p: Parser, min_power: int): list {
	words = []
	while true {
		words = words + [expression(p, min_power)]
		skip_spaces(p)
		if ends_branch(p) or not starts_atom(p) { break }
	}
	words
}

def one_expression(words: list): Node := if words.length == 1 then words#1 else spaced(words)

// The call print(first, …): the arguments after `first` follow commas, each the words up to the next one
def print_call_from(p: Parser, first: Node, min_power: int): Node := {
	arguments = [first]
	while at_char(p, ',') {
		advance(p)
		skip_spaces(p)
		arguments += [one_expression(words_binding(p, min_power))]
	}
	call_of([PRINT] + arguments)
}

def ends_branch(p: Parser): bool := keyword_at(p, "else") or else_if_at(p)

def else_if_at(p: Parser): bool := keyword_form(word_at(p)) == "else if"

def starts_atom(p: Parser): bool := starts_atom_at(p, p.at)

def starts_atom_at(p: Parser, at: int): bool {
	c = char_at(p, at)
	is_name_start(c) or is_digit(c) or opens_text(c) or c == '(' or c == '[' or c == '{' or (c == '@' and is_name_start(char_at(p, at + 1))) or starts_path_at(p, at)
}

// `x`, `k, v` or `(k, v)`: the names a loop gives each item, else ø
def loop_variable(p: Parser): Node := {
	bracket = Bracket.None
	if at_char(p, '(') {
		bracket = Bracket.Round
		advance(p)
	}
	names = []
	while true {
		skip_spaces(p)
		// a rule's name hole `$item` stands for the name: `for $item in $xs {…}`
		hole = if at_char(p, '$') then 1 else 0
		if not is_name_start(char_ahead(p, hole)) { return ø }
		end = name_end(p.code, p.at + hole, p.n)
		names = names + [symbol(p.code[p.at .. end])]
		p.at = end
		skip_spaces(p)
		if not at_char(p, ',') { break }
		advance(p)
	}
	if bracket == Bracket.Round {
		if not at_char(p, ')') { return ø }
		advance(p)
	}
	if names.length == 1 { return names#1 }
	listed(bracket, Separator.Comma, names)
}

// The atom at the parser's position at its line and column: a warning or error
// about it names where it stands (card front-end-warnings)
def atom(p: Parser): Node := {
	start = p.at
	found = bare_atom(p)
	if found === ø { return found }
	placed_at(p, found, start)
}

// The node, written at the source's offset `start`: its line and column
def placed_at(p: Parser, n: Node, start: int): Node := {
	line = line_at(p, start)
	line_start = p.line_starts[line - 1]
	positioned(n, line, start - line_start + 1 + shifted(p, line_start, start))
}

// How many columns a source pass took out of the line from `line_start` before `at` (`\:alpha` written, α read), so
// a node keeps the column it is written at (core/extension.warp source_passes)
def shifted(p: Parser, line_start: int, at: int): int {
	columns = 0
	for shift in p.shifts { if shift#1 > line_start and shift#1 <= at { columns += shift#2 } }
	columns
}
// The offset in the parsed code of a written column of the line from `line_start`: shifted's inverse
def code_offset(p: Parser, line_start: int, column: int): int {
	at = line_start + column - 1
	while at - line_start + shifted(p, line_start, at) > column - 1 { at -= 1 }
	at
}

// Where each line of the source starts
def line_starts_of(source: text): list {
	starts = [0]
	for at in 0 ..< source.length { if source[at] == '\n' { starts += [at + 1] } }
	starts
}

// The line (from 1) holding the position `at`, by bisection of the line starts
def line_at(p: Parser, at: int): int {
	first = 0
	last = p.line_starts.length
	while last - first > 1 {
		middle = (first + last) ÷ 2
		if p.line_starts[middle] <= at { first = middle } else { last = middle }
	}
	first + 1
}

// the type words naming a kind of number, `number` itself not
NUMBER_TYPE_WORDS = ["int", "integer", "long", "i64", "i32", "rational", "real", "exact", "precise", "float", "double", "f64", "f32", "float32", "float64", "fast"]
// the number a literal was written as: a float with a point or an exponent, else an int
def written_number(written: text): Node := if written.contains(".") or written.contains("e") then float(written) else whole_number(written)
// the int a literal's digits write; beyond 64 bits, `1e20` and `100000000000000000000`, the number view of its digits,
// an exact big int to the host and to the run (emitter.warp; card exponent-literal-overflow)
INT_MAX_DIGITS = "9223372036854775807"
def whole_number(digits: text): Node := {
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	fits = #significant < #INT_MAX_DIGITS or (#significant == #INT_MAX_DIGITS and significant <= INT_MAX_DIGITS)
	if fits then int(digits) else opaque(["number", significant])
}
// a decimal literal: past 18 places, a denominator beyond int64, the number view of its own digits, which the
// emitter makes an exact ratio of a big denominator, never a float (decision exact-decimal-big); any other a float,
// which the emitter reads exact where it can (literals.warp)
DECIMAL_PLACES_IN_INT = 18
def decimal_value(written: text): Node := {
	shown = written
	while shown.ends_with("0") { shown = shown[0 ..< #shown - 1] }
	if #shown.split(".")#2 > DECIMAL_PLACES_IN_INT then opaque(["number", shown]) else float(written)
}

// A number, text, name or bracketed group: a name reads at once, any other atom by the row of its first character
// (decision atoms-as-rows), else as the character it is
def bare_atom(p: Parser): Node := {
	if p.at >= p.n { return ø }
	c = p.code[p.at]
	if is_name_start(c) { return named_atom(p) }
	reader = atom_reader_of(c)
	start = p.at
	read = if reader == ø then ø else reader(p)
	// a reader that moved read its atom, ø too; one answering ø unmoved leaves the character to character_atom
	if read != ø or p.at != start then read else character_atom(p, c)
}
// The atoms by their first character: each reader reads its atom at the parser's position, or answers ø unmoved when
// the character starts none of its forms; extensions add theirs (core/extension.warp atom_readers), a character two
// rows claim is refused loudly
def core_atom_rows(): list := [reading_rows("0123456789".chars(), number_atom), reading_rows(["\"", "'", "«"], p => quoted(p)), {".": dot_atom, "*": starred_name, "$": pattern_hole, "(": group_atom, "[": group_atom, "{": group_atom}]
def reading_rows(characters: list, reader: function): map {
	rows = {}
	for c in characters { rows["$(c)"] = reader }
	rows
}
global atom_rows = ø
// the reader of the atom a character starts, else ø
def atom_reader_of(c: text): any {
	if atom_rows == ø { atom_rows = claimed_once(core_atom_rows() + EXTENSIONS.map(extension => extension.atom_readers)) }
	atom_rows.get("$(c)")
}
// a name, or a loop where an atom stands: the body of a comprehension's clause, `[a + b for a in xs for b in ys]`
def named_atom(p: Parser): Node := {
	loop = if keyword_at(p, "for") then looped(p) else if keyword_at(p, "each") then each_loop(p) else ø
	if loop != ø then loop else named(p)
}
def number_atom(p: Parser): Node := {
	// a number form an extension reads, `0xff`, `2024-01-31` (core/extension.warp number_readers)
	for reader in number_readers() {
		form = reader(p)
		if form != ø { return form }
	}
	number_start = p.at
	written = decimal_number(p)
	// a number with a suffix an extension reads, `0.1f`, `1 month` (core/extension.warp number_suffix_readers)
	literal = p.code[number_start .. p.at]
	for reader in number_suffix_readers() {
		form = reader(p, written, literal)
		if form != ø { return form }
	}
	// `0.5:float`, `2.5:int`: a number type glued after a colon binds tightly, unlike the loose `as`
	glued_type = if char_here(p) == ':' then p.code[p.at + 1 .. name_end(p.code, p.at + 1, p.n)] else ""
	if NUMBER_TYPE_WORDS.contains(glued_type) {
		p.at += 1 + glued_type.length
		return Key(written_number(written), Op.As, symbol(glued_type))
	}
	// two returns and `amount: any`: an `if` of float(…) and int(…), a parameter float elsewhere, make an int beyond
	// i64 a float (card int-beyond)
	// `1.5e-7` is a float, as measurements and other programs write it (decision exact-decimals); `1e3` stays the integer 1000 (decimal_number writes its zeros), `0.5` exact
	if written.contains("e") { return Key(float(written), Op.As, symbol("float")) }
	with_glued_factor(p, if written.contains(".") then decimal_value(written) else whole_number(written))
}
// `.5` is 0.5, `...xs` spreads xs; Swift's `.north`, a member of the type the context expects (a match arm's case),
// also a rule's `.$k`
def dot_atom(p: Parser): Node := {
	next = char_ahead(p, 1)
	if is_digit(next) { return decimal_value("0" + decimal_number(p)) }
	if next == '.' { return starred_name(p) }
	if not (is_name_start(next) or next == '$') { return ø }
	advance(p)
	Key(ø, Op.Dot, atom(p))
}
// `$a`, a pattern's name hole: `data($a + 0)`; `$0`, a function's first parameter. `$f(x)`, `$f(x) {…}`: a hole
// applied reads as the name it stands for applied, its arguments read as a call's (typed_parameters): `$f($x)`
def pattern_hole(p: Parser): Node := {
	next = char_ahead(p, 1)
	if not (is_name_start(next) or is_digit(next)) { return ø }
	end = symbol_end(p.code, p.at + 1, p.n)
	hole = symbol(p.code[p.at .. end])
	p.at = end
	name_or_call(p, hole)
}
def group_atom(p: Parser): Node := {
	c = p.code[p.at]
	advance(p)
	round = c == '('
	group = with_field(p, "header", p.header and round, () => with_field(p, "iterable", p.iterable and round, () => if c == '{' then braced_items(p) else items_until(p, c as Bracket, ItemsEnd.Closer)))
	// `(int or text)?`: an optional union, the one type word `int or text?` (a member ø joins is the union's)
	union = if c == '(' and #group == 1 and optional_mark_follows(p, "") then union_spelling(group#1) else ø
	if union == ø { return group }
	advance(p)
	symbol(union + "?")
}
// `∅`, the empty set sign, is ø while warp has no sets (decision empty-is-not-missing); a closer ends the atoms. Every
// other character is read: a free symbol names itself, `x = ↯`, `⌘`; any other one is its character, `★`
// (card unicode-glyphs)
def character_atom(p: Parser, c: text): Node := {
	if c == ')' or c == ']' or c == '}' or c == ';' { return ø }
	if c == 'ø' or c == '∅' {
		advance(p)
		return ø
	}
	// `"̅"`: a quote carrying combining marks is one grapheme of the code; the marks open the text (card parser-graphemes)
	if opens_text(code_points("$(c)")#1) { return quoted(p) }
	advance(p)
	if is_free_symbol(p, c) then symbol("$(c)") else c
}

// The Unicode blocks of symbols a program may use before anything defines them (decision unicode-symbols): arrows,
// math operators, technical and geometric symbols, dingbat arrows, the supplemental math and arrow blocks
FREE_SYMBOL_BLOCKS = [['←', '⏿'], ['■', '◿'], ['➔', '➿'], ['⟀', '⟿'], ['⤀', '⫿'], ['⬀', '⯿'], ['￩', '￬']]
// A symbol character no built-in operator, prefix operator or alias spells: a free operator or symbol name
def is_free_symbol(p: Parser, c: text): bool {
	glyph = "$(c)"
	// a declared operator calls as declared: `prefix operator ∆` makes `print ∆ 5` print ∆(5), no free infix
	if glyph.length != 1 or aliases_starting(p, glyph).any(alias => alias.spelling == glyph) or symbol_operator(glyph) != ø or owned_glyph(p, glyph) { return false }
	FREE_SYMBOL_BLOCKS.any(block => c >= block#1 and c <= block#2)
}
// `1 ⇔ 1` with no `infix operator ⇔` declared: a free symbol with an operand after it on its line calls its operator;
// `[↯ ↯]` and `print ↯` read the glyph as a value
def free_infix_at(p: Parser, left: Node): bool := left != ø and is_free_symbol(p, char_here(p)) and operand_follows(p, 1) and not is_free_symbol(p, code_after(p, p.at + 1))

// The URL after its scheme word, up to a blank, a separator, a closer or a quote
def url_text(p: Parser, scheme: text): text {
	end = p.at
	while end < p.n and not " \t\n\r;)]}>\"',«".contains(p.code[end]) { end += 1 }
	url = scheme + p.code[p.at .. end]
	p.at = end
	url
}

// A file path without quotes starts here, glued to what follows and not to an operand before it: `./a.wav`,
// `../songs/a.wav`, `./` alone, `~/notes.txt`, `/etc/hosts` (`x = /tmp`, `[/a, /b]`); after an operand too, by its
// spacing (decision path-after-operand): `show /tmp` is show(/tmp), while `a / b`, `a/b` and `x /2` divide
def starts_path(p: Parser): bool := starts_path_at(p, p.at)

def starts_path_at(p: Parser, at: int): bool {
	c = char_at(p, at)
	if at > 0 and is_operand_end(p.code[at - 1]) { return false }
	if c == '.' {
		dots = if char_at(p, at + 1) == '.' then 2 else 1
		after = char_at(p, at + dots + 1)
		return char_at(p, at + dots) == '/' and (not ends_path(after) or not operand_follows_at(p, at + dots + 1))
	}
	// `cd ~` alone; `a ~ b` stays the comparison
	if c == '~' { return char_at(p, at + 1) == '/' or not operand_follows_at(p, at + 1) }
	if c == '/' { return starts_path_name(char_at(p, at + 1)) }
	false
}

// The path at the parser's position, up to a blank, a closer or a separator, as a text
def path_literal(p: Parser): text {
	end = p.at
	while end < p.n and not ends_path(p.code[end]) { end += 1 }
	path = p.code[p.at .. end]
	p.at = end
	path
}

def is_operand_end(c: text): bool := is_name_char(c) or c == ')' or c == ']' or c == '}' or c == '"' or c == '\'' or c == '»'
def ends_path(c: text): bool := is_blank(c) or c == ']' or c == ')' or c == '}' or c == ',' or c == ';'
def starts_path_name(c: text): bool := is_name_start(c) or c == '.'

// `2x` is 2*x, `500ms` is 500*ms, `3(4)` is 3*(4): a name or `(` glued to a number multiplies it; ordinals `1st` do not
def with_glued_factor(p: Parser, amount: Node): Node := {
	c = char_here(p)
	if not (is_name_start(c) or c == '(' or atom_reader(c) != ø) or ORDINAL_SUFFIXES.contains(p.code[p.at .. name_end(p.code, p.at, p.n)]) {
		return amount
	}
	factor = atom(p)
	suffixed = read_suffix(p, factor, 0)
	Key(amount, Op.Mul, if suffixed == ø then factor else suffixed)
}

ORDINAL_SUFFIXES = ["st", "nd", "rd", "th"]

// The words of a block of code, also glued to it: `loop{…}` loops, `do{…}` runs its block, an extension's beside
// them (`go{…}`, extensions/tasks.warp); no tags `loop:{…}`
GLUED_BLOCK_WORDS = ["loop", "do"]

// A name and what is glued to it: `f(x)` calls f, `f(x) {…}` defines it, `a{…}` is the tagged block `a:{…}`
def named(p: Parser): Node := {
	bang = bang_word_at(p)
	end = if bang > 0 then p.at + bang else symbol_end(p.code, p.at, p.n)
	joined = joined_type_name(p, p.code[p.at .. end], end)
	word = joined#1
	p.at = joined#2
	if keyword_form(word) == "reference" {
		referenced = function_reference(p)
		if referenced != ø { return referenced }
	}
	if word == "wasm" {
		instruction = wasm_instruction_after(p)
		if instruction != ø { return instruction }
	}
	if optional_mark_follows(p, word) {
		advance(p)
		return symbol(word + "?")
	}
	// `list<int>`, `option<int>`: a type applied to type arguments, the type written in words; a declared `Box<T>`
	// keeps its brackets
	type_arguments = if p.types.contains(word) then 0 else type_application_length(p, p.at)
	if type_arguments > 0 {
		arguments = p.code[p.at + 1 .. p.at + type_arguments - 1]
		p.at += type_arguments
		return symbol(type_application_name(word, arguments))
	}
	constant = if names_case(p, word.length) then "" else keyword_form(word.lower())
	if constant == "true" { return true }
	if constant == "false" { return false }
	if constant == "empty" and not names_key(p) { return ø }
	// `https://pannous.com`, `ssh://host`: a URL, the rest of which reads as one text
	if p.code[p.at .. min(p.at + 3, p.n)] == "://" { return url_text(p, word) }
	// the Java/C array type `int[]` is the list type `[int]`
	if at_text(p, "[]") and is_type_argument(word) {
		p.at += 2
		return listed(Bracket.Square, Separator.Space, [symbol(word)])
	}
	// Rust's turbofish `sum::<i32>()`, `collect::<Vec<i32>>()`: the type arguments say nothing warp needs, the call is
	// `sum()`
	turbofish = if at_text(p, "::") then type_application_length(p, p.at + 2) else 0
	if turbofish > 0 { p.at = p.at + 2 + turbofish }
	name = symbol(word)
	// `x°`: a name glued to an atom an extension reads multiplies it, as `30°` (core/extension.warp atom_readers)
	if atom_reader(char_here(p)) != ø and not is_alpha(char_ahead(p, 1)) { return Key(name, Op.Mul, atom(p)) }
	// a signature's result type, `def hz(xs): Hz {…}`, is no construction: its block is the body
	if result_body_follows(p, word, p.at) { return name }
	// `Point {x: 1}` with blanks constructs a declared type as the glued one does (open decision 41); a capitalized word
	// of no declared type before a block of fields is the tagged object `Person:{…}` (card person-name)
	declared = p.types.contains(word)
	if (declared or is_capitalized(word)) and block_after_blanks(p, declared) { skip_spaces(p) }
	if at_char(p, '{') {
		if GLUED_BLOCK_WORDS.contains(word) or word in extension_block_words() { return name }
		advance(p)
		// `Point{x: 1}` of a declared type constructs a point, any other `name{…}` stays the tagged block (D4)
		return Key(name, if declared then Op.None else Op.Colon, braced_items(p))
	}
	name_or_call(p, name)
}
// the name, or its call `name(x, y)` when a round group follows it, with the block side by side after it
// (`f(x) {…}`)
def name_or_call(p: Parser, name: Node): Node := {
	if not at_char(p, '(') { return name }
	advance(p)
	written = items_until(p, Bracket.Round, ItemsEnd.Closer)
	arguments = typed_parameters(written)
	skip_spaces(p)
	if at_char(p, '{') and not p.header {
		advance(p)
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
		// the head is the call f(x, y)
		return call_of([call_of([name] + spread(arguments)), body])
	}
	call_of([name] + spread(arguments))
}

// The type names that take type arguments in angle brackets besides the plural and capitalized ones
GENERIC_TYPE_HEADS = ["list", "array", "set", "map", "option", "result", "tuple"]
OPTION_HEADS = ["option", "Option"]

// The length of the type arguments `<int>`, `<list<int>>`, `<text, int>` at `start`, 0 unless every word in them
// names a type (`i<n>` compares)
def type_application_length(p: Parser, start: int): int {
	if char_at(p, start) != '<' { return 0 }
	depth = 0
	words = []
	// a word is the slice since the last other character, not built a character at a time
	word_start = start
	for at in start ..< p.n {
		c = p.code[at]
		if is_alphanumeric(c) or c == '_' or c == '?' { continue }
		if c == '<' {
			depth += 1
		} else if c == '>' {
			depth -= 1
		} else if not ", ()".contains(c) {
			return 0
		}
		if at > word_start { words += [p.code[word_start .. at]] }
		word_start = at + 1
		if depth == 0 { return if at > start + 1 and words.all(is_type_argument) then at - start + 1 else 0 }
	}
	0
}

// `int`, `ints`, `list`, `Point`, `text?`: a word that can stand in type arguments
def is_type_argument(word: text): bool := is_type_name(if word.ends_with("?") then word[0 ..< word.length - 1] else word)

// A word that can take type arguments: a type word, its plural, `list`, `map` …, a capitalized type
def is_type_name(word: text): bool := is_type_word(word) or (word.ends_with("s") and is_type_word(word[0 ..< word.length - 1])) or word in GENERIC_TYPE_HEADS or is_capitalized(word)

// The type `name<arguments>` in words: `list<list<int>>` is `list of list of int`, `option<int>` is `int?`, Rust's
// `Vec<i32>` is `list of i32`
def type_application_name(name: text, arguments: text): text {
	if OPTION_HEADS.contains(name) and not arguments.contains(",") and not arguments.contains("<") { return arguments.trim() + "?" }
	head = if foreign_list_heads.contains(name) then "list" else name
	words = arguments.replace("<", " of ").replace(">", "").split(" ").filter(w => w)
	head + " of " + words.join(" ")
}

// `x:int?=ø`, `f(x:int?)`, the field `right? }`: the `?` after `word` marks it optional when a closer, `=`, a comment,
// the next field or a declaration follows; a ternary `?` is followed by its branch instead
def optional_mark_follows(p: Parser, word: text): bool {
	if not at_char(p, '?') { return false }
	after = p.at + 1
	ends_optional_type(char_at(p, after), char_at(p, after + 1)) or closes_after_blanks(p, after) or next_field_follows(p, after) or declaration_follows(p, word, after) or result_body_follows(p, word, after)
}

// `def f(x: int): list? {…}`: `word` follows a signature's `):` and spaces or tabs from `at` lead to a `{`, so it is
// an optional result type before the body, no ternary (decision optional-result)
def result_body_follows(p: Parser, word: text, at: int): bool {
	colon = blank_before(p, p.at - word.length)
	body = spaces_end(p, at)
	body > at and char_at(p, body) == '{' and colon > 0 and char_at(p, colon) == ':' and blank_before(p, colon) >= 0 and char_at(p, blank_before(p, colon)) == ')'
}

// The position of the last character before `at` that is no blank, -1 at the source's start
def blank_before(p: Parser, at: int): int {
	before = at - 1
	while before >= 0 and is_blank(p.code[before]) { before -= 1 }
	before
}

// What ends an optional type after its `?`: a closer, a separator, the line's or source's end, or an assignment's `=`
def ends_optional_type(next: text, after: text): bool := ")]},;\n\r".contains(next) or (next == '=' and after != '=')

// Spaces or tabs from `at`, then a comment or what ends an optional type
def closes_after_blanks(p: Parser, at: int): bool {
	end = spaces_end(p, at)
	comment_starts = char_at(p, end) == '/' and "/*".contains(char_at(p, end + 1))
	end > at and (comment_starts or ends_optional_type(char_at(p, end), char_at(p, end + 1)))
}

// Inside a type's body, spaces or tabs from `at`, then the next field `name:` (no `:=`, no `::`)
def next_field_follows(p: Parser, at: int): bool {
	start = spaces_end(p, at)
	colon = name_end(p.code, start, p.n)
	p.type_body and start > at and colon > start and char_at(p, colon) == ':' and not "=:".contains(char_at(p, colon + 1))
}

// After the type word `word`, spaces or tabs from `at`, then the definition `:=` or a declared name `i =`: `int? i = 3`
// and `as int? := …` are optional types, no ternary; `f(): Name? := …` also of a type the program does not declare (a
// used file's), as a ternary has no empty branch
def declaration_follows(p: Parser, word: text, at: int): bool {
	start = spaces_end(p, at)
	name_after = name_end(p.code, start, p.n)
	assigned = if name_after == start then start else spaces_end(p, name_after)
	assigns = if char_at(p, assigned) == ':' then char_at(p, assigned + 1) == '=' else char_at(p, assigned) == '=' and char_at(p, assigned + 1) != '='
	start > at and assigns and (name_after == start or is_type_word(word) or p.types.contains(word))
}

// After the spaces and tabs from `at` on
def spaces_end(p: Parser, at: int): int := blanks_end(p.code, at, p.n)

// Blanks, then a block of fields: `{}`, `{ name: …`, or with `assignments` `{ x = 1 …` (its first entry may start on
// the next line)
def block_after_blanks(p: Parser, assignments: bool): bool {
	at = blank_end(p, p.at)
	if at == p.at or char_at(p, at) != '{' { return false }
	first = at + 1
	while first < p.n and is_blank(p.code[first]) { first += 1 }
	if char_at(p, first) == '}' { return true }
	end = name_end(p.code, first, p.n)
	if end == first { return false }
	after_name = blank_end(p, end)
	c = char_at(p, after_name)
	following = char_at(p, after_name + 1)
	(c == ':' and following != '=') or (assignments and c == '=' and following != '=')
}

// `wasm f64.floor`: a function body that is one wasm instruction (decision wasm-instruction-body), ø when no
// `type.operation` follows
def wasm_instruction_after(p: Parser): Node := {
	if not at_char(p, ' ') { return ø }
	type_end = name_end(p.code, p.at + 1, p.n)
	if type_end == p.at + 1 or char_at(p, type_end) != '.' { return ø }
	end = name_end(p.code, type_end + 1, p.n)
	if end == type_end + 1 { return ø }
	name = p.code[p.at + 1 .. end]
	p.at = end
	if name not in wasm_instructions and name not in memory_instructions { return error_node("wasm " + name + " is no instruction warp takes: the ones on i64 and f64 and the memory's, e.g. wasm f64.sqrt, wasm f64.load") }
	call_of([symbol("wasm_instruction"), name])
}

// A case of an enum, no constant: `Node.True`, `Node::Empty`, `None` in `enum Bracket { Round, None }`
// `{empty: yes}`, `Kind = {Empty: 0}`, `class Cell{empty: bool}`: a word naming ø with a `:` glued to it is a name,
// not with the definition `:=` nor the scope `::`
def names_key(p: Parser): bool := char_here(p) == ':' and not "=:".contains(char_ahead(p, 1))

def names_case(p: Parser, length: int): bool {
	start = p.at - length
	if p.enum_cases or (start > 0 and p.code[start - 1] == '.') { return true }
	if not (start > 1 and p.code[start - 2 .. start] == "::") { return false }
	scope = start - 2
	while scope > 0 and is_name_char(p.code[scope - 1]) { scope -= 1 }
	scope < start - 2 and p.code[scope].upper() == p.code[scope] and p.code[scope].lower() != p.code[scope]
}

// The items of a `{…}` group, the parser after its `{`; after `enum Name` they are the enum's cases
def braced_items(p: Parser): Node := with_field(p, "enum_cases", p.enum_cases or enum_body_at(p), () => items_until(p, Bracket.Curly, ItemsEnd.Closer))

// The `{` just read follows `enum Name`
def enum_body_at(p: Parser): bool {
	end = p.at - 1
	while end > 0 and is_blank(p.code[end - 1]) { end -= 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start -= 1 }
	if start == end { return false }
	keyword_end = start
	while keyword_end > 0 and is_blank(p.code[keyword_end - 1]) { keyword_end -= 1 }
	keyword_end >= 4 and p.code[keyword_end - 4 .. keyword_end] == "enum" and (keyword_end == 4 or not is_name_char(p.code[keyword_end - 5]))
}

// `function add`, `func add`: the function add itself, where the expression ends after the name (or `on`, `is`
// follows: `map function square on xs`); `function add(x) {…}` defines it
// `function f`, `func f`: the function f as a value, marked (FUNCTION_REFERENCE_MARK), so the closure pass makes it a closure, a nested one too
FUNCTION_REFERENCE_MARK = "function_reference"
def function_reference(p: Parser): Node := {
	at = blank_end(p, p.at)
	if at == p.at or at >= p.n or not is_alpha(p.code[at]) { return ø }
	end = name_end(p.code, at, p.n)
	rest = blank_end(p, end)
	next_word = p.code[rest .. name_end(p.code, rest, p.n)]
	if not (rest >= p.n or ";,)]}\n".contains(p.code[rest]) or next_word == "on" or next_word == "is") { return ø }
	p.at = end
	attributed(FUNCTION_REFERENCE_MARK, true, symbol(p.code[at .. end]))
}

// The items of an argument list: none for ø, the list's items, else the one argument. A comma separates arguments,
// a blank joins the words of one: `f(4, s)` is f of 4 and s, `square(square 2)` and `str(3 meter)` take one; Swift's
// labeled parameter `greet(person name: String)` stays one argument too
def spread(arguments: Node): list {
	if arguments == ø { return [] }
	parts = group_parts(arguments)
	if parts == ø or labeled_parameter(parts) { return [arguments] }
	if parts#2 != " " or #parts#3 < 2 { return parts#3 }
	// the words of the one argument, a phrase as between commas: `f(square 3)` as `f(square 3, 2)` holds it
	[if parts#1 == "(" then spaced(parts#3) else arguments]
}

// Every argument of `f(int x, float y)` as its typed parameter
def typed_parameters(arguments: Node): Node := {
	parts = group_parts(arguments)
	if parts == ø or parts#2 != "," or #parts#3 == 0 { return typed_parameter(arguments) }
	listed(parts#1 as Bracket, Separator.Comma, [typed_parameter(argument) for argument in parts#3])
}

// `f(int x)`, Go's `f(x int)`, `f(s Shape)` and `f(x of int)` as the typed parameter x:int; `f(vararg xs)`,
// `f(params int[] xs)` the rest parameter *xs; `f(int b = 2)` as b:int = 2; any other argument as it is
def typed_parameter(argument: Node): Node := {
	parts = group_parts(argument)
	if parts != ø and parts#1 == "(" and #parts#3 == 1 and is_optional_name(parts#3#1) { return listed(Bracket.Round, parts#2 as Separator, [optional_parameter(parts#3#1)]) }
	if is_optional_name(argument) { return optional_parameter(argument) }
	if parts == ø or parts#2 != " " or parts#1 == "[" or #parts#3 == 0 { return argument }
	words = parts#3
	first = words#1
	last = words#(words.length)
	if words.length == 2 and is_type_symbol(first) and is_symbol(last) { return Key(last, Op.Colon, first) }
	if words.length == 2 and is_symbol(first) and not is_type_symbol(first) and (is_type_symbol(last) or (is_symbol(last) and is_capitalized(name_of(last)))) {
		return Key(first, Op.Colon, last)
	}
	if words.length == 3 and words#2 == symbol("of") and is_type_symbol(last) and is_symbol(first) and not is_type_symbol(first) {
		return Key(first, Op.Colon, last)
	}
	// `xs: list of int`, parsed `(xs: list) of int`: the words after the type are the type's
	if words.length > 2 and is_typed_name(first) and words#2 == symbol("of") { return type_continued(first, words[1 ..]) }
	if is_symbol(first) and REST_MARKERS.contains(name_of(first)) { return rest_parameter(last, argument) }
	if words.length == 2 and is_type_symbol(first) { return typed_default(last, first, argument) }
	argument
}

// `vararg xs`, `params int[] xs: list` as the rest parameter *xs
def rest_parameter(last: Node, argument: Node): Node := match last {
	Symbol(name): symbol("*" + name)
	Key(name, Op.Colon, kind): { if name is symbol then symbol("*" + name_of(name)) else argument }
	_: argument
}

// `f(x?)`: the optional parameter x, ø where a call leaves it out, as `f(x = ø)`. A parser case, not a rule: the parser
// reads `x?` as the one name `x?`, and no rule pattern takes a name apart (F5 glues names in templates only)
def optional_parameter(argument: Node): Node := if is_optional_name(argument) then Key(symbol(name_of(argument).remove_suffix("?")), Op.Assign, ø) else argument
def is_optional_name(argument: Node): bool := is_symbol(argument) and name_of(argument).length > 1 and name_of(argument).ends_with("?")

// `int b = 2` as b:int = 2
def typed_default(last: Node, kind: Node, argument: Node): Node := match last {
	Key(name, Op.Assign, value): { if name is symbol then Key(Key(name, Op.Colon, kind), Op.Assign, value) else argument }
	_: argument
}

// The rest-parameter markers: Kotlin's `vararg xs`, C#'s `params int[] xs`
REST_MARKERS = ["vararg", "params"]

def is_type_symbol(node: Node): bool := is_symbol(node) and is_type_word(name_of(node))

// `person name: String`: a label, then the typed parameter, of a group's parts
def labeled_parameter(parts: list): bool := parts#2 == " " and #parts#3 == 2 and is_symbol(parts#3#1) and is_typed_name(parts#3#2)

def is_typed_name(node: Node): bool := match node {
	Key(name, Op.Colon, kind): name is symbol
	_: no
}
def type_continued(typed: Node, words: list): Node := match typed {
	Key(name, Op.Colon, kind): Key(name, Op.Colon, spaced([kind] + words))
	_: typed
}

// The words before a declared name that only say how it is declared: `global mutable x`, `export const y`; a type
// word types it, `global int n = 0` is `n:int = 0`
DECLARATION_MODIFIERS = ["export", "mutable", "mut", "const", "constant", "final", "val"]
// the type words of words.warp (`global long k = 7`)
DECLARED_TYPE_WORDS = type_words

// `global x = 1`, `global n`, `export api: clock` as `global: x = 1`, a module-level variable; `global a, b` declares
// each; `export` without a name after it stays a word
def global_declaration(p: Parser, keyword: text): Node := {
	at = blank_end(p, p.at + keyword.length)
	if at == p.at + keyword.length or not is_name_start(char_at(p, at)) { return ø }
	p.at = at
	type_word = ø
	while true {
		end = name_end(p.code, p.at, p.n)
		word = p.code[p.at .. end]
		after = blank_end(p, end)
		if not (DECLARATION_MODIFIERS contains word or DECLARED_TYPE_WORDS contains word) or not is_name_start(char_at(p, after)) { break }
		if DECLARED_TYPE_WORDS contains word { type_word = word }
		p.at = after
	}
	declaration = expression(p, 0)
	# `export square := it * 2`, `global int k := 7`: a definition is the module's already, the words add nothing
	if is_key(declaration, Op.Define) { return declaration }
	if type_word != ø { declaration = typed_default(declaration, symbol(type_word), declaration) }
	names = [declaration]
	while keyword == "global" and is_symbol(names#(names.length)) and at_char(p, ',') {
		advance(p)
		skip_spaces(p)
		names = names + [atom(p)]
	}
	declared = [Key(GLOBAL, Op.Colon, name) for name in names]
	if declared.length == 1 { return declared#1 }
	listed(Bracket.None, Separator.Semicolon, declared)
}

// The statements an item stands for in its block: `global a, b` is the declarations `global: a` and `global: b`
def statements_of(item: Node): list {
	parts = group_parts(item)
	if parts == ø or parts#1 != "" or parts#2 != ";" or #parts#3 == 0 { return [item] }
	for declaration in parts#3 {
		if not declares_global(declaration) { return [item] }
	}
	parts#3
}

GLOBAL = symbol("global")

def declares_global(node: Node): bool := match node {
	Key(word, Op.Colon, name): word == GLOBAL
	_: no
}

// What follows the name of a lowercase `type`: `type point {…}`, `type size = u32`, `type pair<T>`
TYPE_BODY_STARTS = "{=:<"
// `class V { x: int }`, `struct P {…}`, `type Point {…}` as ["type", name, body], else ø with nothing read
def type_declaration(p: Parser, word: text): Node := {
	if (p.at > 0 and p.code[p.at - 1] == '.') or not declares_type(p, word) { return ø }
	with_field(p, "type_body", true, () => declared_type(p, word))
}

// `class:"btn"`, `type = "text"` are keys and `type(x)`, `type 3.5` the type of a value: a declaration names its type,
// after `type` a capital name or a name with its body
def declares_type(p: Parser, word: text): bool {
	at = blank_end(p, p.at + word.length)
	c = char_at(p, at)
	if (c == ':' or c == '=') and char_at(p, at + 1) != '=' { return false }
	if word != "type" { return true }
	if not is_name_start(c) { return false }
	end = symbol_end(p.code, at, p.n)
	after = blank_end(p, end)
	body_follows = TYPE_BODY_STARTS.contains(char_at(p, after)) and char_at(p, after + 1) != '='
	c.upper() == c or body_follows or p.code[at .. end] == "of"
}

// After the spaces, tabs and inline block comments from `from` on: `1 /* inline */ + 1`
def blank_end(p: Parser, from: int): int {
	at = from
	while true {
		at = spaces_end(p, at)
		following = char_at(p, at + 1)
		if char_at(p, at) != '/' or not (following == '*' or following == '#') { return at }
		at = block_comment_end(p.code, at, following, p.n)
	}
}

// The name and `{fields}` of a type declaration; `class Dog extends Animal` carries its parent on the name, a bare
// `class Marker` is marked and gets an empty body
def declared_type(p: Parser, word: text): Node := {
	p.at += word.length
	skip_blanks(p)
	word_end = symbol_end(p.code, p.at, p.n)
	joined = joined_type_name(p, p.code[p.at .. word_end], word_end)
	end = joined#2
	name = symbol(joined#1)
	// `mixin Name {…}`: the type its classes take the methods of (foreign_forms.warp)
	if word == "mixin" { name = attributed("mixin", true, name) }
	p.at = end
	parameters = type_parameters(p)
	constructor = if CLASS_KEYWORDS.contains(word) then constructor_fields(p) else []
	ends_statement = ";}\n".contains(char_at(p, blank_end(p, p.at)))
	skip_blanks(p)
	if keyword_at(p, "extends") {
		p.at += 7
		skip_blanks(p)
		end = symbol_end(p.code, p.at, p.n)
		name = attributed("extends", symbol(p.code[p.at .. end]), name)
		p.at = end
		skip_blanks(p)
	}
	// `class ParseError: Error` ending its line: the parent
	if at_char(p, ':') {
		parent_at = blank_end(p, p.at + 1)
		parent_end = symbol_end(p.code, parent_at, p.n)
		initial = char_at(p, parent_at)
		if parent_end > parent_at and initial.upper() == initial and initial.lower() != initial and ";\n".contains(char_at(p, blank_end(p, parent_end))) {
			p.at = parent_end
			return declared_type_node(attributed("extends", symbol(p.code[parent_at .. parent_end]), name), listed(Bracket.Curly, Separator.None, []))
		}
	}
	// a type an extension reads from its head, the sum type `= A(T) | B` (core/extension.warp type_readers)
	read = read_type(p, name, parameters)
	if read != ø { return read }
	// `type Box[T]: { item: T }`
	if at_char(p, ':') and char_at(p, blank_end(p, p.at + 1)) == '{' { p.at = blank_end(p, p.at + 1) }
	if at_char(p, '{') {
		advance(p)
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
		fields = group_parts(body)
		if fields != ø and fields#1 == "{" { body = class_body(constructor + fields#3, if #constructor > 0 then Separator.Semicolon else fields#2 as Separator, parameters) }
		return declared_type_node(name, body)
	}
	if #constructor > 0 { return declared_type_node(name, class_body(constructor, Separator.Semicolon, parameters)) }
	if not ends_statement { return type_node(name, ø) }
	if word == "class" { name = attributed("bare_class", true, name) }
	declared_type_node(name, listed(Bracket.Curly, Separator.None, []))
}

def class_body(fields: list, separator: Separator, parameters: list): Node := listed(Bracket.Curly, separator, fields.map(field => untyped(field, parameters)))

// `class P(val x: Int, var w: Int = 2) {…}` (Kotlin, Scala, TypeScript): the primary constructor's parameters are the
// class's first fields, their val, var or let dropped
CONSTRUCTOR_FIELD_WORDS = ["val", "var", "let"]
def constructor_fields(p: Parser): list {
	if not at_char(p, '(') { return [] }
	advance(p)
	fields = []
	while p.at < p.n {
		skip_blanks(p)
		if at_char(p, ')') { advance(p); return fields }
		for word in CONSTRUCTOR_FIELD_WORDS { if keyword_at(p, word) { p.at = blank_end(p, p.at + word.length) } }
		before = p.at
		fields += [expression(p, 0)]
		skip_blanks(p)
		if at_char(p, ',') { advance(p) } else if p.at == before { return fields }
	}
	fields
}

// A type declaration, its fields typed
def declared_type_node(name: Node, body: Node): Node := type_node(name, typed_fields(body))

// `Box[T]`, `Pair<A, B>`: the names of a declared type's parameters, read
def type_parameters(p: Parser): list {
	names = []
	if not (at_char(p, '[') or at_char(p, '<')) { return names }
	closer = if p.code[p.at] == '[' then ']' else '>'
	advance(p)
	while true {
		p.at = space_end(p.code, p.at, p.n)
		end = symbol_end(p.code, p.at, p.n)
		if end == p.at { break }
		names += [p.code[p.at .. end]]
		p.at = space_end(p.code, end, p.n)
		if at_char(p, ',') { advance(p) }
	}
	if at_char(p, closer) { advance(p) }
	names
}

// A field of a type parameter holds any value: `item: T` of `Box[T]` is `item: any`
def untyped(field: Node, parameters: list): Node := match field {
	Key(name, Op.Colon, kind): { if kind is symbol and parameters.contains(name_of(kind)) then Key(name, Op.Colon, symbol("any")) else field }
	_: field
}

def space_end(code: text, from: int, n: int): int {
	at = from
	while at < n and " \t\r\n".contains(code[at]) { at += 1 }
	at
}

// The cases of an enum body, a line of several cases `Add, Sub, Mul` among lines of cases each a case
def case_rows(cases: Node): list {
	rows = []
	for case in group_parts(cases)#3 {
		row = group_parts(case)
		if row != ø and row#1 == "" and row#2 == "," { rows += row#3 } else { rows += [case] }
	}
	rows
}

// Swift's `case circle(radius: Double)` as `circle(radius: Double)`
def without_case_word(case: Node): Node := {
	words = group_parts(case)
	if words != ø and words#1 == "" and #words#3 == 2 and words#3#1 == symbol("case") then words#3#2 else case
}


// A decimal number as written, read: digits (`_` between them dropped), a fraction unless `..` or a name follows the
// point, an exponent
def decimal_number(p: Parser): text {
	written = digits_read(p)
	after_point = char_ahead(p, 1)
	if at_char(p, '.') and after_point != '.' and not is_name_start(after_point) {
		advance(p)
		written = written + "." + digits_read(p)
	}
	e = char_here(p)
	sign = char_ahead(p, 1)
	signed = (sign == '+' or sign == '-') and is_digit(char_ahead(p, 2))
	if (e == 'e' or e == 'E') and (is_digit(sign) or signed) {
		advance(p)
		if signed { advance(p) }
		exponent = digits_read(p)
		// 1e3 is the exact integer 1000, like the literal it abbreviates
		if written.contains(".") or sign == '-' { return written + "e" + (if sign == '-' then "-" else "") + exponent }
		zeros = int(exponent)
		while zeros > 0 {
			written = written + "0"
			zeros -= 1
		}
	}
	written
}

def digits_read(p: Parser): text {
	// the runs of digits between `_` separators are copied whole and joined once
	parts = []
	copied = p.at
	while p.at < p.n {
		c = p.code[p.at]
		if c == '_' and p.at > 0 and is_digit(p.code[p.at - 1]) and is_digit(char_ahead(p, 1)) {
			parts += [p.code[copied .. p.at]]
			copied = p.at + 1
		} else if not is_digit(c) or c.ends_with("̅") {
			return join(parts + [p.code[copied .. p.at]], "")
		}
		advance(p)
	}
	join(parts + [p.code[copied .. p.at]], "")
}

// A quote opening a text: `"…"`, `'…'`, `«…»` (lexer.warp closing_of closes each)
def opens_text(c: text): bool := c == '"' or c == '\'' or c == '«'

// A text in quotes, its backslash escapes read; one character is a codepoint. `«…»` holds quotes as they are:
// `«she said "hi"»`
def quoted(p: Parser): Node := {
	opening = code_points("$(p.code[p.at])")
	quote = opening#1
	marks = opening[1 .. opening.length].join("")
	end = text_end(p.code, p.at + 1, closing_of(quote), p.n)
	written = marks + p.code[p.at + 1 .. end - 1]
	p.at = end
	holed = if quote == '"' then template(written) else ø
	if holed != ø { return template_node(holed) }
	content = unescaped(written, quote == '"')
	if content.length == 1 then content#1 else content
}

// An interpolating text with a hole as its template: holes `\(x)` `\{x}` `$(x)` as `${x}`, escapes read, a literal
// dollar `$$` unless a name follows it (the bare `$name` of sql and sh templates); ø without a hole. An escaped
// dollar makes a template too: it is never a hole
def template(written: text) {
	// the plain runs are copied whole and the pieces joined once, only for a template: one `+` per character copied
	// the text each time, for every text literal
	parts = []
	copied = 0
	holed = no
	at = 0
	n = written.length
	while at < n {
		c = written[at]
		next = peek(written, at + 1, n)
		if (c == '\\' or c == '$') and (next == '(' or next == '{') {
			end = hole_end(written, at + 2, next, closing_of(next), n)
			parts += [written[copied .. at], "\${" + written[at + 2 .. end - 1] + "}"]
			holed = yes
			at = end
			copied = at
		} else if c == '\\' and text_escape_at(written, at, n) != ø {
			escape = text_escape_at(written, at, n)
			parts += [written[copied .. at], escape#1]
			at += escape#2
			copied = at
		} else if c == '\\' and code_escape(written, at, n) != ø {
			coded = code_escape(written, at, n)
			parts += [written[copied .. at], coded#1]
			at += coded#2
			copied = at
		} else if c == '\\' and at + 1 < n {
			literal = escape_character(next)
			holed = holed or literal == '$'
			parts += [written[copied .. at], if literal == '$' then "$$" else literal]
			at += 2
			copied = at
		} else if c == '$' {
			parts += [written[copied .. at], if is_alpha(next) or next == '_' then "$" else "$$"]
			at += 1
			copied = at
		} else {
			at += 1
		}
	}
	if holed then join(parts + [written[copied .. n]], "") else ø
}

// A text's escapes read: `\n` `\t` `\r` `\e` as their characters, `\"` `\\` and the like as the character itself;
// entities `\:alpha` stay as written in an interpolating text (holes went to template)
def unescaped(content: text, interpolates: bool): text {
	if not content.contains("\\") { return content }
	// the plain runs are copied whole and the pieces joined once: one `+` per character copied the text each time
	parts = []
	copied = 0
	at = 0
	while at < content.length {
		c = content[at]
		escaped = if at + 1 < content.length then content[at + 1] else ' '
		if c != '\\' or at + 1 >= content.length {
			at += 1
		} else if interpolates and text_escape_at(content, at, content.length) != ø {
			escape = text_escape_at(content, at, content.length)
			parts += [content[copied .. at], escape#1]
			at += escape#2
			copied = at
		} else if code_escape(content, at, content.length) != ø {
			coded = code_escape(content, at, content.length)
			parts += [content[copied .. at], coded#1]
			at += coded#2
			copied = at
		} else {
			parts += [content[copied .. at], escape_character(escaped)]
			at += 2
			copied = at
		}
	}
	join(parts + [content[copied .. content.length]], "")
}

// `\x41`, `\u{1b}` at the backslash `at`: [the character, the length read], else ø
def code_escape(written: text, at: int, n: int): list? := {
	kind = peek(written, at + 1, n)
	if kind == 'x' and is_hex_digit(peek(written, at + 2, n)) and is_hex_digit(peek(written, at + 3, n)) {
		return [hex_value(written[at + 2 .. at + 4]) as codepoint, 4]
	}
	if kind == 'u' and peek(written, at + 2, n) == '{' {
		end = at + 3
		while end < n and is_hex_digit(written[end]) { end += 1 }
		if end > at + 3 and peek(written, end, n) == '}' { return [hex_value(written[at + 3 .. end]) as codepoint, end + 1 - at] }
	}
	ø
}

// The number the hex digits write
def hex_value(digits: text): int {
	value = 0
	for digit in digits { value = value * 16 + "0123456789abcdef".index_of(digit.lower()) - 1 }
	value
}

def escape_character(c: text): text {
	if c == 'n' { return '\n' }
	if c == 't' { return '\t' }
	if c == 'r' { return '\r' }
	if c == 'e' { return '\e' }
	c
}
