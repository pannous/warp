// The parser written in warp (card self-parser, notes/self_hosting.md step 6): a source's tree as nodes
// (core/passes/shapes.warp), each word next to its Rust twin in rust-harness:src/warp_parser (tests/parser/test_self_parser.rs),
// which compares its view (tests/common/twins.rs node_view)
use "lexer.warp"
use "../passes/shapes.warp"
use "../analysis/words.warp"
use "../passes/sugar.warp"
use "foreign_forms.warp"
use os
use file

// Where the items being read stand: the bracket of their group, whether that group is closed by a bracket or a word
// (`grouped`), whether a Ruby block's `end` closes it (`stops_at_end`) and whether an `else` ends it too (`in_branch`)
class GroupContext { bracket: Bracket = Bracket.None; grouped: bool = no; in_branch: bool = no; stops_at_end: bool = no }

// What closes the items of items_until: the end of the source, the closing bracket, a Ruby block's `end`, that or a
// `then` block's `else` (kept for the branch), or, for the rest of an enclosing group or block, whatever closes that one
enum ItemsEnd { Source, Closer, End, EndOrElse, Rest }

class Parser { code: text; n: int; at: int = 0; header: bool = no; iterable: bool = no; indexing: bool = no; indent: int = 0; spaces: bool = no; group: GroupContext; branch_power: int = 0; enum_cases: bool = no; resumes: list; breaks: list; finally_blocks: int = 0; types: list; bangs: list; type_body: bool = no; operators: list; aliases: map; circumfixes: list; phrases: list = []; closing_ends: map = {}; word_types: list; line_starts: list }

// The view of a source's tree, as the twins compare it and the self-hosted pipeline hands it on
def tree(source: text): list := view_of(parsed(source))

// The tree of a source: one statement as itself, several as a list
// Rust twin: WarpParser::parse
def parsed(source: text, uses: text = ""): Node := {
	try {
		written_tree(source, uses)
	} catch failure {
		error_node(failure.message)
	}
}

// `\:alpha` is α, `\:world` 🌍: before parsing, each known uniscript entity outside texts and comments becomes its
// characters; an unknown one stays as written
// Rust twin: uniscript_entities.rs expand_entities, entity_name_at
ENTITY_MARK = "\\:"
// `name TAB characters` lines, the table Rust include_str!s, built into the compiler as its other data
// (module_source: user 2026-10-25, "These should all be built in")
ENTITY_TABLE = module_source("compiler/entities.tsv")
// The lib/ a run reads a program's standard modules from (its own data is built in, module_source): the one the run was
// given (compiler.warp's fourth argument, given_library), else WARP_LIB, else the one above this file, or beside it when
// the file was reached as core/ (card compiler-core-link). A compiled stage is kept for every identical lib/ and runs
// from wherever that is now, so nothing reads the folder it was compiled in (card pure-lane-nondeterministic): that
// folder, a build machine's, is only the last resort
global given_library = ""
def run_library(): text := if given_library != "" then given_library else (warp_lib() ?? library_of_core(folder_of(module_directory)))
// WARP_LIB, asked of the host once a compile: file_source asks for every file it gives, ~50 µs a host call
global warp_lib_asked = no
global warp_lib_given = ø
def warp_lib(): text? {
	if not warp_lib_asked {
		warp_lib_given = env("WARP_LIB")
		warp_lib_asked = yes
	}
	warp_lib_given
}
// this file lies in core/parsing/, reached as core/ or as lib/'s link compiler/
def library_of_core(core: text): text := if core.ends_with("/core") then folder_of(core) + "/lib" else folder_of(core)
// The lib/ the run was given, which run_library answers from now on
def use_library(folder: text) { given_library = folder }
// Every module of lib/ by its path within lib/ ("prelude.warp", "sugar/lists.warp", "native/z.warp"), bundled into the
// built compiler: uses.warp's module_text writes them in where library_sources() stands when it compiles the compiler,
// so a compiler needs no lib/ on any disk (decision built-in-lib). A compiler built by one that bundles none yet (an
// older seed) calls library_sources below and reads them where it runs
// lib/'s folders the bundle leaves out: core's link (the compiler itself) and the files a build makes
UNBUNDLED_FOLDERS = ["compiler", "data"]
// core's folders bundled all the same: the extensions' rules, which every compile reads (rewrites.warp
// extension_module_names), baked with the rest instead of parsed at each run (~25 ms of a small program's 0.15 s)
BUNDLED_CORE_FOLDERS = ["compiler/extensions"]
LIBRARY_FILES = library_sources()
// (its parameter keeps this head apart from the empty call module_text writes the bundle in for)
def library_sources(within: text = ""): map := library_texts(run_library(), within)
// the .warp files of lib/<within> and its folders, by their paths within lib/
def library_texts(library: text, within: text): map {
	found = {}
	entry_names = try list_files(library + "/" + within) else []
	# a compiler without the runtime's own listing (one an older seed built) lists nothing: it reads lib/ where it runs
	if not (type(entry_names) is list) { return found }
	for name in entry_names.sort() {
		path = within + name
		if name.ends_with(".warp") {
			found[path] = try read(library + "/" + path) else ""
		} else if not name.contains(".") and not UNBUNDLED_FOLDERS.contains(path) {
			inner = library_texts(library, path + "/")
			for inner_path in inner.keys { found[inner_path] = inner[inner_path] }
		}
	}
	if within == "" {
		for folder in BUNDLED_CORE_FOLDERS {
			inner = library_texts(library, folder + "/")
			for inner_path in inner.keys { found[inner_path] = inner[inner_path] }
		}
	}
	found
}
// A source file's text: a bundled module of lib/ from the bundle, unless WARP_LIB is set and has the file (a module
// changed after the build, per module); any other file (the program's own, core reached as lib/compiler) from the disk;
// ø for none
def file_source(path: text): text? {
	bundled = LIBRARY_FILES.get(library_path(path))
	if bundled != ø and warp_lib() == ø { return bundled }
	(try read(path) else ø) ?? bundled
}
// a path's place within lib/ ("sugar/lists.warp"), "" outside it
def library_path(path: text): text {
	library = run_library() + "/"
	if path.starts_with(library) then path[library.length .. path.length] else ""
}
// Every bundled module's parse, packed (pack), baked in beside its text: module_text writes them in where
// library_parses() stands as it does the texts (decision runtime-prepended: a compile derives no table of its own
// library). A compiler built by one that bakes none yet (an older seed) parses them where it runs
LIBRARY_PARSES = library_parses()
def library_parses(within: text = ""): map := {}
// a source's parse, the baked one when the file at `path` is the bundled module of this very text
def source_parse(path: text, source: text): Node {
	within = library_path(path)
	packed = if LIBRARY_FILES.get(within) == source then LIBRARY_PARSES.get(within) else ø
	if packed != ø then unpack(packed) else plain_node(parsed(rules_ended(source)))
}
// the source with each rule ending its line in `$s...` ended by `;`: the parser reads `...` at the end of a line as a
// range going on into the next line (`rewrite loudly $s... => $s...` and the line after it as `$s ... (next line)`),
// which swallowed the next rule or statement
rewrite_line_start = "rewrite "
def rules_ended(source: text): text {
	if not source.contains(rewrite_line_start) { return source }
	lines = source.split("\n")
	ended = []
	changed = no
	for line in lines {
		rule = line.trim()
		ending = rule.starts_with(rewrite_line_start) and rule.contains("=>") and rule.ends_with("...")
		if ending { changed = yes }
		ended += [if ending then line + ";" else line]
	}
	if changed then ended.join("\n") else source
}
// The words that take a block last, as `if` does (user 2026-10-29: derived from the signature): a function whose last
// parameter is `body: block` (`once(body: block)`), a rewrite rule whose pattern ends in a `: block` hole (`rewrite
// whenever $c $body: block`). Baked in by uses.warp module_text; a compiler built by one that bakes none reads them
// off its library where it runs
BLOCK_HEADS = block_heads()
def block_heads(within: text = ""): map := block_heads_in(LIBRARY_FILES)
def block_heads_in(files: map): map {
	heads = {}
	for path in files.keys {
		for line in files[path].split("\n") {
			word = block_head_of(line)
			if word != "" { heads[word] = word }
		}
	}
	heads
}
// the word a line declares taking a block last, else ""
def block_head_of(line: text): text {
	if line.starts_with(rewrite_line_start) and line.contains(" => ") {
		pattern = line[rewrite_line_start.length .. line.find(" => ")].trim()
		words = pattern.split(" ")
		return if pattern.ends_with(": block") and words.length > 2 and is_name_start(words#1[0]) then words#1 else ""
	}
	if not (line.contains("body: block) :=") and is_name_start(line[0])) { return "" }
	name = line[0 .. name_end(line, 0, line.length)]
	if line[name.length] == '(' then name else ""
}
global entity_table = ø
def entities(): map {
	if entity_table == ø {
		entity_table = {}
		lines = ENTITY_TABLE.split("\n")
		for line in lines {
			columns = line.split("\t")
			if columns.length == 2 { entity_table[columns#1] = columns#2 }
		}
	}
	entity_table
}
def expanded_entities(source: text): text {
	if not source.contains(ENTITY_MARK) { return source }
	points = code_points(source)
	n = points.length
	// the pieces between entities are copied whole: one append per character made the run quadratic (card
	// pure-compile-speed: 69% of a pure-lane compile of uses.warp)
	parts = []
	copied = 0
	at = 0
	// each point read before the ones after it: a list of points is walked on from the point read last, so reading
	// one back (span_end's lookahead, then entity_name_at at the same point) walked it from its head at every point,
	// quadratic: most of the passes' list reads in `warp rebuild self` (card speed-symbol-calls). An entity starts at a
	// backslash, a text or comment never does, so the entity is looked for first
	while at < n {
		name = entity_name_at(points, at, n)
		if name != "" {
			parts += [text_between(points, copied, at), entities()[name]]
			at = at + 2 + name.length
			copied = at
		} else {
			skipped = span_end(points, at, n)
			at = if skipped > at then skipped else at + 1
		}
	}
	join(parts + [text_between(points, copied, n)], "")
}
// The known entity name written at `at` (`\:name`), else "": its run of ASCII letters, or a longer known name with
// hyphenated parts (`\:fracture-A`)
def entity_name_at(source: text or list, at: int, n: int): text {
	if not (source[at] == '\\' and peek(source, at + 1, n) == ':') { return "" }
	letters = at + 2
	while letters < n and is_alpha(source[letters]) { letters = letters + 1 }
	if letters == at + 2 { return "" }
	run = letters
	while run < n and (is_alphanumeric(source[run]) or source[run] == '-') { run = run + 1 }
	end = run
	while end > letters {
		if end == run or source[end] == '-' {
			name = text_between(source, at + 2, end)
			if name in entities() { return name }
		}
		end = end - 1
	}
	name = text_between(source, at + 2, letters)
	if name in entities() then name else ""
}
// The characters from `from` to `to` of a text or of its code points
def text_between(source: text or list, from: int, to: int): text := if source is text then source[from .. to] else join(source[from .. to], "")
// `\:name` inside a text at `at`: [its characters, the length read]; an unknown one stays as written
def entity_read(source: text or list, at: int, n: int): list {
	name = entity_name_at(source, at, n)
	if name == "" then [ENTITY_MARK, 2] else [entities()[name], 2 + name.length]
}

// The tree as the source writes it; `uses`, the use lines of the module a slice of it comes from, whose operators
// the slice reads as the module does (compute_toys' `use regex`: `code matches rule#1`)
def written_tree(written: text, uses: text = ""): Node := {
	source = expanded_entities(written)
	found = gaps(source, source.length)
	word_types = multi_word_types(source)
	p = Parser{code: source, n: source.length, group: GroupContext(), resumes: found.resumes, breaks: found.breaks, types: declared_type_names(source) + word_types.map(type_words => type_words.join("-")), bangs: bang_words(source), operators: scanned_operators(source + uses), aliases: by_first_character(operator_aliases(source) + math_operator_aliases()), circumfixes: circumfix_aliases(source) + math_circumfix_aliases(), word_types: word_types, line_starts: line_starts_of(source)}
	items_until(p, Bracket.None, ItemsEnd.Source)
}

// The names glued to `!` a source defines as words of their own: `def is!(warp, expected) := …`, `is!(…) := …`;
// any other `!` after a name stays a suffix (`x!`), a macro (`println!(…)`) or `!=` (card parser-reads-2)
// Rust twin: declaration_scan.rs defined_name, lookahead.rs defines_bang_word
def bang_words(source: text): list {
	found = []
	# only a line with `!(` can define one: the prelude's scan, at every start of a stage program, took 60 ms
	for line in source.split("\n") {
		if not line.contains("!(") { continue }
		n = line.length
		at = blanks_end(line, 0, n)
		if starts_at(line, "def ", at, n) { at = blanks_end(line, at + 4, n) }
		end = name_end(line, at, n)
		if end > at and starts_at(line, "!(", end, n) { found += [line[at .. end] + "!"] }
	}
	found
}
// the prelude's bang words, scanned the first time a `name!` needs them: scanning the prelude on every parse made the
// front stage 5× slower (card front-stage-5x-slower)
global prelude_bangs = ø
def prelude_bang_words(): list {
	if prelude_bangs == ø { prelude_bangs = bang_words(module_source("prelude")) }
	prelude_bangs
}

// The width of the bang word at the parser's position (`is!`), else 0
def bang_word_at(p: Parser): int {
	end = name_end(p.code, p.at, p.n)
	if end == p.at or not is_at(p.code, end, '!', p.n) or is_at(p.code, end + 1, '=', p.n) { return 0 }
	word = p.code[p.at .. end] + "!"
	if p.bangs contains word or prelude_bang_words() contains word then end + 1 - p.at else 0
}

// `{if: 4, from: 1 to: 2}`: a keyword or operator word glued to a key's colon names the key; `else:`, `then:` and
// `do:` open blocks
// Rust twin: lookahead.rs word_names_key, BLOCK_COLON_WORDS
BLOCK_COLON_WORDS = ["then", "else", "do"]
def word_names_key(p: Parser, word: text): bool {
	after = p.at + word.length
	not (word is empty) and not BLOCK_COLON_WORDS.contains(word) and is_at(p.code, after, ':', p.n) and not is_at(p.code, after + 1, ':', p.n) and not is_at(p.code, after + 1, '=', p.n)
}

// The blank-separated words of the statement at the parser's position
def statement_words_at(p: Parser): list := blank_words(p.code[p.at .. statement_end(p)])
// Where the statement at the parser's position ends: at its line's end or `;`
def statement_end(p: Parser): int {
	end = p.at
	while end < p.n and p.code[end] != '\n' and p.code[end] != ';' { end += 1 }
	end
}
// `operator × := *` (lib/math.warp): another spelling of a built-in operator; `prefix operator √ := sqrt` one of a
// function, `√x` is sqrt(x): a statement declaring nothing (the pre-scan made the spelling an operator: operator_aliases)
// [spelling, target] of an alias statement's words (`operator ∧ := and`, `prefix operator √ := sqrt`), else []
// Rust twin: aliases.rs alias_line
def operator_alias(words: list): list {
	prefix = words.length > 0 and words#1 == "prefix"
	if prefix { words = words[1 .. words.length] }
	if not (words.length == 4 and words#1 == "operator" and words#3 == ":=") { return [] }
	if is_operator_spelling(words#4) or (prefix and is_name_start(words#4#1)) then [words#2, words#4] else []
}
// An alias spelling a function, `√` of sqrt, no operator
def spells_function(alias: list): bool := is_name_start(alias#2#1) and not is_operator_spelling(alias#2)
// [spelling, target] of each operator alias a source declares
// Rust twin: aliases.rs source_aliases
def operator_aliases(source: text): list := if source.contains(":=") then operator_aliases_in(code_statements(source)) else []
def operator_aliases_in(statements: list): list {
	found = []
	for statement in statements {
		alias = operator_alias(blank_words(statement))
		if alias.length > 0 { found += [alias] }
	}
	found
}
// lib/math.warp's aliases, which every program reads (decision operator-alias), scanned the first time a parse needs them
// Rust twin: aliases.rs math_aliases
global math_aliases = ø
def math_operator_aliases(): list {
	if math_aliases == ø { math_aliases = operator_aliases_in(code_statements_of("math")) }
	math_aliases
}
// `circumfix operator ⌊ ⌋ := floor`: [opening, closing, function] of a circumfix statement's words, else []
// Rust twin: aliases.rs circumfix_line
def circumfix_alias(words: list): list {
	if words.length == 6 and words#1 == "circumfix" and words#2 == "operator" and words#5 == ":=" then [words#3, words#4, words#6] else []
}
// [opening, closing, function] of each circumfix operator a source declares
// Rust twin: aliases.rs source_circumfixes
def circumfix_aliases(source: text): list := if source.contains("circumfix") then circumfix_aliases_in(code_statements(source)) else []
def circumfix_aliases_in(statements: list): list {
	found = []
	for statement in statements {
		pair = circumfix_alias(blank_words(statement))
		if pair.length > 0 { found += [pair] }
	}
	found
}
// lib/math.warp's circumfix operators (‖x‖, ⌊x⌋, ⌈x⌉), scanned the first time a parse needs them
// Rust twin: aliases.rs math_circumfixes
global math_circumfixes = ø
def math_circumfix_aliases(): list {
	if math_circumfixes == ø { math_circumfixes = circumfix_aliases_in(code_statements_of("math")) }
	math_circumfixes
}
// A library's code statements by its name ("math"), split once a compile for every scanner of them: splitting math's
// text for its operators, its aliases and its circumfixes each was a tenth of a small program's compile
global library_code_statements = {}
def code_statements_of(name: text): list {
	if not library_code_statements.has(name) { library_code_statements[name] = code_statements(join(module_sources([name]), "")) }
	library_code_statements[name]
}
// `x ← v` (also `<-`), the plain store: the hidden call store·value(x, v), an assignment no rewrite rule takes for one
// (rewrites.warp stored), so a rule's template writes it without matching itself again; `x = v` once the rules ran
STORE_OPERATOR = "←"
// The canonical names of the alias targets parser.warp's operator lists spell otherwise
// Rust twin: spellings.rs OPERATOR_SPELLINGS ("approximately", "+-", "<-")
ALIAS_TARGET_NAMES = {"approximately": "≈", "+-": "±", "<-": STORE_OPERATOR}

// The parser's spellings: its own operators and keyword forms, with lib/aliases.warp's (card alias-mechanism,
// notes/aliases.md: one entry per canonical word, `add { operator: "+", aliases: [plus] }`), made the first time a
// parse asks; reading the table sees the parser's own spellings only. The table is built into the compiler when it is
// compiled (module_source), never read from a lib/ when it runs 
ALIAS_TABLE = module_source("aliases")
// operator symbols and words: [spelling, operator] pairs, the symbols longest first; forms: keyword_form's; canonical:
// each alias with its entry's word (`plus` → add); infix words: the table's (`mod`, `upto`)
class Spellings { operator_symbols: list; operator_words: list; forms: map; canonical: map; infix_words: list }
global spelling_tables = ø
def alias_spellings(): Spellings := {
	if spelling_tables == ø {
		spelling_tables = own_spellings()
		spelling_tables = aliased_spellings()
	}
	spelling_tables
}
// the alias table's parse, baked in with the table (LIBRARY_PARSES): parsing it at every run was a sixth of a small
// program's compile (card speed-module-rules)
def alias_table_tree(): Node := source_parse(run_library() + "/aliases.warp", ALIAS_TABLE)
def own_spellings(): Spellings := {
	symbols = pairs_of(SYMBOL_OPERATORS)
	Spellings{operator_symbols: symbols, operator_words: pairs_of(WORD_OPERATORS), forms: copied(KEYWORD_FORMS), canonical: {}, infix_words: []}
}
def aliased_spellings(): Spellings := {
	tables = own_spellings()
	for row in items_of(alias_table_tree()) { add_alias_entry(tables, spelling_text(row#1), row#2) }
	tables.operator_symbols = longest_first(tables.operator_symbols)
	tables
}
// The spellings an entry gives: a symbol alias spells the entry's operator (its `operator`, else the entry itself), a
// word alias its word (also infix with `infix: yes`, also a keyword form when the word is one)
def add_alias_entry(tables: Spellings, word: text, fields: Node) {
	target = alias_field(fields, "operator") ?? word
	written_infix = alias_field(fields, "infix") == "yes"
	if written_infix { add_infix_word(tables, word, target) }
	for spelling in alias_field(fields, "aliases") ?? [] {
		tables.canonical[spelling] = word
		if not is_name_start(spelling#1) { tables.operator_symbols += [[spelling, target]] }
		else if written_infix { add_infix_word(tables, spelling, target) }
		if word in tables.forms { tables.forms[spelling] = tables.forms[word] }
	}
}
def add_infix_word(tables: Spellings, word: text, target: text) {
	tables.operator_words += [[word, target]]
	tables.infix_words += [word]
}
// An entry's field as written, `operator: "+"` gives "+", `aliases: [plus]` ["plus"], else ø
def alias_field(fields: Node, name: text): any {
	for field in items_of(fields) { if name_of(key_of(field)) == name { return spelling_text(value_of(field)) } }
	ø
}
// A spelling as text, each of a list's
def spelling_text(n: Node): any := match n {
	Char(c): "${c}"
	Text(t): t
	Symbol(name): name
	True: "yes"
	List(items, bracket, separator): items.map(item => spelling_text(item))
	_: "${n}"
}
def symbol_operators(): list := alias_spellings().operator_symbols
def word_operators(): list := alias_spellings().operator_words
def keyword_forms(): map := alias_spellings().forms
// The canonical word an alias spells (`plus` gives add), else ø
def canonical_word(spelling: text): text? := alias_spellings().canonical.get(spelling)
// The operator a symbol or word spells (`≤` gives <=, `mod` %), else ø
def symbol_operator(written: text): text? := spelled_by(symbol_operators(), written)
def word_operator(written: text): text? := spelled_by(word_operators(), written)
def spelled_by(pairs: list, written: text): text? {
	for pair in pairs { if pair#1 == written { return pair#2 } }
	ø
}
def pairs_of(table: map): list {
	pairs = []
	for key, value in table { pairs += [[key, value]] }
	pairs
}
def copied(table: map): map {
	copy = {}
	for key, value in table { copy[key] = value }
	copy
}
// [spelling, …] pairs ordered longest first, so the first spelling written at a position is the longest
def longest_first(pairs: list): list {
	width = 0
	for pair in pairs { if pair#1.length > width { width = pair#1.length } }
	ordered = []
	while width > 0 {
		ordered += pairs.filter(pair => pair#1.length == width)
		width -= 1
	}
	ordered
}
// The canonical name of the operator an alias spells, else ""
def canonical_operator(target: text): text := symbol_operator(target) ?? word_operator(target) ?? ALIAS_TARGET_NAMES.get(target) ?? ""
// The alias written at the parser's position as [spelling, target], a word one as a whole word, the longest, else []
def alias_at(p: Parser): list := longest_spelled_at(p, starting_here(p.aliases, p, p.at), alias => alias#1) ?? []
// Spellings (or [spelling, …] entries) by the character each starts with, in their order: a position tries only those
// that can be written there (trying every alias at every token was 55% of a parse, card compiler-parse-timing)
def by_first_character(entries: list): map {
	starting = {}
	for entry in entries {
		first = "$(spelling_of(entry)[0])"
		starting[first] = (starting.get(first) ?? []) + [entry]
	}
	starting
}
def spelling_of(entry: any): text := if entry is list then entry#1 else entry
// the entries of such an index that start with the character at `at`
def starting_here(index: map, p: Parser, at: int): list := if at >= p.n then [] else index.get("$(p.code[at])") ?? []
def aliases_starting(p: Parser, c: text): list := p.aliases.get("$(c)") ?? []
// Of `candidates`, each spelled as `spelling` gives, the one written at the parser's position with the longest spelling,
// a word one as a whole word, else ø
def longest_spelled_at(p: Parser, candidates: list, spelling: function): any {
	longest = ø
	longest_length = 0
	for candidate in candidates {
		spelled = spelling(candidate)
		here = starts_at(p.code, spelled, p.at, p.n) and not (is_name_start(spelled#1) and is_at_name_char(p, p.at + spelled.length))
		if here and (longest == ø or spelled.length > longest_length) {
			longest = candidate
			longest_length = spelled.length
		}
	}
	longest
}
// The infix operator an alias at the parser's position spells, as [written, canonical], else []; a word alias with a
// block after it stays a name: `div {…}` is the html tag, `7 div 2` the floor division
def aliased_operator_at(p: Parser): list {
	alias = alias_at(p)
	canonical = if alias.length == 0 then "" else canonical_operator(alias#2)
	if canonical is empty or (is_name_start(alias#1#1) and opens_block(p, alias#1.length)) then [] else [alias#1, canonical]
}
// A spelling of a built-in operator: symbols (`*`, `/!=`, `->`), or an operator word (`and`, `in`, `contains`)
// Rust twin: spellings.rs table_operator, PREFIX_OPERATOR_WORDS
def is_operator_spelling(word: text): bool {
	if not is_name_start(word#1) or word_operator(word) != ø { return true }
	keyword_form(word) == "contains" or word == "in" or word == "approximately"
}
// The statement at the parser's position skipped: ø
def skip_statement(p: Parser): Node := {
	p.at = statement_end(p)
	ø
}

// The words a type's name follows where it is declared
// Rust twin: mod.rs TYPE_DECLARATION_WORDS, RECORD_WORD
TYPE_SCAN_WORDS = ["class", "struct", "record", "type"]

// The type names a source declares: the word after class, struct, record or type within a line, outside comments
// and texts, with nothing or a bracket, `:` or `;` glued after it (`record = find(…)` declares nothing)
// Rust twin: declaration_scan.rs scan_declared_types
def declared_type_names(source: text): list {
	type_names = []
	for line in code_only(source).split("\n") {
		previous = ""
		for word_written in line.replace("\t", " ").split(" ") {
			if word_written is empty { continue }
			if TYPE_SCAN_WORDS.contains(previous) {
				end = symbol_end(word_written, 0, word_written.length)
				if end > 0 and (end == word_written.length or "({<[:;".contains(word_written[end])) { type_names += [word_written[0 .. end]] }
			}
			previous = word_written
		}
	}
	type_names
}

// The words naming a body before it, `class full name extends person {`: no word of the type's name
// Rust twin: declaration_scan.rs WORDS_BEFORE_TYPE_BODY
WORDS_BEFORE_TYPE_BODY = ["extends", "with", "implements", "interface", "gc", "struct"]

// The type names of several words a source declares, by their words: `class full name {…}` declares `full name`,
// written `full-name`; only on one line, up to the body's `{` (glued to the last word or the body too)
// Rust twin: declaration_scan.rs scan_multi_word_types
def multi_word_types(source: text): list {
	found = []
	for line in code_only(source).split("\n") {
		name = []
		naming = false
		for word in line.replace("\t", " ").split(" ") {
			if word == "" { continue }
			if naming {
				before_body = word.split("{")#1
				name_word = is_plain_name(before_body) and not WORDS_BEFORE_TYPE_BODY.contains(before_body)
				if word.contains("{") {
					if name_word { name += [before_body] }
					if name.length > 1 { found += [name] }
					naming = false
				} else if name_word {
					name += [word]
				} else {
					naming = false
				}
			}
			if not naming and TYPE_SCAN_WORDS.contains(word) {
				name = []
				naming = true
			}
		}
	}
	found
}

// Words naming one built-in type: warp's `x: fast int` is i64, `fast float` f64; C's names of several words the fixed
// width they mean there, `unsigned int` uint32 (the Rust lane notes warp's word); `byte index`, `byte position`, `byte offset`
// the count types of bytes (decision index-units, index_positions.warp). The longest first.
// Rust twin: types/expressions.rs COMPOUND_TYPES
COMPOUND_TYPES = [[["unsigned", "long", "long"], "uint64"], [["long", "long", "int"], "int64"], [["unsigned", "long"], "uint64"], [["long", "long"], "int64"], [["long", "int"], "int64"], [["unsigned", "int"], "uint32"], [["signed", "int"], "int32"], [["unsigned", "short"], "uint16"], [["short", "int"], "int16"], [["unsigned", "char"], "byte"], [["signed", "char"], "int8"], [["fast", "int"], "i64"], [["fast", "float"], "f64"], [["byte", "index"], "byte index"], [["byte", "position"], "byte position"], [["byte", "offset"], "byte offset"]]

// `full name` of a declared `class full name {…}` is the one name `full-name`, `unsigned int` uint32, any other word
// itself: [the name, the end of its words] for the word ending at `end`
// Rust twin: types/expressions.rs joined_type_name
def joined_type_name(p: Parser, word: text, word_end: int): list {
	for compound in COMPOUND_TYPES {
		compound_end = if compound#1#1 == word then words_ahead_end(p, compound#1, word_end) else 0
		if compound_end > 0 { return [compound#2, compound_end] }
	}
	joined = [word, word_end]
	joined_words = 1
	for type_words in p.word_types {
		type_end = if type_words#1 == word and type_words.length > joined_words then words_ahead_end(p, type_words, word_end) else 0
		if type_end > 0 {
			joined = [type_words.join("-"), type_end]
			joined_words = type_words.length
		}
	}
	joined
}

// The end of the blanks and whole words after the first of `words` from `at` on: ` name` of `full name`, else 0
// Rust twin: types/expressions.rs words_ahead_length
def words_ahead_end(p: Parser, words: list, first_end: int): int {
	end = first_end
	for word in words[1 .. words.length] {
		start = spaces_end(p, end)
		if start == end or not starts_at(p.code, word, start, p.n) { return 0 }
		end = start + word.length
		following = peek(p.code, end, p.n)
		if is_name_char(following) or following == '-' { return 0 }
	}
	end
}

// The keyword forms: each word with a form of its own and the form's shape, a constant word's the constant (any case: `True`, `NULL`); their aliases come from
// lib/aliases.warp (spellings)
// Rust twin: atoms.rs keyword_form, expressions.rs parse_expr, if_else.rs, conditions.rs, warp_parser check_constants
KEYWORD_FORMS = {"return": "return", "if": "condition", "while": "condition", "unless": "condition", "until": "condition", "for": "loop", "loop": "endless",
	"class": "type", "struct": "type", "type": "type", "global": "global", "export": "global", "not": "not",
	"else if": "else if", "where": "clause", "match": "clause", "switch": "clause",
	"contains": "contains", "function": "reference", "func": "reference", "yes": "true", "no": "false", "ø": "empty", "empty": "empty"}

// The shape of the keyword form `word` opens, else ""
def keyword_form(word: text): text := if word in keyword_forms() then keyword_forms()[word] else ""

// The name at the parser's position, "" before anything else
def word_at(p: Parser): text := p.code[p.at .. name_end(p.code, p.at, p.n)]

// The items of a group in `bracket` up to what `ends` them, grouped by their separators; outside brackets the lines
// indented below an item are its body (`repeat⏎⇥x` is `repeat: x`) and a line indented less ends the items
// Rust twin: lists.rs parse_list_with_separators
def items_until(p: Parser, bracket: Bracket, ends: ItemsEnd): Node := {
	found = []
	opener = p.at - 1
	outer = p.group
	closer = closer_of(bracket, ends)
	rest = ends == ItemsEnd.Rest
	enclosed = ends != ItemsEnd.Source and not rest
	// the rest of the enclosing group or block stops where that one stops
	if not rest { p.group = GroupContext{bracket: bracket, grouped: outer.grouped or enclosed, in_branch: ends == ItemsEnd.EndOrElse, stops_at_end: ends == ItemsEnd.End or ends == ItemsEnd.EndOrElse} }
	while true {
		skip_blanks(p)
		if closes_block(p) {
			if keyword_at(p, "end") and not rest { p.at = p.at + 3 }
			break
		}
		if p.at >= p.n {
			if enclosed { raise "`" + closer + "` is missing: the group opened at " + line_and_column(p.code, opener) + " runs to the end of the input" }
			break
		}
		c = p.code[p.at]
		if c == closer {
			p.at = p.at + 1
			break
		}
		stray = c == ')' or c == ']' or c == '}'
		if stray and enclosed { raise "`" + c + "` closes the group opened at " + line_and_column(p.code, opener) + ", which needs `" + closer + "`" }
		// the lines indented inside a group end at its closer: `{ for x in xs:⏎    a }`
		if stray and p.group.grouped { break }
		if stray { raise "`" + c + "` closes no group" }
		before = p.at
		item = if follows_clause_word(found) then header_expression(p, 0) else if heads_block(p, found) then head_item(p) else expression(p, 0)
		tabbed = tab_separates(p)
		newline = skip_blanks(p)
		if bracket == Bracket.None and newline and line_indent(p) > p.indent {
			body = lines_below(p)
			skip_end_line(p)
			lines = group_parts(body)
			item = Key(item, Op.Colon, if lines != ø and lines#1 == "" and lines#2 == "\n" then listed(Bracket.Curly, Separator.Newline, lines#3) else body)
			newline = skip_blanks(p)
		}
		dedent = bracket == Bracket.None and newline and line_indent(p) < p.indent
		after = if dedent then Separator.None else separator(p, closer, newline)
		if tabbed and after == Separator.Space { after = Separator.Tab }
		// `ys = xs.map { |x| x+1 }`, `n = t.split " "`: what follows an assigned method belongs to its call, not to the
		// statement
		if found and found#(found.length)#2 == Separator.Space and assigned_method_call(found#(found.length)#1) {
			item = with_trailing_item(found#(found.length)#1, item)
			found = found[0 .. found.length - 1]
		}
		found += [[statement, after] for statement in statements_of(item)]
		if dedent { break }
		if p.at == before { p.at = p.at + 1 }
	}
	p.group = outer
	grouped(found, bracket)
}

// `ys = xs.map`, `f(xs) := xs.map`, `n = t.replace "a"`: an assignment of a method, which a block or value after it is
// given to
// Rust twin: functions.rs assigned_method_call
def assigned_method_call(n: Node): bool := match n {
	Key(target, op, value): ["=", ":=", "->"].contains(op as text) and (method_phrase(value) or assigned_method_call(value))
	_: false
}
// `t.split`, `t.replace "a"`: a method, alone or with values after it already
def method_phrase(n: Node): bool {
	parts = group_parts(n)
	names_method(n) or (parts != ø and parts#1 == "" and parts#2 == " " and #parts#3 > 0 and names_method(parts#3#1))
}

def names_method(n: Node): bool := match n {
	Key(receiver, Op.Dot, method): method is symbol
	_: false
}

// The assignment with `item` given to the method call it assigns: `ys = (xs.map {…})`, `n = (t.split " ")`
// Rust twin: blocks.rs with_trailing_block
def with_trailing_item(assignment: Node, item: Node): Node := match assignment {
	Key(target, op, value): Key(target, op, if assigned_method_call(value) then with_trailing_item(value, item) else spaced((if names_method(value) then [value] else group_parts(value)#3) + [item]))
	_: assignment
}

// `match f(x) {…}`: the subject after a clause word ends before the block, no call `f(x) {…}` takes it
// Rust twin: conditions.rs ends_with_clause_word
// `whenever x > y {…}`, `on change x: n += 1`: the words after a block head (BLOCK_HEADS) starting the statement are
// its head, as `if`'s condition is, up to its body, `{…}` or `: …` (a block); not the body once it was read
def heads_block(p: Parser, found: list): bool {
	if found.length == 0 or is_block(found#(found.length)#1) or found#(found.length)#2 != Separator.Space { return false }
	first = found.length
	while first > 1 and found#(first - 1)#2 == Separator.Space { first = first - 1 }
	found#first#1 is symbol and BLOCK_HEADS.has(name_of(found#first#1)) and body_follows(p)
}
// whether the statement goes on to a body, `{` or `:` outside brackets and texts before its end: without one a block
// head is an ordinary call, the program's own `twice square 3` of a twice(f, x) beside the prelude's twice(body: block)
def body_follows(p: Parser): bool {
	depth = 0
	at = p.at
	while at < p.n {
		c = p.code[at]
		if c == '"' or c == '\'' {
			at = at + 1
			while at < p.n and p.code[at] != c { at = at + 1 }
		} else if depth == 0 and (c == '{' or c == ':') {
			return true
		} else if c == '(' or c == '[' {
			depth = depth + 1
		} else if c == ')' or c == ']' {
			if depth == 0 { return false }
			depth = depth - 1
		} else if depth == 0 and (c == '\n' or c == ';' or c == '}') {
			return false
		}
		at = at + 1
	}
	false
}
def head_item(p: Parser): Node := if body_word_width(p) == 1 then listed(Bracket.Curly, Separator.Semicolon, [colon_body(p, 1)]) else header_expression(p, CONDITION_POWER)
def follows_clause_word(found: list): bool := found.length > 0 and ends_with_clause_word(found#(found.length)#1)

// `where`, `match`, alone or the last word of `for i in xs where`: a word whose condition or subject follows
def ends_with_clause_word(node: Node): bool := match node {
	Symbol(word): keyword_form(word) == "clause"
	List(parts, Bracket.None, separator): parts.length > 0 and ends_with_clause_word(parts#(parts.length))
	_: false
}

// `line:column` of the character at `at`, both from 1
def line_and_column(code: text, at: int): text {
	line = 1
	start = 0
	for i in 0 ..< at {
		if code[i] == '\n' {
			line = line + 1
			start = i + 1
		}
	}
	"$(line):$(at - start + 1)"
}

// The indent of the parser's position on its line: its tabs, its spaces too inside a block indented by spaces
// Rust twin: scanning.rs skip_whitespace
def line_indent(p: Parser): int {
	at = p.at
	indent = 0
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') {
		at = at - 1
		if p.code[at] == '\t' or p.spaces { indent = indent + 1 }
	}
	indent
}

// The items of the lines indented below, the parser at the line they end before
// Rust twin: lists.rs parse_list_with_separators (indented block), blocks.rs parse_indented_block
def lines_below(p: Parser): Node := {
	outer = p.indent
	p.indent = line_indent(p)
	block = items_until(p, Bracket.None, ItemsEnd.Source)
	p.indent = outer
	// the line break after the block still separates the next statement
	while p.at > 0 and is_blank(p.code[p.at - 1]) { p.at = p.at - 1 }
	block
}

// The block indented below a head that ends its line, `for x in xs:` and its lines; ø with nothing read if none
// Rust twin: blocks.rs parse_indented_block, curly_block
def indented_block(p: Parser): Node := {
	before = p.at
	outer_spaces = p.spaces
	newline = skip_blanks(p)
	p.spaces = outer_spaces or p.code[p.at - line_blanks(p) .. p.at].contains(" ")
	if not newline or line_indent(p) <= p.indent {
		p.spaces = outer_spaces
		p.at = before
		return ø
	}
	block = lines_below(p)
	p.spaces = outer_spaces
	skip_end_line(p)
	lines = group_parts(block)
	if lines != ø and lines#1 == "" { return listed(Bracket.Curly, lines#2 as Separator, lines#3) }
	// one statement, as `{ statement }` reads it
	phrase(Bracket.Curly, [block])
}

// The words that may stand alone on the line after a block read by indentation: Ruby's `end`, the shell's `fi`
INDENTED_BLOCK_ENDS = ["end", "fi"]
// One of INDENTED_BLOCK_ENDS alone on the line after a block read by indentation, at the head's indent, read; the
// line break before the next statement stays
// Rust twin: blocks.rs skip_end_line
def skip_end_line(p: Parser) {
	before = p.at
	newline = skip_blanks(p)
	for closer in INDENTED_BLOCK_ENDS {
		if newline and keyword_at(p, closer) and line_indent(p) == p.indent and line_ends_after(p, p.at + closer.length) {
			p.at = p.at + closer.length
			return
		}
	}
	p.at = before
}

def line_blanks(p: Parser): int {
	at = p.at
	while at > 0 and (p.code[at - 1] == ' ' or p.code[at - 1] == '\t') { at = at - 1 }
	p.at - at
}

// Only blanks follow `at` on its line
def ends_line(p: Parser, at: int): bool := line_ends_after(p, at)

// The body after `:` or `do`: the block indented below when the line ends, else the rest of the line
// Rust twin: blocks.rs colon_body
def colon_body(p: Parser, width: int): Node := {
	p.at = p.at + width
	if only_blanks_before_newline(p) {
		block = indented_block(p)
		if block != ø { return block }
	}
	skip_spaces(p)
	statement_words(p)
}

// The separator after an item, consumed: a comma, a semicolon, a newline, a blank, or none before the closer
// Rust twin: lists.rs parse_separator
def separator(p: Parser, closer: text, newline: bool): Separator {
	if p.at >= p.n or p.code[p.at] == closer or closes_block(p) { return Separator.None }
	c = p.code[p.at]
	if c == ',' {
		p.at = p.at + 1
		return Separator.Comma
	}
	if c == ';' {
		p.at = p.at + 1
		return if only_blanks_before_newline(p) then Separator.Newline else Separator.Semicolon
	}
	if newline then Separator.Newline else Separator.Space
}

def only_blanks_before_newline(p: Parser): bool := line_ends_after(p, p.at)

// A tab between two items of a line separates columns: `'1+1'⇥2` is a list of two (tab-separated test pairs);
// indentation and a tab before a comment or the line's end separate nothing
// Rust twin: scanning.rs at_tab_separator
def tab_separates(p: Parser): bool {
	start = p.at - line_blanks(p)
	end = blank_end(p, p.at)
	if start == 0 or p.code[start - 1] == '\n' or line_ends_after(p, p.at) { return false }
	p.code[start ..< end].contains('\t')
}

// How loosely a separator groups: a blank tightest, a newline loosest, none (the end) never
def precedence(separator: Separator): int := match separator {
	Separator.Space: 0
	Separator.Comma: 2
	Separator.Semicolon: 3
	Separator.Tab: 4
	Separator.Newline: 5
	_: NEVER_SPLITS
}
NEVER_SPLITS = 255

// [[item, separator], …] as one list: the loosest separator splits first, the groups between split by the tighter ones
// Rust twin: lists.rs group_by_separators
def grouped(pairs: list, bracket: Bracket): Node := {
	if pairs.length == 0 { return if bracket == Bracket.Curly or bracket == Bracket.Square then listed(bracket, Separator.None, []) else ø }
	if pairs.length == 1 and bracket == Bracket.None { return pairs#1#1 }
	loosest = -1
	for pair in pairs {
		level = precedence(pair#2)
		if level < NEVER_SPLITS and level > loosest { loosest = level }
	}
	if loosest < 0 { return phrase(bracket, [pair#1 for pair in pairs]) }
	split = Separator.None
	for pair in pairs {
		if split == Separator.None and precedence(pair#2) == loosest { split = pair#2 }
	}
	groups = []
	group = []
	for pair in pairs {
		if precedence(pair#2) == loosest {
			group += [[pair#1, Separator.None]]
			groups += [group]
			group = []
		} else {
			group += [pair]
		}
	}
	if group.length > 0 { groups += [group] }
	nodes = [if group.length == 1 and group#1#2 == Separator.None then group#1#1 else grouped(group, Bracket.None) for group in groups]
	if nodes.length == 1 and bracket == Bracket.None { return nodes#1 }
	if split == Separator.Space { return phrase(bracket, nodes) }
	if split == Separator.Comma { return comma_list(bracket, nodes) }
	listed(bracket, split, nodes)
}

// Words side by side; `print ord c` and `{ print ord c }` print the rest of the line as one value
// Rust twin: commands.rs grouped_list
def phrase(bracket: Bracket, nodes: list): Node := {
	guarded = if bracket == Bracket.Square then ø else guarded_command(nodes)
	if guarded != ø { return guarded }
	assigned = if bracket == Bracket.Square then ø else of_assignment(nodes)
	if assigned != ø { return if bracket == Bracket.None then assigned else listed(bracket, Separator.Space, [assigned]) }
	if not (bracket == Bracket.None or bracket == Bracket.Curly) or nodes.length < 3 or nodes#1 != PRINT { return listed(bracket, Separator.Space, nodes) }
	listed(bracket, Separator.Space, [nodes#1, spaced(nodes[1:])])
}
PRINT = symbol("print")
OF = symbol("of")

// `of` binds tighter than `=`: `width of canvas = 12` and `square of int = it * it` assign to the phrase, not to its
// last word
def of_assignment(nodes: list): Node? := {
	if nodes.length < 3 or not nodes[0 ..< nodes.length - 1].contains(OF) { return ø }
	match nodes#(nodes.length) {
		Key(target, Op.Assign, value): Key(listed(Bracket.None, Separator.Space, nodes[0 ..< nodes.length - 1] + [target]), Op.Assign, value)
		_: ø
	}
}

// `print a, b` and `{ print i, i*2 }`: the comma binds looser than the space, so [[print a], b] is the call print(a, b)
// Rust twin: commands.rs grouped_list, print_call
def comma_list(bracket: Bracket, nodes: list): Node := {
	head = group_parts(nodes#1)
	if not (bracket == Bracket.None or bracket == Bracket.Curly) or not prints(head) { return listed(bracket, Separator.Comma, nodes) }
	call = call_of([PRINT] + head#3[1:] + nodes[1 ..])
	if bracket == Bracket.Curly then listed(Bracket.Curly, Separator.None, [call]) else call
}

// The parts of an unbracketed phrase `print a`
def prints(phrase: list): bool := #phrase > 0 and phrase#1 == "" and phrase#2 == " " and #phrase#3 > 0 and phrase#3#1 == PRINT

// Spaces, tabs, newlines and comments skipped; whether a newline was among them
// Rust twin: scanning.rs skip_whitespace_and_comments
def skip_blanks(p: Parser): bool {
	newline = line_breaks_after(p, p.at)
	p.at = p.resumes[p.at]
	if peek(p.code, p.at, p.n) == '\\' and line_continuation_length(p) > 0 {
		p.at = p.at + line_continuation_length(p)
		return skip_blanks(p)
	}
	newline
}

// A line break lies between `at` and the code after it, or the source ends there
def line_ends_after(p: Parser, at: int): bool := p.resumes[at] >= p.n or line_breaks_after(p, at)
def line_breaks_after(p: Parser, at: int): bool := p.breaks[at] == true

// The character the code goes on with after `at` and its blanks and comments: '\n' where the line ends first
def code_after(p: Parser, at: int): text := if line_ends_after(p, at) then '\n' else p.code[p.resumes[at]]

def skip_spaces(p: Parser) {
	p.at = blank_end(p, p.at)
	continuation = line_continuation_length(p)
	if continuation > 0 {
		p.at = p.at + continuation
		skip_spaces(p)
	}
}

// The width of `\` ending its line with the newline, or of a line break and the indentation before what continues the
// line: a method call or `|>` starting the next line (`numbers⏎    .map(square)`), `else` starting it, or the line
// ending in then/else (`if c then⏎ a⏎ else⏎ b`); else 0
// Rust twin: scanning.rs line_continuation_length
def line_continuation_length(p: Parser): int {
	c = peek(p.code, p.at, p.n)
	// `1 + \` at a line's end continues the statement on the next line (was the symbol `\`, the line its own statement)
	if c == '\\' {
		at = p.at + 1
		while at < p.n and (p.code[at] == ' ' or p.code[at] == '\t' or p.code[at] == '\r') { at = at + 1 }
		if at >= p.n or p.code[at] != '\n' { return 0 }
		while at < p.n and is_blank(p.code[at]) { at = at + 1 }
		return at - p.at
	}
	if c == '\n' or c == '\r' {
		at = p.at
		while at < p.n and is_blank(p.code[at]) { at = at + 1 }
		next = peek(p.code, at + 1, p.n)
		starts_method = is_at(p.code, at, '.', p.n) and is_name_char(next) and not is_digit(next)
		starts_pipeline = is_at(p.code, at, '|', p.n) and next == '>'
		ends_in_branch_word = ["then", "else"] contains word_before(p)
		return if starts_method or starts_pipeline or keyword_at_position(p, "else", at) or ends_in_branch_word then at - p.at else 0
	}
	if c != '\\' { return 0 }
	end = spaces_end(p, p.at + 1)
	if is_at(p.code, end, '\r', p.n) { end = end + 1 }
	if is_at(p.code, end, '\n', p.n) then end + 1 - p.at else 0
}

// An expression of operators binding at least `min_power` on the left
// Rust twin: expressions.rs parse_expr, continue_expr
def expression(p: Parser, min_power: int): Node := continued(p, prefixed(p), min_power)

// The head of `if`, `while` or `for`: a `{` after it opens the body, so `f(x) {` calls f rather than defining it
def header_expression(p: Parser, min_power: int): Node := {
	outer = p.header
	p.header = true
	head = expression(p, min_power)
	p.header = outer
	head
}

// `left` and the operators after it binding at least `min_power`
// Rust twin: expressions.rs continue_expr
def continued(p: Parser, left: Node, min_power: int): Node := {
	// a prefix `if` inside a tighter operand took its own `then` (owns_branches), so its `else` too
	took_own_then = false
	// left is the phrase an implicit application made in the round before
	applied = false
	while true {
		follows_application = applied
		applied = false
		if tab_separates(p) { break }
		skip_spaces(p)
		c = peek(p.code, p.at, p.n)
		// `cd ~/notes`: a path after an operand is the next word, no operator
		if starts_path(p) { return left }
		if c == '@' and left != ø and min_power <= binding_powers("=")#2 {
			marked = trailing_attribute(p, left)
			if marked != ø {
				left = marked
				continue
			}
		}
		user_op = user_operator_at(p)
		if user_op != ø and user_op.fixity != Fixity.Prefix and user_op.level >= min_power and not is_glued_call(p, user_op.glyph) {
			p.at = p.at + user_op.glyph.length
			if user_op.fixity == Fixity.Suffix {
				left = operator_call(user_op.glyph, [left])
			} else {
				skip_blanks(p)
				left = operator_call(user_op.glyph, [left, expression(p, user_op.level + 1)])
			}
			continue
		}
		// a declared operator binding looser than the context ends the operand, unless a built-in one of the glyph binds
		if user_op != ø and user_op.fixity != Fixity.Prefix and operator_at(p).length == 0 { break }
		power = superscript_power(p, left, min_power)
		if power != ø {
			left = power
			continue
		}
		test = if left == ø then [] else test_word_at(p, min_power)
		if test.length > 0 {
			p.at = test#1
			left = tested(left, test#2, test#3)
			continue
		}
		if (c == '+' or c == '-') and is_at(p.code, p.at + 1, c, p.n) and SUFFIX_POWER >= min_power {
			op = p.code[p.at .. p.at + 2]
			p.at = p.at + 2
			left = keyed(op, left, ø)
		} else if c == '!' and SUFFIX_POWER >= min_power and bang_suffix_at(p) {
			p.at = p.at + 1
			# `x!!` is `x!`
			if is_at(p.code, p.at, '!', p.n) and not is_at(p.code, p.at + 1, '=', p.n) { p.at = p.at + 1 }
			left = forced(left)
		} else if c == '[' and p.at > 0 and not is_blank(p.code[p.at - 1]) and INDEX_POWER >= min_power {
			p.at = p.at + 1
			skip_blanks(p)
			outer_indexing = p.indexing
			p.indexing = true
			index = slice_from_start(p)
			if index == ø { index = expression(p, 0) }
			p.indexing = outer_indexing
			skip_blanks(p)
			if is_at(p.code, p.at, ']', p.n) { p.at = p.at + 1 }
			left = subscript(left, index)
		} else if c == '(' and p.at > 0 and not is_blank(p.code[p.at - 1]) and INDEX_POWER >= min_power and is_callee(left) {
			p.at = p.at + 1
			left = call_of([left] + spread(items_until(p, Bracket.Round, ItemsEnd.Closer)))
		} else if left != ø and keyword_at(p, "times") and times_binds(p, min_power) {
			p.at = p.at + 5
			skip_spaces(p)
			left = operator_call("times", [left, repeated(p)])
		} else if membership_at(p).length > 0 and not counts_units(left) {
			membership = membership_at(p)
			if MEMBERSHIP_POWERS#1 < min_power { break }
			p.at = p.at + membership#1.length
			skip_blanks(p)
			left = membership_test(left, membership#2, expression(p, MEMBERSHIP_POWERS#2))
		} else if negated_at(p) {
			// `x is not 4`, `x not in xs`, `a nand b`: `not (x is 4)`, `not (x in xs)`, `not (a and b)`
			written = negated_at(p)
			positive = NEGATED_SPELLINGS[written]
			powers = if positive == "in" then MEMBERSHIP_POWERS else binding_powers(positive)
			if powers#1 < min_power { break }
			p.at = p.at + written.length
			skip_blanks(p)
			left = Key(ø, Op.Not, operation(left, positive, expression(p, powers#2)))
		} else if down_to_at(p) > 0 {
			// `10 down to 1` is `reverse(1 to 10)`, which for_loop counts down (Rust twin: ranges.rs binary_node)
			powers = binding_powers("to")
			if powers#1 < min_power { break }
			p.at = p.at + down_to_at(p)
			skip_blanks(p)
			left = call_of([symbol("reverse"), Key(expression(p, powers#2), Op.To, left)])
		} else if trailing_guard_at(p) != "" {
			// `a = 2 if c`, `x++ while c`: guards the whole statement (left power 0)
			if min_power > 0 { break }
			word = trailing_guard_at(p)
			p.at = p.at + word.length
			skip_blanks(p)
			left = guarded_statement(left, word, condition_expression(p))
		} else {
			op = operator_at(p)
			if op.length == 0 and free_infix_at(p, left) {
				if fixity_level(Fixity.Infix) < min_power { break }
				glyph = "$(c)"
				p.at = p.at + 1
				skip_blanks(p)
				left = operator_call(glyph, [left, expression(p, fixity_level(Fixity.Infix) + 1)])
				continue
			}
			if op.length == 0 or negative_item_at(p) {
				if not applies(p, left, min_power) or comprehension_filter_at(p) { break }
				// `s + f 2 each: 3`: the labelled arguments after the argument are the call's too
				labelled = labelled_argument(p)
				// `ys = xs where it > 2`: after a clause word its whole condition or subject, as a statement's (follows_clause_word)
				given = [if labelled != ø then labelled else if ends_with_clause_word(left) then header_expression(p, 0) else argument(p, not applies_otherwise(p, min_power))]
				labelled = labelled_argument(p)
				while labelled != ø {
					given = given + [labelled]
					labelled = labelled_argument(p)
				}
				// `x = name of q with a`: the next word after an applied phrase joins it, one flat phrase as the statement is
				left = spaced((if follows_application then items_of(left) else [left]) + given)
				applied = true
				continue
			}
			powers = binding_powers(op#2)
			// one arrow, but `=>` binds as written: its body takes an assignment (Rust twin: Op::spelled_binding_power)
			if op#1 == "=>" { powers = binding_powers("=>") }
			owns = owns_branches(left, op#2, took_own_then)
			if powers#1 < min_power and not owns { break }
			// `match -3 {…}`, `xs where #it > 1`, `where to#i == n`: after a clause word a glued `#` or `-`, or an
			// operator word, starts its subject
			// Rust twin: expressions.rs continue_expr (starts_operand)
			glued_sign = (op#1 == "-" or op#1 == "#") and not is_blank(peek(p.code, p.at + 1, p.n))
			if (glued_sign or is_alpha(c)) and ends_with_clause_word(left) { break }
			took_own_then = owns and powers#1 < min_power and op#2 == "then"
			p.at = p.at + op#1.length
			// `f(n):` ending its line: the block indented below is its value
			block = if op#1 == ":" and ends_line(p, p.at) then indented_block(p) else ø
			if block != ø {
				left = Key(left, Op.Colon, block)
				continue
			}
			if op#1 == "." and peek(p.code, p.at, p.n) == "(" { raise dot_call_refused(left) }
			// `80%`, `[10%, 20%]`, `10% == 1/10`: a % with no operand after it is a percent, `50 % of 200` that much of 200
			// (decision Trailing percent, lib/sugar/arithmetic.warp)
			if op#2 == "%" and percent_ends(p) {
				left = keyed(op#2, left, ø)
				if not line_ends_after(p, p.at) and keyword_at_position(p, "of", p.resumes[p.at]) {
					p.at = p.resumes[p.at] + "of".length
					skip_blanks(p)
					left = keyed("*", left, expression(p, powers#2))
				}
				continue
			}
			skip_blanks(p)
			if is_phrase_operator(op) {
				left = phrase_operation(left, op#1, expression(p, powers#2))
			} else if DECLARED_ONLY_OPERATORS contains op#2 {
				left = operator_call(op#2, [left, expression(p, powers#2)])
			} else if op#2 == STORE_OPERATOR {
				left = call_of([symbol(HiddenWord.StoredValue as text), left, expression(p, powers#2)])
			} else if op#2 == "|>" {
				left = piped(left, expression(p, powers#2))
			} else if (op#2 == ".." or op#2 == "to") and (starts_at(p.code, "=>", p.at, p.n) or ",;)]}".contains(peek(p.code, p.at, p.n)) or (left is symbol and name_of(left).starts_with("$") and keyword_at(p, "for"))) {
				// the match arm `65.. => "senior"`, the rest hole `$xs... => …`, `($as..., $bs...)`: a range without end; also a
				// rule's rest hole before a comprehension's clause, `[$e... for $x in $xs]` (card sugar-comprehensions)
				left = keyed(op#2, left, ø)
			} else {
				right = if END_BLOCK_WORDS contains op#2 then end_block_operand(p, op#2, powers#2) else expression(p, powers#2)
				// `x(p: P) -> int := …`, Swift's and Rust's result arrow, is the typed head `x(p: P): int := …`
				if op#2 == ":=" or op#2 == "=" { left = result_typed(left) }
				left = keyed(bit_operator(op#1, left, right, op#2), left, if op#2 == ":" then with_switch_cases(p, right) else right)
				// `{f: x => x * 2}`: the field f holds the lambda; `f: (float) -> float` stays a typed name
				if op#1 == "=>" { left = field_holding_lambda(left) }
			}
		}
	}
	left
}

// `3 & 5`, `a & 1`, `x | 4`: a single `&` or `|` between operands that may be whole numbers combines their bits, between
// others it is and/or (`yes & no`, `a > 1 & b`, `int | text`); `xs | sort` stays an or, which may pipe; else `spelled`
// Rust twin: expressions.rs bitwise, pipes.rs may_be_stage
// `x(p: P) -> int` before `:=` or `=`, a call's result arrow, as the typed head `x(p: P): int`; any other target as it is
// Rust twin: welcome_forms.rs lower_arrow_result_types
def result_typed(target: Node): Node := match target {
	Key(head, Op.Arrow, result): { if calls_by_name(head) then Key(head, Op.Colon, result) else target }
	_: target
}
def calls_by_name(n: Node): bool := match n {
	List(parts, Bracket.Round, separator): #parts > 0 and parts#1 is symbol
	_: no
}

def bit_operator(written: text, left: Node, right: Node, spelled: text): text {
	if not (written == "&" or written == "|") or not may_be_whole_number(left) or not may_be_whole_number(right) { return spelled }
	if written == "|" and right is symbol { return spelled }
	written
}

// A number, a name or an operation that may give a whole number: no float, text, list, type word, capitalized name,
// comparison or logical operation; `a xor b` of whole numbers is their bits' xor, `(e xor m) & g` bits again
// Rust twin: lowering/nodes.rs may_be_whole_number
def may_be_whole_number(n: Node): bool := match n {
	Symbol(name): not is_type_word(name) and not is_capitalized(name)
	Key(left, op, right): if op == Op.Xor then may_be_whole_number(left) and may_be_whole_number(right) else not (NOT_WHOLE_OPERATORS contains op)
	List(items, bracket, separator): bracket != Bracket.Square and (items is empty or may_be_whole_number(items#1))
	_: n is int and not (n is bool)
}
NOT_WHOLE_OPERATORS = [Op.Eq, Op.Is, Op.Ne, Op.Identical, Op.NotIdentical, Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.And, Op.Or, Op.Not]

// Ruby/Lua `do … end`, `then … else … end`: the words whose body an `end` may close, and those that open such a body
END_BLOCK_WORDS = ["do", "then", "else"]
END_BLOCK_OPENERS = ["do", "then"]

// The `end` keywords and openers of a source in order, as running balances: an opener adds one, an `end` takes one
// away. A body opened before a word closes when the balance later falls below the one before that word, so the lowest
// balance from each word on answers every search with one lookup (parsing stays linear, test_parse_long_definitions)
// Rust twin: blocks.rs ClosingEnds
class ClosingEnds { word_starts: list; balances: list; lowest_from: list }

def closing_ends_of(code: text, n: int, openers: list): ClosingEnds := {
	word_starts = []
	balances = []
	balance = 0
	names_end = false
	at = 0
	while at < n {
		skipped = skipped_end(code, at, n)
		if skipped > at {
			at = skipped
		} else if is_name_start(code[at]) {
			end = name_end(code, at, n)
			word = code[at .. end]
			// `items.end` is a member, no keyword
			member = at > 0 and code[at - 1] == '.'
			names_end = names_end or (word == "end" and names_word(code, at, end, n))
			step = if member then 0 else if word == "end" then -1 else if openers contains word then 1 else 0
			if step != 0 {
				balance = balance + step
				word_starts += [at]
				balances += [balance]
			}
			at = end
		} else {
			at = at + 1
		}
	}
	// a program naming a variable `end` closes no block with it: `if a == 0 then 1 else end` hands back the variable
	if names_end { return ClosingEnds{word_starts: [], balances: [], lowest_from: []} }
	lowest_from = [balance for balance in balances]
	index = lowest_from.length - 1
	while index > 0 {
		lowest_from[index - 1] = min(lowest_from[index - 1], lowest_from[index])
		index = index - 1
	}
	ClosingEnds{word_starts: word_starts, balances: balances, lowest_from: lowest_from}
}

// Whether the word from `start` to `end` is used as a name: an assigned variable (`end = 3`), a key or field
// (`{block: 2, end: 11}`, `end: int`) or a parameter or argument between separators (`f(a, end)`; `foo(if c then 1
// else 2 end)` closes a block)
// Rust twin: blocks.rs names_block_closer
def names_word(code: text, start: int, end: int, n: int): bool {
	before = start - 1
	while before >= 0 and is_blank(code[before]) { before = before - 1 }
	after = end
	while after < n and is_blank(code[after]) { after = after + 1 }
	following = peek(code, after, n)
	assigned = following == '=' and peek(code, after + 1, n) != '='
	keyed = following == ':'
	listed = before >= 0 and "(,".contains(code[before]) and ",)".contains(following)
	assigned or keyed or listed
}

// Whether an `end` after the parser's position closes the body opened here: the openers between count, each closed by
// an `end` of its own; an `end` that closes nothing leaves the one-statement body
// Rust twin: blocks.rs closing_end_follows, ClosingEnds::close_after
def closing_end_follows(p: Parser, openers: list): bool {
	key = openers.join(" ")
	if not (key in p.closing_ends) { p.closing_ends[key] = closing_ends_of(p.code, p.n, openers) }
	ends = p.closing_ends[key]
	// the first word from the parser's position on, by bisection
	first = 0
	last = ends.word_starts.length
	while first < last {
		middle = (first + last) /! 2
		if ends.word_starts[middle] < p.at { first = middle + 1 } else { last = middle }
	}
	before = if first == 0 then 0 else ends.balances[first - 1]
	first < ends.lowest_from.length and ends.lowest_from[first] < before
}

// The operand after `do`, `then` or `else`: the statements up to its closing `end`, else the one-statement body
// Rust twin: expressions.rs continue_expr (Op::Do | Op::Then | Op::Else)
def end_block_operand(p: Parser, word: text, power: int): Node := {
	if closing_end_follows(p, END_BLOCK_OPENERS) { return end_block(p, word == "then") }
	// `do a; if c then b end`
	if word == "do" and closing_end_follows(p, ["do"]) { raise AMBIGUOUS_END }
	if word == "do" then expression(p, power) else branch(p, power)
}

AMBIGUOUS_END = "ambiguous `end`: it closes either the `then` or the `do`; as in Ruby and Lua every `then … end` and `do … end` needs its own: write `while c do … if x then … end end` or `while c { … if x { … } }`"

// The statements up to the closing `end` (consumed) as a `{…}` block; a `then` block also ends at its `else`
// Rust twin: blocks.rs parse_end_block
def end_block(p: Parser, stops_at_else: bool): Node := items_until(p, Bracket.Curly, if stops_at_else then ItemsEnd.EndOrElse else ItemsEnd.End)

// What closes the items, as the messages name it; ' ' where no character does
def closer_of(bracket: Bracket, ends: ItemsEnd): text := match ends {
	ItemsEnd.Closer: closing_of(bracket as text)
	ItemsEnd.End: "end"
	ItemsEnd.EndOrElse: "end else"
	_: ' '
}

// Whether the parser stands at the word closing the Ruby block `closer`
// Rust twin: blocks.rs at_block_close
def closes_block(p: Parser): bool := p.group.stops_at_end and (keyword_at(p, "end") or (p.group.in_branch and keyword_at(p, "else")))

// The control words that guard or loop the statement before them: `a = 2 if c`, `a = 2 unless c`, `x++ while c`,
// `x++ until c`
// Rust twin: spellings.rs (if, unless, while, until as infix operators), lookahead.rs operator_in_context
TRAILING_GUARD_WORDS = ["if", "unless", "while", "until"]
// The trailing guard word at the parser's position, else ""; an `if` with its own `then` or block starts a branch, an
// `until` in a loop's iterable is the range word (`for i in 1 until 5`)
def trailing_guard_at(p: Parser): text {
	for word in TRAILING_GUARD_WORDS {
		if keyword_at(p, word) and operand_after(p, word.length) and not starts_branch(p, word) and not (word == "until" and p.iterable) { return word }
	}
	""
}
def starts_branch(p: Parser, word: text): bool := word == "if" and condition_has_branch(p, p.at + word.length)

// Whether the condition from `at` to the end of its statement has a branch: a spaced `{` outside brackets
// (`point{x:1}` is data) or `then`. A match arm's guard has none: `n if n > 3 => {…}` ends at the `=>`, and
// `if k in {a: 1} => …` holds a map
// Rust twin: if_else.rs condition_has_branch
def condition_has_branch(p: Parser, at: int): bool {
	depth = 0
	spaced_brace_open = false
	// ' ' while outside quotes
	open_quote = ' '
	for i in at ..< p.n {
		c = p.code[i]
		if open_quote != ' ' {
			if c == closing_of(open_quote) { open_quote = ' ' }
		} else if opens_text(c) {
			open_quote = c
		} else if c == '{' and depth == 0 {
			// a comparison, not is_blank: a `: bool` call is an Int to the analyzer (card bool-call-int)
			spaced_brace_open = p.code[i - 1] == ' ' or p.code[i - 1] == '\t'
			depth = depth + 1
		} else if c == '(' or c == '[' or c == '{' {
			depth = depth + 1
		} else if c == ')' or c == ']' or c == '}' {
			if depth == 0 { return false }
			if c == '}' and depth == 1 and spaced_brace_open {
				if not starts_at(p.code, "=>", blank_end(p, i + 1), p.n) { return true }
				spaced_brace_open = false
			}
			depth = depth - 1
		} else if depth == 0 {
			if starts_at(p.code, "=>", i, p.n) or c == '\n' or c == ';' { return false }
			if c == 't' and not is_name_char(p.code[i - 1]) and keyword_at_position(p, "then", i) { return true }
		}
	}
	spaced_brace_open
}

// `x if c` is `if c then x`, `x unless c` is `if not c then x`, `x while c` is `while c do x`, `x until c` is `while
// not c do x`; a trailing `while` tests before the first round like the leading one 
// Rust twin: conditions.rs guarded_statement
def guarded_statement(statement: Node, word: text, condition: Node): Node := {
	guard = control_condition(word, condition)
	if CONTROL_WORDS[word] == "while" then Key(Key(ø, Op.While, guard), Op.Do, statement) else Key(Key(ø, Op.If, guard), Op.Then, statement)
}

// `pattern: match v {…}`: the arm's value is the whole inner match, its subject and its cases on the line, though `:`
// binds tighter than the words after it (card match-arm-whose)
// Rust twin: control/switch.rs with_switch_cases
def with_switch_cases(p: Parser, value: Node): Node {
	opens_switch = value == symbol("match") or value == symbol("switch")
	if not opens_switch or not starts_atom_at(p, blank_end(p, p.at)) { return value }
	skip_blanks(p)
	parts = [value, argument(p, true)]
	if is_at(p.code, blank_end(p, p.at), '{', p.n) {
		skip_blanks(p)
		parts = parts + [atom(p)]
	}
	spaced(parts)
}

// A prefix `if` takes its own `then` and `else` wherever it stands: `pattern: if c then a else b` is the arm giving the
// whole if, though `:` binds tighter than `then`. Only an `else` after a `then` the if took this way: `if a then if b
// then c else d` keeps its else for the outer if.
// Rust twin: expressions.rs owns_branches
def owns_branches(left: Node, op: text, took_own_then: bool): bool := match left {
	Key(condition, Op.If, test): op == "then" and condition == ø
	Key(branches, Op.Then, value): op == "else" and took_own_then
	_: false
}

// `n times {…}` binds below assignment, `n times [x]` to the count before it, `it times it` like `*`
// Rust twin: suffixes.rs try_parse_control_suffix
def times_binds(p: Parser, min_power: int): bool {
	at = blank_end(p, p.at + 5)
	c = peek(p.code, at, p.n)
	value_follows = is_digit(c) or opens_text(c) or is_name_start(c)
	min_power <= TIMES_POWER or c == '[' or (value_follows and min_power <= 150)
}

TIMES_POWER = 50

// What `n times` repeats, the prelude's infix times: a block, `: body` as a block, a list or a value
// Rust twin: suffixes.rs parse_times_loop
def repeated(p: Parser): Node := {
	if is_at(p.code, p.at, ':', p.n) {
		body = colon_body(p, 1)
		return if is_block(body) then body else listed(Bracket.Curly, Separator.Semicolon, [body])
	}
	atom(p)
}

// The name before the parser's position and blanks, else ""
// Rust twin: definitions/functions.rs after_function_keyword_word
def word_before(p: Parser): text {
	end = p.at
	while end > 0 and is_blank(p.code[end - 1]) { end = end - 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start = start - 1 }
	p.code[start .. end]
}

// An infix word of lib/aliases.warp before a block names it: `div {…}` is the html tag, `7 div 2` divides
def names_block(p: Parser, word: text): bool := alias_spellings().infix_words.contains(word) and opens_block(p, word.length)
// A block opens after the `width` characters at the parser's position and blanks: `div {…}` is the html tag
def opens_block(p: Parser, width: int): bool {
	is_at(p.code, blank_end(p, p.at + width), '{', p.n)
}

// `is not`, `isn't` at the parser's position, else ""
// Spellings of a negated operator, each with the spelling it negates: `a nand b` is `not (a and b)`, `x isn't 4`
// `not (x is 4)`, Python's `x not in xs` `not (x in xs)`
// Rust twin: spellings.rs NEGATED_SPELLINGS
NEGATED_SPELLINGS = {"nand": "and", "¬&": "and", "⊼": "and", "is not": "is", "isn't": "is", "isn’t": "is", "not in": "in", "∉": "in"}
NEGATED_STARTS = by_first_character(NEGATED_SPELLINGS.keys)
def negated_at(p: Parser): text := starting_here(NEGATED_STARTS, p, p.at).find(written => keyword_at(p, written)) ?? ""

// how tightly `x in xs` binds on its left and right
MEMBERSHIP_POWERS = [115, 116]
def membership_test(left: Node, word: text, right: Node): Node := spaced([left, symbol(word), right])
// `a and b`, `x is 4`, `x in xs` of the operator's spelling
def operation(left: Node, spelling: text, right: Node): Node := if spelling == "in" then membership_test(left, spelling, right) else keyed(spelling, left, right)

// `x in xs`, `xs contains x`: the membership word at the parser's position as [written, word], else []; `x is in xs` is
// `x in xs`
// Rust twin: expressions.rs special_infix
def membership_at(p: Parser): list {
	if keyword_at(p, "is in") { return ["is in", "in"] }
	if keyword_at(p, "in") { return ["in", "in"] }
	word = word_at(p)
	if keyword_form(word) == "contains" and operand_after(p, word.length) and not assigned_at(p, p.at + word.length) { return [word, word] }
	// `x ∈ xs`, `xs ∋ x`: an alias of a membership word
	alias = alias_at(p)
	if alias.length > 0 and (alias#2 == "in" or keyword_form(alias#2) == "contains") { return alias }
	[]
}

// A unit word stays in the flat counting phrase `number of chars in t`
// Rust twin: counting.rs text_unit
def counts_units(left: Node): bool := left is symbol and UNIT_WORDS.contains(name_of(left))

UNIT_WORDS = ["byte", "bytes", "char", "chars", "character", "characters", "codepoint", "codepoints", "grapheme", "graphemes"]

// An operand follows `width` characters on: blanks, then no end of the expression
// Rust twin: scanning.rs operand_after
// `alias contains = collection_contains`: an assignment's `=` (no `==`) after the blanks at `at`
def assigned_at(p: Parser, at: int): bool {
	sign = blank_end(p, at)
	is_at(p.code, sign, '=', p.n) and not is_at(p.code, sign + 1, '=', p.n)
}
def operand_after(p: Parser, width: int): bool {
	at = p.at + width
	if not (is_at(p.code, at, ' ', p.n) or is_at(p.code, at, '\t', p.n)) { return false }
	not "\n)]};,".contains(code_after(p, at))
}

// `x = f y`, `1 + count xs`: a name before an operand is called with it, as an assignment's value, in an operand from
// `or` up to `+` (not in an argument or a loop header) or with an argument that is no name, never before `for`
// Rust twin: suffixes.rs try_parse_implicit_application
def applies(p: Parser, left: Node, min_power: int): bool {
	if min_power == 0 or min_power > 151 { return false }
	// `do r += i end`: the `end` closing the block is no argument
	if p.group.stops_at_end and keyword_at(p, "end") { return false }
	callable = left is symbol or is_list_of(left, "")
	if not callable { return false }
	c = peek(p.code, p.at, p.n)
	if c == '{' and p.header { return false }
	// `[if c then 1 else c for c in t]`: a `for` clause takes no argument of the word before it (`for:` labels one)
	if keyword_at(p, "for") and peek(p.code, p.at + 3, p.n) != ':' { return false }
	in_operand = min_power >= OPERAND_POWERS#1 and min_power <= OPERAND_POWERS#2 and min_power != ARGUMENT_POWER and (if p.iterable then word_ends_header(p) else not word_begins_item(p))
	(applies_otherwise(p, min_power) or in_operand) and (unnamed_at(p) or is_name_start(c))
}

// `r = move 1 from: 10 to: 3`: a label word with a colon and a blank after it labels the argument after them, also
// where the call is an operand (decision labels-calls); ø where no label stands
// Rust twin: suffixes.rs labelled_argument
def labelled_argument(p: Parser): Node := {
	at = blank_end(p, p.at)
	end = name_end(p.code, at, p.n)
	if end == at or not label_words.contains(p.code[at .. end]) or not is_at(p.code, end, ':', p.n) or not " \t".contains(peek(p.code, end + 1, p.n)) { return ø }
	p.at = end + 1
	skip_spaces(p)
	Key(symbol(p.code[at .. end]), Op.Colon, expression(p, ARGUMENT_POWER))
}

// `x empty`, `x missing`, `x is absent` … ending a condition (wiki/null.md): [the end of the word, the word, whether
// `is` stood before it], else []; the word ends the condition where no operand follows it, or a block, a colon or an
// operator word does
// Rust twin: conditions.rs try_parse_test_word
TEST_WORDS = ["empty", "missing", "absent", "unknown", "undefined", "failed"]
TEST_WORD_STARTS = by_first_character(TEST_WORDS)
NOT_POWER = 105
def test_word_at(p: Parser, min_power: int): list {
	if min_power > NOT_POWER { return [] }
	after_is = keyword_at(p, "is")
	start = if after_is then blank_end(p, p.at + 2) else p.at
	word = starting_here(TEST_WORD_STARTS, p, start).find(candidate => keyword_at_position(p, candidate, start)) ?? ""
	if word == "" { return [] }
	end = start + word.length
	after = blank_end(p, end)
	next = peek(p.code, after, p.n)
	following = p.code[after .. name_end(p.code, after, p.n)]
	ends = not operand_follows_at(p, end) or next == '{' or next == ':' or word_operators().any(op => op#1 == following)
	if ends then [end, word, after_is] else []
}
// `x is empty`, `x failed` as their phrase, the test word kept as written (`empty` alone reads as ø): its meaning is
// lib/sugar/test_words.warp's rules
def tested(left: Node, word: text, after_is: bool): Node := spaced([left] + (if after_is then [symbol("is")] else []) + [symbol(word)])

// The word here begins what follows the operand: a loop clause, a block's `end`, a key (`_: 0`) or an element (`p{m}`)
// Rust twin: suffixes.rs word_begins_item
def word_begins_item(p: Parser): bool {
	if keyword_at(p, "for") or keyword_at(p, "end") or else_if_at(p) { return true }
	at = p.at
	while at < p.n and is_name_char(p.code[at]) { at = at + 1 }
	if at == p.at { return false }
	c = peek(p.code, at, p.n)
	next = peek(p.code, at + 1, p.n)
	c == '{' or (c == ':' and not (next == ':' or next == '='))
}

// The word here is a loop header's last, the body follows it (`for i in 1 to count xs {…}`, `… do …`, `…:` or an
// indented line): it is the argument of the word before rather than that word's body
// Rust twin: suffixes.rs word_ends_header
def word_ends_header(p: Parser): bool {
	if not is_name_start(peek(p.code, p.at, p.n)) { return false }
	start = p.at
	p.at = name_end(p.code, p.at, p.n)
	skip_spaces(p)
	indented_line_follows = is_at(p.code, p.at, '\n', p.n) and " \t".contains(peek(p.code, p.at + 1, p.n))
	ends = at_to_header_end(p) or keyword_at(p, "do") or indented_line_follows
	p.at = start
	ends
}

// An assignment's value, a branch or an argument that is no name is called with whatever the operand is
def applies_otherwise(p: Parser, min_power: int): bool := min_power <= 60 or min_power == p.branch_power or unnamed_at(p)

def unnamed_at(p: Parser): bool {
	c = peek(p.code, p.at, p.n)
	is_digit(c) or opens_text(c) or c == '(' or c == '[' or c == '{' or c == '-'
}

// The argument of a braceless call; `while i < count t {…}`: a block after an operand's argument is the body
def argument(p: Parser, block_ends: bool): Node := {
	outer = p.header
	p.header = outer or block_ends
	value = expression(p, ARGUMENT_POWER)
	p.header = outer
	value
}

// The operands a braceless call binds in: the right sides of `or` to `+`
OPERAND_POWERS = [91, 141]

// A braceless argument takes arithmetic and ranges, stops at comparisons: `f 3-1 > 5`, `y = sum 1..4`
ARGUMENT_POWER = 130

// The marks of a slice from the start, `xs[:3]`, `xs[...3]`, each with its operator
// Rust twin: subscripts.rs SLICE_FROM_START
SLICE_FROM_START = [[":", ":"], ["…", "to"], ["...", "to"], ["..", ".."]]

// `[:end]`, `[...last]`, `[..end]`, `[:]`: a slice from the start, `ø:end`, else ø with nothing read
// Rust twin: subscripts.rs parse_slice_from_start
def slice_from_start(p: Parser): Node := {
	for mark in SLICE_FROM_START {
		if starts_at(p.code, mark#1, p.at, p.n) {
			p.at = p.at + mark#1.length
			skip_blanks(p)
			if is_at(p.code, p.at, ']', p.n) { return keyed(mark#2, ø, ø) }
			return keyed(mark#2, ø, expression(p, 0))
		}
	}
	ø
}

// Below member access and indexing: `xs#1++`, `xs#2!`
SUFFIX_POWER = 165

// The `!` at the parser's position is the suffix `x!`, not a `!=` nor a prefix `!` of the operand after it: glued to
// its operand and followed by a blank, an infix operator or `)` (`name! email?`, `x!+1`), or no operand follows
// Rust twin: suffixes.rs try_parse_evaluate_bang
def bang_suffix_at(p: Parser): bool {
	next = peek(p.code, p.at + 1, p.n)
	if next == '=' { return false }
	glued = p.at > 0 and not is_blank(p.code[p.at - 1]) and " \t!+-*/%^<>)".contains(next)
	glued or not operand_follows(p, 1)
}

// `left!` (or `left!!`): `upper(x)!` assigns the result back to x, `{…}!` runs the block anyway, anything else
// is `unwrap(left)`, which lib/sugar/methods.warp turns into an assignment back where a function's call is marked
// (`x.upper!`, `upper x!`), and which runs a lone `x!` as it is
// Rust twin: suffixes.rs try_parse_evaluate_bang
def forced(left: Node): Node := {
	if left == ø { return call_of([symbol("unwrap"), ø]) }
	variable = mutated_variable(left)
	if variable != ø and not is_member(left) { return Key(variable, Op.Assign, left) }
	if is_block(left) { return left }
	call_of([symbol("unwrap"), left])
}

def is_member(node: Node): bool := match node {
	Key(receiver, Op.Dot, member): yes
	_: no
}

// The variable a call written before `!` changes: x in `x.upper`, `x.upper()` and `upper(x)`
// Rust twin: mutation.rs mutated_variable
def mutated_variable(call: Node): Node := match call {
	Key(receiver, Op.Dot, method): { if receiver is symbol and is_method(method) then receiver else ø }
	List(parts, Bracket.Round, separator): { if #parts == 2 and parts#1 is symbol and parts#2 is symbol then parts#2 else ø }
	_: ø
}

def is_method(node: Node): bool {
	parts = group_parts(node)
	node is symbol or (parts != ø and #parts#3 > 0 and parts#3#1 is symbol)
}
// An operand a glued `(` calls, as `f(x)` calls a name: a group `(x => x*2)(5)`, a call's result `adder(5)(1)`, an
// element `fs[0](3)`; a number it multiplies (`(2)(3)`, emitter closure_call). A block `{it*2}(5)` stays side by side
// with its argument, the one shape `{it*2} 5` applies by
def is_callee(left: Node): bool := is_list_of(left, "(") or is_element(left)
def is_element(n: Node): bool := match n {
	Key(target, op, index): op == Op.Hash
	_: false
}
// `[a -1]`, `f it -1`, `x -1`: a minus spaced before and glued after starts a negative operand, a new item, not a
// subtraction (decision glued-negative); `a - 1` and `a-1` subtract, so does `-` inside an index, `xs[i -1]`
def negative_item_at(p: Parser): bool {
	if p.indexing or not is_at(p.code, p.at, '-', p.n) or p.at == 0 or not is_blank(p.code[p.at - 1]) { return false }
	next = peek(p.code, p.at + 1, p.n)
	not is_blank(next) and not "=->".contains(next)
}

// The left power of `#`, which a glued `[` indexes with
INDEX_POWER = 170

// The operators written with symbols, longest first, each with its canonical name; alias_spellings() adds their other
// spellings (lib/aliases.warp)
// Rust twin: lookahead.rs peek_operator, operators.rs Op::as_str
SYMBOL_OPERATORS = {"?.": "?.", "===": "===", "!==": "!==", "/!": "/!", "??": "??", "?:": "?:", "··": "··", ":=": ":=", "::": "::", "->": "->", "|>": "|>", "+=": "+=", "-=": "-=", "*=": "*=", "/=": "/=", "<<": "<<", ">>": ">>", "<=": "<=", ">=": ">=", "==": "==", "!=": "!=", "..": "..", ":": ":", "=": "=", "←": "←", "<-": "←", ".": ".", "+": "+", "±": "±", "-": "-", "*": "*", "/": "/", "%": "%", "^": "^", "<": "<", ">": ">", "≈": "≈", "~": "~", "#": "#", "?": "?", "↑": "↑", "↓": "↓"}
// The operators kept as the phrase [a op b] for the sugar to read: `a ?: b` is a or its fallback
// (lib/sugar/fallbacks.warp); so are each operator's element-wise form `.op` and compound assignment `op=`
PHRASE_OPERATORS = ["?:"]
// the canonical name of a compound assignment `x op= y`, which binds as `=`
COMPOUND_ASSIGNMENT = "op="
def is_phrase_operator(op: list): bool := PHRASE_OPERATORS.contains(op#1) or op#2 == COMPOUND_ASSIGNMENT or is_dotted(op)
// `.<` of `xs .< 2`: an operator's element-wise form, its canonical name the operator's (it binds as that one does)
def is_dotted(op: list): bool := op#1.length > 1 and op#1#1 == '.' and op#1[1 ..] == op#2
// `abs.(xs)`, Julia's dot call: warp has none (decision no-dot-call-broadcast), a function of numbers broadcasts by itself
// and `each` applies any other to every item
def dot_call_refused(f: Node): text {
	name = if f is symbol then name_of(f) else "f"
	"no dot call " + name + ".(…): did you mean `" + name + " xs`, or `" + name + " each xs` for a function taking a list?"
}
// `left op right` as its phrase, for the sugar to read (lib/sugar/arithmetic.warp, fallbacks.warp)
def phrase_operation(left: Node, op: text, right: Node): Node := spaced([left, symbol(op), right])
// The operators written as words, each with its canonical name; alias_spellings() adds the infix words of lib/aliases.warp
WORD_OPERATORS = {"then": "then", "else": "else", "and": "and", "xor": "xor", "or": "or", "is": "is", "do": "do", "to": "to", "as": "as", "rem": "rem"}
// The words that are operators in a loop's iterable alone: Kotlin's `for i in 0 until n` (elsewhere `until` guards)
// Rust twin: lookahead.rs operator_in_context (in_for_header)
ITERABLE_WORD_OPERATORS = [["until", ".."]]
// The iterable's own operator at the parser's position as [written, canonical], else []
def iterable_operator_at(p: Parser): list {
	for op in ITERABLE_WORD_OPERATORS { if keyword_at(p, op#1) { return op } }
	[]
}

// The operator at the parser's position as [written, canonical], else []: a spelled one, the element-wise form `.op`
// of one, or the compound assignment `op=` of one or of a function's word (decisions dot-operators-now,
// op-assign-general): `xs .< 2`, `x ^= 3`, `x max= 5`, `xs .*= 2`; in a rule its operator hole, `.$op`, `$op=`
def operator_at(p: Parser): list {
	spelled = dotted_operator_at(p)
	if spelled.length == 0 { spelled = spelled_operator_at(p) }
	written = if spelled.length > 0 then spelled#1 else operand_word_at(p)
	if written != "" and assigns_after(p, written.length) and (if spelled.length == 0 then not declares_before(p) else computes(spelled#2)) { return [written + "=", COMPOUND_ASSIGNMENT] }
	spelled
}
// the word before the operand is one declaring it, `const x=5`, `let n=5`, or its type, `int i=2*3`: its `x=` an
// assignment, no `x max= 5`
DECLARING_WORDS = ["let", "var", "global", "export", "import", "const", "constant", "final", "mutable", "mut", "val", "static"]
def declares_before(p: Parser): bool {
	end = p.at
	while end > 0 and is_blank(p.code[end - 1]) { end = end - 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start = start - 1 }
	word = p.code[start ..< end]
	word in DECLARING_WORDS or (end < p.at and known_type(word, p.types))
}
// `=` alone (no `==`) right after `width` characters
def assigns_after(p: Parser, width: int): bool := peek(p.code, p.at + width, p.n) == '=' and peek(p.code, p.at + width + 1, p.n) != '='
// an operator computing a value of its two sides, which has an element-wise form and a compound assignment: one
// binding between `or` and `^` (binding_powers), but for the range, the pipe, the cast and the fallback there
def computes(canonical: text): bool {
	power = binding_powers(canonical)#1
	power >= binding_powers("or")#1 and power <= binding_powers("^")#1 and canonical not in ["..", "to", "|>", "as", "??"]
}
// `.<`, `.*`: a `.` glued to a computing operator; a word's after a blank, `xs .and ys` (`x.is(y)` calls the method
// is), and so `.$op`, a rule's hole of one
def dotted_operator_at(p: Parser): list {
	if peek(p.code, p.at, p.n) != '.' { return [] }
	spaced = p.at > 0 and is_blank(p.code[p.at - 1])
	if is_name_start(peek(p.code, p.at + 1, p.n)) and not spaced { return [] }
	if peek(p.code, p.at + 1, p.n) == '$' and spaced {
		hole = operand_word_at_from(p, p.at + 1)
		return if hole == "" then [] else ["." + hole, hole]
	}
	p.at = p.at + 1
	inner = unassigned(spelled_operator_at(p))
	p.at = p.at - 1
	if inner.length > 0 and inner#1#1 != '.' and computes(inner#2) then ["." + inner#1, inner#2] else []
}
// the operator of a compound assignment the parser keeps, `*` of `*=` (`xs .*= 2`), else the spelled one
def unassigned(spelled: list): list {
	if spelled.length == 0 or not spelled#1.ends_with("=") or spelled#1.length < 2 or computes(spelled#2) { return spelled }
	written = spelled#1[0 ..< spelled#1.length - 1]
	canonical = canonical_operator(written)
	if canonical == "" then spelled else [written, canonical]
}
// the word at the parser's position, `$op` a rule's hole too, else ""
def operand_word_at(p: Parser): text := operand_word_at_from(p, p.at)
def operand_word_at_from(p: Parser, at: int): text {
	start = if peek(p.code, at, p.n) == '$' then at + 1 else at
	if not is_name_start(peek(p.code, start, p.n)) { return "" }
	p.code[at .. name_end(p.code, start, p.n)]
}
// The operator spelled at the parser's position as [written, canonical], else []
// (each text read is a walk from its start, card text-costs: the character is read once and picks the candidates)
def spelled_operator_at(p: Parser): list {
	c = peek(p.code, p.at, p.n)
	if is_name_start(c) {
		if bang_word_at(p) > 0 or word_names_key(p, word_at(p)) { return [] }
		word = word_operator_at(p, c)
		if word.length > 0 { return word }
		if p.iterable and iterable_operator_at(p).length > 0 { return iterable_operator_at(p) }
		return aliased_operator_at(p)
	}
	if starts_at(p.code, "//", p.at, p.n) { return [] }
	// `x = 1  # one` is a comment, `xs #1` the index operator (card parser-parses)
	if c == '#' and skipped_end(p.code, p.at, p.n) > p.at { return [] }
	spelled_symbol = symbol_operator_at(p, c)
	if spelled_symbol.length > 0 then spelled_symbol else aliased_operator_at(p)
}
// The operator word at the parser's position as [written, canonical], else []
def word_operator_at(p: Parser, c: text): list {
	for pair in word_operators() {
		written = pair#1
		if written#1 == c and keyword_at(p, written) and not (p.group.in_branch and written == "else") and not names_block(p, written) { return pair }
	}
	[]
}
// The operator symbol at the parser's position as [written, canonical], the longest, else []
// (`c ?.5 : 1` keeps its ternary: `?.` before a digit is `?` and the number .5)
def symbol_operator_at(p: Parser, c: text): list {
	for pair in symbol_operators() {
		written = pair#1
		if written#1 == c and starts_at(p.code, written, p.at, p.n) and (written != ">>" or operand_follows(p, 2)) and (written != "?." or not is_digit(peek(p.code, p.at + 2, p.n))) { return pair }
	}
	[]
}

// An operand follows `width` characters on, after any blanks: `n >> 7` shifts, `list<list<int>>` closes two generics
// Rust twin: lookahead.rs operand_follows
def operand_follows(p: Parser, width: int): bool := operand_follows_at(p, p.at + width)
def operand_follows_at(p: Parser, at: int): bool := not "\n>)]},;=".contains(code_after(p, at))

// `word` at the parser's position as a whole word
def keyword_at(p: Parser, word: text): bool := keyword_at_position(p, word, p.at)
// what follows a % on its line leaves it no operand: the line's end, a separator, a closing bracket, a comparison, `of`,
// an operator standing apart (`10% + 1`; `7 % -3` takes the glued -3)
def percent_ends(p: Parser): bool := {
	if line_ends_after(p, p.at) { return true }
	next = code_after(p, p.at)
	",;)]}=<>!".contains(next) or keyword_at_position(p, "of", p.resumes[p.at]) or ("+-*/^".contains(next) and is_blank(peek(p.code, p.resumes[p.at] + 1, p.n)))
}

// `10 down to 1`: the length of the words `down to` (Kotlin's `downTo`), else 0
// Rust twin: ranges.rs down_to_length
def down_to_at(p: Parser): int {
	if not keyword_at(p, "down") { return 0 }
	at = blank_end(p, p.at + 4)
	if at > p.at + 4 and keyword_at_position(p, "to", at) then at + 2 - p.at else 0
}

// The operators only a declaration gives meaning (lib/prelude.warp `infix operator ↑`): `2↑3` calls operator_↑(2, 3);
// `loop··step` in a rule's template glues the hidden name loop·step (rewrites.warp), elsewhere the call of no operator
// Rust twin: Op::is_declared_only, word_operators.rs log_calls
DECLARED_ONLY_OPERATORS = ["↑", "↓", "··"]
// The name of the function an operator declaration defines: `infix operator ⊕` defines operator_⊕
// Rust twin: operators/mod.rs OPERATOR_FUNCTION_PREFIX
OPERATOR_FUNCTION_PREFIX = "operator_"
// Where a declared operator stands to its operands: `prefix operator ∆`, `suffix operator ³`, `infix operator ⊕`
enum Fixity { Prefix, Suffix, Infix }
// The words declaring an operator of a fixity; `operator ⊕` alone is infix
// Rust twin: declaration_scan.rs OPERATOR_KINDS, operators.rs declared_kind
FIXITY_WORDS = {"prefix": Fixity.Prefix, "suffix": Fixity.Suffix, "infix": Fixity.Infix, "operator": Fixity.Infix}
// An operator a program or module declares, `infix operator ⊕ := …`, binding as tight as its level
class DeclaredOperator { glyph: text; fixity: Fixity; level: int }

// How tight a declared operator binds unless a precedence declaration says otherwise, as the built-ins it resembles;
// an infix one's right power is one more than its level
// Rust twin: declaration_scan.rs USER_SUFFIX_BP, USER_PREFIX_RIGHT_BP, USER_INFIX_BP
def fixity_level(fixity: Fixity): int := match fixity {
	Fixity.Prefix: 155
	Fixity.Suffix: 165
	_: 140
}

// The call of a declared operator's function: `2 ⊕ 3` is operator_⊕(2, 3)
// Rust twin: operators.rs operator_call
def operator_call(glyph: text, arguments: list): Node := call_of([symbol(OPERATOR_FUNCTION_PREFIX + glyph)] + arguments)

// A declaration's first word declares an infix operator: `infix operator ⊕`, `operator ⊕`
def declares_infix(word: text): bool := word in FIXITY_WORDS and FIXITY_WORDS[word] == Fixity.Infix

// A glyph a program may declare as an operator: symbols with a non-ASCII character (`‼`, `⊕`), no letter or digit;
// raised digits too (`suffix operator ³`)
// Rust twin: operators.rs is_operator_glyph
def is_operator_glyph(glyph: text): bool {
	beyond_ascii = false
	for c in glyph {
		if not SUPERSCRIPT_DIGITS.contains(c) and (is_name_char(c) or is_digit(c) or is_blank(c)) { return false }
		if c > '~' { beyond_ascii = true }
	}
	beyond_ascii
}

// The operator the words after a declaration's first word declare, else "": a glyph (`operator ⊕ := …`), or for infix
// a word or glyph with its parameters, `infix operator divides(d, n) := …`, `infix operator ↑(x: number, n: number)`
// Rust twin: operators.rs declared_operator, declared_glyph
def declared_operator(infix: bool, words: list): text {
	glyph = if words.length > 2 and words#1 == "operator" and words#3 == ":=" then words#2 else if words.length > 1 and words#2 == ":=" then words#1 else ""
	if glyph != "" and is_operator_glyph(glyph) { return glyph }
	if not infix or not words.contains(":=") or words.length == 0 { return "" }
	head = if words#1 == "operator" and words.length > 1 then words#2 else words#1
	end = if is_name_start(head#1) then name_end(head, 0, head.length) else 0
	if not is_name_start(head#1) { while end < head.length and head[end] != '(' { end = end + 1 } }
	word = head[0 .. end]
	operator = (is_name_start(head#1) and word != "operator") or is_operator_glyph(word)
	if operator and (end == head.length or head[end] == '(') then word else ""
}

// `operator × := *`: another spelling of a built-in operator, no function
// Rust twin: aliases.rs alias_line

// The blank-separated words of a statement
def blank_words(statement: text): list := statement.replace("\t", " ").split(" ").filter(word => word)

// Each operator a source declares: `[prefix|suffix|infix]
// operator ⊕ := …` and the pattern `a ⊕ b := …` (infix), at the level a precedence declaration gives it
// Rust twin: operators.rs declared_operators
def declared_operators(source: text): list := if source.contains(":=") then operators_declared_in(code_statements(source)) else []
def operators_declared_in(statements: list): list {
	found = []
	for statement in statements {
		if not statement.contains(":=") { continue }
		found += operator_declared(blank_words(statement))
	}
	// `operator ⊕ has precedence above *`, wherever it stands, once every operator is known
	for statement in statements {
		if not statement.contains("precedence") { continue }
		ranked = precedence_declaration(blank_words(statement), found)
		if ranked is empty { continue }
		for operator in found { if operator.glyph == ranked#1 { operator.level = ranked#2 } }
	}
	found
}

// The operators a parse of a source knows: its own declared ones, those of the standard modules it uses (`use regex`
// makes `matches` infix), then the standard modules' glyph operators it writes
// Rust twin: operators.rs scan_user_operators
def scanned_operators(source: text): list {
	found = declared_operators(source)
	for module in used_module_sources(source) { found += declared_operators(module) }
	for library in library_glyph_operators() {
		if source.contains(library.glyph) and declared_level(found, library.glyph) < 0 { found += [library] }
	}
	found
}
// The glyph operators the standard modules declare, with their precedence: `[1] ∪ [2] ∩ [3]` reads ∩ first as
// lib/list.warp says, without `use list`; scanned the first time a parse needs them
// Rust twin: operators.rs library_glyph_operators (it scans every std module; these are the ones declaring operators)
global library_operators = ø
def library_glyph_operators(): list {
	if library_operators == ø {
		statements = ["math", "list", "regex"].flat_map(name => code_statements_of(name))
		library_operators = operators_declared_in(statements).filter(operator => not is_name_start(operator.glyph#1))
	}
	library_operators
}

// What the bundled modules at the top of lib/ declare for every program, read off their text once a run: "words",
// word → the module declaring it global, `global play(file: text) := …` (decision bizarre-global: a program naming it
// uses the module without its `use`); "classes", class → its module, `class Time` of units (decision
// expected-type-names: a parameter typed Time finds its values there)
global module_declarations = ø
def bundled_declarations(): map {
	if module_declarations == ø {
		module_declarations = declarations_scanned()
	}
	module_declarations
}
def global_words(): map := bundled_declarations()["words"]
def declared_classes_modules(): map := bundled_declarations()["classes"]
def declarations_scanned(): map {
	words = {}
	classes = {}
	for path in LIBRARY_FILES.keys {
		if not path.contains("/") and path.ends_with(module_extension) {
			module = path[0 ..< #path - #module_extension]
			for line in LIBRARY_FILES[path].split("\n") {
				if line.starts_with(GLOBAL_MARK) {
					word = name_starting(line[#GLOBAL_MARK ..])
					if word and line[#GLOBAL_MARK + #word ..].starts_with("(") { words[word] = module }
				}
				if line.starts_with(CLASS_MARK) { classes[name_starting(line[#CLASS_MARK ..])] = module }
			}
		}
	}
	{"words": words, "classes": classes}
}
GLOBAL_MARK = "global "
CLASS_MARK = "class "
// the name a text starts with, "" when none
def name_starting(line: text): text {
	stop = 0
	while stop < #line and is_name_char(line[stop]) { stop = stop + 1 }
	line[0 ..< stop]
}

// The words of a statement that uses a module: `use regex`, `require regex`, `import regex`
// Rust twin: use_statements.rs USE_KEYWORDS
USE_KEYWORDS = ["use", "require", "import"]
// The folder holding the file of a path: core of core/parsing/parser.warp
def folder_of(path: text): text {
	parts = path.split("/")
	parts[0 ..< #parts - 1].join("/")
}
// The sources of the standard modules a source uses by name, read from lib/ beside this compiler (module_source takes
// a name written out only), and of those whose global words it names (`play "mozart.mp3"`, words.warp global_words)
// Rust twin: declaration_scan.rs used_std_modules
def used_module_sources(source: text): list := module_sources(reached_modules(source))
// the standard modules a source uses by name or reaches by one of their global words
def reached_modules(source: text): list {
	modules = used_modules(source)
	code = code_only(source)
	words = global_words()
	for word in words.keys {
		if not modules.contains(words[word]) and mentions_word(code, word) { modules += [words[word]] }
	}
	modules
}
def module_sources(modules: list): list {
	sources = []
	for module in modules {
		module_source = file_source(run_library() + "/" + module + ".warp") ?? ""
		if module_source { sources += [module_source] }
	}
	sources
}
// the modules the source's use lines name, each once: `use regex`, `import sound`
def used_modules(source: text): list {
	modules = []
	for statement in code_statements(source) {
		words = blank_words(statement)
		if words.length == 2 and USE_KEYWORDS.contains(words#1) and not modules.contains(words#2) { modules += [words#2] }
	}
	modules
}
// the use lines of a source, as a slice of it reads them (written_tree's `uses`)
def use_lines(source: text): text := used_modules(source).map(module => "\nuse " + module).join("")
// whether the code names the word, not as a part of a longer name: `play` in `play(A4)`, not in `display`; glued to a
// number it is its own (`km` in `3km`, a number times km), as no name starts with a digit
def mentions_word(code: text, word: text): bool {
	parts = code.split(word)
	i = 1
	while i < #parts {
		before = parts#i
		after = parts#(i + 1)
		if not ends_in_name(before) and (#after == 0 or not is_name_char(after[0])) { return yes }
		i = i + 1
	}
	no
}
// whether the text ends in a name, its last run of name characters starting as a name does, not as a number (`3`)
def ends_in_name(t: text): bool {
	start = #t
	while start > 0 and is_name_char(t[start - 1]) { start = start - 1 }
	start < #t and is_name_start(t[start])
}

// The statements of a source's code, outside comments and texts, split at line ends and `;`
def code_statements(source: text): list {
	statements = []
	for line in code_only(source).split("\n") { statements += line.split(";") }
	statements
}

// `operator ⊕ has precedence above *`: ⊕ binds this much tighter than `*`; the built-in levels are at least 5 apart
// Rust twin: declaration_scan.rs PRECEDENCE_STEP
PRECEDENCE_STEP = 2
// What the words `operator ⊕ has precedence above|below [operator] Y` declare: [glyph, level]; [] for any other
// statement; one that cannot be followed (a built-in ⊕, an unknown Y) raises its error
// Rust twin: operators.rs precedence_declaration
def precedence_declaration(words: list, declared: list): list {
	if words.length < 6 or words#1 != "operator" or words#3 != "has" or words#4 != "precedence" { return [] }
	direction = words#5
	if direction != "above" and direction != "below" { return [] }
	other = if words.length == 7 and words#6 == "operator" then words#7 else if words.length == 6 then words#6 else ""
	if other is empty { return [] }
	glyph = words#2
	if declared_level(declared, glyph) < 0 { raise "operator $(glyph) is built in: only a declared operator gets a precedence (`infix operator $(glyph) := …` first)" }
	reference = declared_level(declared, other)
	if reference < 0 {
		canonical = canonical_operator(other)
		if canonical is empty { raise "unknown operator $(other) in `operator $(glyph) has precedence $(direction) $(other)`" }
		reference = binding_powers(canonical)#1
	}
	[glyph, if direction == "above" then reference + PRECEDENCE_STEP else reference - PRECEDENCE_STEP]
}
// The level of the declared operator spelled `glyph`, else -1
def declared_level(declared: list, glyph: text): int {
	operator = declared.find(operator => operator.glyph == glyph)
	if operator == ø then -1 else operator.level
}

// The operator a statement's words declare, as a list of it, else []
def operator_declared(words: list): list {
	if words.length == 0 { return [] }
	glyph = if words#1 in FIXITY_WORDS then declared_operator(declares_infix(words#1), words[1 .. words.length]) else ""
	if glyph != "" and operator_alias(words).length == 0 { return [declared_of(glyph, FIXITY_WORDS[words#1])] }
	if words.length > 3 and words#4 == ":=" and is_operator_glyph(words#2) and is_plain_name(words#1) and is_plain_name(words#3) { return [declared_of(words#2, Fixity.Infix)] }
	[]
}
def declared_of(glyph: text, fixity: Fixity): DeclaredOperator := DeclaredOperator{glyph: glyph, fixity: fixity, level: fixity_level(fixity)}
def is_plain_name(word: text): bool := word.length > 0 and name_end(word, 0, word.length) == word.length

// The declared operator written at the parser's position, the longest glyph, a word one as a whole word, else ø
// Rust twin: operators.rs user_operator_at
def user_operator_at(p: Parser): DeclaredOperator? := longest_spelled_at(p, p.operators, operator => operator.glyph)
def is_at_name_char(p: Parser, at: int): bool := at < p.n and is_name_char(p.code[at])

// `print matches("abd", "a.c$")`: a word operator glued to `(both, operands)` is its call, as `f(x, y)` is; a right
// operand never holds a comma, so `"abc" matches("a.c")` stays infix
// Rust twin: operators.rs parse_user_infix is_glued_call, holds_top_level_comma
def is_glued_call(p: Parser, glyph: text): bool := is_name_start(glyph#1) and holds_top_level_comma(p.code, p.at + glyph.length, p.n)
// whether the balanced `(…)` at `at` separates items by a comma of its own; brackets and commas inside a text or a
// nested group are none of its own
def holds_top_level_comma(code: text, at: int, n: int): bool {
	if not is_at(code, at, '(', n) { return false }
	depth = 0
	quote = ""
	escaped = false
	while at < n {
		c = code[at]
		if escaped {
			escaped = false
		} else if quote {
			if c == '\\' { escaped = true } else if "" + c == quote { quote = "" }
		} else if c == '"' or c == '\'' {
			quote = "" + c
		} else if c == '(' or c == '[' or c == '{' {
			depth = depth + 1
		} else if c == ')' or c == ']' or c == '}' {
			if depth == 1 { return false }
			depth = depth - 1
		} else if c == ',' and depth == 1 {
			return true
		}
		at = at + 1
	}
	false
}

// `infix operator ⊕(a: int, b: int) := a * 10 + b`, `prefix operator ∆ := …`: the definition of the function
// operator_⊕, whose parameters are the declared ones, else `it` (prefix, suffix) or `a b` (`left right` when the body
// names them); ø for any other statement starting with the word
// Rust twin: operators.rs try_parse_operator_declaration
def operator_declaration(p: Parser, word: text): Node := {
	words = blank_words(p.code[p.at + word.length .. statement_end(p)])
	infix = declares_infix(word)
	glyph = declared_operator(infix, words)
	if glyph == "" { return ø }
	p.at = p.at + word.length
	skip_spaces(p)
	if words#1 == "operator" {
		p.at += "operator".length
		skip_spaces(p)
	}
	p.at = p.at + glyph.length
	declared = if is_at(p.code, p.at, '(', p.n) then expression(p, binding_powers(":=")#1 + 1) else ø
	skip_spaces(p)
	p.at = p.at + 2
	skip_spaces(p)
	body = expression(p, 0)
	parameters = if not infix then [symbol("it")] else if declared == ø then ø else group_items(declared)
	if parameters == ø { parameters = if mentions(body, "left") or mentions(body, "right") then [symbol("left"), symbol("right")] else [symbol("a"), symbol("b")] }
	Key(operator_call(glyph, parameters), Op.Define, body)
}

// The items of a parenthesized group, the one item of any other node, none of ø: the parameters of `⊕(a, b)`
def group_items(declared: Node): list {
	if declared == ø { return [] }
	parts = group_parts(declared)
	if parts != ø and parts#1 == "(" then parts#3 else [declared]
}

// The operators a class defines as methods by their glyph: `+(o) := …` is its plus, `#(n) := …` its index
// Rust twin: spellings.rs OPERATOR_METHODS
METHOD_OPERATORS = ["+", "-", "*", "/", "%", "<", ">", "≈", "~", "#"]

// `+(o) := …` defines a class's method of an operator by its glyph (its plus): the head is the call `+(o)`, no unary
// plus, no count `#`; ø where no `:=` follows the parentheses
// Rust twin: operators.rs try_parse_operator_method_head
def operator_method_head(p: Parser): Node {
	op = operator_at(p)
	if op.length == 0 or not METHOD_OPERATORS.contains(op#2) { return ø }
	open = p.at + op#1.length
	if not is_at(p.code, open, '(', p.n) { return ø }
	if not starts_at(p.code, ":=", blank_end(p, hole_end(p.code, open + 1, '(', ')', p.n)), p.n) { return ø }
	p.at = open
	parameters = group_items(expression(p, binding_powers(":=")#1 + 1))
	call_of([symbol(op#2)] + parameters)
}

// `operator #(n) := …`, `infix operator +(a: V, b: V) := …`: the method of a built-in operator, its keywords
// superfluous; ø for any other statement starting with the word
// Rust twin: operators.rs operator_method_definition
def operator_method_definition(p: Parser, word: text): Node {
	start = p.at
	p.at = p.at + word.length
	skip_spaces(p)
	if word != "operator" and keyword_at(p, "operator") {
		p.at = p.at + 8
		skip_spaces(p)
	}
	head = operator_method_head(p)
	if head == ø {
		p.at = start
		return ø
	}
	skip_spaces(p)
	p.at = p.at + 2
	skip_spaces(p)
	Key(head, Op.Define, expression(p, 0))
}

// Left and right binding power of an operator
// Rust twin: operators.rs Op::binding_power
def binding_powers(op: text): list {
	// the effect constraint `f(x) := x*x ! Pure`: a free `!` takes the whole statement before it
	if op == "not" { return [0, 105] }
	if op == "." or op == "?." { return [180, 181] }
	if op == "::" { return [175, 176] }
	if op == "#" { return [170, 182] }
	if op == "^" or DECLARED_ONLY_OPERATORS.contains(op) { return [160, 159] }
	if op == "*" or op == "/" or op == "/!" or op == "%" or op == "rem" { return [150, 151] }
	if op == "+" or op == "-" or op == "±" { return [140, 141] }
	if op == "<<" or op == ">>" { return [135, 136] }
	if op == ".." or op == "to" { return [130, 131] }
	if op == "|>" { return [127, 128] }
	if op == "as" { return [125, 250] }
	if op == "<" or op == ">" or op == "<=" or op == ">=" { return [120, 121] }
	if op in ["==", "is", "!=", "===", "!==", "≈", "~"] { return [115, 116] }
	if op == "and" { return [100, 101] }
	if op == "xor" { return [95, 96] }
	if op == "or" { return [90, 91] }
	if op == "??" { return [93, 92] }
	if op == "?" { return [85, 79] }
	if op == "?:" { return [85, 86] }
	if op == "then" { return [77, 76] }
	if op == "else" { return [75, 74] }
	if op == "do" { return [77, 10] }
	if op == ":" { return [80, 81] }
	if op == "->" { return [70, 69] }
	if op == "=>" { return [70, 58] }
	[60, 59]
}

// The words that guard a statement and the marker call each becomes: `check C` is `assert C` (card check-assert)
// Rust twin: control/guards.rs GUARD_MARKERS, warp_parser TRY_MARKER, ASSERT_MARKER
GUARD_MARKERS = {"try": HiddenWord.TryElse as text, "assert": HiddenWord.AssertElse as text, "check": HiddenWord.AssertElse as text}
// The words that start the fallback of `try X else Y`: classical `catch`, Python's `except` (P60)
FALLBACK_WORDS = ["else", "catch", "except"]
// The hidden name `try X` binds X's Error to, to hand it on as the value
UNCAUGHT_ERROR = HiddenWord.UncaughtError as text
// The hidden name `except ParseError:` binds the Error to, to test its class
CAUGHT_ERROR = HiddenWord.CaughtError as text

// `try` or `assert` followed by an operand
// Rust twin: guards.rs guard_word_ahead
def guard_word_at(p: Parser, word: text): bool := word in GUARD_MARKERS and " \t{:".contains(peek(p.code, p.at + word.length, p.n))

// `try X else Y`, `assert C else X`: the marker call `marker(X, Y)`; `try X catch e {e}` adds the caught name the
// fallback reads, `r = try X` keeps X's Error as the value, `assert C` alone fails naming C as written
// Rust twin: guards.rs parse_guard
def guarded(p: Parser, word: text): Node := {
	marker = GUARD_MARKERS[word]
	p.at = p.at + word.length
	skip_spaces(p)
	skip_python_colon(p)
	start = p.at
	guarded_part = guarded_phrase(p)
	written_part = p.code[start .. p.at].trim()
	skip_spaces(p)
	if fallback_word_ahead(p) {
		// `except A: a except B: b`: an Error A does not catch passes on to the next one; an `else` after the
		// fallback is an enclosing `if`'s
		guard = guarded_part
		first = yes
		fallback_word = fallback_word_ahead(p)
		while fallback_word and (first or fallback_word != "else") {
			first = no
			p.at = p.resumes[p.at] + fallback_word.length
			skip_spaces(p)
			caught = if fallback_word == "else" then ["", ""] else caught_parts(p, fallback_word)
			skip_python_colon(p)
			guard = guarded_by(marker, guard, guarded_phrase(p), caught)
			skip_spaces(p)
			fallback_word = fallback_word_ahead(p)
		}
		return with_finally(p, guard)
	}
	caught = ["", ""]
	fallback = ø
	if word == "try" {
		caught = [UNCAUGHT_ERROR, ""]
		fallback = symbol(UNCAUGHT_ERROR)
	} else if marker == HiddenWord.AssertElse {
		fallback = "assertion failed: " + written_part
	}
	with_finally(p, guarded_by(marker, guarded_part, fallback, caught))
}

// The marker call `marker(X, Y)`, with the name Y reads the caught Error by as a fourth item (`catch e { … }`);
// `except ParseError as e` binds `e: ParseError`, which lowering tests before Y runs
// Rust twin: guards.rs guarded_by
def guarded_by(marker: text, guarded_part: Node, fallback: Node, caught: list): Node := {
	parts = [symbol(marker), guarded_part, fallback]
	name = caught#1
	caught_class = caught#2
	if caught_class {
		bound = if name is empty then CAUGHT_ERROR else name
		parts = parts + [keyed(":", symbol(bound), symbol(caught_class))]
	} else if name and reads_name(fallback, name) {
		parts = parts + [symbol(name)]
	}
	call_of(parts)
}

// whether n reads the name, in the holes of its texts too (`catch e { "caught: \(e)" }`): this parser keeps a text's
// holes as written, Rust's parses them
def reads_name(n: Node, name: text): bool := mentions(n, name) or has_hole(n, code => mentions(parsed(code), name))

// `try: x` as Python writes it; the block may start on the next line
// Rust twin: blocks.rs skip_python_colon
def skip_python_colon(p: Parser) {
	if is_at(p.code, p.at, ':', p.n) {
		p.at = p.at + 1
		skip_blanks(p)
	}
}

// The fallback word after the blanks and line breaks ahead, else ""
// Rust twin: guards.rs fallback_word_ahead
def fallback_word_ahead(p: Parser): text {
	at = p.resumes[p.at]
	for word in FALLBACK_WORDS { if keyword_at_position(p, word, at) { return word } }
	""
}

// `catch e`, `except ZeroDivisionError`, `except ValueError as e`: [the name the Error is bound to, the class it must
// be], "" for none
// Rust twin: guards.rs parse_caught
def caught_parts(p: Parser, fallback_word: text): list {
	if not is_name_start(peek(p.code, p.at, p.n)) { return ["", ""] }
	first = word_at(p)
	p.at = p.at + first.length
	skip_spaces(p)
	if keyword_at(p, "as") {
		p.at = p.at + 2
		skip_spaces(p)
		name = word_at(p)
		p.at = p.at + name.length
		skip_spaces(p)
		return [name, first]
	}
	if fallback_word == "catch" then [first, ""] else ["", first]
}

// Either part of `try X else Y`: one expression, or a braceless call of several (`try raise "boom" else print 3`)
// Rust twin: guards.rs parse_guarded_phrase
def guarded_phrase(p: Parser): Node := {
	outer = p.group.in_branch
	p.group.in_branch = true
	phrase_parts = [expression(p, 0)]
	while true {
		skip_spaces(p)
		if fallback_word_ahead(p) or keyword_at(p, "finally") or not starts_atom(p) { break }
		phrase_parts = phrase_parts + [expression(p, 0)]
	}
	p.group.in_branch = outer
	if phrase_parts.length == 1 then phrase_parts#1 else spaced(phrase_parts)
}

// `… finally {Z}` after a guard: `(finally·N = guard; Z; finally·N)`, Z runs and the guard's value stays
// Rust twin: guards.rs with_finally
def with_finally(p: Parser, guard: Node): Node := {
	if not keyword_at_position(p, "finally", p.resumes[p.at]) { return guard }
	p.at = p.resumes[p.at] + 7
	skip_spaces(p)
	cleanup = if is_at(p.code, p.at, ':', p.n) then colon_body(p, 1) else statement_words(p)
	p.finally_blocks = p.finally_blocks + 1
	value = symbol("finally·" + str(p.finally_blocks))
	listed(Bracket.Round, Separator.Semicolon, [Key(value, Op.Assign, guard), cleanup, value])
}

// An expression's start: a prefix operator and its operand, else an atom
// Rust twin: expressions.rs parse_expr (step 1), parse_prefix_operand, finish_prefix
def prefixed(p: Parser): Node := {
	c = peek(p.code, p.at, p.n)
	if starts_path(p) { return path_literal(p) }
	user_op = user_operator_at(p)
	if user_op != ø and user_op.fixity == Fixity.Prefix {
		p.at = p.at + user_op.glyph.length
		skip_spaces(p)
		return operator_call(user_op.glyph, [expression(p, user_op.level)])
	}
	if not is_name_start(c) { return prefixed_by_symbol(p, c) }
	word = word_at(p)
	// `try: x except: y` guards as `try x except y` does: Python's colon names no key (Rust: the guard comes first)
	if guard_word_at(p, word) and not after_member_dot(p) { return guarded(p, word) }
	// `op.if`, `math.sqrt`: a member's name is no keyword
	if word_names_key(p, word) or after_member_dot(p) { return atom(p) }
	if word == "circumfix" or word in FIXITY_WORDS {
		words = statement_words_at(p)
		// the pre-scans applied both: declared_operators, operator_aliases
		if precedence_declaration(words, p.operators) or operator_alias(words).length > 0 or circumfix_alias(words).length > 0 { return skip_statement(p) }
		declaration = operator_declaration(p, word)
		if declaration != ø { return declaration }
		method = operator_method_definition(p, word)
		if method != ø { return method }
	}
	// `To square a number: …` starts an English sentence with a capital
	if word.lower() == "to" and starts_statement(p) {
		definition = to_definition(p)
		if definition != ø { return definition }
	}
	form = keyword_form(word)
	if form == "return" { return returned(p) }
	if form == "condition" {
		p.at = p.at + word.length
		skip_spaces(p)
		return conditioned(CONTROL_WORDS[word], control_condition(word, condition_expression(p)), p)
	}
	if form == "loop" {
		loop = looped(p)
		return if loop == ø then atom(p) else loop
	}
	foreign = foreign_form(p, word)
	if foreign != ø { return foreign }
	event = if emit_words.contains(word) then emitted(p, word) else ø
	if event != ø { return event }
	declared = if form == "type" then type_declaration(p, word) else if form == "global" then global_declaration(p, word) else if form == "endless" then endless_loop(p) else ø
	if declared != ø { return declared }
	if word == DATA_WORD and peek(p.code, p.at + word.length, p.n) == ' ' {
		literal = data_literal(p)
		if literal != ø { return literal }
	}
	if form == "not" or no_asks_emptiness(p, word) {
		p.at = p.at + word.length
		skip_spaces(p)
		return Key(ø, Op.Not, expression(p, 105))
	}
	atom(p)
}

// `x = data a and b` is the data `a and b`, also as an operand (`string(data a and b)`); parentheses around all of it
// only group it (`data (a and b)`); ø for `data = …`, `data.x`, glued `data(x)` and `data class`, where data stays a word
// Rust twin: literals/data.rs try_parse_data
DATA_WORD = "data"
def data_literal(p: Parser): Node := {
	before = p.at
	p.at = p.at + DATA_WORD.length
	skip_spaces(p)
	if "}]);,\n\r".contains(peek(p.code, p.at, p.n)) or operator_at(p).length > 0 or word_at(p) == "class" {
		p.at = before
		return ø
	}
	read = expression(p, binding_powers("=")#2)
	written = match read {
		List(parts, Bracket.Round, separator): { if #parts == 1 then parts#1 else read }
		_: read
	}
	spaced([symbol(DATA_WORD), written])
}

// `if no xs`: in a condition `no` before an operand asks for emptiness as `not xs` does; elsewhere, or before an
// operator word or a block, `no` is false (decision empty-is-not-missing)
// Rust twin: lookahead.rs no_asks_emptiness
def no_asks_emptiness(p: Parser, word: text): bool {
	if word != "no" or not p.header or not operand_follows(p, 2) { return false }
	after = blank_end(p, p.at + 2)
	if "{:".contains(peek(p.code, after, p.n)) { return false }
	follower = p.code[after .. name_end(p.code, after, p.n)]
	not word_operators().any(pair => pair#1 == follower)
}

// `1 + emit ask`, `emit stop the machine{reason: "x"}`: the emit word and the words of its event are one phrase, each
// binding like the operand of a unary minus (`emit missing` raises missing, no test word); ø where an operator
// follows, the word is then a name (`send alarm{} to "x"`)
// Rust twin: jumps.rs try_parse_emit
def emitted(p: Parser, word: text): Node := {
	before = p.at
	p.at = p.at + word.length
	skip_spaces(p)
	phrase = [symbol(word)]
	while is_name_start(peek(p.code, p.at, p.n)) or (phrase.length > 1 and "0123456789\"'".contains(peek(p.code, p.at, p.n))) {
		if operator_at(p).length > 0 {
			p.at = before
			return ø
		}
		phrase = phrase + [expression(p, PREFIX_POWER)]
		skip_spaces(p)
	}
	if phrase.length == 1 {
		p.at = before
		return ø
	}
	spaced(phrase)
}

// Whether the word at the parser's position follows a member's dot: `op.if` names the member if, no keyword (a
// range's `..if` keeps it)
def after_member_dot(p: Parser): bool := p.at > 0 and p.code[p.at - 1] == '.' and not (p.at > 1 and p.code[p.at - 2] == '.')

PREFIX_POWER = 162

// The dashes 0x2010..0x2015 and the minus sign: each means `-` (infix ones: lib/aliases.warp, the minus sign
// lib/math.warp's alias line)
// Rust twin: operators/spellings.rs OPERATOR_SPELLINGS
DASH_GLYPHS = "‐‑‒–—―−"

// The circumfix operator opening at the parser's position as [opening, closing, function], else []
// Rust twin: math_notation.rs circumfix_here
def circumfix_at(p: Parser): list {
	for pair in p.circumfixes { if starts_at(p.code, pair#1, p.at, p.n) { return pair } }
	[]
}
// The glyph opens or closes a circumfix operator: `⌋` is no free symbol
// Rust twin: math_notation.rs is_circumfix_glyph
def is_circumfix_glyph(p: Parser, glyph: text): bool {
	for pair in p.circumfixes { if pair#1 == glyph or pair#2 == glyph { return true } }
	false
}
// Where the circumfix pair opened before `from` closes, past the pairs nested in it, else n
def circumfix_closing(p: Parser, pair: list, from: int): int {
	depth = 0
	for at in from ..< p.n {
		if starts_at(p.code, pair#2, at, p.n) {
			if depth == 0 { return at }
			depth = depth - 1
		} else if starts_at(p.code, pair#1, at, p.n) { depth = depth + 1 }
	}
	p.n
}
// `‖x‖`, `⌊x⌋` bracket a whole expression like parentheses and call their function with it: `‖3-5‖*2` is 4
// Rust twin: math_notation.rs try_parse_circumfix
def circumfixed(p: Parser, pair: list): Node := {
	opened = p.at + pair#1.length
	closing = circumfix_closing(p, pair, opened)
	if closing >= p.n { raise "Missing closing " + pair#2 }
	whole = p.n
	p.at = opened
	p.n = closing
	inner = expression(p, 0)
	p.n = whole
	p.at = closing + pair#2.length
	call_of([symbol(pair#3), inner])
}

def prefixed_by_symbol(p: Parser, c: text): Node := {
	head = operator_method_head(p)
	if head != ø { return head }
	alone = operator_value(p)
	if alone != ø { return alone }
	next = peek(p.code, p.at + 1, p.n)
	reference = reference_prefix_length(p, c, next)
	if reference > 0 {
		p.at = p.at + reference
		return prefixed(p)
	}
	if (c == '-' or DASH_GLYPHS.contains(c)) and next != '>' and next != '-' {
		sign = p.at
		p.at = p.at + 1
		skip_spaces(p)
		operand = expression(p, 155)
		// `-7` is the number, written where its sign is
		// 9223372036854775808 reads as the int -2^63 where ints are 64 bits: `-9223372036854775808` is that int itself
		if operand is number { return placed_at(p, if operand is int and operand == -9223372036854775807 - 1 then operand else 0 - operand, sign) }
		return keyed("-", ø, operand)
	}
	// `+5` is 5, `+x` x: a glued plus is the sign of its operand (it was the symbol '+' beside it)
	if c == '+' and next != '+' and next != '=' and not is_blank(next) and operand_follows(p, 1) {
		p.at = p.at + 1
		return expression(p, 155)
	}
	if c == '!' or c == '¬' {
		p.at = p.at + 1
		return Key(ø, Op.Not, expression(p, 105))
	}
	if c == '#' and not is_blank(next) {
		p.at = p.at + 1
		return Key(ø, Op.Hash, expression(p, INDEX_POWER - 1))
	}
	circumfix = circumfix_at(p)
	if circumfix.length > 0 { return circumfixed(p, circumfix) }
	// `√x`, `∛x`: a glyph spelling a function calls it (lib/math.warp `prefix operator √ := sqrt`)
	spelled = alias_at(p)
	if spelled.length > 0 and spells_function(spelled) {
		p.at = p.at + spelled#1.length
		skip_spaces(p)
		return call_of([symbol(spelled#2), expression(p, PREFIX_POWER)])
	}
	// `> 100 => "big"` (C#'s relational pattern): a comparison without its left side, a match arm compares the
	// subject; a glued `<tag` stays a bracket
	// Rust twin: lookahead.rs peek_prefix_operator ('>' | '<')
	if c == '<' or c == '>' {
		relation = if next == '=' then "" + c + "=" else "" + c
		spacing = peek(p.code, p.at + relation.length, p.n)
		if spacing == ' ' or spacing == '\t' {
			p.at = p.at + relation.length
			skip_spaces(p)
			return keyed(relation, ø, expression(p, binding_powers(relation)#2))
		}
	}
	if c == '|' {
		parameters = pipe_parameters(p)
		// the body binds as after `=>`: it takes an assignment, `|x| total += x`
		// `do |item|⏎  print item⏎end`: the rest of the block is the body
		body_below = parameters != ø and is_at(p.code, p.at, '\n', p.n)
		if body_below { return keyed("->", parameters, single_statement_or_block(items_until(p, Bracket.Curly, ItemsEnd.Rest))) }
		if parameters != ø { return keyed("->", parameters, expression(p, binding_powers("=>")#2)) }
	}
	// `&lerp`: a reference to the function, an `&` glued to the word after it and not to one before it (`a &b`)
	// Rust twin: functions.rs starts_function_reference, closures.rs function_reference
	if c == '&' and is_alpha(next) and not (p.at > 0 and is_name_char(p.code[p.at - 1])) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return attributed(FUNCTION_REFERENCE_MARK, true, symbol(name))
	}
	if c == ':' and explicit_symbol_at(p) {
		end = name_end(p.code, p.at + 1, p.n)
		name = p.code[p.at + 1 .. end]
		p.at = end
		return call_of([symbol("symbol"), name])
	}
	atom(p)
}

// Rust's reference `&x`, `&mut x`, `&&x`, `&5`, `&(a + b)` and dereference `*r`, `**r`, `*(&x)`: a value needs no
// reference, so the prefix's length goes and the value is read itself; 0 for a function reference `&name` or a star of
// a rest or spread
// Rust twin: functions.rs starts_rust_reference, skip_reference_prefix
def reference_prefix_length(p: Parser, c: text, next: text): int {
	if c == '&' {
		if mutable_reference_at(p) { return 1 + MUT_WORD.length + 1 }
		if next == '&' or next == '(' or next == '[' or next == '"' or is_digit(next) { return 1 }
		return 0
	}
	operand = is_name_start(next) or next == '(' or next == '*' or next == '&'
	if c == '*' and operand and not star_is_rest_or_spread(p) then 1 else 0
}
MUT_WORD = "mut"
def mutable_reference_at(p: Parser): bool {
	end = name_end(p.code, p.at + 1, p.n)
	p.code[p.at + 1 .. end] == MUT_WORD and is_spacing(peek(p.code, end, p.n))
}
def is_spacing(c: text): bool := c == ' ' or c == '\t'

// `a, *rest = xs`, `f(*xs)`, `*init, last = xs`, Python's `**kw`: a star after a comma or an opening bracket, or at a
// statement's start before a comma or `=`, gathers or spreads items
// Rust twin: functions.rs star_is_rest_or_spread
def star_is_rest_or_spread(p: Parser): bool {
	back = p.at - 1
	while back >= 0 and is_spacing(p.code[back]) { back = back - 1 }
	before = if back < 0 then '\n' else p.code[back]
	if before == ',' or before == '(' or before == '[' { return true }
	if not (before == '\n' or before == ';' or before == '{') { return false }
	end = name_end(p.code, p.at + 1, p.n)
	after = end
	while is_spacing(peek(p.code, after, p.n)) { after = after + 1 }
	peek(p.code, after, p.n) == ',' or (peek(p.code, after, p.n) == '=' and peek(p.code, end + 1, p.n) != '=')
}

// `sorted(xs, >)`, `fold(xs, +)`, `[<, >=]`: an operator standing alone before a closing parenthesis or bracket or a
// comma is the operator itself, both sides ø; `..` also at the end of a pattern's rest (Point with x and the rest)
// Rust twin: definitions/operators.rs try_parse_operator_value
def operator_value(p: Parser): Node := {
	found = operator_at(p)
	if found.length == 0 { return ø }
	next_char = peek(p.code, blank_end(p, p.at + found#1.length), p.n)
	ends_rest = next_char == '}' and (found#2 == ".." or found#2 == "to")
	if not (next_char == ')' or next_char == ',' or next_char == ']' or ends_rest) { return ø }
	p.at = p.at + found#1.length
	keyed(found#2, ø, ø)
}

// `a, *rest = xs`: the starred name takes the items the other names leave; JS's `...rest` is the starred `*rest` too,
// Python's `**kw` the starred `**kw`; ø unless a name follows the prefix
// Rust twin: atoms.rs parse_starred
STAR_PREFIXES = [["...", "*"], ["**", "**"], ["*", "*"]]
def starred_name(p: Parser): Node := {
	for prefix in STAR_PREFIXES {
		start = p.at + prefix#1.length
		if starts_at(p.code, prefix#1, p.at, p.n) and is_name_start(peek(p.code, start, p.n)) {
			end = name_end(p.code, start, p.n)
			p.at = end
			return symbol(prefix#2 + p.code[start .. end])
		}
	}
	ø
}

// `|x| x*x`, `|a, b| a+b` (Rust, and Ruby's `{ |x| x*x }`): the parameters of a lambda between bars, the parser
// placed on the body after them (in a block also on the lines below); ø (nothing consumed) when no names between bars and a body follow
// Rust twin: pipes.rs pipe_parameters
def pipe_parameters(p: Parser): Node := {
	close = p.at + 1
	while close < p.n and (" ,".contains(p.code[close]) or is_name_char(p.code[close])) { close = close + 1 }
	names = p.code[p.at + 1 .. close].split(' ').join(",").split(',').filter(name => name)
	body = spaces_end(p, close + 1)
	// Ruby's `do |item|⏎ … end`, `{ |x|⏎ … }`: inside a block the body may start on the next line
	body_below = is_at(p.code, body, '\n', p.n) and (p.group.grouped or p.group.stops_at_end)
	if peek(p.code, close, p.n) != '|' or names is empty or not is_name_start(names#1#1) or body >= p.n or ("\n;,)]}".contains(p.code[body]) and not body_below) { return ø }
	p.at = body
	if names.length == 1 then symbol(names#1) else listed(Bracket.Round, Separator.Comma, names.map(name => symbol(name)))
}

// A block of one statement as that statement
def single_statement_or_block(block: Node): Node := {
	parts = group_parts(block)
	if parts != ø and parts#3.length == 1 then parts#3#1 else block
}

// `:post` (wiki/symbol.md): the symbol itself, written as the call symbol("post"), never evaluated
// Rust twin: atoms.rs parse_atom (':' at_explicit_symbol), lookahead.rs at_explicit_symbol
def explicit_symbol_at(p: Parser): bool {
	before = if p.at == 0 then ' ' else p.code[p.at - 1]
	is_name_start(peek(p.code, p.at + 1, p.n)) and (is_blank(before) or "([{,=".contains(before))
}

// `return x`, `return` alone: ø; `return = 1` assigns a name
// Rust twin: expressions.rs try_parse_return
def returned(p: Parser): Node := {
	before = p.at
	p.at = p.at + 6
	skip_spaces(p)
	op = operator_at(p)
	if op.length > 0 and binding_operators.contains(op#2) {
		p.at = before
		return atom(p)
	}
	c = peek(p.code, p.at, p.n)
	value = ø
	if not (c == '}' or c == ';' or c == '\n' or c == '\r') { value = continued(p, expression(p, 59), 0) }
	// `return` alone is the word
	if value === ø then symbol("return") else spaced([symbol("return"), value])
}

// Binds a condition until `then`, `do` or the colon of `if c: x`
CONDITION_POWER = 81
// The condition of `if` and `while`: a braceless call takes a variable argument as in a branch (`if area certainly > 10
// then`, `while square i < 10`)
// Rust twin: conditions.rs parse_condition
def condition_expression(p: Parser): Node := {
	outer = p.branch_power
	p.branch_power = CONDITION_POWER
	value = header_expression(p, CONDITION_POWER)
	p.branch_power = outer
	value
}

// Rust's `loop { … }` as `while true { … }`, ø when no block follows the word
// Rust twin: atoms.rs keyword_form (LOOP_WORD)
def endless_loop(p: Parser): Node := {
	at = blank_end(p, p.at + 4)
	if not is_at(p.code, at, '{', p.n) { return ø }
	p.at = at + 1
	Key(Key(ø, Op.While, true), Op.Do, items_until(p, Bracket.Curly, ItemsEnd.Closer))
}

// `if c {…} else {…}`, `while c {…}`, `if c` and the lines indented below: the block after the condition is its
// branch or body
// Rust twin: expressions.rs finish_if_prefix, finish_while_prefix
def conditioned(word: text, condition: Node, p: Parser): Node := {
	skip_spaces(p)
	body = ø
	if is_at(p.code, p.at, ':', p.n) {
		// `if c: x = 1 else: x = 2`: the body ends before the else
		outer = p.group.in_branch
		p.group.in_branch = word == "if"
		body = colon_body(p, 1)
		p.group.in_branch = outer
	} else if is_at(p.code, p.at, '{', p.n) {
		p.at = p.at + 1
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
	} else if at_body_start(p) {
		// `if a == 1 print "ok"`, `if (x < 0) return -1`, `while (i < 9) i++`: the statement on the condition's line
		outer = p.group.in_branch
		p.group.in_branch = word == "if"
		body = statement_words(p)
		p.group.in_branch = outer
	} else {
		// `while m > 1` ending its line: the lines indented below (Rust twin: blocks.rs indented_lines_below); without
		// them `while x-- > 0` is a loop without a body, its condition does the work; `while c do …` takes its body
		// from the `do` that follows, as `if c then …` from its `then`
		body = if only_blanks_before_newline(p) then indented_block(p) else ø
		if body == ø { return if word == "while" and not keyword_at(p, "do") then Key(keyed(word, ø, condition), Op.Do, ø) else keyed(word, ø, condition) }
	}
	head = keyed(word, ø, condition)
	if word == "while" { return Key(head, Op.Do, body) }
	branches = Key(head, Op.Then, body)
	otherwise = else_branch(p)
	if otherwise.length == 0 { return branches }
	Key(branches, Op.Else, otherwise#1)
}

// The control words and the condition word each reads as: `unless c` is `if not c`, `until c` is `while not c`
// Rust twin: conditions.rs NEGATED_CONTROL_WORDS, spellings.rs
CONTROL_WORDS = {"if": "if", "unless": "if", "while": "while", "until": "while"}
NEGATED_CONTROL_WORDS = ["unless", "until"]
def control_condition(word: text, condition: Node): Node := if NEGATED_CONTROL_WORDS contains word then Key(ø, Op.Not, condition) else condition

// `print it if it%2`, `do {i++} while c`: a trailing `if` guards and a trailing `while` loops the whole command, not its
// last word; else ø
// Rust twin: conditions.rs guarded_command
def guarded_command(nodes: list): Node := {
	if nodes.length < 2 or nodes#1 is not symbol { return ø }
	match nodes#(nodes.length) {
		Key(head, Op.Do, body): { if bare_control(head, "while") then Key(head, Op.Do, command_with(nodes, body)) else ø }
		Key(head, Op.Then, body): { if bare_control(head, "if") then Key(head, Op.Then, command_with(nodes, body)) else ø }
		_: ø
	}
}
// `if c`, `while c` with nothing before the word
def bare_control(n: Node, control: text): bool := match n {
	Key(before, Op.If, test): control == "if" and before == ø
	Key(before, Op.While, test): control == "while" and before == ø
	_: no
}
// the command's words with its last one replaced by `tail`
def command_with(nodes: list, tail: Node): Node := spaced(nodes[0 .. nodes.length - 1] + [tail])

// `to name params: body` (also `{ body }`, `do body`, the lines indented below), after `to` opening a statement: the
// function `name(params) := body`, its parameters the head's slots (phrase_slots); ø, nothing read, before anything
// else
// Rust twin: functions.rs try_parse_to_definition, phrase_result_type, phrase_redefinition
def to_definition(p: Parser): Node := {
	before = p.at
	p.at = p.at + 2
	skip_spaces(p)
	if not is_name_start(peek(p.code, p.at, p.n)) {
		p.at = before
		return ø
	}
	name = header_word(p)
	words = []
	// `to call person{name?, phone number} do …` (wiki/argument.md): the parameter's fields, glued to it
	shapes = []
	result_type = ""
	while true {
		skip_spaces(p)
		if at_to_header_end(p) { break }
		if not is_name_start(peek(p.code, p.at, p.n)) {
			p.at = before
			return ø
		}
		word = header_word(p)
		if word == "do" and #words > 0 { break }
		if word == "as" and #words > 0 {
			result_type = phrase_result_type(p)
			if result_type != "" { break }
		}
		if is_at(p.code, p.at, '{', p.n) { shapes += [[word, atom(p)]] }
		words += [word]
	}
	if is_at(p.code, p.at, ':', p.n) { p.at = p.at + 1 }
	skip_spaces(p)
	body = definition_body(p)
	parameters = phrase_slots(words, body, p.types).map(parameter => shaped(parameter, shapes))
	clash = phrase_redefinition(p, name, parameters)
	if clash != "" { raise clash }
	head = symbol(name)
	if #parameters > 0 {
		p.phrases += [[name, parameters]]
		head = call_of([head] + parameters)
	}
	if result_type != "" { head = Key(head, Op.As, symbol(result_type)) }
	Key(head, Op.Define, body)
}

// The word at the parser's position, read
def header_word(p: Parser): text {
	start = p.at
	p.at = symbol_end(p.code, p.at, p.n)
	p.code[start .. p.at]
}

// `:` (no `:=`) or `{`: where a `to` header ends and its body starts
def at_to_header_end(p: Parser): bool := (is_at(p.code, p.at, ':', p.n) and peek(p.code, p.at + 1, p.n) != '=') or is_at(p.code, p.at, '{', p.n)

// The type after `as` when it ends the header, read: `to render text as pdf: …`; else "", nothing read
def phrase_result_type(p: Parser): text {
	after_as = p.at
	skip_spaces(p)
	if is_name_start(peek(p.code, p.at, p.n)) {
		result_type = header_word(p)
		skip_spaces(p)
		if at_to_header_end(p) or keyword_at(p, "do") { return result_type }
	}
	p.at = after_as
	""
}

// A definition's body: a `{…}` block, the rest of the statement, or the lines indented below
// Rust twin: blocks.rs parse_definition_body
def definition_body(p: Parser): Node := {
	if is_at(p.code, p.at, '{', p.n) { return atom(p) }
	if not only_blanks_before_newline(p) { return statement_words(p) }
	block = indented_block(p)
	if block == ø { raise "a definition needs a body: `to name params: body`" }
	block
}

// The parameter with the fields its head glued to it: `person{name?}` is `person: {name?}`
def shaped(parameter: Node, shapes: list): Node := {
	for shape in shapes {
		if shape#1 == slot_name(parameter) { return Key(parameter, Op.Colon, shape#2) }
	}
	parameter
}

// The parameters of a phrase head's words after its name (notes/matching.md):
// - a preposition (`to of from …`) separates the slots and labels the one after it: `to add a to b` → `a`, `to b`
// - an article starts a noun slot when a known type follows it or the body never names the article: `a number` →
//   `number: number`, `a photo` → `photo` (typed once `class photo` is declared); `to add a b: a+b` keeps `a`
// - several nouns after an article are one name, typed and named by the last: `a phone number` → `number: number`;
//   when together they name a declared type, by all of them: `a full name` → `full-name: full-name`
// - a lone typed slot the body reads as `it` alone is `it`: `to square a number: it*it`
// Rust twin: type_name_matching.rs parameter_slots (labelled)
def phrase_slots(words: list, body: Node, types: list): list {
	parameters = []
	preposition = ""
	at = 1
	while at <= #words {
		word = words#at
		if phrase_prepositions.contains(word) {
			preposition = word
			at = at + 1
			continue
		}
		noun = [word]
		if phrase_articles.contains(word) and in_slot(words, at + 1) and (known_type(words#(at + 1), types) or not mentions(body, word)) {
			noun = []
			while in_slot(words, at + 1) and not phrase_articles.contains(words#(at + 1)) {
				at = at + 1
				noun += [words#at]
			}
		}
		at = at + 1
		// `a full name` of `class full name`: the nouns together are the type, and the slot's name
		head = if #noun > 1 and known_type(noun.join("-"), types) then noun.join("-") else noun#(#noun)
		slot = if known_type(head, types) then Key(symbol(head), Op.Colon, symbol(head)) else symbol(head)
		parameters += [if preposition == "" then slot else spaced([symbol(preposition), slot])]
		preposition = ""
	}
	names = []
	for parameter in parameters {
		name = slot_name(parameter)
		if names.contains(name) { raise "two parameters are named " + name + ": use one-word parameter names here (`first name`, `last name` need multi-word identifiers)" }
		names += [name]
	}
	if #parameters == 1 and is_key(parameters#1, Op.Colon) {
		typed = parameters#1
		type_name = name_of(value_of(typed))
		if slot_name(typed) == type_name and mentions(body, implicit_parameter) and not mentions(body, type_name) {
			return [Key(symbol(implicit_parameter), Op.Colon, value_of(typed))]
		}
	}
	parameters
}

// Whether the head word at `at` belongs to the slot before it: no preposition, not past the end
def in_slot(words: list, at: int): bool := at <= #words and not phrase_prepositions.contains(words#at)

// A type word, its plural (`numbers`) or a type the source declares
// Rust twin: analyzer type_word_kind, plural_element_type
def known_type(word: text, types: list): bool := is_type_word(word) or plural_type_word(word) or types.contains(word)

// The name a slot gives its parameter: `a`, `number` of `number: number`, `b` of `to b`
def slot_name(parameter: Node): text := match parameter {
	Symbol(name): name
	Key(name, _, _): slot_name(name)
	List(parts, _, _): slot_name(parts#(parts.length))
	_: ""
}

// `to kill a person: …` after `to kill a dog: …`: the same phrase with other untyped nouns, which only types tell apart;
// else ""
def phrase_redefinition(p: Parser, name: text, parameters: list): text {
	earlier = []
	for phrase in p.phrases {
		if phrase#1 == name { earlier = phrase#2 }
	}
	if #earlier == 0 or #earlier != #parameters { return "" }
	classes = []
	at = 1
	while at <= #parameters {
		before = earlier#at
		current = parameters#at
		if before != current {
			if not (before is symbol and current is symbol) { return "" }
			classes += ["class " + name_of(before), "class " + name_of(current)]
		}
		at = at + 1
	}
	if #classes == 0 { return "" }
	name + " is defined twice; declare " + classes.join(" and ") + " to dispatch on them"
}
// Whether a statement starts at the parser's position, no end of one, `then`, `else` or `do`
// Rust twin: blocks.rs at_body_start
def at_body_start(p: Parser): bool {
	c = peek(p.code, p.at, p.n)
	not (p.at >= p.n or "\n;,})]".contains(c)) and not keyword_at(p, "do") and not keyword_at(p, "then") and not keyword_at(p, "else")
}

// `else body`, also on the line after the branch, `else: body`, and `elif`/`elsif`/`elseif` chaining a new if; [] if
// no else follows
// Rust twin: if_else.rs parse_optional_else, else_on_a_later_line, at_else_if_word
def else_branch(p: Parser): list {
	skip_spaces(p)
	at = p.at
	while at < p.n and is_blank(p.code[at]) { at = at + 1 }
	if at > p.at and p.code[p.at .. at].contains("\n") and keyword_at_position(p, "else", at) { p.at = at }
	if else_if_at(p) {
		p.at = p.at + word_at(p).length
		skip_spaces(p)
		return [conditioned("if", condition_expression(p), p)]
	}
	if not keyword_at(p, "else") { return [] }
	p.at = p.at + 4
	skip_spaces(p)
	if not is_at(p.code, p.at, ':', p.n) { return [branch(p, 74)] }
	p.at = p.at + 1
	skip_spaces(p)
	[branch(p, 0)]
}

// A branch of an if; `then print x, y` and `else print ord x` are the call print(…) of the expressions after it
// Rust twin: if_else.rs parse_branch, commands.rs take_braceless_print, print_call_from
// A `then` or `else` branch is a statement: a braceless call there takes a variable, `then count xs`
// Rust twin: expressions.rs parse_right_operand (branch_bp)
def branch(p: Parser, min_power: int): Node := {
	outer = p.branch_power
	p.branch_power = min_power
	value = branch_assignment(p, branch_value(p, min_power), min_power)
	p.branch_power = outer
	value
}

// `if c then s += 5 else s = 0` assigns in the branch, the value stopping at `else`
// Rust twin: if_else.rs branch_assignment
def branch_assignment(p: Parser, target: Node, min_power: int): Node := {
	skip_spaces(p)
	op = operator_at(p)
	if op.length == 0 or not assigning_operators.contains(op#2) { return target }
	p.at = p.at + op#1.length
	skip_spaces(p)
	keyed(op#2, target, expression(p, min_power))
}

def branch_value(p: Parser, min_power: int): Node := {
	at = blank_end(p, p.at + 5)
	if not (keyword_at(p, "print") and at > p.at + 5 and starts_atom_at(p, at)) { return expression(p, min_power) }
	p.at = at
	print_call_from(p, one_expression(words_binding(p, min_power)), min_power)
}

def keyword_at_position(p: Parser, word: text, at: int): bool := starts_at(p.code, word, at, p.n) and not (at + word.length < p.n and is_name_char(p.code[at + word.length]))

// `for x in xs {…}` or `for each x in xs {…}`: the loop variable, the iterable and the body, else ø, nothing read
// Rust twin: loops.rs try_parse_for_in, for_iterable_and_body_word
def looped(p: Parser): Node := {
	before = p.at
	p.at = p.at + 3
	skip_spaces(p)
	if keyword_at(p, "each") and not keyword_at_position(p, "in", spaces_end(p, p.at + 4)) {
		p.at = p.at + 4
	}
	named = named_loop(p)
	if named != ø { return named }
	p.at = before + 3
	skip_spaces(p)
	// `for(i=0;i<n;i++)`
	if at_c_style_for_head(p) { return c_style_for(p) }
	ranged = ranged_loop(p)
	if ranged == ø { p.at = before }
	ranged
}

// `(i=0;i<n;i++)`: a group here whose top level holds a `;`
// Rust twin: loops.rs at_c_style_for_head
def at_c_style_for_head(p: Parser): bool {
	if not is_at(p.code, p.at, '(', p.n) { return false }
	at = p.at
	depth = 0
	while at < p.n {
		c = p.code[at]
		skipped = if opens_text(c) then text_end(p.code, at + 1, closing_of(c), p.n) else comment_end(p.code, at, p.n)
		if skipped > at {
			at = skipped
		} else if "([{".contains(c) {
			depth = depth + 1
		} else if ")]}".contains(c) {
			if depth == 1 { return false }
			depth = depth - 1
		} else if c == ';' and depth == 1 {
			return true
		}
		at = at + 1
	}
	false
}

// `for (i=0;i<3;i++) {…}`, `… : body`, `… do body`, the lines indented below or the rest of the statement: the call
// for(head) glued to the body as a block
// Rust twin: loops.rs c_style_for
def c_style_for(p: Parser): Node := {
	head = atom(p)
	skip_spaces(p)
	width = body_word_width(p)
	body = ø
	if width > 0 {
		body = colon_body(p, width)
	} else if is_at(p.code, p.at, '{', p.n) {
		body = atom(p)
	} else {
		body = indented_block(p)
		if body == ø { body = statement_words(p) }
	}
	listed(Bracket.None, Separator.None, [call_of([symbol("for"), head]), if is_block(body) then body else listed(Bracket.Curly, Separator.Semicolon, [body])])
}

// `each x in xs {…}` is `for each x in xs {…}`, else ø, nothing read
// Rust twin: atoms.rs keyword_form, loop_variable_in_follows
def each_loop(p: Parser): Node := {
	before = p.at
	p.at = p.at + 4
	skip_spaces(p)
	named = named_loop(p)
	if named == ø { p.at = before }
	named
}

// `x in xs {…}` after `for`: the loop over the named variable, else ø
def named_loop(p: Parser): Node := {
	variable = loop_variable(p)
	if variable == ø { return ø }
	skip_spaces(p)
	if not keyword_at(p, "in") { return ø }
	p.at = p.at + 2
	skip_spaces(p)
	iterable = iterable_words(p)
	skip_spaces(p)
	spaced([symbol("for"), variable, symbol("in"), iterable, loop_body(p)])
}

// A loop's iterable: one expression, or the words up to the body as a space list, `reverse xs` of
// `for x in reverse xs {…}`; in a comprehension, whose loop has no body, the words up to the closer or its
// `if`: `[c * 2 for c in reverse xs]`, `[c for c in cases of Coin]`
// Rust twin: loops.rs parse_iterable
def iterable_words(p: Parser): Node := {
	p.iterable = true
	first = header_expression(p, 81)
	after_first = p.at
	words = [first]
	while true {
		skip_spaces(p)
		start = p.at
		if p.at >= p.n or at_loop_body(p) or ITERABLE_ENDS.contains(peek(p.code, p.at, p.n)) or keyword_at(p, "if") or comprehension_clause_at(p) or comprehension_filter_at(p) { break }
		// a rule's hole after the iterable is the loop's body, `for $i in 1 to $n $body` (card sugar-comprehensions)
		if words.length == 1 and is_at(p.code, p.at, '$', p.n) and is_name_start(peek(p.code, p.at + 1, p.n)) {
			p.iterable = false
			return first
		}
		words += [header_expression(p, 81)]
		if p.at == start { break }
	}
	p.iterable = false
	ends_clause = in_comprehension(p) and (p.at >= p.n or ITERABLE_ENDS.contains(peek(p.code, p.at, p.n)) or keyword_at(p, "if") or keyword_at(p, "for") or keyword_at(p, "where"))
	if words.length == 1 or not (at_loop_body(p) or ends_clause) {
		p.at = after_first
		return first
	}
	spaced(words)
}

// Rust twin: loops.rs ITERABLE_ENDS
ITERABLE_ENDS = ";}]),"

// A loop's body starts here: `{…}`, `: …`, `do …`, or the next line
// Rust twin: loops.rs at_loop_body
def at_loop_body(p: Parser): bool {
	c = peek(p.code, p.at, p.n)
	c == '{' or c == ':' or c == '\n' or starts_at(p.code, "//", p.at, p.n) or keyword_at(p, "do") or body_hole_at(p)
}

// In a list or braces, where a loop is a comprehension's clause: `[x * 2 for x in reverse xs]`
def in_comprehension(p: Parser): bool := p.group.bracket == Bracket.Square or p.group.bracket == Bracket.Curly

// A comprehension's next clause, which ends the iterable before it: `for b` of `[a + b for a in xs for b in ys]`
def comprehension_clause_at(p: Parser): bool := in_comprehension(p) and keyword_at(p, "for")
// A comprehension's filter, which ends the iterable before it as `if` does: `where x > 2` of `[x for x in xs where x > 2]`
def comprehension_filter_at(p: Parser): bool := p.iterable and in_comprehension(p) and keyword_at(p, "where")

// A rule's hole ending a loop's header is its body: `$body` of `for $i in 1 to $n $body`, then the line's end, a
// closer or the rule's `where`; in a comprehension the loop is an each clause (`[$c for $c in cases of $e]`), its
// iterable ending there
def body_hole_at(p: Parser): bool {
	if in_comprehension(p) or not (is_at(p.code, p.at, '$', p.n) and is_name_start(peek(p.code, p.at + 1, p.n))) { return false }
	after = spaces_end(p, name_end(p.code, p.at + 1, p.n))
	after >= p.n or "\n;)}]".contains(p.code[after]) or keyword_at_position(p, "where", after)
}

// `for 1…100: print it`, `for xs {…}` and `for 0 to 2` with the lines indented below: a loop over the iterable without
// a name, its body a block; ø if no body follows
// Rust twin: loops.rs try_parse_for_in (only the colon and do forms), as_block
def ranged_loop(p: Parser): Node := {
	iterable = iterable_words(p)
	skip_spaces(p)
	width = body_word_width(p)
	body = ø
	if width > 0 {
		body = colon_body(p, width)
	} else if is_at(p.code, p.at, '{', p.n) {
		body = atom(p)
	} else {
		body = indented_block(p)
	}
	if body == ø { return ø }
	// a colon body stays bare, as in `for i in xs: x`
	spaced([symbol("for"), iterable, body])
}

// A loop's body: `{…}`, `: words`, `do words`
// Rust twin: statements.rs for_iterable_and_body_word, colon_body
def loop_body(p: Parser): Node := {
	width = body_word_width(p)
	if width == 2 {
		p.at = p.at + width
		if closing_end_follows(p, END_BLOCK_OPENERS) { return end_block(p, false) }
		p.at = p.at - width
	}
	if width > 0 { return colon_body(p, width) }
	block = indented_block(p)
	if block != ø { return block }
	// `[x for x in xs where x > 2]`: a comprehension's `where` filters as its `if`
	if in_comprehension(p) and keyword_at(p, "where") {
		p.at = p.at + "where".length
		return symbol("if")
	}
	atom(p)
}

def body_word_width(p: Parser): int {
	if is_at(p.code, p.at, ':', p.n) { return 1 }
	if keyword_at(p, "do") { return 2 }
	0
}

// The words up to the end of the statement, one expression: `print ord c` of `for c in s: print ord c`
// Rust twin: statements.rs rest_of_statement, words_binding
def statement_words(p: Parser): Node := {
	words = words_binding(p, 0)
	// `for i in 1…3: print i, i*2` prints both
	if words.length >= 2 and words#1 == PRINT and is_at(p.code, p.at, ',', p.n) { return print_call_from(p, one_expression(words[1:]), 0) }
	if words.length == 1 { return words#1 }
	phrase(Bracket.None, words)
}

// The words of an expression up to a comma, the line's end or an `else`, each binding at least `min_power`
// Rust twin: commands.rs words_binding
def words_binding(p: Parser, min_power: int): list {
	words = []
	while true {
		words = words + [expression(p, min_power)]
		skip_spaces(p)
		if ends_branch(p) or not starts_atom(p) { break }
	}
	words
}

def one_expression(words: list): Node := if words.length == 1 then words#1 else spaced(words)

// The call print(first, …): the arguments after `first` follow commas, each the words up to the next one
// Rust twin: commands.rs print_call_from
def print_call_from(p: Parser, first: Node, min_power: int): Node := {
	arguments = [first]
	while is_at(p.code, p.at, ',', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		arguments += [one_expression(words_binding(p, min_power))]
	}
	call_of([PRINT] + arguments)
}

def ends_branch(p: Parser): bool := keyword_at(p, "else") or else_if_at(p)

def else_if_at(p: Parser): bool := keyword_form(word_at(p)) == "else if"

def starts_atom(p: Parser): bool := starts_atom_at(p, p.at)

def starts_atom_at(p: Parser, at: int): bool {
	c = peek(p.code, at, p.n)
	is_name_start(c) or is_digit(c) or opens_text(c) or c == '(' or c == '[' or c == '{' or (c == '@' and is_name_start(peek(p.code, at + 1, p.n))) or starts_path_at(p, at)
}

// `x`, `k, v` or `(k, v)`: the names a loop gives each item, else ø
// Rust twin: statements.rs parse_loop_variable
def loop_variable(p: Parser): Node := {
	bracket = Bracket.None
	if is_at(p.code, p.at, '(', p.n) {
		bracket = Bracket.Round
		p.at = p.at + 1
	}
	names = []
	while true {
		skip_spaces(p)
		// a rule's name hole `$item` stands for the name: `for $item in $xs {…}`
		hole = if is_at(p.code, p.at, '$', p.n) then 1 else 0
		if not is_name_start(peek(p.code, p.at + hole, p.n)) { return ø }
		end = name_end(p.code, p.at + hole, p.n)
		names = names + [symbol(p.code[p.at .. end])]
		p.at = end
		skip_spaces(p)
		if not is_at(p.code, p.at, ',', p.n) { break }
		p.at = p.at + 1
	}
	if bracket == Bracket.Round {
		if not is_at(p.code, p.at, ')', p.n) { return ø }
		p.at = p.at + 1
	}
	if names.length == 1 { return names#1 }
	listed(bracket, Separator.Comma, names)
}

// The atom at the parser's position at its line and column, as the Rust parser marks each atom: a warning or error
// about it names where it stands (card front-end-warnings)
// Rust twin: atoms.rs parse_atom (LineInfo::at)
def atom(p: Parser): Node := {
	start = p.at
	found = bare_atom(p)
	if found === ø { return found }
	placed_at(p, found, start)
}

// The node, written at the source's offset `start`: its line and column
def placed_at(p: Parser, n: Node, start: int): Node := {
	line = line_at(p, start)
	positioned(n, line, start - p.line_starts[line - 1] + 1)
}

// Where each line of the source starts
def line_starts_of(source: text): list {
	starts = [0]
	for at in 0 ..< source.length { if source[at] == '\n' { starts += [at + 1] } }
	starts
}

// The line (from 1) holding the position `at`, by bisection of the line starts
def line_at(p: Parser, at: int): int {
	first = 0
	last = p.line_starts.length
	while last - first > 1 {
		middle = (first + last) /! 2
		if p.line_starts[middle] <= at { first = middle } else { last = middle }
	}
	first + 1
}

FLOAT_SUFFIXES = "fFdD"
// the type words naming a kind of number, `number` itself not (Rust twin: type_tests.rs is_number_type_word)
NUMBER_TYPE_WORDS = ["int", "integer", "long", "i64", "i32", "rational", "real", "exact", "float", "double", "f64", "f32", "float32", "float64", "fast"]
// the number a literal was written as: a float with a point or an exponent, else an int
def written_number(written: text): Node := if written.contains(".") or written.contains("e") then float(written) else whole_number(written)
// the int a literal's digits write; beyond 64 bits, `1e20` and `100000000000000000000`, the number view of its digits,
// an exact big int to the host and to the run (emitter.warp; card exponent-literal-overflow)
INT_MAX_DIGITS = "9223372036854775807"
def whole_number(digits: text): Node := {
	significant = digits
	while #significant > 1 and significant.starts_with("0") { significant = significant[1..] }
	fits = #significant < #INT_MAX_DIGITS or (#significant == #INT_MAX_DIGITS and significant <= INT_MAX_DIGITS)
	if fits then int(digits) else opaque(["number", significant])
}
// a decimal literal: past 18 places, a denominator beyond int64, the number view of its own digits, which the
// emitter makes an exact ratio of a big denominator, never a float (decision exact-decimal-big); any other a float,
// which the emitter reads exact where it can (literals.warp)
DECIMAL_PLACES_IN_INT = 18
def decimal_value(written: text): Node := {
	shown = written
	while shown.ends_with("0") { shown = shown[0 ..< #shown - 1] }
	if #shown.split(".")#2 > DECIMAL_PLACES_IN_INT then opaque(["number", shown]) else float(written)
}

// A number, text, name or bracketed group
// Rust twin: atoms.rs parse_atom, literals.rs read_number_value
def bare_atom(p: Parser): Node := {
	if p.at >= p.n { return ø }
	c = p.code[p.at]
	if is_digit(c) {
		if c == '0' and (is_at(p.code, p.at + 1, 'x', p.n) or is_at(p.code, p.at + 1, 'X', p.n)) {
			p.at = p.at + 2
			return radix_value(p, 16)
		}
		if c == '0' and (is_at(p.code, p.at + 1, 'b', p.n) or is_at(p.code, p.at + 1, 'B', p.n)) and p.at + 2 < p.n and digit_value(p.code[p.at + 2]) < 2 {
			p.at = p.at + 2
			return radix_value(p, 2)
		}
		// `2024-01-31`, `2024-01-31T10:00Z`: a time, the data view Rust's parser gives it
		time_length = time_literal_length(p, p.at)
		if time_length > 0 {
			p.at = p.at + time_length
			return opaque(["data", p.code[p.at - time_length .. p.at]])
		}
		number_start = p.at
		written = decimal_number(p)
		// `0.1f`, `3d`: the float suffix of C, Java and C#, a tight conversion (C's `0.1l` is the litre instead)
		// Rust twin: numbers.rs literal_type_suffix
		if FLOAT_SUFFIXES.contains(peek(p.code, p.at, p.n)) and not is_name_char(peek(p.code, p.at + 1, p.n)) {
			p.at = p.at + 1
			return Key(written_number(written), Op.As, symbol("float"))
		}
		// `0.5:float`, `2.5:int`: a number type glued after a colon binds tightly, unlike the loose `as`
		glued_type = if peek(p.code, p.at, p.n) == ':' then p.code[p.at + 1 .. name_end(p.code, p.at + 1, p.n)] else ""
		if NUMBER_TYPE_WORDS.contains(glued_type) {
			p.at = p.at + 1 + glued_type.length
			return Key(written_number(written), Op.As, symbol(glued_type))
		}
		// two returns and `amount: any`: an `if` of float(…) and int(…), a parameter float elsewhere, make an int beyond
		// i64 a float (card int-beyond)
		// `1.5e-7` is a float, as measurements and other programs write it (decision exact-decimals; Rust twin:
		// numbers.rs scientific_float); `1e3` stays the integer 1000 (decimal_number writes its zeros), `0.5` exact
		if written.contains("e") { return Key(float(written), Op.As, symbol("float")) }
		if written.contains(".") { return with_glued_factor(p, decimal_value(written)) }
		literal = p.code[number_start .. p.at]
		if not (literal.contains("e") or literal.contains("E")) {
			duration = with_time_unit(p, int(written))
			if duration != ø { return duration }
		}
		return with_glued_factor(p, whole_number(written))
	}
	if VULGAR_FRACTIONS.contains(c) { return vulgar_fraction(p, c) }
	if opens_text(c) { return quoted(p) }
	// `.5` is 0.5
	if c == '.' and is_digit(peek(p.code, p.at + 1, p.n)) { return decimal_value("0" + decimal_number(p)) }
	// a loop where an atom stands: the body of a comprehension's clause, `[a + b for a in xs for b in ys]`
	if keyword_at(p, "for") {
		loop = looped(p)
		if loop != ø { return loop }
	}
	if keyword_at(p, "each") {
		loop = each_loop(p)
		if loop != ø { return loop }
	}
	// `\:nosuchthing`, an entity no table row names (expanded_entities replaced the known ones): the text as written
	// Rust twin: atoms.rs parse_atom (card unknown-entity)
	if c == '\\' and is_at(p.code, p.at + 1, ':', p.n) and is_alpha(peek(p.code, p.at + 2, p.n)) {
		end = name_end(p.code, p.at + 2, p.n)
		unknown = "" + p.code[p.at .. end]
		p.at = end
		return unknown
	}
	// `\alpha` written for `\:alpha`
	// Rust twin: atoms.rs parse_atom, uniscript_entities.rs bare_entity_name_at
	if c == '\\' and is_alpha(peek(p.code, p.at + 1, p.n)) {
		end = p.at + 1
		while end < p.n and is_alpha(p.code[end]) { end = end + 1 }
		name = p.code[p.at + 1 .. end]
		if name in entities() { raise "a uniscript entity is written \\:" + name + ", not \\" + name }
	}
	truth = truth_glyph_at(p)
	if truth != "" {
		p.at = p.at + truth.length
		return not FALSE_GLYPHS.contains(truth)
	}
	if is_name_start(c) { return named(p) }
	starred = starred_name(p)
	if starred != ø { return starred }
	// `$a`, a pattern's name hole: `data($a + 0)`; `$0`, a function's first parameter
	if c == '$' and (is_name_start(peek(p.code, p.at + 1, p.n)) or is_digit(peek(p.code, p.at + 1, p.n))) {
		end = symbol_end(p.code, p.at + 1, p.n)
		hole = symbol(p.code[p.at .. end])
		p.at = end
		// `$f(x)`, `$f(x) {…}`: a hole applied reads as the name it stands for applied, its arguments read as a call's
		// (typed_parameters): `$f($x)`
		return name_or_call(p, hole, "")
	}
	if EXACT_CONSTANTS.contains("$(c)") {
		p.at = p.at + 1
		return exact_constant("$(c)")
	}
	if c == '@' and is_name_start(peek(p.code, p.at + 1, p.n)) { return attribute(p) }
	// Swift's `.north`, a member of the type the context expects (a match arm's case), also a rule's `.$k`
	// Rust twin: atoms.rs implicit member
	if c == '.' and (is_name_start(peek(p.code, p.at + 1, p.n)) or peek(p.code, p.at + 1, p.n) == '$') {
		p.at = p.at + 1
		return Key(ø, Op.Dot, atom(p))
	}
	// `@1`: the node whose @id is 1
	if c == '@' and is_digit(peek(p.code, p.at + 1, p.n)) {
		end = p.at + 1
		while end < p.n and is_digit(p.code[end]) { end = end + 1 }
		reference = symbol(p.code[p.at .. end])
		p.at = end
		return reference
	}
	if c == '(' or c == '[' or c == '{' {
		p.at = p.at + 1
		outer = p.header
		outer_iterable = p.iterable
		p.header = outer and c == '('
		p.iterable = outer_iterable and c == '('
		group = if c == '{' then braced_items(p) else items_until(p, c as Bracket, ItemsEnd.Closer)
		p.header = outer
		p.iterable = outer_iterable
		// `(int or text)?`: an optional union, the one type word `int or text?` (a member ø joins is the union's)
		union = if c == '(' and #group == 1 and optional_mark_follows(p, "") then union_spelling(group#1) else ø
		if union != ø {
			p.at = p.at + 1
			return symbol(union + "?")
		}
		return group
	}
	// `°C`, `°F`: a temperature unit; `°` alone the angle unit (units.rs)
	// Rust twin: atoms.rs parse_atom (DEGREE)
	if c == DEGREE {
		end = if is_alpha(peek(p.code, p.at + 1, p.n)) then name_end(p.code, p.at + 1, p.n) else p.at + 1
		unit = symbol(p.code[p.at .. end])
		p.at = end
		return unit
	}
	// `∅`, the empty set sign, is ø while warp has no sets (decision empty-is-not-missing)
	// Rust twin: atoms.rs EMPTY_SET_SIGN
	if c == 'ø' or c == '∅' or c == ')' or c == ']' or c == '}' or c == ';' {
		if c == 'ø' or c == '∅' { p.at = p.at + 1 }
		return ø
	}
	// `"̅"`: a quote carrying combining marks is one grapheme of the code; the marks open the text (card parser-graphemes)
	if opens_text(code_points("$(c)")#1) { return quoted(p) }
	// every other character is read: a free symbol names itself, `x = ↯`, `⌘`; any other one is its character, `★`
	// (card unicode-glyphs)
	// Rust twin: atoms.rs parse_atom (is_free_symbol, parse_emoji; the Rust lane still errors on other characters)
	p.at = p.at + 1
	if is_free_symbol(p, c) then symbol("$(c)") else c
}

// The glyphs that are true or false, longest spelling first: `✔️` is `✔` with an emoji variation selector
// (card keyword-glyphs)
// Rust twin: literals/constants.rs TRUTH_GLYPHS
TRUE_GLYPHS = ["✔️", "✓️", "☑️", "⊤", "✓", "✔", "☑", "✅", "🗸", "🗹"]
FALSE_GLYPHS = ["⊥", "❌", "✗"]
TRUTH_GLYPH_STARTS = by_first_character(TRUE_GLYPHS + FALSE_GLYPHS)
def truth_glyph_at(p: Parser): text {
	for glyph in starting_here(TRUTH_GLYPH_STARTS, p, p.at) { if starts_at(p.code, glyph, p.at, p.n) { return glyph } }
	""
}

// The degree sign of temperatures and angles (Rust twin: numbers/units.rs DEGREE)
DEGREE = '°'

// The Unicode blocks of symbols a program may use before anything defines them (decision unicode-symbols): arrows,
// math operators, technical and geometric symbols, dingbat arrows, the supplemental math and arrow blocks
// Rust twin: operators.rs FREE_SYMBOL_BLOCKS
FREE_SYMBOL_BLOCKS = [['←', '⏿'], ['■', '◿'], ['➔', '➿'], ['⟀', '⟿'], ['⤀', '⫿'], ['⬀', '⯿'], ['￩', '￬']]
// A symbol character no built-in operator, prefix operator or alias spells: a free operator or symbol name
// Rust twin: operators.rs is_free_symbol
def is_free_symbol(p: Parser, c: text): bool {
	glyph = "$(c)"
	// a declared operator calls as declared: `prefix operator ∆` makes `print ∆ 5` print ∆(5), no free infix
	if glyph.length != 1 or aliases_starting(p, glyph).any(alias => alias#1 == glyph) or is_circumfix_glyph(p, glyph) or symbol_operator(glyph) != ø or declared_level(p.operators, glyph) >= 0 { return false }
	FREE_SYMBOL_BLOCKS.any(block => c >= block#1 and c <= block#2) and not aliases_starting(p, glyph).any(alias => alias#1 == glyph)
}
// `1 ⇔ 1` with no `infix operator ⇔` declared: a free symbol with an operand after it on its line calls its operator;
// `[↯ ↯]` and `print ↯` read the glyph as a value
// Rust twin: operators.rs try_parse_free_infix, free_symbol_follows
def free_infix_at(p: Parser, left: Node): bool := left != ø and is_free_symbol(p, peek(p.code, p.at, p.n)) and operand_follows(p, 1) and not is_free_symbol(p, code_after(p, p.at + 1))

// The URL after its scheme word, up to a blank, a separator, a closer or a quote
// Rust twin: literals/paths.rs parse_url, is_url_terminator
def url_text(p: Parser, scheme: text): text {
	end = p.at
	while end < p.n and not " \t\n\r;)]}>\"',«".contains(p.code[end]) { end = end + 1 }
	url = scheme + p.code[p.at .. end]
	p.at = end
	url
}

// A file path without quotes starts here, glued to what follows and not to an operand before it: `./a.wav`,
// `../songs/a.wav`, `./` alone, `~/notes.txt`, `/etc/hosts` where no operand stands before it (`x = /tmp`, `[/a, /b]`);
// after an operand `/` divides (`width /height`). `ls /tmp`, a path after a word taking one, waits for card path-words
// Rust twin: literals/paths.rs starts_path_literal
def starts_path(p: Parser): bool := starts_path_at(p, p.at)

def starts_path_at(p: Parser, at: int): bool {
	c = peek(p.code, at, p.n)
	if at > 0 and is_operand_end(p.code[at - 1]) { return false }
	if c == '.' {
		dots = if is_at(p.code, at + 1, '.', p.n) then 2 else 1
		after = peek(p.code, at + dots + 1, p.n)
		return is_at(p.code, at + dots, '/', p.n) and (not ends_path(after) or not operand_follows_at(p, at + dots + 1))
	}
	// `cd ~` alone; `a ~ b` stays the comparison
	if c == '~' { return is_at(p.code, at + 1, '/', p.n) or not operand_follows_at(p, at + 1) }
	if c == '/' { return starts_path_name(peek(p.code, at + 1, p.n)) and not operand_before(p, at) }
	false
}

// The path at the parser's position, up to a blank, a closer or a separator, as a text
// Rust twin: literals/paths.rs parse_path_literal
def path_literal(p: Parser): text {
	end = p.at
	while end < p.n and not ends_path(p.code[end]) { end = end + 1 }
	path = p.code[p.at .. end]
	p.at = end
	path
}

def is_operand_end(c: text): bool := is_name_char(c) or c == ')' or c == ']' or c == '}' or c == '"' or c == '\'' or c == '»'
def ends_path(c: text): bool := is_blank(c) or c == ']' or c == ')' or c == '}' or c == ',' or c == ';'
def starts_path_name(c: text): bool := is_name_start(c) or c == '.'

// Whether an operand ends before the blanks before `start`
def operand_before(p: Parser, start: int): bool {
	at = start - 1
	while at >= 0 and (p.code[at] == ' ' or p.code[at] == '\t') { at = at - 1 }
	at >= 0 and is_operand_end(p.code[at])
}

// The exact generators the core has no value for yet; `π`, `τ`, `ℯ` and `∞` are plain names lib/reals.warp defines
// Rust twin: literals/constants.rs check_constants
EXACT_CONSTANTS = ["ⅈ", "ε", "ω"]
// no node of its own in warp yet (card node-more-cases): the number view, which the Rust side reads as written
def exact_constant(word: text): Node := opaque(["number", word])

// `shader { … }` (or `wgsl { … }`) after its word: WGSL as a sublanguage, the text between the braces without its
// common indentation, braces in WGSL comments not counted; else ø
// Rust twin: literals/shaders.rs parse_shader_block
SHADER_WORDS = ["shader", "wgsl"]
def shader_block(p: Parser, word: text): Node := {
	open = p.at
	while open < p.n and (p.code[open] == ' ' or p.code[open] == '\t') { open = open + 1 }
	if not is_at(p.code, open, '{', p.n) { return ø }
	end = closing_brace(p.code, open + 1, p.n)
	if end < 0 { raise "the { of `" + word + " { … }` is never closed" }
	p.at = end + 1
	shader_text(dedented(p.code[open + 1 .. end]))
}

// Where the `}` closing a `{` before `at` is, -1 if none: WGSL comments hold no braces
// Rust twin: literals/text.rs closing_brace
def closing_brace(code: text, at: int, n: int): int {
	depth = 1
	while at < n {
		c = code[at]
		if c == '/' and is_at(code, at + 1, '/', n) {
			while at + 1 < n and code[at + 1] != '\n' { at = at + 1 }
		} else if c == '/' and is_at(code, at + 1, '*', n) {
			at = at + 2
			while at + 1 < n and not (code[at] == '*' and code[at + 1] == '/') { at = at + 1 }
			at = at + 1
		} else if c == '{' {
			depth = depth + 1
		} else if c == '}' {
			if depth == 1 { return at }
			depth = depth - 1
		}
		at = at + 1
	}
	-1
}

// The lines without the indentation all non-blank ones share, without the blank lines around them, the first
// without any
// Rust twin: literals/text.rs without_common_indentation
def dedented(source: text): text {
	lines = source.split("\n")
	written = [line for line in lines if line.trim()]
	if #written == 0 { return "" }
	common = min(written.map(indent_width))
	first = 1
	while lines#first.trim() is empty { first = first + 1 }
	last = #lines
	while lines#last.trim() is empty { last = last - 1 }
	kept = []
	for index in first .. last + 1 {
		line = lines#index
		kept += [without_trailing_blanks(if index == first then line.trim() else line[common ..])]
	}
	kept.join("\n")
}

def indent_width(line: text): int {
	width = 0
	while width < #line and (line[width] == ' ' or line[width] == '\t') { width = width + 1 }
	width
}

def without_trailing_blanks(line: text): text {
	end = #line
	while end > 0 and (line[end - 1] == ' ' or line[end - 1] == '\t') { end = end - 1 }
	line[0 .. end]
}

// A shader's WGSL with each hole `$name` read from the uniform values (`values.name`), the holes listed in its
// shader_holes attribute; Book of Shaders names and `$mouse_x` read warp's own holes
// Rust twin: graphics/shader_holes.rs shader_text, written
HOLE_ALIASES = {"mouse_x": "mouse.x", "mouse_y": "mouse.y", "u_time": "time", "u_resolution": "size", "u_mouse": "mouse", "wheel": "mouse_wheel"}
def shader_text(wgsl: text): Node := {
	names = []
	// the pieces between holes are copied whole, joined once: one `+` per character copied the text each time
	parts = []
	copied = 0
	at = 0
	n = #wgsl
	while at < n {
		c = wgsl[at]
		end = at + 1
		if c == '$' {
			while end < n and (is_alphanumeric(wgsl[end]) or wgsl[end] == '_') { end = end + 1 }
		}
		if end == at + 1 or is_digit(wgsl[at + 1]) {
			at = at + 1
		} else {
			written_name = wgsl[at + 1 .. end]
			read = if HOLE_ALIASES.contains(written_name) then HOLE_ALIASES[written_name] else written_name
			parts += [wgsl[copied .. at], "values." + read]
			hole_name = read.split(".")#1
			if not names.contains(hole_name) { names += [hole_name] }
			at = end
			copied = at
		}
	}
	text = join(parts + [wgsl[copied .. n]], "")
	if #names == 0 { return text }
	attributed("shader_hole_names", listed(Bracket.Square, Separator.Space, [symbol(hole_name) for hole_name in names]), text)
}

// `@name` or `@name(value)` marks the atom after it: `@version(2) @draft tee{a:1}`; `@name: value` is the meta entry
// `@name`, never a field; after a dot, `p.@name` names the meta key itself
// Rust twin: annotations.rs parse_attribute
def attribute(p: Parser): Node := {
	after_dot = p.at > 0 and p.code[p.at - 1] == '.'
	end = name_end(p.code, p.at + 1, p.n)
	key = symbol(p.code[p.at .. end])
	name = p.code[p.at + 1 .. end]
	p.at = end
	if after_dot { return key }
	if is_at(p.code, p.at, ':', p.n) and not is_at(p.code, p.at + 1, '=', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		return Key(key, Op.Colon, atom(p))
	}
	value = attribute_value(p)
	skip_spaces(p)
	attributed(name, value, atom(p))
}

// The value of `@name(value)`, true for a bare `@name`
def attribute_value(p: Parser): Node := {
	if not is_at(p.code, p.at, '(', p.n) { return true }
	group = atom(p)
	parts = group_parts(group)
	if parts != ø and #parts#3 == 1 then parts#3#1 else group
}

// `ys = xs.map(f) @parallel`: an `@name` or `@name(value)` with nothing after it on the statement marks the
// expression before it, else ø
// Rust twin: annotations.rs try_parse_trailing_attribute
def trailing_attribute(p: Parser, marked: Node): Node := {
	start = p.at
	if not is_name_start(peek(p.code, p.at + 1, p.n)) { return ø }
	end = name_end(p.code, p.at + 1, p.n)
	name = p.code[p.at + 1 .. end]
	p.at = end
	value = attribute_value(p)
	skip_spaces(p)
	if p.at < p.n and not "\n\r;,)]}".contains(p.code[p.at]) {
		p.at = start
		return ø
	}
	attributed(name, value, marked)
}

// The calendar length of each calendar unit word: [months, days, seconds]. A day can be 23 or 25 hours across a
// daylight saving change and a month varies; an hour, a minute and a second are fixed, quantities of lib/units.warp
// (`sleep 1 minute`)
// Rust twin: time/calendar.rs unit_named
TIME_UNITS = {"year": [12, 0, 0], "month": [1, 0, 0], "week": [0, 7, 0], "day": [0, 1, 0]}

// The length of a time unit word, singular or plural (`day`, `days`), else ø
def time_unit_named(word: text) := TIME_UNITS.get(if word.ends_with("s") then word[0 ..< #word - 1] else word)

// `1 month`, `24 hours`, `1day`, `1 month 2 days`: an integer followed by a time unit word is a calendar duration, the
// data view Rust's parser gives it, ["data", "1 month 2 days"] as the duration prints; else ø, nothing read
// Rust twin: literals/units.rs with_time_unit, following_duration
def with_time_unit(p: Parser, count: int): Node := {
	unit = time_unit_at(p, p.at)
	if unit == ø { return ø }
	length = unit#1.map(part => part * count)
	p.at = unit#2
	while true {
		spaces = run_end(p.code, p.at, ' ', p.n)
		digits = digits_end(p.code, spaces, p.n)
		following = if spaces > p.at and digits > spaces then time_unit_at(p, digits) else ø
		if following == ø { break }
		amount = int(p.code[spaces .. digits])
		length = (1 to 3).map(i => length#i + following#1#i * amount)
		p.at = following#2
	}
	opaque(["data", duration_text(length)])
}

// The length of the RFC 3339 / RFC 9557 time literal at `at`: `2024-01-31`, `2024-01-31T10:00:30.5+01:00`,
// `2024-01-31T10:00[Europe/Berlin]`; 0 if none starts there
// Rust twin: time/calendar.rs literal_len
def time_literal_length(p: Parser, at: int): int {
	if not (digits_at(p, at, 4) and is_at(p.code, at + 4, '-', p.n) and digits_at(p, at + 5, 2) and is_at(p.code, at + 7, '-', p.n) and digits_at(p, at + 8, 2)) { return 0 }
	end = at + 10
	if (is_at(p.code, end, 'T', p.n) or is_at(p.code, end, 't', p.n)) and clock_at(p, end + 1) {
		end = end + 6
		if is_at(p.code, end, ':', p.n) and digits_at(p, end + 1, 2) {
			end = end + 3
			if is_at(p.code, end, '.', p.n) and digits_at(p, end + 1, 1) {
				end = end + 1
				while end < p.n and is_digit(p.code[end]) { end = end + 1 }
			}
		}
		if is_at(p.code, end, 'Z', p.n) or is_at(p.code, end, 'z', p.n) {
			end = end + 1
		} else if (is_at(p.code, end, '+', p.n) or is_at(p.code, end, '-', p.n)) and clock_at(p, end + 1) {
			end = end + 6
		}
		// RFC 9557 suffixes: `[Europe/Berlin]`, then `[key=value]` like `[_tzdata=warp-2026a]`
		while is_at(p.code, end, '[', p.n) {
			close = suffix_close(p, end + 1)
			if close == 0 { break }
			end = close + 1
		}
	}
	if end < p.n and (is_alphanumeric(p.code[end]) or p.code[end] == '_') { return 0 }
	end - at
}

// `count` digits from `at`
def digits_at(p: Parser, at: int, count: int): bool {
	for i in at ..< at + count {
		if i >= p.n or not is_digit(p.code[i]) { return false }
	}
	true
}

// `10:00` at `at`: two digits, a colon, two digits
def clock_at(p: Parser, at: int): bool := digits_at(p, at, 2) and is_at(p.code, at + 2, ':', p.n) and digits_at(p, at + 3, 2)

// The `]` closing a time literal's suffix whose name starts at `at`, a name of letters, digits and `/_+-=.!`; 0 if none
def suffix_close(p: Parser, at: int): int {
	close = at
	while close < p.n and p.code[close] != ']' {
		c = p.code[close]
		if not (is_alphanumeric(c) or "/_+-=.!".contains(c)) { return 0 }
		close = close + 1
	}
	if close >= p.n or close == at then 0 else close
}

// The time unit word at `at` after any spaces: [its length, where it ends], else ø; `{year:1970 month:1}`: a word that
// starts the next entry or assignment is no unit
// Rust twin: literals/units.rs time_unit_at, time/calendar.rs unit_after
def time_unit_at(p: Parser, at: int): list? := {
	at = run_end(p.code, at, ' ', p.n)
	end = name_end(p.code, at, p.n)
	unit = time_unit_named(p.code[at .. end])
	if unit == ø { return ø }
	after = run_end(p.code, end, ' ', p.n)
	starts_entry = is_at(p.code, after, ':', p.n) or (is_at(p.code, after, '=', p.n) and not is_at(p.code, after + 1, '=', p.n))
	if starts_entry then ø else [unit, end]
}

// `1 month 2 days`, `3 hours`: a duration's months, days and seconds as Rust's Duration prints them
// Rust twin: time/calendar.rs Display for Duration
def duration_text(length: list): text {
	seconds = length#3
	amounts = [[length#1, "month"], [length#2, "day"], [seconds /! 3600, "hour"], [seconds % 3600 /! 60, "minute"], [seconds % 60, "second"]]
	parts = amounts.filter(amount => amount#1 != 0).map(amount => counted_unit(amount#1, amount#2))
	if parts.length == 0 { return "0 seconds" }
	parts.join(" ")
}

def counted_unit(amount: int, unit: text): text := if amount == 1 then "1 " + unit else "$(amount) $(unit)s"

// The Unicode vulgar fractions, each the numerator and denominator its NFKD decomposition writes (½ is 1⁄2)
// Rust twin: numbers.rs vulgar_fraction
VULGAR_FRACTIONS = {"½": [1, 2], "↉": [0, 3], "⅓": [1, 3], "⅔": [2, 3], "¼": [1, 4], "¾": [3, 4], "⅕": [1, 5], "⅖": [2, 5], "⅗": [3, 5], "⅘": [4, 5], "⅙": [1, 6], "⅚": [5, 6], "⅐": [1, 7], "⅛": [1, 8], "⅜": [3, 8], "⅝": [5, 8], "⅞": [7, 8], "⅑": [1, 9], "⅒": [1, 10]}

// `⅓` is the exact 1/3; digits glued after it multiply it
// Rust twin: numbers.rs vulgar_fraction_literal
def vulgar_fraction(p: Parser, glyph: text): Node := {
	p.at = p.at + 1
	parts = VULGAR_FRACTIONS[glyph]
	fraction = keyed("/", int(parts#1), int(parts#2))
	if is_digit(peek(p.code, p.at, p.n)) then Key(fraction, Op.Mul, atom(p)) else fraction
}

// `2x` is 2*x, `500ms` is 500*ms, `3(4)` is 3*(4): a name or `(` glued to a number multiplies it; ordinals `1st` do not
// Rust twin: literals.rs with_juxtaposed_factor
def with_glued_factor(p: Parser, amount: Node): Node := {
	c = peek(p.code, p.at, p.n)
	if not (is_name_start(c) or c == '(' or c == DEGREE) or ORDINAL_SUFFIXES.contains(p.code[p.at .. name_end(p.code, p.at, p.n)]) {
		return amount
	}
	factor = atom(p)
	power = superscript_power(p, factor, 0)
	Key(amount, Op.Mul, if power == ø then factor else power)
}

// `x²` is x^2, `x⁻¹` is 1/x^1, `2ⁿ⁺¹` is 2^(n+1), `2²⁺³` is 2^5:
// the power of `left` written in superscripts at the parser's position and binding at least `min_power`, else ø
// Rust twin: math_notation.rs try_parse_superscript_power, superscript_exponent, superscript_variable_exponent
def superscript_power(p: Parser, left: Node, min_power: int): Node := {
	terms = raised_terms(p)
	if terms.length == 0 { return ø }
	width = terms#(terms.length)#3 - p.at
	lettered = false
	for term in terms {
		if term#2 is symbol { lettered = true }
	}
	if lettered {
		if binding_powers("^")#1 < min_power { return ø }
		exponent = terms#1#2
		for term in terms[1:] { exponent = Key(exponent, if term#1 < 0 then Op.Sub else Op.Add, term#2) }
		p.at = p.at + width
		return reciprocal_if(terms#1#1 < 0, Key(left, Op.Pow, exponent))
	}
	total = 0
	for term in terms { total = total + term#1 * term#2 }
	power = Key(left, Op.Pow, if total < 0 then 0 - total else total)
	// a lone ² or ³ binds as a suffix: `a.b²` squares a.b
	suffix = width == 1 and (total == 2 or total == 3)
	if (if suffix then SUFFIX_POWER else binding_powers("^")#1) < min_power { return ø }
	p.at = p.at + width
	reciprocal_if(total < 0, power)
}

def reciprocal_if(negative: bool, power: Node): Node := if negative then Key(1, Op.Div, power) else power

// The superscript terms at the parser's position, each [sign, value, end]: a raised number, or a raised name as a symbol
def raised_terms(p: Parser): list {
	terms = []
	at = p.at
	while true {
		sign = 1
		if is_at(p.code, at, '⁻', p.n) { sign = -1 }
		start = if is_at(p.code, at, '⁻', p.n) or is_at(p.code, at, '⁺', p.n) then at + 1 else at
		end = start
		letters = ""
		while end < p.n and SUPERSCRIPT_LETTER_INDEX.has("$(p.code[end])") {
			letters = letters + RAISED_LETTERS[SUPERSCRIPT_LETTER_INDEX["$(p.code[end])"]]
			end = end + 1
		}
		value = 0
		while letters is empty and end < p.n and SUPERSCRIPT_DIGIT_INDEX.has("$(p.code[end])") {
			value = value * 10 + SUPERSCRIPT_DIGIT_INDEX["$(p.code[end])"]
			end = end + 1
		}
		if end == start { return terms }
		terms += [[sign, if letters is empty then value else symbol(letters), end]]
		at = end
	}
	terms
}

// Each superscript letter and digit → where it stands in its table, read once: finding a character in the table text
// walked the table at each operand (a quarter of a parse, card compiler-parse-timing)
SUPERSCRIPT_LETTER_INDEX = character_index(SUPERSCRIPT_LETTERS)
SUPERSCRIPT_DIGIT_INDEX = character_index(SUPERSCRIPT_DIGITS)
def character_index(table: text): map {
	index = {}
	at = 0
	for c in table {
		index["$(c)"] = at
		at = at + 1
	}
	index
}

ORDINAL_SUFFIXES = ["st", "nd", "rd", "th"]

// The words of a block of code, also glued to it: `go{…}` starts a task, `loop{…}` loops, `do{…}` runs its block;
// no tags `go:{…}` (Rust twin: atoms.rs GLUED_BLOCK_KEYWORDS)
GLUED_BLOCK_WORDS = ["go", "loop", "do"]

// A name and what is glued to it: `f(x)` calls f, `f(x) {…}` defines it, `a{…}` is the tagged block `a:{…}`
// Rust twin: atoms.rs parse_symbol_with_suffix, parse_glued_suffix, function_call
def named(p: Parser): Node := {
	bang = bang_word_at(p)
	end = if bang > 0 then p.at + bang else symbol_end(p.code, p.at, p.n)
	joined = joined_type_name(p, p.code[p.at .. end], end)
	word = joined#1
	p.at = joined#2
	if keyword_form(word) == "reference" {
		referenced = function_reference(p)
		if referenced != ø { return referenced }
	}
	if word == "enum" and enum_values_ahead(p) { return enum_with_values(p) }
	if word == "wasm" {
		instruction = wasm_instruction_after(p)
		if instruction != ø { return instruction }
	}
	if optional_mark_follows(p, word) {
		p.at = p.at + 1
		return symbol(word + "?")
	}
	// `list<int>`, `option<int>`: a type applied to type arguments, the type written in words; a declared `Box<T>`
	// keeps its brackets (Rust twin: atoms.rs parse_glued_suffix '<')
	type_arguments = if p.types.contains(word) then 0 else type_application_length(p, p.at)
	if type_arguments > 0 {
		arguments = p.code[p.at + 1 .. p.at + type_arguments - 1]
		p.at = p.at + type_arguments
		return symbol(type_application_name(word, arguments))
	}
	constant = if names_case(p, word.length) then "" else keyword_form(word.lower())
	if constant == "true" { return true }
	if constant == "false" { return false }
	if constant == "empty" and not names_key(p) { return ø }
	if not names_case(p, word.length) and EXACT_CONSTANTS.contains(word.lower()) { return exact_constant(word) }
	// `https://pannous.com`, `ssh://host`: a URL, the rest of which reads as one text
	if p.code[p.at .. min(p.at + 3, p.n)] == "://" { return url_text(p, word) }
	if SHADER_WORDS.contains(word) {
		shader = shader_block(p, word)
		if shader != ø { return shader }
	}
	// the Java/C array type `int[]` is the list type `[int]` (Rust twin: types/expressions.rs try_parse_array_type_suffix)
	if starts_at(p.code, "[]", p.at, p.n) and is_type_argument(word) {
		p.at = p.at + 2
		return listed(Bracket.Square, Separator.Space, [symbol(word)])
	}
	// Rust's turbofish `sum::<i32>()`, `collect::<Vec<i32>>()`: the type arguments say nothing warp needs, the call is
	// `sum()` (Rust twin: atoms.rs skip_turbofish)
	turbofish = if starts_at(p.code, "::", p.at, p.n) then type_application_length(p, p.at + 2) else 0
	if turbofish > 0 { p.at = p.at + 2 + turbofish }
	name = symbol(word)
	// `x°`: a variable in degrees, as `30°` (Rust twin: atoms.rs, card angles-degrees)
	if is_at(p.code, p.at, DEGREE, p.n) and not is_alpha(peek(p.code, p.at + 1, p.n)) {
		p.at = p.at + 1
		return Key(name, Op.Mul, symbol("$(DEGREE)"))
	}
	// `Point {x: 1}` with blanks constructs a declared type as the glued one does (open decision 41); a capitalized word
	// of no declared type before a block of fields is the tagged object `Person:{…}` (card person-name)
	declared = p.types.contains(word)
	if (declared or is_capitalized(word)) and block_after_blanks(p, declared) { skip_spaces(p) }
	if is_at(p.code, p.at, '{', p.n) {
		if GLUED_BLOCK_WORDS.contains(word) { return name }
		p.at = p.at + 1
		// `Point{x: 1}` of a declared type constructs a point, any other `name{…}` stays the tagged block (D4)
		return Key(name, if declared then Op.None else Op.Colon, braced_items(p))
	}
	name_or_call(p, name, word)
}
// the name, or its call `name(x, y)` when a round group follows it, with the block side by side after it
// (`f(x) {…}`); the arguments of `print(…)` as print reads them
def name_or_call(p: Parser, name: Node, word: text): Node := {
	if not is_at(p.code, p.at, '(', p.n) { return name }
	p.at = p.at + 1
	written = items_until(p, Bracket.Round, ItemsEnd.Closer)
	arguments = typed_parameters(written)
	skip_spaces(p)
	if is_at(p.code, p.at, '{', p.n) and not p.header {
		p.at = p.at + 1
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
		// the head is the call f(x, y)
		return call_of([call_of([name] + spread(arguments)), body])
	}
	call_of([name] + (if word == PRINT_WORD then print_arguments(written) else spread(arguments)))
}

// `print(a b)`, `print(match n {…})`: words set apart by blanks are the one value printed; `print(a, b)` prints each
// Rust twin: commands.rs print_arguments
PRINT_WORD = "print"
def print_arguments(arguments: Node): list {
	parts = group_parts(arguments)
	if parts != ø and parts#2 == " " and #parts#3 > 1 { return [arguments] }
	spread(arguments)
}

// The type names that take type arguments in angle brackets besides the plural and capitalized ones
// Rust twin: types/expressions.rs GENERIC_TYPE_HEADS, OPTION_HEADS
GENERIC_TYPE_HEADS = ["list", "array", "set", "map", "option", "result", "tuple"]
OPTION_HEADS = ["option", "Option"]

// The length of the type arguments `<int>`, `<list<int>>`, `<text, int>` at `start`, 0 unless every word in them
// names a type (`i<n>` compares)
// Rust twin: types/expressions.rs type_application_length
def type_application_length(p: Parser, start: int): int {
	if not is_at(p.code, start, '<', p.n) { return 0 }
	depth = 0
	words = []
	// a word is the slice since the last other character, not built a character at a time
	word_start = start
	for at in start ..< p.n {
		c = p.code[at]
		if is_alphanumeric(c) or c == '_' or c == '?' { continue }
		if c == '<' {
			depth = depth + 1
		} else if c == '>' {
			depth = depth - 1
		} else if not ", ()".contains(c) {
			return 0
		}
		if at > word_start { words += [p.code[word_start .. at]] }
		word_start = at + 1
		if depth == 0 { return if at > start + 1 and words.all(is_type_argument) then at - start + 1 else 0 }
	}
	0
}

// `int`, `ints`, `list`, `Point`, `text?`: a word that can stand in type arguments
def is_type_argument(word: text): bool := is_type_name(if word.ends_with("?") then word[0 ..< word.length - 1] else word)

// A word that can take type arguments: a type word, its plural, `list`, `map` …, a capitalized type
// Rust twin: types/expressions.rs names_a_type
def is_type_name(word: text): bool := is_type_word(word) or (word.ends_with("s") and is_type_word(word[0 ..< word.length - 1])) or word in GENERIC_TYPE_HEADS or is_capitalized(word)

// The type `name<arguments>` in words: `list<list<int>>` is `list of list of int`, `option<int>` is `int?`, Rust's
// `Vec<i32>` is `list of i32`
// Rust twin: types/expressions.rs type_application_name, list_type_head
def type_application_name(name: text, arguments: text): text {
	if OPTION_HEADS.contains(name) and not arguments.contains(",") and not arguments.contains("<") { return arguments.trim() + "?" }
	head = if foreign_list_heads.contains(name) then "list" else name
	words = arguments.replace("<", " of ").replace(">", "").split(" ").filter(w => w)
	head + " of " + words.join(" ")
}

// `x:int?=ø`, `f(x:int?)`, the field `right? }`: the `?` after `word` marks it optional when a closer, `=`, a comment,
// the next field or a declaration follows; a ternary `?` is followed by its branch instead
// Rust twin: atoms.rs parse_symbol_with_suffix (Optional type)
def optional_mark_follows(p: Parser, word: text): bool {
	if not is_at(p.code, p.at, '?', p.n) { return false }
	after = p.at + 1
	ends_optional_type(peek(p.code, after, p.n), peek(p.code, after + 1, p.n)) or closes_after_blanks(p, after) or next_field_follows(p, after) or declaration_follows(p, word, after) or result_body_follows(p, word, after)
}

// `def f(x: int): list? {…}`: `word` follows a signature's `):` and spaces or tabs from `at` lead to a `{`, so it is
// an optional result type before the body, no ternary (decision optional-result)
// Rust twin: lookahead.rs result_body_follows
def result_body_follows(p: Parser, word: text, at: int): bool {
	colon = blank_before(p, p.at - word.length)
	body = spaces_end(p, at)
	body > at and is_at(p.code, body, '{', p.n) and colon > 0 and is_at(p.code, colon, ':', p.n) and blank_before(p, colon) >= 0 and is_at(p.code, blank_before(p, colon), ')', p.n)
}

// The position of the last character before `at` that is no blank, -1 at the source's start
def blank_before(p: Parser, at: int): int {
	before = at - 1
	while before >= 0 and is_blank(p.code[before]) { before = before - 1 }
	before
}

// What ends an optional type after its `?`: a closer, a separator, the line's or source's end, or an assignment's `=`
// Rust twin: lookahead.rs ends_optional_type
def ends_optional_type(next: text, after: text): bool := ")]},;\n\r".contains(next) or (next == '=' and after != '=')

// Spaces or tabs from `at`, then a comment or what ends an optional type
// Rust twin: lookahead.rs closes_after_blanks
def closes_after_blanks(p: Parser, at: int): bool {
	end = spaces_end(p, at)
	comment_starts = is_at(p.code, end, '/', p.n) and "/*".contains(peek(p.code, end + 1, p.n))
	end > at and (comment_starts or ends_optional_type(peek(p.code, end, p.n), peek(p.code, end + 1, p.n)))
}

// Inside a type's body, spaces or tabs from `at`, then the next field `name:` (no `:=`, no `::`)
// Rust twin: lookahead.rs next_field_follows
def next_field_follows(p: Parser, at: int): bool {
	start = spaces_end(p, at)
	colon = name_end(p.code, start, p.n)
	p.type_body and start > at and colon > start and is_at(p.code, colon, ':', p.n) and not "=:".contains(peek(p.code, colon + 1, p.n))
}

// After the type word `word`, spaces or tabs from `at`, then the definition `:=` or a declared name `i =`: `int? i = 3`
// and `as int? := …` are optional types, no ternary; `f(): Name? := …` also of a type the program does not declare (a
// used file's), as a ternary has no empty branch
// Rust twin: lookahead.rs declaration_follows
def declaration_follows(p: Parser, word: text, at: int): bool {
	start = spaces_end(p, at)
	name_after = name_end(p.code, start, p.n)
	assigned = if name_after == start then start else spaces_end(p, name_after)
	assigns = if is_at(p.code, assigned, ':', p.n) then peek(p.code, assigned + 1, p.n) == '=' else is_at(p.code, assigned, '=', p.n) and peek(p.code, assigned + 1, p.n) != '='
	start > at and assigns and (name_after == start or is_type_word(word) or p.types.contains(word))
}

// After the spaces and tabs from `at` on
def spaces_end(p: Parser, at: int): int := blanks_end(p.code, at, p.n)

// Blanks, then a block of fields: `{}`, `{ name: …`, or with `assignments` `{ x = 1 …` (its first entry may start on
// the next line)
// Rust twin: lookahead.rs block_after_blanks
def block_after_blanks(p: Parser, assignments: bool): bool {
	at = blank_end(p, p.at)
	if at == p.at or not is_at(p.code, at, '{', p.n) { return false }
	first = at + 1
	while first < p.n and is_blank(p.code[first]) { first = first + 1 }
	if is_at(p.code, first, '}', p.n) { return true }
	end = name_end(p.code, first, p.n)
	if end == first { return false }
	after_name = blank_end(p, end)
	c = peek(p.code, after_name, p.n)
	following = peek(p.code, after_name + 1, p.n)
	(c == ':' and following != '=') or (assignments and c == '=' and following != '=')
}

// `wasm f64.floor`: a function body that is one wasm instruction (decision wasm-instruction-body), ø when no
// `type.operation` follows
// Rust twin: atoms.rs wasm_instruction_after
def wasm_instruction_after(p: Parser): Node := {
	if not is_at(p.code, p.at, ' ', p.n) { return ø }
	type_end = name_end(p.code, p.at + 1, p.n)
	if type_end == p.at + 1 or not is_at(p.code, type_end, '.', p.n) { return ø }
	end = name_end(p.code, type_end + 1, p.n)
	if end == type_end + 1 { return ø }
	name = p.code[p.at + 1 .. end]
	p.at = end
	if name not in wasm_instructions and name not in memory_instructions { return error_node("wasm " + name + " is no instruction warp takes: the ones on i64 and f64 and the memory's, e.g. wasm f64.sqrt, wasm f64.load") }
	call_of([symbol("wasm_instruction"), name])
}

// A case of an enum, no constant: `Node.True`, `Node::Empty`, `None` in `enum Bracket { Round, None }`
// Rust twin: atoms.rs check_constants (at_member_name, at_scoped_name, in_enum_cases)
// `{empty: yes}`, `Kind = {Empty: 0}`, `class Cell{empty: bool}`: a word naming ø with a `:` glued to it is a name,
// not with the definition `:=` nor the scope `::`
// Rust twin: variables.rs names_field
def names_key(p: Parser): bool := peek(p.code, p.at, p.n) == ':' and not "=:".contains(peek(p.code, p.at + 1, p.n))

def names_case(p: Parser, length: int): bool {
	start = p.at - length
	if p.enum_cases or (start > 0 and p.code[start - 1] == '.') { return true }
	if not (start > 1 and p.code[start - 2 .. start] == "::") { return false }
	scope = start - 2
	while scope > 0 and is_name_char(p.code[scope - 1]) { scope = scope - 1 }
	scope < start - 2 and p.code[scope].upper() == p.code[scope] and p.code[scope].lower() != p.code[scope]
}

// The items of a `{…}` group, the parser after its `{`; after `enum Name` they are the enum's cases
// Rust twin: types/declarations.rs enum_name_and_cases
def braced_items(p: Parser): Node := {
	outer = p.enum_cases
	p.enum_cases = outer or enum_body_at(p)
	block = items_until(p, Bracket.Curly, ItemsEnd.Closer)
	p.enum_cases = outer
	block
}

// The `{` just read follows `enum Name`
def enum_body_at(p: Parser): bool {
	end = p.at - 1
	while end > 0 and is_blank(p.code[end - 1]) { end = end - 1 }
	start = end
	while start > 0 and is_name_char(p.code[start - 1]) { start = start - 1 }
	if start == end { return false }
	keyword_end = start
	while keyword_end > 0 and is_blank(p.code[keyword_end - 1]) { keyword_end = keyword_end - 1 }
	keyword_end >= 4 and p.code[keyword_end - 4 .. keyword_end] == "enum" and (keyword_end == 4 or not is_name_char(p.code[keyword_end - 5]))
}

// `function add`, `func add`: the function add itself, where the expression ends after the name (or `on`, `is`
// follows: `map function square on xs`); `function add(x) {…}` defines it
// `function f`, `func f`: the function f as a value, marked as Rust's parser marks it (closures.rs
// FUNCTION_REFERENCE_MARK), so the closure pass makes it a closure, a nested one too
// Rust twin: definitions/functions.rs function_reference_after
FUNCTION_REFERENCE_MARK = "function_reference"
def function_reference(p: Parser): Node := {
	at = blank_end(p, p.at)
	if at == p.at or at >= p.n or not is_alpha(p.code[at]) { return ø }
	end = name_end(p.code, at, p.n)
	rest = blank_end(p, end)
	next_word = p.code[rest .. name_end(p.code, rest, p.n)]
	if not (rest >= p.n or ";,)]}\n".contains(p.code[rest]) or next_word == "on" or next_word == "is") { return ø }
	p.at = end
	attributed(FUNCTION_REFERENCE_MARK, true, symbol(p.code[at .. end]))
}

// The items of an argument list: none for ø, the list's items, else the one argument; Swift's labeled parameter
// `greet(person name: String)` stays one argument
// Rust twin: atoms.rs function_call, is_labeled_parameter
def spread(arguments: Node): list {
	if arguments == ø { return [] }
	parts = group_parts(arguments)
	if parts != ø and not labeled_parameter(parts) { return parts#3 }
	[arguments]
}

// Every argument of `f(int x, float y)` as its typed parameter
// Rust twin: definitions/functions.rs typed_parameters
def typed_parameters(arguments: Node): Node := {
	parts = group_parts(arguments)
	if parts == ø or parts#2 != "," or #parts#3 == 0 { return typed_parameter(arguments) }
	listed(parts#1 as Bracket, Separator.Comma, [typed_parameter(argument) for argument in parts#3])
}

// `f(int x)`, Go's `f(x int)`, `f(s Shape)` and `f(x of int)` as the typed parameter x:int; `f(vararg xs)`,
// `f(params int[] xs)` the rest parameter *xs; `f(int b = 2)` as b:int = 2; any other argument as it is
// Rust twin: definitions/functions.rs typed_parameter
def typed_parameter(argument: Node): Node := {
	parts = group_parts(argument)
	if parts != ø and parts#1 == "(" and #parts#3 == 1 and is_optional_name(parts#3#1) { return listed(Bracket.Round, parts#2 as Separator, [optional_parameter(parts#3#1)]) }
	if is_optional_name(argument) { return optional_parameter(argument) }
	if parts == ø or parts#2 != " " or parts#1 == "[" or #parts#3 == 0 { return argument }
	words = parts#3
	first = words#1
	last = words#(words.length)
	if words.length == 2 and is_type_symbol(first) and is_symbol(last) { return Key(last, Op.Colon, first) }
	if words.length == 2 and is_symbol(first) and not is_type_symbol(first) and (is_type_symbol(last) or (is_symbol(last) and is_capitalized(name_of(last)))) {
		return Key(first, Op.Colon, last)
	}
	if words.length == 3 and words#2 == symbol("of") and is_type_symbol(last) and is_symbol(first) and not is_type_symbol(first) {
		return Key(first, Op.Colon, last)
	}
	if is_symbol(first) and REST_MARKERS.contains(name_of(first)) { return rest_parameter(last, argument) }
	if words.length == 2 and is_type_symbol(first) { return typed_default(last, first, argument) }
	argument
}

// `vararg xs`, `params int[] xs: list` as the rest parameter *xs
def rest_parameter(last: Node, argument: Node): Node := match last {
	Symbol(name): symbol("*" + name)
	Key(name, Op.Colon, kind): { if name is symbol then symbol("*" + name_of(name)) else argument }
	_: argument
}

// `f(x?)`: the optional parameter x, ø where a call leaves it out, as `f(x = ø)`. A parser case, not a rule: the parser
// reads `x?` as the one name `x?`, and no rule pattern takes a name apart (F5 glues names in templates only)
def optional_parameter(argument: Node): Node := if is_optional_name(argument) then Key(symbol(name_of(argument).remove_suffix("?")), Op.Assign, ø) else argument
def is_optional_name(argument: Node): bool := is_symbol(argument) and name_of(argument).length > 1 and name_of(argument).ends_with("?")

// `int b = 2` as b:int = 2
def typed_default(last: Node, kind: Node, argument: Node): Node := match last {
	Key(name, Op.Assign, value): { if name is symbol then Key(Key(name, Op.Colon, kind), Op.Assign, value) else argument }
	_: argument
}

// The rest-parameter markers: Kotlin's `vararg xs`, C#'s `params int[] xs`
// Rust twin: warp_parser/definitions/functions.rs REST_MARKERS
REST_MARKERS = ["vararg", "params"]

def is_type_symbol(node: Node): bool := is_symbol(node) and is_type_word(name_of(node))

// `person name: String`: a label, then the typed parameter, of a group's parts
def labeled_parameter(parts: list): bool := parts#2 == " " and #parts#3 == 2 and is_symbol(parts#3#1) and is_typed_name(parts#3#2)

def is_typed_name(node: Node): bool := match node {
	Key(name, Op.Colon, kind): name is symbol
	_: no
}

// The words before a declared name that only say how it is declared: `global mutable x`, `export const y`; a type
// word types it, `global int n = 0` is `n:int = 0`
// Rust twin: mod.rs DECLARATION_MODIFIERS, words.rs CONSTANT_KEYWORDS, analyzer type_word_kind
DECLARATION_MODIFIERS = ["export", "mutable", "mut", "const", "constant", "final", "val"]
// the type words of words.warp, as Rust reads them (`global long k = 7`)
DECLARED_TYPE_WORDS = type_words

// `global x = 1`, `global n`, `export api: clock` as `global: x = 1`, a module-level variable; `global a, b` declares
// each; `export` without a name after it stays a word
// Rust twin: definitions/variables.rs try_parse_global_declaration, skip_declaration_modifiers, typed_global
def global_declaration(p: Parser, keyword: text): Node := {
	at = blank_end(p, p.at + keyword.length)
	if at == p.at + keyword.length or not is_name_start(peek(p.code, at, p.n)) { return ø }
	p.at = at
	type_word = ø
	while true {
		end = name_end(p.code, p.at, p.n)
		word = p.code[p.at .. end]
		after = blank_end(p, end)
		if not (DECLARATION_MODIFIERS contains word or DECLARED_TYPE_WORDS contains word) or not is_name_start(peek(p.code, after, p.n)) { break }
		if DECLARED_TYPE_WORDS contains word { type_word = word }
		p.at = after
	}
	declaration = expression(p, 0)
	if type_word != ø { declaration = typed_default(declaration, symbol(type_word), declaration) }
	names = [declaration]
	while keyword == "global" and is_symbol(names#(names.length)) and is_at(p.code, p.at, ',', p.n) {
		p.at = p.at + 1
		skip_spaces(p)
		names = names + [atom(p)]
	}
	declared = [Key(GLOBAL, Op.Colon, name) for name in names]
	if declared.length == 1 { return declared#1 }
	listed(Bracket.None, Separator.Semicolon, declared)
}

// The statements an item stands for in its block: `global a, b` is the declarations `global: a` and `global: b`
// Rust twin: definitions/variables.rs declarations_of_several_globals
def statements_of(item: Node): list {
	parts = group_parts(item)
	if parts == ø or parts#1 != "" or parts#2 != ";" or #parts#3 == 0 { return [item] }
	for declaration in parts#3 {
		if not declares_global(declaration) { return [item] }
	}
	parts#3
}

GLOBAL = symbol("global")

def declares_global(node: Node): bool := match node {
	Key(word, Op.Colon, name): word == GLOBAL
	_: no
}

// What follows the name of a lowercase `type`: `type point {…}`, `type size = u32`, `type pair<T>`
TYPE_BODY_STARTS = "{=:<"
// `class V { x: int }`, `struct P {…}`, `type Point {…}` as ["type", name, body], else ø with nothing read
// Rust twin: mod.rs TYPE_DECLARATION_WORDS, types/declarations.rs declares_type
def type_declaration(p: Parser, word: text): Node := {
	if (p.at > 0 and p.code[p.at - 1] == '.') or not declares_type(p, word) { return ø }
	outer = p.type_body
	p.type_body = true
	declaration = declared_type(p, word)
	p.type_body = outer
	declaration
}

// `class:"btn"`, `type = "text"` are keys and `type(x)`, `type 3.5` the type of a value: a declaration names its type,
// after `type` a capital name or a name with its body
// Rust twin: types/declarations.rs declares_type, type_declaration_follows
def declares_type(p: Parser, word: text): bool {
	at = blank_end(p, p.at + word.length)
	c = peek(p.code, at, p.n)
	if (c == ':' or c == '=') and peek(p.code, at + 1, p.n) != '=' { return false }
	if word != "type" { return true }
	if not is_name_start(c) { return false }
	end = symbol_end(p.code, at, p.n)
	after = blank_end(p, end)
	body_follows = TYPE_BODY_STARTS.contains(peek(p.code, after, p.n)) and peek(p.code, after + 1, p.n) != '='
	c.upper() == c or body_follows or p.code[at .. end] == "of"
}

// After the spaces, tabs and inline block comments from `from` on: `1 /* inline */ + 1`
// Rust twin: comments.rs skip_spaces_and_inline_comments
def blank_end(p: Parser, from: int): int {
	at = from
	while true {
		at = spaces_end(p, at)
		following = peek(p.code, at + 1, p.n)
		if not is_at(p.code, at, '/', p.n) or not (following == '*' or following == '#') { return at }
		at = block_comment_end(p.code, at, following, p.n)
	}
}

// The name and `{fields}` of a type declaration; `class Dog extends Animal` carries its parent on the name, a bare
// `class Marker` is marked and gets an empty body
// Rust twin: types/declarations.rs parse_class_declaration, parse_type_declaration_body
def declared_type(p: Parser, word: text): Node := {
	p.at = p.at + word.length
	skip_blanks(p)
	word_end = symbol_end(p.code, p.at, p.n)
	joined = joined_type_name(p, p.code[p.at .. word_end], word_end)
	end = joined#2
	name = symbol(joined#1)
	// `mixin Name {…}`: the type its classes take the methods of (foreign_forms.warp)
	if word == "mixin" { name = attributed("mixin", true, name) }
	p.at = end
	parameters = type_parameters(p)
	ends_statement = ";}\n".contains(peek(p.code, blank_end(p, p.at), p.n))
	skip_blanks(p)
	if keyword_at(p, "extends") {
		p.at = p.at + 7
		skip_blanks(p)
		end = symbol_end(p.code, p.at, p.n)
		name = attributed("extends", symbol(p.code[p.at .. end]), name)
		p.at = end
		skip_blanks(p)
	}
	// `class ParseError: Error` ending its line: the parent (Rust twin: skip_conformances)
	if is_at(p.code, p.at, ':', p.n) {
		parent_at = blank_end(p, p.at + 1)
		parent_end = symbol_end(p.code, parent_at, p.n)
		initial = peek(p.code, parent_at, p.n)
		if parent_end > parent_at and initial.upper() == initial and initial.lower() != initial and ";\n".contains(peek(p.code, blank_end(p, parent_end), p.n)) {
			p.at = parent_end
			return declared_type_node(attributed("extends", symbol(p.code[parent_at .. parent_end]), name), listed(Bracket.Curly, Separator.None, []))
		}
	}
	start = variants_start(p)
	if start >= 0 { return sum_type(p, name, start, parameters) }
	// `type Box[T]: { item: T }`
	if is_at(p.code, p.at, ':', p.n) and peek(p.code, blank_end(p, p.at + 1), p.n) == '{' { p.at = blank_end(p, p.at + 1) }
	if is_at(p.code, p.at, '{', p.n) {
		p.at = p.at + 1
		body = items_until(p, Bracket.Curly, ItemsEnd.Closer)
		fields = group_parts(body)
		if fields != ø and fields#1 == "{" { body = listed(Bracket.Curly, fields#2 as Separator, fields#3.map(field => untyped(field, parameters))) }
		return declared_type_node(name, body)
	}
	if not ends_statement { return type_node(name, ø) }
	if word == "class" { name = attributed("bare_class", true, name) }
	declared_type_node(name, listed(Bracket.Curly, Separator.None, []))
}

// A type declaration, its fields typed
// Rust twin: types/declarations.rs transform_fields_to_types
def declared_type_node(name: Node, body: Node): Node := type_node(name, typed_fields(body))

// `= Some(T) | None`, `: red | rgb(int, int, int)`, Elm's `= Failure HttpError | …` on lines of their own: the position
// after the `=` or `:` when the declaration lists alternatives one of which carries a payload, else -1
// Rust twin: types/declarations.rs variants_ahead
def variants_start(p: Parser): int {
	at = space_end(p.code, p.at, p.n)
	sign = peek(p.code, at, p.n)
	next = peek(p.code, at + 1, p.n)
	if not ((sign == '=' and next != '=' and next != '>') or (sign == ':' and next != '=')) { return -1 }
	start = at + 1
	depth = 0
	alternatives = false
	payload = false
	words = 0
	at = start
	while at < p.n {
		c = p.code[at]
		after_word = is_name_char(p.code[at - 1])
		if depth == 0 and ";)]}".contains(c) { break }
		if depth == 0 and c == '\n' and peek(p.code, space_end(p.code, at + 1, p.n), p.n) != '|' { break }
		if c == '(' and depth == 0 and after_word { payload = true }
		if "([{".contains(c) {
			depth = depth + 1
		} else if ")]}".contains(c) {
			depth = depth - 1
		} else if c == '|' and depth == 0 and peek(p.code, at + 1, p.n) == '|' {
			at = at + 1
		} else if c == '|' and depth == 0 {
			alternatives = true
			words = 0
		} else if depth == 0 and is_name_char(c) and not after_word {
			words = words + 1
			payload = payload or words > 1
		}
		at = at + 1
	}
	if alternatives and payload then start else -1
}

// `Box[T]`, `Pair<A, B>`: the names of a declared type's parameters, read
// Rust twin: types/declarations.rs parse_type_parameters
def type_parameters(p: Parser): list {
	names = []
	if not (is_at(p.code, p.at, '[', p.n) or is_at(p.code, p.at, '<', p.n)) { return names }
	closer = if p.code[p.at] == '[' then ']' else '>'
	p.at = p.at + 1
	while true {
		p.at = space_end(p.code, p.at, p.n)
		end = symbol_end(p.code, p.at, p.n)
		if end == p.at { break }
		names += [p.code[p.at .. end]]
		p.at = space_end(p.code, end, p.n)
		if is_at(p.code, p.at, ',', p.n) { p.at = p.at + 1 }
	}
	if is_at(p.code, p.at, closer, p.n) { p.at = p.at + 1 }
	names
}

// A field of a type parameter holds any value: `item: T` of `Box[T]` is `item: any`
// Rust twin: types/declarations.rs any_for_type_parameters
def untyped(field: Node, parameters: list): Node := match field {
	Key(name, Op.Colon, kind): { if kind is symbol and parameters.contains(name_of(kind)) then Key(name, Op.Colon, symbol("any")) else field }
	_: field
}

def space_end(code: text, from: int, n: int): int {
	at = from
	while at < n and " \t\r\n".contains(code[at]) { at = at + 1 }
	at
}

// The sum type `Name = A(T) | B | C(x: int)` (card sum-types): the type without fields, its variants without payload
// by name, then a class extending it for each variant with a payload
// Rust twin: types/declarations.rs parse_sum_type, sum_variants.rs sum_type
def sum_type(p: Parser, name: Node, start: int, parameters: list): Node := {
	p.at = start
	bare = []
	classes = []
	while true {
		p.at = space_end(p.code, p.at, p.n)
		end = symbol_end(p.code, p.at, p.n)
		if end == p.at { raise "a variant of " + view_of(name)#2 + " needs a name" }
		variant = p.code[p.at .. end]
		p.at = end
		payload = []
		if is_at(p.code, p.at, '(', p.n) {
			p.at = p.at + 1
			group = items_until(p, Bracket.Round, ItemsEnd.Closer)
			payload = if is_list_of(group, "(") then group_parts(group)#3 else [group]
		}
		// Elm's `Failure HttpError`: the payload's types after the name
		skip_spaces(p)
		while is_name_start(peek(p.code, p.at, p.n)) {
			end = symbol_end(p.code, p.at, p.n)
			payload += [symbol(p.code[p.at .. end])]
			p.at = end
			skip_spaces(p)
		}
		if payload.length == 0 { bare += [symbol(variant)] } else { classes += [variant_class(name, variant, payload, parameters)] }
		after = space_end(p.code, p.at, p.n)
		if peek(p.code, after, p.n) != '|' { break }
		p.at = after + 1
	}
	sum_type_of(name, bare, classes)
}

// The sum type of its bare variants by name, then the classes of the variants with a payload
// Rust twin: sum_variants.rs sum_type
def sum_type_of(name: Node, bare: list, classes: list): Node := listed(Bracket.None, Separator.Semicolon, [declared_type_node(attributed("variants", spaced(bare), name), listed(Bracket.Curly, Separator.None, []))] + classes)

// `enum Shape { Circle(r), Rect(w, h), Dot }` follows `enum`: its braced cases, one with values
// Rust twin: types/declarations.rs enum_body_ahead
def enum_values_ahead(p: Parser): bool {
	at = name_end(p.code, blank_end(p, p.at), p.n)
	if at == blank_end(p, p.at) { return false }
	at = space_end(p.code, at, p.n)
	if not is_at(p.code, at, '{', p.n) { return false }
	depth = 0
	while at < p.n {
		c = p.code[at]
		if c == '(' and depth == 1 and is_name_char(p.code[at - 1]) { return true }
		if "([{".contains(c) {
			depth = depth + 1
		} else if ")]}".contains(c) {
			if depth == 1 { return false }
			depth = depth - 1
		}
		at = at + 1
	}
	false
}

// `enum Shape { Circle(r), Rect(w, h), Dot }`, Swift's `case circle(radius: Double)` lines: each case with values a
// class extending Shape, the others its variants by name, as the sum type `Circle(r) | Rect(w, h) | Dot`
// Rust twin: types/declarations.rs parse_enum_with_values
def enum_with_values(p: Parser): Node := {
	p.at = blank_end(p, p.at)
	end = name_end(p.code, p.at, p.n)
	name = symbol(p.code[p.at .. end])
	p.at = space_end(p.code, end, p.n) + 1
	cases = braced_items(p)
	bare = []
	classes = []
	for case in case_rows(cases).map(without_case_word) {
		parts = group_parts(case)
		if parts != ø and #parts#3 > 0 and is_symbol(parts#3#1) {
			classes += [variant_class(name, name_of(parts#3#1), parts#3[1:], [])]
		} else if is_symbol(case) {
			bare += [case]
		} else {
			raise "a case of enum " + name_of(name) + " is a name with optional values"
		}
	}
	sum_type_of(name, bare, classes)
}

// The cases of an enum body, a line of several cases `Add, Sub, Mul` among lines of cases each a case
// Rust twin: sum_variants.rs case_rows
def case_rows(cases: Node): list {
	rows = []
	for case in group_parts(cases)#3 {
		row = group_parts(case)
		if row != ø and row#1 == "" and row#2 == "," { rows += row#3 } else { rows += [case] }
	}
	rows
}

// Swift's `case circle(radius: Double)` as `circle(radius: Double)`
// Rust twin: types/declarations.rs without_case_keyword
def without_case_word(case: Node): Node := {
	words = group_parts(case)
	if words != ø and words#1 == "" and #words#3 == 2 and words#3#1 == symbol("case") then words#3#2 else case
}

// The words of the built-in types a variant's payload names: `rgb(int, int, int)` gives types, `rgb(r, g, b)` fields
// Rust twin: analyzer builtin_type_kind
BUILTIN_TYPE_WORDS = DECLARED_TYPE_WORDS + ["list", "map", "any", "real", "rational", "exact", "long", "double", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64"]

// A variant with a payload: the class extending the sum type, its fields in order (an unnamed one is `value`, several
// `value1`, `value2`…, a lowercase name that is no type a field of any value)
// Rust twin: types/declarations.rs variant_class
def variant_class(type_name: Node, variant: text, payload: list, parameters: list): Node := {
	fields = []
	position = 0
	for field in payload {
		position = position + 1
		// `(T)` and `(radius: int)` arrive as groups of one
		if is_list_of(field, "(") and #group_parts(field)#3 == 1 { field = group_parts(field)#3#1 }
		if is_typed_field(field) {
			fields += [field]
		} else if is_symbol(field) and name_of(field)#1.lower() == name_of(field)#1 and not BUILTIN_TYPE_WORDS.contains(name_of(field)) {
			fields += [Key(field, Op.Colon, symbol("any"))]
		} else {
			field_name = if payload.length == 1 then "value" else "value" + position
			fields += [Key(symbol(field_name), Op.Colon, field)]
		}
	}
	declared_type_node(attributed("extends", type_name, symbol(variant)), listed(Bracket.Curly, Separator.Semicolon, fields.map(field => untyped(field, parameters))))
}

def is_typed_field(node: Node): bool := match node {
	Key(name, Op.Colon, kind): yes
	_: no
}

// The digits of a number in `base` (`_` between digits), read
// Rust twin: literals.rs read_number_value, its 0x and 0b branches
def radix_value(p: Parser, base: int): int {
	value = 0
	while p.at < p.n {
		c = p.code[p.at]
		separates = c == '_' and (base == 2 or digit_value(peek(p.code, p.at + 1, p.n)) < base)
		if not separates {
			digit = digit_value(c)
			if digit >= base { return value }
			value = value * base + digit
		}
		p.at = p.at + 1
	}
	value
}

// The value of a hex digit, 16 for any other character
def digit_value(c: text): int {
	small = "0123456789abcdef"
	capital = "0123456789ABCDEF"
	i = 0
	while i < 16 and small[i] != c and capital[i] != c { i = i + 1 }
	i
}

// A decimal number as written, read: digits (`_` between them dropped), a fraction unless `..` or a name follows the
// point, an exponent
// Rust twin: literals.rs push_digits, read_number_value, parse_exponent
def decimal_number(p: Parser): text {
	written = digits_read(p)
	after_point = peek(p.code, p.at + 1, p.n)
	if is_at(p.code, p.at, '.', p.n) and after_point != '.' and not is_name_start(after_point) {
		p.at = p.at + 1
		written = written + "." + digits_read(p)
	}
	e = peek(p.code, p.at, p.n)
	sign = peek(p.code, p.at + 1, p.n)
	signed = (sign == '+' or sign == '-') and is_digit(peek(p.code, p.at + 2, p.n))
	if (e == 'e' or e == 'E') and (is_digit(sign) or signed) {
		p.at = p.at + 1
		if signed { p.at = p.at + 1 }
		exponent = digits_read(p)
		// 1e3 is the exact integer 1000, like the literal it abbreviates
		if written.contains(".") or sign == '-' { return written + "e" + (if sign == '-' then "-" else "") + exponent }
		zeros = int(exponent)
		while zeros > 0 {
			written = written + "0"
			zeros = zeros - 1
		}
	}
	written
}

def digits_read(p: Parser): text {
	// the runs of digits between `_` separators are copied whole and joined once
	parts = []
	copied = p.at
	while p.at < p.n {
		c = p.code[p.at]
		if c == '_' and p.at > 0 and is_digit(p.code[p.at - 1]) and is_digit(peek(p.code, p.at + 1, p.n)) {
			parts += [p.code[copied .. p.at]]
			copied = p.at + 1
		} else if not is_digit(c) {
			return join(parts + [p.code[copied .. p.at]], "")
		}
		p.at = p.at + 1
	}
	join(parts + [p.code[copied .. p.at]], "")
}

// A quote opening a text: `"…"`, `'…'`, `«…»` (lexer.warp closing_of closes each)
def opens_text(c: text): bool := c == '"' or c == '\'' or c == '«'

// A text in quotes, its backslash escapes read; one character is a codepoint. `«…»` holds quotes as they are:
// `«she said "hi"»`
// Rust twin: literals.rs read_text
def quoted(p: Parser): Node := {
	opening = code_points("$(p.code[p.at])")
	quote = opening#1
	marks = opening[1 .. opening.length].join("")
	end = text_end(p.code, p.at + 1, closing_of(quote), p.n)
	written = marks + p.code[p.at + 1 .. end - 1]
	p.at = end
	holed = if quote == '"' then template(written) else ø
	if holed != ø { return template_node(holed) }
	content = unescaped(written, quote == '"')
	if content.length == 1 then content#1 else content
}

// An interpolating text with a hole as its template: holes `\(x)` `\{x}` `$(x)` as `${x}`, escapes read, a literal
// dollar `$$` unless a name follows it (the bare `$name` of sql and sh templates); ø without a hole. An escaped
// dollar makes a template too: it is never a hole
// Rust twin: literals/text.rs read_text
def template(written: text) {
	// the plain runs are copied whole and the pieces joined once, only for a template: one `+` per character copied
	// the text each time, for every text literal
	parts = []
	copied = 0
	holed = no
	at = 0
	n = written.length
	while at < n {
		c = written[at]
		next = peek(written, at + 1, n)
		if (c == '\\' or c == '$') and (next == '(' or next == '{') {
			end = hole_end(written, at + 2, next, closing_of(next), n)
			parts += [written[copied .. at], "\${" + written[at + 2 .. end - 1] + "}"]
			holed = yes
			at = end
			copied = at
		} else if c == '\\' and at + 1 < n and next == ':' and at + 2 < n and is_alpha(written[at + 2]) {
			entity = entity_read(written, at, n)
			parts += [written[copied .. at], entity#1]
			at = at + entity#2
			copied = at
		} else if c == '\\' and code_escape(written, at, n) != ø {
			coded = code_escape(written, at, n)
			parts += [written[copied .. at], coded#1]
			at = at + coded#2
			copied = at
		} else if c == '\\' and at + 1 < n {
			literal = escape_character(next)
			holed = holed or literal == '$'
			parts += [written[copied .. at], if literal == '$' then "$$" else literal]
			at = at + 2
			copied = at
		} else if c == '$' {
			parts += [written[copied .. at], if is_alpha(next) or next == '_' then "$" else "$$"]
			at = at + 1
			copied = at
		} else {
			at = at + 1
		}
	}
	if holed then join(parts + [written[copied .. n]], "") else ø
}

// A text's escapes read: `\n` `\t` `\r` `\e` as their characters, `\"` `\\` and the like as the character itself;
// entities `\:alpha` stay as written in an interpolating text (holes went to template)
// Rust twin: literals/text.rs read_text
def unescaped(content: text, interpolates: bool): text {
	if not content.contains("\\") { return content }
	// the plain runs are copied whole and the pieces joined once: one `+` per character copied the text each time
	parts = []
	copied = 0
	at = 0
	while at < content.length {
		c = content[at]
		escaped = if at + 1 < content.length then content[at + 1] else ' '
		if c != '\\' or at + 1 >= content.length {
			at = at + 1
		} else if interpolates and escaped == ':' and at + 2 < content.length and is_alpha(content[at + 2]) {
			entity = entity_read(content, at, content.length)
			parts += [content[copied .. at], entity#1]
			at = at + entity#2
			copied = at
		} else if code_escape(content, at, content.length) != ø {
			coded = code_escape(content, at, content.length)
			parts += [content[copied .. at], coded#1]
			at = at + coded#2
			copied = at
		} else {
			parts += [content[copied .. at], escape_character(escaped)]
			at = at + 2
			copied = at
		}
	}
	join(parts + [content[copied .. content.length]], "")
}

// `\x41`, `\u{1b}` at the backslash `at`: [the character, the length read], else ø
// Rust twin: literals/text.rs hex_byte_escape, unicode_escape
def code_escape(written: text, at: int, n: int): list? := {
	kind = peek(written, at + 1, n)
	if kind == 'x' and is_hex_digit(peek(written, at + 2, n)) and is_hex_digit(peek(written, at + 3, n)) {
		return [hex_value(written[at + 2 .. at + 4]) as codepoint, 4]
	}
	if kind == 'u' and peek(written, at + 2, n) == '{' {
		end = at + 3
		while end < n and is_hex_digit(written[end]) { end = end + 1 }
		if end > at + 3 and peek(written, end, n) == '}' { return [hex_value(written[at + 3 .. end]) as codepoint, end + 1 - at] }
	}
	ø
}

// The number the hex digits write
def hex_value(digits: text): int {
	value = 0
	for digit in digits { value = value * 16 + "0123456789abcdef".index_of(digit.lower()) - 1 }
	value
}

def escape_character(c: text): text {
	if c == 'n' { return '\n' }
	if c == 't' { return '\t' }
	if c == 'r' { return '\r' }
	if c == 'e' { return '\e' }
	c
}
