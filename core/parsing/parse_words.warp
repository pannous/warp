# `parse(text)` is the code the text holds, as data (card pure-parse-call; Rust twin: rust-harness:src/lowering/words/parse_word.rs):
# a constant text folds here into `as_code(data …)`, any other is parsed at run time by the host word parse_code.
# `eval(text)` runs that code where it is written: `interpret(parse(text))`. A program's own `parse` stays its own, and
# so does a method `x.parse(…)`.
use "../passes/walk.warp"
use "parser.warp"
use "../passes/uses.warp"

parse_word = "parse"
eval_word = "eval"
interpret_word = "interpret"
as_code_word = "as_code"
parse_code_word = "parse_code"

def called_word(word: text, arguments: list): Node := List([symbol(word)] + arguments, Bracket.Round, Separator.None)
# `data e`: e as written (Rust's blocks.rs as_data)
def quoted_code_of(code: Node): Node := List([symbol(quote_word), code], Bracket.None, Separator.Space)

# `parse "…"`, `parse(t)`, `parse t`: what the word is given, else ø
def word_argument(n: Node, word: text): Node := {
	if not (is_group(n) and #n == 2 and n#1 == symbol(word) and (bracket_of(n) == "(" or bracket_of(n) == "")) { return ø }
	given = n#2
	if is_group(given) and bracket_of(given) == "(" and #given == 1 { return given#1 }
	given
}

# a text that fails to parse fails at run time, where `try` catches it; a type declaration is built there too, as
# written, where a constant's `class P {…}` would read as the program's own type P
def folds(given: Node): bool := given is text and not view_has(view_of(plain_node(parsed(given))), part => kind_of(part) == "error" or kind_of(part) == "type")

def parse_call(n: Node): Node := {
	given = word_argument(n, parse_word)
	if given == ø { return n }
	if folds(given) { return called_word(as_code_word, [quoted_code_of(plain_node(parsed(given)))]) }
	called_word(as_code_word, [called_word(parse_code_word, [given])])
}

def eval_call(n: Node): Node := {
	given = word_argument(n, eval_word)
	if given == ø { return n }
	called_word(interpret_word, [called_word(parse_word, [given])])
}

# the words rewritten everywhere but on the right of `.` and inside a definition binding the word itself (notes/
# dispatch.md: shadowing is scoped): `f(t) := { parse = x => 7; parse(t) }` calls its own
def words_rewritten(n: Node, rewrite: function, words: list): Node := {
	if is_key(n, Op.Dot) { return Key(words_rewritten(key_of(n), rewrite, words), Op.Dot, value_of(n)) }
	if is_key(n, Op.Define) and words.any(word => binds_word(n, word)) { return n }
	rewrite(children(n, child => words_rewritten(child, rewrite, words)))
}

# does the definition bind the word: a parameter of that name, or a definition of it in its body
def binds_word(definition: Node, word: text): bool := {
	head = key_of(definition)
	if is_group(head) and items_of(head).any(part => part == symbol(word)) { return yes }
	body = value_of(definition)
	statements = if is_curly_group(body) then items_of(body) else [body]
	statements.any(statement => declared_name(statement) == word)
}

def parse_words(program: Node): Node := {
	words = [parse_word, eval_word]
	# the program's own `parse(t) := …`, `parse = …`
	if statements_in(program).any(statement => declared_name(statement) in words) { return program }
	words_rewritten(program, n => parse_call(eval_call(n)), words)
}

# `warp.wasm parse-code <code> <file>`: the code's tree as the native warp's parse_code rebuilds it in the module through
# its builders (core/native/driver.warp code_built), a node before its parts: a tag, its fields each ended by
# FIELD_END. `e` nothing, `T`/`F` yes/no, `i`/`f` a number, `c` a character's code, `t`/`s` a text, a symbol, `k` a key's
# operator (its two sides after it), `l` a list's count, bracket and separator (its items after it), `x` the message of
# code that does not parse; any other node as its text
FIELD_END = "${chr(1)}"
def write_parse_code(code: text, file: text) := write(file, code_encoding(plain_node(parsed(code))))
def code_encoding(n: Node): text := {
	if n is bool { return if n then "T" else "F" }
	if n is int { return encoded_field("i", "${n}") }
	if n is number { return encoded_field("f", "${float(n)}") }
	if n === ø { return "e" }
	# `[]` and `{}`, opaque keys of their view (plain_node)
	if n is key and key_of(n) == opaque_symbol and is_empty_group(value_of(n)) { return list_encoding([], "${value_of(n)#2}", "${value_of(n)#3}") }
	view = view_of(n)
	if kind_of(view) == "error" { return encoded_field("x", view#2#2) }
	match n {
		Symbol(name): encoded_field("s", name)
		Text(t): encoded_field("t", t)
		Char(c): encoded_field("c", "${ord(c)}")
		Key(left, op, right): encoded_field("k", op as text) + code_encoding(left) + code_encoding(right)
		List(items, bracket, separator): list_encoding(items, bracket as text, separator as text)
		_: encoded_field("t", "${n}")
	}
}
def list_encoding(items: list, bracket: text, separator: text): text := {
	count = #items
	encoded_field("l", "${count}") + encoded_field("", bracket) + encoded_field("", separator) + items.map(code_encoding).join("")
}
def encoded_field(tag: text, field: text): text := {
	if FIELD_END in field { raise "parse_code: the code holds the character U+0001, which its encoding ends fields with" }
	tag + field + FIELD_END
}
