# A block written on one line, `{print "big"}` (card pure-runs): the parser keeps its words side by side as the group's
# items; they are one phrase, so the block becomes a block of that one statement. A map's entries, `{a: 1 b: 2}`,
# start with a key, never with a name, and stay as they are.
use "../passes/walk.warp"

def is_name(n: Node): bool := match n {
	Symbol(name): yes
	_: no
}

def phrase_block(n: Node): Node := match n {
	List(items, Bracket.Curly, Separator.Space): {
		if #items > 1 and is_name(items#1) then List([List(items, Bracket.None, Separator.Space)], Bracket.Curly, Separator.Semicolon) else n
	}
	_: n
}

def phrase_blocks(program: Node): Node := bottom_up(program, phrase_block)

# a block given as an argument, `{n += 1}`: braces of statements, not a map's entries
def is_block_argument(n: Node): bool := is_curly_group(n) and not (#n > 0 and items_of(n).all(item => is_key(item, Op.Colon)))
# `twice{n += 1}`, a name glued to its block, which the parser reads as the tagged block `twice: {…}`: the call
# `twice({n += 1})` where `takes(name)` says the name takes a block, else n
def glued_block_call(n: Node, takes: function): Node := match n {
	Key(name, Op.Colon, block): { if name is symbol and takes(name_of(name)) and is_block_argument(block) then List([name, block], Bracket.Round, Separator.None) else n }
	_: n
}
