// Positions in a source text, as the lexer counts them (card self-differential)
// DONE code_points(line) These are probably calculated elsewhere too and can be optimized? (card code-points-once)
// (line_widths is gone; each caller takes a source's code points once, the parser a single grapheme's)

// every source file a compile parses, by the index its positions carry (core/runtime/fields.warp node_file): 0 the
// program's own, whose name the compile knows (card positions-always)
global source_files = [""]
// a node's line holds its file: file * LINE_SPAN + line (core/runtime/fields.warp line_span, the same number)
LINE_SPAN = 1048576
def file_line(file: int, line: int): int := file * LINE_SPAN + line
// the line and the file's index of a line a node holds (line_of)
def line_within(held: int): int := held % LINE_SPAN
def file_within(held: int): int := held ÷ LINE_SPAN
// the index of a source file, its first parse registering it
def file_index(path: text): int {
	for i in 0 ..< #source_files { if source_files[i] == path { return i } }
	source_files += [path]
	#source_files - 1
}

// The code points of a text as a list
def code_points(text: text): list := [point for point in text.codepoints]

// `line:column` of the character at `at`, both from 1
def line_and_column(code: text, at: int): text {
	line = 1
	start = 0
	for i in 0 ..< at {
		if code[i] == '\n' {
			line += 1
			start = i + 1
		}
	}
	"$(line):$(at - start + 1)"
}
// a group, text or comment opened at `opener` that `closer` never closes (card missing-quotes-error)
def missing(closer: text, what: text, code: text, opener: int): text := "`" + closer + "` is missing: the " + what + " opened at " + line_and_column(code, opener) + " runs to the end of the input"
