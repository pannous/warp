# Interpolated text (card sugar-twins): the parser keeps `"a \(x) b"` as its
# template ["template", "a ${x} b"] (holes `${expr}`, a literal dollar `$$`); here it becomes text building,
# `"a " + text_form(x) + " b"`, so every later pass reads the holes as code. The first pass: a template inside a type
# or an error, which stay opaque views, is rewritten there too; first the extensions' text passes run (sql and sh
# templates become their typed values, extensions/typed_templates.warp).
use "../passes/walk.warp"
use "parser.warp"

text_form_word = "text_form"
# the code of a hole as a node
# (its parse as a node, as the program's own: through the view an empty part, the count's left of `#xs`, came back as [])
code_node(code: text): Node := plain_node(parsed(code))
# the hole's code: parsed as a program of its own, its templates built too
hole(code: text): any := call_of(text_form_word, [interpolated_node(code_node(code))])

# the literal pieces and holes of a template, in order; an empty literal is none
pieces(template: text): list := template_pieces(template).map(piece => if piece is list then hole(piece#1) else piece)

# the template as the sum of its pieces
built(template: text): any := {
	parts = pieces(template)
	if #parts == 0 { return "" }
	sum = parts#1
	for part in parts[1..] { sum = Key(sum, Op.Add, part) }
	sum
}

# a view with each template in it built: the inside of an opaque type or error
in_view(view: View): View := {
	if kind_of(view) == template_kind { return view_of(built(view#2)) }
	# a missing value (ø, `size = ø`) stays missing: mapped as an empty list it would become []
	if view is list and view is not ø { return view.map(in_view) }
	view
}

template_built(n: Node): Node := match n {
	Key(opaque, op, view): {
		if opaque != opaque_symbol then n
		else if kind_of(view) == template_kind then built(view#2)
		else Key(opaque, Op.Colon, in_view(view))
	}
	_: n
}

interpolated_node(n: Node): Node := bottom_up(n, template_built)

interpolation(program: Node): Node := interpolated_node(with_text_passes(program))
