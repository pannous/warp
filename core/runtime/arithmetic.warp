# `a + b`, `a += b` of values known only at run time, and nat arithmetic that grows past 64 bits
use "intrinsics.warp"
use "instructions.warp"
use "../analysis/kinds.warp"
use "conversions.warp"
use "bridge.warp"
use "lists.warp"
use "show.warp"
use "types.warp"
use "nodes.warp"
# `a + b` of values known only at run time: lists and texts join, numbers add, a marked number's mark kept
node_add(a: Node, b: Node): Node := marks_kept(node_sum(a, b), a, b)
node_sum(a: Node, b: Node): Node := {
	# ø, also `[]` in the lowered program, beside a list is a copy of that list (ø + ø the empty list), so a later
	# `+=` growing the sum in place leaves the list untouched; beside a text "ø"; beside a number it fails
	if is_null(a) and is_null(b) { return a }
	if is_null(a) and not is_null(b) and kind_code(b) == Kind.List { return list_join(unboxed_list(b), new_list(0)) }
	if not is_null(a) and kind_code(a) == Kind.List { return list_join(unboxed_list(a), appended_items(b)) }
	if textual_node(a) or textual_node(b) { return node_text(a) + node_text(b) }
	if is_null(a) or is_null(b) { fail() }
	# two plain ints add here; a ratio or a big int on either side goes to the extended runtime
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int and (is_plain_int(a) and is_plain_int(b)) { return grown_sum(unboxed_int(a), unboxed_int(b)) }
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int { return extended_sum(a, b) }
	float_of_node(a) + float_of_node(b)
}
# the result of arithmetic on boxed values keeps a marked operand's mark (decision marks-survive-arithmetic): the left
# one's, else the right one's, where it marks a number of the result's Kind; a type's mark lies above a yes/no's,
# which never carries
marks_kept(result: Node, a: Node, b: Node): Node := {
	mark = type_mark(a)
	if mark == 0 or mark % KindUnit.Info != kind_code(result) { mark = type_mark(b) }
	kept_mark(result, mark)
}
# the value's type mark (its marked kind), 0 for none: a type's mark lies above a yes/no's, which never carries
type_mark(x: Node): int := if is_null(x) or code_bit(x) != 0 or info_byte(x) * KindUnit.Info + Kind.Int <= Marked.Bool then 0 else marked_kind(x)
# the result marked so where the mark is of its Kind and it is a plain number, never a ratio or a big int
kept_mark(result: Node, mark: int): Node := if mark == 0 or is_null(result) or mark % KindUnit.Info != kind_code(result) or not (kind_code(result) == Kind.Float or is_plain_int(result)) then result else with_kind(result, mark)
# a + b, a - b, a * b of two plain ints held boxed (nats): past 64 bits the big int they make (D16, the extended runtime's exact words)
grown_sum(a: int, b: int): Node := if sum_overflows(a, b) then extended_sum(a, b) else a + b
grown_difference(a: int, b: int): Node := if difference_overflows(a, b) then extended_difference(a, b) else a - b
grown_product(a: int, b: int): Node := if product_overflows(a, b) then extended_product(a, b) else a * b
sum_overflows(a: int, b: int): bool := {
	added = a + b
	(b > 0 and added < a) or (b < 0 and added > a)
}
difference_overflows(a: int, b: int): bool := {
	difference = a - b
	(b > 0 and difference > a) or (b < 0 and difference < a)
}
# 2^63 bounds the product; one rounded to it from just below counts as past it too, loud rather than wrong
product_overflows(a: int, b: int): bool := {
	estimate = float(a) * float(b)
	bound = float(4611686018427387904) + float(4611686018427387904)
	estimate >= bound or estimate < 0 - bound
}
# what a list takes of b in `xs + b`, `xs += b`: a list its items, ø none, any other value one item: `[] + 3` is [3],
# `[1] + "a"` [1 'a']
appended_items(b: Node): list := {
	if is_null(b) { return new_list(0) }
	if kind_code(b) == Kind.List { return unboxed_list(b) }
	[b]
}
# `a += b` beside a class's `+` (control_flow.warp appended): b's items appended to a list a in place, yes; no for
# any other a, which the class's `+` then adds to
appends_in_place(a: Node, b: Node): bool := {
	if is_null(a) or kind_code(a) != Kind.List { return no }
	list_append(unboxed_list(a), appended_items(b))
	yes
}
# `a += b` of values known only at run time: a list grows in place as list_append, anything else is a + b
node_append(a: Node, b: Node) := {
	if not is_null(a) and not is_null(b) and kind_code(a) == Kind.List and kind_code(b) == Kind.List {
		return list_append(unboxed_list(a), unboxed_list(b))
	}
	node_add(a, b)
}
max_int(a: int, b: int): int := if a > b then a else b
least_int(): int := -9223372036854775807 - 1
min_int(a: int, b: int): int := if a < b then a else b
power(base: int, exponent: int): int := {
	out = 1
	for i in 0..exponent { out = out * base }
	out
}
# `a ÷ b` of values known only at run time, floored: two plain ints in i64, numbers with a float the float quotient's
# floor, a ratio or a big int (and the one quotient past 64 bits) by the extended runtime (card node-floor-quotient)
node_floor_quotient(a: Node, b: Node): Node := {
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int and is_plain_int(a) and is_plain_int(b) and not (unboxed_int(a) == least_int() and unboxed_int(b) == -1) { return floored_quotient(unboxed_int(a), unboxed_int(b)) }
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int { return extended_floor_quotient(a, b) }
	divisor = float_of_node(b)
	# a float divided by zero fails as an int's does
	if divisor == 0.0 { return divide_by_zero() }
	truncated(float_floor(float_of_node(a) / divisor))
}
# `floor x` of a value known only at run time: an int itself, a float's floor, a ratio's or a big int's by the extended
# runtime
node_floor(n: Node): Node := {
	if kind_code(n) != Kind.Int { return truncated(float_floor(unboxed_float(n))) }
	if is_plain_int(n) { return n }
	extended_floor(n)
}
# a ÷ b of ints rounded toward minus infinity: -7 ÷ 2 is -4, 7 ÷ -2 is -4
floored_quotient(a: int, b: int): int := {
	if b == 0 { divide_by_zero() }
	q = int_quotient(a, b)
	if q * b != a and (a < 0) != (b < 0) { q -= 1 }
	q
}
# `a /! b`: the Euclidean quotient that goes with `%`, a = q * b + r with 0 <= r < |b|: -7 /! 2 is -4
floor_quotient(a: int, b: int): int := {
	q = int_quotient(a, b)
	if a - q * b < 0 {
		if b > 0 { q -= 1 } else { q += 1 }
	}
	q
}
