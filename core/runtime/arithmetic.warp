# `a + b`, `a += b` of values known only at run time, and int arithmetic that traps past 64 bits
use "intrinsics.warp"
use "../analysis/kinds.warp"
use "conversions.warp"
use "bridge.warp"
use "lists.warp"
use "show.warp"
use "types.warp"
# `a + b` of values known only at run time: lists and texts join, numbers add
node_add(a: Node, b: Node): Node := {
	# ø, also `[]` in the lowered program, beside a list is a copy of that list (ø + ø the empty list), so a later
	# `+=` growing the sum in place leaves the list untouched; beside a text "ø"; beside a number Rust fails
	if is_null(a) and is_null(b) { return a }
	if is_null(a) and not is_null(b) and kind_code(b) == Kind.List { return list_join(unboxed_list(b), new_list(0)) }
	if not is_null(a) and kind_code(a) == Kind.List { return list_join(unboxed_list(a), appended_items(b)) }
	if textual_node(a) or textual_node(b) { return node_text(a) + node_text(b) }
	if is_null(a) or is_null(b) { fail() }
	# two plain ints add here; a ratio or a big int on either side goes to the extended runtime
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int and (is_plain_int(a) and is_plain_int(b)) { return grown_sum(unboxed_int(a), unboxed_int(b)) }
	if kind_code(a) == Kind.Int and kind_code(b) == Kind.Int { return extended_sum(a, b) }
	float_of_node(a) + float_of_node(b)
}
# a + b, a - b, a * b of ints held unboxed (an i64 local): past 64 bits they trap
checked_add(a: int, b: int): int := {
	if sum_overflows(a, b) { fail() }
	a + b
}
checked_subtract(a: int, b: int): int := {
	if difference_overflows(a, b) { fail() }
	a - b
}
checked_multiply(a: int, b: int): int := {
	if product_overflows(a, b) { fail() }
	a * b
}
# the same of two plain ints held boxed: past 64 bits the big int they make (D16, the extended runtime's exact words)
grown_sum(a: int, b: int): Node := if sum_overflows(a, b) then extended_sum(a, b) else a + b
grown_difference(a: int, b: int): Node := if difference_overflows(a, b) then extended_difference(a, b) else a - b
grown_product(a: int, b: int): Node := if product_overflows(a, b) then extended_product(a, b) else a * b
sum_overflows(a: int, b: int): bool := {
	added = a + b
	(b > 0 and added < a) or (b < 0 and added > a)
}
difference_overflows(a: int, b: int): bool := {
	difference = a - b
	(b > 0 and difference > a) or (b < 0 and difference < a)
}
# 2^63 bounds the product; one rounded to it from just below counts as past it too, loud rather than wrong
product_overflows(a: int, b: int): bool := {
	estimate = float(a) * float(b)
	bound = float(4611686018427387904) + float(4611686018427387904)
	estimate >= bound or estimate < 0 - bound
}
# a << n, a >> n of ints: wasm counts n modulo 64 (1 << 100 was 2^36), so a shift past the bits traps as the product
# a * 2^n would, and one right past them leaves the sign
checked_shift_left(a: int, n: int): int := {
	if n < 0 or n > 63 { fail() }
	shifted = a << n
	if shifted >> n != a { fail() }
	shifted
}
checked_shift_right(a: int, n: int): int := {
	if n < 0 { fail() }
	if n > 63 then (if a < 0 then -1 else 0) else a >> n
}
# what a list takes of b in `xs + b`, `xs += b`: a list its items, ø none, any other value one item: `[] + 3` is [3],
# `[1] + "a"` [1 'a']
appended_items(b: Node): list := {
	if is_null(b) { return new_list(0) }
	if kind_code(b) == Kind.List { return unboxed_list(b) }
	[b]
}
# `a += b` of values known only at run time: a list grows in place as list_append, anything else is a + b
node_append(a: Node, b: Node) := {
	if not is_null(a) and not is_null(b) and kind_code(a) == Kind.List and kind_code(b) == Kind.List {
		return list_append(unboxed_list(a), unboxed_list(b))
	}
	node_add(a, b)
}
max_int(a: int, b: int): int := if a > b then a else b
least_int(): int := -9223372036854775807 - 1
min_int(a: int, b: int): int := if a < b then a else b
