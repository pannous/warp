## WASI underneath files and the command line (card standalone): the runtime reads and writes files, its arguments
## and environment through wasi_snapshot_preview1 itself, so a module needs no host of warp's, plain wasmtime runs it.
## Files are found through the preopened folders: an absolute path in the one named by its longest prefix ("/" for
## `wasmtime --dir /`), a relative one in ".". The calls pass linear memory addresses: the scratch area of the output
## bytes (output_address() on), laid out by the offsets below
use "../intrinsics.warp"
use "../builders.warp"
use "../library_words.warp"
use "../text_words.warp"
use "exact.warp"
use "../text.warp"
use "../arithmetic.warp"

# WASI's words, imported from wasi_snapshot_preview1 (host_words.warp names the module); each gives its error code
args_sizes_get(count_at: int, size_at: int): int from runtime
args_get(pointers_at: int, bytes_at: int): int from runtime
environ_sizes_get(count_at: int, size_at: int): int from runtime
environ_get(pointers_at: int, bytes_at: int): int from runtime
fd_prestat_get(fd: int, prestat_at: int): int from runtime
fd_prestat_dir_name(fd: int, name_at: int, length: int): int from runtime
path_open(dir: int, lookup: int, path_at: int, length: int, open: int, rights: int, inherited: int, flags: int, opened_at: int): int from runtime
fd_read(fd: int, iovecs_at: int, count: int, read_at: int): int from runtime
fd_close(fd: int): int from runtime
fd_readdir(fd: int, entries_at: int, room: int, cookie: int, used_at: int): int from runtime
fd_write(fd: int, iovecs_at: int, count: int, written_at: int): int from runtime

# the scratch area: a prestat or a count pair, an iovec, the count a call wrote, an fd, then the bytes
scratch_pair(): int := 0
scratch_iovec(): int := 8
scratch_count(): int := 16
scratch_fd(): int := 20
scratch_bytes(): int := 32
# the bytes one call moves at most, below the one page of memory
wasi_chunk(): int := 32768
# path_open's flags: follow symlinks; create, truncate; the rights asked for (read, seek, write)
wasi_follow_links(): int := 1
wasi_create_new(): int := 9
wasi_file_rights(): int := 70
wasi_stdin(): int := 0
wasi_stderr(): int := 2
wasi_first_preopen(): int := 3
wasi_no_entry(): int := 44
# path_open's flag for a folder, and the right to read its entries
wasi_directory(): int := 2
wasi_readdir_right(): int := 16384
# a folder entry's bytes before its name: the next entry's cookie (u64), the inode (u64), the name's length (u32), the
# type (u8) and padding
wasi_entry_head(): int := 24

# the 4-byte little-endian word at a scratch offset, written and read
store_scratch_word(at: int, value: int) := {
	rest = value
	for i in 0..<4 {
		output_byte(at + i, rest % 256)
		rest = floor_quotient(rest, 256)
	}
}
scratch_word(at: int): int := {
	address = output_address() + at
	memory_byte(address) + 256 * (memory_byte(address + 1) + 256 * (memory_byte(address + 2) + 256 * memory_byte(address + 3)))
}
put_scratch_bytes(at: int, t: text) := { for i in 0..<byte_count(t) { output_byte(at + i, byte_at(t, i)) } }
scratch_text(at: int, length: int): text := text_from_memory(output_address() + at, length)

# the preopened folders: [fd, name] each
preopened_folders(): list := {
	found = []
	fd = wasi_first_preopen()
	while fd_prestat_get(fd, output_address() + scratch_pair()) == 0 {
		length = scratch_word(scratch_pair() + 4)
		fd_prestat_dir_name(fd, output_address() + scratch_bytes(), length)
		found += [[fd, scratch_text(scratch_bytes(), length)]]
		fd += 1
	}
	found
}
# [folder fd, the path inside it] of a path, -1 for no folder holding it
preopened_place(path: text): list := {
	best = [-1, path]
	longest = -1
	for dir in preopened_folders() {
		name = dir#2
		holds = if text_starts_with(path, "/") then name == "/" or path == name or text_starts_with(path, name + "/") else name == "."
		if holds and byte_count(name) > longest {
			longest = byte_count(name)
			inside = if name == "." then path else bytes_between(path, byte_count(name), byte_count(path))
			while text_starts_with(inside, "/") { inside = bytes_between(inside, 1, byte_count(inside)) }
			best = [dir#1, if inside == "" then "." else inside]
		}
	}
	best
}
# the fd of the file opened, or the negated error code
opened_file(path: text, open: int): int := {
	place = preopened_place(path)
	if place#1 < 0 { return 0 - wasi_no_entry() }
	put_scratch_bytes(scratch_bytes(), place#2)
	error = path_open(place#1, wasi_follow_links(), output_address() + scratch_bytes(), byte_count(place#2), open, wasi_file_rights(), wasi_file_rights(), 0, output_address() + scratch_fd())
	if error != 0 then 0 - error else scratch_word(scratch_fd())
}
file_failure(word: text, path: text, error: int): Node := {
	reason = if error == wasi_no_entry() then "No such file or directory" else "WASI error " + error
	error_of(word + " " + path + " failed: " + reason)
}

# `read(path)`: the file's text, or the Error of why not
read_file(path: Node): Node := {
	t = text_of_textual(path)
	fd = opened_file(t, 0)
	if fd < 0 { return file_failure("read", t, 0 - fd) }
	answer = ""
	got = 1
	while got > 0 {
		store_scratch_word(scratch_iovec(), output_address() + scratch_bytes())
		store_scratch_word(scratch_iovec() + 4, wasi_chunk())
		fd_read(fd, output_address() + scratch_iovec(), 1, output_address() + scratch_count())
		got = scratch_word(scratch_count())
		if got > 0 { answer = answer + scratch_text(scratch_bytes(), got) }
	}
	fd_close(fd)
	answer
}

# `use file; list_files(folder)`: the names of the folder's entries without . and .., in the order WASI gives them;
# the Error of why not
std_file_list(path: Node): Node := {
	t = text_of_textual(path)
	place = preopened_place(t)
	if place#1 < 0 { return file_failure("list", t, wasi_no_entry()) }
	put_scratch_bytes(scratch_bytes(), place#2)
	error = path_open(place#1, wasi_follow_links(), output_address() + scratch_bytes(), byte_count(place#2), wasi_directory(), wasi_readdir_right(), wasi_readdir_right(), 0, output_address() + scratch_fd())
	if error != 0 { return file_failure("list", t, error) }
	fd = scratch_word(scratch_fd())
	names = []
	cookie = 0
	more = yes
	while more {
		fd_readdir(fd, output_address() + scratch_bytes(), wasi_chunk(), cookie, output_address() + scratch_count())
		used = scratch_word(scratch_count())
		# a full buffer may end inside an entry: the next call starts again at the last whole one's cookie
		more = used == wasi_chunk()
		at = scratch_bytes()
		ended = scratch_bytes() + used
		while at + wasi_entry_head() <= ended and at + wasi_entry_head() + scratch_word(at + 16) <= ended {
			length = scratch_word(at + 16)
			name = scratch_text(at + wasi_entry_head(), length)
			if name != "." and name != ".." { names += [name] }
			cookie = scratch_word(at) + 4294967296 * scratch_word(at + 4)
			at += wasi_entry_head() + length
		}
	}
	fd_close(fd)
	names
}
# the texts WASI lists: the environment's NAME=value lines, else the command line's arguments
wasi_list(environment: bool): list := {
	if environment then environ_sizes_get(output_address() + scratch_pair(), output_address() + scratch_pair() + 4) else args_sizes_get(output_address() + scratch_pair(), output_address() + scratch_pair() + 4)
	count = scratch_word(scratch_pair())
	size = scratch_word(scratch_pair() + 4)
	pointers = scratch_bytes()
	texts = scratch_bytes() + 4 * count
	if environment then environ_get(output_address() + pointers, output_address() + texts) else args_get(output_address() + pointers, output_address() + texts)
	found = []
	for i in 0..<count {
		start = scratch_word(pointers + 4 * i) - output_address()
		stop = if i + 1 < count then scratch_word(pointers + 4 * (i + 1)) - output_address() else texts + size
		found += [scratch_text(start, stop - start - 1)]
	}
	found
}
# wasi_environment() (lib/prelude.warp, Rust's wasi_emitter.rs): the environment as WASI gives it, each NAME=value line
# ended by a zero byte, which lib/wagi.warp splits by chr(0)
wasi_environment(): text := {
	joined = ""
	for line in wasi_list(yes) { joined = joined + line + chr(0) }
	joined
}
# `use os; args`: the arguments after the program, as `warp prog.warp a b` gives ["a" "b"]
std_os_args(): list := {
	given = wasi_list(no)
	if #given > 0 then given[1..] else []
}
# `use os; env(name)`: the variable's value, ø when unset
std_os_env(name: Node): Node := {
	prefix = text_of_textual(name) + "="
	for line in wasi_list(yes) {
		if text_starts_with(line, prefix) { return bytes_between(line, byte_count(prefix), byte_count(line)) }
	}
	ø
}
# `use os; input(prompt)`: the prompt written, then a line of stdin without its newline; ø at the end of the input. A
# byte a read, so no byte of the next line is taken. `input()` gives no prompt: os.warp's input() calls this with none
std_os_input(prompt: Node = ø): Node := {
	if prompt is text { print_text(prompt) }
	line = ""
	while yes {
		store_scratch_word(scratch_iovec(), output_address() + scratch_bytes())
		store_scratch_word(scratch_iovec() + 4, 1)
		fd_read(wasi_stdin(), output_address() + scratch_iovec(), 1, output_address() + scratch_count())
		if scratch_word(scratch_count()) == 0 { return if line then line else ø }
		if memory_byte(output_address() + scratch_bytes()) == Ascii.Newline { return line }
		line = line + scratch_text(scratch_bytes(), 1)
	}
}

# the first count scratch bytes, written to the open file
written_bytes(fd: int, count: int) := {
	store_scratch_word(scratch_iovec(), output_address() + scratch_bytes())
	store_scratch_word(scratch_iovec() + 4, count)
	fd_write(fd, output_address() + scratch_iovec(), 1, output_address() + scratch_count())
}
# `warn "careful"`: "warning: careful" on stderr, a chunk at a time, as the Rust lane says a runtime warning
warned(message: Node): Node := {
	t = "warning: " + text_of_textual(message) + "\n"
	start = 0
	while start < byte_count(t) {
		stop = if start + wasi_chunk() < byte_count(t) then start + wasi_chunk() else byte_count(t)
		for i in start..<stop { output_byte(scratch_bytes() + i - start, byte_at(t, i)) }
		written_bytes(wasi_stderr(), stop - start)
		start = stop
	}
	ø
}
# `use file; write_bytes(path, bytes)`: the file made anew of the bytes (ints 0 to 255); ø, or the Error of why not
std_file_write_bytes(path: Node, bytes: Node): Node := {
	items = unboxed_list(bytes)
	content = new_text(#items)
	for i in 0..<#items { set_byte(content, i, unboxed_int(items#(i + 1))) }
	written_file(text_of_textual(path), content)
}
# `use file; write(path, text)`: the file made anew of the text; ø, or the Error of why not
std_file_write(path: Node, content: Node): Node := written_file(text_of_textual(path), text_of_textual(content))
# the file at path made anew of the bytes of content, a chunk a call
written_file(path: text, content: text): Node := {
	fd = opened_file(path, wasi_create_new())
	if fd < 0 { return file_failure("write", path, 0 - fd) }
	start = 0
	while start < byte_count(content) {
		count = min_int(wasi_chunk(), byte_count(content) - start)
		for i in 0..<count { output_byte(scratch_bytes() + i, byte_at(content, start + i)) }
		written_bytes(fd, count)
		start += count
	}
	fd_close(fd)
	ø
}
