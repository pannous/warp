## exact rounding: Rust's exact_floor … exact_div_assign (rust-harness:src/wasm_emitter/numbers/exact.rs) as words over an Int
## $Node's numerator and denominator; a $Ratio n/0 is ±∞ by n's sign and 0/0 is NaN, as Rust reads them
use "../intrinsics.warp"
use "../../analysis/kinds.warp"
use "exact.warp"
use "../instructions.warp"
# -1 for -∞, 1 for ∞, 0 for a finite x and for NaN
def exact_infinity_rank(x: Node): int := if exact_denominator(x) == 0 then exact_numerator(x) else 0
def exact_is_nan(x: Node): bool := exact_numerator(x) == 0 and exact_denominator(x) == 0
def int_order(a: int, b: int): int := if a < b then -1 else if a > b then 1 else 0
# -1, 0 or 1 as a is below, equal to or above b; 2 (unequal) when exactly one of them is NaN
def exact_cmp(a: Node, b: Node): int := {
	made_case(Made.BigInt, big_exact_order(a, b))
	if exact_is_nan(a) or exact_is_nan(b) { return if exact_is_nan(a) and exact_is_nan(b) then 0 else 2 }
	if exact_denominator(a) == 0 or exact_denominator(b) == 0 { return int_order(exact_infinity_rank(a), exact_infinity_rank(b)) }
	exact_order(a, b)
}
def exact_neg(x: Node): Node := {
	made_case(Made.BigInt, big_exact_negated(x))
	exact_ratio(-exact_numerator(x), exact_denominator(x))
}
# -1, 0 or 1 as x is below, equal to or above 0 (a denominator is positive)
def exact_sign(x: Node): int := {
	made_case(Made.BigInt, big_exact_sign(x))
	n = exact_numerator(x)
	if n < 0 then -1 else if n > 0 then 1 else 0
}
def exact_abs(x: Node): Node := {
	if exact_sign(x) < 0 { return exact_neg(x) }
	x
}
# the integer part, rounded toward 0
def exact_trunc(x: Node): Node := {
	if not is_ratio(x) { return x }
	made_case(Made.BigInt, big_exact_trunc(x))
	int_quotient(ratio_numerator(x), ratio_denominator(x))
}
# a - b * trunc(a / b), the sign of a as i64.rem_s
def exact_rem(a: Node, b: Node): Node := {
	made_case(Made.BigInt, big_exact_remainder(a, b))
	exact_sub(a, exact_mul(b, exact_trunc(exact_div(a, b))))
}
# the Euclidean remainder, 0 <= r < |b|: the truncated one plus |b| when negative
def exact_mod(a: Node, b: Node): Node := {
	rest = exact_rem(a, b)
	if exact_sign(rest) < 0 { return exact_add(rest, exact_abs(b)) }
	rest
}
# the largest integer <= x, exact beyond the float range: a negative ratio truncates up, so one less
def exact_floor(x: Node): Node := {
	if not is_ratio(x) { return x }
	whole = exact_trunc(x)
	if exact_sign(x) < 0 { return exact_sub(whole, 1) }
	whole
}
# the quotient of a // b that goes with a % b: floor(a / b) for b > 0, -floor(-a / b) for b < 0
def exact_euclid_div(a: Node, b: Node): Node := {
	if exact_sign(b) < 0 { return exact_neg(exact_floor(exact_neg(exact_div(a, b)))) }
	exact_floor(exact_div(a, b))
}
# x /= y: an int x stays an int, the Euclidean quotient (x - x % y) / y; a ratio x divides exactly
def exact_div_assign(x: Node, y: Node): Node := {
	if is_ratio(x) { return exact_div(x, y) }
	exact_div(exact_sub(x, exact_mod(x, y)), y)
}
# `floor x` of a boxed number: exact for an int or ratio, a float's floor as an int
def floored_node(n: Node): Node := {
	if kind_code(n) != Kind.Int { return truncated(float_floor(unboxed_float(n))) }
	exact_floor(n)
}
