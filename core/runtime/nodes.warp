# The built-in node's parts: operators, keys, symbols, brackets and separators of lists
use "intrinsics.warp"
use "../analysis/kinds.warp"
use "errors.warp"
use "instructions.warp"
use "show.warp"
use "text.warp"
use "bridge.warp"
# a value as a boxed $Node
held(value: Node) as Node := value
# an int as its Int node (the emitter boxes every int so, emitter.warp boxed): one node per small number, made at its
# first use, as a node never changes; a list of bytes or counts made a node and a box per item (16 MB to read the 232 KB
# runtime.wasm, card hello-compile-allocations)
small_int_low() as int := -128
small_int_high() as int := 1023
global small_int_nodes = []
int_node(n: int) as Node := {
	if n < small_int_low() or n > small_int_high() { return fresh_int_node(n) }
	if not small_int_nodes { small_int_nodes = new_list(small_int_high() - small_int_low() + 1) }
	at = n - small_int_low() + 1
	if is_null(small_int_nodes#at) { small_int_nodes#at = fresh_int_node(n) }
	small_int_nodes#at
}
# The spellings of the built-in node's parts (core/node.warp), made at their first use only: a key's operator, a list's
# bracket and separator are read at every step of a walk over a program, and each list of texts made anew was a tenth
# of a rebuild (card key-op-case)
global runtime_spelling_lists = []
# each table named by its accessor below, operator_spellings() the first
spellings_of(table: int) as list := {
	if not runtime_spelling_lists {
		runtime_spelling_lists = [
			# a key's operator is its code above the kind bits, the position of its spelling here
			["", ":", "=", ":=", ".", "?.", "::", "->", "+", "-", "*", "/", "%", "rem", "^", "<<", ">>", "+=", "-=",
				"*=", "/=", "%=", "^=", "&&=", "||=", "^^=", "<", ">", "<=", ">=", "==", "!=", "≈", "and", "or", "xor", "not", "-", "√", "∛",
				"‖", "++", "--", "?", "if", "then", "else", "while", "do", "#", "..", "to", "as", "±", "??", "===", "!==", "~", "⌞", "⌟", "&",
				"|", "↑", "↓", "÷", "÷=", "is"],
			# a list's bracket and separator, as `n.bracket` and `n.separator` give them
			["{", "[", "(", "<", "·other", ""],
			["", " ", ",", ";", "\n", "\t"],
			# how a list shows its brackets and joins its items by its separator (Other's brackets as square ones)
			["{", "[", "(", "<", "[", ""],
			["}", "]", ")", ">", "]", ""],
			[" ", " ", ", ", "; ", "\n", "\t"]]
	}
	runtime_spelling_lists#table
}
operator_spellings() as list := spellings_of(1)
# a spelling's code; one of no built-in operator, `⊕` (Op.Other), joins the table at its first use, while the code
# still fits the byte a key holds it in
operator_code(written: text) as int := {
	spellings = operator_spellings()
	spelled = canonical_operator(written)
	for i in 1 to #spellings { if text_order(node_text(spellings#i), spelled) == 0 { return i - 1 } }
	if #spellings >= KindUnit.Info { raised("too many operators: " + spelled + " is one more than a key holds") }
	list_append(spellings, [spelled])
	#spellings - 1
}
# floor division's other spelling as its table's (node_cases.warp other_spellings)
canonical_operator(spelled: text) as text := if text_order(spelled, "/!") == 0 then "÷" else if text_order(spelled, "/!=") == 0 then "÷=" else spelled
# `key(1, "⊕", 2)`: a key of any operator, its spelling kept
key_node(left: Node, operator: Node, right: Node) as Node := keyed(operator_code(node_text(operator)) * KindUnit.Info + Kind.Key, left, right)
# the case of a node part's code among the cases by code, an operator past them (Op.Other) its own spelling
coded_case(cases: list, code: int, n: Node) as any := if code < #cases then cases#(code + 1) else key_operator(n)
# `as_code(data e)`: e marked as code, of the type code; the kind field without the code mark:
# `parse("a+1") == data (a+1)`
code_bit(n: Node) as int := int_remainder(int_quotient(marked_kind(n), KindUnit.Code), 2)
code_free_kind(n: Node) as int := marked_kind(n) - code_bit(n) * KindUnit.Code
code_node(n: Node) as Node := {
	if is_null(n) or code_bit(n) == 1 { return n }
	with_kind(n, marked_kind(n) + KindUnit.Code)
}
# (a node that is no key has no left side, `key_of(parse("y"))` is ø, as its value_of is)
key_left(n: Node) as Node := if is_null(n) or kind_code(n) != Kind.Key then ø else entry_key(n)
key_right(n: Node) as Node := key_value(n)
# the byte above the Kind: a key's operator, a list's bracket, a time's form and more
info_byte(n: Node) as int := int_remainder(int_quotient(marked_kind(n), KindUnit.Info), KindUnit.Info)
key_operator(n: Node) as text := node_text(operator_spellings()#(info_byte(n) + 1))
symbol_node(name: Node) as Node := symbol_of(node_text(name))
# a list's bracket and separator in its kind field: the bracket's info in the byte above the kind, the separator's
# code at bit 48; each written as `n.bracket` and `n.separator` give it
bracket_spellings() as list := spellings_of(2)
separator_spellings() as list := spellings_of(3)
bracket_info(n: Node) as int := info_byte(n)
separator_info(n: Node) as int := int_remainder(int_quotient(marked_kind(n), KindUnit.Separator), 8)
bracket_openings() as list := spellings_of(4)
bracket_closings() as list := spellings_of(5)
separator_joiners() as list := spellings_of(6)
# `(1; 2)`, `'x', 2`: a list between its brackets, its items joined as its separator joins them; a list or map of no
# written separator by commas, `[1, 2]`, `{a: 1, b: 'x'}`, as `warp format` writes them (decision shown-spaced)
list_shown(n: Node) as text := {
	at = bracket_info(n) + 1
	listed = separator_info(n) == 0 and (bracket_info(n) == BracketCode.Curly or bracket_info(n) == BracketCode.Square)
	joiner = if listed then ", " else node_text(separator_joiners()#(separator_info(n) + 1))
	items = if is_extended_list(n) then extended_list_items(n) else unboxed_list(n)
	node_text(bracket_openings()#at) + joined_items(items, joiner) + node_text(bracket_closings()#at)
}
# `bracket_of(n)`: "(" of `(a b)`, "" of a list without brackets; ø of a node that is no list, Other's brackets too.
# The table's own spelling, no copy: is_group asks it of every node a pass walks
list_bracket(n: Node) as Node := {
	if is_null(n) or kind_code(n) != Kind.List or bracket_info(n) == BracketCode.Other { return ø }
	bracket_spellings()#(bracket_info(n) + 1)
}
list_separator(n: Node) as Node := {
	if is_null(n) or kind_code(n) != Kind.List { return ø }
	separator_spellings()#(separator_info(n) + 1)
}
# the position of a spelling in spellings, from 0
spelling_code(spellings: list, spelled: text) as int := {
	for i in 1 to #spellings { if text_order(node_text(spellings#i), spelled) == 0 { return i - 1 } }
	fail()
	0
}
# `bracketed(items, "[")`, `separated(items, ",")`: the list with that bracket or separator; no items is ø, as `()`
# and `{}` parse, but `[]` in square brackets, the empty list
bracketed_node(items: Node, bracket: Node) as Node := {
	if is_nothing(items) { return if text_order(node_text(bracket), "[") == 0 then list_node(Marked.SquareList, []) else ø }
	if kind_code(items) != Kind.List { not_a_list() }
	code = spelling_code(bracket_spellings(), node_text(bracket))
	list_node(marked_kind(items) + (code - bracket_info(items)) * KindUnit.Info, unboxed_list(items))
}
separated_node(items: Node, separator: Node) as Node := {
	if is_null(items) { return items }
	if kind_code(items) != Kind.List { not_a_list() }
	code = spelling_code(separator_spellings(), node_text(separator))
	list_node(marked_kind(items) + (code - separator_info(items)) * KindUnit.Separator, unboxed_list(items))
}
