# Lists known only at run time: joining, growing, indexing, counting, filling, summing
use "intrinsics.warp"
use "../analysis/kinds.warp"
use "arithmetic.warp"
use "characters.warp"
use "errors.warp"
use "text.warp"
use "bridge.warp"
use "instructions.warp"
list_join(a: list, b: list): list := {
	out = new_list(#a + #b)
	copy_items(out, 0, a, 0, #a)
	copy_items(out, #a, b, 0, #b)
	out
}
# `a += b`: b's items after a's in a itself, so every alias of a sees them; a full array is replaced by one twice
# as large, so appending one item at a time copies each item a bounded number of times
list_append(a: list, b: list): list := {
	start = #a
	added = #b
	if start + added > item_room(a) {
		grown = new_list(max_int(start + added, 2 * item_room(a)))
		copy_items(grown, 0, a, 0, start)
		adopt_items(a, grown)
	}
	copy_items(a, start, b, 0, added)
	set_count(a, start + added)
	a
}
# `n#i` of a value known only at run time, counted from 1: a list's item, a text's character; ø has none ("1 not in
# an empty list"), any other value fails as "not a list"
node_at(n: Node, index: int): Node := {
	if is_null(n) { index_out_of_range_of(index, 0) }
	if is_extended_list(n) { return extended_list_at(n, index) }
	if is_range(n) { return range_at(n, index) }
	if kind_code(n) == Kind.List { return unboxed_list(n)#index }
	if kind_code(n) == Kind.Text { return text_char(unboxed_text(n), index) }
	# a one-character text given as a value known only at run time is a character: ":"#1 is ':'
	if kind_code(n) == Kind.Codepoint and index == 1 { return n }
	if marked_kind(n) == Marked.Instance and has_fields(n) { return instance_position(n, index) }
	# a pair's two items, its name and its value (decision pair-items): (a: 1)#1 is a, #2 is 1
	if kind_code(n) == Kind.Key and (index == 1 or index == 2) { return if index == 1 then entry_key(n) else key_value(n) }
	if kind_code(n) == Kind.Key { index_out_of_range_of(index, 2) }
	not_a_list()
}
# a class instance's default position function: its fields in the order its class declares them, `P(2, 3)#1` is 2
# (user 2026-10-27, card p1-default-position), read from its struct; its extra fields after them, also a declared field
# holding ø, from its entries. A class's own position function is to come (card class-position-index)
instance_position(instance: Node, index: int): Node := instance_field_at(instance, index) ?? key_value(unboxed_list(fields_of(instance))#index)
# `#n` of a value known only at run time: a list's items, a text's characters, one of a character ("d" of a list)
node_length(n: Node): int := {
	# ø, also an empty list `[]` in the lowered program, holds nothing
	if is_null(n) { return 0 }
	if is_extended_list(n) { return extended_list_count(n) }
	if is_range(n) { return range_count(n) }
	if kind_code(n) == Kind.List { return #unboxed_list(n) }
	if kind_code(n) == Kind.Text { return text_count(unboxed_text(n)) }
	if kind_code(n) == Kind.Codepoint { return 1 }
	if kind_code(n) == Kind.Key { return 2 }
	no_length_of(n)
}
# `xs.pop()`: the last item, dropped from xs in place by lowering its count, so every alias
# sees the shorter list
list_pop(xs: list): any := {
	last = xs#(#xs)
	forget_map_index(xs)
	set_count(xs, #xs - 1)
	last
}
# `xs.insert(i, v)`: v at the 0-based position i of xs itself, the items from there one further, so every alias sees
# it; a position past the end or before 0 appends
list_insert(xs: list, at: int, value: Node): list := {
	one = new_list(1)
	one#1 = value
	list_append(xs, one)
	if at < 0 or at >= #xs - 1 { return xs }
	forget_map_index(xs)
	copy_items(xs, at + 1, xs, at, #xs - 1 - at)
	xs#(at + 1) = value
	xs
}
# `n#i = value` of a list known only at run time, in the list itself, so every alias sees it
node_set_at(n: Node, index: int, value: Node): Node := {
	if kind_code(n) != Kind.List { fail() }
	if is_extended_list(n) { return extended_list_set(n, index, value) }
	items = unboxed_list(n)
	forget_map_index(items)
	items#index = value
	value
}
# `int[n]`: a list of count zeros
zero_fill(count: int, filler: Node): list := {
	out = new_list(count)
	for i in 1 to count { out#i = filler }
	out
}
# `sum(xs)` as `list_sum(xs, loop)`: the loop the lowering wrote gives it
list_sum(xs: list, computed: Node): Node := computed
# The indexes of the big maps looked up last (maps.warp map_index; card rebuild-speed), one per slot: the entries
# indexed and the table (each wrapped as a list's node), how many entries the table covers (ø or -1: the slot is free)
# and whether it was looked up since the clock hand last passed it (1, else 0). An index stays right while entries are only added at
# the end (the next lookup takes them on) or replaced by one of the same name (field_with); any other change in place
# (map_without, node_set_at, list_pop) forgets that index alone. Four slots were too few: the emitter looks up more big
# maps (its functions, runtime words, globals, kinds) between two lookups of its texts, whose index was made anew each time
index_slots(): int := 64
# (a runtime global list starts empty, whatever it is given: the slots are made at the first lookup, index_slot)
global index_entries = []
global index_tables = []
global index_covered = []
global index_used = []
# the slot least_recent_slot looked at last: it sweeps the slots as a clock, giving a slot looked up since a second chance
# (the second-chance clock, where a count of lookups per slot boxed a new int at every lookup)
global index_hand = 0
# the slots index_slot found last and the one before: a run of lookups in one map (a parser's fields, read again and
# again) or alternating between two finds them first, where moving the other forward at each turn swapped them back
# and forth (10% of map_index)
global index_last = 0
global index_previous = 0
slot_free(slot: int): bool := is_null(index_covered#slot) or unboxed_int(index_covered#slot) < 0
holds_entries(slot: int, entries: list): bool := not is_null(index_entries#slot) and same(unboxed_list(index_entries#slot), entries) and not slot_free(slot)
# the slot holding these entries' index, 0 for none
index_slot(entries: list): int := {
	if index_last > 0 and holds_entries(index_last, entries) {
		# marked again only when the clock hand cleared it: a write at every lookup boxed the mark anew
		if unboxed_int(index_used#index_last) == 0 { index_used#index_last = 1 }
		return index_last
	}
	if index_previous > 0 and holds_entries(index_previous, entries) { return found_slot(index_previous) }
	if #index_covered == 0 {
		index_entries = new_list(index_slots())
		index_tables = new_list(index_slots())
		index_covered = new_list(index_slots())
		index_used = new_list(index_slots())
	}
	for slot in 1 to index_slots() {
		if holds_entries(slot, entries) { return found_slot(slot_moved_forward(slot)) }
	}
	0
}
# the slot found, now the last, marked looked up for least_recent_slot
found_slot(slot: int): int := {
	if slot != index_last { index_previous = index_last }
	index_last = slot
	index_used#slot = 1
	slot
}
# a slot found by the search swapped halfway to the front, so the maps looked up most sit where the search starts
# (it compared each slot in turn: 5% of compiling compiler.warp); its new place
slot_moved_forward(slot: int): int := {
	to = max_int(int_quotient(slot, 2), 1)
	swapped(index_entries, slot, to)
	swapped(index_tables, slot, to)
	swapped(index_covered, slot, to)
	swapped(index_used, slot, to)
	# the last and previous slots follow the map they held
	if index_last == to { index_last = slot }
	if index_previous == to { index_previous = slot }
	to
}
swapped(items: list, a: int, b: int): int := {
	held = items#a
	items#a = items#b
	items#b = held
	0
}
# the slot a new map's index takes: the next free one or one not looked up since the hand last passed it, the hand
# clearing the mark of each it passes (within two turns one is found)
least_recent_slot(): int := {
	for turn in 1 to 2 * index_slots() {
		index_hand = int_remainder(index_hand, index_slots()) + 1
		if slot_free(index_hand) or unboxed_int(index_used#index_hand) == 0 { return index_hand }
		index_used#index_hand = 0
	}
	index_hand
}
slot_table(slot: int): list := unboxed_list(index_tables#slot)
slot_covered(slot: int): int := unboxed_int(index_covered#slot)
# a slot holding the entries' index, marked looked up; written only when it changed: a lookup that found the index
# as it was wrapped the lists anew at every lookup
hold_index(slot: int, entries: list, covered: int, table: list): int := {
	found_slot(slot)
	if not holds_entries(slot, entries) or slot_covered(slot) != covered or not same(slot_table(slot), table) {
		index_entries#slot = list_node(Kind.List, entries)
		index_tables#slot = list_node(Kind.List, table)
		index_covered#slot = covered
	}
	0
}
# the index of these entries forgotten, after a change in place an index cannot follow; the other maps keep theirs
forget_map_index(entries: list): int := {
	slot = index_slot(entries)
	if slot > 0 { index_covered#slot = -1 }
	0
}
# a list node's kind (kinds.warp ListKind): 0 of a list holding its $list, else the row of a range or an extension's list
list_kind(n: Node): int := if is_null(n) or kind_code(n) != Kind.List then 0 else int_remainder(int_quotient(marked_kind(n), list_kind_unit()), 4)
# kinds.warp's KindUnit.ListKind, KindUnit.ListCell and ListKind.Range as numbers: the seed that builds the runtime
# first knows only its own tables' keys (card once-refreshed)
list_kind_unit(): int := 4503599627370496
list_cell_unit(): int := 144115188075855872
range_kind(): int := 1
# a list of an extension's kind, whose words runtime/bridge.warp's list hooks reach (a GPU list: extensions/gpu_lists)
is_extended_list(n: Node): bool := list_kind(n) > range_kind()
# A range `1 to n`, `1..n` (decision lazy-range-value): a list node of ListKind.Range holding its two ends and no
# items; #, xs#i and sum answer from the ends, any other list word makes its items (unlisted_items)
range_value(first: int, last: int): Node := keyed(Kind.List + BracketCode.Square * KindUnit.Info + range_kind() * list_kind_unit(), fresh_int_node(first), fresh_int_node(last))
is_range(n: Node): bool := list_kind(n) == range_kind()
range_first(n: Node): int := unboxed_int(entry_key(n))
range_count(n: Node): int := max_int(unboxed_int(key_value(n)) - range_first(n) + 1, 0)
range_at(n: Node, index: int): Node := {
	if index < 1 or index > range_count(n) { index_out_of_range_of(index, range_count(n)) }
	fresh_int_node(range_first(n) + index - 1)
}
range_items(n: Node): list := {
	out = new_list(range_count(n))
	for i in 1 to #out { out#i = range_at(n, i) }
	out
}
# Gauss's sum, count · (first + last) / 2, halving whichever of the two is even
range_sum(n: Node): Node := {
	count = range_count(n)
	ends = range_first(n) + unboxed_int(key_value(n))
	if int_remainder(count, 2) == 0 then grown_product(int_quotient(count, 2), ends) else grown_product(count, int_quotient(ends, 2))
}
# the items of a list node whose data is no $list (emitter unboxed_list_code): a range's made, an extension's as its
# kind gives them (a GPU list refuses)
unlisted_items(n: Node): list := if is_range(n) then range_items(n) else extended_list_unlisted(n)
