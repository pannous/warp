# Maps and class instances: their entries, fields, lookups and updates
use "intrinsics.warp"
use "../kinds.warp"
use "equality.warp"
use "errors.warp"
use "fields.warp"
use "lists.warp"
use "nodes.warp"
use "show.warp"
use "text.warp"
use "types.warp"
# a map is a curly list of `name:value` keys (Marked.Map and Marked.Entry, as Rust's); a class instance `Point{x:1}`
# is the key of its class name and the map of its fields; any other key `n:20` is the map of itself, as Rust's
# keys(n:20) is [n]
fields_of(m: Node): Node := {
	if marked_kind(m) != Marked.Instance { return m }
	fields = key_value(m)
	if not is_null(fields) and kind_code(fields) == Kind.List then fields else map_of([m])
}
# the place of m's entry named `name`, counted from 1; 0 when it has none
map_index(m: Node, name: text): int := {
	entries = unboxed_list(fields_of(m))
	if #entries < index_least() {
		for i in 1 to #entries { if kind_code(entries#i) == Kind.Key and same_bytes(entry_name(entries#i), name) { return i } }
		return 0
	}
	hashed_place(entries, map_table(entries), name)
}
# A map with fewer entries is walked: an object like `{x: 1, y: 2}` read field by field needs no index (Rust's
# MIN_INDEXED_ENTRIES); a bigger one is looked up through its index (lists.warp indexed_1 …), so `b[k] = a[k]` in a
# loop over a's keys takes linear time, not quadratic
index_least(): int := 16
# the table of the entries' index, brought up to their count: the slot holding it, else the next slot in turn; a table
# kept at most half full, made anew when the entries outgrew it or fewer are left than it covers
map_table(entries: list): list := {
	slot = index_slot(entries)
	if slot == 0 {
		slot = least_recent_slot()
		hold_index(slot, entries, 0, new_list(4 * #entries))
	}
	table = slot_table(slot)
	covered = slot_covered(slot)
	if covered > #entries or 2 * #entries > #table {
		table = new_list(4 * #entries)
		covered = 0
	}
	while covered < #entries {
		covered += 1
		add_place(entries, table, covered)
	}
	hold_index(slot, entries, covered, table)
	table
}
# the slot a new map's index takes: a free one, else the one looked up least recently, so the maps looked up again and
# again (the emitter's texts, its functions) keep their index while one no longer used gives its slot up (taking turns
# instead let a fifth map evict the emitter's texts map every few lookups)
least_recent_slot(): int := {
	slot = 1
	for candidate in 2 to 4 {
		if slot_covered(slot) >= 0 and (slot_covered(candidate) < 0 or slot_used(candidate) < slot_used(slot)) { slot = candidate }
	}
	slot
}
slot_used(slot: int): int := if slot == 1 then used_1 else if slot == 2 then used_2 else if slot == 3 then used_3 else used_4
index_slot(entries: list): int := {
	if covered_1 >= 0 and same_list(indexed_1, entries) { return 1 }
	if covered_2 >= 0 and same_list(indexed_2, entries) { return 2 }
	if covered_3 >= 0 and same_list(indexed_3, entries) { return 3 }
	if covered_4 >= 0 and same_list(indexed_4, entries) { return 4 }
	0
}
slot_table(slot: int): list := if slot == 1 then table_1 else if slot == 2 then table_2 else if slot == 3 then table_3 else table_4
slot_covered(slot: int): int := if slot == 1 then covered_1 else if slot == 2 then covered_2 else if slot == 3 then covered_3 else covered_4
hold_index(slot: int, entries: list, covered: int, table: list): int := {
	index_clock += 1
	if slot == 1 { used_1 = index_clock }
	if slot == 2 { used_2 = index_clock }
	if slot == 3 { used_3 = index_clock }
	if slot == 4 { used_4 = index_clock }
	if slot == 1 {
		indexed_1 = entries
		covered_1 = covered
		table_1 = table
	}
	if slot == 2 {
		indexed_2 = entries
		covered_2 = covered
		table_2 = table
	}
	if slot == 3 {
		indexed_3 = entries
		covered_3 = covered
		table_3 = table
	}
	if slot == 4 {
		indexed_4 = entries
		covered_4 = covered
		table_4 = table
	}
	0
}
# where a name's probe starts in a table: the hash of its bytes, mixed by Knuth's multiplier (below 2^32, so the
# product of a hash below 2^30 stays in an i64) before it picks a slot: names a last letter apart ("text 41", "text
# 42") hash next to each other, and their runs of neighbouring slots made each probe walk a long cluster
name_hash(name: text, size: int): int := {
	h = 5381
	i = 0
	while i < byte_count(name) {
		h = int_remainder(h * 33 + byte_at(name, i), 1000000007)
		i += 1
	}
	int_remainder(int_remainder(h * 2654435761, 4294967291), size)
}
# the entry at place goes in the table, unless it is no key or an earlier entry has its name (map_index finds the first)
add_place(entries: list, table: list, place: int): int := {
	entry = entries#place
	if kind_code(entry) != Kind.Key { return 0 }
	name = entry_name(entry)
	at = name_hash(name, #table)
	while not is_null(table#(at + 1)) {
		if same_bytes(entry_name(entries#unboxed_int(table#(at + 1))), name) { return 0 }
		at = int_remainder(at + 1, #table)
	}
	table#(at + 1) = place
	0
}
# the place of the entry named name by the table, 0 when it has none
hashed_place(entries: list, table: list, name: text): int := {
	at = name_hash(name, #table)
	while not is_null(table#(at + 1)) {
		place = unboxed_int(table#(at + 1))
		if same_bytes(entry_name(entries#place), name) { return place }
		at = int_remainder(at + 1, #table)
	}
	0
}
# an entry's name as a text: a symbol's or a text's own, without node_text's match over every kind (map_index runs it
# for each entry it passes); another name as key_name shows it
entry_name(entry: Node): text := {
	name = entry_key(entry)
	plain = not is_null(name) and (kind_code(name) == Kind.Symbol or kind_code(name) == Kind.Text) and not names_a_type(name)
	if plain then unboxed_text(name) else key_name(entry)
}
# 1 when m has fields to look up: a map, or a class instance (the key of its class name and its fields)
has_fields(m: Node): bool := not is_null(m) and not is_null(fields_of(m)) and kind_code(fields_of(m)) == Kind.List
# `m.name`: the value of m's entry `name`; a value without it fails as Rust's "no field name"
map_get(m: Node, name: text): Node := {
	if is_position_part(m, name) { return position_part(m, name) }
	if is_list_part(m, name) { return list_part(m, name) }
	# a symbol's name, a type value's too: `type(3).name` is int, as written without its `class ` (Rust: TYPE_VALUE_PREFIX)
	if kind_code(m) == Kind.Symbol { return unboxed_text(m) }
	if is_error_message(m, name) { return unboxed_text(m) }
	# a field of that name wins over the part reader: `.key` of the code `key = 3` is 3 (card node-part-clash)
	if is_entry(m) and same_bytes(key_name(m), name) { return key_value(m) }
	if is_entry(m) and same_bytes(name, "name") { return key_name(m) }
	if is_entry(m) and same_bytes(name, "key") { return entry_key(m) }
	if is_entry(m) and same_bytes(name, "value") { return key_value(m) }
	if is_entry(m) and same_bytes(name, "op") { return key_operator(m) }
	at = if has_fields(m) then map_index(m, name) else 0
	if at == 0 { missing_field(name) }
	key_value(unboxed_list(fields_of(m))#at)
}
# what `for k, v in x` walks: a map's entries as [name, value] pairs, any other list itself
map_entries(n: Node): Node := {
	if marked_kind(n) != Marked.Map { return n }
	out = []
	for entry in unboxed_list(n) { out += [[key_name(entry), key_value(entry)]] }
	out
}
map_keys(m: Node): list := {
	# `{}` is the empty value: its keys are the empty value too, as Rust's
	if is_null(m) { return m }
	out = new_list(0)
	if marked_kind(m) != Marked.Map and marked_kind(m) != Marked.Instance { not_a_map() }
	for entry in unboxed_list(fields_of(m)) { out += [key_name(entry)] }
	out
}
map_values(m: Node): list := {
	# `{}` is the empty value: its values are the empty value too, as Rust's
	if is_null(m) { return m }
	out = new_list(0)
	if marked_kind(m) != Marked.Map and marked_kind(m) != Marked.Instance { not_a_map() }
	for entry in unboxed_list(fields_of(m)) { out += [key_value(entry)] }
	out
}
# the name a key looks up an entry by: a symbol's letters, so the type value `float` names the entry `float:` (Rust:
# map_key_name)
name_text(key: Node): text := if kind_code(key) == Kind.Symbol then unboxed_text(key) else node_text(key)
# `x in c`, `c.contains(x)`: a map's entry named x, a list's item equal to x, a text's part x
collection_contains(c: Node, x: Node): bool := {
	if is_null(c) { return no } # `[]` is the null node
	# ø names no entry: `ø in m` is no (card pure-nil-in-any-map: name_text(ø) trapped on the null node)
	if marked_kind(c) == Marked.Map or kind_code(c) == Kind.Key { return not is_null(x) and map_index(c, name_text(x)) > 0 }
	if kind_code(c) == Kind.Text { return text_index(unboxed_text(c), node_text(x)) >= 0 }
	for item in unboxed_list(c) { if node_equal(item, x) { return yes } }
	no
}
# `c.index_of(x)`: a list's 1-based position of its first item equal to x, a text's character position, 1 for
# a map's entry named x; 0 when absent (Rust's collection_position, src/lowering/words/library_words.rs)
collection_position(c: Node, x: Node): int := {
	if is_null(c) { return 0 }
	if marked_kind(c) == Marked.Map or kind_code(c) == Kind.Key { return if not is_null(x) and map_index(c, name_text(x)) > 0 then 1 else 0 }
	if kind_code(c) == Kind.Text { return text_find(unboxed_text(c), node_text(x)) }
	position = 0
	for item in unboxed_list(c) {
		position += 1
		if node_equal(item, x) { return position }
	}
	0
}
# `c.remove(key)` gives this: of a map the key's value (ø when absent), of a list the list itself, which map_without
# then changes (Rust twin: fields_and_keys.rs removed_value)
removed_value(c: Node, key: Node): Node := if marked_kind(c) == Marked.Map then map_get_or(c, key) else c
# `c.remove(key)` stores this in c: a map without the key's entry, a list without its first item equal to key, in place
# so every holder sees it (Rust twin: fields_and_keys.rs map_without)
map_without(c: Node, key: Node): Node := {
	at = if marked_kind(c) == Marked.Map then map_index(c, name_text(key)) else collection_position(c, key)
	if at == 0 { return c }
	items = unboxed_list(fields_of(c))
	forget_map_index(items)
	copy_items(items, at - 1, items, at, #items - at)
	set_count(items, #items - 1)
	c
}
# `x[key]` of a value known only at run time: a list's item at an int key (counted from 0), else the map's entry
node_get(n: Node, key: Node): Node := {
	if kind_code(key) == Kind.Int and marked_kind(n) != Marked.Map { return node_at(n, unboxed_int(key) + 1) }
	map_get(n, name_text(key))
}
# `n[key] = value` of a value known only at run time: an int key sets the item key+1, any other key the entry named
# by its text (field_with); n, or the map made of ø
node_put(n: Node, key: Node, value: Node): Node := {
	if kind_code(key) == Kind.Int {
		node_set_at(n, unboxed_int(key) + 1, value)
		return n
	}
	field_with(n, name_text(key), value)
}
# `m.name = value`: a new entry in the old one's place, or at m's end; m itself, so every alias sees it; ø (`{}`)
# becomes a map of the one entry
field_with(m: Node, name: text, value: Node): Node := {
	if is_null(m) { return map_of([new_key(name, value)]) }
	entries = unboxed_list(fields_of(m))
	at = map_index(m, name)
	if at == 0 { list_append(entries, [new_key(name, value)]) } else { entries#at = new_key(name, value) }
	m
}
# `map_get_or(m, key, fallback)`: the value of m's entry key, fallback (ø when left out: `m.get(k)`) when m has none
map_get_or(m: Node, key: Node, fallback: Node = ø): Node := {
	if is_null(m) { return fallback }
	at = map_index(m, node_text(key))
	if at == 0 { return fallback }
	key_value(unboxed_list(fields_of(m))#at)
}
