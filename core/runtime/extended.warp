# The extended runtime words (decision runtime-split): the parts in core/runtime/extended/, for what only some
# programs do (durations and times, files over WASI). The core, runtime.warp and core/runtime/*.warp, never uses them
# nor names their words (scripts/self-check.sh checks it): its generic words hand an extended value to the hooks
# core/runtime/bridge.warp declares, whose bodies are this file's, at its end, or an extension root's (big ints and
# ratios: extensions/big_numbers.warp). The emitter calls these words where a program needs them, compiling each on
# its first call like any runtime word.
# Loaded after runtime.warp by compiler.warp (RUNTIME_ROOTS), the words of each file its `use` lines name in their order.
use "extended/durations.warp"
use "extended/times.warp"
use "extended/wasi.warp"
# the big numbers extension's runtime root, until the seed joins the extensions' runtime roots itself (the Extension
# rows' `runtime`): a seed lowers the runtime by its own compiler.warp's RUNTIME_ROOTS, and the compiler's int `/`
# calls exact_ratio
use "../../extensions/big_numbers.warp"
# The bodies of the hooks core/runtime/bridge.warp declares for times and warnings
use "intrinsics.warp"
use "../analysis/kinds.warp"
use "instructions.warp"
extended_text(n: Node): text := {
	made_case(Made.Time, time_text(n))
	fail()
}
extended_warned(message: text): Node := warned(message)
