# The intrinsics of core/emitter.warp (`intrinsic` and `time_intrinsic` there), each one or two instructions,
# declared by their typed heads (decision bodiless-imports): emitter.warp supplies them, so a part of the runtime
# compiles alone; the Rust lane, which has none, traps when one is called
# nodes: their kind field, payloads and the nodes built of them
with_kind(n: any, kind: int): any from runtime
kind_code(n: any): int from runtime
marked_kind(n: any): int from runtime
is_null(n: any): bool from runtime
unboxed_int(n: any): int from runtime
unboxed_float(n: any): float from runtime
unboxed_text(n: any): text from runtime
unboxed_char(n: any): char from runtime
unboxed_list(n: any): list from runtime
symbol_of(t: text): any from runtime
error_of(t: text): any from runtime
keyed(kind: int, left: any, right: any): any from runtime
new_key(left: any, right: any): any from runtime
entry_key(n: any): any from runtime
key_name(n: any): text from runtime
key_value(n: any): any from runtime
map_of(entries: list): any from runtime
list_node(kind: int, items: list): any from runtime
meta_node(n: any, line: int, column: int): any from runtime
is_meta(n: any): bool from runtime
meta_line(n: any): int from runtime
meta_column(n: any): int from runtime
closure_text(n: any): text from runtime
# exact rationals
is_ratio(n: any): bool from runtime
ratio_of(numerator: int, denominator: int): any from runtime
ratio_numerator(n: any): int from runtime
ratio_denominator(n: any): int from runtime
# texts, their bytes and characters
new_text(length: int): text from runtime
copy_text(to: text, at: int, source: text, start: int, count: int) from runtime
byte_count(t: text): int from runtime
byte_at(t: text, at: int): int from runtime
set_byte(t: text, at: int, byte: int) from runtime
same_text(a: text, b: text): int from runtime
code_of(c: char): int from runtime
char_of(code: int): char from runtime
# lists: their item array, its room and count
new_list(room: int): list from runtime
copy_items(to: list, at: int, source: list, start: int, count: int) from runtime
adopt_items(to: list, source: list) from runtime
item_room(items: list): int from runtime
set_count(items: list, count: int) from runtime
# the run: failing, output and the host's answers in linear memory
fail() from runtime
output_byte(at: int, byte: int) from runtime
write_output(count: int): int from runtime
output_address(): int from runtime
memory_byte(address: int): int from runtime
# values the emitter supplies: the message of the error a try caught (emitter.warp failed_in_name)
failed_in: text from runtime
# times and durations, packed in the kind field; time_of(info, position) builds one (emitter.warp time_words, which
# Rust's lane knows only of a constant info)
time_of(info: int, position: int): any from runtime
time_position(t: any): int from runtime
zone_index(t: any): int from runtime
zone_offset(t: any): int from runtime
