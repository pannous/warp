## packed_node(n): any value as one text, unpacked_node(t) the value again, its kinds, positions and texts as they were:
## a value kept across runs or handed whole to the host crosses as one text instead of node by node (card
## program-fixed). Each node is its shape (kinds.warp NodeShape), its kind field (but for Empty and Meta), then its
## payload. Numbers are ASCII varints and texts their UTF-8, so the whole text is UTF-8 a host keeps as it is.
## A class instance or a closure has no bytes: packed_node fails on one
use "intrinsics.warp"
use "../analysis/kinds.warp"
use "instructions.warp"
use "nodes.warp"
def packed_node(n: Node): text := {
	whole = new_text(node_written(n, yes, new_text(0), 0))
	node_written(n, yes, whole, 0)
	whole
}
# n written into `out` from `at`, where its bytes end: a text of no room only measures, so one walk sizes the text and
# the next fills it
def node_written(n: Node, positioned: bool, out: text, at: int): int := {
	if is_null(n) { return varint_written(NodeShape.Empty, out, at) }
	if positioned and is_meta(n) {
		place = varint_written(meta_line(n), out, varint_written(NodeShape.Meta, out, at))
		return node_written(n, no, out, varint_written(meta_column(n), out, place))
	}
	if is_class_instance(n) { fail() }
	shape = shape_of(n)
	at = varint_written(marked_kind(n), out, varint_written(shape, out, at))
	if shape == NodeShape.Int { return varint_written(unboxed_int(n), out, at) }
	if shape == NodeShape.Ratio { return varint_written(ratio_denominator(n), out, varint_written(ratio_numerator(n), out, at)) }
	if shape == NodeShape.BigInt {
		at = varint_written(limb_count(n), out, varint_written(if big_int_negative(n) then 1 else 0, out, at))
		for i in 0..<limb_count(n) { at = varint_written(limb(n, i), out, at) }
		return at
	}
	if shape == NodeShape.Float { return varint_written(bits_of_float(unboxed_float(n)), out, at) }
	if shape == NodeShape.Codepoint { return varint_written(code_of(unboxed_char(n)), out, at) }
	if shape == NodeShape.Text {
		t = unboxed_text(n)
		at = varint_written(byte_count(t), out, at)
		if byte_count(out) > 0 { copy_text(out, at, t, 0, byte_count(t)) }
		return at + byte_count(t)
	}
	if shape == NodeShape.Pair { return node_written(key_value(n), yes, out, node_written(entry_key(n), yes, out, at)) }
	items = unboxed_list(n)
	at = varint_written(#items, out, at)
	for item in items { at = node_written(item, yes, out, at) }
	at
}
# the shape of a node's payload, by its kind; a closure, a pointer or an uncertain value fails
def shape_of(n: Node): int := {
	kind = kind_code(n)
	if kind == Kind.Int { return if is_ratio(n) then NodeShape.Ratio else if is_big_int(n) then NodeShape.BigInt else NodeShape.Int }
	if kind == Kind.Time { return NodeShape.Int }
	if kind == Kind.Float { return NodeShape.Float }
	if kind == Kind.Codepoint { return NodeShape.Codepoint }
	if kind == Kind.Text or kind == Kind.Symbol or kind == Kind.Error { return NodeShape.Text }
	if kind == Kind.Key or kind == Kind.TypeDef { return NodeShape.Pair }
	if kind == Kind.List or kind == Kind.Block { return NodeShape.List }
	fail()
	0
}
# an int as ASCII bytes from `at` (where a text of no room only measures), where they end: zigzag, so a small negative
# one is small too, 6 bits a byte, low ones first, 64 marking a byte that more follow
def varint_written(value: int, out: text, at: int): int := {
	rest = bits_xor(shifted_left(value, 1), shifted_right_signed(value, 63))
	while shifted_right(rest, 6) != 0 {
		if byte_count(out) > 0 { set_byte(out, at, bits_and(rest, 63) + 64) }
		rest = shifted_right(rest, 6)
		at += 1
	}
	if byte_count(out) > 0 { set_byte(out, at, rest) }
	at + 1
}

# where unpacked_node reads next in its text
global bytes_read = 0
def unpacked_node(t: text): Node := {
	bytes_read = 0
	read_node(t)
}
def read_node(t: text): Node := {
	shape = read_varint(t)
	if shape == NodeShape.Empty { return ø }
	if shape == NodeShape.Meta {
		line = read_varint(t)
		column = read_varint(t)
		return meta_node(read_node(t), line, column)
	}
	kind = read_varint(t)
	if shape == NodeShape.Pair {
		left = read_node(t)
		return keyed(kind, left, read_node(t))
	}
	if shape == NodeShape.List {
		count = read_varint(t)
		items = new_list(count)
		set_count(items, 0)
		for i in 0..<count { items += [read_node(t)] }
		return list_node(kind, items)
	}
	with_kind(payload_read(t, shape), kind)
}
# the value a payload of that shape holds, its kind field set by the caller
def payload_read(t: text, shape: int): Node := {
	if shape == NodeShape.Int { return held(read_varint(t)) }
	if shape == NodeShape.Float { return held(float_of_bits(read_varint(t))) }
	if shape == NodeShape.Codepoint { return held(char_of(read_varint(t))) }
	if shape == NodeShape.Ratio {
		numerator = read_varint(t)
		return ratio_of(numerator, read_varint(t))
	}
	if shape == NodeShape.BigInt {
		negative = read_varint(t) == 1
		count = read_varint(t)
		big = big_int_of(negative, count)
		for i in 0..<count { set_limb(big, i, read_varint(t)) }
		return big
	}
	size = read_varint(t)
	part = new_text(size)
	copy_text(part, 0, t, bytes_read, size)
	bytes_read += size
	symbol_of(part)
}
def read_varint(t: text): int := {
	rest = 0
	shift = 0
	byte = byte_at(t, bytes_read)
	while byte >= 64 {
		rest = bits_or(rest, shifted_left(byte - 64, shift))
		shift += 6
		bytes_read += 1
		byte = byte_at(t, bytes_read)
	}
	rest = bits_or(rest, shifted_left(byte, shift))
	bytes_read += 1
	bits_xor(shifted_right(rest, 1), -bits_and(rest, 1))
}
