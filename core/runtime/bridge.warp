# The bridge (decision runtime-split): the hooks through which the core runtime hands a value of an extended type, an
# exact ratio or a time, to the extended runtime (core/runtime/extended/, joined by runtime/extended.warp).
# Core's generic words (show, ordering, equality, arithmetic, conversions, text_numbers, floats) call these hooks and
# never an extended word, nor use an extended file. Each hook is declared here by its typed head only; its body is
# runtime/extended.warp's, which fills it with the extended words when the extended runtime is compiled in. The
# emitter compiles a word on its first call, so a program with no ratio, time or float carries none of them. In the
# Rust lane a core part runs alone with a hook trapping when called (decision bodiless-imports).
# scripts/self-check.sh checks that no core file uses an extended file or names an extended word.
# show: an exact ratio as Rust shows it (3.5, 1/3), a time or duration as it is written
extended_text(n: Node): text from runtime
# ordering and equality: -1, 0 or 1 as a is below, equal to or above b, two Int nodes, one an exact ratio
extended_order(a: Node, b: Node): int from runtime
# arithmetic: the sum of two Int nodes, one an exact ratio
extended_sum(a: Node, b: Node): Node from runtime
# conversions: an exact ratio as a float, and truncated toward 0
extended_float(n: Node): float from runtime
extended_truncated(n: Node): int from runtime
# text_numbers: "1/3" read, n/d in lowest terms
extended_ratio(n: int, d: int): Node from runtime
# floats: a text of count zero digits
extended_zeros(count: int): text from runtime
# maps: a warning on stderr (a class instance read wrongly, card instance-field-order)
extended_warned(message: text): Node from runtime
