## node_bytes(n): any value as one text, node_of_bytes(t) the value again, its kinds, positions and texts as they were:
## a value kept across runs or handed whole to the host crosses as one text instead of node by node (card
## program-fixed). Each node is its shape (kinds.warp NodeShape), its kind field (but for Empty and Meta), then its
## payload. Numbers are ASCII varints and texts their UTF-8, so the whole text is UTF-8 a host keeps as it is.
## A class instance or a closure has no bytes: node_bytes fails on one
use "intrinsics.warp"
use "../kinds.warp"
use "instructions.warp"
use "nodes.warp"
node_bytes(n: Node): text := {
	parts = []
	write_node(parts, n, yes)
	concatenated(parts)
}
write_node(parts: list, n: Node, positioned: bool) := {
	if is_null(n) {
		parts += [varint_text(NodeShape.Empty)]
		return
	}
	if positioned and is_meta(n) {
		parts += [varint_text(NodeShape.Meta), varint_text(meta_line(n)), varint_text(meta_column(n))]
		write_node(parts, n, no)
		return
	}
	if is_class_instance(n) { fail() }
	shape = shape_of(n)
	parts += [varint_text(shape), varint_text(marked_kind(n))]
	if shape == NodeShape.Int { parts += [varint_text(unboxed_int(n))] }
	if shape == NodeShape.Ratio { parts += [varint_text(ratio_numerator(n)), varint_text(ratio_denominator(n))] }
	if shape == NodeShape.BigInt {
		parts += [varint_text(if big_int_negative(n) then 1 else 0), varint_text(limb_count(n))]
		for i in 0..<limb_count(n) { parts += [varint_text(limb(n, i))] }
	}
	if shape == NodeShape.Float { parts += [varint_text(bits_of_float(unboxed_float(n)))] }
	if shape == NodeShape.Codepoint { parts += [varint_text(code_of(unboxed_char(n)))] }
	if shape == NodeShape.Text { parts += [varint_text(byte_count(unboxed_text(n))), unboxed_text(n)] }
	if shape == NodeShape.Pair {
		write_node(parts, entry_key(n), yes)
		write_node(parts, key_value(n), yes)
	}
	if shape == NodeShape.List {
		items = unboxed_list(n)
		parts += [varint_text(#items)]
		for item in items { write_node(parts, item, yes) }
	}
}
# the shape of a node's payload, by its kind; a closure, a pointer or an uncertain value fails
shape_of(n: Node): int := {
	kind = kind_code(n)
	if kind == Kind.Int { return if is_ratio(n) then NodeShape.Ratio else if is_big_int(n) then NodeShape.BigInt else NodeShape.Int }
	if kind == Kind.Time { return NodeShape.Int }
	if kind == Kind.Float { return NodeShape.Float }
	if kind == Kind.Codepoint { return NodeShape.Codepoint }
	if kind == Kind.Text or kind == Kind.Symbol or kind == Kind.Error { return NodeShape.Text }
	if kind == Kind.Key or kind == Kind.TypeDef { return NodeShape.Pair }
	if kind == Kind.List or kind == Kind.Block { return NodeShape.List }
	fail()
	0
}
# the texts one after the other, copied once into a text of their whole length
concatenated(parts: list): text := {
	size = 0
	for part in parts { size += byte_count(part) }
	whole = new_text(size)
	at = 0
	for part in parts {
		copy_text(whole, at, part, 0, byte_count(part))
		at += byte_count(part)
	}
	whole
}
# an int as ASCII bytes: zigzag (a small negative one small too), 6 bits a byte, low ones first, 64 marking a byte
# that more follow
varint_text(value: int): text := {
	rest = bits_xor(shifted_left(value, 1), shifted_right_signed(value, 63))
	count = 1
	while shifted_right(rest, 6 * count) != 0 { count += 1 }
	out = new_text(count)
	for i in 0..<count {
		group = bits_and(shifted_right(rest, 6 * i), 63)
		set_byte(out, i, if i < count - 1 then group + 64 else group)
	}
	out
}

# where node_of_bytes reads next in its text
global bytes_read = 0
node_of_bytes(t: text): Node := {
	bytes_read = 0
	read_node(t)
}
read_node(t: text): Node := {
	shape = read_varint(t)
	if shape == NodeShape.Empty { return ø }
	if shape == NodeShape.Meta {
		line = read_varint(t)
		column = read_varint(t)
		return meta_node(read_node(t), line, column)
	}
	kind = read_varint(t)
	if shape == NodeShape.Pair {
		left = read_node(t)
		return keyed(kind, left, read_node(t))
	}
	if shape == NodeShape.List {
		count = read_varint(t)
		items = new_list(count)
		for i in 0..<count { items += [read_node(t)] }
		return list_node(kind, items)
	}
	with_kind(payload_read(t, shape), kind)
}
# the value a payload of that shape holds, its kind field set by the caller
payload_read(t: text, shape: int): Node := {
	if shape == NodeShape.Int { return held(read_varint(t)) }
	if shape == NodeShape.Float { return held(float_of_bits(read_varint(t))) }
	if shape == NodeShape.Codepoint { return held(char_of(read_varint(t))) }
	if shape == NodeShape.Ratio {
		numerator = read_varint(t)
		return ratio_of(numerator, read_varint(t))
	}
	if shape == NodeShape.BigInt {
		negative = read_varint(t) == 1
		count = read_varint(t)
		big = big_int_of(negative, count)
		for i in 0..<count { set_limb(big, i, read_varint(t)) }
		return big
	}
	size = read_varint(t)
	part = new_text(size)
	copy_text(part, 0, t, bytes_read, size)
	bytes_read += size
	symbol_of(part)
}
read_varint(t: text): int := {
	rest = 0
	shift = 0
	byte = byte_at(t, bytes_read)
	while byte >= 64 {
		rest = bits_or(rest, shifted_left(byte - 64, shift))
		shift += 6
		bytes_read += 1
		byte = byte_at(t, bytes_read)
	}
	rest = bits_or(rest, shifted_left(byte, shift))
	bytes_read += 1
	bits_xor(shifted_right(rest, 1), -bits_and(rest, 1))
}
