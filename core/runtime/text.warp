# Texts byte by byte: joining, counting characters, code points, order, search, printing
use "intrinsics.warp"
use "instructions.warp"
use "characters.warp"
use "walks.warp"
use "../emitter/byte_codes.warp"
text_join(a: text, b: text): text := {
	out = new_text(byte_count(a) + byte_count(b))
	copy_text(out, 0, a, 0, byte_count(a))
	copy_text(out, byte_count(a), b, 0, byte_count(b))
	# a walk over a stays good on out, which starts with a's bytes: `t += …` keeps t's cursor
	if same(a, walked_text) { walked_text = out }
	if same(a, other_text) { other_text = out }
	out
}
# the texts joined, `between` between each two: one text made and each byte copied once, where `+=` in a loop copies
# all bytes so far each time (card list-display-slowness)
texts_joined(parts: list, between: text): text := {
	size = 0
	for i in 1 to #parts { size += byte_count(unboxed_text(parts#i)) }
	if #parts > 1 { size += byte_count(between) * (#parts - 1) }
	out = new_text(size)
	at = 0
	for i in 1 to #parts {
		if i > 1 {
			copy_text(out, at, between, 0, byte_count(between))
			at += byte_count(between)
		}
		part = unboxed_text(parts#i)
		copy_text(out, at, part, 0, byte_count(part))
		at += byte_count(part)
	}
	out
}
global other_index = 0
global other_at = 0
global other_before = -1
# the characters (grapheme clusters) of a text; a short one stays out of the count kept, so a lexer's words leave its
# source's count (card text-cache-lru)
text_count(t: text): int := {
	if byte_count(t) < short_text() { return characters_counted(t) }
	if same(t, counted_text) and byte_count(t) == counted_bytes { return counted }
	count = characters_counted(t)
	counted_text = t
	counted_bytes = byte_count(t)
	counted = count
	count
}
characters_counted(t: text): int := {
	count = 0
	at = 0
	while at < byte_count(t) {
		at = character_end(t, at)
		count += 1
	}
	count
}
# the code points of a text: its bytes that start one, all but the continuation bytes 10xxxxxx
code_point_count(t: text): int := {
	count = 0
	for i in 0..byte_count(t) {
		b = byte_at(t, i)
		if not is_continuation_byte(b) { count += 1 }
	}
	count
}
# the bytes the output area of linear memory holds at once (one page, past fd_write's iovec)
output_room(): int := 65520
# the bytes of t from start until stop into the output area at offset `at`, the memory grown to hold them and the
# byte after them (a C string's 0): the one place a text goes into linear memory
output_bytes(at: int, t: text, start: int, stop: int) := {
	memory_holding(at + stop - start + 1)
	for i in start..<stop { output_byte(at + i - start, byte_at(t, i)) }
}
# linear memory grown until the output area holds that many bytes (a long program argument, a big C text)
memory_holding(bytes: int) := {
	missing = pages_holding(output_address() + bytes) - memory_grown(0)
	if missing > 0 { memory_grown(missing) }
}
# the pages of linear memory that many bytes take
pages_holding(bytes: int): int := int_quotient(bytes + page_bytes() - 1, page_bytes())
page_bytes(): int := 65536
# where a text goes as a C string for a host word: past the output area's scratch bytes (runtime/extended/wasi.warp
# scratch_bytes)
c_text_at(): int := 32
# t as the C string a host word reads, its bytes and a 0 in linear memory: its address
c_text(t: text): int := {
	output_bytes(c_text_at(), t, 0, byte_count(t))
	output_byte(c_text_at() + byte_count(t), 0)
	output_address() + c_text_at()
}
# t and a newline to stdout
print_line(t: text): int := {
	print_text(t)
	output_byte(0, Ascii.Newline)
	write_output(1)
}
# t to stdout, through the output bytes of linear memory a chunk at a time
print_text(t: text) := {
	start = 0
	while start < byte_count(t) {
		stop = start + output_room()
		if stop > byte_count(t) { stop = byte_count(t) }
		output_bytes(0, t, start, stop)
		write_output(stop - start)
		start = stop
	}
}
# -1, 0 or 1 as a's bytes come before b's, equal them or come after
text_order(a: text, b: text): int := {
	i = 0
	while i < byte_count(a) and i < byte_count(b) {
		if byte_at(a, i) < byte_at(b, i) { return -1 }
		if byte_at(a, i) > byte_at(b, i) { return 1 }
		i += 1
	}
	if byte_count(a) == byte_count(b) then 0 else if byte_count(a) < byte_count(b) then -1 else 1
}
# whether a and b have the same bytes: the one text, or texts of other lengths, without looking at a byte (a map's
# names are mostly the very texts looked up)
same_bytes(a: text, b: text): bool := {
	if same(a, b) { return yes }
	if byte_count(a) != byte_count(b) { return no }
	i = 0
	while i < byte_count(a) {
		if byte_at(a, i) != byte_at(b, i) { return no }
		i += 1
	}
	yes
}
# `a == b` of texts (decisions nfc-tables, nfc-slot; wiki/Footguns.md): equal bytes, else equal NFC forms.
# Only a text holding a code point NFC may change asks the host: the compiler's own `→` == `≠` never does, so building
# the runtime needs no modules/unicode.wasm, which the step after it builds. The shared start of two texts is the same
# in both NFC forms up to an ASCII byte (nothing composes into an ASCII letter), so only what follows it is looked at,
# once. NFC reads code points, so a text that is no whole UTF-8 (byte_slice cut a character) compares by its bytes
# alone; a slice cuts only at its ends, so the shared start is checked at its first byte only
equal_texts(a: text, b: text): bool := {
	if same_bytes(a, b) { return yes }
	shared = shared_bytes(a, b)
	# parting where each holds an ASCII byte or has ended, their NFC forms part there too: an ASCII byte starts a
	# code point NFC keeps first (nothing before it composes with it), so it stays what NFC holds at that place
	if ascii_or_end(a, shared) and ascii_or_end(b, shared) { return no }
	from = stable_start(a, shared)
	first_a = first_suspect(a, from)
	first_b = first_suspect(b, from)
	if first_a < 0 or first_b < 0 { return no }
	(maybe_decomposed(a, first_a) or maybe_decomposed(b, first_b)) and same_bytes(canonical(a), canonical(b))
}
# how many bytes the two texts start the same
shared_bytes(a: text, b: text): int := {
	i = 0
	while i < byte_count(a) and i < byte_count(b) and byte_at(a, i) == byte_at(b, i) { i += 1 }
	i
}
ascii_or_end(t: text, at: int): bool := at >= byte_count(t) or byte_at(t, at) < Utf8.Continuation
# the last ASCII byte of t before its byte shared, or 0: a place where NFC starts over
stable_start(t: text, shared: int): int := {
	at = shared - 1
	while at > 0 and byte_at(t, at) >= Utf8.Continuation { at -= 1 }
	if at < 0 then 0 else at
}
# where t from byte `from` on first holds a lead byte of a code point NFC may change (see maybe_decomposed), its byte
# count when none; -1 when t is no whole UTF-8: a continuation byte first, or a lead byte without all its continuation bytes
first_suspect(t: text, from: int): int := {
	if byte_count(t) > 0 and is_continuation_byte(byte_at(t, 0)) { return -1 }
	suspect = byte_count(t)
	at = from
	while at < byte_count(t) {
		lead = byte_at(t, at)
		next = at + code_point_width(lead)
		if next > byte_count(t) { return -1 }
		if lead >= 204 and suspect == byte_count(t) { suspect = at }
		at += 1
		while at < next {
			if not is_continuation_byte(byte_at(t, at)) { return -1 }
			at += 1
		}
	}
	suspect
}
# whether t from byte `from` on (the lead byte first_suspect found, or the end) holds a code point NFC may change
maybe_decomposed(t: text, from: int): bool := {
	at = from
	before = 0
	while at < byte_count(t) {
		# a byte below 204 (0xCC, U+0300's lead byte) is ASCII, a continuation or the lead of a code point NFC keeps
		if byte_at(t, at) < 204 {
			before = 0
			at += 1
		} else {
			next = at + code_point_width(byte_at(t, at))
			c = code_point_at(t, at)
			after = if next < byte_count(t) then code_point_at(t, next) else 0
			if may_change_in_nfc(c) and not (lone_mark(c) and not may_change_in_nfc(before) and not may_change_in_nfc(after)) { return yes }
			before = c
			at = next
		}
	}
	no
}
# a combining mark U+0300–036F no composition takes, as the parser's overline `6̅`: between two stable code points
# nothing composes or reorders it (U+0300–0304, 0306–030C, 030F, 0311, 0313, 0314, 031B, 0323–0328, 032D, 032E, 0330,
# 0331, 0338, 0340–0345 compose or are replaced)
lone_mark(c: int): bool := {
	if not within(c, 768, 879) or within(c, 768, 772) or within(c, 774, 780) or within(c, 803, 808) or within(c, 832, 837) { return no }
	not (c == 783 or c == 785 or c == 787 or c == 788 or c == 795 or c == 813 or c == 814 or c == 816 or c == 817 or c == 824)
}
# a code point NFC may compose, reorder or replace (a combining mark, an NFC_QC No singleton), or one of a block not
# known free of them. Free of them: below U+0300; Greek and Cyrillic U+0370–0482, 048A–052F; phonetic letters
# U+1D00–1DBF; Latin extended additional U+1E00–1EFF; punctuation and currency U+2010–20CF; letterlike, number forms,
# arrows, math and shapes U+2100–2BFF; CJK punctuation U+3000–3029; variation selectors U+FE00–FE0F; small forms
# U+FE30–FE6F; halfwidth and fullwidth forms U+FF00–FFEF; emoji U+1F000–1FAFF. The singletons among them: U+0374,
# 037E, 0387 (Greek), 2126 Ω, 212A K, 212B Å, 2329, 232A (angle brackets), 2ADC (forking)
may_change_in_nfc(c: int): bool := {
	if c < 768 { return no }
	if c == 884 or c == 894 or c == 903 or c == 8486 or c == 8490 or c == 8491 or c == 9001 or c == 9002 or c == 10972 { return yes }
	if within(c, 880, 1154) or within(c, 1162, 1327) or within(c, 7424, 7615) or within(c, 7680, 7935) { return no }
	if within(c, 8208, 8399) or within(c, 8448, 11263) or within(c, 12288, 12329) { return no }
	if within(c, 65024, 65039) or within(c, 65072, 65135) or within(c, 65280, 65519) or within(c, 126976, 129791) { return no }
	yes
}
canonical(t: text): text := unboxed_text(canonical_text(t))
# a text's NFC form, by lib/unicode.warp's canonical_text, which the host links on its first call
canonical_text(t: Node): Node from runtime
# where the bytes of part first start in t, -1 when nowhere
text_index(t: text, part: text): int := {
	for start in 0..(byte_count(t) - byte_count(part) + 1) {
		i = 0
		while i < byte_count(part) and byte_at(t, start + i) == byte_at(part, i) { i += 1 }
		if i == byte_count(part) { return start }
	}
	-1
}
