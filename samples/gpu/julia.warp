#!/usr/bin/env warp
# The Julia set of c = -0.8 + 0.156i: z → z² + c until |z| > 2, colored by the escape count through a cosine palette
use math
width = 320
height = 180
c = [-0.8, 0.156]
julia(x, y) := {
	z = [(x / width - 0.5) * 3.2, (y / height - 0.5) * 1.8]
	n = 0.0
	while n < 200 and norm(z) < 2 {
		z = [z.x * z.x - z.y * z.y + c.x, 2 * z.x * z.y + c.y]
		n += 1
	}
	t = n / 200
	[0.5 + 0.5 * cosine(3 + t * 20), 0.5 + 0.5 * cosine(3.6 + t * 20), 0.5 + 0.5 * cosine(4 + t * 20)]
}
paint(julia, width, height)
