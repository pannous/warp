#!/usr/bin/env warp
# The Julia set z → z² + c until |z| > 2, colored by the escape count through a cosine palette; 
# z and c are complex numbers of lib/complex => vec2f on the GPU
use math
width = 1600
height = 900
c = -0.8 + 0.16ⅈ
julia(x, y) := {
	z = (x / width - ½) * 3 + (y / height - ½) * 2 * ⅈ
	n = 0.0
	while n < 200 and ‖z‖ < 2 {
		z = z² + c
		n++
	}
	t = n / 200
	[½ + ½ * cosine(3 + t * 20), ½ + ½ * cosine(3.6 + t * 20), ½ + ½ * cosine(4 + t * 20)]
}
paint(julia, width, height)
