#!/usr/bin/env warp
# A sunset sea, after web-ocean (github.com/Noniv/web-ocean, MIT): waves, sun glitter, whitecaps, a warm sky with two cloud layers, aerial perspective and AgX tone mapping, 
# all pur warp functions that paint(ocean, width, height) compiles to one fragment shader. 
# Each pixel casts a ray from the camera: it marches down onto the waves or goes up into the sky.
# web-ocean simulates its waves by FFT on a quadtree mesh over several passes; here they are a sum of wind waves, each one dragging the next along (cheap, and the crests stay sharp)
use math
use keys
use units
width = 960
height = 540
global time = 0.0

# the settings of web-ocean's panel (H), with its defaults
wind_speed = 7 # m/s: longer, higher waves as it rises
wind_direction = 28° # off the line of sight, the waves roll toward the camera
swell_height = 1.8 # metres, significant wave height
swell_length = 120 # metres
swell_direction = -4° # off the line of sight
choppiness = 1.25
turbidity = 1.6 # how bright and green the water body is (coastal sediment, plankton)
foam_amount = 1.0
sun_elevation = 4.6° # above the horizon
sun_azimuth = 4° # to the right of the view
haze = 1.0
cloud_cover = 0.4
exposure = 1.0

# the camera: 2.4 m above the water looking toward the sun, as docs/front.jpg of web-ocean; it flies as there:
# W A S D move, Space or E up, Q or C down, drag the mouse to look around, Escape ends
global camera_x = 0.0
global camera_z = 0.0
# Angles are plain numbers of radians, `60°` is 1.0472 (decision degree-constant). The shader reads plain numbers only,
# so the lengths it reads stay numbers of metres; units are only for the values the flying alone reads (decision
# no-units-in-shaders)
global camera_height = 2.4 # metres
global yaw = 0° # to the right
global pitch = -3° # up
field_of_view = 60°
# the angle one pixel spans (radians)
pixel_angle = tangent(field_of_view / 2) / (height / 2)
flying_speed = 6 # m/s todo 6 m/s once a unit word is no Key case here (card use-keys)
looking_speed = 0.2° # a pixel the mouse moves
lowest = 0.8 # metres above the calm sea, todo 0.8 m (card use-keys)

geometry_waves = 12
detail_waves = 32
drag = 0.28
# how far the wind waves fan out around the wind
wind_spread = 70°
far_away = 20000.0
# how far the facets of the waves smear the mirrored sky, as a share of their roughness
reflection_blur = 0.2

# the direction toward a point elevation above the horizon, azimuth to the right
direction_of(elevation, azimuth) := [sine(azimuth) * cosine(elevation), sine(elevation), cosine(azimuth) * cosine(elevation)]
sun = direction_of(sun_elevation, sun_azimuth)
sun_light = [1.0, 0.68, 0.45] .* 9
zenith_blue = [0.09, .13, 0.22]
horizon_gold = [1.0, 0.58, 0.2]

# a number in 0 … 1 per lattice point: sin-hashes stripe in f32 for big arguments, so the point is wrapped first
hash(p) := fract(sine((p .- 289 .* floor(p ./ 289)) ∘ [127.1, 311.7]) * 43758.547)

# smooth value noise: the corner hashes of the lattice cell, blended
noise(p) := {
	cell = floor(p)
	inside = p .- cell
	blend = inside .* inside .* (3 .- 2 .* inside)
	bottom = mix(hash(cell), hash(cell .+ [1, 0]), blend.x)
	top = mix(hash(cell .+ [0, 1]), hash(cell .+ [1, 1]), blend.x)
	mix(bottom, top, blend.y)
}

# fractal noise: octaves of noise, each twice as fine and half as strong, turned so their grids don't line up
clouds_noise(p, octaves) := {
	sum = 0.0
	weight = 0.5
	q = p
	for octave in 0..octaves {
		sum = sum + weight * noise(q)
		q = [1.6 * q.x - 1.2 * q.y, 1.2 * q.x + 1.6 * q.y] .+ 17.3
		weight = weight * 0.5
	}
	sum
}

# a wave's direction of travel on the water, an angle off the line of sight, rolling toward the camera
heading(angle) := [sine(angle), -cosine(angle)]

# one sharp-crested wave, an exp(sin − 1) profile, at p after time: [height, slope along x, slope along z, rise]
wave_at(p, direction, length, amplitude) := {
	frequency = tau / length
	speed = sqrt(9.81 / frequency)
	phase = dot(p, direction) * frequency - time * speed * frequency
	crest = exponential(sine(phase) - 1)
	rise = crest * cosine(phase)
	slope = direction .* (rise * amplitude * frequency)
	[crest * amplitude, slope.x, slope.y, rise]
}

# the sea surface at p (metres, x and z) as a pixel footprint metres wide sees it: [height, slope along x, slope along z,
# the variance of the slopes too fine for the pixel]
# the long swell, then wind waves fanning around the wind, each shorter one dragged along by the slope before it, so
# the short waves bunch on the crests of the long ones. A wave would alias into noise where its sharp crest spans fewer
# than a few pixels (its harmonics are shorter than the wave): it fades out, and its slopes become roughness instead (the glitter spreads where the eye can't tell the facets apart)
waves(p, count, footprint) := {
	swell = wave_at(p, heading(swell_direction), swell_length, swell_height * 0.35)
	surface = swell.xyz
	# floats: twelve exact divisions by 1.18 would leave 64 bits
	length = (1.6 + wind_speed * 4.5) as float
	amplitude = (0.05 * wind_speed * choppiness) as float
	weights = amplitude
	hidden_slopes = 0.0
	at = p
	for wave in 0..count {
		direction = heading(wind_direction + wind_spread * sine(wave * 2.39996))
		seen = smoothstep(4 * footprint, 12 * footprint, length)
		one = wave_at(at, direction, length, amplitude * seen)
		surface = surface .+ one.xyz
		at = at .- direction .* (one.w * drag * amplitude * seen * 4)
		hidden_slopes = hidden_slopes + (1 - seen) * (amplitude * tau / length) ^ 2 * 0.25
		weights = weights + amplitude
		length = length / 1.18
		amplitude = amplitude * 0.83
	}
	[surface.x - weights * 0.37, surface.y, surface.z, hidden_slopes]
}

surface_height(p) := {
	surface = waves(p, geometry_waves, 0.01)
	surface.x
}

# the sky's color in a direction: the air's gradient, the glow around the sun, the sun itself, then the clouds
air(direction) := {
	up = max(direction.y, 0)
	toward_sun = max(dot(direction, sun), 0)
	gradient = mix(horizon_gold, zenith_blue, smoothstep(0, 0.5, up) ^ 0.6)
	factor = (0.4 * toward_sun ^ 8 + 2.0 * toward_sun ^ 120 + 6 * toward_sun ^ 2000) .* (1 - up) ^ 3
	glow = [1.0, 0.55, 0.25] .* factor
	gradient .+ glow .* haze
}

# the sun's disc, about three degrees wide, and its bloom blurring the rim, as a low sun looks through the haze (the
# true half degree reads as a dot on a screen)
sun_disc(direction) := {
	facing = dot(direction, sun)
	sun_light .* (40 * smoothstep(0.9996, 0.99985, facing) + 3 * exponential(-(1 - facing) * 2500))
}

# one flat cloud layer at altitude metres: coverage cuts the fractal noise, the side facing the sun is lit. A look
# blur radians wide (a pixel, or the spread of the facets of rough water) softens the cloud edges by how much of the
# noise it spans, so the layer seen edge-on near the horizon doesn't break into streaks
cloud_layer(direction, altitude, scale, stretch, cover, octaves, blur) := {
	distance = altitude / max(direction.y, 0.02)
	spot = direction.xz .* (distance / scale) .* [1, stretch] .+ [time * 0.004, 0.3]
	density = clouds_noise(spot, octaves)
	spanned = distance / scale * blur / max(direction.y, 0.02)
	soft = 0.5 * smoothstep(0.1, 1.5, spanned)
	opacity = smoothstep(1 - cover - soft, 1.15 - cover + soft, density) * smoothstep(0.015, 0.09, direction.y)
	thickness = clouds_noise(spot .+ [0.05 * sun.x, 0.05 * sun.z], octaves)
	toward_sun = max(dot(direction, sun), 0)
	lit = clamp(1.2 - 3 * (thickness - density) - 0.8 * density, 0.1, 1.1)
	color = mix([0.5, 0.36, 0.24], [1.5, 0.95, 0.4], lit) .+ [1.0, 0.7, 0.4] .* (2.5 * toward_sun ^ 12)
	[color.x, color.y, color.z, opacity]
}

sky(direction, blur) := {
	color = air(direction) .+ sun_disc(direction)
	high = cloud_layer(direction, 6000, 2600, 4, cloud_cover * 0.7, 4, blur)
	color = mix(color, high.xyz .* 1.1, high.w * 0.6)
	low = cloud_layer(direction, 1500, 900, 1.3, cloud_cover, 5, blur)
	mix(color, low.xyz, low.w)
}

# where the ray hits the waves: march between the highest and lowest water, then halve the last step until it fits
hit_distance(origin, ray) := {
	top = 1.6
	near = (origin.y - top) / -ray.y
	far = min((origin.y + top) / -ray.y, far_away)
	distance = near
	before = near
	for step in 0..72 {
		p = origin .+ ray .* distance
		above = p.y - surface_height(p.xz)
		if above < 0.002 * distance or distance > far {
			break
		}
		before = distance
		distance = distance + max(above * 0.7, 0.01 * distance)
	}
	# the march overshoots by up to a step: neighbouring pixels would land at scattered points of the waves, which turns
	# them into speckles. Halving the last step finds the water between the last point above it and the first below
	for step in 0..8 {
		middle = (before + distance) / 2
		p = origin .+ ray .* middle
		if p.y > surface_height(p.xz) { before = middle } else { distance = middle }
	}
	distance
}

# the sea where the ray hit it: the sky mirrored by Fresnel, the sun's glitter, the turbid water below, whitecaps
water(ray, distance) := {
	p = [camera_x, camera_height, camera_z] .+ ray .* distance
	# how long a pixel lies on the water: stretched along the ray where it grazes the sea, where the waves mostly roll
	# toward the camera; somewhat less than the full stretch, so the far sea keeps its texture instead of turning glassy
	footprint = distance * pixel_angle / max(-ray.y, 0.002) ^ 0.75
	surface = waves(p.xz, detail_waves, footprint)
	n = normalize([-surface.y, 1, -surface.z])
	view = ray .* -1
	# Fresnel of a partly smoothed normal: at grazing angles the finer facets the eye sees stay mirror-like
	facing = max(dot(normalize(mix(n, [0, 1, 0], 0.45)), view), 0)
	fresnel = 0.02 + 0.98 * (1 - facing) ^ 5
	# the facets' slopes: the glitter's roughness, rougher where the waves too fine for a pixel tilt them
	roughness = sqrt(0.09 * 0.09 + surface.w)
	mirrored = reflect(ray, n)
	lifted = normalize([mirrored.x, abs(mirrored.y) * 0.4 + max(mirrored.y, 0) * 0.6, mirrored.z])
	reflection = sky(lifted, pixel_angle + roughness * reflection_blur)
	# glitter: a Gaussian distribution of facet slopes
	halfway = normalize(sun .+ view)
	along = max(dot(n, halfway), 0.001)
	tilt = (1 - along * along) / (along * along * roughness * roughness)
	glitter = sun_light .* (exponential(-tilt) / (pi * roughness * roughness * along ^ 4) * fresnel * 0.05)
	# the water body: light scattered up from below, and a green glow where the sun shines through a thin crest
	sky_light = air([0, 1, 0]) .* 1.6 .+ sun_light .* (max(sun.y, 0) * 0.8)
	body = [0.018, 0.085, 0.072] .* turbidity .* sky_light
	crest = clamp((p.y + 0.2) / 0.9, 0, 1)
	toward_sun = max(dot(sun, view .* -1), 0)
	thin = clamp(0.5 - 0.5 * dot(sun, n), 0, 1) ^ 3
	body = body .+ [0.035, 0.12, 0.085] .* sun_light .* (0.4 * crest * crest * toward_sun ^ 4 * thin * exponential(-distance / 600))
	# whitecaps on the highest crests, broken into patches, gone where they would be smaller than a pixel
	foam_line = p.y + 0.3 * noise(p.xz .* 0.5) + 0.15 * foam_amount
	patches = smoothstep(0.4, 0.8, noise(p.xz .* 3) * noise(p.xz .* 0.7 .+ 5))
	# patches = smoothstep(0.4, 0.8, noise(p.xz .* 1) * noise(p.xz .* 0.1 .+ 5))
	foam = smoothstep(0.85, 1.1, foam_line) * patches * foam_amount * exponential(-distance / 250)
	sea = mix(body, reflection, fresnel) .+ glitter
	mix(sea, [0.82, 0.87, 0.92] .* sky_light .* 0.5, clamp(foam, 0, 0.95))
}

# AgX tone mapping (Troy Sobotka's, in Benjamin Wrensch's fit): log encoding, then a sigmoid polynomial
agx(color) := {
	inset = [dot(color, [0.842479, 0.0784336, 0.0792237]), dot(color, [0.042328, 0.878469, 0.0791661]), dot(color, [0.0423756, 0.0784336, 0.879142])]
	low = -12.47393
	high = 4.026069
	x = clamp((binary_log(max(inset, 0.0000000001)) .- low) ./ (high - low), 0, 1)
	x2 = x .* x
	x4 = x2 .* x2
	15.5 .* x4 .* x2 .- 40.14 .* x4 .* x .+ 31.96 .* x4 .- 6.868 .* x2 .* x .+ 0.4298 .* x2 .+ 0.1191 .* x .- 0.00232
}

# back from AgX's space, a touch more saturated and contrasty as web-ocean's look
agx_display(curve) := {
	luminance = dot(curve, [0.2126, 0.7152, 0.0722])
	look = (max(curve, 0) .^ 1.06 .- luminance) .* 1.05 .+ luminance
	[dot(look, [1.19687900512017, -0.0980208811401368, -0.0990297440797205]), dot(look, [-0.0528968517574562, 1.15190312990417, -0.0989611768448433]), dot(look, [-0.0529716355144438, -0.0980434501171241, 1.15107367264116])]
}

# web-ocean's camera: exposure, a slight vignette, a cool white balance, glints and the sun bleached toward white
film(color, x, y) := {
	off_center = [(x / width - 0.5) * width / height, y / height - 0.5]
	exposed = color .* (exposure * (1 - 0.1 * dot(off_center, off_center))) .* [0.81, 1, 1.19]
	luminance = dot(exposed, [0.2126, 0.7152, 0.0722])
	bleached = mix(exposed, [luminance, luminance, luminance], smoothstep(0.7, 6, luminance) * 0.55)
	clamp(agx_display(agx(bleached)), 0, 1)
}

# the camera's ray through the pixel at column x, row y
ray_through(x, y) := {
	turn = yaw
	tilt = pitch
	forward = [sine(turn) * cosine(tilt), sine(tilt), cosine(turn) * cosine(tilt)]
	right = normalize(cross([0, 1, 0], forward))
	up = cross(forward, right)
	normalize(forward .+ right .* ((x - width / 2) * pixel_angle) .+ up .* ((height / 2 - y) * pixel_angle))
}

ocean(x, y) := {
	ray = ray_through(x, y)
	color = sky(ray, pixel_angle)
	if ray.y < -0.0005 {
		distance = hit_distance([camera_x, camera_height, camera_z], ray)
		# aerial perspective: the far sea fades into the haze of the horizon
		hazy = 1 - exponential(-distance * 0.00004 * haze)
		color = mix(water(ray, distance), air([ray.x, 0.02, ray.z]), hazy)
	}
	film(color, x, y)
}

# the free camera, one step of that many seconds
fly(step) := {
	turn = yaw
	way = flying_speed * step
	if held_key == "w" { camera_x += sine(turn) * way; camera_z += cosine(turn) * way }
	if held_key == "s" { camera_x -= sine(turn) * way; camera_z -= cosine(turn) * way }
	if held_key == "d" { camera_x += cosine(turn) * way; camera_z -= sine(turn) * way }
	if held_key == "a" { camera_x -= cosine(turn) * way; camera_z += sine(turn) * way }
	if held_key == space or held_key == "e" { camera_height += way }
	if held_key == "q" or held_key == "c" { camera_height = max(camera_height - way, lowest) }
}

started = clock()
last_frame = started
last_x = mouse_x
last_y = mouse_y
# each frame of the window, until it closes (headless: one frame, as a PNG)
on frame {
	if held_key == ESC: exit()
	now = clock()
	time = float(now - started) / 1000
	fly(float(now - last_frame) / 1000)
	last_frame = now
	if mouse_down {
		yaw += (mouse_x - last_x) * looking_speed
		pitch = clamp(pitch - (mouse_y - last_y) * looking_speed, -89°, 89°)
	}
	last_x = mouse_x
	last_y = mouse_y
	paint(ocean, width, height)
}
