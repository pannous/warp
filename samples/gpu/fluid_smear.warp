#!/usr/bin/env warp
# three liquids smeared with a finger, after https://mofu-dev.com/en/blog/fluid-foundation/ ("Mixing Three Colored
# Liquids"): three round drops, cyan, magenta and yellow, share one velocity field that a drag pushes along. Each liquid
# keeps its own thickness and a history of where it has been: its thickness moves by tracing the velocity back (a part
# leaves where the flow is strong, a part arrives from upstream, so thin trails stay behind), its history keeps the
# trace visible where the thickness is gone. The colors mix by thickness as paint does (a simple Kubelka–Munk), the
# surface is lit from the normals of the combined thickness, a glossy highlight on top.
# Drag to smear, space pours three fresh drops, F fills the screen, Escape leaves full screen, then ends. Headless, the PNG shows a first smear.
# Everything runs on the GPU (gpu_compute) over GPU lists [f32], two states taking turns
use keys
width = 320
height = 200
cells = width * height
state_size = 8 # per cell: velocity x, y, thickness of the three liquids, history of the three liquids

step = "
@group(0) @binding(0) var<storage, read_write> one: array<f32>;
@group(0) @binding(1) var<storage, read_write> two: array<f32>;
@group(0) @binding(2) var<storage, read_write> finger: array<f32>;
@group(0) @binding(3) var<storage, read_write> pixels: array<f32>;
const W = ${width}; const H = ${height}; const S = ${state_size};
const DT = 1.0;             // cells a unit of velocity moves in a step
const FADE = 0.985;         // velocity kept per step (no pressure solve: looks over conservation)
const VISCOSITY = 0.12;     // velocity shared with the neighbors
const MOVES = vec2f(0.05, 1.2); // below the first speed the liquid stays, above the second it moves fully
const SHARE = 0.3;          // the part of a cell's thickness that leaves with a full flow (the article's 0.3)

// the finger: x, y, its motion x, y, pressed, radius, phase (which array holds this step's state), pouring
fn from_one() -> bool { return finger[6] < 0.5; }
fn held(cell: i32, k: i32) -> f32 {
	if (from_one()) { return one[cell * S + k]; }
	return two[cell * S + k];
}
fn put(cell: i32, k: i32, v: f32) {
	if (from_one()) { two[cell * S + k] = v; } else { one[cell * S + k] = v; }
}
fn at_clamped(x: i32, y: i32, k: i32) -> f32 { return held(clamp(y, 0, H - 1) * W + clamp(x, 0, W - 1), k); }
// a value between the cells: bilinear, as a texture is sampled
fn sampled(p: vec2f, k: i32) -> f32 {
	let q = clamp(p, vec2f(0.0), vec2f(f32(W - 1), f32(H - 1)));
	let i = vec2i(floor(q));
	let f = fract(q);
	let a = mix(at_clamped(i.x, i.y, k), at_clamped(i.x + 1, i.y, k), f.x);
	let b = mix(at_clamped(i.x, i.y + 1, k), at_clamped(i.x + 1, i.y + 1, k), f.x);
	return mix(a, b, f.y);
}
// the article's initial height: a hemisphere, flat-topped by the smoothstep
fn drop(at: vec2f, centre: vec2f, radius: f32) -> f32 {
	let d = smoothstep(0.0, 1.0, distance(at, centre) / radius);
	let h = sqrt(max(1.0 - d * d, 0.0) / 12.0);
	return smoothstep(0.0, 0.025, h) * h * 0.66;
}
fn strength(v: vec2f) -> f32 { return smoothstep(MOVES.x, MOVES.y, length(v)); }
fn total(cell: i32) -> f32 { return held(cell, 2) + held(cell, 3) + held(cell, 4); }
// absorption over scattering of each liquid, per red, green, blue (Kubelka–Munk K/S), and the reflectance of a mix
fn ks_of(r: vec3f) -> vec3f { return (1.0 - r) * (1.0 - r) / (2.0 * r); }
fn reflectance(ks: vec3f) -> vec3f { return 1.0 + ks - sqrt(ks * ks + 2.0 * ks); }

@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {
	let cell = i32(id.x);
	if (cell >= W * H) { return; }
	let x = cell % W;
	let y = cell / W;
	let at = vec2f(f32(x), f32(y));
	if (finger[7] > 0.5) {
		let r = f32(H) * 0.22;
		let c = vec2f(f32(W), f32(H)) * 0.5;
		let heights = vec3f(drop(at, c + vec2f(-r * 1.25, r * 0.45), r), drop(at, c + vec2f(r * 1.25, r * 0.45), r), drop(at, c + vec2f(0.0, -r * 0.75), r));
		for (var k = 0; k < S; k++) { put(cell, k, 0.0); }
		put(cell, 2, heights.x); put(cell, 3, heights.y); put(cell, 4, heights.z);
		return;
	}
	// velocity: carried along itself, shared with its neighbors, pushed by the finger, fading
	let v_here = vec2f(held(cell, 0), held(cell, 1));
	let back = at - v_here * DT;
	var v = vec2f(sampled(back, 0), sampled(back, 1));
	let around = (vec2f(at_clamped(x + 1, y, 0), at_clamped(x + 1, y, 1)) + vec2f(at_clamped(x - 1, y, 0), at_clamped(x - 1, y, 1))
		+ vec2f(at_clamped(x, y + 1, 0), at_clamped(x, y + 1, 1)) + vec2f(at_clamped(x, y - 1, 0), at_clamped(x, y - 1, 1))) * 0.25;
	v = mix(v, around, VISCOSITY);
	let touch = finger[4] * (1.0 - smoothstep(0.0, finger[5], distance(at, vec2f(finger[0], finger[1]))));
	v = mix(v, vec2f(finger[2], finger[3]), touch * 0.6);
	v = v * FADE;
	let speed = length(v);
	if (speed > 6.0) { v = v * (6.0 / speed); }
	put(cell, 0, v.x); put(cell, 1, v.y);

	// thickness: a part leaves where the flow is strong, a part arrives from where the flow comes from (height.frag)
	let source = at - v_here * DT;
	let leaving = strength(v_here);
	let arriving = strength(vec2f(sampled(source, 0), sampled(source, 1)));
	var heights = vec3f(0.0);
	var history = vec3f(0.0);
	for (var k = 0; k < 3; k++) {
		let before = held(cell, 2 + k);
		let upstream = sampled(source, 2 + k);
		let next = max(0.0, before - min(before, leaving * SHARE * before) + min(upstream, arriving * SHARE * upstream));
		put(cell, 2 + k, next);
		// the history keeps the largest coverage seen (alpha.frag), shown half with the current one
		let current = smoothstep(0.0, 0.01 / 0.7, next);
		let most = max(current, held(cell, 5 + k));
		put(cell, 5 + k, most);
		heights[k] = next;
		history[k] = most * 0.5 + current * 0.5;
	}

	// normals from the combined thickness, its neighbors to the right and below
	let scale = 30.0;
	let h = heights.x + heights.y + heights.z;
	let hx = total(clamp(y, 0, H - 1) * W + clamp(x + 1, 0, W - 1));
	let hy = total(clamp(y + 1, 0, H - 1) * W + x);
	let normal = normalize(vec3f(-(hx - h) * scale, -(hy - h) * scale, 1.0));
	// mixing: by thickness, by the traces where the thickness is nearly gone
	let weights = select(history, heights, h > 0.002);
	let all = max(weights.x + weights.y + weights.z, 1e-5);
	let colors = array<vec3f, 3>(vec3f(0.05, 0.62, 0.86), vec3f(0.88, 0.12, 0.52), vec3f(0.98, 0.84, 0.08));
	let ks = (ks_of(colors[0]) * weights.x + ks_of(colors[1]) * weights.y + ks_of(colors[2]) * weights.z) / all;
	let deep = 1.0 + 4.0 * smoothstep(0.0, 0.06, h);
	let paint = reflectance(ks * deep);
	let light = normalize(vec3f(-0.5, -0.6, 0.65));
	let diffuse = 0.55 + 0.45 * max(dot(normal, light), 0.0);
	let shine = pow(max(dot(normal, normalize(light + vec3f(0.0, 0.0, 1.0))), 0.0), 40.0) * smoothstep(0.0, 0.02, h);
	let rim = 0.12 * (1.0 - normal.z);
	let alpha = step(0.1, max(history.x, max(history.y, history.z))) * max(history.x, max(history.y, history.z));
	let ground = vec3f(0.95, 0.93, 0.9);
	let rgb = mix(ground, paint * diffuse - rim, alpha) + shine * 0.8;
	let bytes = vec3i(clamp(rgb, vec3f(0.0), vec3f(1.0)) * 255.0);
	// a color as paint takes it, 0x01RRGGBB: blue's lowest bit cleared, so the f32 holds it exactly (an odd one would
	// round up and carry into green and red)
	pixels[cell] = f32((1 << 24) | (bytes.x << 16) | (bytes.y << 8) | (bytes.z & 254));
}"

one = float[cells * state_size]
two = float[cells * state_size]
pixels = float[cells]
global finger = float[8]
global last_x = 0.0
global last_y = 0.0
global was_down = no

# one step of the liquids, two phases so the state lands back in `one`; the finger at x, y moving by dx, dy
def stepped(x, y, dx, dy, pressed, pouring = 0) {
	settings = [x, y, dx, dy, pressed, 14, 0, pouring]
	for setting in 1 to #settings { finger#setting = settings#setting }
	for phase in 0..2 {
		finger#7 = phase
		gpu_compute(step, {one: one, two: two, finger: finger, pixels: pixels}, cells / 64 + 1)
	}
}
def poured() { stepped(0, 0, 0, 0, 0, 1) }
# a finger dragged from x1, y1 to x2, y2 in the given steps
def smeared(x1, y1, x2, y2, steps) {
	for s in 0..steps {
		stepped(x1 + (x2 - x1) * s / steps, y1 + (y2 - y1) * s / steps, (x2 - x1) / steps, (y2 - y1) / steps, 1)
	}
}
def rested(steps) {
	for s in 0..steps { stepped(0, 0, 0, 0, 0) }
}

# a first smear while the program starts, so the window (or the headless PNG) opens on mixed liquid
poured()
smeared(60, 130, 260, 90, 40)
smeared(250, 60, 90, 110, 40)
rested(20)

on key {
	if key == ESC: if window.fullscreen { window.fullscreen = no } else { exit() }
	if key == "f": window.fullscreen = not window.fullscreen
	if key == SPACE: poured()
}

on frame {
	down = mouse_down
	if down and not was_down { last_x = mouse_x; last_y = mouse_y }
	stepped(mouse_x, mouse_y, mouse_x - last_x, mouse_y - last_y, if down then 1 else 0)
	last_x = mouse_x
	last_y = mouse_y
	was_down = down
	paint([int(color) for color in pixels], width, height)
}
"three liquids on ${width}×${height} cells"
