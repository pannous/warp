#!/usr/bin/env warp
# Yohei Nishitsuji's #つぶやきGLSL one-liner, ported as a WGSL fragment shader (twigl geekest: FC, r, t, o):
# https://x.com/YoheiNishitsuji/status/2118697408498409526
# A ray takes fifty steps. Each step remaps the point into log-spherical coordinates (log of the radius, height over
# the radius, the angle in the plane) and folds eight octaves of cosine noise into the step length; that length is
# also the light added this frame, through twigl's hsv. Past step 35 the direction collapses to -1, the tweet's
# `i>35.?d-=d+1.:d`. $time and $size are paint's values, read each frame
yohei = shader {
	// twigl geekest hsv: hue, saturation and value, saturation free to fall outside 0…1 as the tweet's does
	fn hsv(h: f32, s: f32, v: f32) -> vec3f {
		let wheel = vec4f(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		let turned = abs(fract(vec3f(h) + wheel.xyz) * 6.0 - vec3f(wheel.w));
		return v * mix(vec3f(wheel.x), clamp(turned - vec3f(wheel.x), 0.0, 1.0), s);
	}

	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		// gl_FragCoord counts up from the bottom; a paint pixel counts down from the top
		let fc = vec2f(at.x, $size.y - at.y);
		var d = vec3f((fc - 0.5 * $size) / $size * 0.5 + vec2f(0.0, 1.0), 1.0);
		// q.yz-- before the march: the ray starts at (0, -1, -1)
		var q = vec3f(0.0, -1.0, -1.0);
		var e = 0.0;
		var radius = 0.0;
		var color = vec3f(0.0);
		// i++ < 50, so the body sees i = 1 … 50
		for (var step = 0; step < 50; step++) {
			let i = f32(step) + 1.0;
			e += i / 20000.0;
			if (i > 35.0) {
				d -= d + vec3f(1.0);
			}
			color += hsv(0.6, d.y, e / 9.0);
			q += d * e * radius * 0.2;
			var p = q;
			let px = p.x;
			let py = p.y;
			let pz = p.z;
			radius = length(p);
			p = vec3f(log(radius) - $time * 0.5, -pz / radius, atan2(px, py) - $time * 0.5);
			// e = --p.y, then s = 1, 2, 4 … 128
			p.y -= 1.0;
			e = p.y;
			var s = 1.0;
			for (var octave = 0; octave < 8; octave++) {
				e += cos(dot(cos(p * s), sin(p.yzx * s))) / s;
				s += s;
			}
		}
		return vec4f(color, 1.0);
	}
}
# ten seconds by the clock, however long a frame takes
started = clock()
while clock() - started < 10000 {
	paint(yohei)
	sleep(1 / 60)
}
