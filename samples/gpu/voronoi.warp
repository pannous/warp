#!/usr/bin/env warp
# Worley's cellular noise: in each cell one random point, each pixel shaded by its distance to the nearest
use math
width = 320
height = 180
voronoi(x, y) := {
	p = [x, y] ./ 30
	cell = floor(p)
	nearest = 8.0
	for j in -1..2 {
		for i in -1..2 {
			neighbour = [i, j]
			point = hash(cell .+ neighbour)
			nearest = min(nearest, norm(neighbour .+ point .- fract(p)))
		}
	}
	[nearest, nearest * nearest, 1 - nearest]
}
paint(voronoi, width, height)
