#!/usr/bin/env warp
# A lava lamp: seven blobs of wax rise and sink, melting into each other where they meet.
# Press to add a blob under the pointer; the wheel adds wax or takes it away.
# A WGSL fragment shader: paint colors every pixel on the GPU, frame after frame; $time, $mouse, $mouse_down,
# $mouse_wheel and $size are paint's values, read at each frame.
use shown_frames
lamp = shader {
	const BLOBS = 7;

	// blob number index at time t: its center (x, y) and its radius (z)
	fn blob(index: f32, t: f32) -> vec3f {
		let pace = 0.11 + 0.05 * index;
		let x = 0.45 * sin(t * pace * 1.3 + index * 2.4);
		let y = 0.75 * sin(t * pace + index * 1.7);
		return vec3f(x, y, (0.13 + 0.06 * fract(index * 0.618)) * clamp(pow(1.05, $mouse_wheel), 0.5, 2.0));
	}

	// how much wax covers the point: each blob adds r² / distance², so blobs close together merge
	fn wax_field(at: vec2f, t: f32, pointer: vec2f, pressed: bool) -> f32 {
		var field = 0.0;
		for (var i = 0; i < BLOBS; i++) {
			let b = blob(f32(i), t);
			let away = at - b.xy;
			field += b.z * b.z / max(dot(away, away), 1e-4);
		}
		if (pressed) {
			let away = at - pointer;
			field += 0.03 / max(dot(away, away), 1e-4);
		}
		return field;
	}

	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let scale = 2.0 / $size.y;
		let middle = 0.5 * $size;
		// y up from the middle: pixel rows count from the top
		let p = (floor(at.xy) - middle) * vec2f(scale, -scale);
		let pointer = ($mouse - middle) * vec2f(scale, -scale);
		let field = wax_field(p, $time, pointer, $mouse_down > 0.0);

		let wax = smoothstep(0.95, 1.05, field);
		// hotter (yellower) near the lamp at the bottom, cooler (redder) at the top
		let heat = clamp(0.5 - 0.5 * p.y, 0.0, 1.0);
		let molten = mix(vec3f(0.9, 0.12, 0.08), vec3f(1.0, 0.75, 0.15), heat);
		// the wax glows into the liquid around it and darkens a little toward its edge
		let glow = smoothstep(0.3, 1.0, field);
		let liquid = mix(vec3f(0.03, 0.005, 0.06), vec3f(0.4, 0.06, 0.2), glow * glow);
		let edge = 1.0 - 0.35 * smoothstep(1.0, 3.0, field);
		var color = mix(liquid, molten * (1.2 - 0.2 * edge), wax);
		// the glass: darker toward its sides
		color *= 1.0 - 0.6 * pow(abs(p.x) / (middle.x * scale), 3.0);
		return vec4f(pow(clamp(color, vec3f(0.0), vec3f(1.0)), vec3f(1.0 / 2.2)), 1.0);
	}
}
# ten seconds in a window; without one, one still (shown_frames, decision on-frame-headless)
shown_frames(() => paint(lamp), 10000)
