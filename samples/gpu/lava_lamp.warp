#!/usr/bin/env warp
# a compute.toys shader runs as it is: `compute_toy(shader { … })` of `use compute_toys` takes a single-pass
# compute.toys kernel, main_image writing textureStore(screen, id.xy, color), and makes it a WGSL shader for paint.
# This one is a lava lamp: seven blobs of wax rise and sink on slow loops of their own, melting into each other where
# their fields add up; a press puts one more blob under the pointer, the wheel adds wax or takes it away
# (compute.toys' mouse.zoom). More compute.toys shaders that run with warp:
# https://github.com/pannous/shaders (folder warp/compute_toys)
use compute_toys
lamp = compute_toy(shader {
	const BLOBS = 7;

	// blob number index at time t: its center (x, y) and its radius (z)
	fn blob(index: f32, t: f32) -> float3 {
		let pace = 0.11 + 0.05 * index;
		let x = 0.45 * sin(t * pace * 1.3 + index * 2.4);
		let y = 0.75 * sin(t * pace + index * 1.7);
		return float3(x, y, (0.13 + 0.06 * fract(index * 0.618)) * clamp(mouse.zoom, 0.5, 2.0));
	}

	// how much wax covers the point: each blob adds r² / distance², so blobs close together merge
	fn wax_field(at: float2, t: f32, pointer: float2, pressed: bool) -> f32 {
		var field = 0.0;
		for (var i = 0; i < BLOBS; i++) {
			let b = blob(f32(i), t);
			let away = at - b.xy;
			field += b.z * b.z / max(dot(away, away), 1e-4);
		}
		if (pressed) {
			let away = at - pointer;
			field += 0.03 / max(dot(away, away), 1e-4);
		}
		return field;
	}

	@compute @workgroup_size(16, 16)
	fn main_image(@builtin(global_invocation_id) id: vec3u) {
		let screen_size = textureDimensions(screen);
		if (id.x >= screen_size.x || id.y >= screen_size.y) { return; }
		let scale = 2.0 / f32(screen_size.y);
		let middle = 0.5 * float2(screen_size);
		// y up from the middle: compute.toys counts pixel rows from the top
		let at = (float2(id.xy) - middle) * float2(scale, -scale);
		let pointer = (float2(mouse.pos) - middle) * float2(scale, -scale);
		let field = wax_field(at, time.elapsed, pointer, mouse.click > 0);

		let wax = smoothstep(0.95, 1.05, field);
		// hotter (yellower) near the lamp at the bottom, cooler (redder) at the top
		let heat = clamp(0.5 - 0.5 * at.y, 0.0, 1.0);
		let molten = mix(float3(0.9, 0.12, 0.08), float3(1.0, 0.75, 0.15), heat);
		// the wax glows into the liquid around it and darkens a little toward its edge
		let glow = smoothstep(0.3, 1.0, field);
		let liquid = mix(float3(0.03, 0.005, 0.06), float3(0.4, 0.06, 0.2), glow * glow);
		let edge = 1.0 - 0.35 * smoothstep(1.0, 3.0, field);
		var color = mix(liquid, molten * (1.2 - 0.2 * edge), wax);
		// the glass: darker toward its sides
		color *= 1.0 - 0.6 * pow(abs(at.x) / (middle.x * scale), 3.0);
		textureStore(screen, id.xy, float4(color, 1.0));
	}
})
# ten seconds by the clock, however long a frame takes
started = clock()
while clock() - started < 10000 {
	paint(lamp)
	sleep(1 / 60)
}
