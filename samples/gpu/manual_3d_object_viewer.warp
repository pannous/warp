#!/usr/bin/env warp
# A 3D model from a Wavefront .obj text, spun and shaded on the GPU. warp reads the model (`v x y z` corners, `f a b c …`
# faces, a face of more corners split into triangles), viewer casts a ray through every pixel against the triangles,
# the nearest one hit is lit by its normal. viewer is plain warp: paint compiles it to a shader, its lists of 3 numbers
# to vectors
use graphics
use math
house = "# a house: walls, a gable roof, a chimney
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v  0  2 -1
v  0  2  1
v  0.4 1 -0.3
v  0.7 1 -0.3
v  0.7 1  0.3
v  0.4 1  0.3
v  0.4 2 -0.3
v  0.7 2 -0.3
v  0.7 2  0.3
v  0.4 2  0.3
f 1 2 3 4
f 6 5 8 7
f 5 1 4 8
f 2 6 7 3
f 5 6 2 1
f 4 3 9
f 7 8 10
f 3 7 10 9
f 8 4 9 10
f 11 12 16 15
f 13 14 18 17
f 12 13 17 16
f 14 11 15 18
f 15 16 17 18"

# the corners of every triangle, three by three: `v` lines are the points, `f` lines index them from 1 (`3/1/2`: the
# point before the slash)
def triangles(obj) {
	points = []
	corners = []
	for line in obj.split("\n") {
		words = line.split(" ").filter(word => word)
		if #words > 0 and words#1 == "v" { points = points + [[float(words#2), float(words#3), float(words#4)]] }
		if #words > 3 and words#1 == "f" {
			face = words.filter(word => word != "f").map(word => points#int(word.split("/")#1))
			for i in 2 to #face - 1 { corners = corners + [face#1, face#i, face#(i + 1)] }
		}
	}
	corners
}

mesh: [vec3] = triangles(house)
size = 256
camera_tilt = 0.45
global angle = 0.0
count = #mesh

# the camera turns around the model instead of the model around itself: same picture, one rotation per pixel
turned(p, turn, tilt) := {
	leaned = [p.x, cosine(tilt) * p.y + sine(tilt) * p.z, cosine(tilt) * p.z - sine(tilt) * p.y]
	[cosine(turn) * leaned.x - sine(turn) * leaned.z, leaned.y, sine(turn) * leaned.x + cosine(turn) * leaned.z]
}
viewer(x, y) := {
	uv = [x / size - 0.5, 0.5 - y / size]
	origin = turned([0, 0.3, 6], angle, camera_tilt)
	ray = normalize(turned([uv.x * 1.1, uv.y * 1.1, -1], angle, camera_tilt))
	nearest = 1e9
	normal = [0, 0, 0]
	for i in 0 ..< count / 3 {
		a = mesh#(3 * i + 1)
		ab = mesh#(3 * i + 2) .- a
		ac = mesh#(3 * i + 3) .- a
		p = cross(ray, ac)
		det = dot(ab, p)
		s = origin .- a
		q = cross(s, ab)
		u = dot(s, p) / det
		v = dot(ray, q) / det
		t = dot(ac, q) / det
		if abs(det) > 1e-6 and u >= 0 and v >= 0 and u + v <= 1 and t > 0 and t < nearest {
			nearest = t
			normal = normalize(cross(ab, ac))
		}
	}
	if nearest > 1e8 { [0.10, 0.12, 0.18 + 0.2 * uv.y + 0.1] } else {
		facing = if dot(normal, ray) > 0 then 0 .- normal else normal
		sun = normalize([0.5, 0.8, 0.6])
		light = max(dot(facing, sun), 0) + 0.35 * max(-dot(facing, sun), 0)
		[0.95, 0.62, 0.30] .* (0.25 + 0.7 * light)
	}
}
for frame in 1..90 {
	angle = frame * 0.07
	paint(viewer, size, size)
	sleep(10ms)
}
