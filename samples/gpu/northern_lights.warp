#!/usr/bin/env warp
# Northern lights over a frozen lake. Curtains of light hang from wavy lines that drift with time, each in its own
# color. Stars twinkle behind them, hills stand in front, and the lake below mirrors it all.
# The wheel makes the lights stronger or fainter.
lights = shader {
	const CURTAINS = 4;

	// smooth noise: the hashes of the four corners of the cell, blended
	fn noise(p: vec2f) -> f32 {
		let cell = floor(p);
		let inside = fract(p);
		let blend = inside * inside * (3 - 2 * inside);
		let bottom = mix(hash(cell), hash(cell + vec2f(1, 0)), blend.x);
		let top = mix(hash(cell + vec2f(0, 1)), hash(cell + vec2f(1, 1)), blend.x);
		return mix(bottom, top, blend.y);
	}

	// the hills' height at x: two octaves of noise
	fn ridge(x: f32) -> f32 {
		return -.17 + .12 * noise(vec2f(x * 2, 3)) + .05 * noise(vec2f(x * 7, 9));
	}

	// light of curtain number index at the point: brightest just above its wavy hem, fading upward
	fn curtain(at: vec2f, index: f32, t: f32) -> f32 {
		let drift = t * (.05 + .02 * index);
		let hem = .22 + .07 * index + .15 * sin(at.x * (1.5 + index * .4) + drift * 6)
			+ .08 * noise(vec2f(at.x * 3 + drift * 4, index * 7));
		let above = at.y - hem;
		if (above < 0) { return exp(above * 40) * .4; }
		let rays = .3 + .7 * noise(vec2f(at.x * 40 + index * 13, t * .6));
		return exp(-above * (9 + 2 * index)) * rays;
	}

	fn sky(at: vec2f, t: f32) -> vec3f {
		var color = mix(vec3f(.01, .02, .06), vec3f(0, 0, .02), clamp(at.y, 0, 1));
		// stars: one cell in a few holds one, twinkling at a pace of its own
		let cell = floor(at * 300);
		let star = hash(cell);
		if (star > .996) {
			color += vec3f(.8) * (.6 + .4 * sin(t * 3 + star * 90));
		}
		let hues = array<vec3f, CURTAINS>(vec3f(.1, 1, .45), vec3f(.15, .8, .9), vec3f(.6, .3, 1), vec3f(1, .25, .5));
		for (var i = 0; i < CURTAINS; i++) {
			color += hues[i] * curtain(at, f32(i), t) * .6 * clamp(pow(1.05, $mouse_wheel), .2, 3);
		}
		return color;
	}

	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		// y counts up from the horizon, two thirds of the way down
		let pixel = floor(at.xy);
		let p = vec2f(pixel.x - .5 * $size.x, .65 * $size.y - pixel.y) / $size.y;
		let t = $time;
		var color: vec3f;
		if (p.y >= 0) {
			color = sky(p, t);
			if (p.y < ridge(p.x) + .2) { color = vec3f(.005, .01, .02); }
		} else {
			// the lake mirrors the sky, darker and rippled
			let ripple = .004 * sin(p.y * 300 + t * 2);
			let mirrored = vec2f(p.x + ripple, -p.y);
			color = sky(mirrored, t) * .45;
			if (mirrored.y < ridge(mirrored.x) + .2) { color = vec3f(.004, .008, .015); }
		}
		return vec4f(pow(clamp(color, vec3f(0.0), vec3f(1.0)), vec3f(1.0 / 2.2)), 1.0);
	}
}
# every frame until the window closes
on frame: paint(lights)
on key: exit
