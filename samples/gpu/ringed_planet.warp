#!/usr/bin/env warp
# A ringed planet lit by a sun on the left. Each pixel sends a ray that may hit the planet, a ball, or its rings,
# a flat disc with a hole. The planet's stripes drift, the rings shade the planet and the planet shades the rings.
# Move the pointer to fly around the planet and tilt the rings; the wheel zooms in and out.
# Full HD, so each star is one pixel.
use shown_frames
width = 1920
height = 1080
planet = shader {
	const PLANET = 1.0;
	const RING_INNER = 1.45;
	const RING_OUTER = 2.6;

	// distance along the ray to the sphere, or -1 when it misses
	fn hit_planet(origin: vec3f, toward: vec3f) -> f32 {
		let b = dot(origin, toward);
		let c = dot(origin, origin) - PLANET * PLANET;
		let disc = b * b - c;
		if (disc < 0.0) { return -1.0; }
		return -b - sqrt(disc);
	}

	// distance along the ray to the ring plane (y = 0) inside the rings, or -1
	fn hit_rings(origin: vec3f, toward: vec3f) -> f32 {
		if (abs(toward.y) < 1e-5) { return -1.0; }
		let along = -origin.y / toward.y;
		let radius = length((origin + along * toward).xz);
		if (along < 0.0 || radius < RING_INNER || radius > RING_OUTER) { return -1.0; }
		return along;
	}

	// how much light the rings let through at this radius: gaps, dense and thin lanes
	fn ring_density(radius: f32) -> f32 {
		let across = (radius - RING_INNER) / (RING_OUTER - RING_INNER);
		let lanes = 0.55 + 0.45 * sin(across * 70.0) * sin(across * 23.0 + 1.0);
		let gap = smoothstep(0.02, 0.0, abs(across - 0.62));
		return clamp(lanes * (1.0 - gap) * smoothstep(0.0, 0.05, across) * smoothstep(1.0, 0.9, across), 0.0, 1.0);
	}

	fn planet_color(point: vec3f, t: f32) -> vec3f {
		// bands by latitude, bent a little by a slow wave that travels around
		let longitude = atan2(point.z, point.x) + t * 0.15;
		let latitude = point.y + 0.04 * sin(longitude * 3.0 + point.y * 9.0);
		let band = 0.5 + 0.5 * sin(latitude * 18.0) * cos(latitude * 7.0);
		let storm = smoothstep(0.12, 0.0, length(vec2f(longitude % 6.2831853 - 2.0, (point.y + 0.35) * 2.0)));
		let cream = vec3f(0.92, 0.82, 0.62);
		let rust = vec3f(0.68, 0.38, 0.2);
		return mix(mix(rust, cream, band), vec3f(0.8, 0.3, 0.15), storm);
	}

	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let size = $size;
		let pixel = floor(at.xy);
		// the pointer, from 0 to 1 across and down; it starts in the middle
		let pointer = select($mouse / size, vec2f(0.5, 0.45), $mouse.x <= 0.0 && $mouse.y <= 0.0);
		let around = (pointer.x - 0.5) * 4.0;
		let tilt = 0.08 + (pointer.y - 0.2) * 0.8;
		let distance = clamp(6.0 / pow(1.05, $mouse_wheel), 2.2, 30.0);
		let eye = distance * vec3f(sin(around) * cos(tilt), sin(tilt), -cos(around) * cos(tilt));
		let forward = normalize(-eye);
		let right = normalize(cross(vec3f(0.0, 1.0, 0.0), forward));
		let up = cross(forward, right);
		// flip y so it points up: pixel rows count from the top
		let p = (pixel - 0.5 * size) / size.y * vec2f(1.0, -1.0);
		let ray = normalize(forward * 1.6 + p.x * right + p.y * up);
		let sun = normalize(vec3f(-1.0, 0.3, -0.25));
		let t = $time;

		// the sky: stars, sparse and faint
		let star = hash(pixel);
		var color = vec3f(0.004, 0.006, 0.015) + vec3f(select(0.0, 0.8, star > 0.9985));

		let planet_at = hit_planet(eye, ray);
		let rings_at = hit_rings(eye, ray);
		if (planet_at > 0.0) {
			let point = eye + planet_at * ray;
			let normal = normalize(point);
			var light = max(dot(normal, sun), 0.0);
			// the rings' shadow: the sun's ray from this point through the ring plane
			let shade_at = hit_rings(point, sun);
			if (shade_at > 0.0) {
				light *= 1.0 - 0.8 * ring_density(length((point + shade_at * sun).xz));
			}
			let rim = pow(1.0 - max(dot(normal, -ray), 0.0), 3.0);
			color = planet_color(point, t) * (0.03 + light) + vec3f(0.25, 0.35, 0.6) * rim * light;
		}
		// rings in front of the planet, or with nothing behind them
		if (rings_at > 0.0 && (planet_at < 0.0 || rings_at < planet_at)) {
			let point = eye + rings_at * ray;
			let density = ring_density(length(point.xz));
			// the planet's shadow on the rings
			let lit = select(1.0, 0.05, hit_planet(point, sun) > 0.0);
			let dust = mix(vec3f(0.55, 0.5, 0.45), vec3f(0.85, 0.75, 0.6), density);
			color = mix(color, dust * (0.05 + 0.95 * lit), density * 0.9);
		}
		return vec4f(pow(clamp(color, vec3f(0.0), vec3f(1.0)), vec3f(1.0 / 2.2)), 1.0);
	}
}
# ten seconds in a window; without one, one still (shown_frames, decision on-frame-headless)
shown_frames(() => paint(planet), 10000)
