#!/usr/bin/env warp
// A signal computed a block at a time (sound layer 8): warp hands chord a block of 512 samples to fill, t the time of
// its first one, once every 23 ms; one call a block instead of one a sample
use sound
chord(block, t) := for i in 1 to #block {
	time = t + (i - 1) / sample_rate
	block#i = 0.2 * (sin(2 * pi * 262 * time) + sin(2 * pi * 330 * time) + sin(2 * pi * 392 * time))
}
play_blocks(chord, 3s)
