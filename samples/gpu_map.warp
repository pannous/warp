#!/usr/bin/env warp
// @gpu: a map of a heavy lambda (math words) runs as a WGSL kernel over every item at once; sum, min and max of it
// read back only one partial result per workgroup. Without a GPU adapter the same lines run on the CPU.
// The GPU computes in f32: its sum differs from the CPU's in the 7th digit
// TODO: Danger: Don't we have the logic to automatically switch to GPU if the array is tall enough? 
n = 1000000
xs = float[n]
for i in 1 to n { xs#i = i / n }

t0 = clock()
on_cpu = sum(xs.map(x => sin(x) * exp(x) + cos(x * 3)))
t1 = clock()
on_gpu = sum(xs.map(x => sin(x) * exp(x) + cos(x * 3)) @gpu)
t2 = clock()
print "sum of \(n) items: CPU \(on_cpu) in \(t1 - t0) ms, GPU \(on_gpu) in \(t2 - t1) ms"

ys = xs.map(x => sin(x) * exp(x) + cos(x * 3)) @gpu
t3 = clock()
print "the mapped list itself back from the GPU: \(t3 - t2) ms, last item \(ys#n)"

// ys was read on the CPU above, but its buffer also stayed on the GPU: this map starts from there, without an upload
zs = ys.map(y => exp(sin(y)) + cos(y * 2)) @gpu
t4 = clock()
print "mapped again on the GPU from the kept buffer: \(t4 - t3) ms, last item \(zs#n)"
