#!/usr/bin/env warp
# Iterators: any object whose class has next() walks in a for loop until next() gives ø

class Countdown {
	n: int
	next() := { if n <= 0 { return ø }; n -= 1; n + 1 }
}

for x in Countdown(3) { print x }   # 3 2 1

# one step at a time
c = Countdown(2)
print c.next()                      # 2
print c.next()                      # 1
print c.next()                      # ø

# break and continue work as in any loop
sum = 0
for x in Countdown(5) { if x == 4 { continue }; sum += x }
sum                                 # 11
