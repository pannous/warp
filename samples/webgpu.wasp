#!/usr/bin/env warp
// WebGPU: a WGSL fragment shader colors every pixel on the GPU (gpu_render gives the pixels), paint shows each frame
size = 128
for frame in 1..30 {
	shader = "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	let uv = at.xy / \(size).0;
	let rings = 0.5 + 0.5 * cos(length(uv - 0.5) * 40.0 - \(frame).0 * 0.3);
	return vec4f(uv.x, rings, uv.y, 1.0);
}"
	paint(gpu_render(shader, size, size), size, size)
	sleep 40 ms
}
