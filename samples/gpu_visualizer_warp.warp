#!/usr/bin/env warp
// warp functions compiled to a GPU shader: paint(tunnel, width, height) turns tunnel and the functions it calls into one
// WGSL fragment shader, which raymarches 16 glowing frequency bars around a pulsing gem frame after frame while
// mozart.mp3 plays. Vectors are lists of 2 to 4 numbers, .+ .- .* ./ .^ their element-wise math, p.x p.zy their
// components; the functions read the program's levels, bass, treble and time
use sound
use math
use os
width = 1920
height = 1080
bands = 16
// any wav, mp3, ogg, flac, aiff or m4a file plays and lights the bars the same
song = "mozart.mp3"
// how much the quiet spectrum is turned up before it lights the bars
loudness = 15
// the shortest frame: a frame that took less waits for the rest
frame_milliseconds = 16
// how fast the eye flies down the tunnel, and the most steps of a ray
speed = 3.0
most_steps = 110

// what the shader reads, set each frame
global levels = [0.0 as float for band in 0..bands]
global bass = 0.0
global treble = 0.0
global time = 0.0

// the level of band b (0 … 15, any whole number wraps around)
band_level(b) := levels#((b - bands * floor(b / bands)) as int + 1)
turned(p, angle) := [cosine(angle) * p.x - sine(angle) * p.y, sine(angle) * p.x + cosine(angle) * p.y]
hue(h) := 0.5 .+ 0.5 .* [cosine(tau * h), cosine(tau * (h + 0.33)), cosine(tau * (h + 0.67))]
gem_center() := [0.6 * sine(time * 0.7), 0.4 * cosine(time * 0.9), time * speed + 5 - 1.2 * bass]

// a point seen from the twisting bars: across its bar, from the axis, along its ring, its band
// beside: 0 for the point's own bar, -1 and 1 for its neighbors
bar_space(p, beside) := {
	q = turned(p.xy, p.z * 0.12 + time * 0.4)
	sector = (atan2(q.y, q.x) / tau + 0.5) * bands
	across = (fract(sector) - 0.5 - beside) * tau / bands * norm(q)
	[across, norm(q), p.z - 1.5 * round(p.z / 1.5), floor(sector) + beside]
}

bar_distance(p, beside) := {
	bars = bar_space(p, beside)
	box = [abs(bars.x) - 0.42, 2.9 - band_level(bars.w) * 1.9 - bars.y, abs(bars.z) - 0.55]
	norm([max(box.x, 0), max(box.y, 0), max(box.z, 0)]) + min(max(box.x, max(box.y, box.z)), 0) - 0.04
}

// the distance to the nearest surface and its band, -1 for the gem
scene(p) := {
	own = bar_space(p, 0)
	bar = min(bar_distance(p, 0), min(bar_distance(p, -1), bar_distance(p, 1)))
	local = p .- gem_center()
	flat = turned(local.xz, time * 1.3)
	spin = [flat.x, flat.y, local.y]
	ripple = sine(7 * spin.x + time * 4) * sine(7 * spin.y) * sine(7 * spin.z) * (0.06 + 0.25 * treble)
	gem = norm(local) - (0.55 + 0.8 * bass) + ripple
	if gem < bar then [gem * 0.7, -1] else [bar * 0.8, own.w]
}

distance_at(p) := {
	hit = scene(p)
	hit#1
}

normal_at(p) := {
	nudge = 0.002
	dx = distance_at(p .+ [nudge, 0, 0]) - distance_at(p .- [nudge, 0, 0])
	dy = distance_at(p .+ [0, nudge, 0]) - distance_at(p .- [0, nudge, 0])
	dz = distance_at(p .+ [0, 0, nudge]) - distance_at(p .- [0, 0, nudge])
	normalize([dx, dy, dz])
}

gem_surface(n, ray, rim, tint) := {
	reflected = reflect(ray, n)
	mirrored = hue(atan2(reflected.y, reflected.x) / tau + 0.5 + time * 0.2)
	sparkle = max(dot(reflected, normalize([0.5, 0.8, 0.3])), 0) ^ 24
	mirrored .* mirrored .* (0.2 + rim * 1.8) .+ sparkle .+ tint .* (rim * 0.6)
}

bar_surface(p, band_hit, diffuse, rim, tint) := {
	lit = band_level(band_hit)
	bars = bar_space(p, 0)
	edge = 1 - smoothstep(0, 0.05, min(0.46 - abs(bars.x), 0.59 - abs(bars.z)))
	pulse = (0.5 + 0.5 * sine(p.z * 0.7 - time * 9)) ^ 12 * (0.3 + 5 * bass)
	shade = 0.04 + diffuse * (0.1 + 0.6 * lit) + 1.4 * lit * lit
	tint .* tint .* shade .+ tint .* (rim * (0.1 + lit)) .+ (tint .+ 0.3) .* (edge * (0.15 + 2.5 * lit)) .+ tint .* pulse
}

// the color where the ray meets a surface at p
surface(p, ray, hit, tint) := {
	n = normal_at(p)
	diffuse = max(dot(n, normalize(gem_center() .- p)), 0)
	rim = (1 - max(0 - dot(n, ray), 0)) ^ 3
	if hit#2 < 0 then gem_surface(n, ray, rim, tint) else bar_surface(p, hit#2, diffuse, rim, tint)
}

tunnel(x, y) := {
	uv = [(x - width / 2) / height, (height / 2 - y) / height] .* (1 - 0.15 * bass)
	eye = [0.4 * sine(time * 0.5), 0.3 * cosine(time * 0.6), time * speed]
	ahead = normalize(gem_center() .- eye)
	side = normalize(cross([0, 1, 0], ahead))
	ray = normalize(ahead .+ uv.x .* side .+ uv.y .* cross(ahead, side))
	travelled = 0.0
	glow = [0, 0, 0]
	seen = [0, 0, 0]
	for marched in 1 to most_steps {
		p = eye .+ ray .* travelled
		hit = scene(p)
		tint = if hit#2 < 0 then hue(time * 0.3) else hue(hit#2 / bands + time * 0.05)
		shine = if hit#2 < 0 then 0.1 + 1.5 * bass else 0.05 + 3 * band_level(hit#2)
		glow = glow .+ tint .* tint .* (shine * 0.004 / (0.03 + abs(hit#1) * 10))
		if hit#1 < 0.001 {
			seen = surface(p, ray, hit, tint)
			break
		}
		travelled = travelled + hit#1
		if travelled > 40 { break }
	}
	lit = seen .* exponential(-0.06 * travelled) .+ glow .* (0.6 + 1.5 * bass)
	vignetted = lit .* (1 - 0.35 * dot(uv, uv))
	(vignetted ./ (1 .+ vignetted)) .^ 0.85
}

on key {
	if key == ESC { exit() }
}

// the whole song, or as many seconds as the command line gives: `warp gpu_visualizer_warp.warp 3`; measuring it decodes
// the song before it plays, so the first frame keeps up with the music
seconds = if count(args) > 0 then min(args#1 as number, sound_seconds(song)) else sound_seconds(song)
play song
started = clock()
while time < seconds {
	frame_started = clock()
	levels = [min(1.0, sqrt(level * loudness)) for level in spectrum(song, time, bands)]
	bass = (levels#1 + levels#2 + levels#3 + levels#4) / 4
	treble = (levels#11 + levels#12 + levels#13 + levels#14) / 4
	paint(tunnel, width, height)
	sleep(max(0, frame_milliseconds - (clock() - frame_started)) / 1000)
	time = (clock() - started) / 1000.0
}
