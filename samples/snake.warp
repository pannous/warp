// Snake Game
// Classic arcade game, playing itself: the snake steers toward the food (there is no keyboard input yet)
// positions are (x, y) pairs, read with #1 and #2; the game state is global

width = 20
height = 15
global snake = [(10, 7), (9, 7), (8, 7)]
global direction = (1, 0)
global food = (15, 7)
global score = 0
global game_over = false
global foods_eaten = 0

// the next food: a fixed walk over the board, so every game is the same
def spawn_food() {
    for attempt in 1 to width * height {
        x = (foods_eaten * 7 + attempt * 3) % width
        y = (foods_eaten * 5 + attempt * 11) % height
        if not ((x, y) in snake) { return (x, y) }
    }
    return (0, 0)
}

def is_free(position) {
    x = position#1
    y = position#2
    return x >= 0 and x < width and y >= 0 and y < height and not (position in snake)
}

// turn toward the food, never into a wall or itself when another way is free
def steer() {
    head = snake#1
    wanted = direction
    if food#1 > head#1 { wanted = (1, 0) }
    if food#1 < head#1 { wanted = (-1, 0) }
    if food#1 == head#1 and food#2 > head#2 { wanted = (0, 1) }
    if food#1 == head#1 and food#2 < head#2 { wanted = (0, -1) }
    for option in [wanted, direction, (0, 1), (0, -1), (1, 0), (-1, 0)] {
        if is_free((head#1 + option#1, head#2 + option#2)) {
            direction = option
            return direction
        }
    }
    return direction
}

def update() {
    head = snake#1
    new_head = (head#1 + direction#1, head#2 + direction#2)
    if not is_free(new_head) {
        game_over = true
        return 0
    }
    snake = [new_head] + snake
    if new_head == food {
        score = score + 10
        foods_eaten = foods_eaten + 1
        food = spawn_food()
    } else {
        snake = snake.slice(0, count(snake) - 1)
    }
    return 1
}

def render() {
    for y in 0..height {
        line = ""
        for x in 0..width {
            cell = "."
            if (x, y) == food { cell = "*" }
            if (x, y) in snake { cell = "o" }
            if (x, y) == snake#1 { cell = "@" }
            line = line + cell
        }
        print line
    }
    print "Score: " + str(score)
}

// each turn a frame: in the playground what a frame prints replaces the last one after the sleep
for turn in 1 to 60 {
    if not game_over {
        steer()
        update()
    }
    render()
    sleep 50 ms
}
if game_over { print "GAME OVER" }
score
