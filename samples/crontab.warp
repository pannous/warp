#!/usr/bin/env warp
// The cron table, read only (card read-chron): `warp samples/crontab.warp` shows it in a window (its value is an html page).
// A job is its schedule (five fields, or one like @reboot) and the command after it; comments and settings (PATH=…) are no jobs.
// The schedule reads as words (every 10 minutes, daily at 06:35), the log file the output goes to gets a column of its own.
fields(line) := split(line, " ")
is_job(line) := line != "" and not line.starts_with("#") and not fields(line)#1.contains("=")
schedule_size(job) := if job.starts_with("@") then 1 else 5
schedule(job) := fields(job)[0..schedule_size(job)]
run(job) := join(fields(job)[schedule_size(job)..], " ")
command(job) := trim(split(run(job), " >")#1)
logged(job) := count(split(run(job), " >")) > 1
log(job) := if not logged(job) then "" else trim(replace(replace(split(run(job), " >")#2, "2>&1", ""), ">", ""))
file_name(path) := last(split(path, "/"))

padded(number) := if size(number) < 2 then "0" + number else number
repeated(step, unit) := "every " + step + " " + unit
listed(values) := join(values, ", ")
weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
weekday(number) := if size(number) == 1 then weekdays#(int(number) + 1) else number
// minute and hour: an `*/n` step, a list of values or `*`
time_of_day(minute, hour) := if minute.starts_with("*/") and hour == "*" then repeated(minute[2..], "minutes")
else if minute == "*" and hour == "*" then "every minute"
else if hour == "*" then "hourly at " + listed([":" + padded(m) for m in split(minute, ",")])
else if hour.starts_with("*/") then repeated(hour[2..], "hours") + " at :" + padded(minute)
else "daily at " + listed([padded(h) + ":" + padded(minute) for h in split(hour, ",")])
// day of month, month and weekday narrow the days; `*` is any
narrowed(field, words) := if field == "*" then "" else words + field
days(day, month, week) := (if week == "*" then "" else " on " + listed([weekday(w) for w in split(week, ",")])) + narrowed(day, " on day ") + narrowed(month, " in month ")
when(job) := if job.starts_with("@reboot") then "at startup"
else if job.starts_with("@") then schedule(job)#1[1..]
else time_of_day(schedule(job)#1, schedule(job)#2) + days(schedule(job)#3, schedule(job)#4, schedule(job)#5)

jobs = [line for line in split(exec sh "crontab -l", "\n") if is_job(line)]
html{ lang: "en"
	style{
		body { font-family: system-ui; margin: 2em; color-scheme: light dark }
		table { border-collapse: collapse }
		th { text-align: left; color: gray; font-weight: 500 }
		td, th { padding: 6px 14px; border-bottom: 1px solid silver; vertical-align: top }
		td.when { white-space: nowrap; font-weight: 500 }
		td.log { white-space: nowrap; color: gray }
		code { white-space: pre-wrap; word-break: break-all }
	}
	body{
		h1{ "cron table" }
		table{
			tr{ th{ "when" } th{ "command" } th{ "log" } }
			for job in jobs {
				tr{
					td{ class: "when" title: join(schedule(job), " ") when(job) }
					td{ code{ command(job) } }
					td{ class: "log" title: log(job) file_name(log(job)) }
				}
			}
		}
	}
}
