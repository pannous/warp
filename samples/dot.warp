#!/usr/bin/env warp
#!/usr/bin/env warp
// dot(xs, ys) is sum(xs .* ys) in one loop, no list of the products. Over two linear float arrays it multiplies and
// adds two pairs at a time in SIMD lanes (f64x2), after checking both have the same length. A dot is too light for
// the GPU: copying the two arrays there costs more than the CPU's whole loop. Float arrays paired by dot or .* live in
// linear memory by themselves, as long as every other use reads, writes or counts their items
n = 1000000
xs = float[n]
ys = float[n]
for i in 1 to n { xs#i = i / n; ys#i = 1 - i / n }

t0 = clock()
d = dot(xs, ys)
d1 = xs * ys
assert d1 == d
t1 = clock()
print "dot of \(n) items: \(d) in \(t1 - t0) ms (about n/6)"

zs = xs .* ys
print "xs .* ys pairs the items: \(#zs) products, the middle one \(zs#(n//2))"
