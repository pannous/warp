#!/usr/bin/env warp
@primitive
# C functions of lib/c.warp and lib/math.warp: `GREETING=Hi warp c_calls.warp`, or natively
# `warp build native c_calls.warp`, then `GREETING=Hi ./c_calls`
import (getenv, strlen) from "c"
import hypot from "m"
greeting = getenv("GREETING")
print greeting
print text_of(strlen(greeting))
print text_of(hypot(3.0, 4.0) as i64)
