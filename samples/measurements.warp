// Measurements with uncertainty: x ± r is an interval that flows through arithmetic
length = 6.0 ± 0.3
width = 2.0 ± 0.2
area = length * width
print "area: " + str(area) + " m²"
print "between " + str(area.low) + " and " + str(area.high)

// a comparison answers only when the whole interval agrees
big = area certainly > 10
maybe_huge = area possibly > 14
if big then print "certainly more than 10 m²"
if maybe_huge then print "possibly more than 14 m²"

// functions map the whole interval too: the swing of a pendulum this long
pendulum = 2.0 ± 0.01
period = 2 * π * √(pendulum / 9.81)
print "period: " + str(period) + " s"
// with units, ± converts its spread into the value's unit and carries both through Quantity arithmetic
rope = 5 m ± 1 cm
print "two ropes: " + str(rope * 2)
print "area about " + str(area.value) + " m²"
// the program's value: a quantity shows its text, as str() gives it
room = (5 m ± 1 cm) * (2 m ± 1 cm)
room
