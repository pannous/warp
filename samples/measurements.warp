// Measurements with uncertainty: x ± r is an interval that flows through arithmetic
length = 6.0 ± 0.3
width = 2.0 ± 0.2
area = length * width
print "area: " + str(area) + " m²"
print "between " + str(area.low) + " and " + str(area.high)

// a comparison answers only when the whole interval agrees
big = area certainly > 10
maybe_huge = area possibly > 14
if big then print "certainly more than 10 m²"
if maybe_huge then print "possibly more than 14 m²"

// functions map the whole interval too: the swing of a pendulum this long
pendulum = 2.0 ± 0.01
period = 2 * π * √(pendulum / 9.81)
print "period: " + period + " s"
// with units, ± converts its spread into the value's unit and carries both through Quantity arithmetic
rope = 5m ± 1cm
print "two ropes: " + str(rope * 2)
# print "two ropes: " + rope * 2 // TODO Error("wasm trap: cast failure")
print "with a 20 cm knot: " + str(rope + 20cm)  // the exact 20 cm adds no spread
print "pulled in 2 s: " + str(rope / 2s)
// one function serves a quantity and a plain number alike
twice(x) := x * 2
print "twice: \(twice(rope)) and \(twice(3))"
# print "twice: \{twice(rope)} and \(twice(3))"

print "area about " + area.value + " m²"
// 1σ makes a Gaussian: one standard deviation, independent errors add in quadrature (an interval adds them whole)
mass = 6.0 ± 0.3σ
volume = 2.0 ± 0.2σ
print "density: " + str(mass / volume) + " kg/m³"
// a value met twice is the same error, not a new one
print "mass - mass: " + str(mass - mass)
// the program's value: a quantity shows its text, as str() gives it
room = (5m ± 1cm) * (2m ± 1cm)
room
