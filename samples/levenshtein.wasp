// Levenshtein edit distance via dynamic programming (two-row variant)
fun levenshtein(a, b) {
    let m = a.length
    let n = b.length
    // wasp: `let` binds once (error "prev is let (immutable)"); a reassigned variable is `var prev = []` or plain `prev = []`
    let prev = []
    // wasp: `..` excludes the end (`0..n` is 0…n-1); Kotlin-style inclusive ranges are `0...n` or `0 to n`
    for j in 0..n {
        prev.push(j)
    }
    for i in 1..m {
        let curr = [i]
        for j in 1..n {
            let cost = a[i - 1] == b[j - 1] ? 0 : 1
            let deletion = prev[j] + 1
            let insertion = curr[j - 1] + 1
            let substitution = prev[j - 1] + cost
            curr.push(min(deletion, insertion, substitution))
        }
        prev = curr
    }
    return prev[n]
}

// wasp: `let` binds once (error "prev is let (immutable)"); a changing variable is plain `total = 0` or `var total = 0`
let total = 0
total += levenshtein("kitten", "sitting")   // 3
total += levenshtein("flaw", "lawn")        // 2
total += levenshtein("", "abc")             // 3
total += levenshtein("abc", "abc")          // 0
total += levenshtein("saturday", "sunday")  // 3
total
