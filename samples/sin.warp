#!/usr/bin/env warp
// sin(x) with the polynomial of fdlibm's __kernel_sin: x reduced into [-π, π), then folded into [-π/2, π/2]
float sine(float x){
  turn = 6.283185307179586 as float // 2π
  x = x % turn
  if (x >= turn / 2) x = x - turn
  if (x > turn / 4) return sine(turn / 2 - x)
  if (x < -turn / 4) return sine(-turn / 2 - x)
  S1 = -1.66666666666666324348e-01 as float // 0xBFC55555, 0x55555549
  S2 =  8.33333333332248946124e-03 as float // 0x3F811111, 0x1110F8A6
  S3 = -1.98412698298579493134e-04 as float // 0xBF2A01A0, 0x19C161D5
  S4 =  2.75573137070700676789e-06 as float // 0x3EC71DE3, 0x57B1FE7D
  S5 = -2.50507602534068634195e-08 as float // 0xBE5AE5E6, 0x8A2B9CEB
  S6 =  1.58969099521155010221e-10 as float // 0x3DE5D93A, 0x5ACFD57C
  z = x*x
  w = z*z
  r = S2 + z*(S3 + z*S4) + z*w*(S5 + z*S6)
  return x + z*x*(S1 + z*r)
}
round(sine(1.0) * 1000000) // 841471
