#!/usr/bin/env warp
// Hold the arrow keys to move the dot, Escape ends (in the playground: click the canvas first)
use draw
canvas(320, 240)
x = 160
y = 120
// each frame of the window, until it closes (headless: one frame)
on frame {
	if held_key == ESC: exit()
	if held_key == LEFT { x -= 4 }
	if held_key == RIGHT { x += 4 }
	if held_key == UP { y -= 4 }
	if held_key == DOWN { y += 4 }
	clear(white)
	circle(x, y, 10, red)
	label(10, 20, "held: " + held_key, black)
	show()
}
