// A field typed with a unit holds a quantity (card unit-fields); stored, its column keeps the unit (NUMERIC km), so a
// class changed to `distance: m` keeps every distance, and a change to another quantity is a loud error. An optional unit
// field (`climb: m?`) is a nullable column: a run may have no climb (ø).

class Run{distance: km; note: text; climb: m?}
stored runs: [Run]

if count(runs) == 0 {
	runs.add(Run(5 km, "park", 120 m))
	runs.add(Run(1500 m, "track", ø))  // any length unit: the row holds the amount
}

total = 0 km
for run in runs { total += run.distance }
print "total: " + total
print "or " + (total as km)  // a conversion joins a text in its unit
print "average: " + average(runs.map(r => r.distance))  // a decimal in the field's unit, mean without `use`
print "flat runs: " + count(runs where it.climb == ø)
runs#2.distance
