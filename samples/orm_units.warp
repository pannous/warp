#!/usr/bin/env warp
// A field typed with a unit holds a quantity (card unit-fields); stored, its column keeps the unit (NUMERIC km), so a
// class changed to `distance: m` keeps every distance, and a change to another quantity is a loud error. An optional unit
// field (`climb: m?`) is a nullable column: a run may have no climb (ø).

class Run{distance: km; note: text; climb: m?}
stored runs: [Run]

if count(runs) == 0 {
	runs.add(Run(5km, "park", 120m))
	runs.add(Run(1500m, "track", ø))  // any length unit: the row holds the amount
	runs.add(Run(12km, "river", 80m))
}

total = 0km
for run in runs { total += run.distance }
print "total: " + total
print total as m  // the same amount in another unit
print "or " + (total as km)  // a conversion joins a text in its unit
print "average: " + average(runs.map(r => r.distance))  // a decimal in the field's unit, mean without `use`
print "flat runs: " + count(runs where it.climb == ø)
distances = runs.map(run => run.distance)
print max(distances) as km
print sum(distances) / count(runs) as km  // the average
print count(runs where it.distance > 5km)  // the filter runs in SQLite, on the stored amounts

// each column keeps its own quantity: a speed is a distance over a time
class Ride{distance: km; time: min; load: kg}
stored rides: [Ride]
if count(rides) == 0 {
	rides.add(Ride(10km, 50min, 3kg))
	rides.add(Ride(2km, 20min, 500g))
}
for ride in rides { print ride.distance / ride.time as km/h }
print sum(rides.map(ride => ride.load))
runs#2.distance
