#!/usr/bin/env warp
# A signal computed a block at a time (sound layer 8): warp calls two_tones to fill a block of 512 samples per speaker, t
# the time of the first one, once every 23 ms: one call a block instead of one a sample. Two blocks make it stereo,
# play_blocks(two_tones, linear_address(left_block), 3s) with one would be mono
use sound
linear left_block = float[512]
linear right_block = float[512]
two_tones(t: float) := {
	for i in 1 to #left_block {
		time = t + (i - 1) / sample_rate
		low = sin(2 * pi * 262 * time)
		high = sin(2 * pi * 392 * time)
		left_block#i = 0.4 * low + 0.1 * high
		right_block#i = 0.1 * low + 0.4 * high
	}
	0.0 as float
}
play_blocks(two_tones, [linear_address(left_block), linear_address(right_block)], 3s)
