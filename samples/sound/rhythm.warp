#!/usr/bin/env warp
# Music by beats: note names with sharps and flats in any octave, durations in beats and bars at a tempo.

use sound

tempo = 100                             # beats per minute (120 unless set)
melody([C4 E4 G4 Bb4], beat(1/2))     # a dominant seventh, a half beat each
play([F♯3 A3 C♯4], beat 1)            # F♯ minor, written F♯3 or Fs3
melody([D5 C♯5 B4 A4 G♯4], beat(1/4))
play([E3 G♯3 B3 D4], bar 1)           # four beats
wait_sound()
