#!/usr/bin/env warp
# Patterns and live loops on the beat clock: Tidal's mini-notation, one cycle per bar, loops as voices.

use sound

tempo = 110
bass() := pattern "c3 ~ [c3 c3] <~ c3?>"           # the bass: a bar; the last step alternates
low() := pattern "c2 _ _ e2"                         # c2 holds three steps
offbeat() := pattern("~ g4 ~ g4*2", bar 1)           # the offbeat chords' root
euclid() := pattern("c5(3,8) e5(2,8)", bars 2)       # Euclidean rhythms, 3 and 2 of 8
tune() := pattern "c4 e4 <g4 a4> [b4 c5?]"           # the swung tune, c5 in about half the cycles (pattern_seed)
bass_voice = live_loop(bass, 4)                      # each loop a voice of its own, four bars of the bass
live_loop(low, 4)
live_loop(offbeat, 4)
live_loop(euclid, 2)
swing = 0.6
live_loop(tune, 2)
await bass_voice
wait_sound()
