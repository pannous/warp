#!/usr/bin/env warp
# The signal graph: every sound passes distortion → delay → reverb on its way from the voice to the output.
# The settings at the time of `play` are that sound's sends.

use sound

wave_shape = "sawtooth"
loudness = dB(-9)
melody([A2 C3 E3 A3], beat(1/2))      # dry

delay_time = beat(3/8)                   # echoes, 3/8 of a beat apart
delay_feedback = 0.5                    # each one half as loud as the one before
delay_mix = 0.6
melody([A3 E3 C3 A2], beat(1/2))

delay_time = 0
reverb_mix = 0.3                        # a small room's tail
play(chord(A3, minor), bar 1)

reverb_mix = 0
distortion = 0.8                        # a soft clipper
play(A2, beat 1)
wait_sound()
