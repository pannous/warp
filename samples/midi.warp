#!/usr/bin/env warp
// MIDI (lib/sound.warp): a Standard MIDI File written and read back, and messages to a MIDI device.
// Notes are [start, pitch, length, velocity]: seconds, a note or frequency, seconds, 1 to 127.
// The playground sends through Web MIDI (allow it when the browser asks); the warp command needs `sendmidi`
// (brew install gbevin/tools/sendmidi) and says so when it is missing.

use sound

write_midi("tune.mid", [[0, C4, 0.5, 100], [0.5, E4, 0.5, 90], [1, G4, 1, 80]])
for note in read_midi("tune.mid") { print note }

midi_on C4        // a key down on channel 1, velocity 100
midi_off C4
midi_on(E4, 64, 2)
midi_off(E4, 2)
