#!/usr/bin/env warp
#!/usr/bin/env warp
// WebGPU: a WGSL fragment shader colors every pixel on the GPU; paint renders it and shows each frame.
// `$frame` in the shader is warp's frame, read at each paint: it changes without compiling the shader anew.
// The map given last fills holes itself: `$size` is the vec2 [size, size] here, not the number
use graphics
size = 128*2
rings = shader {
@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	let uv = at.xy / $size;
	let rings = 0.5 + 0.5 * cos(length(uv - 0.5) * 40.0 - $frame * 0.3);
	return vec4f(uv.x, rings, uv.y, 1.0);
	}
}

for frame in 1..120 {
	paint(rings, size, size, {size: [size, size]})
	# sleep 20 ms
}
