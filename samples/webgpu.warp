#!/usr/bin/env warp
// WebGPU: a WGSL fragment shader colors every pixel on the GPU; paint renders it and shows each frame.
// The shader reads the map given last as `values`: the frame changes without compiling the shader anew

# DONE : use graphics Or something to import the names paint / gpu_render   
// `use graphics` is an alias of `use draw` (P234)
# DONE: merge gpu_render into render or even paint? discuss We want elegance, but not black magic. 
// paint takes the shader itself and renders it on the GPU; gpu_render stays for getting the pixels (P234)

size = 128*2
shader = "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	let uv = at.xy / values.size;
	let rings = 0.5 + 0.5 * cos(length(uv - 0.5) * 40.0 - values.frame * 0.3);
	return vec4f(uv.x, rings, uv.y, 1.0);
}"
for frame in 1..30 {
	paint(shader, size, size, {frame: frame, size: [size, size]})
	# sleep 20 ms
}
