#!/usr/bin/env warp
# a million floats doubled on the GPU: `@gpu` compiles the lambda to a compute kernel over every item at once (in f32),
# no shader text, no explicit GPU call; without a GPU adapter the same line runs on the CPU
n = 1000000
started = clock()
xs = float[n]
for i in 1 to n { xs#i = i }
made = clock()
doubled = xs.map(x => x * 2) @gpu
print "list made in \(made - started) ms, \(n) floats doubled on the GPU in \(clock() - made) ms, last \(doubled#n)"
