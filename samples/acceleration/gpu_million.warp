#!/usr/bin/env warp
# a million floats doubled on the GPU: gpu_compute reads and writes the GPU list in place (lib/host/native_host/gpu.warp)
doubling = "@group(0) @binding(0) var<storage, read_write> xs: array<f32>;
@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) { if (id.x < arrayLength(&xs)) { xs[id.x] = xs[id.x] * 2.0; } }"
n = 1000000
started = clock()
xs = [float(i) for i in 0..n]
made = clock()
big = gpu_compute(doubling, xs, n / 64 + 1)
print("list made in ${made - started} ms, 1M floats through the GPU in ${clock() - made} ms, last ${big#n}")
# the same doubling in f16, two bytes a number (`enable f16`, a GPU list [f16]; f16 reaches only 65504)
halves: [f16] = [0.25, 1.5, 1000]
gpu_compute("enable f16;\n" + doubling.replace("f32", "f16").replace("2.0", "2.0h"), halves, 1)
print("in f16: ${halves}")
