#!/usr/bin/env warp
// Matching: a case key describes the value it takes, from plain values to the shape of the data

// Values, alternatives and ranges
age_group(age) := match age {
	0 to 12 => "child"
	13 to 19 => "teen"
	65.. => "senior"
	other => "adult"
}
print age_group(15)

weekend(day) := match day { Saturday | Sunday => yes; other => no }
print weekend(Sunday)

// Types: a type word tests, name: type also names
describe(v) := match v { i: int => i + 1; t: text => t + "!"; _ => "something else" }
print describe(41)
print describe("hi")

// Lists and tuples by shape, the rest with ...
total(xs) := match xs { [] => 0; [first, ...rest] => first + total(rest) }
print total([1, 2, 3])
print match (1, 2) { (1, t) => t; _ => 0 }

// Maps: name only the fields you need, at any depth
response = {status: 200, data: {user: {name: "Ann"}}}
print match response { {status: 200, data: {user: {name}}} => name; {status: 404} => "missing"; _ => "?" }

// Enums: every case named, or the compiler names the missing one
enum Coin { Penny, Nickel, Dime, Quarter }
cents(coin: Coin) := match coin { Penny: 1; Nickel: 5; Dime: 10; Quarter: 25 }
print cents(Dime)

// is tests one pattern and binds its names
pair = [3, 4]
print if pair is [a, b] then a * b else 0
