#!/usr/bin/env warp
// Warp Language Sample

/* Types */
int x = 42
string name = "Hello World"
list numbers = [1, 2, 3]
triple = (1, 2, 3)
// a map (array, tuple and map as declaration words: card declaration-type-words)
data = {key: "value"}
// PI is warp's own constant: a program does not redefine it
float64 ratio = 3.14159
bool flag = true

/* Functions */
fun calculate(a: int, b: real) -> float64 {
    return a + b * 2.0
}

/* Control flow */
if (x > 0) {
    print("Positive")
} else {
    print("Non-positive")
}

/* Collections */
for item in numbers {
    print(item)
}

/* Arithmetic */
result = 2 + 3 * 4 + calculate(1, 2.5)
