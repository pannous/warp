#!/usr/bin/env warp
// a WebGPU music visualizer: a tune plays while a WGSL fragment shader raymarches a tunnel of 16 glowing frequency
// bars around a pulsing gem, every pixel on the GPU, frame after frame (natively a window, in the playground the
// canvas). The shader reads warp's variables through `$name`: $levels (16 bands, the spectrum at this moment),
// $bass, $treble, $kick (a beat: a band got louder), $tone (the loudest band's hue), $time; $size is built in
use sound
width = 1920
height = 1080
bands = 16
// each band is measured against its own recent peak, which fades this much per frame: quiet bands still reach the top
peak_fade = 0.995
// below this a band is silence, not a quiet sound turned up
quietest = 0.02
// how much of last frame's level stays when the sound gets quieter
fall = 0.8
// how much of the kick stays per frame, and how much rise across all bands is a full kick
kick_fade = 0.85
full_kick = 3.0
frame_milliseconds = 16

tune = [C4 E4 G4 [C4 E4 G4] A4 G4 E4 [C3 G3 C4] D4 F4 A4 [D4 F4 A4] G4 B4 D5 [G3 B3 D4 G4] C5 G4 E4 [C3 E4 G4 C5]]
song = melody_samples(tune, 0.25)
seconds = count(song) / sample_rate

tunnel = shader {
	const BANDS = 16.0;
	const TAU = 6.2831853;
	const SPEED = 3.0;

	fn level(band: f32) -> f32 {
		let index = (i32(band) % 16 + 16) % 16;
		return $levels[index / 4][index % 4];
	}

	fn turned(p: vec2f, angle: f32) -> vec2f {
		let c = cos(angle);
		let s = sin(angle);
		return vec2f(c * p.x - s * p.y, s * p.x + c * p.y);
	}

	fn hue(h: f32) -> vec3f {
		return 0.5 + 0.5 * cos(TAU * (h + vec3f(0.0, 0.33, 0.67)));
	}

	fn gem_center() -> vec3f {
		return vec3f(0.6 * sin($time * 0.7), 0.4 * cos($time * 0.9), $time * SPEED + 5.0 - 1.2 * $kick);
	}

	// a point seen from the twisting bars: x across its bar, y from the axis, z along its ring, w its band
	// beside: 0 for the point's own bar, -1 and 1 for its neighbors
	fn bar_space(p: vec3f, beside: f32) -> vec4f {
		let q = turned(p.xy, p.z * 0.12 + $time * 0.4);
		let sector = (atan2(q.y, q.x) / TAU + 0.5) * BANDS;
		let across = (fract(sector) - 0.5 - beside) * TAU / BANDS * length(q);
		return vec4f(across, length(q), p.z - 1.5 * round(p.z / 1.5), floor(sector) + beside);
	}

	fn bar_distance(p: vec3f, beside: f32) -> f32 {
		let bars = bar_space(p, beside);
		let bar_box = vec3f(abs(bars.x) - 0.42, 2.9 - level(bars.w) * 1.9 - bars.y, abs(bars.z) - 0.55);
		return length(max(bar_box, vec3f(0.0))) + min(max(bar_box.x, max(bar_box.y, bar_box.z)), 0.0) - 0.04;
	}

	// x: distance, y: band of a bar (0 … 15), -1 for the gem
	fn scene(p: vec3f) -> vec2f {
		let band = bar_space(p, 0.0).w;
		let bar = min(bar_distance(p, 0.0), min(bar_distance(p, -1.0), bar_distance(p, 1.0)));

		let local = p - gem_center();
		let spin = vec3f(turned(local.xz, $time * 1.3), local.y);
		let ripple = sin(7.0 * spin.x + $time * 4.0) * sin(7.0 * spin.y) * sin(7.0 * spin.z) * (0.06 + 0.25 * $treble);
		let gem = length(local) - (0.55 + 0.5 * $bass + 0.35 * $kick) + ripple;
		if gem < bar { return vec2f(gem * 0.7, -1.0); }
		return vec2f(bar * 0.8, band);
	}

	fn normal_at(p: vec3f) -> vec3f {
		let e = vec2f(0.002, 0.0);
		return normalize(vec3f(
			scene(p + e.xyy).x - scene(p - e.xyy).x,
			scene(p + e.yxy).x - scene(p - e.yxy).x,
			scene(p + e.yyx).x - scene(p - e.yyx).x));
	}

	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let uv = (at.xy - 0.5 * $size) / $size.y * vec2f(1.0, -1.0) * (1.0 - 0.25 * $kick);
		let eye = vec3f(0.4 * sin($time * 0.5), 0.3 * cos($time * 0.6), $time * SPEED);
		let ahead = normalize(gem_center() - eye);
		let side = normalize(cross(vec3f(0.0, 1.0, 0.0), ahead));
		let up = cross(ahead, side);
		let ray = normalize(ahead + uv.x * side + uv.y * up);

		var travelled = 0.0;
		var glow = vec3f(0.0);
		var color = vec3f(0.0);
		for (var step = 0; step < 110; step++) {
			let p = eye + ray * travelled;
			let hit = scene(p);
			let tint = select(hue(hit.y / BANDS + $tone), hue($time * 0.3 + $tone), hit.y < 0.0);
			let shine = select(0.05 + 3.0 * level(hit.y), 0.1 + 1.5 * $bass, hit.y < 0.0);
			glow += tint * tint * shine * 0.004 / (0.03 + abs(hit.x) * 10.0);
			if hit.x < 0.001 {
				let n = normal_at(p);
				let light = normalize(gem_center() - p);
				let diffuse = max(dot(n, light), 0.0);
				let rim = pow(1.0 - max(dot(n, -ray), 0.0), 3.0);
				if hit.y < 0.0 {
					let reflected = reflect(ray, n);
					let mirrored = hue(atan2(reflected.y, reflected.x) / TAU + 0.5 + $time * 0.2);
					let sparkle = pow(max(dot(reflected, normalize(vec3f(0.5, 0.8, 0.3))), 0.0), 24.0);
					color = mirrored * mirrored * (0.2 + rim * 1.8) + vec3f(sparkle) + tint * rim * 0.6;
				} else {
					let lit = level(hit.y);
					let bars = bar_space(p, 0.0);
					let edge = 1.0 - smoothstep(0.0, 0.05, min(0.46 - abs(bars.x), 0.59 - abs(bars.z)));
					let pulse = pow(0.5 + 0.5 * sin(p.z * 0.7 - $time * 9.0), 12.0) * (0.3 + 2.0 * $bass + 4.0 * $kick);
					color = tint * tint * (0.04 + diffuse * (0.1 + 0.6 * lit) + 1.4 * lit * lit) + tint * rim * (0.1 + lit)
						+ (tint + 0.3) * edge * (0.15 + 2.5 * lit) + tint * pulse;
				}
				break;
			}
			travelled += hit.x;
			if travelled > 40.0 { break; }
		}
		let fog = exp(-0.06 * travelled);
		var final_color = color * fog + glow * (0.6 + 0.6 * $bass + 1.5 * $kick) + hue($tone) * $kick * 0.25;
		final_color *= 1.0 - 0.35 * dot(uv, uv);
		final_color = final_color / (1.0 + final_color);
		return vec4f(pow(final_color, vec3f(0.85)), 1.0);
	}
}

sound(song)
levels = [0.0 as float for band in 0..bands]
peaks = [quietest as float for band in 0..bands]
kick = 0.0
tone = 0.0
started = clock()
time = 0.0
while time < seconds {
	heard = spectrum(song, time, bands)
	rise = 0.0
	loudest = 0
	for band in 0..bands {
		peaks[band] = max(quietest, max(heard[band], peaks[band] * peak_fade))
		level = heard[band] / peaks[band]
		if level > levels[band] { rise += level - levels[band] }
		levels[band] = max(level, levels[band] * fall)
		if levels[band] > levels[loudest] { loudest = band }
	}
	kick = max(kick * kick_fade, min(1.0, rise / full_kick))
	tone += (loudest / bands - tone) * 0.1
	bass = (levels[0] + levels[1] + levels[2] + levels[3]) / 4
	treble = (levels[10] + levels[11] + levels[12] + levels[13]) / 4
	paint(tunnel, width, height)
	sleep(frame_milliseconds)
	time = (clock() - started) / 1000.0
}
