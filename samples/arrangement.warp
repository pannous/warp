#!/usr/bin/env warp
// An arrangement on the beat clock: `at` places a part at its time, counted from the first sound; the parts overlap.

tempo = 96
at 0 bars { melody [C4 E4 G4 E4] each 1 beat }           // the tune, bar 1
at 1 bar { melody [F4 A4 C5 A4] each 1 beat }            // bar 2
at 0 bars play [C3 G3] for 1 bar                         // a pad under bar 1
at 1 bar play [F2 C3] for 1 bar                          // and under bar 2
at 2 bars play [C3 E3 G3 C4] for 2 beats                 // the last chord
wait_sound()
