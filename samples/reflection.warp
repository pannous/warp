#!/usr/bin/env warp
// Reflection: a program looks at its own classes and functions (notes/reflection.md)

class Point {
	x: int
	y: int
	length() := sqrt(x*x + y*y)
}

p = Point(3, 4)
print "fields \(p.fields), methods \(p.methods)"
print dir(p)
print help(Point)
print help(p)

// a function knows its parameters and its signature

// the area of a rectangle
area(width: int, height: int) := width * height
print "area takes \(area.params): \(area.signature)"
print "$(area.body)"
print "OK"
# print area.dumb To do we have all the information so we can emit the complete function as it will be copy pastable: ≈
# area(width: int, height: int) := width * height
print area.dump
print dir(&area)
print type(&area)
print dir(area)
print type(area)
print area.body

// every property of a function also answers to a familiar name
print area.doc              // the comment above the definition
print area.description      // the same
print area.return_type
print area.returns          // the same
print area.representation   // the same as area.dump: the definition
print area.full             // what print area shows: the doc line and the definition
