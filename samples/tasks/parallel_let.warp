#!/usr/bin/env warp
# The parallel let, from Bend: `a b = f(x) g(y)` runs both calls at the same time and names their values. Natively
# each call but the last goes to a task while a core is free, and the calls run one after the other once all are busy,
# so a recursive split forks only its top levels.

# the sum of 0 … 1023, split in halves down to single numbers
sum(depth, x) := {
	if depth == 0 { return x }
	left right = sum(depth - 1, x * 2) sum(depth - 1, x * 2 + 1)
	left + right
}
print "sum of 0 … 1023: " sum(10, 0)

# two different calls side by side
square(n) := n * n
cube(n) := n * n * n
s c = square(12) cube(5)
print "12² = " s ", 5³ = " c
s + c
