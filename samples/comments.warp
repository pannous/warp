#!/usr/bin/env warp
// Comments in warp
// This is a single-line comment

/*
This is a block comment
spanning multiple lines
*/

// Under `use comments` a comment before a binding becomes its meta information:
// greeting.@comment (or greeting.meta.comment) reads these two lines
greeting: "Hello"

/*
Multi-line documentation
for the person record
*/
person: {
    // Name of the person
    name: "Alice"

    /* Age in years */
    age: 30
}

// Inline comments work too
result = 2 + 3  // process inputs

// Nested block comments are supported
/*
outer comment
/* inner comment */
still in outer
*/

// Documentation comments for export (triple slash)
/// Computes the factorial of n
/// Returns n! for non-negative integers
def factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

factorial(result)
