#!/usr/bin/env warp
// HTML as a domain-specific language
// warp's tagged blocks make markup natural; the page is the program's value, the playground renders it

fruits = ["Apple", "Banana", "Cherry"]

html { lang: "en"
    head {
        title: "My Page"
        meta{ charset: "utf-8" }
        style{ // css rules as they are written in css; link{ rel: "stylesheet" href: "style.css" } loads a sheet instead
            body { font-family: sans-serif; margin: 0 }
            header { background: darkslategray; color: white; padding: 8px 16px }
            "nav a": { color: white; margin-right: 12px }
            main { display: flex; gap: 24px; padding: 16px }
            aside { border-left: 2px solid lightgray; padding-left: 16px }
            footer { color: gray; padding: 0 16px }
        }
    }
    body {
        header {
            h1: "Welcome"
            nav {
                a{ href: "/" "Home" }
                a{ href: "/about" "About" }
                a{ href: "/contact" "Contact" }
            }
        }
        main {
            article {
                h2: "Hello World"
                p: "This is a paragraph of text."
                ul {
                    li{ "First item" }
                    li{ "Second item" }
                    li{ "Third item" }
                }
            }
            section {
                h3: "Fruits" // dynamic content: a loop inside the markup
                ul { for fruit in fruits { li: fruit } }
            }
            aside {
                h3: "Related"
                ul {
                    li{ a{ href: "#" "Link 1" } }
                    li{ a{ href: "#" "Link 2" } }
                }
            }
        }
        footer {
            p: "© 2025 warp"
        }
    }
}
