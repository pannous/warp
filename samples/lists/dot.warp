#!/usr/bin/env warp
use math
# dot(xs, ys) is sum(xs .* ys) in one multiply-add loop, no list of the products (lib/math.warp). Large float lists
# are copied into linear memory and dotted as f64 there; once the emitter pairs float[n] by dot, linear_dotf (f64x2,
# no copy) replaces that. A dot is too light for the GPU: uploading the two arrays costs more than the CPU's whole loop
n = 1000000
xs = float[n]
ys = float[n]
for i in 1 to n { xs#i = i / n; ys#i = 1 - i / n }

t0 = clock()
d = dot(xs, ys)
d1 = xs ∘ ys
assert d1 == d
t1 = clock()
print "dot of \(n) items: \(d) in \(t1 - t0) ms"

zs = xs .* ys
print "xs .* ys pairs the items: \(count(zs)) products, the middle one \(zs#(n /! 2))"
