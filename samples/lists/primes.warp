#!/usr/bin/env warp
# Prime check by recursion: i, the divisor tried next, starts at 2 by its default
def is_prime(n,i=2) = if n < 2 then no else if i * i > n then yes else if n % i == 0 then false else is_prime(n, i + 1)
# DONE Prime check without helper recursion, depends on default args

is_prime(97)
