#!/usr/bin/env warp
# Prime check with helper recursion
def check(n, i) = if i * i > n then yes else if n % i == 0 then false else check(n, i + 1)
def is_prime(n,i=2) = if n < 2 then no else check(n, 2)

# TODO Prime check without helper recursion, depends on default args
# def is_prime(n,i=2) = if n < 2 then no else if i * i > n then yes else if n % i == 0 then false else check(n, i + 1)


is_prime(97)
