#!/usr/bin/env warp
// Conway's Game of Life: a glider on an 8x8 grid, 4 generations
size = 8

fun neighbors(grid, r, c) {
  count = 0
  for dr in [-1, 0, 1] {
    for dc in [-1, 0, 1] {
      if dr != 0 or dc != 0 {
        rr = r + dr
        cc = c + dc
        if rr >= 0 and rr < size and cc >= 0 and cc < size {
          count += grid[rr * size + cc]
        }
      }
    }
  }
  return count
}

fun step(grid) {
  next = []
  // warp: `..` excludes the end, so `0..size-1` stops at size-2 ("index out of range" later); write `0..size` or `0...size-1`
  for r in 0..size-1 {
    for c in 0..size-1 {
      n = neighbors(grid, r, c)
      alive = grid[r * size + c] == 1
      if alive and (n == 2 or n == 3) {
        next.push(1)
      } else if not alive and n == 3 {
        next.push(1)
      } else {
        next.push(0)
      }
    }
  }
  return next
}

grid = []
for i in 0..size*size-1 { grid.push(0) }
for (r, c) in [(0, 1), (1, 2), (2, 0), (2, 1), (2, 2)] {
  grid[r * size + c] = 1
}

for gen in 1..4 {
  grid = step(grid)
}

// checksum: sum of r*10+c over live cells; the glider moved by (1,1)
checksum = 0
for r in 0..size-1 {
  for c in 0..size-1 {
    if grid[r * size + c] == 1 { checksum += r * 10 + c }
  }
}
checksum

// Kotlin habit kept on purpose: `0..size-1` meant inclusive; warp excludes the end and explains it (tests/welcoming/test_welcoming_ask.rs)
