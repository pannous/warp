#!/usr/bin/env warp
# a filled circle, painted on the playground's canvas: row after row, nonzero is ink
height=window.height
width=window.width
radius = min(width,height)/3
center = {y:height / 2, x:width/2}
surface = int[height * width]
for y in 0..height {
	for x in 0..width {
		surface[y * width + x] =  (y - center.y) ^ 2 + (x - center.x) ^ 2 < radius ^ 2 
	}
}
paint(surface)
