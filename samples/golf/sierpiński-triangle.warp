#!/usr/bin/env warp
// code.golf sierpiński-triangle: order 4, each order two copies of the last one under a centered copy; no space after a row's last ▲
rows = ["▲"]
for 1 to 4:
	pad = " " * rows.count
	width = 2 * rows.count - 1
	rows = rows.map(row => pad + row) + rows.map(row => row + " " * (width - #row + 1) + row)
print rows.join("\n")
