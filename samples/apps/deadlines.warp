#!/usr/bin/env warp
# Named deadlines checked against a fixed reference instant: overdue, due soon (within 2 days) or later,
# with the time remaining, as a table (time, tables)
use time
use tables

today = "2026-11-05T12:00:00Z" as Instant
soon = 2 * 24 * 3600 * 1000
deadlines = [
	{name: "Tax return", due: "2026-10-31"},
	{name: "Conference talk", due: "2026-11-06T09:30:00Z"},
	{name: "Rent", due: "2026-11-07"},
	{name: "Passport renewal", due: "2026-12-01"},
	{name: "Invoice #42", due: "2026-11-04T17:00:00Z"},
	{name: "Car service", due: "2027-01-15"}]

rows = []
late = 0
for d in deadlines {
	due = d["due"] as Instant
	left = due - today
	state = "later"
	if left < 0 { state = "overdue"; late = late + 1 } else if left <= soon { state = "due soon" }
	shown = Duration(abs(left)) as text
	if left < 0 { shown = shown + " ago" }
	rows = rows + [[d["name"], text(due.date), state, shown, days_between(today.ms, due.ms)]]
}
print("as of " + text(today.date) + ": " + text(count(deadlines)) + " deadlines, " + text(late) + " overdue")
print("")
print(table_text(rows, {headers: ["deadline", "due", "status", "remaining", "days"], align: ["left", "left", "left", "right", "right"]}))
