#!/usr/bin/env warp
# A tiny static site generator: pages in markdown with yaml front matter, poured into one mustache layout (markdown, yaml, template)
use markdown
use yaml
use template
use os
use file

layout = "<!doctype html>
<html><head><title>{{title}} · {{site}}</title></head>
<body>
<nav>{{#pages}}<a href=\"{{slug}}.html\">{{title}}</a> {{/pages}}</nav>
<article>
<h1>{{title}}</h1>
<p class=\"meta\">{{date}} by {{author}}{{#tags}} #{{.}}{{/tags}}</p>
{{{body}}}
</article>
</body></html>"

sources = [
	"---\ntitle: Hello warp\nslug: index\ndate: 2026-11-05\nauthor: Ada\ntags: [intro, news]\n---\n# Welcome\n\nThis site is *generated* by a warp program.\n\n- fast\n- small\n",
	"---\ntitle: Release 0.2\nslug: release-0-2\ndate: 2026-11-03\nauthor: Ada\ntags: [news]\n---\n## What changed\n\n1. JSON numbers stay whole\n2. A [changelog](https://example.com/log) link\n",
	"---\ntitle: About\nslug: about\ndate: 2026-11-01\nauthor: Bob\ntags: []\n---\nWe write **wasm**.\n\n```\nwarp run site.warp\n```\n"
]

# split '---' front matter from the markdown body
split_page(source: text): map := {
	parts = source.split("---\n")
	meta = parse_yaml(parts[1])
	meta["body"] = markdown_html(join(parts[2..], "---\n"))
	meta
}

# newest first: the yaml dates are ISO texts, so they sort as texts
pages = sort_by([split_page(s) for s in sources], p => p["date"]).reverse()
nav = [{title: p["title"], slug: p["slug"]} for p in pages]
out = (env("TMPDIR") ?? "/tmp") + "/warp_site"
for page in pages {
	page["site"] = "warp notes"
	page["pages"] = nav
	html = mustache(layout, page)
	write(out + "/" + page["slug"] + ".html", html)
	print("=== " + page["slug"] + ".html")
	print(html)
}

# a tag index: every tag with the pages that carry it, alphabetically
tag_layout = "<h1>Tags</h1>\n<ul>\n{{#tags}}<li>{{name}}: {{#pages}}<a href=\"{{slug}}.html\">{{title}}</a> {{/pages}}</li>\n{{/tags}}</ul>"
names = sort(unique(flatten([p["tags"] for p in pages])))
tags = [{name: t, pages: [{slug: p["slug"], title: p["title"]} for p in pages if t in p["tags"]]} for t in names]
write(out + "/tags.html", mustache(tag_layout, {tags: tags}))
print("=== tags.html")
print(read(out + "/tags.html"))
print("wrote " + str(count(pages) + 1) + " pages")
