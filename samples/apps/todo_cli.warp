#!/usr/bin/env warp
# A todo list on the command line, kept as JSON in a file (json, os, file, cli)
#   warp samples/apps/todo_cli.warp add "buy milk"   |   done 1   |   list   |   clear   |   --file todos.json list
# without arguments it plays a short session in a fresh file under $TMPDIR
use json
use os
use file
use cli

# git style: global options, then a command with its own
options = [{name: "file", short: "f", help: "the JSON file of the todos (else warp_todo_demo.json in $TMPDIR)"}]
commands = {
	add: {help: "add a todo", options: [{name: "title", positional: yes, many: yes}]},
	done: {help: "mark a todo done", options: [{name: "id", kind: "int", positional: yes}]},
	list: {help: "show the todos", options: []},
	clear: {help: "remove every todo", options: []}
}
# a mistake on the command line is shown with the help, never a trace
parsed(argv: list): map := try { parse_commands(options, commands, argv) } catch e { print(e.message); {help: yes, command: ø} }

given = if count(args) > 0 then parsed(args) else {help: no, command: ø}
store = given.get("file") ?? temp_folder() + "/warp_todo_demo.json"

load(): list := if exists(store) then parse_json(read(store)) else []
keep(items: list) := write(store, to_json(items))

next_id(items: list): int := if count(items) == 0 then 1 else max([item.id for item in items]) + 1

# (named add_todo: a program word named add breaks lib/json, card core-program-word-leaks-into-module)
add_todo(title: text) := {
	items = load()
	item = {id: next_id(items), title: title, done: no}
	keep(items + [item])
	print("added #" + str(item.id) + ": " + title)
}

finish(id: int) := {
	items = load()
	found = no
	for item in items {
		if item.id == id { item.done = yes; found = yes }
	}
	if found { keep(items); print("done #" + str(id)) } else { print("no todo #" + str(id)) }
}

show() := {
	items = load()
	for item in items {
		mark = if item.done then "[x]" else "[ ]"
		print(mark + " " + str(item.id) + ". " + item.title)
	}
	open = count([item for item in items if not item.done])
	print(if count(items) == 0 then "nothing to do" else str(open) + " open, " + str(count(items) - open) + " done")
}

command(o: map) := {
	verb = o["command"]
	if verb == "add" { add_todo(join(o["title"], " ")) }
	else if verb == "done" { finish(o["id"]) }
	else if verb == "list" { show() }
	else { keep([]); print("cleared") }
}

# one parsed command line: the help, or the command it names
act(o: map) := {
	if not o["help"] { command(o) }
	else if o["command"] == ø { print(cli_commands_help("todo", options, commands)) }
	else { print(cli_command_text("todo", commands, o["command"])) }
}

if count(args) > 0 {
	act(given)
} else {
	keep([])
	for argv in [["list"], ["add", "buy", "milk"], ["add", "write", "the", "report"], ["add", "call", "Ada"], ["done", "2"], ["done", "7"], ["list"], ["frobnicate"], ["--color", "list"], ["done", "two"], ["add", "--help"], ["--help"]] {
		print("$ todo " + join(argv, " "))
		act(parsed(argv))
	}
	print("stored: " + read(store))
	print("demo file removed: " + str(delete_file(store)))
}
