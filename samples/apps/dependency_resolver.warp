#!/usr/bin/env warp
# A package resolver: pick the newest version of each package that every requirement allows, then an install
# order where dependencies come first; a conflict and a cycle are reported (semver, graphs)
use semver
use graphs

# the registry: package -> version -> its requirements ("log" quoted: a bare key log pulls the log function in, card key-map)
registry = {
	app: {"1.0.0": {web: "^2.1.0", "log": "~1.4.0"}},
	web: {"2.0.0": {http: "^1.0.0"}, "2.1.3": {http: "^1.2.0", "log": ">=1.3.0"}, "2.2.0-beta.1": {http: "^2.0.0"}, "3.0.0": {http: "^2.0.0"}},
	http: {"1.1.0": {}, "1.2.5": {tls: "^0.9.0"}, "1.3.0": {tls: "^0.9.2"}, "2.0.0": {}},
	"log": {"1.3.9": {}, "1.4.2": {}, "1.4.7": {}, "1.5.0": {}},
	tls: {"0.9.1": {}, "0.9.4": {}, "1.0.0": {}}
}

# the newest version of a package allowed by every range wanted of it, ø when none is
newest(name: text, ranges: list): any := {
	fitting = [v for v in keys(registry[name]) if all(ranges, r => satisfies(v, r))]
	if count(fitting) == 0 then ø else semver_sort(fitting)[count(fitting) - 1]
}

# requirements collected breadth first; a package seen again gets its range added and is picked anew
resolve(root: text): map := {
	wanted = {}
	wanted[root] = [">=0.0.0"]
	picked = {}
	queue = [root]
	while count(queue) > 0 {
		name = queue[0]
		queue = queue[1..]
		version = newest(name, wanted[name])
		if version == ø { raise "conflict: no " + name + " fits " + join(wanted[name], " and ") }
		picked[name] = version
		needs = registry[name][version]
		for dependency in keys(needs) {
			wanted[dependency] = (wanted.get(dependency) ?? []) + [needs[dependency]]
			queue = queue + [dependency]
		}
	}
	picked
}

solution = resolve("app")
for package in sort(keys(solution)) { print(package + " " + solution[package]) }

# install order: an edge from each dependency to its dependent
edges = []
for package in keys(solution) {
	for dependency in keys(registry[package][solution[package]]) { edges = edges + [[dependency, package]] }
}
print("install order: " + join(topological_sort(graph_of(edges, yes)), ", "))

# a requirement nobody can meet
registry["app"]["1.0.0"]["tls"] = "^2.0.0"
try { resolve("app") } catch e { print(e.message) }

# a loop between two packages
loop = graph_of([["a", "b"], ["b", "c"], ["c", "a"]], yes)
try { topological_sort(loop) } catch e { print(e.message) }
