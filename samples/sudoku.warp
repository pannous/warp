#!/usr/bin/env warp
// Sudoku Solver
// Backtracking algorithm
// the grid is a flat list of 81 cells, row by row; lists are shared, so each try fills a copy and solve returns the
// solved grid (or [] if none)

def parse_grid(s) {
    cells = []
    // a char as int is its code point ('5' as int is 53), its text as int is the digit
    for c in s.replace(".", "0") { cells.push(c as text as int) }
    return cells
}

def cell(grid, x, y) { return grid#(y * 9 + x + 1) }

def is_valid(grid, row, col, num) {
    for i in 0..9 {
        if cell(grid, i, row) == num or cell(grid, col, i) == num { return false }
    }
    box_x = (col//3) * 3
    box_y = (row//3) * 3
    for dy in 0..3 {
        for dx in 0..3 {
            if cell(grid, box_x + dx, box_y + dy) == num { return false }
        }
    }
    return true
}

def solve(grid) {
    for i in 0..81 {
        if grid#(i + 1) == 0 {
            for num in 1..10 {
                if is_valid(grid, i//9, i % 9, num) {
                    candidate = grid.copy()
                    candidate#(i + 1) = num
                    solved = solve(candidate)
                    if solved != [] { return solved }
                }
            }
            return []
        }
    }
    return grid
}

def print_grid(grid) {
    for y in 0..9 {
        if y % 3 == 0 and y > 0 { print "------+-------+------" }
        line = ""
        for x in 0..9 {
            if x % 3 == 0 and x > 0 { line = line + "| " }
            value = cell(grid, x, y)
            line = line + (if value == 0 then "." else str(value)) + " "
        }
        print line
    }
}

// Example puzzle (. = empty)
puzzle = "53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79"

grid = parse_grid(puzzle)
print "Puzzle:"
print_grid(grid)
print ""

solution = solve(grid)
if solution != [] {
    print "Solution:"
    print_grid(solution)
} else {
    print "No solution exists"
}
solution#1 * 100 + solution#2 * 10 + solution#3
