#!/usr/bin/env warp
# a brush that leaves strokes behind (samples/shader_brush.warp only glows where the pointer is): $previous(at) is
# the color this shader left at that pixel the frame before, kept on the GPU, so each frame paints over the last.
# The first frame finds black, which is the paper here; a light paper would start with
# select(paper, $previous(at.xy), $frame > 0). The strokes fade a little each frame, faster without a press.
trails = shader {
	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let away = distance(at.xy, $mouse);
		let radius = select(10.0, 28.0, $mouse_down > 0.5);
		let ink = exp(-away * away / (radius * radius));
		let hue = vec3f(0.5) + 0.5 * cos($time + vec3f(0.0, 2.1, 4.2));
		let fade = select(0.006, 0.002, $mouse_down > 0.5);
		let kept = max($previous(at.xy).rgb - vec3f(fade), vec3f(0.0));
		return vec4f(max(kept, hue * ink), 1.0);
	}
}

on key {
	exit()
}
# each frame of the window, until it closes; the first paint opens it (headless: one frame, as a PNG)
on frame {
	paint(trails) # at the view's size: in the playground the screen's in full screen (⛶)
}
