#!/usr/bin/env warp
# One function, many methods: a definition for a class adds a method, the library's sort stays for lists
class Deck{cards: int}
class Animal{name: text}
class Dog extends Animal{}

sort(d: Deck) := "shuffled " + d.cards + " cards"
speak(a: Animal) := a.name + " makes a sound"
speak(d: Dog) := d.name + " barks"    # the most specific method wins

# sort(x) and x.sort() are the same call
print sort(Deck(52))
print Deck(3).sort()
print [3, 1, 2].sort()

# the class is known only at run time: still the right method
for pet in [Animal("Kitty"), Dog("Rex")] { print speak(pet) }

# every argument counts: the method fitting all of them best wins
class Ship{name: text}
class Rock{name: text}
collide(a: Ship, b: Rock) := a.name + " hits a rock"
collide(a: Rock, b: Ship) := "a rock hits " + b.name
collide(a: Ship, b: Ship) := a.name + " bumps " + b.name
print Ship("Ark").collide(Rock("x"))
for other in [Ship("Bee"), Rock("y")] { print collide(Ship("Ark"), other) }
