#!/usr/bin/env warp
# A transaction: every write of its block lands, or none does
class Account{owner: text; balance: int}
stored accounts: [Account]
if count(accounts) == 0 {
	accounts.add(Account("Al", 100))
	accounts.add(Account("Bo", 0))
}
global al = accounts#1  # transfer changes them: a function changes a main-level variable only when it is global
global bo = accounts#2
al.balance = 100  # every run starts from the same balances: the table is stored next to this file
bo.balance = 0

transfer(amount) := transaction {
	al.balance -= amount
	bo.balance += amount
	if al.balance < 0 { raise "Al cannot pay " + text(amount) }
}

transfer(30)
print "after 30: Al " + text(al.balance) + ", Bo " + text(bo.balance)
try transfer(500) catch e { print e.message }
print "after the refused 500: Al " + text(al.balance) + ", stored " + text((accounts where it.owner == "Al")#1.balance)
