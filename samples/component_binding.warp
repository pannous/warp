#!/usr/bin/env warp
# A bound field inside a component (card web-bind-component): each Greeter keeps its own name, so typing into one
# changes only its greeting. Run it in the playground, or `warp samples/component_binding.warp` for its HTML.
def Greeter(start) {
	name = start
	div{ input{ bind: name aria-label: "name" } p{ "Hi " + name } }
}
div{ Greeter("Ann") Greeter("Bob") }
