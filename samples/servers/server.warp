#!/usr/bin/env warp
# One source for a server and its page: `warp samples/servers/server.warp`, then open
# http://localhost:8080/ (notes/server_routes.md). Curl probe: scripts/samples_check.sh
#
# In-memory name list (not `stored` / sqlite): native sqlite FFI aborts on this host.
# `/api/newest` returns the full list: `last n of` stack-exhausts in the native warp.
use web
users = ["Ann", "Bo"]

# a server function runs on the server; the page asks it with POST /rpc/user_count
server def user_count() {
	global users
	count(users)
}

get "/api/users" { users }                 # data for anyone: GET /api/users
# a user from the request: `curl -d Cy localhost:8080/api/users` answers the new count, GET shows Cy
post "/api/users" { users.add(request.body); count(users) }
# a typed parameter as a page route's: GET /api/users/2 is Bo, /api/users/9 out of range
get "/api/users/:id:int" { users#id }
get "/api/newest" { users }

route "/" {
	div{
		h1{ "Users: " + user_count() }
		ul{
			li{ a{ href: "/users/1" "the first" } }
			li{ a{ href: "/users/2" "the second" } }
		}
	}
}

route "/users/:id:int" {
	div{
		h1{ "User " + users#id }
		a{ href: "/" "all users" }
	}
}

route "*" { p{ "no such page" } }
