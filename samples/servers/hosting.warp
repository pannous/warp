#!/usr/bin/env warp
# A program to host: in the playground's ⋯ menu, Deploy (log in with GitHub) 
# https://warp-<name>.pannous.workers.dev or "Deploy to my Cloudflare" 
# (notes/hosting.md). On this machine: warp samples/servers/hosting.warp
fib(n) := if n < 2 then n else fib(n-1) + fib(n-2)
get "/" { "hello from the edge" }
get "/fib/:n:int" { {n: n, fib: fib(n)} }
