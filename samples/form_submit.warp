#!/usr/bin/env warp
# A form handled on the page (card web-submit): `on submit` gets the form's named fields as event.fields,
# a number field's value as a number. Run it in the playground, or `warp samples/form_submit.warp` for its HTML.
guests = []
div{
	h1{ "Guest list" }
	form{
		on submit { guests += [event.fields.name + " (" + event.fields.age + ")"] }
		input{ name: "name" aria-label: "name" placeholder: "name" }
		input{ name: "age" type: "number" aria-label: "age" value: 30 }
		button{ "Add" }
	}
	ul{ for guest in guests { li{ guest } } }
}
