#!/usr/bin/env warp
// An emit the program has no handler for reaches its page as a DOM CustomEvent (card page-custom-event): its name,
// the data as event.detail. The page's own script listens; build it with `warp build --site` or run it in the
// playground, click Save and watch the tab's title (and the console).
saves = 0
div{
	button{ on click {
		saves += 1
		emit saved{count: saves}
		} "Save" }
	p{ "saved " + saves + " times" }
	script{ "document.addEventListener('saved', event => { document.title = 'saved #' + event.detail.count; console.log('the page heard', event.detail) })" }
}
