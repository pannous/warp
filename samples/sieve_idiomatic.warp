// Sieve of Eratosthenes, then binary search over the primes found
// workarounds vs samples/sieve.warp: `times {push}` fill, while instead of break, `0...(limit)`, `/ 2 as int`, `-1` without return, `:=` so the list parameter is inferred

fun sieve(limit) {
    is_prime = []
    (limit + 1) times { is_prime.push(true) }
    is_prime[0] = false
    is_prime[1] = false
    i = 2
    while i * i <= limit {
        if is_prime[i] {
            j = i * i
            while j <= limit {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    var primes = []
    for n in 0...(limit) {
        if is_prime[n] { primes.push(n) }
    }
    primes
}

fun binary_search(list, target) := {
    low = 0
    high = list.length - 1
    while low <= high {
        mid = ((low + high) / 2) as int
        if list[mid] == target { return mid }
        if list[mid] < target { low = mid + 1 } else { high = mid - 1 }
    }
    -1
}

primes = sieve(100)
total = sum primes
found = binary_search(primes, 97)
missing = binary_search(primes, 50)
total + found + missing
