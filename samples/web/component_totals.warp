#!/usr/bin/env warp
# Reading a component's state from outside it: `Counter.instances`
# are its instances in page order. `Counter.instances#1.count` is the first one's
# count, `Counter.instances.map(c => c.count)` every one's.
# Run it in the playground and click.
use web
def Counter(start) {
	count = start
	div{ button{ on click { count += 1 }, "+" } p{ "n " + count } }
}
div{
	Counter(0)
	Counter(10)
	button{ on click { Counter.instances#1.count = 0 }, "Reset the first" }
	p{ "sum " + sum(Counter.instances.map(c => c.count)) }
}
