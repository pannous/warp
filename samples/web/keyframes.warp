#!/usr/bin/env warp
# CSS keyframes (card web-keyframes): a new item pops in through the style sheet's @keyframes, overshooting a little;
# `leave:` plays it backwards before the item is removed. Run it in the playground and click add and remove.
style{ "@keyframes pop": { from: { opacity: 0 transform: "scale(0.5)" } "60%": { transform: "scale(1.15)" } to: { opacity: 1 } } }
items = ["first"]
div{
	button{ on click { items = items + ["item " + (count(items) + 1)] } "add" }
	button{ on click { items = items[1..] } "remove" }
	ul{ [li{ key: item animation: pop 400ms leave: pop 400ms reverse item } for item in items] }
}
