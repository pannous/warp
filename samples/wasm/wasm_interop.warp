#!/usr/bin/env warp
# WebAssembly interop
# warp compiles to wasm and interoperates seamlessly

# Import from wasm module: a core module's functions with `import name` (counter.wasm), a component's with
# `use name.wasm`; the host's memory and function table by name instead of the module's own
use { memory, table } from "env"
use text
use memory

# Export function for wasm (library form: `export name(…) := …`, not `export def`)
export add(a: i32, b: i32): i32 := a + b

# Export with explicit wasm type
export compute(x: f64, y: f64): f64 := sqrt(x * x + y * y)

# Strings as bytes, the way they lie in linear memory: memory.copy(bytes, ptr) writes them, memory.slice(ptr, end) reads
read_string(bytes): text := from_utf8(bytes)

round_trip(s: text): text := {
	bytes = s.to_utf8()
	copy(bytes, 60000)
	read_string(slice(60000, 60000 + count(bytes)))
}

write_string(s: text) := s.to_utf8()

# GC types (wasm-gc): every warp class is a GC struct, a missing child ø
enum Kind { Branch, Leaf }
class Node {
	kind: Kind
	value: int
	left: Node?
	right: Node?
}

# Create GC object
tree = Node(Kind.Branch, 42, Node(Kind.Leaf, 8, ø, ø), ø)

# Interface types (WIT): what a calculator offers, as a class whose methods become the component's exports
class Calculator {
	add(a: int, b: int) := a + b
	sub(a: int, b: int) := a - b
	mul(a: int, b: int) := a * b
}
calculator = Calculator()

# Component model: `warp build --wit` writes this program's world as WIT, `warp build --component` builds the
# component, which other programs use with `use name.wasm`; what it imports from its host (print, time, read) is
# plain warp here: print and clock()

[add(2, 3), compute(3.0, 4.0), round_trip("wasm ✓"), tree.value + tree.left.value, calculator.mul(6, 7)]
