#!/usr/bin/env warp
# Collatz conjecture - count steps to reach 1, and plot the steps of the first thousand numbers
use draw
def collatz(n) = if n == 1 then 0 else 1 + collatz(if n % 2 == 0 then n / 2 else 3 * n + 1)

lengths = [collatz(n) for n in 1 to 1000]

# one dot per number: its x the number, its height the steps it takes
canvas(1000, 400)
clear(paper)
for n in 1 to 1000 { circle(n, 400 - 2 * lengths#n, 1.5, red) }
show()

collatz(27)
