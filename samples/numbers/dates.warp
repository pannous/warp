#!/usr/bin/env warp
# now is the instant the clock reads when the program runs: UTC, printed in RFC 3339
start = now
print "started at " + start

# instants compare in time order
later = now
if later >= start then print "time did not run backwards"

# an instant's wall clock is the one of the time zone the program runs in (TZ)
print "hour here: " + start.hour

# date and local time literals are values the program keeps, prints and asks
leap_day = 2024-02-29
meeting = 2024-01-31T10:30
print leap_day + " is day " + leap_day.day_of_year + ", weekday " + leap_day.weekday
print "meeting at " + meeting.hour + ":" + meeting.minute
if leap_day > 2024-01-01 then print "the leap day comes later"

# durations and zoned times are values too
break_length = 1 hour + 30 minutes
print "break: " + break_length
launch = 2030-07-01T09:30[America/New_York]
print "launch " + launch + " at offset " + launch.offset

# a time zone has its own offset, with daylight saving: the same instant, two wall clocks
moment = 2024-07-01T10:00:00Z
print "Berlin: " + (moment in "Europe/Berlin")
print "Kolkata: " + (moment in "Asia/Kolkata")
# a calendar day keeps the wall clock across the clock change, 24 hours does not
before_change = 2024-03-30T12:00[Europe/Berlin]
print "+1 day:    " + (before_change + 1 day)
print "+24 hours: " + (before_change + 24 hours)
