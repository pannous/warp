#!/usr/bin/env warp
# sin(x) approximation with the polynomial of fdlibm's __kernel_sin: x reduced into [-π, π), then folded into [-π/2, π/2]
# use math.sin in real world;)
float sine(float x){
	x = x % τ # fold to [-2π,2π]
	if (x >= π) x = x - τ
	if (x > τ / 4) return sine(π - x)
	if (x < -τ / 4) return sine(π - x)
	S1 = -1.66666666666666324348e-01
	S2 = 8.33333333332248946124e-03
	S3 = -1.98412698298579493134e-04
	S4 = 2.75573137070700676789e-06
	S5 = -2.50507602534068634195e-08
	S6 = 1.58969099521155010221e-10
	z = x * x
	w = z * z
	r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6)
	return x + z * x * (S1 + z * r)
}
sine(π/2)
