#!/usr/bin/env warp
// Mandelbrot set visualization
// Classic fractal computation

// decimal literals are exact in warp: the iteration runs in floats, or its fractions would grow without end
def mandelbrot(cx, cy, max_iter) {
    x = 0.0 as float
    y = 0.0 as float
    iter = 0
    while x*x + y*y <= 4 and iter < max_iter {
        xtemp = x*x - y*y + cx
        y = 2*x*y + cy
        x = xtemp
        iter = iter + 1
    }
    return iter
}

// ASCII art rendering
def render(width, height, max_iter) {
    chars = " .:-=+*#%@"
    for row in 0..height {
        cy = (row - height/2) * 4.0 / height
        line = ""
        for col in 0..width {
            cx = (col - width/2) * 4.0 / width
            iter = mandelbrot(cx, cy, max_iter)
            idx = iter * (chars.length - 1)//max_iter  // floor division: / is exact
            line = line + chars[idx]
        }
        print line
    }
}

render(80, 40, 100)

// The color version drew to a canvas (canvas, pixel, hsv), which warp has no words for yet; its iteration counts:
total = 0
for y in 0..30 {
    for x in 0..40 {
        total = total + mandelbrot((x - 25) * 3.0 / 40, (y - 15) * 3.0 / 30, 64)
    }
}
total
