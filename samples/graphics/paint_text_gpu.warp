#!/usr/bin/env warp
# paint_text.warp's picture painted on the GPU: one fragment shader colors every pixel, the shapes by testing where the
# pixel lies and "hello" by how much the system font's letters cover it (text_coverage, which label uses too), given
# to the shader as $glyph, three pixels to a number (a float holds 24 bits exactly, and a shader's values hold 4096
# numbers natively). The colors are warp's, each as its [red, green, blue]
use draw
width = 200
height = 100
letters = text_coverage("hello", 48)
glyph_size = [letters#1, letters#2]
covered = letters[2 ..] + [0, 0]
glyph = [covered[3 * k] + 256 * covered[3 * k + 1] + 65536 * covered[3 * k + 2] for k in 0 ..< #covered /! 3]
paper_rgb = channels(paper as Color)
blue_rgb = channels(blue)
gold_rgb = channels(color(0xFFD700))
green_rgb = channels(green)
red_rgb = channels(red)
picture = shader {
	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let p = at.xy;
		var color = $paper_rgb;
		if (p.x >= 10.0 && p.x < 70.0 && p.y >= 56.0 && p.y < 90.0) { color = $blue_rgb; }
		if (distance(p, vec2f(120.0, 72.0)) <= 20.0) { color = $gold_rgb; }
		// the line, a pixel wide: the pixel's distance to the nearest point of the segment
		let a = vec2f(156.0, 90.0);
		let b = vec2f(190.0, 54.0);
		let t = clamp(dot(p - a, b - a) / dot(b - a, b - a), 0.0, 1.0);
		if (distance(p, a + t * (b - a)) <= 0.7) { color = $green_rgb; }
		// "hello" from its top left corner at 10, 6: its coverage of this pixel mixes red over what is below
		let cell = vec2i(floor(p - vec2f(10.0, 6.0)));
		let size = vec2i($glyph_size);
		if (all(cell >= vec2i(0)) && all(cell < size)) {
			let i = u32(cell.y * size.x + cell.x);
			let three = u32($glyph[i / 12u][(i / 3u) % 4u]);
			color = mix(color, $red_rgb, f32((three >> (8u * (i % 3u))) & 255u) / 255.0);
		}
		return vec4f(color, 1.0);
	}
}
paint(picture, width, height)
