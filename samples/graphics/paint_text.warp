#!/usr/bin/env warp
# paint without the GPU: use draw keeps a canvas of colored pixels, and show() paints it, natively in a window (a PNG
# without one) and in the playground on its canvas. label sets words in the system's sans-serif font, any size
use draw
width=300
height=100
canvas(width, height)
clear(paper)
rect(10, 56, 60, 34, blue)
circle(120, 72, 20, color(0xFFD700))
line(156, 90, 190, 54, green)
label(10, 6, "hello", red, size=48) 
show() 
# save("painting.png") # DONE Works in browser, but we want a different signature which is not conflicting with other potential variants of this very common name. Ideally typed with picture or whatever the canvas object (card save-picture-word): save canvas as: "painting.png"
