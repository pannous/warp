#!/usr/bin/env warp
# Gaussian splatting (Kerbl et al. 2023, "3D Gaussian Splatting for Real-Time Radiance Field Rendering"): a scene made
# of fuzzy 3D ellipsoids, each a position, a scale and a rotation (its covariance), a color and an opacity.
# Every frame warp sorts them by their depth before the camera, and the GPU draws each as a quad around its ellipse on
# the screen (its covariance through the camera's Jacobian), the farthest first, each blended over the ones behind it
# (a shader with its own vertex stage: one quad an instance; the scene a storage array each of its parts).
# The camera orbits a little every frame; drag the mouse to turn it yourself
use math
use color

distance_away = 5.0
zoom = 1.5 # the focal length, in picture heights
nearest = 0.2 # what is nearer the camera is not seen
background = [0.05, 0.06, 0.10]
# a Gaussian narrower than a pixel aliases: every projected one gets this much variance (in pixels²) more
pixel_blur = 0.3
knot_steps = 320
tube_splats = 6 # Gaussians around the tube at each step
tube_radius = 0.12
light = normalize([0.4, 0.8, 0.5])
star_splats = 60
orbit_step = 0.01 # radians a frame

class Splat { position: list; covariance: list; color: Color; opacity: float }

# the rotation matrix of the unit quaternion [w, x, y, z]
rotation(q: list): list := {
	w = q#1; x = q#2; y = q#3; z = q#4
	[[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
	 [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
	 [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]]
}
# the rotation whose columns are the axes a, b, c (each a unit vector, at right angles)
turning_onto(a: list, b: list, c: list): list := [[a#i, b#i, c#i] for i in 1 to 3]
# a Gaussian's covariance Σ = R S Sᵀ Rᵀ, its 3×3 rows: R the rotation, S the scales along its own axes
covariance(scale: list, r: list): list := {
	m = [[r#i#j * scale#j for j in 1 to 3] for i in 1 to 3]
	[[dot(m#i, m#j) for j in 1 to 3] for i in 1 to 3]
}
splat(position: list, scale: list, r: list, color: Color, opacity: float): Splat := Splat(position, covariance(scale, r), color, opacity)

# the scene: the surface of a tube along a (2, 3) torus knot, of flat Gaussians lying in it, its hue going round and
# lit from above; and stars, Gaussians stretched each its own way
knot_point(t: float): list := {
	r = 1 + 0.45 * cos(3 * t)
	[r * cos(2 * t), 0.45 * sin(3 * t), r * sin(2 * t)]
}
knot_tube(): list := {
	surface = []
	for i in 1 to knot_steps {
		t = 2 * π * i / knot_steps
		along = normalize(knot_point(t + 0.01) .- knot_point(t - 0.01))
		side = normalize(cross(along, [0, 1, 0]))
		lifted = cross(side, along)
		for j in 1 to tube_splats {
			a = 2 * π * j / tube_splats
			outward = side .* cos(a) .+ lifted .* sin(a)
			around = cross(outward, along)
			shade = 0.3 + 0.7 * max(dot(outward, light), 0)
			surface.push(splat(knot_point(t) .+ outward .* tube_radius, [0.035, 0.065, 0.008], turning_onto(along, around, outward), hsv(360 * i / knot_steps, 0.75, 0.95 * shade), 0.9))
		}
	}
	surface
}
knot = knot_tube()
star(i: int): Splat := {
	t = 2.39996 * i # the golden angle: points spread evenly over the sphere
	height = 1 - 2 * i / star_splats
	ring = sqrt(1 - height * height)
	twist = [cos(i), sin(2 * i), cos(3 * i), sin(5 * i)]
	splat([2.6 * ring * cos(t), 2.6 * height, 2.6 * ring * sin(t)], [0.06, 0.015, 0.015], rotation(twist ./ norm(twist)), white, 0.9)
}
stars = [star(i) for i in 1 to star_splats]
scene = knot + stars

# the scene as the shader reads it, a vec4f each Gaussian: its centre and opacity, the six numbers of its covariance and
# its color's 24 bits
centres = scene.map(s => s.position + [s.opacity])
shapes = scene.map(s => [s.covariance#1#1, s.covariance#1#2, s.covariance#1#3, s.covariance#2#2])
shades = scene.map(s => [s.covariance#2#3, s.covariance#3#3, int(s.color) % 16777216, 0])

# the camera looking at the origin from yaw and pitch: its place and axes, its focal length in pixels and the picture's
# centre, as the shader reads them
global eye = [0.0, 0.0, distance_away]
global right = [1.0, 0.0, 0.0]
global up = [0.0, 1.0, 0.0]
global forward = [0.0, 0.0, -1.0]
global focal = 1.0
global centre = [0.0, 0.0]
global order = [0] # the Gaussians in front of the camera, nearest first
global instances = 1 # the sky, then every Gaussian in front of the camera
look(yaw: float, pitch: float, width: float, height: float) := {
	eye = [cos(pitch) * sin(yaw), sin(pitch), cos(pitch) * cos(yaw)] .* distance_away
	forward = normalize(eye .* -1)
	right = normalize(cross(forward, [0, 1, 0]))
	up = cross(right, forward)
	focal = zoom * height
	centre = [width / 2, height / 2]
	depths = scene.map(s => dot(s.position .- eye, forward))
	order = [i - 1 for i in 1 to #scene].filter(i => depths#(i + 1) >= nearest).sort_by(i => depths#(i + 1))
	instances = 1 + #order
}

splats = shader {
struct Corner { @builtin(position) at: vec4f, @location(0) offset: vec2f, @location(1) conic: vec3f, @location(2) ink: vec4f }

@vertex fn splat(@builtin(vertex_index) corner: u32, @builtin(instance_index) drawn: u32) -> Corner {
	let side = vec2f(f32(corner & 1u), f32(corner >> 1u)) * 2.0 - 1.0;
	var out: Corner;
	if (drawn == 0u) { // the sky first, over the whole picture
		out.at = vec4f(side, 0.0, 1.0);
		out.ink = vec4f($background, 1.0);
		return out;
	}
	let n = u32($instances) - 1u - drawn; // the farthest Gaussian first, the nearest last
	let i = u32($order[n / 4u][n % 4u]);
	let a = $shapes[i];
	let b = $shades[i];
	let sigma = mat3x3f(a.xyz, vec3f(a.y, a.w, b.x), vec3f(a.z, b.x, b.y));
	let seen = $centres[i].xyz - $eye;
	let x = dot(seen, $right);
	let y = dot(seen, $up);
	let z = dot(seen, $forward);
	// the rows of the projection's Jacobian times the view rotation: how a step in the world moves the pixel
	let f = $focal;
	let across = $right * (f / z) - $forward * (f * x / (z * z));
	let down = $up * (-f / z) + $forward * (f * y / (z * z));
	let spread = vec3f(dot(across, sigma * across), dot(across, sigma * down), dot(down, sigma * down)) + vec3f($pixel_blur, 0.0, $pixel_blur);
	let det = spread.x * spread.z - spread.y * spread.y;
	let middle = (spread.x + spread.z) / 2.0;
	let reach = 3.0 * sqrt(middle + sqrt(max(middle * middle - det, 0.0))); // three standard deviations, in pixels
	out.offset = side * reach;
	let pixel = $centre + vec2f(x, -y) * (f / z) + out.offset;
	out.at = vec4f(pixel.x / $width * 2.0 - 1.0, 1.0 - pixel.y / $height * 2.0, 0.0, 1.0);
	out.conic = vec3f(spread.z, -spread.y, spread.x) / det;
	let bits = u32(b.z);
	out.ink = vec4f(vec3f(f32(bits >> 16u), f32((bits >> 8u) & 255u), f32(bits & 255u)) / 255.0, $centres[i].w);
	return out;
}

@fragment fn main(here: Corner) -> @location(0) vec4f {
	let d = here.offset;
	let power = -0.5 * (here.conic.x * d.x * d.x + here.conic.z * d.y * d.y) - here.conic.y * d.x * d.y;
	return vec4f(here.ink.rgb, min(1.0, here.ink.a * exp(power)));
}
}

yaw = 0.0
pitch = 0.35
last_x = mouse_x
last_y = mouse_y
# each frame of the window, until it closes (headless: one frame, as a PNG)
on frame {
	if mouse_down {
		yaw -= (mouse_x - last_x) * 0.01
		pitch = clamp(pitch + (mouse_y - last_y) * 0.01, -1.4, 1.4)
	} else {
		yaw += orbit_step
	}
	last_x = mouse_x
	last_y = mouse_y
	look(yaw, pitch, shown_width(), shown_height())
	paint(splats) # at the size it shows at: the window's, the playground's pane
}
