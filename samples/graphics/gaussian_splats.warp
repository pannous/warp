#!/usr/bin/env warp
# Gaussian splatting (Kerbl et al. 2023, "3D Gaussian Splatting for Real-Time Radiance Field Rendering"): a scene made
# of fuzzy 3D ellipsoids, each a position, a scale and a rotation (its covariance), a color and an opacity: here a
# capture, a .splat file (lib/splats.warp), the one given or the bee beside this program (bee.splat.md).
# Every frame warp sorts them by their depth before the camera, and the GPU draws each as a quad around its ellipse on
# the screen (its covariance through the camera's Jacobian), the farthest first, each blended over the ones behind it
# (a shader with its own vertex stage: one quad an instance; the scene a storage array each of its parts).
# The camera orbits a little every frame; drag the mouse to turn it yourself.
# --times prints each frame's sort, in milliseconds, before paint (the host adds upload and draw when it can).
use math
use file
use os
use splats

capture = program.folder + "/bee.splat"
timing = no
for arg in args {
	if arg == "--times" { timing = yes } else { capture = arg }
}
zoom = 1.5 # the focal length, in picture heights
backed_off = 3.0 # the camera's distance from the scene's middle, in the scene's sizes
nearest = 0.05 # what is nearer the camera, in the scene's sizes, is not seen
upward = [0, 1, 0] # this capture's up: the bee is y-up. A COLMAP capture such as angel.splat has y down, [0, -1, 0]
background = [0.05, 0.06, 0.10]
# a Gaussian narrower than a pixel aliases: every projected one gets this much variance (in pixels²) more
pixel_blur = 0.3
orbit_step = 0.01 # radians a frame

scene = read_splats(capture)
# its middle and its size, both of the bulk of it: a capture's stray Gaussians far out do not count
middle = [median(scene.map(s => s.position#k)) for k in 1 to 3]
size = 2 * median(scene.map(s => norm(s.position .- middle)))

# the scene as the shader reads it, four floats a Gaussian, a vec4f each: its centre and opacity, then the six numbers
# of its covariance and its color's 24 bits. A GPU list [f32], so the host can hand the GPU those bytes in one copy
n = #scene
centres: [f32] = float[n * 4]
shapes: [f32] = float[n * 4]
shades: [f32] = float[n * 4]
for i in 1 to n {
	s = scene#i
	base = (i - 1) * 4
	p = s.position
	centres#(base + 1) = p#1
	centres#(base + 2) = p#2
	centres#(base + 3) = p#3
	centres#(base + 4) = s.opacity
	c = covariance_terms(s.rotation, s.scale)
	shapes#(base + 1) = c#1
	shapes#(base + 2) = c#2
	shapes#(base + 3) = c#3
	shapes#(base + 4) = c#4
	shades#(base + 1) = c#5
	shades#(base + 2) = c#6
	shades#(base + 3) = int(s.color) % 16777216
	shades#(base + 4) = 0.0
}

# the camera looking at the scene's middle from yaw and pitch: its place and axes, its focal length in pixels and the
# picture's centre, as the shader reads them
global eye = [0.0, 0.0, 1.0]
global right = [1.0, 0.0, 0.0]
global up = [0.0, 1.0, 0.0]
global forward = [0.0, 0.0, -1.0]
global focal = 1.0
global centre = [0.0, 0.0]
pad = n
if pad % 4 != 0 { pad = pad + 4 - pad % 4 }
if pad < 4 { pad = 4 }
order_cells: [f32] = float[pad]
global order = order_cells # the Gaussians in front of the camera, nearest first, 0-based indices
global depths = []
global instances = 1 # the sky, then every Gaussian in front of the camera
look(yaw: float, pitch: float, width: float, height: float) := {
	back = upward .* sin(pitch) .+ cross(upward, [1, 0, 0]) .* (cos(pitch) * cos(yaw)) .+ [1, 0, 0] .* (cos(pitch) * sin(yaw))
	eye = middle .+ back .* (backed_off * size)
	forward = back .* -1
	right = normalize(cross(forward, upward))
	up = cross(right, forward)
	focal = zoom * height
	centre = [width / 2, height / 2]
	depths = depths_of(scene, eye, forward, depths)
	ranked = order_by_depth(depths, nearest * size)
	drawn = #ranked
	if drawn > 0 { for i in 1 to drawn { order#i = float(ranked#i) } }
	instances = 1 + drawn
}

splats = shader {
struct Corner { @builtin(position) at: vec4f, @location(0) offset: vec2f, @location(1) conic: vec3f, @location(2) ink: vec4f }

@vertex fn splat(@builtin(vertex_index) corner: u32, @builtin(instance_index) drawn: u32) -> Corner {
	let side = vec2f(f32(corner & 1u), f32(corner >> 1u)) * 2.0 - 1.0;
	var out: Corner;
	if (drawn == 0u) { // the sky first, over the whole picture
		out.at = vec4f(side, 0.0, 1.0);
		out.ink = vec4f($background, 1.0);
		return out;
	}
	let n = u32($instances) - 1u - drawn; // the farthest Gaussian first, the nearest last
	let i = u32($order[n / 4u][n % 4u]);
	let a = $shapes[i];
	let b = $shades[i];
	let sigma = mat3x3f(a.xyz, vec3f(a.y, a.w, b.x), vec3f(a.z, b.x, b.y));
	let seen = $centres[i].xyz - $eye;
	let x = dot(seen, $right);
	let y = dot(seen, $up);
	let z = dot(seen, $forward);
	// the rows of the projection's Jacobian times the view rotation: how a step in the world moves the pixel
	let f = $focal;
	let across = $right * (f / z) - $forward * (f * x / (z * z));
	let down = $up * (-f / z) + $forward * (f * y / (z * z));
	let spread = vec3f(dot(across, sigma * across), dot(across, sigma * down), dot(down, sigma * down)) + vec3f($pixel_blur, 0.0, $pixel_blur);
	let det = spread.x * spread.z - spread.y * spread.y;
	let middle = (spread.x + spread.z) / 2.0;
	let reach = 3.0 * sqrt(middle + sqrt(max(middle * middle - det, 0.0))); // three standard deviations, in pixels
	out.offset = side * reach;
	let pixel = $centre + vec2f(x, -y) * (f / z) + out.offset;
	out.at = vec4f(pixel.x / $width * 2.0 - 1.0, 1.0 - pixel.y / $height * 2.0, 0.0, 1.0);
	out.conic = vec3f(spread.z, -spread.y, spread.x) / det;
	let bits = u32(b.z);
	out.ink = vec4f(vec3f(f32(bits >> 16u), f32((bits >> 8u) & 255u), f32(bits & 255u)) / 255.0, $centres[i].w);
	return out;
}

@fragment fn main(here: Corner) -> @location(0) vec4f {
	let d = here.offset;
	let power = -0.5 * (here.conic.x * d.x * d.x + here.conic.z * d.y * d.y) - here.conic.y * d.x * d.y;
	return vec4f(here.ink.rgb, min(1.0, here.ink.a * exp(power)));
}
}

yaw = 0.0
pitch = 0.35
last_x = mouse_x
last_y = mouse_y
# each frame of the window, until it closes (headless: one frame, as a PNG)
on frame {
	if mouse_down {
		yaw -= (mouse_x - last_x) * 0.01
		pitch = clamp(pitch + (mouse_y - last_y) * 0.01, -1.4, 1.4)
	} else {
		yaw += orbit_step
	}
	last_x = mouse_x
	last_y = mouse_y
	started = clock()
	look(yaw, pitch, shown_width(), shown_height())
	if timing { print("splat-frame sort " + (clock() - started)) }
	paint(splats) # at the size it shows at: the window's, the playground's pane
}
