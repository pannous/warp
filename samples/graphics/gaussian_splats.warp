#!/usr/bin/env warp
# Gaussian splatting (Kerbl et al. 2023, "3D Gaussian Splatting for Real-Time Radiance Field Rendering"): a scene made
# of fuzzy 3D ellipsoids, each a position, a scale and a rotation (its covariance), a color and an opacity.
# Every frame warp projects each Gaussian to a 2D ellipse on the screen (its covariance through the camera's Jacobian),
# sorts them near to far, and the fragment shader blends them front to back at every pixel until it is opaque.
# The camera orbits by the clock; drag the mouse to turn it yourself
use math
use color
use units

size = 384
focal = 1.4 * size # pixels per unit at depth 1
distance_away = 5.0
background = [0.05, 0.06, 0.10]
# a Gaussian blurred by less than a pixel aliases: every projected one gets this much variance (in pixels²) more
pixel_blur = 0.3
knot_splats = 420
star_splats = 60

class Splat { position: list; covariance: list; color: Color; opacity: float }

# the rotation matrix of the unit quaternion [w, x, y, z]
rotation(q: list): list := {
	w = q#1; x = q#2; y = q#3; z = q#4
	[[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
	 [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
	 [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]]
}
# the quaternion turning the x axis onto the unit vector `along`
turning_x_onto(along: list): list := {
	half = [1 + along#1, 0, -along#3, along#2]
	half ./ norm(half)
}
# a Gaussian's covariance Σ = R S Sᵀ Rᵀ, its 3×3 rows: R the rotation, S the scales along its own axes
covariance(scale: list, turn: list): list := {
	r = rotation(turn)
	m = [[r#i#j * scale#j for j in 1 to 3] for i in 1 to 3]
	[[dot(m#i, m#j) for j in 1 to 3] for i in 1 to 3]
}
splat(position: list, scale: list, turn: list, color: Color, opacity: float): Splat := Splat(position, covariance(scale, turn), color, opacity)

# the scene: a (2, 3) torus knot of Gaussians stretched along the curve, its hue going round, and a few round stars
knot_point(t: float): list := {
	r = 1 + 0.45 * cos(3 * t)
	[r * cos(2 * t), 0.45 * sin(3 * t), r * sin(2 * t)]
}
knot = [{
	t = 2 * π * i / knot_splats
	along = normalize(knot_point(t + 0.01) .- knot_point(t - 0.01))
	splat(knot_point(t), [0.07, 0.035, 0.035], turning_x_onto(along), hsv(360 * i / knot_splats, 0.75, 0.95), 0.8)
} for i in 1 to knot_splats]
stars = [{
	t = 2.39996 * i # the golden angle: points spread evenly over the sphere
	height = 1 - 2 * i / star_splats
	ring = sqrt(1 - height * height)
	splat([2.6 * ring * cos(t), 2.6 * height, 2.6 * ring * sin(t)], [0.03, 0.03, 0.03], [1, 0, 0, 0], white, 0.9)
} for i in 1 to star_splats]
scene = knot + stars

# the camera's place and axes looking at the origin from yaw and pitch: [eye, right, up, forward]
camera(yaw: float, pitch: float): list := {
	eye = [cos(pitch) * sin(yaw), sin(pitch), cos(pitch) * cos(yaw)] .* distance_away
	forward = normalize(eye .* -1)
	right = normalize(cross(forward, [0, 1, 0]))
	[eye, right, cross(right, forward), forward]
}
quadratic(a: list, sigma: list, b: list): float := dot(a, [dot(sigma#i, b) for i in 1 to 3])

# a Gaussian on the screen: [depth, [x, y, conic a, conic b], [conic c, opacity, color's 24 bits, 0]], the conic the
# inverse of its 2D covariance; ø behind the camera
projected(s: Splat, view: list): any := {
	seen = s.position .- view#1
	x = dot(seen, view#2); y = dot(seen, view#3); z = dot(seen, view#4)
	if z < 0.2 { return ø }
	# the rows of the projection's Jacobian times the view rotation: how a step in the world moves the pixel
	across = view#2 .* (focal / z) .- view#4 .* (focal * x / (z * z))
	down = view#3 .* (-focal / z) .+ view#4 .* (focal * y / (z * z))
	a = quadratic(across, s.covariance, across) + pixel_blur
	b = quadratic(across, s.covariance, down)
	c = quadratic(down, s.covariance, down) + pixel_blur
	det = a * c - b * b
	[z, [size / 2 + focal * x / z, size / 2 - focal * y / z, c / det, -b / det], [a / det, s.opacity, int(s.color) % 16777216, 0]]
}

global ellipses = []
global inks = []
global count = 0
# the scene seen from yaw and pitch, nearest first, as the shader reads it
project(yaw: float, pitch: float) := {
	view = camera(yaw, pitch)
	seen = scene.map(s => projected(s, view)).filter(p => p != ø).sort_by(p => p#1)
	ellipses = seen.map(p => p#2)
	inks = seen.map(p => p#3)
	count = #seen
}

splats = shader {
@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
	var color = vec3f(0.0);
	var through = 1.0; // the light still coming through the Gaussians in front
	for (var i = 0u; i < u32($count); i++) {
		let e = $ellipses[i];
		let k = $inks[i];
		let d = at.xy - e.xy;
		let power = -0.5 * (e.z * d.x * d.x + k.x * d.y * d.y) - e.w * d.x * d.y;
		let alpha = min(0.99, k.y * exp(power));
		if (power > 0.0 || alpha < 1.0 / 255.0) { continue; }
		let bits = u32(k.z);
		let ink = vec3f(f32(bits >> 16u), f32((bits >> 8u) & 255u), f32(bits & 255u)) / 255.0;
		color += through * alpha * ink;
		through *= 1.0 - alpha;
		if (through < 0.004) { break; }
	}
	return vec4f(color + through * $background, 1.0);
}
}

started = clock()
yaw = 0.0
pitch = 0.35
last_x = mouse_x
last_y = mouse_y
# each frame of the window, until it closes (headless: one frame, as a PNG)
on frame {
	if mouse_down {
		yaw -= (mouse_x - last_x) * 0.01
		pitch = clamp(pitch + (mouse_y - last_y) * 0.01, -1.4, 1.4)
	} else {
		yaw = yaw + 0.01
	}
	last_x = mouse_x
	last_y = mouse_y
	project(yaw, pitch)
	paint(splats, size, size)
}
