#!/usr/bin/env warp
# A torch, and the fog that drifts around a pillar (samples/graphics/fluid_25d.warp). The picture follows a visual
# idea by @r4nM4_64; nothing here was copied (notices/fluid_25d.md). The fluid is Stam's stable fluids, on the GPU:
# advect, buoyancy, vorticity confinement, divergence, Jacobi pressure, then the gradient taken back off the velocity.
# Window y grows downward, the same way the pointer and the fragment position do, so a rising flame is a negative v.
# The grid is 384 by 216. The picture is 960 by 540, and on a Retina drawable the shade pass fills that drawable.
# Mode 1, torch (the default): a buoyant flame from a cup. Mode 2, fog: a pale bank over a ground, the pointer
# pushes it, a round pillar blocks it. f, 1, 2 or a click switches. Headless: an argument fog or torch. short stops
# at 80 frames, movie writes a frame every fourth, --times prints each frame's upload and draw in milliseconds.
use os
use keys
use gpu_passes

mode = 1
timing = no
steps = 240
movie = no
for arg in args {
	if arg == "--times" { timing = yes }
	else if arg == "fog" or arg == "2" { mode = 2 }
	else if arg == "torch" or arg == "1" { mode = 1 }
	else if arg == "short" { steps = 80 }
	else if arg == "movie" { movie = yes }
}
if timing { set_system_value("paint timing", 1) }

grid_w = 384
grid_h = 216
view_w = 960
view_h = 540
frame_i = 0
aspect = grid_w * 1.0 / grid_h
fields = gpu_fields(grid_w, grid_h, ["velocity", "density", "temperature", "pressure", "divergence"])
pressure_steps = 22

fragment(body) := "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {\n" + body + "\n}\n"
common = '
fn hash(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn wobble() -> vec2f { return vec2f(sin(values.time * 2.7) * 0.01, cos(values.time * 2.1) * 0.006); }
fn pillar_q(uv: vec2f) -> vec2f { return (uv - vec2f(0.50, 0.46)) * vec2f(values.aspect, 1.0); }
fn rise(uv: vec2f) -> f32 { return select(1.0, smoothstep(0.0, 0.38, uv.y), values.mode < 1.5); }
fn shed(uv: vec2f) -> f32 {
	let upper = smoothstep(0.72, 0.42, uv.y);
	let off = smoothstep(0.045, 0.18, abs(uv.x - 0.5));
	return select(1.0, mix(1.0, 0.86, upper * off), values.mode < 1.5);
}
'
bounds = common + '
fn inside(uv: vec2f) -> bool {
	let side = uv.x < 0.012 || uv.x > 0.988 || uv.y > 0.988;
	let roof = values.mode > 1.5 && uv.y < 0.012;
	let pillar = values.mode > 1.5 && dot(pillar_q(uv), pillar_q(uv)) < 0.0081;
	return side || roof || pillar;
}
'
uv_of = "let uv = at.xy / values.size;\n"
advect(name) := bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let back = uv - field_velocity(uv).xy * values.dt;
	let held = field_' + name + '(back).x;
	let t = values.texel;
	let blur = (field_' + name + '(back + vec2f(t.x, 0.0)).x + field_' + name + '(back - vec2f(t.x, 0.0)).x + field_' + name + '(back + vec2f(0.0, t.y)).x + field_' + name + '(back - vec2f(0.0, t.y)).x) * 0.25;
	let faded = mix(held, blur, values.soft) * values.keep * rise(uv) * shed(uv);
	return vec4f(max(faded, 0.0), 0.0, 0.0, 1.0);
')
advect_velocity = bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let wind = field_velocity(uv).xy;
	let carried = field_velocity(uv - wind * values.dt).xy;
	let t = values.texel;
	let blur = (field_velocity(uv + vec2f(t.x, 0.0)).xy + field_velocity(uv - vec2f(t.x, 0.0)).xy + field_velocity(uv + vec2f(0.0, t.y)).xy + field_velocity(uv - vec2f(0.0, t.y)).xy) * 0.25;
	return vec4f(mix(carried, blur, values.soft) * values.keep * rise(uv) * shed(uv), 0.0, 0.0);
')
buoyancy = bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let v = field_velocity(uv).xy;
	let hot = max(field_temperature(uv).x - 0.08, 0.0);
	return vec4f(v.x, v.y - hot * values.lift, 0.0, 0.0);
')
vorticity = bounds + '
fn curl_at(uv: vec2f) -> f32 {
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).y;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).y;
	let down = field_velocity(uv + vec2f(0.0, t.y)).x;
	let up = field_velocity(uv - vec2f(0.0, t.y)).x;
	return 0.5 * ((right - left) - (down - up));
}
fn curl_abs(uv: vec2f) -> f32 { return abs(curl_at(uv)); }
' + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let curl = curl_at(uv);
	let dx = curl_abs(uv + vec2f(t.x, 0.0)) - curl_abs(uv - vec2f(t.x, 0.0));
	let dy = curl_abs(uv + vec2f(0.0, t.y)) - curl_abs(uv - vec2f(0.0, t.y));
	let len = max(length(vec2f(dx, dy)), 0.0001);
	let force = vec2f(dy, -dx) / len * curl * values.confinement;
	return vec4f(field_velocity(uv).xy + force, 0.0, 0.0);
')
forces = bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	var v = field_velocity(uv).xy;
	let a = uv.x * 5.0 + values.time * 0.35;
	let b = uv.y * 5.0 - values.time * 0.22;
	v = v + vec2f(sin(a) * cos(b), -cos(a) * sin(b)) * values.drift;
	let flame = vec2f(0.50, 0.78) + wobble();
	let q = (uv - flame) * vec2f(values.aspect, 1.0);
	let core = exp(-dot(q, q) / 0.0045);
	let flicker = 1.0 + 0.06 * sin(values.time * 5.0);
	if (values.mode < 1.5) { v = v + vec2f(sin(values.time * 2.3) * 0.06, -1.0) * core * 0.0022 * flicker; }
	let pointer = values.mouse / values.view;
	let away = (uv - pointer) * vec2f(values.aspect, 1.0);
	let puff = exp(-dot(away, away) / 0.014);
	let spin = vec2f(-away.y, away.x) / vec2f(values.aspect, 1.0);
	v = v + (spin * 1.6 + (uv - pointer) * 0.45) * puff * values.stir_force;
	v = clamp(v, vec2f(-0.16), vec2f(0.16));
	return vec4f(v, 0.0, 0.0);
')
inject = bounds + '
fn noise(p: vec2f) -> f32 {
	let i = floor(p);
	let f = fract(p);
	let u = f * f * (3.0 - 2.0 * f);
	let a = hash(i);
	let b = hash(i + vec2f(1.0, 0.0));
	let c = hash(i + vec2f(0.0, 1.0));
	let d = hash(i + vec2f(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
' + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let flame = vec2f(0.50, 0.78) + wobble();
	let q = (uv - flame) * vec2f(values.aspect, 1.0);
	let core = exp(-dot(q, q) / 0.0045);
	let body = exp(-dot(q, q) / 0.05);
	if (values.which < 1.5) {
		var dye = field_density(uv).x;
		if (values.mode < 1.5) { dye = min(dye + core * 0.14 + body * 0.22, 1.7); }
		if (values.mode > 1.5 && values.frame < 2.0) {
			let bank = noise(uv * vec2f(3.2, 2.3));
			let wisp = noise(uv * vec2f(6.5, 4.4) + vec2f(2.0, 1.0));
			dye = 0.22 + 0.72 * bank + 0.28 * wisp;
		}
		return vec4f(dye, 0.0, 0.0, 1.0);
	}
	var heat = field_temperature(uv).x;
	if (values.mode < 1.5) { heat = min(heat + core * 0.5, 1.5); }
	return vec4f(heat, 0.0, 0.0, 1.0);
')
divergence = bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).x;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).x;
	let down = field_velocity(uv + vec2f(0.0, t.y)).y;
	let up = field_velocity(uv - vec2f(0.0, t.y)).y;
	return vec4f(0.5 * (right - left + down - up), 0.0, 0.0, 1.0);
')
jacobi = fragment(uv_of + '
	let t = values.texel;
	let pressure = field_pressure(uv + vec2f(t.x, 0.0)).x + field_pressure(uv - vec2f(t.x, 0.0)).x + field_pressure(uv + vec2f(0.0, t.y)).x + field_pressure(uv - vec2f(0.0, t.y)).x;
	return vec4f((pressure - field_divergence(uv).x) * 0.25, 0.0, 0.0, 1.0);
')
project = bounds + fragment(uv_of + '
	if (inside(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let gx = field_pressure(uv + vec2f(t.x, 0.0)).x - field_pressure(uv - vec2f(t.x, 0.0)).x;
	let gy = field_pressure(uv + vec2f(0.0, t.y)).x - field_pressure(uv - vec2f(0.0, t.y)).x;
	let v = clamp(field_velocity(uv).xy - vec2f(gx, gy) * 0.5, vec2f(-0.16), vec2f(0.16));
	return vec4f(v, 0.0, 0.0);
')
shade = common + '
fn spread(uv: vec2f, dye: bool) -> f32 {
	let t = values.texel * 5.5;
	var sum = 0.0;
	for (var i = 0; i < 5; i = i + 1) {
		var o = vec2f(0.0);
		if (i == 1) { o = vec2f(t.x, 0.0); }
		if (i == 2) { o = vec2f(-t.x, 0.0); }
		if (i == 3) { o = vec2f(0.0, t.y); }
		if (i == 4) { o = vec2f(0.0, -t.y); }
		let p = uv + o;
		let v = select(field_temperature(p).x, field_density(p).x, dye);
		sum += v * select(1.0, 2.0, i == 0);
	}
	return sum / 6.0;
}
fn ramp(heat: f32) -> vec3f {
	var fire = vec3f(0.74, 0.72, 0.70);
	fire = mix(fire, vec3f(0.92, 0.48, 0.58), smoothstep(0.22, 0.32, heat));
	fire = mix(fire, vec3f(1.0, 0.34, 0.08), smoothstep(0.30, 0.44, heat));
	fire = mix(fire, vec3f(1.0, 0.55, 0.08), smoothstep(0.42, 0.58, heat));
	fire = mix(fire, vec3f(1.0, 0.84, 0.32), smoothstep(0.55, 0.76, heat));
	return mix(fire, vec3f(1.0, 0.97, 0.92), smoothstep(0.74, 1.05, heat));
}
' + fragment(uv_of + '
	let t = values.texel * 2.2;
	let height = spread(uv, true);
	let hx = spread(uv + vec2f(t.x, 0.0), true) - spread(uv - vec2f(t.x, 0.0), true);
	let hy = spread(uv + vec2f(0.0, t.y), true) - spread(uv - vec2f(0.0, t.y), true);
	let normal = normalize(vec3f(-hx * values.slope, -hy * values.slope, 1.0));
	let light = normalize(vec3f(-0.32, -0.78, 0.54));
	let diffuse = clamp(dot(normal, light), 0.0, 1.0);
	let half_l = normalize(light + vec3f(0.0, 0.0, 1.0));
	let spec = pow(clamp(dot(normal, half_l), 0.0, 1.0), 24.0);
	var shadow = 1.0;
	var pos = uv;
	var cover = height;
	let march = vec2f(light.x, light.y) * t * 1.35;
	for (var i = 0u; i < 7u; i = i + 1u) {
		pos = pos + march;
		cover = cover + 0.055;
		if (spread(pos, true) > cover) { shadow = min(shadow, 0.58); }
	}
	let heat = spread(uv, false);
	let fire = ramp(heat);
	let lit = (0.45 + 0.55 * diffuse) * shadow;
	let torch = fire * lit + vec3f(1.0, 0.95, 0.85) * spec * shadow * 0.22;
	let glow = fire * smoothstep(0.55, 1.05, heat) * 0.18;
	let fade = smoothstep(0.04, 0.42, uv.y);
	let torch_alpha = smoothstep(0.004, 0.32, height) * fade;
	let fog = vec3f(0.80, 0.84, 0.90) * (0.58 + 0.42 * diffuse) * (0.78 + 0.22 * shadow);
	let fog_alpha = smoothstep(0.04, 0.36, height) * 0.97;
	let cell = floor(uv * vec2f(20.0, 12.0));
	let checker = fract(cell.x * 0.5 + cell.y * 0.5) * 2.0;
	var ground = mix(vec3f(0.36, 0.40, 0.32), vec3f(0.44, 0.40, 0.33), clamp(checker, 0.0, 1.0));
	let road = smoothstep(0.09, 0.0, abs(uv.x - 0.5) - 0.055);
	ground = mix(ground, vec3f(0.40, 0.34, 0.26), road * 0.85);
	var behind = select(vec3f(0.012, 0.008, 0.016), ground, values.mode > 1.5);
	let cup = (uv - vec2f(0.50, 0.86)) * vec2f(values.aspect, 1.0);
	let cup_d = dot(cup / vec2f(0.055, 0.022), cup / vec2f(0.055, 0.022));
	if (values.mode < 1.5 && cup_d < 1.0) {
		behind = mix(vec3f(0.10, 0.07, 0.05), vec3f(0.28, 0.16, 0.08), clamp(0.5 + cup.x * 8.0, 0.0, 1.0));
	}
	let body = select(torch, fog, values.mode > 1.5);
	let alpha = select(torch_alpha, fog_alpha, values.mode > 1.5);
	var color = mix(behind, body, alpha);
	if (values.mode < 1.5) { color = color + glow * torch_alpha; }
	if (values.mode < 1.5 && heat > 0.7 && height > 0.2) {
		let spark_uv = uv * vec2f(22.0, 48.0) + vec2f(0.0, -values.frame * 0.5);
		let id = floor(spark_uv);
		let n = hash(id);
		let local = fract(spark_uv) - vec2f(0.5);
		let spark = smoothstep(0.07, 0.0, length(local)) * step(0.997, n);
		color = color + vec3f(1.0, 0.9, 0.55) * spark;
	}
	let q = pillar_q(uv);
	let along = clamp(q.y, -0.12, 0.12);
	let capsule = length(vec2f(q.x, q.y - along)) - 0.09;
	if (values.mode > 1.5 && capsule < 0.0) {
		let shade = 0.28 + 0.72 * clamp(0.15 + q.x * 7.0 + 0.55, 0.0, 1.0);
		let stone = vec3f(0.34, 0.36, 0.40) * shade;
		let highlight = smoothstep(0.02, 0.0, abs(q.x + 0.03)) * 0.18;
		color = stone + vec3f(highlight);
	}
	return vec4f(color, 1.0);
')

pointer() := {
	if windowless() and mode == 2 {
		if frame_i < 36 { return [view_w * 0.82, view_h * 0.70] }
		if frame_i < 150 {
			u = (frame_i - 36) / 114.0
			return [view_w * (0.14 + 0.72 * u), view_h * (0.46 + 0.05 * sin(u * 6.2832))]
		}
		angle = (frame_i - 150) * 0.09
		return [view_w * (0.50 + 0.20 * cos(angle)), view_h * (0.46 + 0.14 * sin(angle))]
	}
	[system_value("mouse_x"), system_value("mouse_y")]
}
stirring() := {
	if mode != 2 { return 0.0 }
	if windowless() { return if frame_i > 36 then 0.085 else 0.0 }
	if system_value("mouse_down") == 1 { return 0.09 }
	0.028
}
values_of(kept, kind, soft) := {
	made = {}
	made["mouse"] = pointer()
	made["view"] = [view_w, view_h]
	made["mouse_down"] = system_value("mouse_down")
	made["frame"] = frame_i
	made["mode"] = mode
	made["dt"] = 1.0
	made["texel"] = [1.0 / grid_w, 1.0 / grid_h]
	made["lift"] = if mode == 1 then 0.0018 else 0.0
	made["confinement"] = if mode == 1 then 0.015 else 0.05
	made["stir_force"] = stirring()
	made["slope"] = if mode == 1 then 3.4 else 1.15
	made["keep"] = kept
	made["which"] = kind
	made["soft"] = soft
	made["aspect"] = aspect
	made["drift"] = if mode == 2 then 0.007 else 0.0
	made["time"] = frame_i / 60.0
	made
}
sim_pass(shader, into, kept, kind, soft) := {
	made = values_of(kept, kind, soft)
	made["size"] = [grid_w, grid_h]
	gpu_pass(shader, fields, into, made)
}
simulate(picture) := {
	sim_pass(advect_velocity, "velocity", if mode == 1 then 0.97 else 0.992, 0, 0.28)
	sim_pass(buoyancy, "velocity", 1, 0, 0)
	sim_pass(vorticity, "velocity", 1, 0, 0)
	sim_pass(forces, "velocity", 1, 0, 0)
	sim_pass(advect("density"), "density", if mode == 1 then 0.998 else 0.999, 0, if mode == 1 then 0.48 else 0.3)
	sim_pass(advect("temperature"), "temperature", 0.955, 0, 0.45)
	sim_pass(inject, "density", 1, 1, 0)
	sim_pass(inject, "temperature", 1, 2, 0)
	sim_pass(divergence, "divergence", 1, 0, 0)
	var n = 0
	while n < pressure_steps {
		sim_pass(jacobi, "pressure", 1, 0, 0)
		n = n + 1
	}
	sim_pass(project, "velocity", 1, 0, 0)
	if picture { gpu_picture_sized(shade, fields, view_w, view_h, values_of(1, 0, 0)) }
	else { gpu_show_sized(shade, fields, view_w, view_h, values_of(1, 0, 0)) }
}
shot(step) := {
	if not windowless() { return no }
	if movie and step % 4 == 0 { return yes }
	step == steps or step == 60 or step == 120 or step == 240
}

if not windowless() {
	set_system_value("window_width", view_w)
	set_system_value("window_height", view_h)
}
on frame {
	if not windowless() {
		name = key_name(system_value("key code pressed"))
		if name == "f" or name == "F" { mode = 3 - mode }
		else if name == "1" or name == "t" or name == "T" { mode = 1 }
		else if name == "2" { mode = 2 }
		else if name == "Escape" or name == "q" or name == "Q" { exit() }
		frame_i = frame_i + 1
		simulate(no)
	}
}
on click { mode = 3 - mode }
if windowless() {
	step = 0
	while step < steps {
		step = step + 1
		frame_i = step
		if shot(step) { paint(simulate(yes), view_w, view_h, []) }
		else { simulate(no) }
	}
}
