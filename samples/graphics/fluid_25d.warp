#!/usr/bin/env warp
# A torch, and the fog that drifts around a pillar (samples/graphics/fluid_25d.warp). The picture follows a visual
# idea by @r4nM4_64; nothing here was copied (notices/fluid_25d.md). The fluid is Stam's stable fluids, on the GPU.
# Density is sharpened with one MacCormack step. Pressure is two separable convolutions, the rank-1 Jacobi kernel
# of Rabbani and Khiat, instead of a Jacobi loop. The picture ray-marches a slab: density is a thickness about the
# plane, and a short march accumulates emission, absorption and a few light samples. Window y grows downward, so a
# rising flame is a negative v. The grid is 384 by 216. The picture is 960 by 540, and on a Retina drawable the
# shade pass fills that drawable. Mode 1, torch: a short ragged tongue and thin smoke that rolls and fades. Mode 2,
# fog: a bank relaxed toward noise, the pointer pushes it, a round pillar blocks the flow. f, 1, 2 or a click
# switches. Headless: an argument fog or torch. short stops at 80 frames, snap paints the first frame, movie
# writes every second frame, --times prints each frame's upload and draw in milliseconds.
use os
use keys
use gpu_passes

mode = 1
timing = no
steps = 240
movie = no
for arg in args {
	if arg == "--times" { timing = yes }
	else if arg == "fog" or arg == "2" { mode = 2 }
	else if arg == "torch" or arg == "1" { mode = 1 }
	else if arg == "short" { steps = 80 }
	else if arg == "snap" { steps = 1 }
	else if arg == "movie" { movie = yes }
}
if timing { set_system_value("paint timing", 1) }

grid_w = 384
grid_h = 216
view_w = 960
view_h = 540
frame_i = 0
aspect = grid_w * 1.0 / grid_h
fields = gpu_fields(grid_w, grid_h, ["velocity", "density", "temperature", "pressure", "divergence"])

fragment(body) := "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {\n" + body + "\n}\n"
common = '
fn hash(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn noise(p: vec2f) -> f32 {
	let i = floor(p);
	let f = fract(p);
	let u = f * f * (3.0 - 2.0 * f);
	let a = hash(i);
	let b = hash(i + vec2f(1.0, 0.0));
	let c = hash(i + vec2f(0.0, 1.0));
	let d = hash(i + vec2f(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
fn fbm(p: vec2f) -> f32 { return noise(p) * 0.62 + noise(p * 2.1 + vec2f(1.7, 9.2)) * 0.38; }
fn wobble() -> vec2f { return vec2f(sin(values.time * 3.1) * 0.008, cos(values.time * 2.4) * 0.004); }
fn pillar_q(uv: vec2f) -> vec2f { return (uv - vec2f(0.50, 0.48)) * vec2f(values.aspect, 1.0); }
fn pillar_hit(uv: vec2f) -> bool { return values.mode > 1.5 && dot(pillar_q(uv), pillar_q(uv)) < 0.0011; }
fn flame_q(uv: vec2f) -> vec2f { return (uv - vec2f(0.50, 0.62) - wobble()) * vec2f(values.aspect, 1.0); }
fn tongue(uv: vec2f) -> f32 {
	let q = flame_q(uv) + vec2f(0.0, 0.06);
	let cell = vec2f(floor(uv.x * 48.0), floor(uv.y * 80.0 + values.time * 13.0));
	let jag = 0.82 + 0.18 * hash(cell);
	let lick = 0.7 + 0.3 * hash(cell + vec2f(values.time, 2.0));
	let stretched = q / vec2f(1.15, 0.85);
	return exp(-dot(stretched, stretched) / (0.0072 * jag)) * lick;
}
fn wall(uv: vec2f) -> bool {
	let edge = uv.x < 0.008 || uv.x > 0.992 || uv.y > 0.992;
	return values.mode < 1.5 && edge;
}
fn thin(uv: vec2f) -> f32 {
	let up = mix(0.86, 1.0, smoothstep(0.0, 0.50, uv.y));
	return select(1.0, up, values.mode < 1.5);
}
fn curl_noise(uv: vec2f, scale: vec2f, drift: vec2f) -> vec2f {
	let p = uv * scale + drift;
	let dx = noise(p + vec2f(0.15, 0.0)) - noise(p - vec2f(0.15, 0.0));
	let dy = noise(p + vec2f(0.0, 0.15)) - noise(p - vec2f(0.0, 0.15));
	return vec2f(dy, -dx);
}
'
bounds = common + '
fn stopped(uv: vec2f) -> bool { return wall(uv) || pillar_hit(uv); }
'
uv_of = "let uv = at.xy / values.size;\n"
advect_velocity = bounds + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	let wind = field_velocity(uv).xy;
	let carried = field_velocity(uv - wind * values.dt).xy;
	let t = values.texel;
	let blur = (field_velocity(uv + vec2f(t.x, 0.0)).xy + field_velocity(uv - vec2f(t.x, 0.0)).xy + field_velocity(uv + vec2f(0.0, t.y)).xy + field_velocity(uv - vec2f(0.0, t.y)).xy) * 0.25;
	return vec4f(mix(carried, blur, values.soft) * values.keep, 0.0, 0.0);
')
buoyancy = bounds + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	let v = field_velocity(uv).xy;
	let hot = max(field_temperature(uv).x - 0.05, 0.0);
	return vec4f(v.x, v.y - hot * values.lift, 0.0, 0.0);
')
vorticity = bounds + '
fn curl_at(uv: vec2f) -> f32 {
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).y;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).y;
	let down = field_velocity(uv + vec2f(0.0, t.y)).x;
	let up = field_velocity(uv - vec2f(0.0, t.y)).x;
	return 0.5 * ((right - left) - (down - up));
}
' + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let curl = curl_at(uv);
	let dx = abs(curl_at(uv + vec2f(t.x, 0.0))) - abs(curl_at(uv - vec2f(t.x, 0.0)));
	let dy = abs(curl_at(uv + vec2f(0.0, t.y))) - abs(curl_at(uv - vec2f(0.0, t.y)));
	let len = max(length(vec2f(dx, dy)), 0.0001);
	let force = vec2f(dy, -dx) / len * curl * values.confinement;
	return vec4f(field_velocity(uv).xy + force, 0.0, 0.0);
')
forces = bounds + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	var v = field_velocity(uv).xy;
	let gust = curl_noise(uv, vec2f(5.0, 4.0), vec2f(values.time * 0.07, -values.time * 0.05));
	v = v + gust * values.gust;
	if (values.mode < 1.5) {
		let puff = curl_noise(uv, vec2f(28.0, 40.0), vec2f(1.0, -values.time * 0.8));
		let wag = sin(values.time * 6.3) * 0.4 + sin(values.time * 2.2) * 0.15;
		v = v + vec2f(0.0, -0.0006) + puff * 0.01 + vec2f(wag, -1.0) * tongue(uv) * 0.0011;
	}
	let pointer = values.mouse / values.view;
	let away = (uv - pointer) * vec2f(values.aspect, 1.0);
	let reach = exp(-dot(away, away) / 0.012);
	let spin = vec2f(-away.y, away.x) / vec2f(values.aspect, 1.0);
	v = v + spin * reach * values.stir_force;
	v = clamp(v, vec2f(-0.08), vec2f(0.08));
	return vec4f(v, 0.0, 0.0);
')
stash = common + fragment(uv_of + '
	return vec4f(field_density(uv).x, 0.0, 0.0, 1.0);
')
forward = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let back = uv - field_velocity(uv).xy * values.dt;
	return vec4f(max(field_density(back).x, 0.0), 0.0, 0.0, 1.0);
')
rewind = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let ahead = uv + field_velocity(uv).xy * values.dt;
	return vec4f(max(field_density(ahead).x, 0.0), 0.0, 0.0, 1.0);
')
correct = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let hat = field_density(uv).x;
	let orig = field_divergence(uv).x;
	let back = field_pressure(uv).x;
	let gain = select(0.0, 0.5, values.mode < 1.5);
	let sharpened = hat + gain * (orig - back);
	let dye = clamp(sharpened, 0.0, max(hat, orig));
	return vec4f(dye * values.keep * thin(uv), 0.0, 0.0, 1.0);
')
advect_heat = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let back = uv - field_velocity(uv).xy * values.dt;
	return vec4f(max(field_temperature(back).x, 0.0) * values.keep, 0.0, 0.0, 1.0);
')
torch_dye = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let spark = 0.7 + 0.3 * hash(vec2f(floor(uv.x * 80.0), floor(uv.y * 140.0 + values.time * 18.0)));
	let dye = min(field_density(uv).x + tongue(uv) * 0.12 * spark, 1.15);
	return vec4f(dye, 0.0, 0.0, 1.0);
')
torch_heat = bounds + fragment(uv_of + '
	if (wall(uv)) { return vec4f(0.0); }
	let heat = min(field_temperature(uv).x + tongue(uv) * 0.30, 1.35);
	return vec4f(heat, 0.0, 0.0, 1.0);
')
fog_coarse = bounds + fragment(uv_of + '
	let p = uv * vec2f(6.4, 5.0) + vec2f(values.time * 0.04, values.time * 0.025);
	let n = noise(p);
	let dye = mix(field_density(uv).x, 0.20 + 0.85 * n, 0.05);
	return vec4f(dye, 0.0, 0.0, 1.0);
')
fog_fine = bounds + fragment(uv_of + '
	let p = uv * vec2f(13.0, 10.5) + vec2f(values.time * 0.05, 1.7);
	let n = noise(p);
	let dye = field_density(uv).x + (n - 0.5) * 0.07;
	return vec4f(clamp(dye, 0.0, 1.2), 0.0, 0.0, 1.0);
')
divergence = bounds + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).x;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).x;
	let down = field_velocity(uv + vec2f(0.0, t.y)).y;
	let up = field_velocity(uv - vec2f(0.0, t.y)).y;
	return vec4f(0.5 * (right - left + down - up), 0.0, 0.0, 1.0);
')
poisson = '
fn weight(i: i32) -> f32 {
	let w = array<f32, 11>(0.057610, 0.097961, 0.161440, 0.257644, 0.405773, 0.642708, 0.405773, 0.257644, 0.161440, 0.097961, 0.057610);
	return w[i];
}
' + fragment(uv_of + '
	var sum = 0.0;
	let across = select(vec2f(0.0, values.texel.y), vec2f(values.texel.x, 0.0), values.which < 1.5);
	let sign = select(-1.0, 1.0, values.which < 1.5);
	for (var i = 0; i < 11; i = i + 1) {
		let p = uv + across * f32(i - 5);
		let inside = step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);
		let sample = select(field_pressure(p).x, field_divergence(p).x, values.which < 1.5);
		sum = sum + weight(i) * sign * sample * inside;
	}
	return vec4f(sum, 0.0, 0.0, 1.0);
')
project = bounds + fragment(uv_of + '
	if (stopped(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let gx = field_pressure(uv + vec2f(t.x, 0.0)).x - field_pressure(uv - vec2f(t.x, 0.0)).x;
	let gy = field_pressure(uv + vec2f(0.0, t.y)).x - field_pressure(uv - vec2f(0.0, t.y)).x;
	let v = clamp(field_velocity(uv).xy - vec2f(gx, gy) * 0.5, vec2f(-0.08), vec2f(0.08));
	return vec4f(v, 0.0, 0.0);
')
shade = common + '
fn rho(uv: vec2f) -> f32 { return max(field_density(uv).x, 0.0); }
fn ramp(heat: f32) -> vec3f {
	var fire = vec3f(0.55, 0.05, 0.08);
	fire = mix(fire, vec3f(0.95, 0.22, 0.05), smoothstep(0.15, 0.40, heat));
	fire = mix(fire, vec3f(1.0, 0.62, 0.12), smoothstep(0.38, 0.70, heat));
	return mix(fire, vec3f(1.0, 0.96, 0.82), smoothstep(0.68, 1.05, heat));
}
fn profile(z: f32, h: f32) -> f32 {
	let u = z / max(h, 0.001);
	return max(1.0 - u * u, 0.0);
}
' + fragment(uv_of + '
	let t = values.texel * 2.0;
	let c = rho(uv);
	let right = rho(uv + vec2f(t.x, 0.0));
	let left = rho(uv - vec2f(t.x, 0.0));
	let down = rho(uv + vec2f(0.0, t.y));
	let up = rho(uv - vec2f(0.0, t.y));
	let d = (c * 2.0 + right + left + down + up) / 6.0;
	let gx = right - left;
	let gy = down - up;
	let heat = max(field_temperature(uv).x, 0.0);
	let torch = values.mode < 1.5;
	let h = mix(0.28, 1.0, smoothstep(0.0, 0.85, d));
	let sigma = select(2.6, 5.2, torch) * values.slope;
	let light = select(normalize(vec3f(0.10, -0.20, 0.95)), normalize(vec3f(0.08, 0.72, 0.58)), torch);
	let warm_l = smoothstep(0.0, 0.35, heat);
	let light_col = select(vec3f(0.82, 0.90, 0.86), mix(vec3f(0.72, 0.66, 0.64), vec3f(1.0, 0.48, 0.28), warm_l), torch);
	let steps = 8.0;
	let dz = (2.0 * h) / steps;
	var z = h - dz * 0.5;
	var transmittance = 1.0;
	var rgb = vec3f(0.0);
	for (var i = 0; i < 8; i = i + 1) {
		let shape = profile(z, h);
		let rho_z = d * shape;
		let dpdz = -2.0 * z / max(h * h, 0.0001);
		let xy = select(0.08, 1.2, torch);
		let normal = normalize(vec3f(-gx * shape * xy, -gy * shape * xy, -d * dpdz) + vec3f(0.0, 0.0, 0.001));
		let diffuse = clamp(dot(normal, light), 0.0, 1.0);
		var shadow = 1.0;
		var suv = uv;
		var sz = z;
		for (var j = 0; j < 3; j = j + 1) {
			suv = suv + light.xy * 0.016;
			sz = sz + light.z * 0.05;
			let cover = rho(suv) * profile(sz, h);
			shadow = shadow * exp(-cover * select(0.12, 0.40, torch));
		}
		let warm = smoothstep(0.0, 0.45, heat * shape);
		let smoke = mix(vec3f(0.78, 0.70, 0.72), vec3f(0.85, 0.32, 0.36), warm);
		let albedo = select(vec3f(0.84, 0.90, 0.88), smoke, torch);
		let ambience = select(0.78, 0.34, torch);
		let lit = albedo * light_col * (ambience + (1.0 - ambience) * diffuse) * shadow;
		let absorb = 1.0 - exp(-rho_z * sigma * dz);
		let glow = ramp(heat) * max(heat * shape - 0.08, 0.0);
		let flame_lit = glow * (0.5 + 0.5 * diffuse) * mix(1.0, shadow, 0.4) * dz * 5.4;
		rgb = rgb + transmittance * (lit * absorb + flame_lit);
		transmittance = transmittance * (1.0 - absorb);
		z = z - dz;
	}
	let px0 = (uv.x - 0.50) * values.aspect;
	let pool_q = vec2f(px0 * 0.8, (uv.y - 0.80) * 2.4);
	let pool = exp(-dot(pool_q, pool_q) / 0.09);
	let sky = vec3f(0.006, 0.005, 0.008) + vec3f(0.26, 0.09, 0.025) * pool;
	let earth = mix(vec3f(0.10, 0.16, 0.09), vec3f(0.30, 0.26, 0.14), noise(uv * vec2f(5.0, 3.6)));
	var behind = select(earth, sky, torch);
	if (torch) {
		let px = (uv.x - 0.50) * values.aspect;
		let shaft = abs(px) < 0.026 && uv.y > 0.64;
		if (shaft) {
			let metal = 0.25 + 0.75 * smoothstep(-0.026, 0.026, px);
			behind = vec3f(0.025, 0.018, 0.014) * metal;
			let band = fract((uv.y - 0.64) * 14.0);
			if (band > 0.72 && uv.y < 0.92) { behind = vec3f(0.45, 0.14, 0.05) * metal; }
		}
		let cup = vec2f(px, uv.y - 0.635);
		let rim = abs(length(cup / vec2f(0.055, 0.016)) - 1.0);
		if (rim < 0.18 && abs(cup.y) < 0.02) { behind = vec3f(0.10, 0.07, 0.05); }
	}
	var color = behind * transmittance + rgb;
	if (torch) {
		let spark_uv = uv * vec2f(30.0, 62.0) + vec2f(0.0, -values.frame * 0.7);
		let spark = step(0.997, hash(floor(spark_uv))) * smoothstep(0.05, 0.0, length(fract(spark_uv) - 0.5));
		color = color + vec3f(1.0, 0.84, 0.45) * spark * smoothstep(0.08, 0.4, heat);
	}
	let q = pillar_q(uv);
	let along = clamp(q.y, -0.026, 0.026);
	let capsule = length(vec2f(q.x, q.y - along)) - 0.024;
	if (!torch && capsule < 0.02) {
		let lit_p = 0.62 + 0.38 * clamp(0.15 + q.x * 16.0, 0.0, 1.0);
		color = mix(color, vec3f(0.80, 0.82, 0.80) * lit_p, smoothstep(0.02, 0.0, capsule));
	}
	let grain = hash(vec2f(at.x, at.y) + vec2f(values.frame, 0.0));
	color = color + (grain - 0.5) / 255.0;
	return vec4f(color, 1.0);
')

pointer() := {
	if windowless() and mode == 2 {
		if frame_i < 28 { return [view_w * 0.84, view_h * 0.62] }
		if frame_i < 150 {
			u = (frame_i - 28) / 122.0
			return [view_w * (0.16 + 0.68 * u), view_h * (0.50 + 0.06 * sin(u * 6.2832))]
		}
		angle = (frame_i - 150) * 0.08
		return [view_w * (0.50 + 0.16 * cos(angle)), view_h * (0.48 + 0.12 * sin(angle))]
	}
	[system_value("mouse_x"), system_value("mouse_y")]
}
stirring() := {
	if mode != 2 { return 0.0 }
	if windowless() { return if frame_i > 28 then 0.0014 else 0.0 }
	if system_value("mouse_down") == 1 { return 0.002 }
	0.00035
}
values_of(kept) := {
	made = {}
	made["mouse"] = pointer()
	made["view"] = [view_w, view_h]
	made["mouse_down"] = system_value("mouse_down")
	made["frame"] = frame_i
	made["mode"] = mode
	made["dt"] = 1.0
	made["texel"] = [1.0 / grid_w, 1.0 / grid_h]
	made["lift"] = if mode == 1 then 0.00055 else 0.0
	made["confinement"] = if mode == 1 then 0.022 else 0.02
	made["stir_force"] = stirring()
	made["slope"] = if mode == 1 then 1.0 else 0.85
	made["keep"] = kept
	made["which"] = 0
	made["soft"] = 0
	made["aspect"] = aspect
	made["gust"] = if mode == 1 then 0.0016 else 0.003
	made["time"] = frame_i / 60.0
	made
}
sim_pass(shader, into, kept) := {
	made = values_of(kept)
	made["size"] = [grid_w, grid_h]
	gpu_pass(shader, fields, into, made)
}
project_pressure() := {
	made = values_of(1)
	made["size"] = [grid_w, grid_h]
	made["which"] = 1
	gpu_pass(poisson, fields, "pressure", made)
	made["which"] = 2
	gpu_pass(poisson, fields, "pressure", made)
	sim_pass(project, "velocity", 1)
}
feed() := {
	if mode == 2 {
		made = values_of(1)
		made["size"] = [grid_w, grid_h]
		gpu_pass(fog_coarse, fields, "density", made)
		gpu_pass(fog_fine, fields, "density", made)
	} else {
		made = values_of(1)
		made["size"] = [grid_w, grid_h]
		gpu_pass(torch_dye, fields, "density", made)
		gpu_pass(torch_heat, fields, "temperature", made)
	}
}
simulate(picture) := {
	vel_keep = if mode == 1 then 0.97 else 0.99
	wind = values_of(vel_keep)
	wind["soft"] = 0.16
	wind["size"] = [grid_w, grid_h]
	gpu_pass(advect_velocity, fields, "velocity", wind)
	sim_pass(buoyancy, "velocity", 1)
	sim_pass(vorticity, "velocity", 1)
	sim_pass(forces, "velocity", 1)
	sim_pass(divergence, "divergence", 1)
	project_pressure()
	dye_keep = if mode == 1 then 0.994 else 0.996
	sim_pass(stash, "divergence", 1)
	sim_pass(forward, "density", 1)
	sim_pass(rewind, "pressure", 1)
	sim_pass(correct, "density", dye_keep)
	sim_pass(advect_heat, "temperature", if mode == 1 then 0.93 else 0.99)
	feed()
	if picture { gpu_picture_sized(shade, fields, view_w, view_h, values_of(1)) }
	else { gpu_show_sized(shade, fields, view_w, view_h, values_of(1)) }
}
shot(step) := {
	if not windowless() { return no }
	if movie and step % 2 == 0 { return yes }
	step == steps or step == 60 or step == 120 or step == 240
}

if not windowless() {
	set_system_value("window_width", view_w)
	set_system_value("window_height", view_h)
}
on frame {
	if not windowless() {
		name = key_name(system_value("key code pressed"))
		if name == "f" or name == "F" { mode = 3 - mode }
		else if name == "1" or name == "t" or name == "T" { mode = 1 }
		else if name == "2" { mode = 2 }
		else if name == "Escape" or name == "q" or name == "Q" { exit() }
		frame_i = frame_i + 1
		simulate(no)
	}
}
on click { mode = 3 - mode }
if windowless() {
	step = 0
	while step < steps {
		step = step + 1
		frame_i = step
		if shot(step) { paint(simulate(yes), view_w, view_h, []) }
		else { simulate(no) }
	}
}
