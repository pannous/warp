#!/usr/bin/env warp
# A torch, and the fog that drifts around a pillar (samples/graphics/fluid_25d.warp). The picture follows a visual
# idea by @r4nM4_64; nothing here was copied (notices/fluid_25d.md). The fluid is Stam's stable fluids, on the GPU:
# advect, buoyancy, vorticity, divergence, Jacobi pressure, then the gradient taken back off the velocity. The shade
# reads the density as a height, lights it, and marches a few steps toward the light for a self-shadow.
# Mode 1, torch (the default): a flame from an emitter. Mode 2, fog: pale smoke over a ground, the pointer pushes
# it, a pillar blocks it. f, 1, 2 or a click switches. Headless: an argument fog or torch, and --times prints each
# frame's upload and draw in milliseconds.
use os
use keys
use gpu_passes

mode = 1
timing = no
for arg in args {
	if arg == "--times" { timing = yes }
	else if arg == "fog" or arg == "2" { mode = 2 }
	else if arg == "torch" or arg == "1" { mode = 1 }
}
if timing { set_system_value("paint timing", 1) }

wide = if windowless() then 192 else 640
high = if windowless() then 108 else 360
frame_i = 0
fields = gpu_fields(wide, high, ["velocity", "density", "temperature", "pressure", "divergence"])

pillar = "values.mode > 1.5 && dot(uv - vec2f(0.50, 0.42), uv - vec2f(0.50, 0.42)) < 0.016"
fragment(body) := "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {\n" + body + "\n}\n"
sim = '
fn blocked(uv: vec2f) -> bool {
	let edge = uv.x < 0.012 || uv.y < 0.012 || uv.x > 0.988 || uv.y > 0.988;
	let pillar = ' + pillar + ';
	return edge || pillar;
}
'
advect(name) := sim + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let wind = field_velocity(uv).xy;
	return field_' + name + '(uv - wind * values.dt) * values.keep;
')
advect_velocity = sim + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let wind = field_velocity(uv).xy;
	let carried = field_velocity(uv - wind * values.dt).xy;
	let t = values.texel;
	let blur = (field_velocity(uv + vec2f(t.x, 0.0)).xy + field_velocity(uv - vec2f(t.x, 0.0)).xy + field_velocity(uv + vec2f(0.0, t.y)).xy + field_velocity(uv - vec2f(0.0, t.y)).xy) * 0.25;
	return vec4f(mix(carried, blur, 0.12) * values.keep, 0.0, 0.0);
')
buoyancy = sim + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let v = field_velocity(uv).xy;
	return vec4f(v.x, v.y - field_temperature(uv).x * values.lift, 0.0, 0.0);
')
vorticity = sim + '
fn curl_at(uv: vec2f) -> f32 {
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).y;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).y;
	let below = field_velocity(uv + vec2f(0.0, t.y)).x;
	let above = field_velocity(uv - vec2f(0.0, t.y)).x;
	return 0.5 * ((right - left) - (below - above));
}
' + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let curl = curl_at(uv);
	let dx = curl_at(uv + vec2f(t.x, 0.0)) - curl_at(uv - vec2f(t.x, 0.0));
	let dy = curl_at(uv + vec2f(0.0, t.y)) - curl_at(uv - vec2f(0.0, t.y));
	let len = sqrt(dx * dx + dy * dy) + 0.0001;
	let force = vec2f(dy, -dx) / len * curl * values.confinement;
	return vec4f(field_velocity(uv).xy + force, 0.0, 0.0);
')
splat = sim + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let flame = vec2f(0.50, 0.86);
	let hot = exp(-dot(uv - flame, uv - flame) / 0.0022);
	let pointer = values.mouse / values.size;
	let away = uv - pointer;
	let puff = exp(-dot(away, away) / 0.0035);
	let stirring = values.mode > 1.5 || values.mouse_down > 0.5;
	let strength = select(0.25, 1.0, values.mouse_down > 0.5 || values.stir > 0.5);
	let vel = field_velocity(uv);
	let dye = field_density(uv);
	let heat = field_temperature(uv);
	if (values.which < 0.5) {
		var push = vec2f(0.0, select(0.0, -hot * 0.025, values.mode < 1.5));
		if (stirring) { push = push + vec2f(-away.y, away.x) * puff * 0.4 * strength + away * puff * 0.12 * strength; }
		return vec4f(vel.xy + push, 0.0, 0.0);
	}
	if (values.which < 1.5) {
		var added = select(0.0, hot * 0.4, values.mode < 1.5);
		if (values.mode > 1.5 && values.frame < 48.0) { added = added + 0.03; }
		return vec4f(min(dye.x + added, 1.3), 0.0, 0.0, 1.0);
	}
	var warmed = select(0.0, hot * 0.6, values.mode < 1.5);
	if (values.mode > 1.5 && values.frame < 24.0) { warmed = warmed + 0.015; }
	return vec4f(min(heat.x + warmed, 1.6), 0.0, 0.0, 1.0);
')
divergence = sim + fragment('
	let uv = at.xy / values.size;
	let t = values.texel;
	let right = field_velocity(uv + vec2f(t.x, 0.0)).x;
	let left = field_velocity(uv - vec2f(t.x, 0.0)).x;
	let below = field_velocity(uv + vec2f(0.0, t.y)).y;
	let above = field_velocity(uv - vec2f(0.0, t.y)).y;
	return vec4f(0.5 * (right - left + below - above), 0.0, 0.0, 1.0);
')
jacobi = fragment('
	let uv = at.xy / values.size;
	let t = values.texel;
	let pressure = field_pressure(uv + vec2f(t.x, 0.0)).x + field_pressure(uv - vec2f(t.x, 0.0)).x + field_pressure(uv + vec2f(0.0, t.y)).x + field_pressure(uv - vec2f(0.0, t.y)).x;
	return vec4f((pressure - field_divergence(uv).x) * 0.25, 0.0, 0.0, 1.0);
')
project = sim + fragment('
	let uv = at.xy / values.size;
	if (blocked(uv)) { return vec4f(0.0); }
	let t = values.texel;
	let gx = field_pressure(uv + vec2f(t.x, 0.0)).x - field_pressure(uv - vec2f(t.x, 0.0)).x;
	let gy = field_pressure(uv + vec2f(0.0, t.y)).x - field_pressure(uv - vec2f(0.0, t.y)).x;
	return vec4f(field_velocity(uv).xy - vec2f(gx, gy) * 0.5, 0.0, 0.0);
')
shade = fragment('
	let uv = at.xy / values.size;
	let t = values.texel;
	let height = field_density(uv).x;
	let hx = field_density(uv + vec2f(t.x, 0.0)).x - field_density(uv - vec2f(t.x, 0.0)).x;
	let hy = field_density(uv + vec2f(0.0, t.y)).x - field_density(uv - vec2f(0.0, t.y)).x;
	let normal = normalize(vec3f(-hx * values.slope, -hy * values.slope, 1.0));
	let light = normalize(vec3f(-0.45, -0.62, 0.58));
	let lit = clamp(dot(normal, light), 0.0, 1.0);
	var shadow = 1.0;
	var pos = uv;
	var top = height;
	let march = vec2f(light.x, light.y) * t * 1.8;
	for (var i = 0u; i < 6u; i++) {
		pos = pos + march;
		top = top + 0.05;
		if (field_density(pos).x > top + 0.03) { shadow = shadow * 0.74; }
	}
	let heat = field_temperature(uv).x;
	let smoke = vec3f(0.42, 0.40, 0.38);
	let magenta = vec3f(0.72, 0.16, 0.42);
	let red = vec3f(0.95, 0.14, 0.05);
	let orange = vec3f(1.0, 0.46, 0.06);
	let yellow = vec3f(1.0, 0.86, 0.28);
	let white = vec3f(1.0, 0.97, 0.92);
	var fire = mix(smoke, magenta, smoothstep(0.0, 0.2, heat));
	fire = mix(fire, red, smoothstep(0.12, 0.35, heat));
	fire = mix(fire, orange, smoothstep(0.3, 0.55, heat));
	fire = mix(fire, yellow, smoothstep(0.5, 0.78, heat));
	fire = mix(fire, white, smoothstep(0.75, 1.05, heat));
	let torch = fire * (0.18 + 0.82 * lit) * shadow;
	let fog_lit = vec3f(0.78, 0.84, 0.9) * (0.7 + 0.3 * lit);
	let body = select(torch, fog_lit, values.mode > 1.5);
	let alpha = clamp(height * select(1.2, 0.9, values.mode > 1.5), 0.0, 1.0);
	let cell = floor(uv * vec2f(8.0, 5.0));
	let checker = fract(cell.x * 0.5 + cell.y * 0.5) * 2.0;
	var ground = mix(vec3f(0.28, 0.40, 0.26), vec3f(0.52, 0.44, 0.30), clamp(checker, 0.0, 1.0));
	let path = smoothstep(0.07, 0.0, abs(uv.x - 0.5) - 0.05);
	ground = mix(ground, vec3f(0.40, 0.34, 0.26), path);
	let behind = select(vec3f(0.015, 0.012, 0.018), ground, values.mode > 1.5);
	var color = mix(behind, body, alpha);
	let pillar = ' + pillar + ';
	if (pillar) { color = vec3f(0.22, 0.24, 0.28) * (0.45 + 0.55 * lit); }
	if (values.mode < 1.5) { color = color + torch * heat * 0.7; }
	if (values.mode < 1.5) {
		let spark_uv = uv * vec2f(36.0, 64.0) + vec2f(0.0, -values.frame * 0.4);
		let id = floor(spark_uv);
		let n = fract(sin(dot(id, vec2f(127.1, 311.7))) * 43758.5);
		let local = fract(spark_uv) - vec2f(0.5);
		let spark = smoothstep(0.07, 0.0, length(local)) * step(0.93, n) * step(0.12, height);
		color = color + vec3f(1.0, 0.92, 0.65) * spark;
	}
	return vec4f(color, 1.0);
')

pointer() := {
	if windowless() and mode == 2 {
		angle = frame_i * 0.13
		return [wide * (0.66 + 0.18 * sin(angle)), high * (0.5 + 0.15 * sin(angle * 1.7))]
	}
	[system_value("mouse_x"), system_value("mouse_y")]
}
uniforms(kept, kind) := {
	made = {}
	made["size"] = [wide, high]
	made["mouse"] = pointer()
	made["mouse_down"] = system_value("mouse_down")
	made["frame"] = frame_i
	made["mode"] = mode
	made["dt"] = 1.0
	made["texel"] = [1.0 / wide, 1.0 / high]
	made["lift"] = if mode == 1 then 0.016 else 0.0015
	made["confinement"] = if mode == 1 then 0.2 else 0.05
	made["stir"] = if windowless() and mode == 2 then 1 else 0
	made["slope"] = if mode == 1 then 9.0 else 1.6
	made["keep"] = kept
	made["which"] = kind
	made
}
pass(shader, into, kept, kind) := gpu_pass(shader, fields, into, uniforms(kept, kind))
simulate(picture) := {
	pass(advect_velocity, "velocity", 0.996, 0)
	pass(advect("density"), "density", 0.992, 0)
	pass(advect("temperature"), "temperature", 0.975, 0)
	pass(buoyancy, "velocity", 1, 0)
	pass(vorticity, "velocity", 1, 0)
	pass(splat, "velocity", 1, 0)
	pass(splat, "density", 1, 1)
	pass(splat, "temperature", 1, 2)
	pass(divergence, "divergence", 1, 0)
	var n = 0
	while n < 24 {
		pass(jacobi, "pressure", 1, 0)
		n = n + 1
	}
	pass(project, "velocity", 1, 0)
	if picture then gpu_picture(shade, fields, uniforms(1, 0)) else gpu_show(shade, fields, uniforms(1, 0))
}

# f toggles, 1 or t the torch, 2 the fog, escape or q leaves
on frame {
	if not windowless() {
		name = key_name(system_value("key code pressed"))
		if name == "f" or name == "F" { mode = 3 - mode }
		else if name == "1" or name == "t" or name == "T" { mode = 1 }
		else if name == "2" { mode = 2 }
		else if name == "Escape" or name == "q" or name == "Q" { exit() }
		frame_i = frame_i + 1
		simulate(no)
	}
}
on click { mode = 3 - mode }
if windowless() {
	step = 0
	while step < 199 {
		step = step + 1
		frame_i = step
		simulate(no)
	}
	frame_i = 200
	paint(simulate(yes), wide, high, [])
}
