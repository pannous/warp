#!/usr/bin/env warp
# Raylib FFI Demo - Multiple shapes display
# This example creates a window and displays colorful shapes, drawn each frame until the window is closed: a window
# shows only while its frames are drawn (on the Mac one left waiting never appears)
import raylib

WIDTH = 800
HEIGHT = 600
InitWindow(WIDTH, HEIGHT, "Warp Raylib Demo - Multiple Shapes")
SetTargetFPS(60)

def shapes_drawn() {
	BeginDrawing()
	ClearBackground(RAYWHITE)
	DrawText("Warp Raylib FFI Demo", 250, 20, 30, DARKGRAY)
	DrawText("Press Escape to close", 260, 560, 20, DARKGRAY)
	# center circle
	DrawCircle(400, 300, 40.0, MAROON)
	# corner circles
	DrawCircle(100, 100, 30.0, DARKBLUE)
	DrawCircle(700, 100, 30.0, GOLD)
	DrawCircle(100, 500, 30.0, GREEN)
	DrawCircle(700, 500, 30.0, RED)
	# rectangles
	DrawRectangle(350, 250, 50, 50, GOLD)
	DrawRectangle(200, 200, 50, 30, GREEN)
	DrawRectangle(200, 350, 30, 50, RED)
	EndDrawing()
}

while not WindowShouldClose() { shapes_drawn() } // DONE Doesn't help on the Mac see raylib_circle.warp / raylib_circle_forever.warp (card raylib-window: drawn each frame instead of a busy wait)
CloseWindow()
1
