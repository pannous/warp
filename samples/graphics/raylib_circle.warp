#!/usr/bin/env warp
# Raylib FFI Example - Draw a circle in a window
# Demonstrates using raylib graphics library via FFI

import raylib
use units
InitWindow(800, 600, "Warp Raylib - Circle Demo")
BeginDrawing()
RAYWHITE = 0xFFF5F5F5
ClearBackground(RAYWHITE)
DARKGRAY = 0xFF505050
MAROON = 0xFF2E1990
DrawText("Warp Raylib FFI Demo", 250, 20, 30, DARKGRAY)
DrawCircle(400, 300, 80.0, MAROON)
EndDrawing()
sleep(5000ms) # todo The window closes immediately on the Mac  ./samples/graphics/raylib_circle_forever.warp Works fine. Maybe this test is only meant as a probe Not for end-users?
