#!/usr/bin/env warp
# Raylib FFI Example - Draw a circle in a window for five seconds
# A window shows what is drawn only while its frames are drawn: on the Mac a window whose program sleeps instead never
# appears, so the frame is drawn again until the time is up or the window is closed (Escape closes it too)
import raylib
seconds_shown = 5
InitWindow(800, 600, "Warp Raylib - Circle Demo")
SetTargetFPS(60)
while not WindowShouldClose() and GetTime() < seconds_shown {
	BeginDrawing()
	ClearBackground(RAYWHITE)
	DrawText("Warp Raylib FFI Demo", 250, 20, 30, DARKGRAY)
	DrawCircle(400, 300, 80.0, MAROON)
	EndDrawing()
}
CloseWindow()
