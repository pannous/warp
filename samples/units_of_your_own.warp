#!/usr/bin/env warp
// A program adds units as lib/units.warp defines them (card dimensions-units): an amount of a known unit. Each stays
// the program's constant (`8furlong` is 8 times it) and is a unit to convert to (`as furlong`)
furlong := 201.168 m
fortnight := 14 * 24 h

race = 8furlong
print race as km
print 1 km as furlong
print 1furlong / 1fortnight as furlong / fortnight
