#!/usr/bin/env warp
# a twigl.app shader runs as it is (card create-little): twigl(code) takes the shorthand of twigl's geekest mode, GLSL
# drawing the color o of the pixel FC from r (the size), t (seconds), m (the pointer) and f (the frame), and makes it a
# WGSL shader for paint. This one flies through a glowing fractal tunnel
use graphics
tunnel = twigl("float i,e,R,s,k,z;vec3 q,p,d=.5-FC.rgb/r.y;for(q--;i++<1e2;i>85.?d/=-d,o+=(cos(vec4(1,3,5,0)+k)-k)*e*.1:o){s=3.;q+=d*e*R*.2-4e-5;p=vec3(log(R=length(q))-t,acos(q.z/R)-.5,atan(q.x,q.y)+t*.5);for(e=--p.y;s<4e3;s*=3.)e+=(z=sin(dot(p/p,exp(cos(p*s)+1.))))/s,k+=z/70.;}")
# ten seconds by the clock, however long a frame takes
started = clock()
while clock() - started < 10000 {
	paint(tunnel)
	sleep(1 / 60)
}
