#!/usr/bin/env warp
# A signal computed while it plays (card real-time): warp calls siren for every sample, t its time in seconds, a
# block ahead of the speaker. Its state between samples lives in globals (floats: `as float`).
use sound
global phase = 0.0 as float
# the pitch glides between 330 and 550 Hz twice a second; the phase adds up each sample's step, so the glide stays smooth
siren(t) := {
	pitch = 440 + 110 * sin(2 * pi * 0.5 * t)
	phase = phase + 2 * pi * pitch / sample_rate
	0.3 * sin(phase)
}
play(siren, 4s)
