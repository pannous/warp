#!/usr/bin/env warp
# Packages: a folder of the registry github.com/pannous/warp-packages, cloned into packages/ beside the project
# (scripts/link-packages.sh), used by its path
use "../../packages/colors/colors.warp"
print to_hex(mix(from_hex("#ff0000"), from_hex("#0000ff"), 0.5))   # #800080
print [to_hex(color) for color in triad(from_hex("#ff8800"))]
