#!/usr/bin/env warp
# Rust crates from crates.io: `use cargo <crate>` builds the crate once as a WebAssembly component
# (~/.cache/warp/crates) and calls its public functions; a struct it constructs is a handle with its methods.
# Native only: the first run needs cargo and `rustup target add wasm32-wasip2`.

use cargo strsim
print strsim.levenshtein("kitten", "sitting")

use cargo regex
digits = regex.Regex("[0-9]+")
print digits.is_match("room 101")
print digits.replace_all("call 555 1234", "#")

use cargo semver
version = semver.Version.parse("1.4.2")
print version.minor
print semver.VersionReq.parse(">=1.2").matches(version)
