#!/usr/bin/env warp
# Rust crates from crates.io: `use cargo <crate>` links the crate built as a WebAssembly module, natively and in the page
# (scripts/warp-crate wasm lib/crates/strsim.warp wrote lib/crates/strsim.wasm); its free functions take and give
# numbers and texts. Crates of objects (regex.Regex, semver.Version) wait for a handle design

use cargo strsim
print strsim.levenshtein("kitten", "sitting")
print strsim.jaro_winkler("martha", "marhta") > 0.96
