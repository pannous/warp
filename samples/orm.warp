// Plain classes as database tables (notes/orm.md): no base class, no annotations, a table is a list of a class.
// Natively the rows live in orm.database.sqlite beside this file, so a second run finds them there.

class Team{name: text; players: [Person]}
class Person{name: text; age: int; team: Team}

// registering a list of a class from the database makes it a table, with an implicit id per row
teams: [Team] = database.teams
// the short form of people: [Person] = database.people
stored people: [Person]

if count(teams) == 0 {
	red = Team("Red", [])
	teams.add(red)                     // INSERT: red gets the id of its row
	people.add(Person("Ann", 7, red))  // a field of a table's class is a foreign key: red's id
	people.add(Person("Bo", 30, red))
	people.add(Person("Cy", 41, red))
}

// a filter is SQL where SQL says the same; the fields of each row can be named bare
grown = people where age > 18
print "grown: " + count(grown)

// any warp function works inside a filter too: SQLite calls back into the program for each row
is_prime(n) := n > 1 and count([d for d in 2..n if n % d == 0]) == 0
print "prime ages: " + count(people where is_prime(age))

// relations: a row's team is the row of teams, and a team lists the people pointing to it
red = teams#1
print "Bo plays for " + people#2.team.name
print red.name + " has " + count(red.players) + " players"

// a row read from the table is an ordinary instance that knows its row
bo = grown#1
bo.name + " has row " + bo.id
