// Plain classes as database tables (notes/orm.md): no base class, no annotations, a table is a list of a class.
// Natively the rows live in orm.database.sqlite beside this file, so a second run finds them there.

class Team{name: text; players: [Person]}
class Person{name: text; age: int; team: Team?}

// registering a list of a class from the database makes it a table, with an implicit id per row;
stored teams: [Team]
stored people: [Person]

if count(people) == 0 {
	people.add(Person("Ann", 7))  // INSERT: the instance gets the id of its row
	people.add(Person("Bo", 30))
	people.add(Person("Cy", 41))
}

// a filter is SQL where SQL says the same; the fields of each row can be named bare
grown = people where age > 18
print "grown: " + count(grown)

# infix operator divides(d:int,n:int) := { n % d == 0 }  TODO Also see card. 

// any warp function works inside a filter too: SQLite calls back into the program for each row
prime(n) := not 0 in [n%d for d in 2..n] 
primers = people where prime(it.age)
print "prime ages: " + #primers

// a row read from the table is an ordinary instance that knows its row
bo = grown#1
print(bo.name + " has row " + bo.id + " and age ${bo.age}")

// a field of a table's class is a foreign key; a list of one is the rows pointing back, read when used
if count(teams) == 0 { teams.add(Team("Climbers")) }
climbers = teams#1
climbers.players.add(bo)  // writes bo.team through
print climbers.name + ": " + count(climbers.players)
// and the other way: the rows whose key is a given row, a filter in SQL too
print "on no team: " + count(people where it.team == ø)

// sorting by a key of each row, the first rows
print "oldest first: " + str((people sorted by -it.age).map(p => p.name))
print "first two: " + str((people.take first 2).map(p => p.name))

// remove deletes the row
guest = Person("Guest", 99)
people.add(guest)
people.remove(guest)
for p in people where p.age > 90 { print "still here: " + p.name }

bo.age += 1 // ages with each call ;)
# save bo // Unnecessary!
