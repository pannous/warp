#!/usr/bin/env warp
// A WGSL fragment shader written as a block of warp: paint renders it on the GPU and shows it, each frame anew.
// The shader reads the map given last as `values`, so a frame changes without compiling the shader again
size = 128
rings = shader {
	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		let uv = at.xy / values.size;
		let wave = 0.5 + 0.5 * cos(length(uv - 0.5) * 40.0 - values.frame * 0.3);
		return vec4f(uv.x, wave, uv.y, 1.0);
	}
}
for frame in 1..30 {
	paint(rings, size, size, {frame: frame, size: [size, size]})
	sleep 40ms
}
