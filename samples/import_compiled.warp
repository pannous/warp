// A module warp compiled is imported like any WebAssembly module (notes/import_compiled.md), here one compiled by
//   warp compile --wasm tests/fixtures/compiled/shapes.warp
// Texts, lists and instances cross between the two modules as values
import "../tests/fixtures/compiled/shapes.wasm"

print(area(2, 3))                     // a function on numbers
print(shapes.greet("Ann"))            // a text in and out, qualified by the module's name
p = P(3, 4)                           // the module's class is the program's too
print(p.sum())
print(width(P(5, 6)))                 // an instance as an argument
origin().y                            // and as a result
