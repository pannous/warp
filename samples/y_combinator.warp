#!/usr/bin/env warp
// The Y combinator: recursion without a function calling itself by name.
// Paul Graham named his startup accelerator Y Combinator after it, for reasons only he would understand.
// Z is the Y combinator for languages that evaluate arguments first: the inner v => … waits until called.
def half(f) = x => f(v => x(x)(v))
def Z(f) = half(f)(half(f))

fact = Z(self => n => if n < 2 then 1 else n * self(n - 1))
print fact(10)

fib = Z(self => n => if n < 2 then n else self(n - 1) + self(n - 2))
fib(20)
