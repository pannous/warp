// decimals-exact benchmark: an exact decimal used in a hot loop, alone and beside a float source (WARP_NO_WINDOW=1)
// exact: x stays 0.5, the sum stays exact; mixed: x meets a float (random) each round, only that use converts
n = 1000000 + random_below(1)
x = 0.5
t0 = clock()
exact = 0
for i in 1 to n { exact = exact + x }
t1 = clock()
mixed = 0.0f
for i in 1 to n { mixed = mixed + x * random() }
t2 = clock()
print("exact " + (t1 - t0) + "ms (" + exact + "), mixed " + (t2 - t1) + "ms, x " + x)
