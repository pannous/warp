// runtime-speed profile target: brush strokes only, no host words (wasmtime --profile=guest can run it)
use draw
global turn = 0.0
def stroke(x1, y1, x2, y2) {
	dabs = max(cell(max(abs(x2 - x1), abs(y2 - y1)) / 3), 1)
	for i in 1 to dabs {
		circle(x1 + (x2 - x1) * i / dabs, y1 + (y2 - y1) * i / dabs, 8, hsv(turn, 0.8, 0.9))
		turn += 0.5
	}
}
canvas(1280, 800)
for k in 1 to 30 { stroke(100.0 + k, 100.0, 200.0 + k, 150.0) }
print(canvas_pixels[150 * 1280 + 150])
