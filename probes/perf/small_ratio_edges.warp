// exact_dispatch's small shortcut at its edges (decimals-exact): results must match the big path
a = 1/3 + 1/6 + random_below(1)
b = 0.5 - 0.5 + random_below(1)
c = 2147483647/3 * (3/2147483647) + random_below(1)
d = -2147483648 * 0.5 + random_below(1)
e = 1073741823/1073741824 + 1/1073741823 + random_below(1)
f = 0.1 + 0.2 == 0.3
g = 0.25 < 1/3
h = -0.5 > -1/3
print("" + a + " " + b + " " + c + " " + d + " " + e + " " + f + " " + g + " " + h)
