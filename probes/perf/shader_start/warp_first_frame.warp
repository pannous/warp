#!/usr/bin/env warp
// gpu_visualizer.warp's music visualizer with its shader written in warp: paint(tunnel, width, height) turns tunnel
// and the functions it calls into one WGSL fragment shader, which raymarches 16 glowing frequency bars around a
// pulsing gem on the GPU frame after frame. Vectors are lists of 2 to 4 numbers, .+ .- .* ./ .^ their element-wise
// math, p#1 a component; the functions read the program's levels, bass, treble, kick, tone and time
use sound
use math
program_started = clock()
width = 1920
height = 1080
bands = 16
// each band is measured against its own recent peak, which fades this much per frame: quiet bands still reach the top
peak_fade = 0.995
// below this a band is silence, not a quiet sound turned up
quietest = 0.02
// how much of last frame's level stays when the sound gets quieter
fall = 0.8
// how much of the kick stays per frame, and how much rise across all bands is a full kick
kick_fade = 0.85
full_kick = 3.0
// the shortest frame: a frame that took less waits for the rest
frame_milliseconds = 16
// how fast the eye flies down the tunnel, and the most steps of a ray
speed = 3.0
most_steps = 110

tune = [C4 E4 G4 [C4 E4 G4] A4 G4 E4 [C3 G3 C4] D4 F4 A4 [D4 F4 A4] G4 B4 D5 [G3 B3 D4 G4] C5 G4 E4 [C3 E4 G4 C5]]
song = melody_samples(tune, 0.25)
seconds = count(song) / sample_rate
// what the shader reads, set each frame
global levels = [0.0 as float for band in 0..bands]
global kick = 0.0
global tone = 0.0
global bass = 0.0
global treble = 0.0
global time = 0.0

// the level of band b (0 … 15, any whole number wraps around)
band_level(b) := levels#((b - bands * floor(b / bands)) as int + 1)
turned(p, angle) := [cos(angle) * p#1 - sin(angle) * p#2, sin(angle) * p#1 + cos(angle) * p#2]
hue(h) := 0.5 .+ 0.5 .* [cos(tau * h), cos(tau * (h + 0.33)), cos(tau * (h + 0.67))]
gem_center() := [0.6 * sin(time * 0.7), 0.4 * cos(time * 0.9), time * speed + 5 - 1.2 * kick]

// a point seen from the twisting bars: across its bar, from the axis, along its ring, its band
// beside: 0 for the point's own bar, -1 and 1 for its neighbors
bar_space(p, beside) := {
	q = turned([p#1, p#2], p#3 * 0.12 + time * 0.4)
	sector = (atan2(q#2, q#1) / tau + 0.5) * bands
	across = (fract(sector) - 0.5 - beside) * tau / bands * norm(q)
	[across, norm(q), p#3 - 1.5 * round(p#3 / 1.5), floor(sector) + beside]
}

bar_distance(p, beside) := {
	bars = bar_space(p, beside)
	box = [abs(bars#1) - 0.42, 2.9 - band_level(bars#4) * 1.9 - bars#2, abs(bars#3) - 0.55]
	norm([max(box#1, 0), max(box#2, 0), max(box#3, 0)]) + min(max(box#1, max(box#2, box#3)), 0) - 0.04
}

// the distance to the nearest surface and its band, -1 for the gem
scene(p) := {
	own = bar_space(p, 0)
	bar = min(bar_distance(p, 0), min(bar_distance(p, -1), bar_distance(p, 1)))
	local = p .- gem_center()
	flat = turned([local#1, local#3], time * 1.3)
	spin = [flat#1, flat#2, local#2]
	ripple = sin(7 * spin#1 + time * 4) * sin(7 * spin#2) * sin(7 * spin#3) * (0.06 + 0.25 * treble)
	gem = norm(local) - (0.55 + 0.5 * bass + 0.35 * kick) + ripple
	gem < bar ? [gem * 0.7, -1] : [bar * 0.8, own#4]
}

distance_at(p) := {
	hit = scene(p)
	hit#1
}

normal_at(p) := {
	nudge = 0.002
	dx = distance_at(p .+ [nudge, 0, 0]) - distance_at(p .- [nudge, 0, 0])
	dy = distance_at(p .+ [0, nudge, 0]) - distance_at(p .- [0, nudge, 0])
	dz = distance_at(p .+ [0, 0, nudge]) - distance_at(p .- [0, 0, nudge])
	normalize([dx, dy, dz])
}

gem_surface(n, ray, rim, tint) := {
	reflected = reflect(ray, n)
	mirrored = hue(atan2(reflected#2, reflected#1) / tau + 0.5 + time * 0.2)
	sparkle = max(dot(reflected, normalize([0.5, 0.8, 0.3])), 0) ^ 24
	mirrored .* mirrored .* (0.2 + rim * 1.8) .+ sparkle .+ tint .* (rim * 0.6)
}

bar_surface(p, band_hit, diffuse, rim, tint) := {
	lit = band_level(band_hit)
	bars = bar_space(p, 0)
	edge = 1 - smoothstep(0, 0.05, min(0.46 - abs(bars#1), 0.59 - abs(bars#3)))
	pulse = (0.5 + 0.5 * sin(p#3 * 0.7 - time * 9)) ^ 12 * (0.3 + 2 * bass + 4 * kick)
	shade = 0.04 + diffuse * (0.1 + 0.6 * lit) + 1.4 * lit * lit
	tint .* tint .* shade .+ tint .* (rim * (0.1 + lit)) .+ (tint .+ 0.3) .* (edge * (0.15 + 2.5 * lit)) .+ tint .* pulse
}

// the color where the ray meets a surface at p
surface(p, ray, hit, tint) := {
	n = normal_at(p)
	diffuse = max(dot(n, normalize(gem_center() .- p)), 0)
	rim = (1 - max(0 - dot(n, ray), 0)) ^ 3
	hit#2 < 0 ? gem_surface(n, ray, rim, tint) : bar_surface(p, hit#2, diffuse, rim, tint)
}

tunnel(x, y) := {
	uv = [(x - width / 2) / height, (height / 2 - y) / height] .* (1 - 0.25 * kick)
	eye = [0.4 * sin(time * 0.5), 0.3 * cos(time * 0.6), time * speed]
	ahead = normalize(gem_center() .- eye)
	side = normalize(cross([0, 1, 0], ahead))
	ray = normalize(ahead .+ uv#1 .* side .+ uv#2 .* cross(ahead, side))
	travelled = 0.0
	glow = [0, 0, 0]
	seen = [0, 0, 0]
	for marched in 1 to most_steps {
		p = eye .+ ray .* travelled
		hit = scene(p)
		tint = hit#2 < 0 ? hue(time * 0.3 + tone) : hue(hit#2 / bands + tone)
		shine = hit#2 < 0 ? 0.1 + 1.5 * bass : 0.05 + 3 * band_level(hit#2)
		glow = glow .+ tint .* tint .* (shine * 0.004 / (0.03 + abs(hit#1) * 10))
		if hit#1 < 0.001 {
			seen = surface(p, ray, hit, tint)
			break
		}
		travelled = travelled + hit#1
		if travelled > 40 { break }
	}
	lit = seen .* exp(-0.06 * travelled) .+ glow .* (0.6 + 0.6 * bass + 1.5 * kick) .+ hue(tone) .* (kick * 0.25)
	vignetted = lit .* (1 - 0.35 * dot(uv, uv))
	(vignetted ./ (1 .+ vignetted)) .^ 0.85
}

peaks = [quietest as float for band in 0..bands]
started = clock()
// card shader-start: where the first frame's time goes, the first paint (shader made) against the second
treble = 0.0
bass = 0.0
before = clock()
print(before - program_started)
paint(tunnel, width, height)
first = clock()
paint(tunnel, width, height)
second = clock()
print(first - before)
print(second - first)
