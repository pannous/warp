// card gpu-functions: a heavy map calling the program's own function, on the GPU by itself (f32) and pinned to the CPU
count = 1000000
def damped(x) {
	level = 0.0
	for i in 0..4 {
		level = level + cos(x * i)
	}
	if level > 2 {
		return level / 2
	}
	level
}
linear xs = float[count]
for i in 1 to count { xs#i = i / 1000.0 }
started = clock()
on_gpu = xs.map(x => damped(x))
gpu_milliseconds = clock() - started
started = clock()
exact = xs.map(x => damped(x)) @cpu
cpu_milliseconds = clock() - started
print "gpu ${gpu_milliseconds} ms, cpu ${cpu_milliseconds} ms, last ${on_gpu#count} vs ${exact#count}"
