#!/usr/bin/env warp
// card go-heavy-map: go of a heavy float map takes the GPU from 327680 items, else the CPU loop; 10 rounds of 300k
// items took 50 s in tasks, about 1 s now
n = 400000 + random_below(1)
xs = float[n]
for i in 1 to n { xs#i = i / n }
s = 0.0
for round in 1 to 10 {
	ys = go xs.map(x => sin(x) * 0.5)
	s += ys#n
}
s
