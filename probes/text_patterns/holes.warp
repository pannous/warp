# text_holes of lib/prelude.warp, the run-time half of text patterns (card text-patterns)
print text_holes("0xff", ["0x", ""], [""])
print text_holes("a.txt", ["", ".txt"], [""])
print text_holes("/users/7/posts/9", ["/users/", "/posts/", ""], ["int", "int"])
print text_holes("/users/me", ["/users/", ""], ["int"])
print text_holes("0y", ["0x", ""], [""])
print text_holes("x", ["xx", "x"], [""])
print fits_text_type("-4.25", "number")
print fits_text_type("4.", "number")
print fits_text_type("beef", "hex")
print fits_text_type("a", "letter")
