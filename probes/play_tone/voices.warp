#!/usr/bin/env warp
// Voices: a task (go { }) plays along with the program, so a bass line sounds under the melody.
use sound

tempo = 110
loop{
bass = go { melody [C3 G2 A2 F2] each: beat 1 }   // a voice of its own
drum = go { melody [C5 G5 A5 F5] each: beat(1/8) }   // a voice of its own
melody [E4 G4 C5 B4 A4 C5 F4 A4] each: beat(1/2)    // starts together with the bass
tempo*=1.05
}