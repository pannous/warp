#!/usr/bin/env warp
// Shaping the sound: an envelope for every note (attack, decay, sustain, release), wave shapes, gain in decibels.
use sound

def repeats(n: int, block) := {
	for i in 0...n {
		block()
	}
}

# loop 4{
repeats 4 {
attack = 0.02                   // seconds to rise
decay = 0.1                     // then falls for 0.1 s
sustain = 0.4                   // to 40 % of the peak
release = 0.2                   // and fades out over its last 0.2 s
wave_shape = "sawtooth"         // sine, square, triangle, sawtooth or noise
loudness = dB(-9)
melody [A3 C4 E4 A4 A0] each: beat(1/2)

wave_shape = "noise"            // a hi-hat: short noise
attack = 0.001
decay = 0.03
sustain = 0
melody [C4 C4 C4 C4 A0 A0] each: beat(1/4)
# wait_sound()
}