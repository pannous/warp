# a loop inside an if that its condition guards: parts#1 must not be read when parts is ø
parts_of_sum(n: any): any := if n is number then ø else [[1], n]
probe(n: any, counted: any) := {
	parts = parts_of_sum(n)
	if parts != ø {
		for name in counted.keys() { if name not in parts#1 { print name } }
		print "inside"
	}
	"after"
}
print probe(3, {p: 1})
