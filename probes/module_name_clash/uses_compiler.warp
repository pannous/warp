#!/usr/bin/env warp
# uses.warp's with_uses on compiler.warp itself, the self build's largest use (timing of claim_signatures)
use "../../lib/compiler/uses.warp"
folder = module_directory + "/../../lib/compiler"
program = parsed(file_text(folder + "/compiler.warp"))
print(#statements_in(with_uses(plain_node(program), folder)))
