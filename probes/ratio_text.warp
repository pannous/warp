// probe of lib/prelude.warp ratio_text (card exact-text-warp): run with any warp
ratio_text(numerator: int, denominator: int, period_limit: int) := {
	if denominator == 0 { return if numerator == 0 then "NaN" else if numerator > 0 then "∞" else "-∞" }
	rest = denominator; twos = 0; fives = 0
	while rest % 2 == 0 { rest = rest /! 2; twos += 1 }
	while rest % 5 == 0 { rest = rest /! 5; fives += 1 }
	period = 0
	if rest != 1 {
		power = 10 % rest
		period = 1
		while power != 1 and period <= period_limit { power = power * 10 % rest; period += 1 }
		if period > period_limit { return "\(numerator)/\(denominator)" }
	}
	digits = if twos > fives then twos else fives
	sign = if numerator < 0 then "-" else ""
	whole = abs(numerator)
	text = sign + "\(whole /! denominator)."
	remainder = whole % denominator
	for i in 1 to digits + period {
		remainder = remainder * 10
		text = text + "\(remainder /! denominator)"
		if i > digits { text = text + "̅" }
		remainder = remainder % denominator
	}
	text
}
print ratio_text(1, 3, 1000)
print ratio_text(-7, 12, 1000)
print ratio_text(22, 7, 1000)
print ratio_text(-1, 8, 0)
print ratio_text(1, 3, 0)
print ratio_text(5, 0, 0)
print ratio_text(1, 6, 1000)
print ratio_text(2^70 + 1, 4, 0)
