#!/usr/bin/env warp
# A function returning a number on one path and a list or a text on another returns a Node of run-time kind
# (card function-returning): each line printed yes
def counted(n) { if n > 0 { return n }; [1] }
def named(n) { if n > 0 { return "x" }; 2 }
def halved(n) { if n > 0 { return 2.5 }; [1] }
print(counted(1) is number)
print(counted(0) == [1])
print(named(0) + 1 == 3)
print(halved(1) + 1 == 3.5)
