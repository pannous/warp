#!/usr/bin/env warp
# card list-result-autocast: a list result that can answer ø gives [] with no warning; an int result still warns
def evens(x: int): list {
	if x < 0 { return ø }
	[x, x + 2]
}
def found(x: int): ints {
	if x > 0 { [x] }
}
def half(x: int): int {
	if x < 0 { return ø }
	x / 2
}
print evens(2)
print evens(-1)
print found(-1)
print found(3)
print half(-1)
