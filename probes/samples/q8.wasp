def cell(g, x, y) { return g#(y * 2 + x + 1) }
def is_valid(g, row, col, num) {
    for i in 0..2 {
        if g#(row*2+i+1) == num { return false }
    }
    return true
}
def solve(g) {
    for i in 0..4 {
        if g#(i + 1) == 0 {
            for num in 1..3 {
                if is_valid(g, i//2, i%2, num) {
                    candidate = g
                    candidate#(i + 1) = num
                    solved = solve(candidate)
                    if solved != [] { return solved }
                }
            }
            return []
        }
    }
    return g
}
solve([1,0,0,1])
