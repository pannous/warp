def cell(grid, x, y) { return grid#(y * 2 + x + 1) }
def is_valid(grid, row, col, num) {
    for i in 0..2 {
        if grid#(row*2+i+1) == num { return false }
    }
    return true
}
def search(grid) {
    for i in 0..4 {
        if grid#(i + 1) == 0 {
            for num in 1..3 {
                if is_valid(grid, i//2, i%2, num) {
                    candidate = grid
                    candidate#(i + 1) = num
                    solved = search(candidate)
                    if solved != [] { return solved }
                }
            }
            return []
        }
    }
    return grid
}
search([1,0,0,1])
