// Conway's Game of Life
// Cellular automaton simulation on a torus (the edges wrap)
// the grid is a flat list of cells, row by row; lists are values, so the grid is global for the functions to change it

width = 20
height = 10
generations = 8
global grid = []
for i in 0 to width * height - 1 { grid.push(false) }

def cell(x, y) { return grid#(y * width + x + 1) }

// Initialize with glider
def spawn_glider(x, y) {
    for (dx, dy) in [(1, 0), (2, 1), (0, 2), (1, 2), (2, 2)] {
        grid#((y + dy) * width + x + dx + 1) = true
    }
}

spawn_glider(2, 2)

def count_neighbors(x, y) {
    neighbors = 0
    for dy in -1 to 1 {
        for dx in -1 to 1 {
            if dx != 0 or dy != 0 {
                nx = (x + dx + width) % width
                ny = (y + dy + height) % height
                if cell(nx, ny) { neighbors = neighbors + 1 }
            }
        }
    }
    return neighbors
}

alive = ""
for y in 0..6 {
  for x in 0..7 {
    n = count_neighbors(x, y)
    if n == 3 or (cell(x, y) and n == 2) { alive = alive + str(x) + "," + str(y) + " " }
  }
}
alive
