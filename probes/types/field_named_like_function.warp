#!/usr/bin/env warp
// x.kinds reads the field of an instance held in a map, by a literal or a variable key, though kinds(x) is a function too
// (cards element-field-like-function, field-read); 0 0 7
class S { kinds: map = {} }
kinds(program: list): int := 7
scopes = {}
scopes["a"] = S()
k = "a"
xs = {}
xs[k] = [1]
print(#scopes["a"].kinds)
print(#scopes[k].kinds)
print xs[k].kinds
