# lowers a program (args#1) pass by pass with the pure lane passes in the Rust lane, printing each pass number first,
# so the pass that fails is the last number printed
use "../lib/compiler/passes.warp"
use os
use file
lib = env("WARP_LIB")
n = with_used(plain_node(parsed(read(args#1))), lib + "/compiler", read(lib + "/prelude.warp"))
for i in 1 to count(pure_passes) {
	print i
	pass = pure_passes#i
	n = pass(n)
}
print "lowered"
