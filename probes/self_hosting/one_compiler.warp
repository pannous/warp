# feasibility probe (card standalone): parser, passes, analyzer and emitter in ONE warp program, on warp values
use "../../core/passes.warp"
use "../../core/analyzer.warp"
use "../../core/emitter.warp"
use os
use file

source = "1 + 2"
program = lowered_program(source, ".")
kinds = emitter_kinds(program)
runtime = lowered_program(read("../../core/runtime.warp"), "../../lib")
module = typed_wasm_module(program, runtime, {}, kinds)
print(#module)
