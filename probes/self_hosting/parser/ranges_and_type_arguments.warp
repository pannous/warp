#!/usr/bin/env warp
// Rust-style inclusive ranges `..=`, a range without end `65..` in an arm, and type arguments `option<int>`, `list<int>`
age(n: int): text := match n {
	0 ..= 17 => "young"
	65.. => "senior"
	_ => "adult"
}
print age(10)
print age(70)
print age(30)
x: option<int> = 3
print x
xs: list<int> = [1, 2]
print xs
