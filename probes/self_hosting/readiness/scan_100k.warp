// lexer/parser: one pass over a 120 KB source: tokens into a list, each looked up in a keyword map (~0.2 s release)
// 40000, 20000
source = 20000 times "abc if "
keywords = {"if": yes, "else": yes}
tokens = []
start = -1
for i in 0..#source {
	c = source[i]
	if c == ' ' {
		if start >= 0 { tokens += [source[start..i]]; start = -1 }
	} else if start < 0 { start = i }
}
print(#tokens)
print(tokens.filter(t => t in keywords).length)
