#!/usr/bin/env warp
# values the pure lane (WARP_SELF_HOSTED=pure) got wrong: case beyond ASCII, a map made of ø, casts of texts known only
# at run time, counting properties; prints STRASSE, αβγ привет, 5 4, 12.5 8, 1, 3, as the Rust pipeline does
print upper("straße")
print lower("ΑΒΓ Привет")
d = {}
d["A"] = 5
e = {}
e.x = 4
print d["A"], e.x
items = ["12.5x", "7"]
print float(items[0].slice(0, 4)), items[1] as int + 1
print items[1].bytecount
print number of words in "a b c"
