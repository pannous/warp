# emitter core: run-time floats print their shortest digits that read back (runtime.warp float_text)
# [0.3333333333333333 333.3333333333333 -3.333333333333333e-7 3.333333333333333e19 2.5 1500 0.30000000000000004]
x = float(1) / 3
print [x, x * 1000, -x / 1000000, x * 1000000000000000 * 100000, 2.5, float(1500), float(1) / 10 + float(2) / 10]
