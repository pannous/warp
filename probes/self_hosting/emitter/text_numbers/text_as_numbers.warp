#!/usr/bin/env warp
# emitter core: texts as numbers at run time (runtime.warp text_as_int, text_as_float, text_as_number; card card-4)
# [-42 12500 0.035 1.5 1e-7 1.2345678901234568e16 7 2.5]
to_whole(t: text): int := t as int
to_real(t: text): float := t as float
to_number(t: text) := t as number
[to_whole("-42"), to_real("12.5e3"), to_real("3.5e-2"), to_real(".15e1"), to_real("1e-7"), to_real("12345678901234567"), to_number("7.0"), to_number("2.5")]
