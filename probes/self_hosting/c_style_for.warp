#!/usr/bin/env warp
// parser.warp reads C-style for heads as Rust does: for(head) and its body as a block (card parser-each-loops); 18
s = 0
for (i = 0; i < 3; i++) {s += i}
for(i = 0; i < 3; i++) s += i
for (i = 0; i < 3; i++): s += i
for (i = 0; i < 3; i++)
	s += i
	s += 1
for (i = 0; i < 3; i++) do s += i
s
