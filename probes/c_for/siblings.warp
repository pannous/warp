// expected: 10 6 9 3 4 (the pure lane refuses the continue: card lib-sugar-loops)
s = 0
for (i=0; i<5; i++) { x = i; s += x }
t = 0
for (int j = 0; j < 6; j += 2) { t += j }
n = 0
for (i=0;i<3;i++) { for (k=0;k<3;k++) { n += 1 } }
b = 0
for (i=0; i<10; i++) { if i == 3 { break }; b += 1 }
c = 0
for (i=0; i<5; i++) { if i == 2 { continue }; c += 1 }
print "$(s) $(t) $(n) $(b) $(c)"
