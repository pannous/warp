// card web-apis (WebGPU): a compute shader doubles each number on the GPU
shader = "@group(0) @binding(0) var<storage, read_write> data: array<f32>;
@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {
	if (id.x < arrayLength(&data)) { data[id.x] = data[id.x] * 2.0; }
}"
gpu_compute(shader, [1.5, 2.0, 3.0], 1)
