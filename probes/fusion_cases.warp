// map-fold fusion over other iteration words (card sum-plain-fold): each line as without fusion
twice(x) := x * 2
xs = [1, 2, 3, 4]
print xs.map(x => x * 10).filter(x => x > 15)
print xs.map(twice).map(x => x + 1)
print xs.map(x => x - 1).any(x => x == 0)
print xs.map(x => x * x).find(x => x > 5)
words = ["a", "bb", "ccc"]
print words.map(w => #w).filter(n => n != 2)
print "abc".map(c => c + c)
names = words.map(w => w + "!").filter(w => w != "bb!").map(w => w + "?")
print names
