// card real-time-playback: the user's endless voices loop (probes/sound_experiments/voices.warp) bounded: each lap's
// compute time against the seconds it sounds (4 beats)
use sound
tempo = 110
lap = 0
while lap < 40 {
	start = clock()
	bass = go { melody([C3 G2 A2 F2], beat 1) }
	drum = go { melody([C5 G5 A5 F5], beat(1/8)) }
	melody([E4 G4 C5 B4 A4 C5 F4 A4], beat(1/2))
	await bass
	await drum
	print "lap ${lap} tempo ${tempo}: ${clock() - start} ms for ${240000 / tempo} ms"
	tempo *= 1.05
	lap += 1
}
