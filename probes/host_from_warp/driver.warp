# warp-host's command handling written in warp (card host-from-warp, notes/host_from_warp_eval.md): the CLI of
# crates/warp-runtime/src/warp_host/main.rs (run, compile, help, a module by name or magic bytes, the missing-file error,
# refusals, exit statuses) on top of today's warp-host words: os.compile_wasm, os.run_wasm, os.run and file.*.
# Run by today's warp-host: `warp-host driver.wasm <warp-host's arguments…>`; probes/host_from_warp/run_checks.sh makes
# driver.wasm and a shim warp-host and runs tests/host/test_host.sh, unchanged, against it.
# What stays native (decision in notes/host_from_warp_eval.md): the engine, WASI, the os/FFI/wasm-load words, the cache.
#
# Two ways to compile and run, as WARP_DRIVER_SPAWN says:
# - unset: in-process, compile_wasm and run_wasm
# - WARP_DRIVER_SPAWN=<warp-host>: by warp-host processes of their own (os.run): `<warp-host> compile <file> <module>`,
#   `<warp-host> <module> <args…>`; their output comes after they end (out, then err), not as it is printed
#
# TODO(host): run_wasm caches a module's machine code, a program's too, where warp-host caches none of the program it
#   runs: the driver takes the program's .cwasm out of the cache again after the run (forget_program); a run_wasm
#   without the cache (an option, or a word of its own) would make that unneeded.
# TODO(host): an uncaught Error of the program is that Error from run_wasm, an Error value of its main the same: both
#   print as `Error("…")`, status 1, where warp-host prints an uncaught raise as `warp-host: …` on stderr.
# TODO(host): compile_wasm uses the compiler warp-host was started with; `--compiler full` is read and ignored here.
# TODO(host): no stderr word: the driver's own failures go to stdout, where warp-host prints them on stderr.
# TODO(host): in-process, a .warp file is compiled as code of the current folder (compile_wasm takes code, not a path).
# TODO(pure-c-imports): C imports and the shell words in programs (`strlen(s: text): i64 from 'c'`, os.exec) are
#   refused by today's compiler-self ("outside the core"); they unblock with the card pure-c-imports
#   (lib/compiler/c_imports.warp and a rebuilt compiler-self). The driver needs none of them itself.
use os
use file

usage = "usage: warp-host [--compiler self|full] [run] <file.warp | code> [args…]
       warp-host [--compiler self|full] compile <file.warp> [<file.wasm>]
       warp-host <file.wasm | file.wat> [args…]
no command means run: warp-host f.warp, warp-host '6*7'"

spawn_host = env("WARP_DRIVER_SPAWN")
spawning = spawn_host and count(spawn_host) > 0

# compiler-self (2026-10-22) makes the value of a try, or of an if, ø when one of its branches ends in exit() inline, so
# catches only mark a failure as a text, and the exits happen in functions of their own (failed, refused, given_up …)
failure_mark = "⚠ warp-host failure: "

# warp-host's failure: its message, status 1
failed(message) := { print "warp-host: " + message; exit(1) }

# no program, or a command without its file: the usage, status 2
usage_error() := { print usage; exit(2) }

# a refusal of the compiler: `Error("…")` the only output line, status 1 (as warp-host's refused)
refused(message) := { print "Error(\"" + message + "\")"; exit(1) }

# a host word's failure without the word's name ("os.run_wasm: …")
reason(e, word) := if starts_with(e, word + ": ") then slice(e, count(word) + 2) else e

is_warp_name(name) := ends_with(name, ".warp") or ends_with(name, ".wasp")

# a module: a .wasm or .wat name, else a file starting with wasm's magic bytes
is_module(name) := {
	if ends_with(name, ".wasm") or ends_with(name, ".wat") then true
	else if not exists(name) then false
	else {
		b = read_bytes(name)
		count(b) >= 4 and b#1 == 0 and b#2 == 97 and b#3 == 115 and b#4 == 109
	}
}

# where run_wasm keeps machine code (as cache.rs's folder)
cache_folder() := {
	given = env("WARP_HOST_CACHE")
	xdg = env("XDG_CACHE_HOME")
	if given and count(given) > 0 then given
	else if xdg and count(xdg) > 0 then xdg + "/warp-host"
	else env("HOME") + "/.cache/warp-host"
}
cache_before = "/tmp/warp-driver-cache-before"

# the cache's machine code before a run, to tell the program's own from it afterwards
remember_cache() := run(["sh", "-c", "ls \"$0\" > \"$1\" 2>/dev/null; true", cache_folder(), cache_before])

# the program's machine code taken out of the cache again: the oldest .cwasm the run added (run_wasm compiles the
# program before anything the program loads), as warp-host keeps none of the program it runs
forget_program() := run(["sh", "-c",
	"cd \"$0\" 2>/dev/null && ls -tr | grep '[.]cwasm$' | grep -vxF -f \"$1\" | head -n 1 | xargs -r rm -f; true",
	cache_folder(), cache_before])

# a failed in-process run: the module's exit status passed on, a trap warp-host's failure; an uncaught Error of the
# program (it has no "os.run_wasm: ") the Error printed, status 1
given_up(failure) := {
	why = reason(failure, "os.run_wasm")
	exited = "the module exited with status "
	if why == failure then refused(failure)
	else if starts_with(why, exited) then exit(int(slice(why, count(exited))))
	else failed(why)
}

# a module (its bytes, or a text holding them) run in-process with the program's arguments: its value, which
# warp-host prints and exits with
ran(module, program_args) := {
	remember_cache()
	value = try run_wasm(module, program_args) catch e { failure_mark + e }
	forget_program()
	if value is text and starts_with(value, failure_mark) then given_up(slice(value, count(failure_mark))) else value
}

# a warp-host process's output passed on, and its status
finished(result) := {
	if count(result.out) > 0 { print result.out }
	if count(result.err) > 0 { print result.err }
	exit(result.status)
}

# a module file run: in-process (as a text: no byte list), else by a warp-host process with the program's arguments
module_run(file, program_args) := if spawning then spawned(file, program_args) else ran(read(file), program_args)

# a module run by a warp-host process; one without .wasm or .wat in its name goes as a .wasm copy (warp-hosts before
# 1aec4ee9f know a module by its name only)
spawned(file, program_args) := {
	named = ends_with(file, ".wasm") or ends_with(file, ".wat")
	module = if named then file else { run(["cp", file, "/tmp/warp-driver-module.wasm"]); "/tmp/warp-driver-module.wasm" }
	finished(run([spawn_host, module] + program_args))
}

# a source compiled in-process: the module's bytes, or the refusal
compiled_here(source) := {
	code = if exists(source) then read(source) else source
	bytes = try compile_wasm(code) catch e { failure_mark + e }
	if bytes is text then refused(reason(slice(bytes, count(failure_mark)), "os.compile_wasm")) else bytes
}

# a source compiled by a warp-host process into the file `module` (code goes to a file of /tmp first); ø, or the refusal
compiled_by_process(source, module) := {
	code_file = "/tmp/warp-driver-code.warp"
	file = if exists(source) then source else { write(code_file, source); code_file }
	result = run([spawn_host, "compile", file, module])
	if result.status == 0 then ø else finished(result)
}

# a .warp name is a file, and a missing one the error, never code
checked(source) := if is_warp_name(source) and not exists(source) then failed("could not read file " + source) else source

# `run <source> <args…>`, and a source without a command
run_source(source, program_args) := {
	checked(source)
	if spawning {
		module = "/tmp/warp-driver-run.wasm"
		compiled_by_process(source, module)
		module_run(module, program_args)
	} else { ran(compiled_here(source), program_args) }
}

# `compile <source> <module>`
compile_file(source, module) := {
	checked(source)
	if spawning { compiled_by_process(source, module) } else { write_bytes(module, compiled_here(source)) }
	ø
}

# the options before the file: --help/-h is help, --compiler and --fuel take a word, other --options are ignored
words = []
skip = false
for word in args {
	before_file = count(words) == 0 or (count(words) == 1 and (words#1 == "run" or words#1 == "compile"))
	if skip { skip = false }
	else if before_file and (word == "--help" or word == "-h") { words = words + ["help"] }
	else if before_file and (word == "--compiler" or word == "--fuel") { skip = true }
	else if before_file and starts_with(word, "--") { skip = false }
	else { words = words + [word] }
}
n = count(words)
verb = if n > 0 then words#1 else ""

# the command the words name, its value the run's
dispatch() := {
	if n == 0 { usage_error() }
	else if verb == "help" { print usage; ø }
	else if verb == "run" and n >= 2 { run_source(words#2, slice(words, 2)) }
	else if verb == "compile" and n == 2 { compile_file(words#2, slice(words#2, 0, count(words#2) - 5) + ".wasm") }
	else if verb == "compile" and n == 3 { compile_file(words#2, words#3) }
	else if is_module(verb) { module_run(verb, slice(words, 1)) }
	else if verb != "run" and verb != "compile" { run_source(verb, slice(words, 1)) }
	else { usage_error() }
}

dispatch()
