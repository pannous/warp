# the core's generic words hand exact ratios to the extended runtime through runtime/bridge.warp's hooks (card
# runtime-split): show, sum, ordering, equality, conversions, reading "3/4", and a float's padding zeros
a = 1/3
b = 1/2
print a + b
print a < b
print b > a
print a == 2/6
print a as float
print (7/2) as int
print "3/4" as number
print 1.5e20
print 100000.0
print 0.00025
