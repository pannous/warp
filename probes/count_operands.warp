// card count-xs: a braceless call is an operand of a comparison or a sum, by precedence (no word lists)
xs = [1, 2, 3]
w = "abc"
i = 0
while i < count xs { i += 1 }
print i                      // 3
d = 2 - len w
print d                      // -1
ys = [x - count xs for x in xs]
print ys                     // [-2, -1, 0]
if count xs > 2 { print "more than two" }
