// expected: 6 6 6 3 (a statement rule fires as a statement: of the program, a block, a one-statement block, a function)
xs = [1, 2, 3]
a = 0
each xs { a += it }
b = 0
if yes {
	each xs { b += it }
	b += 0
}
c = 0
if yes { each xs { c += it } }
total(ys) := { n = 0; each ys { n += 1 }; n }
print "$(a) $(b) $(c) $(total(xs))"
