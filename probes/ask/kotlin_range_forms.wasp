// every for-header `a..b-1` form asks (kotlin-range); exclusive by default: each loop runs n-1 = 3 times
n = 4
a = [1, 2, 3, 4]
c = 0
for i in 0..n-1 { c += 1 }
for i in 0 .. n - 1 { c += 1 }
for i in 0..(n-1) { c += 1 }
for i in (0..n-1) { c += 1 }
for i in 0..#a-1 { c += 1 }
for i in 0..n-1 do c += 1
fun count(m) { k = 0; for j in 0..m-1 { k += 1 }; return k }
c + count(4)
