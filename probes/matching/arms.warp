// match arms: alternatives, types, ranges, catch-alls (cards match-alternatives, match-type-arms, match-ranges)
size(n) := match n { 1 | 2 => "small"; 3 or 4 => "medium"; 5, 6 => "large"; other => "huge" }
describe(v) := match v { i: int => "int " + i; t: text => "text " + t; else => "something" }
plain(v) := match v { int | text => "plain"; _ => "other" }
age(n) := match n { 0 to 12 => "child"; 13..20 => "teen"; 65.. => "senior"; _ => "adult" }
x = 3
[size(2), size(4), size(6), size(9), describe(3), describe("a"), plain("a"), age(15), age(70), x is (int or text)]
