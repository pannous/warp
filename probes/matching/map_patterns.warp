# Map patterns (card map-patterns, step 1 of tree-patterns): an arm names only the fields it needs, at any depth
response = {status: 200, body: {user: {name: "Ann", email: "ann@x.org", age: 31}}}
describe(response) := match response {
	{status: 200, body: {user: {name, email}}} => name + " <" + email + ">"
	{status: 404} => "missing"
	{error: message} => message
}
print describe(response)
print describe({status: 404})
print describe({error: "timeout"})
if response is {body: {user: {age}}} then print age
# prints Ann <ann@x.org>, missing, timeout, 31
