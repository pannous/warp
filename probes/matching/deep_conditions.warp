# Conditions at any depth (card deep-conditions, step 2 of tree-patterns): a field or an item takes what a whole arm
# takes: a comparison, a range, a type and alternatives
classify(person) := match person {
	{age: >= 18, name: text} => "adult"
	{age: 13 to 17} => "teen"
	_ => "child"
}
print classify({name: "Ann", age: 31})
print classify({name: "Bo", age: 15})
print classify({name: "Cy", age: 3})
status(response) := match response { {code: 301 | 302} => "moved"; {code: >= 500} => "server error"; _ => "ok" }
print status({code: 302})
print status({code: 503})
if {name: "Ann", age: 31} is {age: >= 18} then print "is an adult"
# prints adult, teen, child, moved, server error, is an adult
