#!/usr/bin/env warp
# card function-words-consume: an argument reaches right while it still fits the parameter
xs = [1, 2, 3, 4]
neg(b: bool) := not b
print sqrt 4 + 5      # sqrt(9): 3
print count xs > 3    # (count xs) > 3: yes, a comparison is no list
print neg 1 > 3       # neg(1 > 3): yes, a comparison fits a bool
