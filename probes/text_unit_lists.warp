// decision text-unit-plurals: a text's plural unit words are lists; count them for sizes
t = "👍🏽!"
print t.chars        // ["👍🏽" '!']
print t.codepoints   // ['👍' '🏽' '!']
print t.bytes        // [240 159 145 141 240 159 143 189 33]
print count t.codepoints   // 3
print number of bytes in t // 9
pixels = [1 2 4]
print pixels.bytecount     // 24: 8 bytes per element
