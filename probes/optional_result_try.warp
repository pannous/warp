#!/usr/bin/env warp
# Try line for decision optional-result: a function declared `: T` that can answer ø warns "declare `: T?`" and the ø
# reaches the caller unchanged
def half(x: int): int {
	if x < 0 { return ø }
	x / 2
}
def first_big(xs: list): int {
	for x in xs { if x > 5 { return x } }
}
print half(8)
print half(-1)
print first_big([1, 9])
