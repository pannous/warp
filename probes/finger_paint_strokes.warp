#!/usr/bin/env warp
// probe of samples/finger_paint.warp strokes without a mouse (WARP_NO_WINDOW=1 writes the PNG)
// finger painting: hold the mouse button over the window (in the playground, the canvas) and draw strokes whose color
// turns as you go. mouse_x, mouse_y and mouse_down are the pointer over the painted picture, in its pixels
use draw
mouse_x = 0.0
mouse_y = 0.0
mouse_down = false
// 1024 pixels across or more show pixel for pixel: crisp on a Retina screen (640×400 points there)
width = 1280
height = 800
brush = 8
// a brush dab every this many pixels along a stroke: dabs overlap into a smooth line
spacing = 3
degrees_per_dab = 0.5

canvas(width, height)
clear(white)
show()
global turn = 0.0
last_x = 0.0
last_y = 0.0
was_down = false

// dabs of the brush from x1, y1 to x2, y2
def stroke(x1, y1, x2, y2) {
	dabs = max(cell(max(abs(x2 - x1), abs(y2 - y1)) / spacing), 1)
	for i in 1 to dabs {
		circle(x1 + (x2 - x1) * i / dabs, y1 + (y2 - y1) * i / dabs, brush, hsv(turn, 0.8, 0.9))
		turn += degrees_per_dab
	}
}

// a scripted pointer instead of the mouse: two strokes, the button up between them
for t in 0..120 {
	mouse_down = t < 50 or t > 60
	mouse_x = 100.0 + t * 9
	mouse_y = 400.0 + 250 * sin(t / 12.0)
	if mouse_down {
		if not was_down { last_x = mouse_x; last_y = mouse_y }
		stroke(last_x, last_y, mouse_x, mouse_y)
		last_x = mouse_x
		last_y = mouse_y
	}
	was_down = mouse_down
}
show()
