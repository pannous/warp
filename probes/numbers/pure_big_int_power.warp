// exact int powers beyond 64 bits in every lane (card pure-big-int-power): expected
// 3011, 1995063116, 2596709376 and yes (the digit count of 2^10000, its first and last ten digits, 2^10000.0 the same),
// then 3^200, (-2)^63, (-2)^65 and 2^64 in full
digits = text(2 ^ 10000)
print #digits
print digits.slice(0, 10)
print digits.slice(3001, 3011)
print text(2 ^ 10000.0) == digits
print 3 ^ 200
print (-2) ^ 63
print (-2) ^ 65
print 2 ^ 64
