// card held-key: hold the arrow keys to move the dot, Escape ends (the playground: click the canvas first)
use draw
canvas(320, 240)
x = 160
y = 120
step(name) := if name == "ArrowLeft" then -4 else if name == "ArrowRight" then 4 else 0
// headless (no window) the loop never starts
while window_open and held_key != "Escape" {
	x += step(held_key)
	if held_key == "ArrowUp" { y -= 4 }
	if held_key == "ArrowDown" { y += 4 }
	clear(white)
	circle(x, y, 10, red)
	label(10, 20, "held: " + held_key, black)
	show()
	sleep 16ms
}
