#!/usr/bin/env warp
# a single & or | between whole numbers combines bits, between truths it is and/or (card parser-reads)
# want: 1 7 2 7 no yes two-or-three 1180591620717411303425 (the last: card pure-big-power, 2^70 under the pure lane)
print 3 & 5
print 3 | 5
a = 6
b = 3
print a & b
print a | 1
print yes & no
print (a > 1) & (b > 1)
n = 3
kind = match n {
	2 | 3 => "two-or-three"
	_ => "other"
}
print kind
print 2 ^ 70 | 1
