# a function sees its own locals and the outer names only: `x is key` tests the type beside a local key elsewhere. Expected: no yes 3 yes
f(x: any): bool := x is key
g(x: any): bool := x is text
h(): int := {
	key = 1
	text = 2
	key + text
}
print f(1)
print g("a")
print h()
local(x: any): bool := {
	key = 1
	x is key
}
print local(1)
