#!/usr/bin/env warp
// card gpu-functions step 4: the Mandelbrot set as paint(f, width, height) of a warp function; a fragment shader on
// the GPU, pixel by pixel on the CPU with WARP_GPU=off (samples/advanced/mandelbrot_canvas.warp loops over the pixels itself)
width = 1920
height = 1080
max_iter = 60
def escape_time(cx, cy) {
	x = 0.0 as float
	y = 0.0 as float
	iter = 0
	while x*x + y*y <= 4 and iter < max_iter {
		xtemp = x*x - y*y + cx
		y = 2*x*y + cy
		x = xtemp
		iter = iter + 1
	}
	return iter
}
def ink(col, row) {
	steps = escape_time(-2.2 + col * 3.2 / width, -1.1 + row * 2.2 / height)
	steps == max_iter or steps % 2 == 1
}
started = clock()
paint(ink, width, height)
print "painted in ${clock() - started} ms"
