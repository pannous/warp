#!/usr/bin/env warp
# parsed code is code and the kind it holds, under warp pure too (card pure-lane-parse)
# want: yes yes a (a) ( 3 a+1 class code
x = parse("a")
print(x is code)
print(x is symbol)
print x
n = parse("(a)")
print n
print(match n { List(items, bracket, s): bracket as text, _: 0 })
print parse("3")
print parse("a + 1")
print type(x)
