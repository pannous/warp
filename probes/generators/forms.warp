abc() := { yield 1; yield 2; yield 3 }
print abc()
evens(n) := { for i in 1 to n { if i % 2 == 0 { yield i } } }
print evens(10)
total = 0
for e in evens(10) { total += e }
print total
first_over(limit) := { k = 1; while 1 { if k * k > limit { return }; yield k * k; k += 1 } }
print first_over(50)
q = 0
for v in first_over(50) { q += v }
print q
pairs() := { yield 1, 2; yield 3, 4 }
print pairs()
n = 0
for x in abc() { for y in abc() { n += x * y } }
print n
big = 0
for x in count_up() { if x > 1000000 { break }; big = x }
count_up() := { c = 0; while 1 { c += 1; yield c } }
print big
