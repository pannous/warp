# card fast-scope: `fast` on one function; the rest of the program stays exact
fast square(n) := n * n
fast wave(x) := sin(x)
fast third(x) := x / 3
x = 1.0
print [square(10^10), 10^10 * 10^10]   # wraps at 2^63 / exact
print [wave(x), sin(x)]                # polynomial sin / C library sin
print [third(1), 1 / 3]                # float / exact ratio
y: fast int = 3
print y + 1
