// expected: [5 10 15] [11 22] [2 5] [12 34] [1 2 3] [Penny Nickel Dime] (F4: index, zip, a pattern taking items apart, enum cases)
rewrite numbered $xs... => [$x * $i for $x at $i in $xs...]
print numbered 5 5 5
rewrite paired ($as...) ($bs...) => [$a + $b for ($a, $b) in ($as..., $bs...)]
print paired (1 2) (10 20)
rewrite second_terms $as... => [$v for ($k + $v) in $as...]
print second_terms (1 + 2) 5
rewrite pairs {$as...} => [$k * 10 + $v for ($k: $v) in $as...]
print pairs {1: 2, 3: 4}
enum Coin { Penny, Nickel, Dime }
rewrite positions_of $e => [$i for $c at $i in cases of $e] where $e is enum
print positions_of Coin
rewrite listed_of $e => [$c for $c in cases of $e] where $e is enum
print listed_of Coin
