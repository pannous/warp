// a program serving its own page (warp run probes/site/served.warp, then open http://localhost:18452/): the page
// hydrates, its button counts, and it fetches the program's own route
clicks = 0
users := fetch "/api/users"
serve 18452 {
	get "/api/users" { ["Ann", "Bo"] }
}
div{
	button{ on click { clicks += 1 } "clicked " + clicks }
	p{ if users.loading then "loading" else "users: " + count(users) }
}
