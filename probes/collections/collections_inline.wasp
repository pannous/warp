class Stack { items = []
  push(x) := items.add(x)
  pop() := items.pop()
  peek() := items#count(items)
  size() := count(items)
}
class Set { items = []
  init(xs) := { items = []; for x in xs { if not (x in items) { items.add(x) } } }
  add(x) := { if not (x in items) { items.add(x) } }
  has(x) := (x in items) > 0
  remove(x) := { kept = []; for y in items { if y != x { kept.add(y) } }; items = kept }
  size() := count(items)
}
class Counter { keys = []; counts = []
  init(xs) := { keys = []; counts = []; for x in xs { add(x) } }
  add(x) := { i = x in keys; if i { counts#i += 1 } else { keys.add(x); counts.add(1) } }
  get(x) := { i = x in keys; if i { counts#i } else { 0 } }
}
s = Stack()
s.push(1); s.push(2)
t = Set([1 2 2 3])
t.add(3); t.add(4); t.remove(1)
c = Counter(["a" "b" "a"])
print s.pop(), s.size(), t.size(), t.has(4), t.has(1), c.get("a"), c.get("z")
