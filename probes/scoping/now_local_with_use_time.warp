use time
// a parameter named now beside time's now(), a local text beside Instant's text() method
mixed(was: text, now: text): text := {
	if was == now { return was }
	now + was
}
labelled(said: list): text := {
	text = "" + said#1
	if said#2 then text + "+" else text
}
print mixed("a", "b")
print mixed("a", "a")
print labelled([1, 0])
print labelled([2, 1])
