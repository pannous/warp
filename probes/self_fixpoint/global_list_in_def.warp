#!/usr/bin/env warp
# a def reads a main-level list of lists: its element is a list, not a text, in `warp self` too (analyzer.warp
# binding() finds the main scope's kinds; the self-compiled compiler refused parser.warp's ITERABLE_WORD_OPERATORS)
OPS = [["until", ".."]]
def first_op(): list {
	for op in OPS { return op }
	[]
}
def picked(): list {
	op = OPS#1
	op
}
def second_words() {
	for op in OPS { print(op#2) }
}
print(first_op())
print(picked())
second_words()
