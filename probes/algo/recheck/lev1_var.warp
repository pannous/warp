// Levenshtein edit distance via dynamic programming (two-row variant)
fun levenshtein(a, b) {
    var m = a.length
    var n = b.length
    var prev = []
    for j in 0..n {
        prev.push(j)
    }
    for i in 1..m {
        var curr = [i]
        for j in 1..n {
            var cost = a[i - 1] == b[j - 1] ? 0 : 1
            var deletion = prev[j] + 1
            var insertion = curr[j - 1] + 1
            var substitution = prev[j - 1] + cost
            curr.push(min(deletion, insertion, substitution))
        }
        prev = curr
    }
    return prev[n]
}

var total = 0
total += levenshtein("kitten", "sitting")   // 3
total += levenshtein("flaw", "lawn")        // 2
total += levenshtein("", "abc")             // 3
total += levenshtein("abc", "abc")          // 0
total += levenshtein("saturday", "sunday")  // 3
total
