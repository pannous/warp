// insertion sort and merge sort over a list of integers

fun insertion_sort(items) {
  a = items.copy()
  for i in range(1, len(a)) {
    key = a[i]
    j = i - 1
    while j >= 0 and a[j] > key {
      a[j + 1] = a[j]
      j = j - 1
    }
    a[j + 1] = key
  }
  return a
}

fun merge(left, right) {
  result = []
  i = 0
  j = 0
  while i < len(left) and j < len(right) {
    if left[i] <= right[j] {
      result.push(left[i])
      i += 1
    } else {
      result.push(right[j])
      j += 1
    }
  }
  while i < len(left) {
    result.push(left[i])
    i += 1
  }
  while j < len(right) {
    result.push(right[j])
    j += 1
  }
  return result
}

fun merge_sort(items) {
  if len(items) <= 1 { return items }
  mid = len(items) / 2 as int
  left = merge_sort(items[0:mid])
  right = merge_sort(items[mid:])
  return merge(left, right)
}

numbers = [5, 2, 9, 1, 5, 6, -3, 8, 0, 7]
a = insertion_sort(numbers)
b = merge_sort(numbers)
if a == b { a.join(",") } else { "mismatch" }
