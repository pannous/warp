fun sieve(limit) {
    is_prime = []
    (limit + 1) times { is_prime.push(true) }
    is_prime[0] = false
    is_prime[1] = false
    i = 2
    while i * i <= limit {
        if is_prime[i] {
            j = i * i
            while j <= limit {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    primes = []
    for n in 0...(limit) {
        if is_prime[n] { primes.push(n) }
    }
    primes
}
fun binary_search(list, target) {
    low = 0
    high = list.length - 1
    while low <= high {
        mid = (low + high) / 2 as int
        if list[mid] == target { return mid }
        if list[mid] < target { low = mid + 1 } else { high = mid - 1 }
    }
    -1
}

binary_search(sieve(30), 7)
