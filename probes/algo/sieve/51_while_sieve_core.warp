fun count_primes(limit) {
    is_prime = (limit + 1) times [true]
    is_prime[0] = false
    is_prime[1] = false
    i = 2
    while i * i <= limit {
        if is_prime[i] {
            j = i * i
            while j <= limit {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    c = 0
    for n in 0...(limit) {
        if is_prime[n] { c += 1 }
    }
    c
}
count_primes(30)
