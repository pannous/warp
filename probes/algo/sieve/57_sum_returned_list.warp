fun sieve(limit) {
    is_prime = []
    (limit + 1) times { is_prime.push(true) }
    is_prime[0] = false
    is_prime[1] = false
    i = 2
    while i * i <= limit {
        if is_prime[i] {
            j = i * i
            while j <= limit {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    primes = []
    for n in 0...(limit) {
        if is_prime[n] { primes.push(n) }
    }
    primes
}
primes = sieve(30)
total = 0
for p in primes { total += p }
total
