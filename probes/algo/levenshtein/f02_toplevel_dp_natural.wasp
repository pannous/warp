a = "kitten"
b = "sitting"
m = a.length
n = b.length
prev = []
for j in 0..n+1 {
    prev.push(j)
}
for i in 1..m+1 {
    curr = [i]
    for j in 1..n+1 {
        cost = a[i - 1] == b[j - 1] ? 0 : 1
        deletion = prev[j] + 1
        insertion = curr[j - 1] + 1
        substitution = prev[j - 1] + cost
        curr.push(min(deletion, insertion, substitution))
    }
    prev = curr
}
prev[n]
