size = 8

fun neighbors(grid, r, c) {
  count = 0
  for dr in [-1, 0, 1] {
    for dc in [-1, 0, 1] {
      if dr != 0 or dc != 0 {
        rr = r + dr
        cc = c + dc
        if rr >= 0 and rr < size and cc >= 0 and cc < size {
          count += grid[rr * size + cc]
        }
      }
    }
  }
  return count
}

grid = []
for i in 0 to size*size-1 { grid.push(0) }
for cell in [1, 10, 16, 17, 18] {
  grid[cell] = 1
}
neighbors(grid, 1, 1)
