size = 8

fun neighbors(grid, r, c) {
  live = 0
  for dr in [-1, 0, 1] {
    for dc in [-1, 0, 1] {
      if dr != 0 or dc != 0 {
        rr = r + dr
        cc = c + dc
        if rr >= 0 and rr < size and cc >= 0 and cc < size {
          live += grid[rr * size + cc]
        }
      }
    }
  }
  return live
}

fun step(grid) {
  next = []
  for r in 0 to size-1 {
    for c in 0 to size-1 {
      n = neighbors(grid, r, c)
      alive = grid[r * size + c] == 1
      if (alive and (n == 2 or n == 3)) or (not alive and n == 3) {
        next.push(1)
      } else {
        next.push(0)
      }
    }
  }
  return next
}

grid = []
for i in 0 to size*size-1 { grid.push(0) }
for cell in [1, 10, 16, 17, 18] {
  grid[cell] = 1
}

for gen in 1 to 4 {
  grid = step(grid)
}

checksum = 0
for r in 0 to size-1 {
  for c in 0 to size-1 {
    if grid[r * size + c] == 1 { checksum += r * 10 + c }
  }
}
checksum
