// expected: a b a b 2 one other south (match arms as other languages write them: `=>`, `_`, `else ->`, `case`, switch, a named subject)
x = 1
print(match x { 1 => "a"; _ => "b" })
print(match 2 { 1 => "a"; _ => "b" })
y = match x { 1 => "a"; else -> "b" }
print y
print(match 5 { 1: "a"; default: "b" })
f(n) := n + 1
print(match alle = f(1) { 2 => alle; _ => 0 })
print(switch 1 { case 1: "one"; default: "other" })
print(switch 9 { case 1: "one"; default: "other" })
enum Direction { north, south }
d = Direction.south
print(match d { case .north: "north"; case .south: "south" })
