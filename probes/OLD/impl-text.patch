+			match (ch, quote) {
+				('\0', _) => return Err(format!("unterminated interpolation hole: missing `{close}`")),
+				('\\', Some(_)) => self.advance(),
+				(c, Some(q)) if c == q => quote = None,
+				('"' | '\'', None) => quote = Some(ch),
+				(c, None) if c == open => depth += 1,
+				(c, None) if c == close => {
+					depth -= 1;
+					if depth == 0 {
