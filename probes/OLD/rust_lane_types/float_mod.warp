# float parameters stay floats through if-then-else and negation
float_floor(x: float): float := x
float_ceil(x: float): float := x
float_mod(a: float, b: float): float := {
	q = a / b
	rest = a - b * (if q < 0 then float_ceil(q) else float_floor(q))
	if rest < 0 { return rest + (if b < 0 then -b else b) }
	rest
}
print float_mod(7.5, 2.0)
