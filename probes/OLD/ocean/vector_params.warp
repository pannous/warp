#!/usr/bin/env warp
// card vector-params-cpu: a parameter a list reaches maps the scalar words over it at run time, numbers stay numbers
use math
f(d) := fract(d)
g(q) := f(q)
check f([0.5, 1.25]) == [0.5, 0.25]
check f(2.5) == 0.5
check g([0.5, 1.25]) == [0.5, 0.25]
square_root_of(d) := sqrt(d)
check square_root_of([1, 4]) == [1, 2]
doubled_floor(p) := floor(p .* 2)
check doubled_floor([0.5, 1.25]) == [1, 2]
wave(d) := dot(d, [sine(0.1), 0.2])
check wave([0.5, 1.5]) ≈ 0.349916708323414
// a function's list result reaches a parameter too, and a negated component of it stays a float
pair(c) := [c, c]
check fract(pair(1.5)) == [0.5, 0.5]
check clamp(pair(1.5), 0, 1) == [1, 1]
check -(normalize([0, -1, 2]).y) ≈ 0.447213595499958
// a parameter computed element-wise into a variable whose components are read is a vector: no broadcast of smooth
smooth(p) := { cell = floor(p); inside = p .- cell; blend = inside .* inside; blend.x + blend.y }
check smooth([0.5, 1.25]) == 0.3125
