vendor
target
*.wasm
# … but the test fixtures, which need clang, wasi-libc or wasm-tools to build (card wasm-fixtures-ignored)
!/test/fixtures/wasm/*.wasm
# the library index `warp rebuild` writes beside the prebuilt modules
lib/modules/index.tsv
lib/modules/sugar_rules.packed
wiki/
out

/Users/me/dev/angles/warp/vendor

.DS_Store
**/.DS_Store
# editor settings stay local (card which-following)
.fleet/
.idea/
.vscode/
# session data permissions_hook.js may write
.claude/sessions.json
.claude/session-config.json

notes/session


# a checkout's own output, never committed: logs, test results, dumps, copies, temp builds (the main checkout's is
# a symlink to /Volumes/Junk/warp/data, notes/churn_volume.md)
data/
/data
!src/lowering/data/
# the compilers `warp rebuild` builds in a lib/ (--lib's folder itself), with their machine code, inputs and kept values
/lib/warp.wasm*
/lib/warp-self.wasm*
/lib/runtime.wasm.cwasm
# the machine code a linked run keeps beside runtime.wasm and each prebuilt module (driver.warp machine_code_file)
/lib/runtime.wasm.driver.*
/lib/modules/*.cwasm*
/lib/modules/*.built-of
# … and beside every other module a run links, test/fixtures/wasm's too
*.driver.cwasm*
# warp's wasmtime C API and native libraries, copied in by scripts/wasmtime-c-api.sh (card wasmtime-bundled)
/lib/libwarp_*
/lib/libwgpu_native.*
/lib/compiler.wasm*
/lib/compiler-self.wasm*

# packages fetched by `use <name>`, see packages.warp; a worktree links the main checkout's (rebuild.sh), so no trailing slash
/packages

# test fixtures may be prebuilt modules and components (tests/fixtures/components/*/build.sh rebuilds them)
!tests/fixtures/**/*.wasm
# libc.wasm is the browser's `use c` (P147), served with the playground; build_libc.sh rebuilds it
!web/playground/lib/libc.wasm
# `stored x = v` keeps its values beside the program (src/lowering/stored_values.rs)
*.stored.json
# warp's samples, their own repository github.com/pannous/samples: a link to its checkout (scripts/lib/platform.sh
# checkouts_linked), in CI a clone (.github/actions/samples)
/samples
# wap, the new compiler, its own repository github.com/pannous/wap since 2026-11-20: links to its checkout (scripts/lib/platform.sh WAP_LINKED)
/wap
/test/wap
/notes/backbone.md
/notes/kernel.md
/notes/reader.md
/notes/agents/wap-owner.md
/notes/agents/simplifier.md
# the Spin manifest warp build --wagi writes beside app.wagi.wasm (src/cli/outputs.rs SPIN_MANIFEST_EXTENSION, card wagi-manifest)
*.spin.toml
/tune.mid

.wrangler
**/.wrangler

**/.DS_Store

# the native warp `warp build native core/native/warp.warp` writes beside its source
/core/native/warp

*.bak
**/*.bak
# what tests write beside themselves (a case runs in its file's folder): the sounds they render, the files they write
test/**/*.wav
test/**/*_written.*

kick.wav
# the packed sugar rules warp rebuild writes beside the modules (build output)
/lib/modules/sugar_rules.packed
