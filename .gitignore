.DS_Store
**/.DS_Store
# editor settings stay local (card which-following)
.fleet/
.idea/
.vscode/
# session data permissions_hook.js may write
.claude/sessions.json
.claude/session-config.json

notes/session


# a checkout's own output, never committed: logs, test results, dumps, copies, temp builds (the main checkout's is
# a symlink to /Volumes/Junk/warp/data, notes/churn_volume.md)
data/
/data
!src/lowering/data/
# the compilers `warp rebuild` builds in a lib/ (WARP_LIB's folder itself), with their machine code, inputs and kept values
/lib/warp.wasm*
/lib/warp-self.wasm*
/lib/runtime.wasm.cwasm
# warp's wasmtime C API, copied in by scripts/wasmtime-c-api.sh (card wasmtime-bundled)
/lib/libwarp_wasmtime.*
/lib/compiler.wasm*
/lib/compiler-self.wasm*

# packages fetched by `use <name>`, see packages.warp
/packages/

# test fixtures may be prebuilt modules and components (tests/fixtures/components/*/build.sh rebuilds them)
!tests/fixtures/**/*.wasm
# libc.wasm is the browser's `use c` (P147), served with the playground; build_libc.sh rebuilds it
!web/playground/lib/libc.wasm
# `stored x = v` keeps its values beside the program (src/lowering/stored_values.rs)
*.stored.json
# the executables `warp build` and running a sample leave beside their source (card cwd-artifacts)
/samples/**/*
!/samples/**/*.*
!/samples/**/
/samples/**/*.wasm
# the compiled module samples/wasm/import_compiled.warp imports by its bare name: a link to tests/fixtures/compiled/shapes.wasm
!/samples/wasm/shapes.wasm
/samples/**/*.wast
# the Spin manifest warp build --wagi writes beside app.wagi.wasm (src/cli/outputs.rs SPIN_MANIFEST_EXTENSION, card wagi-manifest)
*.spin.toml
# the database tables of samples/storage/orm.warp (a run keeps them beside it), after the exception above
samples/**/*.database.sqlite
# the values samples/storage/store.warp keeps (a run writes them beside it)
samples/**/*.stored.json
/tune.mid

.wrangler
**/.wrangler

**/.DS_Store

# the native warp `warp build native core/native/warp.warp` writes beside its source
/core/native/warp

