# from test_postfix_words.rs: edit the Rust test, then run the script again

# an_operator_word_after_its_value_applies_to_it
'-7 abs'	7
# triage-held 2026-11-06: desk-invented postfix function words (-7 abs, map xs abs) :: 'x = -7 abs; x'	7
'16 sqrt'	4.0
# triage-held 2026-11-06: desk-invented postfix function words (-7 abs, map xs abs) :: 'x = -3; x abs + 1'	4
'27 cbrt'	3.0
'abs -7'	7

# a_trailing_percent_is_a_hundredth
'10 %'	0.1
'10%'	0.1
'200 * 10%'	20
'x = 50%; x * 4'	2
'10% + 1'	1.1
'7 % 5'	2
'x = 7; x %= 5; x'	2

# an_operator_word_without_operand_is_a_function
'f = function abs; f(-2)'	2
'g = function sqrt; g(16) + 1'	5.0
'xs = [1, -2]; xs.map(abs)'	[1, 2]
