# from test_equality_never_chains.rs: edit the Rust test, then run the script again

# equality_compares_the_result_of_an_ordering
'1<2==2'	false
'1<2==1'	true
'3>2!=1'	false
'2==2<3'	false

# orderings_still_chain
'1<2<3'	true
'3>2>1'	true
'1<3<2'	false
'1<=1<2'	true

# two equality-level comparisons in a row read two ways (refused, unpinned); parenthesized they read one way (user 2026-10-03, card approx-level)
'(1 == 1) == yes'	true
'1 == (1 ≈ 2)'	false
'1 == 1 and 2 ≈ 2'	true
'(30 == 10 + 20) ≈ yes'	true
