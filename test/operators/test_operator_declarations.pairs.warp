# from test_operator_declarations.rs: edit the Rust test, then run the script again

# test_suffix_operator
'suffix operator ‼ := it*2; 3‼'	6
'suffix operator ‼ := it*2; x=4; x‼+1'	9
'suffix operator ‼ := it*2; (1+2)‼'	6

# test_prefix_operator
'prefix operator ∆ := it*it; ∆3'	9
'prefix operator ∆ := it*it; ∆3+1'	10

# test_infix_operator
'infix operator ⊕ := a+b; 2 ⊕ 3'	5
'infix operator ⊕ := a+b; 2 ⊕ 3*2'	8
'infix operator ⊕ := a+b; x=1; x ⊕ 1 ⊕ 1'	3

# test_infix_operator_declared_by_its_pattern
'x ⊗ y := x*y; 2 ⊗ 4'	8

# test_precedence_declarations_are_followed
'infix operator ⊕ := a+b; operator ⊕ has precedence above *; 2 * 3 ⊕ 4'	14

# test_built_in_operators_are_untouched
'3²'	9
'infix operator ⊕ := a+b; 3²'	9
# a declared glyph beside a longer built-in spelling: the longer one wins, so a for loop (its step glued with ··) still runs beside a declared · (maximal munch)
'infix operator ·(u, v) := u + v; s = 0; for i in 1 to 3 { s += i }; [s, 3·4]'	[6, 7]
# a module's glyph operator written tight between its operands still brings its module (lib/math.warp ∘ and ·)
'[[1, 2]∘[3, 4], 3·4]'	[11, 12]
