# from test_then_pipe.rs: edit the Rust test, then run the script again

# then is no pipe (decision then-not-pipe): refused, naming |>
'xs = [3,1,2]; xs then sort'	error	no pipe, `|>` is (decision then-not-pipe)
'xs = [1,6,9]; xs then filter(x => x > 5)'	error	no pipe, `|>` is (decision then-not-pipe)
'twice(x) := x * 2; 3 then twice then twice'	error	no pipe, `|>` is (decision then-not-pipe)

# a bare condition then a value is refused, naming its if (decision then-not-pipe)
'x = 3; x > 2 then 5'	error	no if: `if x > 2 then 5`
'x = 1; x < 2 then 1 else 2'	error	no if
'x = 3; x < 2 then 1 else 2'	error	no if
'twice(x) := x * 2; x = 3; x > 2 then twice(x) else 0'	error	no if

# nor into a word operator
'4 then sqrt'	error	no pipe, `|>` is (decision then-not-pipe)
'9 then root'	error	no pipe, `|>` is (decision then-not-pipe)
'x = -3; x then abs'	error	no pipe, `|>` is (decision then-not-pipe)
'twice(x) := x * 2; 8 then twice then sqrt'	error	no pipe, `|>` is (decision then-not-pipe)
