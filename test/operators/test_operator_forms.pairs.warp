# every operator's compound assignment `x op= y` and element-wise `.op` (decisions op-assign-general, dot-operators-now)
'x = 2; x ^= 3; x'	8
'x = 1; x max= 5; x'	5
'x = yes; x and= no; x'	no
'x = 7; x /!= 2; x'	3
'x = 1; x <<= 3; x'	8
'[1, 2] .< 2'	[yes no]
'[1, 2] .== [1, 3]'	[yes no]
'[1, 2, 3] .^ 2'	[1 4 9]
'x = [1, 2]; x .*= 2; x'	[2 4]
'n = 0; at() := { n += 1; 0 }; xs = [2]; xs[at()] ^= 3; [xs#1, n]'	[8 1]
