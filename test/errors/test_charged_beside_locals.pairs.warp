# a charged value takes no assignment, but a function's local of the same name is no assignment of it (card core-analysis)
'g(x: int): int := { var total = 0; total = total + x; total }; c = 2; total := c * 3; c = 5; total + g(1)'	16
'total := 0; total += 2; total'	error
'c = 2; total := c * 3; on tick { total = 1 }; total'	error
