# an Error given straight to a word that needs a text or a list raises itself, its own words, not the
# word's failure (card error-text-trap; the page's `exec sh "crontab -l"` in samples/system/crontab.warp)
'try { split(error("boom"), ",") } catch e { e.message }'	"boom"
'try { for x in error("boom") { x } } catch e { e.message }'	"boom"
'try { split(fetch "http://127.0.0.1:9/x", ",") } catch e { not e.message.starts_with("text of") }'	yes

# a runtime error's words, the ones every host prints before its place (core/runtime/error_sentences.warp; card
# runtime-error-builder): a caught one holds them, the raised value or missing field named

'try { n = 0; 7 % n } catch e { e.message }'	"divide by zero"
'try { [1 2]#5 } catch e { e.message }'	"index out of range"
'try { raise "boom" } catch e { e.message }'	"boom"
'm = {a: 1}; k = "b"; try { m[k] } catch e { e.message }'	"no field b"

# a program's own error class extends the prelude's Error (decision error-classes)
'class ParseError: Error; ParseError("bad").message'	'bad'
'class ParseError: Error; ParseError("bad") is Error'	yes
'class ParseError extends Error {}; try { raise ParseError("bad") } catch e { "caught" }'	'caught'
# error classes (decision error-classes, card try-raise): a raised instance says its message, except T as e catches a T or a subclass, any other error raises on
'try { raise Error("bad") } catch e { e.message }'	"bad"
'class ParseError extends Error {}; class TokenError extends ParseError {}; try { raise TokenError("bad char") } except ParseError as e { e.message }'	"bad char"
'class ParseError extends Error {}; class IoError extends Error {}; try { raise IoError("disk") } except ParseError as e { 1 }'	error	disk
'try { raise Error("bad") } except Error as e { e.message }'	"bad"
