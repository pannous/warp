# decision time-command: time of a number is that many seconds, time of a block measures it as the shell's time does
'time 3+3'	6s
'time 6 == 6s'	yes
'x = time { sleep(0.05); 7 }; x'	7
'time = 5; time + 1'	6
# a Duration shows in seconds and meets units' quantities of time both ways (decision one-duration)
'time 0.25'	0.25s
'6s == time 6'	yes
'd = time 6; d + time 2'	8s
