# lib/time's Instant moves by a typed Duration: a plain number converts to one, lib/units' quantities of time too, an
# Instant minus an Instant is milliseconds (card instant-typed-duration)
'use time; [(Instant(0) + 2).ms, (Instant(5000) - Duration(1500)).ms, Instant(9000) - Instant(2000)]'	[2, 3500, 7000]
'use time; use units; [(Instant(0) + 2 seconds).ms, (Instant(5000) - 1 s).ms, ((3 seconds) as Duration).ms]'	[2000, 4000, 3000]
'use time; use units; Instant(0) + 2 km'	error
# a parameter typed by a union converts to the member the value has a conversion to, a member's value as it is
'class D { ms: int }; n: int as D := D(n); class I { ms: int; minus(o: I or D) := if o is I then ms - o.ms else I(ms - o.ms) }; [I(9) - I(2), (I(9) - 2).ms]'	[7, 7]
# a bare number beside an Instant names no unit (decision instant-bare-number); a duration compares the time of day
'use time; try { Instant(0) > 5 } catch e { e.message }'	"5 what? write t > 5 h, or 5 AM"
'use time; [Instant(36000000) > Duration(32400000), Instant(0) > Duration(1)]'	[yes, no]
# a time moved by a quantity of time at run time, its kind a node: the core duration it lasts (card since-time)
'd = 2 seconds; str(2030-03-30T12:00 + d)'	"2030-03-30T12:00:02"
'str(2030-03-30T12:00 + 90 minutes)'	"2030-03-30T13:30"
# a place typed by a time word takes a quantity of time as the duration it lasts (card duration-hours)
'f(n: duration) := n; str(f(2 hours))'	"2 hours"
'f(n: duration) := n; str(f(90 minutes))'	"1 hour 30 minutes"
'f(n: time) := n; str(2030-03-30T12:00 + f(2h))'	"2030-03-30T14:00"
