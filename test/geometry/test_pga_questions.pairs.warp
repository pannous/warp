# The answers the PGA question samples print (card pga-visualization, samples/geometry/pga_*.warp, lib/pga_draw.warp)
# pga_ray_plane: the ray from (-2, -1, 3) through (0, 0, 1.5) hits z = 0 at (2, 1, 0), ahead of its start
'use pga_draw; start = point(-2, -1, 3); through = point(0, 0, 1.5); hit = (start ⋎ through) ⋏ plane(0, 0, 1, 0); [place(hit), dot(coordinates(hit) .- coordinates(start), coordinates(through) .- coordinates(start)) > 0]'	[[2, 1, 0], yes]
# pga_skew_lines: the x axis and a line along y 1.5 above it at x = 1 are skew, 1.5 apart, nearest at (1, 0, 0) and (1, 0, 1.5)
'use pga_draw; l = point(-2, 0, 0) ⋎ point(2, 0, 0); m = point(1, -2, 1.5) ⋎ point(1, 2, 1.5); near = closest(l, m); [coplanar(l, m), distance(near#1, m), near.map(place)]'	[no, 1.5, [[1, 0, 0], [1, 0, 1.5]]]
# lines that cross are coplanar, their closest points the one where they meet
'use pga_draw; l = point(-2, 0, 0) ⋎ point(2, 0, 0); n = point(1, -1, 0) ⋎ point(1, 1, 0); [coplanar(l, n), closest(l, n).map(place)]'	[yes, [[1, 0, 0], [1, 0, 0]]]
# parallel lines are coplanar too
'use pga_draw; coplanar(point(0, 0, 0) ⋎ point(1, 0, 0), point(0, 0, 1) ⋎ point(1, 0, 1))'	yes
# pga_sphere_cut: the sphere at (1, 0.5, 1) of radius 1.3 and the plane z = 0.5 cut the circle at (1, 0.5, 0.5) of radius 1.2
'use pga_draw; cut = sphere(point(1, 0.5, 1), 1.3) ⋏ plane(0, 0, 1, -0.5); [place(cut#1.center), round(cut#1.radius, 3)]'	[[1, 0.5, 0.5], 1.2]
# pga_point_line_distance: (1, 1.5, 2) is 2.5 from the x axis, its foot (1, 0, 0)
'use pga_draw; p = point(1, 1.5, 2); axis = point(-2, 0, 0) ⋎ point(2, 0, 0); [round(distance(p, axis), 3), place(point(foot(axis, p)))]'	[2.5, [1, 0, 0]]
# a point's distance from a plane
'use pga_draw; distance(point(0, 0, 5), plane(0, 0, 1, -1))'	4
# pga_reflect: (3, 2, 1) mirrored in x + y = 2 is (0, -1, 1)
'use pga_draw; place(plane(1, 1, 0, -2).reflect(point(3, 2, 1)))'	[0, -1, 1]
# math's distance of two lists is still there beside the point one
'use pga_draw; distance([0, 0, 0], [3, 4, 0])'	5
