# exact numbers, ints, rounding and quantities as wiki/number.md, wiki/unit.md and wiki/bool.md say (decisions bool-int-fallthrough, element-wise-scalars, type-shows-nat, int-boxed-overflow-big, exact-decimals, exact-power, number-converts, repeating-decimals, c-int-names, footgun-divzero, approx-zero, Trailing percent, P184, lossy-return, nearest-limit, easy-add, P57, units #5/P36, dimensions-units, litre-suffix, pixel-lengths, units-as-values, overloads-before-reals, duration-units, general-conversions)
'yes * 3'	3
'3 .* 3'	9
'type(3)'	nat
'x: int = 3; type(x)'	int
'xs = [2^62]; xs#1 * 4'	18446744073709551616
'0.1 + 0.2 == 0.3'	yes
'1 / 3 + 1 / 6'	1/2
'0.5 ^ 3'	0.125
'x = 1 / 3; x as number'	1/3
'0.3̅ == 1 / 3'	yes
'x: int8 = 200'	error
'x: unsigned int = -1'	error
'1 / 0'	error
'try 1 / 0 else 7'	7
'x = 1.0 as float; x / 0'	∞
'x: int = 7; x /= 2; x'	3
'10% == 1 / 10'	yes
'50 % of 200'	100
'one plus two'	3
'f(): int := 1 / 2; f()'	error
'round(2.7)'	3
'⌊2.7⌋'	2
'⌈2.1⌉'	3
'-2.7 as int'	-2
'(0.25 as float as rational) == 1/4'	yes
'8 ↑ 2'	64
'100 ↓ 10'	2
'text(2h + 30min)'	"2.5h"
'text(100 cm in m)'	"1m"
'3 cm is length'	yes
'text([3, 4] cm)'	"[3cm, 4cm]"
'text(2L)'	"2L"
'3 cm as px'	error
'text(90km/h)'	"90km/h"
'text(π/2)'	"π/2"
'text(2 h in minutes)'	"120min"
'class Person { name: text }; Person as text := it.name; p = Person("Al"); p as text'	"Al"
