# decision exact-decimal-big: a decimal past 18 places stays exact, a ratio of a big denominator, never a float
'0.0000000000000000001'	0.0000000000000000001
'x = 0.0000000000000000001; x * 3'	0.0000000000000000003
'0.0000000000000000001 + 1'	1.0000000000000000001
'1 - 0.00000000000000000025'	0.99999999999999999975
'0.0000000000000000001 * 10000000000000000000'	1
'0.0000000000000000003 / 0.0000000000000000001'	3
'0.0000000000000000001 < 0.0000000000000000002'	true
'-0.0000000000000000001'	-0.0000000000000000001
'0.00000000000000000010 == 0.0000000000000000001'	true
'0.12345678901234567890123 - 0.1'	0.02345678901234567890123
'text(1/3 + 0.0000000000000000001)'	'10000000000000000003/30000000000000000000'
'0.0000000000000000007 % 0.0000000000000000002'	0.0000000000000000001
'floor(1.0000000000000000001)'	1
'abs(-0.0000000000000000001)'	0.0000000000000000001
'type(0.0000000000000000001)'	'rational'
# a big int with a ratio stays exact too
'text(100000000000000000000 / 3)'	'100000000000000000000/3'
'x = 100000000000000000000; x + 0.5'	100000000000000000000.5
'100000000000000000000 % 30000000000'	10000000000
# inside a loop it is exact all the same, with a warning naming the cost
's = 0; for i in 1 to 3 { s += 0.0000000000000000001 }; s'	0.0000000000000000003
# card rational-overflow-big: a ratio whose parts leave 64 bits grows into a big ratio, never wraps nor traps (D16)
'y = 1; for i in 0..14 { y = y / 1.18 }; text(y)'	'610351562500000000000000/6193386212891813387462761'
'3000000000 + 1/2'	3000000000.5
# card big-literal-units: a big literal with a unit is a quantity
'use units; x = 100000000000000000000 m; x * 2'	200000000000000000000m
'use units; x = 0.0000000000000000001 m; x * 2'	0.0000000000000000002m
'use units; 100000000000000000000 m + 1 km'	100000000000000001000m
