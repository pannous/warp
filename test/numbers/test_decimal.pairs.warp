# a_decimal_amount_of_a_unit_is_exact
'0.25km == 250 m'	true

# sleep_takes_a_decimal_duration
'started = clock(); sleep 0.3s; clock() - started >= 300'	true
'started = clock(); sleep(0.05 s); clock() - started >= 50'	true
