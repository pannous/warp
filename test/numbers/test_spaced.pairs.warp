# a module's rule sees a spaced definition head as written: unit hand := 4inch is units' unit line, not a definition unit(hand)
'use units; unit hand := 4inch; x = 2 * hand; str(x.to("cm"))'	"20.32cm"
'square x := x * x; square 4'	16

# a spaced unit converts with as and in: its amount goes with it first
'str(3 km as m)'	'3000m'
'x = 3 km as m; x == 3000 m'	true
'x = 2 hours in minutes; x == 120 minutes'	true
's = "abc"; "b" in s'	true

# a number before a unit's power multiplies the power: 4 m² is four square metres
'str(4 m²)'	'4m²'
'str(2 m³)'	'2m³'
'str(2 m² + 3 m²)'	'5m²'
'str(2 km + 500 m)'	'2.5km'
