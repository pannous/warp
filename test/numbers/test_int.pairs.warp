# a global declared int is a fast int as a declared local is: arithmetic of it wraps as an i64, an index of it stays one
# (card untyped-local)
'global w: int = 10; def at(r: int, c: int) { place = r * w + c; place }; at(2, 3)'	23
'global w: int = 2^62; def f(a: int) { a * w }; f(4)'	0
'global w: int = 2^63 - 1; def g() { w + 1 }; g()'	-9223372036854775808

# `int(x)` and `x as int` of an exact real truncate its value toward 0, as of a float
'int(2 * π)'	6
'int(sqrt(8) * 9)'	25
'(-2 * π) as int'	-6
'int(√2 + 1)'	2

# a typed global keeps its declared type as a typed local does: a value of another kind is refused, at compile time when
# known, at run time naming its kind when it comes untyped (card inside-linked, interviewer OK 11-12)
'global cw: int = 1280; cw = "x"; cw'	error
'global cw: int = 1280; def size(w) { cw = w }; size("x"); cw'	error
'global cw: int = 1280; global ch: int = 800; def size(w, h) { cw = w; ch = h }; size(640, 480); cw * ch'	307200
'f(step: int) := { x = 0; x += step; x += step; x }; f(9223372036854775807)'	18446744073709551614
'f(step: int) := { x = 0; while x < 10 { x += step }; x }; f(3)'	12
'f(step: int) := { x = 0.5; x += step; x }; f(2)'	2.5
