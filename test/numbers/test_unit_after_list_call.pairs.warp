# a unit after a call or a name giving a list measures each item, as after a written list (card unit-after)
'text([3, 4] cm)'	'[3cm, 4cm]'
'sizes() := [1, 2]; text(sizes() cm)'	'[1cm, 2cm]'
'xs = [1, 2]; text(xs cm)'	'[1cm, 2cm]'
'g(n) := n > 0 ? [1, 2] : [3]; text(g(1) cm)'	'[1cm, 2cm]'
'f(x) := x; text(f([1, 2]) cm)'	'[1cm, 2cm]'
