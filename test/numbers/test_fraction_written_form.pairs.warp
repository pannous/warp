# fraction arithmetic shows as fractions until the denominator gets too big; decimals stay decimal (decision
# fraction-written-form, card hGgec8)
'"${1/3 + 1/6}"'	'1/2'
'"${2/4}"'	'1/2'
'"${1/3 + 0.5}"'	'5/6'
'"${-(1/4)}"'	'-1/4'
'"${a = 1; b = 4; a / b}"'	'1/4'
'"${1/1024}"'	'1/1024'
'"${0.1 + 0.2}"'	'0.3'
'"${3.5}"'	'3.5'
'"${1/20000}"'	'0.00005'
'1/3 * 3'	1
'1/2 == 0.5'	yes
