# card liter-hectare-2: litre, millilitre and hectare in lib/units.warp's unit table, 1 L = 0.001 m³, 1 ha = 10000 m²
# (run-time quantities: `warp test tests/numbers` )

# a_litre_counts_in_millilitres
is! 'use units
quantity(2, "L").in("ml")' 2000
is! 'use units
quantity(250, "ml").in("L")' 0.25

# a_cubic_metre_holds_a_thousand_litres
is! 'use units
quantity(1, "m³").in("L")' 1000

# a_hectare_is_ten_thousand_square_metres
is! 'use units
quantity(1, "ha").in("m²")' 10000
is! 'use units
(quantity(100, "m") * quantity(100, "m")).in("ha")' 1
