# Geometric algebra and plane/space PGA (card geometric-algebra, lib/pga.warp)
'use pga; (basis(PGA2, 1) * basis(PGA2, 2)).text()'	"e12"
'use pga; (basis(PGA2, 2) * basis(PGA2, 1)).text()'	"-e12"
'use pga; (basis(PGA2, 0) * basis(PGA2, 0)).text()'	"0"
'use pga; e = basis([1, 1, 1], 0) + basis([1, 1, 1], 1); (e * e).text()'	"2"
'use pga; (1 + basis(PGA2, 1) * 3 - basis(PGA2, 2)).text()'	"1 + 3e1 - e2"
'use pga; wedge(basis(PGA2, 1), basis(PGA2, 1)).text()'	"0"
'use pga; x = basis(PGA2, 1) + basis(PGA2, 2) * 2; mv_undual(mv_dual(x)) == x'	yes
'use pga; pga2_coordinates(wedge(pga2_line(1, 0, -1), pga2_line(0, 1, -2)))'	[1, 2]
'use pga; regressive(pga2_point(0, 0), pga2_point(1, 1)).text()'	"-e1 + e2"
'use pga; pga2_coordinates(sandwich(pga2_translator(3, 4), pga2_point(1, 1)))'	[4, 5]
'use pga; [round(c) for c in pga2_coordinates(sandwich(pga2_rotor(pi / 2, 0, 0), pga2_point(1, 0)))]'	[0, 1]
'use pga; pga3_coordinates(wedge(wedge(pga3_plane(1, 0, 0, -1), pga3_plane(0, 1, 0, -2)), pga3_plane(0, 0, 1, -3)))'	[1, 2, 3]
