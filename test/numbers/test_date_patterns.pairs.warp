# format_pattern and parse_pattern with yyyy MM dd HH mm ss tokens, UTC (card lib-date-patterns)
'use time; format(Instant(0), Pattern("yyyy-MM-dd HH:mm:ss"))'	"1970-01-01 00:00:00"
'use time; format(parse("2026-11-04 14:05", Pattern("yyyy-MM-dd HH:mm")), Pattern("yyyy-MM-dd HH:mm"))'	"2026-11-04 14:05"
'use time; p = "dd.MM.yyyy HH:mm:ss.SSS"; t = "29.02.2024 23:59:58.123"; format(parse(t, Pattern(p)), Pattern(p)) == t'	yes
'use time; format(parse("2026-03-07 09:05:01", Pattern("yyyy-MM-dd HH:mm:ss")), Pattern("d/M/yy H:mm:ss"))'	"7/3/26 9:05:01"
'use time; format(parse("3/7/2026 9:05", Pattern("d/M/yyyy H:mm")), Pattern("dd.MM.yyyy HH:mm"))'	"03.07.2026 09:05"
'use time; format(parse("2026-11-04", Pattern("yyyy-MM-dd")), Pattern("EEEE, d MMMM yyyy"))'	"Wednesday, 4 November 2026"
'use time; format(parse("4 Nov 2026", Pattern("d MMM yyyy")), Pattern("yyyy-MM-dd"))'	"2026-11-04"
'use time; format(Instant(0), Pattern("\'day\' d"))'	"day 1"
'use time; parse("1970-01-02", Pattern("yyyy-MM-dd")).ms'	86400000
'use time; try parse("2026/11/04", Pattern("yyyy-MM-dd")) else "mismatch"'	"mismatch"
'use time; try parse("2026-11-4", Pattern("yyyy-MM-dd")) else "mismatch"'	"mismatch"
'use time; try parse("2026-11-04 extra", Pattern("yyyy-MM-dd")) else "mismatch"'	"mismatch"
'use time; try parse("2026-02-30", Pattern("yyyy-MM-dd")) else "no date"'	"no date"
'use time; try parse("25:00", Pattern("HH:mm")) else "no time"'	"no time"
'use time; try parse("12:61", Pattern("HH:mm")) else "no time"'	"no time"
'use time; try parse("12:30:60", Pattern("HH:mm:ss")) else "no time"'	"no time"
'use time; try parse("12:30:00.1000", Pattern("HH:mm:ss.S")) else "no time"'	"no time"
'use time; try parse("2026-13-01", Pattern("yyyy-MM-dd")) else "no date"'	"no date"
'use time; format(parse("2026-11-04 23:59:59", Pattern("yyyy-MM-dd HH:mm:ss")), Pattern("HH:mm:ss"))'	"23:59:59"
