# Complex numbers (card lib-complex)
'use complex; (Complex(3, 4) + Complex(1, -2)).text()'	"4+2ⅈ"
'use complex; (Complex(3, 4) - Complex(1, -2)).text()'	"2+6ⅈ"
'use complex; (Complex(1, 2) * Complex(3, 4)).text()'	"-5+10ⅈ"
'use complex; complex_near(Complex(1, 2) / Complex(3, 4), Complex(0.44, 0.08), 0.000000001)'	yes
'use complex; (Complex(3, 4) + 1).text()'	"4+4ⅈ"
'use complex; (Complex(3, 4) * 2).text()'	"6+8ⅈ"
'use complex; (Complex(6, 4) / 2).text()'	"3+2ⅈ"
'use complex; Complex(1, 2) == Complex(1, 2)'	yes
'use complex; Complex(1, 2) == Complex(1, 3)'	no
'use complex; Complex(5, 0) == 5'	yes
'use complex; complex_abs(Complex(3, 4))'	5.0
'use complex; abs(complex_arg(Complex(0, 2)) - pi / 2) < 0.000000001'	yes
'use complex; conj(Complex(3, 4)).text()'	"3-4ⅈ"
'use complex; complex_near(complex_exp(Complex(0, pi)), -1, 0.000000001)'	yes
'use complex; complex_sqrt(-1).text()'	"ⅈ"
'use complex; complex_sqrt(Complex(-4, 0)).text()'	"2ⅈ"
'use complex; complex_near(complex_sqrt(Complex(3, 4)), Complex(2, 1), 0.000000001)'	yes
'use complex; complex_near(complex_log(Complex(-1, 0)), Complex(0, pi), 0.000000001)'	yes
'use complex; complex_near(complex_pow(Complex(0, 1), 2), -1, 0.000000001)'	yes
'use complex; complex_near(complex_sin(Complex(1, 1)), Complex(1.2984575814159773, 0.6349639147847361), 0.000000001)'	yes
'use complex; complex_near(complex_cos(Complex(1, 1)), Complex(0.8337300251311491, -0.9888977057628651), 0.000000001)'	yes
'use complex; z = polar(2, 1); complex_abs(z) ≈ 2 and complex_arg(z) ≈ 1'	yes
'use complex; z = Complex(-3, 4); complex_near(polar(complex_abs(z), complex_arg(z)), z, 0.000000001)'	yes
'use complex; Complex(3, 4).text()'	"3+4ⅈ"
'use complex; Complex(3, -4).text()'	"3-4ⅈ"
'use complex; Complex(0, 4).text()'	"4ⅈ"
'use complex; Complex(3, 0).text()'	"3"
'use complex; Complex(0, -1).text()'	"-ⅈ"
'use complex; Complex(0, 0).text()'	"0"
'use complex; Complex(1.5, 1).text()'	"1.5+ⅈ"
'use complex; try (Complex(1, 1) / 0).text() else "refused"'	"refused"
'use complex; try (Complex(1, 1) / Complex(0, 0)).text() else "refused"'	"refused"
'use complex; (2 + Complex(1, 1)).text()'	"3+ⅈ"
'use complex; csub(10, Complex(1, 1)).text()'	"9-ⅈ"
'use complex; cdiv(2, Complex(1, 1)).text()'	"1-ⅈ"
'use complex; cadd(1, 2).text()'	"3"
'use complex; cmul(Complex(0, 1), Complex(0, 1)).text()'	"-1"
'use complex; try cdiv(1, 0).text() else "refused"'	"refused"
# z² + c of the Julia set (card possible): ^ of a whole exponent multiplies exactly, any other goes through complex_pow
'use complex; z = Complex(1, 2); (z² + Complex(0.5, 1)).text()'	"-2.5+5ⅈ"
'use complex; (Complex(0, 1) ^ 3).text()'	"-ⅈ"
'use complex; (Complex(3, 4) ^ 0).text()'	"1"
'use complex; complex_near(Complex(0, 1) ^ 0.5, Complex(0.7071067811865476, 0.7071067811865476), 0.000000001)'	yes
# a complex shows as 3+4ⅈ; complex names its type; re and im read its parts (user card complex-format-fix)
'use complex; str((3 + 4ⅈ) * (1 + 2ⅈ))'	"-5+10ⅈ"
'use complex; x: complex = Complex(3, -4); [re(x), im(x)]'	[3, -4]
