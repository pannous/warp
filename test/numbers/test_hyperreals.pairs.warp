# from test_hyperreals.rs: edit the Rust test, then run the script again

# test_epsilon_times_omega_is_one
'use hyperreal; ε*ω'	1
'use hyperreal; ε*ω == 1'	true
'use hyperreal; 1/ε == ω'	true

# test_epsilon_is_positive_and_smaller_than_every_real
'ε>0'	true
'use hyperreal; ε<0.0001'	true
'-ε<0'	true
'use hyperreal; ω>1000000'	true
'1+ε>1'	true
'use hyperreal; ε*ε<ε'	true
'ω-1000<ω'	true
'π*ε<ε*4'	true

# test_powers_expand_exactly
'use hyperreal; (1+ε)^2 == 1+2ε+ε²'	true
