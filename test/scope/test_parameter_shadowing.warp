# from test_parameter_shadowing.rs: edit the Rust test, then run the script again

# a_parameter_may_walk_what_another_function_assigned_a_number
is! 'f(x) := { pitch = 440; 0.3 }
g(pitch) := [p for p in pitch]
g([1, 2])' [1, 2]

# a_parameter_is_not_typed_by_another_functions_real_value
is! 'f(t) := { pitch = pi * t; 0.3 }
h(pitch) := if pitch is list then 1 else 2
h(4.0)' 2

# a_parameter_is_no_map_another_function_assigned
is! 'both(first: any): any := { held = {}; for name in first.keys { held[name] = first[name] }; held }
def firsts(held: any): list { held.map(e => e#1) }
firsts([[1, 2], [3, 4]])' [1, 3]
is! 'f() := { held = {a: 1}; held.a }
g(held: any) := held.map(e => e * 2)
g([1, 2])' [2, 4]

# a_loop_variable_is_no_map_another_function_assigned
is! 'f() := { held = {a: 1}; held.a }
g() := { n = []; for held in [[1, 2], [3]] { n += held.map(e => e * 2) }; n }
g()' [2, 4, 6]
