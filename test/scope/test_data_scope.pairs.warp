# test_kebab_keys_are_read_back
# triage-held 2026-11-06: desk-invented dashed keys `a-b:2 … a-b` :: 'a-b:2; a-b+1'	3
# triage-held 2026-11-06: desk-invented dashed keys `a-b:2 … a-b` :: 'a-b:2 c-d:4 c-d'	4

# test_a_key_can_refer_to_an_earlier_key
'{c:4 b:c}.b'	4
'p={c:4 b:c}; p.b'	4

# test_a_key_shadows_the_subtraction_of_its_parts
# triage-held 2026-11-06: desk-invented dashed keys `a-b:2 … a-b` :: 'a=5; b=1; a-b:2; a-b'	2

# test_without_a_key_a_hyphenated_name_of_variables_subtracts
'a=5; b=1; a-b'	4
'a=5; b=1; c=a-b; c'	4
'a=5; b=2; c=1; a-b-c'	2
'f(a,b):=a-b; f(5,1)'	4
