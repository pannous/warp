# from test_global_constant_words.rs: edit the Rust test, then run the script again

# global_with_every_constant_word
'global final x=7; x'	7
'global constant x=7; x'	7
'global val int x=7; x'	7

# a global's value is every word after its assignment, as for a plain assignment: `global x = 7 m/s` is 7m/s, not 7
'use units; global x = 7 m/s; "" + x'	"7m/s"
'use units; global d = 3 km; f() := d * 2; "" + f()'	"6km"
'global n = 2 + 3; n'	5

# a global declared a whole float (0.0, an exact whole number) holds the float or exact value given it later
'global t = 0.0; t = 1.5; t'	1.5
'global t = 0.0; s = 3; t = float(s) / 1000; t'	0.003
'global t = 0.0; def tick() { t = 0.25 }; tick(); t'	0.25
'global n = 0; def bump() { n += 1 }; bump(); bump(); n'	2
