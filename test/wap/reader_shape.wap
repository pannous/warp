# The shorthand of notes/reader.md §5 for a Node: what test/wap/reader.wap compares

SEPARATOR_MARKS = {Space: "", None: "", Comma: ",", Semicolon: ";", Newline: "⏎", Tab: "⇥"}
BRACKET_LETTERS = {Curly: "C", Square: "Q", Round: "R", None: ""}

# a node in the shorthand
shape(n: Node) as text := {
	written = match n {
		Number(value) => if value is float and not text(value).contains(".") then text(value) + ".0" else text(value)
		Char(value) => "'" + value + "'"
		Text(value) => "\"" + value.replace("\n", "\\n") + "\""
		Symbol(name) => name
		Key(left, op, right) => "K(" + shape(left) + ", " + shape(right) + ")"
		List(items, bracket, separator) => list_shape(items, bracket, separator)
		_ => if n == ø then "Empty" else text(n)
	}
	comment = fact_of(n, "comment")
	meta = fact_of(n, "meta")
	warning = fact_of(n, "warning")
	if comment != ø { written += "/*" + text(comment) + "*/" }
	if meta != ø { written = "M(" + written + ", " + shape(meta) + ")" }
	if warning != ø { written += "!" + text(warning) }
	written
}

list_shape(items: list, bracket: Bracket, separator: Separator) as text := {
	letter = BRACKET_LETTERS[text(bracket)]
	if letter == "" and separator == Separator.Space { letter = "S" }
	if letter == "" and separator == Separator.None { letter = "G" }
	letter + SEPARATOR_MARKS[text(separator)] + "(" + items.map(shape).join(" ") + ")"
}
