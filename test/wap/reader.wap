#!/usr/bin/env warp
# wap's reader, text → notation, on the examples of notes/reader.md §5 and its decisions (§6). Each line: the text,
# then the Node it reads as in the shorthand of §5: S(…) a phrase, G(…) a glued run, C/Q/R(…) a {…} […] (…) list with
# its separator after the letter when it is no blank, K(a, b) a key, M(n, d) an annotation, n/*c*/ a comment,
# n!w a warning, Error a text the reader refuses.
# Run by test/wap/test_reader.sh
use "../../wap/core/stage.wap"
use "../../wap/core/errors.wap"
use "../../wap/core/parse/reader.wap"
use "reader_shape.wap"

CASES = [
	["1", "1"],
	["3.", "3.0"],
	["0xFF", "255"],
	["'hi'", "\"hi\""],
	["", "Empty"],
	["yes", "yes"],
	["null", "null"],
	["1 2 3", "S(1 2 3)"],
	["(1,2,3)", "R,(1 2 3)"],
	["1;2;3", ";(1 2 3)"],
	["[1 2 3]", "Q(1 2 3)"],
	["{  }", "C()"],
	["{aa:3}", "C(K(aa, 3))"],
	["a:'HIO' b:3  d:{}", "S(K(a, \"HIO\") K(b, 3) K(d, C()))"],
	["{deep{a:3,b:4,c:{d:'hi'}}}", "C(G(deep C,(K(a, 3) K(b, 4) K(c, C(K(d, \"hi\"))))))"],
	["a b:c", "S(a K(b, c))"],
	["a: b c d", "K(a, S(b c d))"],
	["a b : c", "K(S(a b), c)"],
	["a{x:1}", "G(a C(K(x, 1)))"],
	["a:{x:1}", "K(a, C(K(x, 1)))"],
	["a b (c)", "S(a b R(c))"],
	["a b(c)", "S(a G(b R(c)))"],
	["div{ class:'bold' 'text'}", "G(div C(K(class, \"bold\") \"text\"))"],
	["body(style='blue'){a(link)}", "G(body R(G(style = \"blue\")) C(G(a R(link))))"],
	["x:40;x+1", ";(K(x, 40) G(x + 1))"],
	["a b; c d", ";(S(a b) S(c d))"],
	["a b c, d e f", ",(S(a b c) S(d e f))"],
	["a,b,c;d,e,f", ";(,(a b c) ,(d e f))"],
	["{ a b , c d ; e f , g h }", "C;(,(S(a b) S(c d)) ,(S(e f) S(g h)))"],
	["{ a b , c d \n e f , g h }", "C⏎(,(S(a b) S(c d)) ,(S(e f) S(g h)))"],
	["a{\n  b,c}", "G(a C,(b c))"],
	["a\n  b\n  c\nd\ne", "⏎(G(a C⏎(b c)) d e)"],
	["a:\n  b\n  c\n\nd\ne", "⏎(K(a, C⏎(b c)) d e)"],
	["blah a b c # note\ny/* c */=0 // c", "⏎(S(blah a b c/*note*/) S(y G(=/*c*/ 0/*c*/)))"],
	["1 - -3", "S(1 - -3)"],
	["1- -3", "S(G(1 -) -3)"],
	["#[0 1 2 3]", "G(# Q(0 1 2 3))"],
	["@attrib(1) @attrib2(42) tee{a:1}", "M(G(tee C(K(a, 1))), S(G(attrib R(1)) G(attrib2 R(42))))"],
	["1 m + 1km", "S(1 m + G(1 km))"],
	["a-b:2 c-d:4 a-b", "S(K(G(a - b), 2) K(G(c - d), 4) G(a - b))"],
	["`hello $test`", "\"hello $test\""],
	["]", "Error"],
	["(unclosed", "Error"],
	// §6 decisions: signs (Q4), operator runs (Q5), `=` stays a word (Q11), duplicate keys warned (Q12)
	["a -1", "S(a -1)"],
	["a-1", "G(a - 1)"],
	["-a", "G(- a)"],
	["x=-1", "G(x = -1)"],
	["a=1", "G(a = 1)"],
	["x := 2", "S(x := 2)"],
	["a <= b != c", "S(a <= b != c)"],
	["1..3", "G(1 .. 3)"],
	["a.b", "G(a . b)"],
	["{a:1, a:2}", "C,(K(a, 1) K(a, 2))!the key a is given twice"],
	// texts: escapes read, one character is a Char, «…» as written
	["'a'", "'a'"],
	["\"\\x41\\u{1F600}\"", "\"A😀\""],
	["\"a\\qb\"", "Error"],
	["«a\\nb»", "\"a\\nb\""],
	[«"\:alpha \${x}"», «"\:alpha \${x}"»],
	// numbers
	["1_000 1e3 1.5e-3 3.25", "S(1000 1000 0.0015 3.25)"],
	// separators: tabs separate columns, trailing separators drop
	["a\tb c", "⇥(a S(b c))"],
	["[1,2,]", "Q,(1 2)"],
	// indentation: blocks nest and close, mixing tabs and spaces is refused
	["a\n  b\n    c\nd", "⏎(G(a C(G(b C(c)))) d)"],
	["a\n  b\n\tc", "Error"],
	["  a\n    b\n  c", "⏎(G(a C(b)) c)"],
	// comments: `//` after `:` is no comment, `#` glued is an operator
	["http://x", "K(http, G(// x))"],
]

failures = 0
for case in CASES {
	got = try shape(notation(case#1)) else "Error"
	if got == case#2 { print "✓ " + case#1.replace("\n", "⏎") } else { print "✗ " + case#1.replace("\n", "⏎") + ": got " + got + ", expected " + case#2; failures += 1 }
}
if failures > 0 { raise "${failures} reader cases fail" }
