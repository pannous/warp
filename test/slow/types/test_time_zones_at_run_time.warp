# from test_time_zones_at_run_time.rs: edit the Rust test, then run the script again
# test_a_zoned_time_changes_zone_keeping_its_instant
is! 'z = zoned(2024-03-30T12:00, "Europe/Berlin"); print z; str(z + 24 hours)' '2024-03-31T13:00+02:00'
is! 'z = zoned(2024-03-31T01:30, "Europe/Berlin"); print z; str(z + 1 hour)' '2024-03-31T03:30+02:00'
