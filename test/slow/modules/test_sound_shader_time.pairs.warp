# a program using sound with its own variable time, a shader's $time hole and paint in a loop: one prelude for the
# program and every module it uses (card use-sound, fixed by 95db5f7868)
'use sound; tunnel = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return vec4f($time, 0.0, 0.0, 1.0); } }; started = clock(); time = 0.0; while time < 0.05 { paint(tunnel, 8, 8); time = float(clock() - started) / 1000 }; 1'	1
