# YAML: parse_yaml, parse_yaml_all, to_yaml (lib/yaml.warp, card lib-yaml); YAML 1.2 spec examples by number
«use yaml; parse_yaml("a: 1\\nb:\\n  c: [1, 2, {x: y}]\\n  d:\\n  - p\\n  - q: 1\\n    r: 2\\ne: {\\n  f: [\\n    1,\\n    2,\\n  ],\\n}\\ng: plain # comment\\n")»	{a: 1, b: {c: [1, 2, {x: "y"}], d: ["p", {q: 1, r: 2}]}, e: {f: [1, 2]}, g: "plain"}
«use yaml; i = float("1e308") * 10.0; v = {name: "demo", "key: odd": "x", f: 2.5, t: yes, z: ø, e: "", s: "true", multi: "a\\nb\\ttab", q: "it's \\"q\\"", list: [1, "two", [3, [4]], {k: "v", k2: [5]}], empty: [], none: {}, deep: {a: {b: {c: "-dash"}}}, inf: i, ninf: 0.0 - i, dots: "...", u: "é😀"}; parse_yaml(to_yaml(v)) == v»	yes
