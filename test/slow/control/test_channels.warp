# from test_channels.rs: edit the Rust test, then run the script again
# for_over_a_channel_receives_until_it_is_closed
is! 'for k in 1 to 6 { go { sleep(300 ms) } }; ch = channel(); go { ch.send(5) }; ch.receive()' 5
is! 'jobs = []; for k in 1 to 6 { jobs.add(go { sleep(100 ms); k }) }; ch = channel(); go { for k in 1 to 3 { ch.send(k) }; ch.close() }; received = 0; for v in ch { received += v }; [sum(await all jobs), received]' [21, 6]
