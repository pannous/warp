is! 'event stop the machine; why=""; on stop the machine {why=event.reason}; emit stop the machine{reason:"human"}; why' 'human'
is! 'event too big; seen=0; def check(x){ if x>2 {emit too big{value:x}}; x }; on too big {seen=event.value}; check(4); seen' 4
