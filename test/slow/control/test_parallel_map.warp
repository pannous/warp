# from test_parallel_map.rs: edit the Rust test, then run the script again
# a_parallel_map_runs_its_items_at_once
is! 'slow(x) := { sleep(500ms); x }; started = clock(); ys = @parallel [1,2,3].map(slow); clock() - started < 1200' true
is! 'slow(x) := { sleep(500 ms); x }; started = clock(); ys = go [1,2,3,4].map(slow); clock() - started < 1200' true
is! 'slow(x) := { sleep(500 ms); x }; xs = [1, 2, 3]; started = clock(); ys = @parallel slow all xs; clock() - started < 1200' true
