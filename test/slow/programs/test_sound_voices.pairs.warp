# every voice on one clock (user's cards bass-sync-issue, pause-playback-timing; lib/sound.warp voice_joined): what
# follows `await` of a task starts after the task's sounds, so a 4-beat bass and a 3.5-beat melody start each cycle together
'use sound; tempo = 100; for cycle in 0..3 { bass = go { play([C3 G3 A2 E3], beat 1) }; play([E4 D4 C4 D4 E4 E4 E4], beat(1/2)); await bass }; round(sound.seconds * 10)'	72
# a rest alone holds the voice that long, as a rest in a melody does
'use sound; play(rest, 1s); play C4; sound.seconds'	1.5
