# A named pattern with names is a type with fields: built by its names, tested with `is`, matched by name or by place,
# its names read off a parameter of that type (wiki pattern-matching.md "Named patterns as types", user 2026-11-17)

# a list
is! 'pattern Pair = [a: int, b: int]; Pair(1, 2)' [1, 2]
is! 'pattern Pair = [a: int, b: int]; [1, 2] is Pair' true
is! 'pattern Pair = [a: int, b: int]; [1, "x"] is Pair' false
is! 'pattern Pair = [a: int, b: int]; match [3, 4] { Pair(x, y) => x * y; _ => 0 }' 12
is! 'pattern Pair = [a: int, b: int]; sum(p: Pair) := p.a + p.b; sum([3, 4])' 7

# code, quoted, its holes the parts of the code
is! 'pattern If = data((choose $cond $then_part $else_part)); text(If(parse("c"), parse("1"), parse("2")))' '(choose c 1 2)'
is! 'pattern If = data((choose $cond $then_part $else_part)); parse("(choose c 1 2)") is If' true
is! 'pattern If = data((choose $cond $then_part $else_part)); parse("(pick c 1 2)") is If' false
is! 'pattern If = data((choose $cond $then_part $else_part)); match parse("(choose c 1 2)") { If(c, _, other) => other; _ => 0 }' 2
is! 'pattern If = data((choose $cond $then_part $else_part)); then_of(n: If) := n.then_part; then_of(parse("(choose c 1 2)"))' 1

# a node case
is! 'pattern Def = Key(head, Op.Define, body); parse("g := 1") is Def' true
is! 'pattern Def = Key(head, Op.Define, body); match parse("g := 1") { Def(h, b) => b; _ => 0 }' 1
is! 'pattern Def = Key(head, Op.Define, body); body_of(d: Def) := d.body; body_of(parse("g := 2"))' 2
is! 'pattern Def = Key(head, Op.Define, body); Def(parse("g"), parse("3")) is Def' true

# a pattern without types
is! 'pattern Point = [x, y]; Point(3, 4)' [3, 4]
is! 'pattern Point = [x, y]; match [3, 4] { Point(a, _) => a }' 3
