# card pure-class-methods: a class's methods are functions of the instance they are called on, its fields read and
# written bare (or as self.x, this.x), a sibling method called bare; a method several classes declare calls the
# instance's own class's, a subclass's override before its parent's
# (run-time instances: `warp test tests/types` , `warp test --self tests/types` through
# warp self)

# a_method_reads_the_fields_of_its_instance
is! "class Animal { name: text; speak() := name + \" makes a sound\" }
a = Animal{name: \"Cat\"}
a.speak()" "Cat makes a sound"
is! "class P { x: int; next() := self.x + 1 }
P{x: 4}.next()" 5
is! "class P { x: int; next() := this.x + 1 }
P{x: 4}.next()" 5

# a_method_takes_arguments
is! "class person { name; age: int; older(years) := age + years }
person(\"Ann\", 40).older(2)" 42

# a_method_calls_a_sibling_method
is! "class C { x: int; doubled() := x * 2; quad() := doubled() * 2 }
C(3).quad()" 12

# a_property_is_read_with_or_without_parentheses
is! "class square { side: int; area := side * side; perimeter() := 4 * side }
square(2).perimeter() + square(2).area" 12

# a_method_changes_its_instance
is! "class Counter { count: int = 0; bump() := { count += 1 }; twice() := { bump(); bump() } }
c = Counter()
c.twice()
c.bump()
c.count" 3
is! "class K { counts = [0, 0]; bump(i) := { counts#i += 1 } }
k = K()
k.bump(1)
k.bump(1)
k.bump(2)
k.counts#1 * 10 + k.counts#2" 21

# classes_with_a_method_of_the_same_name_each_call_their_own
is! "class square { side: int; area := side * side }
class circle { r: int; area := 3 * r * r }
square(2).area + circle(1).area" 7

# a_subclass_inherits_its_parents_methods
is! "class Animal { name: text; speak() := name + \" makes a sound\" }
class Dog extends Animal { breed: text }
Dog{name: \"Rex\", breed: \"pug\"}.speak()" "Rex makes a sound"

# a_subclass_overrides_its_parents_method
is! "class Animal { name: text; speak() := name + \" makes a sound\" }
class Dog extends Animal { speak() := name + \" barks\" }
class Cat extends Animal { lives: int = 9 }
Dog{name: \"Rex\"}.speak() + \", \" + Cat{name: \"Tom\"}.speak() + \", \" + Animal{name: \"Gnu\"}.speak()" "Rex barks, Tom makes a sound, Gnu makes a sound"

# a_keyword_method
is! "class Square { side: int; def area() -> int { side * side } }
Square(3).area()" 9
