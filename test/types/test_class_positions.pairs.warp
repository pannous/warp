# a class's own positions (card class-position-index): b#p its position(p) from 1, b[i] its index(i) from 0, either one
# deriving the other; b#p = v the setter position(p, v); #b its count()
'class B { n: int; position(p) := p * 10 }; b = B(3); [b#2, b[2], b.index(0)]'	[20, 30, 10]
'class R { index(i) := i * 2 }; r = R(); [r#1, r[3]]'	[0, 6]
'class B { n: int; count() := n }; #B(3)'	3
'class B { cells: list; position(p) := cells#p; position(p, value) := { cells#p = value } }; b = B([1, 2]); b#2 = 7; b#2'	7
'class B { n: int; position(p) := p }; xs = [4, 5]; xs#1 = 7; [#xs, xs#1, B(1)#9]'	[2, 7, 9]
'class P { x: int; y: int }; P(2, 3)#1'	2
'use sound; F#4'	369.99
'class B { n: int; position(p) := p }; xs = [4, 5]; xs#1 += 2; xs'	[6, 5]
