# typed JSON: a defaulted field missing takes its class default, present it is checked (card typed-parse-optional)
'class Server { host: text; port: int = 80 }; parse("{host:\\"a\\"}", Server).port'	80
'class Server { host: text; port: int = 80 }; parse("{host:\\"a\\",port:8080}", Server).port'	8080
'class Server { host: text; port: int = 80 }; try { parse("{host:\\"a\\",port:\\"x\\"}", Server) } catch e { e.message }'	'port must be int, received text'
'class Server { host: text; port: int = 80 }; try { parse("{port:1}", Server) } catch e { e.message }'	'host is required'
'class U { a: int; b: text? }; parse("{a: 1}", U).b'	ø
'class U { a: int; b: text? }; parse("{a: 1, b: \\"x\\"}", U).b'	'x'
'class U { a: int; b: text? }; parse("{a: 1, b: null}", U).b'	ø
