# enum cases with spellings, raw values as in Swift and TypeScript (decision enum-raw-values, card enum-spelled-cases)

# a spelled case converts to its spelling and back
is! 'enum Word { LoopStep = "loop·step", TryElse = "try·else" }; Word.LoopStep as text' 'loop·step'
is! 'enum Word { LoopStep = "loop·step", TryElse = "try·else" }; "try·else" as Word == Word.TryElse' true

# a case equals its spelling
is! 'enum Word { LoopStep = "loop·step", TryElse = "try·else" }; Word.LoopStep == "loop·step"' true
is! 'enum Word { LoopStep = "loop·step", TryElse = "try·else" }; w = "try·else"; w == Word.LoopStep' false

# a case without a spelling is spelled by its name
is! 'enum Word { LoopStep = "loop·step", Other }; Word.Other as text' 'Other'

# a variable holding a case
is! 'enum Word { A = "a", B = "b" }; w = Word.B; w as text' 'b'

# a spelled enum of a used file
is! 'use "test/fixtures/spelled_enum.warp"; Level.Warning as text' 'warning'

# a parameter typed by a spelled enum keeps its spelling (card enum-parameter-conversion)
is! 'enum Word { A = "a", B = "b" }; f(w: Word): text := w as text; f(Word.B)' 'b'
is! 'f(b: Bracket): text := b as text; f(Bracket.Square)' '['
is! 'f(o: Op): bool := o == "+"; f(Op.Add)' true
is! 'f(o: Op?): text := o as text; f(Op.Sub)' '-'
