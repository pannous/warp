# time literals are values (card triage-time-values): dates, local times, instants and durations print, join texts and compare
'2024-02-29'	2024-02-29
'1 month 2 days'	1 month 2 days
'2024-01-31T10:30+01:00'	2024-01-31T09:30Z
'"in " + 1 day'	'in 1 day'
'a = 2024-01-01; b = 2024-03-01; a < b'	yes
'x = 3 months; x == 3 months'	yes
'1 month < 28 days'	no
'1 month <= 31 days'	yes
'2 days <= 1 day'	no

# a time's fields at run time
'd = 2024-02-29; d.year * 10000 + d.month * 100 + d.day'	20240229
'd = 2024-02-29; d.weekday'	4
't = 2024-01-31T10:30:15; t.hour + t.minute + t.second'	55
't = 2024-01-31T10:30Z; t.epoch_seconds'	1706697000

# a time's arithmetic at run time (lib/time.warp, card day-hour)
'2024-01-15 + 1 month == 2024-02-15'	yes
'a = 2024-03-01; b = 2024-02-01; a - b'	29
'3 * 1 day'	3 days

# a date outside the calendar is refused, never rolled over (wiki/Footguns.md "Dates")
'2024-02-30'	error	2024-02 has the days 01 to 29
'2023-02-29'	error	2023-02 has the days 01 to 28
'2024-13-01'	error	the months are 01 to 12
'2024-04-31T10:00Z'	error	2024-04 has the days 01 to 30
