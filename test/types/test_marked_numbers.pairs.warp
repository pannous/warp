# a number of a marked type keeps its mark through arithmetic (decision marks-survive-arithmetic), held unboxed as
# long as its static type knows it (decision marks-unboxed-first), and shows by its type's show
'use units; "" + 30° * 2'	"60°"
'use units; a = 30°; b = a * 2; "" + b'	"60°"
'use units; f(a: Angle) := a * 2; "" + f(30°)'	"60°"
'use units; "" + -(30°)'	"-30°"
'use units; round(sin(30°) * 1e9) / 1e9'	0.5
'type Angle = float; show(a: Angle) := "angle"; "" + (0.5 as Angle) * 2'	"angle"
'type Color = int; red = 0xFFFF0000 as Color; show(c: Color) := "C"; g(c: Color): Color := c; "" + g(red)'	"C"
'use color; "" + (red + 1)'	"#FF0001"
'yes + 1'	2
