# an int type `type T = int` marks its values, shown by its `format T t as text`, the plain int to arithmetic (card color-prints)
'"" + red'	"red"
'"" + rgb(1, 2, 3)'	"#010203"
'"" + with_alpha(red, 0.5)'	"#FF000080"
'red + 0'	4294901760
'red == 0xFFFF0000'	true
'red is Color'	true
'5 is Color'	false
'type Flag = int; format Flag f as text := "flag " + (f as int); "" + (3 as Flag)'	"flag 3"
'red.hex == 0xFFFF0000'	true
'red.hex_text'	"#FF0000"
'with_alpha(red, 0.5).hex_text'	"#FF000080"
# a type's `format … as text` leaves lib/text's format(template, values) callable (card program-format)
'type Flag = int; format Flag f as text := "F"; format("{} has {} items", ["cart", 3])'	"cart has 3 items"
