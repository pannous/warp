# from test_date_arithmetic_at_run_time.rs: edit the Rust test, then run the script again

# test_time_minus_time
'a = 2024-03-01; b = 2024-02-01; print a; a - b'	29

# test_constant_times_fold_and_the_run_does_the_rest
'2024-02-29.month + 1'	3
'date(2024, 2, 29).day * 2'	58
'2024-02-29 < 2024-03-01 and 2024-01-01 < 2024-02-01'	1
'1 day != 2 days'	1

# test_a_time_plus_a_text_is_text
'd = 2024-02-29; print d; d + " is day"'	'2024-02-29 is day'
'd = 1 day; print d; d + " long"'	'1 day long'
'd = 2024-02-29; print d; "day " + d'	'day 2024-02-29'
