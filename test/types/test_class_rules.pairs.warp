# Classes and enums: field defaults, receiver fields, per-instance defaults, init, shown form, inheritance, getters,
# enum cases and raw values (wiki class, enum; decisions valued-field-default, P115, P116, P117, P122, P162, P123,
# enum-case, enum-raw-values)
'class Animal { name: "?" }; Animal().name'	"?"
'class Counter { c: 0; inc() := { c = c + 1 } }; k = Counter(); k.inc(); k.c'	1
'class C { pi = 3 }; C().pi'	3
'class P { x: int; init(a) := { x = a } }; P(4).x'	4
'class Point { x: int; y: int }; str(Point{x:1 y:2})'	"Point{x: 1, y: 2}"
'enum Coin { Penny, Nickel, Dime }; Coin.Dime as int'	2
'enum Coin { Penny, Nickel, Dime }; 2 as Coin'	Dime
'enum W { A = "a·b", B }; W.A as text'	"a·b"
'enum W { A = "a·b", B }; W.B as text'	"B"
'class A { x: 1 }; class B extends A { }; B().x'	1
'class Box { v: 1; double := v * 2 }; Box().double'	2
