# Card typed-parse: absent optional and defaulted fields are allowed without coercion.
'class User { id: number; name: string = "Ada" }; parse("{\\"id\\":7}", User).name'	'Ada'
'class User { id: number; name: string? }; parse("{\\"id\\":7}", User).id'	7
'class User { id: number; name: string? }; parse("{\\"id\\":7,\\"name\\":null}", User).id'	7
'class User { id: number; name: string? }; try { parse("{\\"id\\":7,\\"name\\":8}", User) } catch e { e.message }'	'name must be text, received number'
