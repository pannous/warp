# a subtype of int computes as the int it is: arithmetic on it is int arithmetic, an int place takes it (card samples-advanced)
'use color; red % 256'	0
'use color; f(c) := to_base(c % 256, 16); f(blue)'	"ff"
'use color; f(c) := c /! 65536 % 256; f(red)'	255
'use color; type P: { color: int }; P { color: blue }.color'	4278190335

# a subtype with no format of its own shows as its value: is-a, not has-a (decision subtype-less-than)
'type Age < int; x: Age = 3; "" + x'	"3"
'type Age < int; class P { age: Age }; "" + P(3).age'	"3"
# an int fills a declared result of a subtype as it fills its variable (decision subtype-less-than)
'type Age < int; f(n: Age): Age := n + 1; f(3)'	4
'type Age < int; f(): Age := 3; f() is Age'	yes
'type Age < int; f(n: int): Age := { m = n * 2; m + 1 }; f(3)'	7
# a subtype of a type phrase, type Code < list of int, tests its items as the phrase does (wiki/alias.md, card subtype-of-phrase)
'type Code < list of int; [1, 2] is Code'	yes
'type Code < list of int; ["a"] is Code'	no
'type Grid < list of list of int; [[1], [2, 3]] is Grid'	yes
