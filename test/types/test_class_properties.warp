# from test_class_properties.rs: edit the Rust test, then run the script again

# a_getter_reads_like_a_field
# triage-held 2026-11-06: JS/C# get/set accessors, foreign syntax :: is! 'class P{birthday:int; get age() { 2026 - birthday }; set age(v) { birthday = 2026 - v }}; P(2000).age' 26
# triage-held 2026-11-06 (night decision, review at 10:00): accessor forms ruled out by property-accessors (use `age := …; age(v) := …`) :: is! 'class P{birthday:int; age:{2026 - birthday} set{birthday = 2026 - it}}; P(2000).age' 26

# a_setter_runs_when_the_property_is_assigned
# triage-held 2026-11-06: JS/C# get/set accessors, foreign syntax :: is! 'class P{birthday:int; get age() { 2026 - birthday }; set age(v) { birthday = 2026 - v }}; p = P(2000); p.age = 30; p.birthday' 1996
# triage-held 2026-11-06 (night decision, review at 10:00): accessor forms ruled out by property-accessors (use `age := …; age(v) := …`) :: is! 'class P{birthday:int; age:{2026 - birthday} set{birthday = 2026 - it}}; p = P(2000); p.age = 30; p.birthday' 1996
# triage-held 2026-11-06 (night decision, review at 10:00): accessor forms ruled out by property-accessors (use `age := …; age(v) := …`) :: is! 'class P{birthday:int; get age() { 2026 - birthday }; set age(v) { birthday = 2026 - v }}; p = P(2000); p.age = 30; p.age' 30

# a_function_member_assigned_stores_its_call_back
is! 'class B {x: int}; r(b: B, m) := B(m); r(xs: list, m) := xs; b = B(1); b.r = 5; b.x' 5
