# from test_type_values.rs: edit the Rust test, then run the script again

# a_type_value_joins_as_its_class
'"type is " + type 3'	'type is class nat'
'x = int; "\\(x)"'	'class int'
'x = int; x as text'	'class int'
'x = 3; "" + type(x) == "class nat"'	true

# the_type_of_a_type_value_is_type
'x = int; type x'	'type'
'type(int)'	'type'
'f(t: type) := type(t); f int'	'type'

# a_type_value_still_compares_as_the_type
'x = 3; type(x) == nat'	true
'x = int; x == int'	true
