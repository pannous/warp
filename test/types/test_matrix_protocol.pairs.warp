# a class with rows, cols and element(i, j) is a matrix: every matrix word takes it, as it takes a list of rows
# (decision matrix-protocol, card matrix-protocol-default)
'use matrix; class Diag { d: list; rows() := count(d); cols() := count(d); element(i, j) := if i == j then d#i else 0 }; m = Diag([1, 2]); [rows(m), cols(m), shape(m), map_matrix(m, x => x + 1)]'	[2, 2, [2, 2], [[2, 1], [1, 3]]]
'use matrix; class Diag { d: list; rows() := count(d); cols() := count(d); element(i, j) := if i == j then d#i else 0 }; m = Diag([1, 2]); [transpose(m), matmul(m, [[1, 1], [1, 1]]), scale(m, 3)]'	[[[1, 0], [0, 2]], [[1, 1], [2, 2]], [[3, 0], [0, 6]]]
'use matrix; class Diag { d: list; rows() := count(d); cols() := count(d); element(i, j) := if i == j then d#i else 0 }; m = Diag([1, 2]); determinant(m) == 2'	yes
'use matrix; class Diag { d: list; rows() := count(d); cols() := count(d); element(i, j) := if i == j then d#i else 0 }; m = Diag([1, 2]); [m is matrix, [[1, 2], [3, 4]] is matrix, [[1], [2, 3]] is matrix, 3 is matrix]'	[yes, yes, no, no]
'use matrix; class Diag { d: list; rows() := count(d); cols() := count(d); element(i, j) := if i == j then d#i else 0 }; m = Diag([1, 2]); f(x: matrix) := rows(x) * cols(x); [f(m), f([[1, 2, 3]]), columns([[1, 2, 3]])]'	[4, 3, 3]
# Matrix and matrix build the default class: the list of rows, unless `matrix default` names another
'use matrix; Matrix x = [[1, 2], [3, 4]]; x#2#1'	3
'use matrix; class Dense { rs: list; rows() := count(rs); cols() := count(rs#1); element(i, j) := rs#i#j }; matrix default Dense; Matrix x = [[1, 2], [3, 4]]; [x is Dense, transpose(x)]'	[yes, [[1, 3], [2, 4]]]

# Matrix, the protocol's default class (decision matrix-class): * the matrix product, + and - element by element
'use matrix; a = Matrix([[1, 2], [3, 4]]); [(a * a).cells, (a + a).cells, (a * 2).cells, determinant(a)]'	[[[7, 10], [15, 22]], [[2, 4], [6, 8]], [[2, 4], [6, 8]], -2]
'use matrix; [[1, 2]] + [[3, 4]]'	[[1, 2], [3, 4]]
