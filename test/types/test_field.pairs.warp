# a parameter of a class declaring a field reads that field, though a function has its name; the function stays
# callable (card class-field-reads)
'class F { kinds: list; name: text }; kinds(n: int): int := n * 2; size(f: F): int := #f.kinds; size(F([1, 2, 3], "x")) + kinds(4)'	11
'class F { count: int }; total(f: F): int := f.count + 1; total(F(41))'	42

# a field of ø is a catchable error naming it, never a trap (card person-class-definition)
'class Person{name: text}; p: Person? = ø; p.name'	error
'class Person{name: text}; p: Person? = Person("Ada"); p.name'	"Ada"
'class Person{name: text}; f(p: Person?) := try p.name catch e { "none" }; f(ø)'	"none"
