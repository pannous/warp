# from test_generic_types.rs: edit the Rust test, then run the script again

# test_nested_type_applications
'x:list<list<int>>=[[1], [2]]; type(x)'	'list of list of int'
'x:list of list of int=[[1], [2]]; type(x)'	'list of list of int'

# test_type_of_a_literal_list_stays
'type([1 2 3])'	'list of int'

# test_comparisons_and_shifts_are_not_type_applications
'a=1;b=2;a < b'	true
'a=1;b=2;a > b'	false
'a=3;b=2;a >= b'	true
'1 << 3'	8
'1<<3'	8
# an optional of a generic, `list<int>?`, is a result type as `list?` is
'f(x: int) as list<int>? := if x > 0 then [x] else ø; [f(2), f(0)]'	[[2], ø]
'pick(xs: list<T>) as T? := { for x in xs { return x }; ø }; [pick([1, 2]), pick([])]'	[1, ø]
