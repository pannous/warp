# Typed parse first slice: unsupported field shapes must be refused.
'class User { name: string? }; try { parse("{}", User) } catch e { e.message }'	'typed JSON supports only required flat fields yet'
'class Address { city: string }; class User { address: Address }; try { parse("{address:{city:Berlin}}", User) } catch e { e.message }'	'typed JSON supports only required flat fields yet'
