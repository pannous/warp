# card pure-class-methods (stage 2): a method named like a function of the program or a word of the library (sum, max,
# round) is called on the instances of its classes, and any other value still reaches the function itself
# (run-time instances: `warp test tests/types` , `warp test --self tests/types` through
# warp self)

# a_method_named_like_a_library_word_is_the_instances
is! "class Bag { items: list; sum() := 42 }
Bag([1, 2]).sum()" 42
is! "class Bag { items: list; max() := 7 }
Bag([1]).max()" 7

# a_list_still_reaches_the_library_word
is! "class Bag { items: list; sum() := 42 }
b = Bag([1, 2])
[1, 2, 3].sum() + b.sum()" 48
is! "class Bag { items: list; max() := 7 }
[4, 9, 2].max()" 9

# a_method_named_like_a_library_word_reads_its_fields
is! "class Bag { items: list; sum() := items.sum() * 10 }
Bag([1, 2]).sum()" 30

# a_sibling_named_like_a_library_word
is! "class Bag { items: list; max() := 7; top() := max() + 1 }
Bag([1]).top()" 8

# a_subclass_overrides_a_method
is! "class Shape { side: int; doubled() := side * 2 }
class Square extends Shape { doubled() := side * 4 }
Square(3).doubled() + Shape(3).doubled()" 18

# a_method_named_like_a_function_of_the_program
is! "twice(x) := x * 2
class P { x: int; twice() := x * 20 }
twice(4) + P{x: 1}.twice()" 28
