# an element of a list declared [T] is a T, a class's instance with its fields, never read as a text (card typed-list-where-field)
'class P{a: int}; ps: [P] = [P(1), P(3)]; q = ps#2; q.a'	3
'class P{a: int}; ps: [P] = [P(1), P(3)]; ps.filter(p => p.a > 2).map(p => p.a)'	[3]
'xs: [int] = [1, 2]; y = xs#2; y + 1'	3
'xs: [float] = [1.5, 2]; y = xs#1; y * 2'	3.0
'xs: [text] = ["a", "b"]; y = xs#2; y + "!"'	"b!"
