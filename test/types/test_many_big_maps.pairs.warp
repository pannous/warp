# more big maps than the runtime keeps indexes for, looked up in turn, each answers its own entries (card lookup-index-lru)
'made(n) := { entries = {}; for i in 1 to 20 { entries["k" + i] = i * n }; entries }; maps = [made(n) for n in 1 to 70]; total = 0; for round in 1 to 3 { for m in maps { total += m["k7"] + m["k20"] } }; total'	201285
'made(n) := { entries = {}; for i in 1 to 20 { entries["k" + i] = i * n }; entries }; maps = [made(n) for n in 1 to 70]; for m in maps { m["k7"] = 0 }; total = 0; for m in maps { total += m["k7"] + m["k8"] }; total'	19880
