# card pure-inherited-fields: a subclass's instance takes its parent's fields and defaults first, then its own (a chain
# of parents, declared in any order); an optional field left out, `b?` or `b: text?`, is ø
# (run-time instances: `warp test tests/types` , `warp test --self tests/types` through
# warp self)

# a_subclass_instance_takes_its_parents_fields
is! "class Animal { name: text }
class Dog extends Animal { breed? }
d = Dog{name: \"Rex\"}
d.name" "Rex"
is! "class Animal { name: text }
class Dog extends Animal { breed: text }
d = Dog{name: \"Rex\", breed: \"pug\"}
d.breed + \" \" + d.name" "pug Rex"

# a_chain_of_parents_gives_every_field
is! "class A { a: int }
class B extends A { b: int }
class C extends B { c: int }
x = C{a: 1, b: 2, c: 3}
x.a + x.b + x.c" 6

# a_parent_declared_after_its_subclass
is! "class Dog extends Animal { breed: text }
class Animal { name: text }
d = Dog{name: \"Rex\", breed: \"pug\"}
d.name" "Rex"

# a_subclass_takes_its_parents_defaults
is! "class Animal { name: text; legs: int = 4 }
class Dog extends Animal { breed: text? }
Dog{name: \"Rex\"}.legs" 4

# an_optional_field_left_out_is_nothing
is! "class D { a: int; b? }
D{a: 1}.b ?? \"none\"" "none"
is! "class D { a: int; b: text? }
D{a: 1}.b ?? \"none\"" "none"
is! "class D { a: int; b: text? }
D{a: 1, b: \"pug\"}.b" "pug"
