# Decision D4: supplied fields do not evaluate class defaults; omitted defaults run once.
'global hits = 0; next_default() := { hits = hits + 1; 9 }; class Counter { value: number = next_default() }; c = parse("{value:7}", Counter); c.value + hits'	7
'global hits = 0; next_default() := { hits = hits + 1; 9 }; class Counter { value: number = next_default() }; c = parse("{}", Counter); c.value + hits'	10
