# from test_time_values_at_run_time.rs: edit the Rust test, then run the script again

# test_durations_and_zoned_times_read_back
is! 'z = zoned(2024-01-31T10:00, "Europe/Berlin"); print z; str(z)' '2024-01-31T10:00+01:00'

# test_zoned_times_and_durations_compare_at_run_time
is! 'a = zoned(2024-01-31T10:00, "Europe/Berlin"); b = zoned(2024-01-31T10:00, "Europe/London"); print a; a < b' true
