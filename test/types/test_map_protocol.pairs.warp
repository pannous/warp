# a class with the map words keys, get, has, set and remove is a map: every map word and form reaches its own methods
# (decision map-protocol, card protocol-default-implementation)
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := { ks = ks.filter(x => x != k) } }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; keys(p)'	['a', 'b']
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; p["b"]'	2
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; p.b'	2
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a"], vs: [1]}; p["c"] = 5; p.get("c")'	5
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a"], vs: [1]}; "a" in p'	yes
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a"], vs: [1]}; "z" in p'	no
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; s = ""; for k in p { s += k }; s'	'ab'
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; get_or(p, "b", 0) + get_or(p, "z", 7)'	9
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; entries(p)'	[['a', 1], ['b', 2]]
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; values(p)'	[1, 2]
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := { ks = ks.filter(x => x != k) } }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; p.remove("a"); keys(p)'	['b']
# its own fields stay fields, and a hashed map stays as it was
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := 0; has(k) := no; set(k, v) := ø; remove(k) := ø }; p = Pairs{ks: ["a"], vs: [1]}; p.ks'	['a']
'm = {a: 1}; m["b"] = 2; [keys(m), "a" in m, get_or(m, "z", 3)]'	[['a', 'b'], yes, 3]
# conformance is structural: such a class is a map, and a place typed map takes it as it takes a hashed map
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; [p is map, {a: 1} is map, 3 is map]'	[yes, yes, no]
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: ["a", "b"], vs: [1, 2]}; f(m: map) := keys(m); [f(p), f({c: 3})]'	[['a', 'b'], ['c']]
# Map{…} and map{…} build the default class: the hashed map, unless `map default` names another, which is then built
# from the hashed one; `Map x = {…}` too, and a place typed map takes either
'm = Map{a: 1}; [m.a, keys(m), m is map]'	[1, ['a'], yes]
'm = map{a: 1, b: 2}; values(m)'	[1, 2]
'Map x = {a: 1}; x.a'	1
'm = ListMap({a: 1, b: 2}); m.remove("a"); m["c"] = 3; [keys(m), values(m), m.c, "b" in m, m.get("z")]'	[['b', 'c'], [2, 3], 3, yes, ø]
'map default ListMap; m = Map{a: 1, b: 2}; [m is ListMap, keys(m), m["b"], "a" in m]'	[yes, ['a', 'b'], 2, yes]
'map default ListMap; Map x = {a: 1}; x["c"] = 3; [x is ListMap, values(x)]'	[yes, [1, 3]]
'map default ListMap; f(m: map) := m["a"]; f(Map{a: 3}) + f({a: 4})'	7
'm = ListMap(); for i in 1 to 3 { m["k" + i] = i * 10 }; [keys(m), m["k2"]]'	[["k1", "k2", "k3"], 20]
'class Pairs { ks: list; vs: list; keys() := ks; get(k) := vs#(ks.index_of(k)); has(k) := k in ks; set(k, v) := { ks = ks + [k]; vs = vs + [v] }; remove(k) := ø }; p = Pairs{ks: [], vs: []}; for i in 1 to 3 { p["k" + i] = i }; [keys(p), p["k2"]]'	[["k1", "k2", "k3"], 2]
