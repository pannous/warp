# from test_class_destructuring.rs: edit the Rust test, then run the script again

# braces_take_fields_by_name
is! 'class Point{x:int y:int}; p = Point(1, 2); {y: b, x: a} = p; a * 10 + b' 12

# match_arms_take_an_instance_apart
is! 'class Circle{r:int}; class Rect{w:int h:int}; area(s) := match s { Circle{r} => 3 * r * r; Rect{w, h} => w * h }; area(Rect(2, 3)) + area(Circle(1))' 9
is! 'class Circle{r:int}; class Rect{w:int h:int}; area(s) := match s { Circle(r) => 3 * r * r; Rect(w, h) => w * h }; area(Rect(2, 5))' 10

# nested_patterns_and_constants
is! 'class Point{x:int y:int}; class Line{start:Point end:Point}; kind(p) := match p { Point{x: 0, y} => y; Point(x, 0) => x * 10; Point{x, y} => x + y + 100 }; kind(Point(0, 7))' 7
is! 'class Point{x:int y:int}; class Line{start:Point end:Point}; kind(p) := match p { Point{x: 0, y} => y; Point(x, 0) => x * 10; Point{x, y} => x + y + 100 }; kind(Point(4, 0))' 40
is! 'class Point{x:int y:int}; class Line{start:Point end:Point}; kind(p) := match p { Point{x: 0, y} => y; Point(x, 0) => x * 10; Point{x, y} => x + y + 100 }; kind(Point(1, 2))' 103

# a_class_pattern_names_some_fields: a place `name: pattern` takes the field of that name, any other place the field at
# its position; fields no place names are not looked at (decision with the user 2026-11-17, kernel forms as classes)
is! 'class Call{called: text; arguments: list; origin: text = "?"}; match Call("f", [1, 2]) { Call(f, args) => f + #args; _ => "no" }' 'f2'
is! 'class Call{called: text; arguments: list; origin: text = "?"}; match Call("f", [1, 2]) { Call{arguments} => #arguments; _ => 0 }' 2
