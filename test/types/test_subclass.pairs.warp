# x is Class holds for an instance of a class extending it, whatever the subject: a call, a literal, a name
'class A {}; class B extends A {}; [B() is A, A() is B]'	[true, false]
'use units; [(5ms) is Quantity, 5ms is Time]'	[true, true]

'class Animal{name: text}; class Dog extends Animal{}; speak(a: Animal) := a.name + " makes a sound"; speak(d: Dog) := d.name + " barks"; [speak(Dog("Rex")), speak(Animal("Kitty"))]'	["Rex barks", "Kitty makes a sound"]
'class Animal{name: text}; class Dog extends Animal{}; speak(a: Animal) := "sound"; speak(d: Dog) := "bark"; out = []; for pet in [Animal("K"), Dog("R")] { out += [speak(pet)] }; out'	["sound", "bark"]
# a program's class extending a library's: the library's code calls the program's methods (card pass-rate-regression)
'use feeds; class C extends Polled { poll() := [{u: "a"}]; key(q) := q.u }; C(period: 1).refill()'	[{u: "a"}]
