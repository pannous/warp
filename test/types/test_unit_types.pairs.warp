# a unit word in a type position is its dimension's class (card unit-fields): fields, variables, parameters
'class R{d: km}; R(1500m).d'	1500m
'class R{t: min; w: kg}; r = R(50min, 3kg); r.w + 500g'	3.5kg
'f(d: km) := d * 2; f(3km)'	6km
'min(3, 4)'	3
't = 1km; t += 500m; t'	1.5km
'class Run{distance: km; note: text}; stored runs: [Run]; runs.add(Run(5km, "park")); stored_table("runs", Run)#1.distance'	5km
'sum([2km, 500m])'	2.5km
