# from test_type_name_matching.rs: edit the Rust test, then run the script again

# test_type_word_is_the_parameter_name
'succ int := int+1; succ 3'	4

# test_lone_type_word_parameter_is_it
'foo of int = it + it; foo 3'	6

# test_an_unknown_noun_is_an_untyped_name
'to measure a parcel: parcel+1; measure 2'	3

# test_a_declared_class_types_its_noun
'to keep a photo: photo; keep 3'	3

# test_a_multi_word_noun_is_named_and_typed_by_its_head
'to call a phone number: number+1; call 41'	42

# test_a_type_written_before_the_name_types_it (notes/matching.md rule 3, card phrase-typed-params)
'to plus number a to number b: a+b; plus(1.5, 2)'	3.5
'to plus number a, number b as real: a+b; plus(1, 2)'	3
'to scale int factor of number x: x*factor; scale(2, 1.5)'	3
