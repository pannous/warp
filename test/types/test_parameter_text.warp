# from test_parameter_text.rs: edit the Rust test, then run the script again

# a_typed_parameter_prints_by_its_text_method
is! 'class V{x:int; text() := "v" + text(x)}
f(q:V) := text(q)
f(V(1))' 'v1'
is! 'class V{x:int; text() := "v" + text(x)}
f(q:V) := q.text()
f(V(2))' 'v2'
is! 'class V{x:int; text() := "v" + text(x)}
f(q:V) := q as text
f(V(3))' 'v3'
is! 'class V{x:int; text() := "v" + text(x)}
f(q:V) := "is \\(q)"
f(V(4))' 'is v4'
is! 'class V{x:int; text() := "v" + text(x)}
f(n, q:V) := text(n) + text(q)
f(5, V(6))' '5v6'

# a_typed_parameter_types_only_its_own_function
is! 'class V{x:int; text() := "v" + text(x)}
f(q:V) := text(q)
g(q) := text(q)
g(3) + f(V(1))' '3v1'
is! 'class V{x:int; text() := "v" + text(x)}
q = V(1)
g(q) := text(q)
g(3)' '3'
