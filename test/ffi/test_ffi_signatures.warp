# :: 1» 1
is! «import srand from 'c'
import rand from 'c'
srand(7)
a=rand()
srand(7)
a==rand()» true
is! «import abs from 'c'
abs(-5)» 5
is! «import sqrtf from 'c'
sqrtf(2.25)» 1.5
is! «import fabsf from 'c'
