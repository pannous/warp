# from test_foreign_js.rs: edit the Rust test, then run the script again
// needs: js

# test_js_globals
'use js Math; Math.max(1, 5)'	5
'use js Math; Math.max(1, 5) + 1'	6
'use js "Math"; Math.PI > 3'	1
'use js JSON; JSON.stringify([1, 2])'	'[1,2]'

# test_js_modules
'use js "crypto"; count crypto.randomUUID()'	36
'use python math; use js Math; math.pi - Math.PI'	0

# test_values_held_from_another_runtime_compare
'use js Math; if Math.max(1.5, 0) > 1 {1} else {0}'	1

# test_foreign_printing_keeps_the_answer_channel
'use js console; console.log(1); 3'	3
'use python builtins; builtins.print(1); 3'	3

# use js window: the page's Window, WebIDL's WindowProxy (document.defaultView) the same, its members checked (card use-js-window)
'use js window; window.atob("aGk=")'	'hi'
'use js window; window.document.defaultView.atob("aGk=")'	'hi'
'use js window; window.nonsense'	error	Window has no nonsense
