# from test_ffi.rs: edit the Rust test, then run the script again

# test_dynlib_import_emit
'use m; ceil(3.2)'	4.0
'use math; floor(3.7)'	3.0
'use m; fmin(3.5, 2.1)'	2.1
'use m; fmax(1.5, 2.5)'	2.5

# test_ffi_string_math_combined
«import atof from c;import ceil from 'm';ceil(atof('3.7'))»	4.0

# test_ffi_math_pipeline
«import (sin,floor,fabs) from 'm'; fabs(floor(sin(3.14159)))»	0.0
«import (ceil,floor,fmax) from 'm'; fmax(ceil(2.3), floor(5.9))»	5.0

# test_ffi_text_arguments_known_at_run_time
'import atoi from "c"; q = atoi("3"); q'	3
'import atoi from "c"; xs=["12" "30"]; atoi(xs#1) + atoi(xs#2)'	42
'import strlen from "c"; xs=["hello"]; strlen(xs#1)'	5
