# a warp function passed to C as a function pointer, C calling it back (card ffi-callbacks, lib/callbacks.warp)

'qsort(base: handle, count: i64, size: i64, compare: handle): void from "c"\nimport (calloc, field_i64, set_field_i64) from "c"\nm = calloc(4, 8)\nfor i in 0 ..< 4 { set_field_i64(m, i * 8, [3, 9, 1, 7]#(i + 1)) }\nqsort(m, 4, 8, c_callback((a, b) => field_i64(a, 0) - field_i64(b, 0), ["handle", "handle"]))\n[field_i64(m, i * 8) for i in 0 ..< 4]'	[1, 3, 7, 9]
'c_callback(x => x, ["f64"])'	error	a float argument never reaches a callback
