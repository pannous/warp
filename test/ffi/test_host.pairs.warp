# a C word takes only calls of its own arity: web's read(fd, buffer, size) beside the prelude's read(path), a call of
# another count is the builtin's (decision host-call-by-arity, card dev-page)
'read(fd: i32, buffer: handle, size: i64): i64 from "c"; p = temp_folder() + "/host_word_arity.txt"; write(p, "hi"); read(p)'	'hi'

# a typed C word beside a library word of its name and count picks by the arguments' types (card web-write-call):
# web's write(fd, data) beside the prelude's write(path, text); known kinds decide when compiled, others at run time
'use web; write(2, "")'	0
'use web; p = temp_folder() + "/host_word_types.txt"; write(p, "hi"); read(p)'	"hi"
'use web; fd = [2]#1; write(fd, "")'	0
'use web; p = [temp_folder() + "/host_word_types_2.txt"]#1; write(p, "ok"); read(p)'	"ok"
