# the words the parser makes prefix operators broadcast over a list, called spaced or in parentheses (card p50-scalar)
'sqrt [4, 9]'	[2 3]
'sqrt([4, 9])'	[2 3]
'cbrt [8, 27]'	[2 3]
'abs [-1, 2]'	[1 2]
'xs = [1.0, 4.0]; sqrt xs'	[1 2]
'sqrt 9'	3
# Julia's dot call is no warp (decision no-dot-call-broadcast): a did-you-mean of `f xs`, `f each xs`
'length.(["ab", "c"])'	error
'xs = ["ab", "c"]; length.(xs)'	error
'f(x) := x + 1; f.([1, 2])'	error
'f(a, b) := a * b; f.([1, 2], [3, 4])'	error
'max.([1, 5], 3)'	error
# a method call without arguments stays one
't = "ab"; t.chars()'	['a' 'b']
