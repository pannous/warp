# Extents, merge_intervals, subtract_intervals, IntervalSet (card lib-intervals)
'use intervals; extents_overlap(extent(1, 3), extent(3, 5))'	no
'use intervals; extents_overlap(closed_extent(1, 3), closed_extent(3, 5))'	yes
'use intervals; extents_overlap(closed_extent(1, 3), extent(3, 5))'	yes
'use intervals; extents_overlap(extent(1, 4), extent(3, 5))'	yes
'use intervals; extents_overlap(extent(2, 2), extent(0, 5))'	no
'use intervals; extents_overlap(closed_extent(2, 2), extent(0, 5))'	yes
'use intervals; extent_is_empty(extent(2, 2))'	yes
'use intervals; extent_contains(closed_extent(2, 2), 2)'	yes
'use intervals; extent_contains(extent(1, 3), 3)'	no
'use intervals; extent_contains(closed_extent(1, 3), 3)'	yes
'use intervals; extent_contains(extent(1, 10), extent(2, 10))'	yes
'use intervals; extent_contains(extent(1, 10), closed_extent(2, 10))'	no
'use intervals; try extent(5, 1).text() else "refused"'	"refused"
'use intervals; extent_intersection(extent(1, 5), closed_extent(3, 8)).text()'	"[3, 5)"
'use intervals; extent_intersection(closed_extent(1, 3), extent(3, 5)).text()'	"[3, 3]"
'use intervals; extent_intersection(extent(1, 3), extent(3, 5))'	ø
'use intervals; extent_union(extent(1, 3), extent(3, 5)).text()'	"[1, 5)"
'use intervals; extent_union(extent(1, 4), closed_extent(2, 6)).text()'	"[1, 6]"
'use intervals; try extent_union(extent(1, 2), extent(3, 4)).text() else "disjoint"'	"disjoint"
'use intervals; merge_intervals([extent(5, 7), extent(1, 3), extent(2, 4), extent(9, 9)]).map(e => e.text())'	["[1, 4)", "[5, 7)"]
'use intervals; merge_intervals([extent(3, 5), extent(1, 3)]).map(e => e.text())'	["[1, 5)"]
'use intervals; merge_intervals([])'	[]
'use intervals; total_length([extent(5, 7), extent(1, 3), extent(2, 4)])'	5
'use intervals; subtract_intervals(extent(0, 10), [extent(2, 3), extent(8, 12)]).map(e => e.text())'	["[0, 2)", "[3, 8)"]
'use intervals; subtract_intervals(extent(0, 10), [extent(4, 6)]).map(e => e.text())'	["[0, 4)", "[6, 10)"]
'use intervals; subtract_intervals(extent(0, 10), [extent(0, 2), extent(9, 10)]).map(e => e.text())'	["[2, 9)"]
'use intervals; subtract_intervals(extent(0, 10), [extent(-5, 20)])'	[]
'use intervals; subtract_intervals(extent(0, 10), []).map(e => e.text())'	["[0, 10)"]
'use intervals; interval_set([extent(0, 10), extent(5, 20)]).remove(extent(3, 6)).items.map(e => e.text())'	["[0, 3)", "[6, 10)", "[6, 20)"]
'use intervals; s = interval_set([]).add(extent(0, 10)).remove(extent(4, 5)); [s.contains(4), s.contains(5), s.contains(3)]'	[no, yes, yes]
'use intervals; interval_set([extent(0, 10), extent(5, 20), closed_extent(8, 8)]).stabbing(8).map(e => e.text())'	["[0, 10)", "[5, 20)", "[8, 8]"]
'use intervals; interval_set([extent(0, 10), extent(5, 20)]).stabbing(20)'	[]
'use intervals; interval_set([extent(0, 3), extent(2, 6)]).merged().map(e => e.text())'	["[0, 6)"]
'use intervals; use time; h = 3600000; day = extent(Instant(9 * h), Instant(17 * h)); busy = [extent(Instant(13 * h), Instant(14 * h)), extent(Instant(10 * h), Instant(11 * h)), extent(Instant(10 * h + h / 2), Instant(12 * h))]; subtract_intervals(day, busy).map(e => format_time(e.lo.ms) + "-" + format_time(e.hi.ms))'	["09:00:00-10:00:00", "12:00:00-13:00:00", "14:00:00-17:00:00"]
'use intervals; use time; extents_overlap(extent(Instant(0), Instant(1000)), extent(Instant(1000), Instant(2000)))'	no
'use intervals; use time; total_length([extent(Instant(0), Instant(60000)), extent(Instant(30000), Instant(90000))])'	90000
