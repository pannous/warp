# from test_empty_is_absence.rs: edit the Rust test, then run the script again

# an_empty_value_is_not_missing
'[] == ø'	false
'"" == ø'	false
'[] != ø'	true
'x = []; x == ø'	false
'f(a: any) := a == ø; f([])'	false
'ø == ø'	true

# is_nothing_means_missing
'[] is ø'	false
'f(a: any) := a is ø; f([])'	false
'f(a: any) := a is ø; f(ø)'	true
'ø is ø'	true

# a_list_holding_an_empty_list_holds_no_nothing
'[[]].contains(ø)'	false
'xs = [[] 1]; ø in xs'	false
'[ø].contains(ø)'	true

# emptiness_is_asked_loosely
'xs = []; xs is empty'	true
'xs = []; if no xs then 1 else 2'	1
'xs = [1]; if no xs then 1 else 2'	2
't = ""; if not t then 1 else 2'	1
'm = {}; m is empty'	true
'xs = [1]; if xs then 1 else 2'	1

