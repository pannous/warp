# from test_element_wise_scalar.rs: edit the Rust test, then run the script again

# element_wise_on_a_number_is_the_plain_operator
'6 ./ 2'	3
'f(x) := x .+ 1; f(4)'	5

# element_wise_on_a_list_still_maps
'f(x) := x .+ 1; f([4,5])'	[5 6]
'xs=[1,2]; xs .* 3'	[3 6]
'g(xs) := count(xs) + (xs .* 2)#1; g([5,6])'	12
