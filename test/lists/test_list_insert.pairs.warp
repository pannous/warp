# xs.insert(i, v): v at the 0-based position i of the list itself, the position first as in Python; xs.insert(v, at: i) by name (decision list-insert)
'xs = [1, 2, 3]; xs.insert(1, 9); xs'	[1, 9, 2, 3]
'xs = [1, 2, 3]; xs.insert(9, at: 1); xs'	[1, 9, 2, 3]
'xs = [1, 2]; xs.insert(2, 7); xs'	[1, 2, 7]
'xs = ["a"]; ys = xs; ys.insert(0, "z"); xs'	['z', 'a']
