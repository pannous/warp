# a program whose classes order through compare still sorts numbers and texts (card sort-refuses-compare)
'use sound; f() := { xs = [[3, 1], [1, 2]]; sort([e#1 for e in xs]) }; f()'	[1 3]
'use units; sort(["b", "a"])'	['a' 'b']
'class P {x: int; compare(o) := x - o.x}; sort([2, 1])'	[1 2]
# values of no common order fail the run, naming both
'sort([1, "a"])'	error
