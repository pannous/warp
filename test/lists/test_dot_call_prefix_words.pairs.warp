# sqrt, cbrt and abs are plain functions, √ ∛ and ‖ ‖ their spellings (decision prefix-symbols-alias-functions):
# broadcast by the general rule; Julia's dot call is no warp (decision no-dot-call-broadcast)
'abs.([-3, 2])'	error
'sqrt.([4, 9])'	error
'abs [-3, 2]'	[3 2]
'x = -3; abs x'	3
'√9'	3
'∛27'	3
'‖-3‖ * 2'	6
'√[4, 9]'	[2 3]
'sqrt(2)'	√2
'sqrt(8)'	2√2
