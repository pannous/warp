# a range of whole numbers holds only its two ends (decision lazy-range-value): count, #, sum and r#i answer from
# them at once, any other list word makes its items, so a range stays a list everywhere
'n = 10^12; r = 1..n; [count r, sum r, r#123456789]'	[999999999999, 499999999999500000000000, 123456789]
'r = 1 to 10^12; #r'	1000000000000
'r = 1 to 5; r'	[1, 2, 3, 4, 5]
'(1..3) + [4]'	[1, 2, 4]
'r = 1 to 4; r.map(x => x * 2)'	[2, 4, 6, 8]
'r = 1 to 4; s = 0; for x in r { s += x }; s'	10
'r = 1 to 3; r#5'	error
'r = 5 to 1; #r'	0
'r = 1..1; #r'	0
