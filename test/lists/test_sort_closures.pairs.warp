# sort given a function: of one item the key it sorts by, of two the order, yes where the first goes before (guide
# "Closures"); Swift's shorthand arguments {$0 > $1} are such a function
'sort(["banana" "fig" "apple" "kiwi"], {it.length})'	["fig" "kiwi" "apple" "banana"]
'sort(["bb", "a"], w => #w)'	["a" "bb"]
'sort([8 3 1 5 2], {$0 > $1})'	[8 5 3 2 1]
'sorted([8 3 1 5 2], (a, b) => a < b)'	[1 2 3 5 8]
'sort([2, 1, 2, 1], (a, b) => a < b)'	[1 1 2 2]
'f = {$0 + $1}; f(2, 3)'	5
