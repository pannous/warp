# an operator outside Op's named cases is Op.Other, its spelling its own (card enum-op-should)
'key(1, "⊕", 2) as text'	"1⊕2"
'op_of(key(1, "⊕", 2)) as text'	"⊕"
'op_of(key(1, "⊕", 2)) == Op.Other'	yes
'op_of(key(1, "⊕", 2)) != Op.Other'	no
'op_of(key(1, "+", 2)) == Op.Other'	no
'op_of(key(1, "⊕", 2)) == op_of(key(1, "⊗", 2))'	no
'key(1, "⊕", 2).json'	'{"⊕":[1,2]}'
'match key(1, "⊕", 2) { Key(l, op, r): [op as text, op == Op.Other], _: 0 }'	['⊕', yes]
# quoted, an undeclared operator is the key written, not the call it reads as in code (card undeclared-unicode-operator)
'x = data (a ⊕ b); x.json'	'{"⊕":["a","b"]}'
'x = data (a ⊕ b); op_of(x) == Op.Other'	yes
'x = data (1 + (a ⊕ b)); x as text'	"1+(a⊕b)"
'infix operator ⊗(l, r) := l * r + 1; [3 ⊗ 4, (data (3 ⊗ 4)) as text]'	[13, "3⊗4"]
