# from test_filter_loops.rs: edit the Rust test, then run the script again

# test_a_class_name_loop_visits_only_its_instances
is! 'class friend{n:int}; class foe{n:int}; xs=[friend(1), foe(2), friend(3)]; s=0; for friend in xs { s += friend.n }; s' 4
is! 'class friend{n:int}; class foe{n:int}; xs=[friend(1), foe(2), friend(3)]; c=0; for friend in xs: c += 1
c' 2

