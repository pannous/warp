# a comment line between the arms of an if keeps the chain: the else after it is the if's (card core-comment-in-else-chain, interviewer OK 11-12)
'x = 3
r = 0
if x == 1 { r = 1 }
else if x == 2 { r = 2 }
// note
else { r = 9 }
r'	9
'f(x: int): text := {
	if x == 1 { return "a" }
	else if x == 2 { return "b" }
	// note
	else { return "c" }
}
[f(1), f(2), f(3)]'	['a', 'b', 'c']
'f(x: int): int := {
	r = 0
	if x == 1 { r = 1 }
	# note
	else { r = 5 }
	r
}
[f(1), f(2)]'	[1, 5]
