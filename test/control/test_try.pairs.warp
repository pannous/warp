# from test_try_braceless_call.rs: edit the Rust test, then run the script again

# a_braceless_call_is_guarded
'f(x) := x * 2; try f 4 else 3'	8
'xs = [1 2]; f(i) := xs#i; try f 5 else 3'	3
'try 1'	1

# from test_try_division.rs: edit the Rust test, then run the script again

# try_catches_every_error_of_a_division
'x = 5; try x / 0 else -1'	-1
'xs = [1, "a"]; try xs#2 / 2 else -1'	-1
'xs = [1.5, "a"]; try xs#2 / 2.0 else -1'	-1
'x = 9; try x / 3 else -1'	3

# from test_try_else_print.rs: edit the Rust test, then run the script again

# the_fallback_prints
'try print 1/0 else print "msg"'	ø
'try print 1 + 2 else print "msg"'	ø
'y = try 1/0 else 2 + 3; y'	5

# from test_try_else_value.rs: edit the Rust test, then run the script again

# try_else_takes_a_value_or_an_action
'x = 1; try 1 + [1 2]#5 else {x = 5}; x'	5

# from test_try_named_traps.rs: edit the Rust test, then run the script again

# indexing_a_number_is_not_a_list
'def f(m){ m#1 }; try f(3) else 7'	7

# a_missing_field_is_caught
'def f(m){ m.a }; try f(3) else 7'	7
'def f(m){ m.a }; try f({a:2}) else 7'	2
