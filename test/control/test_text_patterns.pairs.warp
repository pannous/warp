# from test_text_patterns.rs: edit the Rust test, then run the script again

# a_prefix_or_suffix_binds_the_rest
's = "0xff"; match s { "0x" + rest => rest; _ => "no" }'	'ff'
's = "a.txt"; match s { name + ".txt" => name; _ => "no" }'	'a'
's = "0yff"; match s { "0x" + rest => rest; _ => "no" }'	'no'

# pieces_and_holes_alternate
's = "(1,2)"; match s { "(" + a + "," + b + ")" => b + a; _ => "no" }'	'21'

# a_typed_hole_reads_its_text
's = "/users/7"; match s { "/users/" + id: int => id + 1; _ => 0 }'	8
's = "/users/me"; match s { "/users/" + id: int => id + 1; _ => 0 }'	0

# a_class_hole_tests_its_characters
's = "v12"; match s { "v" + n: digits => n; _ => "no" }'	'12'
's = "vx"; match s { "v" + n: digits => n; _ => "no" }'	'no'
's = "0xbeef"; match s { "0x" + h: hex => h; _ => "no" }'	'beef'
's = "a!"; match s { c: letter + "!" => c; _ => "no" }'	'a'

# a_known_name_in_a_sum_is_a_value
'p = "0x"; s = "0xff"; match s { p + "ff" => "same"; _ => "no" }'	'same'

# text_holes_fit_their_types
's = "t-3"; match s { "t" + n: int => n; _ => "no" }'	-3
's = "t-2.5"; match s { "t" + x: float => x; _ => "no" }'	-2.5
's = "t-"; match s { "t" + n: int => n; _ => "no" }'	"no"
