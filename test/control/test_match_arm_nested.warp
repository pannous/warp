# from test_match_arm_nested.rs: edit the Rust test, then run the script again

# an_unbraced_inner_match_keeps_the_outer_arms
is! 'f(n) := match n {
	1: match n + 1 { 2: "two"; _: "never" }
	_: "other"
}
f(1)' 'two'
is! 'f(n) := match n {
	1: match n + 1 { 2: "two"; _: "never" }
	_: "other"
}
f(5)' 'other'
is! 'n := 3; match n { 3: switch n * 2 { 6: "six"; _: "never" }; _: "other" }' 'six'

# an_unbraced_inner_match_over_a_node
is! 'f(n: Node): any := match n {
	Key(v, Op.Else, f): match v { Key(c, Op.Then, y): "then"; _: "plain" }
	_: "other"
}
f(symbol("x"))' 'other'
is! 'f(n: Node): any := match n {
	Key(v, Op.Else, f): match v { Key(c, Op.Then, y): "then"; _: "plain" }
	_: "other"
}
f(Key(symbol("a"), Op.Else, symbol("b")))' 'plain'
is! 'f(n: Node): any := match n {
	Key(v, Op.Else, f): match v { Key(c, Op.Then, y): "then"; _: "plain" }
	_: "other"
}
f(Key(Key(ø, Op.Then, symbol("y")), Op.Else, symbol("b")))' 'then'
