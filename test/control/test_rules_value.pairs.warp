'simplify = rules { data($a * 1) => a; data($a + 0) => a }; simplify(data(y * 1 * 1 + k * 1)) == data(y + k)'	yes
'simplify = rules { data($a * 1) => a }; simplify(data(f(x * 1, [z * 1]))) == data(f(x, [z]))'	yes
'zero = rules { data($a - $a) => 0 }; zero(data(q - q))'	0
# a rule set that never settles stops with a loud error (decision rewrite-rules, card swap-operands-rule)
'swap = rules { data($a * $b) => data($b * $a) }; swap(data(p * q))'	error
