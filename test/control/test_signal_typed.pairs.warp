# Signal values retain their values and watched names follow writes (notes/signals.md "Lists of signals").
'use signals; [signal_value(17), signal_value("hi"), signal_value(Signal{name: "missing", value: 42})]'	[17, "hi", 42]
'global seen = 0; watch(xs) := for s in xs { on change s { seen = s } }; a = 1; watch([a]); a = 7; seen'	7
