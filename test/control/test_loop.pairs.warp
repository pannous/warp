# a counted loop's own variable and an inlined map's inside it are two variables
'rows = ["a"]; for 2 { rows = rows.map(row => row + "x") }; rows'	["axx"]
'rows = ["a"]; for 1 to 2: rows = rows.map(row => row + "x"); rows'	["axx"]

# a loop without a named variable has its own it: the next such loop may give it another type (decision loop-scoped-it)
'n=0; for 1..3 {n+=it}; s=""; for "ab" {s+=it}; s'	'ab'
'n = 0; for [1, 2] { for [10, 20] { n += it } }; n'	60
's = ""; for 1 to 3: s += it; s'	'123'
