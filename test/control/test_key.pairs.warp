# from test_key_down.rs: edit the Rust test, then run the script again

# key_down_is_a_system_value_and_no_without_a_key_held
'if key_down { 1 } else { 0 }'	0

# a key's listener runs once as that key goes down, never each frame it is held, by a key word or a Key case (card
# key-press-on, notes/events_plan.md step 16)
'n = 0; on ESC { n += 1 }; emit key{key: "Escape"}; n'	1
'n = 0; on ESC { n += 1 }; emit key{key: "a"}; n'	0
'use keys; n = 0; on Key.escape { n += 1 }; emit key{key: "Escape"}; emit key{key: "Escape"}; n'	2
