# an empty `{}` given where a rule takes a block is an empty block (a rule's `$body: block` hole), not a map
'a = 1; on change a {}; a = 2; a'	2
'n = 5; each [1, 2] {}; n'	5
'xs = [1, 2]; xs.each {}; 3'	3

# from test_empty_bodies.rs: edit the Rust test, then run the script again

# an_empty_function_body_returns_nothing
'f() := {}; f(); 3'	3
'f() := { {} }; f(); 3'	3

# an_empty_timer_body_does_nothing
'n = 1; on every 1000 ms {}; n'	1
