# from test_text_in_logical_condition.rs: edit the Rust test, then run the script again

# a_text_in_a_logical_condition_is_true_when_it_has_characters
'g(k: text): int := { if k and yes { return 1 }; 2 }; g("y")'	1
'g(k: text): int := { if k and yes { return 1 }; 2 }; g("")'	2
'g(k: text): int := { if yes and k { return 1 }; 2 }; g("y")'	1
'g(k: text): int := { if k or no { return 1 }; 2 }; g("")'	2
'g(k: text): int := { if k or yes { return 1 }; 2 }; g("")'	1
'g(n: int): int := { if n and n > 2 { return 1 }; 2 }; g(3)'	1
'g(n: int): int := { if n and n > 2 { return 1 }; 2 }; g(0)'	2
