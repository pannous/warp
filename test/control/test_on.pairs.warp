# on exit runs once the program is done, the program's value kept (tour on exit)
'on exit { print "bye" }; print "working"; 42'	42

# from test_on_set_value.rs: edit the Rust test, then run the script again

# a_write_in_an_expression_runs_the_handler_and_gives_the_value
'x = 3; on set x { print "v" }; y = x--; y'	2
'x = 3; on set x { print "v" }; y = (x = 7); y'	7
