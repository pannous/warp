# test_define_entries_are_values
'class O { a: int; s := 2+3 }; O(1).s'	5
'class O { a: int; s := 2+3 }; O(1).a'	1
'class O { s := 5 }; O().s'	5
'class O { a := 1; s := 5 }; o = O(); o.a + o.s'	6
'class O { a: int; s := clock() }; O(1).s > 0'	1
