# from test_implicit_await.rs: edit the Rust test, then run the script again

# a task is read as its value by await, never implicitly (decision go-unified)
'f(x) := { sleep(10 ms); x * 2 }; job = go f(3); await job + 1'	7

# an_awaited_task_does_not_warn
'f(x) := { sleep(10 ms); x * 2 }; job = go f(3); await job + 1'	7
'f(x) := { sleep(10 ms); x * 2 }; job = go f(3); try await job else 0'	6
