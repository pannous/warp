# from test_meta_values.rs: edit the Rust test, then run the script again

# a_classes_meta
is! 'class A { a: int }
class P extends A { x: int }
length(p: P) := p.x
P.fields == ["a" "x"]' true
is! 'class A { a: int }
class P extends A { x: int }
length(p: P) := p.x
P.methods#1.name' 'length'

# meta_of_a_value_known_at_run_time
is! 'class A { a: int }
class P extends A { x: int }
length(p: P) := p.x
type(P(1, 2)).fields == ["a" "x"]' true
