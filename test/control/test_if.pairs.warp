# from test_if_value_kind.rs: edit the Rust test, then run the script again

# test_if_of_characters_joins_a_text
'c=1; "a" + (if c then "x" else "y")'	'ax'
'c=0; x = if c then "x" else "y"; "a" + x'	'ay'
'c=1; "a" + (c ? "x" : "yy")'	'ax'

# an if without else inside a loop body runs as a statement, never a compiler crash (card if-without-else)
's = 0; for y in 1 to 3 { if y > 1 then s += y }; s'	5
's = 0; for y in 1 to 3 { if y > 1 { s += y } }; s'	5
's = 0; for y in [1, 2, 3]: if y > 1 then s += y
s'	5
's = 0; i = 0; while i < 3 { i += 1; if i > 1 then s += i }; s'	5
