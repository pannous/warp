# a variable's listener takes its block after a colon too, as with braces (guide 189, card whenever-print)
'global n = 0; x = 1; whenever x > 2: n += 1; x = 3; n'	1
'global n = 0; x = 1; whenever x > 2 : n += 1; x = 3; x = 4; n'	1
'global n = 0; x = 1; once x == 5: n += 10; x = 5; x = 6; x = 5; n'	10
'global n = 0; x = 1; on set x: n += 1; x = 1; x = 2; n'	2
'global n = 0; x = 1; on change x: n += 1; x = 1; x = 2; n'	1
