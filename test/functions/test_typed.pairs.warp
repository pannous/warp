# from test_typed_lambda.rs: edit the Rust test, then run the script again

# a_lambda_parameter_declares_its_type
'f = (x:float)=>x/2; f(3)'	1.5
'f = (x:int, y)=>x+y; f(2, 3)'	5
'f = (x:float)=>x*1.5; s = 0.0; for i in 0..4 { s += f(i) }; s'	9.0

# A program's typed function named like a prelude word it can't join (no typed line of the library) is its own, as an
# untyped one is: the call reaches the program's, never the prelude's (card typed-add-overflow)
'add(a: int, b: int): int := a + b; add(2, 3)'	5
'add(a: text, b: text): text := a + "+" + b; add("x", "y")'	"x+y"
'count_item(a: int, b: int): int := 7; count_item(1, 2)'	7

# from test_typed_returns.rs: edit the Rust test, then run the script again

# test_type_before_the_name_converts_the_result
'float half(x) := x/2; half 3'	1.5

# test_return_type_after_the_parameters
'def square(x) : float = x*x; square 3'	9.0
'def square(x) as float = x*x; square 3'	9.0

# test_block_bodies_and_returns_convert_too
# triage-held 2026-11-06: C-style typed definition float twice(x) :: 'float twice(x) := {x+x}; twice 2'	4.0
