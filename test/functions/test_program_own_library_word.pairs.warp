# a program's typed definition of a library word joins it as a typed overload, else is the program's own: a call
# never reaches a body of other parameter types (card program-own-log)
'my_log(level: text, parts: texts) := level + ": " + parts.join(" "); my_log("warn", ["a", "b"])'	'warn: a b'
'my_log(level: text, parts: texts) := level; [my_log("warn", ["a"]), log(100, 10)]'	['warn', 2.0]
'my_log(level: text, n: int) := level; my_log("warn", 3)'	'warn'
'log(level: text) := level; log("warn")'	'warn'
