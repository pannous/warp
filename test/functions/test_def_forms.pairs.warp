# from test_def_forms.rs: edit the Rust test, then run the script again

# probe_def_block_syntax
'def test1(x){x+1}; test1(3)'	4

# definition_forms_agree
'def fib(n){n+1}; fib(3)'	4
# triage-held 2026-11-06: Python-style def …: bodies, foreign syntax :: 'def fib(n): n+1; fib(3)'	4
'fib(n) = n + 1; fib(3)'	4
'fib(n:int) = n + 1; fib(3)'	4
'fib := it + 1; fib(3)'	4

# a_def_function_calls_its_function_parameter
'def app(f, x) { return f(x) }; app(y => y+1, 2)'	3
'def app(f, x) { f(x) }; g(y):=y*3; app(g, 2)'	6

# a_parameter_tested_for_membership_is_no_function
'snake=[1]; f(p) := not (p in snake); f(3)'	1

# a_keyword_definition_may_take_an_operator_words_name
