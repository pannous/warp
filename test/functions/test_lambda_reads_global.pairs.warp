'global flag = no; set_flag() := { flag = yes }; check() := { flag = no; f = () => flag; set_flag(); f() }; check()'	yes
'global n = 0; bump() := { n += 1 }; turned(done: function) := { bump(); bump(); done() }; check() := { n = 0; turned(() => n) }; check()'	2
