# from test_functions_passed_by_name.rs: edit the Rust test, then run the script again

# a_function_passed_by_name_is_called_by_name
is! 'ink(x, y) := (x * 3 + y) % 7; each(f: function, n) := { total = 0; for i in 0..n { total = total + f(i, i + 1) }; total }; each(ink, 10)' 29

# recursive_passed_on_and_several_functions_by_name
is! 'dbl(x) := x * 2; inc(x) := x + 1
times(f: function, n, x) := if n < 1 then x else times(f, n - 1, f(x))
twice(f: function, x) := f(f(x))
via(f, x) := twice(f, x)
both(f: function, g: function, x) := g(f(x))
shadow(ink: function, x) := ink(x)
ink(x) := x * 10
times(dbl, 3, 1) * 1000 + via(inc, 5) * 100 + both(dbl, inc, 4) * 10 + shadow(inc, 7)' 8798

# a_function_parameter_passed_on_in_a_method_call
is! 'walk(n, f: function) := { if n is list { return f(n.map(x => walk(x, f))) }; f(n) }
bump(n) := if n is list then n else n + 1
walk([1, [2, 3]], bump)' [2 [3 4]]
