# from test_callable_parameter.rs: edit the Rust test, then run the script again

# a_callable_parameter_takes_a_function
is! 'square(x) := x * x
run(f: callable) := f(3)
run(square)' 9
is! 'run(f: callable) := f(3)
run(x => x * 2)' 6

# a_callable_parameter_takes_a_block
is! 'run(f: callable) := f()
run({ 1 + 2 })' 3

# callable_is_a_type
