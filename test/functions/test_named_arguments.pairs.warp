# a_bare_flag_name_in_a_call_sets_it
'a = {x: {y: 1}}; b = a.copy(shallow); b.x.y = 5; a.x.y'	5
'f(a, loud = false) := if loud then a * 10 else a; f(3, loud)'	30
'f(a, loud = false) := if loud then a * 10 else a; f(3)'	3
'f(a, loud: false) := if loud then a * 10 else a; f(3, loud)'	30
