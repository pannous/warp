# from test_parameter_assignment.rs: edit the Rust test, then run the script again

# assigning_an_annotated_parameter_checks_its_type
'f(n: int) := { n = 4; n }; f(3)'	4
'f(n: float) := { n = 4; n }; f(3)'	4.0
'f(n: int) := { n = 4; n }; n = "x"; f(3)'	4

# A parameter takes any value, whatever a variable of its name is given elsewhere: the overload is chosen by what the
# parameter holds (samples/gpu/ocean.warp: `e -> tan(e)` beside keys.warp's case `e = "e"`, card samples-gpu-ocean-2)
'e = "e"; f(a: int) := 1; f(a: text) := 2; [5].map(e -> f(e))'	[1]
'x = "a"; f(a: int) := 1; f(a: text) := 2; g(x) := f(x); g(5)'	1

# a parameter named like a list's member never hides the member (card compiler-built: the self build trapped on it)
'f(length: int) := length + 1; f(2)'	3
'x = {length: 3, a: 1}; x.length'	3
'Person{name: "A"}.name'	"A"

# from test_parameter_retype.rs: edit the Rust test, then run the script again

# a_parameter_given_another_kind_in_its_body_holds_it
'f(n) := { n = "x"; n }; f(5)'	'x'
'f(n) := { n = "xy"; n }; f(5)'	'xy'
'f(n) := { n = [1]; n }; f(5)'	[1]
'f(n) := { n = 2.5; n }; f(5)'	2.5

# a parameter is its definition's or lambda's own, never a library word or an overloaded function of its name
'g = find => find(2, 3); g((a, b) => a * b)'	6
'h = (count, x) => count(x); h(n => n + 1, 41)'	42
'f(find: function) := find(2, 3); f((a, b) => a - b)'	-1
