'sq(x):=x*x; sq 2 == 4 and yes'	error
'sq(x):=x*x; sq 2 + 1 == 9 and yes'	error

# from test_braceless_closure_call.rs: edit the Rust test, then run the script again

# a_function_variable_is_called_without_parentheses
'f = function upper; f "a"'	'A'
'add(a, b) := a + b; g = function add; g 1 2'	3
'f = x => x + 1; f 3 == 4'	error

# a_function_variable_given_a_number_is_refused
'f = function upper; f = function lower; f "A"'	'a'
