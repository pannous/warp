# a_function_assigned_in_a_call_is_a_named_argument
# triage-held 2026-11-06: Python keyword argument key=…, foreign syntax :: 'xs = [3, 1, 2]; sorted(xs, key=x=>-x)#1'	3
'sorted([3, 1, 2], key = x => -x)#3'	1
'sorted([3, 1, 2], key: x => -x)#1'	3
'f = x => x * 2; f(4)'	8

# a named argument of a call dispatched by its arguments' types goes by its name: save sound as: "a.wav"
'save(path: text, content) := 1; class R {}; save(made: R, as file) := file; save R() as: "a"'	"a"
'f(x: int, as file) := file; f(x: text, as file) := "t"; [f(1, as: "i"), f("x", as: "j")]'	["i", "t"]
