# a call takes the overload its computed arguments fit: a builtin's declared result, √, -, abs and + - * of known
# numbers (card number-computed-float, notes/overloads: an exact type before a widened one)
'f(x: int) := "int"; f(x: float) := "float"; f(sqrt(2))'	'float'
'f(x: int) := "int"; f(x: number) := "number"; f(sqrt(2))'	'number'
'f(x: int) := "int"; f(x: float) := "float"; f(2 + √2)'	'float'
'f(x: int) := "int"; f(x: float) := "float"; f(-sqrt(9))'	'int'
'f(x: int) := "int"; f(x: float) := "float"; f(2 * -3)'	'int'
'f(x: int) := "int"; f(x: float) := "float"; f(floor(2.5))'	'float'

# a variable keeps its kind whatever another function names its parameters; inside, a parameter is any value
'f(x: int) := "int"; f(x: float) := "float"; h(n) := n; n = 2 * 3; f(n)'	'int'
'g(x) := "any"; g(x: int) := "int"; k(x) := g(x); x = 2; k("a")'	'any'

# a variable's kind is its own scope's: another function's x = "a" leaves this x a float (card local-x-widening)
'f() := { x = "a"; x }
x = -1.005; round_to(x, 2)'	-1.01
'f() := { x = "a"; x }
g() := { x = -1.005; round_to(x, 2) }
g()'	-1.01
'g() := { x = -1.005; round_to(x, 2) }
g()'	-1.01
'f() := { x = "a"; x }
g() := { x = -1.005; round_to(x, 2) }
[f(), g()]'	["a", -1.01]
'x = -1.005; h = () => round_to(x, 2); h()'	-1.01
