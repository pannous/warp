# from test_operator_word_methods.rs: edit the Rust test, then run the script again

# a_method_named_like_an_operator_word_is_called
'class P{x:int; y:int; norm() := x*x+y*y}; P(1,2).norm()'	5
'class P{x:int; y:int; norm() := x*x+y*y}; p = P(1,2); p.norm()'	5
'class P{x:int; abs() := x * 10}; P(3).abs()'	30
'class P{x:int; fun cbrt() { x * 2 }}; P(3).cbrt()'	6

# the_operator_word_stays_an_operator_elsewhere
'use math; class P{x:int; norm() := x}; abs(-3) + norm(-4)'	7
'norm(x) := 777; norm(4)'	777

# a_definition_of_an_operator_word_without_parentheses_is_refused
'norm x := x * 10; norm -3'	-30
'use math; x := 3; norm x'	3
