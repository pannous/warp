# a name defined as a function value is bound to it (decision function-valued-definition); a pipe binds weaker than a
# braceless call of any argument (card pipe-number-argument)
'f := x => x*2; f(3)'	6
'square(x) := x*x; h := square & square; h(3)'	81
'square(x) := x*x; inc(x) := x+1; h := square | inc; h(3)'	10
'square(x) := x*x; square 3 |> text'	"9"
'square(x) := x*x; square 3 |> text |> size'	1
