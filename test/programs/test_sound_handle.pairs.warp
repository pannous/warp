// play gives the sound's handle, which stop_sound and fade_sound take (wiki/standard-library.md stop_sound, fade_sound)
'use sound; text(play(C4, 0.5s))'	"♪ 0.5 s"
'use sound; h = play(C4, 1s); fade_sound(h, 0, 0.5); stop_sound(h); h.duration'	1
'use sound; play(C4, 50ms); h = play(E4, 50ms); h.number'	2
'use sound; h = play(C4, 50ms); stop_sound(); 3'	3
