# from test_algo_levenshtein.rs: edit the Rust test, then run the script again

# test_levenshtein: the sample prints its five distances (card bug-levenshtein-total, faf3345b4b), the test reads them
'use "../../samples/text/levenshtein.warp"; [levenshtein("kitten", "sitting"), levenshtein("flaw", "lawn"), levenshtein("", "abc"), levenshtein("abc", "abc"), levenshtein("saturday", "sunday")]'	[3, 2, 3, 0, 3]

