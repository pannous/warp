# one word plays every sound (decision play-one-word): a list or a chord together, a score written as data one after
# another; melody sounds a list one after another; tone and tune are play's aliases; chord(C4, major) is a Chord
'use sound; play([C4 E4 G4], 100ms); round(sound_queued() * 10)'	1
'use sound; play(C4+E4+G4, 100ms); round(sound_queued() * 10)'	1
'use sound; melody([C4 E4 G4], 100ms); round(sound_queued() * 10)'	3
'use sound; play { c4 e4 [c4 g4] }; sound_queued() > 1'	true
'use sound; [tone(440Hz, 5ms, "square") > 0, play(C4, 5ms, "square") > 0, tune({ c4 [c4 g4] }) > 0]'	[true, true, true]
'use sound; [count(chord(C4, minor)), "" + chord(C4, major), play(chord(A3, minor), 5ms) > 0]'	[3, "C4+E4+G4", true]
