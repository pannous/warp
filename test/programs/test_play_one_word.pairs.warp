# one word plays every sound (card play-c4): a list one after another, each the duration long; a chord together;
# tone and melody are play's aliases, tune plays a score written as data; chord(C4, major) is a Chord
'use sound; play([C4 E4 G4], 100ms); round(sound_queued() * 10)'	3
'use sound; play(C4+E4+G4, 100ms); round(sound_queued() * 10)'	1
'use sound; chord([C4 E4 G4], 100ms); round(sound_queued() * 10)'	1
'use sound; [tone(440Hz, 5ms, "square") > 0, melody([C4 E4], 5ms) > 0, tune({ c4 [c4 g4] }) > 0]'	[true, true, true]
'use sound; [count(chord(C4, minor)), "" + chord(C4, major), play(chord(A3, minor), 5ms) > 0]'	[3, "C4+E4+G4", true]
