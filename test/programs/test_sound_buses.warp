# from test_sound_buses.rs: edit the Rust test, then run the script again

# a sound sent to a delay bus rings on: 0.1 s of A4 renders 2.9 s (decision bus-test-outcome)
is! 'use sound
room = bus() |> delay(0.3, 0.5, 1)
out(osc(A4, 0.1s), room)
round(save(sound, "bus_rings.wav") * 10)' 29

# list_effects_run_the_bus_dsp
is! 'use sound
count(osc(440, 0.1s) |> delay(0.1, 0.5))' 23105
is! 'use sound
count(osc(C4, 0.1s) |> lowpass(800))' 2205
