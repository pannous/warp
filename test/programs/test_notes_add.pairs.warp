# note names are notes (decision notes-are-notes): a note added to a note sounds with it, a number moves it in semitones
'use sound; "" + (C4 + E4)'	"C4+E4"
'use sound; "" + (C4 + E4 + G4)'	"C4+E4+G4"
'use sound; [C4 + 4 == E4, (C4 + E4) + 12 == C5 + E5]'	[true, true]
'use sound; [round(C4 * 100), hertz(C4) + 1]'	[26163, 262.63]
'use sound; melody([C4+E4 E4 G4], 5ms); play(C4 + E4 + G4, 5ms); "played"'	"played"
