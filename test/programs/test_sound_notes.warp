# from test_sound_notes.rs: edit the Rust test, then run the script again

# sharps_and_flats_are_notes
is! 'use sound
play(F♯4, 5ms)
round(F♯4 * 100)' 36999
is! 'use sound
play(Bb3, 5ms)
round(Bb3 as float, 2)' 233.08
is! 'use sound
play(C♯5, 5ms)
C♯5 == D♭5' true
is! 'use sound
melody([C4 Eb4 G4], 5ms)
round(Eb4 as float, 2)' 311.13

# every_octave_is_a_note
is! 'use sound
A0 as float' 27.5
is! 'use sound
round(C8 as float, 2)' 4186.01
is! 'use sound
round(note("G#7").hertz() * 100) == round(G♯7 * 100)' true

# a_variable_named_like_a_note_is_the_variable
is! 'A4 = 3
play(440Hz, 5ms)
A4' 3

# a_note_inside_a_function_body_plays
is! 'def A4(v) { v }; play(440Hz, 5ms)
A4(3)' 3
