# paint of a list of shaders: each draws into the field of its name, which a shader reads as $name(at), last frame's where nothing wrote it earlier in the frame; the last shows (wiki/graphics.md "Fields and passes"; decision shader-value (c))
'width = 2; height = 1; count = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return $count(at.xy) + vec4f(0.25, 0.0, 0.0, 0.0); } }; show = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return vec4f($count(at.xy).r, 0.0, 0.0, 1.0); } }; paint([count, show]); pixels = paint([count, show]); red = int(pixels#1 / 65536) % 256; red > 120 and red < 135'	yes
'width = 2; height = 1; glow = shader { @fragment fn main() -> @location(0) vec4f { return vec4f($level, 0.0, 0.0, 1.0); } }; show = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return $glow(at.xy); } }; pixels = paint([glow with {level: 1.0}, show]); int(pixels#1 / 65536) % 256'	255
