# wiki graphics.md "Fields and passes": each @compute pass of values.compute runs in source order before the draw; a fixed-length read_write array no value names is a field, kept from frame to frame and read by the draw as values.name
'use graphics; passes = "@group(0) @binding(0) var<storage, read_write> steps: array<f32, 2>; @compute @workgroup_size(1) fn first() { steps[0] = steps[0] + 0.25; } @compute @workgroup_size(1) fn second() { steps[1] = steps[0] * 2.0; }"; s = "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return vec4f(values.steps[0], values.steps[1] / 2.0, 0.0, 1.0); }"; gpu_render(s, 2, 2, {compute: passes}); gpu_render(s, 2, 2, {compute: passes}); gpu_render(s, 2, 2, {compute: passes})#2'	4290756352
# a field of atomics: every invocation counts into it, the draw reads the count (2 renders of 2 workgroups of 64: 256)
'use graphics; passes = "@group(0) @binding(0) var<storage, read_write> hits: array<atomic<u32>, 1>; @compute @workgroup_size(64) fn count() { atomicAdd(&hits[0], 1u); }"; s = "@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return vec4f(f32(values.hits[0]) / 256.0, 0.0, 0.0, 1.0); }"; gpu_render(s, 2, 2, {compute: passes, workgroups: 2}); gpu_render(s, 2, 2, {compute: passes, workgroups: 2})#2'	4294901760
