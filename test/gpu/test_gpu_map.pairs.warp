# xs.map(f) @gpu maps every item at once on the GPU, a new list, xs as it was (samples/acceleration/gpu_map.warp, card xs-map-gpu)
// needs: gpu
'xs = [0.0, 1.0, 2.0]; ys = xs.map(x => x * 2 + 1) @gpu; [xs, ys]'	[[0, 1, 2], [1, 3, 5]]
'halved(x) := x / 2; [2.0, 8.0].map(halved) @gpu'	[1, 4]
'n = 1000; xs = float[n]; for i in 1 to n { xs#i = i }; ys = xs.map(x => floor(sqrt(x))) @gpu; [#ys, ys#100, ys#n]'	[1000, 10, 31]
