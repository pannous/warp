# a picture among paint's values is a texture the shader samples as values.<name> with the sampler it names: nearest
# or bilinear, clamped at the edge or repeating (card gpu-texture-binds; wiki/graphics.md "Pixels and shaders")
'use image; p = image(2, 1, (x, y) => if x == 0 then red else blue); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return textureSampleLevel(values.p, nearest, vec2f(0.25, 0.5), 0.0); } }; gpu_render(s, 1, 1, {p: p})'	[4294901760]	needs: gpu
'use image; p = image(2, 1, (x, y) => if x == 0 then red else blue); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return textureSampleLevel(values.p, nearest_repeat, vec2f(1.75, 0.5), 0.0); } }; gpu_render(s, 1, 1, {p: p})'	[4278190335]	needs: gpu
'use image; p = image(2, 1, (x, y) => if x == 0 then red else blue); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return textureSampleLevel(values.p, bilinear, vec2f(0.5, 0.5), 0.0); } }; c = gpu_render(s, 1, 1, {p: p})#1; (c /! 65536) % 256 == c % 256 and c % 256 > 100 and (c /! 256) % 256 == 0'	yes	needs: gpu
'use image; p = image(3, 2, black); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { let size = textureDimensions(values.p); return vec4f(f32(size.x) / 255.0, f32(size.y) / 255.0, 0.0, 1.0); } }; gpu_render(s, 1, 1, {p: p})'	[4278387200]	needs: gpu
# a pixel without an alpha byte, rgb(…), is opaque
'use image; p = image(1, 1, (x, y) => rgb(0, 0, 255)); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return vec4f(textureSampleLevel(values.p, nearest, vec2f(0.5), 0.0).a, 0.0, 0.0, 1.0); } }; gpu_render(s, 1, 1, {p: p})'	[4294901760]	needs: gpu
'use image; p = image(1, 1, red); s = shader { @fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return textureSampleLevel(values.p, trilinear, vec2f(0.5), 0.0); } }; gpu_render(s, 1, 1, {p: p})'	error	needs: gpu
# a pixel written after a paint shows at the next: the picture is never an old one (interviewer 11-14)
'use image; p = image(1, 1, (x, y) => red); toy = shader { @compute @workgroup_size(16, 16) fn main_image(@builtin(global_invocation_id) id: vec3u) { textureStore(screen, id.xy, textureSampleLevel(channel0, nearest, vec2f(0.5), 0.0)); } }; gpu_render(toy, 1, 1, {channel0: p}); p.pixels[0] = blue; gpu_render(toy, 1, 1, {channel0: p})'	[4278190335]	needs: gpu
# a sampler or picture a comment names binds nothing: the bind group holds what the shader's code uses (card mode-crashes)
'use image; p = image(1, 1, (x, y) => red); s = "// four bilinear taps, values.q too\n@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f { return textureSampleLevel(values.p, nearest, vec2f(0.5), 0.0); /* bilinear_repeat */ }"; gpu_render(s, 1, 1, {p: p, q: p})'	[4294901760]	needs: gpu
