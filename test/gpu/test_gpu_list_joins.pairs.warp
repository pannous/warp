# a GPU list joined to a GPU list of its cell type stays a GPU list (card gpu-list-inference: color_swatches, meshlet_grid join theirs with +)
'xs: [vec4] = [[1, 2, 3, 4]]; ys: [vec4] = [[5, 6, 7, 8]]; zs = xs + ys; [gpu_list_place(zs) >= 0, #zs, zs#2]'	[yes, 2, [5.0, 6.0, 7.0, 8.0]]
'xs: [f32] = [1, 2]; ys: [f32] = [0.5]; zs = xs + ys; [gpu_list_place(zs) >= 0, zs#3]'	[yes, 0.5]
# of two cell types it is refused: copy one to a list first
'xs: [f32] = [1, 2]; ys: [i32] = [3]; xs + ys'	error	copy it to a list
