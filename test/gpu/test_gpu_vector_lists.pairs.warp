# [vec2], [vec3] and [vec4] GPU lists hold vectors of f32 lanes, a cell a list of its width, as paint's values bind them
# in one copy (card vec4-list; decision gpu-bound-floats)
'xs: [vec4] = [[1.0, 2.0, 3.0, 4.0], [5, 6, 7, 8]]; xs#2'	[5.0, 6.0, 7.0, 8.0]
'xs: [vec4] = [[1, 2, 3, 4]]; #xs'	1
'xs: [vec3] = float[2]; xs#2 = [0.5, 0.25, 1]; xs'	[[0.0, 0.0, 0.0], [0.5, 0.25, 1.0]]
'xs: [vec2] = [[i, i * 2] for i in 1 to 3]; xs#3'	[3.0, 6.0]
'xs: [vec4] = float[1]; xs#1 = [1, 2]'	error	holds vectors of its width only
'xs: [vec2] = [[sqrt(2), 1/3]]; round(xs#1#1, 3)'	1.414
