# GPU lists [f16]: two-byte floats a shader reads and writes as array<f16> after enable f16 (card gpu-lists)
'xs: [f16] = [1, 2.5, -3]; gpu_compute("enable f16; @group(0) @binding(0) var<storage, read_write> xs: array<f16>; @compute @workgroup_size(3) fn main(@builtin(global_invocation_id) id: vec3u) { xs[id.x] = xs[id.x] * 2.0h + 0.5h; }", xs, 1); xs'	[2.5, 5.5, -5.5]	needs: gpu
'xs: [f16] = [0.1, 65504, 0.00001]; [x for x in xs]'	[0.0999755859375, 65504, 0.000010013580322265625]
'xs: [f16] = [100000, -100000]; xs#1 > 1e300 and xs#2 < -1e300'	yes
'xs: [f16] = float[3]; xs#2 = 1/3; xs#2'	0.333251953125
'xs: [f16] = [1, 2]; #xs'	2
'try { gpu_compute("enable f16; @group(0) @binding(0) var<storage, read_write> xs: array<f16>; @compute @workgroup_size(3) fn main(@builtin(global_invocation_id) id: vec3u) { xs[id.x] = xs[id.x] * 2.0h + 0.5h; }", [1.0, 2.0], 1) } catch e { "takes a GPU list [f16]" in e.message }'	yes
