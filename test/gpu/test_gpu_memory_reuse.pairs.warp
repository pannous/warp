# a GPU list's cells are freed once no value holds the list (card gpu-memory-reuse): a program making new lists every
# frame runs in flat memory. 3000 lists of a million f32 cells are 12 GB made, of which one lives at a time
'n = 0; for frame in 0..3000 { xs: [f32] = float[1000000]; xs#1 = 1; n += xs#1 }; n'	3000
