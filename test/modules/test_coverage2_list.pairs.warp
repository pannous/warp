# coverage audit 2 (ranked 81-160): list helpers, edge cases
«use list; [lower_bound([1, 3, 3, 5], 3), lower_bound([1, 3, 5], 0), lower_bound([1, 3, 5], 9), lower_bound([], 1)] == [2, 1, 4, 1]»	true
«use list; [take_while([1, 2, 5, 1], x -> x < 3), take_while([], x -> true), take_while([9], x -> x < 3)] == [[1, 2], [], []]»	true
«use list; [median([3, 1, 2]), median([4, 1, 3, 2]) == 2.5, median([5])] == [2, true, 5]»	true
«use list; m = try { median([]) } catch e { "" + e }; m == "median of an empty list"»	true
«use list; [insert_sorted([1, 3], 2), insert_sorted([], 1), insert_sorted([1, 2, 2], 2), insert_sorted([1], 0)] == [[1, 2, 3], [1], [1, 2, 2, 2], [0, 1]]»	true
«use list; [quantile([1, 2, 3, 4], 0.25), quantile([5], 0.5)] == [1.75, 5]»	true
«use list; [intersection([1, 2, 3], [2, 3, 4]), intersection([], [1]), union([1, 2], [2, 3]), union([], [])] == [[2, 3], [], [1, 2, 3], []]»	true
«use list; fill(3, 0) == [0, 0, 0] and fill(0, 7) == []»	true
