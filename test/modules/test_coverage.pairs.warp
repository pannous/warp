// markup style-sheet ~ combinator edges; > and + covered in test/web/test_markup_style_child.pairs.warp (card lib-coverage-recent)
// lengths like 4px need units_shown in the compiler; these stay on color values so an older seed still runs them
'use markup; to_html(style{ a ~ b { color: red } })'	'<style>a ~ b { color: red }</style>'
'use markup; to_html(style{ a ~ b { color: red } .x { color: blue } })'	'<style>a ~ b { color: red } .x { color: blue }</style>'
'use markup; to_html(style{ .box { color: green } a ~ b { color: red } })'	'<style>.box { color: green } a ~ b { color: red }</style>'
'use markup; to_html(style{ div > p + span ~ em { color: red } })'	'<style>div > p + span ~ em { color: red }</style>'

// edges for temp_folder / delete_file beyond test_temp_files.pairs.warp (card lib-coverage-recent)
'use file; a = temp_folder(); b = temp_folder(); a == b'	yes
'use file; p = temp_folder() + "/warp_cov_recent_del.txt"; write(p, ""); [delete_file(p), delete_file(p)]'	[yes, no]
'use file; p = temp_folder() + "/warp_cov_recent_empty.txt"; write(p, ""); [exists(p), delete_file(p), exists(p)]'	[yes, yes, no]
'use file; p = temp_folder() + "/warp_cov_recent_bytes.bin"; write_bytes(p, [0, 255, 1]); r = read_bytes(p); delete_file(p); [r, exists(p)]'	[[0, 255, 1], no]
