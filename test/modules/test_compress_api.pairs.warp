// lib/compress.warp bytes/_text pairs (card lib-compress-api-polish): a _text sibling is the bytes form decoded as UTF-8
'use compress; decompress(compress("hello")) == to_utf8("hello")'	true
'use compress; from_utf8(decompress(compress("hello")))'	"hello"
'use compress; gunzip(gzip("hi")) == to_utf8("hi")'	true
'use compress; inflate(deflate("x")) == to_utf8("x")'	true
'use compress; from_utf8(inflate(deflate("x")))'	"x"
