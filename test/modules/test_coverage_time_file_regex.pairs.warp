# coverage audit (card lib-coverage-audit): lib/time, lib/file and lib/regex words that had no or few test lines; fixed dates, temp paths under /tmp

# day numbers since 1970-01-01; weekday_of_day is ISO (Monday 1 … Sunday 7): 1970-01-01 was a Thursday
«use time; [weekday_of_day(0), weekday_of_day(4), weekday_of_day(-1), weekday_of_day(days_from_date(2024, 2, 29)), days_from_date(1970, 1, 1), days_from_date(2000, 3, 1), days_from_date(1969, 12, 31)] == [4, 1, 3, 4, 0, 11017, -1]»	true
# the EU summer-time Sundays: last Sunday of March and October 2024 (the 31st and the 27th); the US ones: second Sunday of March (10th) and first of November (3rd)
«use time; [last_sunday(2024, 3) == days_from_date(2024, 3, 31), last_sunday(2024, 10) == days_from_date(2024, 10, 27), nth_sunday(2024, 3, 2) == days_from_date(2024, 3, 10), nth_sunday(2024, 11, 1) == days_from_date(2024, 11, 3), last_sunday(2023, 3) == days_from_date(2023, 3, 26)] == [yes, yes, yes, yes, yes]»	true
«use time; [year_of_seconds(0), year_of_seconds(1709251200), year_of_seconds(-1), year_of_seconds(951782400), date_of(0)] == [1970, 2024, 1969, 2000, {"year": 1970, "month": 1, "day": 1}]»	true
«use time; [is_leap_year(2024), is_leap_year(2023), is_leap_year(1900), is_leap_year(2000), is_leap_year(0), is_leap_year(-4), days_in_month(2024, 2), days_in_month(2023, 2), days_in_month(1900, 2), days_in_month(2000, 2), days_in_month(2024, 4), days_in_month(2024, 12), two_digits(5), two_digits(12), two_digits(0)] == [yes, no, no, yes, yes, yes, 29, 28, 28, 29, 30, 31, "05", "12", "00"]»	true
«use file; write_bytes("/tmp/warp_cov_bytes.bin", [0, 255, 65]); a = read_bytes("/tmp/warp_cov_bytes.bin"); write_bytes("/tmp/warp_cov_empty.bin", []); b = read_bytes("/tmp/warp_cov_empty.bin"); [a, b, exists("/tmp/warp_cov_bytes.bin"), exists("/tmp/warp_cov_missing_file.bin")] == [[0, 255, 65], [], yes, no]»	true
«use regex; [find_all("a1b22c333", "[0-9]+"), find_all("abc", "[0-9]"), find_all("", "x"), first_match("ab12cd", "[0-9]+"), first_match("abc", "[0-9]"), replace_all("a1b22", "[0-9]", "#"), "abc" matches "^a.c$"] == [["1", "22", "333"], [], [], "12", nil, "a#b##", yes]»	true
