# TOML 1.0: parse_toml and to_toml (lib/toml.warp, card lib-ini-toml); dates are {toml: kind, value: text}

«use toml; m = parse_toml("# This is a TOML document\\n\\ntitle = \\"TOML Example\\"\\n\\n[owner]\\nname = \\"Tom Preston-Werner\\"\\ndob = 1979-05-27T07:32:00-08:00\\n\\n[database]\\nenabled = true\\nports = [ 8000, 8001, 8002 ]\\ndata = [ [\\"delta\\", \\"phi\\"], [3.14] ]\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n\\n[servers]\\n\\n[servers.alpha]\\nip = \\"10.0.0.1\\"\\nrole = \\"frontend\\"\\n\\n[servers.beta]\\nip = \\"10.0.0.2\\"\\nrole = \\"backend\\"\\n"); [m["title"], m["owner"]["name"], m["database"]["enabled"], m["database"]["ports"]]»	["TOML Example", "Tom Preston-Werner", yes, [8000, 8001, 8002]]
«use toml; m = parse_toml("# This is a TOML document\\n\\ntitle = \\"TOML Example\\"\\n\\n[owner]\\nname = \\"Tom Preston-Werner\\"\\ndob = 1979-05-27T07:32:00-08:00\\n\\n[database]\\nenabled = true\\nports = [ 8000, 8001, 8002 ]\\ndata = [ [\\"delta\\", \\"phi\\"], [3.14] ]\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n\\n[servers]\\n\\n[servers.alpha]\\nip = \\"10.0.0.1\\"\\nrole = \\"frontend\\"\\n\\n[servers.beta]\\nip = \\"10.0.0.2\\"\\nrole = \\"backend\\"\\n"); [m["owner"]["dob"]["toml"], m["owner"]["dob"]["value"]]»	["offset-date-time", "1979-05-27T07:32:00-08:00"]
«use toml; m = parse_toml("# This is a TOML document\\n\\ntitle = \\"TOML Example\\"\\n\\n[owner]\\nname = \\"Tom Preston-Werner\\"\\ndob = 1979-05-27T07:32:00-08:00\\n\\n[database]\\nenabled = true\\nports = [ 8000, 8001, 8002 ]\\ndata = [ [\\"delta\\", \\"phi\\"], [3.14] ]\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n\\n[servers]\\n\\n[servers.alpha]\\nip = \\"10.0.0.1\\"\\nrole = \\"frontend\\"\\n\\n[servers.beta]\\nip = \\"10.0.0.2\\"\\nrole = \\"backend\\"\\n"); [m["database"]["data"], m["database"]["temp_targets"]["cpu"], m["servers"]["beta"]["role"], m["servers"].keys]»	[[["delta", "phi"], [3.14]], 79.5, "backend", ["alpha", "beta"]]
«use toml; m = parse_toml("# This is a TOML document\\n\\ntitle = \\"TOML Example\\"\\n\\n[owner]\\nname = \\"Tom Preston-Werner\\"\\ndob = 1979-05-27T07:32:00-08:00\\n\\n[database]\\nenabled = true\\nports = [ 8000, 8001, 8002 ]\\ndata = [ [\\"delta\\", \\"phi\\"], [3.14] ]\\ntemp_targets = { cpu = 79.5, case = 72.0 }\\n\\n[servers]\\n\\n[servers.alpha]\\nip = \\"10.0.0.1\\"\\nrole = \\"frontend\\"\\n\\n[servers.beta]\\nip = \\"10.0.0.2\\"\\nrole = \\"backend\\"\\n"); parse_toml(to_toml(m)) == m»	yes
«use toml; m = parse_toml("[[products]]\\nname = \\"Hammer\\"\\nsku = 738594937\\n\\n[[products]]  # empty table within the array\\n\\n[[products]]\\nname = \\"Nail\\"\\nsku = 284758393\\n\\ncolor = \\"gray\\"\\n"); [count(m["products"]), m["products"][1] == {}, m["products"][2]["color"], parse_toml(to_toml(m)) == m]»	[3, yes, "gray", yes]
«use toml; m = parse_toml("[[fruits]]\\nname = \\"apple\\"\\n\\n[fruits.physical]\\ncolor = \\"red\\"\\nshape = \\"round\\"\\n\\n[[fruits.varieties]]\\nname = \\"red delicious\\"\\n\\n[[fruits.varieties]]\\nname = \\"granny smith\\"\\n\\n[[fruits]]\\nname = \\"banana\\"\\n\\n[[fruits.varieties]]\\nname = \\"plantain\\"\\n"); [m["fruits"][0]["physical"]["shape"], count(m["fruits"][0]["varieties"]), m["fruits"][1]["varieties"][0]["name"], parse_toml(to_toml(m)) == m]»	["round", 2, "plantain", yes]
«use toml; m = parse_toml("s = \\"tab\\\\there \\\\u00e9 \\\\U0001F600 \\\\\\"q\\\\\\" \\\\\\\\ end\\""); m["s"]»	"tab\there é 😀 \"q\" \\ end"
«use toml; m = parse_toml("w = 'C:\\\\Users\\\\nodejs\\\\templates'"); m["w"]»	"C:\\Users\\nodejs\\templates"
«use toml; m = parse_toml("s = \\"\\"\\"\\nRoses are red\\nViolets are blue\\"\\"\\""); m["s"]»	"Roses are red\nViolets are blue"
«use toml; m = parse_toml("s = \\"\\"\\"\\nThe quick brown \\\\\\n\\n\\n  fox jumps over \\\\\\n    the lazy dog.\\"\\"\\""); m["s"]»	"The quick brown fox jumps over the lazy dog."
«use toml; m = parse_toml("s = \\"\\"\\"Here are fifteen quotation marks: \\"\\"\\\\\\"\\"\\"\\\\\\"\\"\\"\\\\\\"\\"\\"\\\\\\"\\"\\"\\\\\\".\\"\\"\\"\\nt = \\"\\"\\"\\"This,\\" she said, \\"is just a pointless statement.\\"\\"\\"\\""); [m["s"], m["t"]]»	["Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\".", "\"This,\" she said, \"is just a pointless statement.\""]
«use toml; m = parse_toml("re = '''I [dw]on't need \\\\d{2} apples'''\\nlines = '''\\nThe first newline is\\ntrimmed in raw strings.\\n'''\\nq = '''''Two quotes'''''"); [m["re"], m["lines"], m["q"]]»	["I [dw]on't need \\d{2} apples", "The first newline is\ntrimmed in raw strings.\n", "''Two quotes''"]
«use toml; m = parse_toml("a = [+99, 42, 0, -17, 1_000, 5_349_221, 53_49_221, 1_2_3_4_5]\\nb = [0xDEADBEEF, 0xdead_beef, 0o01234567, 0o755, 0b11010110]"); [m["a"], m["b"]]»	[[99, 42, 0, -17, 1000, 5349221, 5349221, 12345], [3735928559, 3735928559, 342391, 493, 214]]
«use toml; m = parse_toml("a = [+1.0, 3.1415, -0.01, 5e+22, 1e06, -2E-2, 6.626e-34, 224_617.445_991]"); [m["a"]#2, m["a"]#3, m["a"]#8, m["a"]#1 is int]»	[3.1415, -0.01, 224617.445991, no]
«use toml; m = parse_toml("i = inf\\nj = -inf\\nn = nan"); [m["i"] > 1e308, m["j"] < -1e308, ("" + m["n"]) == "NaN", to_toml(m)]»	[yes, yes, yes, "i = inf\nj = -inf\nn = nan\n"]
«use toml; m = parse_toml("f = 2.0\\ni = 2"); [to_toml(m), parse_toml(to_toml(m))["f"] is int]»	["f = 2.0\ni = 2\n", no]
«use toml; m = parse_toml("t = true\\nf = false"); [m["t"], m["f"]]»	[yes, no]
«use toml; m = parse_toml("odt1 = 1979-05-27T07:32:00Z\\nodt2 = 1979-05-27T00:32:00-07:00\\nodt3 = 1979-05-27 00:32:00.999999-07:00\\nldt = 1979-05-27T07:32:00\\nld = 1979-05-27\\nlt1 = 07:32:00\\nlt2 = 00:32:00.999999"); m.keys.map(k => m[k]["toml"])»	["offset-date-time", "offset-date-time", "offset-date-time", "local-date-time", "local-date", "local-time", "local-time"]
«use toml; m = parse_toml("odt3 = 1979-05-27 00:32:00.999999-07:00\\nld = 1979-05-27"); [m["odt3"]["value"], to_toml(m)]»	["1979-05-27T00:32:00.999999-07:00", "odt3 = 1979-05-27T00:32:00.999999-07:00\nld = 1979-05-27\n"]
«use toml; m = parse_toml("\\"127.0.0.1\\" = \\"v\\"\\n\\"character encoding\\" = \\"value\\"\\n'quoted \\"value\\"' = \\"value\\"\\nsite.\\"google.com\\" = true\\n3.14159 = \\"pi\\""); [m["127.0.0.1"], m["site"]["google.com"], m["3"]["14159"]]»	["v", yes, "pi"]
«use toml; m = parse_toml("fruit.apple.color = \\"red\\"\\nfruit.apple.taste.sweet = true\\n\\n[fruit.apple.texture]\\nsmooth = true"); [m["fruit"]["apple"]["taste"]["sweet"], m["fruit"]["apple"]["texture"]["smooth"]]»	[yes, yes]
«use toml; m = parse_toml("# [x] you\\n# [x.y] don't\\n# [x.y.z] need these\\n[x.y.z.w] # for this to work\\n\\n[x] # defining a super-table afterward is ok\\nq = 1"); [m["x"]["q"], m["x"]["y"]["z"]["w"] == {}]»	[1, yes]
«use toml; m = parse_toml("name = { first = \\"Tom\\", last = \\"Preston-Werner\\" }\\npoint = { x = 1, y = 2 }\\nanimal = { type.name = \\"pug\\" }\\nempty = {}"); [m["name"]["last"], m["point"]["y"], m["animal"]["type"]["name"], m["empty"] == {}]»	["Preston-Werner", 2, "pug", yes]
«use toml; m = parse_toml("integers = [ 1, 2, 3 ]\\nnested_mixed = [ [ 1, 2 ], [\\"a\\", \\"b\\", \\"c\\"] ]\\nmixed = [ 0.1, \\"x\\", 1 ]\\npoints = [ { x = 1, y = 2 },\\n           { x = 7, y = 8 }, ]\\nmulti = [\\n  1, # one\\n  2,\\n]"); [m["nested_mixed"]#2, m["points"]#2, m["multi"]]»	[["a", "b", "c"], {x: 7, y: 8}, [1, 2]]
«use toml; m = parse_toml("a = 1\\r\\nb = \\"x\\"\\r\\n"); [m["a"], m["b"]]»	[1, "x"]
«use toml; m = {name: "x", list: [1, 2.5, "q"], deep: {in: {k: yes}}, rows: [{a: 1}, {a: 2}], "odd key": "tab\there"}; parse_toml(to_toml(m)) == m»	yes
«use toml; (try { parse_toml("x = 1\\ny = 2\\nx = 3") } catch e { "" + e }) == "toml line 3: duplicate key x"»	yes
«use toml; (try { parse_toml("[t]\\nx = 1\\n\\n[t]") } catch e { "" + e }) == "toml line 4: duplicate table [t]"»	yes
«use toml; (try { parse_toml("[fruit]\\napple.color = \\"red\\"\\n\\n[fruit.apple]") } catch e { "" + e }) == "toml line 4: table [fruit.apple] redefines the dotted keys fruit.apple"»	yes
«use toml; (try { parse_toml("[fruit]\\napple = \\"red\\"\\n\\n[fruit.apple]") } catch e { "" + e }) == "toml line 4: table [fruit.apple] redefines the key fruit.apple"»	yes
«use toml; (try { parse_toml("[product]\\ntype = { name = \\"Nail\\" }\\ntype.edible = false") } catch e { "" + e }) == "toml line 3: key type.edible extends type, which is no table of dotted keys here"»	yes
«use toml; (try { parse_toml("fruits = []\\n\\n[[fruits]]") } catch e { "" + e }) == "toml line 3: [[fruits]] appends to fruits, which is no array of tables"»	yes
«use toml; (try { parse_toml("[[fruits]]\\nname = \\"apple\\"\\n[fruits]") } catch e { "" + e }) == "toml line 3: table [fruits] redefines the array of tables fruits"»	yes
«use toml; (try { parse_toml("s = \\"bad \\\\q escape\\"") } catch e { "" + e }) == "toml line 1: bad escape \\\\q"»	yes
«use toml; (try { parse_toml("\\n\\ns = \\"\\\\u00G1\\"") } catch e { "" + e }) == "toml line 3: bad unicode escape: 4 hex digits expected"»	yes
«use toml; (try { parse_toml("n = 017") } catch e { "" + e }) == "toml line 1: a leading zero in 017"»	yes
«use toml; (try { parse_toml("n = 1__000") } catch e { "" + e }) == "toml line 1: a misplaced _ in 1__000"»	yes
«use toml; (try { parse_toml("n = 3.") } catch e { "" + e }) == "toml line 1: no value 3."»	yes
«use toml; (try { parse_toml("k = 1 extra") } catch e { "" + e }) == "toml line 1: unexpected e after a value"»	yes
«use toml; (try { parse_toml("t = { x = 1, }") } catch e { "" + e }) == "toml line 1: a trailing comma in an inline table"»	yes
«use toml; (try { parse_toml("a = [1, 2\\nb = 3") } catch e { "" + e }) == "toml line 2: no , or ] in an array, but b"»	yes
«use toml; (try { parse_toml("d = 1979-13-27") } catch e { "" + e }) == "toml line 1: no such date 1979-13-27"»	yes
«use toml; (try { parse_toml("s = \\"open") } catch e { "" + e }) == "toml line 1: no closing \\" in a string"»	yes
«use toml; (try { parse_toml("= 1") } catch e { "" + e }) == "toml line 1: a key expected, not ="»	yes
