// lib/json_tools.warp json_validate: JSON Schema 2020-12 keywords, each error led by the JSON Pointer of its place (card lib-json-tools)
'use json_tools; json_validate(json(\'{"items": [{"name": "a"}, {"name": "b"}, {"name": 5}]}\'), json(\'{"properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/item"}}}, "$defs": {"item": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}, "additionalProperties": false}}}\'))'	["/items/2/name: expected string, got number"]
'use json_tools; json_validate(json(\'{"items": [{}, {"name": "b", "x": 1}]}\'), json(\'{"properties": {"items": {"items": {"$ref": "#/$defs/item"}}}, "$defs": {"item": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}, "additionalProperties": false}}}\'))'	["/items/0: missing required property name", "/items/1/x: additional property x is not allowed"]
'use json_tools; json_validate(json(\'{"a": 1, "b": "x"}\'), json(\'{"properties": {"a": {}}, "additionalProperties": {"type": "integer"}}\'))'	["/b: expected integer, got string"]
'use json_tools; json_validate(json(\'3\'), json(\'{"type": "integer"}\'))'	[]
'use json_tools; json_validate(json(\'3.0\'), json(\'{"type": "integer"}\'))'	[]
'use json_tools; json_validate(json(\'3.5\'), json(\'{"type": "integer"}\'))'	["(root): expected integer, got number"]
'use json_tools; json_validate(json(\'null\'), json(\'{"type": ["string", "null"]}\'))'	[]
'use json_tools; json_validate(json(\'true\'), json(\'{"type": ["string", "null"]}\'))'	["(root): expected string or null, got boolean"]
'use json_tools; json_validate(json(\'"b"\'), json(\'{"enum": ["a", 1, null]}\'))'	["(root): \"b\" is not one of [\"a\",1,null]"]
'use json_tools; json_validate(json(\'true\'), json(\'{"const": 1}\'))'	["(root): expected 1"]
'use json_tools; json_validate(json(\'{"x": [1]}\'), json(\'{"const": {"x": [1.0]}}\'))'	[]
'use json_tools; json_validate(json(\'[1, "a"]\'), json(\'{"prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false}\'))'	["/1: expected integer, got string"]
'use json_tools; json_validate(json(\'[1, 2, 3]\'), json(\'{"prefixItems": [{}], "items": false}\'))'	["/1: no value is allowed here", "/2: no value is allowed here"]
'use json_tools; json_validate(json(\'[1, 2, 1]\'), json(\'{"minItems": 4, "maxItems": 2, "uniqueItems": true}\'))'	["(root): fewer than 4 items", "(root): more than 2 items", "(root): items 0 and 2 are equal"]
'use json_tools; json_validate(json(\'"héllo"\'), json(\'{"minLength": 6, "maxLength": 5}\'))'	["(root): shorter than 6 characters"]
'use json_tools; json_validate(json(\'"abc1"\'), json(\'{"pattern": "^[a-z]+$"}\'))'	["(root): does not match the pattern ^[a-z]+$"]
'use json_tools; json_validate(json(\'"xabcx"\'), json(\'{"pattern": "abc"}\'))'	[]
'use json_tools; json_validate(json(\'10\'), json(\'{"minimum": 11, "maximum": 5, "exclusiveMinimum": 10, "exclusiveMaximum": 10, "multipleOf": 3}\'))'	["(root): 10 is less than the minimum 11", "(root): 10 is more than the maximum 5", "(root): 10 is not more than 10", "(root): 10 is not less than 10", "(root): 10 is not a multiple of 3"]
'use json_tools; json_validate(json(\'0.3\'), json(\'{"multipleOf": 0.1}\'))'	[]
'use json_tools; json_validate(json(\'5\'), json(\'{"allOf": [{"minimum": 6}, {"maximum": 4}]}\'))'	["(root): 5 is less than the minimum 6", "(root): 5 is more than the maximum 4"]
'use json_tools; json_validate(json(\'5\'), json(\'{"anyOf": [{"type": "string"}, {"minimum": 6}]}\'))'	["(root): matches none of anyOf"]
'use json_tools; json_validate(json(\'5\'), json(\'{"oneOf": [{"type": "integer"}, {"minimum": 1}]}\'))'	["(root): matches 2 of oneOf, not exactly 1"]
'use json_tools; json_validate(json(\'5\'), json(\'{"oneOf": [{"type": "integer"}, {"minimum": 9}]}\'))'	[]
'use json_tools; json_validate(json(\'"x"\'), json(\'{"not": {"type": "string"}}\'))'	["(root): must not match the not schema"]
'use json_tools; json_validate(json(\'{"next": {"next": {"next": 3}}}\'), json(\'{"$defs": {"node": {"type": "object", "properties": {"next": {"anyOf": [{"$ref": "#/$defs/node"}, {"type": "null"}]}}}}, "$ref": "#/$defs/node"}\'))'	["/next: matches none of anyOf"]
'use json_tools; json_validate(json(\'1\'), json(\'true\'))'	[]
'use json_tools; json_validate(json(\'1\'), json(\'false\'))'	["(root): no value is allowed here"]
'use json_tools; json_valid(json(\'{}\'), json(\'{"required": ["a"]}\'))'	false
