# GFM tables and strikethrough

# Raw HTML is passed through (spec 613, 614, 627, GFM table HTML)
«use markdown; [markdown_html("<a><bab><c2c>\\n"), markdown_html("<a/><b2/>\\n"), markdown_html("foo <?php echo $a; ?>\\n"), markdown_html("| a |\\n| --- |\\n| <strong>hello</strong> |\\n| ok <br> sure |\\n")] == ["<p><a><bab><c2c></p>\n", "<p><a/><b2/></p>\n", "<p>foo <?php echo $a; ?></p>\n", "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>hello</strong></td>\n</tr>\n<tr>\n<td>ok <br> sure</td>\n</tr>\n</tbody>\n</table>\n"]»	true
