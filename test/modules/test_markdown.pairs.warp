«use markdown; [markdown_html("[link [bar](/uri)\\n"), markdown_html("[link \\\\[bar](/uri)\\n"), markdown_html("[link *foo **bar** `#`*](/uri)\\n"), markdown_html("[![moon](moon.jpg)](/uri)\\n"), markdown_html("[foo [bar](/uri)](/uri)\\n"), markdown_html("[foo *[bar [baz](/uri)](/uri)*](/uri)\\n"), markdown_html("![[[foo](uri1)](uri2)](uri3)\\n"), markdown_html("*[foo*](/uri)\\n"), markdown_html("[foo *bar](baz*)\\n"), markdown_html("*foo [bar* baz]\\n"), markdown_html("[foo`](/uri)`\\n"), markdown_html("[foo<https://example.com/?search=](uri)>\\n"), markdown_html("[foo][bar]\\n\\n[bar]: /url \\"title\\"\\n"), markdown_html("[link [foo [bar]]][ref]\\n\\n[ref]: /uri\\n"), markdown_html("[link \\\\[bar][ref]\\n\\n[ref]: /uri\\n")] == ["<p>[link <a href=\\"/uri\\">bar</a></p>\\n", "<p><a href=\\"/uri\\">link [bar</a></p>\\n", "<p><a href=\\"/uri\\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\\n", "<p><a href=\\"/uri\\"><img src=\\"moon.jpg\\" alt=\\"moon\\" /></a></p>\\n", "<p>[foo <a href=\\"/uri\\">bar</a>](/uri)</p>\\n", "<p>[foo <em>[bar <a href=\\"/uri\\">baz</a>](/uri)</em>](/uri)</p>\\n", "<p><img src=\\"uri3\\" alt=\\"[foo](uri2)\\" /></p>\\n", "<p>*<a href=\\"/uri\\">foo*</a></p>\\n", "<p><a href=\\"baz*\\">foo *bar</a></p>\\n", "<p><em>foo [bar</em> baz]</p>\\n", "<p>[foo<code>](/uri)</code></p>\\n", "<p>[foo<a href=\\"https://example.com/?search=%5D(uri)\\">https://example.com/?search=](uri)</a></p>\\n", "<p><a href=\\"/url\\" title=\\"title\\">foo</a></p>\\n", "<p><a href=\\"/uri\\">link [foo [bar]]</a></p>\\n", "<p><a href=\\"/uri\\">link [bar</a></p>\\n"]»	true

