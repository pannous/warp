# Backslash escapes: examples 12,14,15,16,17,18,19,20,22,23,24
«use markdown; [markdown_html("\\\\!\\\\\\"\\\\#\\\\$\\\\%\\\\&\\\\'\\\\(\\\\)\\\\*\\\\+\\\\,\\\\-\\\\.\\\\/\\\\:\\\\;\\\\<\\\\=\\\\>\\\\?\\\\@\\\\[\\\\\\\\\\\\]\\\\^\\\\_\\\\`\\\\{\\\\|\\\\}\\\\~\\n"), markdown_html("\\\\*not emphasized*\\n\\\\<br/> not a tag\\n\\\\[not a link](/foo)\\n\\\\`not code`\\n1\\\\. not a list\\n\\\\* not a list\\n\\\\# not a heading\\n\\\\[foo]: /url \\"not a reference\\"\\n\\\\&ouml; not a character entity\\n"), markdown_html("\\\\\\\\*emphasis*\\n"), markdown_html("foo\\\\\\nbar\\n"), markdown_html("`` \\\\[\\\\` ``\\n"), markdown_html("    \\\\[\\\\]\\n"), markdown_html("~~~\\n\\\\[\\\\]\\n~~~\\n"), markdown_html("<https://example.com?find=\\\\*>\\n"), markdown_html("[foo](/bar\\\\* \\"ti\\\\*tle\\")\\n"), markdown_html("[foo]\\n\\n[foo]: /bar\\\\* \\"ti\\\\*tle\\"\\n"), markdown_html("``` foo\\\\+bar\\nfoo\\n```\\n")] == ["<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\\\]^_`{|}~</p>\\n", "<p>*not emphasized*\\n&lt;br/&gt; not a tag\\n[not a link](/foo)\\n`not code`\\n1. not a list\\n* not a list\\n# not a heading\\n[foo]: /url &quot;not a reference&quot;\\n&amp;ouml; not a character entity</p>\\n", "<p>\\\\<em>emphasis</em></p>\\n", "<p>foo<br />\\nbar</p>\\n", "<p><code>\\\\[\\\\`</code></p>\\n", "<pre><code>\\\\[\\\\]\\n</code></pre>\\n", "<pre><code>\\\\[\\\\]\\n</code></pre>\\n", "<p><a href=\\"https://example.com?find=%5C*\\">https://example.com?find=\\\\*</a></p>\\n", "<p><a href=\\"/bar*\\" title=\\"ti*tle\\">foo</a></p>\\n", "<p><a href=\\"/bar*\\" title=\\"ti*tle\\">foo</a></p>\\n", "<pre><code class=\\"language-foo+bar\\">foo\\n</code></pre>\\n"]»	true

