«use markdown; [markdown_html("[link](/uri \\"title\\")\\n"), markdown_html("[link](/uri)\\n"), markdown_html("[](./target.md)\\n"), markdown_html("[link]()\\n"), markdown_html("[link](<>)\\n"), markdown_html("[]()\\n"), markdown_html("[link](/my uri)\\n"), markdown_html("[link](</my uri>)\\n"), markdown_html("[link](foo\\nbar)\\n"), markdown_html("[a](<b)c>)\\n"), markdown_html("[link](<foo\\\\>)\\n"), markdown_html("[link](\\\\(foo\\\\))\\n"), markdown_html("[link](foo(and(bar)))\\n"), markdown_html("[link](foo(and(bar))\\n"), markdown_html("[link](foo\\\\(and\\\\(bar\\\\))\\n")] == ["<p><a href=\\"/uri\\" title=\\"title\\">link</a></p>\\n", "<p><a href=\\"/uri\\">link</a></p>\\n", "<p><a href=\\"./target.md\\"></a></p>\\n", "<p><a href=\\"\\">link</a></p>\\n", "<p><a href=\\"\\">link</a></p>\\n", "<p><a href=\\"\\"></a></p>\\n", "<p>[link](/my uri)</p>\\n", "<p><a href=\\"/my%20uri\\">link</a></p>\\n", "<p>[link](foo\\nbar)</p>\\n", "<p><a href=\\"b)c\\">a</a></p>\\n", "<p>[link](&lt;foo&gt;)</p>\\n", "<p><a href=\\"(foo)\\">link</a></p>\\n", "<p><a href=\\"foo(and(bar))\\">link</a></p>\\n", "<p>[link](foo(and(bar))</p>\\n", "<p><a href=\\"foo(and(bar)\\">link</a></p>\\n"]»	true

