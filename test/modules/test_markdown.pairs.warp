«use markdown; [markdown_html("<http://foo.bar.baz>\\n"), markdown_html("<https://foo.bar.baz/test?q=hello&id=22&boolean>\\n"), markdown_html("<irc://foo.bar:2233/baz>\\n"), markdown_html("<MAILTO:FOO@BAR.BAZ>\\n"), markdown_html("<a+b+c:d>\\n"), markdown_html("<made-up-scheme://foo,bar>\\n"), markdown_html("<https://../>\\n"), markdown_html("<localhost:5001/foo>\\n"), markdown_html("<https://foo.bar/baz bim>\\n"), markdown_html("<https://example.com/\\\\[\\\\>\\n"), markdown_html("<foo@bar.example.com>\\n"), markdown_html("<foo+special@Bar.baz-bar0.com>\\n"), markdown_html("<foo\\\\+@bar.example.com>\\n"), markdown_html("<>\\n"), markdown_html("< https://foo.bar >\\n")] == ["<p><a href=\\"http://foo.bar.baz\\">http://foo.bar.baz</a></p>\\n", "<p><a href=\\"https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\\">https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a></p>\\n", "<p><a href=\\"irc://foo.bar:2233/baz\\">irc://foo.bar:2233/baz</a></p>\\n", "<p><a href=\\"MAILTO:FOO@BAR.BAZ\\">MAILTO:FOO@BAR.BAZ</a></p>\\n", "<p><a href=\\"a+b+c:d\\">a+b+c:d</a></p>\\n", "<p><a href=\\"made-up-scheme://foo,bar\\">made-up-scheme://foo,bar</a></p>\\n", "<p><a href=\\"https://../\\">https://../</a></p>\\n", "<p><a href=\\"localhost:5001/foo\\">localhost:5001/foo</a></p>\\n", "<p>&lt;https://foo.bar/baz bim&gt;</p>\\n", "<p><a href=\\"https://example.com/%5C%5B%5C\\">https://example.com/\\\\[\\\\</a></p>\\n", "<p><a href=\\"mailto:foo@bar.example.com\\">foo@bar.example.com</a></p>\\n", "<p><a href=\\"mailto:foo+special@Bar.baz-bar0.com\\">foo+special@Bar.baz-bar0.com</a></p>\\n", "<p>&lt;foo+@bar.example.com&gt;</p>\\n", "<p>&lt;&gt;</p>\\n", "<p>&lt; https://foo.bar &gt;</p>\\n"]»	true

