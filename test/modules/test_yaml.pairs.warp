# YAML: parse_yaml, parse_yaml_all, to_yaml (lib/yaml.warp, card lib-yaml); YAML 1.2 spec examples by number

«use yaml; d = parse_yaml_all("american:\\n  - Boston Red Sox\\n  - Detroit Tigers\\n  - New York Yankees\\nnational:\\n  - New York Mets\\n  - Chicago Cubs\\n  - Atlanta Braves\\n"); d == [{american: ["Boston Red Sox", "Detroit Tigers", "New York Yankees"], national: ["New York Mets", "Chicago Cubs", "Atlanta Braves"]}]»	yes
«use yaml; d = parse_yaml_all("-\\n  name: Mark McGwire\\n  hr:   65\\n  avg:  0.278\\n-\\n  name: Sammy Sosa\\n  hr:   63\\n  avg:  0.288\\n"); d#1 == [{name: "Mark McGwire", hr: 65, avg: 0.278}, {name: "Sammy Sosa", hr: 63, avg: 0.288}]»	yes
«use yaml; d = parse_yaml_all("- [name        , hr, avg  ]\\n- [Mark McGwire, 65, 0.278]\\n- [Sammy Sosa  , 63, 0.288]\\n"); d#1 == [["name", "hr", "avg"], ["Mark McGwire", 65, 0.278], ["Sammy Sosa", 63, 0.288]]»	yes
«use yaml; d = parse_yaml_all("Mark McGwire: {hr: 65, avg: 0.278}\\nSammy Sosa: {\\n    hr: 63,\\n    avg: 0.288\\n  }\\n"); d#1 == {"Mark McGwire": {hr: 65, avg: 0.278}, "Sammy Sosa": {hr: 63, avg: 0.288}}»	yes
«use yaml; d = parse_yaml_all("# Ranking of 1998 home runs\\n---\\n- Mark McGwire\\n- Sammy Sosa\\n- Ken Griffey\\n\\n# Team ranking\\n---\\n- Chicago Cubs\\n- St Louis Cardinals\\n"); d == [["Mark McGwire", "Sammy Sosa", "Ken Griffey"], ["Chicago Cubs", "St Louis Cardinals"]]»	yes
«use yaml; d = parse_yaml_all("---\\nhr:\\n  - Mark McGwire\\n  # Following node labeled SS\\n  - &SS Sammy Sosa\\nrbi:\\n  - *SS # Subsequent occurrence\\n  - Ken Griffey\\n"); d#1 == {hr: ["Mark McGwire", "Sammy Sosa"], rbi: ["Sammy Sosa", "Ken Griffey"]}»	yes
«use yaml; d = parse_yaml_all("---\\n# Products purchased\\n- item    : Super Hoop\\n  quantity: 1\\n- item    : Basketball\\n  quantity: 4\\n- item    : Big Shoes\\n  quantity: 1\\n"); [count(d#1), (d#1)#3, ((d#1)#2)["quantity"]]»	[3, {item: "Big Shoes", quantity: 1}, 4]
«use yaml; d = parse_yaml_all("# ASCII Art\\n--- |\\n  \\\\//||\\\\/||\\n  // ||  ||__\\n"); d#1 == "\\\\//||\\\\/||\\n// ||  ||__\\n"»	yes
«use yaml; d = parse_yaml_all("--- >\\n  Mark McGwire's\\n  year was crippled\\n  by a knee injury.\\n"); d#1»	"Mark McGwire's year was crippled by a knee injury.\n"
«use yaml; d = parse_yaml_all("name: Mark McGwire\\naccomplishment: >\\n  Mark set a major league\\n  home run record in 1998.\\nstats: |\\n  65 Home Runs\\n  0.278 Batting Average\\n"); [(d#1)["accomplishment"], (d#1)["stats"]]»	["Mark set a major league home run record in 1998.\n", "65 Home Runs\n0.278 Batting Average\n"]
«use yaml; d = parse_yaml_all("unicode: \\"Sosa did fine.\\\\u263A\\"\\ncontrol: \\"\\\\b1998\\\\t1999\\\\t2000\\\\n\\"\\nhex esc: \\"\\\\x0d\\\\x0a is \\\\r\\\\n\\"\\n\\nsingle: '\\"Howdy!\\" he cried.'\\nquoted: ' # Not a ''comment''.'\\ntie-fighter: '|\\\\-*-/|'\\n"); m = d#1; [m["unicode"] == "Sosa did fine." + chr(0x263A), m["control"] == chr(8) + "1998\\t1999\\t2000\\n", m["hex esc"] == chr(13) + "\\n is " + chr(13) + "\\n", m["single"], m["quoted"], m["tie-fighter"]]»	[yes, yes, yes, "\"Howdy!\" he cried.", " # Not a 'comment'.", "|\\-*-/|"]
«use yaml; d = parse_yaml_all("plain:\\n  This unquoted scalar\\n  spans many lines.\\n\\nquoted: \\"So does this\\n  quoted scalar.\\\\n\\"\\n"); d#1 == {plain: "This unquoted scalar spans many lines.", quoted: "So does this quoted scalar.\\n"}»	yes
«use yaml; d = parse_yaml_all("canonical: 12345\\ndecimal: +12345\\noctal: 0o14\\nhexadecimal: 0xC\\n"); d#1»	{canonical: 12345, decimal: 12345, octal: 12, hexadecimal: 12}
«use yaml; d = parse_yaml_all("canonical: 1.23015e+3\\nexponential: 12.3015e+02\\nfixed: 1230.15\\nnegative infinity: -.inf\\nnot a number: .nan\\n"); m = d#1; [m["canonical"], m["exponential"], m["fixed"], m["negative infinity"] < -1e308, "" + m["not a number"], m["fixed"] is int]»	[1230.15, 1230.15, 1230.15, yes, "NaN", no]
«use yaml; d = parse_yaml_all("null:\\nbooleans: [ true, false ]\\nstring: '012345'\\n"); d#1 == {null: ø, booleans: [yes, no], string: "012345"}»	yes
«use yaml; d = parse_yaml_all("- &CENTER { x: 1, y: 2 }\\n- &BIG { r: 10 }\\n- # Merge one map\\n  << : *CENTER\\n  r: 10\\n  label: center/big\\n- # Override\\n  << : [ *BIG, *CENTER ]\\n  x: 1\\n  label: big\\n"); m = d#1; [m#3, m#4]»	[{r: 10, label: "center/big", x: 1, y: 2}, {x: 1, label: "big", r: 10, y: 2}]
«use yaml; d = parse_yaml_all("strip: |-\\n  text\\nclip: |\\n  text\\nkeep: |+\\n  text\\n\\nlast: >2\\n   indented\\n  normal\\n"); d#1 == {strip: "text", clip: "text\\n", keep: "text\\n\\n", last: " indented\\nnormal\\n"}»	yes
«use yaml; d = parse_yaml_all("a: 1\\n...\\n---\\nb: 2\\n"); d»	[{a: 1}, {b: 2}]

# scalars, nesting, flow over lines, one document
«use yaml; parse_yaml("[~, null, '', true, False, 0x1F, 0o17, -12, +3, 1.5, .5, 1e3, 1_000, 2001-12-14, 'true', \\"5\\", yes, a b]")»	[ø, ø, "", yes, no, 31, 15, -12, 3, 1.5, 0.5, 1000, "1_000", "2001-12-14", "true", "5", "yes", "a b"]
«use yaml; parse_yaml("a: 1\\nb:\\n  c: [1, 2, {x: y}]\\n  d:\\n  - p\\n  - q: 1\\n    r: 2\\ne: {\\n  f: [\\n    1,\\n    2,\\n  ],\\n}\\ng: plain # comment\\n")»	{a: 1, b: {c: [1, 2, {x: "y"}], d: ["p", {q: 1, r: 2}]}, e: {f: [1, 2]}, g: "plain"}
«use yaml; [parse_yaml(""), parse_yaml("# only a comment\\n"), parse_yaml("--- 42"), parse_yaml_all("---\\n---\\nx\\n"), parse_yaml("- - a\\n  - b\\n- c")]»	[ø, ø, 42, [ø, "x"], [["a", "b"], "c"]]
«use yaml; parse_yaml("a: 1\\r\\nb: [2]\\r\\n")»	{a: 1, b: [2]}

# to_yaml: block style, quoting only where needed, read back equal
«use yaml; to_yaml({name: "demo", n: 1, list: [1, "two", [3, 4], {k: "v"}], empty: [], none: {}, z: ø})»	"name: demo\nn: 1\nlist:\n  - 1\n  - two\n  - - 3\n    - 4\n  - k: v\nempty: []\nnone: {}\nz: null\n"
«use yaml; to_yaml({a: "true", b: "123", c: "", d: "a: b", e: "-x", f: "x #y", g: "~", h: " pad", i: "two\\nlines", j: "it's fine"})»	"a: \"true\"\nb: \"123\"\nc: \"\"\nd: \"a: b\"\ne: \"-x\"\nf: \"x #y\"\ng: \"~\"\nh: \" pad\"\ni: \"two\\nlines\"\nj: it's fine\n"
«use yaml; i = float("1e308") * 10.0; v = {name: "demo", "key: odd": "x", f: 2.5, t: yes, z: ø, e: "", s: "true", multi: "a\\nb\\ttab", q: "it's \\"q\\"", list: [1, "two", [3, [4]], {k: "v", k2: [5]}], empty: [], none: {}, deep: {a: {b: {c: "-dash"}}}, inf: i, ninf: 0.0 - i, dots: "...", u: "é😀"}; parse_yaml(to_yaml(v)) == v»	yes
«use yaml; v = [1, [2, [3]], {a: [{b: 1}]}, "x"]; parse_yaml(to_yaml(v)) == v»	yes
«use yaml; [to_yaml(2.0 * 1.5), to_yaml(float("2")), to_yaml("x"), to_yaml(ø)]»	["3\n", "2.0\n", "x\n", "null\n"]

# errors name the line
«use yaml; attempt(t) := try { parse_yaml(t) } catch e { "" + e }; [attempt("a: 1\\nb:\\n\\tc: 2"), attempt("a: 1\\na: 2"), attempt("x: 1\\ny: [*nope]"), attempt("a: [1, 2\\nb: 3"), attempt("a: {b: 1"), attempt("a: 'x"), attempt("a: !!str x"), attempt("? complex\\n: v"), attempt("%YAML 1.2\\n---\\na: 1"), attempt("a:\\n  b: 1\\n c: 2"), attempt("- a\\nb: 1"), attempt("a: 1\\n- b"), attempt("\\n\\na: \\"\\\\q\\""), attempt("x: 1\\n---\\ny: 2"), attempt("a: [1] junk"), attempt("k: v\\n- a\\n  - b"), attempt("{a: 1, a: 2}")] == ["yaml line 3: a tab used as indentation", "yaml line 2: duplicate key a.", "yaml line 2: undefined alias *nope", "yaml line 2: no , or ] in a flow sequence", "yaml line 1: an unclosed {", "yaml line 1: an unclosed '", "yaml line 1: tags (!…) are not supported", "yaml line 1: complex keys (? …) are not supported", "yaml line 1: directives (%…) are not supported", "yaml line 3: bad indentation of a mapping entry", "yaml line 2: bad indentation: a mapping key among sequence entries", "yaml line 2: bad indentation: a sequence entry among mapping keys", "yaml line 3: bad escape \\\\q", "yaml: 2 documents in one text: parse_yaml_all reads them all", "yaml line 1: unexpected junk after a value", "yaml line 2: bad indentation: a sequence entry among mapping keys", "yaml line 1: duplicate key a."]»	yes
