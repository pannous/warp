// lib/cli.warp choices and commands: warp's own messages and help texts (card lib-cli-args-2)
'use cli; try { parse_args([{name: "mode", choices: ["a", "b"]}], ["--mode=c"])["help"] } catch e { e.message }'	"cli: --mode is one of a, b, not c"
'use cli; try { parse_args([{name: "n", kind: "int", choices: [1, 2]}], ["--n", "3"])["help"] } catch e { e.message }'	"cli: --n is one of 1, 2, not 3"
'use cli; try { parse_args([{name: "where", positional: yes, choices: ["up", "down"]}], ["left"])["help"] } catch e { e.message }'	"cli: where is one of up, down, not left"
'use cli; parse_args([{name: "mode", choices: ["a", "b"], default: "a"}], [])'	{help: no, mode: "a"}
'use cli; try { parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, [])["help"] } catch e { e.message }'	"cli: missing command (add, list)"
'use cli; try { parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, ["zap"])["help"] } catch e { e.message }'	"cli: unknown command zap (add, list)"
'use cli; try { parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, ["add", "-p", "mid"])["help"] } catch e { e.message }'	"cli: --priority is one of low, high, not mid"
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, ["-h", "add"])'	{help: yes, verbose: no, command: ø}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, ["add", "--help"])'	{help: yes, verbose: no, command: "add", priority: "low", title: []}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, ["list"])'	{help: no, verbose: no, command: "list", sort: "id"}
'use cli; cli_help("x", [{name: "mode", short: "m", choices: ["a", "b"], help: "how"}, {name: "where", positional: yes, choices: ["up", "down"]}])'	"usage: x [-h] [--mode {a,b}] {up,down}\n\npositional arguments:\n  where\n\noptions:\n  -h, --help            show this help\n  -m, --mode {a,b}      how"
'use cli; cli_commands_help("todo", [{name: "verbose", short: "v", kind: "flag", help: "talk more"}], {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]})'	"usage: todo [-h] [--verbose] {add,list} ...\n\ncommands:\n  add                   add a todo\n  list\n\noptions:\n  -h, --help            show this help\n  -v, --verbose, --no-verbose\n                        talk more"
'use cli; cli_command_text("todo", {add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]}, list: [{name: "sort", choices: ["id", "title"], positional: yes, default: "id"}]}, "add")'	"usage: todo add [-h] [--priority {low,high}] [title ...]\n\npositional arguments:\n  title\n\noptions:\n  -h, --help            show this help\n  -p, --priority {low,high}\n                        (default low)"
