// card lib-path-file-conformance: path and file words against python's posixpath, pathlib and os
# path_dot_names_have_no_extension
'use path; [extension(".."), stem(".."), extension("a/.."), extension("a.tar.gz"), stem(".bashrc")]'	["", "..", "", ".gz", ".bashrc"]
# file_exists_of_empty_path
'use file; exists("")'	no
# file_append_and_glob_without_host_words
'use file; d = "/tmp/warp-pathfile-test"; write(d + "/a.txt", "a"); write(d + "/b.txt", "b"); write(d + "/.c.txt", "c"); append_file(d + "/a.txt", "z"); [read(d + "/a.txt"), glob(d + "/*.txt")]'	["az", ["/tmp/warp-pathfile-test/a.txt", "/tmp/warp-pathfile-test/b.txt"]]

// card test-failure-triage (Supervisor's decision): a dot ending a name starts no extension, as pathlib has it
# path_trailing_dot_no_extension
'use path; [extension("a."), stem("a."), extension("dir/b.."), stem("dir/b.."), extension("a.b"), stem("a.b")]'	["", "a.", "", "b..", ".b", "a"]

# a file used by its path defines its words: its mix is no implicit use of sound's (card path-used-shadows)
'use "own_mix.warp"; mix(1, 3, 0.5)'	2
