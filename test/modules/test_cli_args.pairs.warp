// lib/cli.warp parse_args against python's argparse (card lib-cli-args): each expected value is what argparse.parse_args
// gives on the same argv (test/cli/gen_cli_args_tests.py runs python3 argparse, allow_abbrev=False, BooleanOptionalAction, append, nargs=*).
// Where both refuse, warp's message is its own (cli: …), argparse's is not compared. Intentional differences:
// positionals may come between options in warp (argparse refuses a b split by an option: parse_intermixed_args
// accepts it), so that case's value is warp's own, marked below
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out", "x"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-v"])'	{help: no, verbose: yes, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--verbose", "--no-verbose"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-vq"])'	{help: no, verbose: yes, quiet: yes, count: 1, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-n", "3"])'	{help: no, verbose: no, quiet: no, count: 3, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-n3"])'	{help: no, verbose: no, quiet: no, count: 3, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-vn3"])'	{help: no, verbose: yes, quiet: no, count: 3, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-vn", "4"])'	{help: no, verbose: yes, quiet: no, count: 4, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--count=12"])'	{help: no, verbose: no, quiet: no, count: 12, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--count", "-5"])'	{help: no, verbose: no, quiet: no, count: -5, ratio: 0.5, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-r", "2.25"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 2.25, tag: [], out: "x", files: []}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-t", "a", "--tag=b", "-tc"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: ["a", "b", "c"], out: "x", files: []}
// intentional difference: argparse.parse_args refuses this, parse_intermixed_args gives:
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["a", "--out=x", "b"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: ["a", "b"]}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--", "-v", "--count=2"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: ["-v", "--count=2"]}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "x", files: ["-"]}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=", "a"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "", files: ["a"]}
'use cli; parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--out=y"])'	{help: no, verbose: no, quiet: no, count: 1, ratio: 0.5, tag: [], out: "y", files: []}
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--zz"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], [])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-n", "x"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--verbose=1"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "-k"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--no-out"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--verb"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_args([{name: "verbose", short: "v", kind: "flag"}, {name: "quiet", short: "q", kind: "flag"}, {name: "count", short: "n", kind: "int", default: 1}, {name: "ratio", short: "r", kind: "float", default: 0.5}, {name: "tag", short: "t", many: yes}, {name: "out", required: yes}, {name: "files", positional: yes, many: yes}], ["--out=x", "--count"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
