# a color written as its number (decision rgb-color-literal): six hex digits are opaque, eight carry their own alpha
'use color; hex_text(color(0xFF8000))'	'#FF8000'
'use color; hex_text(rgb(0xFF8000))'	'#FF8000'
'use color; hex_text(color(0x80FF8000))'	'#80FF8000'
'use color; color(0xFFD700) == yellow'	yes
