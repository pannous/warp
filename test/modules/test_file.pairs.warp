// lib/file's file_lines(path) splits the file's text on "\n" (card lib-file-lines); the deprecated alias lines(path) is shadowed by the prelude's lines(t) for a text path, see FILE_LINES.md
'use file; p = temp_folder() + "/warp_fl_1.txt"; write(p, "a\nb\nc"); r = file_lines(p); delete_file(p); r'	["a", "b", "c"]

# files named by path literals, unquoted (decision path-literals-preferred, card file-literal-replace)
'use file; write ./warp_fpl_shopping.txt "milk"; t = read(./warp_fpl_shopping.txt); delete_file(./warp_fpl_shopping.txt); t'	"milk"
'use file; write(/tmp/warp_fpl_list.txt, "tea"); t = read(/tmp/warp_fpl_list.txt); delete_file(/tmp/warp_fpl_list.txt); t'	"tea"
'use file; write ./warp_fpl_seen.txt "x"; seen = exists ./warp_fpl_seen.txt; delete_file(./warp_fpl_seen.txt); [seen, exists ./warp_fpl_seen.txt]'	[yes, no]

# lib/file.warp's prelude words (P171) need no `use file`: they are marked global there
# native only: /etc/hosts, a system file the browser has not
'exists("/etc/hosts")'	yes
'exists("/no/such/warp/file")'	no

# A path through a link to an absolute path (a repo's data -> /Volumes/…) reaches the file as the shell does (card
# programs-read); the link made in /tmp, leading to /

# reading_through_an_absolute_link — native only: os.command, a shell the browser has not
'use file; use os; link = "/tmp/warp_root_link_read"; command("ln -sfn / " + link); [count(read(link + "/etc/hosts")) > 0, exists(link + "/etc/hosts"), list_files(link + "/etc").contains("hosts")]'	[yes yes yes]

# writing_through_an_absolute_link — native only: os.command, a shell the browser has not
'use file; use os; link = "/tmp/warp_root_link_written"; command("ln -sfn / " + link); write(link + "/tmp/warp_linked_write.txt", "ok"); read("/tmp/warp_linked_write.txt")'	'ok'

// Source: wiki/script.md; home expansion preserves non-home paths and non-text values.
'use file; home_expanded("relative.txt")'	"relative.txt"
'use file; home_expanded(42)'	42
