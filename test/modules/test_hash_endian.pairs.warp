# hash endian helpers via bits (card lib-hash-endian-via-bits)
'use hash; use bits; little_endian(258, 2) == int_bytes(258, 16, "little")'	yes
'use hash; use bits; big_endian(258, 2) == int_bytes(258, 16, "big")'	yes
'use hash; from_little_endian(little_endian(0x12345678, 4))'	305419896
'use hash; from_big_endian(big_endian(0x12345678, 4))'	305419896
'use hash; use bits; from_big_endian([1, 2]) == bytes_int([1, 2], "big")'	yes
