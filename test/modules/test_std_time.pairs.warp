# from test_std_time.rs: edit the Rust test, then run the script again

# dates_of_milliseconds
'use time; d = date_of(0); [d.year, d.month, d.day]'	[1970 1 1]
'use time; d = date_of(951782400000); [d.year, d.month, d.day]'	[2000 2 29]
'use time; weekday(0)'	4

# today_is_a_date_after_2025
'use time; today().year > 2025'	1

# date_arithmetic
'use time; d = date_of(add_days(0, 31)); [d.month, d.day]'	[2 1]
'use time; days_between(0, 951782400000)'	11016

# use_time_formats_dates_and_times
'use time; text(Instant(0).date)'	'1970-01-01'
'use time; text(Instant(1791331509000).date)'	'2026-10-07'
'use time; text(Instant(1791331509000).time)'	'00:05:09'
'use time; two_digits(7) + two_digits(12)'	'0712'

# use_time_parses_dates
'use time; ("1970-01-01" as Instant).ms'	0
'use time; ("2026-10-07" as Instant).ms'	1791331200000
'use time; text(("2000-02-29" as Instant).date)'	'2000-02-29'

# format_duration_in_the_largest_units
'use time; text(Duration(5430000))'	'1h 30m 30s'
'use time; text(Duration(250))'	'250ms'
'use time; text(Duration(86400000 + 5000))'	'1d 5s'

# civil_days_are_prelude_words
'days_from_civil(1970, 1, 1)'	0
'days_from_civil(2000, 2, 29)'	11016
'days_from_civil(1969, 12, 31)'	-1
'd = civil_from_days(11016); [d.year, d.month, d.day]'	[2000 2 29]
'd = civil_from_days(-719468); [d.year, d.month, d.day]'	[0 3 1]
'use time; days_from_date(2026, 10, 7)'	20733
