# use uniscript: lib/uniscript.warp over the package's C library (card uniscript-ownership; scripts/link-packages.sh builds it)
'use uniscript; uniscript("<:alpha/>")'	'α'
'use uniscript; uniscript("\\:alpha + \\:beta")'	'α + β'
'use uniscript; unicode_to_uniscript("α")'	'\\:alpha'
'import uniscript_c; uniscript_to_unicode("<:alpha/>")'	'α'
