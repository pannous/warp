// zlib compress/decompress edges beyond test_compress_api.pairs.warp (card lib-coverage-recent)
'use compress; from_utf8(decompress(compress("")))'	""
'use compress; decompress(compress([]))'	[]
'use compress; try { decompress([1, 2, 3]) } catch e { e.message }'	"zlib: the input is too short for a zlib stream"
'use compress; try { decompress([112, 156, 0, 0, 0, 0]) } catch e { e.message }'	"zlib: compression method 0 is not deflate"
'use compress; try { decompress([120, 32, 0, 0, 0, 0]) } catch e { e.message }'	"zlib: a preset dictionary is not supported"
'use compress; from_utf8(decompress(compress("a")))'	"a"
