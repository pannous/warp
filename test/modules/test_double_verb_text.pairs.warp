# one verb with overloads by argument type (card double-verb-text): remove, map, filter, sort, find
'use text; remove("foobar", prefix: "foo")'	"bar"
'use text; remove("foobar", suffix: "bar")'	"foo"
'use text; "file.txt".remove(suffix: ".txt")'	"file"
'use map; map({a: 2, b: 3}, x => x * 2)'	{a: 4, b: 6}
'use map; filter({a: 1, b: 2, c: 3}, (k, v) => k != "a" and v < 3)'	{b: 2}
'use file; use shell; p = temp_folder() + "/double_verb_sort.txt"; write(p, "b\na\n"); r = sort(Path(p)); delete_file(p); r'	["a", "b"]
'use shell; find(Path("../fixtures/unix/configs"), "?.txt")'	[]
'use regex; [find("abc", "b"), find("a1 b22", Regex("[0-9]+"))]'	[2, ["1", "22"]]
