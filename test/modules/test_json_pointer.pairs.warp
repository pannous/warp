// lib/json_tools.warp JSON Pointer: RFC 6901 section 5, every pointer of its example, then the URI fragment forms and errors (card lib-json-tools)
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'\'), json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo\'), json(\'["bar", "baz"]\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo/0\'), json(\'"bar"\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/\'), json(\'0\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/a~1b\'), json(\'1\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/c%d\'), json(\'2\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/e^f\'), json(\'3\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/g|h\'), json(\'4\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/i\\\\j\'), json(\'5\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/k"l\'), json(\'6\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/ \'), json(\'7\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/m~0n\'), json(\'8\'))'	true
// section 6, the URI fragment identifier forms
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#\'), json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/foo\'), json(\'["bar", "baz"]\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/foo/0\'), json(\'"bar"\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/\'), json(\'0\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/a~1b\'), json(\'1\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/c%25d\'), json(\'2\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/e%5Ef\'), json(\'3\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/g%7Ch\'), json(\'4\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/i%5Cj\'), json(\'5\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/k%22l\'), json(\'6\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/%20\'), json(\'7\'))'	true
'use json_tools; json_equal(json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'#/m~0n\'), json(\'8\'))'	true
// a missing path raises, naming it
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/nope\') } catch e { e.message }'	"json pointer /nope: no member nope"
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo/2\') } catch e { e.message }'	"json pointer /foo/2: index 2 is past the end of an array of 2"
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo/01\') } catch e { e.message }'	"json pointer /foo/01: 01 is no array index"
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo/-\') } catch e { e.message }'	"json pointer /foo/-: - is no array index"
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'/foo/0/x\') } catch e { e.message }'	"json pointer /foo/0/x: x reaches into a string"
'use json_tools; try { json_pointer_get(json(\'{"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\\\\\\\j": 5, "k\\\\"l": 6, " ": 7, "m~n": 8}\'), \'foo\') } catch e { e.message }'	"json pointer foo does not start with /"
