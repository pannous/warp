# splat_frame_of (lib/splats.warp): a .splat file's bytes in the GPU lists, the same numbers read_splats and covariance_terms give. read_splats is unchanged
'use splats; use color; s = Splat([1.5, -2.0, 0.25], [0.5, 0.5, 0.125], [1.0, 0.0, 0.0, 0.0], rgb(255, 128, 0), 1.0); f = splat_frame_of(splat_bytes(s)); [f.count, [f.centres#i for i in 1 to 4], [f.shapes#i for i in 1 to 4], [f.shades#i for i in 1 to 4], covariance_terms(s.rotation, s.scale)]'	[1, [1.5, -2, 0.25, 1], [0.25, 0, 0, 0.25], [0, 0.015625, 16744448, 0], [0.25, 0, 0, 0.25, 0, 0.015625]]
'use splats; splat_frame_of([]).count'	0
