# coverage audit (card lib-coverage-audit): lib/text words that had no or one test line

«use text; [indentation("\\t  x y"), indentation("x"), indentation(""), common_start("interstellar", "internet"), common_start("ab😀c", "ab😀d"), common_start("", "abc")] == ["\\t  ", "", "", "inter", "ab😀", ""]»	true
«use text; [center("ab", 6), center("abc", 6), center("abcdef", 3), center("", 2), center("😀", 3), pad_left("😀", 3), pad_right("ab", 4), pad_left("abcdef", 2)] == ["  ab  ", " abc  ", "abcdef", "  ", " 😀 ", "  😀", "ab  ", "abcdef"]»	true
«use text; [truncate("hello world", 5), truncate("hi", 5), truncate("hello", 5), truncate("😀😀😀", 2), remove_suffix("file.txt", ".txt"), remove_suffix("file", ".txt"), remove_suffix("", "x"), remove_suffix("aa", "aa")] == ["hell…", "hi", "hello", "😀…", "file", "file", "", ""]»	true
«use text; [between("a [b] c", "[", "]"), between("no", "[", "]"), between("x(1)(2)", "(", ")"), between("[open", "[", "]"), between("‹é›", "‹", "›")] == ["b", "", "1", "", "é"]»	true
«use text; [is_upper("ABC"), is_upper("AbC"), is_upper("123"), is_upper(""), is_upper("ÄÖ"), is_blank(""), is_blank("  \\t\\n"), is_blank(" a "), is_palindrome("A man, a plan, a canal: Panama"), is_palindrome(""), is_palindrome("ab")] == [yes, no, no, no, yes, yes, yes, no, yes, yes, no]»	true
«use text; [is_numeric("12"), is_numeric("-1.5"), is_numeric(" 3 "), is_numeric("1."), is_numeric(".5"), is_numeric(""), is_numeric("1e5"), is_numeric("abc")] == [yes, yes, yes, no, no, no, no, no]»	true
«use text; [capitalize("hello"), capitalize(""), capitalize("élan"), title("hello wide world"), title(""), title("ünïcode text"), words("  a  b\\tc\\n"), words(""), words("😀 ok"), lines("a\\nb"), lines("a\\n")] == ["Hello", "", "Élan", "Hello Wide World", "", "Ünïcode Text", ["a", "b", "c"], [], ["😀", "ok"], ["a", "b"], ["a", ""]]»	true
«use text; attempt(f) := try { str(f()) } catch e { "" + e }; [ordinalize(1), ordinalize(2), ordinalize(3), ordinalize(4), ordinalize(11), ordinalize(12), ordinalize(13), ordinalize(21), ordinalize(111), attempt(() -> ordinalize(0)), human_size(0), human_size(999), human_size(1536), human_size(1500000), attempt(() -> human_size(-1))] == ["1st", "2nd", "3rd", "4th", "11th", "12th", "13th", "21st", "111th", "ordinalize needs a whole number >= 1", "0 B", "999 B", "1.5 KB", "1.5 MB", "human_size needs bytes >= 0"]»	true
