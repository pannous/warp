# use_encoding_base64_vectors
'use encoding; base64_encode("")'	""
'use encoding; base64_encode("f")'	"Zg=="
'use encoding; base64_encode("fo")'	"Zm8="
'use encoding; base64_encode("foo")'	"Zm9v"
'use encoding; base64_encode("foob")'	"Zm9vYg=="
'use encoding; base64_encode("foobar")'	"Zm9vYmFy"
'use encoding; base64_decode("Zm9vYmFy")'	"foobar"
'use encoding; base64_decode("Zg==")'	"f"
'use encoding; base64_decode(base64_encode("héllo wörld"))'	"héllo wörld"

# use_encoding_hex
'use encoding; hex_encode("foo")'	"666f6f"
'use encoding; hex_decode("666F6F")'	"foo"
'use encoding; hex_decode(hex_encode("héllo"))'	"héllo"

