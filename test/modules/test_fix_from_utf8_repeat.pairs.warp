# from_utf8 refuses invalid UTF-8 (a lone continuation byte, a cut-off character, overlong forms, surrogates, non-bytes) instead of an index error or a wrong character; repeat refuses a negative count (it trapped with divide by zero): fix(lib), card lib-coverage-audit-2
«use text; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> from_utf8([128])), attempt(() -> from_utf8([65, 195])), attempt(() -> from_utf8([192, 128])), attempt(() -> from_utf8([237, 160, 128])), attempt(() -> from_utf8([300]))] == ["from_utf8: the byte 128 at position 0 cannot start a character (invalid UTF-8)", "from_utf8: the character starting at position 1 is cut off (invalid UTF-8)", "from_utf8: the byte 192 at position 0 cannot start a character (invalid UTF-8)", "from_utf8: an overlong or out-of-range sequence at position 0 (invalid UTF-8)", "from_utf8: 300 at position 0 is not a byte"]»	true
«use text; [from_utf8([195, 169, 240, 159, 152, 128, 65]), from_utf8(to_utf8("ünï😀")), from_utf8([])] == ["é😀A", "ünï😀", ""]»	true
«use text; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> repeat("x", -1)), repeat("ab", 0), repeat("😀", 2)] == ["repeat needs a count of at least 0, not -1", "", "😀😀"]»	true
