# from test_std_file.rs: edit the Rust test, then run the script again

# use_file_writes_appends_and_reads_back
'use file; exists("data/test_std_file/no such file")'	false

# write_and_exists_need_no_use
'exists("data/test_std_file/no such file")'	false
'write(x, y) := x + y; write(1, 2)'	3

# a_file_url_loads_the_module_and_append_is_qualified
'use file; xs = [1]; xs.append(2); xs'	[1 2]

# decision file-words-implicit: write works with and without `use file` (std_file_written.txt holds what it writes)
'use file; write("test/modules/std_file_written.txt", "hi"); read("test/modules/std_file_written.txt")'	"hi"
'write("test/modules/std_file_written.txt", "hi"); read("test/modules/std_file_written.txt")'	"hi"
