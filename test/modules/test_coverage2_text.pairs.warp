# coverage audit 2 (ranked 81-160): text helpers, edge cases
«use text; [center("ab", 6), center("long", 2), center("", 3)] == ["  ab  ", "long", "   "]»	true
«use text; [is_upper("ABC"), is_upper("AbC"), is_upper(""), is_upper("ÄÖ"), is_upper("A1")] == [true, false, false, true, true]»	true
«use text; [between("a[b]c", "[", "]"), between("abc", "[", "]"), between("x<<y>>", "<<", ">>")] == ["b", "", "y"]»	true
«use text; wrap("the quick brown fox", 10) == "the quick" + chr(10) + "brown fox"»	true
«use text; [format_number(1234567), format_number(-1234), format_number(0), format_number(999), format_number(0.5)] == ["1,234,567", "-1,234", "0", "999", "0.5"]»	true
«use text; nl = chr(10); [dedent("    a" + nl + "      b" + nl + "    c"), dedent(""), dedent("  a" + nl + " b")] == ["a" + nl + "  b" + nl + "c", "", " a" + nl + "b"]»	true
«use text; [repeat("ab", 3), repeat("😀", 2), repeat("", 5)] == ["ababab", "😀😀", ""]»	true
«use text; from_utf8(to_utf8("")) == "" and count(to_utf8("é")) == 2 and count(to_utf8("😀")) == 4»	true
