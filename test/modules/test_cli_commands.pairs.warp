// lib/cli.warp choices and parse_commands against python's argparse subparsers (card lib-cli-args-2): each expected
// value is what argparse gives on the same argv (test/cli/gen_cli_commands_tests.py; dest="command", required,
// allow_abbrev=False). Where both refuse, warp's message is its own (cli: …), argparse's is not compared.
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["add", "buy", "milk"])'	{help: no, verbose: no, file: "todo.json", command: "add", priority: "low", times: 1, title: ["buy", "milk"]}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["-v", "add", "-p", "high", "buy", "milk"])'	{help: no, verbose: yes, file: "todo.json", command: "add", priority: "high", times: 1, title: ["buy", "milk"]}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["add", "--priority=mid", "x"])'	{help: no, verbose: no, file: "todo.json", command: "add", priority: "mid", times: 1, title: ["x"]}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["add", "-n", "3", "x"])'	{help: no, verbose: no, file: "todo.json", command: "add", priority: "low", times: 3, title: ["x"]}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["-f", "a.json", "done", "3"])'	{help: no, verbose: no, file: "a.json", command: "done", id: 3}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["--file=b.json", "-v", "done", "12"])'	{help: no, verbose: yes, file: "b.json", command: "done", id: 12}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["list"])'	{help: no, verbose: no, file: "todo.json", command: "list", all: no, sort: "id"}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["list", "-a", "--sort", "title"])'	{help: no, verbose: no, file: "todo.json", command: "list", all: yes, sort: "title"}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["list", "--no-all"])'	{help: no, verbose: no, file: "todo.json", command: "list", all: no, sort: "id"}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["--no-verbose", "list"])'	{help: no, verbose: no, file: "todo.json", command: "list", all: no, sort: "id"}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["add", "--", "-v", "x"])'	{help: no, verbose: no, file: "todo.json", command: "add", priority: "low", times: 1, title: ["-v", "x"]}
'use cli; parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["add"])'	{help: no, verbose: no, file: "todo.json", command: "add", priority: "low", times: 1, title: []}
'use cli; try { parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, [])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
'use cli; try { parse_commands([{name: "verbose", short: "v", kind: "flag"}, {name: "file", short: "f", default: "todo.json"}], {add: [{name: "priority", short: "p", choices: ["low", "mid", "high"], default: "low"}, {name: "times", short: "n", kind: "int", choices: [1, 2, 3], default: 1}, {name: "title", positional: yes, many: yes}], done: [{name: "id", kind: "int", positional: yes}], list: [{name: "all", short: "a", kind: "flag"}, {name: "sort", choices: ["id", "title"], default: "id"}]}, ["zap"])["help"] } catch e { e.message.starts_with("cli: ") }'	yes
