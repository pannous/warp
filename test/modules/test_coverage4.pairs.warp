# behaviour pinned by Supervisor decision (lib-coverage-audit-2 batch 4): deliberate, not bugs
# deliberate: is_letter_text is ASCII-only; use is_unicode_letter for letters beyond ASCII
«is_letter_text("é") == false and is_letter_text("e")»	true
# deliberate: lines of an empty text is one empty line
«use text; lines("") == [""]»	true

# coverage audit 2, batch 4: time helpers (UTC milliseconds), edge cases incl. before 1970 and leap day
«use time; [weekday(0), weekday(86400000 * 3), weekday(-86400000)] == [4, 7, 3]»	true
«use time; [text(Instant(0).date), text(Instant(-86400000).date), text(Instant(951782400000).date)] == ["1970-01-01", "1969-12-31", "2000-02-29"]»	true
«use time; [text(Instant(0).time), text(Instant(3723000).time), text(Instant(-1000).time)] == ["00:00:00", "01:02:03", "23:59:59"]»	true
«use time; [relative_time(0, 0), relative_time(0, 7200000), relative_time(90000, 0), relative_time(0, 31536000000 * 2)] == ["just now", "2 hours ago", "in 1 minute", "2 years ago"]»	true
