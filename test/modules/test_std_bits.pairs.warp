# int_bytes_and_bytes_int
'use bits; int_bytes(258, 16)'	[1, 2]
'use bits; int_bytes(258, 16, "little")'	[2, 1]
'use bits; int_bytes(-1, 32)'	[255, 255, 255, 255]
'use bits; int_bytes(-2, 64, "little")'	[254, 255, 255, 255, 255, 255, 255, 255]
'use bits; int_bytes(0x12345678, 32)'	[0x12, 0x34, 0x56, 0x78]
'use bits; int_bytes(200, 8)'	[200]
'use bits; bytes_int([1, 2])'	258
'use bits; bytes_int([2, 1], "little")'	258
'use bits; bytes_int([255, 254], "big", yes)'	-2
'use bits; bytes_int([255, 254], "big")'	65534
'use bits; bytes_int([128], "big", yes)'	-128
'use bits; bytes_int(int_bytes(-123456789, 64, "little"), "little", yes)'	-123456789
'use bits; bytes_int([255, 255, 255, 255, 255, 255, 255, 255], "big", yes)'	-1

# float_bytes_ieee_754
'use bits; float_bytes(1.0)'	[0x3f, 0xf0, 0, 0, 0, 0, 0, 0]
'use bits; float_bytes(1.0, 32)'	[0x3f, 0x80, 0, 0]
'use bits; float_bytes(-2.5, 64)'	[0xc0, 0x04, 0, 0, 0, 0, 0, 0]
'use bits; float_bytes(-2.5, 32)'	[0xc0, 0x20, 0, 0]
'use bits; float_bytes(1.0, 64, "little")'	[0, 0, 0, 0, 0, 0, 0xf0, 0x3f]
'use bits; float_bytes(0.1, 32)'	[0x3d, 0xcc, 0xcc, 0xcd]
'use bits; float_bytes(bytes_float([0x80, 0, 0, 0, 0, 0, 0, 0]), 64)'	[0x80, 0, 0, 0, 0, 0, 0, 0]
'use bits; float_bytes(bytes_float([0x80, 0, 0, 0, 0, 0, 0, 0]), 32)'	[0x80, 0, 0, 0]
'use bits; float_bytes(bytes_float([0x80, 0, 0, 0]), 64)'	[0x80, 0, 0, 0, 0, 0, 0, 0]
'use bits; float_bytes(bytes_float([0x7f, 0xf0, 0, 0, 0, 0, 0, 0]), 32)'	[0x7f, 0x80, 0, 0]
'use bits; float_bytes(bytes_float([0xff, 0xf0, 0, 0, 0, 0, 0, 0]), 32)'	[0xff, 0x80, 0, 0]
'use bits; float_bytes(bytes_float([0x7f, 0xf8, 0, 0, 0, 0, 0, 0]), 32)'	[0x7f, 0xc0, 0, 0]
'use bits; float_bytes(1e40, 32)'	[0x7f, 0x80, 0, 0]
'use bits; float_bytes(1e-45, 32)'	[0, 0, 0, 1]
'use bits; float_bytes(1.1754942e-38, 32)'	[0, 0x7f, 0xff, 0xff]
'use bits; float_bytes(1e-50, 32)'	[0, 0, 0, 0]
'use bits; bytes_float([0x3f, 0x80, 0, 0])'	1.0
'use bits; bytes_float([0xc0, 0x20, 0, 0])'	-2.5
'use bits; float_bytes(bytes_float([0, 0, 0, 1]))'	[0x36, 0xa0, 0, 0, 0, 0, 0, 0]
'use bits; float_bytes(bytes_float([0x80, 0, 0, 1]), 32)'	[0x80, 0, 0, 1]
'use bits; bytes_float(float_bytes(3.141592653589793))'	3.141592653589793
'use bits; bytes_float(float_bytes(-1.5e300, 64, "little"), "little")'	-1.5e300
'use bits; bytes_float([0x7f, 0xf8, 0, 0, 0, 0, 0, 1]) != bytes_float([0x7f, 0xf8, 0, 0, 0, 0, 0, 1])'	true

# bit_counts_and_rotations
'use bits; [popcount(255), popcount(0), popcount(-1), popcount(-1, 8)]'	[8, 0, 64, 8]
'use bits; [bit_length(5), bit_length(0), bit_length(1), bit_length(-1)]'	[3, 0, 1, 64]
'use bits; [leading_zeros(1), leading_zeros(1, 32), leading_zeros(0, 8), leading_zeros(-1)]'	[63, 31, 8, 0]
'use bits; [trailing_zeros(8), trailing_zeros(0), trailing_zeros(0, 16)]'	[3, 64, 16]
'use bits; [rotate_left(1, 1, 8), rotate_left(0x80, 1, 8), rotate_right(1, 1, 8), rotate_right(0x12345678, 8, 32)]'	[2, 1, 0x80, 0x78123456]
'use bits; [rotate_left(1, 63) == 1 << 63, rotate_right(1, 1) == 1 << 63, rotate_left(5, 0, 32)]'	[yes, yes, 5]
'use bits; [shift_right(-1, 60), -1 >> 60, signed(255, 8), signed(127, 8)]'	[15, -1, -1, 127]
