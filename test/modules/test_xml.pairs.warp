# XML: parse_xml, xml_text, xml_find, xml_find_all, to_xml (lib/xml.warp, card lib-xml)

# RSS feed: structure, CDATA, entities, namespaced dc:creator, quotes
«use xml; d = parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n"); [d["name"], d["attributes"]["version"], xml_find(d, "channel/title")["text"], count(xml_find_all(d, "channel/item")), xml_find(d, "channel/item/description")["text"], xml_find(d, "channel/item[2]/title")["text"], xml_find(d, "//dc:creator")["ns"], xml_find_all(d, "//creator").map(xml_text), xml_find(d, "//guid[@isPermaLink='false']")["text"]] == ["rss", "2.0", "Warp News", 2, "<p>Big & bold</p>", "Fish & Chips " + chr(8211) + " " + chr(0x263A), "http://purl.org/dc/elements/1.1/", ["Ann", "Bob"], "r1"]»	true

# SVG with a default namespace and xlink

# config file: DOCTYPE without entities skipped, PI skipped, attributes, paths

# mixed content, comments dropped, whitespace-only runs dropped, self-closing
«use xml; p = parse_xml("<p>Hello <b>big</b> world<!-- x --> again</p>"); e = parse_xml("<a>\\n  <b/>\\n  <c> </c><d><![CDATA[ ]]></d></a>"); [p["text"], xml_text(p), count(p["children"]), count(e["children"]), xml_find(e, "c")["children"], xml_find(e, "d")["text"], xml_find(e, "b")["children"]] == ["Hello  world again", "Hello big world again", 3, 3, [], " ", []]»	true

# to_xml round-trips and escapes
«use xml; d = parse_xml("<a k='1 &amp; \\"2\\"'>x &lt; y<b></b>z</a>"); [to_xml(d), parse_xml(to_xml(d)) == d, parse_xml(to_xml(parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n"))) == parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n")] == ["<a k=\\"1 &amp; &quot;2&quot;\\">x &lt; y<b/>z</a>", yes, yes]»	true

# errors carry line and column

# path syntax refused clearly

# namespace scoping and redeclaration, the xml prefix
«use xml; nd = parse_xml("<r xmlns:a='urn:one' xml:lang='en'><a:b><a:c xmlns:a='urn:two'/></a:b><d xmlns='urn:dflt'><e xmlns=''/></d></r>"); [xml_find(nd, "a" + ":b")["ns"], xml_find(nd, "a" + ":b/a:c")["ns"], xml_find(nd, "d")["ns"], xml_find(nd, "d/e")["ns"], nd["attributes"]["xml:lang"]] == ["urn:one", "urn:two", "urn:dflt", "", "en"]»	true

# BOM, CRLF, attribute normalization
«use xml; [parse_xml(chr(0xFEFF) + "<r>x</r>")["text"], parse_xml("<r>a" + chr(13) + chr(10) + "b</r>")["text"], parse_xml("<r t='x" + chr(10) + "y &lt;&amp;&gt;'/>")["attributes"]["t"]] == ["x", "a" + chr(10) + "b", "x y <&>"]»	true

