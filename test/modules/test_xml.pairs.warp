# XML: parse_xml, xml_text, xml_find, xml_find_all, to_xml (lib/xml.warp, card lib-xml)

# RSS feed: structure, CDATA, entities, namespaced dc:creator, quotes
«use xml; d = parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n"); [d["name"], d["attributes"]["version"], xml_find(d, "channel/title")["text"], count(xml_find_all(d, "channel/item")), xml_find(d, "channel/item/description")["text"], xml_find(d, "channel/item[2]/title")["text"], xml_find(d, "//dc:creator")["ns"], xml_find_all(d, "//creator").map(xml_text), xml_find(d, "//guid[@isPermaLink='false']")["text"]] == ["rss", "2.0", "Warp News", 2, "<p>Big & bold</p>", "Fish & Chips " + chr(8211) + " " + chr(0x263A), "http://purl.org/dc/elements/1.1/", ["Ann", "Bob"], "r1"]»	true

# SVG with a default namespace and xlink
«use xml; s = parse_xml("<svg xmlns=\\"http://www.w3.org/2000/svg\\" xmlns:xlink=\\"http://www.w3.org/1999/xlink\\" width=\\"10\\">\\n  <defs><circle id=\\"c\\" r=\\"2\\"/></defs>\\n  <g fill=\\"red\\"><use xlink:href=\\"#c\\" x=\\"1\\"/><rect width=\\"3\\" height=\\"4\\"/></g>\\n  <g fill=\\"blue\\"><rect width=\\"5\\"/></g>\\n</svg>"); [s["ns"], s["local"], s["prefix"], xml_find(s, "g/use")["attributes"]["xlink:href"], count(xml_find_all(s, "//rect")), count(xml_find_all(s, "//{http://www.w3.org/2000/svg}rect")), count(xml_find_all(s, "//{urn:other}rect")), xml_find(s, "g[@fill='blue']/rect")["attributes"]["width"], xml_find(s, "g[2]/rect")["attributes"]["width"], count(xml_find_all(s, "g/*")), xml_find(s, "//rect/..")["attributes"]["fill"]] == ["http://www.w3.org/2000/svg", "svg", "", "#c", 2, 2, 0, "5", "5", 3, "red"]»	true

# config file: DOCTYPE without entities skipped, PI skipped, attributes, paths
«use xml; c = parse_xml("<?xml version=\\"1.0\\"?>\\n<!DOCTYPE config [ <!ELEMENT config ANY> ]>\\n<config>\\n  <server host=\\"localhost\\" port=\\"8080\\"/>\\n  <db><user>admin</user><pool size=\\"4\\">yes</pool></db>\\n  <?app-hint keep?>\\n  <feature name=\\"a\\" on=\\"true\\"/><feature name=\\"b\\" on=\\"false\\"/><feature name=\\"c\\" on=\\"true\\"/>\\n</config>"); [xml_find(c, "server")["attributes"]["port"], xml_find(c, "db/user")["text"], xml_find(c, "db/pool[@size]")["text"], xml_find_all(c, "feature[@on='true']").map(f => f["attributes"]["name"]), xml_find(c, "feature[3]")["attributes"]["name"], xml_find(c, "missing"), xml_find(c, ".")["name"], xml_find(c, "db/..")["name"], count(xml_find_all(c, "//*")), count(xml_find_all(c, "db//user"))] == ["8080", "admin", "yes", ["a", "c"], "c", nil, "config", "config", 7, 1]»	true

# mixed content, comments dropped, whitespace-only runs dropped, self-closing
«use xml; p = parse_xml("<p>Hello <b>big</b> world<!-- x --> again</p>"); e = parse_xml("<a>\\n  <b/>\\n  <c> </c><d><![CDATA[ ]]></d></a>"); [p["text"], xml_text(p), count(p["children"]), count(e["children"]), xml_find(e, "c")["children"], xml_find(e, "d")["text"], xml_find(e, "b")["children"]] == ["Hello  world again", "Hello big world again", 3, 3, [], " ", []]»	true

# to_xml round-trips and escapes
«use xml; d = parse_xml("<a k='1 &amp; \\"2\\"'>x &lt; y<b></b>z</a>"); [to_xml(d), parse_xml(to_xml(d)) == d, parse_xml(to_xml(parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n"))) == parse_xml("<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n<!-- feed -->\\n<rss version=\\"2.0\\" xmlns:dc=\\"http://purl.org/dc/elements/1.1/\\">\\n  <channel>\\n    <title>Warp News</title>\\n    <link>https://example.org/</link>\\n    <item>\\n      <title>Release 1.0</title>\\n      <dc:creator>Ann</dc:creator>\\n      <description><![CDATA[<p>Big & bold</p>]]></description>\\n      <guid isPermaLink='false'>r1</guid>\\n    </item>\\n    <item>\\n      <title>Fish &amp; Chips &#8211; &#x263A;</title>\\n      <dc:creator>Bob</dc:creator>\\n    </item>\\n  </channel>\\n</rss>\\n")] == ["<a k=\\"1 &amp; &quot;2&quot;\\">x &lt; y<b/>z</a>", yes, yes]»	true

# errors carry line and column
«use xml; attempt(t) := try { parse_xml(t)["name"] } catch e { "" + e }; [attempt("<a>\\n<b>\\n</a>"), attempt("<a>\\n<b>"), attempt("<a x=\\"1\\"\\n x=\\"2\\"/>"), attempt("<a>&nbsp;</a>"), attempt("<a>&#xZZ;</a>"), attempt("<a/>\\n<b/>"), attempt("<?xml version=\\"1.0\\"?>\\n<!-- only -->"), attempt("<!DOCTYPE a [\\n<!ENTITY lol \\"lol\\">]><a>&lol;</a>"), attempt("<a><p:b/></a>"), attempt("<a x=1/>"), attempt("<a")] == ["xml line 3, column 1: mismatched end tag </a>, expected </b>", "xml line 2, column 1: the unclosed element <b>", "xml line 2, column 2: the duplicate attribute x", "xml line 1, column 4: unknown entity &nbsp; (XML has only amp, lt, gt, quot and apos)", "xml line 1, column 4: bad character reference &#xZZ;", "xml line 2, column 1: junk after the root element", "xml line 2, column 14: no root element", "xml line 2, column 1: entity declarations (<!ENTITY) are refused: no entity expansion", "xml line 1, column 5: the undeclared namespace prefix p:", "xml line 1, column 6: a quoted value expected for the attribute x", "xml line 1, column 1: an unclosed start tag <a"]»	true

# path syntax refused clearly
«use xml; d = parse_xml("<a><b/></a>"); attempt(p) := try { "" + count(xml_find_all(d, p)) } catch e { "" + e }; [attempt("/a"), attempt("b[last()]"), attempt("b[@x=1]"), attempt("b/"), attempt("a|b"), attempt("b[1]")] == ["xml path /a: absolute paths are not supported (start with a tag, . or //)", "xml path b[last()]: unsupported predicate [last()] (use [@attr], [@attr='v'] or [n])", "xml path b[@x=1]: unsupported predicate [@x=1] (quote the value)", "xml path b/: a path ending in /", "xml path a|b: unsupported syntax a|b", "1"]»	true
