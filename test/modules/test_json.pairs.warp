// JSON parsing and writing: notes/stdlib.md section 7
use json; to_json(parse_json("{a: [1, true, null], b: {c: -23}}"))	"{\"a\":[1,true,null],\"b\":{\"c\":-23}}"

# JSON parsing and serialization: notes/stdlib.md section 7 and lib/json.warp
'use json; to_json([true, null, "x"])'	'[true,null,"x"]'
'use json; to_json({answer: 42})'	'{"answer":42}'
'use json; parse_json("[true, null, 2]")#3'	2
