// lib/compress.warp deflate, gzip and zlib_compress, read back by inflate (card lib-deflate); python3 zlib and gzip read the same output on the box
'use compress; deflate("")'	[3, 0]
'use compress; inflate_text(deflate("hello"))'	"hello"
// fixed Huffman with LZ77: the repeats shrink it, the run an overlapping match
'use compress; count(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa")) < 20'	true
'use compress; inflate_text(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa"))'	"abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa"
// bytes that do not compress go out as a stored block (BTYPE 0)
'use compress; deflate([150 + i for i in 0 ..< 40])[0 ..< 5]'	[1, 40, 0, 215, 255]
'use compress; inflate(deflate([150 + i for i in 0 ..< 40])) == [150 + i for i in 0 ..< 40]'	true
'use compress; inflate_text(deflate("héllo wörld ✓"))'	"héllo wörld ✓"
'use compress; gunzip_text(gzip("hello gzip hello gzip"))'	"hello gzip hello gzip"
'use compress; gunzip_text(gzip(""))'	""
'use compress; zlib_decompress_text(zlib_compress("hello zlib hello zlib"))'	"hello zlib hello zlib"
'use compress; zlib_compress("hello")'	[120, 156, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 21]
'use compress; adler32("Wikipedia")'	300286872
'use compress; adler32("")'	1
