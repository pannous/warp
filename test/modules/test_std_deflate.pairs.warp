// lib/compress.warp deflate, gzip and zlib_compress, read back by inflate (card lib-deflate); python3 zlib and gzip read the same output on the box
'use compress; deflate("")'	[3, 0]
'use compress; deflate("hello")'	[203, 72, 205, 201, 201, 7, 0]
'use compress; inflate_text(deflate("hello"))'	"hello"
// fixed Huffman with LZ77: the repeats shrink it, the run an overlapping match
'use compress; count(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa")) < 20'	true
'use compress; inflate_text(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa"))'	"abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa"
