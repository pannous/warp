// lib/compress.warp deflate, gzip and compress (zlib), read back by inflate (card lib-deflate); python3 zlib and gzip read the same output on the box
'use compress; deflate("")'	[3, 0]
'use compress; from_utf8(inflate(deflate("hello")))'	"hello"
// fixed Huffman with LZ77: the repeats shrink it, the run an overlapping match
'use compress; count(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa")) < 20'	true
'use compress; from_utf8(inflate(deflate("abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa")))'	"abcabcabcabcabcabcabcabcabcabcabcabcaaaaaaaaaaaaaaaaaaaaaaaa"
// bytes that do not compress go out as a stored block (BTYPE 0)
'use compress; deflate([150 + i for i in 0 ..< 40])[0 ..< 5]'	[1, 40, 0, 215, 255]
'use compress; inflate(deflate([150 + i for i in 0 ..< 40])) == [150 + i for i in 0 ..< 40]'	true
'use compress; from_utf8(inflate(deflate("héllo wörld ✓")))'	"héllo wörld ✓"
'use compress; from_utf8(gunzip(gzip("hello gzip hello gzip")))'	"hello gzip hello gzip"
'use compress; from_utf8(gunzip(gzip("")))'	""
'use compress; from_utf8(decompress(compress("hello zlib hello zlib")))'	"hello zlib hello zlib"
'use compress; compress("hello")'	[120, 156, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 21]
'use compress; adler32("Wikipedia")'	300286872
'use compress; adler32("")'	1
