// card lib-audit-bugfixes-2 (lib-consistency-audit findings 32, 33): parse_date refuses what is no date instead of
// rolling over, median of an empty list says so
'use time; ("2024-02-29" as Instant).ms'	1709164800000
'use time; text(("2026-12-31" as Instant).date)'	"2026-12-31"
'use time; ("1970-1-1" as Instant).ms'	0
'use time; try { ("2024-13-01" as Instant).ms } catch e { e.message }'	"\"2024-13-01\" as Instant: no month 13"
'use time; try { ("2024-00-10" as Instant).ms } catch e { e.message }'	"\"2024-00-10\" as Instant: no month 0"
'use time; try { ("2024-02-30" as Instant).ms } catch e { e.message }'	"\"2024-02-30\" as Instant: no day 30 in that month"
'use time; try { ("2023-02-29" as Instant).ms } catch e { e.message }'	"\"2023-02-29\" as Instant: no day 29 in that month"
'use time; try { ("2024-04-31" as Instant).ms } catch e { e.message }'	"\"2024-04-31\" as Instant: no day 31 in that month"
'use time; try { ("2024-05-00" as Instant).ms } catch e { e.message }'	"\"2024-05-00\" as Instant: no day 0 in that month"
'use time; try { ("x" as Instant).ms } catch e { e.message }'	"\"x\" as Instant: no YYYY-MM-DD date"
'use time; try { ("2024-1" as Instant).ms } catch e { e.message }'	"\"2024-1\" as Instant: no YYYY-MM-DD date"
'use time; try { ("2024-01-02T03:04" as Instant).ms } catch e { e.message }'	"\"2024-01-02T03:04\" as Instant: no YYYY-MM-DD date"
'use time; try { ("it\'s-01-01" as Instant).ms } catch e { e.message }'	"\"it's-01-01\" as Instant: no YYYY-MM-DD date"
'use list; try { median([]) } catch e { e.message }'	"median of an empty list"
'use list; median([3, 1, 2])'	2
'use list; median([4, 1, 3, 2])'	2.5
