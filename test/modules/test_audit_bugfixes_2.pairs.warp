// card lib-audit-bugfixes-2 (lib-consistency-audit findings 32, 33): parse_date refuses what is no date instead of
// rolling over, median of an empty list says so
'use time; parse_date("2024-02-29")'	1709164800000
'use time; format_date(parse_date("2026-12-31"))'	"2026-12-31"
'use time; parse_date("1970-1-1")'	0
'use time; try { parse_date("2024-13-01") } catch e { e.message }'	"parse_date: \"2024-13-01\": no month 13"
'use time; try { parse_date("2024-00-10") } catch e { e.message }'	"parse_date: \"2024-00-10\": no month 0"
'use time; try { parse_date("2024-02-30") } catch e { e.message }'	"parse_date: \"2024-02-30\": no day 30 in that month"
'use time; try { parse_date("2023-02-29") } catch e { e.message }'	"parse_date: \"2023-02-29\": no day 29 in that month"
'use time; try { parse_date("2024-04-31") } catch e { e.message }'	"parse_date: \"2024-04-31\": no day 31 in that month"
'use time; try { parse_date("2024-05-00") } catch e { e.message }'	"parse_date: \"2024-05-00\": no day 0 in that month"
'use time; try { parse_date("x") } catch e { e.message }'	"parse_date: \"x\" is no YYYY-MM-DD date"
'use time; try { parse_date("2024-1") } catch e { e.message }'	"parse_date: \"2024-1\" is no YYYY-MM-DD date"
'use time; try { parse_date("2024-01-02T03:04") } catch e { e.message }'	"parse_date: \"2024-01-02T03:04\" is no YYYY-MM-DD date"
'use time; try { parse_date("it\'s-01-01") } catch e { e.message }'	"parse_date: \"it's-01-01\" is no YYYY-MM-DD date"
'use list; try { median([]) } catch e { e.message }'	"median of an empty list"
'use list; median([3, 1, 2])'	2
'use list; median([4, 1, 3, 2])'	5/2
