# a word of one standard module works without its `use` (decision implicit-standard-words)
'red == 0xFFFF0000'	true
'hsv(0, 1, 1) == red'	true
'A4'	440
'class C{r:int; f() := r * 2}; C(3).f()'	6
'c = {red: 3}; c.red'	3
'transpose([[1, 2]])'	error	a word of two modules needs its `use`
'use matrix; transpose([[1, 2]])'	[[1], [2]]
# a name the program binds anywhere is its own, never a module's word: a key, a loop variable, a parameter, a pattern
'q = {g: 5}; q.g'	5
's = {f: x => x * 2, g: x => x + 1}; s.g(s.f(4))'	9
'[c * 2 for c in [1, 2]]'	[2, 4]
'f = (red) => red + 1; f(1)'	2
'p = Person{red: 2}; p.red'	2
# a tag's {…} is markup: its words are data, no module's (samples/web/html: label(for: pwd), id: pwd)
'div{ id: pwd }'	div:{id:pwd}
'form{ label{ for: email } }; 1'	1
'form{ guests: 2 }'	form:{guests:2}
# a class's method, a field and a sum type's variants are the program's own (warp-separate-modules' reds)
'class P{x:int; max() := x}; max(3, 5)'	5
'class Bag{items; def sum():=7}; Bag([1]).sum'	7
'type Color = red | rgb(r, g, b); c = rgb(1, 2, 3); c.g'	2
