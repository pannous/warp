# a word of one standard module works without its `use` (decision implicit-standard-words)
'red == 0xFFFF0000'	true
'hsv(0, 1, 1) == red'	true
'A4'	440
'class C{r:int; f() := r * 2}; C(3).f()'	6
'c = {red: 3}; c.red'	3
'transpose([[1, 2]])'	error	a word of two modules needs its `use`
'use matrix; transpose([[1, 2]])'	[[1], [2]]
# a name the program binds anywhere is its own, never a module's word: a key, a loop variable, a parameter, a pattern
'q = {g: 5}; q.g'	5
's = {f: x => x * 2, g: x => x + 1}; s.g(s.f(4))'	9
'[c * 2 for c in [1, 2]]'	[2, 4]
'f = (red) => red + 1; f(1)'	2
'p = Person{red: 2}; p.red'	2
