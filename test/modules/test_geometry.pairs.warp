# Geometry: vectors, polygons, segments, convex hull, haversine (lib/geometry.warp, card lib-geometry); floats compared within 1e-9 (near(a, b))

# vector words: exact integer results
«use geometry; [vec_add([1, 2], [3, 4]), vec_sub([1, 2], [3, 4]), vec_scale([1, 2, 3], 2), vec_dot([1, 2, 3], [4, 5, 6]), vec_cross([1, 0, 0], [0, 1, 0]), vec_cross([2, 3, 4], [5, 6, 7]), vec_cross2([1, 0], [0, 1]), vec_cross2([2, 3], [4, 5])] == [[4, 6], [-2, -2], [2, 4, 6], 32, [0, 0, 1], [-3, 6, -3], 1, -2]»	true

# norm, distance, angle (radians, unsigned 0..pi), rotate (counter-clockwise)
«use geometry; near(a, b) := abs(a - b) < 0.000000001; r = vec_rotate([1, 0], pi / 2); q = vec_rotate([2, 1], pi); [near(vec_norm([3, 4]), 5), near(geo_distance([1, 1], [4, 5]), 5), near(geo_distance([0, 0, 0], [1, 2, 2]), 3), near(vec_angle([1, 0], [0, 1]), pi / 2), near(vec_angle([1, 0], [-1, 0]), pi), near(vec_angle([1, 1], [1, 0]), pi / 4), near(vec_angle([0, 1], [1, 0]), pi / 2), near(vec_angle([2, 0, 0], [3, 0, 0]), 0), near(r#1, 0), near(r#2, 1), near(q#1, -2), near(q#2, -1)] == [yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes]»	true

# bounding box, shoelace area (signed: counter-clockwise positive), centroid
«use geometry; near(a, b) := abs(a - b) < 0.000000001; sq = [[0, 0], [1, 0], [1, 1], [0, 1]]; tri = [[0, 0], [4, 0], [0, 3]]; ell = [[0, 0], [2, 0], [2, 1], [1, 1], [1, 2], [0, 2]]; c = polygon_centroid(sq); t = polygon_centroid(tri); l = polygon_centroid(ell); [bounding_box([[1, 5], [-2, 3], [4, 0]]), bounding_box([[1, 2, 3]]), near(polygon_signed_area(sq), 1), near(polygon_signed_area([[0, 0], [0, 1], [1, 1], [1, 0]]), -1), near(polygon_area([[0, 0], [0, 1], [1, 1], [1, 0]]), 1), near(polygon_area(tri), 6), near(polygon_area(ell), 3), near(c#1, 0.5), near(c#2, 0.5), near(t#1, 4 / 3), near(t#2, 1), near(l#1, 5 / 6), near(l#2, 5 / 6)] == [[[-2, 0], [4, 5]], [[1, 2, 3], [1, 2, 3]], yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes]»	true

# point in polygon: inside, outside, boundary (edge and corner) counts as inside, a concave L
«use geometry; sq = [[0, 0], [1, 0], [1, 1], [0, 1]]; ell = [[0, 0], [2, 0], [2, 1], [1, 1], [1, 2], [0, 2]]; [point_in_polygon([0.5, 0.5], sq), point_in_polygon([2, 0.5], sq), point_in_polygon([1, 0.5], sq), point_in_polygon([0, 0], sq), point_in_polygon([0.5, 1], sq), point_in_polygon([1.5, 1.5], ell), point_in_polygon([1.5, 0.5], ell), point_in_polygon([0.5, 1.5], ell), point_in_polygon([-0.1, 0.5], sq)] == [yes, no, yes, yes, yes, no, yes, yes, no]»	true

# segment intersection: crossing, parallel, disjoint, touching at an end, collinear overlap (end nearest a), collinear disjoint, T junction
«use geometry; [segment_intersection([0, 0], [2, 2], [0, 2], [2, 0]), segment_intersection([0, 0], [1, 0], [0, 1], [1, 1]), segment_intersection([0, 0], [1, 1], [3, 0], [2, 1]), segment_intersection([0, 0], [1, 0], [1, 0], [1, 5]), segment_intersection([0, 0], [3, 0], [2, 0], [5, 0]), segment_intersection([3, 0], [0, 0], [2, 0], [5, 0]), segment_intersection([0, 0], [1, 0], [2, 0], [3, 0]), segment_intersection([0, 0], [4, 0], [2, -1], [2, 0]), segment_intersection([0, 0], [4, 0], [2, 1], [2, 3])] == [[1, 1], nil, nil, [1, 0], [2, 0], [3, 0], nil, [2, 0], nil]»	true

# convex hull: counter-clockwise from the lowest x, collinear and inner points left out, duplicates removed; a random-ish set (seeded, checked against a reference monotone chain)
«use geometry; [convex_hull([[0, 0], [1, 1], [2, 2], [2, 0], [0, 2], [1, 0], [1, 2], [0.5, 0.5], [0, 1], [2, 2]]), convex_hull([[10, 4], [12, 20], [1, 2], [17, 3], [11, 18], [1, 16], [6, 1], [2, 13], [13, 2], [7, 2], [17, 13], [1, 18], [3, 7], [20, 20], [18, 1], [18, 18], [12, 1], [7, 1], [17, 4], [9, 13], [4, 17], [3, 18], [9, 17], [5, 3], [18, 18]]), convex_hull([[1, 1], [1, 1], [0, 0]]), convex_hull([[0, 0], [1, 1], [2, 2]]), convex_hull([])] == [[[0, 0], [2, 0], [2, 2], [0, 2]], [[1, 2], [6, 1], [18, 1], [20, 20], [12, 20], [1, 18]], [[0, 0], [1, 1]], [[0, 0], [2, 2]], []]»	true

# haversine (earth radius 6371 km) and initial bearing in degrees 0..360: Paris to London 343.556 km at 330.02°, values worked out from the formula
«use geometry; near(a, b) := abs(a - b) < 0.000001; paris = [48.8566, 2.3522]; london = [51.5074, -0.1278]; [near(haversine_km(paris, london), 343.556060341), near(initial_bearing(paris, london), 330.021092856), near(haversine_km(paris, paris), 0), near(haversine_km([0, 0], [0, 180]), 6371 * pi), near(haversine_km([0, 0], [90, 0]), 6371 * pi / 2), near(initial_bearing([0, 0], [0, 1]), 90), near(initial_bearing([0, 0], [1, 0]), 0), near(initial_bearing([0, 0], [-1, 0]), 180), near(initial_bearing([0, 0], [0, -1]), 270)] == [yes, yes, yes, yes, yes, yes, yes, yes, yes]»	true

# refusals rather than guesses
«use geometry; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> vec_angle([0, 0], [1, 0])), attempt(() -> vec_add([1], [1, 2])), attempt(() -> polygon_area([[0, 0], [1, 1]])), attempt(() -> vec_cross([1, 2], [3, 4])), attempt(() -> vec_rotate([1, 2, 3], 1)), attempt(() -> polygon_centroid([[0, 0], [1, 1], [2, 2]])), attempt(() -> haversine_km([91, 0], [0, 0])), attempt(() -> vec_dot([1, 2], [1, "x"]))] == ["vec_angle of a zero-length vector ([0, 0], [1, 0]) has no angle", "vec_add: mismatched dimensions 1 and 2 ([1], [1, 2])", "polygon_signed_area needs a polygon of at least 3 points, not [[0, 0], [1, 1]]", "vec_cross needs 3D vectors, not [1, 2]", "vec_rotate needs 2D vectors, not [1, 2, 3]", "polygon_centroid of a polygon with no area [[0, 0], [1, 1], [2, 2]]", "haversine_km: latitude 91 is not within -90..90", "vec_dot needs numbers, not x in [1, 'x']"]»	true
