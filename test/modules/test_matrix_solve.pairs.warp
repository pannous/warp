# determinant, inverse and solve by Gaussian elimination with partial pivoting (card lib-matrix-solve)
'use matrix; abs(determinant([[1, 2], [3, 4]]) + 2) < 0.000000001'	yes
'use matrix; abs(determinant([[2, 0, 1], [1, 3, 2], [1, 1, 2]]) - 6) < 0.000000001'	yes
'use matrix; abs(determinant([[6, 1, 1], [4, -2, 5], [2, 8, 7]]) + 306) < 0.000000001'	yes
'use matrix; abs(determinant(identity(4)) - 1) < 0.000000001'	yes
'use matrix; determinant([[1, 2], [2, 4]])'	0.0
'use matrix; a = [[4, 7], [2, 6]]; p = matmul(inverse(a), a); abs(p#1#1 - 1) + abs(p#1#2) + abs(p#2#1) + abs(p#2#2 - 1) < 0.000000001'	yes
'use matrix; a = [[2, 0, 1], [1, 3, 2], [1, 1, 2]]; p = matmul(a, inverse(a)); i = identity(3); [abs(p#r#c - i#r#c) < 0.000000001 for r in 1 to 3 for c in 1 to 3].all(x => x)'	yes
'use matrix; try inverse([[1, 2], [2, 4]]) else "singular"'	"singular"
'use matrix; x = solve([[2, 1, -1], [-3, -1, 2], [-2, 1, 2]], [8, -11, -3]); abs(x#1 - 2) + abs(x#2 - 3) + abs(x#3 + 1) < 0.000000001'	yes
'use matrix; x = solve([[0, 1], [1, 1]], [2, 3]); abs(x#1 - 1) + abs(x#2 - 2) < 0.000000001'	yes
'use matrix; try determinant([[1, 2, 3], [4, 5, 6]]) else "not square"'	"not square"
'use matrix; try solve([[1, 0], [0, 1]], [1, 2, 3]) else "size mismatch"'	"size mismatch"
'use matrix; try solve([[1, 2], [2, 4]], [1, 2]) else "singular"'	"singular"
