# fractions: helpers over the core rational kind (lib/fractions.warp, card lib-fractions); expected values from python3 fractions; asserted via numerator and denominator

# parse_fraction
«use fractions; nd(x) := [numerator(x), denominator(x)]; [nd(parse_fraction("3/4")), nd(parse_fraction("-3/4")), nd(parse_fraction("1 1/2")), nd(parse_fraction("-1 1/2")), nd(parse_fraction("7")), nd(parse_fraction("-12")), nd(parse_fraction(" 10 / 4 ")), nd(parse_fraction("+2 3/8")), nd(parse_fraction("0/5")), nd(parse_fraction("6/3"))] == [[3, 4], [-3, 4], [3, 2], [-3, 2], [7, 1], [-12, 1], [5, 2], [19, 8], [0, 1], [2, 1]]»	true

# from_decimal (exact)
«use fractions; nd(x) := [numerator(x), denominator(x)]; [nd(from_decimal("0.125")), nd(from_decimal("-1.5e-3")), nd(from_decimal("12.")), nd(from_decimal(".5")), nd(from_decimal("3")), nd(from_decimal("2.5E2")), nd(from_decimal("-0.0001")), nd(from_decimal("123456789.987654321"))] == [[1, 8], [-3, 2000], [12, 1], [1, 2], [3, 1], [250, 1], [-1, 10000], [123456789987654321, 1000000000]]»	true

# from_float: the binary value exactly, as Python Fraction(float)
«use fractions; nd(x) := [numerator(x), denominator(x)]; [nd(from_float(0.1)), nd(from_float(1.5)), nd(from_float(-2.75)), nd(from_float(1152921504606846976.0)), nd(from_float(0.0)), nd(from_float(0.3)), nd(from_float(123.456)), nd(from_float(2.0 ** 62))] == [[3602879701896397, 36028797018963968], [3, 2], [-11, 4], [1152921504606846976, 1], [0, 1], [5404319552844595, 18014398509481984], [8687443681197687, 70368744177664], [4611686018427387904, 1]]»	true

# limit_denominator: Python semantics
«use fractions; nd(x) := [numerator(x), denominator(x)]; [nd(limit_denominator(3141592653589793 / 1000000000000000, 1)), nd(limit_denominator(3141592653589793 / 1000000000000000, 10)), nd(limit_denominator(3141592653589793 / 1000000000000000, 100)), nd(limit_denominator(3141592653589793 / 1000000000000000, 1000)), nd(limit_denominator(3141592653589793 / 1000000000000000, 100000)), nd(limit_denominator(-7 / 10, 2)), nd(limit_denominator(1 / 3, 1)), nd(limit_denominator(5 / 8, 3)), nd(limit_denominator(5 / 8, 8)), nd(limit_denominator(100000000000000001 / 100000000000000000, 100)), nd(limit_denominator(1 / 3, 2)), nd(limit_denominator(-1 / 3, 2))] == [[3, 1], [22, 7], [311, 99], [355, 113], [312689, 99532], [-1, 2], [0, 1], [2, 3], [5, 8], [1, 1], [1, 2], [-1, 2]]»	true

# mixed_text
«use fractions; nd(x) := [numerator(x), denominator(x)]; [mixed_text(3 / 2), mixed_text(-3 / 2), mixed_text(-1 / 2), mixed_text(4), mixed_text(22 / 7), mixed_text(-355 / 113), mixed_text(0)] == ["1 1/2", "-1 1/2", "-1/2", "4", "3 1/7", "-3 16/113", "0"]»	true

# continued_fraction (floor terms) and from_continued_fraction round trip
«use fractions; nd(x) := [numerator(x), denominator(x)]; [continued_fraction(415 / 93), continued_fraction(-7 / 3), continued_fraction(355 / 113), continued_fraction(5), continued_fraction(1 / 7), continued_fraction(3141592653589793 / 1000000000000000), nd(from_continued_fraction(continued_fraction(415 / 93))), nd(from_continued_fraction(continued_fraction(-7 / 3))), nd(from_continued_fraction(continued_fraction(355 / 113))), nd(from_continued_fraction(continued_fraction(5))), nd(from_continued_fraction(continued_fraction(1 / 7))), nd(from_continued_fraction(continued_fraction(3141592653589793 / 1000000000000000))), nd(from_continued_fraction([1, 2, 2, 2, 2, 2, 2, 2])), nd(from_continued_fraction([0, 1, 1, 1]))] == [[4, 2, 6, 7], [-3, 1, 2], [3, 7, 16], [5], [0, 7], [3, 7, 15, 1, 292, 1, 1, 1, 2, 1, 3, 1, 14, 4, 2, 3, 1, 12, 5, 1, 5, 20, 1, 11, 1, 1, 1, 2], [415, 93], [-7, 3], [355, 113], [5, 1], [1, 7], [3141592653589793, 1000000000000000], [577, 408], [2, 3]]»	true

# fraction_pow: exact integer powers
«use fractions; nd(x) := [numerator(x), denominator(x)]; [nd(fraction_pow(2 / 3, 2)), nd(fraction_pow(2 / 3, -3)), nd(fraction_pow(-3 / 5, 3)), nd(fraction_pow(-3 / 5, -2)), nd(fraction_pow(7, 0)), nd(fraction_pow(0, 5)), nd(fraction_pow(1 / 2, 62))] == [[4, 9], [27, 8], [-27, 125], [25, 9], [1, 1], [0, 1], [1, 4611686018427387904]]»	true

# refusals
«use fractions; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> parse_fraction("1/0")), attempt(() -> parse_fraction("1 3/2")), attempt(() -> parse_fraction("0.5")), attempt(() -> parse_fraction("")), attempt(() -> parse_fraction("1/2/3")), attempt(() -> parse_fraction("x/2")), attempt(() -> from_decimal("1.2.3")), attempt(() -> from_float(1e-30)), attempt(() -> fraction_pow(0, -1)), attempt(() -> fraction_pow(10, 30)), attempt(() -> limit_denominator(1 / 3, 0)), attempt(() -> from_continued_fraction([])), attempt(() -> from_continued_fraction([1, 0])), attempt(() -> from_float(1e-10))] == ["parse_fraction: a zero denominator in 1/0", "parse_fraction: the mixed number 1 3/2 needs a proper fraction part (n < d)", "parse_fraction: 0.5 is a decimal; use from_decimal", "parse_fraction of an empty text", "parse_fraction: more than one / in 1/2/3", "parse_fraction: x is not a digit in x/2", "from_decimal: . is not a digit in 1.2.3", "from_float of 1e-30: its exact denominator 2^147 leaves the 64-bit range of the core's ints", "fraction_pow: 0 to the negative power -1", "fraction_pow: the result leaves the 64-bit range of the core's ints", "limit_denominator needs a max_denominator of at least 1, not 0", "from_continued_fraction of an empty list", "from_continued_fraction: a tail of value 0 to divide by in [1, 0]", "from_float of 1e-10: its exact denominator 2^86 leaves the 64-bit range of the core's ints"]»	true

