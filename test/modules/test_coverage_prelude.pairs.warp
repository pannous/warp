# coverage audit (card lib-coverage-audit): prelude words that had no test line; expected values from their doc comments and sibling words

# one-character class tests and whole-text class tests (ASCII classes, as the prelude's comments say)
«[is_digit_text("7"), is_digit_text("77"), is_digit_text(""), is_letter_text("a"), is_letter_text("é"), is_letter_text("ab")] == [yes, no, no, yes, no, no]»	true
«[is_digits("0123"), is_digits(""), is_digits("1 2"), is_digits("١٢"), is_letters("abcXYZ"), is_letters(""), is_letters("a1"), is_hex("DEADbeef"), is_hex(""), is_hex("0x1f")] == [yes, no, no, no, yes, no, no, yes, no, no]»	true
«[is_hex_digit("a"), is_hex_digit("F"), is_hex_digit("g"), is_hex_digit("9"), is_word_char("_"), is_word_char("a"), is_word_char("5"), is_word_char("-")] == [yes, yes, no, yes, yes, yes, yes, no]»	true
«[consists_of("123", is_digit), consists_of("", is_digit), consists_of("12a", is_digit), is_integer("42"), is_integer("-42"), is_integer("4.2"), is_integer(""), is_integer("-")] == [yes, no, no, yes, yes, no, no, no]»	true

# number parts of a text: ø when the text is not one
«[unsigned("-12"), unsigned("12"), unsigned(""), int_part("12"), int_part("-12"), int_part("1.5"), int_part(""), float_part("-0.25"), float_part("3"), float_part("1.2.3"), float_part(".5"), unmarked("$a", "$"), unmarked("a", "$")] == ["12", "12", "", 12, -12, nil, nil, -0.25, 3, nil, nil, "a", "a"]»	true

# radix texts and bases (from_base refuses a digit outside the base)
«[radix_text(255, 16, "0x"), radix_text(-10, 2, "0b"), radix_text(0, 8, "0o"), binary_text(5), binary_text(0), binary_text(-3), from_base("ff", 16), from_base("FF", 16), from_base("z", 36), to_base(255, 16), to_base(0, 2)] == ["0xFF", "-0b1010", "0o0", "0b101", "0b0", "-0b11", 255, 255, 35, "ff", "0"]»	true
«attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> from_base("9", 8)), attempt(() -> from_base("", 10)), attempt(() -> from_base("1g", 16)), attempt(() -> from_base("1", 1))] == ["from_base: 9 is not a base-8 digit in 9", "from_base of an empty text", "from_base: g is not a base-16 digit in 1g", "from_base: the base 1 is not 2 to 36"]»	true

# maps as entries, sorting by a key (stable), counting, roots, decimals
«[map_entries({"a": 1, "b": 2}), map_entries({}), map_without({"a": 1, "b": 2}, "a"), map_without({"a": 1}, "z")] == [[["a", 1], ["b", 2]], [], {"b": 2}, {"a": 1}]»	true
«[sorted_by_key(["ccc", "a", "bb"], w => count(w)), sorted_by_key(["b1", "a2", "b0", "a1"], w => w[0]), sorted_by_key([], w => w), as_list("ab😀"), count_item([1, 2, 1, 1], 1), count_item([], 1)] == [["a", "bb", "ccc"], ["a2", "a1", "b1", "b0"], [], ["a", "b", "😀"], 3, 0]»	true
«[fourth_root(16), fourth_root(0), fourth_root(81.0), as_decimal(1/4), as_decimal(5), as_decimal(-3/8)] == [2, 0, 3, "0.25", "5", "-0.375"]»	true

# thrice runs its block three times
«n = 0; thrice { n = n + 1 }; n»	3

# text basics on multi-byte and emoji text
«[reverse("héllo😀"), reverse(""), count("😀é"), count(""), first("😀b"), last("a😀"), upper("straße"), lower("ÄÖÜ"), ord("😀"), chr(233), join(["😀", "é"], "-"), join([], ",")] == ["😀olléh", "", 2, 0, "😀", "😀", "STRASSE", "äöü", 128512, "é", "😀-é", ""]»	true
«[starts_with("😀ab", "😀"), starts_with("", ""), starts_with("", "a"), ends_with("ab😀", "😀"), replace("😀😀", "😀", "x"), replace("aaa", "a", "b"), split("a,b,,c", ","), split("", ","), trim("\\t\\n x \\n"), slice("héllo", 1), slice("héllo", 1, 3)] == [yes, yes, no, yes, "xx", "bbb", ["a", "b", "", "c"], [""], "x", "éllo", "él"]»	true
«attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> first([])), attempt(() -> find("hello", "z"))] == ["index out of range", "ValueError: \\"z\\" is not in \\"hello\\""]»	true
