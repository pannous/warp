# days_in_month refuses a month outside 1..12 (it gave 31 for 13); padded keeps a minus sign in front (it gave "0-5"): fix(lib), card lib-coverage-audit
«use time; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> days_in_month(2024, 13)), attempt(() -> days_in_month(2024, 0)), attempt(() -> days_in_month(2024, -1))] == ["days_in_month: the month 13 is not 1 to 12", "days_in_month: the month 0 is not 1 to 12", "days_in_month: the month -1 is not 1 to 12"]»	true
«use time; [padded(5, 3), padded(-5, 3), padded(-123, 2), padded(0, 2), padded(1234, 2), padded(7, 0)] == ["005", "-05", "-123", "00", "1234", "7"]»	true
