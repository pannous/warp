# behaviour pinned by Supervisor decision (lib-coverage-audit-2): each of these is deliberate, not a bug
# deliberate: an empty part is counted 0 times (not Python's len+1)
«count_of("abc", "") == 0»	true
# deliberate: format_duration is coarse and drops milliseconds
«use time; format_duration(1500) == "1s"»	true
