# an implicit use is the standard module, never a same-named file beside the program (decision implicit-use-lib-first)
'../fixtures/implicit_lib/main.warp'	6

# a word several standard modules define is the one module's that takes the call's arguments: math's dot(u, v), draw's dot(x, y, color) (card dot-product-definition)
'dot([1, 2], [3, 4])'	11
'dot(1)'	error
