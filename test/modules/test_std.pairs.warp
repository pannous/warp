'use os; count(args)'	0

# from test_std_exec.rs: edit the Rust test, then run the script again

# exec_gives_what_the_command_printed
# — native only: a page runs no process or shell (decision page-host-lines)
'exec sh "echo hello world"'	'hello world'
'word="a; rm -rf ~";exec sh "echo $word"'	'a; rm -rf ~'
'text="a\\nb";split(exec sh "echo $text", "\\n")#2'	'b'

