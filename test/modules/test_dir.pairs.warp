# from test_dir.rs: edit the Rust test, then run the script again

# dir_lists_the_names_of_a_standard_module
'"weekday" in dir(time)'	true
'"add_days" in dir(time)'	true
'names = dir text; names#1'	'any'
'use time; #dir(time) > 5'	true

# a_program_s_own_dir_wins
'dir(x) := x + 1; dir(3)'	4
'time = 5; dir(x) := x * 2; dir(time)'	10

# from test_dir_value_methods.rs: edit the Rust test, then run the script again

# dir_of_a_value_lists_its_types_methods
'xs=[3 4]; dir(xs) == dir(list)'	true
'f(v) := dir(v); f([1]) == dir(list)'	true
