# window refuses a size below 1, as chunk does (window([1, 2, 3], 0) gave [[], [], [], []]): fix(lib), card window-empty-windows
«use list; attempt(f) := try { str(f()) } catch e { "" + e }; [attempt(() -> window([1, 2, 3], 0)), attempt(() -> window([1, 2], -1)), window([1, 2, 3], 1), window([1, 2, 3], 3), window([1, 2, 3], 5)] == ["window needs a size of at least 1, not 0", "window needs a size of at least 1, not -1", [[1], [2], [3]], [[1, 2, 3]], []]»	true
