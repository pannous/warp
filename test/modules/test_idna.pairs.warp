// (S) -> $1.00 <-
'use idna; punycode_encode([45, 62, 32, 36, 49, 46, 48, 48, 32, 60, 45])'	"-> $1.00 <--"
'use idna; punycode_decode_points("-> $1.00 <--")'	[45, 62, 32, 36, 49, 46, 48, 48, 32, 60, 45]
// (I) above is written with the RFC's mixed-case annotation D, which decoding reads as d; encoding writes lowercase
'use idna; punycode_encode("bücher")'	"bcher-kva"
'use idna; punycode_decode("bcher-kva")'	"bücher"
'use idna; try { punycode_decode("abc-!") } catch e { e.message }'	"punycode: ! is no punycode digit"
// domain_to_ascii and domain_to_unicode: lowercase, NFC, xn-- labels, the IDNA dots; python's idna codec agrees, lowercased (it keeps the case of ASCII labels, UTS #46 lowercases them)
'use idna; domain_to_ascii("bücher.example")'	"xn--bcher-kva.example"
'use idna; domain_to_unicode("xn--bcher-kva.example")'	"bücher.example"
'use idna; domain_to_ascii("München.DE")'	"xn--mnchen-3ya.de"
'use idna; domain_to_unicode("xn--mnchen-3ya.de")'	"münchen.de"
'use idna; domain_to_ascii("www.Bücher.de")'	"www.xn--bcher-kva.de"
'use idna; domain_to_unicode("www.xn--bcher-kva.de")'	"www.bücher.de"
'use idna; domain_to_ascii("例え.テスト")'	"xn--r8jz45g.xn--zckzah"
'use idna; domain_to_unicode("xn--r8jz45g.xn--zckzah")'	"例え.テスト"
'use idna; domain_to_ascii("παράδειγμα.δοκιμή")'	"xn--hxajbheg2az3al.xn--jxalpdlp"
'use idna; domain_to_unicode("xn--hxajbheg2az3al.xn--jxalpdlp")'	"παράδειγμα.δοκιμή"
'use idna; domain_to_ascii("ドメイン名例.jp")'	"xn--eckwd4c7cu47r2wf.jp"
'use idna; domain_to_unicode("xn--eckwd4c7cu47r2wf.jp")'	"ドメイン名例.jp"
'use idna; domain_to_ascii("abc.example.com")'	"abc.example.com"
'use idna; domain_to_unicode("abc.example.com")'	"abc.example.com"
'use idna; domain_to_ascii("example.com.")'	"example.com."
'use idna; domain_to_unicode("example.com.")'	"example.com."
'use idna; domain_to_ascii("例え。テスト")'	"xn--r8jz45g.xn--zckzah"
'use idna; domain_to_ascii("bücher．example｡com")'	"xn--bcher-kva.example.com"
'use idna; domain_to_ascii("über.example")'	"xn--ber-goa.example"
// non-transitional: ß stays ß (python's IDNA 2003 codec would map it to ss)
'use idna; domain_to_ascii("straße.de")'	"xn--strae-oqa.de"
'use idna; domain_to_unicode("XN--BCHER-KVA.Example")'	"bücher.example"
'use idna; try { domain_to_ascii("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com") } catch e { e.message }'	"domain_to_ascii: the label aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa is longer than 63 characters"
