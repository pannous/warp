'use idna; punycode_encode([23433, 23460, 22856, 32654, 24693, 45, 119, 105, 116, 104, 45, 83, 85, 80, 69, 82, 45, 77, 79, 78, 75, 69, 89, 83])'	"-with-SUPER-MONKEYS-pc58ag80a8qai00g7n9n"
