// lib/idna.warp Punycode: every RFC 3492 section 7.1 sample (A-S), its code points to its ASCII and back (card lib-encodings-more)
// (A) Arabic (Egyptian):
'use idna; punycode_encode([1604, 1610, 1607, 1605, 1575, 1576, 1578, 1603, 1604, 1605, 1608, 1588, 1593, 1585, 1576, 1610, 1567])'	"egbpdaj6bu4bxfgehfvwxn"
'use idna; punycode_decode_points("egbpdaj6bu4bxfgehfvwxn")'	[1604, 1610, 1607, 1605, 1575, 1576, 1578, 1603, 1604, 1605, 1608, 1588, 1593, 1585, 1576, 1610, 1567]
// (B) Chinese (simplified):
'use idna; punycode_encode([20182, 20204, 20026, 20160, 20040, 19981, 35828, 20013, 25991])'	"ihqwcrb4cv8a8dqg056pqjye"
'use idna; punycode_decode_points("ihqwcrb4cv8a8dqg056pqjye")'	[20182, 20204, 20026, 20160, 20040, 19981, 35828, 20013, 25991]
// (C) Chinese (traditional):
'use idna; punycode_encode([20182, 20497, 29234, 20160, 40637, 19981, 35498, 20013, 25991])'	"ihqwctvzc91f659drss3x8bo0yb"
'use idna; punycode_decode_points("ihqwctvzc91f659drss3x8bo0yb")'	[20182, 20497, 29234, 20160, 40637, 19981, 35498, 20013, 25991]
// (D) Czech: Pro<ccaron>prost<ecaron>nemluv<iacute><ccaron>esky
'use idna; punycode_encode([80, 114, 111, 269, 112, 114, 111, 115, 116, 283, 110, 101, 109, 108, 117, 118, 237, 269, 101, 115, 107, 121])'	"Proprostnemluvesky-uyb24dma41a"
'use idna; punycode_decode_points("Proprostnemluvesky-uyb24dma41a")'	[80, 114, 111, 269, 112, 114, 111, 115, 116, 283, 110, 101, 109, 108, 117, 118, 237, 269, 101, 115, 107, 121]
// (E) Hebrew:
'use idna; punycode_encode([1500, 1502, 1492, 1492, 1501, 1508, 1513, 1493, 1496, 1500, 1488, 1502, 1491, 1489, 1512, 1497, 1501, 1506, 1489, 1512, 1497, 1514])'	"4dbcagdahymbxekheh6e0a7fei0b"
'use idna; punycode_decode_points("4dbcagdahymbxekheh6e0a7fei0b")'	[1500, 1502, 1492, 1492, 1501, 1508, 1513, 1493, 1496, 1500, 1488, 1502, 1491, 1489, 1512, 1497, 1501, 1506, 1489, 1512, 1497, 1514]
