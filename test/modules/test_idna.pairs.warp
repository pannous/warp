'use idna; punycode_decode_points("Hello-Another-Way--fc4qua05auwb3674vfr0b")'	[72, 101, 108, 108, 111, 45, 65, 110, 111, 116, 104, 101, 114, 45, 87, 97, 121, 45, 12381, 12428, 12382, 12428, 12398, 22580, 25152]
