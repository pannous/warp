// lib/compress.warp inflate, gunzip and zlib_decompress on vectors made by python3 zlib/gzip and the system gzip (card lib-deflate)
'use compress; use encoding; inflate(hex_decode_bytes("0300"))'	[]
'use compress; use encoding; inflate_text(hex_decode_bytes("cb48cdc9c90700"))'	"hello"
// back-references, the run of a's an overlapping copy (distance 1)
'use compress; use encoding; inflate_text(hex_decode_bytes("4b4c4a4ec48d141289000ac83a00"))'	"abcabcabcabcabcabcabcabcabcabc aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa abcabcabcabc"
// 1742 bytes python compresses with a dynamic Huffman block (BTYPE 2)
'use compress; use encoding; inflate_text(hex_decode_bytes(""))'	"seven jumps quietly farmers quick brown zebras fox wizards near quick jumping the quick brown box box brown lazy brown zebras box quick near fox lazy farmers farmers near quick near near quietly quick lazy quick zebras jumps while box jumps zebras fox near while zebras over fox near near farmers the wizards fox zebras brown near quick vexed the judge zebras box seven and near and wizards while lazy over lazy brown near while jumping judge seven and while vexed brown fox jumping box over seven jumps judge box quick brown zebras near seven seven wizards vexed judge near and brown brown dog judge brown quick while farmers near and while quietly wizards the and wizards over vexed fox judge quick the while jumps lazy quietly quietly judge brown over and quietly zebras dog jumps box zebras dog box wizards quietly lazy jumps brown over jumps lazy lazy the judge near over dog while the jumps box zebras wizards vexed near seven jumps jumping vexed farmers quick and zebras quietly quietly quietly quietly fox judge farmers quietly quick the brown the and over fox seven vexed quick fox the near jumps zebras fox wizards vexed the brown the vexed quietly jumps farmers dog wizards vexed wizards judge fox fox judge and judge judge while brown jumps fox seven dog judge over jumping the the jumping wizards jumps zebras the jumping while farmers brown dog jumping wizards over wizards lazy zebras zebras jumping seven farmers lazy vexed the lazy quietly lazy the jumping judge wizards the the dog judge dog the vexed wizards and wizards wizards brown lazy fox lazy judge the seven the judge vexed vexed the judge farmers wizards farmers brown fox quietly the judge over box farmers seven brown quietly and quietly brown over over jumps the"
'use compress; use encoding; zlib_decompress_text(hex_decode_bytes(""))'	"seven jumps quietly farmers quick brown zebras fox wizards near quick jumping the quick brown box box brown lazy brown zebras box quick near fox lazy farmers farmers near quick near near quietly quick lazy quick zebras jumps while box jumps zebras fox near while zebras over fox near near farmers the wizards fox zebras brown near quick vexed the judge zebras box seven and near and wizards while lazy over lazy brown near while jumping judge seven and while vexed brown fox jumping box over seven jumps judge box quick brown zebras near seven seven wizards vexed judge near and brown brown dog judge brown quick while farmers near and while quietly wizards the and wizards over vexed fox judge quick the while jumps lazy quietly quietly judge brown over and quietly zebras dog jumps box zebras dog box wizards quietly lazy jumps brown over jumps lazy lazy the judge near over dog while the jumps box zebras wizards vexed near seven jumps jumping vexed farmers quick and zebras quietly quietly quietly quietly fox judge farmers quietly quick the brown the and over fox seven vexed quick fox the near jumps zebras fox wizards vexed the brown the vexed quietly jumps farmers dog wizards vexed wizards judge fox fox judge and judge judge while brown jumps fox seven dog judge over jumping the the jumping wizards jumps zebras the jumping while farmers brown dog jumping wizards over wizards lazy zebras zebras jumping seven farmers lazy vexed the lazy quietly lazy the jumping judge wizards the the dog judge dog the vexed wizards and wizards wizards brown lazy fox lazy judge the seven the judge vexed vexed the judge farmers wizards farmers brown fox quietly the judge over box farmers seven brown quietly and quietly brown over over jumps the"
// zlib level 0: a stored block
'use compress; use encoding; zlib_decompress_text(hex_decode_bytes("7801010c00f3ff68656c6c6f2073746f7265641ed504c6"))'	"hello stored"
'use compress; use encoding; zlib_decompress_text(hex_decode_bytes("789c030000000001"))'	""
// the system gzip of greeting.txt: FNAME set
'use compress; use encoding; gunzip_text(hex_decode_bytes("1f8b0808796beb6a00036772656574696e672e74787400f348cdc9c95748afca2c5028cf2cc9504854c84bcc4de50200663db01b17000000"))'	"Hello gzip with a name\n"
// FEXTRA, FNAME, FCOMMENT and FHCRC all set; two members
'use compress; use encoding; gunzip_text(hex_decode_bytes("1f8b081e0000000000030400616201026e616d652e747874006120636f6d6d656e7400ebac4bcb494c2f0600ba41050b05000000"))'	"flags"
'use compress; use encoding; gunzip_text(hex_decode_bytes("1f8b08000000000002ff4bcb2c2a2e510000fc7af11c060000001f8b08000000000002ff2b4e4dcecf4b010069111fb606000000"))'	"first second"
// corrupt input raises
'use compress; use encoding; try { inflate([7]) } catch e { e.message }'	"inflate: block type 3 is invalid"
'use compress; use encoding; try { inflate([1, 5, 0, 5, 0]) } catch e { e.message }'	"inflate: a stored block's length 5 does not match its complement 5"
'use compress; use encoding; try { inflate(hex_decode_bytes("0302")) } catch e { e.message }'	"inflate: distance 1 reaches before the start of the output (0 bytes)"
'use compress; use encoding; try { inflate(hex_decode_bytes("cb48cd")) } catch e { e.message }'	"inflate: the input is truncated at byte 3"
'use compress; use encoding; try { gunzip(hex_decode_bytes("1f8b0808796beb6a00036772656574696e672e74787400f348cdc9c95748afca2c5028cf2cc9504854c84bcc4de50200673db01b17000000")) } catch e { e.message }'	"gunzip: the CRC-32 check fails"
'use compress; use encoding; try { zlib_decompress(hex_decode_bytes("789c4b4cc9492d020005fa0208")) } catch e { e.message }'	"zlib: the Adler-32 check fails"
// cut inside the FNAME
'use compress; use encoding; try { gunzip(hex_decode_bytes("1f8b0808796beb6a00036772656574696e672e74")) } catch e { e.message }'	"gunzip: the header is truncated inside a name or comment"
