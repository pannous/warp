# ascii_fold, slugify, case conversions, truncate_words, normalize_whitespace (card lib-text-slugs)
'use slugs; ascii_fold("Crème brûlée")'	"Creme brulee"
'use slugs; ascii_fold("Straße Øresund Æther Œuvre ŁÓDŹ")'	"Strasse Oresund AEther OEuvre LODZ"
'use slugs; ascii_fold("Müller")'	"Muller"
'use slugs; ascii_fold("plain ascii 123")'	"plain ascii 123"
'use slugs; ascii_fold("")'	""
'use slugs; ascii_fold("日本 ok")'	"日本 ok"
'use slugs; ascii_fold_german("Müller Größe Äpfel")'	"Mueller Groesse Aepfel"
'use slugs; ascii_fold_german("Crème")'	"Creme"
'use slugs; slugify("  Hello, Wörld! Crème — brûlée  ")'	"hello-world-creme-brulee"
'use slugs; slugify("A B", "_")'	"a_b"
'use slugs; slugify("already-a-slug")'	"already-a-slug"
'use slugs; slugify("")'	""
'use slugs; slugify("!!!")'	""
'use slugs; to_snake("HTTPServer")'	"http_server"
'use slugs; to_snake("parseURL2Text")'	"parse_url2_text"
'use slugs; to_snake("already_snake_case")'	"already_snake_case"
'use slugs; to_snake("")'	""
'use slugs; to_kebab("XMLHttpRequest")'	"xml-http-request"
'use slugs; to_kebab("Hello World")'	"hello-world"
'use slugs; to_camel("http_server_error")'	"httpServerError"
'use slugs; to_camel("alreadyCamel")'	"alreadyCamel"
'use slugs; to_camel("")'	""
'use slugs; to_pascal("parse url")'	"ParseUrl"
'use slugs; to_pascal("HTTPServer")'	"HttpServer"
'use slugs; to_constant("parseURL2Text")'	"PARSE_URL2_TEXT"
'use slugs; to_constant("MAX_SIZE")'	"MAX_SIZE"
'use slugs; to_snake("v2Beta")'	"v2_beta"
'use slugs; truncate_words("one two  three four", 2)'	"one two…"
'use slugs; truncate_words("one two", 2)'	"one two"
'use slugs; truncate_words("", 3)'	""
'use slugs; normalize_whitespace("  a \t b\n c  ")'	"a b c"
'use slugs; normalize_whitespace("")'	""
