# a count in a text's hole, "${#xs}", counts: the hole parses as the program does (card interpolated-count-fail)
'xs = [1, 2]; "n ${#xs}"'	'n 2'
'xs = [1, 2, 3]; "${#xs} of ${#xs}"'	'3 of 3'
't = "abc"; "${#t}"'	'3'

# a literal in a text's hole is its text: the hole's tree is that number's view, no list (card interpolated-number-literal)
'c = "${12345}"; c'	'12345'
'"a${12}b"'	'a12b'
'"${1.5}"'	'1.5'
'"${-1} and ${1+2}"'	'-1 and 3'
