// lib/regex.warp match_groups and find_all_groups: capture groups through the host's replace (card lib-regex-groups-tempfiles)
'use regex; match_groups("v1.22", "v([0-9]+)\\.([0-9]+)")'	["1", "22"]
'use regex; match_groups("nope", "v([0-9]+)")'	ø
'use regex; find_all_groups("a=1, b=22", "([a-z])=([0-9]+)")'	[["a", "1"], ["b", "22"]]
'use regex; find_all_groups("x1 y2", "[a-z][0-9]")'	[[], []]
'use regex; find_all_groups("none here", "([0-9])")'	[]
'use regex; match_groups("ab", "(a)(x)?(b)")'	["a", "", "b"]
'use regex; match_groups("2026-11-05", "^([0-9]{4})-(1[0-2]|0[1-9])-([0-9]{2})$")'	["2026", "11", "05"]
'use regex; match_groups("key: value", "^([a-z]+): (.*)$")'	["key", "value"]
'use regex; find_all_groups("aXb aYb", "a(.)b")'	[["X"], ["Y"]]
'use regex; try { match_groups("a", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)") } catch e { e.message }'	"find_all_groups: 10 groups in (a)(b)(c)(d)(e)(f)(g)(h)(i)(j), the host captures at most 9"
'use regex; match_groups("[x](y)", "[[](x)[]][(]y[)]")'	["x"]
'use regex; regex_group_count("([a-z])[(]x[)](b)")'	2
