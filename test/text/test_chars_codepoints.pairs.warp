# from test_chars_codepoints.rs: edit the Rust test, then run the script again

# test_chars_is_a_list_of_characters
'type("abc".chars)'	'list of codepoint'
'type("abc".chars#1)'	'codepoint'
«type(['a' 'b']#1)»	'codepoint'
'type(split("a b", " "))'	'list of text'

# test_a_list_of_characters_prints_them_in_single_quotes
