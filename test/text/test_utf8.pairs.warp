# UTF-8 conversion: lib/text.warp UTF-8 contract
'use text; to_utf8("")'	[]
'use text; to_utf8("😀")'	[240, 159, 152, 128]
'use text; from_utf8([])'	""
'use text; from_utf8([240, 159, 152, 128])'	"😀"
