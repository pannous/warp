# a value shows as before where the program makes ratios, big ints or times: their texts are compiled only into a
# program making them, a plain list or text carries none (card shown-non)
'"" + [1, 2]'	"[1 2]"
'"" + [1/3, 2]'	"[1/3 2]"
'"" + 3 / 4'	"0.75"
'"" + 2 ^ 100'	"1267650600228229401496703205376"
'x = 2 ^ 100; "" + [x + 1]'	"[1267650600228229401496703205377]"
'"" + {a: 1, b: 2.5}'	"{a:1 b:2.5}"
'"x" + 3.5'	"x3.5"
