# from test_count_in.rs: edit the Rust test, then run the script again

# count_occurrences
«count 'a' in "banana"»	3
'count "an" in "banana"'	2
«s="banana"; count 'a' in s»	3
'count 2 in [1 2 2 3]'	2
'count 5 in [1 2 3]'	0
'xs=["a" "b" "a"]; count "a" in xs'	2
'count bytes in "äb"'	3
# one value, the emitter's count beside the prelude's count_in (card triage-count-in)
'xs = [1, 2, 3]; count xs'	3
'count([1, 2, 2], 2)'	2
'[1, 2, 2].count(2)'	2
