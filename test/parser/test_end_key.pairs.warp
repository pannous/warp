# a key or field named end is a name: it closes no `then` block, so a one-line if before it stays one line (card function-among)
'f(m: text): text := if m == "a" then "yes" else "no"; op = {block: 2, end: 11}; g() := 3; [f("a"), g(), op.end]'	["yes", 3, 11]
'class Span { start: int; end: int }; s = Span(1, 4); if s.end > 3 then "long" else "short"'	"long"
