# from test_number_glyphs.rs: edit the Rust test, then run the script again

# test_multi_digit_superscript_exponent
'2¹⁰'	1024
'x=2;x⁴'	16
'3⁴+1'	82

# test_vulgar_fractions_are_exact
'½+½'	1
'⅔*3'	2
'⅓+⅓+⅓==1'	true
'⅞'	0.875

# test_number_glyphs_at_end_of_input
'⅓*3'	1

# test_square_and_cube_inside_arithmetic
'3²+1'	10
'x=3;x²+1'	10
'2³*2'	16
'1+2³'	9

# a_glued_name_multiplies_every_number_literal
'x=9;⅓x'	3
'x=9;½x'	4.5
'x=9;⅓(x)'	3
'x=9;0.3̅x'	3
'x=2;3½x'	7
'⅓9'	3
