# a function's effects, what it does besides giving its value (card effects-lists, notes/effects.md)
'square(x) := x * x; square.effects'	[]
'shout(t) := print t; shout.effects'	['IO']
'shout(t) := print t; loud(t) := shout(t); loud.effects'	['IO']
# a raise or an Error made is the effect Fail (card error-gaps)
'half(x) := { if x < 0 { raise "negative" }; x / 2 }; half.effects'	['Fail']
'@pure half(x) := { if x < 0 { raise "negative" }; x / 2 }; half(4)'	error
# a raise a try catches is no Fail (card try-clears-fail)
'h(x) := try raise("a") else 0; h.effects'	[]
'h(x) := try { raise "a" } catch e { print e }; h.effects'	['IO']
