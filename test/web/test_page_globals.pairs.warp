'use markup; to_html(div{ button{ on click { print document.title } "Title" } })'	'<div><button data-warp-click="1">Title</button></div>'
'use markup; location = {city: "Rome"}; to_html(div{ p{ location.city } })'	'<div><p>Rome</p></div>'
'use markup; to_html(div{ input{ id: "who" } button{ on click { who.focus() } "Focus" } })'	'<div><input id="who"><button data-warp-click="1">Focus</button></div>'
