# words a painted function may call from lib/color and lib/geometry: hsv_rgb, a standard module's word WGSL lacks,
# written into the shader once as its WGSL function (lib/shaders.warp LIBRARY_FUNCTIONS); rotated_about translated from
# its warp body. Their values on the CPU first
'use color; [hsv_rgb(0, 1, 1), hsv_rgb(120, 1, 0.5), hsv_rgb(36, 0, 0.7)]'	[[1, 0, 0], [0, 0.5, 0], [0.7, 0.7, 0.7]]
# saturation free to leave 0…1, as twigl's hsv lets it
'use color; hsv_rgb(240, 2, 1)'	[-1, -1, 1]
'use geometry; r = rotated_about([1, 0, 0], [0, 0, 2], pi / 2); [abs(r#1) < 0.000001, abs(r#2 - 1) < 0.000001, abs(r#3) < 0.000001]'	[yes, yes, yes]
'use geometry; r = rotated_about([1, 2, 3], [1, 7, -0.3], 0.5); abs(norm(r) - norm([1, 2, 3])) < 0.000001'	yes
'use color; f(x, y) := hsv_rgb(x, 1, y) .+ hsv_rgb(y, 0.5, 1); w = shader_of(f); [w.contains("fn hsv_rgb(h: f32, s: f32, v: f32) -> vec3f"), #w.split("fn hsv_rgb(") == 2, w.contains("hsv_rgb(x, 1.0, y)")]'	[yes, yes, yes]
# a function of the program of the same name wins
'hsv_rgb(h, s, v) := [h, s, v]; f(x, y) := hsv_rgb(x, y, 1); shader_of(f).contains("fn hsv_rgb(h: f32, s: f32, v: f32) -> vec3f {\n\treturn vec3f(h, s, v);\n}")'	yes
'use geometry; f(x, y) := rotated_about([x, y, 1], [0, 1, 0], 0.5); shader_of(f).contains("fn rotated_about(v: vec3f, axis: vec3f, radians_: f32) -> vec3f {")'	yes
