'use markup; t = "abcdef"; to_html(div{ p{ t.upper() } })'	'<div><p>ABCDEF</p></div>'
'use markup; to_html(div{ p{ "abcdef"[0..2] } })'	'<div><p>ab</p></div>'
'use markup; to_html(div{ p{ abs(-2) } })'	'<div><p>2</p></div>'

'use markup; to_html(div{ if no then p{ "L" } else ul{ [li{ k } for k in [1, 2]] } })'	'<div><ul><li>1</li><li>2</li></ul></div>'
'use markup; to_html(div{ if no then "L" else abs(-2) })'	'<div>2</div>'
'use markup; to_html(div{ if yes then abs(-3) else "L" })'	'<div>3</div>'
