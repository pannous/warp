# Data blocks and data parameters (decisions data-parameter, data-names, data-parameters): a word nothing binds glued
# to its block is the data pair `word: […]`, its bound names their values, an unbound word a word; a parameter typed
# `data` takes its argument so

'use markup; to_html(div{ class: "box" h1{"Hi"} })'	'<div class="box"><h1>Hi</h1></div>'
'use markup; to_html(input{ type: email id: email })'	'<input type="email" id="email">'
'use markup; name = "Ann"; to_html(p{ "Hi " + name })'	'<p>Hi Ann</p>'
'use markup; xs = ["a", "b"]; to_html(ul{ [li{ x } for x in xs] })'	'<ul><li>a</li><li>b</li></ul>'
# a `for` among the items gives its items
'use markup; gs = ["a", "b"]; to_html(ul{ for g in gs { li{ g } } })'	'<ul><li>a</li><li>b</li></ul>'
'use markup; to_html(style{ .box { color: red } })'	'<style>.box { color: red }</style>'
'theme = "red"; f(x: data) := x; text(f{ color: theme ul })'	'{color: "red" ul}'
'f(x: data) := x; text(f{ a: 1 b })'	'{a: 1 b}'
# an instance written into a list inside a block is the instance (card html-div-syntax)
'class H { n: int }; v = (k: {[H(1)]}); v'	'k: {[H{n: 1}]}'
'class H { n: int }; v = (k: {f: H(1)}); v'	'k: {f: H{n: 1}}'
# a data parameter takes its block spaced as glued (decision spaced-tag): a word stays CSS, a selector a selector
'use markup; to_html(style { p { display: flex } })'	'<style>p { display: flex }</style>'
'use markup; done = 1; to_html(style { .done = "green" })'	'<style>.done { color: green }</style>'
'use markup; to_html(style { p { color: red } })'	'<style>p { color: red }</style>'
'f(x: data) := x; text(f { a: flex })'	'{a: flex}'
'f(x: data) := x; text(f { p { a: flex } })'	'{p: {a: flex}}'
