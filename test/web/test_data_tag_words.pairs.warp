# a prelude function glued to its block in data is the tag, not its call (decision data-tag-words: elements written glued)
'use markup; d = div{ first{ p{"a"} } }; str(d)'	"div: {first: {p: {'a'}}}"
'use markup; to_html(html{ head{ title: "x" } })'	"<html><head><title>x</title></head></html>"
# a one-statement program naming a standard module's word in its markup (`label{ for: …}`, `div{ "clamp" }`) is that element
'label{ for: "email", "clamp" }'	label{ for: "email", "clamp" }
