# Element handlers and live parts (wiki/html.md "Elements by id", card markup-keeps): a handler attribute holding a
# function is numbered by page_render (data-warp-click="1") and run by page_event; a function among the markup is a
# live part, its value now

'use markup; n = 0; tick = (event => n += 1); page_render(button{ "+" onclick: tick })'	'<button data-warp-click="1">+</button>'
'use markup; n = 0; label = () => "n " + n; tick = (event => n += 1); page = div{ button{ onclick: tick } p{ label } }; page_render(page); page_event(1, ø); page_render(page)'	'<div><button data-warp-click="1"></button><p>n 1</p></div>'
'use markup; n = 0; step = (event => n += event); page_render(div{ button{ onclick: step } }); page_event(1, 5); n'	5
'use markup; n = 1; to_html(div{ p{ () => n + 1 } })'	'<div><p>2</p></div>'

'use markup; greet(name: text) := p{ "hi " + name }; to_html(div{ "a", greet "Ann" })'	'<div>a<p>hi Ann</p></div>'
'use markup; count = 0; page = div{ button{ "+1", on click { count += 1 } } }; page_render(page)'	'<div><button data-warp-click="1">+1</button></div>'
'use markup; count = 0; page = div{ button{ "+1"\n on click { count += 1 } } }; page_render(page); page_event(1, ø); page_event(1, ø); count'	2
'count = 0; x = div{ button{ "+1", on click { count += 1 } } }; count'	0
'use markup; count = 0; page = div{ button{ "+1", on click { count += 1 } } p{ "count: " + count } }; page_render(page); page_event(1, ø); page_render(page)'	'<div><button data-warp-click="1">+1</button><p>count: 1</p></div>'
'use markup; done = no; page = p{ class: (if done then "done" else "open"), on click { done = yes }, "x" }; page_render(page); page_event(1, ø); page_render(page)'	'<p class="done" data-warp-click="1">x</p>'
