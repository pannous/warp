# a warp function f(x, y) giving a color [r, g, b] as one WGSL fragment shader (lib/prelude.warp paint rules, card
# warp-to-shaders): every number an f32, a list of 2 to 4 numbers a vecNf, the program values it reads paint's values
'f(x, y) := [x / 96, y / 54, 0.5]; shader_of(f).contains("fn f(x: f32, y: f32) -> vec3f {\n\treturn vec3f((x / 96.0), (y / 54.0), 0.5);\n}")'	yes
'f(x, y) := [x, y, 1] .* 0.5; shader_of(f).contains("@fragment fn main(@builtin(position) position: vec4f) -> @location(0) vec4f")'	yes
'use math; f(x, y) := [cosine(x), sine(y), norm([x, y])]; shader_of(f).contains("vec3f(cos(x), sin(y), length(vec2f(x, y)))")'	yes
'time = 0.5; f(x, y) := [x, y, time]; shader_of(f).contains("values.time")'	yes
'f(x, y) := [x, y]; shader_of(f)'	error	a painted function gives a color of three numbers
'f(x, y) := [x, f(y, x)#1, 0]; shader_of(f)'	error	WGSL has no recursion
'f(x, y) := x > y; shader_of(f).contains("select(vec3f(0.98039216), vec3f(0.11372549), f(position.x - 0.5, position.y - 0.5))")'	yes
'f(x, y) := { i = 0; while i < x { i = i + 1 }; [i, y, 0] }; shader_of(f).contains("while ((i < x)) {")'	yes
'f(x, y) := round(x / 2); shader_of(f).contains("sign(((x / 2.0))) * floor(abs(((x / 2.0))) + 0.5)")'	yes
