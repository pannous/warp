# `$who` is the value of the page's field with the id who (card who-handler-read, decision page-ids)
is! 'use web; greeting = "-"; page: html = div{ input{ id: "who" } button{ on click { greeting = "Hello " + $who }, "Greet" } }; render page; $who = "Ann"; click "Greet"; greeting' "Hello Ann"  // needs: js
is! 'use web; page: html = div{ input{ id: "who" } }; $who = "Ann"; render page' '<div><input id="who" value="Ann"></div>'  // needs: js
is! 'use web; $who' ""
