# on mount / on cleanup of a component (lib/markup.warp component_moments, card mount-cleanup-handlers):
# mount when an instance first renders, cleanup when a later render drops it (tour cleanup)

'use web; seen = []; def Fruit(label) { name = label; on mount { seen.add("hello " + name) }; on cleanup { seen.add("bye " + name) }; span{ name + " " } }; pears = true; page = div{ button{ on click { pears = false }, "hide pears" } Fruit("apples") (if pears then Fruit("pears") else []) }; render page; seen'	["hello apples", "hello pears"]
'use web; seen = []; def Fruit(label) { name = label; on mount { seen.add("hello " + name) }; on cleanup { seen.add("bye " + name) }; span{ name + " " } }; pears = true; page = div{ button{ on click { pears = false }, "hide pears" } Fruit("apples") (if pears then Fruit("pears") else []) }; render page; click "hide pears"; seen'	["hello apples", "hello pears", "bye pears"]
'use web; seen = []; def Fruit(label) { name = label; on mount { seen.add("hello " + name) }; on cleanup { seen.add("bye " + name) }; span{ name + " " } }; pears = true; page = div{ button{ on click { pears = false }, "hide pears" } Fruit("apples") (if pears then Fruit("pears") else []) }; render page; click "hide pears"'	'<div><button data-warp-click="1">hide pears</button><span>apples </span></div>'
'use web; seen = []; def Box(label) { name = label; span{ on mount { seen.add("hi " + name) }, on cleanup { seen.add("bye " + name) }, name } }; show = true; page = div{ button{ on click { show = false }, "hide" } (if show then Box("x") else []) }; render page; click "hide"; seen'	["hi x", "bye x"]
