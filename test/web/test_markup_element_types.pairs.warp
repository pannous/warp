# Element and attribute rendering while typing markup predicates
'use markup; to_html(div{class: "box", "Hello"})'	'<div class="box">Hello</div>'
'use markup; to_html(my-card{"Hi"})'	'<my-card>Hi</my-card>'
'use markup; to_html(div{data-id: "a", "ok"})'	'<div data-id="a">ok</div>'
# a tag named like a function that can't take its block stays the element: lib/markup's form(method, action, body) (card core-markup-form-word)
'use markup; to_html(form{ method: "post" action: "/t" })'	'<form method="post" action="/t"></form>'
# a class name has no dot: the selector's .card is refused (card div-class)
'use markup; to_html(div{class: .card, "x"})'	error	an attribute value has no dot
