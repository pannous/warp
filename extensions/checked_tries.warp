# The tries whose error wasm cannot catch, checked before it happens (card compiler-untaken-lines), and `assert c else
# m`; run right before tries, so core tries.warp guards what they leave as any try:
#   try a / b else y    → (try·divisor = b; if try·divisor == 0 then {y} else {try a / try·divisor else y})
#   try [1 2]#i else y  → (try·list = [1 2]; try·index = i; if 1 <= try·index <= count(try·list) then … else {y})
#   try x = a / b else y → x = (the checked division)
#   assert c else m     → if c then {1} else {raise m}
checked_form(n: Node): Node := match n {
	List(parts, Bracket.Round, Separator.None): {
		if #parts == 3 and parts#1 == symbol(HiddenWord.AssertElse as text) { return assertion(parts#2, parts#3) }
		if #parts != 3 or parts#1 != symbol(HiddenWord.TryElse as text) { return n }
		checked = checked_try(parts#2, parts#3)
		if checked == ø then n else checked
	}
	_: n
}

# the checked form of `try value else fallback`, ø where the core's guard serves
checked_try(value: Node, fallback: Node): Node? := match value {
	Key(target, Op.Assign, assigned): {
		if not is_name(target) { return ø }
		checked = checked_try(assigned, fallback)
		if checked == ø then ø else try_assigned(target, checked)
	}
	Key(left, op, right): {
		if is_division(op) { return divided(left, op, right, fallback) }
		if op == Op.Hash and is_written_list(left) { return indexed(left, right, fallback) }
		ø
	}
	_: ø
}

is_division(op: Op): bool := op == Op.Div or op == Op.Mod or op == Op.Rem

# To do give one-line summaries to all functions where the meaning is not immediately clear from the context and name 
# todo number: int  Generalize to other numbers 
divided(dividend: Node, op: Op, divisor: Node, fallback: Node): Node := {
	held = try_name("divisor", fresh_number())
	quotient = applied_to(HiddenWord.TryElse as text, [Key(dividend, op, held), fallback])
	statements([try_assigned(held, divisor), chosen(Key(held, Op.Eq, 0), braced(fallback), braced(quotient))])
}

is_written_list(n: Node): bool := match n {
	List(written, Bracket.Square, separator): yes
	Text(t): yes
	_: no
}

# TODO this doesn't seem to belong to tries but to index.warp Which doesn't exist yet but should collect all the a[index] a#position syntax?  (card index-syntax-module)
indexed(written: Node, index: Node, fallback: Node): Node := {
	number = fresh_number()
	held = try_name("list", number)
	at = try_name("index", number)
	within = Key(Key(at, Op.Ge, 1), Op.And, Key(at, Op.Le, applied_to("count", [held])))
	statements([try_assigned(held, written), try_assigned(at, index), chosen(within, braced(Key(held, Op.Hash, at)), braced(fallback))])
}

# `assert c else m`, `check c`: 1 when c holds, else it raises m; not `asserted`, emitter.warp's, as the compiler's
# files share one namespace
assertion(condition: Node, message: Node): Node := chosen(condition, braced(1), braced(applied_to(raise_word, [message])))

checked_tries(program: Node): Node := bottom_up(program, checked_form)

checked_tries_extension = Extension{name: "checked_tries", passes_before: {"tries": checked_tries}}
