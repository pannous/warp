# Patterns
#
# A pattern describes the shape of a value: "a list of two things", "a map with a name", "a number above 5". Matching
# a value against a pattern answers two questions at once: does the value have this shape, and what are its parts?
# The parts a pattern names are bound as variables:
#
#   match [3, 4] {
#     [x, y] => x + y        // a list of two items: yes, so x = 3 and y = 4, and the result is 7
#     _ => 0                 // `_` fits anything and binds nothing
#   }
#
# The core compiler (core/passes/node_matches.warp) only knows the simplest arms: a value (`1 =>`), a type
# (`int =>`), a case of a node (`Key(left, op, right) =>`) and `_`. This compiler extension adds every other kind
# of pattern, by turning each such arm into a plain test plus the variables it binds.
#
# What this file adds, from simple to advanced:
#
#   [x, y] => …                 a list pattern; `[first, ...rest]` takes the remaining items as a list
#   {name} => …                 a map pattern: any map with the key name, bound as name
#   n if n > 5 => …             a guard: the pattern fits, then the condition must hold too
#   n => …                      a bare name fits anything and binds the whole value
#   "/user/" + id: int => …     a text cut: the text starts with "/user/", the rest read as an int
#   data($f($x)) => …           quoted code: a call of anything with one argument (for programs about programs)
#
# A pattern known whole at compile time, like `[a, b]`, is tested right where it stands; the others are handed
# to a matcher in the prelude that fits the value at run time.
#
# A pattern can also get a name, so it can be used in many places, like a type. In its body the parts it names are
# holes, written `$x` as in rules; any other word stands for itself:
#
#   pattern Point = [$x, $y]
#   [3, 4] is Point                        // yes
#   match v { Point => x + y }             // the arm uses the pattern's holes x and y
#
# Such a named pattern is a type with fields, its holes. Since the fields are known, it also builds a value, binds its
# fields by place in an arm, and lets a parameter of its type read them by name:
#
#   Point(3, 4)                            // [3, 4]
#   match v { Point(a, b) => a * b }       // a is the first hole of the pattern (x), b the second (y)
#   length(p: Point) := sqrt(p.x * p.x + p.y * p.y)
#
# The body may be code too, and matching code against it is how a compiler's rules take programs apart (wap's kernel
# forms are such patterns, wap/kernel/forms.wap):
#
#   pattern Choice = (choose $condition: Node $then: Node $else: Node)
#   Choice(c, a, b)                        // builds the code `(choose c a b)`
#   match n { Choice(c, a, b) => … }       // takes such code apart
#
# How named patterns build, bind and read is explained in "Named patterns" at the end of this file.

# whether the core lowers the arm itself
is_core_arm(arm: Node, variants: map) as bool := guard_of(arm_pattern(arm)) == ø and not is_name_arm(arm_pattern(arm), arm_result(arm), variants) and is_case_arm(arm, variants)

# the arms, the first the core does not lower and all after it as one arm `_`
guarded_arms(arms: list, subject: Node, variants: map) as list := {
	for at in 0 ..< #arms {
		if not is_core_arm(arms[at], variants) {
			rest = chained_arms(arms[at + 1 ..], subject, variants)
			return arms[0 ..< at] + [Key(symbol(other_arm), Op.Colon, guarded_arm(arms[at], subject, variants, rest))]
		}
	}
	arms
}

# a guarded, binding or structural arm: the pattern's test and its bindings, then the guard with them in sight, and the
# result with them; `otherwise` what the arms after it give
guarded_arm(arm: Node, subject: Node, variants: map, otherwise: Node) as Node := {
	guard = guard_of(arm_pattern(arm))
	pattern = quoted_holes_tight(guarded_pattern(arm_pattern(arm)))
	result = arm_result(arm)
	# ø: the pattern takes any subject
	test: Node = ø
	bound: list = []
	if is_name(pattern) and not is_other_arm(pattern) and (guard != ø or is_name_arm(pattern, result, variants)) { bound = [Key(pattern, Op.Assign, subject)] }
	else if is_value_pattern(pattern, variants) { test = value_test(subject, pattern) }
	else if is_type_pattern(pattern) { test = List([symbol("is_type"), subject, name_of(pattern)], Bracket.Round, Separator.None) }
	else if case_pattern(pattern) != ø { test = arm_test(case_pattern(pattern), subject); bound = part_bindings(case_pattern(pattern), subject) }
	else if direct_items(pattern, variants) != ø { test = items_test(subject, direct_items(pattern, variants)); bound = item_bindings(subject, direct_items(pattern, variants)) }
	else { test = structural_test(subject, pattern); bound = structural_bindings(pattern, List([guard, result], Bracket.Square, Separator.Comma)) }
	if guard != ø {
		guarded = List(bound + [guard], Bracket.Round, Separator.Semicolon)
		test = if test == ø then guarded else Key(test, Op.And, guarded)
	}
	value = if #bound == 0 then result else List(bound + [result], Bracket.Round, Separator.Semicolon)
	if test == ø then value else chosen(test, value, otherwise)
}

# A list pattern known whole at compile time, `[a, b]`, `["add", x, y]`, `[_, 0]`: tested and bound in place, item by
# item, with no call of the prelude's matcher (card pattern-direct-tests). Its items are names binding once, `_`, and
# numbers, texts or characters the item equals; any other list (a rest, a type word, a class of characters, a name
# twice, a nested pattern) stays pattern_bindings's at run time
direct_items(pattern: Node, variants: map) as list? := match pattern {
	List(items, Bracket.Square, separator): if #items > 0 and items.all(item => is_direct_item(item, variants)) and distinct_names(items) then items else ø
	_: ø
}
is_direct_item(item: Node, variants: map) as bool := match item {
	Number(value): yes
	Text(value): yes
	Char(value): yes
	Symbol(name): is_binding_word(name, variants)
	_: no
}
# a word binding the item as itself: no hole `$x`, rest `*xs`, type word, class of characters or declared variant
is_binding_word(name: text, variants: map) as bool := not (name.starts_with("$") or name.starts_with("*") or name.starts_with(".")) and not is_tested_type_word(name) and not (name in character_class_words) and not (name in variants)
distinct_names(items: list) as bool := {
	names = items.filter(item => item is symbol and name_of(item) != other_arm).map(item => name_of(item))
	#names == #names.unique()
}
# a list of as many items, each literal one equal
items_test(subject: Node, items: list) as Node := {
	test = Key(List([symbol("is_type"), subject, "list"], Bracket.Round, Separator.None), Op.And, Key(applied("count", subject), Op.Eq, #items))
	for at in 1 to #items {
		if not (items#at is symbol) { test = Key(test, Op.And, Key(Key(subject, Op.Hash, at), Op.Eq, items#at)) }
	}
	test
}
# each name the item at its place
item_bindings(subject: Node, items: list) as list := {
	bound = []
	for at in 1 to #items {
		if items#at is symbol and name_of(items#at) != other_arm { bound += [Key(items#at, Op.Assign, Key(subject, Op.Hash, at))] }
	}
	bound
}

# `data($k: int + $x)` reads `$k: (int + $x)`: within a pattern a hole's type binds the hole alone, `($k: int) + $x`,
# `$a: int * $b: int + $c` as `($a: int) * ($b: int) + $c`; any other pattern as written
quoted_holes_tight(pattern: Node) as Node := if is_quote(pattern) then group_like(pattern, [pattern#1, typed_holes_tight(pattern#2)]) else pattern
typed_holes_tight(n: Node) as Node := match n {
	Key(left, Op.Colon, right): {
		tight_left = typed_holes_tight(left)
		tight_right = typed_holes_tight(right)
		hole = rightmost_part(tight_left)
		kind = leftmost_part(tight_right)
		if hole is symbol and name_of(hole).starts_with("$") and kind is symbol and is_tested_type_word(name_of(kind)) then leftmost_replaced(tight_right, rightmost_replaced(tight_left, Key(hole, Op.Colon, kind))) else Key(tight_left, Op.Colon, tight_right)
	}
	Key(left, op, right): Key(typed_holes_tight(left), op, typed_holes_tight(right))
	List(items, bracket, separator): List(items.map(typed_holes_tight), bracket, separator)
	_: n
}
rightmost_part(n: Node) as Node := match n {
	Key(left, op, right): rightmost_part(right)
	_: n
}
leftmost_part(n: Node) as Node := match n {
	Key(left, op, right): leftmost_part(left)
	_: n
}
rightmost_replaced(n: Node, part: Node) as Node := match n {
	Key(left, op, right): Key(left, op, rightmost_replaced(right, part))
	_: part
}
leftmost_replaced(n: Node, part: Node) as Node := match n {
	Key(left, op, right): Key(leftmost_replaced(left, part), op, right)
	_: part
}

# the structural pattern fits: what it binds is held in match·bound
structural_test(subject: Node, pattern: Node) as Node := {
	fitted = List([symbol(matcher_word), subject, List([quote_symbol, pattern], Bracket.Round, Separator.None)], Bracket.Round, Separator.None)
	Key(Key(symbol(match_bound), Op.Assign, fitted), Op.Ne, ø)
}

# the names the result uses of those the pattern binds, each read off match·bound
structural_bindings(pattern: Node, result: Node) as list := structural_names(pattern, no).filter(name => mentions(result, name)).map(name => Key(symbol(name), Op.Assign, subscript(symbol(match_bound), name)))

# `{port: "80"} as Config`: the prelude's converter of a value field by field to a named pattern's types
pattern_converter_word = "converted_to_pattern"
# `{port: "80", extra: 1} as! Config`: the same, after the fields the pattern does not name are dropped
kept_pattern_word = "kept_pattern"
# `word(value, data(pattern))`
pattern_call(word: text, subject: Node, pattern: Node) as Node := List([symbol(word), subject, List([quote_symbol, pattern], Bracket.Round, Separator.None)], Bracket.Round, Separator.None)

# [name, pattern] of `pattern Definition = …`, else ø
named_pattern(statement: Node) as list? := if is_pattern_definition(statement) then named_definition(statement#2) else ø

named_definition(definition: Node) as list? := match definition {
	Key(Symbol(name), Op.Assign, pattern): [name, pattern_body(pattern)]
	_: ø
}

# A pattern's body in the one hole notation of patterns and rules (user 2026-11-17): `$name` is a hole, `$name: Type`
# a typed hole, `$name...` (typed `$name...: Node`) takes the rest of the items, and any other word stands for itself:
#
#   pattern If = (If $condition: Node $then: Node $else: Node)     code, the word If itself and three holes
#   pattern Call = (Call $called: Symbol $arguments...: Node)       a symbol, then any number of nodes
#   pattern Pair = Key($key, Op.Colon, $value)                      a case of Node, its parts named
#   pattern Point = [$x: int, $y: int]                              a value
#
# Code is matched as quoted code, `data((If $condition $then $else))`; a case or a value pattern reads its holes as
# names, as an arm does. A type of a hole in code is a case of Node (`$name: Symbol`), the type word that tests it;
# `Node` itself tests nothing. Code in round brackets is code even without a hole, `pattern Break = (Break)`, built by
# `Break()`. Any other body with no hole at all reads as before, its words binding (card named-pattern-holes).
pattern_body(body: Node) as Node := {
	holed = nodes_in(body).any(is_hole_symbol)
	if is_quote(body) or not (holed or is_code_body(body)) { return body }
	if is_value_body(body) then bottom_up(bottom_up(rest_holes_typed(body), field_shorthand), hole_unmarked) else List([quote_symbol, bottom_up(rest_holes_typed(body), code_hole_typed)], Bracket.Round, Separator.None)
}
# a round group that is no case call: code, `(Break)`, `(Call $called $arguments...)`
is_code_body(body: Node) as bool := bracket_of(body) == "(" and not is_value_body(body)
is_hole_symbol(n: Node) as bool := n is symbol and #name_of(n) > 1 and name_of(n).starts_with(HOLE_MARK)
HOLE_MARK = "$"
# a list, a map or a case `Key(…)`: matched as a value, its holes the names of an arm
is_value_body(body: Node) as bool := bracket_of(body) == "[" or bracket_of(body) == "{" or is_capitalized_call(body)
is_capitalized_call(n: Node) as bool := bracket_of(n) == "(" and separator_of(n) == "" and #n > 1 and n#1 is symbol and is_capitalized(name_of(n#1))
hole_unmarked(part: Node) as Node := if is_hole_symbol(part) then symbol(name_of(part)[1 ..]) else part
# in a map, `src: $src` is the field src bound by its own name, `{src}`
field_shorthand(part: Node) as Node := match part {
	Key(Symbol(field), Op.Colon, Symbol(hole)): if hole == HOLE_MARK + field then symbol(field) else part
	_: part
}
# `$c: Node` is any part, `$c`; `$f: Symbol` tests the case by its type word, `$f: symbol`
# A capitalized type, a declared pattern (`$c: Call`), waits for the patterns of the program (shapes_resolved). A lowercase
# type, `$k: int`, is a literal of that type until types are inferred (wap's stage 3 widens it to any code of the type).
code_hole_typed(part: Node) as Node := match part {
	Key(hole, Op.Colon, Symbol(kind)): if not is_hole_symbol(hole) then part else if kind == node_type then hole else if kind in NODE_CASE_TESTS then Key(hole, Op.Colon, symbol(NODE_CASE_TESTS[kind])) else part
	_: part
}
# the cases of Node a hole of code may name, each with the type word that tests it
NODE_CASE_TESTS = {"Symbol": "symbol", "Key": "key", "List": "list", "Text": "text", "Number": "number"}
# `$xs...: Node` is read `($xs...):` then `Node`; as one item it is the rest whose items are each typed, `($xs: Node)...`
rest_holes_typed(body: Node) as Node := bottom_up(body, part => match part {
	List(items, Bracket.None, separator): {
		rested = typed_rests(items)
		if #rested == 1 and #items > 1 then rested#1 else group_like(part, rested)
	}
	List(items, bracket, separator): group_like(part, typed_rests(items))
	_: part
})
typed_rests(items: list) as list := {
	if #items < 2 { return items }
	rest = items#1
	if is_key(rest, Op.To) and is_hole_symbol(key_of(rest)) and value_of(rest) != ø and text(value_of(rest)) == ":" and items#2 is symbol {
		return [Key(Key(key_of(rest), Op.Colon, items#2), Op.To, ø)] + typed_rests(items[2 ..])
	}
	[rest] + typed_rests(items[1 ..])
}

named_patterns_of(program: Node) as map := {
	patterns = {}
	for statement in statements_in(program) {
		named = named_pattern(statement)
		if named { patterns[named#1] = named#2 }
	}
	for name in patterns.keys { patterns[name] = shapes_resolved(patterns[name], patterns, [name]) }
	patterns
}
# A hole of code typed by a declared pattern, `$c: Call`, fits a part of that shape: the type is the pattern's body.
# Any other capitalized type names no shape and is refused; so is a pattern whose holes take its own shape.
shapes_resolved(pattern: Node, patterns: map, within: list) as Node := if not is_quote(pattern) then pattern else pattern_rebuilt(pattern, part => match part {
	Key(hole, Op.Colon, Symbol(kind)): if is_hole_symbol(hole) and is_capitalized(kind) then Key(hole, Op.Colon, shape_named(kind, patterns, within)) else part
	_: part
})
shape_named(kind: text, patterns: map, within: list) as Node := {
	if kind in within { raise "the pattern " + kind + " takes itself in a hole: a shape cannot hold itself" }
	if not (kind in patterns) { raise kind + " names no shape: a hole of code takes Node, a case of Node (" + NODE_CASE_TESTS.keys.join(", ") + ") or a declared pattern; a value type is written in lower case, " + kind.lower() }
	shapes_resolved(patterns[kind], patterns, within + [kind])
}

without_named_patterns(program: Node) as Node := {
	if not is_statement_sequence(program) { return program }
	group_like(program, statements_in(program).filter(statement => not named_pattern(statement)))
}

# a pattern's name where a pattern, a test, a type or a quote goes
with_named_patterns(n: Node, patterns: map) as Node := match n {
	# `n is Definition`, an equality by now (type_tests.warp: no type of that name): a pattern's name is no value
	Key(subject, Op.Eq, Symbol(name)): if name in patterns then pattern_test(subject, patterns[name]) else n
	Key(subject, Op.Colon, Symbol(name)): if name in patterns then Key(subject, Op.Colon, symbol(any_word)) else n
	Key(subject, Op.As, right): {
		if right is symbol and name_of(right) in patterns { return pattern_call(pattern_converter_word, subject, patterns[name_of(right)]) }
		# `value as! Config`: the parser's `value as !Config`. Unknown fields are dropped, then the pattern's types bind
		forced = if is_key(right, Op.Not) and key_of(right) == ø and value_of(right) is symbol then name_of(value_of(right)) else ""
		if forced != "" and forced in patterns then pattern_call(kept_pattern_word, subject, patterns[forced]) else n
	}
	List(arms, Bracket.Curly, separator): group_like(n, arms.map(arm => named_arm(arm, patterns)))
	# `page find Image`, find's quote `data Image`: the pattern held as data
	_: if is_quote(n) and n#2 is symbol and name_of(n#2) in patterns then group_like(n, [n#1, patterns[name_of(n#2)]]) else n
}

# `match subject { pattern: yes, _: no }`
pattern_test(subject: Node, pattern: Node) as Node := pattern_match(subject, [Key(pattern, Op.Colon, yes), Key(symbol(other_arm), Op.Colon, no)])
pattern_match(subject: Node, arms: list) as Node := node_match(List([symbol("match"), subject, List(arms, Bracket.Curly, Separator.Semicolon)], Bracket.None, Separator.Space), {})

named_arm(arm: Node, patterns: map) as Node := match arm {
	Key(pattern, Op.Colon, result): Key(arm_named_pattern(pattern, patterns), Op.Colon, result)
	Key(pattern, Op.Arrow, result): Key(arm_named_pattern(pattern, patterns), Op.Arrow, result)
	_: arm
}
# `Definition: …` the pattern itself, `If(c, _, no): …` the pattern with its names bound by place to c, nothing and no
arm_named_pattern(pattern: Node, patterns: map) as Node := match pattern {
	Symbol(name): patterns.get(name) ?? pattern
	List(call, Bracket.Round, Separator.None): if call#1 is symbol and name_of(call#1) in patterns then placed_holes(patterns[name_of(call#1)], call[1 ..]) else pattern
	_: pattern
}

# the program with its named patterns put where their names stand, right before node_matches lowers the matches
named_patterns(program: Node) as Node := {
	patterns = named_patterns_of(program)
	if not patterns { return program }
	read = bottom_up(without_named_patterns(program), n => with_hole_reads(n, patterns))
	tests = bottom_up(read, n => with_subject_carried(n, patterns))
	bottom_up(tests, n => with_named_patterns(n, patterns))
}
# `it is Pair and StartsAtOne`, read `(it is Pair) and StartsAtOne`: a pattern's name is no value, so the subject of
# the test before it is tested again, `it is Pair and it is StartsAtOne` (or `or`)
with_subject_carried(n: Node, patterns: map) as Node := {
	if not ((is_key(n, Op.And) or is_key(n, Op.Or)) and value_of(n) is symbol and name_of(value_of(n)) in patterns) { return n }
	subject = tested_subject(key_of(n), patterns)
	if subject == ø then n else Key(key_of(n), op_of(n), Key(subject, Op.Eq, value_of(n)))
}
# the subject of `x is Pattern`, also of the first of several joined by and/or; ø for any other condition
tested_subject(test: Node, patterns: map) as Node? := {
	if is_key(test, Op.Eq) and value_of(test) is symbol and name_of(value_of(test)) in patterns { return key_of(test) }
	if is_key(test, Op.And) or is_key(test, Op.Or) then tested_subject(key_of(test), patterns) else ø
}


# ── Named patterns ────────────────────────────────────────────────────────────────────────────────────────────────
# A named pattern with holes is a type with fields (user 2026-11-17: `pattern` is the one spelling, no
# `type X < Base = pattern`): built by its holes, tested with `is`, matched by name or by place, its holes read off a
# parameter of that type. pattern_body (above) reads the body into the forms below: code quoted, holes of a value
# pattern as names.
#
#   pattern Pair = [$a: int, $b: int]
#   pattern Choice = (choose $condition: Node $then: Node $else: Node)
#   pattern Definition = Key($head, Op.Define, $body)
#
#   build  Choice(c, a, b)             the code `(choose c a b)`, a Pair(1, 2) the list [1, 2]
#   test   n is Choice                 whether n fits the pattern
#   match  n { Choice(c, _, e) => … }  its holes bound by place, `_` binding none; `Choice => condition` binds them by name
#   read   f(n: Choice) := n.condition a parameter of the type reads its holes

# A pattern's names in the order written: `[a: int, b: int]` → a, b; `data((choose $condition $then $else))` → condition,
# then, else.
# These are the type's fields and the constructor's parameters. A capitalized word (`Key`, `Op.Define`) is a case, a
# type or an enum, and `_` binds nothing: neither is a name.
pattern_holes(pattern: Node) as list := structural_names(pattern, no).filter(is_hole_word)
is_hole_word(name: text) as bool := name != other_arm and name#1.lower() == name#1

# `pattern Point = [x, y]` also defines `Point(x, y) := [x, y]`, right before the definitions are read. The body is
# the pattern with each name as its value; a typed name types its parameter, `Pair(a: int, b: int) := [a, b]`. A
# pattern without names, or with a part still open once its names are values (`_`, a rest `..` or `*xs`, a type alone
# as in `{port: int}`), describes no single value and builds nothing.
pattern_constructors(program: Node) as Node := if is_statement_sequence(program) then group_like(program, statements_in(program).flat_map(statement => [statement] + pattern_constructor(statement))) else program
pattern_constructor(statement: Node) as list := {
	named = named_pattern(statement)
	if named == ø { return [] }
	pattern = named#2
	holes = pattern_holes(pattern)
	value = built_value(pattern, holes)
	if (#holes == 0 and not is_quote(pattern)) or nodes_in(value).any(is_open_part) { return [] }
	[Key(call_of(named#1, holes.map(hole => typed_parameter(pattern, hole))), Op.Define, value)]
}
# `_`, a rest word `*xs`, a type word (`int`; a capitalized `Key` is a case), or an operator missing a side, the rest `..`
# of `[1, ..]`; a rest hole `$xs...` is no open part: a template splices it
is_open_part(part: Node) as bool := if part is symbol then name_of(part) == other_arm or name_of(part).starts_with("*") or (is_hole_word(name_of(part)) and is_tested_type_word(name_of(part))) else part is key and (key_of(part) == ø or (value_of(part) == ø and not is_hole_symbol(key_of(part))))
# the value the pattern describes: each typed hole `a: int` (in code `$a: int`) as the name alone
built_value(pattern: Node, holes: list) as Node := pattern_rebuilt(pattern, part => match part {
	Key(Symbol(name), Op.Colon, Symbol(kind)): if name in holes or (name.starts_with("$") and name[1 ..] in holes) then symbol(name) else part
	_: part
})
# the parameter of a name, typed as the pattern types it: `a: int`, else the bare name
typed_parameter(pattern: Node, hole: text) as Node := {
	for part in nodes_in(pattern) {
		if is_key(part, Op.Colon) and key_of(part) is symbol and name_of(key_of(part)) in [hole, "$" + hole] and value_of(part) is symbol { return Key(symbol(hole), Op.Colon, value_of(part)) }
	}
	symbol(hole)
}

# The arm `If(c, _, e) => …`: the pattern with its names, in order, renamed to the arm's, so `c` binds cond and `e`
# binds else_part. A place in a value pattern may hold any pattern (`Pair(1, y)`); a hole of code takes a name or `_`.
placed_holes(pattern: Node, places: list) as Node := {
	holes = pattern_holes(pattern)
	if #places != #holes { raise "the pattern binds " + #holes + " names, " + holes.join(", ") + ": an arm names each by its place" }
	placed = {}
	for at in 1 to #holes { placed[holes#at] = places#at }
	pattern_rebuilt(pattern, part => if part is symbol then placed_hole(name_of(part), placed) ?? part else part)
}
# Each part of a pattern changed by f, bottom up, the inside of a quoted pattern too: bottom_up leaves quoted code
# alone, as it must for code that is data, but a quoted pattern's holes are exactly what is to change.
pattern_rebuilt(pattern: Node, f: function) as Node := if is_quote(pattern) then group_like(pattern, [pattern#1, bottom_up(pattern#2, f)]) else bottom_up(pattern, f)
# the place of a name, `$cond` in code as `$c`; ø for a word that is no name of the pattern
placed_hole(name: text, placed: map) as Node? := {
	if name in placed { return placed[name] }
	hole = name[1 ..]
	if not (name.starts_with("$") and hole in placed) { return ø }
	if placed[hole] is symbol then symbol("$" + name_of(placed[hole])) else raise "a hole of code binds a name, not " + placed[hole]
}

# `f(n: Choice) := n.condition`: in a function, a parameter typed by a named pattern reads its names. Each read matches the
# parameter against the pattern, `match n { Choice => condition }`; a value that does not fit is refused there ("no case for
# value"), never read as ø. Reads after a test (`if n is Choice { n.condition }`) are not narrowed yet.
with_hole_reads(n: Node, patterns: map) as Node := {
	if not is_key(n, Op.Define) { return n }
	typed = pattern_parameters(leftmost_part(key_of(n)), patterns)
	if not typed then n else Key(key_of(n), Op.Define, bottom_up(value_of(n), part => pattern_read(part, typed)))
}
# each parameter whose type is a named pattern: its name → the pattern
pattern_parameters(call: Node, patterns: map) as map := {
	typed = {}
	if not is_round(call) { return typed }
	for parameter in items_of(call)[1 ..] {
		if is_key(parameter, Op.Colon) and key_of(parameter) is symbol and value_of(parameter) is symbol and name_of(value_of(parameter)) in patterns { typed[name_of(key_of(parameter))] = patterns[name_of(value_of(parameter))] }
	}
	typed
}
pattern_read(n: Node, typed: map) as Node := match n {
	Key(Symbol(name), Op.Dot, Symbol(field)): if name in typed and field in pattern_holes(typed[name]) then pattern_match(key_of(n), [Key(typed[name], Op.Colon, value_of(n))]) else n
	_: n
}

match_patterns_extension = Extension{name: "match_patterns", arm_lowerings: [guarded_arms], passes_before: {"definition_heads": pattern_constructors}, passes: {"code_templates": named_patterns}}
