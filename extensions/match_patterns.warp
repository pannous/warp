# Match arms past the core's cases, values, types and `_` (core/passes/node_matches.warp):
# - a guard `n if n > 5 => e` tests its pattern and then its condition, the pattern's names bound
# - a bare name `n => "hi " + n` binds the subject
# - a structural pattern, a list `[a, ...rest]`, a map `{name}`, a text cut `"/u/" + id: int`, quoted code
#   `data($f($x))`, is fitted at run time by the prelude's matcher: `(match·bound = pattern_bindings(n, data(pattern)))
#   != ø`, each name bound `x = match·bound#"x"`
# Each such arm becomes the arm `_` whose result chooses by its test, else what the arms after it give.
# A named pattern `pattern Definition = Key(head, Op.Define, body)` (decision node-refinements: a named refinement of a
# node case) leaves the program, and its name stands for the pattern in an arm `Definition: …`, which binds head and
# body, in a test `n is Definition`, and as the type `d: Definition`, any node.

# whether the core lowers the arm itself
is_core_arm(arm: Node, variants: map): bool := guard_of(arm_pattern(arm)) == ø and not is_name_arm(arm_pattern(arm), arm_result(arm), variants) and is_case_arm(arm, variants)

# the arms, the first the core does not lower and all after it as one arm `_`
guarded_arms(arms: list, subject: Node, variants: map): list := {
	for at in 0 ..< #arms {
		if not is_core_arm(arms[at], variants) {
			rest = chained_arms(arms[at + 1 ..], subject, variants)
			return arms[0 ..< at] + [Key(symbol(other_arm), Op.Colon, guarded_arm(arms[at], subject, variants, rest))]
		}
	}
	arms
}

# a guarded, binding or structural arm: the pattern's test and its bindings, then the guard with them in sight, and the
# result with them; `otherwise` what the arms after it give
guarded_arm(arm: Node, subject: Node, variants: map, otherwise: Node): Node := {
	guard = guard_of(arm_pattern(arm))
	pattern = guarded_pattern(arm_pattern(arm))
	result = arm_result(arm)
	# ø: the pattern takes any subject
	test: Node = ø
	bound: list = []
	if is_name(pattern) and not is_other_arm(pattern) and (guard != ø or is_name_arm(pattern, result, variants)) { bound = [Key(pattern, Op.Assign, subject)] }
	else if is_value_pattern(pattern, variants) { test = value_test(subject, pattern) }
	else if is_type_pattern(pattern) { test = List([symbol("is_type"), subject, name_of(pattern)], Bracket.Round, Separator.None) }
	else if case_pattern(pattern) != ø { test = arm_test(case_pattern(pattern), subject); bound = part_bindings(case_pattern(pattern), subject) }
	else if direct_items(pattern, variants) != ø { test = items_test(subject, direct_items(pattern, variants)); bound = item_bindings(subject, direct_items(pattern, variants)) }
	else { test = structural_test(subject, pattern); bound = structural_bindings(pattern, List([guard, result], Bracket.Square, Separator.Comma)) }
	if guard != ø {
		guarded = List(bound + [guard], Bracket.Round, Separator.Semicolon)
		test = if test == ø then guarded else Key(test, Op.And, guarded)
	}
	value = if #bound == 0 then result else List(bound + [result], Bracket.Round, Separator.Semicolon)
	if test == ø then value else chosen(test, value, otherwise)
}

# A list pattern known whole at compile time, `[a, b]`, `["add", x, y]`, `[_, 0]`: tested and bound in place, item by
# item, with no call of the prelude's matcher (card pattern-direct-tests). Its items are names binding once, `_`, and
# numbers, texts or characters the item equals; any other list (a rest, a type word, a class of characters, a name
# twice, a nested pattern) stays pattern_bindings's at run time
direct_items(pattern: Node, variants: map): list? := match pattern {
	List(items, Bracket.Square, separator): if #items > 0 and items.all(item => is_direct_item(item, variants)) and distinct_names(items) then items else ø
	_: ø
}
is_direct_item(item: Node, variants: map): bool := match item {
	Number(value): yes
	Text(value): yes
	Char(value): yes
	Symbol(name): is_binding_word(name, variants)
	_: no
}
# a word binding the item as itself: no hole `$x`, rest `*xs`, type word, class of characters or declared variant
is_binding_word(name: text, variants: map): bool := not (name.starts_with("$") or name.starts_with("*") or name.starts_with(".")) and not is_tested_type_word(name) and not (name in character_class_words) and not (name in variants)
distinct_names(items: list): bool := {
	names = items.filter(item => item is symbol and name_of(item) != other_arm).map(item => name_of(item))
	#names == #names.unique()
}
# a list of as many items, each literal one equal
items_test(subject: Node, items: list): Node := {
	test = Key(List([symbol("is_type"), subject, "list"], Bracket.Round, Separator.None), Op.And, Key(applied("count", subject), Op.Eq, #items))
	for at in 1 to #items {
		if not (items#at is symbol) { test = Key(test, Op.And, Key(Key(subject, Op.Hash, at), Op.Eq, items#at)) }
	}
	test
}
# each name the item at its place
item_bindings(subject: Node, items: list): list := {
	bound = []
	for at in 1 to #items {
		if items#at is symbol and name_of(items#at) != other_arm { bound += [Key(items#at, Op.Assign, Key(subject, Op.Hash, at))] }
	}
	bound
}

# the structural pattern fits: what it binds is held in match·bound
structural_test(subject: Node, pattern: Node): Node := {
	fitted = List([symbol(matcher_word), subject, List([quote_symbol, pattern], Bracket.Round, Separator.None)], Bracket.Round, Separator.None)
	Key(Key(symbol(match_bound), Op.Assign, fitted), Op.Ne, ø)
}

# the names the result uses of those the pattern binds, each read off match·bound
structural_bindings(pattern: Node, result: Node): list := structural_names(pattern, no).filter(name => mentions(result, name)).map(name => Key(symbol(name), Op.Assign, subscript(symbol(match_bound), name)))

# `{port: "80"} as Config`: the prelude's converter of a value field by field to a named pattern's types
pattern_converter_word = "converted_to_pattern"
# `{port: "80", extra: 1} as! Config`: the same, after the fields the pattern does not name are dropped
kept_pattern_word = "kept_pattern"
# `word(value, data(pattern))`
pattern_call(word: text, subject: Node, pattern: Node): Node := List([symbol(word), subject, List([quote_symbol, pattern], Bracket.Round, Separator.None)], Bracket.Round, Separator.None)

# [name, pattern] of `pattern Definition = …`, else ø
named_pattern(statement: Node): list? := if is_pattern_definition(statement) then named_definition(statement#2) else ø

named_definition(definition: Node): list? := match definition {
	Key(Symbol(name), Op.Assign, pattern): [name, pattern]
	_: ø
}

named_patterns_of(program: Node): map := {
	patterns = {}
	for statement in statements_in(program) {
		named = named_pattern(statement)
		if named { patterns[named#1] = named#2 }
	}
	patterns
}

without_named_patterns(program: Node): Node := {
	if not is_statement_sequence(program) { return program }
	group_like(program, statements_in(program).filter(statement => not named_pattern(statement)))
}

# a pattern's name where a pattern, a test, a type or a quote goes
with_named_patterns(n: Node, patterns: map): Node := match n {
	# `n is Definition`, an equality by now (type_tests.warp: no type of that name): a pattern's name is no value
	Key(subject, Op.Eq, Symbol(name)): if name in patterns then pattern_test(subject, patterns[name]) else n
	Key(subject, Op.Colon, Symbol(name)): if name in patterns then Key(subject, Op.Colon, symbol(any_word)) else n
	Key(subject, Op.As, right): {
		if right is symbol and name_of(right) in patterns { return pattern_call(pattern_converter_word, subject, patterns[name_of(right)]) }
		# `value as! Config`: the parser's `value as !Config`. Unknown fields are dropped, then the pattern's types bind
		forced = if is_key(right, Op.Not) and key_of(right) == ø and value_of(right) is symbol then name_of(value_of(right)) else ""
		if forced != "" and forced in patterns then pattern_call(kept_pattern_word, subject, patterns[forced]) else n
	}
	List(arms, Bracket.Curly, separator): group_like(n, arms.map(arm => named_arm(arm, patterns)))
	# `page find Image`, find's quote `data Image`: the pattern held as data
	_: if is_quote(n) and n#2 is symbol and name_of(n#2) in patterns then group_like(n, [n#1, patterns[name_of(n#2)]]) else n
}

# `match subject { pattern: yes, _: no }`
pattern_test(subject: Node, pattern: Node): Node :=
	node_match(List([symbol("match"), subject, List([Key(pattern, Op.Colon, yes), Key(symbol(other_arm), Op.Colon, no)], Bracket.Curly, Separator.Semicolon)], Bracket.None, Separator.Space), {})

named_arm(arm: Node, patterns: map): Node := match arm {
	Key(Symbol(name), Op.Colon, result): if name in patterns then Key(patterns[name], Op.Colon, result) else arm
	Key(Symbol(name), Op.Arrow, result): if name in patterns then Key(patterns[name], Op.Arrow, result) else arm
	_: arm
}

# the program with its named patterns put where their names stand, right before node_matches lowers the matches
named_patterns(program: Node): Node := {
	patterns = named_patterns_of(program)
	if not patterns { return program }
	tests = bottom_up(without_named_patterns(program), n => with_subject_carried(n, patterns))
	bottom_up(tests, n => with_named_patterns(n, patterns))
}
# `it is Pair and StartsAtOne`, read `(it is Pair) and StartsAtOne`: a pattern's name is no value, so the subject of
# the test before it is tested again, `it is Pair and it is StartsAtOne` (or `or`)
with_subject_carried(n: Node, patterns: map): Node := {
	if not ((is_key(n, Op.And) or is_key(n, Op.Or)) and value_of(n) is symbol and name_of(value_of(n)) in patterns) { return n }
	subject = tested_subject(key_of(n), patterns)
	if subject == ø then n else Key(key_of(n), op_of(n), Key(subject, Op.Eq, value_of(n)))
}
# the subject of `x is Pattern`, also of the first of several joined by and/or; ø for any other condition
tested_subject(test: Node, patterns: map): Node? := {
	if is_key(test, Op.Eq) and value_of(test) is symbol and name_of(value_of(test)) in patterns { return key_of(test) }
	if is_key(test, Op.And) or is_key(test, Op.Or) then tested_subject(key_of(test), patterns) else ø
}

match_patterns_extension = Extension{name: "match_patterns", arm_lowerings: [guarded_arms], passes: {"code_templates": named_patterns}}
