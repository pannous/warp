# Quoted code (extension, the emitter's part; card quotes-templates-serializer): `data e` as a node, the fields of a
# code view (line, column, comment). `data e`, glued `data(e)`: e as written, a node (Rust's blocks.rs as_data,
# written_quote); `parse("a + 1")` is `as_code(data a + 1)`. Which nodes are quotes is the core's (walk.warp is_quote)
# `print data (a + 1)`: a `data` after the head of a line quotes the item after it; its place, else 0. In a call,
# `f(data, 7)`, data is a word: the parser groups `f(data e)`'s quote itself (parser.warp data_literal)
inline_quote_at(n: Node): int := {
	if not is_spaced(n) { return 0 }
	for i in 2..<#n { if n#i == quote_symbol { return i } }
	0
}
quote_folded(n: Node, at: int): Node := {
	quote = separated(bracketed([n#at, n#(at + 1)], ""), " ")
	separated(bracketed(items_of(n)[..(at - 1)] + [quote] + items_of(n)[(at + 1)..], bracket_of(n)), separator_of(n))
}
# `code.line`, `code.column`, `e.comment` (Rust's view: `code#("line" + 1)`): the views carry no positions or comments
position_fields = ["line", "column", "comment"]
# what a selector's leading dot leaves unbound in data (unbound_words): `.done{…}` is rebuilt as written
selector_dot = "."
# the field a key reads, `x.name`, also as Rust's analysis view writes it, `x#("name" + 1)`; ø of another key
read_field(n: Node): text? := {
	if op_of(n) == Op.Dot and value_of(n) is symbol { return name_of(value_of(n)) }
	field = value_of(n)
	if op_of(n) == Op.Hash and is_key(field, Op.Add) and key_of(field) is text and value_of(field) == 1 { return key_of(field) }
	ø
}
reads_position(n: Node): bool := {
	if type(n) is key and read_field(n) in position_fields { return yes }
	if type(n) is key { return reads_position(key_of(n)) or reads_position(value_of(n)) }
	is_group(n) and items_of(n).any(reads_position)
}
# a program reading `code.line` or `code.column` gets its quotes where they were written, $MetaNodes; any other
# program pays nothing for them (decision debug-positions-auto)
def quoted_code(body: Body, e: Node): list {
	code = written_quote_code(body, e)
	at = if module.reads_positions then written_at(e) else ø
	if at == ø { return code }
	intrinsic_of(body, "meta_node", [TypedCode(ValueKind.Node, code), number_value(at#1), number_value(at#2)]).code
}
def written_quote_code(body: Body, e: Node): list {
	if e is symbol { return node(Kind.Symbol, text_bytes(name_of(e))) }
	if type(e) is key {
		parts = [TypedCode(ValueKind.Node, quoted_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, quoted_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	if is_group(e) {
		if #e == 0 { return [ref_null, gc_type(gc.node)] }
		items = TypedCode(ValueKind.Node, node(Marked.SquareList, vector_code(e.map(item => quoted_code(body, item)))))
		bracketed = TypedCode(ValueKind.Node, runtime_call("bracketed_node", [items, text_value(bracket_of(e))]).code)
		return runtime_call("separated_node", [bracketed, text_value(separator_of(e))]).code
	}
	boxed(expression_code(body, e))
}

# Data with its names spliced in (decisions data-names, data-parameters): a part naming only what the program binds is
# its value (`"Hi " + name`, `theme`, `Greeter("Ann")`), any other part is rebuilt as written, its parts so in turn;
# an entry's key stays a word, a block stays a block of its items
def spliced_code(body: Body, e: Node): list {
	# statements the passes made, a comprehension's loop: code, its value spliced in
	if is_group(e) and bracket_of(e) != "{" and separator_of(e) in statement_separators { return boxed(expression_code(body, e)) }
	# `if c then a else b` is code, never split at its else; its branches are data in turn (`else ul{…}`)
	if is_conditional(e) { return boxed(expression_code(body, e)) }
	if not is_curly_group(e) and not is_word_keyed(e) and #unbound_words(body, e) == 0 { return boxed(expression_code(body, e)) }
	if is_group(e) and is_data_tag(body, e) { return spliced_code(body, Key(e#1, Op.Colon, e#2)) }
	if is_word_keyed(e) {
		parts = [TypedCode(ValueKind.Node, quoted_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, spliced_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	# `.done` of a style sheet: a selector's name stays a word, though the program binds done
	if is_key(e, Op.Dot) and key_of(e) == ø and value_of(e) is symbol { return quoted_code(body, e) }
	if type(e) is key {
		parts = [TypedCode(ValueKind.Node, spliced_code(body, key_of(e))), text_value(op_of(e)), TypedCode(ValueKind.Node, spliced_code(body, value_of(e)))]
		return runtime_call("key_node", parts).code
	}
	if is_group(e) and #e > 0 {
		items = TypedCode(ValueKind.Node, node(Marked.SquareList, vector_code(range_list(#e).map(at => if is_id_selector(e, at) then quoted_code(body, e[at]) else spliced_code(body, e[at])))))
		bracketed = TypedCode(ValueKind.Node, runtime_call("bracketed_node", [items, text_value(bracket_of(e))]).code)
		return runtime_call("separated_node", [bracketed, text_value(separator_of(e))]).code
	}
	quoted_code(body, e)
}
# `#main {…}` of a style sheet: a `#` before a word and then its block is the id selector as written, no count of a
# value the program binds; a `#xs` anywhere else counts
is_id_selector(items: Node, at: int): bool := {
	mark = items[at]
	is_key(mark, Op.Hash) and key_of(mark) == ø and value_of(mark) is symbol and at + 1 < #items and is_curly_group(items[at + 1])
}
# `if c then a else b`, `if c then a`, `c ? a : b`
is_conditional(e: Node): bool := (is_key(e, Op.Else) and is_key(key_of(e), Op.Then)) or (is_key(e, Op.Then) and is_key(key_of(e), Op.If)) or (is_key(e, Op.Question) and is_key(value_of(e), Op.Colon))
# `class: "box"`, `"nav a": {…}`, `p{…}`: a key whose left is a word or text, kept as written
is_word_keyed(e: Node): bool := (is_key(e, Op.Colon) or is_key(e, Op.None)) and (key_of(e) is symbol or key_of(e) is text)
# a function of parameters, its name and nothing else's (a nullary one, `now`, is its call), which is no value in data: `animation: pop 400ms` the CSS keyframes pop, the
# list word aside (decision data-names: what the program binds is a value)
names_function_only(body: Body, name: text): bool := name in module.functions and #module.functions[name].signature.parameters > 0 and name not in body.names and not is_global(body, name) and name not in module.variants
is_bound(body: Body, name: text): bool := name in body.names or is_global(body, name) or name in module.functions or name in module.variants
# the words of e nothing binds, a field's name (`todo.text`) and an entry's key not counted
unbound_words(body: Body, e: Node): list := {
	if e is symbol { return if is_bound(body, name_of(e)) and not names_function_only(body, name_of(e)) then [] else [name_of(e)] }
	# `f(x)`: the call of a function, its arguments the words to ask
	if bracket_of(e) == "(" and #e > 0 and e#1 is symbol and name_of(e#1) in module.functions { return items_of(e)[1..].flat_map(item => unbound_words(body, item)) }
	# a lambda the lambdas pass lifted, `closure_new(closure_lambda_1, n)`: a function value (`div{ p{ () => n } }`)
	if is_quote(e) or is_spliced_quote(e) or is_closure_value(e) { return [] }
	# `.box` and `.done{…}` of a style sheet read no field: a selector, never a value, though the program binds done
	if is_key(e, Op.Dot) { return if key_of(e) == ø then [selector_dot] else unbound_words(body, key_of(e)) }
	if is_word_keyed(e) { return unbound_words(body, value_of(e)) }
	if type(e) is key { return unbound_words(body, key_of(e)) + unbound_words(body, value_of(e)) }
	if is_group(e) then items_of(e).flat_map(item => unbound_words(body, item)) else []
}
# `div{ class: "box" p{"Hi"} }`: a word nothing binds, glued to its block, is the data pair `div: […]`, Warp's own data
# notation (decision data-parameters, option b), which lib/markup.warp's to_html renders by name
# (or written before its block, `div { … }`: walk.warp tag_parts). A function's name glued to a block it can't take stays
# a tag: `form{ method: "post" … }` is the element, though lib/markup's form(method, action, body) is a function; `json{ 'a': 1 }` is its call
is_data_tag(body: Body, n: Node): bool := {
	parts = tag_parts(n)
	if #parts != 2 or name_of(parts#1) in module.classes { return no }
	name = name_of(parts#1)
	not is_bound(body, name) or (names_function_only(body, name) and not takes_arguments(module.functions[name], [parts#2]))
}
