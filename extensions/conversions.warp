# A program's conversions (decision general-conversions): `Person as text := it.name` says how a Person turns into
# text, and every `p as text` of the program then uses it. Each target gets one function trying the program's
# conversions to it in the order written, the built-in one last:
#   as·text(it) := if it is Person then it.name else it as text
# A use is its call, `as·text(p)`; a declaration `x as text = "a"` stays one. `text(p: Person) := …` is the conversion
# to text too, and a program converting to text shows values through it: print, str, text, an interpolation, a join.
# The pass runs after the class rewrites (a class's conversions become the program's) and before the definitions are lowered

# `as·text`: the function converting to the target, a name no program can write; its parameter, which a body's `it`
# (or the name `text(p: Person)` gives) is renamed to (lambdas.warp renamed)
conversion_name(target: text): text := "as·" + target
converted_value = HiddenWord.ConvertedValue as text

# a word naming a type: a type word, a collection, or a type the program declares (`class Person {…}`)
names_type(n: Node, scope: map): bool := n is symbol and (is_tested_type_word(name_of(n)) or binds_as(scope, name_of(n), Meaning.Type))

# a class's name as written, declared or not: units' `q: Quantity as Duration` names lib/time's Duration, which a program
# without lib/time lacks and so leaves the conversion out
names_class(n: Node): bool := n is symbol and is_capitalized(name_of(n))
# [source, target, body, the body's name of the value] of `A as B := body` with A and B types, of `n: A as B := body`
# naming the value, also of `text(p: A) := body`, else ø
conversion_of(n: Node, scope: map): list? := {
	if not is_key(n, Op.Define) { return ø }
	head = as_phrase_read(key_of(n))
	if is_key(head, Op.Colon) and key_of(head) is symbol and is_key(value_of(head), Op.As) {
		types = value_of(head)
		return if names_type(key_of(types), scope) and (names_type(value_of(types), scope) or names_class(value_of(types))) then [name_of(key_of(types)), name_of(value_of(types)), value_of(n), name_of(key_of(head))] else ø
	}
	if is_call(head) and #head == 2 and head#1 == symbol("text") and is_key(head#2, Op.Colon) and key_of(head#2) is symbol {
		return if names_type(value_of(head#2), scope) then [name_of(value_of(head#2)), "text", value_of(n), name_of(key_of(head#2))] else ø
	}
	if not is_key(head, Op.As) { return ø }
	if (names_type(key_of(head), scope) or names_class(key_of(head))) and (names_type(value_of(head), scope) or names_class(value_of(head))) then [name_of(key_of(head)), name_of(value_of(head)), value_of(n), implicit_parameter] else ø
}

# the words showing a value as text, which show it through a program's conversion to text
showing_words = ["print", "str", "text", "text_form"]
# x as the program's conversion to text shows it; a text as it is
shown_converted(x: Node): Node := if x is text then x else call_of(conversion_name("text"), [x])

# every `x as B` of a target B the program converts to as the call of its conversion; `x as B = v` and `f(x) as B := …`
# declare and stay
converting_uses(n: Node, targets: map): Node := {
	if (is_key(n, Op.Assign) or is_key(n, Op.Define)) and is_key(key_of(n), Op.As) {
		return Key(key_of(n), op_of(n), converting_uses(value_of(n), targets))
	}
	walked = children(n, x => converting_uses(x, targets))
	if is_key(walked, Op.As) and value_of(walked) is symbol and targets.has(name_of(value_of(walked))) {
		return call_of(conversion_name(name_of(value_of(walked))), [key_of(walked)])
	}
	if not targets.has("text") { return walked }
	if is_group(walked) and #walked > 1 and walked#1 is symbol and name_of(walked#1) in showing_words and (bracket_of(walked) == "(" or bracket_of(walked) == "") {
		return group_like(walked, [walked#1] + items_of(walked)[1 ..].map(shown_converted))
	}
	# `"hi " + p`: a join with a text
	if is_key(walked, Op.Add) and (key_of(walked) is text or value_of(walked) is text) { return Key(shown_converted(key_of(walked)), Op.Add, shown_converted(value_of(walked))) }
	walked
}

# the conversion to `target`: a typed function of each source type, `as·text·Person(p: Person) := body`, and the one
# trying them in order by the value's type, then the built-in conversion, `as·text(it: any)`
conversion_functions(target: text, written: list, targets: map, scope: map): list := {
	it = symbol(converted_value)
	# a class's own instance stays itself, a value of no source type is refused: no built-in conversion makes one
	refused = call_of(raise_word, ["no conversion to " + target + " of that value"])
	tried = if not declared_target(target, scope) then Key(it, Op.As, symbol(target)) else chosen(Key(it, Op.Is, symbol(target)), it, refused)
	functions = []
	for conversion in class_first(written).reverse() {
		name = conversion_name(target) + "·" + conversion#1
		written_body = renamed(conversion#3, conversion#4, it)
		body = converting_uses(if declared_target(target, scope) then amount_kept(written_body, target) else written_body, targets)
		functions += [Key(call_of(name, [Key(it, Op.Colon, symbol(conversion#1))]), Op.Define, body)]
		tried = chosen(Key(it, Op.Is, symbol(conversion#1)), call_of(name, [it]), tried)
	}
	functions + [Key(call_of(conversion_name(target), [Key(it, Op.Colon, symbol(any_word))]), Op.Define, tried)]
}
# a target the program declares, a class, not a built-in type word: text stays one where a prelude in front binds it
declared_target(target: text, scope: map): bool := binds_as(scope, target, Meaning.Type) and not is_tested_type_word(target)
# a conversion's body giving a number gives the target's amount (night decision length-pixels): `length as pixels :=
# it.amount * 2` makes 3m 6px, the number as the target class as any number is (lib/units counts its base unit); any
# other value, and every value of a built-in target (`P as text := it.age`), as the body gives it
amount_kept(body: Node, target: text): Node := {
	given = symbol(given_amount)
	block_of([Key(given, Op.Assign, body), chosen(Key(given, Op.Is, symbol("number")), Key(given, Op.As, symbol(target)), given)])
}
given_amount = "amount·given"

# Typed parameters convert (decision as-promotes, card argument-parameter-conversion): a call's argument meeting a
# parameter typed T the program converts to goes through `passed·T`, so `f(2)` of `f(q: Quantity)` passes 2 as Quantity,
# and `Instant(0) + 2 seconds` a Duration where time's plus takes one; on the caller's side, which sees every module's
# conversions (units' Quantity as Duration beside time's number as Duration), never the callee's. A union converts to
# the member the value has a conversion to: Instant.minus(other: Instant or Duration) takes an Instant as it is and
# 2 seconds as a Duration (card instant-typed-duration)
# (never `to·T`, the compiled name of a method `to` of class T: Quantity.to beside the conversion to Quantity)
argument_conversion_name(type: text): text := "passed·" + union_members(type).join("_or_")
converts_to(type: text, targets: map): bool := union_members(type).any(member => targets.has(member))
# `passed·T(it: any, taker: text)`: a value of the type (of a member of the union) as it is, one of a source type
# converted, the first member's conversions first. A class goes before a type word, as a member and as a source: a
# lib/units quantity also tests as a number, so Instant.compare(other: Instant or number or Duration) takes 9h as a
# Duration and only a bare 5 as a number. A class place (decision class-types-checked) takes, besides, a value with
# every field of a member class extending none, and refuses any other value: `f takes a Length, not 5s (a Time)`; a
# place of type words only takes it as it is, the parameter's own check says what it takes
argument_conversion(type: text, places: map, classes: map): Node := {
	it = symbol(converted_value)
	# (`Duration or any`: a Duration, a value converting to one, else any value as it is)
	members = union_members(type).filter(member => member != any_word)
	passes = members.map(member => [member, it])
	conversions = members.filter(member => places.has(member)).flat_map(member => places[member].map(conversion => [conversion#1, call_of(conversion_name(member) + "·" + conversion#1, [it])]))
	steps = class_first(passes + conversions)
	# (a union naming any refuses nothing: lib/time's lasting_of(d: Duration or any) of 24 hours, card zoned-europe)
	checked = if any_word in union_members(type) then [] else members.filter(member => classes.has(member))
	refused = call_of(place_refusal_word, [it, symbol(taker_name), Text(type)])
	passed = if checked then chosen(Key(symbol(taker_name), Op.Eq, Text("")), it, refused) else it
	for member in checked.filter(member => classes[member].parent == "").reverse() { passed = chosen(fields_fit(it, classes[member].fields), it, passed) }
	for step in steps.reverse() { passed = chosen(Key(it, Op.Is, symbol(step#1)), step#2, passed) }
	Key(call_of(argument_conversion_name(type), [Key(it, Op.Colon, symbol(any_word)), Key(symbol(taker_name), Op.Colon, symbol("text"))]), Op.Define, passed)
}
taker_name = "taker·named"
place_refusal_word = "place_refused"
# whether an instance or a map has every one of the fields (lib/prelude.warp has_fields)
fields_fit(it: Node, fields: list): Node := Key(Key(call_of(instance_test_word, [it]), Op.Or, Key(it, Op.Is, symbol("map"))), Op.And, call_of("has_fields", [it, List(fields.map(field => Text(field)), Bracket.Square, Separator.Comma)]))
# the prelude words a class place's check calls (core/passes/prelude_words.warp extension_writes)
class_place_words(program: Node): list := if statements_in(program).any(statement => class_view(statement) != ø) then [place_refusal_word, "has_fields", "with_article"] else []
# each class the program declares, not an enum: name → its Declared (core/passes/classes.warp)
class_declarations(program: Node): map := {
	enums = declarations_found(program, declared_enum, {})
	found = {}
	for statement in statements_in(program) {
		view = class_view(statement)
		if view != ø and not enums.has(declared_type_name(view#2)) { found[declared_type_name(view#2)] = class_declared(statement, view) }
	}
	found
}
# conversions (or [type, …] steps) from a class first, then from a type word, each in the order written
class_first(steps: list): list := steps.filter(step => is_capitalized(step#1)) + steps.filter(step => not is_capitalized(step#1))
# name → the parameter types of a function defined once, for each one taking a type the program converts to
typed_parameters(statements: list, targets: map, aliases: map): map := {
	found = {}
	for statement in statements {
		call = definition_call(statement)
		if call != ø and call#1 is symbol {
			name = name_of(call#1)
			# (a type's alias as the type it names, units' length as Length)
			found[name] = if found.has(name) then ø else signature_types(parameter_types(call), aliases)
		}
	}
	without_keys(found, found.keys.filter(name => found[name] == ø or not found[name].any(type => converts_to(type, targets)) or has_builtin_variant(name)))
}
# each parameter type, an alias as the type it names, but a type variable of the signature, `K` of `m: map of K, k: K`,
# as any
signature_types(types: list, aliases: map): list := {
	variables = types.filter(type => type is text).flat_map(type => type.split(" of ")[1..])
	types.map(type => if type is text and type in variables then any_word else if type is text then alias_resolved(type, aliases) else type)
}
alias_resolved(type: text, aliases: map): text := {
	resolved = type
	steps = 0
	# (bounded: two aliases naming each other end the walk)
	while aliases.has(resolved) and steps < #aliases {
		resolved = aliases[resolved]
		steps += 1
	}
	resolved
}
# a word the runtime or C also takes, `exp(x: real)` beside math's `exp(x: float)`: the overload passes choose among
# them by the argument as written, so it stays unconverted
has_builtin_variant(name: text): bool := #lines_of(typed_lines + foreign_math_lines, unaliased(name)) > 0
# a class's making as a function of its fields (card class-field-takes): name → its fields' types in order, of each class
# with a field of a type the program converts a value to, `class P { age: Age }` making P(3) of `type Age < int`
constructor_parameters(classes: map, targets: map, aliases: map, typed: map): map := {
	found = {}
	for name in classes.keys.filter(name => not typed.has(name)) {
		declared = classes[name]
		# (the fields' types as the emitter reads them: a field `q: Q` is held as `q: type Q` by now)
		written = field_types(class_view(declared.top_statement)#3)
		types = signature_types(declared.fields.map(field => written.get(field) ?? any_word), aliases)
		if types.any(type => union_members(type).any(member => #(targets.get(member) ?? []) > 0)) { found[name] = types }
	}
	found
}
# `P(q: 3)`, `P { q: 3 }` of a class taking a converted field: each named field's value passed to its type
named_fields_passed(call: Node, places: Places, known: map): Node := group_like(call, [call#1] + items_of(call)[1 ..].map(argument => field_passed(argument, name_of(call#1), places, known)))
braced_fields_passed(made: Node, places: Places, known: map): Node := Key(key_of(made), op_of(made), group_like(value_of(made), items_of(value_of(made)).map(argument => field_passed(argument, name_of(key_of(made)), places, known))))
field_passed(argument: Node, class_name: text, places: Places, known: map): Node := {
	fields = places.classes[class_name].fields
	if not (is_key(argument, Op.Colon) and key_of(argument) is symbol and name_of(key_of(argument)) in fields) { return argument }
	Key(key_of(argument), Op.Colon, passed(value_of(argument), places.typed[class_name]#(fields.index_of(name_of(key_of(argument)))), class_name, places, known))
}
# whether the node makes an instance of a class taking a converted field
makes_converting_class(name: Node, places: Places): bool := name is symbol and places.classes.has(name_of(name)) and places.typed.has(name_of(name))
# the parameter types a call of such a function passes its arguments to, one each, else ø (a named argument too)
positional_types(call: Node, typed: map): list? := {
	if not (is_call(call) and call#1 is symbol and typed.has(name_of(call#1))) { return ø }
	types = typed[name_of(call#1)]
	arguments = items_of(call)[1 ..]
	if #arguments != #types or arguments.any(argument => is_key(argument, Op.Colon) or is_key(argument, Op.Assign)) then ø else types
}
# where values pass to typed places: name → the parameter types of each function converting some (typed_parameters),
# the types the program converts to or checks, a class's own [] (decision class-types-checked), each class declared
# and the functions of several results, whose call a typed place picks one of (arity_overloads.warp result_overloads)
class Places { typed: map; converting: map; classes: map; results: map }
# each call of such a function with its arguments for those parameters converted, the function's name the taker a
# refusal names, and each `x: T = v` so, x the taker; a named argument as it is, and a value known to be a T already:
# a parameter typed so of the definition around it (`g(d: Length) := f(d)`), the instance of a constructor of the class
converted_arguments(n: Node, places: Places, known: map): Node := {
	call = definition_call(n)
	if call != ø { return Key(key_of(n), Op.Define, converted_arguments(value_of(n), unshadowed(places, bound_at(n)), parameters_typed(call))) }
	walked = children(n, x => converted_arguments(x, places, known))
	if is_key(walked, Op.Assign) and is_key(key_of(walked), Op.Colon) and key_of(key_of(walked)) is symbol and value_of(key_of(walked)) is symbol {
		return Key(key_of(walked), Op.Assign, passed(value_of(walked), name_of(value_of(key_of(walked))), name_of(key_of(key_of(walked))), places, known))
	}
	types = positional_types(walked, places.typed)
	if types == ø and is_call(walked) and makes_converting_class(walked#1, places) { return named_fields_passed(walked, places, known) }
	if walked is key and op_of(walked) in [Op.None, Op.Colon] and makes_converting_class(key_of(walked), places) and is_group(value_of(walked)) and bracket_of(value_of(walked)) == "{" { return braced_fields_passed(walked, places, known) }
	if types == ø { return walked }
	arguments = items_of(walked)[1 ..]
	# (a method a dispatcher calls, `equal·method`, by a name no program writes: its dispatch tests the types, "" no taker)
	taker = if name_of(walked#1).contains("·") then "" else name_of(walked#1)
	group_like(walked, [walked#1] + (1 to #arguments).map(at => passed(arguments#at, types#at, taker, places, known)))
}
passed(value: Node, type: text, taker: text, places: Places, known: map): Node := if converts_to(type, places.converting) and not known_as(value, type, places, known) then call_of(argument_conversion_name(type), [value, Text(taker)]) else value
# the places without the functions a parameter or variable of the definition shadows, `apply: function` called
# `apply([item])`, `named = (m => …)` called `named(w)` (card local-shadowing)
unshadowed(places: Places, names: list): Places := {
	if names.any(name => places.typed.has(name)) then Places(without_keys(places.typed, names), places.converting, places.classes, places.results) else places
}
# name → type of each parameter of a definition
parameters_typed(call: Node): map := {
	typed = {}
	for parameter in signature_of(items_of(call)).parameters { if parameter.type_name != "" { typed[parameter.name] = parameter.type_name } }
	typed
}
# whether the value is known to be of a member class of the type, or of one extending it, or is the call of a function
# of several results, which the place picks
known_as(value: Node, type: text, places: Places, known: map): bool := {
	plain = unparenthesized(without_mark(value))
	head = if is_group(plain) and #plain > 0 and plain#1 is symbol then name_of(plain#1) else ""
	if places.results.has(head) { return yes }
	given = if plain is symbol and known.has(name_of(plain)) then known[name_of(plain)] else if is_call(plain) and places.classes.has(head) then head else ""
	given != "" and union_members(type).any(member => places.classes.has(member) and descends_from(given, member, places.classes))
}
descends_from(name: text, ancestor: text, classes: map): bool := name == ancestor or (classes.has(name) and classes[name].parent != "" and descends_from(classes[name].parent, ancestor, classes))
# the functions defined more than once, each declaring its result, `render(t) as pdf := …` beside `… as docx`: read
# before the definitions pass normalizes the heads (arity_overloads.warp overloaded_results reads them after)
several_results(statements: list): map := {
	found = {}
	for statement in statements {
		call = definition_call(statement)
		if call != ø and call#1 is symbol and (is_key(key_of(statement), Op.As) or is_key(key_of(statement), Op.Colon)) { found[name_of(call#1)] = (found.get(name_of(call#1)) ?? 0) + 1 }
	}
	without_keys(found, found.keys.filter(name => found[name] < 2))
}
# a name defined bare more than once, each with its result type, `sample: int := 7` beside `sample: text := "seven"`:
# a function of no parameters of several results, `sample(): int := 7`, the type at its use choosing (card
# duplicate-function-definitions); a single `x: T := e` stays as written
result_heads(program: Node): Node := {
	statements = statements_in(program)
	names = statements.map(bare_result_name).filter(name => name != "")
	several = names.filter(name => #names.filter(other => other == name) > 1)
	if #several == 0 { return program }
	statements_as(program, statements.map(statement => if bare_result_name(statement) in several then nullary_head(without_mark(statement)) else name_calls(statement, several)))
}
# n with each bare use of the names as their call, `sample` → `sample()`; a call written as one kept
name_calls(n: Node, names: list): Node := {
	if n is symbol and name_of(n) in names { return call_node(n, []) }
	if is_call(n) and n#1 is symbol and name_of(n#1) in names { return call_node(n#1, items_of(n)[1 ..].map(item => name_calls(item, names))) }
	children(n, child => name_calls(child, names))
}
# `name: T := e`'s name, else ""
bare_result_name(statement: Node): text := {
	plain = without_mark(statement)
	if is_key(plain, Op.Define) and is_key(key_of(plain), Op.Colon) and key_of(key_of(plain)) is symbol and value_of(key_of(plain)) is symbol then name_of(key_of(key_of(plain))) else ""
}
nullary_head(definition: Node): Node := Key(Key(call_node(key_of(key_of(definition)), []), Op.Colon, value_of(key_of(definition))), Op.Define, value_of(definition))
# the types of the program's `x: T = v`
declared_types(program: Node): list := nodes_in(program).filter(n => is_key(n, Op.Assign) and is_key(key_of(n), Op.Colon) and key_of(key_of(n)) is symbol and value_of(key_of(n)) is symbol).map(n => name_of(value_of(key_of(n))))

# the program with its conversions as functions, before its statements (its last one stays its value), and their uses
# as calls
conversions(program: Node): Node := {
	aliases = type_aliases(statements_in(program))
	if aliases { program = List(statements_in(program).map(statement => unaliased_conversions(statement, aliases)), Bracket.None, Separator.Newline) }
	scope = scope_of(program)
	targets = {}
	order = []
	kept = []
	# (a conversion to a class the program lacks, units' Quantity as Duration without lib/time, is left out)
	for statement in statements_in(program) {
		conversion = conversion_of(statement, scope)
		if conversion == ø {
			kept += [result_type_checked(statement, scope, aliases)]
		} else if conversion#1 == conversion#2 {
			kept += [diagnose(call_of("own_type_conversion", [conversion#2]), statement)]
		} else if names_type(symbol(conversion#2), scope) {
			if not targets.has(conversion#2) {
				targets[conversion#2] = []
				order += [conversion#2]
			}
			targets[conversion#2] = targets[conversion#2] + [conversion]
		}
	}
	# `x as P` of a class P the program converts nothing to: its instance as it is, any other value refused
	for target in class_targets(program, scope) {
		if not targets.has(target) {
			targets[target] = []
			order += [target]
		}
	}
	# (@primitive code's classes are structs, no class places: a check would hold any value)
	classes = if lowering_primitive() then {} else class_declarations(program)
	checked = if not order and not classes {
		if #kept == #statements_in(program) then program else List(kept, Bracket.None, Separator.Newline)
	} else {
		functions = order.map(target => conversion_functions(target, targets[target], targets, scope)).flatten()
		# (a class checked with no conversions to it: a copy, `x as C` converts only to targets)
		converting_to = entries_of_both(targets, {})
		for name in classes.keys { if not targets.has(name) { converting_to[name] = [] } }
		typed = typed_parameters(kept, converting_to, aliases)
		places = Places(entries_of_both(constructor_parameters(classes, targets, aliases, typed), typed), converting_to, classes, several_results(kept))
		converting = {}
		for type in places.typed.values.flatten() + declared_types(program) { if converts_to(type, places.converting) { converting[type] = yes } }
		functions += converting.keys.map(type => argument_conversion(type, places.converting, classes))
		# (a program's conversions are its own, seeing every module's: never a linked module's of the same name, time's
		# passed·Duration knowing no Quantity)
		if module_written == "" { own_words_unlinked(functions.map(f => name_of(definition_call(f)#1))) }
		List(functions + kept.map(statement => converted_arguments(converting_uses(statement, targets), places, {})), Bracket.None, Separator.Newline)
	}
	forced_conversions(checked)
}

# `render(t) as pdf := …` with no type pdf is refused, never a variable declared pdf (Interviewer screen 11-08, card
# render-pdf-string): a result's type must be a type, declared `type pdf = text`, a class, or a built-in one
result_type_checked(statement: Node, scope: map, aliases: map): Node := {
	if not (is_key(statement, Op.Define) and is_key(key_of(statement), Op.As)) { return statement }
	head = key_of(key_of(statement))
	type = value_of(key_of(statement))
	if not (is_group(head) and bracket_of(head) == "(" and #head > 0 and head#1 is symbol and type is symbol) { return statement }
	if names_type(type, scope) or aliases.has(name_of(type)) { return statement }
	diagnose(call_of("result_type_unknown", [name_of(type)]), statement)
}
# the classes the program declares that an `x as P` names, its declarations `x as P = v` too; not its enums, whose
# `2 as Level` is the case at an index, `66 as Key` the case of that number (plain_enums, extensions/sugar/enums.warp)
class_targets(program: Node, scope: map): list := {
	enums = declarations_found(program, declared_enum, {})
	nodes_in(program).filter(n => is_key(n, Op.As) and value_of(n) is symbol and is_capitalized(name_of(value_of(n))) and binds_as(scope, name_of(value_of(n)), Meaning.Type) and not enums.has(name_of(value_of(n)))).map(n => name_of(value_of(n))).unique()
}

# `type Q = P`: name → the type it names, Q → P, of each alias the program declares of one type
type_aliases(statements: list): map := {
	aliases = {}
	for statement in statements {
		if is_key(statement, Op.Assign) and value_of(statement) is symbol {
			name = aliased_type_name(key_of(statement))
			if name != ø { aliases[name] = name_of(value_of(statement)) }
		}
	}
	aliases
}
# the statement with an alias named as the type it names: the target of every `x as Q`, both types of a conversion's
# head `q as Q := …` (`n: q as Q := …`); a value's own name, `length as pixels` of a variable length, stays
unaliased_conversions(statement: Node, aliases: map): Node := {
	targets_named = targets_unaliased(statement, aliases)
	if not is_key(targets_named, Op.Define) { return targets_named }
	head = as_phrase_read(key_of(targets_named))
	head = if is_key(head, Op.As) then Key(unaliased_type(key_of(head), aliases), Op.As, value_of(head)) else if is_key(head, Op.Colon) and is_key(value_of(head), Op.As) then Key(key_of(head), Op.Colon, Key(unaliased_type(key_of(value_of(head)), aliases), Op.As, value_of(value_of(head)))) else key_of(targets_named)
	Key(head, Op.Define, value_of(targets_named))
}
targets_unaliased(n: Node, aliases: map): Node := {
	walked = children(n, x => targets_unaliased(x, aliases))
	if is_group(walked) and #walked == 3 and walked#2 == symbol("as") { return group_like(walked, [walked#1, walked#2, unaliased_type(walked#3, aliases)]) }
	if is_key(walked, Op.As) then Key(key_of(walked), Op.As, unaliased_type(value_of(walked), aliases)) else walked
}
unaliased_type(n: Node, aliases: map): Node := if n is symbol and aliases.has(name_of(n)) then symbol(aliases[name_of(n)]) else n

# --- forced conversions, `x as! T` (decision checked-forced-conversions, convert-bang) ---
# A library writes `convert!(n: number, to: byte) := …`, the twin of `n: number as byte := …`. `to: T` names the target
# type, not a value of that type. Every such declaration becomes one function `convert!(value, to)`, and `x as! T`
# becomes `convert!(x, to: T)`. The 64-bit int wrap stays `as! int` (the emitter's wrapped_int). A named pattern stays
# for match_patterns. A map forced to a class the program declares, and no convert! of that class, drops unknown fields.

# [source type or "", target, body, the body's name of the value] of `convert!(n: number, to: byte) := body`, else ø
forced_conversion_of(n: Node): list? := {
	if not is_key(n, Op.Define) { return ø }
	head = key_of(n)
	if not is_call(head) or not (head#1 is symbol) or not is_convert_name(name_of(head#1)) { return ø }
	arguments = items_of(head)[1 ..]
	if #arguments != 2 { return ø }
	target = ""
	param = ""
	source = ""
	for argument in arguments {
		if is_key(argument, Op.Colon) and key_of(argument) is symbol and name_of(key_of(argument)) == "to" and value_of(argument) is symbol {
			target = name_of(value_of(argument))
		} else if argument is symbol {
			param = name_of(argument)
		} else if is_key(argument, Op.Colon) and key_of(argument) is symbol and value_of(argument) is symbol {
			param = name_of(key_of(argument))
			source = name_of(value_of(argument))
		} else { return ø }
	}
	if target == "" or param == "" { return ø }
	[source, target, value_of(n), param]
}
# the type of `x as! T`, else ø
forced_type_name(n: Node): text? := {
	if not is_forced_as(n) { return ø }
	type = value_of(value_of(n))
	if type is symbol then name_of(type) else ø
}
# `convert!` as written, and the program's own copy of it once a library defines the same word (`convert!·own`)
convert_word = "convert!"
is_convert_name(name: text): bool := name == convert_word or name == own_word(convert_word)
# `convert!·byte`: one function per target, so a linked prelude `convert!` is not what `as! byte` calls when this
# program adds a target, and a literal `to: T` needs no run-time name test
clause_name(target: text): text := convert_word + "·" + target
# the target of `convert!(x, to: byte)` or `convert!(x, to: symbol("tiny"))` when it is written out, else ø
literal_forced_target(call: Node): text? := {
	if not is_call(call) or not (call#1 is symbol) or not is_convert_name(name_of(call#1)) { return ø }
	arguments = items_of(call)[1 ..]
	if #arguments < 2 { return ø }
	argument = arguments#2
	if not is_key(argument, Op.Colon) or not (key_of(argument) is symbol) or name_of(key_of(argument)) != "to" { return ø }
	value = value_of(argument)
	if value is symbol { return name_of(value) }
	if value is text { return value }
	if is_call(value) and #value == 2 and value#1 is symbol and name_of(value#1) == "symbol" and value#2 is text { return value#2 }
	ø
}
# `x as! T` and a literal `convert!(x, to: T)` call `convert!·T` when this program has that target; a target only the
# linked prelude converts (`as! byte` with no local clause) stays `convert!(x, to: symbol(T))`
forced_uses(n: Node, patterns: map, written: map): Node := {
	walked = children(n, x => forced_uses(x, patterns, written))
	literal = literal_forced_target(walked)
	if literal != ø and written.has(literal) {
		arguments = items_of(walked)[1 ..]
		return call_of(clause_name(literal), [arguments#1])
	}
	name = forced_type_name(walked)
	if name == ø or name in patterns or keeps_wrapped_int(name) { return walked }
	if written.has(name) { return call_of(clause_name(name), [key_of(walked)]) }
	call_of(convert_word, [key_of(walked), Key(symbol("to"), Op.Colon, call_of("symbol", [name]))])
}
forced_value = symbol("value")
# `raise "no forced conversion to T of that value"`
forced_refusal(target: text): Node := call_of(raise_word, ["no forced conversion to " + target + " of that value"])
# a field's zero when a map omits it: 0, 0.0, "", no, [], and ø for an optional or unknown type
forced_field_zero(type: text?): Node := {
	if type == ø or type == "" or type != required_type(type) { return ø }
	if type in ["int", "integer", "long", "i64", "i32", "nat", "byte", "int8", "int16", "int32", "int64", "uint8", "u8", "uint16", "uint32", "uint64", "hex", "binary", "octal"] { return 0 }
	if type in ["float", "double", "f64", "f32", "float32", "float64"] { return 0.0 }
	if type in ["text", "str", "string"] { return "" }
	if type in ["bool", "boolean"] { return no }
	if type == "list" { return [] }
	ø
}
# `Person{name: map_get_or(value, "name", ""), …}`: the declared fields, unknown map keys left out
forced_instance(class_name: text, declared: Declared, value: Node): Node := {
	entries = []
	for name in declared.fields {
		if name != ø and name != "" {
			zero = forced_field_zero(if name in declared.field_types then declared.field_types[name] else ø)
			entries += [Key(symbol(name), Op.Colon, call_of("map_get_or", [value, name, zero]))]
		}
	}
	fields = if #entries == 0 then ø else List(entries, Bracket.Curly, Separator.Newline)
	Key(symbol(class_name), Op.None, fields)
}
# the branch of one target: typed sources in the order written (the last tried first), then an untyped source, then a
# class built from a map, then the refusal
forced_branch(target: text, clauses: list, classes: map, patterns: map, written: map): Node := {
	typed = clauses.filter(conversion => conversion#1 != "")
	untyped = clauses.filter(conversion => conversion#1 == "")
	branch = if #untyped > 0 then forced_body(untyped.last, patterns, written) else if target in classes then chosen(Key(forced_value, Op.Is, symbol("map")), forced_instance(target, classes[target], forced_value), forced_refusal(target)) else forced_refusal(target)
	for conversion in typed.reverse() {
		branch = chosen(Key(forced_value, Op.Is, symbol(conversion#1)), forced_body(conversion, patterns, written), branch)
	}
	branch
}
forced_body(conversion: list, patterns: map, written: map): Node := forced_uses(renamed(conversion#3, conversion#4, forced_value), patterns, written)
# `convert!·T(value)` for each target this program converts by force
forced_functions(order: list, written: map, classes: map, patterns: map): list := order.map(target => Key(call_of(clause_name(target), [forced_value]), Op.Define, forced_branch(target, written.get(target) ?? [], classes, patterns, written)))
# the classes still declared in these statements, by name
forced_classes(statements: list): map := {
	classes = {}
	for statement in statements {
		view = class_view(statement)
		if view != ø {
			name = declared_type_name(view#2)
			if name != ø and name != "" { classes[name] = class_declared(statement, view) }
		}
	}
	classes
}
# the program with its convert! declarations as the one dispatcher, and `x as! T` as calls of it
forced_conversions(program: Node): Node := {
	patterns = named_patterns_of(program)
	found = []
	kept = []
	for statement in statements_in(program) {
		conversion = forced_conversion_of(statement)
		if conversion == ø { kept += [statement] } else { found += [conversion] }
	}
	asked = []
	seen = {}
	for n in nodes_in(program) {
		name = forced_type_name(n)
		if name != ø and name not in patterns and not keeps_wrapped_int(name) and not seen.has(name) {
			seen[name] = yes
			asked += [name]
		}
	}
	if #found == 0 and #asked == 0 { return program }
	classes = forced_classes(kept)
	written = {}
	order = []
	for conversion in found {
		target = conversion#2
		if not written.has(target) {
			written[target] = []
			order += [target]
		}
		written[target] = written[target] + [conversion]
	}
	for name in asked {
		if name in classes and not written.has(name) {
			written[name] = []
			order += [name]
		}
	}
	rewritten = kept.map(statement => forced_uses(statement, patterns, written))
	List(forced_functions(order, written, classes, patterns) + rewritten, Bracket.None, Separator.Newline)
}

conversions_extension = Extension{name: "conversions", passes_before: {"definition_heads": result_heads}, passes: {"definition_heads": conversions}}
