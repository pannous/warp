# `interpret x` of data or a block written in the program sees the names where it is written, as a closure does; eval of a
# text sees only what its `with:` names (user 11-13 via warp-interviewer, cluster runtime-eval-scope). Each call
# `interpret(x)` passes the variables the program's data reads that it can see, interpret(x, with: {a: a}), which
# lib/interpret.warp binds as eval's `with:` does; before arity_overloads names the variant the call takes

INTERPRET_WORD = "interpret"

interpret_scope(program: Node) as Node := {
	if not mentions(program, INTERPRET_WORD) { return program }
	read = data_names(program)
	if #read == 0 { return program }
	main = statements_in(program).filter(statement => definition_call(without_mark(statement)) == ø).flat_map(names_assigned)
	statements_as(program, statements_in(program).map(statement => scoped_statement(statement, read, main)))
}
scoped_statement(statement: Node, read: list, main: list) as Node := {
	plain = without_mark(statement)
	call = definition_call(plain)
	if call == ø { return scoped_calls(statement, read, main + loops_in(plain)) }
	own = items_of(call)[1 ..].map(parameter => name_of(leftmost_symbol(parameter))) + names_assigned(value_of(plain)) + loops_in(value_of(plain))
	Key(key_of(plain), Op.Define, scoped_calls(value_of(plain), read, main + own))
}
# the variables of the loops in n, `i` of `for i in 1..4 { s += interpret(xs#1) }`, seen by the calls inside them
loops_in(n: Node) as list := nodes_in(n).flat_map(loop_variables)
data_names(program: Node) as list := nodes_in(program).filter(is_quote).flat_map(quote => nodes_in(quote#2).filter(n => n is symbol).map(name_of))
scoped_calls(n: Node, read: list, visible: list) as Node := {
	seen = read.filter(name => name in visible).unique()
	# (only a statement calling interpret is rebuilt: bottom_up anew loses what a rule keeps opaque)
	if #seen == 0 or not mentions(n, INTERPRET_WORD) then n else bottom_up(n, part => if is_call_form(part) and #part == 2 and part#1 == symbol(INTERPRET_WORD) then with_names(part, seen) else part)
}
with_names(call: Node, names: list) as Node := group_like(call, [call#1, call#2, Key(symbol("with"), Op.Colon, List(names.map(name => Key(symbol(name), Op.Colon, symbol(name))), Bracket.Curly, Separator.Comma))])

interpret_scope_extension = Extension{name: "interpret_scope", passes_before: {"arity_overloads": interpret_scope}}
