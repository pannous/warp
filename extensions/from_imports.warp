# `from list import zip` (decision modules-triage): Python's import of named words, which core/passes/uses.warp reads
# as `use list`; its hint says so, every word of the module being visible, its message in core/analysis/hints.data

from_import_hint(n: Node, program: Node) := {
	imported = from_line(without_mark(n))
	if imported == ø { return ø }
	diagnose(call_of("from_import", [if imported is text then imported else name_of(imported)]), n)
}

from_imports_extension = Extension{name: "from_imports", lints: [from_import_hint]}
