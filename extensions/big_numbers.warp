# Big numbers (card big-numbers-extension): ints past 64 bits, exact ratios, exact rounding and float pow. Its runtime
# root, which its Extension row in extensions/extensions.warp names: compiler.warp joins it after the core's runtime roots.
# The core reaches these words only through the hooks core/runtime/bridge.warp declares, whose bodies for big ints and
# ratios are here; the emitter calls the exact rounding words by name where a program needs them. Powers, `as rational`
# and the long decimals are big_numbers/big_numbers.warp, a module linked on demand (card runtime-bridge-slots).
# Its parts use the core's runtime files as lib/ links them (lib/compiler is core/).
use "big_numbers/big_ints.warp"
use "big_numbers/exact.warp"
use "big_numbers/big_ratios.warp"
use "big_numbers/exact_rounding.warp"
use "../compiler/runtime/intrinsics.warp"
use "../compiler/analysis/kinds.warp"
use "../compiler/runtime/instructions.warp"
use "../compiler/runtime/nodes.warp"
use "../compiler/runtime/conversions.warp"
# each case compiled in only when the program makes values of its kind
extended_number_text(n: Node) as text := {
	made_case(Made.Ratio, exact_text(n))
	made_case(Made.BigInt, exact_text(n))
	fail()
}
extended_order(a: Node, b: Node) as int := exact_order(a, b)
extended_sum(a: Node, b: Node) as Node := exact_add(a, b)
extended_difference(a: Node, b: Node) as Node := exact_sub(a, b)
extended_product(a: Node, b: Node) as Node := exact_mul(a, b)
extended_floor_quotient(a: Node, b: Node) as Node := floored_node(exact_div(a, b))
extended_quotient(a: Node, b: Node) as Node := exact_div(a, b)
extended_modulo(a: Node, b: Node) as Node := exact_mod(a, b)
extended_remainder(a: Node, b: Node) as Node := exact_rem(a, b)
extended_floor(n: Node) as Node := exact_floor(n)
extended_big_literal(digits: text) as Node := big_int_of_digits(digits)
extended_float(n: Node) as float := {
	made_case(Made.BigInt, big_exact_float(n))
	float(exact_numerator(n)) / float(exact_denominator(n))
}
extended_truncated(n: Node) as int := {
	made_case(Made.BigInt, big_exact_truncated(n))
	int_quotient(exact_numerator(n), exact_denominator(n))
}
extended_wrapped(n: Node) as int := int_of_magnitude(n, big_int_negative(n))
extended_ratio(n: int, d: int) as Node := exact_ratio(n, d)
extended_fraction(n: int, d: int) as Node := fraction_of(exact_ratio(n, d))
