// Other languages' ways of writing a declaration (card pure-class-forms) that decide what the parser reads next: a run
// of modifiers mixing warp's (`public export fun f()`), and the forms `new Point(1, 2)`, Ruby's `attr_accessor :x`,
// Kotlin's `data class`, `mixin Name {…}`, read as the warp form they mean (Kotlin's `enum class` is
// extensions/sum_types.warp's). Modifiers without warp meaning alone (`public static fun f()`, `private x = 4`) and
// `constant x` are rewrite rules: extensions/sugar/declarations.warp
// Each word below is a keyword reader (core/extension.warp keyword_readers) of one reader, foreign_form: it reads with
// the parser's expression and atom, and answers ø, nothing read, where the form is not there

// Modifiers of other languages with no meaning in warp ; `static` marks the statement
FOREIGN_MODIFIERS = ["private", "protected", "internal", "static", "extern", "external", "C", "inline", "local", "virtual", "override", "abstract", "constexpr", "volatile", "thread_local", "synchronized", "transient", "native"]
// Modifiers with a warp meaning that change nothing before a function definition (a function is global and constant);
// `public f(x) := …` marks an untyped library word its importers may call, read off the module's text (decision
// library-word-visibility), the definition the same without it
DEFINITION_MODIFIERS = ["global", "export", "import", "const", "final", "mutable", "mut", "public"]
PUBLIC_WORD = "public"
// Words before a class declaration that change nothing in warp: `data class` (a warp class compares by value already),
// `open`, `abstract`, `sealed`, `final`, visibility
CLASS_MODIFIERS = ["data", "open", "abstract", "sealed", "final", "public", "private", "internal"]
// Ruby's field declarations `attr_accessor :x, :y`
RUBY_FIELD_WORDS = ["attr_accessor", "attr_reader", "attr_writer"]
STATIC_WORD = "static"
NEW_WORD = "new"
MIXIN_WORD = "mixin"

// The form another language writes with `word` at the parser's position, the parser after it; else ø, nothing read
def foreign_form(p: Parser, word: text): Node := {
	if starts_statement(p) {
		skipped = without_foreign_modifiers(p, word)
		if skipped != ø { return skipped }
	}
	keyword = class_keyword_after(p, word)
	if keyword and CLASS_MODIFIERS.contains(word) {
		p.at = blank_end(p, p.at + word.length)
		return type_declaration(p, keyword)
	}
	if word == NEW_WORD and p.types.contains(name_after_blanks(p, word)) {
		p.at = blank_end(p, p.at + word.length)
		return atom(p)
	}
	if p.type_body and RUBY_FIELD_WORDS.contains(word) { return ruby_fields(p, word) }
	if word == MIXIN_WORD and block_after_name(p, word) { return type_declaration(p, word) }
	ø
}

// `public export fun f(){…}` (P78): a run of modifiers with one of warp's that ends before a function definition is
// skipped; the statement after it, marked @static after `static`. A run without warp's is extensions/sugar/declarations.warp's
def without_foreign_modifiers(p: Parser, first: text): Node := {
	if not is_modifier(first) { return ø }
	words = [first]
	at = p.at + first.length
	while true {
		start = spaces_end(p, at)
		// `public = 3`, `public(…)`: a name
		if start == at { return ø }
		at = name_end(p.code, start, p.n)
		next = p.code[start .. at]
		if not is_modifier(next) {
			foreign_only = words.all(word => FOREIGN_MODIFIERS.contains(word))
			public_definition = #words == 1 and first == PUBLIC_WORD and char_at(p, at) == "("
			if foreign_only or not (function_keywords.contains(next) or public_definition) { return ø }
			p.at = start
			statement = expression(p, 0)
			return if words.contains(STATIC_WORD) then attributed(STATIC_WORD, true, statement) else statement
		}
		words += [next]
	}
}

def is_modifier(word: text): bool := FOREIGN_MODIFIERS.contains(word) or DEFINITION_MODIFIERS.contains(word)

// Ruby's `attr_accessor :x, :y` in a class body: the fields x and y, read to the end of the line
def ruby_fields(p: Parser, word: text): Node := {
	start = p.at + word.length
	end = start
	while end < p.n and not "\n;}".contains(p.code[end]) { end += 1 }
	names = p.code[start .. end].split(",").map(name => without_colon(name.trim()))
	if not names.all(name => name and name_end(name, 0, name.length) == name.length) { return ø }
	p.at = end
	listed(Bracket.None, Separator.Semicolon, names.map(name => symbol(name)))
}

def without_colon(name: text): text := if name.starts_with(":") then name[1 .. name.length] else name

foreign_words = FOREIGN_MODIFIERS + DEFINITION_MODIFIERS + CLASS_MODIFIERS + RUBY_FIELD_WORDS + [NEW_WORD, MIXIN_WORD]
foreign_declarations_extension = Extension{name: "foreign_declarations", keyword_readers: reading_rows(foreign_words, foreign_form)}
