# A function's own words (cards name-params, doc-signature): `f.name` the text it is named by, `f.params` (also
# `f.parameters`) the names of its parameters, `f.body` the code it computes, `f.definition` its whole definition as
# code to paste (extensions/rules/rule_words.warp definition_text), `f.doc` its doc text, `f.signature` and
# `f.return_type` as the analyzer infers them (extensions/rules/rule_words.warp parameters_named, body_of, doc_of, signature_text,
# return_kind); a word it has none of but another one means is refused naming that one. A library word's signature,
# params and help read its typed line (builtin_signature), the program's own definition first
rewrite $f.name => $n where $f is symbol and $f is function and $n = spelled($f)
rewrite $f.params => [$names...] where $f is symbol and $names = parameters_named($f, $program)
rewrite $f.parameters => [$names...] where $f is symbol and $names = parameters_named($f, $program)
rewrite $f.body => data $b where $f is symbol and $f is function and $b = body_of($f, $program)
rewrite $f.doc => $d where $f is symbol and $f is function and $d = doc_of($f, $program, $source)
# `square.effects`: what the function does besides giving its value, ["IO"], [] when pure
# (extensions/effects.warp effects_named, card effects-lists)
rewrite $f.effects => [$effects...] where $f is symbol and $f is function and $effects = effects_named($f, $program)
rewrite $f.signature => $s where $f is symbol and $s = signature_text($f, $program)
rewrite $f.signatures => [$s...] where $f is symbol and $s = signatures_listed($f, $program)
rewrite $f.return_type => $r where $f is symbol and $f is function and $r = return_kind($f, $program)
# the prelude's aliases of doc and return_type (decision synonyms-are-aliases), which a member word doesn't take
rewrite $f.description => $f.doc where $f is symbol and $f is function
rewrite $f.returns => $f.return_type where $f is symbol and $f is function
rewrite $f.representation => $refused where $f is symbol and $f is function and $refused = misnamed($f, representation, body)
rewrite $f.definition => $d where $f is symbol and $f is function and $d = definition_text($f, $program, $source)
rewrite $f.full => $d where $f is symbol and $f is function and $d = full_definition($f, $program, $source)
# `P.fields`, `P.methods` of a class the program declares: fields(P), methods(P) below (decision: one reflection set);
# properties, attributes and members say fields too, unless the class has a member of that name (field_word)
rewrite $c.$w => [$names...] where $c is symbol and $f = field_word($w, $program) and $names = class_fields_listed($c, $program, $source)
rewrite $c.methods => [$functions...] where $c is symbol and $functions = class_methods_listed($c, $program, $source)
# `p.fields`, `p.methods` of an instance the program makes of a class, `p = Point(3, 4)` (extensions/rules/rule_words.warp
# instance_members)
rewrite $p.$w => [$names...] where $p is symbol and $f = field_word($w, $program) and $names = instance_members($p, $f, $source)
rewrite $p.methods => [$names...] where $p is symbol and $names = instance_members($p, methods, $source)
# `p.class`, as p.type (wiki/reflection.md)
rewrite $p.class => type($p) where $p is instance
# `functions` is a synonym of methods (decision methods-declared); a type word's or alias's methods, `text.methods`
# (extensions/rules/rule_words.warp type_methods)
rewrite $c.functions => [$functions...] where $c is symbol and $functions = class_methods_listed($c, $program, $source)
rewrite $p.functions => [$names...] where $p is symbol and $names = instance_members($p, methods, $source)
rewrite $t.methods => [$names...] where $t is symbol and $names = type_methods($t, $program, $source)
rewrite $t.functions => [$names...] where $t is symbol and $names = type_methods($t, $program, $source)
# `fields(B)`, `methods(B)` of a class the program declares: its field names, its methods (inherited and outside ones
# among them) as function values (extensions/rules/rule_words.warp class_fields_listed, class_methods_listed)
rewrite $w($c) => [$names...] where $f = field_word($w, $program) and $c is symbol and $names = class_fields_listed($c, $program, $source)
rewrite methods($c) => [$functions...] where $c is symbol and $functions = class_methods_listed($c, $program, $source)
rewrite functions($c) => [$functions...] where $c is symbol and $functions = class_methods_listed($c, $program, $source)
# `fields(p)` of an instance the program makes, as p.fields
rewrite $w($p) => [$names...] where $f = field_word($w, $program) and $p is symbol and $names = instance_members($p, $f, $source)
# `functions()`: the program's own functions as function values (extensions/rules/rule_words.warp program_functions)
rewrite functions() => [$functions...] where not method and $functions = program_functions($program, $source)
# `type(sqrt)`: a library word's signature, `builtin: (x:number) -> number`; `type(area)` of a function the program
# or a module defines, `function: (w: int) -> int` (extensions/rules/rule_words.warp builtin_type)
rewrite type($f) => $t where $f is symbol and $t = builtin_type($f, $program)
rewrite $f.dump => $refused where $f is symbol and $f is function and $refused = misnamed($f, dump, definition)

# `dir(time)`, `dir text`: the words of a module or type named as written (extensions/rules/rule_words.warp dir_words); `dir(v)` of
# a value only the run knows: a map's keys then its words, a list's or a text's words, none of a number (lib/prelude.warp
# dir_of_value). A program's own dir wins
rewrite dir $x => dir($x)
rewrite dir($m) => [$names...] where $m is symbol and $names = dir_words($m, $program)
rewrite dir($p) => [$names...] where $p is symbol and $names = instance_members($p, dir, $source)
rewrite dir($c) => [$names...] where $c is symbol and $names = class_dir($c, $program, $source)
rewrite dir($x) => dir_of_value($x, $words...) where $words = value_dir_words($program)
# the views of a module's words besides dir (card dir-filters): `time.functions`, `time.attributes`, `time.classes`,
# `list.operators` (the operators it declares, `∪`, which dir leaves out) (extensions/rules/rule_words.warp module_view)
rewrite $m.functions => [$names...] where $m is symbol and $names = module_view($m, functions, $program)
rewrite $m.attributes => [$names...] where $m is symbol and $names = module_view($m, attributes, $program)
rewrite $m.classes => [$names...] where $m is symbol and $names = module_view($m, classes, $program)
rewrite $m.operators => [$names...] where $m is symbol and $names = module_view($m, operators, $program)

# `help(Point)`, `help(area)`, `help(sound)`, `help(draw.save)`: what a class, a function or a module is, as text (extensions/rules/rule_words.warp
# class_help, function_help, module_help, module_word_help; wiki/reflection.md); a program's own help wins
rewrite help $x => help($x)
# each help's text marked help_line: help_lines_printed (extensions/rules/rule_words.warp) prints one on its own line,
# as Python's help (user decision help-statement), unless it is the value of a block or of the program
rewrite $p => $q where program and $q = help_lines_printed($p)
rewrite help($m.$w) => help_line($t) where $m is symbol and $w is symbol and $t = qualified_word_help($m, $w, $program)
rewrite help($c) => help_line($t) where $c is symbol and $t = class_help($c, $program, $source)
rewrite help($f) => help_line($t) where $f is symbol and $t = function_help($f, $program, $source)
rewrite help($m) => help_line($t) where $m is symbol and $t = module_help($m, $program)
rewrite help($w) => help_line($t) where $w is symbol and $t = module_word_help($w, $program, $source)
rewrite help($e) => help_line($t) where $e is symbol and $t = enum_help($e, $program, $source)
# `help(trick)` of a name or an instance only the run knows: looked up at run time among the program's and its
# modules' words (extensions/rules/rule_words.warp value_helps, lib/prelude.warp looked_up_word)
rewrite help($x) => help_line(looked_up_word($x, "help", $helps...)) where $helps = value_helps($program, $source)
# `function(trick).definition`: the definition, as written, of the word a name only the run knows names
rewrite function($x).definition => looked_up_word($x, "function", $definitions...) where $definitions = value_definitions($program, $source)
