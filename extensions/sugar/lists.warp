# Typed arrays (notes/layers.md, sugar): `int[3]`, which the parser reads as the subscript `int#4`, is the list of 3
# zeros of the type, zero_fill(3, 0); `float[n]` of float zeros, `text[n]` of empty texts. A program binding the type
# word as a value indexes it.
# `xs#(2…4)`, `s#(2…4)`: a slice counted from 1 as `xs#2` is, `…` taking its end and `..` stopping before it; a prefix
# `#(1 … 5)` has no list and counts
rewrite $xs#($a … $b) => $xs[($a - 1) .. $b] where $xs is not missing
rewrite $xs#($a .. $b) => $xs[($a - 1) .. ($b - 1)] where $xs is not missing
rewrite $t#$n => zero_fill($n - 1, $zero) where $zero = type_zero($t)
# `640000*int`, `26 * char`, `100 * ints`, `16 int`: the count times the type (singular or plural), n zeros of it;
# `x : 100 numbers`, `x : int[100]` declare x so
rewrite $x : $n * $t => $x = zero_fill($n, $zero) where $zero = type_zero($t)
rewrite $x : $t#$n => $x = zero_fill($n - 1, $zero) where $zero = type_zero($t)
rewrite $x : $n $t => $x = zero_fill($n, $zero) where $zero = type_zero($t)
rewrite $n * $t => zero_fill($n, $zero) where $zero = type_zero($t)
rewrite $n $t => zero_fill($n, $zero) where $n is number and $zero = type_zero($t)
rewrite $n $t => zero_fill($n, $zero) where $n is value and $zero = type_zero($t)

# The type forms of a list (card list-type-forms, wiki/list.md "Typed lists"): `x = int[]` (the parser's `x = [int]`)
# and `x = list of numbers` (or `list of number`) are the empty list of the type, as `int[0]`
rewrite ($x = [int]) => ($x = zero_fill(0, 0))
rewrite ($x = [float]) => ($x = zero_fill(0, 0 as float))
rewrite ($x = [text]) => ($x = zero_fill(0, ""))
rewrite ($x = [$t]) => ($x = []) where $t is type
rewrite ($x = list of int) => ($x = zero_fill(0, 0))
rewrite ($x = list of float) => ($x = zero_fill(0, 0 as float))
rewrite ($x = list of text) => ($x = zero_fill(0, ""))
rewrite ($x = list of $t) => ($x = []) where $t is type
rewrite ($x = list of numbers) => ($x = [])
rewrite ($x = list of ints) => ($x = zero_fill(0, 0))
rewrite ($x = list of floats) => ($x = zero_fill(0, 0 as float))
rewrite ($x = list of texts) => ($x = zero_fill(0, ""))
rewrite ($x = list of strings) => ($x = zero_fill(0, ""))
rewrite ($x = list of bools) => ($x = [])

# A conversion to a list of a type (card pure-as-conversions): `["1", "2"] as list of int` converts each item, [1, 2]
# a unit type walks a text by that unit first, as `for codepoint in t` does: `"שָלוֹם" as list of codepoint` is its six code
# points, never its four characters (card list-codepoint)
rewrite ($v as list of $t) => walked_by($v, $unit).map($x => $x as $t) where $unit = unit_of_type($t)

# `count bytes in t`: the text's byte size, ahead of the `in` of a membership
rewrite (count bytes in $t) => byte_size($t)

# `xs are in t`: every item of xs is in t (decisions are-words-in, all-words-in)
rewrite ($xs are in $t) => $xs.all($x => collection_contains($t, $x))
# `all xs in t`, `are xs in t`: the same; `any xs in t`: some item of xs is in t (decision all-any-in), only where xs is
# a value the program has, never a fresh name (`for all x in xs`)
rewrite (all $xs in $t) => $xs.all($x => collection_contains($t, $x)) where $xs is not unbound
rewrite (are $xs in $t) => $xs.all($x => collection_contains($t, $x)) where $xs is not unbound
rewrite (any $xs in $t) => $xs.any($x => collection_contains($t, $x)) where $xs is not unbound
# A filter (card pair-count-filter): `xs where it > 2` is the items the condition holds for, `it` each item, also as a
# call's argument, `count(xs where it is Pair)`; a field named bare reads the item's (decision P223, `people where age > 18`)
rewrite ($xs where $c...) => $xs.filter(it => $d) where $d = bare_fields_read($c..., $program)
rewrite $f($xs where $c...) => $f($xs.filter(it => $d)) where $d = bare_fields_read($c..., $program)
# `for p in people where p.age > 90 {…}`: the filter reads the loop's variable, and `it` as well (`where it > 2`)
rewrite for $x in $xs.filter(it => $c) {$body...} => for $x in $xs.filter($x => $d) {$body...} where $x is symbol and $d = it_read_as($c, $x)
