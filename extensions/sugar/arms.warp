# Match arms as other languages spell them, in warp's own (notes/layers.md, sugar; Rust twin: welcome_forms.rs
# lower_match_arms): `k => v` is the arm `k: v` (of several patterns too, `1, 2 => v`), `_ => v` and `else -> v` the arm `default: v`, Swift's `case .north: 1`
# and `.north: 1` the arm of the case north, `case 1: v` the arm `1: v`. `switch` is match's other word.
# a match over the cases of one enum that leaves one out is refused naming it (card pure-lane-def)
rewrite match $s $arms => $refused where $refused = missed_cases($arms, $program)
rewrite match $s {$arms...} => match $s {($k: $v) for ($k => $v) in $arms...}
rewrite match $s {$arms...} => match $s {($ks..., $k: $v) for ($ks..., $k => $v) in $arms...}
rewrite match $s {$arms...} => match $s {(default: $v) for (_: $v) in $arms...}
rewrite match $s {$arms...} => match $s {(default: $v) for (else: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (case.$k: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (.$k: $v) in $arms...}
rewrite match $s {$arms...} => match $s {($k: $v) for (case $k: $v) in $arms...}
rewrite switch $s {$arms...} => match $s {$arms...}
# `when` by its shape (notes/decisions.md "`when` by shape"): arms after a subject, `when x {1 -> "a"; else -> "b"}`,
# are a match, `when ping {…}` listens as `on ping {…}` (extensions/sugar/events.warp); each says the word meant
rewrite when $s $body: block => match $s $body where are_arms($body) and alias
# a rule set as a value, `simplify = rules { data($a * 1) => a }`: a function rewriting code at any depth, children
# first, each node again while a rule fits it
rewrite rules {$arms...} => (rules_code => rewritten_everywhere(rules_code, rules_node => match rules_node {$arms..., _ => ø}))
