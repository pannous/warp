# Enum cases (notes/layers.md, sugar): `Color.Red`, Rust's `Color::Red` are the case Red the enum Color declares, kept
# so to the emitter, which makes each case of each enum once (a case knows its enum, card case-enum-carry); Swift's arm
# `case .red:` the case red of the one enum declaring it
rewrite $e::$c => $e.$c where $c is case of $e
# `Shape::Rect(2, 3)`, `Shape.Rect(2, 3)`: the case carrying data, made by its own name, so its data stays; a name
# holding an instance (`main.result`) stays a member
rewrite $e::$c => $c where $c is instance
rewrite $e.$c => $c where $e is symbol and $c is instance and $c is not symbol
rewrite case.$c => $c where $c is case

# `c is Coin` (type_tests.warp's is_type(c, "Coin")) of an enum: c is one of its cases
rewrite is_type($v, $e) => collection_contains([cases of $e], $v) where $e is enum

# A case's number: `Coin.Dime as int` (also `as index`) its index from 0, as C counts, `as position` its position from
# 1, as `xs#p` counts; of a name holding a case too (`c = Coin.Dime`, `c: Coin`)
rewrite $v as int => collection_position([cases of $e], $v) - 1 where $v is case of $e
rewrite $v as index => collection_position([cases of $e], $v) - 1 where $v is case of $e
rewrite $v as position => collection_position([cases of $e], $v) where $v is case of $e
# the case at an index, `2 as Coin`, `Coin(2)`; an index no case has is an error. A typed operator of `as` (decision
# rules-to-typed-operators): its body is spliced in, so `cases of e` lists the cases of the enum e names
infix operator as(n: any, e: enum) := (k = n; cs = [cases of e]; if k >= 0 and k < count(cs) then cs#(k + 1) else raise "" + k + " is no case: the cases count from 0 to " + (count(cs) - 1))
# the case of a name, `"Dime" as Coin`; a name no case has is an error (decision enum-case)
infix operator as(name: text, e: enum) := (cs = [cases of e]; named = cs.filter(c => "" + c == name); if count(named) > 0 then named#1 else raise name + " is no case of " + cs.join(", "))
rewrite $e($n) => $n as $e where $e is enum
