# Named events (wiki/events.md): `on alarm {…}` listens, its block reading the event's data as `event`; `once alarm {…}`
# listens for the first one only; `emit alarm{level: 3}` (also fire, send, trigger) runs the listeners in order and
# gives the last one's result. A listener is numbered within its event: `h = on alarm {…}`, `listeners of alarm`,
# `remove h from listeners of alarm`. An item of a structure, `button{ "+1", on click {…} }`, is the structure's own
# Handler (lib/markup.warp). The registry is the prelude's (lib/prelude.warp listen)
rewrite on $e $body: block => handler(data $e, event => $body) where $e is symbol and item
# `input{ bind: name }` (card input-bind-name): the variable as code to read and to write, the field's two-way binding
# (lib/markup.warp Binding); its writer makes the items reading name live (rewrites.warp early_sugared)
rewrite bind: $v => bind: binding(() => $v, entered => { $v = entered }) where item and $v is symbol
# an item reading a variable a handler writes is live, recomputed each time it is shown (decision markup-keeps):
# `p{ "count: " + count }`, `class: (if done then "done" else "open")`
rewrite $k: $v => $k: live(() => $v) where item and $v is varying
rewrite $e => live(() => $e) where item and $e is varying
# `when ping {…}` is `on ping {…}` (notes/decisions.md "`when` by shape"; arms after `when` are a match, arms.warp)
rewrite when $e $body: block => on $e $body where $e is symbol and not are_arms($body) and alias
# `when x > 2 {…}` reads three ways, refused naming if, once and whenever (user, card should-offer)
rewrite when $c $body: block => $refused where $refused = when_readings($c)
rewrite when $c: $body => $refused where $refused = when_readings($c)
rewrite on $e $body: block => listen(data $e, event => $body, no) where $e is symbol
rewrite on $e: $body => listen(data $e, event => $body, no) where $e is symbol
rewrite once $e $body: block => listen(data $e, event => $body, yes) where $e is symbol
rewrite remove $h from listeners of $e => unlisten(data $e, $h) where $e is symbol
rewrite listeners of ($e -= $h) => unlisten(data $e, $h) where $e is symbol
rewrite count listeners of $e => count(listeners_of(data $e)) where $e is symbol
rewrite listeners of $e => listeners_of(data $e) where $e is symbol
rewrite emit $e: $v => emitted(data $e, $v)
rewrite emit $e $v => emitted(data $e, $v) where $e is symbol
rewrite emit $e => emitted(data $e, ø) where $e is symbol
rewrite fire $e... => emit $e...
// `send v to: c`, also without the colon, is no event: the call of lib/channels.warp's send (decision named-argument-phrases)
rewrite send $v to: $c => send($v, to: $c)
rewrite send $v to $c => send($v, to: $c)
rewrite send $e... => emit $e...
rewrite trigger $e... => emit $e...
# a program that listens shows no value when it ends in a registration (its handle is for a name to keep, card
# listener-value), and defines page_value(), its last expression again, for the page to show after each firing
# (extensions/rules/rule_words.warp listening_program)
rewrite $p => $q where program and $q = listening_program($p)
# `on error of f { 7 }`: a failing call of f gives the handler's value (extensions/rules/rule_words.warp errors_handled)
rewrite $p => $q where program and $q = errors_handled($p)
