# Big numbers linked on demand (card runtime-bridge-slots, user decision (c)): float and int powers, the cube root,
# `x as rational` and the decimals past 18 places (a literal past 64 bits stays in runtime.wasm: the
# prelude writes one, u64's range). A standard module of runtime code (its row's
# runtime_modules, extensions/extensions.warp): `warp rebuild` builds it behind runtime.wasm, where the rest of big
# numbers stays (overflow, ÷, show), and a program links it when its source can make one of these values
# (big_number_uses.warp). Only the emitter calls its extended_ words, so runtime.wasm never needs it. Its functions
# compile as runtime words do: intrinsics and the runtime's own words
use "../../compiler/runtime/intrinsics.warp"
use "pow.warp"
# `x as rational` of a run-time float (decision float-as-rational; Rust twin float_as_exact in
# rust-harness:src/wasm_emitter/numbers/float_text.rs): the exact value of its shortest digits, 1.4142135623730951 as
# 14142135623730951/10^16; ∞ and NaN have no fraction
float_as_exact(x: float): Node := {
	# x - x is 0 for every finite x, NaN for ∞ and NaN
	if x - x != 0 { not_a_finite_number() }
	if x == 0 { return exact_ratio(0, 1) }
	sign = if x < 0 then -1 else 1
	# `then -x else` reads as a subtraction from then
	magnitude = if x < 0 then 0 - x else x
	found = float_digits(magnitude)
	digits = unboxed_int(found#1)
	shift = unboxed_int(found#2)
	if shift <= 0 { return exact_ratio(sign * multiplied_within_64_bits(digits, 10, -shift), 1) }
	# digits / (2^shift · 5^shift), the common factors taken out first so the denominator fits where it can
	twos = shift
	fives = shift
	while twos > 0 and int_remainder(digits, 2) == 0 {
		digits = int_quotient(digits, 2)
		twos -= 1
	}
	while fives > 0 and int_remainder(digits, 5) == 0 {
		digits = int_quotient(digits, 5)
		fives -= 1
	}
	exact_ratio(sign * digits, multiplied_within_64_bits(multiplied_within_64_bits(1, 5, fives), 2, twos))
}
# n · factor^times of n ≥ 0; beyond 64 bits it fails as an int64 overflow (Rust's twin goes on in big ints)
multiplied_within_64_bits(n: int, factor: int, times: int): int := {
	for i in 0..times {
		if n > int_quotient(9223372036854775807, factor) { overflow_of_int64() }
		n = n * factor
	}
	n
}
# `base ^ exponent` of exact numbers (rust-harness:src/wasm_emitter/numbers/exact.rs exact_pow): an int exponent only, a negative one
# inverts the base first: 2^-2 is 1/4, (2/3)^2 is 4/9; a rational exponent fails here, which traps.rs names. An int
# to a positive power is unbounded, 2^10000 a big int of 3011 digits (big_ints.warp)
exact_pow(base: Node, exponent: Node): Node := {
	if is_ratio(exponent) { fail() }
	times = unboxed_int(exponent)
	if times < 0 {
		base = fraction_kept(exact_ratio(exact_denominator(base), exact_numerator(base)), base, base)
		times = -times
	}
	if not is_ratio(base) and times < 64 and bit_length(unboxed_int(base)) * times < 64 { return int_pow(unboxed_int(base), times) }
	if not is_ratio(base) { return big_int_power(unboxed_int(base), times) }
	# a ratio in lowest terms stays in lowest terms raised to any power
	fraction_kept(ratio_of(int_pow(ratio_numerator(base), times), int_pow(ratio_denominator(base), times)), base, base)
}
# the digits of a decimal past 18 places over 10^places (emitter literals.warp big_decimal)
decimal_ratio(digits: text, places: int): Node := big_ratio(big_int_of_digits(digits), big_int_power(10, places))
# the emitter's calls (core/emitter operators.warp, literals.warp, emitter.warp)
# (2/3)^2 is 4/9 (decision exact-power); a ratio exponent has no exact power, (2/3)^(1/2) is the float one
extended_power(base: Node, exponent: Node): Node := if is_ratio(exponent) then held(float_pow(float_of_node(base), float_of_node(exponent))) else exact_pow(base, exponent)
extended_exact_float(x: float): Node := float_as_exact(x)
extended_decimal(digits: text, places: int): Node := decimal_ratio(digits, places)
extended_float_power(x: float, y: float): float := float_pow(x, y)
extended_cube_root(x: float): float := float_cbrt(x)
