# Mixins (wiki/keyword.md mixin, with): `mixin Walker { steps: int = 0; walk() := name + " walks" }` declares fields
# and methods for classes to take in, `class Duck with Walker, Swimmer { name }`, or `include Walker` in a class body.
# A member the class writes itself wins over a mixin's. A mixin is no class of its own: its methods read the fields of
# the class taking it in (`name` above)
MIXIN_MARK = "mixin"
WITH_WORD = "with"
INCLUDE_WORD = "include"

# the program with each mixin's members in the classes taking it in, the mixins themselves gone
mixins_applied(program: Node): Node := {
	statements = flat_statements(program)
	mixins = {}
	for statement in statements {
		view = mixin_view(statement)
		if view != ø { mixins[declared_type_name(view#2)] = view#3[3..] }
	}
	if #mixins == 0 { return program }
	kept = statements.filter(statement => mixin_view(statement) == ø).map(statement => with_mixins_taken(statement, mixins))
	separated(bracketed(kept, ""), ";")
}

# the view of `mixin Walker {…}`, a class declaration marked mixin, else ø
mixin_view(statement: Node): list? := {
	view = class_view(statement)
	if view != ø and view#2#1 == "attribute" and view#2#2 == MIXIN_MARK then view else ø
}

# `class Duck with Walker {…}`, parsed as the bodiless class, `with` and `Walker: {…}`: the class with its body and the
# mixins' members; a class including a mixin in its body, `include Walker`, the same; any other statement as it is
with_mixins_taken(statement: Node, mixins: map): Node := {
	clause = with_clause(statement)
	if clause != ø {
		match clause#1 {
			Key(left, key_op, right): return Key(left, key_op, ["type", right#2, mixed_body(view_of(clause#3)[3..], clause#2, mixins)])
			_: return statement
		}
	}
	view = class_view(statement)
	if view == ø { return statement }
	own = view#3[3..].filter(member => included_mixin(member) == ø)
	included = view#3[3..].map(included_mixin).filter(name => name != ø)
	if #included == 0 { return statement }
	match statement {
		Key(left, key_op, right): Key(left, key_op, [view#1, view#2, mixed_body(own, included, mixins)])
		_: statement
	}
}

# a class body's view: its own members, then each mixin's the class doesn't write itself
mixed_body(own: list, taken: list, mixins: map): list := {
	for name in taken { if not mixins.has(name) { raise "`" + name + "` is no mixin the program declares" } }
	written = own.map(mixed_member_word)
	mixed = concatenated(taken.map(name => mixins[name])).filter(member => mixed_member_word(member) not in written)
	["list", '{', ';'] + own + mixed
}

# [the bodiless class, the mixins' names, the body] of `class Duck with Walker {…}`, which parses as the group
# `class Duck`, `with`, `Walker: {…}`, and with more mixins as the comma list of the group `class Duck with Walker`, the
# names after it, the last `Swimmer: {…}`; else ø
with_clause(statement: Node): list? := {
	parts = match statement {
		List(items, Bracket.None, Separator.Comma): items
		_: [statement]
	}
	head = parts#1
	if not (is_group(head) and #head == 3 and head#2 == symbol(WITH_WORD)) { return ø }
	named = [head#3] + parts[1 ..]
	last = named#(#named)
	listed = named[0 ..< #named - 1]
	if not (is_key(last, Op.Colon) and key_of(last) is symbol and listed.all(name => name is symbol)) { return ø }
	[head#1, (listed + [key_of(last)]).map(name => name_of(name)), value_of(last)]
}

# the mixin a body member `include Walker` names, else ø
included_mixin(member: list): text? := {
	n = node_of(member)
	if is_group(n) and #n == 2 and n#1 == symbol(INCLUDE_WORD) and n#2 is symbol then name_of(n#2) else ø
}

# the word a member defines, a method's or a field's
mixed_member_word(member: list): text := {
	n = member_read(member)
	defined_word(n) ?? field_name(n)
}

mixins_extension = Extension{name: "mixins", passes_before: {"with_type_module_uses": mixins_applied}}
