# A parameter given a value with a colon, `f(a, b: 0) := …`, is refused with its fix, `b = 0`: in a definition's head
# `:` gives a type and `=` a default (night decision parameter-named-fails). Its message is in core/analysis/errors.data

parameter_value(n: Node, program: Node) := {
	parts = definition_of(without_mark(n))
	if parts == ø { return ø }
	valued = parts.parameters.find(parameter => is_key(parameter, Op.Colon) and key_of(parameter) is symbol and is_literal_value(value_of(parameter)))
	if valued == ø { return ø }
	diagnose(call_of("parameter_value", [name_of(key_of(valued)), value_of(valued)]), valued)
}
is_literal_value(n: Node): bool := n is number or n is text

parameter_values_extension = Extension{name: "parameter_values", lints: [parameter_value]}
