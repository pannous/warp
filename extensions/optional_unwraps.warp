# `x!` of an optional (decision x-unwrap, wiki/optional.md): `x: int? = 5; x! * 2` is 10, and `x!` of an x holding ø
# raises "x is missing". A variable the program declares `name: T? = …` unwraps as `x ?? raise "x is missing"`; any
# other `x!` keeps its meaning (a value itself, a block run).
optional_unwraps_extension = Extension{name: "optional_unwraps", passes_before: {"rules_rewritten": optional_unwraps}}

OPTIONAL_MARK = "?"
MISSING = " is missing"

optional_unwraps(program: Node): Node := {
	optionals = OptionalNames()
	bottom_up(program, n => noted_optional(n, optionals))
	if #optionals.names == 0 { return program }
	bottom_up(program, n => unwrapped_optional(n, optionals))
}
class OptionalNames {
	names: map = {}
}

# notes the name of `name: T? = …`
noted_optional(n: Node, optionals: OptionalNames): Node := {
	if is_key(n, Op.Assign) and is_key(key_of(n), Op.Colon) {
		declared = key_of(n)
		if key_of(declared) is symbol and value_of(declared) is symbol and name_of(value_of(declared)).ends_with(OPTIONAL_MARK) { optionals.names[name_of(key_of(declared))] = yes }
	}
	n
}

# `(unwrap x)` of an optional x as `x ?? raise "x is missing"`
unwrapped_optional(n: Node, optionals: OptionalNames): Node := {
	if not (is_group(n) and bracket_of(n) == "(" and #n == 2 and n#1 == symbol(unwrap_word)) { return n }
	x = n#2
	if not (x is symbol and optionals.names.has(name_of(x))) { return n }
	Key(x, Op.Coalesce, List([symbol("raise"), name_of(x) + MISSING], Bracket.None, Separator.Space))
}
