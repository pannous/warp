# Effect annotations (decision effect-annotations, notes/effects.md): `@pure f(x) := …`, `@io`, `@ffi` mark a definition
# with the effects it may have, meta annotations as `@primitive` is; a function with an effect its marks leave out is
# refused, naming the calls that lead to it: `@pure shout(t) := print t` does IO via shout → print.
# A function's effects are those of the words it calls, the program's functions and the library's it reaches followed
# through their bodies: the host's words and the emitter's that read or write (print, read) do IO, a foreign line's
# word (`sqrt(x: f64): f64 from "c"`) is FFI. Allocation is pure (`[x, x]`), as construction is (wiki/pure.md)

# each mark → the effects it allows
EFFECT_MARKS = {pure: [], io: ["IO"], ffi: ["FFI"]}
# the emitter's words that read or write; every host word but the pure one does IO
emitter_io_words = ["print", "read"]
pure_host_words = ["std_pure"]

# the effect a word has by itself, else ø: FFI of a foreign line's word, IO of a host or emitter word that does IO
own_effect(word: text, foreign: map): text? := {
	if foreign.has(word) { return "FFI" }
	if word in emitter_io_words or (host_words().has(word) and word not in pure_host_words) { return "IO" }
	ø
}

# name → the marks the program gives it, of each function it marks
effect_marks_given(): map := {
	given = {}
	for mark in EFFECT_MARKS.keys {
		for name in marked_names.get(mark) ?? [] { if mark not in (given.get(name) ?? []) { given[name] = (given.get(name) ?? []) + [mark] } }
	}
	given
}

# the program as it is, once every marked function has only the effects its marks allow; else refused with the first
# chain of calls to an effect they leave out
checked_effects(program: Node): Node := {
	given = effect_marks_given()
	if #given == 0 { return program }
	sources = effect_sources(program)
	for name in given.keys {
		allowed = given[name].flat_map(mark => EFFECT_MARKS[mark])
		chain = effect_chain(name, sources#1, sources#2, allowed, {})
		if chain != ø { raise "${name} is marked ${given[name].map(mark => "@" + mark).join(" ")} but does ${chain#(#chain)} via ${chain[0 ..< #chain - 1].join(" → ")}" }
	}
	program
}

# [name → body of each function the program defines, name → yes of each foreign line's word]
effect_sources(program: Node): list := {
	bodies = {}
	foreign = {}
	for statement in statements_in(program) {
		if is_function_definition(statement) { bodies[declared_name(statement)] = value_of(statement) }
		else if is_foreign_line(statement) { foreign[declared_name(statement)] = yes }
	}
	[bodies, foreign]
}
# `effects of f`, `f.effects` (card effects-lists): what the function does besides giving its value, ["IO"], [] of a
# pure one, each effect a chain of its calls reaches
effects_named(function: Node, program: Node): Node := {
	sources = effect_sources(program)
	found = []
	chain = effect_chain(name_of(function), sources#1, sources#2, found, {})
	while chain != ø {
		found += [chain#(#chain)]
		chain = effect_chain(name_of(function), sources#1, sources#2, found, {})
	}
	List(found, Bracket.Square, Separator.Comma)
}

# the calls from word to an effect not allowed, the effect last: [shout, print, "IO"]; else ø
effect_chain(word: text, bodies: map, foreign: map, allowed: list, seen: map): list? := {
	effect = own_effect(word, foreign)
	if effect != ø { return if effect in allowed then ø else [word, effect] }
	if not bodies.has(word) or seen.has(word) { return ø }
	seen[word] = yes
	for called in symbol_words(bodies[word]) {
		chain = effect_chain(called, bodies, foreign, allowed, seen)
		if chain != ø { return [word] + chain }
	}
	ø
}

# --- purity predicates and `purely` (card purity-predicates, wiki/pure.md) ---
# `f.pure?` is yes when f reaches no effect and none of the words below; `f.input?`, `f.output?`, `f.random?` whether
# it reaches a word that reads the world, writes it, or answers differently each call (the time does both)
INPUT_WORDS = ["read", "input", "fetch", "now", "clock", "time", "today", "env", "args"]
OUTPUT_WORDS = ["print", "puts", "eprint", "write", "append", "say", "warn"]
RANDOM_WORDS = ["random", "now", "clock", "time", "today"]
PURITY_PREDICATES = {"input?": INPUT_WORDS, "output?": OUTPUT_WORDS, "random?": RANDOM_WORDS}
PURE_PREDICATE = "pure?"
# `purely f(x) := …` is `@pure f(x) := …`: the definition checked to have no effect
PURELY_WORD = "purely"

# the program without its `purely` words, each definition they lead marked pure, its predicates answered
purity_read(program: Node): Node := {
	statements = statements_in(program)
	if not statements.any(statement => purity_lead(statement) == PURELY_WORD) and not mentions_predicate(program) { return program }
	bodies = function_bodies(statements.map(statement => if purity_lead(statement) == PURELY_WORD then without_first_word(statement) else statement))
	plain = bottom_up(program, n => if purity_lead(n) == PURELY_WORD and n in statements then purely_marked(n) else n)
	bottom_up(plain, n => predicate_answered(n, bodies))
}
# the definition `purely` leads, its name marked pure
purely_marked(statement: Node): Node := {
	definition = without_first_word(statement)
	# (a spaced head, `purely square x = x * x`, is no definition yet where purely is read: its first word names it)
	name = declared_name(definition) ?? (if purity_lead(definition) != "" then purity_lead(definition) else ø)
	if name == ø { raise "purely marks a definition: purely square(x) := x * x" }
	marked_names["pure"] = (marked_names.get("pure") ?? []) + ["${name}"]
	definition
}
# the word n starts with, its first part's first part: `purely` of `purely square x = …`, else ""
purity_lead(n: Node): text := {
	if n is symbol { return name_of(n) }
	if n is key { return purity_lead(key_of(n)) }
	if is_group(n) and #n > 0 { return purity_lead(n#1) }
	""
}
# n without the word it starts with
without_first_word(n: Node): Node := {
	if n is key { return Key(without_first_word(key_of(n)), op_of(n), value_of(n)) }
	if not is_group(n) or #n == 0 { return n }
	if n#1 is symbol { return if #n == 2 then n#2 else group_like(n, items_of(n)[1..]) }
	group_like(n, [without_first_word(n#1)] + items_of(n)[1..])
}
mentions_predicate(program: Node): bool := nodes_in(program).any(n => n is symbol and (name_of(n) == PURE_PREDICATE or PURITY_PREDICATES.has(name_of(n))))
# name → body of each function the statements define
function_bodies(statements: list): map := {
	bodies = {}
	for statement in statements { if is_function_definition(statement) { bodies["${declared_name(statement)}"] = value_of(statement) } }
	bodies
}
# `f.pure?` as yes or no, of a function the program defines; any other node as it is
predicate_answered(n: Node, bodies: map): Node := {
	if not (is_key(n, Op.Dot) and key_of(n) is symbol and value_of(n) is symbol) { return n }
	name = name_of(key_of(n))
	predicate = name_of(value_of(n))
	if not bodies.has(name) { return n }
	if predicate == PURE_PREDICATE { return if is_pure(name, bodies) then Node.True else Node.False }
	if PURITY_PREDICATES.has(predicate) { return if reaches_word(name, bodies, PURITY_PREDICATES[predicate], {}) then Node.True else Node.False }
	n
}
# whether the function reaches no effect, no input, output or randomness
is_pure(name: text, bodies: map): bool := effect_chain(name, bodies, {}, [], {}) == ø and not PURITY_PREDICATES.values.any(words => reaches_word(name, bodies, words, {}))
# whether the calls from word reach one of the words
reaches_word(word: text, bodies: map, words: list, seen: map): bool := {
	if word in words { return yes }
	if not bodies.has(word) or seen.has(word) { return no }
	seen[word] = yes
	symbol_words(bodies[word]).any(called => reaches_word(called, bodies, words, seen))
}

# after the last pure pass, the library's definitions the program reaches beside its own
effects_extension = Extension{name: "effects", attributes: EFFECT_MARKS.keys, passes_before: {"tries": purity_read}, passes: {"number_keys": checked_effects}}
