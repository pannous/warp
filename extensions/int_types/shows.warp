# The int types' declarations and show hooks, as int_types.warp marks and renames them: class_methods.warp reads them
# too, so a class's routed show() never falls back to a hook that int_types.warp renames away (card
# module-arity-overloads)

# the number types a marked type is held as: `type Color = int`, `type Angle = float`
MARKED_NUMBER_KINDS = {int: Kind.Int, float: Kind.Float}
# `type Color = int`, `type Angle = float`: Color, Angle; ø for any other statement
int_type_name(statement: Node): text? := {
	if not is_key(statement, Op.Assign) or not (value_of(statement) is symbol) or name_of(value_of(statement)) not in MARKED_NUMBER_KINDS { return ø }
	declared = key_of(statement)
	if not (is_key(declared, Op.Colon) and key_of(declared) == opaque_symbol) { return ø }
	view = value_of(declared)
	if kind_of(view) == "type" and view#3 == ø then declared_type_name(view#2) else ø
}
# each number type the statements declare, its marked kind: the number's Kind with the type's mark above it, the
# marks numbered in order of declaration (int_types.warp marks the values, the emitter the values it holds unboxed)
int_type_kinds(statements: list): map := {
	kinds = {}
	for statement in statements {
		name = int_type_name(statement)
		if name != ø and name not in kinds { kinds[name] = MARKED_NUMBER_KINDS[name_of(value_of(statement))] + (TypeMark.First + #kinds) * KindUnit.Info }
	}
	kinds
}
# `format Color c as text := …` (the user's decision format-as-text, not show: showing is no printing): the hook giving
# a value of Color its text, read as `format·text(c: Color) := …`, a class's shown form's name (core/passes/classes.warp
# form_method), before any pass takes it for a call of lib/text format. Of a class of the program, `format Point p as
# text := …`, it is the class's own `format as text`, its p the instance
formatted_definitions(program: Node): Node := {
	statements = statements_in(program).map(formatted_definition)
	classes = statements.map(class_view).filter(view => view != ø).map(view => declared_type_name(view#2))
	formats = statements.filter(statement => shower_of(statement) in classes)
	if #formats == 0 { return group_like(program, statements) }
	group_like(program, statements.filter(statement => statement not in formats).map(statement => with_class_formats(statement, formats)))
}
# a class declaration with the formats of its class among its members
with_class_formats(statement: Node, formats: list): Node := {
	view = class_view(statement)
	if view == ø { return statement }
	owned = formats.filter(format => shower_of(format) == declared_type_name(view#2)).map(format => view_of(instance_format(format)))
	if #owned == 0 then statement else Key(key_of(statement), op_of(statement), [view#1, view#2, view#3 + owned])
}
# `format·text(p: Point) := …` as Point's method `format·text() := …`, p its this
instance_format(format: Node): Node := {
	instance = key_of(key_of(format)#2)
	Key(call_of(form_method, []), Op.Define, bottom_up(value_of(format), n => if n == instance then symbol("this") else n))
}
formatted_definition(statement: Node): Node := {
	if not is_key(statement, Op.Define) or not is_group(key_of(statement)) { return statement }
	words = items_of(key_of(statement))
	if not (#words == 5 and words.all(word => word is symbol)) { return statement }
	if [words#1, words#4, words#5].map(name_of) != ["format", "as", "text"] { return statement }
	Key(call_of(form_method, [Key(words#3, Op.Colon, words#2)]), Op.Define, value_of(statement))
}
# the type a module's line `format Angle a as text := …` gives its text, "" of any other line: the hook is a slice of
# Angle's, reached with the type (core/passes/prelude_words.warp name_defined_in)
formatted_type(line: text): text := {
	words = line.split(":=")#1.split(" ").filter(word => word != "")
	if line.contains(":=") and #words == 5 and words#1 == "format" and words#4 == "as" and words#5 == "text" then words#2 else ""
}
# `format·text(c: Color) := …`: Color; ø for any other statement
shower_of(statement: Node): text? := {
	if not is_key(statement, Op.Define) { return ø }
	head = key_of(statement)
	if not (is_group(head) and #head == 2 and head#1 == symbol(form_method) and is_key(head#2, Op.Colon)) { return ø }
	typed = value_of(head#2)
	if typed is symbol then name_of(typed) else ø
}
# the statements showing a value of one of the program's int types
int_type_showers(statements: list): list := {
	types = statements.map(int_type_name).filter(name => name != ø)
	statements.filter(statement => shower_of(statement) in types)
}
