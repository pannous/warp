# `use js Name` (card js-webidl-bindings, decision js-webidl-bindings): a JavaScript global of the page, its members
# reached through the host word foreign_call (web/playground/host-foreign.js in the page; natively the native host module's
# hidden web view, decision native-js-webview, notes/webview.md), checked and typed by the standard WebIDL in lib/web.webidl. A member its interface lacks is a
# compile error; a value of an interface keeps its type (`u = URL(…)`, `u.pathname`); a text or a number comes back
# as warp's own, with warp's members (`crypto.randomUUID().upper()`).
#   Name.member(a, b)  foreign_call("js", "Name", "member", 1, [a, b])
#   Name.member        foreign_call("js", "Name", "member", 0, [])
#   Name(a)            the constructor, `new Name(a)` (member ""); a function of the global scope (`atob(t)`) is called
#   x.member = v       member "set member"
# A global WebIDL does not declare (Math, JSON) is reached unchecked, and so is what its members give.
# `use python json` (card rewrite-example-hide; `use json from python` says the same): a module of another runtime,
# reached through that runtime's library, which works natively and in the page (lib/native/python.warp: libpython,
# Pyodide's C API); its members go unchecked, a missing one failing as the runtime's own error (AttributeError)
#   json                 python_import("json")
#   json.dumps(a)        python_member(python_import("json"), "dumps", 1, [a])
foreign_globals_extension = Extension{name: "foreign_globals", passes_before: {"rules_rewritten": foreign_globals}}

JS_RUNTIME = "js"
# the runtimes reached through their library, <runtime>_import(name) and <runtime>_member(target, member, called,
# arguments); every value they give is typed by the runtime's name, so its members go there too
LIBRARY_RUNTIMES = ["python"]
FOREIGN_RUNTIMES = [JS_RUNTIME] + LIBRARY_RUNTIMES
IMPORT_SUFFIX = "_import"
MEMBER_SUFFIX = "_member"
USE_WORD = "use"
FROM_WORD = "from"
FOREIGN_CALL = "foreign_call"
# each js call's value goes through it: a promise the page keeps is waited for (lib/prelude.warp)
FOREIGN_SETTLED = "foreign_settled"
# a function handed to js with its parameters' count, and the module that keeps it for js to call back
# (lib/callbacks.warp js_function)
JS_FUNCTION = "js_function"
CALLBACKS_MODULE = "callbacks"
SETTER_PREFIX = "set "
GLOBAL_SCOPE = "globalThis"
# the page's window itself, which WebIDL declares as no attribute: the global scope, of interface Window
PAGE_WINDOW = "window"
# the types WebIDL names that are another's: a WindowProxy (defaultView, contentWindow) is its Window (HTML 7.2.3)
# an element of the page by its id (decision page-ids): `who.focus()` is document.getElementById("who").focus()
ID_ATTRIBUTE = "id"
PAGE_DOCUMENT = "document"
ELEMENT_LOOKUP = "getElementById"
PAGE_ELEMENT_TYPE = "HTMLElement"
# the interfaces whose attributes and operations are the page's globals (`crypto`, `atob`)
GLOBAL_INTERFACES = ["Window", "WindowOrWorkerGlobalScope", "WorkerGlobalScope", "WindowLocalStorage", "WindowSessionStorage"]
# read from lib/ the first time a program reaches the page's js (load on demand)
WEBIDL = "web.webidl"
# ECMAScript's own globals (Math, JSON, Reflect), written as WebIDL beside the web's
ECMASCRIPT_WEBIDL = "ecmascript.webidl"
use "js_globals/webidl.warp"

# --- the program ---

# The program with its `use js` lines taken out (a library runtime's become `use python`) and the uses of their globals
# as foreign calls
foreign_globals(program: Node): Node := {
	uses = foreign_uses(program)
	scopes = markup_scopes(program)
	markup = #scopes > 0
	if markup { uses += page_globals_read(program, uses.map(used => used#2)).map(name => [JS_RUNTIME, name, no]) }
	names = uses.map(used => used#2)
	ids = page_ids(scopes, names_bound_in(program))
	elements = page_elements(program, ids)
	if #names == 0 and #ids == 0 and #elements == 0 { return program }
	scope = JsScope(arities: function_arities(program))
	for used in uses { scope.globals[used#2] = if used#1 == JS_RUNTIME then js_global_type(used#2) else used#1 }
	for id in ids { scope.elements[id] = yes }
	for id in elements { scope.dollar_elements[PAGE_MARK + id] = id }
	lowered = bottom_up(program, n => js_lowered(n, scope))
	if scope.hands_functions { lowered = first_statement(lowered, use_statements([CALLBACKS_MODULE])#1) }
	if markup then first_statement(lowered, call_node(symbol(PAGE_SHOWN_IN_JS), [])) else lowered
}
# a page reaching the page's js has its markup in the js runtime's document (lib/markup.warp page_in_js): natively
# the hidden web view then holds `who` for `who.focus()`
PAGE_SHOWN_IN_JS = "page_shown_in_js"
first_statement(program: Node, statement: Node): Node := separated(bracketed([statement] + statements_in(program), ""), ";")
# A program with markup reads the page's own globals without `use js` (decision page-globals-implicit): `window` and
# the global scope's attributes holding an object (document, location, localStorage, navigator …), typed as with
# `use js`; a name the program binds itself is its own. Natively they are the webview's, else foreign_call's error
page_globals_read(program: Node, used: list): list := {
	bound = names_bound_in(program)
	found = {}
	for n in nodes_in(program) {
		if n is symbol and is_page_global(name_of(n)) and not (name_of(n) in used) and not bound.has(name_of(n)) { found[name_of(n)] = yes }
	}
	found.keys
}
is_page_global(name: text): bool := {
	if name == PAGE_WINDOW { return yes }
	member = webidl_global_member(name)
	member != ø and not member.operation and webidl().has(member.type)
}
# The ids of the program's markup, each a name of its element (decision page-ids): `input{ id: "who" }` makes
# `who.focus()` the page's element; a variable or function of the same name is a compile error naming both. An id with
# a dash is no name (`$user-name` reads its value)
page_ids(scopes: list, bound: any): list := {
	found = {}
	for n in scopes.flat_map(nodes_in) {
		if is_markup_block(n) {
			for item in items_of(value_of(n)) {
				id = written_id(item)
				if id != "" and bound.has(id) { raise "the id " + id + " of the page's markup and the program's own " + id + " share a name: rename one" }
				if id != "" { found[id] = yes }
			}
		}
	}
	found.keys
}
# `$paintings.className` (decision dollar-any-element): a member of any element of the page by its id; an id of the
# program's markup and a bare `$who` stay the value typed into its field (page_values.warp), and a rewrite rule's
# `$holes` are its own
page_elements(program: Node, ids: list): list := {
	found = {}
	for statement in flat_statements(program).filter(statement => not is_rewrite_rule(statement)) {
		for n in nodes_in(statement) {
			id = page_id(n)
			if id != "" and id not in ids { found[id] = yes }
		}
	}
	found.keys
}
is_rewrite_rule(statement: Node): bool := is_group(statement) and #statement > 0 and statement#1 == symbol(rewrite_word)
# document.getElementById(id), an element of the page
page_element(id: text, scope: JsScope): Node := {
	call = js_call([PAGE_DOCUMENT, js_global_type(PAGE_DOCUMENT)], ELEMENT_LOOKUP, 1, [Text(id)], scope)
	scope.calls["${call}"] = PAGE_ELEMENT_TYPE
	call
}
written_id(item: Node): text := match item {
	Key(Symbol(name), Op.Colon, Text(id)): if name == ID_ATTRIBUTE and id != "" and not id.contains("-") then id else ""
	_: ""
}
# the js names a program reaches: its globals by their interface (UNCHECKED where WebIDL declares none), the variables
# holding a js value, and the foreign calls giving one, by their written form
class JsScope {
	globals: map = {}
	variables: map = {}
	calls: map = {}
	elements: map = {}
	dollar_elements: map = {}
	arities: map = {}
	hands_functions: bool = no
}
# the parameters' count of each function the program defines, `f(x) := …` or `f = x => …`, by its name
function_arities(program: Node): map := {
	arities = {}
	for statement in flat_statements(program) {
		if is_key(statement, Op.Define) and is_group(key_of(statement)) { arities[head_word(key_of(statement))] = #parameters_in(items_of(key_of(statement))[1 ..]) }
		if is_key(statement, Op.Assign) and key_of(statement) is symbol and is_lambda(value_of(statement)) { arities[name_of(key_of(statement))] = lambda_arity(value_of(statement)) }
	}
	arities
}
lambda_arity(n: Node): int := #parameters_of(arrow_parameters(n))
# a function given to js, a lambda or one the program defines, as js_function(f, its parameters' count); any other
# argument as it is (a function whose parameters the lowering can't see is refused where it crosses)
handed_to_js(argument: Node, scope: JsScope): Node := {
	arity = if is_lambda(argument) then lambda_arity(argument) else if argument is symbol and scope.arities.has(name_of(argument)) then scope.arities[name_of(argument)] else -1
	if arity < 0 { return argument }
	scope.hands_functions = yes
	call_of(JS_FUNCTION, [argument, arity])
}
# [runtime, name, aliased] of `use js Math`, `use js "path"`, `use python json`, `use json from python` (the alias);
# ø for another statement
foreign_use(statement: Node): list? := {
	if not is_group(statement) or #statement < 3 or statement#1 != symbol(USE_WORD) { return ø }
	if #statement == 3 and is_runtime(statement#2) { return [name_of(statement#2), used_name(statement#3), no] }
	if #statement == 4 and statement#3 == symbol(FROM_WORD) and is_runtime(statement#4) { return [name_of(statement#4), used_name(statement#2), yes] }
	ø
}
# the foreign uses of a program, whose names are its own (implicit_uses.warp)
foreign_uses(program: Node): list := flat_statements(program).map(foreign_use).filter(used => used != ø)
is_runtime(n: Node): bool := n is symbol and name_of(n) in FOREIGN_RUNTIMES
used_name(n: Node): text := if n is symbol then name_of(n) else "" + n

js_lowered(n: Node, scope: JsScope): Node := {
	used = foreign_use(n)
	if used != ø { return use_lowered(n, used) }
	if is_key(n, Op.Assign) { return js_assigned(n, scope) }
	if is_key(n, Op.Dot) { return js_member(n, scope) }
	if is_group(n) and bracket_of(n) == "(" and n#1 is symbol and is_js_global(name_of(n#1), scope) { return js_global_called(n, scope) }
	n
}
# a foreign use taken out, a library runtime's left as the use of its library (`use python`); the alias said
use_lowered(n: Node, used: list): Node := {
	if used#3 { diagnose(call_of("alias_word", [symbol("${n}"), symbol("use ${used#1} ${used#2}")]), n) }
	if used#1 == JS_RUNTIME then Node.Empty else use_statements([used#1])#1
}
# `receiver.member`, `receiver.member(…)` of a js receiver
js_member(n: Node, scope: JsScope): Node := {
	receiver = js_receiver(key_of(n), scope)
	member = value_of(n)
	if receiver == ø { return n }
	if member is symbol { return js_call(receiver, name_of(member), 0, [], scope) }
	if is_group(member) and bracket_of(member) == "(" and member#1 is symbol { return js_call(receiver, name_of(member#1), 1, items_of(member)[1 ..], scope) }
	n
}
# `Name(…)`: a function of the global scope called, else the constructor
js_global_called(n: Node, scope: JsScope): Node := {
	name = name_of(n#1)
	arguments = items_of(n)[1 ..]
	if js_global_operation(name) { return js_call([GLOBAL_SCOPE, UNCHECKED], name, 1, arguments, scope) }
	js_call([name, scope.globals[name]], CONSTRUCTOR_MEMBER, 1, arguments, scope)
}
# [the receiver as foreign_call takes it, its interface] of a js value, ø where the node is none
js_receiver(n: Node, scope: JsScope): list? := {
	if n is symbol and scope.globals.has(name_of(n)) { return global_receiver(name_of(n), scope.globals[name_of(n)]) }
	if n is symbol and scope.elements.has(name_of(n)) { return [page_element(name_of(n), scope), PAGE_ELEMENT_TYPE] }
	if n is symbol and scope.dollar_elements.has(name_of(n)) { return [page_element(scope.dollar_elements[name_of(n)], scope), PAGE_ELEMENT_TYPE] }
	if n is symbol and scope.variables.has(name_of(n)) { return [n, scope.variables[name_of(n)]] }
	written = "${n}"
	if scope.calls.has(written) then [n, scope.calls[written]] else ø
}
# the foreign call of a member checked by its interface, the interface it gives noted when it is one
js_call(receiver: list, member: text, called: int, arguments: list, scope: JsScope): Node := {
	given = js_member_type(receiver#2, member)
	library = is_library_runtime(receiver#2)
	given_arguments = [receiver#1, member, called, bracketed(if library then arguments else arguments.map(argument => handed_to_js(argument, scope)), "[")]
	call = if library then call_of(receiver#2 + MEMBER_SUFFIX, given_arguments) else call_of(FOREIGN_SETTLED, [call_of(FOREIGN_CALL, [JS_RUNTIME] + given_arguments)])
	if given != UNCHECKED { scope.calls["${call}"] = given }
	call
}
# `x = <a js value>` makes x a js variable of its interface; `receiver.member = v` sets the member
js_assigned(n: Node, scope: JsScope): Node := {
	target = foreign_called(key_of(n))
	value = value_of(n)
	if is_group(target) and #target == 6 and target#1 == symbol(FOREIGN_CALL) and target#5 == 0 {
		return call_of(FOREIGN_CALL, [JS_RUNTIME, target#3, SETTER_PREFIX + target#4, 1, bracketed([handed_to_js(value, scope)], "[")])
	}
	written = "${value}"
	if target is symbol and scope.calls.has(written) { scope.variables[name_of(target)] = scope.calls[written] }
	n
}
# the foreign_call a lowered js call settles (js_call), the node itself else
foreign_called(n: Node): Node := if is_group(n) and #n == 2 and n#1 == symbol(FOREIGN_SETTLED) then n#2 else n

# [receiver, interface] of a global: a library runtime's is its import, a js global its name as foreign_call takes it
global_receiver(name: text, interface: text): list := [if is_library_runtime(interface) then call_of(interface + IMPORT_SUFFIX, [Text(name)]) else Text(name), interface]
is_library_runtime(interface: text): bool := interface in LIBRARY_RUNTIMES
is_js_global(name: text, scope: JsScope): bool := scope.globals.has(name) and not is_library_runtime(scope.globals[name])

# --- the types WebIDL gives ---

# the interface a global names: its own definition (URL, console), else the type of the global scope's attribute of
# that name (crypto: Crypto), else UNCHECKED
js_global_type(name: text): text := {
	if webidl().has(name) { return name }
	if name == PAGE_WINDOW { return GLOBAL_INTERFACES#1 }
	member = webidl_global_member(name)
	if member == ø then UNCHECKED else member.type
}
js_global_operation(name: text): bool := {
	member = webidl_global_member(name)
	member != ø and member.operation
}
webidl_global_member(name: text): WebIdlMember? := {
	for scope in GLOBAL_INTERFACES {
		member = webidl_member_of(scope, name)
		if member != ø { return member }
	}
	ø
}
# the interface the member gives (UNCHECKED for a text, a number, a promise or a type WebIDL does not define); a
# member its interface lacks is refused, naming the interface
js_member_type(interface: text, member: text): text := {
	if interface == UNCHECKED or is_library_runtime(interface) { return interface }
	found = webidl_member_of(interface, member)
	if member == CONSTRUCTOR_MEMBER and found != ø { return interface }
	if found == ø { raise "js: " + interface + " has no " + (if member == CONSTRUCTOR_MEMBER then "constructor" else member) + " (lib/*.webidl)" }
	given = found.type
	if webidl().has(given) then given else UNCHECKED
}
# the member of a definition, its parents' and its mixins' included
webidl_member_of(name: text, member: text): WebIdlMember? := {
	definition = webidl().get(name)
	if definition == ø { return ø }
	if definition.members.has(member) { return definition.members[member] }
	for parent in definition.parents {
		found = webidl_member_of(parent, member)
		if found != ø { return found }
	}
	ø
}

# name → WebIdlDefinition: the interfaces, mixins, namespaces and dictionaries with their partials, read once
global webidl_definitions = ø
webidl(): map := {
	if webidl_definitions == ø { webidl_definitions = webidl_read(library_data(WEBIDL) + library_data(ECMASCRIPT_WEBIDL)) }
	webidl_definitions
}
