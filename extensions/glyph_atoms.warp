# Glyph and number atoms (card parser-coverage-2): truth glyphs `✓` `⊥`, vulgar fractions `½`, the exact constants
# `ⅈ`, `ε`, `ω`, an unknown entity `\:name`, a repeating decimal `0.3̅`
# `\:nosuchthing`, an entity no table row names (expanded_entities replaced the known ones): the text as written
unknown_entity(p: Parser): Node := {
	if char_ahead(p, 1) != ':' or not is_alpha(char_ahead(p, 2)) { return ø }
	end = name_end(p.code, p.at + 2, p.n)
	unknown = "" + p.code[p.at .. end]
	p.at = end
	unknown
}
truth_atom(p: Parser): Node := {
	truth = truth_glyph_at(p)
	if truth == "" { return ø }
	p.at += truth.length
	not FALSE_GLYPHS.contains(truth)
}
exact_atom(p: Parser): Node := {
	constant = "$(p.code[p.at])"
	advance(p)
	exact_constant(constant)
}
# The glyphs that are true or false, longest spelling first: `✔️` is `✔` with an emoji variation selector
# (card keyword-glyphs)
TRUE_GLYPHS = ["✔️", "✓️", "☑️", "⊤", "✓", "✔", "☑", "✅", "🗸", "🗹"]
FALSE_GLYPHS = ["⊥", "❌", "✗"]
TRUTH_GLYPH_STARTS = by_first_character(TRUE_GLYPHS + FALSE_GLYPHS, glyph => glyph)
truth_glyph_at(p: Parser): text := {
	for glyph in starting_here(TRUTH_GLYPH_STARTS, p, p.at) { if at_text(p, glyph) { return glyph } }
	""
}
# The exact generators the core has no value for yet; `π`, `τ`, `ℯ` and `∞` are plain names lib/reals.warp defines
EXACT_CONSTANTS = ["ⅈ", "ε", "ω"]
# no node of its own in warp yet (card node-more-cases): the number view, read as written
exact_constant(word: text): Node := opaque(["number", word])
# The Unicode vulgar fractions, each the numerator and denominator its NFKD decomposition writes (½ is 1⁄2)
VULGAR_FRACTIONS = {"½": [1, 2], "↉": [0, 3], "⅓": [1, 3], "⅔": [2, 3], "¼": [1, 4], "¾": [3, 4], "⅕": [1, 5], "⅖": [2, 5], "⅗": [3, 5], "⅘": [4, 5], "⅙": [1, 6], "⅚": [5, 6], "⅐": [1, 7], "⅛": [1, 8], "⅜": [3, 8], "⅝": [5, 8], "⅞": [7, 8], "⅑": [1, 9], "⅒": [1, 10]}
# `⅓` is the exact 1/3; digits glued after it multiply it
vulgar_fraction(p: Parser): Node := {
	parts = VULGAR_FRACTIONS[p.code[p.at]]
	advance(p)
	fraction = keyed("/", int(parts#1), int(parts#2))
	if is_digit(char_here(p)) then Key(fraction, Op.Mul, atom(p)) else fraction
}
# `0.16̅`: the digits under an overline (U+0305, one grapheme with its digit) repeat forever
overlined_digits(p: Parser): text := {
	period = ""
	while p.at < p.n and p.code[p.at].ends_with("̅") and is_digit(p.code[p.at].replace("̅", "")) {
		period = period + p.code[p.at].replace("̅", "")
		advance(p)
	}
	period
}
# a.b followed by the period p repeating, exactly: (abp - ab) / (10^#b · (10^#p - 1)), 0.3̅ is 1/3, 2.45̅ 221/90
repeating_decimal(written: text, period: text): Node := {
	parts = written.split(".")
	fraction = parts#2
	digits = parts#1 + fraction
	keyed("/", int(digits + period) - int(digits), (ten_to_the(period.length) - 1) * ten_to_the(fraction.length))
}
ten_to_the(count: int): int := {
	power = 1
	while count > 0 {
		power = power * 10
		count -= 1
	}
	power
}
# `0.3̅` after a decimal number; the overlined digits are read past whatever the number is
read_repeating_decimal(p: Parser, written: text, literal: text): Node := {
	if written.contains("e") { return ø }
	period = overlined_digits(p)
	if period != "" and written.contains(".") then repeating_decimal(written, period) else ø
}
# `ε`, `ω` as words: the exact constant, unless the word names a case (`E::ε`, `.ε`, an enum's)
read_exact_word(p: Parser, word: text): Node := {
	p.at += word.length
	if not names_case(p, word.length) { return exact_constant(word) }
	p.at -= word.length
	ø
}
glyph_atoms_extension = Extension{name: "glyph_atoms", atom_readers: joined_maps([reading_rows(VULGAR_FRACTIONS.keys, vulgar_fraction), {"\\": unknown_entity}, reading_rows(TRUTH_GLYPH_STARTS.keys, truth_atom), reading_rows(EXACT_CONSTANTS, exact_atom)]), number_suffix_readers: [read_repeating_decimal], keyword_readers: reading_rows(["ε", "Ε", "ω", "Ω"], read_exact_word)}
