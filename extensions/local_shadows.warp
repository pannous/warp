# A file or folder beside the program named as a standard module it uses, `use compute_toys` beside a folder
# compute_toys/ (decision local-folder-clash, packages by name: the local one is meant first), a warning names both
# (card hit). Its message is in core/analysis/warnings.data

# `use name` of each statement naming a standard module that a file or folder beside the program shares its name with,
# read off the source before its uses are taken (a used file beside it is gone by the passes); it adds no module
local_shadows(source: text, folder: text): list := {
	for statement in flat_statements(parsed(source)) {
		used = use_target(without_mark(statement))
		local = if used is symbol then local_shadow(name_of(used), folder) else ø
		if local != ø { diagnose(call_of("local_shadow", [local, name_of(used), working_relative(std_module_path(name_of(used)))]), statement) }
	}
	[]
}
# the file or folder beside the program a standard module's name also names, ø for none or no such standard module;
# a program's own module (`warp build --module shapes.warp`, uses.warp own_module_files) is that file, no standard one
local_shadow(name: text, folder: text): text? := {
	if own_module_files.has(name) or not is_module_name(name) { return ø }
	[path_in(folder, name + module_extension), path_in(folder, name)].find(path => exists(path))
}

local_shadows_extension = Extension{name: "local_shadows", implicit_uses: [local_shadows]}
