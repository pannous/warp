# An object a class-giving function makes is walked by next() too (decision for-over-iterator, cards
# for-over-iterator and object-iterator-loop): `for e in changes()` of `changes() as WikiChanges`, or a name assigned
# such a call. The program's and the linked modules' functions declaring a class result, and the names assigned their
# calls, are noted once before the methods leave their classes; extensions/sugar/iteration.warp asks the rule word iterated_object (extensions/rules/rule_words.warp) of each loop

# the functions declaring they give an instance, `countdown(n) as Counter`, and the names assigned their calls
global instance_makers = {}
global made_instances = {}
# the classes whose instances walk by next(), the program's and the library's
global walked_classes = {}
# [the linked modules' names, what linked_results found among them]: worked out once a compile, not by each program
# pass
global linked_makers_known = ["", [{}, {}]]

noted_instance_makers(program: Node) as Node := {
	classes = entries_of_both(own_walked_classes(statements_in(program), linked_makers()#1), linked_makers()#1)
	walked_classes = classes
	instance_makers = entries_of_both(result_classes(statements_in(program), classes), linked_makers()#2)
	types = assigned_types_in(outer_nodes_in(program), classes, instance_makers)
	made_instances = {}
	for name in types.keys { if types[name] in classes { made_instances[name] = yes } }
	program
}

# the program's classes with a method next(), their own or one a class they extend has (the library's walked ones given)
own_walked_classes(statements: list, walked: map) as map := {
	declared = {}
	for statement in statements {
		view = class_view(statement)
		if view != ø { declared[declared_type_name(view#2)] = class_declared(statement, view) }
	}
	found = {}
	for name in declared.keys { if walks_own(declared, walked, name) { found[name] = yes } }
	found
}
walks_own(declared: map, walked: map, name: text) as bool := {
	if walked.has(name) { return yes }
	if not declared.has(name) { return no }
	declared[name].methods.any(method => defined_word(method) == "next") or (declared[name].parent != name and walks_own(declared, walked, declared[name].parent))
}

# [the library's classes an instance of walks by next(), the linked functions giving one], worked out once a compile
linked_makers() as list := {
	linked = linked_signatures.keys.join(",")
	if linked != linked_makers_known#1 { linked_makers_known = [linked, linked_results()] }
	linked_makers_known#2
}
# the linked modules' functions declaring they give an instance of a class with next(), by their signature lines
# (`changes(wiki: text = "") as WikiChanges` of wikipedia, whose Streamed has next()), each line read whole only when
# it ends in such a class; a word some module defines giving anything else is none: `json.parse(t)` is no
# time.parse(t, pattern) as Instant. A library class without next(), `transpose(m) as Matrix`, makes none
linked_results() as list := {
	class_texts = {}
	for signature in linked_signatures.values { for slice in signature.slices { if declared_classes_modules().has(slice#1) { class_texts[slice#1] = slice#2 } } }
	classes = {}
	for name in class_texts.keys { if walks_by_next(class_texts, name) { classes[name] = yes } }
	heads = []
	others = {}
	for signature in linked_signatures.values {
		for slice in signature.slices {
			head = slice#2.split("\n")#1.split(":=")#1.trim()
			if head.split(" ").last in classes { heads += statements_in(slice_tree(slice#3, slice#4)) } else { others[slice#1] = yes }
		}
	}
	found = result_classes(heads, classes)
	kept = {}
	for word in found.keys { if not others.has(word) { kept[word] = found[word] } }
	[classes, kept]
}
# whether a library class, by its definition's text, or a class it extends has a method next()
walks_by_next(class_texts: map, name: text) as bool := {
	if not class_texts.has(name) { return no }
	written = class_texts[name]
	if written.contains("\n\tnext(") { return yes }
	extended = written.split("\n")#1.split(" extends ")
	parent = if #extended > 1 then extended#2.split(" ")#1 else name
	parent != name and walks_by_next(class_texts, parent)
}

# (before the class_methods extension lifts the methods out of their classes)
iterators_extension = Extension{name: "iterators", passes_before: {"definition_heads": noted_instance_makers}}
