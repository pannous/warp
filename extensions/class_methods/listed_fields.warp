# A capitalized plural field named after a declared class declares a list of it under the lowercase name (decision
# capitalized-field-list): `class Signature { Parameters = [] }` is `parameters: list[Parameter] = []`, read as
# `sig.parameters`; any other capitalized field stays an ordinary one

# the program with each such field of its classes as the typed list field
listed_fields(program: Node): Node := {
	statements = statements_in(program)
	classes = statements.map(class_view).filter(view => view != ø).map(view => declared_type_name(view#2))
	group_like(program, statements.map(statement => with_listed_fields(statement, classes)))
}
# the class declaration with its listed fields typed, any other statement as it is
with_listed_fields(statement: Node, classes: list): Node := {
	view = class_view(statement)
	if view == ø { return statement }
	members = view#3[3 ..].map(member => {
		typed = listed_field(node_of(member), classes)
		if typed == ø then member else view_of(typed)
	})
	match statement {
		Key(left, key_op, right): Key(left, key_op, [view#1, view#2, view#3[0 ..< 3] + members])
		_: statement
	}
}
# `Parameters = []` of a declared class Parameter: `parameters: list[Parameter] = []`, else ø
listed_field(member: Node, classes: list): Node? := {
	if not (is_key(member, Op.Assign) and key_of(member) is symbol) { return ø }
	name = name_of(key_of(member))
	initial = name[0 ..< 1]
	if not (name.ends_with("s") and initial != initial.lower()) { return ø }
	item_class = name[0 ..< #name - 1]
	if item_class not in classes { return ø }
	type = statements_in(plain_node(parsed("list[" + item_class + "]")))#1
	Key(Key(symbol(initial.lower() + name[1 ..]), Op.Colon, type), Op.Assign, value_of(member))
}
