# A class's methods are functions of the program (card pure-class-methods; the definitions pass lifts them, before any
# other pass lowers a function): `class Animal { name: text; speak() := name + " makes a sound" }` gives the function
# `speak(self) := self.name + " makes a sound"`, which `a.speak()`, the call speak(a), calls on the instance.
# - a field read or written bare is the instance's, `self.name` (`this.name` too); a sibling method read or called
#   bare is called on it, `doubled()` is doubled(self); a method changes its instance in place, `count += 1` is
#   `self.count += 1`
# - a property `area := side * side` is a method of no parameters, read with or without parentheses
# - a method one class declares keeps its name, its subclasses inheriting it; a method several classes declare is
#   `speak·Dog` in each, and `speak` the dispatcher on the instance's class, a subclass tested before its parent:
#   `speak(self) := if self is Dog then speak·Dog(self) else speak·Animal(self)`
# - a method named like a function of the program (the library's `sum`, `max` it reaches) or a word the
#   runtime or the emitter defines (`sort`) is `sum·Bag` in each class declaring it, and a call `x.sum()` is routed by
#   x's static type (decision method-routing-by-type): on a value statically no instance of those classes (a list, a
#   number, an instance of another class) it stays as written, so a list's `xs.sum()` still sums and `names.add(x)`
#   still adds by its sugar rule; an instance of one calls its class's method; any other value the dispatcher
#   `sum·method(x)`, which calls the function itself, sum(x), on a value not an instance
# - a method named by an operator, its glyph, its word or an alias of the word (lib/aliases.warp: `+(o)`, `add(o)`,
#   `plus(o)`), is the operator on its instances: the dispatcher `+·operator(a, b)` calls the method of a's class (its
#   own or an ancestor's) and gives any other value the builtin `a + b`; the emitter calls it for `a + b` of a boxed a,
#   a value that may be an instance (emitter/operators.warp; card pure-class-operators)
# - a class ordering its instances by `compare(o)` (a number below, at or above 0, as Rust's lane reads it) orders them
#   under <, <=, > and >=: the dispatcher `<·operator(a, b)` is compare(a, b) < 0 on its instances, the builtin on any
#   other value
# - a class showing its instances by `text()` shows them so wherever a value shows (print, `"at " + x`): the
#   dispatcher `text·shown(x)` gives an instance its class's text, any other value the builtin's (str); the emitter
#   shows a value that may be an instance through it (emitter/output.warp shown_text)
# - `x is Animal` is true of an instance of a class extending Animal too, a dispatcher's test of each owner as well
#   (emitter runtime_words.warp type_test_code)
# - fields a space lists, `class person{name age: int}`, are each a field, `name; age: int` (the last takes the type)
# - `init(…)` is the class's constructor (card declared-class), `value(…) { … }` and `value { … }` too (a method
#   `value() := …` stays one), lifted as `init·C(self, …)`: a call `C(…)` is the function `C·new(…)`, which makes the
#   instance of the fields' defaults (any other field its type's zero), runs the constructor on it and gives it. One
#   of no parameters runs at every construction, a literal `C{…}`'s too: each is `C·made(…)` of the instance
# A class keeping a member that is neither field nor method (an operator), or whose method takes another count of
# parameters than its namesakes, stays as written: the emitter refuses it as a class with methods.

self_node = symbol("self")
# what a method may call its instance: self, as Swift's and Python's, or this, as Java's and C++'s
instance_names = ["self", "this"]
# what a method calls its class's parent, as Java's, Swift's and Python's
parent_word = "super"
# the operators whose operands may change places, so a value before an instance is the instance's operator with it
commutative_operators = ["+", "*", "==", "!="]
# the static type of a time literal
time_type = "time"
# the method a class's instances are equal by under == (and != by its negation), compare's 0 where it declares none
# (decision compare-equal-hooks)
equality_method = "equal"
# the methods a class's instances convert by, each [method, its dispatcher, the call it falls back to on any other
# value]: `x as text` by text() (also print, str), `x as float` and float(x) by float() (lib/reals.warp's π), a value the
# runtime needs as a float by float(), ø on any other value (runtime conversions.warp float_of_node through the hook
# instance_float: `sin(2km)`), a shown value by show(), ø on any other value: it then shows its structure (decision
# show-hook; runtime show.warp key_text through the hook instance_show); emitter/output.warp and emitter.warp cast read
# the dispatchers
conversion_methods = [["text", showing_dispatcher, "str"], ["float", HiddenWord.FloatConverted as text, HiddenWord.FloatCast as text], ["float", HiddenWord.FloatHooked as text, ø], [form_method, HiddenWord.ShowShown as text, ø]]
# a class's positions (card class-position-index, decisions instance-position and property-accessors): `b#p` is its
# position(p), from 1, `b[i]` (the parser's b#(i+1)) its index(i), from 0, either one deriving the other; `b#p = v` the
# same word with the value, position(p, v), lifted as position·assigned; `#b` its count()
position_method = "position"
index_method = "index"
assigned_position = HiddenWord.PositionAssigned as text
assigned_index = HiddenWord.IndexAssigned as text
position_words = [position_method, index_method, assigned_position, assigned_index]
# what a dispatcher of a method no operator spells gives any other value: the function itself; a method changing its
# value in place as written, `x.remove(k)`, which extensions/sugar/methods.warp and method_calls.warp read; an element read or
# written, `b#(i+1)` (the parser's b[i]), `b#p = v`, as written
builtin_call(method: text, arguments: list): Node := {
	if method in in_place_methods { return Key(arguments#1, Op.Dot, call_of(method, arguments[1..])) }
	if method not in position_words { return call_of(method, arguments) }
	element = Key(arguments#1, Op.Hash, if method.starts_with(index_method) then Key(arguments#2, Op.Add, 1) else arguments#2)
	if method.ends_with("·assigned") then Key(element, Op.Assign, arguments#3) else element
}
# an operator spelled as a word a list changes itself by, `add` (+): on a list the list's own, `people.add(p)` appending
# in place, on any other value the operator. (The append is an insert at the end: `self.add(o)` is `self += [o]`, which
# beside a class's `+` rebinds self to a new list, card list-param-add-assign)
listed_in_place(method: text, arguments: list, operation: Node): Node := {
	if method not in in_place_methods { return operation }
	list = arguments#1
	appended = call_of("list_insert", [list, call_of("count", [list])] + arguments[1..])
	Key(Key(Key(ø, Op.If, Key(list, Op.Is, symbol("list"))), Op.Then, appended), Op.Else, operation)
}
# a member read `m.text` of any other value is the emitter's member read (decision map-key-vs-method): a map's entry
# of that name where it has one (an event's text, a map the page built too), else the function, never the function
# alone, which a module's text() method left `m.text` of a map
keyed_first(method: text, arguments: list, otherwise: Node): Node := {
	if #arguments != 1 or method in position_words { return otherwise }
	Key(arguments#1, Op.Dot, symbol(method))
}
# the dispatcher a call `x.sum()` of a method named like a function or a library word calls
routed_name(method: text): text := method + "·method"
# a method named by a type word or a word of the syntax, `float()`, `in(u)`, is routed: lifted as itself it would change
# that word everywhere, `x is float`, `for x in xs`
syntax_words = phrase_prepositions + ["if", "then", "else", "while", "is", "as", "and", "or", "not", "return"]
names_syntax(method: text): bool := is_tested_type_word(method) or method in syntax_words
# the function a bare call of a sibling method calls: the dispatcher of a routed one
called_name(method: text, routes: list): text := if method in routes then routed_name(method) else method
# the functions the program defines, by name
functions_defined(top_statements: list): list := top_statements.map(function_word).filter(found_word => found_word != ø)
# the function a top statement defines, also one with a result type, `shown(x: any): text := …`
function_word(n: Node): text? := match n {
	Key(Key(typed_head, Op.Colon, result_type), Op.Define, body): if is_called_name(typed_head) then name_of(typed_head#1) else ø
	_: defined_word(n)
}

# what routing a call `x.m(…)` knows: the classes, the lifted ones, the routed methods, and the type each name
# statically holds (`self` its method's class, `c = Counter()` Counter, `xs = []` list)
class Routing { classes: map; names: list; methods: list; known: map; results: map }

# whether a module's class routes the method, decided by what holds whatever else a compile reaches: a word of the
# library (its index, the runtime, a typed line), an operator, a word of the syntax, a position word. A module being
# built and a program linking it lift its classes alike, so both name a method the same (`union·Set`); ø for a
# method a class of the program's own declares too, routed by all the program reaches
module_routing(classes: map, names: list, method: text, operator_methods: list): bool? := {
	linked = concatenated(linked_signatures.values.map(signature => signature.classes.map(entry => "${entry#1}".remove_prefix(instance_struct_prefix))))
	owners = owners_of(classes, names, method)
	if #owners == 0 or not (module.relocating or owners.all(owner => owner in linked)) { return ø }
	is_library_word(method) or library_index_section("word").has(method) or method in operator_methods or names_syntax(method) or method in position_words
}
# the program with the methods of its classes lifted out as functions
methods_lifted(program: Node): Node := {
	top_statements = statements_in(program)
	classes = {}
	for top_statement in top_statements {
		view = class_view(top_statement)
		if view != ø { classes[declared_type_name(view#2)] = class_declared(top_statement, view) }
	}
	operator_table = operator_spellings()
	outside = top_statements.filter(top_statement => operated_class(top_statement, classes, operator_table) != ø)
	for definition in outside {
		owner = classes[operated_class(definition, classes, operator_table)]
		owner.methods = owner.methods + [as_operator_method(definition)]
	}
	top_statements = top_statements.filter(top_statement => operated_class(top_statement, classes, operator_table) == ø)
	for name in classes.keys { classes[name].methods = aliases_derived(equality_derived(name, positions_derived(classes[name].methods, operator_table), operator_table)) }
	promotions = promotions_of(top_statements, classes, scope_of(program))
	liftable = classes.keys.filter(name => lifts(classes, name, top_statements))
	if #liftable == 0 { return program }
	rewritten = []
	for top_statement in top_statements {
		view = class_view(top_statement)
		name = if view == ø then "" else declared_type_name(view#2)
		rewritten += [if name in liftable then without_methods(top_statement, view) else top_statement]
	}
	# an int type's `format Color c as text` is a hook extensions/int_types/marks.warp renames format·text·Color, no function to route to
	hooks = int_type_showers(top_statements)
	functions = functions_defined(top_statements.filter(statement => statement not in hooks))
	constructed = {}
	for name in liftable.filter(name => constructor_of(classes[name]) != ø) { constructed[name] = #method_parameters(method_in(classes[name], constructor_of(classes[name]))) > 0 }
	if #constructed > 0 { rewritten = rewritten.map(top_statement => if class_view(top_statement) == ø then constructions(top_statement, constructed) else top_statement) }
	methods = methods_of(classes, liftable).filter(method => method != constructor_method)
	operator_methods = methods.filter(method => spelled_operator(operator_table, method) != ø and 1 in taken_counts(classes, liftable, method))
	routes = methods.filter(method => module_routing(classes, liftable, method, operator_methods) ?? (is_library_word(method) or method in functions or method in operator_methods or names_syntax(method) or method in position_words))
	for name in methods { rewritten += functions_of(classes, liftable, name, routes) }
	# `w.fahrenheit = 212` of a property with a setter calls it, fahrenheit(w, 212) (decision setter-calls)
	setters = methods.filter(method => 0 in taken_counts(classes, liftable, method) and 1 in taken_counts(classes, liftable, method) and not is_field_of_any(classes, liftable, method))
	if #setters > 0 { rewritten = rewritten.map(top_statement => setter_calls(top_statement, setters, routes)) }
	entry_words = []
	for method in operator_methods {
		word = spelled_operator(operator_table, method)#1
		if word not in entry_words { entry_words += [word] }
	}
	if #routes > 0 {
		self_types = {}
		for name in methods { for owning_class in owners_of(classes, liftable, name) { self_types[lifted_name(classes, liftable, name, owning_class, routes)] = owning_class } }
		results = result_classes(rewritten, classes)
		program_types = assigned_types(rewritten, classes, results)
		rewritten = rewritten.map(top_statement => routed(top_statement, Routing(classes, liftable, routes, statement_types(top_statement, program_types, self_types, classes), results)))
	}
	floaters = float_converters(classes, liftable, routes)
	dispatchers = []
	for name in methods.filter(method => method in routes or #owners_of(classes, liftable, method) > 1) {
		# a dispatcher for each parameter count the classes take the method with (Channel.more(), Interval.more(o)):
		# the arity overloads tell the calls apart
		for count in taken_counts(classes, liftable, name) {
			owners = owners_taking(classes, liftable, name, count)
			# a word of the syntax has no function of its own to fall back to, nor a word no definition of which takes the
			# call (list.warp's tally(xs) beside a class's tally(x))
			# (a module's method routed only as a word of another module's reaches no function of it: an instance of none
			# of the classes reads its field, a map's `d.day` beside Instant's day() and units' day())
			reached = is_library_word(name) or name in functions or (not names_syntax(name) and module_routing(classes, liftable, name, operator_methods) == ø)
			# (a type word is a field's name too: a time's `t.time` and `t.date` beside Instant's time() and date())
			reads_field = not reached and count == 0 and name not in syntax_words and name not in position_words
			# (an element, `b#p` and `b[i]`, falls back to the builtin's of any other value, in a module being built too, which
			# routes position words: sound's samples class made every `xs[i]` of the module its float cell)
			falls_back = name in routes and (name in position_words or ((reached or reads_field) and written_call_fits(top_statements.filter(statement => statement not in hooks), name, count + 1)))
			dispatchers += [method_dispatcher(classes, owners, owners.map(owning_class => name), called_name(name, routes), falls_back, reads_field, spelled_operator(operator_table, name), promotions, floaters)]
		}
	}
	spelled_ordering = {}
	for word in entry_words {
		spellings = operator_methods.filter(method => spelled_operator(operator_table, method)#1 == word)
		owners = []
		owned_spellings = []
		for spelling in spellings {
			for owning_class in owners_taking(classes, liftable, spelling, 1) {
				owners += [owning_class]
				owned_spellings += [spelling]
			}
		}
		operator = spelled_operator(operator_table, spellings#1)
		# a class's own `<` (its less(o)) beside another's compare(o): the one dispatcher of the glyph orders each class
		# by its own (derived_dispatchers)
		if operator#2 in ordering_operators and #orderers_of(classes, liftable) > 0 {
			named = {}
			for i in 0..<#owners { named[owners[i]] = owned_name(owned_spellings[i], owners[i]) }
			spelled_ordering[operator#2] = named
			continue
		}
		dispatchers += [method_dispatcher(classes, owners, owned_spellings, operator_dispatcher(operator#2), yes, no, operator, promotions, floaters)]
	}
	for name in constructed.keys { rewritten += constructor_functions(classes, liftable, name, routes) }
	dispatchers += derived_dispatchers(classes, liftable, routes, promotions, spelled_ordering, operator_table)
	# a dispatcher is the program's own over all its classes, a linked module's among them: the module's of that name
	# knows its own classes only (card bind-linked)
	own_words_unlinked(dispatchers.map(defined_word))
	group_like(program, rewritten + dispatchers)
}
# `+(a: Vec, b: Vec) := …` (also `infix operator +(…)`, `plus(…)`) outside a class: an operator its first parameter's
# class gives its instances, as if the class declared it (as_operator_method); the class's name, else ø
operated_class(n: Node, classes: map, operator_table: map): text? := {
	word = defined_word(n)
	if word == ø or spelled_operator(operator_table, word) == ø { return ø }
	parameters = method_parameters(n)
	if #parameters != 2 or not is_key(parameters#1, Op.Colon) or not (value_of(parameters#1) is symbol) { return ø }
	owner = name_of(value_of(parameters#1))
	if owner in classes then owner else ø
}
# that definition as its class's method, its first parameter the instance
as_operator_method(n: Node): Node := {
	parameters = method_parameters(n)
	instance = key_of(parameters#1)
	Key(call_of(defined_word(n), parameters[1..]), Op.Define, bottom_up(value_of(n), part => if part == instance then self_node else part))
}
# the constructions of the classes with a constructor (`constructed`: whether it takes parameters) through it: a call
# C(…) as C·new(…) when it takes parameters, else C·made(C(…)), a literal C{…} as C·made(C{…})
constructions(n: Node, constructed: map): Node := {
	parts = (part => constructions(part, constructed))
	if is_called_name(n) and name_of(n#1) in constructed {
		owning_class = name_of(n#1)
		arguments = items_of(n)[1..].map(parts)
		return if constructed[owning_class] then call_of(constructor_name(owning_class), arguments) else call_of(made_name(owning_class), [call_of(owning_class, arguments)])
	}
	match n {
		Key(Symbol(owning_class), Op.None, right): { if owning_class in constructed and not constructed[owning_class] then call_of(made_name(owning_class), [Key(symbol(owning_class), Op.None, parts(right))]) else children(n, parts) }
		_: children(n, parts)
	}
}
# a class's constructor lifted, `init·C(self, …)`, and the function constructing through it: `C·new(…) := { self =
# C(); init·C(self, …); self }` of one taking parameters (C() the instance of the fields' defaults: the calls were
# rewritten before), else `C·made(self) := { init·C(self); self }`
constructor_functions(classes: map, names: list, owning_class: text, routes: list): list := {
	method = constructor_of(classes[owning_class])
	initializer = owned_name(method, owning_class)
	parameters = method_parameters(method_in(classes[owning_class], method))
	given = parameters.map(parameter => symbol(parameter_name(parameter)))
	lifted = method_function(classes, names, owning_class, method_in(classes[owning_class], method), initializer, routes)
	if #parameters == 0 { return [lifted, Key(call_of(made_name(owning_class), [self_node]), Op.Define, block_of([call_of(initializer, [self_node]), self_node]))] }
	made = block_of([Key(self_node, Op.Assign, call_of(owning_class, [])), call_of(initializer, [self_node] + given), self_node])
	[lifted, Key(call_of(constructor_name(owning_class), parameters), Op.Define, made)]
}
# the classes ordering their instances by compare(o)
orderers_of(classes: map, names: list): list := owners_of(classes, names, ordering_method).filter(owning_class => #method_parameters(method_in(classes[owning_class], ordering_method)) == 1)
# the dispatchers a class's compare(o), text() and float() give: its instances ordered by <, <=, >, >=, shown by their
# text, converted to a float
derived_dispatchers(classes: map, names: list, routes: list, promotions: list, spelled_ordering: map, operator_table: map): list := {
	made = []
	other = symbol("other")
	# `a != b` of instances equal by their equal(other): not a == b, unless a class spells != itself
	if names.any(name => owns_operator(classes[name], "==", operator_table)) and not names.any(name => owns_operator(classes[name], "!=", operator_table)) {
		head = [Key(self_node, Op.Colon, symbol("any")), Key(other, Op.Colon, symbol("any"))]
		made += [Key(call_of("!=·operator", head), Op.Define, Key(ø, Op.Not, call_of("==·operator", [self_node, other])))]
	}
	orderers = orderers_of(classes, names)
	if #orderers > 0 {
		called = {}
		for owning_class in orderers { called[owning_class] = lifted_name(classes, names, ordering_method, owning_class, routes) }
		for glyph in ordering_operators {
			ordered = {}
			for owning_class in orderers { ordered[owning_class] = Key(call_of(called[owning_class], [self_node, other]), glyph as Op, 0) }
			spelled = spelled_ordering.get(glyph) ?? {}
			for owning_class in spelled.keys { ordered[owning_class] = call_of(spelled[owning_class], [self_node, other]) }
			head = [Key(self_node, Op.Colon, symbol("any")), Key(other, Op.Colon, symbol("any"))]
			builtin = Key(self_node, glyph as Op, other)
			made += [Key(call_of(operator_dispatcher(glyph), head), Op.Define, numbers_first(builtin, value_dispatch(deepest_first(classes, ordered.keys), ordered, promoted(builtin, promotions, operator_dispatcher(glyph)))))]
		}
	}
	for conversion in conversion_methods {
		method = conversion#1
		converters = owners_of(classes, names, method).filter(owning_class => #method_parameters(method_in(classes[owning_class], method)) == 0)
		if #converters > 0 {
			converted = {}
			for owning_class in converters { converted[owning_class] = call_of(lifted_name(classes, names, method, owning_class, routes), [self_node]) }
			fallback = if conversion#3 == ø then Node.Empty else call_of(conversion#3, [self_node])
			made += [Key(call_of(conversion#2, [Key(self_node, Op.Colon, symbol("any"))]), Op.Define, value_dispatch(deepest_first(classes, converters), converted, fallback))]
		}
	}
	made
}
# [class, source type] of each declared conversion to a class, `n: number as Real := …` (definitions.warp
# conversion_of): an operator meeting a value of the source type and an instance converts the value first (decision
# as-promotes), so `3 / π` is `(3 as Real) / π`, exact, for every operator and class alike
promotions_of(statements: list, classes: map, scope: map): list := statements.map(statement => conversion_of(statement, scope)).filter(conversion => conversion != ø and classes.has(conversion#2)).map(conversion => [conversion#2, conversion#1])
# the operator on two values, `a / b`, with the left converted where a promotion takes it (an instance on the right, a
# value of the conversion's source type on the left), through the dispatcher again: its own `a / b` is the builtin
promoted(operation: Node, promotions: list, dispatcher: text): Node := {
	left = key_of(operation)
	right = value_of(operation)
	for promotion in promotions.reverse() {
		test = Key(ø, Op.If, Key(instance_test(right, promotion#1), Op.And, Key(left, Op.Is, symbol(promotion#2))))
		operation = Key(Key(test, Op.Then, call_of(dispatcher, [call_of(conversion_name(promotion#1), [left]), right])), Op.Else, operation)
	}
	operation
}
# the value of the first owner's on an instance of it, else of the next owner's…, the fallback on any other value
value_dispatch(owners: list, values: map, fallback: Node): Node := {
	otherwise = if #owners == 1 then fallback else value_dispatch(owners[1..], values, fallback)
	test = Key(ø, Op.If, instance_test(self_node, owners#1))
	Key(Key(test, Op.Then, values[owners#1]), Op.Else, otherwise)
}
# whether the value is an instance of the class or of one extending it: the dispatchers' test, which `x is real` of
# any number (decision real-canonical) does not answer
instance_test(subject: Node, class_name: text): Node := call_of(HiddenWord.InstanceOf as text, [subject, class_name])
# the function a class's method was lifted to: its own name when one class declares it and it is not routed
lifted_name(classes: map, names: list, method: text, owning_class: text, routes: list): text := if #owners_of(classes, names, method) == 1 and method not in routes then method else owned_name(method, owning_class)

# a class, its parent, the parent's parent… among the program's classes
lineage(classes: map, name: text): list := if name in classes and classes[name].parent in classes then [name] + lineage(classes, classes[name].parent) else [name]
fields_reaching(classes: map, name: text): list := lineage(classes, name).flat_map(ancestor => classes[ancestor].fields)
# the names of the methods an instance of the class has: its own and its ancestors'
methods_reaching(classes: map, name: text): list := lineage(classes, name).flat_map(ancestor => classes[ancestor].methods.map(defined_word))
# the classes declaring a method of that name, among `names`
owners_of(classes: map, names: list, method: text): list := names.filter(name => classes[name].methods.any(m => defined_word(m) == method))
methods_of(classes: map, names: list): list := {
	found = []
	for method in names.flat_map(name => classes[name].methods.map(defined_word)) { if method not in found { found += [method] } }
	found
}
method_in(declared: Declared, method: text): Node := methods_named(declared, method)#1
# a class's methods of that name, the first of each parameter count: a property's getter `f := …` and its setter
# `f(v) := …` (decision property-accessors), arity overloads
methods_named(declared: Declared, method: text): list := {
	found = []
	for m in declared.methods.filter(m => defined_word(m) == method) { if not found.any(other => #method_parameters(other) == #method_parameters(m)) { found += [m] } }
	found
}

# whether a class's methods may be lifted: each member a field or a method, no method kept or named like a class, and
# so its ancestors (classes sharing a method name with other parameter counts get a dispatcher for each count)
lifts(classes: map, name: text, top_statements: list): bool := {
	declared = classes[name]
	if #declared.methods == 0 or declared.fields.any(field => field == ø) { return no }
	for method in declared.methods {
		word = defined_word(method)
		if word in classes { return no }
		if word == constructor_method { continue }
	}
	declared.parent not in classes or #classes[declared.parent].methods == 0 or lifts(classes, declared.parent, top_statements)
}

# a class's position words, `#(p)` as position(p), a setter renamed (position(p, v) is position·assigned), each one
# missing derived from its twin: position(p) := index(p - 1), index(i) := position(i + 1), and so the setters
positions_derived(methods: list, operator_table: map): list := {
	renamed = methods.map(method => position_named(method, operator_table))
	words = renamed.map(defined_word)
	derived = []
	for twins in [[position_method, index_method, Op.Sub], [index_method, position_method, Op.Add], [assigned_position, assigned_index, Op.Sub], [assigned_index, assigned_position, Op.Add]] {
		if twins#1 not in words and twins#2 in words { derived += [shifted_twin(twins#1, twins#2, twins#3)] }
	}
	renamed + derived
}
position_named(method: Node, operator_table: map): Node := {
	spelled = spelled_operator(operator_table, defined_word(method))
	word = if spelled != ø and spelled#1 == position_method then position_method else defined_word(method)
	if word not in [position_method, index_method] { return method }
	name = if #method_parameters(method) == 2 then word + "·assigned" else word
	Key(call_of(name, method_parameters(method)), Op.Define, value_of(method))
}
# a class ordering by compare(other) and spelling no == is equal where compare gives 0, to an instance of its own:
# `equal(other) := other is C and self.compare(other) == 0` (`time == now` is no, not a compare of a type value)
equality_derived(class_name: text, methods: list, operator_table: map): list := {
	words = methods.map(defined_word)
	if ordering_method not in words or words.any(word => spells_operator(word, "==", operator_table)) { return methods }
	other = symbol("other")
	compared = Key(Key(self_node, Op.Dot, call_of(ordering_method, [other])), Op.Eq, 0)
	methods + [Key(call_of(equality_method, [other]), Op.Define, Key(instance_test(other, class_name), Op.And, compared))]
}
# The alias network (card alias-network, notes/aliases.md): a class's method answers every word spelling of its
# lib/aliases.warp entry the class does not declare itself, so a class giving add(o) answers `a.plus(b)` and one giving
# plus(o) answers `a.add(b)`: each other spelling is a method calling the declared one, `plus(o) := add(o)`.
# Symbol spellings stay the operators' (a class's add(o) is its `+` already)
aliases_derived(methods: list): list := {
	words = methods.map(defined_word).filter(word => word is text)
	derived = []
	for method in methods {
		word = defined_word(method)
		# count's entry is networked already: any spelling of it is the class's count (counts, derived_dispatchers)
		if not (word is text) or counts(word) { continue }
		for spelling in alias_words(word) {
			if spelling in words { continue }
			words += [spelling]
			arguments = method_parameters(method).map(parameter => if parameter is symbol then parameter else key_of(parameter))
			derived += [Key(call_of(spelling, method_parameters(method)), Op.Define, call_of(word, arguments))]
		}
	}
	methods + derived
}
# the word spellings of a word's alias entry, the canonical word first, the word itself among them; [word] when no
# entry names it
alias_words(word: text): list := {
	canonical = canonical_word(word) ?? word
	spelled = alias_spellings().canonical
	others = spelled.keys.filter(spelling => spelled[spelling] == canonical and is_word_spelling(spelling))
	if #others == 0 and canonical == word { return [word] }
	[canonical] + others.filter(spelling => spelling != canonical)
}
# a spelling written as a name, `plus` and not `+` or `×`
is_word_spelling(spelling: text): bool := #spelling > 0 and is_name_start(spelling[0 ..< 1]) and spelling.all(c => is_name_char(c))
owns_operator(declared: Declared, glyph: text, operator_table: map): bool := declared.methods.any(method => spells_operator(defined_word(method), glyph, operator_table))
spells_operator(word: any, glyph: text, operator_table: map): bool := word is text and spelled_operator(operator_table, word) != ø and operator_table[word]#2 == glyph
shifted_twin(name: text, twin: text, shift: Op): Node := {
	setting = if name.ends_with("·assigned") then [symbol("value")] else []
	Key(call_of(name, [symbol("at")] + setting), Op.Define, call_of(twin, [Key(symbol("at"), shift, 1)] + setting))
}
# the class declaration keeping only its fields
without_methods(top_statement: Node, view: list): Node := {
	body = view#3
	kept_members = body[0..<3] + body[3..].filter(member => defined_word(member_read(member)) == ø)
	match top_statement {
		Key(left, key_op, right): Key(left, key_op, [view#1, view#2, kept_members])
		_: top_statement
	}
}

# the functions of the method `name`: the method itself when one class declares it, else each owner's (its dispatcher
# methods_lifted adds once the program is routed)
functions_of(classes: map, names: list, method: text, routes: list): list := {
	owners = owners_of(classes, names, method)
	single = #owners == 1 and method not in routes
	owners.flat_map(owning_class => methods_named(classes[owning_class], method).map(declared => method_function(classes, names, owning_class, declared, if single then method else owned_name(method, owning_class), routes)))
}
owned_name(method: text, owning_class: text): text := method + "·" + owning_class
# the class's method as the function `name(self, parameters…)` of its instance
method_function(classes: map, names: list, owning_class: text, declared: Node, name: text, routes: list): Node := {
	parameters = method_parameters(declared)
	taken = parameters.map(parameter_name)
	body = on_parent(value_of(declared), Parent(classes, names, owning_class, routes))
	fields = fields_reaching(classes, owning_class).filter(field => field not in taken)
	siblings = methods_reaching(classes, owning_class).filter(sibling => sibling not in taken and not assigns_name(body, sibling) and not overcalled(body, sibling, taking(classes, owning_class, sibling)))
	Key(call_of(name, [self_node] + parameters), Op.Define, on_instance(body, fields, siblings, routes))
}
# what `super` in a method of the class reaches: the classes, the lifted ones, the class, the routed methods
class Parent { classes: map; names: list; owning_class: text; routes: list }
# `super.m(…)` and `super.m` in a method: the method of the nearest ancestor declaring m, called on the instance
# (`speak := super.speak + ": woof"`); `super(…)` and `super.init(…)` its constructor; `super.name` of a field the
# instance's
on_parent(n: Node, parent: Parent): Node := {
	parts = (part => on_parent(part, parent))
	if is_called_name(n) and name_of(n#1) == parent_word { return parent_call(constructor_method, items_of(n)[1..].map(parts), parent) ?? children(n, parts) }
	match n {
		Key(Symbol(word), Op.Dot, member): {
			if word != parent_word { return children(n, parts) }
			method = if member is symbol then name_of(member) else if is_called_name(member) then name_of(member#1) else ø
			arguments = if is_called_name(member) then items_of(member)[1..].map(parts) else []
			call = if method == ø then ø else parent_call(method, arguments, parent)
			if call != ø then call else Key(self_node, Op.Dot, parts(member))
		}
		_: children(n, parts)
	}
}
# the call of the method of the nearest ancestor declaring it, on the instance, else ø
parent_call(method: text, arguments: list, parent: Parent): Node? := {
	classes = parent.classes
	declaring = lineage(classes, parent.owning_class)[1..].filter(ancestor => ancestor in parent.names and classes[ancestor].methods.any(m => defined_word(m) == method))
	if #declaring == 0 { return ø }
	function = if method == constructor_method then owned_name(method, declaring#1) else lifted_name(classes, parent.names, method, declaring#1, parent.routes)
	call_of(function, [self_node] + arguments)
}
# how many parameters the method of that name the class reaches takes
taking(classes: map, owning_class: text, method: text): int := #method_parameters(lineage(classes, owning_class).flat_map(ancestor => classes[ancestor].methods).filter(m => defined_word(m) == method)#1)
# whether the body calls the name with more arguments than the method takes, so the call is the function's: `count(items)`
# beside a count() method counts the list
overcalled(body: Node, name: text, taken: int): bool := nodes_in(body).any(part => is_called_name(part) and name_of(part#1) == name and #part - 1 > taken)
assigns_name(body: Node, name: text): bool := #assigned_values(body, name) > 0

# `name(self, parameters…)` of a method several classes declare, of a routed one or of an operator: the call of the
# instance's class's own, each class tested before the classes it extends; each owner's spelling of it (an operator's
# `plus` in one class, `+` in another); the last owner taking any other instance, unless it falls back
# the dispatcher an operator's spelling `+` of a class's method calls, and whether a dispatcher is one
operator_dispatcher(spelled: text): text := spelled + OPERATOR_DISPATCHER_MARK
OPERATOR_DISPATCHER_MARK = "·operator"
is_operator_dispatcher(name: text): bool := name.ends_with(OPERATOR_DISPATCHER_MARK)
method_dispatcher(classes: map, owners: list, spellings: list, name: text, falls_back: bool, reads_field: bool, operator: list?, promotions: list, floaters: list): Node := {
	parameters = method_parameters(method_in(classes[owners#1], spellings#1))
	call_arguments = [self_node] + parameters.map(method_parameter => symbol(parameter_name(method_parameter)))
	called = {}
	for i in 0..<#owners { called[owners[i]] = owned_name(spellings[i], owners[i]) }
	# an element read `xs#p` is no operation of numbers: no promotion nor float contagion, which would index by a float
	operated = falls_back and operator != ø and #call_arguments == 2 and spellings#1 not in position_words
	builtin = if operated then promoted(Key(call_arguments#1, operator#2 as Op, call_arguments#2), promotions, name) else ø
	# a commutative operator of a value and an instance, `5 * q`, is the instance's method with the value, q * 5
	reflected = if operated and operator#2 in commutative_operators then class_dispatch(deepest_first(classes, owners), called, call_arguments.reverse(), builtin, call_arguments#2) else builtin
	# (a method call `xs.add(o)` appends to a list in place; the operator itself, `xs + [o]` and `xs += [o]`, is the builtin's)
	fallback = if not falls_back then ø else if operated and not is_operator_dispatcher(name) then listed_in_place(spellings#1, call_arguments, reflected) else if operated then reflected else if reads_field then Key(self_node, Op.Dot, symbol(spellings#1)) else keyed_first(spellings#1, call_arguments, builtin_call(spellings#1, call_arguments))
	# a dispatcher with a fallback takes any values in every place: a number reaches the builtin, an instance its class's
	# method, compiled for any values, never for the kinds of a call no instance makes (`m[name] = v` of a map beside a
	# class's position(p, v), whose `p` would be a text); so a list `[3, 1].sort()` passes none of the owners' methods
	# its kind (their `self.n`)
	head = if falls_back then call_arguments.map(argument => Key(argument, Op.Colon, symbol("any"))) else [self_node] + parameters
	dispatched = class_dispatch(deepest_first(classes, owners), called, call_arguments, fallback)
	# a class with its own method of the operator takes a float itself (`q * sin(x)` keeps q's unit, π's `*` gives the
	# float): contagion only for the classes that leave the operator to the builtin
	contagious = floaters.filter(floater => not lineage(classes, floater#1).any(ancestor => ancestor in owners))
	Key(call_of(name, head), Op.Define, if operated then numbers_first(Key(call_arguments#1, operator#2 as Op, call_arguments#2), float_contagion(Key(call_arguments#1, operator#2 as Op, call_arguments#2), contagious, dispatched)) else dispatched)
}
# two numbers operate as numbers, before any class is asked: `x is real` holds of every number (lib/reals), so a boxed
# `0.5 * 0.4` of a program using reals went through real's `*` and back, ~9× the builtin in lib/sound's per-sample
# loops (card sound-start-speed)
numbers_first(operation: Node, dispatched: Node): Node := {
	both_numbers = Key(Key(key_of(operation), Op.Is, symbol("number")), Op.And, Key(value_of(operation), Op.Is, symbol("number")))
	Key(Key(Key(ø, Op.If, both_numbers), Op.Then, operation), Op.Else, dispatched)
}
# [class, its lifted float()] of each class converting itself to a float, a float() taking nothing
float_converters(classes: map, names: list, routes: list): list := owners_of(classes, names, float_method).filter(owning_class => #method_parameters(method_in(classes[owning_class], float_method)) == 0).map(owning_class => [owning_class, lifted_name(classes, names, float_method, owning_class, routes)])
float_method = "float"
# float contagion (decision float-contagion): an operation of a float (1.0f, `x as float`, a float's result, never an
# exact decimal) and an instance of a class with a float() is the floats' at once, `1.0f * π` the float times π's
# float, every class alike; else the operation as dispatched
float_contagion(operation: Node, floaters: list, dispatched: Node): Node := {
	left = key_of(operation)
	right = value_of(operation)
	op = op_of(operation)
	for floater in floaters.reverse() {
		converted = floater#2
		instance_right = Key(ø, Op.If, Key(Key(left, Op.Is, symbol(float_method)), Op.And, instance_test(right, floater#1)))
		instance_left = Key(ø, Op.If, Key(Key(right, Op.Is, symbol(float_method)), Op.And, instance_test(left, floater#1)))
		dispatched = Key(Key(instance_left, Op.Then, Key(call_of(converted, [left]), op, right)), Op.Else, dispatched)
		dispatched = Key(Key(instance_right, Op.Then, Key(left, op, call_of(converted, [right]))), Op.Else, dispatched)
	}
	dispatched
}
# the call of the first owner's method on an instance of it, else of the next owner's…, the last owner's on any other;
# with a fallback (a routed method's function itself, an operator's builtin), that on any value not an instance of
# the owners
# (`tested`: the argument whose class decides, the instance by default)
class_dispatch(owners: list, called: map, call_arguments: list, fallback: Node, tested: Node = self_node): Node := {
	first_call = call_of(called[owners#1], call_arguments)
	if #owners == 1 and fallback == ø { return first_call }
	otherwise = if #owners == 1 then fallback else class_dispatch(owners[1..], called, call_arguments, fallback, tested)
	test = Key(ø, Op.If, instance_test(tested, owners#1))
	Key(Key(test, Op.Then, first_call), Op.Else, otherwise)
}

# a call `x.sum(…)` of a routed method passing as many arguments as the method takes (`x.sum` the same of a method of
# none not also a field's name): the dispatcher's `sum·method(x, …)`, unless x is statically no instance of a class
# declaring it, then it stays as written; a call on a class, `T.of(2)`, calls the method of that class
routed(n: Node, routing: Routing): Node := {
	parts = (part => routed(part, routing))
	if is_key(n, Op.Assign) and is_position(key_of(n)) and element_word(key_of(n)) + "·assigned" in routing.methods { return position_call(key_of(n), element_word(key_of(n)) + "·assigned", [parts(value_of(n))], parts) }
	# `m[k] = v` of a class with set and no index: its set (decision map-protocol)
	if is_key(n, Op.Assign) and is_key(key_of(n), Op.Hash) and keyed_by(key_of(key_of(n)), "set", routing) { return method_routed(map_form_call(n, routing), routing) }
	# an element written in another way, `xs#1 = 7`, `b#p += 1`, keeps its place
	if n is key and op_of(n) in assigning_operators and is_position(key_of(n)) { return Key(Key(parts(key_of(key_of(n))), Op.Hash, parts(value_of(key_of(n)))), op_of(n), parts(value_of(n))) }
	if is_position(n) and element_word(n) in routing.methods { return position_call(n, element_word(n), [], parts) }
	if is_key(n, Op.Hash) and key_of(n) == ø and counting_method in routing.methods { return call_of(routed_name(counting_method), [parts(value_of(n))]) }
	# `count(b)`, `len(b)`, `size(b)` the same as `#b`
	if is_called_name(n) and #n == 2 and counts(name_of(n#1)) and counting_method in routing.methods { return call_of(routed_name(counting_method), [parts(n#2)]) }
	# `for k in p` of an instance whose class has keys() and no next(): walked by its keys, as a map is (decision
	# map-protocol)
	if walks_keys(n, routing) { return List([n#1, parts(n#2), n#3, parts(Key(n#4, Op.Dot, call_of(unaliased("keys"), []))), parts(n#5)], Bracket.None, Separator.Space) }
	# the same forms on a value known only at run time: the method's call on an instance of a class having it, the form
	# as written on any other value, `f(m: map) := m["a"]`
	unknown = run_time_map_form(n, routing)
	if unknown != ø {
		written = if is_key(n, Op.Assign) then Key(key_of(n), Op.Assign, parts(value_of(n))) else children(n, parts)
		return chosen(unknown#1, method_routed(unknown#2, routing), written)
	}
	method_routed(map_form_call(n, routing), routing)
}
# A class with the map words is a map (decision map-protocol): each map form on its instance calls its method,
# `keys(p)` p.keys(), `p["k"]` and `p.k` (no field k) p.get("k"), `p["k"] = v` and `p.k = v` p.set("k", v),
# `k in p` p.has(k); any other node as it is. A bare call only when the method takes the arguments after the first:
# `remove(x)` inside a class with remove(k) stays its own call. The words as the prelude's aliases left them, a
# class's has() its collection_contains()
# a word as the user writes it or as the prelude's aliases left it (`keys` or map_keys)
is_map_protocol_word(word: text): bool := {
	for protocol_word in ["keys", "get", "has", "set", "remove"] { if unaliased(protocol_word) == unaliased(word) { return yes } }
	no
}
map_form_call(n: Node, routing: Routing): Node := {
	if is_called_name(n) and #n >= 2 and is_map_protocol_word(name_of(n#1)) and unaliased(name_of(n#1)) in routing.methods and (#n - 2) in taken_counts(routing.classes, routing.names, unaliased(name_of(n#1))) {
		return Key(n#2, Op.Dot, call_of(unaliased(name_of(n#1)), items_of(n)[2..]))
	}
	# `values(p)` of a class with keys and get but no values of its own: the values its get gives, `keys(p).map(k => p.get(k))`
	if is_called_name(n) and #n == 2 and unaliased(name_of(n#1)) == unaliased("values") and keyed_by(n#2, "get", routing) and not keyed_by(n#2, "values", routing) { return keyed_values(n#2) }
	if is_group(n) and bracket_of(n) == "" and #n == 3 and n#2 is symbol and name_of(n#2) == "in" and keyed_by(n#3, "has", routing) { return Key(n#3, Op.Dot, call_of(unaliased("has"), [n#1])) }
	if is_key(n, Op.Assign) {
		keyed = map_key(key_of(n), routing)
		return if #keyed == 1 and keyed_by(key_of(key_of(n)), "set", routing) then Key(key_of(key_of(n)), Op.Dot, call_of(unaliased("set"), keyed + [value_of(n)])) else n
	}
	keyed = map_key(n, routing)
	if #keyed == 1 and keyed_by(key_of(n), "get", routing) then Key(key_of(n), Op.Dot, call_of(unaliased("get"), keyed)) else n
}
keyed_values(m: Node): Node := {
	held = fresh_name("map", fresh_number())
	walked = fresh_name("key", fresh_number())
	read = Key(walked, Op.Arrow, Key(held, Op.Dot, call_of(unaliased("get"), [walked])))
	statements([Key(held, Op.Assign, m), Key(call_of(unaliased("keys"), [held]), Op.Dot, call_of("map", [read]))])
}
# [the test, the method's call] of `m["k"]`, `m["k"] = v` and `k in m` on a name m whose class is known only at run time,
# when a class has the word; else ø. Only a name, so the test and the call read it twice
run_time_map_form(n: Node, routing: Routing): list? := {
	if is_key(n, Op.Assign) and text_key(key_of(n)) != "" { return instance_call(key_of(key_of(n)), "set", [text_key(key_of(n)), value_of(n)], routing) }
	if text_key(n) != "" { return instance_call(key_of(n), "get", [text_key(n)], routing) }
	if is_group(n) and bracket_of(n) == "" and #n == 3 and n#2 is symbol and name_of(n#2) == "in" { return instance_call(n#3, "has", [n#1], routing) }
	ø
}
instance_call(receiver: Node, word: text, arguments: list, routing: Routing): list? := {
	method = unaliased(word)
	if not (receiver is symbol) or static_type(receiver, routing) != ø { return ø }
	owners = owners_of(routing.classes, routing.names, method)
	if #owners == 0 { return ø }
	test = instance_test(receiver, owners#1)
	for name in owners[1..] { test = Key(test, Op.Or, instance_test(receiver, name)) }
	[test, Key(receiver, Op.Dot, call_of(method, arguments))]
}
# "k" of `m["k"]`, the parser's m#("k"+1); else ""
text_key(n: Node): text := if is_key(n, Op.Hash) and is_key(value_of(n), Op.Add) and value_of(value_of(n)) == 1 and kind_of(view_of(key_of(value_of(n)))) == "text" then view_of(key_of(value_of(n)))#2 else ""
# [the key] a map form reads: k of `p[k]` (the parser's p#(k+1)), any key, "k" of `p.k` when p's class has no field or
# method k; else []
map_key(n: Node, routing: Routing): list := {
	if is_key(n, Op.Hash) and key_of(n) != ø and is_shifted(value_of(n)) { return [key_of(value_of(n))] }
	if not (is_key(n, Op.Dot) and value_of(n) is symbol) { return [] }
	owner = static_type(key_of(n), routing)
	word = name_of(value_of(n))
	if owner == ø or owner not in routing.classes or word in fields_reaching(routing.classes, owner) or word in methods_reaching(routing.classes, owner) { return [] }
	[word]
}
# whether a value statically is an instance of a class having the map word
keyed_by(n: Node, word: text, routing: Routing): bool := {
	owner = static_type(n, routing)
	if owner == ø { return no }
	if owner in routing.classes { return unaliased(word) in methods_reaching(routing.classes, owner) }
	linked_method(owner, unaliased(word))
}
# whether a class of a linked library module (`m = ListMap()`, lib/collections.warp) has the method: its lifted word
# `map_keys·ListMap`, or the module's plain word of that name (a class's set(k, v) is lifted as `set`)
linked_method(owning_class: text, method: text): bool := (method + "·" + owning_class) in module.linked_words or ((owning_class + "·new") in module.linked_words and method in module.linked_words)
walks_keys(n: Node, routing: Routing): bool := {
	if not (is_group(n) and bracket_of(n) == "" and #n == 5 and n#1 is symbol and name_of(n#1) == "for" and n#3 is symbol and name_of(n#3) == "in") { return no }
	walked = static_type(n#4, routing)
	if walked == ø or walked not in routing.classes { return no }
	reached = methods_reaching(routing.classes, walked)
	unaliased("keys") in reached and "next" not in reached
}
counts(word: text): bool := word == counting_method or canonical_word(word) == counting_method
# `b#p` of a value, no field read `m#("x"+1)` nor typed array `float[n]` (the parser's float#(n+1), extensions/sugar/lists.warp)
is_position(n: Node): bool := is_key(n, Op.Hash) and key_of(n) != ø and not (is_key(value_of(n), Op.Add) and key_of(value_of(n)) is text) and not (key_of(n) is symbol and is_type_word(name_of(key_of(n))))
# `b#(i+1)`, the parser's b[i], is the class's index(i); another b#p its position(p)
is_shifted(at: Node): bool := is_key(at, Op.Add) and value_of(at) == 1
element_word(element: Node): text := if is_shifted(value_of(element)) then index_method else position_method
position_call(element: Node, word: text, written: list, parts: function): Node := {
	at = value_of(element)
	call_of(routed_name(word), [parts(key_of(element)), parts(if word.starts_with(index_method) then key_of(at) else at)] + written)
}
method_routed(n: Node, routing: Routing): Node := match n {
	Key(left, Op.Dot, right): {
		object = routed(left, routing)
		# a member call `.get(k)` is no bare call `get(k)`: only its arguments are routed
		member = if is_called_name(right) then children(right, part => routed(part, routing)) else routed(right, routing)
		method = routed_member(right, routing)
		# a call on a class, `T.of(2)`, is its static method's, the class in the instance's place
		type = if left is symbol and name_of(left) in routing.classes then name_of(left) else static_type(left, routing)
		if method == ø or not may_own(type, method, routing) { return Key(object, Op.Dot, member) }
		call_of(routed_function(type, method, routing), [object] + (if member is symbol then [] else items_of(member)[1..]))
	}
	# `zoned(now, "UTC")` the same as `now.zoned("UTC")` where the first argument is statically an instance of a class
	# declaring the routed method (decision zone-word); on any other value the function as written
	_: if is_instance_call(n, routing) then method_routed(Key(n#2, Op.Dot, call_of(name_of(n#1), items_of(n)[2..])), routing) else children(n, part => routed(part, routing))
}
is_instance_call(n: Node, routing: Routing): bool := {
	if not is_called_name(n) or #n < 2 or name_of(n#1) not in routing.methods { return no }
	type = static_type(n#2, routing)
	type != ø and type in routing.classes and may_own(type, name_of(n#1), routing) and (#n - 2) in taken_counts(routing.classes, routing.names, name_of(n#1))
}
# the routed method a member `.sum` or `.sum(…)` calls, else ø
routed_member(member: Node, routing: Routing): text? := {
	method = if member is symbol then name_of(member) else if is_called_name(member) then name_of(member#1) else ø
	if method == ø or method not in routing.methods { return ø }
	taken = taken_counts(routing.classes, routing.names, method)
	fits = if member is symbol then 0 in taken and not is_field_of_any(routing.classes, routing.names, method) else (#member - 1) in taken
	if fits then method else ø
}
# whether a value of that static type (ø: known only at run time) may be an instance of a class declaring the method
may_own(type: text?, method: text, routing: Routing): bool := type == ø or (type in routing.classes and owners_of(routing.classes, routing.names, method).any(owner => owner in lineage(routing.classes, type) or type in lineage(routing.classes, owner)))
# the function a routed call on a value of that static type calls: its class's method itself when no class extending
# it declares its own (`v.max(3)` of a V: max·V), else the dispatcher
routed_function(type: text?, method: text, routing: Routing): text := {
	owners = owners_of(routing.classes, routing.names, method)
	if type == ø or owners.any(owner => owner != type and type in lineage(routing.classes, owner)) { return routed_name(method) }
	inherited = lineage(routing.classes, type).filter(ancestor => ancestor in owners)
	if #inherited == 0 then routed_name(method) else lifted_name(routing.classes, routing.names, method, inherited#1, routing.methods)
}

# the type a value statically has: a class, or a type of no class (list, int, text…); ø when only the run time knows
static_type(n: Node, routing: Routing): text? := {
	if n is symbol { return if name_of(n) in routing.known then routing.known[name_of(n)] else routing.results.get(name_of(n)) }
	if is_key(n, Op.Dot) and value_of(n) is symbol {
		owner = static_type(key_of(n), routing)
		return if owner in routing.classes then field_type(routing.classes, owner, name_of(value_of(n))) else ø
	}
	# a time literal is no instance: `2026-10-14T23:00.time` reads its field, never Instant's time()
	if is_time_view(n) { return time_type }
	written_type(n, routing.classes, routing.results)
}
# function → the class it declares it gives, `now(): Instant`
result_classes(statements: list, classes: map): map := {
	found = {}
	for statement in statements {
		result = written_result(statement)
		if result != ø and result in classes { found[defined_word(statement)] = result }
		# (`now(): Instant := …` as written, before definitions.warp holds its result)
		if is_key(statement, Op.Define) and is_key(key_of(statement), Op.Colon) and value_of(key_of(statement)) is symbol and name_of(value_of(key_of(statement))) in classes {
			head = key_of(key_of(statement))
			if head is symbol or is_called_name(head) { found[if head is symbol then name_of(head) else name_of(head#1)] = name_of(value_of(key_of(statement))) }
		}
	}
	found
}
field_type(classes: map, owning_class: text, field: text): text? := {
	for ancestor in lineage(classes, owning_class) { if field in classes[ancestor].field_types { return classes[ancestor].field_types[field] } }
	ø
}
# whether a call of that many arguments fits a definition the word has, the program's or a typed line of the
# library's; a word of none (a sugar rule's, the emitter's) is taken as fitting
written_call_fits(statements: list, word: text, count: int): bool := {
	defined = statements.map(defined_call_head).filter(head => head != ø and name_of(head#1) == word)
	signatures = defined.map(head => signature_of(items_of(head))) + (lines_of(typed_lines, word) + (if word_lines().has(word) then word_lines()[word] else [])).map(line => line.signature)
	#signatures == 0 or signatures.any(signature => takes(signature, count))
}
# the head `f(x)` of a definition `f(x) := …`, or of `def f(x) {…}` before extensions/sugar/declarations.warp makes it one
# (draw's `def show()`), else ø
defined_call_head(statement: Node): Node? := {
	head = if is_key(statement, Op.Define) then key_of(statement) else if is_keyword_definition(statement) then (statement#2)#1 else ø
	if head != ø and is_called_name(head) then head else ø
}
is_keyword_definition(n: Node): bool := is_group(n) and bracket_of(n) == "" and #n == 2 and n#1 is symbol and name_of(n#1) in function_keywords and is_group(n#2) and #(n#2) > 0
# the types a statement's names hold: the program's, but a function's parameters its own (their declared type, the
# instance of a lifted method its class)
statement_types(statement: Node, program_types: map, self_types: map, classes: map): map := {
	known = {}
	parameters = if defined_word(statement) != ø and is_called_name(key_of(statement)) then items_of(key_of(statement))[1..] else []
	taken = parameters.map(parameter_name)
	for name in program_types.keys { if program_types[name] != "" and name not in taken { known[name] = program_types[name] } }
	# a parameter typed any is known only at run time, as an untyped one
	for parameter in parameters.filter(parameter => is_key(parameter, Op.Colon) and type_named(value_of(parameter)) != ø and type_named(value_of(parameter)) != "any") { known[parameter_name(parameter)] = type_named(value_of(parameter)) }
	if defined_word(statement) != ø and defined_word(statement) in self_types { known["self"] = self_types[defined_word(statement)] }
	known
}
# the operator a method's name spells (not named operator_word: a plural reads as the function's, and lambdas.warp's
# global operator_words would be its call), [its word, its glyph] (`plus` and `+` give [add, "+"]), else ø
spelled_operator(operator_table: map, spelled: text): list? := if spelled in operator_table then operator_table[spelled] else ø
# how many parameters the methods of that name take (besides their instance), each count once
taken_counts(classes: map, names: list, method: text): list := {
	counts = []
	for owning_class in owners_of(classes, names, method) {
		for declared in methods_named(classes[owning_class], method) {
			count = #method_parameters(declared)
			if count not in counts { counts += [count] }
		}
	}
	counts
}
# `o.p = v` of a property p with a setter: the setter's call p(o, v); any other node as it is
setter_calls(n: Node, setters: list, routes: list): Node := {
	parts = (part => setter_calls(part, setters, routes))
	if is_key(n, Op.Assign) and is_key(key_of(n), Op.Dot) and value_of(key_of(n)) is symbol and name_of(value_of(key_of(n))) in setters {
		return call_of(called_name(name_of(value_of(key_of(n))), routes), [parts(key_of(key_of(n))), parts(value_of(n))])
	}
	children(n, parts)
}
# the classes declaring a method of that name taking that many parameters
owners_taking(classes: map, names: list, method: text, count: int): list := owners_of(classes, names, method).filter(owning_class => methods_named(classes[owning_class], method).any(declared => #method_parameters(declared) == count))
is_field_of_any(classes: map, names: list, name: text): bool := names.any(owning_class => name in classes[owning_class].fields)

# the classes, each before the classes it extends
deepest_first(classes: map, names: list): list := {
	ordered = []
	for name in names {
		insert_at = #ordered.filter(other => #lineage(classes, other) >= #lineage(classes, name))
		ordered = ordered[0..<insert_at] + [name] + ordered[insert_at..]
	}
	ordered
}

# a method's body as a function of the instance: a field read or written bare is the instance's, `self.name`; a
# sibling method read or called bare is called on it; a member after a dot, an entry's or named argument's name and
# the names a lambda takes stay as written
on_instance(n: Node, fields: list, siblings: list, routes: list): Node := {
	if n is symbol and name_of(n) in instance_names { return self_node }
	if n is symbol and name_of(n) in fields { return Key(self_node, Op.Dot, n) }
	# a sibling named by a type word read bare is the type, `o is float`; it is called as `float()`
	if n is symbol and name_of(n) in siblings and not names_syntax(name_of(n)) { return call_of(called_name(name_of(n), routes), [self_node]) }
	if is_called_name(n) and name_of(n#1) in siblings { return call_of(called_name(name_of(n#1), routes), [self_node] + arguments_on_instance(n, fields, siblings, routes)) }
	match n {
		Key(left, Op.Dot, right): {
			member = if is_called_name(right) then group_like(right, [right#1] + arguments_on_instance(right, fields, siblings, routes)) else right
			Key(on_instance(left, fields, siblings, routes), Op.Dot, member)
		}
		Key(left, Op.Colon, right): { if left is symbol then Key(left, Op.Colon, on_instance(right, fields, siblings, routes)) else children(n, part => on_instance(part, fields, siblings, routes)) }
		Key(left, Op.Arrow, right): {
			taken = lambda_parameters(left)
			Key(left, Op.Arrow, on_instance(right, fields.filter(field => field not in taken), siblings.filter(sibling => sibling not in taken), routes))
		}
		_: children(n, part => on_instance(part, fields, siblings, routes))
	}
}
# the arguments of the call, as functions of the instance
arguments_on_instance(invocation: Node, fields: list, siblings: list, routes: list): list := items_of(invocation)[1..].map(part => on_instance(part, fields, siblings, routes))
# the names a lambda takes: `x`, `(a, b)`
lambda_parameters(left: Node): list := if left is symbol then [name_of(left)] else if is_group(left) then items_of(left).filter(x => x is symbol).map(name_of) else []
