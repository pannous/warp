# The float suffix of C, Java and C# (card parser-rows, decision core-is-self): `0.1f`, `3d`, a tight conversion
# (C's `0.1l` is the litre instead; Rust twin: numbers.rs literal_type_suffix)
FLOAT_SUFFIXES = "fFdD"
read_float_suffix(p: Parser, written: text, literal: text): Node := {
	if not FLOAT_SUFFIXES.contains(char_here(p)) or is_name_char(char_ahead(p, 1)) { return ø }
	advance(p)
	Key(written_number(written), Op.As, symbol("float"))
}
float_suffixes_extension = Extension{name: "float_suffixes", number_suffix_readers: [read_float_suffix]}
