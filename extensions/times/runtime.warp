## times (card time-primitives): a time node of a form and a position, read by the intrinsics
## time_form, time_position, duration_months, duration_days, zone_index, zone_offset and made by time_of(info, position)
use "../../compiler/runtime/intrinsics.warp"
use "../../compiler/analysis/kinds.warp"
use "../../compiler/runtime/conversions.warp"
use "../../compiler/runtime/arithmetic.warp"
use "../../compiler/runtime/floats.warp"
use "../../compiler/runtime/instructions.warp"
use "../../compiler/runtime/library_words.warp"
use "../../compiler/runtime/nodes.warp"
use "../../compiler/emitter/byte_codes.warp"
# durations.warp's duration_text and its nanosecond constants
use "durations.warp"
is_time(n: Node): bool := not is_null(n) and kind_code(n) == Kind.Time
is_duration(t: Node): bool := time_form(t) == TimeFormCode.Duration
# `a < b` (relation 0), `a <= b` (1), `a > b` (2), `a >= b` (3) of two times of one form: two times by their positions;
# two durations yes when it holds on every date, no when on none, else a failure (`1 month < 28 days` is no,
# `1 month < 30 days` depends on the month); times of different forms have no order
time_holds(a: Node, b: Node, relation: int): bool := {
	clocks = is_clock_of_day_pair(a, b)
	if time_form(a) != time_form(b) and not clocks { return times_of_different_kinds_have_no_order(time_form_name(time_form(a)), time_form_name(time_form(b))) != 0 }
	# `a > b` is `b < a`
	smaller = if relation < 2 then a else b
	larger = if relation < 2 then b else a
	strict = relation % 2 == 0
	durations = is_duration(a) and not clocks
	fewest = if clocks then nanos_of_day(smaller) - nanos_of_day(larger) else if durations then duration_difference_bound(smaller, larger, no) else time_position(smaller) - time_position(larger)
	most = if durations then duration_difference_bound(smaller, larger, yes) else fewest
	if most < 0 or (most == 0 and not strict) { return yes }
	if fewest > 0 or (fewest == 0 and strict) { return no }
	durations_compare_differently_on_different_dates() != 0
}
# an instant, local time or time of day beside a duration without months or days compares by its time of day, `ref >= 6h`
is_clock_of_day_pair(a: Node, b: Node): bool := {
	if not is_time(a) or not is_time(b) { return no }
	(has_clock(a) and is_plain_duration(b)) or (has_clock(b) and is_plain_duration(a))
}
has_clock(n: Node): bool := time_form(n) in [TimeFormCode.Instant, TimeFormCode.Local, TimeFormCode.Clock]
is_plain_duration(n: Node): bool := is_duration(n) and duration_months(n) == 0 and duration_days(n) == 0
# the nanoseconds since midnight of an instant or local time, a plain duration's own
nanos_of_day(n: Node): int := {
	if is_duration(n) { return duration_nanos(n) }
	position = time_position(n)
	position - floor_quotient(position, day_nanos()) * day_nanos()
}
time_form_name(form: int): text := {
	if form == TimeFormCode.Instant { return "instant" }
	if form == TimeFormCode.Date { return "date" }
	if form == TimeFormCode.Local { return "local datetime" }
	if form == TimeFormCode.Duration { return "duration" }
	if form == TimeFormCode.Zoned { return "zoned time" }
	"time of day"
}
# the runtime error of time_holds, naming both kinds
times_of_different_kinds_have_no_order(left: text, right: text) := {
	returned_error("a " + left + " and a " + right + " have no order; fix: compare its time of day, e.g. ref.time >= 6h")
}
# n as it is, unless n and other are durations of the two kinds: a calendar duration (`1 day`) beside an instance
# (lib/units' `2 hours`), which are one kind only from card dates-times-extraction (decision one-duration)
one_duration_kind(n: Node, other: Node): Node := {
	if (is_calendar_duration(n) and is_instance(other)) or (is_calendar_duration(other) and is_instance(n)) { calendar_and_clock_durations_are_different_kinds() }
	n
}
is_calendar_duration(n: Node): bool := is_time(n) and is_duration(n)
is_instance(n: Node): bool := not is_null(n) and marked_kind(n) == Marked.Instance
# the runtime error of one_duration_kind, named to read off the trace
calendar_and_clock_durations_are_different_kinds() := {
	fail()
	0
}
# an operand of a time's + - * as lib/time.warp time_operation takes it: its form, -1 for a whole number,
# and its position, a whole number's value
operand_form(n: Node): int := if is_time(n) then time_form(n) else -1
operand_position(n: Node): int := unboxed_int(n)

## times (card time-text-warp): a $Node
## of kind Time, its form in the info bits, its position in an $i64box: days since 1970 for a
## date, nanoseconds since 1970 for an instant and a local time, since midnight for a time of day
time_form(n: Node): int := int_remainder(info_byte(n), TimeInfoUnit.Days)
# whether n is a time, what made_case(Made.Time, …) tests
holds_time(n: Node): bool := kind_code(n) == Kind.Time
# RFC 3339, `2026-10-10T14:43:33.682Z`: a date has no clock, a time of day no date, a
# local time no Z; a duration (card duration-warp) as its parts; a zoned time its wall clock and offset only,
# `2024-07-01T12:00+02:00`, its zone's name being .zone (decisions local-now, zone-literal-dropped)
time_text(n: Node): text := {
	form = time_form(n)
	if form == TimeFormCode.Duration { return duration_text(n) }
	if form == TimeFormCode.Zoned { return zoned_text(n) }
	position = unboxed_int(n)
	if form == TimeFormCode.Date { return date_text(position) }
	days = floor_quotient(position, day_nanos())
	clock = clock_text(position - days * day_nanos(), form)
	if form == TimeFormCode.Clock { return clock }
	zone = if form == TimeFormCode.Instant then "Z" else ""
	date_text(days) + "T" + clock + zone
}
# Howard Hinnant's civil_from_days as `2026-10-10`, the proleptic Gregorian date of a day number
date_text(days: int): text := {
	z = days + 719468
	era = floor_quotient(z, 146097)
	day_of_era = z - era * 146097
	year_of_era = int_quotient(day_of_era - int_quotient(day_of_era, 1460) + int_quotient(day_of_era, 36524) - int_quotient(day_of_era, 146096), 365)
	day_of_year = day_of_era - (365 * year_of_era + int_quotient(year_of_era, 4) - int_quotient(year_of_era, 100))
	shifted_month = int_quotient(5 * day_of_year + 2, 153)
	day = day_of_year - int_quotient(153 * shifted_month + 2, 5) + 1
	month = if shifted_month < 10 then shifted_month + 3 else shifted_month - 9
	year = year_of_era + era * 400
	if month <= 2 { year += 1 }
	padded(year, 4) + "-" + padded(month, 2) + "-" + padded(day, 2)
}
# `14:43:33.682` of the nanoseconds of a day: the seconds only when there are any or it is a time of day (22:27:46)
clock_text(nanos: int, form: int): text := {
	hours = int_quotient(nanos, hour_nanos())
	minutes = int_remainder(int_quotient(nanos, minute_nanos()), 60)
	seconds = int_remainder(int_quotient(nanos, second_nanos()), 60)
	fraction = int_remainder(nanos, second_nanos())
	out = padded(hours, 2) + ":" + padded(minutes, 2)
	if seconds != 0 or fraction != 0 or form == TimeFormCode.Clock { out = out + ":" + padded(seconds, 2) }
	out + fraction_text(fraction)
}
# `.5` of the nanoseconds below a second, without trailing zeros; "" for none
fraction_text(fraction: int): text := {
	if fraction == 0 { return "" }
	digits = padded(fraction, 9)
	stop = 9
	while byte_at(digits, stop - 1) == Ascii.Zero { stop -= 1 }
	"." + bytes_between(digits, 0, stop)
}
# n with leading zeros to count digits
padded(n: int, count: int): text := zeros(count - byte_count(int_text(n))) + int_text(n)
# a zoned time's seconds east of UTC: its offset in minutes above the kind (8 bits), form (3) and zone index (8)
zone_seconds_of(n: Node): int := floor_quotient(marked_kind(n), power(2, 19)) * 60
zoned_text(n: Node): text := {
	east = zone_seconds_of(n)
	wall = unboxed_int(n) + east * second_nanos()
	day = floor_quotient(wall, day_nanos())
	date_text(day) + "T" + clock_text(wall - day * day_nanos(), TimeFormCode.Local) + offset_text(east)
}
# `+05:30` of seconds east of UTC
offset_text(east: int): text := {
	sign = if east < 0 then "-" else "+"
	whole_minutes = int_quotient(if east < 0 then 0 - east else east, 60)
	sign + padded(int_quotient(whole_minutes, 60), 2) + ":" + padded(int_remainder(whole_minutes, 60), 2)
}
