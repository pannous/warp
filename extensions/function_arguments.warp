# An `it` expression given where a function is taken is the function of `it` (card it-expression-function, decision
# declared-block-parameters): the callee's signature says which arguments are functions, the program's own definition
# (`apply(f: function, x) := f(f(x)); apply(it + 3, 1)` is 7) or a builtin's typed line (`find(xs: list, f: function)`:
# `[1 2 3].find(it > 1)` is 2); a block `{ it * 10 }` too, and a trailing block is the call's function argument, `xs.map { $0 * 10 }`. It runs first, so such an `it` is never the last result.
function_arguments_extension = Extension{name: "function_arguments", passes_before: {"tries": function_arguments}}

IT_WORD = "it"

function_arguments(program: Node) as Node := {
	defined = own_signatures(program)
	bottom_up(program, n => with_function_arguments(n, defined))
}

# the program's definitions by name: [their signatures]
own_signatures(program: Node) as map := {
	found = {}
	for n in nodes_in(program) {
		definition = definition_of(plain_node(n))
		if definition != ø { found[definition.name] = (found.get(definition.name) ?? []) + [Signature(parameters: definition.parameters.map(parameter_of))] }
	}
	found
}

# the signatures a call of the word may take: the definitions the program holds (the prelude's it reaches too: text's
# `find(t, part)`) and the builtins' typed lines (a list's `find(xs, f: function)`)
signatures_of(word: text, defined: map) as list := (defined.get(word) ?? []) + lines_of(typed_lines, unaliased(word)).map(line => line.signature)

# `f: function`, `body: block`, a bare `block`, `f: (any) -> bool`
is_function_typed(parameter: Parameter) as bool := parameter.type_name in ["function", "block"] or parameter.type_name.contains("->") or (parameter.name == "block" and parameter.type_name == "")

# the parameter an argument at place (from 1) fills: a named argument `by: -it` its own, else the one at its place
parameter_filled(signature: Signature, place: int, argument: Node) as Parameter? := {
	if is_key(argument, Op.Colon) and key_of(argument) is symbol {
		return signature.parameters.find(parameter => parameter.name == name_of(key_of(argument)) or parameter.label == name_of(key_of(argument)))
	}
	if place <= #signature.parameters then signature.parameters#place else ø
}

# a function in a signature that takes as many arguments as the call gives: `find(xs, it > 1)` beside text's
# `find(t, part)` reads the list's
is_function_place(signatures: list, place: int, arguments: list) as bool := {
	signatures.filter(signature => #signature.parameters >= #arguments).any(signature => {
		parameter = parameter_filled(signature, place, arguments#place)
		parameter != ø and is_function_typed(parameter)
	})
}

# whether `it` occurs in n outside a function that binds it
names_free_it(n: Node) as bool := n == symbol(IT_WORD) or (not is_lambda(n) and parts_of(n).any(names_free_it))

# `it + 3` → `it => it + 3`; a named argument keeps its name, `by: -it` → `by: it => -it`
as_function_of_it(argument: Node) as Node := {
	if is_named(argument) { return Key(key_of(argument), Op.Colon, as_function_of_it(value_of(argument))) }
	if names_free_it(argument) then Key(symbol(IT_WORD), Op.Arrow, argument) else argument
}

is_named(argument: Node) as bool := is_key(argument, Op.Colon) and key_of(argument) is symbol

# an argument that gives a function where one is taken: an `it` expression or a block, `{ $0 * 10 }`, `{ |x| x + 1 }`
gives_function(argument: Node) as bool := if is_named(argument) then gives_function(value_of(argument)) else names_free_it(argument) or is_block_argument(argument)

# the arguments with each one at a function place made the function of `it`; ø when none gives a function there
with_functions(word: text, arguments: list, defined: map) as list? := {
	signatures = signatures_of(word, defined)
	given = range_list(#arguments).map(i => is_function_place(signatures, i + 1, arguments) and gives_function(arguments#(i + 1)))
	if not given.any(place => place) { return ø }
	range_list(#arguments).map(i => if given#(i + 1) then as_function_of_it(arguments#(i + 1)) else arguments#(i + 1))
}

# `x.w(a)` with x its first argument: the call of w on the arguments, else ø
method_call(receiver: Node, word: Node, arguments: list, defined: map) as Node? := {
	given = with_functions(name_of(word), [receiver] + arguments, defined)
	if given == ø then ø else Key(receiver, Op.Dot, List([word] + given[1..], Bracket.Round, Separator.None))
}

# the call a phrase makes when it gives a function: `w(a, b)`, `x.w(a)`, and spaced `w a b`, `x.w a`, `x.w(a) b`:
# `map [1 2] (it * 10)` is map([1 2], it => (it * 10)), `xs.map { $0 * 10 }` is xs.map({ $0 * 10 }), `xs.fold(0) { … }`
# is xs.fold(0, { … }); else ø
call_given_function(items: list, spaced: bool, defined: map) as Node? := {
	head = items#1
	if head is symbol {
		given = with_functions(name_of(head), items[1..], defined)
		return if given == ø then ø else List([head] + given, Bracket.Round, Separator.None)
	}
	if not spaced or not is_key(head, Op.Dot) { return ø }
	method = value_of(head)
	if method is symbol { return method_call(key_of(head), method, items[1..], defined) }
	if is_group(method) and bracket_of(method) == "(" and #method > 0 and method#1 is symbol { return method_call(key_of(head), method#1, items_of(method)[1..] + items[1..], defined) }
	ø
}

with_function_arguments(n: Node, defined: map) as Node := match n {
	# a block on one line, `{ it.map { it * 10 } }`, holds its phrase's words itself (core/parsing/phrase_blocks.warp)
	List(items, Bracket.Curly, Separator.Space): {
		call = if #items < 2 then ø else call_given_function(items, yes, defined)
		if call == ø then n else List([call], Bracket.Curly, Separator.Semicolon)
	}
	List(items, Bracket.Round, separator): if #items < 2 then n else call_given_function(items, no, defined) ?? n
	List(items, Bracket.None, Separator.Space): if #items < 2 then n else call_given_function(items, yes, defined) ?? n
	Key(receiver, Op.Dot, List(items, Bracket.Round, separator)): {
		if #items < 1 or not (items#1 is symbol) { return n }
		method_call(receiver, items#1, items[1..], defined) ?? n
	}
	# a block glued to the method word, `xs.map{ it * 2 }`, `xs.sort{$0 > $1}`, read as a tag, is its last argument
	# whatever the method's signature (test_glued_method_block); the signature says whether its `it` makes a function
	Key(receiver, Op.Dot, Key(word, Op.Colon, block)): if word is symbol and is_block_argument(block) then method_call(receiver, word, [block], defined) ?? Key(receiver, Op.Dot, List([word, block], Bracket.Round, Separator.None)) else n
	_: n
}
