# A field annotation can still be a Type node when the early rewrite runs.
typed_json_field_type(member: Node): text? := match member {
	Key(left, Op.Assign, right): typed_json_field_type(left)
	Key(left, Op.Colon, right): annotated_type_name(right)
	_: ø
}
# the type an annotation `: T` names, read through its view: a Type node there before the early rewrite, else T written
annotated_type_name(written: Node): text? := {
	view = view_of(written)
	if kind_of(view) == "type" then declared_type_name(view#2) else type_named(written)
}

# the statement declaring the class of that name in the program, ø for none
declared_class(type_name: text, program: Node): Node? := {
	for statement in level_statements(program) {
		view = class_view(statement)
		if view != ø and declared_type_name(view#2) == type_name { return statement }
	}
	ø
}

# `{name: "User", order: ["id", "address"], types: {id: "number", address: {…Address's…}, tags: {list: "text"}},
# defaults: {port: 80}, make: (fields) => User{id: fields["id"], …}}`: a class the program declares as data, for a
# reader at run time (lib/json.warp typed_json_value): its fields in order, each one's type (a type word, a class's
# data, `{list: …}` of a list, `{optional: …}` of a `T?` one), the defaults of those that have one and its maker from the fields by name; a raise
# naming why for a class it can't give so
CLASS_DATA_TYPES = ["number", "int", "float", "string", "text", "bool"]
class_data(type_name: Node, program: Node): Node := {
	name = name_of(type_name)
	statement = declared_class(name, program)
	if statement == ø { return class_data_refused("typed JSON requires a declared class") }
	if constructor_of(class_declared(statement, class_view(statement))) != ø { return class_data_refused("typed JSON does not support class constructors yet") }
	written = class_data_text(name, program, [])
	if written == ø then class_data_refused("typed JSON supports only required flat fields yet") else plain_node(parsed(written))
}
class_data_refused(why: text): Node := plain_node(parsed("raise \"" + why + "\""))
class_data_text(name: text, program: Node, ancestors: list): text? := {
	statement = declared_class(name, program)
	if statement == ø or name in ancestors { return ø }
	view = class_view(statement)
	declared = class_declared(statement, view)
	if constructor_of(declared) != ø { return ø }
	types = []
	defaults = []
	optional = []
	for member in view#3[3..].map(member_read) {
		field = field_name(member)
		if field != ø {
			field_type = typed_json_field_type(member)
			if field_type == ø { return ø }
			written = type_data_text(field_type, program, ancestors + [name])
			if written == ø { return ø }
			types += [field + ": " + written]
			if field_type.ends_with("?") { optional += [field] }
			if is_key(member, Op.Assign) { defaults += [field + ": " + as_code(value_of(member))] }
		}
	}
	fields = declared.fields
	order = fields.map(field => "\"" + field + "\"").join(", ")
	# (a `T?` field the data leaves out is set only when given: the class leaves it ø)
	given = field => "typed_fields[\"" + field + "\"]"
	made = "{ made = " + name + "{" + fields.filter(field => field not in optional).map(field => field + ": " + given(field)).join(", ") + "}; " + optional.map(field => "if typed_fields.has(\"" + field + "\") { made." + field + " = " + given(field) + " }; ").join("") + "made }"
	"{name: \"" + name + "\", order: [" + order + "], types: {" + types.join(", ") + "}, defaults: {" + defaults.join(", ") + "}, make: (typed_fields => " + made + ")}"
}
type_data_text(field_type: text, program: Node, ancestors: list): text? := {
	list_prefix = "list of "
	if field_type.ends_with("?") {
		item = type_data_text(field_type[0 ..< #field_type - 1], program, ancestors)
		return if item == ø then ø else "{optional: " + item + "}"
	}
	if field_type.starts_with(list_prefix) {
		item = type_data_text(field_type[#list_prefix ..], program, ancestors)
		return if item == ø then ø else "{list: " + item + "}"
	}
	if field_type in CLASS_DATA_TYPES then "\"" + field_type + "\"" else class_data_text(field_type, program, ancestors)
}

# `{$0 > $1}` → `(shorthand·0, shorthand·1) => {shorthand·0 > shorthand·1}`: a block reading Swift's shorthand
# arguments as the lambda of as many as it reads, up to the highest, renamed since `$0` in a rule's result would be a
# hole; ø for a block reading none
shorthand_closure(block: Node): any := {
	count = 0
	for at in 0 to 9 { if mentions(block, "$" + at) { count = at + 1 } }
	if count == 0 { return ø }
	body = block
	for at in 0 to count - 1 { body = renamed(body, "$" + at, symbol("shorthand·" + at)) }
	Key(List([symbol("shorthand·" + at) for at in 0 to count - 1], Bracket.Round, Separator.Comma), Op.Arrow, body)
}

# `a=5; b=1; a-b` (decision kebab-or-minus): a hyphenated name the program binds nothing to, whose parts it binds
# (anywhere: a parameter too), is their difference `a - b - c`, noted with its fix; ø for one the program binds,
# warned when its parts are bound too, or of a part it doesn't
hyphen_difference(name: Node, program: Node): any := {
	written = spelled(name)
	parts = written.split("-")
	if #parts < 2 or parts.any(part => part == "") { return ø }
	bound = names_bound_in_kept(program)
	if not parts.all(part => bound.has(part)) { return ø }
	spaced = parts.join(" - ")
	if bound.has(written) {
		# where it is written, so the page's "I meant" renames it there and at every read (P81)
		diagnose(call_of("kebab_name", [written, spaced, parts.join("_")]), name)
		return ø
	}
	warn written + " reads as " + spaced + ": " + parts.join(" and ") + " are bound, no name " + written + "; fix: " + parts.join("_") + " or " + spaced
	difference = symbol(parts#1)
	# each difference in its own round group, as `(a - b)` parses: a bare Key reads as the spaced list `a -b`
	for part in parts[1..] { difference = List([Key(difference, Op.Sub, symbol(part))], Bracket.Round, Separator.None) }
	difference
}
