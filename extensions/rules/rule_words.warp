# The words a rewrite rule's `where` calls at compile time (decision computed-hole; core/passes/rewrites.warp
# computed): `where $names = path_parameters($path)` binds the hole to the word's result, a node or a list of nodes
# (a rest hole's items), `where routed($program)` holds when the word gives yes. Each word takes the code its rule's
# holes bound, `$program` the whole program, and runs inside the compiler.
# a shader's holes are extensions/rules/shader_holes.warp's words, packing GPU lists extensions/rules/gpu_packing.warp's
use shader_holes
use gpu_packing

# the mark of a program's function named as a library word, its own (core/passes/prelude_words.warp own_word)
own_mark = "·own"

# where a path parameter's name ends: its type `:id:int`, a pattern `:id(\d+)`, a mark `:tab?` `:path*` `:path+`
parameter_ends = ":(?*+"

# the names of a path's parameters: "/users/:id:int/posts/:post" → ["id", "post"]
path_parameters(path: Node): list := "${path}".split("/").filter(part => part.starts_with(":")).map(path_parameter)
path_parameter(part: text): text := {
	name = ""
	for letter in part[1 ..< #part] {
		if parameter_ends.contains(letter) { return name }
		name += letter
	}
	name
}

# `users` → "users": a name as the text it is spelled by, a program's own word as written (twice·own → "twice")
spelled(name: Node): text := "${name}".remove_suffix(own_mark)

# `x > 1500` and m → `x > 1500 * m`: a unit after an expression multiplies its last amount, through the operators
# a unit binds tighter than (lib/units.warp's rules); ø when the expression ends in no amount, or starts with a unit
# word, the tail of an amount split off before it (`2 L == 2000 cm` parses as 2, L == 2000, cm: card spaced-unit-comparison)
unit_bound(amounted: Node, unit: Node): any := {
	if is_amount(amounted) { return Key(amounted, Op.Mul, unit) }
	if amounted is key and op_of(amounted) in unit_ambiguous_ops { throw unit_ambiguous(amounted, unit) }
	if not (amounted is key and op_of(amounted) in unit_binding_ops) or starts_with_unit(amounted) { return ø }
	right = unit_bound(value_of(amounted), unit)
	if right == ø then ø else Key(key_of(amounted), op_of(amounted), right)
}
# what a unit after it measures (decision unit-after-number): a number, an amount in parentheses, `(50/3) ms`, a name
# the program binds a value to, `x = 7; sleep(x ms)`
is_amount(code: Node): bool := {
	if is_number_literal(code) or is_big_number_view(code) { return yes }
	if is_group(code) { return bracket_of(code) == "(" and #items_of(code) == 1 }
	code is symbol and binds_value(rule_scope, name_of(code)) and not starts_with_unit(code)
}
starts_with_unit(code: Node): bool := if code is key and op_of(code) in unit_binding_ops then starts_with_unit(key_of(code)) else is_unit_word(code)
# `km/h`, `m²`, `cm`: code led by a unit word, the unit part of `2 km/h is speed` (lib/units.warp)
unit_led(code: Node): bool := if code is key and op_of(code) in [Op.Div, Op.Mul, Op.Pow] then unit_led(key_of(code)) else is_unit_word(code)
# a name lib/units defines, a unit by its class (`km`, `°C`: `km = Unit("km")`), else any other of its words (`min`)
is_unit_word(code: Node): bool := code is symbol and (typed_as(name_of(code), "Unit") or "units" in defining_modules(name_of(code)))
unit_binding_ops = [Op.Assign, Op.Define, Op.Add, Op.Sub, Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.Eq, Op.Ne]
# a unit after a product, a quotient or a power reads two ways, `10 / 2 ms`: refused with a fix-it naming both
# (decision unit-after-number)
unit_ambiguous_ops = [Op.Mul, Op.Div, Op.FloorDiv, Op.Mod, Op.Pow]
unit_ambiguous(amounted: Node, unit: Node): text := "DimensionError: a unit binds only after a number: write (${as_code(amounted)}) ${unit} to measure the whole amount, or glue the unit to the number it measures"
# `km/h`, `kg·m/s^2`, `cm^2`: a unit written whole, each part a unit word, each power a number (`km/2` is no unit)
unit_written(code: Node): bool := {
	if code is key and op_of(code) == Op.Pow { return unit_written(key_of(code)) and is_number_literal(value_of(code)) }
	if code is key and op_of(code) in [Op.Div, Op.Mul] { return unit_written(key_of(code)) and unit_written(value_of(code)) }
	is_unit_word(code)
}
# `km/h`, `m^2`: the text of a unit written whole of several parts, "km/h", as lib/units unit_named reads it; ø for a
# single unit word or any other code
compound_unit(code: Node): any := if code is key and unit_written(code) then "${code}".replace(" ", "") else ø
# `km/h`, `kg·m/s^2`: the unit word leading a unit written of several parts, ø for other code
# `area possibly`: the code a word qualifies, as the two words read as one group within an expression; ø for other code
qualified(code: Node, word: Node): any := if is_group(code) and bracket_of(code) == "" and #code == 2 and code#2 == word then code#1 else ø
leading_unit(code: Node): any := if code is key and op_of(code) in [Op.Div, Op.Mul, Op.Pow] then leading_unit(key_of(code)) else if code is symbol then code else ø
# `q as km`, `(q as km) / h`: the unit word converted to at the bottom of the code's left operands, ø without one
converted_unit(code: Node): any := {
	if is_key(code, Op.As) { return if value_of(code) is symbol then value_of(code) else ø }
	if code is key and op_of(code) in [Op.Div, Op.Mul, Op.Pow] then converted_unit(key_of(code)) else ø
}
# `q as km/h`, which binds as (q as km) / h: the conversion to the compound unit, q as (km/h); ø when the code is no
# conversion followed by the rest of a unit written whole (`in` binds looser than / and needs none)
unit_regrouped(code: Node): any := {
	if not (code is key and op_of(code) in [Op.Div, Op.Mul, Op.Pow]) { return ø }
	left = key_of(code)
	conversion = if is_key(left, Op.As) then left else unit_regrouped(left)
	if conversion == ø { return ø }
	unit = Key(value_of(conversion), op_of(code), value_of(code))
	if unit_written(unit) then Key(key_of(conversion), Op.As, unit) else ø
}

# --- server routes (lib/web.warp's rules, card sample-gaps-server; Rust twin lowering/web/serve.rs route_entry) ---

# `get` → "GET": a route's method as HTTP spells it
route_verb(method: Node): text := "${method}".upper()
# each `:name` of a route's path a variable of its body, its segment of the request's path (an int where it is digits):
# `n = route_parameter("/fib/:n:int", request.path, "n")`
route_bindings(path: Node): list := path_parameters(path).map(name => Key(symbol(name), Op.Assign, List([symbol("route_parameter"), path, Key(symbol("request"), Op.Dot, symbol("path")), name], Bracket.Round, Separator.None)))
# a program with routes, ending in serving them (lib/web.warp routes_end) once all of it ran; ø for a program without
# routes or served already. `warp build` ends them otherwise (extensions/commands/build.warp, decision
# build-kinds-detected): an executable serving them always (routes_served), a WAGI module answering one request
# (lib/wagi.warp routes_wagi); routes_seen says it found routes
global routes_end_word = "routes_end"
global routes_seen = no
served(program: Node): any := {
	ended = ended_by(program, "route_add", routes_end_word)
	if ended != ø { routes_seen = yes }
	ended
}
# a program with frame listeners, ending in its frames (lib/frames.warp frames_end): one, as no window opens
frames_end_word = "frames_end"
framed(program: Node): any := ended_by(program, "frame_listened", frames_end_word)
exited(program: Node): any := ended_by(program, "exit_listened", "exits_end")
# a program that starts tasks anywhere (`job = go f(x)` too), ending in running them all and awaiting a task it ends
# with (lib/tasks.warp tasks_end)
tasked(program: Node): any := ending_appended(program, mentions(program, "task_go"), "tasks_end")

# --- cooperative tasks (lib/tasks.warp, decision N29) ---

# a task's block split at its own sleeps: `a; sleep t; b` as `a; task_sleep(t, () => { b })`, the rest of the block
# the next step, which the scheduler runs once the task slept; a block without one as it is
task_steps(block: Node): Node := {
	statements = (if is_curly_group(block) then items_of(block) else [block]).flat_map(flat_statements)
	at = (1 to #statements).filter(i => sleep_of(statements#i) != ø)
	if #at == 0 { return block }
	rest = List(statements[at#1 ..], Bracket.Curly, Separator.Semicolon)
	pause = call_of("task_sleep", [call_of("sleep_ms_of", [sleep_of(statements#(at#1))]), Key(List([], Bracket.Round, Separator.Comma), Op.Arrow, task_steps(rest))])
	List(statements[.. at#1 - 1] + [pause], Bracket.Curly, Separator.Semicolon)
}
# `await a + await b`: an await takes the operand before an operator, as a prefix does, not the whole expression
awaited_operand(x: Node): Node := if x is key and op_of(x) in awaited_ops then Key(awaited_operand(key_of(x)), op_of(x), value_of(x)) else call_of("task_awaited", [x])
awaited_ops = [Op.Add, Op.Sub, Op.Mul, Op.Div, Op.FloorDiv, Op.Mod, Op.Pow, Op.Lt, Op.Gt, Op.Le, Op.Ge, Op.Eq, Op.Ne, Op.And, Op.Or, Op.Xor, Op.Coalesce]
# the amount of a statement `sleep(t)` or `sleep t`, else ø
sleep_of(statement: Node): any := if is_call_named(statement, "sleep") and #statement == 2 then statement#2 else if is_group(statement) and bracket_of(statement) == "" and #statement == 2 and statement#1 == symbol("sleep") then statement#2 else ø
# `ticks` after `on every 1 second { ticks += 1 }`: a program that listens (a timer, an event, a variable's listener)
# defines page_value(), its last expression again, which the page shows anew after each firing
# (web/playground/driver.js); ø for any other program, one ending in a declaration or a listener, or one that has it
page_value_word = "page_value"
# (`on message from "chat" {…}` is lib/channels.warp's message_listened by the time this reads it)
listening_words = ["timer_every", "timer_at", "listen", "variable_listen", "frame_listened", "message_listened", "exits_end", frames_end_word]
event_heads = [symbol("on"), symbol("once")]
# a test check (extensions/rules/modules/laws.warp) and the tests' summary run where they stand: no value to read again
is_test_line(statement: Node): bool := is_call_named(statement, test_check_word) or is_call_named(statement, tests_end_word)
# `test C` as lib/laws.warp's call: C as written, the rest of the line after the word `test`, as it reads when made
test_check_word = "test_check"
written_after(word: Node, code: Node, source: text): Node := Text(line_after(word, source) ?? "${code}".trim())
# C of several items, `test switch 3 {…} == "three"`, parsed again from its line as one expression
condition_after(word: Node, code: Node, source: text): Node := {
	written = line_after(word, source)
	if written == ø then code else statements_in(plain_node(parsed(written)))#1
}
line_after(word: Node, source: text): text? := {
	lines = source.split("\n")
	if not is_positioned(word) or line_of(word) > #lines { return ø }
	statement_start((lines#line_of(word))[column_of(word) - 1 + #name_of(word) ..]).trim()
}
opening_brackets = ['(', '[', '{']
closing_brackets = [')', ']', '}']
# the written text up to its statement's end, a `;` outside brackets and texts: `x == 4` of `x == 4; x * 2`
statement_start(written: text): text := {
	depth = 0
	quote = ø
	at = 0
	for c in written {
		if quote != ø { if c == quote { quote = ø } } else if c == '"' or c == '\'' { quote = c } else if c in opening_brackets { depth += 1 } else if c in closing_brackets { depth -= 1 } else if c == ';' and depth == 0 { return written[0 ..< at] }
		at += 1
	}
	written
}
# a program with test checks ending in their summary (lib/laws.warp tests_end), its value kept when no test ran
tests_end_word = "tests_end"
tests_ended(program: Node): any := ending_appended(program, mentions(program, test_check_word), tests_end_word)
# the words that print (extensions/effects.warp OUTPUT_WORDS, a module the rule words do not use)
printing_heads = [symbol("print"), symbol("puts"), symbol("eprint"), symbol("say"), symbol("warn")]
page_valued(program: Node): any := {
	statements = level_statements(program)
	# (the sugar reads the program before its `on click {…}` became a listen call)
	listens = statement => nodes_in(statement).any(n => listening_words.any(word => is_call_named(n, word)) or is_group(n) and #n > 1 and n#1 in event_heads)
	# (`print "done"` as `print("done")`: a group the output word heads)
	outputs = statement => nodes_in(statement).any(n => is_group(n) and #n > 1 and n#1 in printing_heads)
	ending = (0 ..< #statements).filter(i => use_target(statements[i]) == ø)
	if #ending == 0 or not statements.any(listens) or nodes_in(program).any(n => n == symbol(page_value_word)) { return ø }
	last = statements[ending.last()]
	# (a write, `x = 3` once signaled notifies its listeners, or an output, `print "done"`, is no value to read again:
	# run again it would write or print anew)
	if is_declaration(last) or listens(last) or is_test_line(last) or nodes_in(last).any(writes) or outputs(last) { return ø }
	# (a value of any kind, as the page reads it: a text's too, never its bare bytes)
	separated(bracketed(statements + [Key(Key(call_of(page_value_word, []), Op.Colon, symbol("any")), Op.Define, last)], ""), ";")
}
# the program ended by a call of the ending word, when a statement of it calls the starting word and none calls the
# ending one yet: its last statement but a `use` (with_implicit_uses appends some) the ending's value, after it when
# that declares or is a test line, which runs where it stands
ended_by(program: Node, starting: text, ending_word: text): any := ending_appended(program, level_statements(program).any(statement => is_call_named(statement, starting)), ending_word)
ending_appended(program: Node, started: bool, ending_word: text): any := {
	statements = level_statements(program)
	if not started or statements.any(statement => is_call_named(statement, ending_word)) { return ø }
	last = (0 ..< #statements).filter(i => use_target(statements[i]) == ø).last()
	separated(bracketed(statements[0 ..< last] + ended_with(statements[last], ending_word) + statements[last + 1 ..], ""), ";")
}
# the last statement ended by the ending word; the tests' summary stays outermost, once the tasks, frames … ran
ended_with(ending: Node, ending_word: text): list := {
	if is_call_named(ending, tests_end_word) and ending_word != tests_end_word { return [call_of(tests_end_word, ended_with(if #ending == 2 then ending#2 else Node.Empty, ending_word))] }
	if ending == Node.Empty then [call_of(ending_word, [])] else if is_declaration(ending) or is_test_line(ending) then [ending, call_of(ending_word, [])] else [call_of(ending_word, [ending])]
}
# the main level's statements, of lines and of `;` within a line alike
level_statements(program: Node): list := statements_in(program).flat_map(s => if is_statement_sequence(s) then level_statements(s) else [s])
# (its own name: the rule words share the compiler's one namespace, where core/passes/lambdas.warp's is_call_of(n, name:
# Node) also takes a text, and which of the two a call reached changed with a seed: card main-landing-regression)
is_call_named(n: Node, word: text): bool := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 == symbol(word)

# --- stored tables (lib/storage.warp's program rule, card storage-table-writes) ---

# the program with each class a stored table holds given a row id, `id: int`, each add and remove of the table's list
# kept in its table and each write of such a class's field kept in its row: `bo.age += 1` as
# `stored_written(bo, bo.age += 1)`; ø for a program storing no table. `stored people: [Person]` has become
# `people = stored_table("people", Person)` by then
tables_kept(program: Node): any := {
	statements = level_statements(program)
	tables = {}
	for statement in statements { for table in stored_table_of(statement) { tables[table#1] = table } }
	if #tables == 0 { return ø }
	classes = tables.keys.map(name => tables[name]#3)
	kept_classes = statements.filter(statement => declared_class_name(statement) in classes)
	fields = kept_classes.flat_map(declared_field_names)
	table_of = {}
	for name in tables.keys { table_of[tables[name]#3] = tables[name]#2 }
	relations = kept_classes.flat_map(statement => relations_of(statement, table_of, kept_classes))
	back_fields = relations.filter(relation => name_of(relation#1) == "stored_back").map(relation => view_of(relation#3)#2)
	kept = statements.map(statement => if statement in kept_classes then with_row_id(statement) else bottom_up(statement, part => table_kept(part, tables, fields, back_fields)))
	first_table = (1 to #kept).filter(i => stored_table_of(kept#i) != [])#1
	separated(bracketed(kept[0 ..< first_table - 1] + relations + kept[first_table - 1 ..], ""), ";")
}
# the relations of a kept class's fields to the kept classes, registered before the first table is read: a field typed
# with one, `team: Team?`, a foreign key, `stored_key("people", "team", "teams", Team)`; a list of one, `players: [Person]`,
# the rows of it whose foreign key is the row, `stored_back("teams", "players", "people", Person, "team")`
relations_of(statement: Node, table_of: map, classes: list): list := {
	own = declared_class_name(statement)
	related = []
	for member in class_fields(statement) {
		[other, many] = related_class(member)
		if table_of.has(other) {
			heads = [Text(table_of[own]), Text(field_name(member)), Text(table_of[other]), symbol(other)]
			if not many { related += [call_of("stored_key", heads)] }
			key = if many then foreign_key_to(own, other, classes) else ""
			if key != "" { related += [call_of("stored_back", heads + [Text(key)])] }
		}
	}
	related
}
class_fields(statement: Node): list := class_view(statement)#3[3..].map(member_read).filter(member => defined_word(member) == ø)
# [the class a field is typed with, whether a list of it]: `team: Team?` ["Team", no], `players: [Person]` ["Person", yes]
related_class(member: Node): list := {
	if not is_key(member, Op.Colon) { return ["", no] }
	written = if is_key(value_of(member), Op.Assign) then key_of(value_of(member)) else value_of(member)
	many = is_group(written) and bracket_of(written) == "[" and #written == 1
	named = if many then written#1 else written
	name = if named is symbol then name_of(named) else annotated_type_name(named) ?? ""
	[if name.ends_with("?") then name[0 ..< #name - 1] else name, many]
}
# the field of the class `other` that is a foreign key to the class `own`, "" for none (of the kept classes)
foreign_key_to(own: text, other: text, classes: list): text := {
	for statement in classes.filter(statement => declared_class_name(statement) == other) {
		for member in class_fields(statement) { if related_class(member) == [own, no] { return field_name(member) } }
	}
	""
}
ROW_ID = "id"
# [list name, table name, class name] of `people = stored_table("people", Person)`, else none
stored_table_of(statement: Node): list := {
	if not is_key(statement, Op.Assign) or not (key_of(statement) is symbol) or not is_call_named(value_of(statement), "stored_table") { return [] }
	call = value_of(statement)
	[[name_of(key_of(statement)), call#2, "${call#3}"]]
}
declared_class_name(statement: Node): text := {
	view = class_view(statement)
	if view == ø then "" else declared_type_name(view#2) ?? ""
}
# the class with an `id: int` field, unless it has one
with_row_id(statement: Node): Node := {
	if ROW_ID in declared_field_names(statement) { return statement }
	view = class_view(statement)
	opaque([view#1, view#2, view#3 + [view_of(plain_node(parsed(ROW_ID + ": int")))]] + view[3 ..])
}
# a table's add and remove kept in its table, a write of a kept class's field in its row, a read of a list of rows
# pointing back (`climbers.players`) their query and an add to it the foreign key written; any other node as it is
table_kept(n: Node, tables: map, fields: list, back_fields: list): Node := {
	if writes(n) and is_key(key_of(n), Op.Dot) and value_of(key_of(n)) is symbol and name_of(value_of(key_of(n))) in fields {
		return call_of("stored_written", [key_of(key_of(n)), n])
	}
	if is_key(n, Op.Dot) and value_of(n) is symbol and name_of(value_of(n)) in back_fields { return call_of("stored_rows_of", [key_of(n), Text(name_of(value_of(n)))]) }
	if is_key(n, Op.Dot) and is_call_named(key_of(n), "stored_rows_of") and is_call_named(value_of(n), "add") and #value_of(n) == 2 {
		return call_of("stored_joined", items_of(key_of(n))[1..] + [value_of(n)#2])
	}
	if not is_key(n, Op.Dot) or not (key_of(n) is symbol) or not tables.has(name_of(key_of(n))) { return n }
	call = value_of(n)
	table = tables[name_of(key_of(n))]#2
	if is_call_named(call, "add") and #call == 2 { return Key(key_of(n), Op.Dot, call_of("add", [call_of("stored_add", [table, call#2])])) }
	if is_call_named(call, "remove") and #call == 2 { return Key(key_of(n), Op.Dot, call_of("remove", [call_of("stored_removed", [table, call#2])])) }
	n
}

# --- unit fields (lib/units.warp's program rule, card unit-fields) ---

# the program with each value given to a field or variable a unit word types shown in that unit: `Run(1500m)` of
# `class Run{distance: km}` as `Run(shown_in(1500m, "km"))`, `r.distance = 1500m` and `x: km = 1500m` so. shown_in
# changes only the unit a quantity of that dimension shows in, never converts another value; ø when no unit types any.
# The unit words come with the rule, as lib/units.warp lists them
units_shown(program: Node, unit_words: Node): any := {
	statements = level_statements(program)
	units = items_of(unit_words).map(name_of)
	classes = {}
	fields = {}
	for statement in statements.filter(statement => class_view(statement) != ø) {
		members = class_view(statement)#3[3..].map(member_read).filter(member => defined_word(member) == ø)
		typed = members.map(member => member_unit(member, units))
		if typed.any(unit => unit != "") { classes[declared_class_name(statement)] = typed }
		for i in 1 to count(typed) { if typed#i != "" { fields[field_name(members#i)] = typed#i } }
	}
	if #classes == 0 and not statements.any(statement => unit_typed_variable(statement, units) != "") { return ø }
	ruled = statements.map(statement => if class_view(statement) != ø then statement else bottom_up(statement, part => unit_shown(part, classes, fields, units)))
	separated(bracketed(ruled, ""), ";")
}
# a construction, a field write or a typed variable given its value shown in its unit; any other node as it is
unit_shown(n: Node, classes: map, fields: map, units: list): Node := {
	if is_group(n) and bracket_of(n) == "(" and #n > 1 and n#1 is symbol and classes.has(name_of(n#1)) {
		typed = classes[name_of(n#1)]
		return bracketed([n#1] + (2 to #n).map(i => if i - 1 <= count(typed) and typed#(i - 1) != "" then shown_in_unit(n#i, typed#(i - 1)) else n#i), "(")
	}
	if not is_key(n, Op.Assign) { return n }
	target = key_of(n)
	if is_key(target, Op.Dot) and value_of(target) is symbol and fields.has(name_of(value_of(target))) { return Key(target, Op.Assign, shown_in_unit(value_of(n), fields[name_of(value_of(target))])) }
	unit = unit_typed_variable(n, units)
	if unit != "" then Key(target, Op.Assign, shown_in_unit(value_of(n), unit)) else n
}
# the unit word a field `d: km` (or `d: km = 0km`) is declared in, else ""; an aliased unit reads back as a bodiless type
member_unit(member: Node, units: list): text := {
	if not is_key(member, Op.Colon) { return "" }
	written = if is_key(value_of(member), Op.Assign) then key_of(value_of(member)) else value_of(member)
	word = annotated_type_name(written) ?? ""
	if word in units then word else ""
}
# the unit a typed variable `x: km = …` names, else ""
unit_typed_variable(n: Node, units: list): text := {
	if not is_key(n, Op.Assign) or not is_key(key_of(n), Op.Colon) or not (value_of(key_of(n)) is symbol) { return "" }
	word = name_of(value_of(key_of(n)))
	if word in units then word else ""
}
shown_in_unit(value: Node, unit: text): Node := call_of("shown_in", [value, plain_node(parsed("\"" + unit + "\""))])

# --- variable signals (lib/signals.warp's rules, card signals-lib) ---

variable_listen_word = "variable_listen"
signal_old = "signal·old"
# `whenever x > y {…}`: a listener of each name the condition reads, running the block when the write made the
# condition hold, it holding not with the name's old value: `if value > y and not old > y {…}` for x
whenever_listens(condition: Node, body: Node): Node := condition_listens(condition, body, [])
# `once x == 5 {…}`: as whenever, the block running the first time only, its listeners sharing a flag named by the condition
once_listens(condition: Node, body: Node): Node := condition_listens(condition, body, [symbol("signal·fired " + spelled(condition))])
condition_listens(condition: Node, body: Node, flags: list): Node := {
	unfired = flags.map(flag => Key(ø, Op.Not, Key(flag, Op.Hash, 1)))
	block = if #flags == 0 then body else List(flags.map(flag => Key(Key(flag, Op.Hash, 1), Op.Assign, Node.True)) + [body], Bracket.Curly, Separator.Semicolon)
	declared = flags.map(flag => Key(flag, Op.Assign, List([Node.False], Bracket.Square, Separator.Comma)))
	if is_read_anew(condition) { return held_listens(unfired.fold(condition, (now, guard) => Key(guard, Op.And, now)), block, declared) }
	listens = symbol_words(condition).map(name => name_listener(name, became_true(unfired.fold(renamed(condition, name, symbol("value")), (now, guard) => Key(guard, Op.And, now)), renamed(condition, name, symbol("old")), block)))
	separated(bracketed(declared + listens, "("), ";")
}
# A condition reading a field, `person.age > 30`, or calling a function, `big()` reading a global x, cannot take the
# written value in place of a name: its listeners read it anew after each write and keep whether it held, the block
# running when it came to hold. The function's reads are listened to (signaled: listened_through)
is_read_anew(condition: Node): bool := nodes_in(condition).any(n => is_key(n, Op.Dot) or is_named_call(n))
is_named_call(n: Node): bool := is_group(n) and bracket_of(n) == "(" and #n > 0 and n#1 is symbol
held_listens(condition: Node, block: Node, declared: list): Node := {
	held = symbol("signal·held " + as_code(condition))
	now = symbol("signal·now")
	was = symbol("signal·was")
	held_now = Key(held, Op.Hash, 1)
	code = List([Key(now, Op.Assign, condition), Key(was, Op.Assign, held_now), Key(held_now, Op.Assign, now), became_true(now, was, block)], Bracket.Curly, Separator.Semicolon)
	start = Key(held, Op.Assign, List([condition], Bracket.Square, Separator.Comma))
	separated(bracketed(declared + [start] + symbol_words(condition).map(name => read_anew_listener(name, code)), "("), ";")
}
# a listener of each write of the name, its value read anew by the code
read_anew_listener(name: Node, code: Node): Node := call_of(variable_listen_word, [List([name], Bracket.Square, Separator.Comma), Node.False, Key(List([symbol("signal·written"), symbol("signal·before")], Bracket.Round, Separator.Comma), Op.Arrow, code)])
# a listener of the name's changes running the code, which reads the written value as `value`, the one before as `old`
name_listener(name: Node, code: Node): Node := call_of(variable_listen_word, [List([name], Bracket.Square, Separator.Comma), Node.True, Key(List([symbol("value"), symbol("old")], Bracket.Round, Separator.Comma), Op.Arrow, code)])
# `on change b + c {…}`: a listener of each name the expression reads, running the block when the write changed its value
change_listens(expression: Node, body: Node): Node := {
	if is_read_anew(expression) { return changes_read_anew(expression, body) }
	listens = symbol_words(expression).map(name => name_listener(name, Key(Key(ø, Op.If, Key(renamed(expression, name, symbol("value")), Op.Ne, renamed(expression, name, symbol("old")))), Op.Then, body)))
	separated(bracketed(listens, "("), ";")
}
# `on change p.age {…}`: the field read anew after each write of p, the block running when it differs from the last
# value read, which it reads as `old`, the new one as `value`
changes_read_anew(expression: Node, body: Node): Node := {
	last = symbol("signal·last " + as_code(expression))
	last_now = Key(last, Op.Hash, 1)
	value = symbol("value")
	old = symbol("old")
	code = List([Key(value, Op.Assign, expression), Key(old, Op.Assign, last_now), Key(last_now, Op.Assign, value), Key(Key(ø, Op.If, Key(value, Op.Ne, old)), Op.Then, body)], Bracket.Curly, Separator.Semicolon)
	start = Key(last, Op.Assign, List([expression], Bracket.Square, Separator.Comma))
	separated(bracketed([start] + symbol_words(expression).map(name => read_anew_listener(name, code)), "("), ";")
}
became_true(now: Node, before: Node, body: Node): Node := Key(Key(ø, Op.If, Key(now, Op.And, Key(ø, Op.Not, before))), Op.Then, body)
# the program with each write of a watched name notifying its listeners (signal_notify), `x = 3` as
# `(signal·old = x; x = 3; signal_notify("x", x, signal·old))`; a main statement's only once a listener of the name came
# before it (the first write declares the name), that of a definition or a listener always, as they run later. ø for a
# program without listeners
signaled(program: Node): any := {
	given = level_statements(program)
	takers = signal_list_takers(given)
	passed = if #takers == 0 then given else given.map(statement => signal_lists_passed(statement, takers))
	reads = function_reads(passed)
	statements = if #reads.keys == 0 then passed else passed.map(statement => bottom_up(statement, part => listened_through(part, reads)))
	watched = distinct(statements.flat_map(names_listened))
	if #watched == 0 { return ø }
	derived = derived_inputs(statements)
	live = []
	written = []
	for statement in statements {
		later = is_key(statement, Op.Define) or nodes_in(statement).any(is_lambda)
		names = if later then watched else live
		written += [if #names == 0 then statement else bottom_up(statement, part => notifying(part, names, derived))]
		live = distinct(live + names_listened(statement))
	}
	separated(bracketed(written, ""), ";")
}
# the program with each list it makes for the GPU (extensions/rules/gpu_packing.warp gpu_bound) made as a GPU list, else ø: a main-level assignment's
# creating form packed (same-scope flow only, decision gpu-bound-floats)
gpu_lists_packed(program: Node): any := {
	statements = level_statements(program)
	bound = statements.filter(statement => is_key(statement, Op.Assign) and gpu_bound(key_of(statement), program))
	if #bound == 0 { return ø }
	packed = statements.map(statement => if statement in bound then plain_node(parsed(as_code(key_of(statement)) + " = " + gpu_packed_code(value_of(statement), "f32"))) else statement)
	separated(bracketed(packed, ""), ";")
}
# a list made right in a GPU word's call made as a GPU list, else ø
gpu_list_made(v: Node): any := if gpu_creating(v) then gpu_packed(v) else ø
# each name once, in the order first named: two listeners of total notify its listeners once a write
distinct(names: list): list := names.fold([], (kept, name) => if name in kept then kept else kept + [name])
# the names the statement's variable_listen calls listen to
names_listened(statement: Node): list := nodes_in(statement).filter(n => is_call_named(n, variable_listen_word) and #n > 1 and is_group(n#2)).flat_map(n => items_of(n#2).filter(name => name is text).map(name => "${name}")) + nodes_in(statement).filter(n => is_call_named(n, signal_word) and #n > 1).map(n => "${n#2}")

# --- lists of signals (notes/signals.md "Lists of signals") ---

signal_word = "Signal"
# each function subscribing to the loop variable of `for s in xs {…}` over its parameter xs, by name: the positions of
# those parameters (from 1), which take a list of signals
signal_list_takers(statements: list): map := {
	takers = {}
	for statement in statements {
		name = if is_key(statement, Op.Define) then defined_word(statement) else ø
		if name != ø {
			parameters = method_parameters(statement).map(parameter_name)
			looped = signal_loops(value_of(statement)).map(loop => "${loop#4}")
			positions = (1 to #parameters).filter(at => parameters#at in looped)
			if #positions > 0 { takers[name] = positions }
		}
	}
	takers
}
# the loops `for s in xs {…}` within n whose body listens to s
signal_loops(n: Node): list := nodes_in(n).filter(is_signal_loop)
is_signal_loop(n: Node): bool := is_group(n) and #n >= 5 and n#1 == symbol("for") and n#2 is symbol and n#3 == symbol("in") and n#4 is symbol and items_of(n)[4 ..].any(part => "${n#2}" in names_listened(part))
# a taker's loop listening to its item, the item's variable (`on change s` of the Signal), a bare read of it that
# variable's value; a call of a taker with a list literal of names there passing those variables' signals; else n
signal_lists_passed(statement: Node, takers: map): Node := {
	taking = is_key(statement, Op.Define) and takers.has(defined_word(statement) ?? "")
	bottom_up(statement, part => signal_list_part(part, takers, taking))
}
signal_list_part(n: Node, takers: map, taking: bool): Node := match n {
	List(items, bracket, separator): {
		if taking and is_signal_loop(n) { return List(items[.. 4] + items[4 ..].map(part => item_listened(part, "${items#2}")), bracket, separator) }
		if not (bracket == Bracket.Round and #items > 1 and items#1 is symbol and takers.has("${items#1}")) { return n }
		positions = takers["${items#1}"]
		List([items#1] + (2 to #items).map(at => if (at - 1) in positions then signals_of(items#at) else items#at), bracket, separator)
	}
	_: n
}
# a list literal of names as their signals, `[a, b]` as `[Signal("a", a), Signal("b", b)]`; anything else as it is
signals_of(n: Node): Node := if is_group(n) and bracket_of(n) == "[" and items_of(n).all(item => item is symbol) then List(items_of(n).map(item => call_of(signal_word, ["${item}", item])), Bracket.Square, Separator.Comma) else n
# the loop's part with a bare read of the item its variable's value, and a listener of the item's name listening to
# the item, the Signal
item_listened(n: Node, item: text): Node := bottom_up(renamed(n, item, call_of("signal_value", [symbol(item)])), part => if is_call_named(part, variable_listen_word) and is_group(part#2) then listening_item(part, item) else part)
listening_item(call: Node, item: text): Node := match call {
	List(items, bracket, separator): List([items#1, List(items_of(items#2).map(name => if name is text and "${name}" == item then symbol(item) else name), Bracket.Square, Separator.Comma)] + items[2 ..], bracket, separator)
	_: call
}
# each derived value's name, `total := a * 2`, and the names it reads: a derived signal, set anew when one of them
# changes
derived_inputs(statements: list): map := {
	found = {}
	for statement in statements { if is_key(statement, Op.Define) and key_of(statement) is symbol { found[name_of(key_of(statement))] = symbol_words(value_of(statement)) } }
	closed_over(found)
}
# each name's words with those of the names among them, transitively: `quad := twice * 2; twice := a * 2` reads a
closed_over(found: map): map := {
	closed = {}
	for name in found.keys { closed[name] = words_through(name, found, [name]) }
	closed
}
words_through(name: text, found: map, seen: list): list := distinct(found[name].flat_map(word => if found.has(word) and word not in seen then [word] + words_through(word, found, seen + [word]) else [word]))
# each function the program defines, `big() := x > 3`, and the names its body reads but its parameters, through the
# functions it calls: a condition calling it listens to those (notes/signals.md "function_reads")
function_reads(statements: list): map := {
	found = {}
	for statement in statements {
		if is_key(statement, Op.Define) and not (key_of(statement) is symbol) {
			name = defined_word(statement)
			parameters = method_parameters(statement).map(parameter_name)
			if name != ø { found[name] = symbol_words(value_of(statement)).filter(word => word not in parameters) }
		}
	}
	closed_over(found)
}
# a listener of a function's name listening to the names the function reads; any other node as it is
listened_through(n: Node, reads: map): Node := {
	if not (is_call_named(n, variable_listen_word) and #n > 1 and is_group(n#2)) { return n }
	names = items_of(n#2)
	if not names.any(name => name is text and reads.has("${name}")) { return n }
	through = distinct(names.flat_map(name => if name is text and reads.has("${name}") then reads["${name}"] else ["${name}"]))
	bracketed([n#1, square_list(through.map(word => Text(word)))] + items_of(n)[2 ..], "(")
}
# the write of a watched name, notifying its listeners, and those of each watched derived value reading it once the
# write changed it: `a = 2` as `(signal·old = a; signal·total = total; a = 2; if a != signal·old {
# signal_notify("total", total, signal·total) })`; any other node as it is
notifying(n: Node, names: list, derived: map): Node := {
	if method_changing(n, names) { return method_notifying(n) }
	if not writes(n) { return n }
	name = written_target(key_of(n))
	if not (name is symbol) { return n }
	old = symbol(signal_old)
	dependents = names.filter(d => derived.has(d) and name_of(name) in derived[d])
	own = name_of(name) in names
	if not own and #dependents == 0 { return n }
	# an item's write changes the list itself: the old one a copy, `[] + xs`
	kept = if key_of(n) is symbol then name else Key(List([], Bracket.Square, Separator.Comma), Op.Add, name)
	before = [Key(old, Op.Assign, kept)] + dependents.map(d => Key(symbol(signal_old_of(d)), Op.Assign, symbol(d)))
	notified = (if own then [call_of("signal_notify", [name_of(name), name, old])] else []) + dependents.map(d => Key(Key(ø, Op.If, Key(name, Op.Ne, old)), Op.Then, call_of("signal_notify", [d, symbol(d), symbol(signal_old_of(d))])))
	# `x--` gives the value before the step
	result = if op_of(n) in stepping_ops then [old] else []
	separated(bracketed(before + [n] + notified + result, "("), ";")
}
# `x.add(2)` of a watched x: a method may change the list in place, so its listeners hear of it when it did; the
# call's value stays the value (`y = x.pop()`)
method_changing(n: Node, names: list): bool := is_key(n, Op.Dot) and key_of(n) is symbol and name_of(key_of(n)) in names and is_called_name(value_of(n))
signal_result = "signal·result"
method_notifying(n: Node): Node := {
	name = key_of(n)
	old = symbol(signal_old)
	result = symbol(signal_result)
	kept = plain_node(parsed("if " + name_of(name) + " is list then [] + " + name_of(name) + " else " + name_of(name)))
	notified = Key(Key(ø, Op.If, Key(name, Op.Ne, old)), Op.Then, call_of("signal_notify", [name_of(name), name, old]))
	separated(bracketed([Key(old, Op.Assign, kept), Key(result, Op.Assign, n), notified, result], "("), ";")
}
# a write: `x = 3`, `x += 1`, `x--`
writes(n: Node): bool := {
	if not (n is key) { return no }
	op_of(n) in writing_ops or op_of(n) in stepping_ops
}
# the variable a write changes: `x`, that of an item's `xs#1` or a field's `p.n`; else the target itself
written_target(target: Node): Node := {
	if target is key and (op_of(target) == Op.Hash or op_of(target) == Op.Dot) { return written_target(key_of(target)) }
	target
}
stepping_ops = [Op.Inc, Op.Dec]
signal_old_of(name: text): text := "signal·" + name
writing_ops = [Op.Assign, Op.AddAssign, Op.SubAssign, Op.MulAssign, Op.DivAssign, Op.FloorDivAssign, Op.ModAssign, Op.PowAssign, Op.AndAssign, Op.OrAssign, Op.XorAssign]

# `count(2 in xs)`: a yes/no question is no count, the compile refused with the count it means
counted_question(items: Node, item: Node): Node := {
	throw "count(${as_code(item)} in ${as_code(items)}) counts a yes/no question: did you mean ${as_code(items)}.count(${as_code(item)})?"
}
# `count words in t`: a function's results counted, `count words of t` (decision 4de73dde04)
counted_results(items: Node, function: Node): Node := {
	throw "count ${as_code(function)} in ${as_code(items)} counts a yes/no question: did you mean count ${as_code(function)} of ${as_code(items)}?"
}
# `end job` (decision end-refused): no default between letting a task run to its end and ending it now
end_refused(task: Node): Node := {
	throw "end ${as_code(task)}: did you mean finish ${as_code(task)} (let it run to its end) or cancel ${as_code(task)} (end it now)?"
}
# a value as code to paste: a text in its quotes, no attribute of the parser's (`float[n * m]`'s marked `+ 1` would
# read back as `view·attribute: …`)
as_code(n: Node): text := if n is text then "\"${n}\"" else "${plain_node(n)}"

# `people where age > 18` (decision P223, extensions/sugar/lists.warp): a name the program binds nothing to that a class of it
# declares as a field reads the item's field, `it.age`; a name the program binds keeps its value
bare_fields_read(condition: Node, program: Node): Node := {
	fields = statements_in(program).flat_map(s => declared_field_names(s))
	if #fields == 0 { return condition }
	bound = names_bound_in_kept(program)
	readable = fields.filter(name => not bound.has(name))
	item_field_read(condition, readable)
}
# `match c {Penny: 1; Nickel: 5}` over `enum Coin {Penny, Nickel, Dime}`: arms naming cases of one enum only, no
# default, that leave a case out are refused naming it (card pure-lane-def); ø when the match covers its enum
missed_cases(arms: Node, program: Node): any := {
	if not is_group(arms) or bracket_of(arms) != "{" { return ø }
	named = items_of(arms).map(arm_case_name)
	if #named == 0 or named.any(name => name == "") { return ø }
	owner = statements_in(program).map(declared_enum).find(found => found != ø and named.all(name => name in found#2))
	if owner == ø { return ø }
	missing = owner#2.filter(case => case not in named)
	if #missing == 0 { return ø }
	throw "match on ${owner#1} misses ${missing.join(", ")}: an arm for each, or _ => … for the rest"
}
# the case an arm `Penny: 1` or `Penny => 1` names, "" for any other arm (a default, a value, a pattern)
arm_case_name(arm: Node): text := if (is_key(arm, Op.Colon) or is_key(arm, Op.Arrow)) and key_of(arm) is symbol and not (name_of(key_of(arm)) in ["_", "default", "else"]) then name_of(key_of(arm)) else ""
# `for byte in t`: the unit the loop walks by, "bytes" for the rule's walked_by(t, "bytes"), the value's list of that
# unit when its type has one, else its own items (decision loop-variable: `for byte in bytes` of a list of bytes); ø
# for any other loop variable or a list literal
unit_lists = {byte: "bytes", char: "chars", codepoint: "codepoints", pair: "pairs"}
unit_list_word(variable: Node, iterable: Node): any := {
	if not unit_lists.has(name_of(variable)) or (is_group(iterable) and bracket_of(iterable) == "[") { return ø }
	Text(unit_lists[name_of(variable)])
}
# `when x {1 -> "a"; else -> "b"}`: a block of match arms only, each `pattern -> value`
are_arms(body: Node): bool := #items_of(body) > 0 and items_of(body).all(item => is_key(item, Op.Arrow))
# `for p in ps where it > 2`: the condition's `it` read as the loop's variable
it_read_as(condition: Node, variable: Node): Node := renamed(condition, "it", variable)
declared_field_names(statement: Node): list := {
	view = class_view(statement)
	if view == ø then [] else class_declared(statement, view).fields
}
# the code with each of the field names read from `it`; the field part of `x.f` stays as written
item_field_read(n: Node, fields: list): Node := {
	if n is symbol { return if name_of(n) in fields then Key(symbol("it"), Op.Dot, n) else n }
	if n is key { return Key(item_field_read(key_of(n), fields), op_of(n), if op_of(n) == Op.Dot then value_of(n) else item_field_read(value_of(n), fields)) }
	if is_group(n) { return placed(separated(bracketed(items_of(n).map(item => item_field_read(item, fields)), bracket_of(n)), separator_of(n)), n) }
	n
}

# --- a function's own words (extensions/sugar/reflection.warp's rules, card name-params) ---

# the program's definition of the function named, `f(a, b) := …` or `f = x => …`; ø for none
function_definition(name: Node, program: Node): any := {
	found = level_statements(program).filter(statement => defines(statement, "${name}"))
	if #found == 0 then ø else found#1
}
defines(statement: Node, name: text): bool := defined_name(statement) == name or (is_key(statement, Op.Assign) and key_of(statement) == symbol(name) and is_lambda(value_of(statement)))
# `{name: "f", code: data [definitions], values: {sun: sun, …}}`: a function of the program with what it reaches,
# quoted for a reader at run time (lib/shaders.warp, decision shaders-in-lib): its definition and those of the program
# functions it calls, transitively, and the program values they name, each read anew where the map is made; ø for a
# name the program defines no function of
definitions_reached(f: Node, program: Node): any := {
	if function_definition(f, program) == ø { return ø }
	definitions = []
	values = []
	reached = {}
	pending = [name_of(f)]
	while #pending > 0 {
		word = pending.last
		pending = pending[0 ..< #pending - 1]
		if not reached.has(word) {
			reached[word] = yes
			definition = function_definition(symbol(word), program)
			if definition != ø {
				definitions += [definition]
				pending += nodes_in(definition).filter(n => n is symbol).map(name_of)
			} else if main_level_value(word, program) != ø { values += [word] }
		}
	}
	read = if #values == 0 then Node.Empty else List(values.map(word => Key(symbol(word), Op.Colon, symbol(word))), Bracket.Curly, Separator.Comma)
	quoted = List([symbol(quote_word), List(definitions, Bracket.Square, Separator.Comma)], Bracket.None, Separator.Space)
	List([Key(symbol("name"), Op.Colon, Text(name_of(f))), Key(symbol("code"), Op.Colon, quoted), Key(symbol("values"), Op.Colon, read)], Bracket.Curly, Separator.Comma)
}
# `["a", "b"]`: the names of the function's parameters as a list; ø when the program defines no such function
parameters_named(name: Node, program: Node): any := {
	definition = function_definition(name, program)
	if definition != ø { return List(definition_parameters(definition), Bracket.Square, Separator.Comma) }
	builtin = builtin_signature(name, program)
	if builtin == ø then ø else texts_list(builtin.parameters.map(p => p.name))
}
definition_parameters(definition: Node): list := function_parameters_written(definition).map(parameter_name)
# the parameters as the definition writes them, `a: int` of `f(a: int) := …`, `x` of `f = x => …`
function_parameters_written(definition: Node): list := {
	if is_definition(definition) { return defined_parameters(definition) }
	taken = key_of(value_of(definition))
	if is_group(taken) then items_of(taken) else [taken]
}
# `(a: int, b: int) -> int`: the parameters as written, untyped ones by their name alone, and the kind its result
# has; ø when the program defines no such function or no kind is known of its result
signature_text(name: Node, program: Node): any := {
	definition = function_definition(name, program)
	if definition == ø { return builtin_shown(name, program, "") ?? foreign_shown(spelled(name)) }
	returned = function_result_kind(name, definition)
	if returned == ø { return ø }
	"(" + function_parameters_written(definition).map(parameter_shown).join(", ") + ") -> " + returned
}
# a C function or a wasm module's export the program calls, as its foreign line declares it (extensions/c_imports
# imports.warp declared_c_functions): `fib.signature` of rust_demo.wasm is "(p1: i64) -> i64"; ø for any other name
foreign_shown(name: text): any := {
	d = declared_c_functions.find(d => d#1 == name)
	if d == ø { return ø }
	types = d#3
	names = d#4
	"(" + range_list(#types).map(i => names[i] + ": " + types[i]).join(", ") + ") -> " + d#5
}
# `type(sqrt)` of a library word the program neither defines nor binds: "builtin: (x:number) -> number", its first typed
# line (`sqrt(x: number): number from warp`, lib/math.warp); ø for any other name (card function-signatures)
builtin_type(name: Node, program: Node): any := builtin_shown(name, program, "builtin: ")
builtin_shown(name: Node, program: Node, before: text): any := {
	signature = builtin_signature(name, program)
	if signature == ø { return ø }
	shown = signature.parameters.map(p => (if p.rest then p.name + "..." else p.name) + (if p.type_name == "" then "" else ":" + p.type_name) + default_shown(p))
	before + "(" + shown.join(", ") + ") -> " + (if signature.result == "" then "any" else signature.result)
}
# that first typed line's signature, ø of a word the program defines or binds or no library word
builtin_signature(name: Node, program: Node): any := {
	# an alias answers with its word's (`sorted` with sort's)
	word = unaliased(spelled(name))
	if function_definition(name, program) != ø or word in names_bound_in_kept(program) or not word_lines().has(word) { return ø }
	word_lines()[word]#1.signature
}
# `int` of `twice(x) := x*2`: the kind the analyzer infers for the function's result
return_kind(name: Node, program: Node): any := {
	definition = function_definition(name, program)
	if definition == ø then ø else function_result_kind(name, definition)
}
# `[3, 4]`, `sizes()`, `xs`: code giving a list, written out or a call or a name the analyzer infers a list for at the
# program's level, as a hole typed list would take it (decision typed-rule-holes); `[3, 4] cm` and `sizes() cm` alike
list_valued(code: Node, program: Node): bool := {
	if is_group(code) and bracket_of(code) == "[" { return yes }
	if not (code is symbol or is_call(code)) { return no }
	analyze(program)
	inferred_kind(code, scopes[""]) == ValueKind.List
}
# the kinds as data, spelled: {functions: {f: {params: [kind…], result: kind}}, variables: {x: kind}, value: kind}
kinds(program: Node): map := {
	analyze(program)
	functions = {}
	for name in defined_functions.keys() {
		scope = scopes[name]
		functions[name] = {params: taken_names(defined_signatures[name]).map(own => kind_spelling(scope.kinds[own])), result: kind_spelling(results[name])}
	}
	main = scopes[""]
	variables = {}
	for name in main.kinds.keys() { if name not in main.declared_globals { variables[name] = kind_spelling(main.kinds[name]) } }
	{functions: functions, variables: variables, value: kind_spelling(inferred_kind(program, main))}
}
function_result_kind(name: Node, definition: Node): any := {
	found = kinds(definition).functions.get("${name}")
	if found == ø then ø else found.result
}
parameter_shown(written: Node): text := {
	parameter = parameter_of(written)
	(if parameter.type_name == "" then parameter.name else parameter.name + ": " + parameter.type_name) + default_shown(parameter)
}
# ` = 1000000` of a parameter with a default (decision signature-defaults), "" of one without
default_shown(parameter: any): text := {
	given = parameter.defaulted_to
	if given == ø { return "" }
	# (a default as written is the group of its one value)
	" = " + "${if is_group(given) and #given == 1 then given#1 else given}"
}
# the code the function computes, `x*2` of `twice(x) := x*2`; ø when the program defines no such function
body_of(name: Node, program: Node): any := {
	definition = function_definition(name, program)
	if definition == ø { return ø }
	if is_definition(definition) then value_of(definition) else value_of(value_of(definition))
}
# a function's doc: its body's leading text, else the comment lines right above its definition, in the program's
# source (`$source`, which keeps what the parse drops) or the module defining it (lerp's `// the value a fraction t of
# the way from a to b`); "" without
doc_of(name: Node, program: Node, source: text): text := {
	body = body_of(name, program)
	if body != ø and is_sequence_block(body) and #body > 1 and body#1 is text { return "${body#1}" }
	word = spelled(name)
	found = comment_above(source, word)
	modules = defining_modules(word)
	for module in modules { if found == "" { found = comment_above(used_module_text(module), word) } }
	found
}
# the comment lines right above the line defining the word, without their marks; "" when none
comment_above(source: text, word: text): text := {
	comments = []
	for line in source.split("\n") {
		trimmed = line.trim()
		if defines_function(trimmed, word) { return comments.join("\n") }
		comments = if is_comment_line(trimmed) then comments + [comment_text(trimmed)] else []
	}
	""
}
defines_function(line: text, word: text): bool := ["fun ", "def "].any(keyword => line.starts_with(keyword + word + "(") or line.starts_with(keyword + word + " ")) or ((line.starts_with(word + "(") or line.starts_with(word + " ")) and (line.contains(":=") or line.contains("=>")))
comment_text(line: text): text := line[(if line.starts_with("//") then 2 else 1) ..].trim()
# `area(width: int, height: int) := width * height`: the function's definition as code to paste (decision
# reflection-definition); ø when the program defines no such function
definition_text(name: Node, program: Node, source: text): any := {
	definition = function_definition(name, program)
	if definition == ø { return ø }
	written_definition(source, spelled(name)) ?? serialize(view_of(definition))
}
# the definition as the source writes it: from its head to the end of its statement, a `;` or a line's end outside
# brackets and texts; ø when no statement of the source defines the word
written_definition(source: text, word: text): any := {
	start = definition_start(source, word)
	if start == ø { return ø }
	depth = 0
	at = start
	while at < #source and not (depth == 0 and (source[at] == ";" or source[at] == "\n")) {
		c = source[at]
		if c == "(" or c == "[" or c == "{" { depth += 1 }
		if c == ")" or c == "]" or c == "}" { depth -= 1 }
		at = if c == "\"" or c == "'" then quoted_end(source, at + 1, c, #source) else at + 1
	}
	source[start ..< at].trim()
}
# where the statement defining the word starts: at the source's start, a line's or after a `;`, its blanks skipped
definition_start(source: text, word: text): any := {
	for at in 0 ..< #source {
		if at == 0 or source[at - 1] == "\n" or source[at - 1] == ";" {
			start = at
			while start < #source and (source[start] == " " or source[start] == "\t") { start += 1 }
			if defines_function(source[start ..].split("\n")#1, word) { return start }
		}
	}
	ø
}
# `3 then twice` (decision then-not-pipe): `then` is only the branch word, the pipe is `|>`; ø after `if c`, whose
# branch may be a function (`if wanted then float_pi`)
then_not_pipe(value: Node, function: Node): Node := {
	if is_key(value, Op.If) or is_key(value, Op.While) { return ø }
	throw "`${spelled(value)} then ${spelled(function)}` is no pipe: `then` is only the branch word, pipe with `${spelled(value)} |> ${spelled(function)}`"
}
# `x > 2 then 5` (decision then-not-pipe): a branch needs its `if`, refused naming `if x > 2 then 5`; ø where `if c`
# or `while c` heads it already
then_without_if(condition: Node, value: Node): Node := {
	if is_key(condition, Op.If) or is_key(condition, Op.While) { return ø }
	throw "`${spelled(condition)} then ${spelled(value)}` has no if: write `if ${spelled(condition)} then ${spelled(value)}`"
}
# `twice.description`: a word a function has none of, the compile refused with the word it means
misnamed(function: Node, word: Node, meant: Node): Node := {
	throw "${function}.${word} is no word of a function: did you mean ${function}.${meant}?"
}

# `dir(time)`, `dir text` (card dir-ownership): the words a standard module defines, in their order, then the
# prelude's whose first parameter is of the type so named, `upper(t: text)`; ø when the program defines its own dir
# or binds the name, or no module is so named
# `help(x)` (wiki/reflection.md): a class's fields and methods, a function's signature and the doc below it, a
# module's words; ø where the program has its own help or x is none of them
class_help(name: Node, program: Node, source: text): any := {
	members = if owns_word("help", program) then ø else class_members(spelled(name), source)
	if members == ø then ø else ["class " + spelled(name), "fields: " + members#1.join(" "), "methods: " + members#2.join(" ")].join("\n")
}
# [fields, methods] of the class as written, ø when the program declares none of that name: the class methods pass
# has lifted its methods out of the program's view by now
class_members(class_name: text, source: text): any := {
	statement = declared_class(class_name, plain_node(parsed(source)))
	if statement == ø { return ø }
	view = class_view(statement)
	# a method by the name it is written with, `length` (read, it is its alias's word, count)
	methods = view#3[3 ..].map(member => defined_word(node_of(member)) ?? defined_word(member_read(member))).filter(word => word != ø)
	[class_declared(statement, view).fields, methods]
}
# `fields(B)`, `methods(B)` of a class the program declares (wiki/reflection.md, card eval-inherited-methods): the
# names of its fields and those of the classes it extends; its methods as function values, the methods of those
# classes and every function whose first parameter is typed with one of them (`def x(a: A)` of B extends A). ø where
# the program has its own word or declares no class of that name
class_fields_listed(name: Node, program: Node, source: text): any := {
	lineage = written_lineage(name, source)
	if owns_word("fields", program) or #lineage == 0 { return ø }
	texts_list(lineage.reverse().flat_map(owner => (class_members(owner, source) ?? [[], []])#1.map(field => "${field}")))
}
class_methods_listed(name: Node, program: Node, source: text): any := {
	lineage = written_lineage(name, source)
	if owns_word("methods", program) or #lineage == 0 { return ø }
	own = lineage.flat_map(owner => (class_members(owner, source) ?? [[], []])#2)
	outside = first_parameter_types.keys.filter(function => lineage.contains(first_parameter_types[function]) and not own.contains(function))
	List((own + outside).map(symbol), Bracket.Square, Separator.Comma)
}
# `functions()` (card functions-list, user 2026-10-15): the program's own functions as function values, in their
# order, as written (the program holds the library words it reached by now), a list to filter
# (`functions().filter(f => f.name.starts_with("test_"))`); ø where it has its own word. A function taking nothing is
# `function f`, as its bare name calls it
program_functions(program: Node, source: text): any := {
	if owns_word("functions", program) { return ø }
	statements = level_statements(plain_node(parsed(source)))
	names = distinct(statements.map(defined_function).filter(name => name != ø))
	taking_nothing = statements.filter(statement => defined_function(statement) != ø and #listed_function_head(statement) == 1).map(defined_function)
	if #names == 0 { return List([], Bracket.Square, Separator.Comma) }
	plain_node(parsed("[" + names.map(name => if taking_nothing.contains(name) then "function " + name else name).join(", ") + "]"))
}
# the function a statement defines with parameters, `f(x) := …` or `f(x): T := …`, else ø
defined_function(statement: Node): text? := {
	if not is_key(statement, Op.Define) { return ø }
	head = listed_function_head(statement)
	if is_called_name(head) then name_of(head#1) else ø
}
listed_function_head(definition: Node): Node := if is_key(key_of(definition), Op.Colon) then key_of(key_of(definition)) else key_of(definition)
# the class of that name and the classes it extends, nearest first; [] when the program (as written: the class methods
# pass may have lifted its classes by now) declares none
written_lineage(name: Node, source: text): list := class_lineage(spelled(name), plain_node(parsed(source)))
class_lineage(name: text, program: Node): list := {
	statement = declared_class(name, program)
	if statement == ø { return [] }
	parent = class_declared(statement, class_view(statement)).parent
	[name] + (if parent == "" then [] else class_lineage(parent, program))
}
# the classes the program declares, `Point` of a line `class Point {`
class_names(source: text): list := source.split("\n").flat_map(line => line.split(";")).map(statement => statement.trim()).filter(line => line.starts_with("class ")).map(line => line[6 ..].split(" ")#1.split("{")#1.trim())
# `p.fields`, `p.methods`, `dir(p)` (wiki/reflection.md): the names of the members of the class p is made of everywhere the
# program assigns it, `p = Point(3, 4)`; ø when it is not so known or the class has a member of that name itself
# (then `p.fields` is that member, as a map's `m.fields` its key)
instance_members(variable: Node, part: Node, source: text): any := {
	made = class_made_as(spelled(variable), source)
	members = if made == ø then ø else class_members(made, source)
	if members == ø or spelled(part) in members#1 + members#2 { return ø }
	fields = members#1.map(field => "${field}")
	texts_list(if spelled(part) == "fields" then fields else if spelled(part) == "methods" then members#2 else fields + members#2)
}
# the names as a list of texts, parsed: a one-letter name in List(…) would be a character, and the compiler compiling
# itself has no node constructors
texts_list(names: list): Node := plain_node(parsed("[" + names.map(name => "\"" + name + "\"").join(", ") + "]"))
# the class every assignment of the variable makes, `Point` of `p = Point(3, 4)`; ø when one makes something else
class_made_as(variable: text, source: text): any := {
	classes = class_names(source)
	made = source.split("\n").flat_map(line => line.split(";")).map(statement => statement.trim()).filter(line => line.starts_with(variable + " = ")).map(line => line[#variable + 3 ..].split("(")#1.trim())
	if #made > 0 and made.all(name => name == made#1 and name in classes) then made#1 else ø
}
# `area.full`: what printing area shows, its doc as comment lines above its definition as written
full_definition(name: Node, program: Node, source: text): any := {
	definition = definition_text(name, program, source)
	if definition == ø { return ø }
	doc = doc_of(name, program, source)
	if doc == "" then definition else doc.split("\n").map(line => "# " + line).join("\n") + "\n" + definition
}
function_help(name: Node, program: Node, source: text): any := {
	# a used module's word, not the program's: its head and comment as the module writes them (module_word_help)
	if definition_start(source, spelled(name)) == ø and used_word_help(spelled(name), source) != ø { return ø }
	signature = if owns_word("help", program) then ø else signature_text(name, program)
	if signature == ø { return ø }
	doc = doc_of(name, program, source)
	spelled(name) + signature + (if doc == "" then "" else "\n" + doc)
}
module_help(name: Node, program: Node): any := {
	words = if owns_word("help", program) then ø else dir_words(name, program)
	if words == ø then ø else "module " + spelled(name) + ": " + items_of(words).map(word => "${word}").join(" ")
}
# `help(lowpass)` of a used module's word: each of its definitions' heads as the module writes them, then the comment
# above the first (wiki/reflection.md "Modules"); ø when the program has its own help or no used module defines it
module_word_help(name: Node, program: Node, source: text): any := if owns_word("help", program) then ø else used_word_help(spelled(name), source)
# `help(draw.save)`: the word's help as the module the program uses through that name writes it, else ø
qualified_word_help(module: Node, word: Node, program: Node): any := if owns_word("help", program) or not qualifies_by_module(spelled(module), program) then ø else word_help_in(used_module_text(spelled(module).lower()), spelled(word))
used_word_help(word: text, source: text): any := {
	for module in used_modules(source) {
		help = word_help_in(used_module_text(module), word)
		if help != ø { return help }
	}
	ø
}
word_help_in(module_text: text, word: text): any := {
	heads = definition_slices(module_text).filter(cut => cut#1 == word).map(cut => written_head(cut#2))
	if #heads == 0 { return ø }
	doc = comment_above(module_text, word)
	heads.join("\n") + (if doc == "" then "" else "\n" + doc)
}
# `midi(pitch)` of `midi(pitch) := …`: a definition's first line up to its `:=`
written_head(definition: text): text := definition.split("\n")#1.split(":=")#1.trim()
# `help(trick)` of a value only the run knows (the prelude's looked_up_word): [names, helps] of the program's classes and
# functions and its used modules' words, the help of a text naming one or of an instance of a class; ø when the
# program has its own help
value_helps(program: Node, source: text): any := {
	if owns_word("help", program) { return ø }
	helps = {}
	for word in definition_slices(source).map(cut => cut#1) { helps[word] = function_help(symbol(word), program, source) ?? word_help_in(source, word) }
	for named in class_names(source) { helps[named] = class_help(symbol(named), program, source) }
	for module in used_modules(source) {
		module_text = used_module_text(module)
		for word in definition_slices(module_text).map(cut => cut#1).filter(is_listed_word) { if not helps.has(word) { helps[word] = word_help_in(module_text, word) } }
	}
	named = helps.keys.filter(word => helps[word] != ø)
	List([List(named, Bracket.Square, Separator.Comma), List(named.map(word => helps[word]), Bracket.Square, Separator.Comma)], Bracket.Square, Separator.Comma)
}
# `function(trick).definition` of a name only the run knows: [names, definitions] of the program's words and its used
# modules', each definition as its source writes it, to its `;` or line's end (all of a word's, one a line)
value_definitions(program: Node, source: text): any := {
	definitions = {}
	for text in [source] + used_modules(source).map(used_module_text) {
		found = {}
		for cut in definition_slices(text).filter(cut => is_listed_word(cut#1) and not definitions.has(cut#1)) { found[cut#1] = (found.get(cut#1) ?? []) + [written_definition(cut#2, cut#1) ?? cut#2.trim()] }
		for word in found.keys { definitions[word] = found[word].join("\n") }
	}
	named = definitions.keys
	List([List(named, Bracket.Square, Separator.Comma), List(named.map(word => definitions[word]), Bracket.Square, Separator.Comma)], Bracket.Square, Separator.Comma)
}
dir_words(name: Node, program: Node): any := if owns_dir(program) or "${name}" in names_bound_in_kept(program) then ø else module_dir("${name}")
owns_dir(program: Node): bool := owns_word("dir", program)
owns_word(word: text, program: Node): bool := function_definition(symbol(word), program) != ø
module_dir(word: text): any := {
	source = used_module_text(word)
	if source == "" { return ø }
	listed = {}
	for name in definition_slices(source).map(cut => cut#1) + typed_words(word) { if is_listed_word(name) { listed[name] = yes } }
	# sorted, so an edit of the module leaves the order of its other words as it was (decision core-dir-order)
	List(listed.keys.sort(), Bracket.Square, Separator.Comma)
}
# the prelude's words whose first parameter is of the type: its declarations, `upper(t: text): text from warp`
# (word_lines), and its definitions, `pad_left(t: text, width) := …`
typed_words(kind: text): list := {
	declared = word_lines()
	found = declared.keys.filter(name => declared[name].any(line => #line.signature.parameters > 0 and line.signature.parameters#1.type_name == kind))
	found + definition_slices(prelude_text).filter(cut => kind in type_alternatives(first_parameter_type(cut#1, cut#2))).map(cut => cut#1)
}
# `list or number` of `sum(xs: list or number)`: each type a parameter takes, so a list's words include sum
type_alternatives(written: text): list := written.split(" or ").map(part => part.trim())
# a module's word dir lists: a function or value, never a class (`Cursor`) or an operator's function
is_listed_word(word: text): bool := not is_capitalized(word) and word.chars().all(c => is_name_char(c))

# The views of a module's words (card dir-filters): `time.functions`, `time.attributes` (its values, `day_seconds`),
# `time.classes` and `list.operators`, the operators it declares (`∪` of `infix operator ∪(a, b) := …`), which dir
# leaves out; ø of a name the program binds, of a view the module or program defines itself, and of no module
module_view(name: Node, view: Node, program: Node): any := {
	kind = spelled(view)
	if owns_word(kind, program) or "${name}" in names_bound_in_kept(program) { return ø }
	source = used_module_text("${name}")
	if source == "" { return ø }
	listed = {}
	if kind == "classes" { for class_name in class_names(source) { listed[class_name] = yes } }
	if kind == "operators" { for glyph in declared_operator_glyphs(source) { listed[glyph] = yes } }
	# a type's words of the prelude, as dir lists them (`upper` of text)
	if kind == "functions" { for word in typed_words("${name}") { if is_listed_word(word) { listed[word] = yes } } }
	for cut in definition_slices(source) {
		if cut#1 == kind { return ø }
		if viewed_word(kind, cut#1, cut#2) { listed[cut#1] = yes }
	}
	List(listed.keys, Bracket.Square, Separator.Comma)
}
viewed_word(kind: text, word: text, definition: text): bool := {
	if kind == "classes" or kind == "operators" or not is_listed_word(word) { return no }
	value = defines_value(word, definition)
	if kind == "attributes" then value else not value
}
# `∪` of a line `infix operator ∪(a, b) := …`, and of prefix, suffix and postfix operators, each declared operator once
declared_operator_glyphs(source: text): list := {
	glyphs = []
	for line in source.split("\n") {
		for head in ["infix operator ", "prefix operator ", "suffix operator ", "postfix operator "] {
			if line.starts_with(head) and line.contains(":=") {
				glyph = line[#head ..].split("(")#1.trim()
				if #glyph > 0 and not glyph.contains(" ") and not (glyph in glyphs) { glyphs += [glyph] }
			}
		}
	}
	glyphs
}
# `day_seconds = 86400`: a definition of a value, not a function
defines_value(word: text, definition: text): bool := {
	after = definition[#word ..].trim()
	after.starts_with("=") and not after.starts_with("==") and not after.starts_with("=>")
}
# `text` of `upper(t: text): text from warp`, "" of an untyped first parameter
first_parameter_type(word: text, definition: text): text := {
	if not definition.starts_with(word + "(") { return "" }
	first = definition[#word + 1 ..].split(")")#1.split(",")#1
	if first.contains(":") then first.split(":")#2.trim() else ""
}
# `dir(v)` of a value only the run knows: the words of a list, a text and a map, the prelude's dir_of_value's arguments
# after v
value_dir_words(program: Node): any := if owns_dir(program) then ø else List(["list", "text", "map"].map(module_dir), Bracket.Square, Separator.Comma)

# whether a fixed-width int variable is an int holding its cast value (extensions/sugar/calls.warp): in a GC program;
# @primitive code, lowered with the primitive prelude (extensions/primitive.warp), emits the width itself, `start: u32 = …`
# a wasm i32
widened_to_int(width: Node): bool := used_prelude != PRIMITIVE_PRELUDE

# `math` of `math.gcd(4, 6)`, else ø (prelude_words.warp qualifies_by_module)
module_named(module: Node, program: Node): any := if qualifies_by_module("${module}", program) then module else ø

# the iteration words a trailing block is the function of (extensions/sugar/calls.warp): `xs.map { $0 * 10 }`
trailing_block_words = ["map", "filter", "each", "for_each", "find", "any", "all", "reduce", "fold", "sorted"]
takes_trailing_block(word: Node): bool := "${word}" in trailing_block_words

# `let n = 5` is the assignment `n = 5`, where its name was written noted (core/passes/lambdas.warp
# local_declarations): inside a lambda the name stays the lambda's own, not the scope's (card let-inside)
declared_local(declaration: Node): Node := {
	if is_key(declaration, Op.Assign) and key_of(declaration) is symbol { declared_at(key_of(declaration)) }
	declaration
}

# `on change online {…}` (lib/signals.warp): the word when it is one without arguments the prelude or a used module
# defines, `online() := …`, and the program neither defines nor binds it; ø otherwise (a variable's `on change x`)
polled_word(name: Node, program: Node, source: text): any := {
	word = spelled(name)
	if word in names_bound_in_kept(program) or definition_start(source, word) != ø { return ø }
	texts = [prelude_text] + used_modules(source).map(used_module_text)
	if texts.any(text => definition_slices(text).any(cut => cut#1 == word and cut#2.starts_with(word + "()"))) then name else ø
}


# words that take an `it` block / bare `it` expression as their function argument
# (card map-argument-forms). Listed once; sugar uses `it_taking($w)` (rule-word call,
# same pattern as `are_arms($body)`). `$w is it_taking` would need core code_properties.
it_taking_words = ["map", "filter", "find", "any", "all", "each"]
it_taking(w: Node): bool := w is symbol and name_of(w) in it_taking_words

# `xs.map(it * 2)`, `apply(it + 3, 1)` (notes/welcoming.md, card map-argument-forms): an expression that
# mentions `it` and is not already a lambda/function becomes `it => expression`; ø otherwise so the rule misses
it_as_lambda(expression: Node): any := {
	if is_lambda(expression) { return ø }
	if is_group(expression) and bracket_of(expression) == "(" and #expression == 1 and is_lambda(expression#1) { return ø }
	if expression is symbol { return ø }
	if not mentions(expression, "it") { return ø }
	Key(symbol("it"), Op.Arrow, expression)
}

# the words by name, as a rule's `where` calls them: one a line, sorted, so branches adding words merge cleanly

# whether a name is assigned only text literals in the program (card text-element-assign; same idea as
# extensions/text_lints.warp is_evident_text). yes when so, else ø, so a sugar `where` can bind it
evident_text(name: Node, program: Node): any := {
	if not (name is symbol) { return ø }
	given = assigned_values(program, name_of(name))
	if #given > 0 and given.all(value => value is text) then yes else ø
}

