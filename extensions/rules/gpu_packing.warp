# Packing a list the program makes for the GPU at compile time (extensions/rules/modules/prelude.warp's gpu rules call
# these through extensions/rules/rule_words.warp)
use rule_words

# --- GPU lists (decision gpu-bound-floats; extensions/gpu_lists/runtime.warp): a list the program makes for the GPU is
# packed as f32 cells from its creation, which the GPU's library reads and writes where they are. lib/prelude.warp's
# rule packs the creating forms of the program's (extensions/rules/rule_words.warp gpu_lists_packed), `xs: [f32] = …` asks for one outright
GPU_LIST_WORDS = ["gpu_compute", "paint", "gpu_render"]
# the GPU words that write the lists they are given: the program reads back what the GPU made, f32 already
GPU_WRITING_WORDS = ["gpu_compute"]
# the names found once a program: name → [GPU uses, assignments, other mentions, its creating form or ø, growths,
# item reads, GPU writes, the values its growths add]; and the program's functions that hand a parameter to the GPU
# alone: name → those parameters' places among the arguments
class GpuLists { program: Node; uses: map; takers: map }
gpu_lists = GpuLists(Node.Empty, {}, {})
# whether xs is made for the GPU (a GPU word takes it: gpu_compute's arrays, itself or a map's value), made once by a
# form gpu_packed packs and else only grown, `xs = xs + more`, and mentioned otherwise only as a GPU list serves it:
# #xs, xs#i, xs#i = v, for x in xs, print xs. Its items read by the program (xs#i, for, print) would be rounded to f32,
# so only a list a GPU word writes is read so (decision gpu-bound-floats: nothing else sees a rounded value)
gpu_bound(xs: Node, program: Node): bool := {
	if not (xs is symbol) { return no }
	if not same(program, gpu_lists.program) {
		gpu_lists.program = program
		gpu_lists.takers = gpu_takers(program)
		gpu_lists.uses = {}
		gpu_uses_counted(program)
	}
	uses = gpu_lists.uses.get(name_of(xs))
	uses != ø and uses#1 > 0 and uses#2 == 1 + uses#5 and uses#3 == 0 and uses#4 != ø and (uses#6 == 0 or uses#7 > 0)
}
gpu_no_uses(): list := [0, 0, 0, ø, 0, 0, 0, []]
gpu_use_added(name: text, at: int) := {
	uses = gpu_lists.uses.get(name) ?? gpu_no_uses()
	uses[at] = uses[at] + 1
	gpu_lists.uses[name] = uses
}
gpu_uses_counted(n: Node) := {
	if n is symbol { return gpu_use_added(name_of(n), 2) }
	if is_key(n, Op.Assign) and key_of(n) is symbol and is_key(value_of(n), Op.Add) and key_of(value_of(n)) is symbol and name_of(key_of(value_of(n))) == name_of(key_of(n)) {
		gpu_use_added(name_of(key_of(n)), 1)
		gpu_use_added(name_of(key_of(n)), 4)
		grown = gpu_lists.uses[name_of(key_of(n))]
		grown[7] = grown[7] + [value_of(value_of(n))]
		gpu_lists.uses[name_of(key_of(n))] = grown
		return gpu_uses_counted(value_of(value_of(n)))
	}
	if is_key(n, Op.Assign) and key_of(n) is symbol {
		gpu_use_added(name_of(key_of(n)), 1)
		uses = gpu_lists.uses[name_of(key_of(n))]
		uses[3] = if gpu_made_parts(value_of(n)).any(gpu_creating) then value_of(n) else ø
		gpu_lists.uses[name_of(key_of(n))] = uses
		return gpu_uses_counted(value_of(n))
	}
	# xs#i, #xs, xs#i = v
	if is_key(n, Op.Hash) and key_of(n) == ø { return ø }
	if is_key(n, Op.Hash) and key_of(n) is symbol {
		gpu_use_added(name_of(key_of(n)), 5)
		return gpu_uses_counted(value_of(n))
	}
	if is_key(n, Op.Assign) and is_key(key_of(n), Op.Hash) and key_of(key_of(n)) is symbol { return gpu_uses_both(value_of(key_of(n)), value_of(n)) }
	if is_key(n, Op.Define) and not (key_of(n) is symbol) { return gpu_definition_counted(n) }
	if not is_group(n) {
		for part in parts_of(n) { gpu_uses_counted(part) }
		return ø
	}
	items = items_of(n)
	head = if #items > 0 and items#1 is symbol then name_of(items#1) else ""
	if head == "print" and #items == 2 and items#2 is symbol { return gpu_use_added(name_of(items#2), 5) }
	# count(xs) as #xs
	if head == "count" and #items == 2 and items#2 is symbol { return ø }
	if head == "for" and #items == 5 and items#4 is symbol {
		gpu_use_added(name_of(items#4), 5)
		return gpu_uses_counted(items#5)
	}
	# a GPU word's first argument is its shader, or paint's pixels, which the CPU reads: its other arguments are the GPU's
	if head in GPU_LIST_WORDS {
		if #items > 1 { gpu_uses_counted(items#2) }
		for argument in items[2..] { gpu_sink_counted(argument, head in GPU_WRITING_WORDS) }
		return ø
	}
	# a function of the program's that hands an argument to the GPU alone: that argument as a GPU word's
	taken = gpu_lists.takers.get(head)
	if taken != ø and bracket_of(n) == "(" {
		for at in 2 to #items { if (at - 1) in taken then gpu_sink_counted(items#at, no) else gpu_uses_counted(items#at) }
		return ø
	}
	for item in items { gpu_uses_counted(item) }
}
# a function's body counts the program's names it mentions, never its parameters, which only shadow them
gpu_definition_counted(definition: Node) := {
	parameters = method_parameters(definition).map(parameter_name)
	shadowed = parameters.map(name => gpu_lists.uses.get(name))
	gpu_uses_counted(value_of(definition))
	for at in 1 to #parameters { gpu_lists.uses[parameters#at] = shadowed#at ?? gpu_no_uses() }
}
# the program's functions `f(…) := body` with a parameter body hands to the GPU alone (no other mention, assignment
# or item read): f → the places of those parameters
gpu_takers(program: Node): map := {
	takers = {}
	for statement in level_statements(program) {
		if is_key(statement, Op.Define) and is_group(key_of(statement)) {
			gpu_lists.uses = {}
			gpu_uses_counted(value_of(statement))
			parameters = method_parameters(statement).map(parameter_name)
			taken = []
			for at in 1 to #parameters { if gpu_taken(gpu_lists.uses.get(parameters#at)) { taken = taken + [at] } }
			if #taken > 0 { takers[name_of(key_of(statement)#1)] = taken }
		}
	}
	takers
}
gpu_taken(uses: list?): bool := uses != ø and uses#1 > 0 and uses#2 == 0 and uses#3 == 0 and uses#6 == 0
gpu_uses_both(a: Node, b: Node) := {
	gpu_uses_counted(a)
	gpu_uses_counted(b)
}
# a GPU word's argument: a list variable, or a map literal of them, is a GPU use
gpu_sink_counted(argument: Node, writes: bool) := {
	if argument is symbol { return gpu_sink_added(name_of(argument), writes) }
	if is_group(argument) and bracket_of(argument) == "{" {
		for entry in items_of(argument) { if is_key(entry, Op.Colon) and value_of(entry) is symbol { gpu_sink_added(name_of(value_of(entry)), writes) } else { gpu_uses_counted(entry) } }
		return ø
	}
	gpu_uses_counted(argument)
}
gpu_sink_added(name: text, writes: bool) := {
	gpu_use_added(name, 0)
	if writes { gpu_use_added(name, 6) }
}
# the forms a GPU list is made by: `float[n]`, a list literal of items, a comprehension `[e for x in r]`
# a list joined of parts, `a + [e for x in r]`: its parts, which the creating ones among give its cells
gpu_made_parts(v: Node): list := if is_key(v, Op.Add) then gpu_made_parts(key_of(v)) + gpu_made_parts(value_of(v)) else [v]
gpu_creating(v: Node): bool := gpu_zeros_count(v) != ø or gpu_comprehension(v) or gpu_literal(v)
# `float[n]` (`int[n]` for integer cells), which the parser reads as float#(n + 1): that shifted count
gpu_zeros_count(v: Node): Node := if is_key(v, Op.Hash) and key_of(v) is symbol and name_of(key_of(v)) in ["float", "int"] then value_of(v) else ø
gpu_comprehension(v: Node): bool := is_group(v) and bracket_of(v) == "[" and #v == 2 and is_group(v#2) and #(v#2) == 5 and v#2#1 is symbol and name_of(v#2#1) == "for"
gpu_literal(v: Node): bool := (is_group(v) and bracket_of(v) == "[" and not gpu_comprehension(v)) or is_empty_list(v)
# `[]`, the empty list a growth starts from, which the rules hold as an opaque view of no items
EMPTY_LIST_VIEW = ["list", "[", ""]
is_empty_list(v: Node): bool := is_opaque(v) and value_of(v) == EMPTY_LIST_VIEW
# the creating form written to make the GPU list itself (any other value copied into one, gpu_list_of): `float[n]` its zeros, a literal its items written into them
# one by one, a comprehension each item as it is computed, counted by a first loop (`#(0..n)` makes the range a list)
# the cells a GPU list holds, `xs: [i32] = …` (extensions/gpu_lists/gpu_lists.warp GpuCell): f32 unless the program says so
GPU_CELLS = {f32: 0, i32: 1, u32: 2, f16: 3, bf16: 4, vec2: 5, vec3: 6, vec4: 7}
gpu_packed(v: Node): Node := gpu_made(v, "f32")
# `xs: [i32] = …`, `xs: [u32] = …`: the value made as a GPU list of those cells; ø for a list type of no GPU cell
gpu_packed_as(cell: Node, v: Node): any := if cell is symbol and name_of(cell) in GPU_CELLS then gpu_made(v, name_of(cell)) else ø
# a creating form written to make the GPU list itself, any other value copied into one as it is (never written out as
# code and read again, which a lambda's comprehension would not survive)
gpu_made(v: Node, cell: text): Node := if gpu_creating(v) then plain_node(parsed(gpu_packed_code(v, cell))) else call_of("gpu_list_of", [v, GPU_CELLS[cell]])
gpu_packed_code(v: Node, cell: text): text := {
	code = GPU_CELLS[cell]
	shifted = gpu_zeros_count(v)
	if shifted != ø { return "gpu_zeros((" + as_code(shifted) + ") - 1, " + code + ")" }
	if gpu_comprehension(v) {
		each = v#2
		over = "for " + as_code(each#2) + " in " + as_code(each#4)
		return "{ gpu_count = 0; " + over + " { gpu_count += 1 }; gpu_made = gpu_zeros(gpu_count, " + code + "); gpu_at = 1; " + over + " { gpu_made#gpu_at = " + as_code(v#1) + "; gpu_at += 1 }; gpu_made }"
	}
	if is_empty_list(v) { return "gpu_zeros(0, " + code + ")" }
	written = "gpu_zeros(" + #v + ", " + code + ")"
	for i in 1 to #v { written = "gpu_put(" + written + ", " + i + ", " + as_code(v#i) + ")" }
	written
}
# --- a list made for the GPU alone (gpu_bound) declares its cells, which the gpu_lists pass makes it of
# (extensions/gpu_lists/gpu_lists.warp): [vec4] where each item is four numbers, [f32] for numbers, no GPU list where
# its items are lists of another width (the slow path's note then says how to make it)
gpu_inferred_cell(v: Node): text? := {
	# `float[n]` f32 zeros, `int[n]` no floats at all
	if gpu_zeros_count(v) != ø { return if name_of(key_of(v)) == "float" then "f32" else ø }
	items = if gpu_comprehension(v) then [v#1] else items_of(v)
	if #items > 0 and items.all(item => is_number_list(item) and #item == 4) { return "vec4" }
	if items.any(is_number_list) then ø else "f32"
}
# the one cell the made list and the lists its growths add agree on, ø where they differ; growths by other values
# convert at run time and don't vote, and a list nothing votes for (grown from [] by such values) is f32
gpu_cell_of_all(values: list): text? := {
	cells = distinct(values.filter(v => gpu_creating(v) and not is_empty_list(v)).map(v => gpu_inferred_cell(v) ?? ""))
	if #cells == 0 { return "f32" }
	if #cells == 1 and cells#1 != "" then cells#1 else ø
}
is_number_list(item: Node): bool := is_group(item) and bracket_of(item) == "["
# a main-level `xs = v` made for the GPU alone as `xs: [vec4] = v`, any other statement as it is
gpu_inferred_declaration(statement: Node, program: Node): Node := {
	if not (is_key(statement, Op.Assign) and key_of(statement) is symbol) { return statement }
	bound = gpu_bound(key_of(statement), program)
	uses = gpu_lists.uses.get(name_of(key_of(statement)))
	cell = if uses != ø then gpu_cell_of_all(([value_of(statement)] + uses#8).flat_map(gpu_made_parts)) else ø
	if bound and cell != ø {
		diagnose(call_of("gpu_list_inferred", [name_of(key_of(statement)), cell]), key_of(statement))
		return Key(Key(key_of(statement), Op.Colon, bracketed([symbol(cell)], "[")), Op.Assign, value_of(statement))
	}
	why = gpu_kept_why(uses, bound)
	if why != ø { diagnose(call_of("gpu_list_kept", [name_of(key_of(statement)), why, cell ?? "f32"]), statement) }
	statement
}
# why a list the program makes and a GPU word takes stays a list, said where it is made (its upload then walks its
# numbers, the slow path); ø for any other list
gpu_kept_why(uses: list?, bound: bool): text? := {
	if uses == ø or uses#1 == 0 or uses#4 == ø { return ø }
	if bound { return "its items are lists of another width than four" }
	if uses#3 > 0 { return "the program hands it on elsewhere too" }
	if uses#2 != 1 + uses#5 { return "it is assigned again" }
	"the program reads its items, which f32 cells would round"
}
