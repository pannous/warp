# lib/signals.warp's rules that run code at compile time, its whole program or a rule word of extensions/rules/rule_words.warp:
# the compiler keeps them, taken with the module's own (rewrites.warp module_rule_paths; decision library-zero-bake-plan 1b)
rewrite on change $f $body: block => value_listened(() => $f, (value, old) => $body) where $f is symbol and $w = polled_word($f, $program, $source)
rewrite $p => $q where program and $q = signaled($p)
rewrite $p => $q where program and $q = page_valued($p)
