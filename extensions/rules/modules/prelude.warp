# lib/prelude.warp's rules that run code at compile time, its whole program or a rule word of extensions/rules/rule_words.warp:
# the compiler keeps them, taken with the module's own (rewrites.warp module_rule_paths; decision library-zero-bake-plan 1b)
// paint(s) and paint(s, values) paint at the program's own width and height where it assigns both, else at the view's
// size (wiki/graphics.md): the rules below then fill the shader's holes, or lib/shaders' rules paint the function.
// Rules of the prelude, so they meet paint before arity_overloads names its overloads, in every program
rewrite paint($s) => paint($s, $size...) where $s is symbol and $size = paint_size($program)
rewrite paint($s, $v) => paint($s, $size..., $v) where $s is symbol and $size = paint_size($program)
// a paint or render of a shader the program assigns, with values or without, reads its holes from the variables of
// their names (extensions/rules/shader_holes.warp shader_values): one rule for every word that takes a shader
rewrite $f($s, $w, $h, $v...) => $f($s, $w, $h, $filled) where $f in [paint, gpu_render] and $s is symbol and $filled = shader_values($s, $v, $program)
// a shader block's paint without holes, with no values, so the rules below place it (card wgsl-error)
rewrite paint($s, $w, $h) => paint($s, $w, $h, ø) where $s is symbol and $place = shader_place_of($s, $program, $source)
// gpu_render(s, width, height) of a shader without holes: no values of its own
rewrite gpu_render($s, $w, $h) => gpu_render($s, $w, $h, [])
// a shader the program assigns in compute.toys' dialect, its entry point fn main_image (decision: the dialect is read off
// the entry point, notes/gpu.md "One shader"), paints and renders as compute_toy makes it a fragment shader
rewrite $f($s, $w, $h, $v) => $f($made, $w, $h, $v) where $f in [paint, gpu_render] and $s is symbol and $made = compute_toys_made($s, $program)
// a list the program makes for the GPU (gpu_compute takes it) is made as a GPU list [f32] (decision gpu-bound-floats,
// extensions/rules/rule_words.warp gpu_lists_packed): f32 cells in linear memory the GPU reads and writes where they are; `xs: [f32] = …` asks
// for one outright, `xs: [i32] = …` and `xs: [u32] = …` for one of integer cells
rewrite $p => $q where program and $q = gpu_lists_packed($p)
// (this rule needs gpu_compute, so the prelude's rules, the one above too, come with any program calling it)
rewrite gpu_compute($s, $v, $n) => gpu_compute($s, $made, $n) where $made = gpu_list_made($v)
// a shader text the program names gets the shader words it calls but does not define (lib/prelude.warp shader_words,
// decision shader-hash: hash(cell)), placed where its shader block stands (card wgsl-error); after the rules above,
// which read the shader's name
rewrite paint($s, $w, $h, $v) => paint($words, $w, $h, $v) where $s is symbol and not $s is function and $words = shader_words_of($s, $program, $source)
rewrite gpu_render($s, $w, $h, $v) => gpu_render($words, $w, $h, $v) where $s is symbol and $words = shader_words_of($s, $program, $source)
rewrite gpu_compute($s, $v, $n) => gpu_compute($words, $v, $n) where $s is symbol and $words = shader_words_of($s, $program, $source)
