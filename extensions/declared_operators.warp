# Declared operators (card parser-cold-forms, decision core-is-self): `infix operator ⊕(a, b) := a + 2*b`, `prefix
# operator √ := …`, `suffix operator ‼ := …`, the pattern `a ⊕ b := …` and `operator ⊕ has precedence above *`. Each
# parse scans what its source and the modules it uses declare (Parser.scans), then reads the operators as calls of
# operator_⊕. The parser keeps what its passes read too: the one statement reader operator_statement (decision
# one-operator-reader), aliases, methods.
OPERATORS_SCAN = "declared_operators"
declared_operators_extension = Extension{name: "declared_operators", prescans: {"declared_operators": scanned_operators}, infix_readers: [read_declared_infix], prefix_readers: [read_glyph_definition, read_declared_prefix], glyph_owners: [declares_glyph], keyword_readers: {"operator": read_declaration, "infix": read_declaration, "prefix": read_declaration, "suffix": read_declaration, "postfix": read_declaration}}

# the suffixes the parser itself reads as a call of a word, `x!` as unwrap(x): `postfix operator !(n: int) :=
# factorial(n)` overloads that word, so `5!` is 120 and `!` of another value keeps its meaning (decision
# bang-overloadable); the parser's own operator method, under the word's name
PARSED_SUFFIX_WORDS = {"!": "unwrap"}
def suffix_word_overload(p: Parser, word: text) as Node := {
	if FIXITY_WORDS.get(word) != Fixity.Suffix { return ø }
	words = statement_words_at(p)
	glyph = if #words > 2 and words#2 == "operator" then words#3 else if #words > 1 then words#2 else ""
	spelled = PARSED_SUFFIX_WORDS.keys.filter(suffix => glyph.starts_with(suffix + "("))
	if #spelled == 0 { return ø }
	method = operator_method_definition(p, word)
	if method == ø { return ø }
	Key(call_of([symbol(PARSED_SUFFIX_WORDS[spelled#1])] + items_of(key_of(method))[1 ..]), Op.Define, value_of(method))
}

# `+(a: Color, b: Color): Color := …` (decision color-light-adding): a statement headed by an operator's glyph and its
# two parameters is that infix operator's definition, `operator +(…)`; a class's operator method `+(o) := …` and a
# glyph's value `∞() := …` stay as they are. The glyph before `(` the cheap test first
def read_glyph_definition(p: Parser) as Node := {
	end = p.at
	while end < p.n and not is_name_char(p.code[end]) and not is_blank(p.code[end]) and p.code[end] != '(' { end += 1 }
	if end == p.at or end >= p.n or p.code[end] != '(' { return ø }
	glyph = p.code[p.at .. end]
	if SYMBOL_OPERATORS.get(glyph) == ø and not is_definable_glyph(glyph) { return ø }
	words = statement_words_at(p)
	position = words.index_of(":=")
	if position < 2 or not words[0 .. position - 1].join(" ").contains(",") { return ø }
	operator_method_definition(p, "")
}

# the operators this parse knows
declared_in(p: Parser) as list := p.scans.get(OPERATORS_SCAN) ?? []
# The declared operator written at the parser's position, the longest glyph, a word one as a whole word, else ø; a
# longer built-in or alias spelling there wins (maximal munch): `a··b` beside a declared `·` is `··`
def declared_operator_at(p: Parser) as DeclaredOperator? := {
	operator = longest_spelled_at(p, declared_in(p), operator => operator.glyph)
	if operator == ø { return ø }
	spelled = operator_at(p)
	if count(spelled) > 0 and spelled#1.length > operator.glyph.length then ø else operator
}

# `√16`: a declared prefix operator and its operand; its glyph is beyond ASCII (is_operator_glyph), the cheap test first
def read_declared_prefix(p: Parser) as Node := {
	if char_here(p) <= '~' { return ø }
	operator = declared_operator_at(p)
	if operator == ø or operator.fixity != Fixity.Prefix { return ø }
	p.at += operator.glyph.length
	skip_spaces(p)
	operator_call(operator.glyph, [expression(p, operator.level)])
}

# `a ⊕ b`, `n‼`: a declared infix or suffix operator after the operand; one binding looser than the context ends the
# operand, unless a built-in operator of the glyph binds; a glyph beyond ASCII or a word, the cheap test first
def read_declared_infix(p: Parser, left: Node, min_power: int) as Node := {
	c = char_here(p)
	if c <= '~' and not is_name_start(c) { return ø }
	operator = declared_operator_at(p)
	if operator == ø or operator.fixity == Fixity.Prefix { return ø }
	if operator.level < min_power or is_glued_call(p, operator.glyph) { return if operator_at(p).length == 0 then OPERAND_ENDS else ø }
	p.at += operator.glyph.length
	if operator.fixity == Fixity.Suffix { return operator_call(operator.glyph, [left]) }
	skip_blanks(p)
	operator_call(operator.glyph, [left, expression(p, operator.level + 1)])
}

# a declared operator's glyph is no free symbol: `prefix operator ∆` makes `print ∆ 5` print ∆(5)
declares_glyph(p: Parser, glyph: text) as bool := declared_level(declared_in(p), glyph) >= 0

# a statement opening with a fixity word: a declaration, a precedence the scan applied (skipped), else ø: an alias
# `operator × := *` or a method `operator #(n) := …` is the parser's
def read_declaration(p: Parser, word: text) as Node := {
	overload = suffix_word_overload(p, word)
	if overload != ø { return overload }
	words = statement_words_at(p)
	statement = operator_statement(words)
	if only_spells(statement) { return ø }
	if count(precedence_declaration(words, declared_in(p))) > 0 { return skip_statement(p) }
	if statement == ø then ø else operator_declaration(p, word, statement)
}

# Each operator a source declares: `[prefix|suffix|postfix|infix] operator ⊕ := …` and the pattern `a ⊕ b := …` (infix), at the level a precedence declaration gives it
def declared_operators(source: text) as list := if source.contains(":=") then operators_declared_in(code_statements(source)) else []
def operators_declared_in(statements: list) as list {
	found = []
	for statement in operator_statements(statements) { found += operator_declared(statement) }
	// `operator ⊕ has precedence above *`, wherever it stands, once every operator is known
	for statement in statements {
		if not statement.contains("precedence") { continue }
		ranked = precedence_declaration(blank_words(statement), found)
		if count(ranked) == 0 { continue }
		for operator in found { if operator.glyph == ranked#1 { operator.level = ranked#2 } }
	}
	found
}

# The operators a parse of a source knows: its own declared ones, those of the standard modules it uses (`use regex`
# makes `matches` infix), then the standard modules' glyph operators it writes
def scanned_operators(source: text) as list {
	found = declared_operators(source)
	for module in reached_modules(source) { found += module_operators(module) }
	// (a glyph is beyond ASCII: a source without such a character needs no module read)
	if not has_beyond_ascii(source) { return found }
	for library in library_glyph_operators() {
		if source.contains(library.glyph) and declared_level(found, library.glyph) < 0 { found += [library] }
	}
	found
}
# The glyph operators the standard modules declare, with their precedence: `[1] ∪ [2] ∩ [3]` reads ∩ first as
# lib/list.warp says, without `use list`, `6 ± 1` is uncertain's operator_±(6, 1), which brings uncertain as any word
# of it does (implicit_modules); read off the library index the first time a parse needs them
global library_operators = ø
def library_glyph_operators() as list {
	if library_operators == ø {
		indexed = library_index_section("operator")
		library_operators = indexed.keys.map(key => read_operator(key + " " + indexed[key]))
	}
	library_operators
}
# each of them as the library index holds it (library.warp), `<glyph> <fixity word>` with its level, scanned off the
# modules' texts by the build writing the index
def library_operators_scanned() as map {
	statements = std_module_names.filter(name => join(module_sources([name]), "").contains("operator")).flat_map(name => code_statements_of(name))
	found = {}
	for operator in operators_declared_in(statements).filter(operator => not is_name_start(operator.glyph#1)) {
		words = written_operator(operator).split(" ")
		found[words#1 + " " + words#2] = words#3
	}
	found
}
# an operator as one text, `∪ infix 70`, and back: as the library index and a module's signature hold it
def written_operator(operator: DeclaredOperator) as text := operator.glyph + " " + FIXITY_WORDS.keys.find(word => FIXITY_WORDS[word] == operator.fixity) + " " + "${operator.level}"
def read_operator(written: text) as DeclaredOperator {
	words = written.split(" ")
	DeclaredOperator{glyph: words#1, fixity: FIXITY_WORDS[words#2], level: words#3 as int}
}
# the operators a standard module declares: its signature's, else (a program's own module, one not prebuilt) its
# text's
def module_operators(module: text) as list {
	signature = prebuilt_signature(module)
	if signature != ø { return signature.operators.map(read_operator) }
	declared_operators(join(module_sources([module]), ""))
}

def has_beyond_ascii(source: text) as bool {
	for c in source { if c > '~' { return true } }
	false
}

# `operator ⊕ has precedence above *`: ⊕ binds this much tighter than `*`; the built-in levels are at least 5 apart
PRECEDENCE_STEP = 2
# What the words `operator ⊕ has precedence above|below [operator] Y` declare: [glyph, level]; [] for any other
# statement; one that cannot be followed (a built-in ⊕, an unknown Y) raises its error
def precedence_declaration(words: list, declared: list) as list {
	if words.length < 6 or words#1 != "operator" or words#3 != "has" or words#4 != "precedence" { return [] }
	direction = words#5
	if direction != "above" and direction != "below" { return [] }
	other = if words.length == 7 and words#6 == "operator" then words#7 else if words.length == 6 then words#6 else ""
	if count(other) == 0 { return [] }
	glyph = words#2
	if declared_level(declared, glyph) < 0 { raise "operator $(glyph) is built in: only a declared operator gets a precedence (`infix operator $(glyph) := …` first)" }
	reference = declared_level(declared, other)
	if reference < 0 {
		canonical = canonical_operator(other)
		if count(canonical) == 0 { raise "unknown operator $(other) in `operator $(glyph) has precedence $(direction) $(other)`" }
		reference = binding_powers(canonical)#1
	}
	[glyph, if direction == "above" then reference + PRECEDENCE_STEP else reference - PRECEDENCE_STEP]
}
# The level of the declared operator spelled `glyph`, else -1
def declared_level(declared: list, glyph: text) as int {
	operator = declared.find(operator => operator.glyph == glyph)
	if operator == ø then -1 else operator.level
}

# `infix operator ⊕(a: int, b: int) := a * 10 + b`, `prefix operator ∆ := …`: the definition of the function
# operator_⊕, whose parameters are the declared ones, else `it` (prefix, suffix) or `a b` (`left right` when the body
# names them); ø for any other statement starting with the word
def operator_declaration(p: Parser, word: text, statement: OperatorStatement) as Node := {
	glyph = statement.spelling
	if glyph == "" { return ø }
	infix = statement.fixity == Fixity.Infix
	p.at += word.length
	skip_spaces(p)
	if statement.keyword and word != "operator" {
		p.at += "operator".length
		skip_spaces(p)
	}
	p.at += glyph.length
	declared = if at_char(p, '(') then expression(p, binding_powers(":=")#1 + 1) else ø
	skip_spaces(p)
	p.at += 2
	skip_spaces(p)
	body = expression(p, 0)
	parameters = if declared != ø then group_items(declared) else if not infix then [symbol("it")] else if mentions(body, "left") or mentions(body, "right") then [symbol("left"), symbol("right")] else [symbol("a"), symbol("b")]
	Key(operator_call(glyph, parameters), Op.Define, body)
}

# `print matches("abd", "a.c$")`: a word operator glued to `(both, operands)` is its call, as `f(x, y)` is; a right
# operand never holds a comma, so `"abc" matches("a.c")` stays infix
def is_glued_call(p: Parser, glyph: text) as bool := is_name_start(glyph#1) and holds_top_level_comma(p.code, p.at + glyph.length, p.n)
# whether the balanced `(…)` at `at` separates items by a comma of its own; brackets and commas inside a text or a
# nested group are none of its own
def holds_top_level_comma(code: text, at: int, n: int) as bool {
	if not is_at(code, at, '(', n) { return false }
	depth = 0
	quote = ""
	escaped = false
	while at < n {
		c = code[at]
		if escaped {
			escaped = false
		} else if quote {
			if c == '\\' { escaped = true } else if "" + c == quote { quote = "" }
		} else if c == '"' or c == '\'' {
			quote = "" + c
		} else if c == '(' or c == '[' or c == '{' {
			depth += 1
		} else if c == ')' or c == ']' or c == '}' {
			if depth == 1 { return false }
			depth -= 1
		} else if c == ',' and depth == 1 {
			return true
		}
		at += 1
	}
	false
}

# `greater(a: list, b: int) := all a > b` defines `>` as its glyph form does (decision operator-words-top-level): a
# definition starting a line, named by an operator's English word (lib/aliases.warp), its two parameters typed, one of
# them beyond the numbers, is spelled with the glyph; an untyped one, lib's add(xs, x), and one of numbers stay plain
# functions. A source pass: the parse reads a built-in operator's overloads before any pass (rewrites.warp
# operator_overload)
NUMBER_TYPE_NAMES = ["int", "integer", "float", "number", "real"]
operator_words_extension = Extension{name: "operator_words", source_passes: [operator_words_spelled]}
def operator_words_spelled(source: text) as list {
	lines = lines_of(source)
	# (the table only where a line starts a definition: reading it parses lib/aliases.warp, through this pass)
	if not lines.any(line => defined_head_word(line) != ø) { return [source, []] }
	table = operator_spellings()
	spelled = []
	shifts = []
	for line in lines {
		glyph = operator_word_head(line, table)
		if glyph == ø { spelled += [line] } else {
			word = defined_head_word(line)
			start = code_points((spelled + [""]).join("\n")).length
			shifts += [[start + glyph.length, word.length - glyph.length]]
			spelled += [glyph + line[word.length ..]]
		}
	}
	[if #shifts == 0 then source else spelled.join("\n"), shifts]
}
# the name a line's definition `name(…) := …` starts with, else ø
def defined_head_word(line: text): text? {
	open = 0
	while open < line.length and is_name_char(line[open]) { open += 1 }
	if open == 0 or open >= line.length or line[open] != '(' { return ø }
	if line[hole_end(line, open + 1, '(', ')', line.length) ..].trim().starts_with(":=") then line[0 ..< open] else ø
}
# the glyph a line's definition `greater(a: list, b: int) := …` spells by its word, else ø
def operator_word_head(line: text, table: map): text? {
	word = defined_head_word(line)
	operator = if word == ø then ø else table.get(word)
	if operator == ø or operator#2 == "#" or operator#2 == word or not METHOD_OPERATORS.contains(operator#2) { return ø }
	parameters = items_of(statements_in(plain_node(parsed(line[0 ..< hole_end(line, word.length + 1, '(', ')', line.length)])))#1)[1 ..]
	types = parameters.map(parameter => if is_key(parameter, Op.Colon) then type_named(value_of(parameter)) else ø)
	if #parameters != 2 or types.any(type => type == ø) or types.all(type => type in NUMBER_TYPE_NAMES) then ø else operator#2
}
