# GPU lists `[f32]`, `[i32]`, `[u32]`, `[f16]` (decision gpu-bound-floats), the runtime of the gpu_lists extension
# (gpu_lists.warp registers it): the numbers a program hands the GPU, packed as four-byte cells (two-byte f16 ones,
# two to a word, the first in the low half, as WGSL's array<f16> holds them) in linear memory from
# their creation (extensions/rules/gpu_packing.warp gpu_packed chooses them), so the GPU's library reads and writes them where they are
# (lib/host/native_host/gpu.warp cells_address). A List $Node of the square bracket of list kind gpu_list_row() and its cell
# type (GpuCell) in KindUnit.ListCell, its data an Int of (address << 32) + count. It reads, shows and compares as a
# list (the core's list words reach it through runtime/bridge.warp's list hooks); a list word that would change one
# refuses (gpu_list_refused), as a boxed copy would lose the change
use "../../compiler/runtime/intrinsics.warp"
use "../../compiler/analysis/kinds.warp"
use "../../compiler/runtime/errors.warp"
use "../../compiler/runtime/conversions.warp"
use "../../compiler/runtime/instructions.warp"
use "../../compiler/runtime/lists.warp"
word_bytes(): int := 4
# the bytes of a cell of that type
cell_bytes(cell: int): int := if is_narrow_cell(cell) then 2 else word_bytes()
# the two-byte float cells, gpu_lists.warp GpuCell.F16 and GpuCell.BF16 (numbers, as list_kind_unit says why: the
# seed's tables may lack them): IEEE 754 binary16, and bfloat16 (an f32's exponent, 7 fraction bits)
half_cell(): int := 3
brain_cell(): int := 4
is_narrow_cell(cell: int): bool := cell == half_cell() or cell == brain_cell()
narrow_exponent_bits(cell: int): int := if cell == brain_cell() then 8 else 5
narrow_fraction_bits(cell: int): int := if cell == brain_cell() then 7 else 10
address_unit(): int := 4294967296
# its row in a list's kind field, gpu_lists.warp GpuListKind.Row (a number, as list_kind_unit says why)
gpu_list_row(): int := 2
gpu_list_kind(cell: int): int := Kind.List + BracketCode.Square * KindUnit.Info + gpu_list_row() * list_kind_unit() + cell * list_cell_unit()
is_gpu_list(n: Node): bool := list_kind(n) == gpu_list_row()
gpu_list_address(n: Node): int := shifted_right(unboxed_int(n), 32)
gpu_list_count(n: Node): int := bits_and(unboxed_int(n), address_unit() - 1)
# its cell type, a GpuCell
gpu_list_cell(n: Node): int := int_remainder(int_quotient(marked_kind(n), list_cell_unit()), 8)
gpu_cell_name(cell: int): text := if cell == GpuCell.I32 then "i32" else if cell == GpuCell.U32 then "u32" else if cell == half_cell() then "f16" else if cell == brain_cell() then "bf16" else "f32"
is_float_cell(cell: int): bool := cell == GpuCell.F32 or is_narrow_cell(cell)
# where a host finds a GPU list's cells: (address << 32) + count, -1 for any other value (exported for a host,
# gpu_lists.warp host_exports)
gpu_list_place(n: Node): int := if is_gpu_list(n) then unboxed_int(n) else -1
# count zeros of the cell type in pages grown for them (a grown page is zero)
gpu_zeros(count: int, cell: int): Node := {
	pages = pages_holding(count * cell_bytes(cell))
	before = memory_grown(if pages > 0 then pages else 1)
	if before < 0 { gpu_list_refused("no memory left for a GPU list of this size") }
	with_kind(fresh_int_node(shifted_left(before * page_bytes(), 32) + count), gpu_list_kind(cell))
}
# a GPU list of a list's numbers: what a GPU word gives back (extensions/rules/gpu_packing.warp packs a list where it is made)
gpu_list_of(xs: Node, cell: int): Node := {
	if is_gpu_list(xs) and gpu_list_cell(xs) == cell { return xs }
	items = if is_gpu_list(xs) then gpu_list_items(xs) else unboxed_list(xs)
	out = gpu_zeros(#items, cell)
	for i in 1 to #items { gpu_list_set(out, i, items#i) }
	out
}
# the list with its index-th number set: a literal's items written one by one (extensions/rules/gpu_packing.warp gpu_packed)
gpu_put(n: Node, index: int, value: Node): Node := {
	gpu_list_set(n, index, value)
	n
}
# where the index-th cell (from 1) is, an index beyond the list failing the run
cell_address(n: Node, index: int): int := {
	if index < 1 or index > gpu_list_count(n) { index_out_of_range_of(index, gpu_list_count(n)) }
	gpu_list_address(n) + (index - 1) * cell_bytes(gpu_list_cell(n))
}
# the index-th number (from 1): a float of an f32 or f16 cell, an int of an i32 or u32 one
gpu_list_at(n: Node, index: int): Node := {
	cell = gpu_list_cell(n)
	address = cell_address(n, index)
	if is_narrow_cell(cell) { return narrow_float(half_at(address), narrow_exponent_bits(cell), narrow_fraction_bits(cell)) }
	if cell == GpuCell.I32 { return memory_i32(address) }
	if cell == GpuCell.U32 { return memory_u32(address) }
	memory_f32(address)
}
gpu_list_set(n: Node, index: int, value: Node): Node := {
	cell = gpu_list_cell(n)
	address = cell_address(n, index)
	if is_float_cell(cell) {
		if kind_code(value) != Kind.Int and kind_code(value) != Kind.Float { gpu_list_refused("a GPU list [" + gpu_cell_name(cell) + "] holds numbers only") }
		if is_narrow_cell(cell) { half_set(address, narrow_bits(float_of_node(value), narrow_exponent_bits(cell), narrow_fraction_bits(cell))) } else { memory_set_f32(address, float_of_node(value)) }
		return value
	}
	if kind_code(value) != Kind.Int { gpu_list_refused("a GPU list [" + gpu_cell_name(cell) + "] holds ints only") }
	number = int_of_node(value)
	if cell == GpuCell.U32 and (number < 0 or number > 4294967295) { gpu_list_refused("a GPU list [u32] holds 0 to 4294967295") }
	if cell == GpuCell.I32 and (number < -2147483648 or number > 2147483647) { gpu_list_refused("a GPU list [i32] holds -2147483648 to 2147483647") }
	memory_set_i32(address, number)
	value
}
# a two-byte cell: its half of the aligned word holding it
half_at(address: int): int := bits_and(shifted_right(memory_u32(address - int_remainder(address, word_bytes())), 8 * int_remainder(address, word_bytes())), 65535)
half_set(address: int, bits: int) := {
	word = address - int_remainder(address, word_bytes())
	shift = 8 * int_remainder(address, word_bytes())
	kept = bits_and(memory_u32(word), bits_xor(4294967295, shifted_left(65535, shift)))
	memory_set_i32(word, bits_or(kept, shifted_left(bits, shift)))
}
# x as the bits of a narrow IEEE 754 float of that many exponent and fraction bits (f16: 5, 10), rounded to nearest,
# ties to even; too big a magnitude infinity, NaN a quiet NaN, too small zero
narrow_bits(x: float, exponent_bits: int, fraction_bits: int): int := {
	sign = shifted_left(shifted_right(bits_of_float(x), 63), exponent_bits + fraction_bits)
	top = shifted_left(1, exponent_bits) - 1
	bias = shifted_left(1, exponent_bits - 1) - 1
	magnitude = float_abs(x)
	if magnitude != magnitude { return sign + shifted_left(top, fraction_bits) + shifted_left(1, fraction_bits - 1) }
	least_normal = power_of_two(1 - bias)
	if magnitude < least_normal { return sign + truncated(float_nearest(magnitude * power_of_two(bias - 1 + fraction_bits))) }
	exponent = bits_and(shifted_right(bits_of_float(magnitude), 52), 2047) - 1023
	significand = truncated(float_nearest(magnitude * power_of_two(fraction_bits - exponent)))
	if significand == shifted_left(1, fraction_bits + 1) {
		significand = shifted_left(1, fraction_bits)
		exponent = exponent + 1
	}
	if exponent + bias >= top { return sign + shifted_left(top, fraction_bits) }
	sign + shifted_left(exponent + bias, fraction_bits) + significand - shifted_left(1, fraction_bits)
}
# the narrow float's bits as the float of the same value, exactly
narrow_float(bits: int, exponent_bits: int, fraction_bits: int): float := {
	sign = shifted_left(bits_and(shifted_right(bits, exponent_bits + fraction_bits), 1), 63)
	top = shifted_left(1, exponent_bits) - 1
	bias = shifted_left(1, exponent_bits - 1) - 1
	field = bits_and(shifted_right(bits, fraction_bits), top)
	fraction = bits_and(bits, shifted_left(1, fraction_bits) - 1)
	if field == top { return float_of_bits(sign + shifted_left(2047, 52) + shifted_left(fraction, 52 - fraction_bits)) }
	if field == 0 and fraction == 0 { return float_of_bits(sign) }
	exponent = field - bias
	if field == 0 {
		# a subnormal: its top one bit becomes the implicit one of a normal float
		exponent = 1 - bias
		while fraction < shifted_left(1, fraction_bits) {
			fraction = shifted_left(fraction, 1)
			exponent = exponent - 1
		}
		fraction = fraction - shifted_left(1, fraction_bits)
	}
	float_of_bits(sign + shifted_left(exponent + 1023, 52) + shifted_left(fraction, 52 - fraction_bits))
}
# 2 to the k, exactly, for k from -1022 to 1023
power_of_two(k: int): float := float_of_bits(shifted_left(k + 1023, 52))
# the numbers as a list, for the list words that read a list
gpu_list_items(n: Node): list := {
	out = new_list(gpu_list_count(n))
	for i in 1 to #out { out#i = gpu_list_at(n, i) }
	out
}
gpu_list_refused(message: text): int := returned_error(message)
# how many bins view_order_into quantizes a depth into, and the 0 .. 65535 keys those bins are (antimatter15/splat
# runSort: depth · 4096, then 65535 / (max − min)). The two tables are allocated once: a GPU list's pages are never freed
depth_bins(): int := 65536
depth_levels(): int := 65535
global depth_counts = ø
global depth_starts = ø
# the bins, made on the first sort and reused. Each call zeroes the counts; the starts are overwritten by the prefix
depth_bins_ready() := {
	if is_null(depth_counts) or not is_gpu_list(depth_counts) {
		depth_counts = gpu_zeros(depth_bins(), GpuCell.I32)
		depth_starts = gpu_zeros(depth_bins(), GpuCell.I32)
	}
}
zero_words(address: int, count: int) := {
	i = 0
	while i < count {
		memory_set_i32(address + i * word_bytes(), 0)
		i = i + 1
	}
}
# centres holds one splat per four floats, xyz then opacity. index is 0-based. depth is (position − eye) · forward
view_depth(centres: Node, index: int, ex: float, ey: float, ez: float, fx: float, fy: float, fz: float): float := {
	base = gpu_list_address(centres) + index * word_bytes() * 4
	x = memory_f32(base)
	y = memory_f32(base + word_bytes())
	z = memory_f32(base + word_bytes() * 2)
	(x - ex) * fx + (y - ey) * fy + (z - ez) * fz
}
# runSort's first quantization: trunc(depth · 4096), toward 0
quantized_depth(depth: float): int := truncated(depth * 4096.0)
# the 16-bit bin of a depth once low and the scale (65535 / (high − low), or 0 when every kept depth shares a bin) are known
depth_key(depth: float, low: int, scale: float): int := {
	key = truncated(float(quantized_depth(depth) - low) * scale)
	if key < 0 { return 0 }
	if key > depth_levels() { return depth_levels() }
	key
}
listed_float(n: Node, index: int): float := float_of_node(unboxed_list(n)#index)
# the index-th float of a GPU list [f32], or a refusal. what names the argument in the message
f32_list(n: Node, what: text): int := {
	if not is_gpu_list(n) or gpu_list_cell(n) != GpuCell.F32 { return gpu_list_refused("view_order_into reads a GPU list [f32] (" + what + ")") }
	0
}
# indices of the splats in centres whose depth is at least nearest, nearest first, written into into as f32 and counted.
# centres is xyzw per splat. The order is a stable 16-bit counting sort (antimatter15/splat runSort): equal bins keep
# the lower index first, so it matches a stable mergesort except where two different depths share a bin. It always
# sorts; a caller that skipped a still camera would be choosing that itself. 0 for none in front, or an empty centres
view_order_into(centres: Node, eye: Node, forward: Node, nearest: Node, into: Node): int := {
	f32_list(centres, "centres")
	f32_list(into, "order")
	if int_remainder(gpu_list_count(centres), 4) != 0 { gpu_list_refused("view_order_into: a centre is four floats") }
	n = int_quotient(gpu_list_count(centres), 4)
	if n == 0 { return 0 }
	ex = listed_float(eye, 1)
	ey = listed_float(eye, 2)
	ez = listed_float(eye, 3)
	fx = listed_float(forward, 1)
	fy = listed_float(forward, 2)
	fz = listed_float(forward, 3)
	limit = float_of_node(nearest)
	low = 0
	high = 0
	seen = no
	kept = 0
	i = 0
	while i < n {
		d = view_depth(centres, i, ex, ey, ez, fx, fy, fz)
		if d >= limit {
			k = quantized_depth(d)
			if not seen or k < low { low = k }
			if not seen or k > high { high = k }
			seen = yes
			kept = kept + 1
		}
		i = i + 1
	}
	if kept == 0 { return 0 }
	if kept > gpu_list_count(into) { gpu_list_refused("view_order_into: the order list is shorter than the splats in front") }
	depth_bins_ready()
	counts = gpu_list_address(depth_counts)
	starts = gpu_list_address(depth_starts)
	zero_words(counts, depth_bins())
	span = high - low
	scale = if span > 0 then float(depth_levels()) / float(span) else 0.0
	i = 0
	while i < n {
		d = view_depth(centres, i, ex, ey, ez, fx, fy, fz)
		if d >= limit {
			at = counts + depth_key(d, low, scale) * word_bytes()
			memory_set_i32(at, memory_i32(at) + 1)
		}
		i = i + 1
	}
	run = 0
	i = 0
	while i < depth_bins() {
		c = memory_i32(counts + i * word_bytes())
		memory_set_i32(starts + i * word_bytes(), run)
		run = run + c
		i = i + 1
	}
	out = gpu_list_address(into)
	i = 0
	while i < n {
		d = view_depth(centres, i, ex, ey, ez, fx, fy, fz)
		if d >= limit {
			slot_at = starts + depth_key(d, low, scale) * word_bytes()
			slot = memory_i32(slot_at)
			memory_set_i32(slot_at, slot + 1)
			memory_set_f32(out + slot * word_bytes(), float(i))
		}
		i = i + 1
	}
	kept
}
# a list word given a GPU list, which would read or change a copy of it
gpu_list_refused_as(n: Node): int := gpu_list_refused("a GPU list [" + gpu_cell_name(gpu_list_cell(n)) + "] takes only #, xs#i, xs#i = number, for, print and the GPU's words: copy it to a list with [x for x in xs] first")
# the items a list word reads: none, it refuses
gpu_list_unlisted(n: Node): list := {
	gpu_list_refused_as(n)
	new_list(0)
}
