--- a/src/runtime/store/gc.rs
+++ b/src/runtime/store/gc.rs
@@ -1196,7 +1196,9 @@
     // GC heap growth (and its space overhead), only prefer growing first if the
     // predicted GC heap utilization is greater than half the GC heap's
     // capacity.
-    predicted_usage < gc_heap_capacity / 2
+    // warp: a copying heap uses half its capacity at a time, so grow (doubling) once the prediction passes half
+    // of that half, not when the half is full (it collected over and over, freeing little: 80% of a compile)
+    predicted_usage < gc_heap_capacity / 4
 }
 
