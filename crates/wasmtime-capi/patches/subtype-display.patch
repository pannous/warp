+    fn display_depth(&self, ty: ModuleInternedTypeIndex) -> Option<u32> {
+        let mut depth = 0;
+        let mut supertype = self.types[ty].supertype;
+        while let Some(parent) = supertype {
+            depth += 1;
+            supertype = self.types[parent.as_module_type_index()?].supertype;
+        }
+        (depth < SUBTYPE_DISPLAY_STRIDE - 1).then_some(depth)
+    }
