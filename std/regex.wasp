// The standard library module regex (notes/stdlib.md section 7): `use regex`, through the adapter std_pure: Rust's
// regex natively, JS RegExp in the browser, held to what both do alike (no look-around, no backreferences)
matches(subject, pattern) := std_pure("regex", "matches", [subject, pattern])
first_match(subject, pattern) := std_pure("regex", "first", [subject, pattern])
find_all(subject, pattern) := std_pure("regex", "all", [subject, pattern])
replace_all(subject, pattern, replacement) := std_pure("regex", "replace", [subject, pattern, replacement])
