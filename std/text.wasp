// The standard library module text (notes/stdlib.md): `use text`
repeat(t, n) := n times t
pad_left(t, width) := if count(t) >= width then t else (width - count(t)) times " " + t
pad_right(t, width) := if count(t) >= width then t else t + (width - count(t)) times " "
// format("{} has {} items", ["cart", 3]): each {} takes the next value
format(template, values) := {
	parts = split(template, "{}")
	result = parts[0]
	for i in 1 ..< count(parts) {
		result = result + values[i - 1] + parts[i]
	}
	result
}
// the words between runs of spaces
words(t) := [w for w in split(t, " ") if w != ""]
lines(t) := split(t, "\n")
capitalize(t) := if t == "" then t else upper(t[0]) + t[1..]
center(t, width) := pad_right(pad_left(t, (width + count(t))//2), width)
title(t) := join([capitalize(w) for w in words(t)], " ")
// lower case letters and digits, the rest as single dashes: "Hello, World!" → "hello-world"
slug(t) := join(words(join([if is_alphanumeric(c) then c else " " for c in chars(lower(t))], "")), "-")
truncate(t, width) := if count(t) <= width then t else t[0 ..< width - 1] + "…"
// UTF-8: a text as its bytes, and bytes back as a text (Rust's String::from_utf8, string.from_utf8)
def to_utf8(t: text) {
	out = []
	for c in t {
		n = ord(c)
		if n < 128 { out = out + [n] }
		else if n < 2048 { out = out + [192 + n//64, 128 + n % 64] }
		else if n < 65536 { out = out + [224 + n//4096, 128 + n//64 % 64, 128 + n % 64] }
		else { out = out + [240 + n//262144, 128 + n//4096 % 64, 128 + n//64 % 64, 128 + n % 64] }
	}
	out
}
def from_utf8(bytes) {
	out = ""
	i = 0
	while i < count(bytes) {
		b = bytes[i]
		length = if b < 128 then 1 else if b < 224 then 2 else if b < 240 then 3 else 4
		n = if length == 1 then b else if length == 2 then b % 32 else if length == 3 then b % 16 else b % 8
		for k in 1 to length - 1 { n = n * 64 + bytes[i + k] % 64 }
		out = out + chr(n)
		i = i + length
	}
	out
}
// only spaces, tabs and line breaks, or nothing
is_blank(t) := trim(t) == ""
// has letters, all upper (or lower) case
is_upper(t) := upper(t) == t and lower(t) != t
is_lower(t) := lower(t) == t and upper(t) != t
remove_prefix(t, prefix) := if starts_with(t, prefix) then t[count(prefix):] else t
remove_suffix(t, suffix) := if ends_with(t, suffix) then t[0:count(t) - count(suffix)] else t
// how often part occurs, not overlapping: count_of("banana", "an") is 2
count_of(t, part) := count(split(t, part)) - 1
is_palindrome(t) := { s = lower(join([c for c in chars(t) if is_alphanumeric(c)], "")); s == reverse(s) }
