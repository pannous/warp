// The standard library module list (notes/stdlib.md): `use list`
unique(xs) := { out = []; for x in xs { if not (x in out) { out = out + [x] } }; out }
zip(a, b) := { out = []; for i in 1 to min(count(a), count(b)) { out = out + [[a#i, b#i]] }; out }
enumerate(xs) := { out = []; for i in 1 to count(xs) { out = out + [[i, xs#i]] }; out }
product(xs) := { out = 1; for x in xs { out = out * x }; out }
mean(xs) := sum(xs) / count(xs)
take(xs, n) := { out = []; for i in 1 to min(n, count(xs)) { out = out + [xs#i] }; out }
drop(xs, n) := { out = []; for i in n+1 to count(xs) { out = out + [xs#i] }; out }
flatten(xs) := { out = []; for x in xs { out = out + x }; out }
chunk(xs, n) := { out = []; part = []; for x in xs { part = part + [x]; if count(part) == n { out = out + [part]; part = [] } }; if count(part) > 0 { out = out + [part] }; out }
window(xs, n) := { out = []; for i in 1 to count(xs) - n + 1 { part = []; for j in i to i + n - 1 { part = part + [xs#j] }; out = out + [part] }; out }
median(xs) := { s = sort(xs); n = count(s); if n % 2 == 1 then s#(n//2 + 1) else (s#(n//2) + s#(n//2 + 1)) / 2 }
flat_map(xs, f) := { out = []; for x in xs { out = out + f(x) }; out }
// [kept, rest]: the elements f holds for, and the others
partition(xs, f) := { kept = []; rest = []; for x in xs { if f(x) { kept = kept + [x] } else { rest = rest + [x] } }; [kept, rest] }
max_by(xs, f) := { best = xs#1; for x in xs { if f(x) > f(best) { best = x } }; best }
min_by(xs, f) := { best = xs#1; for x in xs { if f(x) < f(best) { best = x } }; best }
// {key: [elements]}: the elements by the text of f's value
group_by(xs, f) := { out = {}; for x in xs { k = "" + f(x); if out.has(k) { out[k] = out.get(k) + [x] } else { out[k] = [x] } }; out }
// {element: how often}
tally(xs) := { out = {}; for x in xs { k = "" + x; if out.has(k) { out[k] = out.get(k) + 1 } else { out[k] = 1 } }; out }
zip_with(a, b, f) := { out = []; for i in 1 to min(count(a), count(b)) { out = out + [f(a#i, b#i)] }; out }
sum_by(xs, f) := { out = 0; for x in xs { out = out + f(x) }; out }
count_by(xs, f) := { out = 0; for x in xs { if f(x) { out = out + 1 } }; out }
// the elements moved n places to the left
rotate(xs, n) := { k = n % count(xs); out = []; for i in k+1 to count(xs) { out = out + [xs#i] }; for i in 1 to k { out = out + [xs#i] }; out }
interleave(a, b) := { out = []; for i in 1 to max(count(a), count(b)) { if i <= count(a) { out = out + [a#i] }; if i <= count(b) { out = out + [b#i] } }; out }
// without runs of equal neighbours
dedupe(xs) := { out = []; for x in xs { if count(out) == 0 or last(out) != x { out = out + [x] } }; out }
// the running results of f: scan([1, 2, 3], 0, (a, b) => a + b) is [1 3 6]
scan(xs, start, f) := { out = []; acc = start; for x in xs { acc = f(acc, x); out = out + [acc] }; out }
take_while(xs, f) := { out = []; for x in xs { if not f(x) { break }; out = out + [x] }; out }
drop_while(xs, f) := { out = []; dropping = true; for x in xs { if not (dropping and f(x)) { dropping = false; out = out + [x] } }; out }
// the index (from 0, like index_of) of the greatest element, the first of equal ones
argmax(xs) := { best = 1; for i in 1 to count(xs) { if xs#i > xs#best { best = i } }; best - 1 }
argmin(xs) := { best = 1; for i in 1 to count(xs) { if xs#i < xs#best { best = i } }; best - 1 }
