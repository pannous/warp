// The standard library module time (notes/stdlib.md): `use time`, the calendar over clock() (milliseconds since 1970, UTC)
day_number(ms) := ms//86400000
// Howard Hinnant's civil_from_days: the proleptic Gregorian date of a day number
date_of(ms) := {
	z = day_number(ms) + 719468
	era = z//146097
	doe = z - era * 146097
	yoe = (doe - doe//1460 + doe//36524 - doe//146096)//365
	doy = doe - (365 * yoe + yoe//4 - yoe//100)
	mp = (5 * doy + 2)//153
	day = doy - (153 * mp + 2)//5 + 1
	month = if mp < 10 then mp + 3 else mp - 9
	year = if month <= 2 then yoe + era * 400 + 1 else yoe + era * 400
	{year: year, month: month, day: day}
}
// ISO weekday: Monday 1 … Sunday 7
weekday(ms) := (day_number(ms) + 3) % 7 + 1
today() := date_of(clock())
