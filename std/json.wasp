// The standard library module json (notes/stdlib.md section 7): `use json`. Wasp data is a superset of JSON; the
// adapter std_pure parses and writes it (serde_json natively, JSON.parse / JSON.stringify in the browser)
parse_json(text) := std_pure("json", "parse", [text])
to_json(value:any) := std_pure("json", "to_json", [value])
