# AUR package warp-lang-bin (yay -S warp-lang-bin): the prebuilt binaries of the GitHub release. Source of truth; the
# AUR repository gets a copy. At a release packaging/aur/update_aur.sh <version> writes pkgver, the sha256sums and
# .SRCINFO (and pushes to the AUR with an ssh key), notes/packaging.md
# Maintainer: pannous <info@pannous.com>
pkgname=warp-lang-bin
pkgver=1.2.6
pkgrel=1
pkgdesc='Warp: a data notation that is also a programming language, compiled to WebAssembly GC'
arch=('x86_64' 'aarch64')
url='https://warp.pannous.com/'
license=('custom') # unlicensed, all rights reserved (open_decisions P150)
depends=('glibc' 'gcc-libs')
provides=('warp-lang')
conflicts=('warp-lang')
options=('!strip' '!debug') # prebuilt, already stripped
_release="https://github.com/pannous/warp/releases/download/v$pkgver/warp-v$pkgver"
source_x86_64=("$_release-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$_release-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('53c92db525c14fb27c68844eef76d91c29799b574b4fbf3eb6f75355a2642c35')
sha256sums_aarch64=('de2f9204f86067f6e6f609c3a14d8a000ccbba96d4d87767ea92c4c0758596a1')

package() {
  # warp-runtime (and warp-page-runtime, in releases since the page stub) must sit next to warp
  install -Dm755 -t "$pkgdir/usr/bin" "$srcdir"/warp "$srcdir"/warp-*runtime
}
