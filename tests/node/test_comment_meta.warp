# generated by scripts/is_tests.py from test_comment_meta.rs: edit the Rust test, then run the script again

# the_comment_of_a_binding_is_its_meta
is! 'use comments
// Comments attach to the next element as metadata
// This documents the greeting variable
greeting: "Hello"
greeting.meta.comment' 'Comments attach to the next element as metadata
This documents the greeting variable'
is! 'use comments
// Comments attach to the next element as metadata
// This documents the greeting variable
greeting: "Hello"
greeting.@comment' 'Comments attach to the next element as metadata
This documents the greeting variable'
is! 'use comments
/* the answer */
x = 42
x.@comment' 'the answer'
is! 'use comments
// Comments attach to the next element as metadata
// This documents the greeting variable
greeting: "Hello"
greeting' 'Hello'

# a_field_named_meta_stays_the_field
is! 'use comments
// a point
p = {meta: 7}
p.meta' 7

# comments_are_meta_information_only_under_use_comments
is! '// doc
x = 1
x + 1' 2
is! 'use comments
use strict
// doc
x = 1
x.@comment' 'doc'
