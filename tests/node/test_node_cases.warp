# generated by scripts/is_tests.py from test_node_cases.rs: edit the Rust test, then run the script again

# a_pattern_takes_the_node_apart
is! 'n = parse("x"); match n { Symbol(name): name, _: 0 }' 'x'
is! 'match parse("f(x)") { Key(Symbol(n), op, v): n, List(items, Bracket.Round, s): 1, _: 0 }' 1
is! 'adds(n: Node): int := match n {
	Key(left, Op.Add, right): 1 + adds(left) + adds(right)
	Key(left, op, right): adds(left) + adds(right)
	List(items, bracket, separator): sum(items.map(adds))
	_: 0
}
adds(parse("a + b * (c + d)"))' 2

# a_case_builds_the_node
is! 'List([1, 2], Bracket.Round, Separator.Comma)' (1, 2)
is! 'swap(n: Node): Node := match n { Key(l, Op.Add, r): Key(r, Op.Add, l), _: n }; swap(parse("1+2"))' 2+1

# node_is_the_type_of_any_node
is! 'f(n: Node): Node := n; f(3)' 3
is! 'Node.True' true
is! 'Node.Empty == ø' true

# an_operator_case_is_spelled_as_the_node_carries_it
is! 'Op.Add as text' '+'
is! 'Bracket.Square as text' '['
is! 'Separator.Comma as text' ','

# a_programs_own_names_win
is! 'class Key { a: int }; k = Key(3); k.a' 3
is! 'Key(a, b) := a + b; Key(1, 2)' 3
is! 'enum Op { Plus, Minus }; Op.Minus as int' 1

# an_enum_case_in_a_pattern_compares
is! 'enum Color { Red, Green }
class P { c: Color; n: int }
p = P(Color.Green, 2)
match p { P(Color.Red, n): 1, P(Green, n): n, _: 0 }' 2

# a_patterns_op_is_spelled_as_text
is! 'n = parse("a+1"); match n { Key(l, op, r): op as text, _: 0 }' '+'
is! 'n = parse("(a)"); match n { List(items, bracket, s): bracket as text, _: 0 }' '('
