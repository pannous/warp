# generated by scripts/is_tests.py from test_wasm.rs: edit the Rust test, then run the script again

# test_implicit_multiplication
is! '2π' (2.0 * pi)

# test_globals
is! '2*π' (2.0 * pi)
is! 'dub:=it*2;dub(π)' (2.0 * pi)

# test_wasm_function_definiton
is! 'fac:= if it<=0 : 1 else it * fac it-1; fac(5)' (5 * 4 * 3 * 2)

# test_wasm_ternary
is! 'fac:= it<=0 ? 1 : it * fac it-1; fac(5)' (5 * 4 * 3 * 2)

# test_lazy_evaluation
is! 'fac:= it<=0 or it * fac it-1; fac(5)' (5 * 4 * 3 * 2)

# test_math_primitives
is! 'maxi=3840*2160;maxi' (3840 * 2160)
is! 'blue=255;green=256*255;' (256 * 255)

# test_wasm_increment
is! 'i=0;w=800;h=800;pixel=(1 2 3);while(i++ < w*h){pixel[i]=i%2 };i ' (800 * 800)

# test_wasm_logic_combined
is! '3<1 and 3<1' (3 < 1)
is! '3<1 and 9>8' (3 < 1)
is! '9>8 and 3<1' (3 < 1)
is! '9>8 and 9>8' (9 > 8)
is! '9>8 or 3<1 and 3<1' (9 > 8)
is! '3<1 xor 9>8' (9 > 8)
is! '9>8 xor 3<1' (9 > 8)
is! '3<1 xor 3<1' (3 < 1)
is! '9>8 xor 9>8' (3 < 1)
is! '3<1 or 9>8' (9 > 8)
is! '3<1 or 3<1' (3 < 1)
is! '9>8 or 3<1' (9 > 8)
is! '9>8 or 9>8' (9 > 8)
is! '9>8 or 8>9' (9 > 8)

# test_square
is! 'π²' (pi * pi)

# test_import_wasm
is! 'import tests/fixtures/wasm/fourty_two;ft*2' (42 * 2)
is! 'include tests/fixtures/wasm/fourty_two;ft*2' (42 * 2)
is! 'require tests/fixtures/wasm/fourty_two;ft*2' (42 * 2)

# test_for_loops
is! 'for i in 1 to 5
  puti i' 5
is! 'for i in 1 ... 5
  puti i' 5
is! 'sum=0
for i in 1…3 {sum+=i}
sum' 6
is! 'sum=0
for i in 1 to 3 : sum+=i
sum' 6
is! 'sum=0
for i in (1 ... 3) {sum+=i}
sum' 6
is! 'sum=0
for i in (1..3) {sum+=i}
sum' 6

# test_sinus2
is! 'double sin(double x){
    x = x % tau;
    let z : double = x*x
    let w : double = z*z
    S1  = -1.66666666666666324348e-01,
    S2  =  8.33333333332248946124e-03,
    S3  = -1.98412698298579493134e-04,
    S4  =  2.75573137070700676789e-06,
    S5  = -2.50507602534068634195e-08,
    S6  =  1.58969099521155010221e-10
    if(x >= PI) return -sin(x % PI);
    let r : double = S2 + z*(S3 + z*S4) + z*w*(S5 + z*S6);
    return x + z*x*(S1 + z*r);
}; sin π/2' 1

# test_sinus
is! 'double sin(double x){
    x = x % tau
    let z : double = x*x
    let w : double = z*z
    S1  = -1.66666666666666324348e-01, /* 0xBFC55555, 0x55555549 */
    S2  =  8.33333333332248946124e-03, /* 0x3F811111, 0x1110F8A6 */
    S3  = -1.98412698298579493134e-04, /* 0xBF2A01A0, 0x19C161D5 */
    S4  =  2.75573137070700676789e-06, /* 0x3EC71DE3, 0x57B1FE7D */
    S5  = -2.50507602534068634195e-08, /* 0xBE5AE5E6, 0x8A2B9CEB */
    S6  =  1.58969099521155010221e-10  /* 0x3DE5D93A, 0x5ACFD57C */
    //	            tau =  6.283185307179586 // 2π
    if(x >= PI) return -sin(x % PI)
    let r : double = S2 + z*(S3 + z*S4) + z*w*(S5 + z*S6)
    return x + z*x*(S1 + z*r)
    };sin π/2' 1
