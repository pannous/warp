// parse corpus of tests/parser/test_self_parser.rs: the former probes/globals/ snippets, asserted in tests/welcoming/
// 10_undeclared_mutation
n=0; def f(x){n+=1;x}; f(3); n

// 11_undeclared_assign
n=0; def f(x){n=5;x}; f(3); n

// 12_pure_local
def f(){ m = 5; m }; f()

// 13_closure_read
k=3; def f(x){x+k}; f(1)

// 14_undeclared_element
xs=[1,2,3]; def f(i){xs[i]=9;i}; f(1); xs

// 15_undeclared_increment
n=0; f(x) := { n++; x }; f(3); n

// 16_param_shadows_main
x=1; def f(x){x=x+1; x}; f(5)

// 17_read_then_write
n=0; def f(x){y=n; n=y+1; x}; f(3); n

// 18_fresh_local_same_name
def f(){ total = 5; total }; total = f(); total

// 19_let_local
n=0; def f(x){let n=5;n}; f(3)

// 20_print_in_fn
f(x) := { print("called"); x }; f(3)

// 21_floor_reassign
x=10; x=floor(x/2)

