// parse corpus of tests/parser/test_self_parser.rs: the former probes/break/ snippets, asserted in tests/welcoming/
// 01_while_break
i=0; while i<10 { i=i+1; if i==3 { break } }; i

// 02_while_continue
i=0; s=0; while i<10 { i=i+1; if i%2==0 { continue }; s+=i }; s

// 03_for_range_break
s=0; for i in 0..10 { if i==4 { break }; s+=i }; s

// 04_for_range_continue
s=0; for i in 0..10 { if i%2==1 { continue }; s+=i }; s

// 05_for_list_continue
s=0; for x in [1,2,3,4,5] { if x==2 { continue }; if x==5 { break }; s+=x }; s

// 06_nested_break
n=0
for i in 0..3 {
  for j in 0..10 {
    if j==2 { break }
    n+=1
  }
}
n

// 07_next_alias
s=0; for i in 1..6 { if i==3 { next }; s+=i }; s

// 09_break_outside_loop
x=1; break; x

// 13_break_in_function
first_over(limit) := { r=0; for x in [3,8,12,20] { if x>limit { r=x; break } }; r }
first_over(10)

// 14_text_body_continue
s=""; for c in ["a","b","c","d"] { if c=="c" { continue }; s += c }; s

// 15_next_variable
next=5; s=0; for i in 0..3 { s += next }; s

// 16_while_true_break
n=0; while true { n+=1; if n>=7 { break } }; n

// 17_nested_continue_outer_break
found=0; for i in 1..5 { for j in 1..5 { if j==i { continue }; if i*j==6 { found=i*10+j; break } }; if found>0 { break } }; found

