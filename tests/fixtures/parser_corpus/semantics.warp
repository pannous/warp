// parse corpus of tests/parser/test_self_parser.rs: former probes of semantics/, key_names/, json5/, values_keys/, asserted in tests/

// semantics/binary_int
// card binary-int: 0b101 reads as 5, `as binary` (alias bin) shows binary
// gives 6
print(0b101 + 1)
// gives 0b101
print(5 as binary)
// gives 0b110
print(6 as bin)

// semantics/in_bool
// decision in-bool: `x in xs` is yes/no; the position comes from index_of
xs = [5 2 8]
// gives yes
print(2 in xs)
// gives 3
print(xs.index_of(8))

// semantics/index_position
// card index-position: index counts from 0 (xs[i]), position from 1 (xs#p); each converts at the other's brackets
xs = [10 20 30]
// gives 20
print(xs[xs.index_of(20)])
// gives 30
print(xs#(argmax(xs)))
xs.insert(15, at: xs.index_of(20))
// gives [10 15 20 30]
print(xs)
// gives 15, the item after 10: a position plus 1 is the next position
print(xs[xs.index_of(10) + 1])

// key_names/bare_key
seen = "none"
on key { if key == "Escape" { seen = "esc" } }
emit key{key:"Escape"}
seen

// key_names/esc_word
seen = "none"
on key { if key == ESC { seen = "esc" } }
emit key{key:"Escape"}
seen

// key_names/event_key
seen = "none"
on key { if event.key == "Escape" { seen = "esc" } }
emit key{key:"Escape"}
seen

// key_names/unbound_word
on key { if key == ESCAPEE { print 1 } }

// json5/block
x = json{ 'a':1 }
x.a

// json5/literal
x = {'a':1, // note
 'b':[2,3,],}
x.b

// json5/single_quotes
x = json("{'a':1}")
x.a

// values_keys/hash_map
m = {}
for i in 1 to 10000 { m[i] = i * 2 }
print count(values(m))
print count(keys(m))

// values_keys/small
m = {}
for i in 1 to 3 { m[i] = i * 2 }
print m
print values(m)
