// parse corpus of tests/parser/test_self_parser.rs: former parser-topic probes, asserted in tests/
// closures/captured_node_return.warp
v(xs) := { m = mean(xs); f = x => x - m; f(1) }; v([float(1), float(4)])

// parse/adjacent_index.warp
xs = [5, 6, 7]
xs[1]

// parse/bare_return.warp
fun f(x) {
  if x > 1 { return }
  x
}
f(1)

// parse/elseif_block.warp
x = 0
{
r = 2
if r == 0 {
 x += 1
} else if r == 2 {
 x += 10
} else {
 x += 100
}
}
x

// parse/elseif_top.warp
x=0
r=1
if r == 0 { x += 1 } else if r == 2 { x += 10 }
x

// parse/for_tuple.warp
x = 0
for (r, c) in [(0, 1), (2, 3)] { x += r*10+c }
x

// parse/fun_elseif_return.warp
fun f(n) {
  if n == 0 { return 0 } else if n == 1 { return 10 } else { return 20 }
}
f(0) + f(1) + f(2)

// parse/in_assign.warp
v = ["A"]
x = "Z" in v
x

// parse/in_condition.warp
v = ["A"]
if "Z" in v { 1 } else { 0 }

// parse/in_counting.warp
number of chars in "héllo"

// parse/property_still.warp
xs = [1, 2, 3]
xs count

// parse/return_count.warp
fun f(i) { count = 7; return count }
f(10)

// parse/return_expr.warp
fun f(n) {
  return n * 2 + 1
}
f(3)

// parse/return_list.warp
fun f() {
  return [1, 2, 3]
}
f()#3

// parse/return_negative.warp
fun f() {
  return -1
}
f()

// parse/space_bracket_list.warp
f(xs) := xs#2
f [5, 6, 7]

// ruby_yield/bare.warp
def run
  yield
end
run { 5 }

