# a_program_defines_a_property_with_a_setter
is! 'box.size := 4
box.size(n) := print "set ${n}"
box.size = 7
box.size' 4
is! 'global kept = 1
box.size := kept
box.size := kept = it
box.size = 7
box.size += 1
box.size' 8
is! 'global kept = 1
box.size := kept
box.size(n) := kept = n
box.size(5)
box.size' 5

# the_setter_is_called_like_a_method
is! 'canvas.width(12)
canvas.width' 12
is! 'display.dpi(200 dpi)
(1 inch * display.dpi) == 200px' true

# a_class_defines_a_property_of_its_instances
is! 'class Point{x;y}
Point.sum := it.x + it.y
Point(1,2).sum' 3
is! 'class Point{x;y}
Point.sum := it.x + it.y
p = Point(3,4)
p.sum + sum([1, 2])' 10

# a_class_defines_a_setter_of_its_instances
is! 'class Point{x: int; name: text}
Point.label := "<" + it.name + ">"
Point.label(v) := it.name = v
p = Point(1, "ab")
p.label = "cd"
p.label' '<cd>'
is! 'class Point{x: int; name: text}
Point.label := "<" + it.name + ">"
Point.label(v) := it.name = v
p = Point(1, "ab")
p.label = "cd"
p.x' 1

# a_class_property_names_its_instance_self_or_this
is! 'class Point{x: int; y: int}
Point.norm(self) := self.x * 2
Point(3, 4).norm' 6
is! 'class Point{x: int; y: int}
Point.norm() := self.x
Point(3, 4).norm' 3
is! 'class Point{x: int; y: int}
Point.sum := this.x + this.y
Point(3, 4).sum' 7
is! 'class Point{x: int; y: int}
Point.shift(d) := self.x = self.x + d
p = Point(3, 4)
p.shift = 10
p.x' 13
