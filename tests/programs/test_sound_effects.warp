# generated by scripts/is_tests.py from test_sound_effects.rs: edit the Rust test, then run the script again

# a_delay_adds_a_tail_of_echoes
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
delay_time = 0.1
delay_feedback = 0.5
count(through_effects(plain)) > count(plain) + 2 * 2205' true
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
count(through_effects(plain)) == count(plain)' true

# an_echo_sounds_where_the_dry_sound_was_silent
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
delay_time = 0.15
mixed = through_effects(plain)
max([abs(x - sample_offset) for x in mixed[3300..4400]]) > 1000' true

# a_reverb_rings_after_the_end
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
reverb_mix = 0.5
mixed = through_effects(plain)
count(mixed) > count(plain) + 10000 and max([abs(x - sample_offset) for x in mixed[2300..2500]]) > 100' true

# distortion_flattens_the_peaks_and_stays_in_range
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
distortion = 1.0
mixed = through_effects(plain)
max(mixed) - sample_offset <= loudness * loudest_sample' true
is! 'use sound
plain = chord_samples([440], 0.1, "sine")
distortion = 1.0
sum([abs(x - sample_offset) for x in through_effects(plain)]) > sum([abs(x - sample_offset) for x in plain])' true

# effects_play_in_a_program
is! 'delay_time = beat(1/4)
reverb_mix = 0.2
distortion = 0.3
play(C4, 50ms)
1' 1
