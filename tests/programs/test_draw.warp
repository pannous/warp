# generated by scripts/is_tests.py from test_draw.rs: edit the Rust test, then run the script again

# colors_are_numbers_with_an_alpha_byte
is! 'use draw
rgb(255, 0, 0) == red' true
is! 'use draw
hsv(120, 1, 1) == rgb(0, 255, 0)' true
is! 'use draw
hsv(0, 1, 1) == red' true
is! 'use draw
alpha_of(with_alpha(blue, 0.5))' 128

# shapes_set_the_pixels_they_cover
is! 'use draw
canvas(3, 3)
dot(1, 1, red)
canvas_pixels[4] == red' true
is! 'use draw
canvas(9, 9)
circle(4.5, 4.5, 2, blue)
[canvas_pixels[4 * 9 + 4] == blue, canvas_pixels[0]]' [1, 0]
is! 'use draw
canvas(4, 4)
rect(1, 1, 2, 2, green)
count(canvas_pixels.filter(p => p == green))' 4
is! 'use draw
canvas(5, 5)
line(0, 0, 4, 4, black)
count(canvas_pixels.filter(p => p == black))' 5

# a_color_with_alpha_mixes_with_what_is_below
is! 'use draw
canvas(1, 1)
clear(white)
dot(0, 0, with_alpha(black, 0.5))
canvas_pixels[0] == rgb(127, 127, 127)' true
is! 'use draw
canvas(1, 1)
clear(red)
dot(0, 0, with_alpha(blue, 0))
canvas_pixels[0] == red' true

# with_alpha_is_a_method_of_a_color
is! 'use draw
alpha_of(blue.with_alpha(0.5))' 128
is! 'use draw
c = hsv(30, 1, 1)
c.with_alpha(0.5) == with_alpha(c, 0.5)' true
