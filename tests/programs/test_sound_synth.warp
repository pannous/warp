# the_envelope_rises_decays_sustains_and_releases
is! 'use sound
attack = 0.01
decay = 0.01
sustain = 0.5
release = 0.1
round(envelope(110, 22050) * 100)' 50
is! 'use sound
attack = 0.01
decay = 0.01
sustain = 0.5
release = 0.1
round(envelope(330, 22050) * 100)' 75
is! 'use sound
attack = 0.01
decay = 0.01
sustain = 0.5
release = 0.1
round(envelope(2000, 22050) * 100)' 50
is! 'use sound
attack = 0.01
decay = 0.01
sustain = 0.5
release = 0.1
round(envelope(22050 - 1 - 1102, 22050) * 100)' 25
is! 'use sound
envelope(0, 100) + envelope(99, 100) == 0' true

# noise_is_a_wave
is! 'use sound
xs = [wave("noise", 0.25) for i in 0..100]
min(xs) >= -1 and max(xs) <= 1 and min(xs) < max(xs)' true
is! 'wave_shape = "noise"
play(C4, 5ms)
7' 7

# gain_in_decibels
is! 'use sound
x = dB(-6)
round(x * 1000)' 501
is! 'use sound
decibels(20)' 10.0
is! 'use sound
round(dB(-6) * 1000)' 501
is! 'loudness = dB(-20)
play(C4, 5ms)
loudness' 0.1
