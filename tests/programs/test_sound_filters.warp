# generated by scripts/is_tests.py from test_sound_filters.rs: edit the Rust test, then run the script again

# tremolo_swells_the_gain
is! 'use sound
tremolo = 1.0
s = chord_samples([440], 0.3, "sine")
max([abs(x - sample_offset) for x in s[2700..2810]]) < 100' true
is! 'use sound
tremolo = 1.0
s = chord_samples([440], 0.3, "sine")
max([abs(x - sample_offset) for x in s[5400..5600]]) > 5000' true

# vibrato_bends_the_pitch
is! 'use sound
phase(440, 22050)' 440
is! 'use sound
vibrato = 1.0
phase(440, 22050 / 20) > 22.5' true

# unison_voices_are_detuned
is! 'use sound
unison = 3
detune = 0.2
v = voices_of([440])
count(v) == 3 and v[1] == 440 and v[0] < 440 and v[2] > 440' true
is! 'unison = 2
play(C4, 5ms)
1' 1

# a_program_variable_named_out_survives_the_filter
is! 'use sound
out = [1]
filtered([0.1, 0.2])
out.push(2)
count(out)' 2
is! 'use sound
out = 7
chord_samples([440], 0.01, "sine")
out + 1' 8
is! 'use sound
out = {}
out.x = 3
chord_samples([440], 0.01, "sine")
out.x' 3
