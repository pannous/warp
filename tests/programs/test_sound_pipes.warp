# generated by scripts/is_tests.py from test_sound_pipes.rs: edit the Rust test, then run the script again

# an_oscillator_is_a_signal_value
is! 'use sound
count(osc(440Hz, 0.1s))' 2205
is! 'use sound
count(osc([C4, E4], 0.1s, "square"))' 2205

# a_delay_node_adds_echoes
is! 'use sound
count(osc(440, 0.1s) |> delay(0.1, 0.5)) > 2205 + 2 * 2205' true

# a_lowpass_node_takes_the_highs
is! 'use sound
energy(signal) := sum([x * x for x in signal])
high = osc(5000, 0.05s)
energy(high |> lowpass(500)) < energy(high) / 10' true
is! 'use sound
energy(signal) := sum([x * x for x in signal])
low = osc(100, 0.05s)
energy(low |> lowpass(5000)) > energy(low) / 2' true

# nodes_chain
is! 'use sound
count(osc(C4, 0.1s) |> distort(0.5) |> highpass(200) |> reverb(0.3) |> gain(0.5)) > 2205' true

# a_mix_sums_signals_to_the_longest
is! 'use sound
count(mix(osc(C4, 0.1s), osc(E4, 0.2s)))' 4410
is! 'use sound
a = osc(C4, 0.1s)
max(mix(a, a, a)) == 3 * max(a)' true

# out_plays_a_signal
is! 'use sound
osc(C4, 5ms) |> lowpass(800) |> out
7' 7
