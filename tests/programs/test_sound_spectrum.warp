# a_tone_fills_its_own_band
is! 'use sound
bars = spectrum(chord_samples([A4], 0.1, "sine"), 0.02, 8)
bars[nearest_band(A4, 8)] == max(bars)' true
is! 'use sound
bars = spectrum(chord_samples([C3], 0.1, "sine"), 0.02, 8)
bars[nearest_band(C3, 8)] == max(bars)' true
is! 'use sound
count(spectrum(chord_samples([A4], 0.1, "sine"), 0.02, 12))' 12

# silence_and_the_end_are_empty
is! 'use sound
max(spectrum([sample_offset for i in 0..2000], 0, 4)) == 0' true
is! 'use sound
max(spectrum(chord_samples([A4], 0.1, "sine"), 5, 4)) == 0' true
