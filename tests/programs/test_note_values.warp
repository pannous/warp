# generated by scripts/is_tests.py from test_note_values.rs: edit the Rust test, then run the script again

# a_note_value_prints_as_its_name
is! 'use sound
note(C4)' 'C4'
is! 'use sound
note(C♯4)' 'C#4'
is! 'use sound
note("Eb5")' 'D#5'
is! 'use sound
note(445Hz)' 'A4+20c'
is! 'use sound
note(435Hz)' 'A4-20c'
is! 'use sound
n = note(C4)
n.key' 60
is! 'use sound
n = note(C4)
n.octave()' 4
is! 'use sound
n = note(C♯4)
n.name()' 'C#'

# semitones_move_a_note
is! 'use sound
note(C♯4) + 2' 'D#4'
is! 'use sound
n = note(C4)
m = n + 7
m' 'G4'
is! 'use sound
note(E4) - 4 == note(C4)' true
is! 'use sound
interval(C4, G4)' 7

# a_note_value_plays_as_its_frequency
is! 'use sound
note(A4).hertz()' 440
is! 'use sound
play(note(A4), 5ms)
play([note(C4), note(E4)], 5ms)
7' 7

# note_names_stay_with_play_alone
is! 'play(C4, 5ms)
play([C4 E4], 5ms)
7' 7

# a_class_printing_method_keeps_is_text
is! 'class N { k: int
 text() := "n" }
f(x) := if x is text then 1 else 2
f("a")' 1
