chord(C4, major7) == [C4, E4, G4, B4]' true
is! 'use sound
chord(A3, "minor") == [A3, C4, E4]' true
is! 'use sound
scale(D4, dorian) == [D4, E4, F4, G4, A4, B4, C5, D5]' true
is! 'use sound
play(chord(C4, minor), 5ms)
melody(scale(C4, major), 5ms)
count(scale(A2, pentatonic))' 6
