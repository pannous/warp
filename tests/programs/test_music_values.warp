# the_tuning_tunes_every_note
is! 'tuning = 442
play(A4, 5ms)
A4' 442
is! 'tuning = 432
play(440Hz, 5ms)
A3' 216
is! 'use sound
midi_hertz(60)' 261.63

# a_frequency_reads_as_its_note
is! 'use sound
midi(C4)' 60
is! 'use sound
midi(440Hz)' 69
is! 'use sound
note_name(Eb4)' 'D#4'
is! 'use sound
