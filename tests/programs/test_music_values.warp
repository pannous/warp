# transposing_moves_notes_by_semitones
is! 'use sound
transpose(A4, 12)' 880
is! 'use sound
transpose(C4, 12) == C5' true
is! 'use sound
transpose([A4, A3], -12) == [A3, A2]' true
is! 'use sound
round(transpose(300Hz, 12))' 600

# chords_and_scales_are_lists_of_notes
