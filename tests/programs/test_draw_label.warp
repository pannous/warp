# generated by scripts/is_tests.py from test_draw_label.rs: edit the Rust test, then run the script again

# a_label_covers_pixels_in_its_color
is! 'use draw
canvas(60, 24)
label(0, 0, "Hi", red, 20)
count(canvas_pixels.filter(p => p == red)) > 20' true
is! 'use draw
canvas(60, 24)
label(0, 0, "Hi", red, 20)
count(canvas_pixels.filter(p => p != 0 and p != red)) > 0' true

# text_coverage_grows_with_the_size_and_the_words
is! 'text_coverage("Hi", 32)[0] > text_coverage("Hi", 16)[0]' true
is! 'text_coverage("Hi there", 16)[0] > text_coverage("Hi", 16)[0]' true
is! 'c = text_coverage("Hi", 16)
count(c) == 2 + c[0] * c[1]' true
