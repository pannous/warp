# new
is! 'class P { x=0; init(x) { self.x = x } }; P(3).x' 3

# a_constructor_alias_called_as_a_method_stays_a_method
is! 'class P { x=1; new(k) := P(x + k) }; p = P(1); p.new(2).x' 3
is! 'class P { x=1; Create(k) := P(x * k) }; P(2).Create(3).x' 6

# positional_braces_build_a_known_class
is! 'type Point struct {
    X int
    Y int
}
Point{1, 2}.Y' 2

# init_defined_with_colon_equals_is_the_constructor
is! 'class S{n:int; init(k) := { n = k * 2 }}; S(4).n' 8
is! 'class S{items:list; init(xs) := { items = []; for x in xs { if not (x in items) { items.add(x) } } }}; count(S([1 2 2 3]).items)' 3

# a_loop_in_init_keeps_its_variables_local
is! 'class C{keys=[]; init(xs) := { for x in xs { i = x in keys; if not i { keys.add(x) } } }; last() := { best = 0; for i in 1 to count(keys) { best = keys#i }; best }}; C([7 8 8]).last()' 8
is! 'class C{keys=[]; init(xs) := { for x in xs { i = x in keys; if not i { keys.add(x) } } }; last() := { best = 0; for i in 1 to count(keys) { best = keys#i }; best }}; count(C([7 8 8]).keys)' 2
