# generated by scripts/is_tests.py from test_construction_defaults.rs: edit the Rust test, then run the script again

# a_construction_default_is_an_instance
is! 'class Point { x: int }; class A { p: Point = Point(0) }; a = A(); a.p.x' 0
is! 'class Point { x: int }; class A { p: Point = Point(0) }; A{}.p.x' 0
is! 'class Point { x: int }; class B { q: Point = Point{x: 7} }; B().q.x' 7

# each_instance_gets_its_own_default
is! 'class Point { x: int }; class A { p: Point = Point(0) }; a = A(); b = A(); a.p.x = 5; b.p.x' 0
is! 'class Point { x: int }; class A { p: Point = Point(0) }; a = A(); a.p.x = 5; a.p.x' 5

# a_nested_construction_default_is_constructed_too
is! 'class Point { x: int = 3 }; class A { p: Point = Point() }; class C { a: A = A() }; C().a.p.x' 3
