# test_nested_type_applications
is! 'x:list<list<int>>=[[1], [2]]; type(x)' 'list of list of int'
is! 'x:list of list of int=[[1], [2]]; type(x)' 'list of list of int'

# test_type_of_a_literal_list_stays
is! 'type([1 2 3])' 'list of int'

# test_comparisons_and_shifts_are_not_type_applications
is! 'a=1;b=2;a < b' true
is! 'a=1;b=2;a > b' false
is! 'a=3;b=2;a >= b' true
is! '1 << 3' 8
is! '1<<3' 8
