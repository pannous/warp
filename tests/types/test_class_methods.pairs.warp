# generated by scripts/is_tests.py from test_class_methods.rs: edit the Rust test, then run the script again

# a_method_in_the_class_body_reads_the_fields
'class person{name; greet() := "hi " + self.name}; greet(person("Bo"))' 'hi Bo'
'class person{name; shout() := this.name + "!"}; person("Bo").shout()' 'Bo!'

# a_method_without_parentheses_is_read_like_a_field
'class square{side:int; area := side*side}; square(3).area' 9
'class square{side:int; area := side*side}; s = square(4); s.area + s.side' 20

# a_method_assigning_its_receiver_says_so
'class counter{n:int; inc() := n += 1}; c = counter(0); c.inc(); c.n' 1

# keyword_methods_in_a_class_body
'class Square{side:int; def area() -> int { side * side }}; Square(3).area()' 9
'class Square{side:int; def scaled(k) { side * k }}; Square(3).scaled(2)' 6

# a_method_may_be_named_like_a_type_word
'class C{x:int; double() := x*2}; C(2).double()' 4
'class C{x:int; double() := x*2; quad() := double() * 2}; c = C(3); c.quad()' 12
'class C{x:int; double() := x*2}; type(double(3))' 'float'

# a_field_in_an_interpolated_text_of_a_method
'class B{n:int; f() := "#\\(n)"}; B(3).f()' '#3'
'class B{n:int; f() := "${n * 2}!"}; B(3).f()' '6!'

# a_python_style_def_method_without_parameters_is_found
'class P{x:int; def f(): x + 1}; P(3).f()' 4
'class P{x:int; def f(): return x + 1}; P(3).f()' 4
'class P{x:int; def f(): x + 1; def g(): f() * 2}; P(3).g()' 8
'class P{x:int; def add(n): x + n}; P(3).add(2)' 5
