# a_subclass_has_the_fields_and_methods_of_its_parent
is! 'class animal{name; speak() := name + " makes a sound"; describe() := "I am " + name}; class dog extends animal{speak() := name + " barks"}; dog("Rex").describe()' 'I am Rex'
is! 'class animal{name; speak() := name + " makes a sound"; describe() := "I am " + name}; class dog extends animal{speak() := name + " barks"}; dog("Rex").name' 'Rex'

# a_subclass_overrides_a_method
is! 'class animal{name; speak() := name + " makes a sound"; describe() := "I am " + name}; class dog extends animal{speak() := name + " barks"}; dog("Rex").speak()' 'Rex barks'
is! 'class animal{name; speak() := name + " makes a sound"; describe() := "I am " + name}; class dog extends animal{speak() := name + " barks"}; animal("Cat").speak()' 'Cat makes a sound'

# a_subclass_adds_fields
is! 'class point{x:int y:int; sum() := x + y}; class point3 extends point{z:int; sum() := x + y + z}; point3(1, 2, 3).sum() + point(1, 2).sum()' 9

# a_subclass_instance_is_accepted_where_the_parent_is_wanted
is! 'class animal{name; speak() := name + " makes a sound"; describe() := "I am " + name}; class dog extends animal{speak() := name + " barks"}; greet(a:animal) := "hello " + a.name; greet(dog("Rex"))' 'hello Rex'
