# a_field_of_a_list_element_changes
is! 'class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; bags#1.n = 5; bags#1.n' 5
is! 'class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; bags#1.n += 2; bags#1.n' 3
is! 'class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; bags#1.items.add("b"); first = bags#1; #first.items' 2
is! 'class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; bags#1.items#1 = "z"; first = bags#1; first.items#1' 'z'
is! 'class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; i = 1; bags#i.n = 7; bags#1.n' 7

# a_list_field_of_an_element_checks_its_items
is! 'same(y) := y; class bag { n: int; items: texts }; bags = [bag(1, ["a"])]; bags#1.items.add(same("b")); first = bags#1; #first.items' 2
