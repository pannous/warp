# generated by scripts/is_tests.py from test_time_now.rs: edit the Rust test, then run the script again

# test_time_is_the_type_and_time_now_the_time_of_day
'type(time.now)' 'time of day'
'time.now is time' true
'time.now.hour == now.hour' true
'time = 3; time' 3

# test_now_has_a_time_of_day_and_a_date
'type(now.time)' 'time of day'
'type(now.date)' 'date'
'now.time.minute == now.minute' true
'now.date.year == now.year' true
'str(2026-10-14T22:27:46.5.time)' '22:27:46'
'str(2026-10-14T22:27.time)' '22:27:00'
'str(2026-10-14T22:27.date)' '2026-10-14'

# test_a_time_of_day_goes_round_the_clock
'str(2026-10-14T23:00.time + 2 hours)' '01:00:00'
'later = now.time + 24 hours; later.hour == now.hour' true

# test_clock_reads_compare
'now <= now' true
'x = now; x <= now' true
