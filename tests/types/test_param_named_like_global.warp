# a_parameter_named_like_an_instance_variable_compares_as_its_own_value
is! 'class V {n:int; equals(o:V) := n == o.n}
f(a, b) := if a == b then a + "²" else a + "·" + b
a = V(1)
f("m", "m")' 'm²'
is! 'unit_product(a, b) := if a == b then a + "²" else a + "·" + b
a = quantity(2, "m") * quantity(3, "m")
unit_product("m", "s")' 'm·s'

