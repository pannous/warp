# a_change_in_a_branch_keeps
is! 'class C { items = []
 put(x) := { if not (x in items) { items.add(x) } }
}
c = C(); c.put(1); c.put(2); c.put(1); count(c.items)' 2

# init_defined_with_colon_equals_is_the_constructor
is! 'class C { items = []
 put(x) := { if not (x in items) { items.add(x) } }
 init(xs) := { for x in xs { put(x) } }
}
count(C([1, 2, 1]).items)' 2

