# generated by scripts/is_tests.py from test_partial_time_comparisons.rs: edit the Rust test, then run the script again

# test_now_against_a_time_of_day
is! 'now < 24h' true
is! 'now >= 0h' true
is! '(now < 17h) == (now.hour < 17)' true

# test_now_against_a_month
is! 'now >= January' true
is! 'now <= December' true
is! '(now >= October) == (now.month >= 10)' true
is! 'now ≈ January or now ≈ February or now.month > 2' true

# test_now_against_a_date
is! 'now ≈ 1970-01-01' false
is! 'now > 1970-01-01' true
is! 'now < 2999-01-01' true
is! '2999-01-01 > now' true

# test_the_users_draft_lines
is! '(now > 17h) == (now.hour >= 17)' true
is! '(now >= 17h) == (now.hour >= 17)' true
is! 'time == now' false

# test_own_names_stay
is! 'October = 3; October + 1' 4
