# generated by scripts/is_tests.py from test_records_classes.rs: edit the Rust test, then run the script again

# a_record_is_a_struct
is! 'record point{x:int y:int}; point(1,2).y' 2
is! 'record point{x:int y:int}; p=point(1,2); p.x+p.y' 3

# a_class_has_untyped_fields
is! 'class contact {name email}; c=contact("Joe" "j@x"); c.name' 'Joe'
is! 'class contact {name email}; contact("Joe" "j@x").email' 'j@x'
is! 'class pair {a b}; p=pair(1 2); p.a+p.b' 3

# an_optional_field_defaults_to_null
is! 'class contact {name email?}; contact("Joe" "j@x").email' 'j@x'
is! 'class contact {name email?}; contact("Joe").name' 'Joe'

# an_enum_names_its_cases_by_index
is! 'enum color {red green blue}; color.red as int' 0
is! 'enum color {red green blue}; color.green as int' 1

# record_stays_usable_as_a_variable_name
is! 'record=5; record+1' 6
is! 'value_of(record):=record*2; value_of(4)' 8

# a_class_declares_a_nested_block_of_fields
is! 'class contact {
 name
 email?
 phone?
 address {
  street
  city
  zip?
 }
}
c = contact{name:"Ann" address:{street:"Main" city:"X"}}
c.address.city' 'X'
is! 'class contact {
 name
 email?
 phone?
 address {
  street
  city
  zip?
 }
}
c = contact{name:"Ann" address:{street:"Main" city:"X"}}
c.name' 'Ann'

# a_constructor_takes_named_arguments_as_functions_do
is! 'class P { x: int; y: int }; p = P(y=2, x=7); p.x * 10 + p.y' 72
is! 'class P { x: int; y: int }; p = P(7, y=2); p.x * 10 + p.y' 72
is! 'class P { x: int; y: int }; p = P(y: 2, x: 7); p.x * 10 + p.y' 72
is! 'class P { x: int; y = 5 }; p = P(x=7); p.x * 10 + p.y' 75
