# generated by scripts/is_tests.py from test_class_json.rs: edit the Rust test, then run the script again

# to_json_of_an_instance_is_its_fields
is! 'use json; class Point{x:int y:int}; to_json(Point(1, 2))' '{"x":1,"y":2}'
is! 'use json; class Point{x:int y:int}; to_json([Point(1, 2), Point(3, 4)])' '[{"x":1,"y":2},{"x":3,"y":4}]'
is! 'use json; class Point{x:int y:int}; class Line{a:Point b:Point}; to_json(Line(Point(1, 2), Point(3, 4)))' '{"a":{"x":1,"y":2},"b":{"x":3,"y":4}}'

# an_instance_from_json
is! 'use json; class Point{x:int y:int}; p = parse_json("{\\"x\\":1,\\"y\\":2}") as Point; p.x * 10 + p.y' 12
is! 'use json; class Point{x:int y:int}; p = Point.from_json("{\\"x\\":3,\\"y\\":4}"); p.y' 4
is! 'class Point{x:int y:int}; p = {x:1 y:2} as Point; p.y' 2
is! 'use json; class Point{x:int y:int}; class Line{a:Point b:Point}; l = Line.from_json("{\\"a\\":{\\"x\\":1,\\"y\\":2},\\"b\\":{\\"x\\":3,\\"y\\":4}}"); l.b.x' 3

# a_roundtrip_through_json
is! 'use json; class Point{x:int y:int}; p = Point.from_json(to_json(Point(5, 6))); p.x + p.y' 11

# other_languages_serializers_are_to_json
is! 'use json; class Point{x:int y:int}; JSON.stringify(Point(1, 2))' '{"x":1,"y":2}'
is! 'class Point{x:int y:int}; d = dataclasses.asdict(Point(1, 2)); d.y' 2
is! 'use json; class Point{x:int y:int}; Json.encodeToString(Point(1, 2))' '{"x":1,"y":2}'
is! 'use json; @Serializable data class Point(val x: Int, val y: Int)
to_json(Point(1, 2))' '{"x":1,"y":2}'

# lists_of_instances_from_json
is! 'use json; class Point{x:int y:int}; ps = parse_json("[{\\"x\\":1,\\"y\\":2},{\\"x\\":3,\\"y\\":4}]") as [Point]; ps#2.x' 3
is! 'use json; class Point{x:int y:int}; class Poly{points:[Point]}; p = Poly.from_json(to_json(Poly([Point(1, 2), Point(5, 6)]))); p.points#2.y' 6

# a_named_instance_from_json_is_of_its_class
is! 'use json; class Todo{title: text}; todos: [Todo] = parse_json("[{\\"Todo\\":{\\"title\\":\\"tea\\"}},{\\"Todo\\":{\\"title\\":\\"milk\\"}}]"); todos#2.title' 'milk'
is! 'use json; class Todo{title: text}; todos: [Todo] = parse_json("[{\\"Todo\\":{\\"title\\":\\"tea\\"}},{\\"Todo\\":{\\"title\\":\\"milk\\"}}]"); titles = []; for todo in todos { titles.add(todo.title) }; titles#1 + titles#2' 'teamilk'
