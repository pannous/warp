# a_symbol_parameter_takes_a_symbol
is! 'f(m: symbol) := m == :post; f(:post)' true
is! 'f(m: symbol) := m; y = :post; f(y) == :post' true
is! '"post" as symbol == :post' true

# a_symbol_parameter_takes_a_bare_word
is! 'f(m: symbol) := m == :post; f(post)' true
is! 'form(method: symbol, action: text) := "\\(method) \\(action)"; form post "/todos"' 'post /todos'
