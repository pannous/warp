# generated by scripts/is_tests.py from test_class_cases_ported.rs: edit the Rust test, then run the script again

# fields_have_defaults
'class point{x:int=0; y:int=0}; point().x + point(3).x'	3
'class point{x:int=1; y:int=2}; p = point(); p.y'	2

# methods_read_fields_with_or_without_self
'class rect{w:int; h:int; area() := w * h}; rect(3, 4).area()'	12

# a_subclass_method_calls_an_inherited_method_without_self
'class a{x:int; f() := x}; class b extends a{g() := f() + 1}; b(1).g()'	2

# a_subclass_instance_is_its_parent_type
'class animal{name}; class dog extends animal{}; dog("Rex") is animal'	true
'class animal{name}; class dog extends animal{}; animal("Cat") is dog'	false

# instances_compare_by_value
'class point{x:int; y:int}; point(1, 2) == point(1, 2)'	true
'class point{x:int; y:int}; point(1, 2) == point(2, 1)'	false

# objects_change_and_copy
'class person{name; age:int}; p = person("Ann", 40); p.age = 41; p.age'	41

# objects_hold_objects
'class engine{hp:int}; class car{e:engine}; car(engine(90)).e.hp'	90
'class person{name; age:int}; person{name:"Ann" age:3}.age'	3

# a_method_reads_a_field_with_a_default
'class Point{x:int=1; f() := x}; Point().f() + Point(5).f()'	6
'class Circle{r:int; k = 3; f() := k * r}; Circle(2).f()'	6

# static_members_belong_to_the_class
'class Circle{r:int; static k = 3}; Circle.k + Circle(1).k'	6
'class Circle{r:int; static k = 3; area() := k * r}; Circle(2).area()'	6

# an_object_has_one_text_form
