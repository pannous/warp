# generated by scripts/is_tests.py from test_traits.rs: edit the Rust test, then run the script again

# test_builtin_kinds_stay_comparable
is! '(sort ["b" "a"])#1' 'a'
is! '(sort [3 1 2])#1' 1
is! '(sort [2.5 1 3])#2' 2.5

# test_conformance_is_a_type_test
is! '3 is Comparable' true
is! '"a" is Comparable' true
is! '[1 2] is Comparable' false

# test_an_explicit_conformance_claim_needs_the_operation
is! 'class dot{x:int} is Comparable; compare(a:dot, b:dot) := a.x - b.x; first = (sort [dot(2) dot(1)])#1; first.x' 1

# test_a_claim_of_a_declared_trait_is_checked
is! 'trait shape{area}; class dot{x:int} is shape; area(d:dot) := d.x; area(dot(4))' 4
