# generated by scripts/is_tests.py from test_class_mixins.rs: edit the Rust test, then run the script again

# a_class_takes_in_a_mixin
is! 'mixin Walker{steps:int=0; walk() := name + " walks"}; class Duck with Walker{name}; Duck("Don").walk()' 'Don walks'
is! 'mixin Walker{steps:int=0; walk() := name + " walks"}; class Duck{name; include Walker}; Duck("Don").walk()' 'Don walks'
is! 'mixin Walker{steps:int=0; walk() := name + " walks"}; class Duck with Walker{name}; Duck("Don").steps' 0

# a_class_takes_in_several_mixins_and_overrides
is! 'mixin Walker{steps:int=0; walk() := name + " walks"}; mixin Swimmer{swim() := name + " swims"}; class Duck with Walker, Swimmer{name}; Duck("Don").swim()' 'Don swims'
is! 'mixin Walker{steps:int=0; walk() := name + " walks"}; class Duck with Walker{name; walk() := "waddles"}; Duck("Don").walk()' 'waddles'
