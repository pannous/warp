# a_list_item_is_the_instance_itself
is! 'class Point { x: int }; ps = [Point(1), Point(2)]; for p in ps { p.x += 10 }; ps#2.x' 12

# a_function_changes_the_instance_it_is_given
is! 'class Point { x: int }; f(q: Point) := q.x = 7; p = Point(1); f(p); p.x' 7
is! 'class Point { x: int }; f(q) := { r = q; r.x = 9 }; p = Point(1); f(p); p.x' 9

# each_construction_is_a_new_instance
is! 'class Point { x: int }; f() := { p = Point(0); p.x += 1; p.x }; f() + f()' 2
is! 'class Point { x: int }; s = 0; for i in [1, 2, 3] { p = Point(0); p.x += i; s += p.x }; s' 6

# a_new_field_grows_the_same_instance
is! 'class Point { x: int; y: int }; p = Point(1, 2); q = p; q.color = "red"; p.color' 'red'
