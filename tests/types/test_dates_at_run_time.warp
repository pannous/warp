# generated by scripts/is_tests.py from test_dates_at_run_time.rs: edit the Rust test, then run the script again

# test_instants_compare_at_run_time
is! 'a = now; b = now; b >= a' true
is! 'a = now; b = now; a <= b and not (b < a)' true
is! 't = now; u = t; t == u' true

# test_an_instant_has_the_local_wall_clock
is! 't = now; t.hour >= 0 and t.hour < 24 and t.year >= 2026' true

# test_field_of_a_grouped_time_expression
is! '((now + 1 hour).hour - now.hour + 24) % 24' 1
is! '((now - 30 minutes).minute - now.minute + 60) % 60' 30
is! '(now + 1 hour).year >= 2026' true
