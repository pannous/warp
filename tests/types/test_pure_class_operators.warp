# card pure-class-operators: an operator between instances calls the method its class defines for it, named by the
# operator's glyph, its word or an alias of the word (lib/aliases.warp: `+` is add, also plus); any other value keeps
# the builtin operator (run-time instances: `warp test tests/types` runs them through warp pure, `warp test --self
# tests/types` through warp self)

# an_operator_calls_the_method_of_its_word
is! "class V { x: int; y: int; plus(o) := V(x + o.x, y + o.y) }
(V(1, 2) + V(3, 4)).y" 6
is! "class V { x: int; add(o) := V(x + o.x) }
(V(1) + V(2)).x" 3
is! "class V { x: int; minus(o) := V(x - o.x) }
(V(5) - V(2)).x" 3
is! "class V { x: int; times(k) := V(x * k) }
a = V(2)
(a * 3).x" 6

# an_operator_calls_the_method_of_its_glyph
is! "class V { x: int; +(o) := V(x + o.x) }
(V(1) + V(2)).x" 3
is! "class V { x: int; operator +(o) := V(x + o.x) }
(V(1) + V(2)).x" 3

# a_chain_of_operators_on_instances
is! "class V { x: int; plus(o) := V(x + o.x) }
a = V(1)
(a + a + a).x" 3

# numbers_keep_the_builtin_operator
is! "class V { x: int; plus(o) := V(x + o.x) }
t = 0
for n in [1, 2] { t = t + n + n }
t" 6
is! "class V { x: int; plus(o) := V(x + o.x) }
\"a\" + \"b\"" "ab"

# the_class_of_the_instance_picks_the_method
is! "class V { x: int; plus(o) := V(x + o.x) }
class W { y: int; plus(o) := W(y - o.y) }
t = 0
for q in [V(1), W(9)] { r = q + q; t = t * 100 + (r is V ? r.x : r.y) }
t" 200

# a_subclass_inherits_the_operator
is! "class V { x: int; plus(o) := V(x + o.x) }
class U extends V { z: int }
(U{x: 1, z: 0} + U{x: 2, z: 0}).x" 3
