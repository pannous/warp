# generated by scripts/is_tests.py from test_checked_call_kinds.rs: edit the Rust test, then run the script again

# a_declared_parameter_takes_its_subtypes
is! 'f(x: text) := x; f("a")' 'a'
is! 'f(x: number) := x * 2; f(3)' 6
is! 'f(x: float) := x; f(2)' 2.0
is! 'f(x: int) := x + 1; f(true)' 2
is! 'f(x: any) := x; f("a")' 'a'
is! 'f(x: int) := x + 1; f([1])#1' 2

# a_variable_keeps_the_kind_of_a_call_result
is! 'f(x: int) := x + 1; y = f(2); y = 7; y' 7
is! 'f(x: int) := x + 1; y = f(2); y = 1.5; y' 1.5

# a_declared_list_parameter_refuses_other_elements
is! 'f(xs: texts) := count xs; f(["a", "bc"])' 2
is! 'f(xs: numbers) := count xs; f([1, 2.5])' 2
is! 'f(xs: floats) := count xs; f([1, 2])' 2
is! 'f(xs: ints) := count xs; f([])' 0

# a_map_parameter_refuses_a_plain_value
is! 'g(m: map) := m.a; g({a:1})' 1

# a_map_parameter_takes_the_empty_map
is! 'g(m: map): int := { m["k"] = 2; m["k"] }; g({})' 2
is! 'g(m: map): int := #m; g({})' 0
