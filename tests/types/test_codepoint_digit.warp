# generated by scripts/is_tests.py from test_codepoint_digit.rs: edit the Rust test, then run the script again

# a_variable_casts_like_its_literal
is! '5 as codepoint' '5'
is! 'x = 5; x as codepoint' '5'
is! 'x = 65; x as codepoint' 'A'

# a_number_naming_no_code_point_is_an_error
is! 'x = 55296; try (x as codepoint) else "fallback"' 'fallback'

# a_character_of_a_text_casts_to_itself
is! 's = "ab"; s#2 as codepoint' 'b'
is! 's = "ab"; s[1] as char' 'b'
is! 'h(s: text, at: int): codepoint := s[at]; h("ab", 1)' 'b'
is! 'g(c: codepoint): codepoint := c; s = "ab"; g(s#2)' 'b'
