# `now` in the pure lane (card merge-pure-now): lib/time.warp's class Instant, milliseconds since 1970, read from the
# wall clock by its one hook into the host (wall_clock_ms, WASI's clock_time_get); ordering, difference, adding a
# duration and the RFC 3339 text are plain warp methods of the class (`warp test tests/types` runs them through warp
# pure, `warp test --self tests/types` through warp self)

# two_readings_of_the_clock_are_ordered
is! "a = now; b = now; b >= a" yes
is! "a = now; [a < a + 1, a == a, a != a + 1, a > a - 1]" [yes, yes, yes, yes]

# the_difference_of_two_instants_is_milliseconds
is! "a = now; (a + 1500) - a" 1500
is! "(Instant(1761392620007) + 3).ms" 1761392620010

# an_instant_shows_in_rfc_3339_without_trailing_zeros
is! "'at ' + Instant(1761392620692)" "at 2025-10-25T11:43:40.692Z"
is! "'at ' + Instant(1761392620500)" "at 2025-10-25T11:43:40.5Z"
is! "'at ' + Instant(1761392620050)" "at 2025-10-25T11:43:40.05Z"
is! "'at ' + Instant(1761392620000)" "at 2025-10-25T11:43:40Z"
is! "('at ' + now).ends_with('Z')" yes
