# generated by scripts/is_tests.py from test_hex_int.rs: edit the Rust test, then run the script again

# hex_acts_as_its_int
is! '255 as hex' 255
is! 'x = 255 as hex; x + 1' 256
is! '(255 as hex) == 255' true

# a_byte_shows_as_hex
is! 'byte b = 10; b * 3' 30

# print_shows_radix_through_the_prelude
is! 'to_base(255, 16, upper: true)' 'FF'
is! 'to_base(255, 16)' 'ff'
