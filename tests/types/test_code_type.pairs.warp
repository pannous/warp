# a_function_body_is_code
'def f(x):=x+1; type f.body' 'code'
'def f(x):=x; type f.body' 'code'
'f(x):={x; x+1}; type f.body' 'code'
'def f(x):=x+1; type of ((function f).body)' 'code'
'def f(x):=x+1; b = f.body; type b' 'code'

# a_function_body_tests_as_code
'def f(x):=x+1; f.body is code' true
'def f(x):=x; f.body is code' true
'f(x):={x; x+1}; f.body is code' true
'f(x):={x; x+1}; f.body is map' false
'def f(x):=x+1; f.body is operation' true

# a_function_body_prints_its_source
'def f(x):=x+1; string(f.body)' 'x+1'
'f(x):={x; x+1}; string(f.body)' '{x; x+1}'

# parsed_code_is_code
'type parse("1+1")' 'code'
'parse("1+1").type' 'code'
'parse("1+1") is code' true
'parse("1+1").op' '+'
'1+1 is code' false
'3 is code' false
