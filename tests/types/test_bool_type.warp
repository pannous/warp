# generated by scripts/is_tests.py from test_bool_type.rs: edit the Rust test, then run the script again

# test_bool_is_a_type_of_its_own
is! 'type(true)' 'bool'
is! 'type(3 > 2)' 'bool'
is! 'true is bool' true
is! '1 is bool' false

# test_bool_acts_as_one_or_zero
is! 'x = 3 > 2; x + 1' 2
is! '0 == false' true
is! '1 == true' true

# a_bool_of_unknown_static_type_is_tested_at_run_time
is! 'h(value:any) := value is int; h(false)' false
is! 'h(value:any) := value is bool; h(false)' true
is! 'h(value:any) := value is int; h(3)' true
is! 'h(value:any) := value == 0; h(false)' true
is! 'h(value:any) := value == true; h(1)' true

# a_literal_bool_counts_in_arithmetic
is! 'true + 1' 2
is! 'true + true' 2

# a_parameter_given_bools_keeps_them
is! 'show(b) := "got " + b; show(1<2)' 'got yes'
is! 'show(b) := "got " + b; ok = 3 > 2; show(ok)' 'got yes'
is! 'show(b) := "got " + b; show(1<2); show(5)' 'got 5'
is! 'f(b) := b + 1; f(1 == 1)' 2

# a_function_returning_a_bool_local_gives_a_bool
is! 'f() := { hit = no; hit = yes; hit }; f()' true
is! 'has_any(xs) := any(xs); has_any([false, true]) == yes and type(has_any([false])) == bool' true
is! 'f() := { n = no; n += 1; n }; f()' 1
