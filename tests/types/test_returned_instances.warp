# an_instance_returned_by_a_function_takes_its_class_operators
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
a = make(1); b = make(2); (a + b).x' 3
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
twice(n) := make(n * 2)
a = twice(1); (a * 5).x' 10
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
parsed(t:text) := { n = t as int; V(n) }
a = parsed("4"); (a + make(1)).x' 5

# an_operation_of_instances_is_an_instance_too
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
c = make(1) + make(2); (c * 2).x' 6
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
a = make(1); c = a + a; d = c + a; d.x' 3

# a_parameter_shadows_an_instance_variable
is! 'class V{x:int; plus(o) := V(x + o.x); times(k) := V(x * k)}
make(n) := V(n)
a = make(1)
f(a) := a + 1
f(2) + a.x' 4

# a_declared_result_class_takes_its_class_operators
is! 'class V{x:int; less(o:V):bool := x < o.x}
make(n:int): V := V(n)
make(1) < make(2)' true
is! 'class V{x:int; less(o:V):bool := x < o.x}
make(n:int): V := V(n)
make(3) < make(2)' false
