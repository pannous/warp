# generated by scripts/is_tests.py from test_type_values.rs: edit the Rust test, then run the script again

# a_type_value_joins_as_its_class
is! '"type is " + type 3' 'type is class int'
is! 'x = int; "\\(x)"' 'class int'
is! 'x = int; x as text' 'class int'
is! 'x = 3; "" + type(x) == "class int"' true

# the_type_of_a_type_value_is_type
is! 'x = int; type x' 'type'
is! 'type(int)' 'type'
is! 'f(t: type) := type(t); f int' 'type'

# a_type_value_still_compares_as_the_type
is! 'x = 3; type(x) == int' true
is! 'x = int; x == int' true
