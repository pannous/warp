is! 'class Stack{items:list; push(x) := items.add(x); pop() := items.pop()}; s = Stack([1 2]); s.pop(); string(s.items)' '[1]'
is! 'class Stack{items:list; push(x) := items.add(x); pop() := items.pop()}; s = Stack([]); s.push(5); s.push(6); s.pop() * 10 + s.pop()' 65

# a_block_method_changes_its_object_and_gives_a_value
is! 'class Queue{items:list; dequeue() := { x = items#1; items = items[1:]; x }}; q = Queue([4 5 6]); q.dequeue() * 10 + q.dequeue()' 45
is! 'class Queue{items:list; dequeue() := { x = items#1; items = items[1:]; x }}; q = Queue([4 5 6]); q.dequeue(); count(q.items)' 2

# a_method_changing_its_object_inside_if_gives_the_object
is! 'class Set{items:list; put(x) := { if not (x in items) { items.add(x) } }}; s = Set([]); s.put(1); s.put(1); s.put(2); count(s.items)' 2
is! 'class Set{items:list; put(x) := { if x in items { items } else { items = items + [x] } }}; s = Set([]); s.put(1); s.put(1); count(s.items)' 1

