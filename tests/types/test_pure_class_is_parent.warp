# card pure-class-methods-2: `x is Parent` is true of an instance of a class extending Parent, in a program's test and
# in the dispatcher of a method its classes override
# (run-time instances: `warp test tests/types` runs them through warp pure, `warp test --self tests/types` through
# warp self)

# an_instance_of_a_subclass_is_its_parent
is! 'class Animal { name: text }; class Dog extends Animal { breed: text }; d = Dog{name: "Rex", breed: "pug"}; d is Animal' true
is! 'class Animal { name: text }; class Dog extends Animal { breed: text }; class Puppy extends Dog { age: int }; p = Puppy{name: "Bo", breed: "pug", age: 1}; p is Animal' true
is! 'class Animal { name: text }; class Dog extends Animal { breed: text }; a = Animal{name: "Gnu"}; a is Dog' false

# a_subclass_without_its_own_override_takes_its_parents
is! 'class Animal { name: text; speak() := name + " makes a sound" }
class Dog extends Animal { speak() := name + " barks" }
class Puppy extends Dog { age: int = 1 }
Puppy{name: "Bo"}.speak()' 'Bo barks'

# a_subclass_reaches_its_parents_method_named_like_a_library_word
is! 'class Bag { items: list; sum() := 42 }
class Sack extends Bag { size: int = 1 }
Sack{items: [1]}.sum() + [1, 2].sum()' 45
