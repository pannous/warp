# test_plural_declarations_are_lists
'numbers x = [1 2]; count x' 2
'numbers x = [1 2]; type(x)' 'list of number'
'x:numbers=[1 2]; type(x)' 'list of number'

# test_declaration_with_count_times_type
'x : 100 * int; count x' 100
'x : 100 * ints; count x' 100
'x : 3 * char; count x' 3
