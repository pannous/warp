# generated by scripts/is_tests.py from test_time_zones_at_run_time.rs: edit the Rust test, then run the script again

# test_a_zoned_time_changes_zone_keeping_its_instant
is! 'z = 2024-07-01T12:00+02:00[Europe/Berlin]; print z; str(z in "America/Los_Angeles")' '2024-07-01T03:00-07:00[America/Los_Angeles]'
is! 't = 2024-07-01T10:00:00Z; z = t in "Asia/Kolkata"; print z; z.offset' 19800

# test_a_local_time_in_a_zone_resolves
is! 't = 2024-07-01T10:00; print t; str(t in "Europe/Berlin")' '2024-07-01T10:00+02:00[Europe/Berlin]'

# test_a_skipped_wall_time_is_rejected_unless_chosen
is! 't = 2024-03-31T02:30; print t; str(zoned(t, "Europe/Berlin", disambiguation: earlier))' '2024-03-31T01:30+01:00[Europe/Berlin]'
is! 't = 2024-03-31T02:30; print t; str(zoned(t, "Europe/Berlin", disambiguation: later))' '2024-03-31T03:30+02:00[Europe/Berlin]'

# test_a_repeated_wall_time_is_rejected_unless_chosen
is! 't = 2024-10-27T02:30; print t; str(zoned(t, "Europe/Berlin", disambiguation: earlier))' '2024-10-27T02:30+02:00[Europe/Berlin]'
is! 't = 2024-10-27T02:30; print t; str(zoned(t, "Europe/Berlin", disambiguation: later))' '2024-10-27T02:30+01:00[Europe/Berlin]'

# test_a_calendar_day_keeps_the_wall_time_across_a_transition
is! 'z = 2024-03-30T12:00[Europe/Berlin]; print z; str(z + 1 day)' '2024-03-31T12:00+02:00[Europe/Berlin]'
is! 'z = 2024-03-31T12:00[Europe/Berlin]; print z; str(z - 1 day)' '2024-03-30T12:00+01:00[Europe/Berlin]'
is! 'z = 2024-01-31T10:00[Europe/Berlin]; n = 6; print n; str(z + n * 1 month)' '2024-07-31T10:00+02:00[Europe/Berlin]'

# test_exact_time_keeps_the_elapsed_time_across_a_transition
is! 'z = 2024-03-30T12:00[Europe/Berlin]; print z; str(z + 24 hours)' '2024-03-31T13:00+02:00[Europe/Berlin]'
is! 'z = 2024-03-31T01:30[Europe/Berlin]; print z; str(z + 1 hour)' '2024-03-31T03:30+02:00[Europe/Berlin]'

# test_zoned_times_subtract_to_elapsed_time
is! 'a = 2024-03-31T12:00[Europe/Berlin]; b = 2024-03-30T12:00[Europe/Berlin]; print a; str(a - b)' '23 hours'
is! 'a = 2024-07-01T12:00[Europe/Berlin]; b = 2024-07-01T12:00[Europe/London]; print a; str(a - b)' '-1 hours'
