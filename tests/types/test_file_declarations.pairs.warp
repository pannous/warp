# generated by scripts/is_tests.py from test_file_declarations.rs: edit the Rust test, then run the script again

# a_file_class_takes_in_the_definitions_after_it
'class Foo; int bar(){ 42 }; int boom(){ -1 }; Foo().boom()'	-1
'class Foo; x: int; double() := x * 2; Foo(4).double()'	8

# a_namespace_qualifies_the_words_of_the_file
'namespace test; int bar(){42}; test.bar()'	42
'namespace test; int bar(){42}; bar()'	42

# a_braced_empty_class_takes_nothing_in
'class Foo {}; int bar(){42}; bar()'	42

# a_class_body_of_one_typed_method
'class Foo { int bar(){ 42 } }; Foo().bar()'	42
