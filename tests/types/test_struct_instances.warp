# generated by scripts/is_tests.py from test_struct_instances.rs: edit the Rust test, then run the script again

# a_struct_instance_gives_the_same_values
is! 'class Point{x:int; y:int}; p = Point(3, 4); p.x * p.y' 12
is! 'class Point{x:int; y:int}; p = Point(3, 4); i=0; s=0; while i<3 { s += p.x; i++ }; s' 9
is! 'class Point{x:int; y:int}; s=0; i=0; while i<3 { q = Point(i, 1); s += q.x + q.y; i++ }; s' 6
is! 'class Point{x:int; y:int}; p = Point(3, 4); string(p)' 'Point{x:3 y:4}'

# a_method_of_a_struct_variable_takes_the_struct
is! 'class Point{x:int; y:int; sum() := x + y}; p = Point(3, 4); p.sum()' 7
is! 'class Point{x:int; y:int; sum() := x + y}; Point(3, 4).sum()' 7
is! 'class Point{x:int; y:int; sum() := x + y}; ps = [Point(1, 2), Point(3, 4)]; s = 0; for p in ps { s += p.sum() }; s' 10
is! 'class Point{x:int; y:int; sum() := x + y}; f(p:Point) := p.sum() * 2; f(Point(1, 2))' 6

# a_field_write_of_a_struct_variable_sets_the_field
is! 'class Point{x:int; y:int}; p = Point(3, 4); p.x = 7; p.y += 1; p.x * p.y' 35
is! 'class Point{x:int; y:int}; p = Point(3, 4); i=0; while i<3 { p.x += i; i++ }; string(p)' 'Point{x:6 y:4}'
is! 'class Point{x:int; y:int}; p = Point(3, 4); p.x++; p.y--; p.x - p.y' 1
is! 'class Point{x:int; y:int}; p = Point(3, 4); q = p; q.x = 9; p.x' 9

# an_int_field_holds_any_int
is! 'class Big{n:int}; b = Big(2^70); b.n + 1 == 2^70 + 1' 1
is! 'class Big{n:int}; b = Big(1); b.n = 2^70; b.n * 2 == 2^71' 1

# a_method_changing_its_struct_variable_keeps_the_struct
is! 'class Counter{n:int; inc() := n += 1}; c = Counter(0); i=0; while i<5 { c.inc(); i++ }; c.n' 5
is! 'class Counter{n:int; inc() := n += 1}; c = Counter(0); d = c; c.inc(); d.n' 1
is! 'class Counter{n:int; inc() := n += 1}; c = Counter(1); d = inc(c); c.n * 10 + d.n' 22

# a_field_of_an_instance_in_a_list_is_found_by_its_written_name
is! 'class Point{x:int; y:int}; ps = [Point(1, 2), Point(3, 4)]; s = 0; for p in ps { s += p.x + p.y }; s' 10
is! 'class P{x:int}; f() := P(4); f().x' 4

# a_hyphenated_field_of_an_instance
is! 'class person{phone-number:text}; p = person{phone-number:"12"}; p.phone-number' '12'
is! 'class person{phone-number:text}; p = person{phone-number:"12"}; p.phone-number = "3"; p.phone-number' '3'

# a_quoted_field_of_an_instance
is! 'class P{"my field":int}; p = P{"my field":1}; p["my field"]' 1
