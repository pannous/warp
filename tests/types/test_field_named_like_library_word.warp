# a_known_instance_reads_its_field
is! 'class person { first: text; last: text }
n = person("Ada", "Lovelace")
n.first' 'Ada'
is! 'class person { first: text; last: text }
n = person("Ada", "Lovelace")
n.first + " " + n.last' 'Ada Lovelace'
is! 'class full name { first: text; last: text }
n = full name("Ada", "Lovelace")
n.last' 'Lovelace'

# a_list_keeps_the_library_word
