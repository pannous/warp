# generated by scripts/is_tests.py from test_globals.rs: edit the Rust test, then run the script again

# test_global_int_simple
is! 'global x=10; x+5' 15

# test_global_int_multiple
is! 'global x=10; global y=20; x+y' 30

# test_global_with_expression
is! 'global x=3*4; x+1' 13

# test_global_float_with_pi
is! 'global x=1+π' (1.0 + pi)
is! 'global x=1+π; x+2' (3.0 + pi)

# test_global_reassignment
is! 'global x=5; global x=10; x' 10
