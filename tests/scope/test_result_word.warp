# generated by scripts/is_tests.py from test_result_word.rs: edit the Rust test, then run the script again

# result_is_the_value_of_the_statement_before
is! '3+4; result * 2' 14
is! 'x = 5; result + 1' 6
is! 'if 1>0 : "hi" else : "ho"
result' 'hi'
is! 'f := it * 3; f 4; result' 12

# a_program_may_name_its_own_result
is! 'result = 9; 3; result' 9

# result_after_a_print_is_the_printed_value
is! 'print 7; result + 1' 8
is! 'if 1>0 : print "hi" else : print "ho"
result' 'hi'
is! 'if 1<0 : print "hi" else : print "ho"
result' 'ho'
is! 'if 1>0: { x = 2; print x * 3 } else: 0
result' 6
