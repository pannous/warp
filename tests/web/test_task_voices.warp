# the_starter_does_not_queue_behind_its_task
is! 'use sound
job = go { play(E4, 2s) }
await job
play(C4, 0.1s)
sound_queued() < 1' true

# a_task_starts_where_its_starter_stands
is! 'use sound
play(C4, 5s)
job = go { play(E4, 5s)
sound_queued() > 6 }
await job' true
