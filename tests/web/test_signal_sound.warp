# a_signal_function_plays_in_the_browser
is! 'use sound
hum(t) := 0.5 * sin(2 * pi * 441 * t)
play(hum, 0.1s)
round(save(sound, "signal.wav") * 100)' 10
is! 'use sound
left(t) := 0.5 * sin(2 * pi * 441 * t)
right(t) := 0.25 * t
play([left, right], 0.1s)
round(save(sound, "stereo.wav") * 100)' 10

# a_block_function_plays_in_the_browser
is! 'use sound
linear hum_block = float[512]
global calls = 0
hum(t) := {
  calls = calls + 1
  for i in 1 to #hum_block { hum_block#i = 0.5 * sin(2 * pi * 441 * (t + (i - 1) / sample_rate)) }
  0
}
play_blocks(hum, linear_address(hum_block), 0.1s)
round(save(sound, "blocks.wav") * 100) + calls' 15
is! 'use sound
linear left = float[512]
linear right = float[512]
hum(t) := for i in 1 to #left { left#i = 0.1; right#i = 0.2 }
play_blocks(hum, [linear_address(left), linear_address(right)], 0.1s)
round(save(sound, "blocks_stereo.wav") * 100)' 10
