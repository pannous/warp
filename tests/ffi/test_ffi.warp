# generated by scripts/is_tests.py from test_ffi.rs: edit the Rust test, then run the script again

# test_ffi_floor
is! «import floor from 'm'
floor(3.7)» 3.0
is! «import floor from 'm'
floor(-2.3)» (-3.0)
is! «import floor from 'm'
floor(5.0)» 5.0

# test_ffi_strlen
is! 'import strlen from "c"
strlen("hello")' 5
is! 'import strlen from "c"
strlen("")' 0
is! 'import strlen from "c"
strlen("Warp")' 4

# test_ffi_atof
is! 'import atof from "c"
atof("5.67")' 5.67
is! 'import atof from "c"
atof("42")' 42.0

# test_ffi_fmin
is! «import fmin from 'm'
fmin(3.5, 2.1)» 2.1
is! «import fmin from 'm'
fmin(100.0, 50.0)» 50.0
is! «import fmin from 'm'
fmin(-5.0, -10.0)» (-10.0)

# test_ffi_combined
is! «import sqrt from 'm'
import abs from "c"
sqrt(abs(-16))» 4.0
is! «import floor from 'm'
import fmin from 'm'
floor(fmin(3.7, 2.9))» 2.0

# test_ffi_strcmp
is! 'import strcmp from "c"
strcmp("hello", "hello")' 0
is! 'import strcmp from "c"
x=strcmp("abc", "def");x<0' 1
is! 'import strcmp from "c"
x=strcmp("xyz", "abc");x>0' 1
is! 'import strcmp from "c"
strcmp("", "")' 0

# test_ffi_strncmp
is! 'import strncmp from "c"
strncmp("hello", "help", 3)' 0
is! 'import strncmp from "c"
x=strncmp("hello", "help", 5);x!=0' 1

# test_ffi_ceil
is! «import ceil from 'm'
ceil(3.2)» 4.0
is! «import ceil from 'm'
ceil(-2.8)» (-2.0)
is! «import ceil from 'm'
ceil(5.0)» 5.0
is! «import ceil from 'm'
ceil(0.1)» 1.0

# test_ffi_sin
is! «import sin from 'm'
sin(0.0)» 0.0
is! «import sin from 'm'
sin(π/2)» 1.0
is! «import sin from 'm'
import fabs from 'm'
fabs(sin(3.141592653589793))<0.001» true

# test_ffi_cos
is! «import cos from 'm'
cos(0.0)» 1.0
is! «import cos from 'm'
import fabs from 'm'
fabs(cos(1.5707963267948966))<0.001» 1
is! «import cos from 'm'
cos(π)» (-1.0)

# test_ffi_tan
is! «import tan from 'm'
tan(0.0)» 0.0
is! «import tan from 'm'
import fabs from 'm'
fabs(tan(π/4)-1.0)<0.0001» true

# test_ffi_fabs
is! «import fabs from 'm'
fabs(3.11)» 3.11
is! «import fabs from 'm'
fabs(-3.11)» 3.11

