is! 'import atoi from "c"
        x = atoi("10")
        y = atoi("20")
        x + y' 30

# test_ffi_string_comparison_logic
is! 'import strcmp from "c"
result = strcmp("test", "test")
if result == 0 then 100 else 200' 100
is! 'import strcmp from "c"
result = strcmp("aaa", "bbb")
if result < 0 then 1 else 0' 1

