# test_ffi_trigonometry_combined
is! «
        import sin from 'm'
        import cos from 'm'
        x = 0.5
        sin_x = sin(x)
        cos_x = cos(x)
        result = sin_x * sin_x + cos_x * cos_x
        result» 1.0

