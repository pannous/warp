# generated by scripts/is_tests.py from test_braceless_operator_words.rs: edit the Rust test, then run the script again

# operator_words_take_the_whole_argument
is! 'sqrt 4 + 5' 3
is! 'abs -3 + 1' 2
is! 'cbrt 4 + 4' 2
is! 'sqrt 2 * 8' 4

# operator_words_stop_where_calls_stop
is! 'sqrt 16 > 3' true
is! '1 + sqrt 4 + 5' 4

# glued_parentheses_are_the_whole_argument
is! 'sqrt(16) + 1' 5
is! 'abs(-3) + 1' 4

# symbols_stay_tight
is! '√4 + 5' 7
is! '‖-3‖ + 1' 4
