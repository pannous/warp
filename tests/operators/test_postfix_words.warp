# generated by scripts/is_tests.py from test_postfix_words.rs: edit the Rust test, then run the script again

# an_operator_word_after_its_value_applies_to_it
is! '-7 abs' 7
is! 'x = -7 abs; x' 7
is! '16 sqrt' 4.0
is! 'x = -3; x abs + 1' 4
is! '27 cbrt' 3.0
is! 'abs -7' 7

# a_trailing_percent_is_a_hundredth
is! '10 %' 0.1
is! '10%' 0.1
is! '200 * 10%' 20
is! 'x = 50%; x * 4' 2
is! '10% + 1' 1.1
is! '7 % 5' 2
is! 'x = 7; x %= 5; x' 2

# an_operator_word_without_operand_is_a_function
is! 'f = function abs; f(-2)' 2
is! 'g = function sqrt; g(16) + 1' 5.0
is! 'xs = [1, -2]; xs.map(abs)' [1, 2]
is! 'xs = [1, -2]; map xs abs' [1, 2]
