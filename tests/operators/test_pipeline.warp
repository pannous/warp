# a_braceless_call_is_the_piped_value
is! 'square := it*it; numbers=[1 2 3 4]; square numbers |> filter(x => x > 5) |> sum' 25
is! 'def square := it * it
numbers = [1, 2, 3, 4, 5]
r = square numbers
    |> filter(x => x > 5)
    |> sum
r' 50
