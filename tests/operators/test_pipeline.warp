# a_pipeline_over_several_lines
is! 'square(x):=x*x; numbers=[1,2,3,4,5]
r = numbers
    |> map(square)
    |> filter(x => x > 5)
    |> sum
r' 50

# a_braceless_call_is_the_piped_value
