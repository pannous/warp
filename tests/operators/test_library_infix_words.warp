# generated by scripts/is_tests.py from test_library_infix_words.rs: edit the Rust test, then run the script again

# a_used_module_declares_an_infix_word
is! 'use regex; "abc" matches "a.c"' true
is! 'use regex; "abd" matches "a.c$"' false
is! 'use regex; matches("abc", "a.c")' true

# the_word_stays_a_word_without_the_module
is! 'matches = 3; matches + 1' 4

# a_glued_call_of_an_infix_word_is_a_call
is! 'use regex; print matches("abd", "a.c$")' false
is! 'use regex; x = matches("abc", "a.c"); x' true

# a_parenthesis_in_a_text_keeps_the_call
is! 'use regex; print matches("(", "x")' false
is! 'use regex; ok = matches("a)", "a\\\\)"); ok' true
is! 'use regex; ok = matches("(", "x"); ok' false
is! 'sqrt(")".count + 3).round(1)' 2

# a_text_ending_in_a_backslash_keeps_the_call
is! 'use regex; ok = matches("a\\\\", "x"); ok' false
is! 'use regex; print matches("a\\\\", "x"); 7' 7
