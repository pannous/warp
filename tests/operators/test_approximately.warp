# generated by scripts/is_tests.py from test_approximately.rs: edit the Rust test, then run the script again

# instances_are_approximately_equal_field_by_field
is! 'class Point{x:float y:float}; Point(1, 2) ≈ Point(1.0000000001, 2)' true
is! 'class Point{x:float y:float}; Point(1, 2) ≈ Point(1.1, 2)' false

# lists_and_objects_are_approximately_equal_element_by_element
is! '[1 2] ≈ [1.0000000001 2]' true
is! '[1 2] ≈ [1 2 3]' false
is! '{x:1 y:2} ≈ {y:2.0000000001 x:1}' true
is! '{p:[1 2]} ≈ {p:[1.0000000001 2]}' true
is! 'tolerance = 0.01; [100] ≈ [100.5]' true

# texts_are_approximately_equal_in_any_case_and_accent
is! '"hí" ≈ "HI"' true
is! '"a" ≈ "b"' false

# a_bool_is_approximately_any_value_of_its_truthiness
is! 'yes ≈ 2' true
is! 'yes ≈ 0' false
is! 'no ≈ ""' true

# numbers_near_zero_are_approximately_zero
is! 'sin(3.141592653589793) ≈ 0' true
is! '1e-20 ≈ 0' true
is! '1e-11 ≈ 0' false
is! 'tolerance = 0.5; 3 ≈ 2' true
