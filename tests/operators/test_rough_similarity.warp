# generated by scripts/is_tests.py from test_rough_similarity.rs: edit the Rust test, then run the script again

# rough_numbers_are_within_one_percent
is! '1 ~ 1.005' true
is! '1 ≈ 1.005' false
is! '1 ~ 1.02' false
is! '1 ~~ 1.005' true
is! 'x = 100; x ~ 100.9' true
is! 'rough_tolerance = 0.1; 1 ~ 1.05' true
is! 'tolerance = 0.1; 1 ≈ 1.05' true

# rough_texts_ignore_surrounding_whitespace_and_punctuation
is! '"Hello!" ~ "hello"' true
is! '"Hello!" ≈ "hello"' false
is! '"  Hí, " ~ "hi"' true
is! '"a" ~ "b"' false
is! '"a b" ~ "ab"' false

# rough_lists_compare_their_items_roughly
is! '[1 "Hi!"] ~ [1.005 "hi"]' true
is! '[1 "Hi!"] ≈ [1.005 "hi"]' false
is! '{x:1 y:"Ok."} ~ {y:"ok" x:1.001}' true

# a_class_method_serves_both_operators_when_only_one_is_defined
is! 'class P{x:float; approximately(o) := abs(x - o.x) < 1}; P(1) ≈ P(1.5)' true
is! 'class P{x:float; approximately(o) := abs(x - o.x) < 1}; P(1) ~ P(1.5)' true
is! 'class P{x:float; approximately(o) := abs(x - o.x) < 1}; P(1) ≈ P(3)' false
is! 'class P{x:float; similar(o) := abs(x - o.x) < 1}; P(1) ~ P(1.5)' true
is! 'class P{x:float; similar(o) := abs(x - o.x) < 1}; P(1) ≈ P(1.5)' true

# a_class_with_both_methods_keeps_them_apart
is! 'class P{x:float; approximately(o) := abs(x - o.x) < 1; similar(o) := abs(x - o.x) < 10}; P(1) ≈ P(5)' false
is! 'class P{x:float; approximately(o) := abs(x - o.x) < 1; similar(o) := abs(x - o.x) < 10}; P(1) ~ P(5)' true

# a_class_without_the_methods_compares_field_by_field_roughly
is! 'class P{x:float}; P(1) ~ P(1.005)' true
is! 'class P{x:float}; P(1) ≈ P(1.005)' false
