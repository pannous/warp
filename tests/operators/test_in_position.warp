# in_gives_yes_or_no
is! '3 in [1 2 3]' true
is! '1 in [1 2 3]' true
is! '5 in [1 2 3]' false
is! 'xs=[7 8 9]; 8 in xs' true
is! '(2 in [5 2]) == yes' true
