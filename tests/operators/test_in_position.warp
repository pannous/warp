is! 'if 5 in [1 2 3] {7} else {8}' 8
is! 'xs=[4 5]; if 4 in xs {1} else {0}' 1

# the_position_never_warns
is! '3 in [1 2 3]' true
is! 'if 3 in [1 2 3] {7} else {8}' 7

# maps_and_has_keep_their_truth_value
