# generated by scripts/is_tests.py from test_structural_equality.rs: edit the Rust test, then run the script again

# objects_compare_by_their_entries
'{a:1 b:2} == {a:1 b:2}' 1
'{a:1} == {a:2}' 0
'{a:1} == {a:1}' 1
'{a:1 b:2} == {a:1}' 0

# the_entry_order_of_an_object_does_not_matter
'{a:1 b:2} == {b:2 a:1}' 1
'{a:1 b:2 c:3} == {c:3 a:1 b:2}' 1
'{a:1 b:2} == {b:2 a:9}' 0

# a_float_equals_the_same_exact_number
'{x:3.0} == {x:3}' 1
'{x:{y:3.0}} == {x:{y:3}}' 1
'{x:0.5} == {x:0.5}' 1
'{x:0.5} == {x:0.25}' 0
'[1.5 2] == [1.5 2]' 1
'[1.5 2] == [1.25 2]' 0

# lists_compare_element_by_element
'[1 2] == [1 2]' 1
'[1 2] == [1 2 3]' 0
'[1 2] == [2 1]' 0
'[[1],[2]] == [[1],[2]]' 1
'[[1],[2]] == [[1],[3]]' 0

# not_equal_is_the_negation
'{a:1} != {a:1}' 0
'{a:1} != {a:2}' 1
'{a:1 b:2} != {b:2 a:1}' 0
'[1 2] != [1 2]' 0
'[1 2] != [1 3]' 1

# variables_holding_structures_compare_by_value
'p={a:1 b:2}; q={b:2 a:1}; p==q' 1
'xs=[1 2]; ys=[1 2]; xs==ys' 1

# struct_instances_compare_by_their_fields
'struct point{x:int y:int}; point(1,2) == point(1,2)' 1
'struct point{x:int y:int}; point(1,2) == point(1,3)' 0
'struct point{x:int y:int}; point(1,2) != point(1,3)' 1

# a_text_never_equals_a_number
'"3" == 3' 0
'[1 2] == 3' 0
'{a:1} == 1' 0

# a_switch_chooses_a_case_by_the_same_equality
'switch [1 2] {[1 2]: 7 default: 0}' 7
'switch [1 3] {[1 2]: 7 default: 0}' 0
