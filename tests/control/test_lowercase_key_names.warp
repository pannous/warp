# generated by scripts/is_tests.py from test_lowercase_key_names.rs: edit the Rust test, then run the script again

# lowercase_key_words_name_keys
is! 'n = 0
on key { if key == space { n += 1 } }
emit key{key:" "}
emit key{key:"q"}
n' 1
is! 'n = 0
on key { if key == esc or up == key { n += 1 } }
emit key{key:"Escape"}
emit key{key:"ArrowUp"}
n' 2
is! 'n = 0
on key { if key != enter { n += 1 } }
emit key{key:"Enter"}
emit key{key:"f1"}
n' 1
is! 'n = 0
on key { if key == f1 { n += 1 } }
emit key{key:"F1"}
n' 1

# a_lowercase_key_word_elsewhere_keeps_its_meaning
is! 'left = "mine"
seen = ""
on key { if key == left { seen = left } }
emit key{key:"mine"}
seen' 'mine'
is! 'seen = ""
on key { up = 3; seen = up }
emit key{key:"q"}
seen' 3

# a_bound_or_unrelated_lowercase_word_is_no_key
is! 'seen = ""
on key { left = 3
 if 3 == left { seen = "same" } else { seen = "differs" } }
emit key{key:"q"}
seen' 'same'
is! 'seen = ""
on key { for left in ["q"] { if key == left { seen = "loop" } } }
emit key{key:"q"}
seen' 'loop'
is! 'same(up) := up == "q"
seen = ""
on key { if same(key) { seen = "parameter" } }
emit key{key:"q"}
seen' 'parameter'
