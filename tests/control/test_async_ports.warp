# await_all_of_started_tasks_gives_their_results
is! 'f(x) := { sleep(30 ms); x * 10 }; await all [go f(1), go f(2), go f(3)]' [10, 20, 30]
is! 'f(x) := { sleep(300 ms); x }; started = clock(); xs = await all [go f(1), go f(2)]; clock() - started < 550' true

# gather_nested_and_wait_group_forms
is! 'f(n) := { a = go { n + 1 }; b = go { n * 2 }; await a + await b }; await go f(5)' 16
is! 'shared n = 0; jobs = []; for i in 1 to 4 { jobs.add(go { n += 1 }) }; await all jobs; n' 4

# await_any_gives_the_first_to_finish
is! 'gate = channel(); slow(g) := { g.receive(); 10 }; quick() := { sleep(10 ms); 20 }; r = await any [go slow(gate), go quick()]; gate.send(0); r' 20
is! 'gate = channel(); slow(g) := { g.receive(); 10 }; quick() := { sleep(10 ms); 20 }; r = await any [go quick(), go slow(gate)]; gate.send(0); r' 20

# await_first_is_the_first_tasks_result
is! 'slow() := { sleep(300 ms); 10 }; quick() := { sleep(10 ms); 20 }; await first [go slow(), go quick()]' 10
