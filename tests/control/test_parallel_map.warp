# generated by scripts/is_tests.py from test_parallel_map.rs: edit the Rust test, then run the script again

# a_parallel_map_gives_the_results_in_order
is! 'twice(x) := x * 2; @parallel [1,2,3].map(twice)' [2, 4, 6]
is! 'twice(x) := x * 2; xs = [4, 5]; ys = @parallel xs.map(twice); ys' [8, 10]

# a_parallel_map_runs_its_items_at_once
is! 'slow(x) := { sleep(500ms); x }; started = clock(); ys = @parallel [1,2,3].map(slow); clock() - started < 1200' true

# a_parallel_map_takes_a_function_value
is! 'inc = x => x + 1; @parallel [1,2].map(inc)' [2, 3]
is! 'inc = x => x + 1; job = go { inc(3) }; await job' 4

# go_maps_in_parallel
is! 'twice(x) := x * 2; go [1,2,3].map(twice)' [2, 4, 6]
is! 'ys = go [1,2,3].map(x => x + 1); ys' [2, 3, 4]
is! 'twice(x) := x * 2; xs = []; for i in 1 to 20 { xs.add(i) }; ys = go xs.map(twice); [#ys, ys#1, ys#20]' [20, 2, 40]
is! 'slow(x) := { sleep(500 ms); x }; started = clock(); ys = go [1,2,3,4].map(slow); clock() - started < 1200' true
is! 'twice(x) := x * 2; ys = [1,2].map(twice) @parallel; ys' [2, 4]

# go_for_runs_its_iterations_in_parallel
is! 'shared total = 0; go for x in [1,2,3,4,5] { total += x }; total' 15
is! 'shared n = 0; started = clock(); go for x in [1,2,3] { sleep(500 ms); n += 1 }; [n, clock() - started < 1200]' [3, 1]

# a_parallel_all_call_runs_its_items_at_once
is! 'square(x) := x * x; xs = [1, 2, 3]; @parallel square all xs' [1, 4, 9]
is! 'square(x) := x * x; ys = @parallel square all [1, 2, 3]; ys' [1, 4, 9]
is! 'slow(x) := { sleep(500 ms); x }; xs = [1, 2, 3]; started = clock(); ys = @parallel slow all xs; clock() - started < 1200' true
