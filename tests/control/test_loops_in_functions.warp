# generated by scripts/is_tests.py from test_loops_in_functions.rs: edit the Rust test, then run the script again

# a_while_loop_in_a_function_keeps_its_variables
is! 'f(n):={ i=0; while (i < 3) {i++}; i }; f(4)' 3
is! 'f(n):={ s=0; i=0; while i < n do {s+=i; i++}; s }; f(4)' 6

# a_while_loop_in_a_function_keeps_its_parameter
is! 'f(n):={ s=0; while n > 0 do {s+=n; n--}; s }; f(4)' 10

# a_multi_line_function_with_a_loop
is! 'sum(n) := {
  s = 0
  i = 0
  while i < n {
    s += i
    i++
  }
  s
}
sum(4)' 6
