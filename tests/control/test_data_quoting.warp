# generated by scripts/is_tests.py from test_data_quoting.rs: edit the Rust test, then run the script again

# data_takes_the_whole_expression_after_it
is! 'x = data a and b; string x' 'a and b'
is! 'string(data a and b)' 'a and b'

# parentheses_around_the_data_only_group_it
is! 'string(data (a and b))' 'a and b'
is! 'x = data (a and b); string(x)' 'a and b'

# data_of_a_tag_reads_as_written
is! 'string(data point{x:1})' 'point{x:1}'

# a_tag_in_a_variable_reads_as_written
is! 'p = data point{x:1}; string p' 'point{x:1}'
is! 'm = {a: data point{x:1}}; string m' '{a:point{x:1}}'
is! 'm = {a:{b:1}}; string m' '{a:{b:1}}'
is! 'e = data a:1; string e' '{a:1}'

# data_in_a_list_reads_as_written
is! 'string [data a or b, 3]' '[a or b 3]'
is! 'xs = [data a or b, 3]; string xs' '[a or b 3]'

# a_variable_named_data_is_no_prefix
is! 'xs=[4 2 2]; xs where it == 2' [2, 2]
is! 'xs=[4 2 2]; n=0; for x in xs { n += x }; n' 8
is! 'xs = [4 2 2 8 3 3 1]
result = []
for v in 1 to 8 {
	matches = [x for x in xs where x == v]
	c = #matches
	j = 0
	while j < c {
		result += [v]
		j += 1
	}
}
result' [1, 2, 2, 3, 3, 4, 8]
