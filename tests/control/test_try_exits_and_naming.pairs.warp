# return_out_of_a_try_restores_the_depth
'f(i) := { try { return [10 20]#i } else 0 }; f(1)' 10

# break_out_of_a_try_restores_the_depth
's=0; for i in [1 2 3] { try { if i==2 {break}; s=s+1 } else 0 }; s' 1

# continue_out_of_a_try_restores_the_depth
's=0; for i in [1 2 3] { try { if i==2 {continue}; s=s+1 } else 0 }; s' 2

# a_jump_inside_a_try_keeps_the_try_catching
