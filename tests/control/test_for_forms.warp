# generated by scripts/is_tests.py from test_for_forms.rs: edit the Rust test, then run the script again

# c_style_for_with_a_space_or_without_braces
is! 's=0; for (i=0;i<3;i++) {s+=i}; s' 3
is! 's=0; for(i=0;i<3;i++) s+=i; s' 3
is! 's=0; for (i=0;i<3;i++): s+=i; s' 3

# block_after_a_chained_iterable
is! 's=0; for (1…5).filter(x=>x%2) {s+=it}; s' 9

# else_after_a_block_takes_the_whole_expression
is! 'if 1 {1} else 3+1' 1
is! 'if 0 {1} else 3+1' 4
is! 'x = if 0 {1} else 3+1; x' 4

# each_starts_a_loop
is! 's=0; each x in [1, 2]: s+=x; s' 3
is! 's=0; each x in [1, 2] { s+=x }; s' 3

# loops_bind_it_to_values_of_other_kinds
is! 'n=0; for 1..3 {n+=it}; s=""; for "ab" {s+=it}; s' 'ab'
is! 'for 1..3 {it}; s=""; for friend in [foe1, friend1] {s+="$(it)"}; s' 'foe1friend1'

# the_loop_variable_name_picks_the_text_unit
is! 'text="hi  you"; s=""; for word in text { s += word + "," }; s' 'hi,you,'
is! 's=""; for line in "a
b c" { s += line + "," }; s' 'a,b c,'
is! 'text="hi"; s=""; for char in text { s += char + "," }; s' 'h,i,'
is! 's=""; for word in ["a b", "c"] { s += word + "," }; s' 'a b,c,'

# a_braceless_call_ends_the_loop_range
is! 'xs=[5,6,7]; s=0; for i in 1 to count xs { s+=i }; s' 6
is! 'xs=[5,6,7]; s=0; for i in 1 to count xs do s+=i; s' 6
is! 'xs=[5,6,7]; s=0; for i in 1 to count xs:
  s+=i
s' 6
is! 'xs=[5,6,7]; s=0; for i in 1 to count xs
  s+=i
s' 6
is! 'xs=[5,6,7]; s=0; for x in reverse xs { s=s*10+x }; s' 765
