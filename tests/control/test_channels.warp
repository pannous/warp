# generated by scripts/is_tests.py from test_channels.rs: edit the Rust test, then run the script again

# a_value_sent_in_a_task_is_received
is! 'ch = channel(); go { ch.send(42) }; ch.receive()' 42
is! 'ch = channel(); go { send 7 to ch }; ch.receive() * 2' 14

# for_over_a_channel_receives_until_it_is_closed
is! 'ch = channel(); go { for i in 1 to 3 { ch.send(i) }; ch.close() }; total = 0; for v in ch { total += v }; total' 6

# a_channel_passed_to_a_function
is! 'produce(c) := { for i in 1 to 4 { c.send(i) }; c.close() }; ch = channel(); go produce(ch); n = 0; for v in ch { n += 1 }; n' 4

# a_machine_channel_has_the_same_words
is! 'chat = channel "warp-test-p155"; chat.send("hi"); chat.receive()' 'hi'
is! 'chat = channel "warp-test-p155-to"; send 5 to chat; chat.receive() + 1' 6

# closed_channels_and_tasks_left_waiting
is! 'ch = channel(); go { ch.send(1) }; 5' 5

# a_sender_queued_behind_busy_tasks_is_received
is! 'for k in 1 to 6 { go { sleep(300 ms) } }; ch = channel(); go { ch.send(5) }; ch.receive()' 5
is! 'jobs = []; for k in 1 to 6 { jobs.add(go { sleep(100 ms); k }) }; ch = channel(); go { for k in 1 to 3 { ch.send(k) }; ch.close() }; received = 0; for v in ch { received += v }; [sum(await all jobs), received]' [21, 6]
