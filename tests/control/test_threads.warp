# tasks_run_at_the_same_time
is! 'f(ms) := { sleep(ms / 1000); ms }; a = go f(1000); b = go f(1000); c = go f(1000); a + b + c' 3000

# await_binds_its_task_inside_an_expression
is! 'f(ms) := { sleep(ms / 1000); ms }; a = go f(1); b = go f(2); await a + await b' 3

# a_paused_task_waits_for_resume
is! 'spin(n) := { i = 0; while i < n { i += 1 }; i }; job = go spin(300000); pause job; resume job; await job' 300000
is! 'spin(n) := { i = 0; while i < n { i += 1 }; i }; job = go spin(300000); job.pause(); job.resume(); job' 300000

# try_catches_the_failure_of_a_task
