# interpret_runs_a_block_known_only_at_run_time
is! 'xs = [data a+1, data a*2]; a = 5; interpret(xs#2)' 10
is! 'y = data 6*7; interpret y' 42
is! 'n=3; t="ab"; ys = [data n+1, data t+"c"]; interpret(ys#2)' 'abc'

# interpret_of_a_constant_block_runs_it_where_written
is! 'a=1; x : a+b; b=2; interpret x' 3

# a_run_time_block_reads_the_values_where_it_runs
