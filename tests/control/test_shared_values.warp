# a_go_block_writes_a_shared_value
is! 'shared hits = 0; jobs = []; for i in 1..5 { jobs.add(go { for j in 1 to 100 { hits += 1 }; 0 }) }; await all jobs; hits' 400

# a_function_given_a_shared_value_shares_it
is! 'shared n = 0; bump(c) := { c += 1; 0 }; await go bump(n); await go bump(n); n' 2

# a_self_update_of_a_shared_value_is_atomic
is! 'shared hits = 0; jobs = []; for i in 1..5 { jobs.add(go { for j in 1 to 200 { hits = hits + 1 }; 0 }) }; await all jobs; hits' 800
