# for_without_variable_binds_it
'x=0; for 1..4 {x+=it}; x'	6
'x=0; for 1...4 {x+=it}; x'	10
'x=0; for [5 6] {x+=it}; x'	11

# upto_excludes_the_end_unlike_to
'x=0; for i in 1 upto 4 {x+=i}; x'	6
'x=0; for i in 1 to 4 {x+=i}; x'	10

# a_range_is_a_list_in_a_variable
'r=1…3; r'	[1, 2, 3]
'r=1 to 3; r'	[1, 2, 3]
'r=1..3; r'	[1, 2]
'x=0; r=1…4; for i in r {x+=i}; x'	10
'r=1…3; count r'	3

# ranges_in_for_headers_stay_ranges
'x=0; for i in 1..4 {x+=i}; x'	6
'x=0; for i in 1...4 {x+=i}; x'	10

# a_while_without_a_body_loops
