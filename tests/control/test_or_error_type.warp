# generated by scripts/is_tests.py from test_or_error_type.rs: edit the Rust test, then run the script again

# test_a_result_declared_int_or_error_holds_both
is! 'def f(x) as int or error := if x < 0 then error("neg") else x; r = f(-1); if r failed then 1 else 2' 1

# test_an_optional_type_before_a_name_or_as_a_result
is! 'def f(x) as int? := if x < 0 then error("neg") else x; r = f(-1); if r failed then 1 else 2' 1

# test_an_optional_result_of_any_type_holds_its_value_or_none
is! 'f(x: bool): text? := if x then "a" else ø; if f(no) is ø then 1 else 2' 1
