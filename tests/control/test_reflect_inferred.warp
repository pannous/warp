# generated by scripts/is_tests.py from test_reflect_inferred.rs: edit the Rust test, then run the script again

# a_field_named_type_is_read_as_written
is! 'class Q { type: int }; def make() { Q(7) }; make().type' 7

# extension_methods_are_listed
is! 'class P { x: int; def sum() { x } }; def make() { P(1) }; fun P.twice() = this.x * 2; [m.name for m in P.methods]' ['sum', 'twice']
is! 'class P { x: int; def sum() { x } }; def make() { P(1) }; fun P.twice() = this.x * 2; [m.name for m in P(3).methods]' ['sum', 'twice']
is! 'class P { x: int }; extension P { func twice() -> int { self.x * 2 }; func three() { 3 } }; dir(P(1))' ['x', 'twice', 'three']
