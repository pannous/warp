# generated by scripts/is_tests.py from test_parsed_code_patterns.rs: edit the Rust test, then run the script again

# code_pattern_matches_code_parsed_at_run_time
is! 'simplify(code) := match code {
	data($a + 0) => a
	data($a * 1) => a
	_ => code
}
t = "n * " + "1"
simplify(parse(t)) == data n' true
is! 'simplify(code) := match code {
	data($a + 0) => a
	data($a * 1) => a
	_ => code
}
simplify(parse("y + 0")) == data y' true

# quoted_statements_bind_no_blocks
is! 'x = data (j: 1
k: n * 1)
(x#2).name' 'k'
is! 'x = parse("j: 1\\nk: n * 1")
(x#2).name' 'k'
is! 'x = data (j: 1
k: n * 1)
x#2 == parse("k: n * 1")' true
