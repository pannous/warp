# generated by scripts/is_tests.py from test_structural_patterns.rs: edit the Rust test, then run the script again

# test_list_patterns_bind_names
is! 'greet(xs) := switch xs { ["", middle, ""]: middle + "!"  ["foo", x]: x  _: "never mind" }; greet(["", "hi", ""])' 'hi!'
is! 'greet(xs) := switch xs { ["", middle, ""]: middle + "!"  ["foo", x]: x  _: "never mind" }; greet(["foo", "bar"])' 'bar'
is! 'greet(xs) := switch xs { ["", middle, ""]: middle + "!"  ["foo", x]: x  _: "never mind" }; greet(["a", "b", "c"])' 'never mind'
is! 'greet(xs) := switch xs { ["", middle, ""]: middle + "!"  ["foo", x]: x  _: "never mind" }; greet(["", "hi"])' 'never mind'

# test_nested_lists_and_pairs
is! 'xs=[1, [2, [3]]]; switch xs { [outer, [middle, [inner]]]: outer + middle + inner  _: 0 }' 6
is! 'xs=[1, 2]; switch xs { [outer, [middle, [inner]]]: outer + middle + inner  _: 0 }' 0
