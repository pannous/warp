# generated by scripts/is_tests.py from test_text_patterns.rs: edit the Rust test, then run the script again

# a_prefix_or_suffix_binds_the_rest
is! 's = "0xff"; match s { "0x" + rest => rest; _ => "no" }' 'ff'
is! 's = "a.txt"; match s { name + ".txt" => name; _ => "no" }' 'a'
is! 's = "0yff"; match s { "0x" + rest => rest; _ => "no" }' 'no'

# pieces_and_holes_alternate
is! 's = "/users/7/posts/9"; match s { "/users/" + u + "/posts/" + p => u + p; _ => "no" }' '79'
is! 's = "(1,2)"; match s { "(" + a + "," + b + ")" => b + a; _ => "no" }' '21'

# a_typed_hole_reads_its_text
is! 's = "/users/7"; match s { "/users/" + id: int => id + 1; _ => 0 }' 8
is! 's = "/users/me"; match s { "/users/" + id: int => id + 1; _ => 0 }' 0

# a_class_hole_tests_its_characters
is! 's = "v12"; match s { "v" + n: digits => n; _ => "no" }' '12'
is! 's = "vx"; match s { "v" + n: digits => n; _ => "no" }' 'no'
is! 's = "0xbeef"; match s { "0x" + h: hex => h; _ => "no" }' 'beef'
is! 's = "a!"; match s { c: letter + "!" => c; _ => "no" }' 'a'

# a_known_name_in_a_sum_is_a_value
is! 'p = "0x"; s = "0xff"; match s { p + "ff" => "same"; _ => "no" }' 'same'

# text_holes_fit_their_types
is! 'text_holes("/users/42", ["/users/", ""], ["int"])#1' '42'
is! 'count(text_holes("/users/bo", ["/users/", ""], ["int"]))' 0
is! 'text_holes("-3.25 m", ["", " m"], ["number"])#1' '-3.25'
is! 'text_holes("0xff!", ["0x", "!"], ["hex"])#1' 'ff'
is! 'count(text_holes("0xfg!", ["0x", "!"], ["hex"]))' 0
is! 'text_holes("my_name", ["", ""], ["word"])#1' 'my_name'
is! 'count(text_holes("my-name", ["", ""], ["word"]))' 0
