# try_catches_the_stack_overflow_of_a_call
is! 'down(n) := if n == 0 then 0 else 1 + down(n - 1); try down(1000000) else 7' 7
is! 'down(n) := if n == 0 then 0 else 1 + down(n - 1); try down(10) else 7' 10

# the_instance_keeps_working_after_a_caught_overflow
