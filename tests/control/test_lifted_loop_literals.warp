# generated by scripts/is_tests.py from test_lifted_loop_literals.rs: edit the Rust test, then run the script again

# a_walked_literal_is_built_once_before_the_outer_loop
is! 't = 0
for i in 0..3 { for k in [16, 8, 0] { t += k } }
t' 72

# lifted_literals_keep_each_loop_its_own
is! 'out = []
for i in 0..2 { for s in [1, 2] { out.add(s) }; for s in [3, 4] { out.add(s * 10) } }
out' [1 2 30 40 1 2 30 40]
is! 'f(n) := { t = 0; for i in 0..n { for k in [1, 2, 3] { t += k } }; t }
[f(2), f(3)]' [12 18]
is! 'out = []
for i in 0..3 { for row in [[1], [2]] { row.add(i); out.add(count(row)) } }
out' [2 2 2 2 2 2]
