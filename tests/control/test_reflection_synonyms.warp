# properties_lists_the_fields
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); p.properties' ['x', 'y']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); properties of p' ['x', 'y']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); P(3, 4).properties' ['x', 'y']
is! 'm = {a:1}; properties(m)' ['a']

# reflection_words_as_calls
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); fields(p)' ['x', 'y']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); fields(P)' ['x', 'y']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); attributes(P(1, 2))' ['x', 'y']
is! 'm = {a:1}; fields(m)' ['a']

# functions_lists_the_methods
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); [m.name for m in functions(p)]' ['sq']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); [m.name for m in functions(P)]' ['sq']
is! 'class P{x:int; y:int; sq() := x*x+y*y}; p = P(1, 2); count(functions of p)' 1

# a_real_field_named_like_a_synonym_wins
is! 'class Q{properties:int}; Q(3).properties' 3
is! 'class Q{properties:int}; q = Q(3); q.properties' 3
is! 'class Q{members:int}; Q(3).members' 3

# a_user_function_named_like_a_synonym_wins
is! 'fields(x) := 42; fields(1)' 42
