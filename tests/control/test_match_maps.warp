# generated by scripts/is_tests.py from test_match_maps.rs: edit the Rust test, then run the script again

# map_arm_binds_a_field
is! 'match {name: "Ann", age: 3} { {name: n} => n }' 'Ann'
is! 'match {name: "Ann", age: 3} { {age} => age + 1 }' 4

# map_arm_ignores_fields_not_named
is! 'match {name: "Ann", age: 3} { {name: "Ann"} => 1; _ => 2 }' 1
is! 'match {name: "Bo", age: 3} { {name: "Ann"} => 1; _ => 2 }' 2

# map_arm_needs_its_fields
is! 'match {name: "Ann"} { {age} => age; {name} => name }' 'Ann'
is! 'match 3 { {name} => name; _ => "no map" }' 'no map'

# map_arms_match_at_any_depth
is! 'response = {status: 200, body: {user: {name: "Ann", email: "ann@x.org", age: 31}}}; match response { {status: 200, body: {user: {name, email}}} => name + " <" + email + ">"; {status: 404} => "missing"; {error: message} => message }' 'Ann <ann@x.org>'
is! 'response = {status: 404}; match response { {status: 200, body: {user: {name, email}}} => name + " <" + email + ">"; {status: 404} => "missing"; {error: message} => message }' 'missing'
is! 'response = {error: "down"}; match response { {status: 200, body: {user: {name, email}}} => name + " <" + email + ">"; {status: 404} => "missing"; {error: message} => message }' 'down'

# is_with_a_map_pattern_binds_its_names
is! 'x = {name: "Ann", age: 3}; if x is {age} then age else 0' 3
is! 'x = {name: "Ann", age: 3}; if x is {size} then size else 0' 0
is! 'response = {status: 200, body: {user: {name: "Ann", email: "ann@x.org", age: 31}}}; if response is {body: {user: {name}}} then name else ""' 'Ann'
