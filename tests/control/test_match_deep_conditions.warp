is! 'classify(p) := match p { {body: {user: {age: >= 18, name: text}}} => "adult"; {body: {user: {age: 13 to 17}}} => "teen"; _ => "child" }; classify({body: {user: {name: "Cy", age: 3}}})' 'child'

