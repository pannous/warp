# generated by scripts/is_tests.py from test_catch_binding.rs: edit the Rust test, then run the script again

# catch_binds_the_error
is! 'try { [1 2]#5 } catch e { is_error(e) }' 1
is! 'r = try { raise "boom" } catch e { 1 }; r' 1

# except_as_binds_the_error
is! 'try:
  [1 2]#5
except:
  7' 7

# a_caught_error_reads_as_its_message_in_text
is! 'try { raise "boom" } catch e { "caught: " + e }' 'caught: boom'
is! 'try { [1 2]#5 } catch e { e + "!" }' 'index out of range!'

# a_raised_value_is_caught_as_its_text
is! 'try { raise 42 } catch e { "caught " + e }' 'caught 42'

# an_interpolation_reads_the_caught_error
is! 'try { raise "boom" } catch e { "caught: \\(e)" }' 'caught: boom'
