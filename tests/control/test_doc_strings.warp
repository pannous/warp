# generated by scripts/is_tests.py from test_doc_strings.rs: edit the Rust test, then run the script again

# a_leading_text_is_the_doc_and_not_evaluated
is! 'fun twice(x) {"doubles a number"; x*2}
twice(3)' 6
is! 'fun twice(x) {
  "doubles a number"
  x*2
}
twice.doc' 'doubles a number'
is! 'twice(x) := {"doubles a number"; x*2}
twice.doc' 'doubles a number'

# the_comment_above_a_definition_is_the_doc
is! '# doubles a number
fun twice(x) { x*2 }
twice.doc' 'doubles a number'
is! '// doubles a number
twice(x) := x*2
twice.doc' 'doubles a number'
is! '# doubles a number
twice(x) := x*2
help(twice)' 'twice(x) -> int
doubles a number'

# help_shows_the_doc_below_the_signature
is! '# doubles a number
fun twice(x) { x*2 }
help(twice)' 'twice(x) -> int
doubles a number'
is! 'fun twice(x) {"doubles a number"; x*2}
help(twice)' 'twice(x) -> int
doubles a number'

# a_lone_text_body_stays_the_value
is! 'fun hi() {"hello"}
hi()' 'hello'

# a_function_without_doc_has_the_empty_doc
is! 'twice(x) := x*2
twice.doc' ''
