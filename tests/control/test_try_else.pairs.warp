# generated by scripts/is_tests.py from test_try_else.rs: edit the Rust test, then run the script again

# try_keeps_a_value
'try 3 else 0'	3
'try [1 2]#2 else 0'	2
'try 7%2 else 0'	1
'try 7/7 else 0'	1
'x=4; try x else 9'	4

# try_falls_back_when_the_index_is_out_of_range
'try [1 2]#5 else 0'	0
'try [1 2]#0 else 0'	0
'l=[1 2 3]; i=9; try l#i else 8'	8

# try_falls_back_on_division_and_modulo_by_zero
'try 1%0 else 7'	7
'try 1/0 else 7'	7
'a=5; b=0; try a%b else 7'	7

# try_of_an_assignment_assigns_the_fallback
'try item = [1 2]#5 else 0; item'	0
'try item = [1 2]#2 else 0; item'	2

# try_falls_back_on_an_error_value
'try error("no") else "yes"'	'yes'
'try "fine" else "yes"'	'fine'

# assert_gives_the_condition_or_an_error
'assert 2>1 else "x"'	1
'assert 1'	1
