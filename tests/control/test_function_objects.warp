# generated by scripts/is_tests.py from test_function_objects.rs: edit the Rust test, then run the script again

# a_modules_methods_are_its_functions
is! 'use math
fs = methods(math)
fs#1(12, 18)' 6
is! 'use math
count(math.methods) == count(dir(math))' true
is! 'use math
count(methods of math) == count(dir(math))' true

# a_function_knows_its_name_and_return_type
is! '# doubles a number
twice(x) := x*2
twice.name' 'twice'
is! '# doubles a number
twice(x) := x*2
twice.return_type' 'int'
is! 'use math
gcd.name' 'gcd'
is! 'use math
gcd.return_type' 'int'

# the_words_of_a_function_reference
is! '# doubles a number
twice(x) := x*2
(function twice).doc' 'doubles a number'
is! '# doubles a number
twice(x) := x*2
(function twice).name' 'twice'

# a_function_value_answers_at_run_time
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.doc' 'doubles a number'
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.name' 'twice'
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.signature' '(x) -> int'

# only_the_comment_directly_above_is_the_doc
is! '# header

# doubles
twice(x) := x*2
twice.doc' 'doubles'
is! 'use math
gcd.doc' ''
is! 'use math
lerp.doc' 'the value a fraction t of the way from a to b'

# a_classes_methods_are_its_functions
is! 'class Dog { name: text; bark() := "wuff " + name }
d = Dog("rex")
fs = d.methods
fs#1(d)' 'wuff rex'
is! 'class Dog { name: text; bark() := "wuff " + name }
d = Dog("rex")
[m.name for m in methods(Dog)]' ['bark']

# methods_of_a_class_with_an_outside_method_read_without_a_crash
is! 'class P{}; def x(_:P):="hi"; print methods(P); print methods(P).count; 1' 1

# the_type_of_a_function_names_its_signature
is! 'use math
type(gcd)' 'function: (a: int, b: int) -> int'
is! 'use math
(function gcd) is function' true

# a_values_methods_are_its_types_functions
is! 'fs = methods("hi")
fs#1.name' 'repeat'
is! 's = "hi"
count(s.methods) == count(dir(s))' true
is! 'm = {methods: 3}
m.methods' 3

# description_is_doc
is! '# doubles a number
twice(x) := x*2
twice.description' 'doubles a number'
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.description' 'doubles a number'

# returns_is_return_type
is! '# doubles a number
twice(x) := x*2
twice.returns' 'int'
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.returns' 'int'

# representation_is_dump
is! '# doubles a number
twice(x) := x*2
twice.representation' 'twice(x) := x*2'
is! '# doubles a number
twice(x) := x*2
fs = [function twice]
fs#1.representation' 'twice(x) := x*2'

# full_is_the_doc_and_the_definition
