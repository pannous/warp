# generated by scripts/is_tests.py from test_tree_find.rs: edit the Rust test, then run the script again

# find_collects_a_name_at_any_depth
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
sources = page find {type: "image", src}
sources#1' 'logo.png'
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
sources = page find {type: "image", src}
sources#2' 'cat.jpg'

# find_without_names_gives_the_subtrees
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
count(page find {type: "text"})' 1

# find_takes_a_named_pattern
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
pattern Image = {type: "image", src}
count(page find Image)' 2

# find_matches_list_patterns_in_nested_lists
is! 'xs = [[1, 2], [3, [1, 5]]]
found = xs find [1, x]
found#1 + found#2' 7

# find_with_two_names_gives_the_maps_that_have_both
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "image", src: "cat.jpg", alt: "a cat"}]}
count(page find {src, alt})' 1
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "image", src: "cat.jpg", alt: "a cat"}]}
described = page find {src, alt}
described#1.alt' 'a cat'

# two_finds_walk_apart
is! 'page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
count(page find {type: "text"}) + count(page find {src})' 3
