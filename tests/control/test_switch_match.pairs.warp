# generated by scripts/is_tests.py from test_switch_match.rs: edit the Rust test, then run the script again

# a_switch_picks_the_case_of_its_subject
'color=1; switch color {1: 10 2: 20}'	10
'color=2; switch color {1: 10 2: 20}'	20
'switch "b" {"a": 1 "b": 2}'	2
'switch "abc" {"abc": 1 "b": 2}'	1

# the_default_case_catches_what_nothing_else_matches
'switch 3 {1: 10 default: 0}'	0
'switch 1 {1: 10 default: 0}'	10
'n=7; switch n {1: 10 default: n+1}'	8

# only_the_chosen_body_runs
'x=0; switch 1 {1: x=5 2: x=7}; x'	5
'x=0; switch 2 {1: x=5 2: x=7}; x'	7
'x=0; switch 3 {1: x=5 default: x=9}; x'	9

# match_is_another_word_for_switch
'match 2 {1: 10 2: 20}'	20
'match 5 {1: 10 default: 0}'	0

# a_switch_is_a_value
'y=switch 2 {1: 10 2: 20}; y+1'	21

# a_user_function_named_switch_wins
'switch(a,b):=a*b; switch(2,3)'	6

# a_switch_inside_an_expression_or_an_argument
'switch 3 {1: "one" 3: "three" default: "many"} == "three"'	true
'y = (switch 3 {1: "one" 3: "three" default: "many"} == "three"); y'	true
'f(x) := x; f(switch 2 {1: 10 2: 20})'	20
