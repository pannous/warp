# generated by scripts/is_tests.py from test_type_word_filter_loops.rs: edit the Rust test, then run the script again

# test_a_type_word_loop_visits_only_items_of_that_type
is! 'xs=[1, "a", 2.5, "b"]; n=0; for number in xs { n += 1 }; n' 2
is! 'xs=[1, "a", 2.5, "b"]; s=""; for text in xs { s += text }; s' 'ab'
is! 'xs=[1, "a", 3]; s=0; for int in xs: s += it
s' 4

# test_a_literal_list_of_matching_items_needs_no_filter
is! 's=0; for number in [1,2,3] { s += number }; s' 6

# test_an_adjective_with_a_type_word_is_a_condition
is! 's=0; for (even number) in [1,2,3,4] { s += it }; s' 6
is! 's=0; for (odd number) in [1,2,3,4]: s += it
s' 4
is! 'big(x) := x > 2; s=0; for (big number) in [1,2,3,4] { s += it }; s' 7

# test_a_text_appended_with_an_item_of_a_mixed_list_inside_an_if
is! 'xs=[1, "a"]; s=""; y=xs#2; if 1 { s += y }; s' 'a'

# test_the_characters_of_a_text_need_no_filter
is! 's=""; t="abc"; for character in t[1:] { s += character }; s' 'bc'
