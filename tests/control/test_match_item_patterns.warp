# every_item_binds_a_list
is! 'names = match [[1, "a"], [2, "b"]] { [[n, s]...] => s }
names#2' 'b'
is! 'numbers = match [[1, "a"], [2, "b"]] { [[n, s]...] => n }
count(numbers)' 2

