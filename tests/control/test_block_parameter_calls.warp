# a_block_parameter_takes_a_trailing_block_without_parentheses
is! 'def repeats(n: int, body: block) := { for i in 1...n { body! } }; k = 0; repeats 4 { k += 1 }; k' 4

# a_parameter_named_block_is_a_block_parameter_and_runs_with_parentheses
is! 'def repeats(n: int, block) := { for i in 1...n { block() } }; k = 0; repeats 3 { k += 1 }; k' 3

# a_parameter_named_code_the_body_never_runs_is_a_value
