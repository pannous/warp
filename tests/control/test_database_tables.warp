# generated by scripts/is_tests.py from test_database_tables.rs: edit the Rust test, then run the script again

# a_field_added_to_the_class_adds_a_column
is! 'class Pet{name: text; legs: int = 4}
stored pets: [Pet] in "pets_grown"
count(pets)' 1
is! 'class Pet{name: text; legs: int = 4}
stored pets: [Pet] in "pets_grown"
pets#2.legs' 2

# a_field_removed_from_the_class_keeps_its_column_with_a_warning
is! 'class Car{make: text}
stored cars: [Car] in "cars_shrunk"
cars#1.make' 'VW'

# a_field_changed_without_loss_converts_its_column
is! 'class Box{width: float}
stored boxes: [Box] in "boxes_widened"
boxes#1.width' 3.0
is! 'class Tag{code: text}
stored tags: [Tag] in "tags_spelled"
tags#1.code' '7'

# a_field_marked_was_renames_its_column
is! 'class Dog{@was(nick) name: text}
stored dogs: [Dog] in "dogs_renamed"
dogs#1.name' 'Rex'
is! 'class Dog{@was(nick) name: text}
stored dogs: [Dog] in "dogs_renamed"
dogs#1.name' 'Rex'

# a_class_of_fields_side_by_side_is_a_table
is! 'class Hiker { name: text age: int = 5 }
stored hikers: [Hiker] in "hikers_spaced"
(hikers where age > 18)#1.name' 'Bo'
is! 'class Hiker { name: text age: int = 5 }
stored hikers: [Hiker] in "hikers_spaced"
hikers#2.age' 5
