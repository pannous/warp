# generated by scripts/is_tests.py from test_shared_signals.rs: edit the Rust test, then run the script again

# whenever_a_task_sets_a_shared_value
is! 'shared done = false; seen = 0; whenever done { seen = 1 }; go { sleep(30 ms); done = true }; sleep(400 ms); seen' 1

# on_change_of_a_shared_value_sees_the_new_value
is! 'shared n = 0; seen = 0; on change n { seen = value }; go { n = 5 }; sleep(300 ms); seen' 5

# once_on_a_shared_value_runs_once
is! 'shared n = 0; hits = 0; once n > 2 { hits += 1 }; go { for i in 1 to 6 { n = i; sleep(20 ms) } }; sleep(500 ms); hits' 1

# a_write_of_the_program_itself_is_seen_at_its_next_check_point
is! 'shared n = 0; seen = 0; on change n { seen = value }; n = 7; for i in 1 to 2 { i }; seen' 7

# changes_before_the_listener_are_not_seen
is! 'shared n = 0; n = 3; hits = 0; on change n { hits += 1 }; for i in 1 to 2 { i }; hits' 0
