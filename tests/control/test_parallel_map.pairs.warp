# a_parallel_map_gives_the_results_in_order
'twice(x) := x * 2; @parallel [1,2,3].map(twice)'	[2, 4, 6]
'twice(x) := x * 2; xs = [4, 5]; ys = @parallel xs.map(twice); ys'	[8, 10]

# a_parallel_map_takes_a_function_value
'inc = x => x + 1; @parallel [1,2].map(inc)'	[2, 3]
'inc = x => x + 1; job = go { inc(3) }; await job'	4

# go_maps_in_parallel
'twice(x) := x * 2; go [1,2,3].map(twice)'	[2, 4, 6]
'ys = go [1,2,3].map(x => x + 1); ys'	[2, 3, 4]
'twice(x) := x * 2; ys = [1,2].map(twice) @parallel; ys'	[2, 4]

# go_for_runs_its_iterations_in_parallel
'shared total = 0; go for x in [1,2,3,4,5] { total += x }; total'	15

# a_parallel_all_call_runs_its_items_at_once
