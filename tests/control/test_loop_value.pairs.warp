# a_counting_loop_gives_its_last_body_value
'for i in 1 to 5 : {i*10}' 50
'for i in 1 to 5 : {puti(i)}' 5
'for i in 1 to 3 {puti i}; i' 4

# a_walking_loop_gives_its_last_body_value
'for i in [1,2,3] : i*10' 30

# a_while_loop_of_one_expression_gives_its_value
'i=1; while (i+=1)<=5 {i*10}' 50

# a_float_last_body_value_is_the_loop_value
