# generated by scripts/is_tests.py from test_after.rs: edit the Rust test, then run the script again

# after_waits_for_its_condition
is! 'shared done = false; go { sleep(50ms); done = true }; last = after done return "third"; await last' 'third'
is! 'shared n = 0; go { for i in 1 to 5 { n += 1 } }; five = after (n == 5) return n * 2; await five' 10

# a_cancelled_after_gives_the_fallback
is! 'shared done = false; last = after done return "third"; cancel last; await last or "no third"' 'no third'
is! 'job = go { sleep(10ms); 3 }; await job or 0' 3
