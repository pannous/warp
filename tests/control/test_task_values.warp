# generated by scripts/is_tests.py from test_task_values.rs: edit the Rust test, then run the script again

# a_task_gives_the_result_of_its_function
is! 'f(x) := x * 2; job = go f(21); await job' 42
is! 'g(t) := t + "!"; job = go g("a"); await job' 'a!'
is! 'h(x:float) := x / 2; job = go h(3); await job' 1.5
is! 'total(xs) := { s=0; for x in xs { s+=x }; s }; job = go total([1,2,3]); await job' 6
is! 'dbl(xs) := xs.map(x => x*2); job = go dbl([1,2]); await job' [2, 4]

# the_failure_of_a_task_is_caught_by_try
is! 'f(i) := [1,2,3]#i; job = go f(5); try await job else -1' (-1)

# two_tasks_overlap
is! 'f(ms) := { started = clock(); sleep(ms / 1000); started }; a = go f(1000); b = go f(1000); if abs(await a - await b) < 1000 then 2000 else -1' 2000

# a_function_value_crosses_to_a_task
is! 'inc = x => x + 1; apply(g, v) := g(v); job = go apply(inc, 3); await job' 4
is! 'k = 10; add = x => x + k; apply(g, v) := g(v); job = go apply(add, 5); await job' 15
is! 'mapit(f, xs) := xs.map(f); job = go mapit(x => x + 1, [1, 2]); await job' [2, 3]

# a_task_pauses_and_resumes
is! 'spin(n) := { i = 0; while i < n { i += 1 }; i }; job = go spin(300000); pause job; resume job; await job' 300000
