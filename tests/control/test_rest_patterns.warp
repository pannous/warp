# generated by scripts/is_tests.py from test_rest_patterns.rs: edit the Rust test, then run the script again

# a_rest_binds_the_remaining_items
is! 'xs=[1,2,3]; match xs { [first, ...rest] => first * 10 + count(rest); _ => 0 }' 12

# items_after_a_rest_count_from_the_end
is! 'xs=[1,2,3,4]; match xs { [first, ...middle, last] => first + last * 10 + count(middle) * 100; _ => 0 }' 241

# a_class_pattern_leaves_other_fields_out
is! 'class P{x:int; y:int; z:int}; p = P(1, 2, 3); match p { P{x, ..} => x; _ => 0 }' 1
is! 'class P{x:int; y:int; z:int}; p = P(1, 2, 3); match p { P(x, ..) => x; _ => 0 }' 1
is! 'class P{x:int; y:int; z:int}; p = P(1, 2, 3); match p { P(x, y, ...) => x + y; _ => 0 }' 3
