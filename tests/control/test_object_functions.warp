# test_function_entries_are_callable
is! 'o = {a: 1, f := it*2}; o.f(3)' 6
is! 'o = {f := it*2}; o.f 3' 6
is! 'o = {a: 1, f := x => x*2}; o.f(3)' 6
is! 'o = {a: 1, f = x => x*2}; o.f(3)' 6
is! 'o = {a: 1, f(x, y) := x*y}; o.f(3, 4)' 12
is! 'o = {a: 1, f := it*2}; o.f(3) + o.a' 7

# test_fields_are_in_scope_of_function_entries
