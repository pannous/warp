# generated by scripts/is_tests.py from test_error_words.rs: edit the Rust test, then run the script again

# fail_and_panic_raise
is! 'try fail "boom" else 3' 3
is! 'try { panic "boom" } catch e { e.message }' 'boom'

# warn_warns_and_continues
is! 'warn "careful"; 1' 1
is! '"a" + warn("careful") + "b"' 'ab'

# a_program_may_define_the_words
is! 'fail(x) := x + 1; fail 2' 3
is! 'warn(x) := x * 2; warn 4' 8
