# generated by scripts/is_tests.py from test_method_let_shadows_field.rs: edit the Rust test, then run the script again

# a_let_local_hides_the_field
is! 'class F { name: text; body: any }
fresh(f: F) := {
	let body = 99
	body
}
f = F("main", 42)
fresh(f) + 1000 * f.body' 42099
is! 'class F { name: text; body: any
 fresh() := {
	let body = 99
	body
} }
f = F("main", 42)
f.fresh() + 1000 * f.body' 42099

# a_let_local_starts_after_its_value
is! 'class F { name: text; body: any }
fresh(f: F) := {
	let body = body + 1
	body
}
fresh(F("main", 42))' 43

# a_bare_field_write_changes_the_field
is! 'class F { name: text; body: any }
fresh(f: F) := {
	body = 99
	body
}
f = F("main", 42)
fresh(f)
f.body' 99
is! 'class F { name: text; body: any
 fresh() := {
	body = 99
	body
} }
f = F("main", 42)
f.fresh()
f.body' 99
