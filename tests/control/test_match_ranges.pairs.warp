# generated by scripts/is_tests.py from test_match_ranges.rs: edit the Rust test, then run the script again

# an_inclusive_range
'match 19 { 13 to 19 => "teen"; _ => "other" }'	'teen'
'match 13 { 13...19 => "teen"; _ => "other" }'	'teen'
'match 20 { 13 to 19 => "teen"; _ => "other" }'	'other'

# an_exclusive_range
'match 15 { 13..20 => "teen"; _ => "other" }'	'teen'
'match 20 { 13..20 => "teen"; _ => "other" }'	'other'
'match 12 { 13..20 => "teen"; _ => "other" }'	'other'

# floats_and_ranges_as_alternatives
'match 2.5 { 1 to 3 => "low"; _ => "high" }'	'low'
'match 7 { 1 to 3 | 6 to 9 => "in"; _ => "out" }'	'in'
