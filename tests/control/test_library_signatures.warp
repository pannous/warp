# generated by scripts/is_tests.py from test_library_signatures.rs: edit the Rust test, then run the script again

# an_operator_words_signature
is! 'sqrt.signature' '(x:number) -> number'
is! 'abs.params' ['x']
is! 'dir(sqrt)' ['params', 'signature']
is! 'help(cbrt)' 'cbrt(x:number) -> number'

# a_prelude_words_signature_as_its_head
is! 'first.signature' '(xs)'
is! 'replace.params' ['t', 'old', 'new']
is! 'help(nearest)' 'nearest(x, kind, limit = 1000000, within = 0)'

# table_words_positional
is! 'atan2.signature' '(a: float, b: float) -> float'
is! 'trim.signature' '(x) -> text'
is! 'split.parameters' ['t', 'separator']
is! 'sorted.signature' '(xs:list) -> list'

# the_programs_own_definition_wins
is! 'def sort(a){a}; sort.params' ['a']

# whole_number_math_words_show_int_parameters
is! 'use math; gcd.signature' '(a: int, b: int) -> int'
is! 'use math; factorial.signature' '(n: int) -> int'
is! 'use math; gcd(2^70, 2^65) == 2^65' true
is! 'use math; lerp.params' ['a', 'b', 't']

# a_bool_result_shows_as_bool
is! 'f(b) := b == 0; (function f).signature' '(b) -> bool'
is! 'use math; is_prime.signature' '(n: int) -> bool'
is! 'f(b) := b == 0; type(function f)' 'function: (b) -> bool'
is! 'f(b) := b + 1; (function f).signature' '(b) -> int'

# a_bool_through_calls_shows_as_bool
is! 'g(x) := x > 2; h(x) := g(x); (function h).signature' '(x) -> bool'
is! 'f(n) := if n == 0 then true else f(n - 1); (function f).signature' '(n) -> bool'
is! 'f(x) := x > 2; f.return_type' 'bool'
is! 'f(x) := x > 2; fs = [function f]; fs#1.return_type' 'bool'
