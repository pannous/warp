# generated by scripts/is_tests.py from test_stored_signals.rs: edit the Rust test, then run the script again

# a_stored_value_starts_with_its_default
is! 'stored theme_first = "dark"; theme_first' 'dark'
is! 'stored count_first = 1; count_first + 1' 2

# a_change_of_a_stored_value_is_kept_for_the_next_run
is! 'stored visits_kept = 0; visits_kept' 2
is! 'stored theme_kept = "dark"; theme_kept' 'light'

# a_local_named_stored_keeps_the_word
is! 'def f() { stored = 3; stored + 1 }; f()' 4
