# generated by scripts/is_tests.py from test_quasi_quote.rs: edit the Rust test, then run the script again

# a_hole_is_an_operand_of_a_phrase
is! 'match data(3 times {print 1}) {
	data($n times $b) => str(n)
	_ => "no"
}' '3'
is! 'match data(3 times {print 1}) {
	data($n times $b) => b == data {print 1}
	_ => no
}' true

# a_hole_named_like_a_unit_is_the_bound_code
is! 'f(c) := match c {
	data($m + 0) => key(m, "+", 1)
	_ => c
}
g(x) := f(x)
g(data(q + 0)) == data(q + 1)' true
is! 'x = data(q + 0)
x is data($m + 0)
str(m)' 'q'
is! 'x = data(q + 0)
x is data($h + 0)
str(h)' 'q'

# a_template_splices_a_variable
is! 'a = data(y)
data($a + 1) == data(y + 1)' true
is! 'a = data(y * 2)
data(f($a, 3)) == data(f(y * 2, 3))' true
is! 'n = data(k)
data([$n, 2]) == data([k, 2])' true

# a_template_splices_an_expression
is! 'k = data(width)
data(m.pop($(str(k)))) == data(m.pop("width"))' true

# a_replacement_template_splices_the_holes
is! '(data(y * 2 * 1 + 2) replace data($a * 1) with data($a + 10)) == data(y * 2 + 10 + 2)' true

# a_times_phrase_becomes_its_loop
is! 'rounds(c) := match c {
	data($n times $b) => data(for i in 0..$n $b)
	_ => c
}
rounds(data(3 times {print 1})) == data(for i in 0..3 {print 1})' true

# an_arm_template_splices_the_holes
is! 'swap(c) := match c {
	data($a - $b) => data($b - $a)
	_ => c
}
swap(data(x - 1)) == data(1 - x)' true

# a_rest_hole_binds_and_splices_the_remaining_items
is! 'tail(c) := match c {
	data($f($first, $rest...)) => data($f($rest...))
	_ => c
}
tail(data(g(1, 2, 3))) == data(g(2, 3))' true
is! 'tail(c) := match c {
	data($f($first, $rest...)) => data($f($rest...))
	_ => c
}
tail(data(g(1))) == data(g())' true

# a_template_in_a_lambda_splices_its_parameter
is! 'wrap(xs, f) := xs.map(x => data($f($x)))
wrap([data(a), data(b)], data(g)) == [data(g(a)), data(g(b))]' true

# a_quoted_literal_is_the_literal
is! 'n = data(3)
n' 3
is! 't = data("s")
t' 's'
is! 'f(x) := x
f(data(3))' 3

# the_value_after_an_assignment_takes_the_whole_phrase
is! 'f(a) := a
x = f([1, 2]) where it > 1
x' [2]
is! 'x = data(y * 1) replace data($a * 1) with a
x == data y' true

# a_replacement_walks_into_quoted_blocks
is! '(data(3 times {print 1}) replace data($n times $b) with data(for i in 0..$n $b)) == data(for i in 0..3 {print 1})' true
is! 'm = {a: 1}
m is map' true
