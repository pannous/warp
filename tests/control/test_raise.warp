# raise_ends_the_run_with_its_message
is! 'f(x) := if x < 0 then raise "negative" else x; f(4)' 4

# try_catches_a_raise
is! 'try raise "boom" else 3' 3
is! 'try throw "boom" else 2' 2
is! 'f(x) := if x < 0 then raise "negative" else x; try f(-1) else 7' 7
