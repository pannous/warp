# a_page_event_handler_is_exported_without_a_raise
is! 'count = 0; on click { count += 1; count }; count' 0

# a_raised_page_event_runs_its_handler_as_any_event
is! 'count = 0; on click { count += 1 }; emit click; emit click; count' 2

# a_page_event_handler_in_a_program_with_tasks_has_one_wrapper
