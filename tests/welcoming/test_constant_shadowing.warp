# generated by scripts/is_tests.py from test_constant_shadowing.rs: edit the Rust test, then run the script again

# a_constant_word_still_reads_and_names_fields
is! 'class circle{pi = 3}; c = circle{}; c.pi' 3
is! 'x = pi; x > 3.14 and x < 3.15' true
is! 'pi == 3' false

# a_field_named_like_a_constant_is_read_by_the_methods
is! 'class C{pi:int}; c = C(4); c.pi' 4
is! 'class C{r:int; pi = 3; f() := pi * r}; c = C(2); c.f()' 6
is! 'class C{r:int; f() := r > 0 ? pi : 0}; C(1).f() > 3' true
is! 'class C{pi:int}; x = pi; x > 3' true
