# a_let_in_one_function_leaves_another_alone
is! 'def a(){ let name = 1; name }
def b(){ name = 2; name = name + 1; name }
a() + b()' 4

# a_const_in_one_function_leaves_another_alone
is! 'def a(){ const x = 1; x }
def b(){ x = 2; x = 3; x }
a() + b()' 4
