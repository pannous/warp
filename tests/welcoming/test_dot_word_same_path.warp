# generated by scripts/is_tests.py from test_dot_word_same_path.rs: edit the Rust test, then run the script again

# a_computed_receiver_takes_the_word_without_parentheses
is! 's = "ab" + "c"; s.capitalize' 'Abc'
is! 'xs = 1..4; xs.product' 6
is! 'f() := [1 2 3]; xs = f(); xs.product' 6
is! 'f(xs) := xs.product; f([1 2 3])' 6

# a_field_of_that_name_still_wins
is! 'class Box{product:int}; f(b) := b.product; f(Box(7))' 7
is! 'f(m) := m.product; f({product: 5})' 5
