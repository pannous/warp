# generated by scripts/is_tests.py from test_welcoming_break.rs: edit the Rust test, then run the script again

# break_leaves_the_innermost_loop
is! 'i=0; while i<10 { i=i+1; if i==3 { break } }; i' 3
is! 'i=0
while i<10 { i=i+1; if i==3 { break } }
i' 3
is! 'i=0
while i<10 {
	i += 1
	if i == 3: break
}
i' 3
is! 'n=0; while true { n+=1; if n>=7 { break } }; n' 7
is! 's=0; for i in 0..10 { if i==4 { break }; s+=i }; s' 6
is! 'n=0
for i in 0..3 {
  for j in 0..10 {
    if j==2 { break }
    n+=1
  }
}
n' 6
is! 'first_over(limit) := { r=0; for x in [3,8,12,20] { if x>limit { r=x; break } }; r }
first_over(10)' 12

# continue_skips_to_the_next_pass_and_keeps_the_for_step
is! 'i=0; s=0; while i<10 { i=i+1; if i%2==0 { continue }; s+=i }; s' 25
is! 's=0; for i in 0..10 { if i%2==1 { continue }; s+=i }; s' 20
is! 's=0; for x in [1,2,3,4,5] { if x==2 { continue }; if x==5 { break }; s+=x }; s' 8
is! 's=0; for(i=0;i<6;i++){ if i==2 { continue }; s+=i }; s' 13
is! 's=""; for i in 0..4 { if i==2 { continue }; s += "x" }; s' 'xxx'
is! 's=""; for c in ["a","b","c","d"] { if c=="c" { continue }; s += c }; s' 'abd'
is! 'found=0; for i in 1..5 { for j in 1..5 { if j==i { continue }; if i*j==6 { found=i*10+j; break } }; if found>0 { break } }; found' 23

# next_is_continue_unless_it_names_a_variable
is! 's=0; for i in 1..6 { if i==3 { next }; s+=i }; s' 12
is! 'next=5; s=0; for i in 0..3 { s += next }; s' 15
