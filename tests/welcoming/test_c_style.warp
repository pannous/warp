# test_c_style_definition
is! 'float g(float x){ x = x - 1.5
return x }
g(4)' 2.5

# test_if_parenthesized_condition_then_statement
is! 'def f(x) { if (x<0) return 5
return 6 }
f(-1) * 10 + f(1)' 56

# test_if_assigning_a_float
is! 'g(x:float) := { if (x > 1) x = x - 1.5
return x }
g(4)' 2.5
is! 'g(x:float) := { if x > 1 { x = x - 1.5 } else { x = 0.5 }
return x }
g(0) + g(4)' 3.0

# test_number_parameter_holds_floats
is! 'number f(number x){ turn = 2.5 as float
x = x % turn
return x }
f(7)' 2.0
is! 'f(x:number) := type(x)
str(f(π))' 'class float'
