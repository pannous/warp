# let_var_and_const_declare_inside_any_block
is! 'fun f(n) { let m = n + 1; return m }; f(2)' 3
is! 'fun f(n) { var m = n + 1; return m }; f(2)' 3
is! 'fun f(n) { const m = n + 1; return m }; f(2)' 3
is! 's=0; for i in 1…3 { let t = i; s += t }; s' 6
is! 'if 1 { let y = 2; y } else { 0 }' 2
is! 'let x = 3; x' 3
is! 'var x = 0; x += 1; x' 1

# an_unknown_word_as_statement_is_loud
is! 'a;b;c' 'c'

# len_counts
is! 'len([1,2,3])' 3
is! 'len("hello")' 5
is! 'xs=[1 2 3]; len(xs)' 3
is! 'len([])' 0

# n_times_a_one_element_list_repeats_it
