is! 'pixel=[1 2 3]; pixel.insert(4); pixel' [1, 2, 3, 4]
is! 'b=[]; b.insert(5, at: 0); b' [5]
is! 'xs=["a" "b"]; xs.insert(0, "z"); xs' ['z', 'a', 'b']
is! 'xs=["a" "b"]; xs.insert("z", 1); xs' ['a', 'z', 'b']

# an_answered_ask_compiles_the_chosen_reading
is! '[1 2].map(x => x*3)' [3, 6]
is! 'xs=[1 2]; xs.insert(0, at: 4); xs' [1, 2, 0]

