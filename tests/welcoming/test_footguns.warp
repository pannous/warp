# test_newline_ends_statement
is! 'x=1
-1
x' 1

# test_law_holds_because_integers_do_not_wrap
is! 'square(x) := x*x
law square(x) >= 0
square(3037000500) > 2^63' true

# test_repeated_local_time_needs_disambiguation
is! 't=zoned(2030-10-27T02:30, "Europe/Berlin", disambiguation: earlier); t.offset' 7200
is! 't=zoned(2030-10-27T02:30, "Europe/Berlin", disambiguation: later); t.offset' 3600

# test_calendar_day_is_not_24_hours
is! '(2030-03-30T12:00[Europe/Berlin] + 1 day) - 2030-03-30T12:00[Europe/Berlin] == 23 hours' true
is! 't=add(2030-10-26T02:30[Europe/Berlin], 1 day, disambiguation: later); t.offset' 3600

# test_null_left_early_needs_no_other_check
is! 'f(n) := { x = ø; if n > 0 { x = n }; if x == ø { return 0 }; x + 1 }; f(2) + f(0)' 3

# test_sql_holes_are_parameters_not_text
is! «name="x' OR '1'='1";q=sql "SELECT * FROM t WHERE name = $name";q#1» 'SELECT * FROM t WHERE name = ?'
is! «name="x' OR '1'='1";q=sql "SELECT * FROM t WHERE name = $name";q#2» «x' OR '1'='1»

# test_shrinking_recursion_is_total
is! 'fib(n) := n<2 ? n : fib(n-1)+fib(n-2) ! Pure
fib(10)' 55

# test_pure_rejects_divergence
is! 'f(n) := n==0 ? 1 : n*f(n-1) ! Div
f(3)' 6

# test_function_equality_up_to_renaming
is! 'fib(n) = n < 2 ? n : fib(n - 1) + fib(n - 2); fibo(m) = m < 2 ? m : fibo(m - 1) + fibo(m - 2); fib==fibo' true

# test_finite_domain_function_equality
is! 'f(a:bool,b:bool):=not (a or b); g(a:bool,b:bool):=(not a) and (not b); f==g' true
