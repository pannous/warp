# generated by scripts/is_tests.py from test_pixel_unit.rs: edit the Rust test, then run the script again

# pixels_are_their_own_dimension
is! '3px + 2px == 5px' true
is! 'type(3px)' 'pixels'

# pixels_turn_into_lengths_through_the_displays_dpi
is! 'x = 1 inch * display.dpi
(x / display.dpi) == 1 inch' true
is! 'w = 5px
(w / display.dpi) * display.dpi == 5px' true
is! 'a = (10px)²
(a / display.dpi²) as inch² == (10px / display.dpi)²' true
is! 'display.dpi = 300 dpi
(1 inch * display.dpi) == 300px' true

# ppi_and_dots_are_dpi_and_pixels
is! '3ppi == 3dpi' true
is! '1inch * 96ppi == 96px' true
is! '2dot + 3px == 5px' true

# run_time_quantities_know_pixels
is! 'quantity(5, "px") + quantity(3, "dot") == quantity(8, "px")' true
is! '(quantity(1, "inch") * quantity(96, "ppi")).to("px") == quantity(96, "px")' true
