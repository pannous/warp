# generated by scripts/is_tests.py from test_dynamic_units.rs: edit the Rust test, then run the script again

# a_quantity_read_from_text_carries_its_unit
is! 'quantity("2.5 km").in("m")' 2500
is! 'quantity(".5 h").in("min")' 30

# quantities_of_one_dimension_add_and_compare
is! 'quantity("1 km") > quantity("999 m")' true
is! 'quantity("1 min") == quantity("60 s")' true

# quantities_multiply_divide_and_convert
is! 'quantity("6 m²").in("cm²")' 60000

# only_a_program_calling_quantity_carries_the_units_module
is! 'quantity(x) := x * 2
quantity(4)' 8
