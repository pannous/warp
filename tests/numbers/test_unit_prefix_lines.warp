# generated by scripts/is_tests.py from test_unit_prefix_lines.rs: edit the Rust test, then run the script again

# each_prefix_line_is_a_power_of_ten
is! '1 Gs == 1000000000 s' true
is! '1000 µg == 1 mg' true
is! '1 dam == 10 m' true

# only_an_si_dimension_takes_prefixes
is! '1 kK == 1000 K' true

# a_name_line_is_a_conversion_target
is! '2 hours in minutes == 120 min' true
is! '3 feet in inches == 36 inch' true

# a_program_writes_its_own_prefix_and_name_lines
is! 'prefix x := 10^4
3 xm in km == 30 km' true
is! 'unit fur := 201 m
name furlong := fur
3 fur in furlongs == 3 fur' true

# a_definition_named_name_or_prefix_stays_a_definition
is! 'name p := p.first; name {first: "Bo"}' 'Bo'
is! 'prefix s := s#1; prefix "ab"' 'a'
