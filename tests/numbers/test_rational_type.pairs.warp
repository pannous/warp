# generated by scripts/is_tests.py from test_rational_type.rs: edit the Rust test, then run the script again

# test_type_of_a_list_of_decimals_is_a_list_of_rational
'type([1.5 2.5])' 'list of rational'
'type([0.5, 0.75])' 'list of rational'
'type([1/2, 3/4])' 'list of rational'

# test_int_is_a_special_case_of_rational
'type([1 2.5])' 'list of rational'
'type([1/2 1])' 'list of rational'
'type([1 2])' 'list of int'
'type([2.0 3.0])' 'list of int'

# test_floats_are_not_rational
'type([1.5f 2.5f])' 'list of float'
'type([1.5 2.5f])' 'list of number'
'type([1 2.5f])' 'list of number'

# test_pi_is_real_whatever_its_representation
'type(π)' 'real'
'type(pi)' 'real'
'type([π π])' 'list of real'
'type([π 1])' 'list of number'

# test_other_mixes_stay_plain_lists
«type([1.5 'a'])» 'list'

# test_rational_and_rationals_are_type_words
'x:rational=1/3; x + 1/6 == 1/2' 1
'type(1.5)' 'rational'
'type(2.0)' 'int'
'type(1.5f)' 'float'
'x:rationals=[1/2, 3/4]; count x' 2
'x:rationals=[1/2, 3/4]; type(x)' 'list of rational'
'x:list<rational>=[1/2, 3/4]; type(x)' 'list of rational'
'x:list of rational=[1/2, 3/4]; type(x)' 'list of rational'
