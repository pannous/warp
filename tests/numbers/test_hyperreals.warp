# generated by scripts/is_tests.py from test_hyperreals.rs: edit the Rust test, then run the script again

# test_epsilon_times_omega_is_one
is! 'ε*ω' 1
is! 'ε*ω == 1' true
is! '1/ε == ω' true

# test_epsilon_is_positive_and_smaller_than_every_real
is! 'ε>0' true
is! 'ε<0.0001' true
is! '-ε<0' true
is! 'ω>1000000' true
is! '1+ε>1' true
is! 'ε*ε<ε' true
is! 'ω-1000<ω' true
is! 'π*ε<ε*4' true

# test_powers_expand_exactly
is! '(1+ε)^2 == 1+2ε+ε²' true
