# generated by scripts/is_tests.py from test_number_methods.rs: edit the Rust test, then run the script again

# test_rounding_methods_without_parentheses
is! 'x=2.6; x.round' 3
is! 'x=2.6; x.floor' 2
is! 'x=2.2; x.ceil' 3

# test_prefix_operator_words_as_methods
is! 'x=4.0; x.sqrt()' 2
is! 'x=4.0; x.sqrt' 2
is! 'x=-3; x.abs()' 3
is! 'x=-3; x.abs' 3
is! 'x=8.0; x.cbrt' 2
is! 'x=-2.5; x.norm()' 2.5

# test_a_field_named_like_a_number_method_stays_a_field
is! 'p={round:7}; p.round' 7
is! 'p={"abs":5}; p.abs' 5
