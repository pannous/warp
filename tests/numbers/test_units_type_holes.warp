# a_comparison_of_quantities_is_yes_or_no
is! '1 m < 2 m' true
is! '50 cm < 1 m' true
is! '1 m == 100 cm' true
is! '2 km < 3 m' false
is! 'x = 3 m; y = x * 2; y < 7 m' true

# a_variable_keeps_its_dimension
