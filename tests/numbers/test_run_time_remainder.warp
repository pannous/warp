# a_float_element_has_a_float_remainder
is! 'phases(xs) := [f % 1 for f in xs]; phases([sqrt(2)])#1 > 0.41' true
is! 'head_of(xs) := { f = xs#1; f % 1.5 }; head_of([sqrt(2) + 2])' 0.4142135623730949
is! 'head_of(xs) := { f = xs#1; 7 % f }; head_of([2.5])' 2.0
is! 'head_of(xs) := { f = xs#1; f rem 1 }; head_of([-1.25])' (-0.25)
is! 'head_of(xs) := { f = xs#1; f % 1 }; head_of([-1.25])' 0.75

# an_int_element_keeps_an_exact_remainder
