# euclidean_words_match_percent_and_floor_division
is! 'use math; same = true
for a in [-9, -7, 0, 7, 9] { for b in [-3, -2, 2, 3] {
	if euclidean_remainder(a, b) != a % b or euclidean_quotient(a, b) != a /! b { same = false }
} }
same' true
