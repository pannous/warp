# generated by scripts/is_tests.py from test_ratio_gcd_warp.rs: edit the Rust test, then run the script again

# gcd_is_never_negative
is! 'use math; gcd(-12, 18)' 6
is! 'use math; gcd(12, -18)' 6
is! 'use math; gcd(-4, 0)' 4
is! 'use math; gcd(0, 0)' 0
is! 'use math; gcd(2^70, 3 * 2^65) == 2^65' true

# lowest_terms_are_the_ratios_of_division
is! 'use math; r = lowest_terms(6, -4); "\\(r.numerator)/\\(r.denominator)"' '-3/2'
is! 'use math; r = lowest_terms(6, -4); r.numerator / r.denominator == 6 / -4' true
is! 'use math; r = lowest_terms(2^70, 3 * 2^65); "\\(r.numerator)/\\(r.denominator)"' '32/3'
is! 'use math; r = lowest_terms(-5, 0); "\\(r.numerator)/\\(r.denominator)"' '-1/0'
is! 'use math; r = lowest_terms(0, 0); "\\(r.numerator)/\\(r.denominator)"' '0/0'

# exact_quotient_divides_as_slash
is! 'use math; r = exact_quotient(RatioParts(1, 2), RatioParts(-3, 4)); "\\(r.numerator)/\\(r.denominator)"' '-2/3'
is! 'use math; r = exact_quotient(RatioParts(6, 1), RatioParts(3, 1)); "\\(r.numerator)/\\(r.denominator)"' '2/1'

# euclidean_words_match_percent_and_floor_division
is! 'use math; same = true
for a in [-9, -7, 0, 7, 9] { for b in [-3, -2, 2, 3] {
	if euclidean_remainder(a, b) != a % b or euclidean_quotient(a, b) != a /! b { same = false }
} }
same' true
is! 'use math; n = -(2^70); euclidean_remainder(n, 1000)' 576
is! 'use math; n = -(2^70); euclidean_quotient(n, 3) == n /! 3' true
is! 'use math; euclidean_quotient(-7, 2)' (-4)
