# generated by scripts/is_tests.py from test_shift_operators.rs: edit the Rust test, then run the script again

# test_shift_left_multiplies_by_a_power_of_two
is! '2 << 1' 4
is! '1 << 10' 1024
is! '-3 << 2' (-12)
is! '5 << 0' 5

# test_shift_right_floors_by_a_power_of_two
is! '8 >> 1' 4
is! '1024 >> 3' 128
is! '7 >> 1' 3
is! '-8 >> 1' (-4)
is! '-7 >> 1' (-4)
is! '5 >> 0' 5

# test_shifts_of_big_exact_ints
is! '1 << 100 == 2^100' true
is! '(2^100) >> 98' 4
is! '(1 << 200) >> 199' 2

# test_shift_precedence_and_variables
is! '1 << 3 + 1' 16
is! 'x=3;1 << x' 8
is! 'x=3;x<<1' 6
is! '1 << 2 < 5' true
is! 'f(n) := 1 << n; f(4)' 16

# test_angle_brackets_still_delimit_generics
is! '1 < 2' true
is! '2 > 1' true
