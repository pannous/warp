# generated by scripts/is_tests.py from test_math.rs: edit the Rust test, then run the script again

# test_arithmetic
is! '2+3' 5
is! '10-3' 7
is! '4*5' 20
is! '15/3' 5

# test_harder_arithmetic
is! '2+3*4' 14
is! '10-3*2' 4

# test_variable_minus
is! 'a=-1; b=2; b - a' 3

# test_hypen_versus_minus
is! 'a-b:2 c-d:4 a-b' 2

# test_modulo
is! '10007%10000' 7
is! '10007.0%10000' 7
is! '10007.0%10000.0' 7

# test_simple_variables
is! 'x:=10; y:=3; x+y' 13
is! 'x:=5; x*x' 25

# test_modulo_with_variables
is! '10007%10000.0' 7
is! 'i:=10007;i%10000' 7
is! 'i:=10007.0;i%10000.0' 7
is! 'i:=10007.1;i%10000.1' 7

# test_sinus_warp_import
is! 'use sin;sin π/2' 1
is! 'use sin;sin π' 0
is! 'use sin;sin 3*π/2' (-1)
is! 'use sin;sin 2π' 0
is! 'use sin;sin -π/2' (-1)

# test_units
is! '1 m + 1km' 1001

# test_eval
is! '√4' 2

# test_runtime_equality
is! '3==2+1' true
is! '3.1==3.1' true
is! '3*452==452*3' 1
is! '3*13==14*3' 0

# test_runtime_equality_autocast
is! '3==3.0' true

# test_ternary_with_comparison
is! '(1<2)?10:255' 10
is! '(1>2)?10:255' 255

# test_if_then_else
is! 'if 1 then 2 else 3' 2
is! 'if 0 then 2 else 3' 3
is! 'if 1<2 then 10 else 255' 10
is! 'if 1>2 then 10 else 255' 255

# test_if_block_syntax
is! 'if 1 { 2 }' 2
is! 'if 0 { 2 }' 0
is! 'if 1<2 { 10 }' 10
is! 'if 1>2 { 10 }' 0
is! 'if 1 { 2 } else { 3 }' 2
is! 'if 0 { 2 } else { 3 }' 3
is! 'if 1<2 { 10 } else { 255 }' 10
is! 'if 1>2 { 10 } else { 255 }' 255

# test_while_loop
is! 'x=3; while x>2 { x -= 1 }' 2
is! 'x=3; while x>0 do x = x - 1' 0

# test_compound_assignment
is! 'x=10; x += 5; x' 15
is! 'x=10; x -= 3; x' 7
is! 'x=10; x *= 2; x' 20
is! 'x=10; x /= 2; x' 5
is! 'x=10; x %= 3; x' 1
is! 'x=5; x += 3' 8
is! 'x=0; i=3; while i>0 { x += i; i -= 1 }; x' 6

# test_absolute_value_arithmetic
is! '‖3‖-1' 2

# test_fraction_multiplication
is! '⅓9' 3

# test_superscript_powers
is! '3⁴' 81

# test_global_with_pi
is! 'global x=1+π' (1.0 + pi)
is! 'global x=1+π;x+2' (3.0 + pi)
is! 'pi' pi
is! '1+pi' (1.0 + pi)

# test_sqrt_alias
is! 'sqrt 9' 3
is! 'sqrt 9.0' 3

# test_abs_alias
is! 'abs -3' 3
is! 'abs 3' 3
is! 'abs -3.14' 3.14
is! 'abs 3.14' 3.14
