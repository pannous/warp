# generated by scripts/is_tests.py from test_float_exact_context.rs: edit the Rust test, then run the script again

# test_explicit_cast_truncates_a_float
is! 'f(x:float) := x as int; f(2.7)' 2
is! 'f(x:float) := int(x); f(-2.7)' (-2)
is! 'f(x:float) := [10,20,30][int(x)]; f(2.0)' 30

# test_ffi_float_result_in_exact_context_is_refused_loudly
is! 'import fabs from m; fabs(0-2.5) % 2' 0.5

# a_rational_constant_of_exact_reals_in_a_runtime_program
is! 'xs = []; xs.add(√2 * √2 == 2); xs#1' true
is! 'xs = []; r = √2 * √2; r == 2' true
is! 'xs = []; r = √2 * √2; ok = r == 2; xs.add(ok); xs#1' true

# test_real_holds_roots_and_exact_unions_refuse_floats
is! 'x: real = sqrt(2); x * x > 1.99' true
is! 'x: real = 1/3; x * 3' 1
is! 'x: real = 1; x = sqrt(2); x > 1.4' true
is! 'f(x: real) := x * 3; f(1/3)' 1
is! 'f(x: real) := x > 1.4; f(sqrt(2))' true
is! 'x: int|rational = 1/3; x * 3' 1

# a_variable_declared_real_keeps_the_exact_root
is! 'x: real = sqrt(2); x * x' 2
is! 'x: real = sqrt(2); x * x == 2' true
is! 'x: exact = √3; x ^ 2' 3
is! 'x: real = sqrt(2); x as text' '√2'

# exact_is_real_and_keeps_the_root
is! 'exact x = √2; x * x' 2
is! 'real x = sqrt(2); x * x == 2' true
is! 'exact x = √2; x as text' '√2'
is! 'real == exact' true
is! '1/3 is exact' true
is! 'π is exact' true
is! '√2 is exact' true
is! 'type(√2) == real' true
is! '√2 is rational' false

# a_decimal_makes_float_arithmetic
is! 's = 0; for x in 1..100 { s += 1.0f/x^2 }; s' 1.6348839001848923
is! 'sqrt(2.0) == sqrt(2)' true
is! 'type(sqrt(2.0))' 'real'
