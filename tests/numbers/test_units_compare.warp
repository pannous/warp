# generated by scripts/is_tests.py from test_units_compare.rs: edit the Rust test, then run the script again

# quantities_compare_in_the_finer_unit
is! '3km == 3000m' true
is! '3km == 3001m' false
is! '3km != 3001m' true
is! '3km > 2999m' true
is! '3km < 2999m' false
is! '3km >= 3000m' true
is! '2999m <= 3km' true

# scalar_division_keeps_the_unit_and_same_dimension_division_is_a_number
is! '6 m / 2 m' 3
is! '6 km / 2000 m' 3

# a_variable_may_change_from_nothing_to_a_number_in_a_loop
is! 'x=ø; while x missing {x=1}; x' 1
is! 'x=ø; while x == ø {x=1}; x' 1
is! 'x=ø; while (not x) {x=2}; x' 2
