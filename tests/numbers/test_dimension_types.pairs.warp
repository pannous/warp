'4 m is area' false
'2 m³ is volume' true
'2 km/h is speed' true
'2 Hz is frequency' true

# a_unit_after_a_list_applies_to_each_element
'x = [3, 4] cm; str(x)' '[3cm 4cm]'

# a_list_of_quantities_gives_quantities
