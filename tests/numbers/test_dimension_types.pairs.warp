# a_quantity_is_its_dimension
'3 cm is length' true
'3 kg is length' false
'2 km/h is length' false
'4 m² is length²' true
'20°C is temperature' true
'x = 5 mi; x is length' true

# a_quantity_of_seconds_is_a_duration_and_a_time
'3 s is duration' true
'3 s is time' true
'3 m is time' false
'speed: length/duration = 3 km/h; speed is length/duration' true
'x = 3 cm; now is time' true

# speed_area_volume_and_frequency_are_named_dimensions
