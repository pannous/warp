# generated by scripts/is_tests.py from test_node_json.rs: edit the Rust test, then run the script again

# json_of_a_value_is_its_json_text
is! '{a: 1}.json' '{"a":1}'
is! 'x = {a: 1, b: [1, 2]}; x.json' '{"a":1,"b":[1,2]}'
is! '[1, 2, 3].json' '[1,2,3]'
is! '"hi".json' '"hi"'
is! '(1 + 2).json' '3'

# a_field_named_json_wins
is! 'x = {json: 3}; x.json' 3

# json_of_code_keeps_its_operations
is! 'parse("1+1").json' '{"+":[1,1]}'
is! 'parse("a * (b + 1)").json' '{"*":["a",{"+":["b",1]}]}'
is! 'parse("not x").json' '{"not":["x"]}'
is! 'parse("{a: 1+2}").json' '{"a":{"+":[1,2]}}'

# json_loses_nothing_silently
is! '{1: "a"}.json' '{"1":"a"}'
is! 'parse("f(x) := x*2").json' '{"(f x)":{"*":["x",2]}}'

# json_writes_numbers_exactly_or_says_so
is! '(2^70).json' '1180591620717411303424'
is! '[-(2^70) 1].json' '[-1180591620717411303424,1]'
is! '(1/3).json' '0.3333333333333333'

# a_fraction_in_json_warns_of_its_loss
is! '{third: 1/3}.json' '{"third":0.3333333333333333}'

# decimal_fractions_are_exact_json
is! 'use strict
{price: 0.1}.json' '{"price":0.1}'
is! 'use strict
{price: 19.99}.json' '{"price":19.99}'
is! 'use strict
p = {price: 2.5}
p.json' '{"price":2.5}'
is! '(-1/8).json' '-0.125'

# exact_json_refuses_a_lossy_fraction
is! 'use json; exact_json({a: 0.5}, [])' '{"a":0.5}'
