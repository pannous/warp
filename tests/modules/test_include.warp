# generated by scripts/is_tests.py from test_include.rs: edit the Rust test, then run the script again

# include_splices_the_whole_file_and_runs_it
is! 'include "tests/fixtures/counter.warp"; counter' 11
is! 'include tests/fixtures/counter; counter' 11
is! 'include tests/fixtures/counter.warp; counter' 11

# use_imports_only_the_declarations
is! 'use tests/fixtures/counter; counter' 10

# require_and_import_are_use
is! 'require square; square 7' 49
is! 'import square; square 7' 49
is! 'use square; square 7' 49
is! 'require math; floor(4.5)' 4

# a_nested_include_is_found_next_to_the_including_file
is! 'include tests/fixtures/nested/outer; outer_value' 2

# including_a_file_twice_includes_it_once_and_cycles_terminate
is! 'include tests/fixtures/counter; include tests/fixtures/counter; counter' 11
is! 'include tests/fixtures/cycle_a; a_done + b_done' 3

# a_sample_never_shadows_a_standard_module
is! 'use square; square 7' 49
