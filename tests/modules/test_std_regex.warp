# use_regex_matches_finds_and_replaces
is! 'use regex; matches("order 66", "[0-9]+")' true
is! 'use regex; matches("no digits", "[0-9]+")' false
is! 'use regex; first_match("order 66, then 7", "[0-9]+")' '66'
is! 'use regex; replace_all("a1 b22", "[0-9]+", "#")' 'a# b#'
is! 'use regex; replace_all("John Smith", "(\\\\w+) (\\\\w+)", "$2 $1")' 'Smith John'

# a_slashed_regex_after_matches
is! 'use regex; "abc" matches /a.c/' true
is! 'use regex; "abd" matches /a.c$/' false
is! 'use regex; "a/b" matches /a\\/b/' true
is! 'use regex; "order 66" matches /[0-9]+ ?$/ and 2 > 1' true
is! 'x = 6; x /2/ 3' 1
