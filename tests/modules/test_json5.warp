# generated by scripts/is_tests.py from test_json5.rs: edit the Rust test, then run the script again

# json_of_a_text_parses_it
is! «x = json("{'a':1}"); x.a» 1
is! 'x = json("[1, 2, 3]"); count(x)' 3

# json_parse_reads_json5
is! 'use json; json.parse("{\'quote\': \'say \\"hi\\"\'}").quote' 'say "hi"'
is! 'use json; json.parse("{\'a\': \'it\\\\\'s\'}").a' «it's»

# json_of_warp_data_is_that_data
is! «x = json{ 'a':1 }; x.a» 1

# strict_json_and_warp_literals_read_alike
is! 'x = json("{\\"a\\":1}"); x.a' 1
