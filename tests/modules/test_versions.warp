# generated by scripts/is_tests.py from test_versions.rs: edit the Rust test, then run the script again

# version_literals_have_two_dots_or_more
is! 'x = 1.2.3; x' '1.2.3'
is! 'version 1.10' '1.10'
is! '1.5' 1.5

# versions_compare_part_by_part
is! 'version 1.9 < version 1.10' true
is! '1.2.3 < 1.10.0' true
is! '1.2.0 == 1.2' true
is! 'version 2.0.1 >= version 2.1' false

# version_is_a_soft_keyword
is! 'version = 2; version + 1' 3

# use_requires_a_version_of_a_package
is! 'use uniscript >= 1.0; uniscript("<:alpha>")' 'α'
is! 'use uniscript from 0.1.5; uniscript("<:alpha>")' 'α'
is! 'use uniscript version 1.0.10; uniscript("<:alpha>")' 'α'

# an_older_version_comes_from_its_git_tag
is! 'use uniscript version 0.1.0; 42' 42

# tagged_version_literals
is! 'v1.2.3' '1.2.3'
is! 'v1.2.3 < 1.10.0' true
is! 'v2 = 7; v2' 7
is! 'use uniscript >= v1.0.0; uniscript("<:alpha>")' 'α'

# a_package_used_twice_is_loaded_once
is! 'use uniscript version 1.0.10; use uniscript from 1.0; uniscript("<:alpha>")' 'α'
is! 'use uniscript; use uniscript >= 1.0; uniscript("<:alpha>")' 'α'
