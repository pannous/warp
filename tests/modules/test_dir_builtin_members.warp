# generated by scripts/is_tests.py from test_dir_builtin_members.rs: edit the Rust test, then run the script again

# dir_of_a_list_lists_its_builtin_methods
is! '("count" in dir([1 2])) > 0' true
is! '"add" in dir([1 2])' true
is! 'xs = [3 4]; ("sort" in dir(xs)) > 0' true
is! '("sum" in dir(list)) > 0' true
is! '("unique" in dir([1 2])) > 0' true
is! 'f(v) := dir(v); ("map" in f([1])) > 0' true

# dir_of_a_text_lists_its_builtin_methods
is! '("upper" in dir("hi")) > 0' true
is! '("trim" in dir(text)) > 0' true
is! 'dir(text)#1' 'repeat'

# methods_list_what_dir_lists
is! 'xs = [1]
count(xs.methods) == count(dir(xs))' true
is! '("Cursor" in dir(text)) > 0' false

# every_builtin_method_is_a_function_value
is! 'f = function count; f("abc")' 3
is! 'f = function filter; f([1 2 3], x => x > 1)' [2, 3]
is! 'f = function add; xs = [1]; f(xs, 2); xs' [1, 2]
is! 'f = function insert; f([1 2], 5, 1)' [1, 5, 2]
is! 'count([function upper, function min])' 2
