# generated by scripts/is_tests.py from test_node_json.rs: edit the Rust test, then run the script again

# json_of_a_value_is_its_json_text
'{a: 1}.json'	'{"a":1}'
'x = {a: 1, b: [1, 2]}; x.json'	'{"a":1,"b":[1,2]}'
'[1, 2, 3].json'	'[1,2,3]'
'"hi".json'	'"hi"'
'(1 + 2).json'	'3'

# a_field_named_json_wins
'x = {json: 3}; x.json'	3

# json_of_code_keeps_its_operations
'parse("1+1").json'	'{"+":[1,1]}'
'parse("a * (b + 1)").json'	'{"*":["a",{"+":["b",1]}]}'
'parse("not x").json'	'{"not":["x"]}'
'parse("{a: 1+2}").json'	'{"a":{"+":[1,2]}}'

# json_loses_nothing_silently
'{1: "a"}.json'	'{"1":"a"}'
'parse("f(x) := x*2").json'	'{"(f x)":{"*":["x",2]}}'

# json_writes_numbers_exactly_or_says_so
'(2^70).json'	'1180591620717411303424'
'[-(2^70) 1].json'	'[-1180591620717411303424,1]'
'(1/3).json'	'0.3333333333333333'

# a_fraction_in_json_warns_of_its_loss
'{third: 1/3}.json'	'{"third":0.3333333333333333}'

# decimal_fractions_are_exact_json
'(-1/8).json'	'-0.125'

# exact_json_refuses_a_lossy_fraction
'use json; exact_json({a: 0.5}, [])'	'{"a":0.5}'
