# The rewrite engine's runs of statements rewritten right to left (F13, card engine-right-to-left-runs),
# core/rewrites.warp, notes/rewrites.md: warp only, no Rust twin

# a_pairwise_rule_folds_to_the_right
is! 'rewrite (take($a); take($b)) => take($a - $b)
take(x) := x
take(10)
take(5)
take(2)' 7

# a_rule_for_the_first_pair_sees_what_follows_joined
is! 'rewrite (item($a); done) => last_item($a)
rewrite (item($a); last_item($b)) => last_item($a + $b)
item(x) := x
last_item(x) := x
item(1)
item(2)
item(3)
done' 6

# clauses_join_from_the_last_pair
is! 'rewrite (fib($a) := $x; fib($n) := $y) => (fib($n) := if $n == $a then $x else $y) where $a is literal
fib(0) := 0
fib(1) := 1
fib(n) := fib(n - 1) + fib(n - 2)
[fib(i) for i in 0 .. 6]' [0, 1, 1, 2, 3, 5]
