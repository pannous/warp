# The rewrite engine's conditions on word lists and on where the matched code stands (lib/compiler/rewrites.warp,
# notes/rewrites.md, card engine-rule-conditions), written in warp: no Rust twin

# where_not_method_leaves_the_method_part
is! 'rewrite plus($x) => $x * 1000 where not method
plus(a, b) := a + b
n = 3
[plus(2), n.plus(4)]' [2000, 7]

# where_not_shadowed_leaves_a_definitions_own_word
is! 'rewrite plus($x) => $x * 1000 where not shadowed
f(t) := { plus = x => x + 1; plus(t) }
g(plus, t) := plus(t)
[plus(2), f(5), g(x => x - 1, 5)]' [2000, 6, 4]

# where_in_a_word_list
is! 'rewrite tag($w) => 1 where $w in [red, "green"]
rewrite tag($w) => 2
[tag(red), tag("green"), tag(blue)]' [1, 1, 2]

# where_not_in_a_word_list
is! 'rewrite mark($w) => 0 where $w not in [push, add]
rewrite mark($w) => 9
[mark(pop), mark(push), mark(add)]' [0, 9, 9]

# the_conditions_joined
is! 'rewrite plus($x) => $x * 1000 where not method and not shadowed
plus(a, b) := a + b
f(t) := { plus = x => x + 1; plus(t) }
n = 3
[plus(2), n.plus(4), f(5)]' [2000, 7, 6]

# a_place_word_first_among_the_conditions
is! 'rewrite keep $p => $p where value and $p is literal
rewrite keep $p => 0 where $p is not literal
y = 2
m = {a: keep 5, b: keep y}
[m.a, m.b]' [5, 0]

# a_place_word_last_among_the_conditions
is! 'rewrite keep $p => $p where $p is literal and value
rewrite keep $p => 0 where $p is not literal
y = 2
m = {a: keep 5, b: keep y}
[m.a, m.b]' [5, 0]
