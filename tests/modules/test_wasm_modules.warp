# generated by scripts/is_tests.py from test_wasm_modules.rs: edit the Rust test, then run the script again

# a_module_keeps_its_state_for_the_run
is! 'import tests/fixtures/wasm/counter.wasm; count_up(2); count_up(3)' 5

# a_module_is_found_by_name_or_path
is! 'use "tests/fixtures/wasm/counter.wasm"; count_up(5)' 5
is! 'import "tests/fixtures/wasm/fourty_two.wat"; ft' 42

# include_runs_main_globals_are_set_and_casts_are_ambiguous
is! 'include tests/fixtures/wasm/fourty_two' 42
is! 'include tests/fixtures/wasm/fourty_two; ft * 2' 84

# an_imported_module_gets_wasi_host_words_and_other_modules
is! 'import tests/fixtures/wasm/greeter; greet()' 3
is! 'import tests/fixtures/wasm/greeter; five()' 5
is! 'import tests/fixtures/wasm/greeter; count_twice(4)' 8
is! 'import tests/fixtures/wasm/counter.wasm; import tests/fixtures/wasm/greeter; count_up(1); count_twice(1)' 3

# a_c_module_takes_and_gives_texts_by_its_header
is! 'import tests/fixtures/wasm/shout; shout("hi there")' 'HI THERE!'
is! 'import tests/fixtures/wasm/shout; letters("hello")' 5
is! 'import tests/fixtures/wasm/shout; letters(shout("ab"))' 3
is! 'import tests/fixtures/wasm/shout; t = shout("ab"); letters(t)' 3

# libc_compiled_to_wasm_is_called_like_c
is! 'import tests/fixtures/wasm/libc_text; strlen("hello")' 5
is! 'import tests/fixtures/wasm/libc_text; strstr("haystack", "st")' 'stack'
is! 'import tests/fixtures/wasm/libc_text; strrchr("a/b/c", 47)' '/c'
is! 'import tests/fixtures/wasm/libc_text; atoi("42") + abs(-8)' 50
is! 'import tests/fixtures/wasm/libc_text; toupper(97)' 65
is! 'import tests/fixtures/wasm/libc_text; strchr("abc", 120)' ø

# a_c_modules_out_pointer_gives_the_result
is! 'import tests/fixtures/wasm/libc_text; strtol("42 apples", 10)' ' apples'
is! 'import tests/fixtures/wasm/libc_text; strtol("ff!", 16)' '!'

# zlib_compiled_to_wasm
is! 'import tests/fixtures/wasm/zlib; zlibVersion()' '1.3.2'
is! 'import tests/fixtures/wasm/zlib; crc32(0, "hello", 5)' 907060870
is! 'import tests/fixtures/wasm/zlib; crc32(0, "wasp", 4)' 3400449319
is! 'import tests/fixtures/wasm/zlib; adler32(1, "hello", 5)' 103547413
is! 'import tests/fixtures/wasm/zlib; compressBound(100)' 113

# zlib_compresses_into_a_buffer_and_back
is! 'import tests/fixtures/wasm/zlib; uncompress(100, compress(64, "hello hello hello"))' 'hello hello hello'
is! 'import tests/fixtures/wasm/zlib; crc32(0, compress(64, "hello hello hello"))' 3327255652
is! 'import tests/fixtures/wasm/zlib; crc32(0, "hello")' 907060870

# xxhash_compiled_to_wasm
is! 'import tests/fixtures/wasm/xxhash; XXH_versionNumber()' 802
is! 'import tests/fixtures/wasm/xxhash; XXH32("hello", 0)' 4211111929
is! 'import tests/fixtures/wasm/xxhash; XXH32("wasp", 4, 42)' 4089166900
is! 'import tests/fixtures/wasm/xxhash; XXH64("hello", 0)' 2794345569481354659
is! 'import tests/fixtures/wasm/xxhash; state = XXH32_createState(); XXH32_reset(state, 0); XXH32_update(state, "hel"); XXH32_update(state, "lo"); XXH32_digest(state)' 4211111929

# a_function_wrapping_a_c_call_gives_its_text
is! 'import tests/fixtures/wasm/shout; loud(t:text) := shout(t); loud("ab")' 'AB!'
is! 'import tests/fixtures/wasm/shout; loud(t) := shout(t); loud("a") + loud("b")' 'A!B!'
