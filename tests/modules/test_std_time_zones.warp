# generated by scripts/is_tests.py from test_std_time_zones.rs: edit the Rust test, then run the script again

# daylight_saving_starts_on_the_last_sunday_of_march_at_one_utc
is! 'use time; zone_offset(zone_named("Europe/Berlin"), days_from_date(2026, 3, 29) * 86400 + 3599)' 3600
is! 'use time; zone_offset(zone_named("Europe/Berlin"), days_from_date(2026, 3, 29) * 86400 + 3600)' 7200
is! 'use time; zone_offset(zone_named("America/New_York"), days_from_date(2026, 7, 1) * 86400)' (-14400)
is! 'use time; zone_offset(zone_named("Asia/Tokyo"), days_from_date(2026, 7, 1) * 86400)' 32400

# zone_instant_resolves_wall_times
is! 'use time; berlin = zone_named("Europe/Berlin"); zone_instant(berlin, 43200, Disambiguation::Reject)' 39600
is! 'use time; berlin = zone_named("Europe/Berlin"); zone_instant(berlin, days_from_date(2026, 3, 29) * 86400 + 9000, Disambiguation::Earlier) - (days_from_date(2026, 3, 29) * 86400 + 9000)' (-7200)
is! 'use time; berlin = zone_named("Europe/Berlin"); zone_instant(berlin, days_from_date(2026, 3, 29) * 86400 + 9000, Disambiguation::Later) - (days_from_date(2026, 3, 29) * 86400 + 9000)' (-3600)
is! 'use time; berlin = zone_named("Europe/Berlin"); zone_instant(berlin, days_from_date(2026, 10, 25) * 86400 + 9000, Disambiguation::Earlier) - (days_from_date(2026, 10, 25) * 86400 + 9000)' (-7200)
is! 'use time; berlin = zone_named("Europe/Berlin"); zone_instant(berlin, days_from_date(2026, 10, 25) * 86400 + 9000, Disambiguation::Later) - (days_from_date(2026, 10, 25) * 86400 + 9000)' (-3600)
