# The rewrite engine's place `parameter` (core/rewrites.warp F10, notes/rewrites.md), written in warp: no Rust twin

# a_rule_of_a_parameter_rewrites_a_definitions_head
is! 'rewrite given $p => $p where parameter
add(a, given b) := a + b
add(1, 2)' 3

# a_label_word_is_a_condition
is! 'rewrite $w $p => $p where $w is label and parameter
scaled(x, by factor) := x * factor
scaled(3, 4)' 12

# a_labelled_parameter_is_passed_by_its_word
is! 'swap(t: text, old: text, with new: text) := join(split(t, old), new)
swap("a-b", "-", "+")' "a+b"
