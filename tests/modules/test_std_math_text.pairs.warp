# a_module_function_maps_in_a_comprehension
'use text; words = ["ab", "cd"]; [capitalize w for w in words]'	['Ab', 'Cd']
'f(t) := upper(t[0]) + t[1..]; [f w for w in ["ab"]]'	['Ab']

# a_program_variable_leaves_the_module_its_words
