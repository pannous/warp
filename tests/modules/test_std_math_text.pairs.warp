# use_math_brings_libm_and_the_module
'use math; gcd(12, 18)'	6
'use math; lcm(4, 6)'	12
'use math; clamp(15, 0, 10) + clamp(-2, 0, 10) + clamp(5, 0, 10)'	15
'use math; sign(-3)'	-1
'use math; floor(2.7)'	2

# use_text_brings_its_words
'use text; "[" + pad_left("ab", 5) + "]"'	'[   ab]'
'use text; "[" + pad_right("ab", 5) + "]"'	'[ab   ]'
'use text; repeat("ab", 3)'	'ababab'

# use_text_formats_a_template
'use text; format("{} has {} items", ["cart", 3])'	'cart has 3 items'
'use text; format("{}{}", [1, 2])'	'12'
'use text; format("none", [])'	'none'

# use_text_brings_words_lines_capitalize_center
'use text; count(words(" a b  c "))'	3
'use text; count(lines("a\\nb"))'	2
'use text; capitalize("abc")'	'Abc'
'use text; "[" + center("ab", 6) + "]"'	'[  ab  ]'

# use_text_brings_title_slug_truncate
'use text; title("hello big world")'	'Hello Big World'
'use text; slug("Hello, Big World!")'	'hello-big-world'
'use text; truncate("abcdef", 4)'	'abc…'
'use text; truncate("abc", 4)'	'abc'

# use_math_rounds_to_places_factorial_is_prime_lerp
'use math; round_to(1.23456, 2)'	1.23
'use math; factorial(5)'	120
'use math; lerp(0, 10, 0.25)'	2.5
'use text; [is_blank("  "), is_blank(" a")]'	[yes, no]

# use_math_parity_digits_choose_mod_pow
'use math; [is_even(4), is_odd(4), is_odd(-3)]'	[yes, no, yes]
'use math; digits(1234)'	[1, 2, 3, 4]
'use math; [choose(5, 2), choose(10, 3), choose(3, 5)]'	[10, 120, 0]
'use math; mod_pow(2, 10, 1000)'	24

# use_text_cases_prefixes_counts_palindromes
'use text; remove_prefix("foobar", "foo")'	'bar'
'use text; remove_suffix("foobar", "bar")'	'foo'
'use text; remove_prefix("foobar", "x")'	'foobar'
'use text; count_of("banana", "an")'	2

# use_math_percent_angles_roots_factors_bases
'use math; percent(1, 4)'	25
'use math; to_degrees(pi)'	180
'use math; to_radians(180) == pi'	true
'use math; [isqrt(17), isqrt(16), isqrt(0)]'	[4, 4, 0]
'use math; [is_square(16), is_square(17)]'	[1, 0]
'use math; divisors(12)'	[1, 2, 3, 4, 6, 12]
'use math; prime_factors(360)'	[2, 2, 2, 3, 3, 5]
'use math; [from_base("ff", 16), from_base("101", 2)]'	[255, 5]

# use_text_cases_wraps_and_cuts
'use text; word_count("a b  c")'	3
'use text; kebab_case("Hello World")'	'hello-world'
'use text; camel_case("Hello big World")'	'helloBigWorld'
'use text; indent("a\\nb", 2) == "  a\\n  b"'	true
'use text; between("a[bc]d", "[", "]")'	'bc'
'use text; wrap("aaa bbb ccc", 7) == "aaa bbb\\nccc"'	true

# use_math_brings_descriptive_names_and_cmath_the_c_library
