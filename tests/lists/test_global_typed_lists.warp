# generated by scripts/is_tests.py from test_global_typed_lists.rs: edit the Rust test, then run the script again

# a_global_number_list_read_by_a_function_is_an_array
is! 'n = 100000; xs = []; for i in 1..n { xs.add(i) }; at(i) := xs#i; s = 0; for i in 1..n { s += at(i) }; s' 4999950000
is! 'xs = [1, 2, 3]; size() := count xs; total() := sum xs; [size(), total()]' [3, 6]
is! 'xs = []; for i in 1 to 4 { xs.add(i) }; doubled() := { s = 0; for x in xs { s += 2 * x }; s }; doubled()' 20

# a_global_float_list_a_function_changes_keeps_its_floats
is! 'hb = [random() for j in 0..4]; def g() { global hb; hb[1] = hb[1] + 0.5 }; g(); hb[1] >= 0.5 and hb[1] < 1.5' true
is! 'hb = []; for j in 0..4 { hb.push(random()) }; def g() { global hb; hb[1] = hb[1] + 0.5 }; g(); hb[1] >= 0.5 and hb[1] < 1.5' true
is! 'hb = [0.0, 0.0, 0.0]; for j in 0..3 { hb[j] = random() }; def g() { global hb; hb[1] = hb[1] + 0.5 }; g(); hb[1] >= 0.5 and hb[1] < 1.5' true
is! 'hb = [random() for j in 0..4]; def f() { t = hb[1]; t + 1 }; def g() { global hb; hb[1] = 0.25 }; g(); f()' 1.25
is! 'hb = [random() for j in 0..4]; def g() { global hb; hb[1] = 0.75 }; g()' 0.75

# a_global_array_a_function_writes_stays_an_array
is! 'global s = int[20000]; def f() { for i in 0..20000 { s[i] = i } }; f(); s[19999]' 19999
is! 'global s = int[5]; def f(v) { s[2] = v; s[3] += 2 }; f(7); f(1); s' [0, 0, 1, 4, 0]

# a_function_appends_to_a_global_list_in_place
is! 'out = []; add(i) := { global out; out += [i] }; for i in 1 to 100000 { add(i) }; count(out)' 100000
is! 'out = [0]; held = out; add(i) := { global out; out += [i] }; add(1); count(held)' 2
