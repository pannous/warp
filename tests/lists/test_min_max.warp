# generated by scripts/is_tests.py from test_min_max.rs: edit the Rust test, then run the script again

# test_min_max_of_ints
is! 'min(1,2)' 1
is! 'max(1,2)' 2
is! 'min(3,1,2)' 1
is! 'max(3,1,2)' 3

# test_min_max_of_floats_and_mixed
is! 'min(1.5,2.5)' 1.5
is! 'max(1.5,2)' 2

# test_min_max_of_variables_and_expressions
is! 'x=5; min(x,3)' 3
is! 'max(1+1,3)' 3
is! '1+max(1,2)' 3
is! 'max(1,min(5,2))' 2

# test_min_keeps_its_types
is! 'min(a,b):=a*b; min(2,3)' 2

# test_min_max_arguments_must_be_side_effect_free
is! 'f(x):=x; min(f(1),2)' 1

# test_a_float_max_accumulates_in_a_loop
is! 'l=[0.0 as float for c in 0..2]; r=0.0; for b in 0..2 { x = 0.5; r += max(0.0, x - l[b]) }; r' 1.0
is! 'r=0.0; r += (t = 0.5 as float; t); r' 0.5
