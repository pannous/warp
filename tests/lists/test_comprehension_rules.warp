# comprehensions as the sugar rules of core/sugar/comprehensions.warp (card sugar-comprehensions)

# a rule's template holding a comprehension (#3004)
is! 'rewrite doubled $xs => [$x * 2 for $x in $xs]; ys = [1, 2]; doubled ys' [2 4]

# a filter after a second clause, each clause its own filter
is! 'xs = [1, 2, 3]; [a * 10 + b for a in xs if a > 1 for b in xs if b > a]' [23]

# an element of several words, filtered
is! 'f(x) := x + 1; [f w for w in [1, 2, 3] if w > 1]' [3 4]

# a pair of loop variables
is! 'm = {a: 1, b: 2}; [v * 10 for k, v in m]' [10 20]

# a generator argument with a filter
is! 'sum(x for x in [1, 2, 3, 4] if x > 2)' 7
