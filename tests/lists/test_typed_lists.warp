# generated by scripts/is_tests.py from test_typed_lists.rs: edit the Rust test, then run the script again

# test_int_array_index_count_sum_for
is! 'xs=[3,1,4]; xs#2' 1
is! 'xs=[3,1,4]; xs[0]' 3
is! 'xs=[3,1,4]; #xs' 3
is! 'xs=[3,1,4]; count xs' 3
is! 'xs=[3,1,4]; xs.count' 3
is! 'xs=[3,1,4]; sum xs' 8
is! 'xs=[3,1,4]; s=0; for x in xs {s+=x}; s' 8
is! 'xs=[3,1,4]; s=0; for x in xs {s=s*10+x}; s' 314
is! 'xs=[3,1,4]; i=xs#3; i*2' 8

# test_int_array_assignment_keeps_value_semantics
is! 'xs=[1,2,3]; xs#2=7; xs#2' 7
is! 'xs=[1,2,3]; xs[1]=7; sum xs' 11
is! 'xs=[1,2,3]; ys=xs; ys#1=9; xs#1' 9
is! 'xs=[1,2,3]; ys=xs; ys#1=9; ys#1' 9
is! 'xs=[1,2,3]; s=0; for x in xs {xs#1=10; s+=x}; s' 6
is! 'xs=[1,2,3]; xs=[4,5]; #xs' 2

# test_zero_filled_int_list_is_an_array
is! 'xs = int[5]; xs[2] = 7; sum xs' 7
is! 'xs = int[5]; #xs' 5

# test_int_expression_items_are_an_array
is! 'a=2; xs=[a, a+1, a*3]; xs#3' 6

# test_appended_int_list_is_an_array
is! 'xs=[]; for i in 1..5 {xs.add(i*i)}; xs#3' 9
is! 'xs=[]; for i in 1..5 {xs.add(i*i)}; sum xs' 30
is! 'xs=[7]; for i in 1..20 {xs.add(i)}; #xs' 20
is! 'xs=[1]; ys=xs; xs.add(2); #ys' 2
is! 'xs=[1]; ys=xs; ys.add(2); #xs' 2

# test_map_and_element_wise_over_int_arrays
is! 'xs=[1,2,3]; ys = xs.map(x => x*x); ys#3' 9
is! 'xs=[1,2,3]; each xs {it*10}' 30

# test_int_arrays_inside_functions
is! 'def total(){xs=int[5]; for i in 1..5 {xs[i]=i}; sum xs}; total()' 10
is! 'def second(){xs=[5,6,7]; xs#2}; second()' 6

# test_float_list_is_a_float_array
is! 'xs=[1.5f, 2.5f]; #xs' 2

# test_sum_of_a_typed_list_is_one_operation
is! 'xs=[1,2,3]; sum xs' 6
is! 'xs=[]; sum xs' 0

# a_list_parameter_holds_elements_of_any_type
is! 'g(ls: list) := ls.map(p => p.n); g([{n: "a"}])' ['a']
is! 'g(ls: list) := ls.filter(p => p.n == "a"); #g([{n: "a"}, {n: "b"}])' 1
is! 'g(ls: list) := { out = ""; for c in ls { out += c }; out }; g(["a" "b"])' 'ab'
is! 'g(xs: list) := { s = 0; for x in xs { s += x }; s }; g([1 2 3]) + 1' 7
