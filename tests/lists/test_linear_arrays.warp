# generated by scripts/is_tests.py from test_linear_arrays.rs: edit the Rust test, then run the script again

# a_linear_array_reads_and_writes_its_cells
is! 'linear xs = int[5]; xs#2 = 7; xs#3 += 4; [xs#2, xs#3, #xs, xs#1, xs.count]' [7, 4, 5, 0, 5]
is! 'linear ys = float[3]; ys#1 = 1.5; ys#1 += 0.25; ys#1' 1.75
is! 'linear xs = int[1000000]; for i in 1 to 1000000 { xs#i = i }; s = 0; for i in 1 to 1000000 { s += xs#i }; s' 500000500000

# a_linear_array_is_a_list_as_a_whole
is! 'linear xs = int[3]; xs#1 = 4; xs' [4, 0, 0]
is! 'linear xs = int[4]; f(a) := a#2 + 1; xs#2 = 5; f(xs)' 6
is! 'linear xs = int[2]; xs#2 = 3; t = 0; for x in xs { t += x }; t' 3

# a_for_loop_over_a_linear_array_gives_its_last_value
is! 'linear xs = int[3]; xs#3 = 7; for x in xs { x }' 7
is! 'linear xs = int[3]; xs#1 = 2; r = for x in xs { x * 10 }; r' 0

# a_numeric_map_of_a_linear_array_writes_a_new_block
is! 'linear xs = int[3]; xs#2 = 5; xs' [0, 5, 0]

# an_item_of_a_linear_array_reads_in_a_text_hole
is! 'linear xs = float[3]; xs#1 = 2.5; "a \\(xs#1) b"' 'a 2.5 b'
is! 'linear xs = int[2]; xs#2 = 7; "\\(#xs): ${xs#2}"' '2: 7'

# element_wise_operators_pair_two_linear_arrays
is! 'linear xs = float[3]; linear ys = float[3]; xs#1 = 2.0; ys#1 = 3.0; xs#2 = 4.0; ys#2 = 0.5
sum(xs .* ys)' 8.0
is! 'linear xs = float[3]; linear ys = float[3]; xs#1 = 2.0; ys#1 = 3.0; xs#2 = 4.0; ys#2 = 0.5
dot(xs, ys)' 8.0
is! 'linear xs = float[3]; linear ys = float[3]; xs#1 = 2.0; ys#1 = 3.0; xs#2 = 4.0; ys#2 = 0.5
zs = xs .+ ys .* 2; zs#2' 5.0
