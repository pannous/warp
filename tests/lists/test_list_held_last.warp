# a_list_held_last_keeps_its_items
is! 'class Box { items: list }
def filled(n: int): int {
	items = n times [0]
	at = n - 2
	while at >= 0 {
		items[at] = items[at + 1] + 1
		at = at - 1
	}
	box = Box{items: items}
	box.items[0]
}
filled(200000)' 199999
is! 'class Box { items: list }; xs = [1, 2, 3]; xs[1] = 5; b = Box{items: xs}; b.items' [1, 5, 3]

# a_list_changed_after_its_holder_is_shared
is! 'class Box { items: list }; xs = [1, 2, 3]; b = Box{items: xs}; xs[1] = 5; b.items' [1, 5, 3]
is! 'class Box { items: list }; xs = [1, 2]; for i in 1..3 { b = Box{items: xs}; xs[0] = i }; b.items' [2, 2]
