# generated by scripts/is_tests.py from test_min_max_lists.rs: edit the Rust test, then run the script again

# test_extremum_of_a_list_literal
is! 'max([1 5 2])' 5
is! 'min([4 2 9])' 2
is! 'min([7])' 7

# test_extremum_of_a_list_variable
is! 'xs=[4 2 9]; max(xs)' 9
is! 'xs=[4 2 9]; min(xs)' 2
is! 'xs=[4 2 9]; 1+max(xs)' 10
is! 'xs=[4 2 9]; max(xs)+min(xs)' 11

# test_several_arguments_still_work
is! 'max(3,7)' 7
is! 'min(3,7,1)' 1

# test_extremum_of_a_list_variable_in_float_arithmetic
is! 'xs=[4 2 9]; 0.5+max(xs)' 9.5
