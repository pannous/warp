# generated by scripts/is_tests.py from test_counting_word_operands.rs: edit the Rust test, then run the script again

# a_counting_word_takes_the_name_after_it
is! 'xs = [1, 2, 3]; 1 + count xs' 4
is! 'xs = [1, 2, 3]; 3 == size xs' true
is! 'xs = [1, 2, 3]; y = 1 + length xs; y' 4
is! 'w = "abc"; 2 - len w' (-1)

# a_variable_named_count_stays_a_variable
is! 'count = 2; 1 + count' 3
is! 'count = 5; a = 2; [count, a]' [5, 2]

# a_block_after_the_operand_is_the_body
is! 't = [1, 2, 3]; i = 0; while i < count t { i++ }; i' 3
is! 't = [1, 2, 3]; i = 0; if i < count t { i = 7 }; i' 7
is! 'xs = [1, 2]; ys = [x - count xs for x in xs]; ys' [-1, 0]
is! 'x = 2; x is a number' true
