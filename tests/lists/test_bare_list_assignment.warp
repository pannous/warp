# generated by scripts/is_tests.py from test_bare_list_assignment.rs: edit the Rust test, then run the script again

# spaced_values_are_a_list
is! 'a=1 2 3; a' [1, 2, 3]
is! 'xs = 1+1 2+2; xs' [2, 4]
is! '2⁰ 2¹ 2²' [1, 2, 4]
is! 'xs = "a" "b"; count xs' 2

# spaced_values_in_every_statement_position_are_a_list
is! '{1+1 2+2}' [2, 4]
is! 'if yes { 1+1 2+2 }' [2, 4]
is! 'f() := 1+1 2+2; f()' [2, 4]
is! 'sum 1+1 2+2' 6
is! 'max 1+1 2+2' 4
is! 'sum 2 4' 6

# each_reading_has_its_explicit_form
is! 'a=[1,2,3]; a' [1, 2, 3]
is! 'a=[1 2 3]; count a' 3
is! 'a=1; 2; 3; a' 1

# a_bracketed_list_never_asks
is! 'a=(1,2,3); count a' 3
is! 'a=1; b=2; a+b' 3
is! 'x=1
y=2
x+y' 3
