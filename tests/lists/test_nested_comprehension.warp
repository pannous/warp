# generated by scripts/is_tests.py from test_nested_comprehension.rs: edit the Rust test, then run the script again

# two_for_clauses_nest
is! '[f * i for f in [1, 2] for i in 0..3]' [0 1 2 0 2 4]
is! 'count([f * i for f in [1, 2] for i in 0..3])' 6
is! '[x + y for x in [10, 20] for y in [1, 2] for z in [0, 0]]' [11 11 12 12 21 21 22 22]

# filters_sit_between_and_after_the_clauses
is! '[f * i for f in [1, 2] for i in 0..3 if i > 0]' [1 2 2 4]
is! '[f * i for f in [1, 2] if f > 1 for i in 0..3]' [0 2 4]
is! '[f + i for f in [1, 2, 3] if f != 2 for i in [10, 20] if i < 20]' [11 13]

# a_where_condition_starts_with_a_count
is! 'idx=[1 2]; done=[5]; #[i for i in idx where #[d for d in done where d == i] == 0]' 2
is! 'xs=[1 2 3]; [x for x in xs where -x < -1]' [2 3]
is! 'to = [2 0]; idx=[1 2]; #[i for i in idx where to#i == 0]' 1
is! 'from = [5 5 4 4 2 3]
to = [2 0 0 1 3 1]
idx = [1 2 3 4 5 6]
done = []
while #done < 6 {
	pick = -1
	for n in 0 to 5 {
		isdone = #[d for d in done where d == n] > 0
		blockers = #[i for i in idx where to#i == n and #[d for d in done where d == from#i] == 0]
		if pick < 0 and not isdone and blockers == 0 : pick = n
	}
	done += [pick]
}
done' [4 5 0 2 3 1]
