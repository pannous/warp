# a_glued_sign_starts_the_next_item_after_anything
is! 'a=5; [a -1]' [5, -1]
is! 'a=5; [a +1]' [5, 1]
is! 'a=5; [a*2 -1 a]' [10, -1, 5]
is! 'a=5; [a -1]' [5, -1]

# spaced_and_glued_operators_still_subtract
is! 'a=5; [a - 1]' [4]
is! 'a=5; [a-1]' [4]
is! 'a=5; [a -1, 2]' [4, 2]
is! 'a=5; xs=[1 2 3 4]; xs[a -2]' 4
is! 'a=5; [(a -1)]' [4]
is! 'a=5; a -1' 4
