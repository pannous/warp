# generated by scripts/is_tests.py from test_where_filter.rs: edit the Rust test, then run the script again

# where_filters_by_it
is! 'xs = [1, 2, 3]; xs where it > 1' [2 3]
is! 'xs = ["a", ""]; count(xs where it != "")' 1
is! 'xs = [1, 2, 3, 4, 5]; xs where it > 1 and it < 5' [2 3 4]
is! 'xs = [1, 2, 3]; ys = xs where it > 1; count(ys)' 2
is! 'f(v) := v where it > 1; f([1, 2, 3])' [2 3]
is! 'people = [{age: 20}, {age: 10}]; count(people where it.age > 18)' 1

# where_with_an_assignment_binds
is! 'x * 2 where x = 3' 6
is! 'xs.reduce(0) { $0 + $1 } where xs = [1,2,3]' 6

# an_assigned_filter_may_start_with_not
is! 'xs = [yes, no, no]; waiting = xs where not it; count(waiting)' 2
is! 'todos = [{done: yes}, {done: no}]; open = todos where not it.done; count(open)' 1
