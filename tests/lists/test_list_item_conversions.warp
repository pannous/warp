# a_loop_variable_read_once_a_round_stays_a_node_list
is! 'n = 3000
rooms = [0..n as list, 0..n as list, 0..n as list, 0..n as list]
sums = [sum([room[i] for room in rooms]) for i in 0..n]
sums[n - 1] + sums[7]' (4 * 2999 + 4 * 7)

# a_loop_variable_read_in_an_inner_loop_keeps_its_values
