# generated by scripts/is_tests.py from test_element_wise_scalar.rs: edit the Rust test, then run the script again

# element_wise_on_a_number_is_the_plain_operator
is! '6 ./ 2' 3
is! 'sq = @(x) x.^2; sq(3)' 9
is! 'f(x) := x .+ 1; f(4)' 5
is! 'add = @(a, b) a .* b; add(3, 4)' 12

# element_wise_on_a_list_still_maps
is! 'sq = @(x) x.^2; sq([1,2,3])' [1 4 9]
is! 'f(x) := x .+ 1; f([4,5])' [5 6]
is! 'xs=[1,2]; xs .* 3' [3 6]
is! 'g(xs) := count(xs) + (xs .* 2)#1; g([5,6])' 12
