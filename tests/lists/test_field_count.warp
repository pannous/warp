# generated by scripts/is_tests.py from test_field_count.rs: edit the Rust test, then run the script again

# test_count_of_a_field
is! 's = {fs: [1,2]}; s.fs.count' 2
is! 's = {fs: [1,2]}; count(s.fs)' 2
is! 's = {name: "ab"}; s.name.count' 2

# a_parameter_counts_with_the_call_form
is! 'f(x) := x.count(); f([1, 2, 3])' 3
is! 'f(x) := x.size(); f([1, 2])' 2
is! 'f(x) := x.length(); f("abc")' 3
