# generated by scripts/is_tests.py from test_empty_list_count.rs: edit the Rust test, then run the script again

# the_count_of_an_empty_list_is_zero
is! 'xs=[]; size xs' 0
is! 'xs=[]; count(xs)' 0

# a_loop_over_an_empty_list_does_not_run
is! 'xs=[]; n=0; for x in xs {n=n+1}; n' 0

# a_one_element_list_still_counts_one
is! 'xs=[7]; size xs' 1

# the_counting_properties_of_an_empty_list_need_no_null_check
is! 'xs=[]; xs.size + 1' 1

# a_counting_property_is_a_number_in_arithmetic
is! 'xs=[4 5 6]; xs.size + 1' 4
is! 'xs=[4 5 6]; 2 * xs.count' 6
is! «t='héllo'; t.length - 1» 4
