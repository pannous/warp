# generated by scripts/is_tests.py from test_map_field_named_like_word.rs: edit the Rust test, then run the script again

# a_parameter_s_field_named_like_a_list_word_is_the_field
is! 'f(m) := m.first; f({first: 9})' 9
is! 'f(m) := m.last; f({last: "z"})' 'z'
is! 'f(m) := m.first + 1; f({first: 9})' 10

# a_parameter_holding_a_list_still_gets_the_word
is! 'f(m) := m.first; f([4 5])' 4
is! 'f(m) := m.first + 1; f([4 5])' 5

# a_loop_element_s_field_named_like_a_list_word_is_the_field
is! 'r = 0; for p in [{first: 2}] { r = p.first }; r' 2
is! 'r = 0; for p in [{first: 2}, {first: 3}] { r += p.first }; r' 5
