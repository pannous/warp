# a_comprehension_beside_an_own_push_function
is! 'class Stack { items: [int] }
s = Stack{items: []}
def push(st, x) {
	st.items += [x]
}
def pop(st) {
	n = #st.items
	top = st.items#n
	st.items = [st.items#i for i in 1 to n - 1]
	top
}
push(s, 1)
push(s, 2)
push(s, 3)
pop(s)' 3
