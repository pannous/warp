# generated by scripts/is_tests.py from test_unpacking.rs: edit the Rust test, then run the script again

# unpack_tuple_values
is! 'a, b = 1, 2; a*10+b' 12

# unpack_parenthesized_tuple
is! 'a, b = (1, 2); a*10+b' 12

# unpack_list_literal
is! 'a, b = [1, 2]; a*10+b' 12

# unpack_list_variable
is! 'xs = [1, 2]; a, b = xs; a*10+b' 12

# unpack_tuple_function
is! 'f() := return 1, 2; a, b = f(); a*10+b' 12

# unpack_list_function
is! 'f() := [1, 2]; a, b = f(); a*10+b' 12

# swap
is! 'a=1; b=2; a, b = b, a; a*10+b' 21

# list_target
is! '[a, b] = [1, 2]; a*10+b' 12

# parenthesized_target
is! '(a, b) = 1, 2; a*10+b' 12

# star_rest_from_list
is! 'a, *rest = [1, 2, 3]; rest == [2, 3]' 1
is! 'a, *rest = [1, 2, 3]; a' 1

# star_rest_from_values
is! 'a, *rest = 1, 2, 3; rest == [2, 3]' 1

# star_init
is! '*init, last = [1, 2, 3]; init == [1, 2] and last == 3' 1

# star_middle
is! 'a, *mid, z = [1, 2, 3, 4]; mid == [2, 3] and a+z == 5' 1

# star_rest_empty
is! 'a, *rest = [1]; rest == []' 1

# star_rest_from_tuple_function
is! 'f() := return 1, 2, 3; a, *rest = f(); rest == [2, 3]' 1

# nested_unpacking
is! '(a, b), c = (1, 2), 3; a*100+b*10+c' 123

# unpack_text
is! 'a, b = "hi"; a' 'h'

# underscore_discards
is! 'f() := return 1, 2; _, b = f(); b' 2

# for_loop_unpacking
is! 's = 0; for a, b in [[1, 2], [3, 4]] { s += a*b }; s' 14
