# list_methods
is! 'xs = [1 2]; xs.extend([3 4]); count(xs)' 4
is! 'xs = [1 2]; ys = xs; xs.extend([3]); count(ys)' 3
is! 'xs = [5 6 7]; xs.index(6)' 1
