# generated by scripts/is_tests.py from test_interpolation.rs: edit the Rust test, then run the script again

# swift_holes_interpolate_any_expression
is! 'x=3; "a \\(x+1) b"' 'a 4 b'
is! 'name="Bob"; "hi \\(name)!"' 'hi Bob!'
is! '"\\(1+2)"' '3'
is! 'x=2; "\\(x)\\(x*2)"' '24'
is! '"sum: \\((1+2)*3)"' 'sum: 9'

# curly_dollar_holes_interpolate_bare_dollars_stay_text
is! 'x=3; "a ${x+1} b"' 'a 4 b'
is! 'name="Bob"; "hi $name!"' 'hi $name!'
is! 'n=7; "$n items"' '$n items'
is! 'x=3; "$x and ${x}"' '$x and 3'

# holes_take_parameters_lists_and_exact_numbers
is! 'f(n):="n is \\(n)"; f(4)' 'n is 4'
is! 'xs=[1 2]; "xs=\\(xs)"' 'xs=[1 2]'
is! 'y=2.5; "v=\\(y)"' 'v=2.5'
is! '"a \\("b") c"' 'a b c'

# holes_take_text_results_of_library_words
is! 'name="bob"; "hi \\(name.upper)"' 'hi BOB'

# single_quotes_stay_literal
is! «'hi $name'» 'hi $name'
is! «'a ${x} b'» 'a ${x} b'

# a_dollar_before_a_digit_or_space_is_a_dollar_sign
is! '"costs $5"' 'costs $5'
is! '"$ 5"' '$ 5'
is! '"a\\$b"' 'a$b'

# dollar_arguments_and_templates_keep_working
is! 'add1(x):=$0+1; add1(3)' 4
is! «name="x' OR '1'='1";q=sql "SELECT * FROM t WHERE name = $name";q#1» 'SELECT * FROM t WHERE name = ?'
is! «name="x' OR '1'='1";q=sql "SELECT * FROM t WHERE name = $name";q#2» «x' OR '1'='1»
is! 'name="x";q=sql "SELECT * FROM t WHERE name = \\(name)";q#1' 'SELECT * FROM t WHERE name = ?'
is! 'file="a b";c=sh "rm -f \\(file)";c#3' 'a b'
is! 'a="x";b="y";q=sql "SELECT * FROM t WHERE a = $a AND b = ${b}";q#3' 'y'
is! 'a="x";b="y";q=sql "SELECT * FROM t WHERE a = $a AND b = ${b}";q#1' 'SELECT * FROM t WHERE a = ? AND b = ?'

# round_dollar_holes_interpolate_like_curly_ones
is! '"sum: $(1+2)"' 'sum: 3'
is! '"sum: $(1+2)" == "sum: ${1+2}"' true
is! 'x=3; "a $(x+1) b $(x*(x+1))"' 'a 4 b 12'
is! 'name="Bob"; "hi $(name)! $name"' 'hi Bob! $name'
is! '"a\\$(b)"' 'a$(b)'
is! 'a="x";q=sql "SELECT * FROM t WHERE a = $(a)";q#1' 'SELECT * FROM t WHERE a = ?'

# holes_call_foreign_modules
is! 'use js Math; "m \\(Math.max(1, 5))"' 'm 5'
is! 'use js JSON; "j ${JSON.stringify([1])}!"' 'j [1]!'
is! 'use js crypto; count "id \\(crypto.randomUUID())"' 39
