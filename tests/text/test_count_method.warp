# count_as_a_method_or_a_call_of_two
is! «"banana".count('a')» 3
is! '"banana".count("an")' 2
is! '[1, 2, 1].count(1)' 2
is! «count("banana", 'a')» 3
is! «s = "banana"; s.count('n')» 2

# a_defined_count_keeps_its_calls
is! 'def count(a, b){a + b}; count(3, 4)' 7
is! 'def count(a, rest...){#rest}; count(7, 8, 9)' 2
