# card pure-compiles-compiler: upper and lower case in the pure lane, past ASCII too, where the case tables' ranges are
# read once into the runtime's list globals (`global lower_table = []`); words.warp's `type_words contains
# word.lower()` stopped the pure-built compiler compiling itself
# (`warp test tests/text` runs them through warp pure)

# lower_and_upper_of_ascii
is! "\"Int\".lower()" "int"
is! "upper(\"abc\")" "ABC"

# lower_and_upper_past_ascii
is! "lower(\"ÄÖÜ\")" "äöü"
is! "\"straße\".upper()" "STRASSE"

# a_lowered_word_in_a_list (the shape of words.warp's is_type_word)
is! "type_words = [\"int\", \"float\"]
is_type_word(word: text): bool := type_words contains word.lower()
[is_type_word(\"Int\"), is_type_word(\"List\")]" [yes, no]
