# texts_concatenate_with_plus
is! '"ab"+"cd"' 'abcd'
is! '"a"+"b"' 'ab'
is! '"a"+"bc"' 'abc'
is! '"ab"+"c"+"d"' 'abcd'
is! '""+"x"' 'x'

# text_variables_and_compound_assignment
is! 'x="hello"; y=" world"; x+y' 'hello world'
is! 'x="hello"; x+=" world"; x' 'hello world'
is! 'x="a"; x+="b"; x' 'ab'
is! 'x=""; x+="a"; x+="b"; x+="c"; x' 'abc'

# concatenation_takes_results_of_functions_and_library_words
is! '"a".upper + "b"' 'Ab'
is! '"a" + "b".upper' 'aB'
is! 'f(x):=x+"!"; f("hi")' 'hi!'

# text_plus_number_stays_an_error
is! '"a"+1' 'a1'
