# generated by scripts/is_tests.py from test_chars_codepoints.rs: edit the Rust test, then run the script again

# test_chars_is_a_list_of_characters
is! 'type("abc".chars)' 'list of codepoint'
is! 'type("abc".chars#1)' 'codepoint'
is! «type(['a' 'b']#1)» 'codepoint'
is! 'type(split("a b", " "))' 'list of text'

# test_a_list_of_characters_prints_them_in_single_quotes
is! '"abc".chars.string' «['a' 'b' 'c']»
is! «['a' "bc" 3].string» «['a' "bc" 3]»
is! '[\'\\\'\'].string' '[\'\\\'\']'

# test_a_character_equals_its_one_character_text
is! «'a' == "a"» true
is! «"abc".chars == ['a' 'b' 'c']» true
