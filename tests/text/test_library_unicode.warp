# generated by scripts/is_tests.py from test_library_unicode.rs: edit the Rust test, then run the script again

# upper_and_lower_cover_unicode_scripts
is! '"straße".upper' 'STRASSE'
is! '"ΑΒΓ".lower' 'αβγ'
is! '"привет".upper' 'ПРИВЕТ'
is! '"աբգ".upper' 'ԱԲԳ'
is! '"ａｂｃ".upper' 'ＡＢＣ'
is! '"ႠႡ".lower' 'ⴀⴁ'
is! '"𐐨".upper' '𐐀'
is! '"x1!".upper' 'X1!'

# sort_orders_floats
is! '([2.5 1.5 3.25].sort)#1' 1.5
is! '([2.5 1.5 3.25].sort)#3' 3.25
is! 'x=[2.5, -1.0, 0.5]; (x.sort)#1' (-1.0)
is! '([2.5f 1.5f 3.25f].sort)#1' 1.5
is! '([2.5f 1 0.5].sort)#3' 2.5

# sort_orders_mixed_numbers
is! '([2.5 1 3].sort)#1' 1
is! '([2.5 1 3].sort)#2' 2.5

# sort_orders_texts
is! '(["pear" "apple" "fig"].sort)#1' 'apple'
is! '(["pear" "apple" "fig"].sort)#3' 'pear'
is! '(["b" "ab" "a"].sort).join(",")' 'a,ab,b'

# sort_still_orders_ints
is! '([3 1 2].sort).join(",")' '1,2,3'

# reverse_works_on_text_by_code_points
is! '"hello".reverse' 'olleh'
is! '"añb🌍".reverse' '🌍bña'
is! 'x="abc"; reverse x' 'cba'
