# generated by scripts/is_tests.py from test_library_unicode.rs: edit the Rust test, then run the script again

# upper_and_lower_cover_unicode_scripts
'"straße".upper' 'STRASSE'
'"ΑΒΓ".lower' 'αβγ'
'"привет".upper' 'ПРИВЕТ'
'"աբգ".upper' 'ԱԲԳ'
'"ａｂｃ".upper' 'ＡＢＣ'
'"ႠႡ".lower' 'ⴀⴁ'
'"𐐨".upper' '𐐀'
'"x1!".upper' 'X1!'

# sort_orders_floats
'([2.5 1.5 3.25].sort)#1' 1.5
'([2.5 1.5 3.25].sort)#3' 3.25
'x=[2.5, -1.0, 0.5]; (x.sort)#1' (-1.0)
'([2.5f 1.5f 3.25f].sort)#1' 1.5
'([2.5f 1 0.5].sort)#3' 2.5

# sort_orders_mixed_numbers
'([2.5 1 3].sort)#1' 1
'([2.5 1 3].sort)#2' 2.5

# sort_orders_texts
'(["pear" "apple" "fig"].sort)#1' 'apple'
'(["pear" "apple" "fig"].sort)#3' 'pear'
'(["b" "ab" "a"].sort).join(",")' 'a,ab,b'

# sort_still_orders_ints
'([3 1 2].sort).join(",")' '1,2,3'

# reverse_works_on_text_by_code_points
'"hello".reverse' 'olleh'
'"añb🌍".reverse' '🌍bña'
'x="abc"; reverse x' 'cba'
