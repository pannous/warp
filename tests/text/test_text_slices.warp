# generated by scripts/is_tests.py from test_text_slices.rs: edit the Rust test, then run the script again

# consecutive_slices_of_a_long_text_take_linear_steps
is! 't = "abcdefghij" * (6000 + round(random() * 0))
total = 0
for i in 0 to 1999 { total += count(t[i * 30 : i * 30 + 5]) }
total' 10000

# short_texts_read_between_leave_a_long_texts_cursor
is! 'src = "trüe,fälse," * (1000 + round(random() * 0))
first = "trüe" * (1 + round(random() * 0))
separator = "," * (1 + round(random() * 0))
hits = 0
for i in 1 to count(src) {
	letter = first#1
	comma = separator#1
	if src#i == letter or src#i == comma { hits += 1 }
}
hits' 3000
