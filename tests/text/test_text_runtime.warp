# generated by scripts/is_tests.py from test_text_runtime.rs: edit the Rust test, then run the script again

# join_and_concatenation_take_non_ascii_characters
is! 'join ["ä" "ö"] ""' 'äö'
is! 'join ["ä" "ö"] "-"' 'ä-ö'
is! '"ä"+"b"' 'äb'
is! 'x="ö"; y="b"; x+y' 'öb'

# upper_and_lower_map_latin_greek_and_cyrillic
is! '"abc".upper' 'ABC'
is! '"äb".upper' 'ÄB'
is! '"ÀÉ".lower' 'àé'
is! '"αβγ".upper' 'ΑΒΓ'
is! '"ПРИВЕТ".lower' 'привет'
is! '"ÿ".upper' 'Ÿ'
is! '"ā".upper' 'Ā'
is! 'x="éa"; x.upper' 'ÉA'

# reverse_of_a_text_is_by_characters
is! 'reverse "abc"' 'cba'
is! '"abc".reverse' 'cba'
is! 'reverse "äb"' 'bä'
is! 'reverse [1 2 3]' [3, 2, 1]
is! 'x="a"; reverse x' 'a'
