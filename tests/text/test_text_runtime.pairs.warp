# join_and_concatenation_take_non_ascii_characters
'join ["ä" "ö"] ""' 'äö'
'join ["ä" "ö"] "-"' 'ä-ö'
'"ä"+"b"' 'äb'
'x="ö"; y="b"; x+y' 'öb'

# upper_and_lower_map_latin_greek_and_cyrillic
'"abc".upper' 'ABC'
'"äb".upper' 'ÄB'
'"ÀÉ".lower' 'àé'
'"αβγ".upper' 'ΑΒΓ'
'"ПРИВЕТ".lower' 'привет'
'"ÿ".upper' 'Ÿ'
'"ā".upper' 'Ā'
'x="éa"; x.upper' 'ÉA'

# reverse_of_a_text_is_by_characters
'reverse "abc"' 'cba'
'"abc".reverse' 'cba'
'reverse "äb"' 'bä'
'reverse [1 2 3]' [3, 2, 1]
'x="a"; reverse x' 'a'
