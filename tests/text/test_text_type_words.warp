# generated by scripts/is_tests.py from test_text_type_words.rs: edit the Rust test, then run the script again

# every_text_type_word_gives_the_text_of_an_exact_real
is! 'π as text' 'π'
is! 'π as str' 'π'
is! 'π as string' 'π'
is! 'π as String' 'π'
is! 'String(√2)' '√2'
is! 'str(√2)' '√2'

# every_float_type_word_rounds_an_exact_real
is! 'π as float' pi
is! 'π as double' pi
is! '(1/4) as float32' 0.25
is! '(1/4) as f64' 0.25

# every_text_type_word_calls_the_printable_operation
is! 'class person{name:text}; text(p:person) := "P " + p.name; x = person{name:"a"}; x as string' 'P a'
is! 'class person{name:text}; text(p:person) := "P " + p.name; x = person{name:"a"}; String(x)' 'P a'
