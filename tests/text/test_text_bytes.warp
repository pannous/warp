# generated by scripts/is_tests.py from test_text_bytes.rs: edit the Rust test, then run the script again

# plus_concatenates_texts_and_characters
is! «'Hello, ' + 'World!'» 'Hello, World!'
is! «'123' + '4' is '1234'» true
is! «'a' + 'β'» 'aβ'
is! 'x="ab"; y="cd"; x+y' 'abcd'
is! 's=""; s = s + "𓀀"; s' '𓀀'

# plus_equals_appends_to_a_text
is! 'x="ab"; x += "cd"; x += "e"; x' 'abcde'
is! 'f(n):={ s=""; i=0; while i < n do {s += "ab"; i++}; s }; f(3)' 'ababab'
is! 'f(t:text):= t + "!"; f("x")' 'x!'

# text_plus_number_stays_a_type_error
is! 'x="ab"; x + 3' 'ab3'

# byte_at_reads_one_byte
is! 't="héllo"; byte_at(t, 0)' 104
is! 't="héllo"; byte_at(t, 1)' 195
is! 't="héllo"; byte_at(t, 1) * 256 + byte_at(t, 2)' 50089

# byte_slice_cuts_by_byte_offsets
is! 't="héllo"; byte_slice(t, 1, 3)' 'é'
is! 't="héllo"; byte_slice(t, 3, 6)' 'llo'

# read_loads_a_file_as_bytes
is! 'use uniscript; index = read("packages/uniscript/data/entities.idx"); byte_slice(index, 0, 4)' 'USX1'
is! 'use uniscript; index = read("packages/uniscript/data/entities.idx"); byte_at(index, 4)' 5

# bytes_of_a_one_character_text_in_a_variable
is! 'input = "a"; byte_slice(input, 0, 1)' 'a'
is! 'input = "a"; byte_at(input, 0)' 97
