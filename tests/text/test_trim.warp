# generated by scripts/is_tests.py from test_trim.rs: edit the Rust test, then run the script again

# trim_drops_whitespace_at_both_ends
is! '"  hi ".trim()' 'hi'
is! 'trim("\\t a b \\n")' 'a b'
is! 's = "   "; #s.trim()' 0
is! 'lines = " x , y ".split(","); lines.map(l => l.trim()).join("|")' 'x|y'

# strip_and_trim_without_parentheses
is! '"  hi ".strip()' 'hi'
is! 'strip(" a ")' 'a'
is! 's = " ab "; strip s' 'ab'
is! 's = " ab "; s.trim' 'ab'
is! 's = " ab "; s.strip + "!"' 'ab!'
