'x=3; "a $(x+1) b $(x*(x+1))"' 'a 4 b 12'
'name="Bob"; "hi $(name)! $name"' 'hi Bob! $name'
'"a\\$(b)"' 'a$(b)'
'a="x";q=sql "SELECT * FROM t WHERE a = $(a)";q#1' 'SELECT * FROM t WHERE a = ?'

