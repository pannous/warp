# swift_holes_interpolate_any_expression
'x=3; "a \\(x+1) b"' 'a 4 b'
'name="Bob"; "hi \\(name)!"' 'hi Bob!'
'"\\(1+2)"' '3'
'x=2; "\\(x)\\(x*2)"' '24'
'"sum: \\((1+2)*3)"' 'sum: 9'

# curly_dollar_holes_interpolate_bare_dollars_stay_text
'x=3; "a ${x+1} b"' 'a 4 b'
'name="Bob"; "hi $name!"' 'hi $name!'
'n=7; "$n items"' '$n items'
'x=3; "$x and ${x}"' '$x and 3'

# holes_take_parameters_lists_and_exact_numbers
'f(n):="n is \\(n)"; f(4)' 'n is 4'
'xs=[1 2]; "xs=\\(xs)"' 'xs=[1 2]'
'y=2.5; "v=\\(y)"' 'v=2.5'
'"a \\("b") c"' 'a b c'

# holes_take_text_results_of_library_words
'name="bob"; "hi \\(name.upper)"' 'hi BOB'

# single_quotes_stay_literal
«'hi $name'» 'hi $name'
«'a ${x} b'» 'a ${x} b'

# a_dollar_before_a_digit_or_space_is_a_dollar_sign
'"costs $5"' 'costs $5'
'"$ 5"' '$ 5'
'"a\\$b"' 'a$b'

# dollar_arguments_and_templates_keep_working
'add1(x):=$0+1; add1(3)' 4
'file="a b";c=sh "rm -f \\(file)";c#3' 'a b'
'a="x";b="y";q=sql "SELECT * FROM t WHERE a = $a AND b = ${b}";q#3' 'y'

# round_dollar_holes_interpolate_like_curly_ones
'"sum: $(1+2)"' 'sum: 3'
