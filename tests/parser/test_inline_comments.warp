# generated by scripts/is_tests.py from test_inline_comments.rs: edit the Rust test, then run the script again

# test_block_comment_between_operands
is! '1 + /* inline */ 1' 2
is! '1 /* a */ + /* b */ 1 /* c */' 2

# test_hash_comment_after_a_statement_keeps_the_newline_separator
is! 'x=3 # note
x+1' 4

# test_hash_comment_ends_the_expression_not_the_program
is! 'x=3 # to silence python warnings;)
 x*2' 6

# test_hash_without_space_is_still_the_index_operator
is! 'x=[1 2 3];x#2' 2

# test_block_comment_between_name_and_assignment
is! 'y/* yeah! */=5;y' 5
