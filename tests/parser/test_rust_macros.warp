# generated by scripts/is_tests.py from test_rust_macros.rs: edit the Rust test, then run the script again

# format_fills_the_placeholders_in_order
is! 'format!("a={} b={}", 1, 2)' 'a=1 b=2'
is! 'format!("plain")' 'plain'
is! 'let x = 3; format!("x={:?}", x)' 'x=3'

# format_reads_inline_names_and_positions
is! 'let x = 3; format!("x={x}")' 'x=3'
is! 'format!("{1} {0}", "a", "b")' 'b a'
is! 'let n = "n"; format!("{} {n} {}", 1, 2)' '1 n 2'

# vec_is_a_list
is! 'vec![1, 2, 3] == [1, 2, 3]' true
is! 'let v = vec![1, 2, 3]; v.len()' 3

# assert_macros_assert
is! 'assert!(1 == 1); 7' 7
is! 'assert_eq!(2, 1 + 1); 7' 7

# another_macro_is_a_call
is! 'twice(x) := x * 2; twice!(4)' 8

# a_spaced_bang_stays_not
is! 'yes and !(no)' true
is! 'x = 3; x != 4' true
