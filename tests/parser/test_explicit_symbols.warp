# generated by scripts/is_tests.py from test_explicit_symbols.rs: edit the Rust test, then run the script again

# a_colon_name_is_a_symbol
is! 'x = :src; x == symbol("src")' true
is! 'type(:src)' 'symbol'
is! 'src = 3; x = :src; x == symbol("src")' true

# colon_names_uncharge_operators
is! 'count([:a :plus :b])' 3
is! '[:a :plus :b]#2 == symbol("plus")' true

# a_colon_without_space_before_stays_a_key
is! '{a:1}.a' 1
is! '{a: 1}.a' 1
is! 'x = {name : 2}; x.name' 2

# a_blank_colon_after_an_operand_keeps_its_meaning
is! 'y = 5
1 < 0 ? 2 :y' 5
is! 'x = 1 > 0 ? 2 :y; x' 2
is! 'class P{ n :int }
P(3).n' 3
is! 'p = {name :ann}; p.name' 'ann'
is! 'x = 1 > 0 ? :big :small; x == symbol("big")' true
