is! 'x=2;3(x+1)' 9

# test_julia_grouping_division
is! 'x=2;8/2x' 2
is! 'x=2;6/3x' 1

# test_postfix_binds_to_the_symbol
is! 'x=3;2x²' 18
is! 'x=2;3x³' 24

# test_spaced_number_and_symbol_is_still_a_list
is! 'x=3;[2 x]#2' 3
