is! '[1 2] ⊂ [1 2]' false
is! '[1 2] ⊆ [1 2]' true
is! '[1 2] ⊃ [1]' true
is! '[1 2] ⊇ [3]' false
is! 'subset([1], [1 2])' true

# set_glyphs_bind_like_math
is! '[1 2] ∪ [2 3] ∩ [3]' [1 2 3]
