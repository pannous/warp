is! '[3 1 2 3] ∩ [3 2]' [3 2]

# intersection_and_superset
is! 'intersection([1 2 3], [2 3 4])' [2 3]
is! '[1 2 3] ∩ [3 4]' [3]
is! 'superset([1 2 3], [2])' true
is! 'superset([1], [1 2])' false
