is! 'x ← 3; x+1' 4
is! '2 ⬆ 3' 8
is! '8 ⬇ 2' 3
is! 'f = x ⟶ x*2; f(3)' 6

# free_unicode_symbols_parse
is! 'infix operator ⇔(a: bool, b: bool) := a == b; (1 > 0) ⇔ (2 > 0)' true

# set_glyphs_are_membership_and_set_words
