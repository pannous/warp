# generated by scripts/is_tests.py from test_nonlocal_cells.rs: edit the Rust test, then run the script again

# test_inner_changes_the_outer_variable
is! 'def outer(){ y=1; def inner(){ nonlocal y; y += 10 }; inner(); inner(); y }; outer()' 21
is! 'def outer(){ t=0.5; def inner(){ nonlocal t; t += 0.25 }; inner(); t }; outer()' 0.75

# test_an_escaping_closure_keeps_its_values
is! 'def make(k){ def add(x){ k + x }; function add }; a = make(1); b = make(10); a(5) + b(5)' 21

# test_an_escaping_closure_keeps_its_cell
is! 'def make(){ n=0; def inc(){ nonlocal n; n += 1; n }; function inc }; c = make(); c(); c()' 2
is! 'def make(){ n=0; def inc(){ nonlocal n; n += 1; n }; function inc }; a = make(); b = make(); a(); a(); b()' 1
