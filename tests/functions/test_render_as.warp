# generated by scripts/is_tests.py from test_render_as.rs: edit the Rust test, then run the script again

# a_phrase_names_its_result_after_as
is! 'class pdf{body:text}; to render text as pdf: pdf(text); x = (render "hello") as pdf; x.body' 'hello'
is! 'class pdf{body:text}; to render text as pdf: pdf(text); type of ((render "hello") as pdf)' 'pdf'

# as_names_the_result_of_a_single_definition
is! 'class pdf{body:text}; render(t):pdf := pdf(t); ((render "hello") as pdf).body' 'hello'
is! 'class pdf{body:text}; render(t) := pdf(t); ((render "hello") as pdf).body' 'hello'

# phrases_with_different_results_are_overloads
is! 'class pdf{body:text}; class docx{body:text}; to render text as pdf: pdf("%PDF " + text); to render text as docx: docx("<w>" + text); ((render "hi") as docx).body' '<w>hi'
is! 'class pdf{body:text}; class docx{body:text}; to render text as pdf: pdf("%PDF " + text); to render text as docx: docx("<w>" + text); docx d = render "hi"; d.body' '<w>hi'
is! 'class pdf{body:text}; class docx{body:text}; to render text as pdf: pdf("%PDF " + text); to render text as docx: docx("<w>" + text); ((render "hi") as pdf).body' '%PDF hi'
