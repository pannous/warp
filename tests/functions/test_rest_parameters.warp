# rest parameters on the pure pipeline: the arguments after the fixed ones arrive as one list (card pure-varargs)

# `*xs` takes every argument
is! 'f(*xs) := count xs; f(1, 2, 3)' 3
is! 'f(*xs) := xs#2 * 10 + xs#3; f(4, 5, 6)' 56

# the fixed parameters first, the rest after them
is! 'first(a, *rest) := a * 10 + count rest; first(7, 8, 9)' 72
is! 'more(a, *rest) := rest; more(7, 8, 9)' [8 9]

# a rest left empty
is! 'none(a, *rest) := count rest; none(7)' 0

# the other spellings of a rest parameter
is! 'f(...xs) := xs#2; f(4, 5, 6)' 5
is! 'f(xs...) := count xs; f(4, 5, 6, 7)' 4

# a list spread into the rest: the list itself
is! 'f(*xs) := count xs; ys = [1, 2, 3, 4]; f(*ys)' 4
is! 'f(a, *xs) := a + count xs; ys = [1, 2]; f(10, ys...)' 12
