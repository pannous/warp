# generated by scripts/is_tests.py from test_late_binding.rs: edit the Rust test, then run the script again

# declaring_global_reads_the_current_value
is! 'y=3; def z(){ global y; y*y }; y=4; z()' 16
is! 'y=3
def z():
  global y
  y*y
y=4
z()' 16
is! 'global y=3; def z(): y*y; y=4; z()' 16

# a_free_variable_that_never_changes_needs_no_declaration
is! 'y=3; def z(): y*y; z()' 9
is! 'y=3; y=4; def z(): y*y; z()' 16
is! 'k=3; def f(x){x+k}; f(1)' 4

# a_variable_bound_after_the_definition_is_read_at_call_time
is! 'def f(x){x+k}; k=3; f(1)' 4

# in_place_mutation_counts_as_a_change
is! 'xs=[1,2]; def n(){ global xs; count(xs) }; xs.add(3); n()' 3

# a_change_no_later_call_can_observe_is_fine
is! 'y=3; def z(): y*y; a=z(); y=4; a' 9

# loop_variables_are_captured_per_iteration
is! 'fs = []; for i in 0..3 { fs.add(x => x + i) }; fs#1(0) + 10*fs#2(0) + 100*fs#3(0)' 210

# nested_def_without_shared_locals_is_callable
is! 'def outer(){ def inner(){ 41 }; inner()+1 }; outer()' 42

# nonlocal_reads_the_enclosing_functions_current_value
is! 'def outer(){ y=1; def inner(){ nonlocal y; y }; y=2; inner() }; outer()' 2

# a_def_without_parameters_over_constants_gets_a_note
is! 'def area(): 3*4; area()+1' 13

# late_binding_change_inside_function_with_no_later_call_is_fine
is! 'def outer(){ y=1; inner := {a=y; a*2}; b=inner(); y=2; b }; outer()' 2
is! 'def outer(){ y=1; y=2; inner := {a=y; a*2}; inner() }; outer()' 4
is! 'def outer(n){ inner := {m=n; m*2}; inner() }; outer(3)' 6

# nonlocal_reads_the_value_at_each_call
is! 'def outer(){ y=1; def inner(){ nonlocal y; y*10 }; a=inner(); y=2; a+inner() }; outer()' 30
is! 'def outer(){ y=1; def inner(){ nonlocal y; y }; t=0; for i in 1..3 { y = i; t += inner() }; t }; outer()' 3
is! 'def outer(){ s="a"; def inner(){ nonlocal s; s+"!" }; s="b"; inner() }; outer()' 'b!'
is! 'def outer(n){ def inner(){ nonlocal n; n*2 }; n+=1; inner() }; outer(3)' 8
is! 'def outer(){ a=1; b=2; def inner(){ nonlocal a, b; a+b }; a=10; b=20; inner() }; outer()' 30
is! 'def outer():
  y=1
  def inner():
    nonlocal y
    y
  y=2
  inner()
outer()' 2
