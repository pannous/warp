# generated by scripts/is_tests.py from test_method_words.rs: edit the Rust test, then run the script again

# test_known_words_and_data_stay_data
is! 'x=[1 2 3]; x.length' 3
is! 'x=[1 2 3]; x.count' 3
is! 'x=[1 2 3]; x.size' 3

# test_user_function_as_method_word
is! 'first(x):=x*2; first(5)' 10
is! 'sum=4; sum' 4

# test_first_and_last
is! 'first [1 2 3]' 1
is! 'last [1 2 3]' 3
is! 'x=[1 2 3]; x.first' 1
is! 'x=[1 2 3]; x.last' 3
is! 'x=[4 5 6]; first(x)' 4
is! 'x=[4 5 6]; last(x)' 6
is! 'x="hello"; x.first' 'h'
is! 'x="hello"; x.last' 'o'

# test_sum
is! 'sum [1 2 3]' 6
is! 'x=[1 2 3]; x.sum' 6
is! 'x=[1 2 3]; sum(x)' 6

# test_library_words_refuse_what_they_cannot_do
is! 'x=[1 2]; x.first(3)' [1, 2]
