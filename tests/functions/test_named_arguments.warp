# generated by scripts/is_tests.py from test_named_arguments.rs: edit the Rust test, then run the script again

# named_arguments_follow_the_parameter_order_of_a_python_colon_def
is! 'def g(a, b, c):
    return a*100+b*10+c
g(1, c=9, b=2)' 129

# named_arguments_run_as_written
is! 'global i = 0; g() := { i = i * 10 + 1; i }; h() := { i = i * 10 + 2; i }; f(a, b) := a * 100 + b; f(b=h(), a=g())' 2102
is! 'global i = 0; g() := { i = i * 10 + 1; i }; h() := { i = i * 10 + 2; i }; f(a, b) := a * 100 + b; f(a=g(), b=h())' 112
is! 'global i = 0; g() := { i = i * 10 + 1; i }; h() := { i = i * 10 + 2; i }; f(a, b) := a * 100 + b; k() := f(b=h(), a=g()); k()' 2102

# a_bare_flag_name_in_a_call_sets_it
is! 'f(a, loud = false) := if loud then a * 10 else a; loud = false; f(3, loud)' 3
is! 'f(a, loud = false) := if loud then a * 10 else a; g(loud) := f(2, loud); g(false)' 2

# a_shallow_copy_of_an_instance_shares_its_lists
is! 'class Team { name: text; members: list }; a = Team("red", ["ann"]); b = copy(a, shallow: true); c = copy(a); b.members.add("bob"); [count(a.members), count(c.members)]' [2, 1]
