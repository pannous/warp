# generated by scripts/is_tests.py from test_bare_calls.rs: edit the Rust test, then run the script again

# test_assigned_bare_name_holds_the_result
is! 'def a():=1; x=a; x' 1

# test_bare_name_as_an_operand
is! 'def a():=1; x=a+1; x' 2
is! 'def a(){1}; y=3; y+a' 4
is! 'a():=2; a*a' 4
is! 'def a():=1; a < 2' true

# test_function_reference_stays_the_function
is! 'def a():=1; f = function a; f()' 1
