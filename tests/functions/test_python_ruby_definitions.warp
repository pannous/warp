# test_python_rest_parameter_with_colon_body
is! 'def f(*args): return len(args)
f(1, 2, 3)' 3
is! 'def f(a, *rest): return a + len(rest)
f(10, 2, 3)' 12

# test_python_keyword_parameter
is! 'def f(**kw): return kw["a"]
f(a=1)' 1
is! 'def f(**kw): return kw.b * 10
f(a=1, b=2)' 20
is! 'def f(x, **kw): return x + kw.a
f(5, a=1)' 6
is! 'def f(**kw): return count(kw)
f()' 0

# test_ruby_def_end
is! 'def f(a, b: 2) a * b end; f(3)' 6
is! 'def f(a, b = 2)
  a * b
end
f(3)' 6
is! 'def g(x)
  if x > 1 then x else 0 end
end
g(5)' 5
is! 'def h
  42
end
h()' 42

# test_ruby_yield_calls_the_block
is! 'total = 0
def each_twice
  yield 1
  yield 2
end
each_twice { |x| total += x }
total' 3
is! 'def twice(n)
  yield n
  yield n * 2
end
sum = 0
twice(3) { |x| sum += x }
sum' 9
is! 'def apply(n)
  yield n
end
apply(3) do |x| x * 2 end' 6
is! 'def pair
  yield 3, 4
end
pair { |a, b| a * b }' 12
is! 'def run
  yield
end
run { 5 }' 5

# test_block_changes_the_callers_variable
is! 'total = 0
def g(h)
  h(1)
  h(2)
end
g(x => total += x)
total' 3
is! 'global total = 0
def g(h)
  h(1)
  h(2)
end
g(x => total += x)
total' 3
is! 'n = 0
inc = () => { n += 1; n }
inc()
inc()' 2

# test_python_spread_object
is! 'def f(**kw): return kw.a
m = {a: 7}
f(**m)' 7
is! 'def g(a, b, c): return a * 100 + b * 10 + c
m = {b: 2, c: 3}
g(1, **m)' 123
is! 'def g(a, b, c): return a * 100 + b * 10 + c
m = {b: 2, c: 3}
g(1, c=9, **m)' 129

# test_julia_definitions
is! 'function f(x; y=2) x*y end; f(3)' 6
is! 'function f(x; y=2) x*y end; f(3; y=4)' 12
is! 'function f(x)
  x * 2
end
f(4)' 8
is! 'f(x; y=2) = x*y; f(3, y=4)' 12

# test_ruby_loops_in_def
is! 'def f(n)
  k = 0
  while k < n
    k += 1
  end
  k
end
f(3)' 3
is! 'k = 0
while k < 3
  k += 1
end
k' 3
is! 'def f
  k = 0
  loop do
    k += 1
    break if k > 2
  end
  k
end
f()' 3
is! 'k = 0
loop do
  k += 1
  break if k > 2
end
k' 3
