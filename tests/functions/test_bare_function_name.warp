# test_bare_name_of_function_without_parameters_calls_it
is! 'f:={1;2;3};f' 3

# test_bare_name_of_function_with_only_defaults_calls_it
is! 'f(x=1):=x*2;f' 2

# a_loop_variable_named_like_a_function_is_the_variable
is! 'f(n) := n * 2; join([str f for f in [1, 2]], "-")' '1-2'
is! 'f(n) := n * 2; sum(f + 1 for f in [1, 2])' 5
is! 'f(n) := n * 2; s = 0; for f in [1, 2] { s = s + abs f }; s' 3
