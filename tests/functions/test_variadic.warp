# generated by scripts/is_tests.py from test_variadic.rs: edit the Rust test, then run the script again

# a_rest_parameter_collects_the_remaining_arguments
is! 'def total(xs...){sum xs}; total(1,2,3)' 6
is! 'def total(...xs){sum xs}; total(1,2,3)' 6
is! 'def total(*xs){sum xs}; total(1,2,3)' 6
is! 'def count(xs...){#xs}; count(1,2,3,4)' 4
is! 'def rest(a, more...){more}; rest(7,8,9)' [8, 9]
is! 'def first(a, rest...){a}; first(7,8,9)' 7

# a_rest_parameter_may_be_empty
is! 'def count(a, rest...){#rest}; count(7)' 0
is! 'def total(xs...){sum xs}; total()' 0

# calls_without_parentheses_fill_the_rest_too
is! 'total(xs...) := sum xs; total 1 2 3' 6

# a_list_spreads_into_a_rest_parameter
is! 'def total(xs...){sum xs}; ys=[1,2,3]; total(...ys)' 6
is! 'def total(xs...){sum xs}; ys=[1,2,3]; total(ys...)' 6
is! 'def total(xs...){sum xs}; ys=[1,2,3]; total(*ys)' 6
is! 'def total(xs...){sum xs}; ys=[2,3]; total(1, ...ys)' 6

# a_list_spreads_into_fixed_parameters
is! 'def f(a,b,c){a*100+b*10+c}; xs=[1,2,3]; f(...xs)' 123
is! 'def f(a,b,c){a*100+b*10+c}; xs=[2,3]; f(1, ...xs)' 123

# kotlin_vararg_and_csharp_params
is! 'fun total(vararg xs: Int): Int = xs.sum(); total(1, 2, 3)' 6
is! 'int Total(params int[] xs) { return xs.sum(); }; Total(1, 2, 3)' 6

# spreading_into_a_function_parameter
is! 'def apply(f, *args){ f(*args) }; apply((a, b) => a * b, 3, 4)' 12
is! 'def apply(f, *args){ f(*args) }; def add(a, b){ a + b }; apply(add, 3, 4)' 7

# a_spread_in_a_list_literal_splices_its_items
is! 'xs = [1, 2]; [...xs, 4]' [1, 2, 4]
is! 'xs = [1, 2]; [*xs, 4]' [1, 2, 4]
is! 'xs = [2, 3]; [1, ...xs, 4, ...xs]' [1, 2, 3, 4, 2, 3]
is! 'xs = [1, 2, 3]; match xs { [a, *rest] => count(rest); _ => 0 }' 2
