# generated by scripts/is_tests.py from test_map_list_fields.rs: edit the Rust test, then run the script again

# a_field_of_a_list_of_maps_reads_each_element
'm = [{name:"a", age:3}, {name:"b", age:5}]; m.name'	['a', 'b']
'm = [{name:"a", age:3}, {name:"b", age:5}]; name of m'	['a', 'b']

# a_condition_names_the_fields_of_each_map
'm = [{name:"a", age:3}, {name:"b", age:5}]; count(m where age > 4)'	1

# one_element_keeps_its_field
'm = [{name:"a", age:3}, {name:"b", age:5}]; m#1.name'	'a'

# a_plural_field_of_a_list_of_maps
'm = [{name:"a", age:3}, {name:"b", age:5}]; names of m'	['a', 'b']
'm = [{name:"a", age:3}, {name:"b", age:5}]; m.names'	['a', 'b']

# quoted_keys_name_the_fields_too
'm = [{"name": "a"}, {"name": "b"}]; m.name'	['a', 'b']
