# generated by scripts/is_tests.py from test_default_parameters.rs: edit the Rust test, then run the script again

# a_missing_argument_takes_its_default
'f(a, b=2) := a + b; f(1)'	3
'def f(a=1, b=2){a*10+b}; f()'	12
'f(x, y=10) = x + y; f(1)'	11

# a_default_may_read_earlier_parameters
'def f(a, b=a*2){a+b}; f(3)'	9
'def f(a, b=a*2){a+b}; f(3, 1)'	4

# a_typed_parameter_may_have_a_default
'def f(a, b:int=2) {a+b}; f(1)'	3
'def f(a:int, b:int=2) {a+b}; f(1, 4)'	5
'f(a:int, b:int=2) := a+b; f(1)'	3
'def f(b:int=2) {b}; f()'	2
'def f(x:float=1.5){x*2}; f()'	3.0
'fun area(w:int, h:int=w){w*h}; area(4)'	16
'def label(s:text="none"){s}; label()'	'none'

# named_arguments_skip_defaults_and_mix_with_positional_ones
'def f(a=1, b=2){a*10+b}; f(b=5)'	15
'def f(a, b, c){a*100+b*10+c}; f(1, c=3, b=2)'	123
'def f(a, b, c){a*100+b*10+c}; f(c:3, a:1, b:2)'	123
'def f(a, b=5, c=7){a*100+b*10+c}; f(1, c=3)'	153
'def f(a, b:int=5, c:int=7){a*100+b*10+c}; f(1, c=3)'	153

# calls_without_parentheses_take_defaults_too
'def f(a, b=2){a+b}; f 1'	3
'def f(a, b:int=2){a+b}; f 1'	3

# a_literal_after_a_colon_is_a_default_as_in_ruby
'def f(a, b: 2){a+b}; f(1)'	3
'def f(a, b: 2){a+b}; f(1, b: 5)'	6
'def f(a, b:int){a+b}; f(1, 2)'	3

# a_one_character_text_default_holds_any_text
'def f(s="a"){ s + s }; f()'	'aa'
'def f(s="a"){ s + s }; f("xy")'	'xyxy'
'def f(sep=","){ "a" + sep + "b" }; f()'	'a,b'
