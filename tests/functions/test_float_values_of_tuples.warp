# generated by scripts/is_tests.py from test_float_values_of_tuples.rs: edit the Rust test, then run the script again

# a_destructured_float_stays_a_float
is! 'def sigmoid(x) := 1.0 / (1.0 + exp(-x)); def pair(x) { return [1], sigmoid(x) }; def t() { (h, o) = pair(0); o }; t()' 0.5
is! 'def sigmoid(x) := 1.0 / (1.0 + exp(-x)); def pair(x) { return [1], sigmoid(x) }; def t() { (h, o) = pair(0); b = 0.25; b = b + o }; t()' 0.75
is! 'def sigmoid(x) := 1.0 / (1.0 + exp(-x)); def pair(x) { return [1], sigmoid(x) }; def slope(x) := x * (1.0 - x); def t() { (h, o) = pair(0); slope(o) }; t()' 0.25

# a_function_changes_a_float_global
is! 'b = random(); def bump() { global b; b = b + 0.5; b }; bump(); b >= 0.5' true
is! 'b = random(); def bump() { global b; b += 0.5; 1 }; bump(); b >= 0.5' true
is! 'def sigmoid(x) := 1.0 / (1.0 + exp(-x)); def pair(x) { return [1], sigmoid(x) }; b = sigmoid(0); def t() { global b; (h, o) = pair(0); b = b + o }; t(); b' 1.0

# a_held_value_adds_into_a_float
is! 'b = random(); def f(t) { global b; d = t - random(); b = b + 0.5 * d }; ex = [([0, 0], 0)]; for (i, t) in ex { f(t) }; b < 3' true
is! 'def f(t) { b = 0.25 + random() * 0; d = t + 0.5 + random() * 0; b = b + d; print b }; ex = [([0, 0], 0)]; for (i, t) in ex { f(t) }' ø
