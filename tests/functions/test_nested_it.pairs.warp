# test_trailing_block_of_a_lambda_body_method
'[[1,2],[3]].map { x -> x.map { it*10 } }'	[[10 20] [30]]
'f = x => x.map { it*10 }; f([1,2])'	[10 20]

# test_named_lambda_parameter_leaves_the_outer_it
