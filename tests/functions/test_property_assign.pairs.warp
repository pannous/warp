# test_assign_a_field
'p={a:1}; p.a=2; p.a'	2
'p={a:1 b:2}; p.b=5; p.a + p.b'	6
'p={a:1 b:2}; p["a"]=5; p.a'	5

# test_assign_a_nested_field
'p={a:1 b:{c:3}}; p.b.c=4; p.b.c'	4
'p={a:1 b:{c:3}}; p.b.c=4; p.a'	1
'p={a:1 b:{c:3 d:5}}; p.b.c=4; p.b.d'	5
'p={a:1 b:{c:3 d:5}}; q=p; p.b.c=4; q.b.c'	4

# test_assignment_has_value_semantics
'p={a:1 b:2}; q=p; p.a=9; q.a'	9
'p={a:1 b:2}; q=p; p.a=9; p.a'	9

# test_assigning_a_new_field_adds_it
'p={a:1 b:2}; p.z=9; p.z'	9
'p={a:1}; p.z=9; p.a + p.z'	10

# test_safe_navigation
'{a:1}?.a'	1
'p={a:1 b:2}; p?.b'	2

# test_a_one_entry_object_counts_one_pair
'p={a:1}; p.length'	1
'p={a:1}; count p'	1
'p={a:1 b:2}; count p'	2
