# a_typed_variable_bound_after_the_definition_is_read_at_the_call
is! 'def f(){ count(users) }; users: [int] = [1,2]; f()' 2
is! 'def f(){ k + 1 }; k: int = 3; f()' 4

# a_call_before_the_definition_reads_the_variable
is! 'users: [int] = [1,2]; x = f(); def f(){ count(users) }; x' 2
is! 'users = [1,2]; x = f(); def f(){ count(users) }; x' 2
is! 'k = 3; x = f(); def f(){ k + 1 }; x' 4

# a_call_before_the_definition_reads_a_constant
is! 'const w = "v1"; x = f(); def f(){ w + "!" }; x' 'v1!'
is! 'const k = 3; x = f(); def f(){ k + 1 }; x' 4
