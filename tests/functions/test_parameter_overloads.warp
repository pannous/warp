# a_call_takes_the_variant_its_arguments_fit
is! 'combine(a:float, b:float) := a+b; combine(a:int, b:int) := a*b; combine(2, 3)' 6
is! 'combine(a:float, b:float) := a+b; combine(a:int, b:int) := a*b; combine(1.5, 2.5)' 4.0
is! 'combine(a:float, b:float) := a+b; combine(a:int, b:int) := a*b; x=2; y=3; combine(x, y)' 6

# an_int_widens_to_a_float_variant
