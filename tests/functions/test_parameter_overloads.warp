is! 'combine(a:float, b:float) := a+b; combine(a:int, b:int) := a*b; def g(p){ combine(p, p) }; g(1.5)' 3

# of_any_is_the_fallback_variant
is! 'foo of int = it+it; foo of text = it.length; foo of any = 1; foo("abc") + foo(2) + foo(2.5)' 8

