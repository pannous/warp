is! 'f(c: text) := 1; f(b: [int]) := 2; f([1 2])' 2
is! 'f(c: text) := 1; f(b: ints) := 2; xs = [1, 2]; f(xs) * 10 + f("a")' 21
is! 'class A{x:int}; area(a:A) := 1; area(b: list) := 2; h(v) := area(v); h([1]) * 10 + h(A(1))' 21
