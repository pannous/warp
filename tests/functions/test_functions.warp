is! 'define x(a): 42+a; x(1)+1' 44
is! 'function x(): 42; x()+1' 43
is! 'function x(a): 42+a; x(1)+1' 44
is! 'x() = 42; x()+1' 43
is! 'x(a) = 42+a; x(1)+1' 44
is! 'function x(){42};x()+1' 43
is! 'function x(a){42+a};x(1)+1' 44

# test_default_params
is! 'def x(a=3): 42+a; x()' 45
is! 'def x(a=3): 42+a; x(10)' 52
is! 'f(a=5, b=10) = a+b; f()' 15
is! 'f(a=5, b=10) = a+b; f(1)' 11
is! 'f(a=5, b=10) = a+b; f(1, 2)' 3

# test_modifiers
is! 'public fun ignore(){3}; ignore()' 3
is! 'public static export import extern external C global inline virtual override final abstract private protected internal const constexpr volatile mutable thread_local synchronized transient native fun ignore(){3}; ignore()' 3

# test_fibonacci_auto_typed
is! 'fib(n) = n < 2 ? n : fib(n - 1) + fib(n - 2); fib(10)' 55

# test_fibonacci_auto_param
is! 'fib := it < 2 ? it : fib(it - 1) + fib(it - 2); fib(10)' 55

# test_fibonacci_typed
is! 'fib(n:int) = n < 2 ? n : fib(n - 1) + fib(n - 2); fib(10)' 55
is! 'fib(n:number) = n < 2 ? n : fib(n - 1) + fib(n - 2); fib(10)' 55

