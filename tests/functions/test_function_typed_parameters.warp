# a_function_passed_for_a_function_typed_parameter_takes_its_types
is! 'apply(f: (float) -> float, x: float) := f(x)
half(t) := t / 2
apply(half, 3.0)' 1.5
is! 'apply(f: (float) -> float, x: float) := f(x)
whole(t) := 3
apply(whole, 1.0) is float' true

# a_parameter_passed_on_to_a_function_typed_one_types_the_function
is! 'apply(f: (float) -> float, x: float) := f(x)
outer(g, x) := apply(g, x)
whole(t) := 3
outer(whole, 1.0) is float' true

# a_function_typed_parameter_leaves_quantities_to_the_others
is! 'apply(f: (float) -> float, d) := d * 2
g(t) := t
apply(g, 0.1s) == 0.2s' true

# the_name_of_a_parameter_declared_function_is_the_function_word
is! 'use sound
d() := 1
g(c: function) := c.name
g(d)' 'd'
