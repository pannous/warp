# generated by scripts/is_tests.py from test_anonymous_function_forms.rs: edit the Rust test, then run the script again

# a_function_keyword_without_a_name_is_a_lambda
is! 'f = function(a, b) { a + b }; f(3, 4)' 7
is! 'mul = fn(a, b) { a * b }; mul(2, 3)' 6
is! 'f = function(x) { return x * 2 }; f(4)' 8
is! 'map([1,2,3], fn(x) { x * 10 })' [10, 20, 30]

# python_lambda_is_a_lambda
is! 'f = lambda x: x * 2; f(4)' 8
is! 'map([1,2,3], lambda x: x + 1)' [2, 3, 4]

# an_arrow_lambda_works_too
is! 'f = (a, b) -> a + b; f(3, 4)' 7

# an_immediately_invoked_function_without_arguments
is! '(() => 7)()' 7
is! '(function(){ return 5 })()' 5
