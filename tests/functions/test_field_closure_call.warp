# a_field_given_a_lambda_parameter_is_called
is! 'route(path, answer) := {path: path, answer: answer}
r = route("/x", (q) => q + 1)
r.answer(2)' 3
is! 'mk(a) := {answer: a}
r = mk((q) => q * 2)
r.answer(4)' 8

# records_in_a_list_call_their_fields
is! 'route(path, answer) := {path: path, answer: answer}
routes = [route("/a", (q) => q + 1), route("/b", (q) => q * 10)]
for r in routes { if r.path == "/b" { return r.answer(3) } }
0' 30
