# generated by scripts/is_tests.py from test_property_access.rs: edit the Rust test, then run the script again

# test_dot_on_an_object_literal
'{a:1 b:2}.a'	1
'{a:1 b:2}.b'	2

# test_dot_on_a_variable_and_nested
'p={a:1 b:2}; p.a'	1
'p={a:1 b:{c:3}}; p.b.c'	3
'p={name:"Joe"}; p.name'	'Joe'

# test_of_and_possessive
'p={name:"Joe"}; name of p'	'Joe'
«p={name:"Joe"}; p's name»	'Joe'
'p={a:1 b:{c:3}}; c of b of p'	3

# test_bracket_lookup_by_text_never_traps
'p={name:"Joe"}; p["name"]'	'Joe'
'p={name:"Joe"}; p[name]'	'Joe'
'{a:1 b:2}["b"]'	2

# test_field_names_win_over_library_words_on_an_object
'p={first:"A" last:"B"}; p.last'	'B'
'p={count:7}; p.count'	7
'p={a:1 b:2}; p.length'	2

# test_object_data_stays_data
'p={a:1 b:2}; p.a + p.b'	3

# test_of_lookup_is_an_assignment_target
'p={width:3}; width of p = 12; p.width'	12
'square of a number = number*number; square 3'	9

# test_print_of_lookup_prints_the_field
'p={w:1}; print w of p; w of p + 1'	2
