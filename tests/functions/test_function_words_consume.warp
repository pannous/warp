# function_words_take_their_arguments_by_their_parameters
is! 'def show(a, b) = a + b; show 1, 2' 3
is! 'def add(a: int, b: int) = a + b; add 1 2' 3
is! «c = 'c'; x = ord c; x» 99
is! 'def twice(x: int) = 2*x; [twice 1, twice 2]' [2, 4]
is! 'def square(x: int) = x*x; xs = [1, 2, 3]; map square xs' [1, 4, 9]

# an_argument_reaches_right_while_it_fits_the_parameter
is! 'sqrt 4 + 5' 3
is! 'def f(x: int) = x; f 1 > 0' true

# a_comparison_is_no_list_so_a_word_of_a_list_stops_before_it
is! 'xs = [1, 2, 3, 4]; count xs > 3' true
is! 'xs = [1, 2, 3, 4]; count xs == 4' true
is! 'xs = [1, 2, 3, 4]; size xs > 3' true

# a_comparison_fits_a_truth_parameter_so_it_is_the_argument
is! 'def neg(b: bool) = not b; neg 1 > 3' true
is! 'def neg(b: bool) = not b; neg 3 > 1' false
