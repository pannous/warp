# generated by scripts/is_tests.py from test_nested_it.rs: edit the Rust test, then run the script again

# test_glued_block_after_a_method_is_a_lambda
is! '[1,2].map{ it*2 }' [2 4]
is! 'xs=[1,2,3]; xs.filter{ it > 1 }' [2 3]

# test_trailing_block_of_an_assigned_method_call
is! 'f(xs) := xs.map { it*10 }; f([1,2])' [10 20]
is! 'ys = [1,2].map { it*10 }; ys' [10 20]

# test_inner_it_shadows_the_outer_it
is! '[[1,2],[3]].map{ it.map{ it*10 } }' [[10 20] [30]]
is! '[[1,2],[3]].map { it.map { it*10 } }' [[10 20] [30]]

# test_inner_dollar_zero_shadows_the_outer
is! '[[1,2],[3]].map{ $0.map{ $0*10 } }' [[10 20] [30]]

# test_function_it_stops_at_an_inner_lambda
is! 'f(x) := { [1,2].map{ it + x } }; f(10)' [11 12]
is! 'f(x) := [1,2].map { it + x }; f(10)' [11 12]

# test_trailing_block_of_a_lambda_body_method
is! '[[1,2],[3]].map { x -> x.map { it*10 } }' [[10 20] [30]]
is! 'f = x => x.map { it*10 }; f([1,2])' [10 20]

# test_named_lambda_parameter_leaves_the_outer_it
is! 'scale := [1 2].map(x => x * it); scale 3' [3 6]
is! 'scale(it) := [1 2].map(x => x * it); scale(3)' [3 6]
