# a_block_to_a_function_parameter_is_called
is! 'run(f: function) := f()
run { 1 + 2 }' 3
is! 'run(f: function) := f()
run({ 1 + 2 })' 3
is! 'twice(f: function) := f(f(1))
twice { it * 10 }' 100

# a_block_names_what_is_around_it
is! 'run(f: function) := f()
n = 4
run { n + 1 }' 5

# a_kept_block_is_called_later
is! 'answers = []
handle(path: text, answer: function) := { global answers; answers.add({path: path, answer: answer}) }
handle "/a" { it + 1 }
handle "/b" { it * 3 }
for a in answers { if a.path == "/b" { return a.answer(5) } }
0' 15

# a_lambda_or_function_still_passes_as_is
is! 'run(f: function) := f(3)
run(x => x * 2)' 6
is! 'triple(x) := x * 3
run(f: function) := f(3)
run(&triple)' 9
