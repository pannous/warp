# generated by scripts/is_tests.py from test_closure_value_arguments.rs: edit the Rust test, then run the script again

# test_a_returned_closure_takes_a_text
is! 'make = () => (t => t + "!"); a = make(); a("x")' 'x!'
is! 'make = () => (t => t + "!"); a = make(); a("xy")' 'xy!'
is! 'def make(){ def add(t){ t + "!" }; function add }; a = make(); a("x")' 'x!'

# test_a_closure_in_a_list_takes_a_text
is! 'fs = [t => t + "!"]; fs#1("x")' 'x!'

# test_a_returned_closure_takes_numbers_and_lists
is! 'make = () => (t => t * 2); a = make(); a(4)' 8
is! 'make = () => (t => count t); a = make(); a([1,2,3])' 3

# a_lambda_of_the_loop_variable_given_to_a_function_sees_each_turn
is! 'g(xs, p) := { n = 0; for y in xs { if p(y) { n = n + 1 } }; n }; xs = [1, 2, 2]; out = []; for x in xs { out = out + [g(xs, z => z == x)] }; out' [1, 2, 2]
is! 'use list; xs = [1, 2, 2, 3]; [count_by(xs, y => y == x) for x in xs]' [1, 2, 2, 1]
