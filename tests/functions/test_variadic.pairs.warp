# a_rest_parameter_collects_the_remaining_arguments
'def total(xs...){sum xs}; total(1,2,3)'	6
'def total(...xs){sum xs}; total(1,2,3)'	6
'def total(*xs){sum xs}; total(1,2,3)'	6
'def count(xs...){#xs}; count(1,2,3,4)'	4
'def rest(a, more...){more}; rest(7,8,9)'	[8, 9]
'def first(a, rest...){a}; first(7,8,9)'	7

# a_rest_parameter_may_be_empty
'def count(a, rest...){#rest}; count(7)'	0
'def total(xs...){sum xs}; total()'	0

# calls_without_parentheses_fill_the_rest_too
'total(xs...) := sum xs; total 1 2 3'	6

# a_list_spreads_into_a_rest_parameter
'def total(xs...){sum xs}; ys=[1,2,3]; total(...ys)'	6
'def total(xs...){sum xs}; ys=[1,2,3]; total(ys...)'	6
'def total(xs...){sum xs}; ys=[1,2,3]; total(*ys)'	6
'def total(xs...){sum xs}; ys=[2,3]; total(1, ...ys)'	6

