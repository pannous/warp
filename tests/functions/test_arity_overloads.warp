# an_overloaded_name_called_on_a_receiver_is_the_variant_counting_it
is! 'class P{name: text}
f(it: P) := it.name
f(it: P, v) := { it.name = v; it }
p = P("ab")
p.f = "cd"
p.f' 'cd'
is! 'class P{f: int}
f(x) := x * 2
f(x, y) := x + y
P(5).f' 5

# a_map_field_named_like_an_overloaded_function_is_set_on_the_map
