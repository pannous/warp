is! 'sum3(a, b) := sum3(a, b, 0); sum3(a, b, c) := a+b+c; sum3(1, 2)' 3

# calls_without_parentheses_pick_by_count_too
is! 'f(a) := a; f(a,b) := a+b; f 1 2' 3

# defaults_count_for_the_arguments_a_definition_accepts
