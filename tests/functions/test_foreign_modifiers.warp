# generated by scripts/is_tests.py from test_foreign_modifiers.rs: edit the Rust test, then run the script again

# test_meaningless_modifiers_are_skipped_with_a_note
is! 'public static fun f(){3}; f()' 3
is! 'private x = 4; x + 1' 5
is! 'public def g(x){x*2}; g(5)' 10

# test_meaningful_modifiers_keep_their_meaning
is! 'export fun f(){3}; f()' 3
is! 'global fun f(){3}; f()' 3
is! 'const k = 7; k' 7
is! 'public = 3; public + 1' 4
