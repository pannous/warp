# generated by scripts/is_tests.py from test_definition_bodies.rs: edit the Rust test, then run the script again

# a_method_body_keeps_its_suffix_word
is! 'class C{ n: int; fn f() := 3 squared }; C(2).f()' 9

# f
is! 'class C{ n: int; f() := n squared }; C(4).f()' 16

# of_phrase_as_a_value
is! 'f() := sum of [1, 2]; f()' 3
is! 'x = sum of [1, 2]; x' 3
is! 'f() := first of [5, 2]; f()' 5

# ruby_def_indented_by_tabs
is! 'def f(x)
	x * 2
end
f(3)' 6
is! 'def f(x)
	y = x * 2
	y + 1
end
f(3)' 7
is! 'class Point
	def initialize(x)
		@x = x
	end
	def double
		@x * 2
	end
end
Point.new(4).double' 8

# a_colon_body_may_assign
is! 'def foo: hi=2*2
foo' 4
is! 'def foo: hi=2*2; foo' 4
is! 'def foo(x): y = x*2
foo(5)' 10
is! 'def foo: hi=2*2
foo
result' 4
