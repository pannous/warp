# generated by scripts/is_tests.py from test_lambda_held_by_field.rs: edit the Rust test, then run the script again

# a_lambda_in_a_map_entry_is_called
is! 'h = {d: x => x * 3}
(h.d)(5)' 15
is! 'h = {d: x => x * 3}
h.d(5)' 15

# a_field_holding_a_lambda_is_passed_as_a_function
is! 'apply(f, v) := f(v)
class Holder {d}
h = Holder(x => x + 1)
apply(h.d, 5)' 6
is! 'apply(f, v) := f(v)
h = {d: x => x * 3}
apply(h.d, 5)' 15

# a_held_lambda_is_called_whatever_holds_it
is! 'hs = [{d: x => x * 3}]
hs#1.d(5)' 15

# a_field_named_like_a_library_method_keeps_the_method
is! 'class Box {join}
b = Box(1)
[1, 2].join("-")' '1-2'
is! 'class Doc {split}
d = Doc(1)
words = "a b".split(" ")
#words' 2
is! 'class Item {size}
x = Item(2)
"abc".size()' 3
is! 'class Box {join}
b = Box(x => x + 1)
[1, 2].join("-")' '1-2'
is! 'class Box {join}
b = Box(x => x + 1)
b.join(5)' 6
