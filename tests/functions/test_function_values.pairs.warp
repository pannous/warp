# generated by scripts/is_tests.py from test_function_values.rs: edit the Rust test, then run the script again

# test_a_parameter_called_as_a_function
'double2(x):=x*2; apply(f, x):=f(x); apply(double2, 3)' 6
'inc(x):=x+1; twice(f, x):=f(f(x)); twice(inc, 5)' 7
'sq(x):=x*x; apply(f, x):=f(x); apply(sq, 4) + apply(sq, 2)' 20

# test_an_explicit_reference
'double2(x):=x*2; apply(f, x):=f(x); apply(&double2, 3)' 6

# test_an_alias_of_a_function
'double2(x):=x*2; g=function double2; g 4' 8
'double2(x):=x*2; g=&double2; g(5)' 10

# test_operators_as_values
'fold [1 2 3] 0 +' 6
'fold [2 3 4] 1 *' 24
'reduce [1 2 3 4] +' 10
'xs=[5 6]; reduce xs *' 30

# test_partial_application_of_an_iteration_word
'sum := fold +; sum [1 2 3]' 6
'product := fold *; product [2 3 4]' 24
'total := reduce +; total [4 5]' 9

# test_a_lambda_that_captures_nothing_is_a_value
'apply(f, x):=f(x); apply(y=>y+1, 2)' 3
'apply(f, x):=f(x); apply((a)->a*a, 5)' 25

# test_a_lambda_that_captures_is_passed_as_a_closure
'k=3; apply(f, x):=f(x); apply(y=>y+k, 2)' 5

# test_a_function_argument_of_a_specialised_function_is_passed_on
'dbl(x):=x*2; apply(f, x):=f(x); outer(g, x):=apply(g, x)+1; outer(dbl, 4)' 9

# test_ordinary_calls_are_untouched
'f(x):=x*2; f 4' 8
'add(a,b):=a+b; add(2,3)' 5
