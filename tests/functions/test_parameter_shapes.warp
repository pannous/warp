# generated by scripts/is_tests.py from test_parameter_shapes.rs: edit the Rust test, then run the script again

# test_to_definition_with_a_shaped_parameter
is! 'to greet person{name, title?} do "Hi " + person.name
greet {name:"Ann"}' 'Hi Ann'
is! 'to greet p do "Hi " + p.name
greet {name:"Ann"}' 'Hi Ann'

# test_wiki_argument_example
is! 'to ring person{name?, phone text, email?, mutable status} do
  person.status = "called " + person.phone
  person.status
ring {name:"Jonathan" phone:"899-573-5842" status:"new"}' 'called 899-573-5842'

# test_constructed_argument_is_checked
is! 'class person{name, phone?}
to call p{name?, phone} do p.phone
call person{name:"J" phone:"8"}' '8'

# test_field_type_is_checked
is! 'to call person{name?, phone number} do person.phone + 1
call {phone:41}' 42

# test_hyphenated_field_with_a_type
is! 'f(p{phone-number:text}) := p.phone-number; f({phone-number:"899-573-5842"})' '899-573-5842'
