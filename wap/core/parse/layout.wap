# Pass 1 of the reader (core/parse/reader.wap): text → tokens for structure, the brackets (type lists `<…>` included),
# separators and indentation, an indented block read as `{…}` glued to the line before.

use "lexemes.wap"
use "atoms.wap"

# Separators, tightest first; glue (no blank) is tighter than all of them
SEPARATOR_ORDER = [Separator.None, Separator.Space, Separator.Comma, Separator.Semicolon, Separator.Tab, Separator.Newline]
OPENERS = "([{"
CLOSERS = ")]}"
BRACKETS = [Bracket.Round, Bracket.Square, Bracket.Curly]
# a type list glued to a word, `list<int>`, `map<text, (int) -> int>`, and its type arrow
ANGLE_OPEN = '<'
ANGLE_CLOSE = '>'
TYPE_ARROW = "->"

# ── brackets, separators, indentation ──

bracket_opened(r: Reader, c: text, width: int) := {
	token(r, LexemeKind.Open, Empty, width)
	t = r.tokens.last
	t.bracket = bracket_of(c)
	r.opened += [t]
}

bracket_closed(r: Reader, c: text) := {
	if r.opened.length == 0 or last_of(r.opened).indented or last_of(r.opened).bracket != bracket_of(c) {
		return failed(r, "this bracket closes no open bracket")
	}
	r.opened = r.opened[0 .. r.opened.length - 1]
	token(r, LexemeKind.Close, Empty, 1)
	last_of(r.tokens).bracket = bracket_of(c)
}

bracket_of(c: text) as Bracket := if c == ANGLE_OPEN or c == ANGLE_CLOSE then Bracket.Less else BRACKETS[(if OPENERS.contains(c) then OPENERS else CLOSERS).find(c) - 1]

# Whether the `<` here opens a type list: glued to a word, it holds only types, words, glued type lists and
# `(…) -> type`, apart by `, `, and closes with a `>`. Its `>` is then remembered as a closer. Followed by an operand,
# `a<b>c` also reads as two comparisons, and is refused naming both.
type_list_follows(r: Reader) as bool := {
	if r.blank or r.at == 0 or not is_name_char(r.code[r.at - 1]) { return no }
	close = type_list_end(r, r.at + 1)
	if close < 0 or peek_at(r, close) != ANGLE_CLOSE { return no }
	after = peek_at(r, close + 1)
	if is_name_char(after) or QUOTES.contains(after) or OPENERS.contains(after) { failed(r, "this reads as a type list glued to what follows, or as comparisons: write blanks around `<` and `>` for the comparisons") }
	r.angle_closers += [close]
	yes
}
# where a list of types starting at `at` ends, -1 where it holds something else
type_list_end(r: Reader, at: int) as int := {
	at = type_end(r, at)
	while at >= 0 and peek_at(r, at) == ',' { at = type_end(r, if peek_at(r, at + 1) == ' ' then at + 2 else at + 1) }
	at
}
# where one type starting at `at` ends: a word with its glued type list, or `(types) -> type`; -1 for none
type_end(r: Reader, at: int) as int := {
	if peek_at(r, at) == '(' {
		inside = if peek_at(r, at + 1) == ')' then at + 1 else type_list_end(r, at + 1)
		if inside < 0 or peek_at(r, inside) != ')' { return -1 }
		arrow = if peek_at(r, inside + 1) == ' ' then inside + 2 else inside + 1
		if slice_of(r, arrow, min(arrow + 2, r.n)) != TYPE_ARROW { return -1 }
		return type_end(r, if peek_at(r, arrow + 2) == ' ' then arrow + 3 else arrow + 2)
	}
	start = at
	while at < r.n and is_name_char(r.code[at]) { at += 1 }
	if at == start { return -1 }
	if peek_at(r, at) != ANGLE_OPEN { return at }
	inside = type_list_end(r, at + 1)
	if inside < 0 or peek_at(r, inside) != ANGLE_CLOSE then -1 else inside + 1
}

# a separator; two in a row are one, the looser
separated(r: Reader, separator: Separator, width: int) := {
	last = last_token(r)
	if last != ø and last.kind == LexemeKind.Separator {
		if looseness(separator) > looseness(last.separator) { last.separator = separator }
		r.at += width
	} else {
		token(r, LexemeKind.Separator, Empty, width)
		last_of(r.tokens).separator = separator
	}
	r.blank = yes
}

looseness(separator: Separator) as int := SEPARATOR_ORDER.index_of(separator)

# a tab between two items of a line separates columns; elsewhere it is a blank
tab(r: Reader) := {
	last = last_token(r)
	if last != ø and last.kind != LexemeKind.Open and last.line == r.line { separated(r, Separator.Tab, 1) } else { r.at += 1; r.blank = yes }
}

# A new line separates, unless it opens or closes an indented block. Inside a bracket indentation means nothing.
new_line(r: Reader) := {
	r.at += 1
	r.line += 1
	r.line_start = r.at
	r.line_atom = ø
	r.blank = yes
	if r.opened.length > 0 and not last_of(r.opened).indented { return separated_line(r) }
	indentation(r)
}

separated_line(r: Reader) := {
	last = last_token(r)
	if last != ø and last.kind != LexemeKind.Open { separated(r, Separator.Newline, 0) }
}

# The indentation of the next line that holds code (empty lines and comment lines change nothing): a deeper one
# opens a block `{` glued to the line before, a shallower one closes blocks down to its level
indentation(r: Reader) := {
	start = r.at
	while r.at < r.n and (r.code[r.at] == ' ' or r.code[r.at] == '\t') { r.at += 1 }
	if r.at >= r.n { return ø }
	c = r.code[r.at]
	next = peek(r, 1)
	if c == '\n' or c == '\r' or (c == '/' and next == '/') or (c == '#' and HASH_COMMENT_FOLLOWERS.contains(next)) { return ø }
	written = slice_of(r, start, r.at)
	if not indent_consistent(r, written) { return ø }
	# the first line's indentation is the text's margin: a pasted, indented text reads as if it had none
	if r.margin < 0 { r.margin = written.length }
	depth = written.length - r.margin
	if depth < 0 { return failed(r, "this line is indented less than the first line") }
	outer = indent_level(r)
	if depth > outer {
		r.indents += [depth]
		# glued to the line before, but a key's value after `:=`, `:` or `=` at the line's end, as if written after a blank
		r.blank = last_token(r) != ø and last_token(r).kind == LexemeKind.Key
		bracket_opened(r, "{", 0)
		last_of(r.tokens).indented = yes
		return ø
	}
	while depth < outer {
		dedent(r)
		outer = indent_level(r)
	}
	if depth != outer { return failed(r, "this line's indentation matches no line above it") }
	separated_line(r)
}

# the depth of the innermost indented block, 0 outside all
indent_level(r: Reader) as int := if r.indents.length > 0 then r.indents.last else 0

# tabs or spaces, one of them throughout the text
indent_consistent(r: Reader, written: text) as bool := {
	if written == "" { return yes }
	if r.indent_char == "" { r.indent_char = written[0] }
	for c in written { if c != r.indent_char { failed(r, "indentation mixes tabs and spaces"); return no } }
	yes
}

dedent(r: Reader) := {
	r.indents = r.indents[0 .. r.indents.length - 1]
	r.opened = r.opened[0 .. r.opened.length - 1]
	if last_of(r.tokens).kind == LexemeKind.Separator { r.tokens = r.tokens[0 .. r.tokens.length - 1] }
	r.blank = no
	token(r, LexemeKind.Close, Empty, 0)
	last_of(r.tokens).bracket = Bracket.Curly
	last_of(r.tokens).indented = yes
}
