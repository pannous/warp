# Text → notation: any text read as Node, data and code alike (notes/reader.md, notes/backbone.md "Stage languages").
#
# The reader knows no language: no keyword, no operator table, no precedence. Character classes tell a word from an
# operator, and spacing and separators give the structure:
#
#   1 2 3            S(1 2 3)          a phrase: List(…, None, Space)
#   a-b  f(x)        G(a - b) G(f (x)) a glued run, no blank between: List(…, None, None)
#   a b, c; d        ;(,(S(a b) c) d)  separators cascade, the loosest splits first
#   a: b c   a:1     K(a, S(b c))      `:` is the only key the reader makes; `=` stays a word of the phrase
#   if x⏎  y         S(if G(x C⏎(y)))  an indented block is `{…}` glued to the line before
#
# Comments, `@annotations` and positions ride in the nodes' metadata (core/stage.wap with_fact, positioned).
# Reading runs in two passes: `read_tokens` cuts the text into atoms, brackets, separators and colons, each knowing
# whether a blank came before it; `built` assembles them by the separator cascade.

# Separators, tightest first; glue (no blank) is tighter than all of them
SEPARATOR_ORDER = [Separator.None, Separator.Space, Separator.Comma, Separator.Semicolon, Separator.Tab, Separator.Newline]
OPENERS = "([{"
CLOSERS = ")]}"
BRACKETS = [Bracket.Round, Bracket.Square, Bracket.Curly]
QUOTES = "\"'`“‘«"
QUOTE_CLOSERS = "\"'`”’»"
# the quote whose text is taken as written, escapes and all
RAW_QUOTE = '«'
# escapes read as the character after the backslash, and those that become another character
ESCAPED_AS_IS = "\\\"'`/"
ESCAPE_LETTERS = "ntre0"
ESCAPE_CHARACTERS = ["\n", "\t", "\r", "\e", "\u{0}"]
# escapes later rules read, kept with their backslash: a template's holes (notes/reader.md Q8), an extension's
# `\:alpha` and `\:U+12C00`
LATER_ESCAPES = «$({:»
# operator glyphs beyond ASCII that no range below holds; `∞` and `∅` are name characters
OTHER_GLYPHS = "¬±×÷·‖…′″"
# operator glyph ranges beyond ASCII: superscripts and subscripts, arrows, math operators, technical
GLYPH_RANGES = [['⁰', '₟'], ['←', '⇿'], ['∀', '∃'], ['∆', '∝'], ['∟', '⌙'], ['¹', '¹'], ['²', '³']]
# what ends a URL: a blank, a bracket, a separator or a quote
URL_ENDS = " \t\n\r()[]{},;\"'`"
# a line comment starts with `//`, or with `#` before a blank, `!` or `#`
HASH_COMMENT_FOLLOWERS = " \t\n!#"

# a token: an atom (its node; a bracket's list has its bracket), an opening or closing bracket, a separator or a key's
# `:` or `=` (its op), with the blank before it
enum LexemeKind { Atom, Open, Close, Separator, Key }
class Lexeme { kind: LexemeKind; node: Node; bracket: Bracket; separator: Separator; glued: bool; line: int; column: int; indented: bool = no; op: Op = Op.Colon }

class Reader { code: list; n: int; at: int = 0; line: int = 1; line_start: int = 0; blank: bool = yes; tokens: list<Lexeme> = []; opened: list<Lexeme> = []; indents: list = []; margin: int = -1; indent_char: text = ""; comments: list = []; line_atom: Lexeme? = ø; error: text = ""; failure: Node = Empty }

# the notation of a text read from a file: its one item, the list of its items, Empty for none, each node marked with
# the file (core/stage.wap file_of); text it cannot read is refused where it was written (core/errors.wap)
notation(source: text, file: text) as Node := {
	code = source.codepoints
	r = Reader{code: code, n: code.length}
	read_tokens(r)
	if r.error != "" { refused(filed(r.failure, file), r.error) }
	filed(built(r.tokens), file)
}
# n and each part of it that has a position, marked with the file it was read from
filed(n: Node, file: text) as Node := {
	if n == ø { return n }
	whole = refitted(with_parts(n, part => filed(part, file)), n)
	if line_of(n) == ø then whole else with_fact(whole, SOURCE_FILE, Text(file))
}

# ── pass 1: tokens ──────────────────────────────────────────────────────────────────────────────────────────────────

read_tokens(r: Reader) := {
	indentation(r)
	while r.at < r.n and r.error == "" { read_token(r) }
	if r.error != "" { return ø }
	while r.indents.length > 0 { dedent(r) }
	if r.opened.length > 0 { failed_at(r, "this bracket is never closed", last_of(r.opened).line, last_of(r.opened).column) }
}

read_token(r: Reader) := {
	c = r.code[r.at]
	next = peek(r, 1)
	// todo rewrite as match c { ... later
	if c == '\n' { new_line(r) }
	else if c == ' ' or c == '\r' { r.at += 1; r.blank = yes }
	else if c == '\t' { tab(r) }
	else if c == '/' and next == '/' and not after_colon(r) { line_comment(r, 2) }
	else if c == '#' and r.blank and HASH_COMMENT_FOLLOWERS.contains(next) { line_comment(r, 1) }
	else if c == '/' and (next == '*' or next == '#') { block_comment(r) }
	else if OPENERS.contains(c) { bracket_opened(r, c, 1) }
	else if CLOSERS.contains(c) { bracket_closed(r, c) }
	else if c == ',' { separated(r, Separator.Comma, 1) }
	else if c == ';' { separated(r, Separator.Semicolon, 1) }
	else if QUOTES.contains(c) { quoted(r, c) }
	else if is_digit(c) or (signs_number(r) and is_digit(next)) { number_read(r) }
	else if c == ':' and next != ':' and next != '=' { key_token(r, Op.Colon) }
	else if c == ':' and next == '=' and not joins_glyph(r, 2) { key_token(r, Op.Define) }
	else if c == '=' and not joins_glyph(r, 1) { key_token(r, Op.Assign) }
	else if is_glyph(c) { glyphs_read(r, c) }
	else if is_name_char(c) { name_read(r) }
	else { failed(r, "a character the reader does not know") }
}

# the character `ahead` of the reader's place, a newline past the end
peek(r: Reader, ahead: int) as text := peek_at(r, r.at + ahead)
peek_at(r: Reader, at: int) as text := if at < r.n then r.code[at] else "\n"

# `http://`: `//` glued after `:` is no comment
after_colon(r: Reader) as bool := r.at > 0 and r.code[r.at - 1] == ':'

# A sign glued to digits is part of the number where an item starts: after a blank, a bracket, a separator or an
# operator (`a -1`, `(-1)`, `x=-1`), never after a word, number or closing bracket (`a-1` is a - 1)
signs_number(r: Reader) as bool := {
	c = r.code[r.at]
	if c != '-' and c != '+' { return no }
	if r.blank or r.at == 0 { return yes }
	before = r.code[r.at - 1]
	OPENERS.contains(before) or before == ',' or before == ';' or (is_glyph(before) and before != c)
}

# `=` alone makes a key; `==`, `=>` and the like are operators, while a sign after it starts a number (`x=-1`)
joins_glyph(r: Reader, width: int) as bool := {
	next = peek(r, width)
	is_glyph(next) and not ((next == '-' or next == '+') and is_digit(peek(r, width + 1)))
}

# a key's `:`, `=` or `:=`
key_token(r: Reader, op: Op) := {
	spelling = op as text
	token(r, LexemeKind.Key, Symbol(spelling), spelling.length)
	last_of(r.tokens).op = op
}

# the token of a list at `i` (from 0), the last one
token_at(tokens: list, i: int) as Lexeme := tokens[i]
last_of(tokens: list) as Lexeme := tokens.last

# the text from `start` to `end` (code points, from 0)
slice_of(r: Reader, start: int, end: int) as text := r.code[start .. end].join("")

column(r: Reader) as int := r.at - r.line_start + 1

# a token of `width` characters at the reader's place
token(r: Reader, kind: LexemeKind, node: Node, width: int) := added(r, kind, node, r.line, column(r), r.at + width)

# a token written at line:column, the reader going on at `end`; an atom takes the comments waiting before it
added(r: Reader, kind: LexemeKind, node: Node, line: int, column: int, end: int) := {
	t = Lexeme{kind: kind, node: node, bracket: Bracket.None, separator: Separator.None, glued: not r.blank, line: line, column: column}
	if kind == LexemeKind.Atom {
		t.node = commented(positioned(node, line, column), r.comments)
		r.comments = []
		r.line_atom = t
	}
	r.tokens += [t]
	r.at = end
	r.blank = no
}

# the last token so far, ø before the first
last_token(r: Reader) as Lexeme? := if r.tokens.length > 0 then last_of(r.tokens) else ø

# the first thing the reader cannot read, kept with what was written there
failed(r: Reader, why: text) := failed_at(r, why, r.line, column(r))
failed_at(r: Reader, why: text, line: int, column: int) := {
	if r.error != "" { return ø }
	r.error = why
	r.failure = positioned(Text(slice_of(r, r.at, min(r.at + 10, r.n))), line, column)
}

# ── comments ──

# `// …` and `# …` to the end of the line: the comment of the line's last atom, else of the next atom
line_comment(r: Reader, opener: int) := {
	end = r.at
	while end < r.n and r.code[end] != '\n' { end += 1 }
	noted(r, slice_of(r, r.at + opener, end).trim())
	r.at = end
	r.blank = yes
}

# `/* … */` and `/# … #/`, nested; a comment counts as a blank between items
block_comment(r: Reader) := {
	opener = slice_of(r, r.at, r.at + 2)
	closer = r.code[r.at + 1] + "/"
	depth = 0
	start = r.at
	while r.at < r.n {
		if slice_of(r, r.at, r.at + 2) == opener { depth += 1; r.at += 2 }
		else if slice_of(r, r.at, r.at + 2) == closer { depth -= 1; r.at += 2; if depth == 0 { break } }
		else { if r.code[r.at] == '\n' { r.line += 1; r.line_start = r.at + 1 }; r.at += 1 }
	}
	if depth > 0 { r.at = start; failed(r, "this comment is never closed") }
	pending(r, slice_of(r, start + 2, r.at - 2).trim())
	r.blank = yes
}

noted(r: Reader, comment: text) := if r.line_atom != ø then attach_comment(r.line_atom, comment) else pending(r, comment)
pending(r: Reader, comment: text) := { r.comments += [comment] }
attach_comment(t: Lexeme, comment: text) := { t.node = commented(t.node, [comment]) }

commented(n: Node, comments: list) as Node := {
	if comments.length == 0 { return n }
	earlier = fact_of(n, "comment")
	all = if earlier == ø then comments else [text(earlier)] + comments
	with_fact(n, "comment", Text(all.join("\n")))
}

# ── brackets, separators, indentation ──

bracket_opened(r: Reader, c: text, width: int) := {
	token(r, LexemeKind.Open, Empty, width)
	t = r.tokens.last
	t.bracket = bracket_of(c)
	r.opened += [t]
}

bracket_closed(r: Reader, c: text) := {
	if r.opened.length == 0 or last_of(r.opened).indented or last_of(r.opened).bracket != bracket_of(c) {
		return failed(r, "this bracket closes no open bracket")
	}
	r.opened = r.opened[0 .. r.opened.length - 1]
	token(r, LexemeKind.Close, Empty, 1)
	last_of(r.tokens).bracket = bracket_of(c)
}

bracket_of(c: text) as Bracket := BRACKETS[(if OPENERS.contains(c) then OPENERS else CLOSERS).find(c) - 1]

# a separator; two in a row are one, the looser
separated(r: Reader, separator: Separator, width: int) := {
	last = last_token(r)
	if last != ø and last.kind == LexemeKind.Separator {
		if looseness(separator) > looseness(last.separator) { last.separator = separator }
		r.at += width
	} else {
		token(r, LexemeKind.Separator, Empty, width)
		last_of(r.tokens).separator = separator
	}
	r.blank = yes
}

looseness(separator: Separator) as int := SEPARATOR_ORDER.index_of(separator)

# a tab between two items of a line separates columns; elsewhere it is a blank
tab(r: Reader) := {
	last = last_token(r)
	if last != ø and last.kind != LexemeKind.Open and last.line == r.line { separated(r, Separator.Tab, 1) } else { r.at += 1; r.blank = yes }
}

# A new line separates, unless it opens or closes an indented block. Inside a bracket indentation means nothing.
new_line(r: Reader) := {
	r.at += 1
	r.line += 1
	r.line_start = r.at
	r.line_atom = ø
	r.blank = yes
	if r.opened.length > 0 and not last_of(r.opened).indented { return separated_line(r) }
	indentation(r)
}

separated_line(r: Reader) := {
	last = last_token(r)
	if last != ø and last.kind != LexemeKind.Open { separated(r, Separator.Newline, 0) }
}

# The indentation of the next line that holds code (empty lines and comment lines change nothing): a deeper one
# opens a block `{` glued to the line before, a shallower one closes blocks down to its level
indentation(r: Reader) := {
	start = r.at
	while r.at < r.n and (r.code[r.at] == ' ' or r.code[r.at] == '\t') { r.at += 1 }
	if r.at >= r.n { return ø }
	c = r.code[r.at]
	next = peek(r, 1)
	if c == '\n' or c == '\r' or (c == '/' and next == '/') or (c == '#' and HASH_COMMENT_FOLLOWERS.contains(next)) { return ø }
	written = slice_of(r, start, r.at)
	if not indent_consistent(r, written) { return ø }
	# the first line's indentation is the text's margin: a pasted, indented text reads as if it had none
	if r.margin < 0 { r.margin = written.length }
	depth = written.length - r.margin
	if depth < 0 { return failed(r, "this line is indented less than the first line") }
	outer = indent_level(r)
	if depth > outer {
		r.indents += [depth]
		r.blank = no
		bracket_opened(r, "{", 0)
		last_of(r.tokens).indented = yes
		return ø
	}
	while depth < outer {
		dedent(r)
		outer = indent_level(r)
	}
	if depth != outer { return failed(r, "this line's indentation matches no line above it") }
	separated_line(r)
}

# the depth of the innermost indented block, 0 outside all
indent_level(r: Reader) as int := if r.indents.length > 0 then r.indents.last else 0

# tabs or spaces, one of them throughout the text
indent_consistent(r: Reader, written: text) as bool := {
	if written == "" { return yes }
	if r.indent_char == "" { r.indent_char = written[0] }
	for c in written { if c != r.indent_char { failed(r, "indentation mixes tabs and spaces"); return no } }
	yes
}

dedent(r: Reader) := {
	r.indents = r.indents[0 .. r.indents.length - 1]
	r.opened = r.opened[0 .. r.opened.length - 1]
	if last_of(r.tokens).kind == LexemeKind.Separator { r.tokens = r.tokens[0 .. r.tokens.length - 1] }
	r.blank = no
	token(r, LexemeKind.Close, Empty, 0)
	last_of(r.tokens).bracket = Bracket.Curly
	last_of(r.tokens).indented = yes
}

# ── atoms ──

# a run of name characters: a word, `$hole` and `π` included
name_read(r: Reader) := {
	end = r.at
	while end < r.n and is_name_char(r.code[end]) { end += 1 }
	if slice_of(r, end, min(end + 3, r.n)) == "://" { return url_read(r, end + 3) }
	token(r, LexemeKind.Atom, Symbol(slice_of(r, r.at, end)), end - r.at)
}

# A word glued to `://` begins a URL, `http://x.com/a?b=1`, any scheme alike: one Text up to the next blank,
# bracket or separator, as today's warp reads it (reader.md §6, URLs)
url_read(r: Reader, from: int) := {
	end = from
	while end < r.n and not URL_ENDS.contains(r.code[end]) { end += 1 }
	token(r, LexemeKind.Atom, Text(slice_of(r, r.at, end)), end - r.at)
}

# operator glyphs: one glyph, joined with its repeats and one `=` after them (`==` `<=` `...` `**=`), Q5
glyphs_read(r: Reader, c: text) := {
	end = r.at + 1
	while end < r.n and r.code[end] == c { end += 1 }
	if end < r.n and r.code[end] == '=' and c != '=' { end += 1 }
	token(r, LexemeKind.Atom, Symbol(slice_of(r, r.at, end)), end - r.at)
}

# `12`, `-3`, `1_000`, `3.5`, `3.`, `1e-3`, `0xFF`: an int, or a float when it has a point or a negative exponent
number_read(r: Reader) := {
	end = r.at
	sign = ""
	if r.code[end] == '-' or r.code[end] == '+' { sign = r.code[end]; end += 1 }
	if r.code[end] == '0' and (peek_at(r, end + 1) == 'x' or peek_at(r, end + 1) == 'X') { return hex_read(r, sign, end + 2) }
	digits = digits_end(r, end)
	written = slice_of(r, end, digits)
	end = digits
	is_float = no
	after = peek_at(r, end + 1)
	if peek_at(r, end) == '.' and (is_digit(after) or after != '.' and not is_name_char(after)) {
		end += 1
		fraction = digits_end(r, end)
		written += "." + (if fraction > end then slice_of(r, end, fraction) else "0")
		end = fraction
		is_float = yes
	}
	if end + 1 < r.n and (r.code[end] == 'e' or r.code[end] == 'E') {
		exponent_sign = r.code[end + 1]
		signed = (exponent_sign == '-' or exponent_sign == '+') and end + 2 < r.n and is_digit(r.code[end + 2])
		if is_digit(exponent_sign) or signed {
			start = end + (if signed then 2 else 1)
			exponent = digits_end(r, start)
			# 1e3 is the int 1000, as written out; 1e-3 and 1.5e3 are floats
			is_float = is_float or exponent_sign == '-'
			written += if is_float then "e" + (if signed then exponent_sign else "") + slice_of(r, start, exponent) else "0" * int(slice_of(r, start, exponent))
			end = exponent
		}
	}
	written = (if sign == '-' then "-" else "") + written.replace("_", "")
	token(r, LexemeKind.Atom, Number(if is_float then float(written) else whole(written)), end - r.at)
}

# after the digits from `at` on, `_` between two digits included
digits_end(r: Reader, at: int) as int := {
	while at < r.n and (is_digit(r.code[at]) or r.code[at] == '_' and at + 1 < r.n and is_digit(r.code[at + 1])) { at += 1 }
	at
}

hex_read(r: Reader, sign: text, from: int) := {
	end = from
	while end < r.n and (is_hex_digit(r.code[end]) or r.code[end] == '_') { end += 1 }
	value = hex_number(slice_of(r, from, end).replace("_", ""))
	token(r, LexemeKind.Atom, Number(if sign == '-' then 0 - value else value), end - r.at)
}

# an int as written, a float beyond the range of an int
whole(written: text) as number := if written.length > 18 then number(written) else int(written)

# A text in quotes, its escapes read (`«…»` holds everything as written); one character is a Char. A template's
# `${…}` holes stay in the text for a later rule (Q8)
quoted(r: Reader, quote: text) := {
	closer = QUOTE_CLOSERS[QUOTES.find(quote) - 1]
	start_line = r.line
	start_column = column(r)
	at = r.at + 1
	parts = []
	copied = at
	while at < r.n and r.code[at] != closer {
		if r.code[at] == '\n' { r.line += 1; r.line_start = at + 1 }
		if r.code[at] == '\\' and quote != RAW_QUOTE {
			escape = escaped(r, at)
			if escape == ø { r.at = at; return failed(r, "a backslash escape the reader does not know") }
			parts += [slice_of(r, copied, at), escape#1]
			at += escape#2
			copied = at
		} else { at += 1 }
	}
	if at >= r.n { return failed_at(r, "this text is never closed", start_line, start_column) }
	content = (parts + [slice_of(r, copied, at)]).join("")
	node: Node = if content.length == 1 then content#1 as codepoint else Text(content)
	added(r, LexemeKind.Atom, node, start_line, start_column, at + 1)
}

# the escape at the backslash `at`: [what it reads as, the characters it takes], ø for an unknown one
escaped(r: Reader, at: int) as list? := {
	c = if at + 1 < r.n then r.code[at + 1] else ""
	if ESCAPED_AS_IS.contains(c) { return [c, 2] }
	if ESCAPE_LETTERS.contains(c) { return [ESCAPE_CHARACTERS[ESCAPE_LETTERS.find(c) - 1], 2] }
	if LATER_ESCAPES.contains(c) { return ["\\" + c, 2] }
	if c == 'x' and at + 3 < r.n and is_hex_digit(r.code[at + 2]) and is_hex_digit(r.code[at + 3]) {
		return [hex_number(slice_of(r, at + 2, at + 4)) as codepoint, 4]
	}
	if c == 'u' and peek_at(r, at + 2) == '{' {
		end = at + 3
		while end < r.n and is_hex_digit(r.code[end]) { end += 1 }
		if end > at + 3 and peek_at(r, end) == '}' { return [hex_number(slice_of(r, at + 3, end)) as codepoint, end + 1 - at] }
	}
	ø
}

hex_number(digits: text) as int := {
	value = 0
	for digit in digits { value = value * 16 + "0123456789abcdef".find(digit.lower()) - 1 }
	value
}

# ── character classes: the only thing that tells a word from an operator ──

# ASCII punctuation but brackets, quotes, separators and the name characters `_` `$`, and the glyphs beyond ASCII
is_glyph(c: text) as bool := {
	if c <= '~' { return c > ' ' and not is_alpha(c) and not is_digit(c) and not «_$()[]{}"'`,;».contains(c) }
	if OTHER_GLYPHS.contains(c) { return yes }
	for range in GLYPH_RANGES { if c >= range#1 and c <= range#2 { return yes } }
	no
}

# letters, digits, `_`, `$`, and every character beyond ASCII that is no glyph, quote or blank
is_name_char(c: text) as bool := {
	if c <= '~' { return is_alpha(c) or is_digit(c) or c == '_' or c == '$' }
	not is_glyph(c) and not QUOTES.contains(c) and not QUOTE_CLOSERS.contains(c) and c != '\u{a0}'
}

# a node placed where it was written, when that is known; an empty `{}` or `()` is Empty in warp's Node and carries
# no metadata
placed(n: Node, line: int?, column: int?) as Node := if n == ø or line == ø then n else positioned(n, line, column)

# ── pass 2: the separator cascade ───────────────────────────────────────────────────────────────────────────────────

# the whole text: one item, the list of its items, or Empty
built(tokens: list<Lexeme>) as Node := level_node(body_read(tokens, 0).parts)

class Body { parts: list<Lexeme>; at: int }

# the tokens from `at` up to the closing bracket, a bracket's own list made of each inner bracket
body_read(tokens: list<Lexeme>, at: int) as Body := {
	parts = []
	while at < tokens.length and token_at(tokens, at).kind != LexemeKind.Close {
		t = tokens[at]
		if t.kind == LexemeKind.Open {
			inner = body_read(tokens, at + 1)
			parts += [Lexeme{kind: LexemeKind.Atom, node: bracket_list(inner.parts, t), bracket: t.bracket, separator: Separator.None, glued: t.glued, line: t.line, column: t.column}]
			at = inner.at + 1
		} else {
			if t.kind != LexemeKind.Separator or parts.length > 0 { parts += [t] }
			at += 1
		}
	}
	if parts.length > 0 and last_of(parts).kind == LexemeKind.Separator { parts = parts[0 .. parts.length - 1] }
	Body{parts: parts, at: at}
}

# a bracket's list: its items split by the loosest separator inside; duplicate keys in `{…}` warned of (Q12)
bracket_list(parts: list<Lexeme>, opener: Lexeme) as Node := {
	items = level_items(parts)
	separator = if items.length > 1 then loosest_separator(parts) else Separator.None
	written = placed(List(items, opener.bracket, separator), opener.line, opener.column)
	if opener.bracket == Bracket.Curly then with_duplicates_warned(written, items) else written
}

listed(items: list, bracket: Bracket, separator: Separator) as Node := placed(List(items, bracket, separator), line_of(items#1), column_of(items#1))

# the loosest separator among the parts, Space between two unglued atoms, None for a glued run
loosest_separator(parts: list<Lexeme>) as Separator := {
	found = Separator.None
	for i in 0 ..< parts.length {
		t = parts[i]
		here = if t.kind == LexemeKind.Separator then t.separator else if i > 0 and not t.glued and token_at(parts, i - 1).kind != LexemeKind.Separator then Separator.Space else Separator.None
		if looseness(here) > looseness(found) { found = here }
	}
	found
}

# the items of a level: the parts split by their loosest separator, each piece read one level tighter
level_items(parts: list<Lexeme>) as list := {
	separator = loosest_separator(parts)
	if separator == Separator.None { return if parts.length == 0 then [] else [glued_run(parts)] }
	if separator == Separator.Space { return annotated(spaced(runs_of(parts))) }
	pieces = pieces_between(parts, separator)
	annotated(pieces.map(piece => level_node(piece)))
}

# a level as one node: Empty, its one item, or the list of its items
level_node(parts: list<Lexeme>) as Node := {
	items = level_items(parts)
	if items.length == 0 { return Empty }
	if items.length == 1 then items#1 else listed(items, Bracket.None, loosest_separator(parts))
}

# the parts between the separators of this kind, the tighter separators kept inside each piece
pieces_between(parts: list<Lexeme>, separator: Separator) as list := {
	pieces = []
	piece = []
	for t in parts {
		if t.kind == LexemeKind.Separator and looseness(t.separator) >= looseness(separator) { pieces += [piece]; piece = [] } else { piece += [t] }
	}
	pieces + [piece]
}

# the glued runs of a phrase: a new run at each part with a blank before it
runs_of(parts: list<Lexeme>) as list := { // todo use  [Lexeme] as soon as syntax works, EVERYWHERE for all generics (via warp fix ?)
	runs = []
	run = []
	for t in parts {
		if not t.glued and run.length > 0 { runs += [run]; run = [] }
		run += [t]
	}
	runs + [run]
}

# A phrase's items, split at its loosest key (below). A key with blanks around takes all before it as key and all
# after it as value (`a b : c`, `x = a + b`); glued to a run with a blank after, it takes the rest of the phrase as
# value (`a: b c`)
spaced(runs: list) as list := {
	split = splitting_run(runs)
	if split < 0 { return runs.map(glued_run) }
	run = runs[split]
	before = runs[0 .. split]
	value = phrase_of(spaced(runs[split + 1 .. runs.length]))
	if run.length == 1 then [keyed(phrase_of(spaced(before)), last_of(run).op, value)] else spaced(before) + [keyed(glued_run(run[0 .. run.length - 1]), last_of(run).op, value)]
}

# Keys split by looseness: `=` and `:=` before `:`, so `x: int = 3` is (x: int) = 3 and `f(x): int := e` gives
# f(x): int the body e; among keys alike the first splits (reader.md §6, typed declarations)
KEY_LOOSENESS = {":": 1, "=": 2, ":=": 2}
key_looseness(op: Op) as int := KEY_LOOSENESS[op as text]

# the run of a phrase at its loosest key, -1 for none: a key between blanks (never the first run), or ending its run
splitting_run(runs: list) as int := {
	found = -1
	for i in 0 ..< runs.length {
		run = runs[i]
		if last_of(run).kind == LexemeKind.Key and (run.length > 1 or i > 0) and (found < 0 or key_looseness(last_of(run).op) > key_looseness(last_of(runs[found]).op)) { found = i }
	}
	found
}

# the items as one node: Empty for none, the item for one, else a phrase
phrase_of(items: list) as Node := if items.length == 0 then Empty else if items.length == 1 then items#1 else listed(items, Bracket.None, Separator.Space)

# A run without blanks: `x:40` and `a=1` split at their loosest key, the first of alike ones; a head glued to a bracket is the glue key
# Key(head, Op.None, group), `f(x)` `a{x:1}` `xs[1]` `f(x)(y)` (Q1); a run of one part is that part, any other run a
# glued list, `3ms` `a-b` `-x`
glued_run(run: list) as Node := {
	split = -1
	for i in 1 ..< run.length {
		t = token_at(run, i)
		if t.kind == LexemeKind.Key and (split < 0 or key_looseness(t.op) > key_looseness(token_at(run, split).op)) { split = i }
	}
	if split > 0 { return keyed(glued_run(run[0 .. split]), token_at(run, split).op, if split + 1 < run.length then glued_run(run[split + 1 .. run.length]) else Empty) }
	nodes = []
	for t in run {
		if t.bracket != Bracket.None and nodes.length > 0 and not is_operator(nodes.last) {
			nodes = nodes[0 .. nodes.length - 1] + [keyed(nodes.last, Op.None, t.node)]
		} else { nodes += [t.node] }
	}
	if nodes.length == 1 then nodes#1 else listed(nodes, Bracket.None, Separator.None)
}

# an operator written as glyphs, `+` `..` `#`: no head a bracket can glue to
is_operator(n: Node) as bool := match n { Symbol(name) => is_glyph(name#1); _ => no }

keyed(key: Node, op: Op, value: Node) as Node := placed(Key(key, op, value), line_of(key), column_of(key))

# ── annotations: `@name` and `@name(args)` belong to the item after them ──

annotated(items: list) as list := {
	result = []
	waiting = []
	for item in items {
		if is_annotation(item) { waiting += [item] }
		else if waiting.length > 0 { result += [with_fact(item, "meta", phrase_of(waiting.map(annotation_of)))]; waiting = [] }
		else { result += [item] }
	}
	result + waiting
}

# `@name…` glued, or a phrase of them
is_annotation(n: Node) as bool := match n {
	List(items, Bracket.None, Separator.None) => items.length > 1 and items#1 == Symbol("@")
	List(items, Bracket.None, Separator.Space) => items.all(is_annotation)
	_ => no
}

# what an annotation says, without its `@`
annotation_of(n: Node) as Node := match n {
	List(items, Bracket.None, Separator.None) => if items.length == 2 then items#2 else listed(items[1 .. items.length], Bracket.None, Separator.None)
	List(items, Bracket.None, Separator.Space) => listed(items.map(annotation_of), Bracket.None, Separator.Space)
	_ => n
}

# ── duplicate keys: the reader keeps both and warns, a later stage decides (Q12) ──

with_duplicates_warned(written: Node, items: list) as Node := {
	seen = []
	for item in items {
		match item {
			Key(key, Op.Colon, value) => {
				name = text(key)
				if seen.contains(name) { return with_fact(written, "warning", Text("the key " + name + " is given twice")) }
				seen += [name]
			}
			_ => ø
		}
	}
	written
}
