# The variables of the binding analysis (core/analyze/scope.wap): which variable each assignment gives a value to, a
# new one of its block or one it already sees, in the order the code is written, and the late reads of the program's
# variables a function must declare.

use "scope.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"

# The variables a Block names without a value (VARIABLES, core/rules/lowering.wap): `let x` a new one of the block,
# `global x` the program's x, which the block then reads and changes as its own
named_variables(block: Node, scope: list, depth: int) as list := match fact_of(block, VARIABLES) {
	List(items, bracket, separator) => items.map(naming => named_variable(naming, scope, depth))
	_ => []
}
named_variable(naming: Node, scope: list, depth: int) as Definition := match naming {
	Key(name, Op.Colon, kind) => if text(kind) == BOUND_GLOBAL then Definition(text(name), BOUND_GLOBAL, program_variable(name, scope).definer, depth) else Definition(text(name), local_kind(depth), name, depth)
}
program_variable(name: Node, scope: list) as Definition := {
	for definition in program_scope(scope) { if definition.name == text(name) and definition.kind == BOUND_GLOBAL { return definition } }
	refused(name, "the program has no variable of this name")
}

# the definitions of the program and the library, the ones `global x = …` sees
program_scope(scope: list) as list := scope.filter(definition => definition.depth <= PROGRAM_DEPTH)

# The definitions a Block makes: each function it defines, and each name it gives a value to that this function does
# not see yet. Nested Blocks and functions keep theirs; a Set inside another form (an If's branch) is the Block's.
defined_in(statements: list, scope: list, depth: int) as list := {
	made = []
	for statement in statements { made = made + definitions_made_by(statement, made + scope, depth) }
	made
}
definitions_made_by(n: Node, scope: list, depth: int) as list := match n {
	Define(name, parameters, body) => [Definition(text(declared_name(name)), BOUND_FUNCTION, declared_name(name), depth)]
	Record(name, fields, variants) => [Definition(text(name), RECORD_KIND, n, depth)] + cases_of(n).map(case => Definition(text(case_name(case)), BOUND_CASE, case_name(case), depth, text(name), #case_fields(case)))
	Set(place, value) => assigned_variables(n, declared_name(place), scope, depth) + definitions_made_by(value, scope, depth)
	Block(statements) => []
	Fn(parameters, body) => []
	Call(called, arguments) => defined_in(arguments, scope, depth)
	Prim(operation, arguments) => defined_in(arguments, scope, depth)
	If(condition, then_part, else_part) => defined_in([condition, then_part, else_part], scope, depth)
	While(condition, body) => defined_in([condition, body], scope, depth)
	Case(subject, arms) => defined_in([subject] + arms.map(arm_result), scope, depth)
	Return(value) => defined_in([value], scope, depth)
	Get(subject, key) => defined_in([subject, key], scope, depth)
	List(items, Bracket.Square, separator) => defined_in(items, scope, depth)
	_ => []
}
# The variable an assignment makes: a new one for `let x = …` and for a name its function sees no variable of;
# none for `global x = …`, the program's, or for a variable its function has. A name that is a variable of the
# program or of a function around, defined before it, reads two ways, so the assignment is refused naming both; one
# defined only later is no variable yet, so the assignment makes its own.
assigned_variables(set: Node, place: Node, scope: list, depth: int) as list := {
	if not place is symbol or fact_of(set, ASSIGNS) == symbol(BOUND_GLOBAL) { return [] }
	name = text(place)
	if fact_of(set, ASSIGNS) != symbol(BOUND_LOCAL) {
		if seen_in_function(name, scope, depth) { return [] }
		outer = outer_variable(name, scope, depth)
		if outer != ø and written_before(outer.definer, place) { refused(place, "this could change the ${outer.kind} ${name} (line ${line_of(outer.definer)}:${column_of(outer.definer)}) or make a new variable here: write `let ${name} = …` for a new one" + global_reading(outer, name)) }
	}
	[Definition(name, local_kind(depth), place, depth)]
}
# whether code was written before other code of its file, ø positions counting as before
written_before(earlier: Node, later: Node) as bool := line_of(earlier) == ø or line_of(later) == ø or line_of(earlier) < line_of(later) or line_of(earlier) == line_of(later) and column_of(earlier) < column_of(later)
global_reading(outer: Definition, name: text) as text := if outer.kind == BOUND_GLOBAL then ", `global ${name} = …` for the program's" else ""
# the variable of that name the program or a function around the one at depth defines, ø when the name is none
outer_variable(name: text, scope: list, depth: int) as Definition? := {
	for definition in scope {
		if definition.name == name { return if definition.depth > LIBRARY_DEPTH and definition.depth < depth and definition.kind != BOUND_FUNCTION then definition else ø }
	}
	ø
}
local_kind(depth: int) as text := if depth == PROGRAM_DEPTH then BOUND_GLOBAL else BOUND_LOCAL
seen_in_function(name: text, scope: list, depth: int) as bool := {
	for definition in scope { if definition.name == name and definition.depth == depth { return yes } }
	no
}

# Late reads (wiki/Footguns.md "Closures capturing loop variables"): a function reads a program variable when it is
# called, so where the program changes the variable after the function's definition, the function declares it,
# `global x`, and the reader sees that it reads the variable as it is then. An undeclared read of such a variable is
# refused where it is written. The program's first value of a variable is its definition, no change.
late_reads_checked(program: Node) as Node := {
	changes = global_changes(program, no)
	match program {
		Block(statements) => for statement in statements { if function_defined_by(statement) != ø { late_reads_of(function_defined_by(statement), line_of(statement), [], changes) } }
		_ => ø
	}
	program
}
# the function a top-level statement defines: `f(x) := …`, or `f = x => …`
function_defined_by(statement: Node) as Node? := match statement {
	Define(name, parameters, body) => statement
	Set(place, value) => if value is Fn then value else ø
	_ => ø
}
# Each change of a program variable: where the program writes it, or anytime for a change inside a function, which
# runs whenever the function is called
class Change { name: text; line: int; anytime: bool }
global_changes(n: Node, in_function: bool) as list := match n {
	Set(place, value) => (if is_change(place) then [Change(text(place), line_of(place), in_function)] else []) + global_changes(value, in_function)
	Define(name, parameters, body) => global_changes(body, yes)
	Fn(parameters, body) => global_changes(body, yes)
	Key(left, op, right) => global_changes(left, in_function) + global_changes(right, in_function)
	List(items, bracket, separator) => items.flat_map(item => global_changes(item, in_function))
	_ => []
}
# whether a place given a value is a program variable given another value than its first
is_change(place: Node) as bool := fact_of(place, BINDING) == symbol(BOUND_GLOBAL) and not same_place(place, fact_of(place, DEFINED_AT))
same_place(a: Node, b: Node) as bool := line_of(a) == line_of(b) and column_of(a) == column_of(b)

# the reads in a function, defined at line, of program variables that change after it, refused unless declared
late_reads_of(n: Node?, line: int, declared: list, changes: list) := match n {
	Symbol(name) => if fact_of(n, BINDING) == symbol(BOUND_GLOBAL) and not declared.contains(name) and changes_after(name, line, changes) { refused(n, "the program changes ${name} after this function is defined: write `global ${name}` in the function, so it reads ${name} as it is when called") }
	Set(place, value) => late_reads_of(value, line, declared, changes)
	Block(statements) => for statement in statements { late_reads_of(statement, line, declared + globals_named(n), changes) }
	Key(left, op, right) => { late_reads_of(left, line, declared, changes); late_reads_of(right, line, declared, changes) }
	List(items, bracket, separator) => for item in items { late_reads_of(item, line, declared, changes) }
	_ => ø
}
changes_after(name: text, line: int, changes: list) as bool := {
	for change in changes { if change.name == name and (change.anytime or change.line > line) { return yes } }
	no
}
# the names a Block declares the program's, `global x`
globals_named(block: Node) as list := match fact_of(block, VARIABLES) {
	List(items, bracket, separator) => items.filter(naming => text(naming.value) == BOUND_GLOBAL).map(naming => text(naming.key))
	_ => []
}
