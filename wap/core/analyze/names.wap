# What a name may mean where the binding analysis meets it (core/analyze/scope.wap): the definitions in scope, layer
# by layer, each layer finding its definitions of a name through its index, and the ones a name means.

use "../stage.wap"
use "../bindings.wap"

# What a name refers to: its kind as seen from the function that defined it, and the defining name itself
# (owner: a case's enum)
# a case's owner is its enum, its fields how many values it takes
class Definition { name: text; kind: DefinitionKind; definer: Node; depth: int; owner: text = ""; fields: int = 0 }
# The definitions a name may mean, layer by layer, innermost first: a block's, a function's parameters …, the
# program's, then the used modules' and the preload's; each layer finds its definitions of a name through its index
class Layer { definitions: list<Definition>; index: NameIndex = NameIndex() }
class Scope { layers: list<Layer> = [] }
# a scope of these definitions alone
scope_of(definitions: list<Definition>) as Scope := Scope([Layer(definitions)])
# a scope with these definitions in front of it, innermost
within(scope: Scope, definitions: list<Definition>) as Scope := if definitions is empty then scope else Scope([Layer(definitions)] + scope.layers)
# the definitions of a name, innermost first
named_in(scope: Scope, name: text) as list<Definition> := scope.layers.flat_map(layer => items_named(layer.index, layer.definitions, name, definition => definition.name))
# every definition, innermost first
every_definition(scope: Scope) as list<Definition> := scope.layers.flat_map(layer => layer.definitions)
# The definitions a name may mean, innermost first: the one it finds, or, when that is a function, every function of
# that name around it, its overloads, up to a variable of that name, which hides the rest. The typing stage picks
# among several by the arguments' types. A type's or a module's name means no value. A case of an enum is meant only
# where no other value has its name: beside a class's maker, a variable or a pattern Box, `Box` is that, the case
# `Kind.Box` (or `Box` where a Kind is expected, types.wap)
definitions_meant(name: text, scope: Scope) as list<Definition> := {
	values = named_in(scope, name).filter(definition => not (definition.kind in [DefinitionKind.Record, DefinitionKind.Module]))
	others = values.filter(definition => definition.kind != DefinitionKind.Case)
	meant = []
	for definition in (if others is empty then values else others) {
		if not is_function(definition) { return if meant is empty then [definition] else meant }
		meant = meant + [definition]
	}
	meant
}
is_function(definition: Definition) as bool := definition.kind == DefinitionKind.Function or definition.kind == DefinitionKind.Library
