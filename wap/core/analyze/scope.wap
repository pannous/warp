# Binding analysis: kernel → bound kernel (first principles 15, notes/backbone.md "Stage languages").
#
# Scopes, shadowing, captures and globals are resolved here, once. Every name of the program gets two facts in its
# metadata (core/stage.wap with_fact), which every later stage reads instead of looking the name up again:
#   binding      what the name refers to: local, parameter, capture, global, function or library
#   defined_at   the name where that was defined, positioned, so an error can say where (ø for a library word)
#
#   x = 1                       x: global
#   f(y) := { z = x + y         z: local, x: global, y: parameter
#             g() := z          z: capture (g reads its enclosing function's local)
#             print z }         print: library
#
# Scopes: a Block opens one; a function (Define, Fn) opens one that also starts a new depth. A name a Block's
# statements give a value to, or define, belongs to that Block unless the same function sees it already; so a local
# never reaches another function, whatever its name (a local `push` in f leaves g's `xs.push` the library's). A
# definition is seen by its whole Block, before and after it, so functions may call each other.
# The stage only learns facts: every node keeps its shape and its own metadata.

# depth of the program's own statements: names defined there are globals and top-level functions
PROGRAM_DEPTH = 0
# depth of the library's words, around the program: the preload's declarations (core/analyze/declarations.wap)
LIBRARY_DEPTH = -1

# What a name refers to: its kind as seen from the function that defined it, and the defining name itself
class Definition { name: text; kind: text; definer: Node; depth: int }

# the program bound inside the library, whose declarations (`name: signature`) it may use
bound_program(program: Block, library: list) as Block := bound(program, library.map(library_word), PROGRAM_DEPTH)
library_word(declaration: Node) as Definition := match declaration { Key(name, Op.Colon, signature) => Definition(text(name), BOUND_LIBRARY, name, LIBRARY_DEPTH) }

# n with the facts on every name it holds; scope lists the definitions visible, the innermost first
bound(n: Node, scope: list, depth: int) as Node := match n {
	Symbol(name) => resolved(n, scope, depth)
	Block(statements) => refitted(Block(all_bound(statements, defined_in(statements, scope, depth) + scope, depth)), n)
	Define(name, parameters, body) => with_captures(refitted(Define(bound(name, scope, depth), parameters_bound(parameters, depth), body_bound(parameters, body, scope, depth)), n), scope, depth)
	Fn(parameters, body) => with_captures(refitted(Fn(parameters_bound(parameters, depth), body_bound(parameters, body, scope, depth)), n), scope, depth)
	Set(place, value) => refitted(Set(bound(place, if fact_of(n, ASSIGNS) == symbol(BOUND_GLOBAL) then program_scope(scope) else scope, depth), bound(value, scope, depth)), n)
	Call(called, arguments) => refitted(Call(bound(called, scope, depth), all_bound(arguments, scope, depth)), n)
	Prim(operation, arguments) => refitted(Prim(operation, all_bound(arguments, scope, depth)), n)
	Key(name, Op.Colon, type) => refitted(Key(bound(name, scope, depth), Op.Colon, type), n)
	If(condition, then_part, else_part) => refitted(If(bound(condition, scope, depth), bound(then_part, scope, depth), bound(else_part, scope, depth)), n)
	Number(value) => n
	Text(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	_ => refused(n, "the binding analysis reads only kernel forms; the lowering should have removed this")
}
all_bound(forms: list, scope: list, depth: int) as list := forms.map(form => bound(form, scope, depth))

# the definitions of the program and the library, the ones `global x = …` sees
program_scope(scope: list) as list := scope.filter(definition => definition.depth <= PROGRAM_DEPTH)

# A function's parameters and body, one depth further in than the function's definition, the body seeing the
# parameters before the names around it
parameters_bound(parameters: List, depth: int) as Node := match parameters {
	List(items, bracket, separator) => refitted(List(items.map(p => bound(p, parameter_definitions(parameters, depth + 1), depth + 1)), bracket, separator), parameters)
}
body_bound(parameters: List, body: Node, scope: list, depth: int) as Node := bound(body, parameter_definitions(parameters, depth + 1) + scope, depth + 1)
parameter_definitions(parameters: List, depth: int) as list := match parameters {
	List(items, bracket, separator) => items.map(p => Definition(text(parameter_name(p)), BOUND_PARAMETER, parameter_name(p), depth))
}

# A function with the fact `captures`: the names of the functions around it that its body reads, a nested function's
# reads included (the function passes them on), each defining name once in the order first read; [] when it captures
# nothing. A closure is built from them (core/emit/closures.wap).
with_captures(function: Node, scope: list, depth: int) as Node := {
	captured = []
	for definer in captured_definers(function) {
		if from_enclosing_function(definer, scope, depth) and not identical_in(definer, captured) { captured = captured + [definer] }
	}
	with_fact(function, CAPTURES, List(captured, Bracket.Square, Separator.Comma))
}
# the defining names of the captures read anywhere in n
captured_definers(n: Node) as list := match n {
	Symbol(name) => if fact_of(n, BINDING) == symbol(BOUND_CAPTURE) then [fact_of(n, DEFINED_AT)] else []
	Key(left, op, right) => captured_definers(left) + captured_definers(right)
	List(items, bracket, separator) => items.flat_map(captured_definers)
	_ => []
}
# whether a defining name belongs to a function around the one at depth, not to the program or the library
from_enclosing_function(definer: Node, scope: list, depth: int) as bool := {
	for definition in scope { if definition.definer === definer { return definition.depth > PROGRAM_DEPTH and definition.depth <= depth } }
	no
}
identical_in(n: Node, nodes: list) as bool := {
	for other in nodes { if other === n { return yes } }
	no
}

# the name a parameter defines: `x`, or the x of `x: int`
parameter_name(parameter: Node) as Node := if declared_name(parameter) is symbol then declared_name(parameter) else refused(parameter, "a parameter is a name, or a name and its type")

# The definitions a Block makes: each function it defines, and each name it gives a value to that this function does
# not see yet. Nested Blocks and functions keep theirs; a Set inside another form (an If's branch) is the Block's.
defined_in(statements: list, scope: list, depth: int) as list := {
	made = []
	for statement in statements { made = made + definitions_made_by(statement, made + scope, depth) }
	made
}
definitions_made_by(n: Node, scope: list, depth: int) as list := match n {
	Define(name, parameters, body) => [Definition(text(declared_name(name)), BOUND_FUNCTION, declared_name(name), depth)]
	Set(place, value) => assigned_variables(n, declared_name(place), scope, depth) + definitions_made_by(value, scope, depth)
	Block(statements) => []
	Fn(parameters, body) => []
	Call(called, arguments) => defined_in(arguments, scope, depth)
	Prim(operation, arguments) => defined_in(arguments, scope, depth)
	If(condition, then_part, else_part) => defined_in([condition, then_part, else_part], scope, depth)
	_ => []
}
# The variable an assignment makes: a new one for `let x = …` and for a name its function sees no variable of;
# none for `global x = …`, the program's, or for a variable its function has. A name that is a variable of the
# program or of a function around reads two ways, so the assignment is refused naming both.
assigned_variables(set: Node, place: Node, scope: list, depth: int) as list := {
	if not place is symbol or fact_of(set, ASSIGNS) == symbol(BOUND_GLOBAL) { return [] }
	name = text(place)
	if fact_of(set, ASSIGNS) != symbol(BOUND_LOCAL) {
		if seen_in_function(name, scope, depth) { return [] }
		outer = outer_variable(name, scope, depth)
		if outer != ø { refused(place, "this could change the ${outer.kind} ${name} (line ${line_of(outer.definer)}:${column_of(outer.definer)}) or make a new variable here: write `let ${name} = …` for a new one${if outer.kind == BOUND_GLOBAL then ", `global ${name} = …` for the program's" else ""}") }
	}
	[Definition(name, local_kind(depth), place, depth)]
}
# the variable of that name the program or a function around the one at depth defines, ø when the name is none
outer_variable(name: text, scope: list, depth: int) as Definition? := {
	for definition in scope {
		if definition.name == name { return if definition.depth > LIBRARY_DEPTH and definition.depth < depth and definition.kind != BOUND_FUNCTION then definition else ø }
	}
	ø
}
local_kind(depth: int) as text := if depth == PROGRAM_DEPTH then BOUND_GLOBAL else BOUND_LOCAL
seen_in_function(name: text, scope: list, depth: int) as bool := {
	for definition in scope { if definition.name == name and definition.depth == depth { return yes } }
	no
}

# A name with what it refers to, as seen from depth: its own function's names as they were defined, the program's
# globals and functions and the library's words as such, an enclosing function's names as captures; a name nothing
# defines is refused
resolved(name: Node, scope: list, depth: int) as Node := {
	meant = definitions_meant(text(name), scope)
	if meant is empty { refused(name, "nothing defines this name, neither the program nor the library") }
	innermost = meant#1
	kind = if innermost.depth == depth or innermost.depth <= PROGRAM_DEPTH then innermost.kind else BOUND_CAPTURE
	bound = with_fact(name, BINDING, symbol(kind))
	if #meant == 1 then with_fact(bound, DEFINED_AT, innermost.definer) else with_fact(bound, CANDIDATES, List(meant.map(definition => definition.definer), Bracket.Square, Separator.Comma))
}
# The definitions a name may mean, innermost first: the one it finds, or, when that is a function, every function of
# that name around it, its overloads, up to a variable of that name, which hides the rest. The typing stage picks
# among several by the arguments' types.
definitions_meant(name: text, scope: list) as list := {
	meant = []
	for definition in scope {
		if definition.name == name {
			if not is_function(definition) { return if meant is empty then [definition] else meant }
			meant = meant + [definition]
		}
	}
	meant
}
is_function(definition: Definition) as bool := definition.kind == BOUND_FUNCTION or definition.kind == BOUND_LIBRARY
