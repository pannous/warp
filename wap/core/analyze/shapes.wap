# Shapes as types (wiki/pattern-matching.md "Named patterns as types"): a case of an enum, `List` of Node, or a declared
# pattern, `Record` (wap/kernel/forms.wap), names the values of a type that have its shape. Written as a type, its
# symbol carries the type it narrows as a fact, so every stage reads it without a lookup: a value of the shape is a
# value of that type (core/analyze/fits.wap conversion, Same), the emitter lays it out as one; a value of that type
# where the shape is wanted is narrowed (Narrowed), its shape tested where a match takes it apart; and a match that
# names the shape fits every value of it (core/analyze/matching.wap missing).

use "types.wap"
use "calls.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../errors.wap"
use "../../kernel/forms.wap"
use "matching.wap"
use "scope.wap"
use "library.wap"

# a hole in a declared pattern's taken shape is its builder's parameter after this sign (core/rules/patterns.wap)
HOLE_MARK = "$"
# the raise where a value is not of the shape a place wants
OTHER_SHAPE = "this value is of another shape than the"

# the type a shape narrows, ø for any other type
narrowed_type(type: Node?) as Node? := if type == ø then ø else fact_of(type, NARROWS)
# the type a shape narrows, refused for any other type
shape_narrows(type: Node) as Node := narrowed_type(type) ?? refused(type, "a shape narrows a type")
# A written type with its shape known: a declared pattern's name narrows Node, the name of a case with fields of one
# enum that enum (`Define` is a pattern, though Op has a case of that name; a case without fields is a value, no type,
# so LexemeKind's Key leaves `Key` Node's); a record's own name, or any other type, is as written
shaped(type: Node, s: TypingState) as Node := {
	if not type is symbol or record_named(s.records, type) != ø or fact_of(type, NARROWS) != ø { return type }
	if form_named(type, s) != ø { return with_fact(type, NARROWS, symbol(NODE_TYPE)) }
	holders = s.records.items.filter(record => cases_of(record).any(case => text(case_name(case)) == text(type) and case_fields(case) is not empty))
	if #holders == 1 then with_fact(type, NARROWS, record_type(holders#1)) else type
}
# definitions with the shapes their written types name, each shaped once
shaped_once(definition: Function, s: TypingState) as Function := {
	if definition.shaped { return definition }
	known = function_of(shaped_definition(reached_bound(definition.definer, s.library_scope), s))
	known.shaped = yes
	known
}
# a definition with the shapes its parameters' and its result's written types name
shaped_definition(definition: Node, s: TypingState) as Node := match definition {
	Define(name, parameters, body) => refitted(Define(shaped_key(name, s), with_items(parameters, items_of(parameters).map(parameter => shaped_key(parameter, s))), body), definition)
	_ => definition
}
shaped_key(n: Node, s: TypingState) as Node := match n {
	Key(name, Op.Colon, type) => refitted(Key(name, Op.Colon, shaped(type, s)), n)
	_ => n
}

# The builder of a declared pattern of this name, which its taken shape and holes mark (core/rules/patterns.wap
# pattern_builder); ø for any other name
form_named(type: Node, s: TypingState) as Function? := {
	definitions_named(text(type), s).find(definition => fact_of(declared_name(written_name(definition.definer)), PATTERN_TAKEN) != ø)
}
# the shape a declared pattern takes values apart by, its holes `$name`
form_taken(form: Function) as Node := fact_of(declared_name(written_name(form.definer)), PATTERN_TAKEN) ?? refused(form.definer, "a pattern's builder carries its shape")
# the types of a declared pattern's holes, in order, their shapes known: its builder's parameters' types
hole_types(form: Function, s: TypingState) as list := form.parameters.map(type => shaped(type ?? symbol(NODE_TYPE), s))
# The patterns an arm's pattern has at the holes of a form's shape, in order; ø when it is not of that shape
form_parts(taken: Node, pattern: Node) as list<Node>? := {
	if taken is symbol and text(taken).starts_with(HOLE_MARK) { return [pattern] }
	match taken {
		Get(subject, key) => if literal_text(taken) == literal_text(pattern) then [] else ø
		Call(called, arguments) => match pattern { Call(given, parts) => if text(given) == text(called) then zipped_parts(arguments, parts) else ø; _ => ø }
		List(items, bracket, separator) => match pattern { List(parts, given_bracket, given_separator) => zipped_parts(items, parts); _ => ø }
		_ => if literal_text(taken) == literal_text(pattern) then [] else ø
	}
}
# a literal part of a shape as an arm writes it: a case read from its enum, `Bracket.Round` (the taken shape's
# spelling), is the case, `Round` (the arm's, bound)
literal_text(n: Node) as text := match n { Get(subject, key) => text(key); _ => text(n) }
zipped_parts(shapes: list<Node>, patterns: list<Node>) as list<Node>? := {
	if #shapes != #patterns { return ø }
	parts: list<Node> = []
	for at in 1 to #shapes { parts = parts + (form_parts(shapes#at, patterns#at) ?? return ø) }
	parts
}

# A shape as a pattern fitting each of its values, the cases it names bound to their enums: a case's name with `_` for
# each field, `List(_, _, _)`; a declared pattern's taken shape with `_` at its holes
shape_pattern(type: Node, s: TypingState) as Node := {
	form = form_named(type, s)
	enum = shape_narrows(type)
	if form != ø { return with_fact(bound_shape(form_taken(form), enum, s), SHAPE_OF, type) }
	Call(case_bound(type, enum, s), wildcards(#case_fields(case_declaring(s.records, case_bound(type, enum, s)))))
}
bound_shape(taken: Node, enum: Node, s: TypingState) as Node := {
	if taken is symbol and text(taken).starts_with(HOLE_MARK) { return symbol(WILDCARD) }
	match taken {
		Get(subject, key) => case_bound(symbol(text(key)), subject, s)
		# a rest hole, `...$arguments`, takes any rest
		Call(called, arguments) => if rest_named(taken) != ø then Call(called, [symbol(WILDCARD)]) else Call(case_bound(called, enum, s), arguments.map(argument => bound_shape(argument, enum, s)))
		List(items, bracket, separator) => List(items.map(item => bound_shape(item, enum, s)), bracket, separator)
		_ => taken
	}
}
case_bound(name: Node, enum: Node, s: TypingState) as Node := with_binding(in_enum(name, enum, s), DefinitionKind.Case)
# A kind word after `is` on a value of an enum, `n is symbol` on a Node: the enum's case of that name in lower case,
# as a shape (wiki/Footguns.md "Tiny surprises"); ø where the value is of no enum or no case is named so
kind_named(word: Node, type: Node?, s: TypingState) as Node? := {
	enum = record_named(s.records, base_or_self(type)) ?? return ø
	named = cases_of(enum).filter(case => lower(text(case_name(case))) == text(word))
	if named is empty then ø else with_fact(symbol(text(case_name(named#1))), NARROWS, record_type(enum))
}
# whether a value is of a shape, as code: `match x { List(_, _, _) => yes; _ => no }`
shape_test(read: Node, type: Node, at: Node, s: TypingState) as Node := with_fact(placed_like(Case(read, [Arm(shape_pattern(type, s), True), Arm(symbol(WILDCARD), False)]), at), TESTED, type)
# the raise where a value is not of the shape wanted, naming the place that wanted it
other_shape(type: Node, at: Node) as text := "${OTHER_SHAPE} ${type} wanted at ${file_of(at)}:${line_of(at)}:${column_of(at)}"
