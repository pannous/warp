# Shapes as types (wiki/pattern-matching.md "Named patterns as types"): a case of an enum, `List` of Node, or a declared
# pattern, `Record` (wap/kernel/forms.wap), names the values of a type that have its shape. Written as a type, its
# symbol carries the type it narrows as a fact, so every stage reads it without a lookup: a value of the shape is a
# value of that type (core/analyze/fits.wap conversion, Same), the emitter lays it out as one; a value of that type
# where the shape is wanted is narrowed (Narrowed), its shape tested where a match takes it apart; and a match that
# names the shape fits every value of it (core/analyze/matching.wap missing).

use "types.wap"
use "calls.wap"
use "../stage.wap"
use "../errors.wap"
use "../../kernel/forms.wap"

# a hole in a declared pattern's taken shape is its builder's parameter after this sign (core/rules/patterns.wap)
HOLE_MARK = "$"
# a definition whose written types have their shapes known
SHAPED = "shaped"

# the type a shape narrows, ø for any other type
narrowed_type(type: Node?) as Node? := if type == ø then ø else fact_of(type, NARROWS)
# A written type with its shape known: a declared pattern's name narrows Node, the name of a case of one enum that
# enum (`Define` is a pattern, though Op has a case of that name); a record's own name, or any other type, is as
# written
shaped(type: Node?, s: TypingState) as Node? := {
	if type == ø or not type is symbol or record_named(s.records, type) != ø or fact_of(type, NARROWS) != ø { return type }
	if form_named(type, s) != ø { return with_fact(type, NARROWS, symbol(NODE_TYPE)) }
	holders = s.records.filter(record => cases_of(record).any(case => text(case_name(case)) == text(type)))
	if #holders == 1 then with_fact(type, NARROWS, symbol(record_name(holders#1))) else type
}
# definitions with the shapes their written types name, each shaped once
shaped_definitions(definitions: list, s: TypingState) as list := definitions.map(definition => if fact_of(definition, SHAPED) != ø then definition else with_fact(shaped_definition(definition, s), SHAPED, True))
# a definition with the shapes its parameters' and its result's written types name
shaped_definition(definition: Node, s: TypingState) as Node := match definition {
	Define(name, parameters, body) => refitted(Define(shaped_key(name, s), with_items(parameters, items_of(parameters).map(parameter => shaped_key(parameter, s))), body), definition)
	_ => definition
}
shaped_key(n: Node, s: TypingState) as Node := match n {
	Key(name, Op.Colon, type) => refitted(Key(name, Op.Colon, shaped(type, s)), n)
	_ => n
}

# The builder of a declared pattern of this name, which its taken shape and holes mark (core/rules/patterns.wap
# pattern_builder); ø for any other name
form_named(type: Node, s: TypingState) as Node? := {
	builders = definitions_named(text(type), s).filter(definition => fact_of(declared_name(written_name(definition)), PATTERN_TAKEN) != ø)
	if builders is empty then ø else builders#1
}
# the shape a declared pattern takes values apart by, its holes `$name`
form_taken(form: Node) as Node := fact_of(declared_name(written_name(form)), PATTERN_TAKEN) ?? refused(form, "a pattern's builder carries its shape")
# the types of a declared pattern's holes, in order, their shapes known: its builder's parameters' types
hole_types(form: Node, s: TypingState) as list := parameters_in(form).map(parameter => shaped(type_given(parameter) ?? symbol(NODE_TYPE), s))
# The patterns an arm's pattern has at the holes of a form's shape, in order; ø when it is not of that shape
form_parts(taken: Node, pattern: Node) as list? := {
	if taken is symbol and text(taken).starts_with(HOLE_MARK) { return [pattern] }
	match taken {
		Get(subject, key) => if literal_text(taken) == literal_text(pattern) then [] else ø
		Call(called, arguments) => match pattern { Call(given, parts) => if text(given) == text(called) then zipped_parts(arguments, parts) else ø; _ => ø }
		List(items, bracket, separator) => match pattern { List(parts, given_bracket, given_separator) => zipped_parts(items, parts); _ => ø }
		_ => if literal_text(taken) == literal_text(pattern) then [] else ø
	}
}
# a literal part of a shape as an arm writes it: a case read from its enum, `Bracket.Round` (the taken shape's
# spelling), is the case, `Round` (the arm's, bound)
literal_text(n: Node) as text := match n { Get(subject, key) => text(key); _ => text(n) }
zipped_parts(shapes: list, patterns: list) as list? := {
	if #shapes != #patterns { return ø }
	parts = []
	for at in 1 to #shapes { parts = parts + (form_parts(shapes#at, patterns#at) ?? return ø) }
	parts
}
