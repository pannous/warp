# The typing of matches (wiki/pattern-matching.md), called from the typing stage's dispatch (core/analyze/types.wap
# typed_form): each arm's pattern of the subject's type, the names it binds, and whether the arms fit every value.

use "types.wap"
use "calls.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "fits.wap"
use "shapes.wap"

# A choice by patterns: each arm's pattern of the subject's type, a name holding the subject; each result expected the
# Case's type. When the arms fit every value of the subject's type, the Case has the results' joined type; a match on
# an enum that misses a case is refused naming it (wiki/pattern-matching.md "Every case"), any other only where its
# value is wanted.
case_typed(n: Node, subject: Node, arms: list, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	type = value_type(subject) ?? refused(subject, "this gives no value to match")
	typed = arms.map(arm => arm_typed(arm, type, s, f, expected))
	results = typed.map(arm => value_type(arm))
	witness = missing(arms.map(arm => [pattern_of(arm)]), [type], s)
	is_enum = record_named(s.records, type) != ø and not cases_of(record_named(s.records, type)) is empty
	if witness != ø and (is_enum or expected != ø) { refused(n, "match on ${type} misses ${pattern_text(witness#1)}: add the missing arm or `_`") }
	given = if witness == ø then results.fold(symbol(NEVER_TYPE), (a, b) -> joined_settling(a, b, s)) else ø
	with_type_of(refitted(Case(subject, typed), n), given)
}
arm_typed(arm: Node, type: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := match arm {
	Arm(pattern, result) => {
		tested = pattern_typed(pattern, type, s, f)
		given = typed_form(result, s, f, expected)
		with_type_of(refitted(Arm(tested, given), arm), value_type(given))
	}
}
# A pattern of a value of this type: a name holding the value, `_`, a case, `Dot`, a case with the patterns of its
# fields, `Circle(r)`, `Two(Dot, 3)`, or a value it equals
pattern_typed(pattern: Node, type: Node, s: TypingState, f: TypeFrame) as Node := {
	if fits_any(pattern) {
		if pattern != symbol(WILDCARD) { remembered(pattern, type, s, f) }
		return pattern
	}
	if narrowed_type(type) != ø { return shape_pattern_typed(pattern, type, s, f) }
	if list_pattern_items(pattern) != ø { return list_pattern_typed(pattern, type, s, f) }
	# a case of an optional's value: `Text(name)` fits a Node? holding a text node, never ø
	if base_of_optional(type) != ø and (pattern is Call or is_case_name(pattern)) { return pattern_typed(pattern, base_of_optional(type), s, f) }
	tested = if pattern is Call then case_pattern_typed(pattern, type, s, f) else if is_case_name(pattern) then case_in_enum_typed(in_enum(pattern, type, s), s) else typed_form(pattern, s, f, type)
	if not same_type(value_type(tested) ?? type, type) { refused(pattern, "this pattern can never fit a value of type ${type}") }
	tested
}
# A pattern of a shape's value, `Record(name, fields, variants)` of a Record, as one of the type the shape narrows; a
# declared pattern's holes named in it hold their holes' types, `fields` a List
shape_pattern_typed(pattern: Node, type: Node, s: TypingState, f: TypeFrame) as Node := {
	form = form_named(type, s)
	if form != ø {
		parts = form_parts(form_taken(form), pattern) ?? []
		holes = hole_types(form, s)
		# known before the pattern binds them as the narrowed type's parts: a variable's first type is its type
		for at in 1 to #parts { if fits_any(parts#at) and parts#at != symbol(WILDCARD) { remembered(parts#at, holes#at, s, f) } }
	}
	with_type_of(pattern_typed(pattern, narrowed_type(type), s, f), type)
}
# A list pattern of a list's type: each item's pattern of its item type, a last `...name` holding the items after them
list_pattern_typed(pattern: Node, type: Node, s: TypingState, f: TypeFrame) as Node := {
	items = list_pattern_items(pattern)
	item = item_type(type) ?? refused(pattern, "a list pattern fits a list, not a ${type}")
	typed = (1 to #items).map(at => if rest_named(items#at) == ø then pattern_typed(items#at, item, s, f) else rest_typed(items#at, at == #items, type, s, f))
	with_type_of(refitted(List(typed, Bracket.Square, Separator.Comma), pattern), type)
}
rest_typed(rest: Node, last: bool, type: Node, s: TypingState, f: TypeFrame) as Node := match rest {
	Call(called, names) => if last then refitted(Call(called, [pattern_typed(names#1, type, s, f)]), rest) else refused(rest, "only a list pattern's last item takes the rest")
}
# The values no arm fits, as one pattern of them, a witness (`Dot`, `Two(Circle(_), _)`), or ø when the arms fit every
# value: the classic usefulness check over rows of patterns, one for each of these types, the witness built on the way
# back. Where a column holds a case, its enum's values are split by case, each case's fields joining the patterns; any
# other column keeps only the rows whose pattern there fits any value.
missing(rows: list, types: list, s: TypingState) as list? := {
	if types is empty { return if rows is empty then [] else ø }
	if narrowed_type(types#1) != ø { return shape_missing(rows, types, s) }
	if item_type(types#1) != ø and rows.any(row => list_pattern_items(row#1) != ø) { return list_missing(rows, types, s) }
	record = record_named(s.records, types#1)
	if record == ø or cases_of(record) is empty or rows.all(row => fits_any(row#1)) {
		rest = missing(rows.filter(row => fits_any(row#1)).map(row => row[1 ..]), types[1 ..], s)
		return if rest == ø then ø else [symbol(WILDCARD)] + rest
	}
	cases_missing(rows, types, cases_of(record), s)
}
# the values of these cases no row fits, split by case, each case's fields joining the patterns
cases_missing(rows: list, types: list, cases: list, s: TypingState) as list? := {
	for case in cases {
		fields = case_fields(case)
		inner = missing(rows.filter(row => fits_any(row#1) or text(case_name(row#1)) == text(case_name(case))).map(row => opened(row, #fields)), fields.map(declared_type) + types[1 ..], s)
		if inner != ø { return [if fields is empty then case_name(case) else Call(case_name(case), inner[.. #fields])] + inner[#fields ..] }
	}
	ø
}
# The values of a shape no row fits: a case's, as its one case; a declared pattern's, by the patterns at its holes, of
# its holes' types (a row of another shape is left out)
shape_missing(rows: list, types: list, s: TypingState) as list? := {
	form = form_named(types#1, s)
	if form == ø { return cases_missing(rows, types, cases_of(record_named(s.records, narrowed_type(types#1))).filter(case => text(case_name(case)) == text(types#1)), s) }
	holes = hole_types(form, s)
	taken = form_taken(form)
	kept = rows.filter(row => fits_any(row#1) or form_parts(taken, row#1) != ø)
	inner = missing(kept.map(row => (if fits_any(row#1) then wildcards(#holes) else form_parts(taken, row#1) ?? []) + row[1 ..]), holes + types[1 ..], s)
	if inner == ø then ø else [Call(symbol(text(types#1)), inner[.. #holes])] + inner[#holes ..]
}
# a row with its first pattern opened into patterns of the case's fields: a name, `_` or a bare case fits each
opened(row: list, count: int) as list := (if row#1 is symbol then wildcards(count) else pattern_parts(row#1)) + row[1 ..]
wildcards(count: int) as list := copies(symbol(WILDCARD), count)
copies(x: Node, count: int) as list := if count == 0 then [] else (1 to count).map(at => x)
# Where a column holds list patterns, its lists are split by count, each count up to the longest pattern's and then the
# longer lists, their items joining the patterns
list_missing(rows: list, types: list, s: TypingState) as list? := {
	longest = rows.map(row => fixed_count(row#1)).fold(0, (a, b) -> if a > b then a else b)
	for count in 0 to longest + 1 {
		longer = count > longest
		inner = missing(rows.filter(row => fits_count(row#1, count, longer)).map(row => items_opened(row, count)), copies(item_type(types#1), count) + types[1 ..], s)
		if inner != ø { return [List(inner[.. count] + (if longer then [Call(symbol(REST_WORD), [symbol(WILDCARD)])] else []), Bracket.Square, Separator.Comma)] + inner[count ..] }
	}
	ø
}
# how many items a list pattern names by place, besides its rest
fixed_count(pattern: Node) as int := #(list_pattern_items(pattern) ?? []).filter(item => rest_named(item) == ø)
# whether a pattern fits lists of a count, or longer ones: any name, a list pattern of that many items, or of no more
# and a rest
fits_count(pattern: Node, count: int, longer: bool) as bool := {
	if fits_any(pattern) { return yes }
	items = list_pattern_items(pattern) ?? return no
	if fixed_count(pattern) < #items then fixed_count(pattern) <= count else not longer and fixed_count(pattern) == count
}
# a row with its first pattern opened into the patterns of a count of items: a list pattern's own, `_` for the others
items_opened(row: list, count: int) as list := (if fits_any(row#1) then wildcards(count) else (list_pattern_items(row#1) ?? []).filter(item => rest_named(item) == ø) + wildcards(count - fixed_count(row#1))) + row[1 ..]
# the patterns of a case pattern's fields, `r` and `0` of `Circle(r, 0)`
pattern_parts(pattern: Node) as list := match pattern { Call(called, parts) => parts; _ => [] }
# a pattern as the program writes it: `Two(Circle(_), _)`, `[_, ..._]`
pattern_text(pattern: Node) as text := match pattern {
	List(items, Bracket.Square, separator) => "[${items.map(pattern_text).join(", ")}]"
	Call(called, parts) => if rest_named(pattern) != ø then REST_WORD + pattern_text(parts#1) else "${called}(${parts.map(pattern_text).join(", ")})"
	_ => text(pattern)
}
# a pattern that fits every value: a name that is no case, or _
fits_any(pattern: Node) as bool := pattern is symbol and fact_of(pattern, BINDING) != symbol(BOUND_CASE)
# a case's bare name: as a pattern it fits the case whatever its fields hold
is_case_name(pattern: Node) as bool := pattern is symbol and fact_of(pattern, BINDING) == symbol(BOUND_CASE)
pattern_of(arm: Node) as Node := match arm { Arm(pattern, result) => pattern }

# a case pattern's name, the case of that name in the subject's enum when it has one (two enums may share the name)
in_enum(name: Node, type: Node, s: TypingState) as Node := {
	record = record_named(s.records, type)
	if record == ø { return name }
	for case in cases_of(record) { if text(case_name(case)) == text(name) { return with_fact(name, DEFINED_AT, case_name(case)) } }
	name
}
case_in_enum_typed(name: Node, s: TypingState) as Node := case_typed_as(name, name, [], s)
field_names(fields: list) as text := fields.map(field => text(declared_name(field))).join(", ")
# A case pattern, `Circle(r)`: a pattern for each of its fields, of the field's type
case_pattern_typed(pattern: Node, type: Node, s: TypingState, f: TypeFrame) as Node := match pattern { Call(written, parts) => {
	called = in_enum(written, type, s)
	fields = case_fields(case_declaring(s.records, called))
	if #parts != #fields { refused(pattern, "${called} names each of its fields: ${field_names(fields)}") }
	case_typed_as(pattern, called, (1 to #parts).map(at => pattern_typed(parts#at, declared_type(fields#at), s, f)), s)
} }
