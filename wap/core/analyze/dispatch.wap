# Calls on dynamic values (notes/first_principles.md "dynamic where we can't infer the type"): code the typing stage
# writes once, as ordinary code, a dispatching function, where a value is an any (or a number, an int or a float).
# - A call whose arguments hold such a value, where a definition of its word wants another type there (from the static
#   choice, core/analyze/calls.wap chosen_definition): a chain of `is` tests over the definitions in the one ranking
#   the static choice uses, most specific first, each passing the tested values on as their types (core/analyze/
#   conditions.wap found); then the definition that takes the values as they are, else a raise naming the word.
# - A field read on an any, `xs#1.name` (calls.wap part_typed): a chain of `is` tests over the records that have the
#   field, in the order they are declared, each reading its field, else a raise.

use "types.wap"
use "calls.wap"
use "fits.wap"
use "letters.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "shapes.wap"
use "matching.wap"

# the name of a dispatching function's parameters, numbered: x1, x2 …
PARAMETER_WORD = "x"
RAISE_WORD = "raise"
# a field read's dispatching function is named after the field, `.name(any)`, apart from a function of that name
FIELD_MARK = "."
# the function that narrows a value to a shape is named after it, `narrowed(Record)`
NARROWING_WORD = "narrowed"

# The dispatching function a call of these definitions with arguments of these types means; ø when no argument is an
# any or a number that some definition wants of a type it may hold
dispatching(called: Node, candidates: list<Function>, types: list, s: TypingState) as Function? := {
	counted = candidates.filter(definition => takes_count(definition, #types))
	if not counted.any(definition => tested_places(definition, types, s) != []) { return ø }
	name = name_for("${called}(${types_text(types)})", declared_name(written_name(counted#1.definer)))
	known = definition_keyed(place_key(name), s)
	if known != ø { return known }
	reads = parameters_of(name, types)
	order = ranked(counted, s.records)
	# the definitions that take the arguments once their tests pass
	taking = order.filter(definition => takes(definition, tested_reads(definition, reads, types, s), s, (argument, wanted) -> fits(argument, wanted, s)))
	untested = taking.filter(definition => tested_places(definition, types, s) == [])
	last = if untested is empty then raised("${called}: no definition takes these values' types", name, s) else named_call(text(called), untested, reads, name)
	tried = taking.filter(definition => tested_places(definition, types, s) != []).map(definition => Choice(tests_of(definition, reads, types, s, name), named_call(definition.name, [definition], reads, name)))
	dispatcher_made(name, reads, chained(tried, last, name), order.map(definition => definition.result), s)
}
# The dispatching function a read of this field on an any means, `.name(any)`; ø when no record has the field
field_dispatching(key: Node, s: TypingState) as Function? := {
	holders = s.records.items.filter(record => cases_of(record) is empty and field_named(record, key) != ø)
	if holders is empty { return ø }
	held = held_field(holders#1, key)
	name = name_for("${FIELD_MARK}${key}(${ANY_TYPE})", declared_name(held))
	known = definition_keyed(place_key(name), s)
	if known != ø { return known }
	read = parameters_of(name, [symbol(ANY_TYPE)])#1
	tried = holders.map(record => Choice([test_of(read, record_type(record), name, s)], placed_like(Get(read, key), name)))
	dispatcher_made(name, [read], chained(tried, raised("${key}: no record of this value's type has this field", name, s), name), holders.map(record => declared_type(held_field(record, key))), s)
}
held_field(record: Node, key: Node) as Node := field_named(record, key) ?? refused(key, "the record holding this field has none")

# a dispatching function's parameters, x1 …, one of each type, as its body reads them
parameters_of(name: Node, types: list) as list := (1 to #types).map(at => {
	parameter = name_for(PARAMETER_WORD + text(at), name)
	with_type_of(with_fact(with_binding(parameter, DefinitionKind.Parameter), DEFINED_AT, parameter), types#at)
})
# The dispatching function, kept with the typing stage's definitions and placed with the program's functions; its
# result written when every choice writes its own, so a choice calling back through the dispatch finds it
dispatcher_made(name: Node, reads: list, body: Node, results: list<Node?>, s: TypingState) as Function := {
	# joined_type is ø where either is: a choice without a written result writes none
	result = results.drop(1).fold(results#1, (a, b) -> joined_type(a, b, s))
	written = if result == ø then name else Key(name, Op.Colon, result)
	dispatcher = placed_like(Define(written, List(reads.map(read => Key(read, Op.Colon, value_of(read, "for a dispatcher's parameter"))), Bracket.Round, Separator.Comma), body), name)
	s.dispatchers += [dispatcher]
	function_added(dispatcher, s)
}
# a dispatch's choice: its tests, and the code that runs once they all pass
class Choice { tests: list<Node>; code: Node }
# the choices tried in order: the first whose tests all pass runs, else the last
chained(choices: list<Choice>, last: Node, at: Node) as Node := {
	chain = last
	for place in 0 upto #choices {
		choice = choices#(#choices - place)
		condition = choice.tests.drop(1).fold(choice.tests#1, (both, test) -> placed_like(If(both, test, False), at))
		chain = placed_like(If(condition, choice.code, chain), at)
	}
	chain
}
# the places where a definition wants a type the any or number its argument gives may box, or a shape of its
# argument's type: an `is` test there chooses it
# a parameter's type a test chooses by: written, no any, no generic letter, none that takes its argument's own type
dispatchable(type: Node?, records: Records) as bool := once_typed(type, records) and type != symbol(ANY_TYPE)
tested_places(definition: Function, types: list, s: TypingState) as list := (1 to #types).filter(at => {
	wanted = definition.parameters#at
	wanted != ø and dispatchable(wanted, s.records) and tested_fit(wanted, types#at, s)
})
tested_fit(wanted: Node, given: Node, s: TypingState) as bool := boxed_fit(wanted, given) or conversion(given, wanted, s) == Conversion.Narrowed
# the arguments as a definition's call reads them once its tests pass: each tested one of its parameter's type
tested_reads(definition: Function, reads: list, types: list, s: TypingState) as list := {
	places = tested_places(definition, types, s)
	(1 to #reads).map(at => if at in places then with_type_of(reads#at, definition.parameters#at) else reads#at)
}
tests_of(definition: Function, reads: list, types: list, s: TypingState, at: Node) as list<Node> := tested_places(definition, types, s).map(place => test_of(reads#place, definition.parameters#place ?? refused(at, "a tested parameter has its type"), at, s))
# whether an any's value is of the type, `x is int`, or a value of a shape (core/analyze/shapes.wap)
test_of(read: Node, type: Node, at: Node, s: TypingState) as Node := if narrowed_type(type) != ø then shape_test(read, type, at, s) else with_fact(with_type_of(placed_like(Prim(symbol(BOXED_TEST), [read]), at), symbol(BOOL_TYPE)), TESTED, type)
# a call of one of these definitions, chosen among them as any call is
named_call(word: text, definitions: list<Function>, arguments: list, at: Node) as Node := {
	called = with_fact(with_binding(placed_like(symbol(word), at), DefinitionKind.Function), CANDIDATES, List([List(definitions.map(definition => declared_name(written_name(definition.definer))), Bracket.Square, Separator.Comma)], Bracket.Square, Separator.Comma))
	placed_like(Call(called, arguments), at)
}
raised(message: text, at: Node, s: TypingState) as Node := raising(Text(message), at, s)
raising(message: Node, at: Node, s: TypingState) as Node := named_call(RAISE_WORD, definitions_named(RAISE_WORD, s), [message], at)

# A value where a shape of its type is wanted, `Record` where a Node is given (core/analyze/shapes.wap), as a call of
# the function the typing stage writes once for the shape: the value when it is of the shape, else a raise naming the
# place that wanted it
narrowed_call(n: Node, wanted: Node, at: Node, s: TypingState) as Node := {
	name = name_once("${NARROWING_WORD}(${wanted})", wanted, s)
	# one for each shape, wherever it is wanted
	if definitions_named(text(name), s) is empty {
		reads = parameters_of(name, [narrowed_type(wanted) ?? symbol(NODE_TYPE), symbol(TEXT_TYPE)])
		body = placed_like(Case(reads#1, [Arm(shape_pattern(wanted, s), with_type_of(reads#1, wanted)), Arm(symbol(WILDCARD), raising(reads#2, name, s))]), name)
		dispatcher_made(name, reads, body, [wanted], s)
	}
	word_called(n, text(name), [n, with_type(placed_like(Text(other_shape(wanted, at)), at), TEXT_TYPE)], wanted, s)
}
