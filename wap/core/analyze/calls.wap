# Calls in the typing stage (core/analyze/types.wap): which definition a call means, among a name's overloads, by the
# number and types of its arguments and the type expected; and a function typed once for each tuple of argument
# types it is called with, a Define of its own.

use "types.wap"
use "function_values.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "data.wap"
use "letters.wap"
use "fits.wap"
use "conditions.wap"
use "scope.wap"
use "dispatch.wap"

# the word an item taken by its place calls on a value that is no list, `r#2` is `#(r, 2)`
PLACE_WORD = "#"
# the word that shows a value in warp notation, the program's last value by it (core/analyze/types.wap typed_shown)
SHOW_WORD = "show"
PRINT_WORD = "print"
# the word of an optional value known present, `x!` (named required): its value, raising when it is missing
REQUIRED_WORD = "!"

# A call: its arguments typed, each expecting its parameter's written type when only one definition takes that many
# arguments; then the function it means, typed for these argument types
call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	if fact_of(called, BINDING) == symbol(BOUND_CASE) { return case_call_typed(n, called, arguments, s, f) }
	if called is symbol and text(called) == TYPE_TEST_WORD and fact_of(called, BINDING) == ø { return type_test_typed(n, arguments, s, f) }
	if rest_named(n) != ø { refused(n, "a list's items spread, `...xs`, stand only in a list, `[...xs, 4]`") }
	if holds_value(called) { return value_call_typed(n, called, arguments, s, f, expected) }
	scopes = candidate_scopes(called).map(scope => scope.map(definer => definition_at(definer, s)))
	candidates = scopes.flat_map(scope => scope)
	if arguments.any(is_named) { arguments = arranged_arguments(n, called, arguments, candidates) }
	by_count = candidates.filter(definition => takes_count(definition, #arguments))
	hints = if #by_count == 1 then parameters_in(by_count#1).map(parameter => if has_letters(type_given(parameter), s.records) then ø else type_given(parameter)) else arguments.map(argument => ø)
	given = (1 to #arguments).map(at => typed_form(arguments#at, s, f, hints#at))
	meant = chosen_definition(n, called, scopes, given, expected, s)
	taken = texts_read(meant, given, s) + defaults_given(meant, #given, s, f)
	chosen = function_typed(meant, taken.map(argument => value_type(argument)), s, n)
	if fact_of(n, PREDICATE) != ø and chosen.result != symbol(BOOL_TYPE) { refused(n, "is: ${called}(x) gives ${type_text(chosen.result)}; a test after `is` gives yes or no") }
	with_type_of(refitted(Call(with_fact(called, DEFINED_AT, declared_name(chosen.signed)), taken), n), chosen.result)
}
# A call's arguments with the named ones, `f(b: 1, a: 5)`, put in their parameters' places, a left-out parameter
# given its default: the same places for every definition the name may mean, else refused
arranged_arguments(n: Node, called: Node, arguments: list, candidates: list) as list := {
	arrangements = candidates.map(definition => arranged(definition, arguments)).filter(each => each != ø)
	if arrangements is empty { refused(n, "no ${called} has parameters of these names: ${candidates_text(candidates)}") }
	if arrangements.any(each => each != arrangements#1) { refused(n, "the names put the arguments in different places for ${candidates_text(candidates)}; give them in order") }
	arrangements#1
}
# the arguments in a definition's parameter order, ø when a name is none of its parameters or a parameter gets none
arranged(definition: Node, arguments: list) as list? := {
	parameters = parameters_in(definition)
	positional = arguments.filter(argument => not is_named(argument))
	named = arguments.filter(is_named)
	if #positional > #parameters or not named.all(argument => parameters.drop(#positional).any(parameter => text(declared_name(parameter)) == text(declared_name(argument)))) { return ø }
	placed = positional
	for parameter in parameters.drop(#positional) {
		given = named.filter(argument => text(declared_name(argument)) == text(declared_name(parameter)))
		placed = placed + [if given then named_value(given#1) else fact_of(parameter, DEFAULT) ?? return ø]
	}
	placed
}
named_value(argument: Node) as Node := match argument { Key(name, Op.Colon, value) => value }
# whether a definition takes this many arguments: one for each parameter, those with defaults at the end left out or not
takes_count(definition: Node, count: int) as bool := {
	parameters = parameters_in(definition)
	count <= #parameters and parameters.drop(count).all(parameter => fact_of(parameter, DEFAULT) != ø)
}
# the defaults of the parameters a call leaves out, after the given ones, each typed as its parameter's type wants
defaults_given(definition: Node, count: int, s: TypingState, f: TypeFrame) as list := {
	parameters_in(definition).drop(count).map(parameter => typed_form(fact_of(parameter, DEFAULT), s, f, type_given(parameter)))
}
# A value's part by a text key, `x.f`: a field of x's record type, else the function f that takes x alone, which the
# Get then calls; a map's value by its key (core/analyze/data.wap); on an any, the field of whichever record holds it
# (core/analyze/dispatch.wap)
part_typed(n: Node, subject: Node, key: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	typed = typed_form(subject, s, f, ø)
	if key_type(value_type(typed)) != ø { return entry_read_typed(n, typed, key) }
	reader = if value_type(typed) == symbol(ANY_TYPE) then field_dispatching(key, s) else ø
	if reader != ø { return typed_form(named_call(text(declared_name(written_name(reader))), [reader], [typed], n), s, f, expected) }
	record = record_named(s.records, value_type(typed))
	field = if record == ø then ø else field_named(record, key)
	if field != ø { return with_type_of(refitted(Get(typed, key), n), declared_type(field)) }
	named = definitions_named(text(key), s)
	if named is empty { refused(n, "no field or function ${key} for a value of type ${value_type(typed) ?? "none"}") }
	chosen = function_typed(chosen_definition(n, key, [named], [typed], expected, s), [value_type(typed)], s, n)
	with_type_of(calling(refitted(Get(typed, key), n), chosen), chosen.result)
}
# a character where a text is wanted, as its text: a written one is that text, any other the call text(c)
as_text(character: Node, s: TypingState) as Node := if character is Char then char_text(character) else word_called(character, TEXT_FUNCTION, [character], ø, s)
char_text(character: Node) as Node := with_type(refitted(Text(text(character)), character), TEXT_TYPE)
# a call's typed arguments, a char where its parameter wants a text (its letters bound by the call) read as its text
texts_read(definition: Node, given: list, s: TypingState) as list := {
	letters = letters_bound(definition, given.map(value_type), s) ?? []
	wanted = parameters_in(definition).map(parameter => substituted(type_given(parameter), letters))
	(1 to #given).map(at => if reads_as_text(given#at, wanted#at) then as_text(given#at, s) else given#at)
}
# the call of a word with these typed arguments, the definition chosen among all of the word's
word_called(n: Node, word: text, given: list, expected: Node?, s: TypingState) as Node := {
	meant = chosen_definition(n, symbol(word), [definitions_named(word, s)], given, expected, s)
	taken = texts_read(meant, given, s)
	chosen = function_typed(meant, taken.map(value_type), s, n)
	with_type_of(refitted(Call(calling(symbol(word), chosen), taken), n), chosen.result)
}
# the definitions of functions of this name the typing stage holds
definitions_named(name: text, s: TypingState) as list := s.definitions.filter(definition => text(declared_name(written_name(definition))) == name)
# a call's function, or a Get that calls one, marked with the function it calls
calling(called: Node, chosen: TypedFunction) as Node := with_fact(with_fact(called, BINDING, symbol(BOUND_FUNCTION)), DEFINED_AT, declared_name(chosen.signed))
# the definitions a called name may mean, one list per scope, innermost first: the one it was bound or typed to, else
# its candidates
candidate_scopes(called: Node) as list := if fact_of(called, DEFINED_AT) != ø then [[defined_at(called)]] else match fact_of(called, CANDIDATES) {
	List(scopes, bracket, separator) => scopes.map(scope => match scope { List(items, inner, between) => items })
	_ => [[defined_at(called)]]
}
# the definition a defining name means: its own, or, for the name of a function typed already (a call typed again),
# the definition that typed function came from, so typing a typed form again changes nothing
definition_at(definer: Node, s: TypingState) as Node := definition_keyed(place_key(definer), s) ?? definition_keyed(typed_from(place_key(definer), s), s) ?? refused(definer, "the typing stage found no definition here")
typed_from(key: text, s: TypingState) as text := {
	for typed in s.functions { if place_key(declared_name(typed.signed)) == key { return typed.key } }
	""
}
definition_keyed(key: text, s: TypingState) as Node? := {
	for definition in s.definitions { if function_key_of(definition) == key { return definition } }
	ø
}

# The one definition that takes these typed arguments, by their types, then by the type expected; none or several
# refused. A literal that reads both ways fits either: `"!"` a char or a text parameter.
chosen_definition(n: Node, called: Node, scopes: list, given: list, expected: Node?, s: TypingState) as Node := {
	candidates = scopes.flat_map(scope => scope)
	types = given.map(argument => value_type(argument) ?? refused(argument, "this gives no value to pass"))
	dispatcher = dispatching(called, candidates, types, s)
	if dispatcher != ø { return dispatcher }
	fitting = candidates.filter(definition => takes(definition, given, s, (argument, wanted) -> fits(argument, wanted, s)))
	exact = fitting.filter(definition => takes(definition, given, s, (argument, wanted) -> fits_exactly(argument, wanted, s)))
	if #fitting > 1 and exact { fitting = exact }
	if #fitting > 1 { fitting = most_specific(fitting, s.records) }
	if #fitting > 1 { fitting = innermost(fitting, scopes) }
	if #fitting > 1 and expected != ø { fitting = fitting.filter(definition => declared_type(written_name(definition)) != ø and same_type(declared_type(written_name(definition)), expected)) }
	if fitting is empty { refused(n, "no ${called} takes (${types_text(types)}): ${candidates_text(candidates)}${words_missing(candidates, types, s)}") }
	if #fitting > 1 { refused(n, "this reads as a call of each of ${candidates_text(fitting)}; write the arguments' types or the type wanted") }
	fitting#1
}
# whether a definition takes these arguments, each one fitting its parameter; a definition they fit exactly wins over
# one they fit only by a conversion (`text('é')` is text(c: char), not text(t: text))
# (a parameter typed by generic letters takes an argument whose type binds them alike, and one of a function type a
# function value whose function gives that type's result for its parameters, see letters_bound)
takes(definition: Node, given: list, s: TypingState, fit: function) as bool := {
	parameters = parameters_in(definition)
	if not takes_count(definition, #given) { return no }
	letters = letters_bound(definition, given.map(value_type), s)
	letters != ø and (1 to #given).all(at => function_type_parts(type_given(parameters#at)) != ø or conforms(value_type(given#at), type_given(parameters#at), s) or fit(with_letters(given#at, letters), substituted(type_given(parameters#at), letters)))
}
# an argument of the type its letters' binding gives it, `xs` of a list<α1> the call settles as a list<int>
with_letters(argument: Node, letters: list) as Node := {
	type = substituted(value_type(argument), letters)
	if type == value_type(argument) then argument else with_type_of(argument, type)
}
# Among several definitions that fit, the most specific: a written type beats a generic letter, a letter beats no
# type, `===(a: T, b: T)` beats `===(a, b)`; of those, more written structure beats less, `==(a: T?, b: T?)` beats
# `==(a: T, b: T)`; several equally specific are left for the caller to refuse
most_specific(definitions: list, records: list) as list := {
	order = ranked(definitions, records)
	order.filter(definition => typing_weight(definition, records) == typing_weight(order#1, records) and written_structure(definition) == written_structure(order#1))
}
# The one ranking of a word's definitions, most specific first, by typing weight, then by written structure: the
# static choice takes its first that fits, a dynamic call (core/analyze/dispatch.wap) tests them in this order
ranked(definitions: list, records: list) as list := definitions.sorted(by: definition => -written_structure(definition)).sorted(by: definition => -typing_weight(definition, records))
# how much structure a definition's parameter types write: each `?`, `list<…>`, `map<…>` or `(…) -> …` one more
written_structure(definition: Node) as int := parameters_in(definition).map(parameter => structure(type_given(parameter))).sum()
structure(type: Node?) as int := {
	parts = type_parts(type) ?? return 0
	1 + parts[1 ..].map(structure).sum()
}
# of equally specific definitions, those of the innermost scope: a program's `===(a: T, b: T)` hides the library's
innermost(definitions: list, scopes: list) as list := {
	for scope in scopes {
		inner = definitions.filter(definition => scope.any(candidate => function_key_of(candidate) == function_key_of(definition)))
		if inner { return inner }
	}
	definitions
}
typing_weight(definition: Node, records: list) as int := parameters_in(definition).map(parameter => if type_given(parameter) == ø then 0 else if has_letters(type_given(parameter), records) or protocol_named(records, type_given(parameter)) != ø then 1 else 2).fold(0, (a, b) -> a + b)

# Protocols (wiki/trait.md, decision traits-are-protocols): a type of words a value can do, `trait shape { area() }`,
# a Record of function-typed fields and no cases. A value fits one when for each word a function of that name takes
# the value's type first and the word's parameters after; a function of a protocol parameter is typed for each type
# given, so `area(s)` in its body is the given type's own area.
protocol_named(records: list, type: Node?) as Node? := {
	record = record_named(records, type)
	if record == ø or not cases_of(record) is empty or fields_of(record) is empty or not fields_of(record).all(field => function_type_parts(declared_type(field)) != ø) { return ø }
	record
}
# whether a value of the given type fits the protocol wanted: no protocol wanted, or every word of it done for the type
conforms(given: Node?, wanted: Node?, s: TypingState) as bool := {
	protocol = protocol_named(s.records, wanted)
	protocol != ø and given != ø and fields_of(protocol).all(word => does_word(given, word, s))
}
# the protocol words these types lack for these definitions' protocol parameters, as a refusal's fix-it
words_missing(definitions: list, types: list, s: TypingState) as text := {
	missing = []
	for definition in definitions {
		parameters = parameters_in(definition)
		if #parameters == #types {
			for at in 1 to #types {
				protocol = protocol_named(s.records, type_given(parameters#at))
				if protocol != ø { missing += fields_of(protocol).filter(word => not does_word(types#at, word, s)).map(word => "${types#at} is no ${record_name(protocol)}: define ${declared_name(word)}(x: ${types#at}${", …" * #(function_type_parts(declared_type(word))#1)})") }
			}
		}
	}
	if missing is empty then "" else "; " + missing.join("; ")
}
does_word(given: Node, word: Node, s: TypingState) as bool := definitions_named(text(declared_name(word)), s).any(definition => does_as(definition, given, #(function_type_parts(declared_type(word))#1)))
# whether a definition takes a value of this type first, then as many parameters as a protocol's word
does_as(definition: Node, given: Node, arity: int) as bool := {
	parameters = parameters_in(definition)
	#parameters == arity + 1 and (type_given(parameters#1) == ø or same_type(type_given(parameters#1), given))
}

# whether an argument fits a parameter, exactly or by a conversion: a char read as its text, a T or ø as a T?
fits(argument: Node, wanted: Node?, s: TypingState) as bool := wanted == ø or reads_as_text(argument, wanted) or conversion(value_type(argument), wanted, s) in STATIC_CONVERSIONS
fits_exactly(argument: Node, wanted: Node?, s: TypingState) as bool := wanted == ø or conversion(value_type(argument), wanted, s) == Conversion.Same
# the bare words of a kind, which every value of the kind fits (core/analyze/fits.wap bare_fit)
FUNCTION_WORD = "function"
ENUM_TYPE = "enum"
# a character where a text is wanted: a one-character text is a character (wiki/char.md, 'a' == "a")
reads_as_text(argument: Node, wanted: Node?) as bool := wanted != ø and reads_as(wanted, value_type(argument))
# types as a message names them, `int, text?`
types_text(types: list) as text := types.map(type_text).join(", ")
candidates_text(definitions: list) as text := definitions.map(definition => "${written_name(definition)}(${parameters_in(definition).join(", ")}), line ${line_of(definition)} of ${(file_of(definition) ?? "").split("/").last}").join("; ")

# A function typed for these argument types, once per tuple: its parameters, then its body, its result the written
# one, which the body's type fits, or else the body's type. A call inside its own body finds it typed but without a result unless one is written.
# what a function's body and returns give back, all of one type
result_given(body_type: Node?, frame: TypeFrame, name: Node, s: TypingState) as Node? := {
	# a written result is the result, which each returned value fits: `return x` of an int in a function giving int?
	result = frame.result ?? (if body_type == symbol(NEVER_TYPE) then (if frame.returns is empty then body_type else frame.returns#1) else body_type)
	for returned in frame.returns { if not (returned == result or conversion(returned, result, s) in STATIC_CONVERSIONS) { refused(name, "this function gives back values of different types") } }
	result
}
function_typed(definition: Node, argument_types: list, s: TypingState, at: Node) as TypedFunction := match definition { Define(name, parameters, body) => {
	key = place_key(declared_name(name))
	letters = letters_bound(definition, argument_types, s) ?? []
	settled_by(letters, s)
	types = (1 to #argument_types).map(place => parameter_type(type_given(parameters_in(definition)#place), substituted(argument_types#place, letters), letters, s.records))
	if (1 to #types).any(place => has_unknowns(types#place) and not takes_any_item(type_given(parameters_in(definition)#place))) { return deferred_typed(definition, types, letters, s, at) }
	for typed in s.functions {
		if typed.key == key and same_types(typed.arguments.map(type => substituted(type, s.settled)), types) {
			if not typed.done and typed.result == ø { refused(at, "a function that calls itself needs its result type: write `${declared_name(name)}(…): int := …`") }
			return typed
		}
	}
	typed = TypedFunction(key, types)
	typed.result = substituted(declared_type(name), letters)
	typed.signed = with_signature(name, types, typed.result)
	s.functions += [typed]
	frame = TypeFrame()
	frame.result = typed.result
	frame.letters = letters
	frame.function = declared_name(name)
	typed_parameters = (1 to #types).map(at => parameter_typed(parameters_in(definition)#at, types#at, frame))
	frame.variables += captured_by(definition, types)
	typed_body = typed_form(body, s, frame, typed.result)
	given = result_given(value_type(typed_body), frame, name, s)
	if typed.result != ø { typed_body = converted(typed_body, typed.result, s, body, "the function says it gives a") }
	typed.result = typed.result ?? given
	typed.signed = with_signature(name, types, typed.result)
	typed.define = refitted(Define(typed.signed, with_items(parameters, typed_parameters), typed_body), definition)
	typed.done = yes
	typed
} }
# A parameter is of its written type, its letters bound, whatever an argument gives: `f(x: int?)` takes 3 and ø as an
# int?; none written, or one that takes its argument's own type, it is of the argument's type
parameter_type(written: Node?, given: Node, letters: list, records: list) as Node := if written == ø or takes_own_type(written, records) then given else substituted(written, letters)
# whether a parameter of this written type is typed anew for each type given: a bare `list`, `enum` or `function`,
# which take any list, enum or function value, a function type, whose function values each type it, and a protocol
takes_own_type(written: Node, records: list) as bool := written == symbol(LIST_TYPE) or written == symbol(ENUM_TYPE) or written == symbol(FUNCTION_WORD) or function_type_parts(written) != ø or protocol_named(records, written) != ø
parameter_typed(parameter: Node, type: Node, frame: TypeFrame) as Node := {
	frame.variables += [[place_key(declared_name(parameter)), type]]
	with_name_fact(parameter, TYPE, type)
}
# a function's name with its signature, `(int, text) -> int`; `()` for no parameters or no value
with_signature(name: Node, types: list, result: Node?) as Node := with_name_fact(name, SIGNATURE, Call(symbol(ARROW), [List(types, Bracket.Round, Separator.Comma), result ?? Empty]))

# the parts of a Define, its parameters as a list of none or more
written_name(definition: Node) as Node := match definition { Define(name, parameters, body) => name }
parameters_in(definition: Node) as list := match definition { Define(name, parameters, body) => items_of(parameters) }
items_of(n: Node) as list := match n {
	List(items, bracket, separator) => items
	_ => []
}
with_items(n: Node, items: list) as Node := match n {
	List(old, bracket, separator) => refitted(List(items, bracket, separator), n)
	_ => n
}
# whether a definition's parameters all have their types, none a generic letter or a function type, whose function
# values each type it anew: typed even when nothing calls it
all_typed(definition: Node, records: list) as bool := parameters_in(definition).all(parameter => type_given(parameter) != ø and not has_letters(type_given(parameter), records) and not takes_own_type(type_given(parameter), records))
written_types(definition: Node) as list := parameters_in(definition).map(type_given)
# a parameter's type, written or given by an earlier typing: typing a typed program again changes nothing
type_given(parameter: Node) as Node? := declared_type(parameter) ?? fact_of(declared_name(parameter), TYPE)
