# Calls in the typing stage (core/analyze/types.wap): which definition a call means, among a name's overloads, by the
# number and types of its arguments and the type expected; and a function typed once for each tuple of argument
# types it is called with, a Define of its own.

use "types.wap"
use "function_values.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "data.wap"
use "letters.wap"
use "fits.wap"
use "conditions.wap"
use "scope.wap"
use "dispatch.wap"
use "shapes.wap"

# the word an item taken by its place calls on a value that is no list, `r#2` is `#(r, 2)`
PLACE_WORD = "#"
# the word of an optional value known present, `x!` (named required): its value, raising when it is missing
REQUIRED_WORD = "!"
# the fact of a call of a function whose result is not known yet, its body calling itself: what to write instead
RESULT_UNKNOWN = "result_unknown"

# A call: its arguments typed, each expecting its parameter's written type when only one definition takes that many
# arguments; then the function it means, typed for these argument types
call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	if is_bound(called, DefinitionKind.Case) { return case_call_typed(n, called, arguments, s, f) }
	if called is symbol and text(called) == TYPE_TEST_WORD and fact_of(called, BINDING) == ø { return type_test_typed(n, arguments, s, f) }
	if rest_named(n) != ø { refused(n, "a list's items spread, `...xs`, stand only in a list, `[...xs, 4]`") }
	if holds_value(called) { return value_call_typed(n, called, arguments, s, f, expected) }
	scopes = candidate_scopes(called).map(scope => scope.map(definer => definition_at(definer, s)))
	candidates = scopes.flat_map(scope => scope)
	placed = if arguments.any(is_named) then arranged_arguments(n, called, arguments, candidates) else arguments
	by_count = candidates.filter(definition => takes_count(definition, #placed))
	hints = if #by_count == 1 then by_count#1.parameters.map(type => if has_letters(type, s.records) then ø else type) else (1 to #placed).map(at => result_wanted(placed#at, at, by_count, s))
	given = (1 to #placed).map(at => typed_form(placed#at, s, f, hints#at))
	# an argument that never finishes ends the call there, the code after it never runs: `pick(a, return 7)` is
	# `{ a; return 7 }`
	jumped = (1 to #given).filter(at => jumps(given#at))
	if jumped { return jumping(refitted(Block(given.take(jumped#1)), n)) }
	known = candidates.map(definition => definition.key)
	scopes = scopes + [own_words(called, given, s).filter(definition => not known.contains(definition.key))]
	made = made_from_map(n, called, candidates, given, s)
	if made != ø { return typed_form(made, s, f, expected) }
	meant = chosen_definition(n, called, scopes, given, expected, s)
	taken = arguments_fitted(meant, given, s) + defaults_given(meant, #given, s, f)
	chosen = function_typed(meant, taken.map(argument => value_type(argument)), s, n)
	called_reads(chosen, n, s, f)
	result_of(refitted(Call(with_fact(called, DEFINED_AT, declared_name(signed_name(chosen))), taken), n), chosen)
}
# A word with several results gives the one that is wanted (wiki/conversion.md "declared type via as"): an argument
# whose definitions differ by their result, `int(hi())` beside hi() as int and hi() as text, is wanted as the parameter
# type of the outer definition that one of its results is; T(x) of an x that can be a T takes it as a T, int(n: int)
# before int(t: text); ø where no single type is left
result_wanted(argument: Node, at: int, outer: list<Function>, s: TypingState) as Node? := {
	results = results_written(argument, s)
	if #results < 2 { return ø }
	taking = outer.filter(definition => results.any(result => wants_at(definition, at, result)))
	giving = taking.filter(definition => wants_at(definition, at, definition.result))
	chosen = if #giving == 1 then giving else taking
	if #chosen == 1 then parameter_type_at(chosen#1, at) else ø
}
# whether a definition's parameter at a place is written as this type; no where either is missing
wants_at(definition: Function, at: int, type: Node?) as bool := {
	wanted = parameter_type_at(definition, at) ?? return no
	type != ø and same_type(type, wanted)
}
# the results a call's definitions write, of those taking as many arguments
results_written(argument: Node, s: TypingState) as list := match argument {
	Call(called, parts) => if fact_of(called, CANDIDATES) == ø and fact_of(called, DEFINED_AT) == ø or holds_value(called) then [] else candidate_scopes(called).flat_map(scope => scope).map(definer => definition_at(definer, s)).filter(definition => takes_count(definition, #parts)).map(definition => definition.result).compact()
	_ => []
}
parameter_type_at(definition: Function, at: int) as Node? := if #definition.parameters < at then ø else definition.parameters#at
# A call's arguments with the named ones, `f(b: 1, a: 5)`, put in their parameters' places, a left-out parameter
# given its default: the same places for every definition the name may mean, else refused
arranged_arguments(n: Node, called: Node, arguments: list, candidates: list<Function>) as list := {
	arrangements = candidates.map(definition => arranged(definition, arguments)).compact()
	if arrangements is empty { refused(n, "no ${called} has parameters of these names: ${candidates_text(candidates)}") }
	if arrangements.any(each => each != arrangements#1) { refused(n, "the names put the arguments in different places for ${candidates_text(candidates)}; give them in order") }
	arrangements#1
}
# the arguments in a definition's parameter order, ø when a name is none of its parameters or a parameter gets none
arranged(definition: Function, arguments: list) as list? := {
	parameters = parameters_in(definition.definer)
	positional = arguments.filter(argument => not is_named(argument))
	named = arguments.filter(is_named)
	if #positional > #parameters or not named.all(argument => parameters.drop(#positional).any(parameter => text(declared_name(parameter)) == text(declared_name(argument)))) { return ø }
	placed = positional
	for parameter in parameters.drop(#positional) {
		given = named.filter(argument => text(declared_name(argument)) == text(declared_name(parameter)))
		placed = placed + [if given then named_value(given#1) else if defaulted(parameter) then parameter_default(parameter) else return ø]
	}
	placed
}
named_value(argument: Node) as Node := match argument { Key(name, Op.Colon, value) => value; _ => refused(argument, "a named argument is written name: value") }
# whether a definition takes this many arguments: one for each parameter, those with defaults at the end left out or not
takes_count(definition: Function, count: int) as bool := {
	parameters = parameters_in(definition.definer)
	count <= #parameters and parameters.drop(count).all(defaulted)
}
defaulted(parameter: Node) as bool := has_fact(parameter, DEFAULT)
# a parameter's default value, `= ø` the fact Empty; a call leaves out only parameters with one (takes_count)
parameter_default(parameter: Node) as Node := fact_of(parameter, DEFAULT) ?? refused(parameter, "a call leaves out this parameter, which has no default")
# the defaults of the parameters a call leaves out, after the given ones, each typed as its parameter's type wants
defaults_given(definition: Function, count: int, s: TypingState, f: TypeFrame) as list := {
	parameters_in(definition.definer).drop(count).map(parameter => typed_form(parameter_default(parameter), s, f, type_given(parameter)))
}
# a map's own word, `m.keys`, beside its entries, `m.name`: a function of that name taking a map alone (wiki/map.md)
map_word(key: Node, s: TypingState) as bool := definitions_named(text(key), s).any(definition => takes_count(definition, 1) and takes_map(parameters_in(definition.definer)#1))
takes_map(parameter: Node) as bool := {
	type = type_given(parameter) ?? return no
	type_word(type) == MAP_TYPE
}
# A value's part by a text key, `x.f`: a field of x's record type, else the function f that takes x alone, which the
# Get then calls; a map's value by its key (core/analyze/data.wap); on an any, the field of whichever record holds it
# (core/analyze/dispatch.wap)
part_typed(n: Node, subject: Node, key: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	typed = typed_form(subject, s, f, ø)
	if key_type(value_type(typed)) != ø and not map_word(key, s) { return entry_read_typed(n, typed, typed_form(key, s, f, symbol(TEXT_TYPE)), s) }
	reader = if value_type(typed) == symbol(ANY_TYPE) then field_dispatching(key, s) else ø
	if reader != ø { return typed_form(named_call(reader.name, [reader], [typed], n), s, f, expected) }
	record = record_named(s.records, value_type(typed))
	field = if record == ø then ø else field_named(record, key)
	if field != ø { return as_found(n, with_type_of(refitted(Get(typed, key), n), declared_type(field)), s, f) }
	named = definitions_named(text(key), s)
	if named is empty { refused(n, "no field or function ${key} for a value of type ${value_type(typed) ?? "none"}") }
	chosen = function_typed(chosen_definition(n, key, [named], [typed], expected, s), [value_type(typed)], s, n)
	called_reads(chosen, n, s, f)
	result_of(calling(refitted(Get(typed, key), n), chosen), chosen)
}
# a value where the type it reads as is wanted, by that type's word: a written character where a text is wanted is
# its text, any other value the call text(c), a range list(r), an atom Node('a')
as_read(n: Node, wanted: Node, s: TypingState) as Node := {
	read = read_type(value_type(n), wanted) ?? refused(n, "this value reads as no other type")
	if n is Char and read == symbol(TEXT_TYPE) then char_text(n) else word_called(n, type_word(read), [n], ø, s)
}
char_text(character: Node) as Node := with_type(refitted(Text(text(character)), character), TEXT_TYPE)
# a call's typed arguments as their parameters (their letters bound by the call) have them: a char read as its text,
# a plain value boxed for an any or an optional
arguments_fitted(definition: Function, given: list, s: TypingState) as list := {
	letters = letters_bound(definition, given.map(value_type), s) ?? []
	wanted = definition.parameters.map(type => substituted(type, letters))
	(1 to #given).map(at => as_wanted(given#at, wanted#at, s))
}
# the call of a word with these typed arguments, the definition chosen among all of the word's
word_called(n: Node, word: text, given: list, expected: Node?, s: TypingState) as Node := {
	meant = chosen_definition(n, symbol(word), [definitions_named(word, s)], given, expected, s)
	taken = arguments_fitted(meant, given, s)
	chosen = function_typed(meant, taken.map(value_type), s, n)
	result_of(refitted(Call(calling(symbol(word), chosen), taken), n), chosen)
}
# the definitions of functions of this name the typing stage holds
definitions_named(name: text, s: TypingState) as list<Function> := items_named(s.definition_names, s.definitions, name, definition => definition.name)
# a definition as typing reaches it: shaped, and bound if it is the library's (core/analyze/shapes.wap shaped_once),
# kept in its place so it is shaped once
reached(definition: Function, s: TypingState) as Function := {
	if definition.shaped { return definition }
	shaped = shaped_once(definition, s)
	# the key's places indexed up to now, the list grown since included
	items_named(s.definition_keys, s.definitions, definition.key, keyed => keyed.key)
	for place in s.definition_keys.places[definition.key] { s.definitions[place] = shaped }
	shaped
}
# a call's function, or a Get that calls one, marked with the function it calls
calling(called: Node, chosen: TypedFunction) as Node := with_fact(with_binding(called, DefinitionKind.Function), DEFINED_AT, declared_name(signed_name(chosen)))
# a class's maker given one map that none of its definitions takes, `person({name: "Ann"})`: the instance made from it
# field by field (core/analyze/data.wap instance_from_map); ø for any other call
made_from_map(n: Node, called: Node, candidates: list<Function>, given: list, s: TypingState) as Node? := {
	record = record_named(s.records, called)
	if record == ø or #given != 1 or key_type(value_type(given#1)) == ø or candidates.any(definition => takes(definition, given, s, (argument, wanted) -> fits(argument, wanted, s))) { return ø }
	instance_from_map(n, record, given#1, s)
}
# A type's own words travel with it: the definitions of a called name that the module of an argument's record declares
# taking a value of that record, so a library's `show(xs#at)` finds a program's show(p: P), in the one ranking
own_words(called: Node, given: list, s: TypingState) as list := {
	records = given.map(argument => record_named(s.records, base_or_self(value_type(argument)))).compact()
	definitions_named(text(called), s).filter(definition => records.any(record => definition.module == (file_of(record) ?? "") and definition.parameters.any(type => takes_record(type, record))))
}
takes_record(type: Node?, record: Node) as bool := type != ø and text(base_or_self(type)) == record_name(record)
# the definitions a called name may mean, one list per scope, innermost first: the one it was bound or typed to, else
# its candidates
candidate_scopes(called: Node) as list := if fact_of(called, DEFINED_AT) != ø then [[defined_at(called)]] else match fact_of(called, CANDIDATES) {
	List(scopes, bracket, separator) => scopes.map(scope => match scope { List(items, inner, between) => items; _ => refused(scope, "a name's candidates are a list of definitions") })
	_ => [[defined_at(called)]]
}
# the definition a defining name means: its own, or, for the name of a function typed already (a call typed again),
# the definition that typed function came from, so typing a typed form again changes nothing
definition_at(definer: Node, s: TypingState) as Function := definition_keyed(place_key(definer), s) ?? definition_keyed(typed_from(place_key(definer), s), s) ?? refused(definer, "the typing stage found no definition here")
typed_from(key: text, s: TypingState) as text := {
	for typed in s.functions { if place_key(declared_name(signed_name(typed))) == key { return typed.function.key } }
	""
}
# the one definition of a key, ø when none has it: a key names one definition, so two of one key are refused
definition_keyed(key: text, s: TypingState) as Function? := {
	keyed = items_named(s.definition_keys, s.definitions, key, definition => definition.key)
	if #keyed > 1 { refused(symbol(key), "two definitions share the key ${key}") }
	if keyed is empty then ø else reached(keyed#1, s)
}

# The one definition that takes these typed arguments, by their types, then by the type expected; none or several
# refused. A literal that reads both ways fits either: `"!"` a char or a text parameter.
chosen_definition(n: Node, called: Node, scopes: list, given: list, expected: Node?, s: TypingState) as Function := {
	candidates = scopes.flat_map(scope => scope).map(definition => reached(definition, s))
	types = given.map(argument => value_of(argument, "to pass"))
	dispatcher = dispatching(called, candidates, types, s)
	if dispatcher != ø { return dispatcher }
	fitting = candidates.filter(definition => takes(definition, given, s, (argument, wanted) -> fits(argument, wanted, s)))
	exact = fitting.filter(definition => takes(definition, given, s, (argument, wanted) -> fits_exactly(argument, wanted, s)))
	if #fitting > 1 { fitting = if exact then exact else fewest_conversions(fitting, given, s) }
	if #fitting > 1 { fitting = most_specific(fitting, s.records) }
	if #fitting > 1 { fitting = innermost(fitting, scopes) }
	if #fitting > 1 and expected != ø { fitting = fitting.filter(definition => definition.result != ø and same_type(definition.result, expected)) }
	if fitting is empty { refused(n, "no ${called} takes (${types_text(types)}): ${candidates_text(candidates)}${words_missing(candidates, types, s)}") }
	if #fitting > 1 { refused(n, "this reads as a call of each of ${candidates_text(fitting)}; write the arguments' types or the type wanted") }
	fitting#1
}
# A definition the arguments fit exactly wins over one they fit only by a conversion (`text('é')` is text(c: char),
# not text(t: text)); of those they fit by conversions, those converting the fewest (`t == "?"` compares texts, not
# Nodes)
fewest_conversions(definitions: list<Function>, given: list, s: TypingState) as list<Function> := {
	counts = definitions.map(definition => conversions_taken(definition, given, s))
	least = counts.fold(counts#1, (a, b) -> if b < a then b else a)
	(1 to #definitions).filter(at => counts#at == least).map(at => definitions#at)
}
conversions_taken(definition: Function, given: list, s: TypingState) as int := {
	types = definition.parameters
	#((1 to #given).filter(at => at <= #types and not fits_exactly(given#at, types#at, s)))
}
# whether a definition takes these arguments, each one fitting its parameter
# (a parameter typed by generic letters takes an argument whose type binds them alike, and one of a function type a
# function value whose function gives that type's result for its parameters, see letters_bound); the arguments known
# whole where no letter is wanted are fitted first, so a function value is never typed for a definition that takes
# none of the other arguments (`items.map(item => named(item))` is no map over a Range)
takes(definition: Function, given: list, s: TypingState, fit: function) as bool := {
	parameters = parameters_in(definition.definer)
	if not takes_count(definition, #given) { return no }
	plain = (1 to #given).filter(at => not has_letters(definition.parameters#at, s.records) and not has_unknowns(value_type(given#at)))
	if not plain.all(at => argument_taken(given#at, parameters#at, [], s, fit)) { return no }
	letters = letters_bound(definition, given.map(value_type), s)
	letters != ø and (1 to #given).all(at => argument_taken(given#at, parameters#at, letters, s, fit))
}
argument_taken(argument: Node, parameter: Node, letters: list<Binding>, s: TypingState, fit: function) as bool := signature(type_given(parameter)) != ø or conforms(value_type(argument), type_given(parameter), s) or fit(with_letters(argument, letters), substituted(type_given(parameter), letters))
# an argument of the type its letters' binding gives it, `xs` of a list<α1> the call settles as a list<int>
with_letters(argument: Node, letters: list<Binding>) as Node := {
	type = substituted(value_type(argument), letters)
	if type == value_type(argument) then argument else with_type_of(argument, type)
}
# Among several definitions that fit, the most specific: a written type beats a bare kind, `==(a: Node, b: Node)`
# beats `==(a: enum, b: enum)`, a kind beats a generic letter, a letter beats no
# type, `===(a: T, b: T)` beats `===(a, b)`; of those, more written structure beats less, `==(a: T?, b: T?)` beats
# `==(a: T, b: T)`; several equally specific are left for the caller to refuse
most_specific(definitions: list<Function>, records: Records) as list<Function> := {
	order = ranked(definitions, records)
	order.filter(definition => typing_weight(definition, records) == typing_weight(order#1, records) and written_structure(definition) == written_structure(order#1) and derived(definition) == derived(order#1))
}
# The one ranking of a word's definitions, most specific first, by typing weight, then by written structure, then one
# the program wrote before one a rule wrote, the class's derived show(self: P) after its own show(p: P): the static
# choice takes its first that fits, a dynamic call (core/analyze/dispatch.wap) tests them in this order
ranked(definitions: list<Function>, records: Records) as list<Function> := definitions.sorted(by: derived).sorted(by: definition => -written_structure(definition)).sorted(by: definition => -typing_weight(definition, records))
derived(definition: Function) as int := if has_fact(declared_name(written_name(definition.definer)), DERIVED) then 1 else 0
# how much structure a definition's parameter types write: each `?`, `list<…>`, `map<…>` or `(…) -> …` one more
written_structure(definition: Function) as int := definition.parameters.map(structure).sum()
structure(type: Node?) as int := {
	parts = type_parts(type) ?? return 0
	1 + parts[1 ..].map(structure).sum()
}
# of equally specific definitions, those of the innermost scope: a program's `===(a: T, b: T)` hides the library's
innermost(definitions: list<Function>, scopes: list) as list<Function> := {
	for scope in scopes {
		inner = definitions.filter(definition => scope.any(candidate => candidate.key == definition.key))
		if inner { return inner }
	}
	definitions
}
typing_weight(definition: Function, records: Records) as int := definition.parameters.map(type => type_weight(type, records)).sum()
# how much a parameter's type says of its argument: nothing, a letter or a protocol, a kind, a type
type_weight(type: Node?, records: Records) as int := if type == ø then 0 else if has_letters(type, records) or protocol_named(records, type) != ø then 1 else if names_bare_kind(type) then 2 else 3

# Protocols (wiki/trait.md, decision traits-are-protocols): a type of words a value can do, `trait shape { area() }`,
# a Record of function-typed fields and no cases. A value fits one when for each word a function of that name takes
# the value's type first and the word's parameters after; a function of a protocol parameter is typed for each type
# given, so `area(s)` in its body is the given type's own area.
protocol_named(records: Records, type: Node?) as Node? := {
	record = record_named(records, type)
	if record == ø or not cases_of(record) is empty or fields_of(record) is empty or not fields_of(record).all(field => signature(declared_type(field)) != ø) { return ø }
	record
}
# whether a value of the given type fits the protocol wanted: no protocol wanted, or every word of it done for the type
conforms(given: Node?, wanted: Node?, s: TypingState) as bool := {
	protocol = protocol_named(s.records, wanted)
	protocol != ø and given != ø and fields_of(protocol).all(word => does_word(given, word, s))
}
# the protocol words these types lack for these definitions' protocol parameters, as a refusal's fix-it
words_missing(definitions: list<Function>, types: list, s: TypingState) as text := {
	missing = []
	for definition in definitions {
		if #definition.parameters == #types {
			for at in 1 to #types {
				protocol = protocol_named(s.records, definition.parameters#at)
				if protocol != ø { missing += fields_of(protocol).filter(word => not does_word(types#at, word, s)).map(word => "${types#at} is no ${record_name(protocol)}: define ${declared_name(word)}(x: ${types#at}${", …" * parameter_count(word)})") }
			}
		}
	}
	if missing is empty then "" else "; " + missing.join("; ")
}
does_word(given: Node, word: Node, s: TypingState) as bool := definitions_named(text(declared_name(word)), s).any(definition => does_as(definition, given, parameter_count(word)))
# how many parameters a protocol's word takes besides the value's own, its field a function type (protocol_named checks it)
parameter_count(word: Node) as int := #((signature(declared_type(word)) ?? refused(word, "a protocol's word is a function type")).parameters)
# whether a definition takes a value of this type first, then as many parameters as a protocol's word
does_as(definition: Function, given: Node, arity: int) as bool := {
	types = definition.parameters
	#types == arity + 1 and (types#1 == ø or same_type(types#1, given))
}

# whether an argument fits a parameter, exactly or by a static conversion (core/analyze/fits.wap conversion)
fits(argument: Node, wanted: Node?, s: TypingState) as bool := wanted == ø or conversion(value_type(argument), wanted, s) in STATIC_CONVERSIONS
fits_exactly(argument: Node, wanted: Node?, s: TypingState) as bool := wanted == ø or conversion(value_type(argument), wanted, s) == Conversion.Same
# the bare words of a kind, which every value of the kind fits (core/analyze/fits.wap bare_fit)
FUNCTION_WORD = "function"
BARE_KINDS = [LIST_TYPE, FUNCTION_WORD, ENUM_TYPE]
# a kind's bare word, or an optional of one: `list`, `enum?`
names_bare_kind(type: Node?) as bool := {
	word = base_or_self(type)
	word != ø and word is symbol and BARE_KINDS.contains(text(word))
}
# the type a refusal asks to write in full: `list<…>` for a bare list, else an example
full_type_hint(written: Node?) as text := if names_bare_kind(written) then text(base_or_self(written)) + "<…>" else "int"
# types as a message names them, `int, text?`
types_text(types: list) as text := types.map(type_text).join(", ")
candidates_text(definitions: list<Function>) as text := definitions.map(definition => "${written_name(definition.definer)}(${parameters_in(definition.definer).join(", ")}), ${written_at(definition)}").join("; ")
# where a function is written, as a message names it: `line 18 of equality.wap`
written_at(definition: Function) as text := "line ${line_of(definition.definer)} of ${definition.module.split("/").last}"
# a function as a refusal names it, its place telling apart the functions of one name and the function values, each a λ
called_name(definition: Function) as text := "${definition.name} (${written_at(definition)})"

# A function typed for these argument types, its written types' shapes known first, so it types alike however it is
# reached: from a block, a call, or alone
# It ends alone when wap refuses it: refused once, and each caller is refused naming it
function_typed(definition: Function, argument_types: list, s: TypingState, at: Node) as TypedFunction := {
	key = definition.key
	name = called_name(definition)
	if s.refusals.any(each => each.key == key) { refused(at, "this calls ${name}, which wap refuses") }
	try shaped_typed(shaped_once(definition, s), argument_types, s, at) catch e {
		s.refusals += [Refusal(key, e.message)]
		refused(at, "this calls ${name}, which wap refuses")
	}
}
# A function typed for these argument types, once per tuple: its parameters, then its body, its result the written
# one, which the body's type fits, or else the body's type. A call inside its own body finds it typed but without a result unless one is written.
# what a function's body and returns give back, all of one type
result_given(body: Node, frame: TypeFrame, name: Node, s: TypingState) as Node? := {
	# a written result is the result, which each returned value fits: `return x` of an int in a function giving int?;
	# else the body's and the returns' types joined as an if's arms are, `return ø` beside a Node a Node?, never any
	finishing = (if jumps(body) then [] else [value_type(body)]) + frame.returns
	joined = joined_all(finishing, s)
	result = frame.result ?? (if joined == symbol(ANY_TYPE) then finishing#1 else joined)
	# `return ø` in a function that gives nothing back is a bare return
	for returned in frame.returns { if not (returned == result or result == ø and returned == symbol(EMPTY_TYPE) or conversion(returned, result, s) in STATIC_CONVERSIONS) { refused(name, "this function gives back values of different types") } }
	result
}
A_DEFINE = "a function's definition is a Define"
shaped_typed(definition: Function, argument_types: list, s: TypingState, at: Node) as TypedFunction := match definition.definer { Define(name, parameters, body) => {
	key = definition.key
	letters = letters_bound(definition, argument_types, s) ?? []
	settled_by(letters, s)
	types = (1 to #argument_types).map(place => parameter_type(definition.parameters#place, type_substituted(argument_types#place ?? refused(at, "an argument reached typing without its type"), letters), letters, s.records))
	if (1 to #types).any(place => has_unknowns(types#place) and not takes_any_item(definition.parameters#place)) { return deferred_typed(definition, types, letters, s, at) }
	for typed in instances_of(key, s) {
		if same_instance(typed, key, types, s) {
			# a call of itself before its result is known gives no value; a function giving one refuses below
			typed.called_unknown = typed.called_unknown or not typed.done and typed.result == ø
			return typed
		}
	}
	typed = TypedFunction(definition, types)
	written = substituted(declared_type(name), letters)
	# a bare `list` (or `list?`) written takes the body's own type, as a bare list parameter takes its argument's
	typed.jumps = written == symbol(NEVER_RESULT)
	typed.result = if names_bare_kind(written) or typed.jumps then ø else written
	typed.unknown_result = "a function that calls itself and gives a value needs its full result type: write `${declared_name(name)}(…): ${full_type_hint(declared_type(name))} := …`"
	instance_added(typed, s)
	frame = TypeFrame()
	frame.present = if s.found_in.has(key) then s.found_in[key] else []
	frame.result = typed.result
	frame.letters = letters
	frame.function = declared_name(name)
	typed_parameters = (1 to #types).map(at => parameter_typed(items_of(parameters)#at, types#at, frame))
	frame.variables += captured_by(definition.definer, types)
	typed_body = typed_form(body, s, frame, typed.result)
	given = result_given(typed_body, frame, name, s)
	# a written result stays the result, `show(x: any): text := raise(…)`; one that writes none and never returns jumps
	typed.jumps = typed.jumps or written == ø and jumps(typed_body) and frame.returns is empty
	if written != ø and not typed.jumps { typed_body = converted(typed_body, written, s, body, "the function says it gives a") }
	typed.result = typed.result ?? (if given != ø and given != symbol(EMPTY_TYPE) and base_of_optional(written) != ø then optional_type(given) else given)
	typed.define = refitted(Define(signed_name(typed), with_items(parameters, typed_parameters), typed_body), definition.definer)
	typed.late = frame.late
	if typed.called_unknown and valued(typed.result) and not typed.jumps { refused(name, typed.unknown_result) }
	typed.done = yes
	typed
}; _ => refused(definition.definer, A_DEFINE) }
# a call typed by the function it calls: of its result, or jumping when that never returns
result_of(n: Node, chosen: TypedFunction) as Node := if chosen.jumps then jumping(n) else if chosen.result == ø and not chosen.done then with_fact(n, RESULT_UNKNOWN, Text(chosen.unknown_result)) else with_type_of(n, chosen.result)
# A parameter is of its written type, its letters bound, whatever an argument gives: `f(x: int?)` takes 3 and ø as an
# int?; none written, or one that takes its argument's own type, it is of the argument's type
parameter_type(written: Node?, given: Node, letters: list<Binding>, records: Records) as Node := if written == ø or takes_own_type(written, records) then given else type_substituted(written, letters)
# whether a parameter of this written type is typed anew for each type given: a bare `list`, `enum` or `function`,
# which take any list, enum or function value, a function type, whose function values each type it, and a protocol
takes_own_type(written: Node, records: Records) as bool := written == symbol(LIST_TYPE) or written == symbol(ENUM_TYPE) or written == symbol(FUNCTION_WORD) or signature(written) != ø or protocol_named(records, written) != ø
parameter_typed(parameter: Node, type: Node, frame: TypeFrame) as Node := {
	frame.variables += [Binding(place_key(declared_name(parameter)), type)]
	with_name_fact(parameter, TYPE, type)
}
# a typed function's name with its signature, `(int, text) -> int`: its argument types and its result, `()` for no
# parameters or no value known, `never` for one that never returns, as a built-in writes it, which the emitter lays out
signed_name(typed: TypedFunction) as Node := {
	result = if typed.jumps then symbol(NEVER_RESULT) else typed.result ?? Empty
	with_name_fact(written_name(typed.function.definer), SIGNATURE, function_type_of(typed.arguments, result))
}

# the parts of a Define, its parameters as a list of none or more
written_name(definition: Define) as Node := match definition { Define(name, parameters, body) => name }
parameters_in(definition: Define) as list := match definition { Define(name, parameters, body) => items_of(parameters) }
# a definition as the typing stage holds it, its written types read once
function_of(definition: Node) as Function := {
	written = written_name(definition)
	name = declared_name(written)
	Function(text(name), place_key(name), written_types(definition), declared_type(written), definition, file_of(name) ?? "")
}
# whether a definition's parameters all have their types, none a generic letter or a function type, whose function
# values each type it anew: typed even when nothing calls it
all_typed(definition: Function, records: Records) as bool := definition.parameters.all(type => once_typed(type, records))
# a written type that types its parameter once for every call: none missing, no generic letter, none typed anew
once_typed(type: Node?, records: Records) as bool := type != ø and not has_letters(type, records) and not takes_own_type(type, records)
written_types(definition: Node) as list<Node?> := parameters_in(definition).map(parameter => type_given(parameter))
# a parameter's type, written or given by an earlier typing: typing a typed program again changes nothing
type_given(parameter: Node) as Node? := declared_type(parameter) ?? fact_of(declared_name(parameter), TYPE)
