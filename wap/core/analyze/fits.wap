# How types meet (core/analyze/types.wap; wiki/conversion.md "Fitting" and "Repacking"): whether a value of one type
# may stand where another is wanted, two types written alike, and the type that holds the values of two.

use "types.wap"
use "calls.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "letters.wap"
use "shapes.wap"
use "dispatch.wap"
use "../errors.wap"

# DONE (1c61026ce9): Get rid of all this REVIEW CLUTTER and ONLY Link to the wiki specification. If absent, bring it to the interviewer!
# DONE (68479de8ad): what is symbol(NEVER_TYPE) ?? We don't have this ugly thing in Warp. Wap must be a more beautiful compiler 
# DONE (bd6311b8df): link conversion(given, wanted) to explicit function convert(a,b) and cast(a,b)  ≈  a as b := {...} 
# the type that holds both, an unknown in either settled by the other, `if missing(x) then 3 else x!` an int
joined_settling(a: Node?, b: Node?, s: TypingState) as Node? := {
	given = value_bearing(a)
	wanted = value_bearing(b)
	if given != ø and wanted != ø { settles(given, wanted, s) }
	joined_type(settled_optional(a, s), settled_optional(b, s), s)
}
# Code of which one part runs, an if's or a match's arms: of the type joining those that finish, jumping when all jump
joined_of(n: Node, parts: list, s: TypingState) as Node := if parts.all(jumps) then jumping(n) else with_type_of(n, parts_type(parts, s))
# the type joining the parts that finish
parts_type(parts: list, s: TypingState) as Node? := joined_all(parts.filter(part => not jumps(part)).map(value_type), s)
# the parts that finish each as their joined type has it: `1` of `if c then 1 else ø` boxed as an int?
parts_fitted(parts: list, s: TypingState) as list := {
	type = parts_type(parts, s)
	parts.map(part => as_wanted(part, type, s))
}
# the type that holds all of these, ø for none: two at a time, or where two only meet in any, the one of them that
# holds every other, whatever their order: `"one"`, `2` and a Symbol meet in Node
joined_all(types: list, s: TypingState) as Node? := {
	if types is empty { return ø }
	folded = types.drop(1).fold(types#1, (a, b) -> joined_settling(a, b, s))
	if folded != symbol(ANY_TYPE) { return folded }
	types.find(holder => types.all(type => conversion(type, holder, s) in STATIC_CONVERSIONS)) ?? folded
}
# the type that holds both: either when they are one, `T?` for a T and ø (or a T?), the type two shapes of it narrow,
# the wider where one fits the other, else any, the dynamic type: `["a", 1]` is a list<any>; ø when either has none
joined_type(a: Node?, b: Node?, s: TypingState) as Node? := {
	if a == ø or b == ø { return ø }
	if same_type(a, b) { return a }
	if a == symbol(EMPTY_TYPE) { return optional_type(b) }
	if b == symbol(EMPTY_TYPE) { return optional_type(a) }
	shared = shape_base(a) ?? return wider(a, b, s)
	if not same_type(shared, shape_base(b) ?? return wider(a, b, s)) { return wider(a, b, s) }
	# two shapes of one type join as that type, `Define` and `Fn?` as a Node?
	if base_of_optional(a) != ø or base_of_optional(b) != ø then optional_type(shared) else shared
}
# the type of two where one fits the other: the wider, else any
wider(a: Node, b: Node, s: TypingState) as Node := if conversion(b, a, s) in STATIC_CONVERSIONS then a else if conversion(a, b, s) in STATIC_CONVERSIONS then b else symbol(ANY_TYPE)
# the type a shape narrows, `Node` of `Define` or of `Fn?`; ø for any other type
shape_base(type: Node) as Node? := narrowed_type(base_of_optional(type) ?? type)

# Whether a typed node's value is of the type a typed rule's hole wants (a stage-3 rule, decision hole-types:
# `$xs: list<int>`, `$f: (float) -> float`): its TYPE, or a function name's SIGNATURE, written as the hole writes it.
# A node not typed yet fits nothing, so a typed rule fires only on settled types; a rest hole asks it of each item.
# A generic's bare name takes it with any parts: `$m: map` any map<K, V>, `$xs: list` any list.
fits_type(n: Node, wanted: Node) as bool := {
	held = type_held(n)
	held != ø and (same_type(held, wanted) or wanted is symbol and parts_of_type(text(wanted), held) != ø)
}
type_held(n: Node) as Node? := fact_of(n, TYPE) ?? fact_of(fact_of(n, DEFINED_AT) ?? return ø, SIGNATURE)
same_types(these: list<Node>, those: list<Node>) as bool := #these == #those and (1 to #these).all(at => same_type(these#at, those#at))
# a field's type, which every field writes
field_type(field: Node) as Node := declared_type(field) ?? refused(field, "a field has a type")
# a value given to a field as the field's type has it, refused when it cannot get there; value is the code that gave it
field_checked(given: Node, field: Node, value: Node, s: TypingState) as Node := converted(given, field_type(field), s, value, "the field holds a")
# What `x as T` does where nothing is written (wiki/conversion.md "Fitting" and "Repacking"): checked is the cast,
# every other way repacks; written, `x as T` is the maker T(x) ("Making").
# How a value of the given type gets where the wanted one is: as it is, of that type, a list where a bare `list` is, a
# function value where a bare `function` is, an enum where a bare `enum` is, or code that never finishes; boxed, into
# any or a number; widened, an int where a float is (wiki/type.md); read, a character as its text, where a text or a text? is (wiki/char.md, 'a' == "a"); wrapped, a T
# or ø where T? is; narrowed, a value of the type a shape narrows where the shape is (core/analyze/shapes.wap), raising
# there when it is of another shape; settled, the unknowns of either becoming the other's types, `[]` where a
# list<int> is; checked, an any's value where another type is, raising there when it holds another; ø when it cannot.
# The conversions a choice of overloads asks for, the static ones, never check: an any argument, or a Node where a
# shape is wanted, is chosen for at run time (core/analyze/dispatch.wap).
enum Conversion { Same, Boxed, Widened, Read, Wrapped, Narrowed, Settled, Checked }
STATIC_CONVERSIONS = [Conversion.Same, Conversion.Boxed, Conversion.Widened, Conversion.Read, Conversion.Wrapped]
# the primitive that widens an int to a float
WIDENING = "f64_convert_i64_s"
conversion(given: Node?, wanted: Node?, s: TypingState) as Conversion? := {
	if given == ø or wanted == ø { return ø }
	if same_type(given, wanted) or bare_fit(given, wanted, s.records) { return Conversion.Same }
	# a shape's value is a value of the type it narrows: a Record where a Node is
	narrows = narrowed_type(given)
	if narrows != ø and conversion(narrows, wanted, s) == Conversion.Same { return Conversion.Same }
	# a list of a shape's values is a list of the type it narrows, its items those values as they are
	given_item = item_type(given)
	wanted_item = item_type(wanted)
	if given_item != ø and wanted_item != ø and same_type(narrowed_type(given_item) ?? given_item, wanted_item) { return Conversion.Same }
	narrowing = narrowed_type(wanted)
	if narrowing != ø and same_type(given, narrowing) { return Conversion.Narrowed }
	if boxed_fit(given, wanted) { return Conversion.Boxed }
	if given == symbol(INT_TYPE) and wanted == symbol(FLOAT_TYPE) { return Conversion.Widened }
	optional = base_of_optional(wanted)
	if reads_as(optional ?? wanted, given) { return Conversion.Read }
	# an optional where one is wanted whose value is as it is: a list<int>? where a list? is
	if optional != ø and base_of_optional(given) != ø and conversion(base_of_optional(given), optional, s) == Conversion.Same { return Conversion.Same }
	if optional != ø and (given == symbol(EMPTY_TYPE) or conversion(given, optional, s) == Conversion.Same) { return Conversion.Wrapped }
	if (has_unknowns(given) or has_unknowns(wanted)) and unified(wanted, given, [], s) != ø { return Conversion.Settled }
	if given == symbol(ANY_TYPE) then Conversion.Checked else ø
}
# typed code as the wanted type has its value, its conversion written: an unknown settled, a character read as its
# text, an any's value checked by `prim cast`, typed the wanted type, at the code's place; refused at `at` when it
# cannot get there, naming the place that wants it, `the field holds a`
converted(n: Node, wanted: Node, s: TypingState, at: Node, place: text) as Node := {
	# code that never finishes gives nothing to convert
	if jumps(n) { return n }
	given = value_type(n) ?? refused(at, "this gives no value, ${place} ${wanted}")
	way = conversion(given, wanted, s) ?? refused(at, "this gives ${given}, ${place} ${wanted}")
	if way == Conversion.Settled { settles(given, wanted, s) }
	if way == Conversion.Narrowed { return narrowed_call(n, wanted, at, s) }
	if way == Conversion.Checked then with_type_of(placed_like(Prim(symbol(CHECKED_CAST), [n]), n), wanted) else repacked(n, way, wanted, s)
}
# a value converted the static way it gets where the wanted type is: read, boxed or wrapped, widened
repacked(n: Node, way: Conversion, wanted: Node, s: TypingState) as Node := match way {
	Conversion.Read => as_read(n, base_of(wanted), s)
	Conversion.Boxed => boxed(n, wanted)
	Conversion.Wrapped => boxed(n, wanted)
	Conversion.Widened => with_type_of(placed_like(Prim(symbol(WIDENING), [n]), n), wanted)
	_ => n
}
# a plain value put where a reference is wanted, an any, a number or an optional, in its box: `prim box(3)`; any
# other value as it is, a reference already
boxed(n: Node, wanted: Node) as Node := if is_plain(value_type(n)) then with_type_of(placed_like(Prim(symbol(BOXED_VALUE), [n]), n), wanted) else n
# the value a box holds, any other value as it is
unboxed(n: Node) as Node := match n {
	Prim(name, arguments) => if name == symbol(BOXED_VALUE) then arguments#1 else n
	_ => n
}
# a value as the type wanted has it, where it needs no check: a character where a text is wanted read as its text,
# `if c then 'a' else ""`, a plain value where a reference is wanted boxed, any other value as it is
as_wanted(n: Node, wanted: Node?, s: TypingState) as Node := {
	if wanted == ø or jumps(n) { return n }
	repacked(n, conversion(value_type(n), wanted, s) ?? return n, wanted, s)
}
# a value of a kind where its bare kind's word is wanted: `list`, `function` (a function value or a written function
# type, `(int) -> int`), `enum`
bare_fit(given: Node, wanted: Node, records: Records) as bool := {
	if wanted == symbol(LIST_TYPE) { return item_type(given) != ø }
	if wanted == symbol(FUNCTION_WORD) { return function_value_parts(given) != ø or signature(given) != ø }
	if wanted != symbol(ENUM_TYPE) { return no }
	record = record_named(records, given) ?? return no
	not cases_of(record) is empty
}
# any value where any is wanted, an int or a float where a number is
boxed_fit(given: Node, wanted: Node) as bool := wanted == symbol(ANY_TYPE) or wanted == symbol(NUMBER_TYPE) and given in [symbol(INT_TYPE), symbol(FLOAT_TYPE)]
# whether a type's values are held as they are, not by reference: put where a reference is wanted, each goes in its box
is_plain(type: Node?) as bool := type is symbol and text(type) in [INT_TYPE, FLOAT_TYPE, BOOL_TYPE, CHAR_TYPE]
# two types written alike, whatever their positions: `int`, `list<int>`, `(float) -> float`
same_type(a: Node, b: Node) as bool := match b {
	Symbol(name) => a is symbol and text(a) == name
	_ => a == b
}
