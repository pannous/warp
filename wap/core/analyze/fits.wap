# How types meet (core/analyze/types.wap): whether a value of one type may stand where another is wanted, two types
# written alike, and the type that holds the values of two.

use "types.wap"
use "calls.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "letters.wap"
use "../errors.wap"

# REVIEW (notes/wap_review.md "Dynamic types", 2026-11-18): this file should hold the one relation between types,
# `conversion(given, wanted) as Conversion?`, answering how a value gets there: as it is, boxed into any, wrapped
# into T?, checked out of any (a cast that raises with the place), or not at all. Typing writes that conversion into
# the kernel once; arguments, results, fields, items, variables and joined branches all ask it, and the relatives in
# calls.wap (conforms, fits, fits_exactly, any_list, any_enum), letters.wap, data.wap and the emitter's `fitted` go.
# Dynamic typing is then two lines here, not a second system: joined_type gives `any` where it gives ø today (so
# `["a", 1]` is a list<any>), and `any` given where a T is wanted is the checked conversion, not a refusal.
# the type that holds both, an unknown in either settled by the other, `if missing(x) then 3 else x!` an int
joined_settling(a: Node?, b: Node?, s: TypingState) as Node? := {
	if valued_type(a) and valued_type(b) { settles(a, b, s) }
	joined_type(substituted(a, s.settled), substituted(b, s.settled), s)
}
# the type that holds both: the one that finishes, either when they are one, `T?` for a T and ø (or a T?), the wider
# where one fits the other, else any, the dynamic type: `["a", 1]` is a list<any>; ø when either has none
joined_type(a: Node?, b: Node?, s: TypingState) as Node? := {
	if a == symbol(NEVER_TYPE) { return b }
	if b == symbol(NEVER_TYPE) or a == ø or b == ø { return if b == symbol(NEVER_TYPE) then a else ø }
	if same_type(a, b) { return a }
	if a == symbol(EMPTY_TYPE) { return optional_type(b) }
	if b == symbol(EMPTY_TYPE) { return optional_type(a) }
	if conversion(b, a, s) in STATIC_CONVERSIONS then a else if conversion(a, b, s) in STATIC_CONVERSIONS then b else symbol(ANY_TYPE)
}

# Whether a typed node's value is of the type a typed rule's hole wants (a stage-3 rule, decision hole-types:
# `$xs: list<int>`, `$f: (float) -> float`): its TYPE, or a function name's SIGNATURE, written as the hole writes it.
# A node not typed yet fits nothing, so a typed rule fires only on settled types; a rest hole asks it of each item.
fits_type(n: Node, wanted: Node) as bool := {
	held = type_held(n)
	held != ø and same_type(held, wanted)
}
type_held(n: Node) as Node? := fact_of(n, TYPE) ?? (if fact_of(n, DEFINED_AT) == ø then ø else fact_of(fact_of(n, DEFINED_AT), SIGNATURE))
same_types(these: list, those: list) as bool := #these == #those and (1 to #these).all(at => same_type(these#at, those#at))
# a value given to a field as the field's type has it, refused when it cannot get there; value is the code that gave it
field_checked(given: Node, field: Node, value: Node, s: TypingState) as Node := converted(given, declared_type(field), s, value, "the field holds a")
# How a value of the given type gets where the wanted one is: as it is, of that type, a list where a bare `list` is, a
# function value where a bare `function` is, an enum where a bare `enum` is, or code that never finishes; boxed, into
# any or a number; wrapped, a T or ø where T? is; settled, the unknowns of either becoming the other's types, `[]`
# where a list<int> is; checked, an any's value where another type is, raising there when it holds another; ø when
# it cannot. The conversions a choice of overloads asks for, the static ones, never check: an any argument is chosen
# for at run time.
enum Conversion { Same, Boxed, Wrapped, Settled, Checked }
STATIC_CONVERSIONS = [Conversion.Same, Conversion.Boxed, Conversion.Wrapped]
conversion(given: Node?, wanted: Node?, s: TypingState) as Conversion? := {
	if given == ø or wanted == ø { return ø }
	if same_type(given, wanted) or given == symbol(NEVER_TYPE) or bare_fit(given, wanted, s.records) { return Conversion.Same }
	if boxed_fit(given, wanted) { return Conversion.Boxed }
	optional = base_of_optional(wanted)
	# an optional where one is wanted whose value is as it is: a list<int>? where a list? is
	if optional != ø and base_of_optional(given) != ø and conversion(base_of_optional(given), optional, s) == Conversion.Same { return Conversion.Same }
	if optional != ø and (given == symbol(EMPTY_TYPE) or conversion(given, optional, s) == Conversion.Same) { return Conversion.Wrapped }
	if (has_unknowns(given) or has_unknowns(wanted)) and unified(wanted, given, [], s) != ø { return Conversion.Settled }
	if given == symbol(ANY_TYPE) then Conversion.Checked else ø
}
# typed code as the wanted type has its value, its conversion written: an unknown settled, an any's value checked by
# `prim cast`, typed the wanted type, at the code's place; refused at `at` when it cannot get there, naming the place
# that wants it, `the field holds a`
converted(n: Node, wanted: Node, s: TypingState, at: Node, place: text) as Node := {
	way = conversion(value_type(n), wanted, s) ?? refused(at, "this gives ${value_type(n) ?? "no value"}, ${place} ${wanted}")
	if way == Conversion.Settled { settles(value_type(n), wanted, s) }
	if way == Conversion.Checked then with_type_of(placed_like(Prim(symbol(CHECKED_CAST), [n]), n), wanted) else n
}
# a value of a kind where its bare kind's word is wanted: `list`, `function`, `enum`
bare_fit(given: Node, wanted: Node, records: list) as bool := {
	if wanted == symbol(LIST_TYPE) { return item_type(given) != ø }
	if wanted == symbol(FUNCTION_WORD) { return function_value_parts(given) != ø }
	wanted == symbol(ENUM_TYPE) and record_named(records, given) != ø and not cases_of(record_named(records, given)) is empty
}
# any value where any is wanted, an int or a float where a number is
boxed_fit(given: Node, wanted: Node) as bool := wanted == symbol(ANY_TYPE) or wanted == symbol(NUMBER_TYPE) and given in [symbol(INT_TYPE), symbol(FLOAT_TYPE)]
# two types written alike, whatever their positions: `int`, `list<int>`, `(float) -> float`
same_type(a: Node, b: Node) as bool := match b {
	Symbol(name) => a is symbol and text(a) == name
	_ => a == b
}
