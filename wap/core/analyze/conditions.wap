# The typing of tests and choices by them, called from the typing stage's dispatch (core/analyze/types.wap
# typed_form): a condition is yes or no, and what a condition finds, a variable present or of a type, its arms read.

use "types.wap"
use "calls.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "fits.wap"
use "letters.wap"
use "shapes.wap"

# What a condition finds of a variable: its key, the arm it holds in (1 then, 2 else), the type it reads as there
class Finding { key: text; arm: int; type: Node }
# A choice: its condition a bool, each part expected the If's type; with both parts of one type (a part that never
# finishes fits any) the If has it
# An optional variable tested, `if x != ø`, is its value in the arm where it is present, `x!`; a variable tested of a
# type, `x is int`, is of that type in the then-arm; `a and b` finds what both find. Where one arm never finishes,
# what the other finds holds after the If too, `if x == ø { return }` leaving x present for the statements after it;
# a loop's body, a match's arm and a try's parts keep such findings to themselves, as an If's arm does.
if_typed(n: Node, condition: Node, then_part: Node, else_part: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	tested = condition_typed(condition, s, f)
	findings = found(condition, tested, s, f)
	typed = (1 to 2).map(at => present_typed([then_part, else_part]#at, findings.filter(finding => finding.arm == at), s, f, expected))
	# a character beside a text is its text: `if c then 'a' else ""` is a text
	chosen = (1 to 2).map(at => text_read(typed#at, value_type(typed#(3 - at)), s))
	finishing = (1 to 2).filter(at => not jumps(chosen#at))
	if #finishing == 1 { f.present = f.present + findings.filter(finding => finding.arm == finishing#1).map(finding => [finding.key, finding.type]) }
	joined_of(refitted(If(tested, chosen#1, chosen#2), n), chosen, s)
}
# an arm typed with what is known of its variables in it, each read there as its finding's type
present_typed(part: Node, known: list<Finding>, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	before = f.present
	# a new list: `+=` would change the one `before` holds too, and the narrowing would outlive its arm
	f.present = f.present + known.map(finding => [finding.key, finding.type])
	typed = typed_form(part, s, f, expected)
	f.present = before
	typed
}
# what a condition finds of its variables, from the condition as written and as typed: `a and b` (If(a, b, no)) what
# each part finds in its then-arm
found(condition: Node, tested: Node, s: TypingState, f: TypeFrame) as list<Finding> := {
	parts = conjoined(condition)
	typed_parts = conjoined(tested)
	if parts != ø and typed_parts != ø { return (found(parts#1, typed_parts#1, s, f) + found(parts#2, typed_parts#2, s, f)).filter(finding => finding.arm == 1) }
	one = present_tested(condition, s, f) ?? type_tested(tested)
	if one == ø then [] else [one]
}
# the two parts of `a and b`, If(a, b, no); ø for any other form
conjoined(n: Node) as list? := match n {
	If(first, second, otherwise) => if otherwise is False then [first, second] else ø
	_ => ø
}
# the variable a condition finds present, of its value's type: `x != ø` and `if x` in the then-arm, `x == ø` in the
# else-arm; ø for any other condition
present_tested(condition: Node, s: TypingState, f: TypeFrame) as Finding? := match condition {
	Symbol(name) => if is_variable(condition) and base_of_optional(variable_type(condition, s, f)) != ø then Finding(place_key(defined_at(condition)), 1, base_of_optional(variable_type(condition, s, f))) else ø
	Call(called, arguments) => if #arguments == 2 and arguments#2 is Empty and is_variable(arguments#1) and (text(called) == UNEQUAL_WORD or text(called) == EQUAL_WORD) then Finding(place_key(defined_at(arguments#1)), if text(called) == UNEQUAL_WORD then 1 else 2, base_of_optional(variable_type(arguments#1, s, f))) else ø
	_ => ø
}
# the variable a typed condition finds of a type, in the then-arm: `x is int` of a number x, a shape's test of a Node
# (core/analyze/shapes.wap shape_test)
type_tested(tested: Node) as Finding? := match tested {
	Prim(operation, arguments) => if text(operation) == BOXED_TEST and is_variable(arguments#1) then Finding(place_key(defined_at(arguments#1)), 1, fact_of(tested, TESTED)) else ø
	Case(subject, arms) => if fact_of(tested, TESTED) != ø and is_variable(subject) then Finding(place_key(defined_at(subject)), 1, fact_of(tested, TESTED)) else ø
	_ => ø
}
is_variable(n: Node) as bool := n is symbol and fact_of(n, DEFINED_AT) != ø
EQUAL_WORD = "=="
UNEQUAL_WORD = "!="
condition_typed(condition: Node, s: TypingState, f: TypeFrame) as Node := {
	tested = truth_of(typed_form(condition, s, f, symbol(BOOL_TYPE)), s)
	# REVIEW (notes/wap_review.md, 2026-11-18): notes/first_principles.md tests emptiness loosely (`if xs`), and
	# wap's own core/paths.wap writes it; this refuses it. A condition of another type should be one more conversion
	# (core/analyze/fits.wap): a call of a library word of the preload, overloaded per type, never a table here.
	if value_type(tested) == ø or not same_type(value_type(tested), symbol(BOOL_TYPE)) { refused(condition, "a condition is yes or no") }
	tested
}
# A value as a condition reads it (wiki/truthiness.md): a bool as it is, a choice by its parts' truth, `xs and o` is
# If(xs, o, no), any other value by the preload's truthy, an empty list, text, 0 or ø no
TRUTHY = "truthy"
truth_of(typed: Node, s: TypingState) as Node := {
	if value_type(typed) != ø and same_type(value_type(typed), symbol(BOOL_TYPE)) { return typed }
	match typed {
		If(condition, then_part, else_part) => with_type(refitted(If(condition, truth_of(then_part, s), truth_of(else_part, s)), typed), BOOL_TYPE)
		_ => if value_type(typed) == ø then typed else word_called(typed, TRUTHY, [typed], ø, s)
	}
}
# A type test, `x is T`, left unbound by the binding analysis (core/analyze/scope.wap type_test_bound), a bool: for a
# case, whether x is that case, the Case `match x { T => yes; _ => no }`; for a type's name, whether x is of that type,
# known here (x still runs), or for a value any or a number holds, asked at run time
type_test_typed(n: Node, arguments: list, s: TypingState, f: TypeFrame) as Node := {
	subject = arguments#1
	tested = arguments#2
	# a shape, `n is Record`, by its pattern (core/analyze/shapes.wap)
	if narrowed_type(shaped(tested, s)) != ø { return typed_form(shape_test(subject, shaped(tested, s), n, s), s, f, ø) }
	if fact_of(tested, BINDING) == symbol(BOUND_CASE) { return typed_form(placed_like(Case(subject, [Arm(tested, True), Arm(symbol(WILDCARD), False)]), n), s, f, ø) }
	if not names_type(tested, s) { refused(tested, "is: ${tested} names no type and no test: define a type ${tested}, or ${tested}(x): bool") }
	typed = typed_form(subject, s, f, ø)
	type = value_type(typed) ?? refused(subject, "this gives no value to test")
	kind = kind_named(tested, type, s)
	if kind != ø { return typed_form(shape_test(subject, kind, n, s), s, f, ø) }
	if boxed_fit(tested, type) and not same_type(type, tested) { return with_fact(with_type(placed_like(Prim(symbol(BOXED_TEST), [typed]), n), BOOL_TYPE), TESTED, tested) }
	typed_form(placed_like(Block([subject, if same_type(type, tested) then True else False]), n), s, f, ø)
}
# whether a type test's word names a type: a built-in one, a record's or a generic letter; a written compound type,
# `list<int>`, is one
names_type(tested: Node, s: TypingState) as bool := not tested is symbol or TYPE_WORDS.contains(text(tested)) or record_named(s.records, tested) != ø or is_letter(tested, s.records)
