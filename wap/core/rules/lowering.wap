# Operated code → kernel forms, by hand until the rule engine runs (notes/wap.md, notes/kernel.md "How a program
# reaches the kernel"; the operated shapes it reads: notes/backbone.md "Stage languages").
#
# This is where the rule engine will run its three stages (shape, signature, kind). Until it exists, the few
# spellings the milestones need are lowered here by hand, one arm per form:
#   print "Hello"            a phrase, a word then its arguments → Call(print, ["Hello"])
#   f(1, 2)                  a head glued to its arguments, Key(f, Op.None, (1, 2)) → Call(f, [1, 2])
#   a + b                    an operator call, (Call + a b) → Call(+, [a, b])
#   x = 1                    (Call = x 1) → Set(x, 1)
#   f(x) := body             (Call := f(x) body) → Define(f, [x], body); `n := 1` → Define(n, [], 1)
#   x => x + 1               (Call => x (x + 1)) → Fn([x], x + 1)
#   yes no ø                 the canonical words of the literals (the preload's aliases bring true, null …) → True,
#                            False, Empty
#   { a; b }                 a block of code → Block([a, b]); a program's statements likewise
# A form not lowered yet is refused, naming it: never passed on to the emitter unlowered.

# the program as one Block of its statements
lowered_program(program: Node) as Block := staged(program, whole => Block(statements_of(whole).map(lowered)))

# code as a kernel form, placed where the code was written (core/stage.wap)
lowered(n: Node) as Node := staged(n, lowered_form)
lowered_form(n: Node) as Node := match n {
	Text(value) => n
	Number(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	Symbol(name) => if name == "yes" then True else if name == "no" then False else if name == "ø" then Empty else n
	Call(called, arguments) => operator_lowered(n, text(called), arguments)
	Key(head, Op.None, group) => if head is symbol then Call(head, arguments_of(group).map(lowered)) else not_lowered(n)
	List(items, Bracket.Curly, separator) => Block(statements_of(List(items, Bracket.None, separator)).map(lowered))
	List(items, Bracket.None, Separator.Space) => if items#1 is symbol then Call(items#1, items[1 ..].map(lowered)) else not_lowered(n)
	_ => not_lowered(n)
}

# an operator call: the defining operators as their kernel forms, any other a call of the operator's function
operator_lowered(n: Node, spelling: text, arguments: list) as Node := match spelling {
	"=" => Set(arguments#1, lowered(arguments#2))
	":=" => defined(n, arguments#1, lowered(arguments#2))
	"=>" => Fn(parameter_list(arguments#1), lowered(arguments#2))
	_ => Call(symbol(spelling), arguments.map(lowered))
}

# `f(x) := body` defines a function, `n := 1` a constant
defined(n: Node, head: Node, body: Node) as Node := match head {
	Key(name, Op.None, group) => if name is symbol then Define(name, parameter_list(group), body) else not_lowered(n)
	Symbol(name) => Define(head, parameter_list(Empty), body)
	_ => not_lowered(n)
}

# what a head's brackets hold: `()` nothing, `(a, b)` its items, `(a)` or `(a b)` one argument
arguments_of(group: Node) as list := match group {
	Empty => []
	List(items, Bracket.Round, Separator.Comma) => items
	List(items, Bracket.Round, Separator.None) => items
	_ => [group]
}

# the parameters a definition or a function value names, as the one list Define and Fn take
parameter_list(written: Node) as Node := List(arguments_of(written), Bracket.Round, Separator.Comma)

# a sequence of statements gives each, a group of one its item, any other node is the one statement
statements_of(n: Node) as list := match n {
	List(items, Bracket.None, Separator.Newline) => items
	List(items, Bracket.None, Separator.Semicolon) => items
	List(items, Bracket.None, separator) => if #items == 1 then items else [n]
	_ => [n]
}

not_lowered(n: Node) := refused(n, "wap does not lower this form yet")
