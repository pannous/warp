# Notation → kernel forms, by hand until the rule engine runs (notes/wap.md, notes/kernel.md "How a program reaches
# the kernel").
#
# This is where the rule engine will run its three stages (shape, signature, kind). Until it exists, the few
# spellings milestone 1 needs are lowered here by hand:
#   print "Hello"            a phrase: a word, then its arguments → Call(print, ["Hello"])
#   f(1, 2)                  a call → Call(f, [1, 2])
#   print "a"; print "b"     statements → Block([…, …])
#   { a; b }                 a block of code → Block([a, b])
#   x = 1                    a value given to a name → Set(x, 1)
#   f(x) := body             a function → Define(f, [x], body)
#   let x = 1, global x = 1  a new variable here, the program's → Set(x, 1) with the fact which variable it assigns
#   prim print_text(t)       a built-in's body in the preload → Prim(print_text, [t])
# A form not lowered yet is refused, naming it: never passed on to the emitter unlowered.

# the word that starts a primitive, only the preload writes it
PRIMITIVE_WORD = "prim"
# the words that say which variable an assignment means: `let x = 1` a new one here, `global x = 1` the program's
LOCAL_WORD = "let"
GLOBAL_WORD = "global"

# the program as one Block of its statements
lowered_program(program: Node) as Block := staged(program, whole => Block(statements_of(whole).map(lowered)))

# code as a kernel form, placed where the code was written (core/stage.wap)
lowered(n: Node) as Node := staged(n, lowered_form)
lowered_form(n: Node) as Node := match n {
	Text(value) => n
	Number(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	Symbol(name) => n
	List(items, Bracket.Curly, separator) => Block(statements_of(List(items, Bracket.None, separator)).map(lowered))
	Key(place, Op.Assign, value) => if place is symbol then Set(place, lowered(value)) else not_lowered(n)
	Key(List(items, Bracket.Round, separator), Op.Define, body) => if items#1 is symbol then Define(items#1, List(items[1 ..], Bracket.Round, Separator.Comma), lowered(body)) else not_lowered(n)
	Key(word, Op.Colon, assignment) => if word == symbol(GLOBAL_WORD) then scoped(assignment, BOUND_GLOBAL, n) else not_lowered(n)
	List(items, Bracket.None, Separator.Space) => phrase_lowered(items, n)
	List(items, Bracket.Round, separator) => called_with(items, n)
	_ => not_lowered(n)
}

# a phrase, a word and what follows: a primitive, `let x = 1`, or a call
phrase_lowered(items: list, n: Node) as Node := {
	if #items == 2 and items#1 == symbol(PRIMITIVE_WORD) { return primitive_of(items#2, n) }
	if #items == 2 and items#1 == symbol(LOCAL_WORD) { return scoped(items#2, BOUND_LOCAL, n) }
	called_with(items, n)
}

# `let x = 1`, `global x = 1`: the assignment, with the fact which variable it assigns (core/analyze/scope.wap)
scoped(assignment: Node, variable: text, n: Node) as Node := {
	set = lowered(assignment)
	if set is Set then with_fact(set, ASSIGNS, symbol(variable)) else refused(n, "`${LOCAL_WORD}` and `${GLOBAL_WORD}` take an assignment, `${LOCAL_WORD} x = 1`")
}

# a word with its arguments, `print "a"` or `f(1, 2)` as the reader gives it, (f 1 2): a call of the word
called_with(items: list, n: Node) as Node := if items#1 is symbol then Call(items#1, items[1 ..].map(lowered)) else not_lowered(n)
# the operation of `prim print_text(t)`, written like a call
primitive_of(operation: Node, n: Node) as Node := match operation {
	List(items, Bracket.Round, separator) => if items#1 is symbol then Prim(items#1, items[1 ..].map(lowered)) else not_lowered(n)
	_ => not_lowered(n)
}

# a sequence of statements gives each, a group of one its item, any other node is the one statement
statements_of(n: Node) as list := match n {
	List(items, Bracket.None, Separator.Newline) => items
	List(items, Bracket.None, Separator.Semicolon) => items
	List(items, Bracket.None, separator) => if #items == 1 then items else [n]
	_ => [n]
}

not_lowered(n: Node) := refused(n, "wap does not lower this form yet")
