# Declared code → kernel forms (notes/wap.md "The pipeline", notes/kernel.md "How a program reaches the kernel";
# the operated shapes it reads: notes/backbone.md "Stage languages").
#
# The rules have written the kernel forms of words (preload/sugar/: yes, break, global, if, while …); this stage
# writes the general ones, which no word names: calls, definitions, data and blocks, one arm per form. A phrase
# becomes a call of its head; typing refuses one whose head holds no function.
#   print "Hello"            a phrase, a word then its arguments → Call(print, ["Hello"])
#   f(1, 2)                  a head glued to its arguments, Key(f, Op.None, (1, 2)) → Call(f, [1, 2])
#   make(1)(2)               any head glued to them, a call of its value: Call(Call(make, [1]), [2])
#   Point{x: 1, y: 2}        an instance, data as the reader reads it, its fields' values lowered
#   x: int                   a typed name, a record's field or a parameter, as written
#   a + b                    an operator call, (Call + a b) → Call(+, [a, b])
#   x = 1                    (Call = x 1) → Set(x, 1)
#   let x = 1, global x = 1  (Call = (Variable x local) 1), the sugar's → Set(x, 1) with the fact which variable it
#                            assigns: a new one here, the program's
#   f(x) := body             (Call := f(x) body) → Define(f, [x], body); `n := 1` → Define(n, [], 1)
#   x => x + 1               (Call => x (x + 1)) → Fn([x], x + 1); `(a, b) -> a + b` likewise, -> and => both
#                            write a function value
#   { a; b }                 a block of code → Block([a, b]); a program's statements likewise
#   (x + 1)  (a; b)          a group: its one statement, several a Block
#   [a, b]                   a list, data as the reader reads it, its items lowered
#   a, b                     a row is a list wherever it stands as a value: `[1, 2⏎3]` is [[1, 2], 3]; in braces
#                            rows of keys are the keys, `{a: 1, b: 2⏎c: 3}` one map of three
#   global x, let x          (Variable x global), the sugar's, named without a value: no statement, the fact on its
#                            Block which x it means
#   use "path"               a module brought in: no statement, read by the declare stage (core/analyze/declarations.wap)
#   (If c a b)               a kernel form a rule built (preload/sugar: `if c then a else b`, `c ? a : b`, `a if c`,
#                            `unless c { a }`, `while c { b }`, `return x`, `prim print_text(t)`), its parts lowered
# A form not lowered yet is refused, naming it: never passed on to the emitter unlowered.

use "../analyze/declarations.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"
use "patterns.wap"
use "../language.wap"


# the program as one Block of its statements
lowered_program(language: Language, program: Node) as Block := staged(program, whole => lowered_block(language, statements_of(whole)))

# Statements as one Block. A Variable alone, `global x`, is no code: it says which variable x is in the whole block,
# the Block's fact VARIABLES, [x: global] (core/analyze/scope.wap)
lowered_block(language: Language, statements: list) as Node := {
	named = statements.filter(statement => statement is Variable)
	block = Block(statements.filter(statement => not (statement is Variable) and not is_use(statement)).map(item => lowered(language, item)))
	if named is empty then block else with_fact(block, VARIABLES, List(named.map(variable_named), Bracket.Square, Separator.Comma))
}
variable_named(statement: Node) as Node := match statement {
	Variable(name, kind) => Key(name, Op.Colon, kind)
	_ => refused(statement, "this statement names no variable")
}

# code as a kernel form, placed where the code was written (core/stage.wap)
lowered(language: Language, n: Node) as Node := staged(n, form => lowered_form(language, form))
lowered_form(language: Language, n: Node) as Node := match n {
	Text(value) => n
	Number(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	# empty braces, a map with no entries yet
	Symbol(name) => if name == EMPTY_BRACES then EmptyMap() else n
	Call(called, arguments) => operator_lowered(language, n, text(called), arguments)
	Key(head, Op.None, List(items, Bracket.Curly, separator)) => if head is symbol then Key(head, Op.None, fields_lowered(language, items, separator, n)) else not_lowered(n)
	# a type written with its parts, `list<Node>`, stays as written: a named argument's or a case's field's type
	Key(head, Op.None, List(items, Bracket.Less, separator)) => n
	Key(head, Op.None, group) => Call(if head is symbol then head else lowered(language, head), arguments_of(group).map(item => argument_lowered(language, item)))
	Key(name, Op.Colon, type) => if name is symbol then n else not_lowered(n)
	List(items, Bracket.Square, separator) => List(items.map(item => lowered(language, item)), Bracket.Square, separator)
	List(items, Bracket.Curly, separator) => if items.all(is_fields) then fields_lowered(language, items, separator, n) else lowered_block(language, statements_of(List(items, Bracket.None, separator)))
	List(items, Bracket.None, Separator.Comma) => List(items.map(item => lowered(language, item)), Bracket.Square, Separator.Comma)
	# a kernel form a rule built, `(If c a b)`, `(Break)`, its parts lowered; any other group its statements
	List(items, Bracket.Round, separator) => if (separator == Separator.Space or #items == 1) and pattern_called(language, items#1) != ø then List([items#1] + items[1 ..].map(item => lowered(language, item)), Bracket.Round, separator) else group_lowered(language, statements_of(List(items, Bracket.None, separator)))
	List(items, Bracket.None, Separator.Space) => phrase_lowered(language, items, n)
	# a word written against what follows it, `...rest`, as a phrase
	List(items, Bracket.None, Separator.None) => phrase_lowered(language, items, n)
	_ => not_lowered(n)
}

# an operator call: the defining operators as their kernel forms, any other a call of the operator's function
operator_lowered(language: Language, n: Node, spelling: text, arguments: list) as Node := match spelling {
	"=" => assigned(language, arguments#1, lowered(language, arguments#2))
	":=" => defined(language, n, arguments#1, lowered(language, arguments#2))
	"=>" => function_value(language, arguments)
	"->" => function_value(language, arguments)
	_ => Call(symbol(spelling), arguments.map(item => lowered(language, item)))
}

function_value(language: Language, arguments: list) as Node := Fn(parameter_list(language, arguments#1), lowered(language, arguments#2))

# a phrase headed by a word, a call of the word
phrase_lowered(language: Language, items: list, n: Node) as Node := if items#1 is symbol then Call(items#1, items[1 ..].map(item => lowered(language, item))) else not_lowered(n)

# `x = 1` gives x a value; a Variable place, `let x = 1` or `global x = 1`, also says which variable x is
# (core/analyze/scope.wap)
assigned(language: Language, place: Node, value: Node) as Node := match place {
	Variable(name, kind) => with_fact(Set(name, value), ASSIGNS, kind)
	_ => Set(lowered(language, place), value)
}

# `f(x) := body` defines a function, `n := 1` a constant; `f(x): int := body` names its result type with the name
defined(language: Language, n: Node, head: Node, body: Node) as Node := match head {
	Key(signature, Op.Colon, result) => with_result(defined(language, n, signature, body), result)
	Key(name, Op.None, group) => if name is symbol then Define(name, parameter_list(language, group), body) else not_lowered(n)
	Symbol(name) => Define(head, parameter_list(language, Empty), body)
	_ => not_lowered(n)
}
with_result(definition: Define, result: Node) as Node := match definition { Define(name, parameters, body) => Define(Key(name, Op.Colon, result), parameters, body) }

# what a head's brackets hold: `()` nothing, `(a, b)` its items, `(a)` or `(a b)` one argument
# a map's or an instance's fields, `{a: 1, b: 2}`, each value lowered: data, not a block (notes/kernel.md Data)
fields_lowered(language: Language, items: list, separator: Separator, n: Node) as Node := List(items.flat_map(row_items).map(field => field_lowered(language, field, n)), Bracket.Curly, separator)
# a key, or a row of keys
is_fields(item: Node) as bool := match item {
	Key(name, Op.Colon, value) => yes
	List(row, Bracket.None, Separator.Comma) => row.all(is_fields)
	_ => no
}
# an instance's field, `x: 1`, its value lowered
# a call's argument lowered: a named one, `by: f`, its value
argument_lowered(language: Language, argument: Node) as Node := match argument {
	Key(name, Op.Colon, value) => if name is symbol then field_lowered(language, argument, argument) else lowered(language, argument)
	_ => lowered(language, argument)
}
field_lowered(language: Language, field: Node, n: Node) as Node := match field {
	Key(name, Op.Colon, value) => refitted(Key(if name is symbol then name else lowered(language, name), Op.Colon, lowered(language, value)), field)
	_ => not_lowered(n)
}
arguments_of(group: Node) as list := match group {
	Empty => []
	List(items, Bracket.Round, Separator.Comma) => items
	List(items, Bracket.Round, Separator.None) => items
	_ => [group]
}

# the parameters a definition or a function value names, as the one list Define and Fn take
parameter_list(language: Language, written: Node) as Node := List(arguments_of(written).map(item => parameter_lowered(language, item)), Bracket.Round, Separator.Comma)
# a parameter as written; one with a default, `y: int = 2`, is the parameter with the default as its fact DEFAULT
parameter_lowered(language: Language, parameter: Node) as Node := match parameter {
	Call(called, arguments) => if text(called) == "=" and #arguments == 2 then with_fact(arguments#1, DEFAULT, lowered(language, arguments#2)) else parameter
	_ => parameter
}

# round brackets group: one statement is itself, `(x + 1)`, several a Block, `(a; b)`
group_lowered(language: Language, statements: list) as Node := if #statements == 1 then lowered(language, statements#1) else lowered_block(language, statements)

# a sequence of statements gives each (core/analyze/declarations.wap), a group of one its item, any other node is the
# one statement
statements_of(n: Node) as list<Node> := match n {
	Block(statements) => statements
	List(items, Bracket.None, separator) => if #items == 1 then statements_of(items#1) else top_level_statements(n)
	_ => [n]
}

not_lowered(n: Node) := refused(n, "wap does not lower this form yet")
