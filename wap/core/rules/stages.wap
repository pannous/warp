# Shape rules (stage 1): operated → surface (notes/backbone.md "Stage languages"). Rules and patterns are data, read
# by wap's own reader and operator stage from kernel/forms.wap, core/sugar/ and the program itself, and compiled to
# matchers when they are loaded:
#
#   pattern If = (If $condition: Node $then: Node $else: Node)      a pattern every rule may name
#   rule unless $c $body => If(not $c, $body, ø)                     a spelling written as other code
#
# Rules are indexed by the head of their pattern. A node is rewritten top-down: by the most specific rule that fits,
# again until none fits, then its parts. Each node a rule builds is placed where the rewritten code was and carries
# the rule (fact RULE, core/stage.wap). Rules terminate by construction, checked when they are loaded.
use "patterns.wap"
use "templates.wap"
use "lowering.wap"
use "../parse/reader.wap"
use "../parse/operators.wap"
use "../format.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"

RULE_WORD = "rule"
PATTERN_WORD = "pattern"
RULE_ARROW = "=>"
# a template that refuses what its pattern matched: `=> refuse "message"`
REFUSE_WORD = "refuse"
DEFINITION = "="
# the head of a pattern that starts with a hole: tried on every node
NO_HEAD = ""

class Rule { head: text, matcher: Matcher, template: Node, fresh: list, written: Node, specificity: int }
# the rules of one stage, by head
class Rules { by_head: map }
# stage 1 asks only shapes; stage 3 asks the types of typed code (a hole of a value type)
shape_rules = Rules({})
typed_rules = Rules({})
# code after a stage's rules, and whether any of them fired
class Fired { code: Node, fired: bool }

# ---- loading
#
# A side of a rule may stand in brackets to keep its keys and operators inside: `rule ($h as $t := $b) => ($h: $t := $b)`.
# Only a pattern's holes take a type (`$c: Node`); in a template `$h: $t` is the key it writes.

# the rules and patterns of loaded code taken in, the code without them returned
rules_loaded(code: Node) as Node := match code {
	List(items, Bracket.None, Separator.Newline) => List(items.filter(item => not taken_in(sequence_rule(item))), Bracket.None, Separator.Newline)
	_ => if taken_in(sequence_rule(code)) then Empty else code
}

# `rule P => A; B` writes both statements: the `;` binds looser than `=>`, so the line is a sequence whose first
# statement is the rule; the rule takes the rest as its template's further statements
sequence_rule(statement: Node) as Node := match statement {
	List(items, Bracket.None, Separator.Semicolon) => match items#1 {
		Call(called, arguments) => if spelling_written(called) == RULE_ARROW and #arguments == 2 then Call(called, [arguments#1, List([arguments#2] + items[1 ..], Bracket.None, Separator.Semicolon)]) else statement
		_ => statement
	}
	_ => statement
}

# a rule or pattern statement taken in (yes), or any other statement left (no)
taken_in(statement: Node) as bool := match statement {
	Call(called, arguments) => declaration_taken(spelling_written(called), arguments)
	_ => no
}

declaration_taken(called: text, arguments: list) as bool := {
	if #arguments != 2 { return no }
	words = phrase_items(arguments#1)
	if #words < 2 or not (words#1 is symbol) { return no }
	keyword = spelling_written(words#1)
	if called == DEFINITION and keyword == PATTERN_WORD and #words == 2 { declare_pattern(words#2, arguments#2); return yes }
	if called == RULE_ARROW and keyword == RULE_WORD { rule_added(arguments#1, if #words == 2 then words#2 else List(words[1 ..], Bracket.None, Separator.Space), arguments#2); return yes }
	no
}

phrase_items(n: Node) as list := match n { List(items, Bracket.None, Separator.Space) => items; _ => [n] }

rule_added(written: Node, pattern: Node, template: Node) := {
	normal = normalized(ungrouped(pattern))
	output = ungrouped(template)
	for hole in holes_in(output) { if not holes_in(normal).contains(hole) and not holes_in(normal).contains(hole + REST_MARK) { refused(written, "the rule writes " + hole + ", which its pattern has no hole for") } }
	typed = asks_value_type(compiled_pattern(normal))
	# a typed rule meets typed kernel: its pattern and template are lowered as the program is, `twice $x: int`
	if typed { normal = lowered(normal); output = lowered(output) }
	matcher = compiled_pattern(normal)
	rule = Rule(heads_of(normal)#1, matcher, output, names_bound_in(output), written, specificity(matcher))
	rules = if typed then typed_rules else shape_rules
	if not rules.by_head.has(rule.head) { rules.by_head[rule.head] = [] }
	rules.by_head[rule.head].add(rule)
}

# The heads a node is indexed under, most specific first: a phrase's first word, a declared form's name with its
# first word (`Call/+` for (Call + a b)), a key's operator; NO_HEAD last, where rules starting with a hole wait.
heads_of(n: Node) as list := match n {
	List(items, bracket, separator) => list_heads(items) + shape_heads(items, bracket, separator) + [NO_HEAD]
	Key(left, Op.None, List(items, bracket, separator)) => glued_heads(left, bracket) + ["key " + (Op.None as text), NO_HEAD]
	Key(left, Op.None, Empty) => EMPTY_GROUPS.flat_map(bracket => glued_heads(left, bracket)) + ["key " + (Op.None as text), NO_HEAD]
	Key(left, op, right) => ["key " + (op as text), NO_HEAD]
	_ => [NO_HEAD]
}
# A list under its bracket and separator, then its bracket alone: `$then... if $c` is a space phrase starting with a hole,
# indexed there, not among the rules tried on any code; a pattern of one part matches any separator, so it waits under
# its bracket
shape_heads(items: list, bracket: Bracket, separator: Separator) as list := (if #items > 1 then ["${bracket} ${separator}"] else []) + ["${bracket}"]

# a glued call or index, `f(x)`, `xs[i]`: under its name and bracket, then under its bracket alone (`$f($x)`, `$xs[$i]`)
glued_heads(left: Node, bracket: Bracket) as list := (if left is symbol and not is_hole(left) then ["${spelling_written(left)} ${bracket}"] else []) + ["glued ${bracket}"]

list_heads(items: list) as list := {
	if #items == 0 or is_hole(items#1) or not (items#1 is symbol) { return [] }
	first = spelling_written(items#1)
	if declared_patterns.has(first) and #items > 1 and items#2 is symbol and not is_hole(items#2) { return [first + "/" + spelling_written(items#2), first] }
	[first]
}

# A rule may refuse a spelling with a fix-it, `rule … => refuse "put the inner if in braces"`: the message, ø for a
# template that writes code
refusal_of(template: Node) as text? := match template {
	List(items, Bracket.None, Separator.Space) => if #items == 2 and items#1 == symbol(REFUSE_WORD) and items#2 is text then text(items#2) else ø
	_ => ø
}

# ---- termination, checked once all rules are loaded

# Every rule's template names heads that may fire again where it built. Following those from head to head must
# never come back, unless each rule on the way writes less code than it matched (each hole counted once).
terminating(rules: Rules) := {
	for head in rules.by_head.keys { cycle_refused(rules, head, []) }
}

cycle_refused(rules: Rules, head: text, path: list) := {
	if path.contains(head) {
		closing = path[path.index_of(head) ..] + [head]
		growing = rules_on(rules, closing).filter(rule => not shrinking(rule))
		if #growing > 0 { refused(growing#1.written, "these rules may rewrite forever: " + closing.join(" → ")) }
		return
	}
	if not rules.by_head.has(head) { return }
	for rule in rules.by_head[head] { for next in template_heads(rule.template) { cycle_refused(rules, next, path + [head]) } }
}

rules_on(rules: Rules, heads: list) as list := heads.filter(head => rules.by_head.has(head)).map(head => rules.by_head[head]).fold([], (a, b) -> a + b)

# the heads of every node a template spells (not the code its holes bring)
template_heads(n: Node) as list := match n {
	List(items, bracket, separator) => heads_of(n) + items.map(template_heads).fold([], (a, b) -> a + b)
	Key(left, op, right) => (if op == Op.None and pattern_called(left) != ø then [spelling_written(left)] else heads_of(n)) + template_heads(left) + template_heads(right)
	_ => []
}

shrinking(rule: Rule) as bool := size_of(rule.template) < matcher_size(rule.matcher) and #holes_in(rule.template) == #holes_in(rule.template).unique
matcher_size(m: Matcher) as int := 1 + m.parts.map(matcher_size).fold(0, (a, b) -> a + b)
size_of(n: Node) as int := match n {
	List(items, bracket, separator) => 1 + items.map(size_of).fold(0, (a, b) -> a + b)
	Key(left, op, right) => 1 + size_of(left) + size_of(right)
	_ => 1
}

# ---- the stage

# a program's own rules and patterns taken in, then the program shaped by every shape rule loaded
shaped_program(program: Node) as Node := {
	rest = rules_loaded(program)
	terminating(shape_rules)
	terminating(typed_rules)
	# the rewritten program stands for the program: it keeps its facts, the file it was read from among them; a
	# program of rules only is an empty block, as Empty carries no facts
	with_facts_of(rewritten_by(shape_rules, rest).code ?? Block([]), program)
}

# Code with a stage's rules applied top-down: a node rewritten by the most specific rule that fits, again until none
# does, then its parts. Says whether any rule fired, so typing can run again after stage 3.
rewritten_by(rules: Rules, code: Node) as Fired := {
	fired = [no]
	result = rules_applied(rules, code, fired)
	Fired(result, fired[0])
}

rules_applied(rules: Rules, n: Node, fired: list) as Node := staged(rewritten(rules, n, fired), whole => parts_applied(rules, whole, fired))

# A block or group of one phrase, `{ if c { a } }`, `(if c then a else b)`, holds the phrase's words: its one statement
# is that phrase, rewritten as one. A kernel form, `(If c a b)`, is its parts; square brackets hold items.
parts_applied(rules: Rules, whole: Node, fired: list) as Node := match whole {
	List(items, Bracket.None, Separator.Space) => with_parts(inner_rewritten(rules, items, whole), part => rules_applied(rules, part, fired))
	List(items, bracket, Separator.Space) => if one_phrase(items, bracket) then List([rules_applied(rules, with_facts_of(List(items, Bracket.None, Separator.Space), whole), fired)], bracket, Separator.None) else with_parts(whole, part => rules_applied(rules, part, fired))
	List(items, bracket, separator) => if separator == Separator.Newline or separator == Separator.Semicolon then List(spliced(items.map(part => rules_applied(rules, part, fired))), bracket, separator) else with_parts(whole, part => rules_applied(rules, part, fired))
	_ => with_parts(whole, part => rules_applied(rules, part, fired))
}
# A phrase no rule fits whole, whose later word heads a rule that fits from there on, `print match x {…}`: that part
# is the earlier words' last argument, as in `print -x`: it groups in round brackets, `print (match x {…})`, a group of
# one phrase the walk rewrites as one, and the grouping `wap format` prints
inner_rewritten(rules: Rules, items: list, whole: Node) as Node := {
	for at in 2 to #items {
		part = items[at - 1 ..]
		if items#at is symbol and rules.by_head.has(spelling_written(items#at)) and rule_applied(rules, phrase_placed(part, Bracket.None, whole)) != ø {
			return List(items[.. at - 1] + [phrase_placed(part, Bracket.Round, whole)], Bracket.None, Separator.Space)
		}
	}
	whole
}

# words as one phrase in those brackets, where the phrase they come from was written
phrase_placed(words: list, bracket: Bracket, origin: Node) as Node := with_facts_of(List(words, bracket, Separator.Space), origin)

# code with every grouping a rule head inside a phrase makes written out, nothing rewritten: what `wap format` prints;
# a rule or pattern line is printed as written
groupings_written(n: Node) as Node := match n {
	List(items, Bracket.None, Separator.Space) => if declares(items) then n else with_facts_of(with_parts(inner_rewritten(shape_rules, items, n), groupings_written), n)
	_ => with_facts_of(with_parts(n, groupings_written), n)
}
declares(items: list) as bool := items#1 == symbol(RULE_WORD) or items#1 == symbol(PATTERN_WORD)

# statements with each statement sequence among them, one a rule wrote, `A; B`, joined in its place
spliced(statements: list) as list := statements.flat_map(statement => match statement { List(items, Bracket.None, separator) => if STATEMENT_SEPARATORS.contains(separator) then items.map(item => with_rule_of(item, statement)) else [statement]; _ => [statement] })
# a spliced statement keeps the rule that wrote its sequence, so a later stage knows a rule wrote it
with_rule_of(item: Node, sequence: Node) as Node := if fact_of(sequence, RULE) == ø then item else with_fact(item, RULE, fact_of(sequence, RULE))
one_phrase(items: list, bracket: Bracket) as bool := bracket == Bracket.Curly or bracket == Bracket.Round and pattern_called(items#1) == ø

rewritten(rules: Rules, n: Node, fired: list) as Node := {
	current = n
	step = rule_applied(rules, current)
	while step != ø {
		fired[0] = yes
		current = staged(current, code => step)
		step = rule_applied(rules, current)
	}
	current
}

# the code the most specific fitting rule builds from it, ø when none fits; two equally specific ones are refused
rule_applied(rules: Rules, n: Node) as Node? := {
	best: Rule? = ø
	best_bindings = {}
	for head in heads_of(n) {
		if rules.by_head.has(head) {
			for rule in rules.by_head[head] {
				bindings = {}
				if matches(rule.matcher, n, bindings) {
					if best != ø and best.specificity == rule.specificity { refused(n, "two rules fit equally: " + best.written + " and " + rule.written) }
					if best == ø or rule.specificity > best.specificity { best = rule; best_bindings = bindings }
				}
			}
		}
	}
	if best == ø { return ø }
	if refusal_of(best.template) != ø { refused(n, refusal_of(best.template)) }
	with_fact(built(best.template, with_fresh_names(best_bindings, best.fresh)), RULE, best.written)
}
