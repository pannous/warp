# Typed rules (stage 3): typed kernel → typed kernel (notes/backbone.md "Stage languages", decision hole-types).
#
# A rule with a hole of a value type, `$xs: list<int>` or `$f: (float) -> float`, fires on code whose type is settled
# (core/analyze/types.wap fits_type). Its pattern and template are lowered like the program (core/rules/stages.wap).
# It fires inside the type walk, on each node as typing writes it and before elaborate: what it wrote is bound and
# typed in place, with the frame and the type expected there, so the code around it reads the type it gives; the code
# its holes took stays as typed (core/bindings.wap TYPED_HOLE).
#
#   rule twice $x: int => $x + $x      a rule only ints take
#   twice 3                            3 + 3, typed in place
use "stages.wap"
use "../analyze/scope.wap"
use "../analyze/names.wap"
use "../analyze/types.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"
use "../language.wap"

# how deep the typed rules may fire again on their own output before the program is refused
ROUNDS_LIMIT = 100

# the typed rules and the scope what they write binds in: the program's top level, inside the library
class KindRules { language: Language; scope: Scope }

# the bound program typed, the typed rules firing as it is typed (a script's value is shown by one,
# preload/sugar/calls.wap)
typed_by_rules(language: Language, program: Block, library: list, preload: Library) as Block := {
	scope = block_scope(program, statements_in(program), scope_around(library, []), PROGRAM_DEPTH)
	typed_program(program, preload, KindRules(language, scope))
}
# typed code rewritten by the typed rule that fits it, what the rule wrote bound and typed in its place
kind_rewritten(typed: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	rules = s.kind_rules ?? return typed
	steps = rule_applied(rules.language, rules.language.typed_rules, typed)
	if steps is empty { return typed }
	if s.refirings >= ROUNDS_LIMIT { refused(typed, "the typed rules still fire after ${ROUNDS_LIMIT} rewrites: a rule writes code it fires on again") }
	s.refirings += 1
	rewritten = typed_form(bound(steps#1, rules.scope, PROGRAM_DEPTH), s, f, expected)
	s.refirings -= 1
	rewritten
}
