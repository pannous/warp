# The stages in order (the table in compiler.wap), one function per step from source to typed program, shared by the
# compiler and the census (scripts/wap-census.warp), so neither can skip a stage.
use "../kernel/forms.wap"
use "stage.wap"
use "errors.wap"
use "parse/reader.wap"
use "parse/operators.wap"
use "parse/operator_table.wap"
use "analyze/declarations.wap"
use "rules/stages.wap"
use "rules/lowering.wap"
use "analyze/scope.wap"
use "analyze/library.wap"
use "analyze/types.wap"
use "rules/typed.wap"
use "rules/declared.wap"
use "language.wap"
use "paths.wap"

# the patterns of the kernel forms and the rules of the spellings every program may use, loaded as data
RULES_FILE = "preload/rules.wap"
# the standard language every program gets, as definitions
PRELOAD_FILE = "preload/preload.wap"
INCLUDE_WORD = "include"
# SCRIPT on the block of a program run as a script, whose last value it shows: a rule may ask it, `where script`
SCRIPT = "script"

# the rules loaded from the wap folder, then the preload declared once: what it declares is the library every program
# is bound in
language_loaded(language: Language, wap_folder: text) as Node := {
	# each file read with the rules of the files before it loaded
	for file in files_named(operated_file(language, in_folder(wap_folder, RULES_FILE)), USE_WORD) { rules_loaded(language, operated_file(language, file)) }
	declared_operated(language, program_operated(language, in_folder(wap_folder, PRELOAD_FILE)))
}
# the names a program's files define at their top, the files it uses and includes too, known before any is read, so
# no alias reads them (core/parse/operator_table.wap words_defined)
program_words_defined(language: Language, program: Node) := {
	for module in [program] + modules_used(program, read_notation) { file_words_defined(language, module) }
}
# the names a file defines at its top and those of the files it includes
file_words_defined(language: Language, code: Node) := {
	words_defined(code, language.defined_words)
	for included in files_named(code, INCLUDE_WORD) { file_words_defined(language, read_notation(included)) }
}
# a file of the wap folder, its path spelled as a used module's is, so a place names its file one way
in_folder(folder: text, file: text) as text := normalized_path(folder + "/" + file)
read_notation(file: text) as Node := readable(notation(read(file), file))
# notation the reader could read, an Error of it refused where the reader failed (core/parse/reader.wap notation)
readable(code: Node) as Node := match code {
	Error(Key(Text(why), op, failure)) => refused(failure, why)
	_ => code
}

# read code with its operators read, its spellings rewritten by the shape rules, then declared
declared_code(language: Language, code: Node) as Node := declared_operated(language, operated_program(language, code))
declared_operated(language: Language, code: Node) as Node := declared_program(shaped_program(language, code))
# a file's code with its operators read, each `include "file"` in it replaced by that file's statements, as they are
# (wiki/use.md)
operated_file(language: Language, file: text) as Node := operated_notation(language, file, read_notation(file))
# a program's file read once, the names it defines known before its operators are read
program_operated(language: Language, file: text) as Node := {
	program = read_notation(file)
	program_words_defined(language, program)
	operated_notation(language, file, program)
}
# a file's notation with its operators read and its includes in
operated_notation(language: Language, file: text, notation: Node) as Node := {
	code = operated_program(language, notation)
	match code {
		List(lines, Bracket.None, Separator.Newline) => refitted(List(lines.flat_map(line => included(language, file, line)), Bracket.None, Separator.Newline), code)
		_ => code
	}
}
# a line of a file, or the lines of the file it includes
included(language: Language, file: text, line: Node) as list<Node> := {
	path = phrase_text(line, INCLUDE_WORD) ?? return [line]
	match operated_file(language, beside(file, path)) {
		List(lines, Bracket.None, Separator.Newline) => lines
		code => [code]
	}
}
# a file with the modules it uses, theirs first, each declared after the modules it uses, so their rules shape it
declared_modules(language: Language, file: text) as list<Module> := {
	code = program_operated(language, file)
	used_modules(language, code) + [declared_module(language, code)]
}
# the modules operated code uses, theirs first, each declared
used_modules(language: Language, code: Node) as list<Module> := modules_used(code, file => if language.modules.has(module_key(file)) then language.modules[module_key(file)].code else operated_file(language, file)).map(module => used_module(language, module))
# a used module declared, or the one this compile declared already from its file; code of no file is declared anew
used_module(language: Language, code: Node) as Module := {
	key = module_key(file_of(code) ?? return declared_module(language, code))
	if language.modules.has(key) { return language.modules[key] }
	module = declared_module(language, code)
	language.modules[key] = module
	module
}
# the key a module's file is cached under, one spelling of its path
module_key(file: text) as text := normalized_path(file)
declared_module(language: Language, code: Node) as Module := module_declared(declared_operated(language, code))
# a declared module lowered and bound inside the modules it uses and the preload's declarations
prepared(language: Language, module: Module, modules: list<Module>, preload: Node) as Block := bound_program(lowered_module(language, module, modules, preload), library_around(module.code, preload), modules_of_uses(module, modules))
# a declared module lowered, the declaration rules first (stage 2), reading what the module, the modules it uses and
# the preload declare
lowered_module(language: Language, module: Module, modules: list<Module>, preload: Node) as Block := {
	uses = modules_of_uses(module, modules)
	lowered_program(language, declared_rewritten(language, module.code, library_around(module.code, preload) + uses.flat_map(used => declarations_of(used.code))))
}
# the modules a declared module uses
modules_of_uses(module: Module, modules: list<Module>) as list<Module> := module.uses.map(file => module_of(file, modules))
# the library a module is bound inside: the preload's declarations, except in the preload, which declares them itself
library_around(code: Node, preload: Node) as list := if code == preload then [] else declarations_of(preload)
# the modules prepared in order, their statements as one block
modules_prepared(language: Language, modules: list<Module>, preload: Node) as Block := Block(modules.flat_map(module => statements_in(prepared(language, module, modules, preload))))
# the preload's code after the modules it uses, whose words only the preload sees: its functions bound once typing
# reaches them (core/analyze/scope.wap library_bound)
library_code_of(language: Language, preload: Node) as Library := {
	uses = used_modules(language, preload)
	own = module_declared(preload)
	library = library_bound(lowered_module(language, own, uses, preload), modules_of_uses(own, uses))
	Library(Block(statements_in(modules_prepared(language, uses, preload)) + statements_in(library.code)), library.scope)
}
# the program with the modules it uses, theirs first: a module's statements run before the code that uses it, its
# functions are there for any caller; typed, then rewritten by the typed rules
typed_file(language: Language, file: text, preload: Node) as Block := {
	modules = declared_modules(language, file)
	whole = with_fact(modules_prepared(language, modules, preload), SCRIPT, True)
	library_code = library_code_of(language, preload)
	typed_by_rules(language, whole, declarations_of(preload), library_code)
}
