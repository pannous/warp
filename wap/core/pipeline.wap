# The stages in order (the table in compiler.wap), one function per step from source to typed program, shared by the
# compiler and the census (scripts/wap-census.warp), so neither can skip a stage.
use "../kernel/forms.wap"
use "stage.wap"
use "parse/reader.wap"
use "parse/operators.wap"
use "analyze/declarations.wap"
use "rules/stages.wap"
use "rules/lowering.wap"
use "analyze/scope.wap"
use "analyze/types.wap"
use "rules/typed.wap"
use "language.wap"
use "paths.wap"

# the patterns of the kernel forms and the rules of the spellings every program may use, loaded as data
RULE_FILES = ["kernel/forms.wap"] + ["conditions", "loops", "matching", "data", "records", "definitions", "types", "ranges", "calls"].map(topic => "preload/sugar/${topic}.wap")
# the standard language every program gets, as definitions: the prelude and the word files beside it
PRELOAD_FILES = ["preload/prelude.wap", "preload/lists.wap", "preload/texts.wap", "preload/numbers.wap", "preload/nodes.wap"]

# the rules loaded from the wap folder, then the preload declared once: what it declares is the library every program
# is bound in
language_loaded(language: Language, wap_folder: text) as Node := {
	for file in RULE_FILES { rules_loaded(language, operated_program(language, read_notation(in_folder(wap_folder, file)))) }
	files = PRELOAD_FILES.map(file => in_folder(wap_folder, file))
	statements = files.flat_map(file => top_level_statements(operated_file(language, file)))
	# one program, its uses found beside the prelude
	declared_operated(language, with_fact(List(statements, Bracket.None, Separator.Newline), SOURCE_FILE, Text(files#1)))
}
# a file of the wap folder, its path spelled as a used module's is, so a place names its file one way
in_folder(folder: text, file: text) as text := normalized_path(folder + "/" + file)
read_notation(file: text) as Node := notation(read(file), file)

# read code with its operators read, its spellings rewritten by the shape rules, then declared
declared_code(language: Language, code: Node) as Node := declared_operated(language, operated_program(language, code))
declared_operated(language: Language, code: Node) as Node := declared_program(shaped_program(language, code))
operated_file(language: Language, file: text) as Node := operated_program(language, read_notation(file))
# a file with the modules it uses, theirs first, each declared after the modules it uses, so their rules shape it
declared_modules(language: Language, file: text) as list := {
	code = operated_file(language, file)
	(modules_used(code, file => operated_file(language, file)) + [code]).map(module => declared_operated(language, module))
}
# declared code lowered and bound inside the modules it uses and the preload's declarations
prepared(language: Language, code: Node, modules: list, preload: Node) as Block := bound_program(lowered_program(language, code), library_around(code, preload), uses_of(code).map(file => module_of(file, modules)))
# the library a module is bound inside: the preload's declarations, except in the preload, which declares them itself
library_around(code: Node, preload: Node) as list := if code == preload then [] else declarations_of(preload)
# the preload's code with the modules it uses, whose words only the preload sees
library_code_of(language: Language, preload: Node) as Block := {
	modules = modules_used(preload, file => operated_file(language, file)).map(module => declared_operated(language, module)) + [preload]
	Block(modules.flat_map(module => statements_in(prepared(language, module, modules, preload))))
}
# the program with the modules it uses, theirs first: a module's statements run before the code that uses it, its
# functions are there for any caller; typed, then rewritten by the typed rules
typed_file(language: Language, file: text, preload: Node) as Block := {
	modules = declared_modules(language, file)
	whole = Block(modules.flat_map(module => statements_in(prepared(language, module, modules, preload))))
	library_code = library_code_of(language, preload)
	typed_by_rules(language, typed_shown(whole, library_code), declarations_of(preload), library_code)
}
