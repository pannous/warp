# The stages in order (the table in compiler.wap), one function per step from source to typed program, shared by the
# compiler and the census (scripts/wap-census.warp), so neither can skip a stage.
use "../kernel/forms.wap"
use "stage.wap"
use "parse/reader.wap"
use "parse/operators.wap"
use "analyze/declarations.wap"
use "rules/stages.wap"
use "rules/lowering.wap"
use "analyze/scope.wap"
use "analyze/types.wap"
use "rules/typed.wap"

# the patterns of the kernel forms and the rules of the spellings every program may use, loaded as data
RULE_FILES = ["kernel/forms.wap", "core/sugar/conditions.wap", "core/sugar/loops.wap", "core/sugar/matching.wap", "core/sugar/data.wap", "core/sugar/records.wap", "core/sugar/definitions.wap", "core/sugar/types.wap", "core/sugar/ranges.wap", "core/sugar/calls.wap"]
# the standard language every program gets, as definitions: the prelude and the word files beside it
PRELOAD_FILES = ["preload/prelude.wap", "preload/lists.wap", "preload/texts.wap", "preload/numbers.wap", "preload/nodes.wap"]

# the rules loaded from the wap folder, then the preload declared once: what it declares is the library every program
# is bound in
language_loaded(wap_folder: text) as Node := {
	for file in RULE_FILES { rules_loaded(operated_program(read_notation(wap_folder + "/" + file))) }
	files = PRELOAD_FILES.map(file => wap_folder + "/" + file)
	statements = files.flat_map(file => top_level_statements(operated_file(file)))
	# one program, its uses found beside the prelude
	declared_operated(with_fact(List(statements, Bracket.None, Separator.Newline), SOURCE_FILE, Text(files#1)))
}
read_notation(file: text) as Node := notation(read(file), file)

# read code with its operators read, its spellings rewritten by the shape rules, then declared
declared_code(code: Node) as Node := declared_operated(operated_program(code))
declared_operated(code: Node) as Node := declared_program(shaped_program(code))
operated_file(file: text) as Node := operated_program(read_notation(file))
# a file with the modules it uses, theirs first, each declared after the modules it uses, so their rules shape it
declared_modules(file: text) as list := {
	code = operated_file(file)
	(modules_used(code, operated_file) + [code]).map(declared_operated)
}
# the names the modules a declared program uses define
used_declarations(code: Node, modules: list) as list := uses_of(code).flat_map(file => declarations_of(module_of(file, modules)))
# declared code lowered and bound inside the preload's declarations and those of the modules it uses
prepared(code: Node, modules: list, preload: Node) as Block := bound_program(lowered_program(code), library_around(code, preload) + used_declarations(code, modules))
# the library a module is bound inside: the preload's declarations, except in the preload, which declares them itself
library_around(code: Node, preload: Node) as list := if code == preload then [] else declarations_of(preload)
# the preload's code with the modules it uses, whose words only the preload sees
library_code_of(preload: Node) as Block := {
	modules = modules_used(preload, operated_file).map(declared_operated) + [preload]
	Block(modules.flat_map(module => statements_in(prepared(module, modules, preload))))
}
# the program with the modules it uses, theirs first: a module's statements run before the code that uses it, its
# functions are there for any caller; typed, then rewritten by the typed rules
typed_file(file: text, preload: Node) as Block := {
	modules = declared_modules(file)
	whole = Block(modules.flat_map(module => statements_in(prepared(module, modules, preload))))
	library_code = library_code_of(preload)
	typed_by_rules(typed_shown(whole, library_code), declarations_of(preload), library_code)
}
