# Matching: a Case's arms tested in order against its subject, the parts of a case
# pattern taken out of the value, and a case's own value, its tag and fields.

use "emitter.wap"
use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "equality.wap"
use "opcodes.wap"
use "lists.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"
use "places.wap"
use "../type_notation.wap"

# the Node cases a raise becomes for a Try's handler, Error(Text(message)) (kernel-try)
ERROR_CASE = "Error"
TEXT_CASE = "Text"
# the Node case that wraps a node with its facts; a pattern of any other Node case looks through it
META_CASE = "Meta"

# A choice by patterns: the subject kept in a slot of its own, then each arm tested in order, an If each, until one
# fits; a name binds the subject. Typing gave the Case a value only when its last arm fits any.
#   subject, local.set held;  held == p1, if  r1  else  held == p2, if  r2  else …  end  end
case_code(form: Node, subject: Code, arms: list<Node>, p: Program, f: Frame) as Code := {
	f.slots += [Placed("subject held in slot ${#f.slots}", #f.slots, subject.type, [], yes)]
	held = f.slots.last
	chosen = arms_code(form, arms, held, p, f)
	Code(chosen.type, subject.instructions + local_set(held.index) + chosen.instructions)
}
arms_code(form: Node, arms: list<Node>, held: Placed, p: Program, f: Frame) as Code := {
	if arms is empty { return if fact_of(form, TYPE) == ø then Code() else Code(NEVER, UNREACHABLE) }
	match arms#1 {
		Arm(pattern, result) => {
			if names_any(pattern) or #arms == 1 and fact_of(form, TYPE) != ø and only_names(pattern, p) { return arm_taken(form, pattern, result, held, p, f) }
			test = Code(I32, pattern_test(pattern, fetched(held), held.type, p))
			if_code(form, test, labelled(f, [OTHER_LABEL], () => arm_taken(form, pattern, result, held, p, f)), labelled(f, [OTHER_LABEL], () => arms_code(form, arms[1 ..], held, p, f)), p)
		}
		_ => refused(arms#1, "a match's arm is written pattern => result")
	}
}
# an arm's result, after the names of its pattern are given their parts of the subject, made to fit the Case's type. The last arm of a Case that
# names every case always fits when its fields are only names, untested
arm_taken(form: Node, pattern: Node, result: Node, held: Placed, p: Program, f: Frame) as Code := {
	named = names_held(pattern, fetched(held), held.type, p, f)
	given = choice_fitted(form, code(result, p, f), result, p)
	Code(given.type, named + given.instructions)
}
# a pattern that fits any value: a name, or _
names_any(pattern: Node) as bool := pattern is symbol and not is_case(pattern)
only_names(pattern: Node, p: Program) as bool := field_parts(pattern, [], p).all(part => names_any(part.pattern))

# A part of a value a pattern takes apart: the field's pattern, the code that gives the field's value, its layout
class Part {
	pattern: Node
	value: list<int>
	type: list<int>
}
# the parts of a case pattern, `Circle(r)`, each field of the value cast to the case, or of a list pattern, each item
# and the rest; none for any other pattern
field_parts(pattern: Node, value: list<int>, p: Program) as list<Part> := match pattern {
	List(items, Bracket.Square, separator) => item_parts(items, value, type_of(pattern), p)
	Call(called, patterns) => {
		record = enum_declaring(p.records, called)
		cast = case_struct_of(record, case_declaring(p.records, called), p.m, p.records)
		types = case_fields(case_declaring(p.records, called)).map(field => known_layout(field_declared(field), p.m, p.records))
		(1 to #patterns).map(at => Part(patterns#at, value + heap_instruction(REF_CAST_NULL, cast) + instruction(STRUCT_GET, [cast, at + #fields_of(record)]), types#at))
	}
	_ => []
}
# A list pattern's parts: its items by their places, then the rest, the items after them as a new list
item_parts(items: list<Node>, value: list<int>, type: Node, p: Program) as list<Part> := {
	fixed = #items.filter(item => rest_named(item) == ø)
	(1 to #items).map(at => item_part(items#at, at, fixed, value, type, p))
}
# an item by its place, or the rest after the fixed items
item_part(item: Node, at: int, fixed: int, value: list<int>, type: Node, p: Program) as Part := {
	rest = rest_named(item)
	if rest == ø then Part(item, value + items_in(type, ø, p) + i32_const(at - 1) + instruction(ARRAY_GET, [items_array(type, p)]), item_layout(type, p)) else Part(rest, value + i64_const(fixed) + value + count_in(type, ø, p) + i32_const(fixed) + I32_SUB + I64_EXTEND_I32_U + typed_helper_called(LIST_SLICE, type, p), list_layout(type, p))
}
# Whether the value fits a pattern, yes or no: a case by its tag, a list by its count, then each part by its own
# pattern, tested only once the shape fits; a literal by equality. `value` is the code that gives the value, of the
# layout `type`.
pattern_test(pattern: Node, written: list<int>, type: list<int>, p: Program) as list<int> := {
	value = seen(pattern, written, p)
	shape = shape_test(pattern, value, p)
	if shape != ø {
		tested = field_parts(pattern, value, p).filter(part => not names_any(part.pattern))
		return tested.fold(shape, (fits, part) => fits + IF + I32 + pattern_test(part.pattern, part.value, part.type, p) + ELSE + i32_const(0) + END)
	}
	given = literal(pattern, p.m) ?? refused(pattern, "wap matches literals, names, cases and _ so far")
	value + given.instructions + equality(type, p)
}
# the test of a case pattern's tag or a list pattern's count, ø for any other pattern
shape_test(pattern: Node, value: list<int>, p: Program) as list<int>? := {
	# a missing value, an optional's ø, is no case
	if is_case(case_name(pattern)) { return value + REF_IS_NULL + IF + I32 + i32_const(0) + ELSE + value + tagged(p.m) + i32_const(tag_of(case_name(pattern), p)) + I32_EQ + END }
	items = list_pattern_items(pattern) ?? return ø
	fixed = #items.filter(item => rest_named(item) == ø)
	value + count_in(type_of(pattern), ø, p) + i32_const(fixed) + (if fixed < #items then I32_GE_U else I32_EQ)
}
# the names of a pattern given their parts of the value, after every test fit; code that leaves nothing. _ gives none.
names_held(pattern: Node, value: list<int>, type: list<int>, p: Program, f: Frame) as list<int> := {
	if text(pattern) == WILDCARD { return [] }
	if names_any(pattern) { return value + kept(added_variable(pattern, type, p, f)) + DROP }
	field_parts(pattern, seen(pattern, value, p), p).flat_map(part => names_held(part.pattern, part.value, part.type, p, f))
}
# A node's facts live in Meta, never in its shape: a pattern of another Node case, `List(items, b, s)`, tests the node
# inside the Meta wrappers, so a pattern written for one stage matches in the next (notes/backbone.md)
seen(pattern: Node, value: list<int>, p: Program) as list<int> := {
	if not is_case(case_name(pattern)) or text(case_name(pattern)) == META_CASE or record_name(enum_declaring(p.records, case_name(pattern))) != NODE_TYPE { return value }
	value + instruction(CALL, [helper(p, "meta_unwrapped", meta_unwrapped_function)])
}
# The helper taking a node out of its Meta wrappers, ø as it is. Its local: 0 the node.
meta_unwrapped_function(p: Program) as int := {
	node = record_named(p.records, symbol(NODE_TYPE)) ?? refused(Text(NODE_TYPE), "a Node pattern looks through Meta, and the program declares no Node")
	meta = case_struct_of(node, node_case(node, META_CASE), p.m, p.records)
	not_meta = local_get(0) + REF_IS_NULL + instruction(BRANCH_IF, [1]) + local_get(0) + tagged(p.m) + i32_const(declared_tag(node_case(node, META_CASE), p)) + I32_NE + instruction(BRANCH_IF, [1])
	inner = local_get(0) + heap_instruction(REF_CAST_NULL, meta) + instruction(STRUCT_GET, [meta, 1 + #fields_of(node)]) + local_set(0)
	layout = known_layout(symbol(NODE_TYPE), p.m, p.records)
	added_function(p.m, [layout], [layout], [], BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + not_meta + inner + instruction(BRANCH, [0]) + END + END + local_get(0))
}
# A case's value, `Dime` or `Circle(3)`: its tag and its fields' values in a new struct of its case, of its enum's type
case_value_code(form: Node, called: Node, arguments: list<Node>, p: Program, f: Frame) as Code := {
	record = enum_declaring(p.records, called)
	named = case_declaring(p.records, called)
	made = if case_fields(named) is empty then struct_of(record, p.m, p.records) else case_struct_of(record, named, p.m, p.records)
	Code(layout(form, p), i32_const(tag_of(called, p)) + (1 to #arguments).flat_map(at => field_filled(case_fields(named)#at, arguments#at, p, f)) + instruction(STRUCT_NEW, [made]))
}
# The helper turning a raise's text into the Node a Try's handler takes, Error(Text(text)), as case_value_code builds
# a case. Its local: 0 the text.
error_node_function(p: Program) as int := {
	node = record_named(p.records, symbol(NODE_TYPE)) ?? refused(Text(NODE_TYPE), "a Try's handler takes the raise as a Node, and the program declares no Node")
	tag = word => i32_const(declared_tag(node_case(node, word), p))
	made = word => instruction(STRUCT_NEW, [case_struct_of(node, node_case(node, word), p.m, p.records)])
	added_function(p.m, [text_layout(p.m)], [known_layout(symbol(NODE_TYPE), p.m, p.records)], [], tag(ERROR_CASE) + tag(TEXT_CASE) + local_get(0) + made(TEXT_CASE) + made(ERROR_CASE))
}
node_case(node: Record, word: text) as Node := {
	named = cases_of(node).filter(case => text(case_name(case)) == word)
	if named is empty then refused(Text(word), "the Node enum has no case of this name") else named#1
}
# A bound case's tag: its place among the cases of every enum the program declares, found by the case that defined
# it by its declaration's place, so cases of two enums never share a tag, not even two of one name and shape
tag_of(case: Node, p: Program) as int := declared_tag(case_declaring(p.records, case), p)
declared_tag(declared: Node, p: Program) as int := {
	key = place_key(case_name(declared))
	index_where(p.records.items.flat_map(cases_of), each => place_key(case_name(each)) == key) - 1
}
is_case(name: Node) as bool := is_bound(name, DefinitionKind.Case)
