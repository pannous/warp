# The primitives that ask the host (WASI): printing, raising, reading and writing files, the command line. Each is a
# helper function of the module, built here from WASI's calls on the module's memory; primitives.wap names them.

use "emitter.wap"
use "lists.wap"
use "values.wap"
use "wasm.wap"
use "opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "primitives.wap"

# print_text writes through WASI's fd_write(fd, iovecs, count, written), which the native warp and the browser both
# answer. Its memory: the iovec [address, length] at 0, the count written at 8, the text's bytes from 16.
STDOUT = 1
STDERR = 2
# the status a program that raised exits with
RAISED_STATUS = 1
# the module's one exception tag, a raise's, carrying its text: emitted declares it first
RAISED_TAG = 0
NEWLINE = 10
IOVEC_ADDRESS = 0
WRITTEN_ADDRESS = 8
BYTES_ADDRESS = 16

# The host's functions (WASI) a module imports, before any function of its own: fd_write and proc_exit, which print
# and every helper that raises call, into every module, first; the others only for the primitives that call them, a
# primitive of a host function's own name (wap/preload/host.wap)
RAISING_CALLS = ["fd_write", "proc_exit"]
# each host function's parameter and result types
HOST_FUNCTIONS = {
	"fd_write": [[I32, I32, I32, I32], [I32]], "proc_exit": [[I32], []], "fd_read": [[I32, I32, I32, I32], [I32]],
	"fd_seek": [[I32, I64, I32, I32], [I32]], "fd_close": [[I32], [I32]],
	"args_sizes_get": [[I32, I32], [I32]], "args_get": [[I32, I32], [I32]],
	"path_open": [[I32, I32, I32, I32, I32, I64, I64, I32, I32], [I32]]
}
# the index of a host function the module imported
host(p: Program, name: text) as int := p.host[name] ?? refused(Text(name), "the module did not import this host function")

printing_function(p: Program) as int := writing_function(p, STDOUT, [])
error_writing_function(p: Program) as int := writing_function(p, STDERR, [])
# a raise: its text thrown, for the innermost Try around it to catch (kernel-try)
raising_function(p: Program) as int := added_function(p.m, [nullable(text_type(p.m))], [], [], local_get(0) + instruction(THROW, [RAISED_TAG]))
# a raise no Try caught: its text written to stderr, the program ended
uncaught_function(p: Program) as int := writing_function(p, STDERR, i32_const(RAISED_STATUS) + instruction(CALL, [host(p, "proc_exit")]))
# a raise of the text on the stack from inside a helper
raise_called(p: Program) as list<int> := instruction(CALL, [helper(p, "raise_text", raising_function)]) + UNREACHABLE
# a raise of a message from inside a helper
raised(message: text, p: Program) as list<int> := text_literal(message, p.m).instructions + raise_called(p)
# a raise of a message and the text the code `ending` gives, joined
raised_with(message: text, ending: list<int>, p: Program) as list<int> := text_literal(message, p.m).instructions + ending + instruction(CALL, [helper(p, "text_joined", joining_function)]) + raise_called(p)
# The helper of print_text, error_text and an uncaught raise: the text's bytes and a line end copied into the memory, grown as needed,
# written to that file, then the code after. Its locals: 0 the text, 1 its length, 2 a count.
writing_function(p: Program, file: int, after: list<int>) as int := {
	text_type_index = text_type(p.m)
	the_text = local_get(0)
	length = local_get(1)
	count = local_get(2)
	byte_at_count = i32_const(BYTES_ADDRESS) + count + I32_ADD
	measured = the_text + ARRAY_LEN + local_set(1)
	grown = memory_grown(length, 2)
	copied = counted(2, length, byte_at_count + the_text + count + instruction(ARRAY_GET_U, [text_type_index]) + instruction(I32_STORE8, [0, 0]))
	line_end = i32_const(BYTES_ADDRESS) + length + I32_ADD + i32_const(NEWLINE) + instruction(I32_STORE8, [0, 0])
	iovec = i32_const(IOVEC_ADDRESS) + i32_const(BYTES_ADDRESS) + instruction(I32_STORE, [2, 0]) + i32_const(IOVEC_ADDRESS + 4) + length + i32_const(1) + I32_ADD + instruction(I32_STORE, [2, 0])
	written = i32_const(file) + i32_const(IOVEC_ADDRESS) + i32_const(1) + i32_const(WRITTEN_ADDRESS) + instruction(CALL, [host(p, "fd_write")]) + DROP
	added_function(p.m, [nullable(text_type_index)], [], [I32, I32], measured + grown + copied + line_end + iovec + written + after)
}

# the memory grown to hold that many bytes from BYTES_ADDRESS and a line end, the scratch local holding the pages
# short: (bytes + length + line end + a page - 1) ÷ page - memory.size, grown when positive
memory_grown(length: list<int>, scratch: int) as list<int> := i32_const(BYTES_ADDRESS + 1 + PAGE_BYTES - 1) + length + I32_ADD + i32_const(PAGE_BYTES) + I32_DIV_U + instruction(MEMORY_SIZE, [0]) + I32_SUB + instruction(LOCAL_TEE, [scratch]) + i32_const(0) + I32_GT_S + IF + VOID_BLOCK + local_get(scratch) + instruction(MEMORY_GROW, [0]) + DROP + END
