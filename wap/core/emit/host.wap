# The primitives that ask the host (WASI): printing, raising, reading and writing files, the command line. Each is a
# helper function of the module, built here from WASI's calls on the module's memory; primitives.wap names them.

use "emitter.wap"
use "lists.wap"
use "values.wap"
use "wasm.wap"
use "opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "primitives.wap"

# text_written writes through WASI's fd_write(fd, iovecs, count, written), which the native warp and the browser both
# answer. Its memory: the iovec [address, length] at 0, the count written at 8, the text's bytes from 16.
STDOUT = 1
STDERR = 2
# the status a program that raised exits with
RAISED_STATUS = 1
# the module's one exception tag, a raise's, carrying its text: emitted declares it first
RAISED_TAG = 0
NEWLINE = 10
IOVEC_ADDRESS = 0
WRITTEN_ADDRESS = 8
BYTES_ADDRESS = 16

# The host's functions (WASI) a module imports, before any function of its own: fd_write and proc_exit, which print
# and every helper that raises call, into every module, first; the others only for the primitives that call them, a
# primitive of a host function's own name (wap/preload/host.wap)
RAISING_CALLS = ["fd_write", "proc_exit"]
# each host function's parameter and result types
HOST_FUNCTIONS = {
	"fd_write": [[I32, I32, I32, I32], [I32]], "proc_exit": [[I32], []], "fd_read": [[I32, I32, I32, I32], [I32]],
	"fd_seek": [[I32, I64, I32, I32], [I32]], "fd_close": [[I32], [I32]],
	"args_sizes_get": [[I32, I32], [I32]], "args_get": [[I32, I32], [I32]],
	"path_open": [[I32, I32, I32, I32, I32, I64, I64, I32, I32], [I32]], "clock_time_get": [[I32, I64, I32], [I32]]
}
# the index of a host function the module imported
host(p: Program, name: text) as int := p.host[name] ?? refused(Text(name), "the module did not import this host function")

# a raise: its text thrown, for the innermost Try around it to catch (kernel-try)
raising_function(p: Program) as int := added_function(p.m, [text_layout(p.m)], [], [], local_get(0) + instruction(THROW, [RAISED_TAG]))
# a raise no Try caught, its text on the stack: written to stderr and a line end, the program ended
uncaught(p: Program) as list<int> := i64_const(STDERR) + i32_const(1) + instruction(CALL, [helper(p, "text_written", writing_function)]) + i32_const(RAISED_STATUS) + instruction(CALL, [host(p, "proc_exit")])
# a raise of the text on the stack from inside a helper
raise_called(p: Program) as list<int> := instruction(CALL, [helper(p, "raise_text", raising_function)]) + UNREACHABLE
# a raise of a message from inside a helper
raised(message: text, p: Program) as list<int> := text_literal(message, p.m).instructions + raise_called(p)
# a raise of a message and the text the code `ending` gives, joined
raised_with(message: text, ending: list<int>, p: Program) as list<int> := text_literal(message, p.m).instructions + ending + instruction(CALL, [helper(p, "text_joined", joining_function)]) + raise_called(p)
# The helper of text_placed: a text's bytes copied into the memory from BYTES_ADDRESS, the memory grown to hold them
# and a line end. Its locals: 0 the text, 1 its length, 2 a count.
placing_function(p: Program) as int := {
	text_type_index = text_type(p.m)
	the_text = local_get(0)
	length = local_get(1)
	count = local_get(2)
	measured = the_text + ARRAY_LEN + local_set(1)
	copied = counted(2, length, i32_const(BYTES_ADDRESS) + count + I32_ADD + the_text + count + instruction(ARRAY_GET_U, [text_type_index]) + instruction(I32_STORE8, [0, 0]))
	added_function(p.m, [nullable(text_type_index)], [], [I32, I32], measured + memory_grown(length, 2) + copied)
}
# The helper of text_written, what print, eprint, an uncaught raise and the file words write with: a text placed, a
# line end after it when asked, written to a file through fd_write's one iovec, again from where it stopped until every
# byte is taken; a write that fails or takes none traps. Its locals: 0 the text, 1 the file, 2 whether a line end
# follows, 3 the count of bytes to write, 4 the count written.
writing_function(p: Program) as int := {
	length = local_get(3)
	done = local_get(4)
	moved = i32_const(WRITTEN_ADDRESS) + instruction(I32_LOAD, [2, 0])
	placed = local_get(0) + instruction(CALL, [helper(p, "text_placed", placing_function)]) + local_get(0) + ARRAY_LEN + local_set(3)
	line_end = local_get(2) + IF + VOID_BLOCK + i32_const(BYTES_ADDRESS) + length + I32_ADD + i32_const(NEWLINE) + instruction(I32_STORE8, [0, 0]) + length + i32_const(1) + I32_ADD + local_set(3) + END
	iovec = i32_const(IOVEC_ADDRESS) + i32_const(BYTES_ADDRESS) + done + I32_ADD + instruction(I32_STORE, [2, 0]) + i32_const(IOVEC_ADDRESS + 4) + length + done + I32_SUB + instruction(I32_STORE, [2, 0])
	written = int_local(1) + i32_const(IOVEC_ADDRESS) + i32_const(1) + i32_const(WRITTEN_ADDRESS) + instruction(CALL, [host(p, "fd_write")])
	failed = written + moved + I32_EQZ + I32_OR + IF + VOID_BLOCK + UNREACHABLE + END
	rest = BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + done + length + I32_GE_U + instruction(BRANCH_IF, [1]) + iovec + failed + done + moved + I32_ADD + local_set(4) + instruction(BRANCH, [0]) + END + END
	added_function(p.m, [text_layout(p.m), I64, I32], [], [I32, I32], placed + line_end + rest)
}
# The helper of memory_held: the memory grown to hold that many bytes from BYTES_ADDRESS. Its locals: 0 the count, 1
# the pages short.
memory_holding_function(p: Program) as int := added_function(p.m, [I64], [], [I32], memory_grown(int_local(0), 1))
# the memory grown to hold that many bytes from BYTES_ADDRESS and a line end, the scratch local holding the pages
# short: (bytes + length + line end + a page - 1) ÷ page - memory.size, grown when positive
memory_grown(length: list<int>, scratch: int) as list<int> := i32_const(BYTES_ADDRESS + 1 + PAGE_BYTES - 1) + length + I32_ADD + i32_const(PAGE_BYTES) + I32_DIV_U + instruction(MEMORY_SIZE, [0]) + I32_SUB + instruction(LOCAL_TEE, [scratch]) + i32_const(0) + I32_GT_S + IF + VOID_BLOCK + local_get(scratch) + instruction(MEMORY_GROW, [0]) + DROP + END
