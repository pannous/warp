# The primitives the emitter performs (notes/kernel.md "Primitives"): where warp ends and wasm or the host begins.
#
# Input: a Prim's operation and the code of its arguments; output: the code of the operation. Only the preload
# writes a Prim, as the body of a built-in (wap/preload/prelude.wap), so each operation here is named once, in the
# definition that gives it a warp signature. An operation that needs more than a few instructions is a helper
# function of the module, emitted once.

use "emitter.wap"
use "equality.wap"
use "lists.wap"
use "patterns.wap"
use "values.wap"
use "wasm.wap"
use "functions.wap"
use "opcodes.wap"
use "../../kernel/forms.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "places.wap"
use "host.wap"

# The wasm instructions a Prim names: operation → opcode. The types of its operands and of its value are the ones
# its built-in's definition writes (wap/preload/prelude.wap).
INSTRUCTIONS: map<text, list<int>> = {
	"ref_is_null": REF_IS_NULL, "i64_add": I64_ADD, "i64_sub": I64_SUB, "i64_mul": I64_MUL, "i64_eq": I64_EQ, "i64_ne": I64_NE,
	"i64_lt_s": I64_LT_S, "i64_gt_s": I64_GT_S, "i64_le_s": I64_LE_S, "i64_ge_s": I64_GE_S,
	"f64_add": F64_ADD, "f64_sub": F64_SUB, "f64_mul": F64_MUL, "f64_div": F64_DIV, "f64_eq": F64_EQ, "f64_ne": F64_NE,
	"f64_lt": F64_LT, "f64_gt": F64_GT, "f64_le": F64_LE, "f64_ge": F64_GE,
	"i64_div_s": I64_DIV_S, "i64_rem_s": I64_REM_S, "f64_neg": F64_NEG, "f64_floor": F64_FLOOR, "f64_ceil": F64_CEIL,
	"i64_trunc_f64_s": I64_TRUNC_F64_S, "f64_convert_i64_s": F64_CONVERT_I64_S,
	"i64_reinterpret_f64": I64_REINTERPRET_F64, "f64_reinterpret_i64": F64_REINTERPRET_I64,
	"array_len": ARRAY_LEN + I64_EXTEND_I32_U, "i64_extend_i32_u": I64_EXTEND_I32_U, "i32_wrap_i64": I32_WRAP_I64
}
# a helper's early end: unless the test on the stack is yes, the helper gives no
NO_UNLESS_YES = I32_EQZ + IF + VOID_BLOCK + i32_const(0) + RETURN + END

# The operations a helper function of the module performs: operation → the function that builds the helper
HELPERS = {"text_written": writing_function, "text_placed": placing_function, "memory_held": memory_holding_function, "array_slice": slicing_function, "raise_text": raising_function, "text_equal": text_equality_function, "text_joined": joining_function, "case_name": case_naming_function}
# the lists a map holds, not copied: its keys and its values, an entry the same place in both
MAP_FIELDS = {"map_keys_held": MAP_KEYS, "map_values_held": MAP_VALUES}

# The operations on the module's memory and on a text's bytes, each by the wasm types it takes and gives and its
# instructions, as a host function's call by HOST_FUNCTIONS: an int given where it takes an i32 is wrapped to one, an
# i32 it gives extended to an int; an operand of another type than it takes is refused
class WasmOperation { takes: list<list<int>>; gives: list<list<int>>; code: list<int> }
memory_operations(p: Program) as map<text, WasmOperation> := {
	bytes = text_type(p.m)
	text = text_layout(p.m)
	{
		"memory_byte": WasmOperation([I32], [I32], instruction(I32_LOAD8_U, [0, 0])),
		"array_get_u": WasmOperation([text, I32], [I32], instruction(ARRAY_GET_U, [bytes])),
		"memory_word": WasmOperation([I32], [I32], instruction(I32_LOAD, [2, 0])), "memory_set_word": WasmOperation([I32, I32], [], instruction(I32_STORE, [2, 0])),
		"text_made": WasmOperation([I32], [text], instruction(ARRAY_NEW_DEFAULT, [bytes])), "text_byte_set": WasmOperation([text, I32, I32], [], instruction(ARRAY_SET, [bytes]))
	}
}
# the code of an operation of wasm types: its operands, each int it takes as an i32 wrapped, its instructions, then an
# i32 it gives extended to the int its definition writes
wasm_called(form: Node, arguments: list<Code>, operation: WasmOperation, p: Program) as Code := {
	narrowed = (1 to #arguments).flat_map(at => arguments#at.instructions + (if arguments#at.type == operation.takes#at or arguments#at.type == NEVER then [] else if arguments#at.type == I64 and operation.takes#at == I32 then I32_WRAP_I64 else refused(form, "operand ${at} of this primitive is not of the wasm type it takes")))
	Code(typed_layout(form, p), narrowed + operation.code + (if operation.gives == [I32] and typed_layout(form, p) == I64 then I64_EXTEND_I32_U else []))
}

# two cases compared, by the type of the first: its tag and its fields, each by its own type's equality
TAG_EQUAL = "tag_equal"
# the code of a primitive: its arguments, then its instruction or a call of its helper, giving the value its
# built-in's definition writes
primitive_code(form: Node, operation: Node, arguments: list<Code>, p: Program) as Code := {
	name = text(operation)
	operands = arguments.flat_map(argument => argument.instructions)
	# the value the operands and these instructions after them give
	ending = instructions => Code(typed_layout(form, p), operands + instructions)
	if INSTRUCTIONS.has(name) { return ending(INSTRUCTIONS[name]) }
	if HELPERS.has(name) { return helper_called(form, operands, name, HELPERS[name], p) }
	if name == BOXED_TEST { return ending(heap_instruction(REF_TEST, held_in_any(fact_of(form, TESTED) ?? refused(form, "this test reached the emitter without the type it tests"), form, p).type_index)) }
	if name == BOXED_VALUE { return ending(instruction(STRUCT_NEW, [box_index(p.m, plain_word(boxed_operand(form)))])) }
	if name == CHECKED_CAST { return finished(ending(cast_called(typed_layout(form, p), text(type_of(form)), form, p))) }
	if name == OPTIONAL_VALUE { return ending(optional_value(form, p)) }
	if name == TAG_EQUAL { return ending(type_equality(first_operand_type(form), p)) }
	if name == LIST_COUNT { return ending(counted_items(p)) }
	if MAP_FIELDS.has(name) { return ending(instruction(STRUCT_GET, [map_struct(first_operand_type(form), p), MAP_FIELDS[name]])) }
	if TYPED_HELPERS.has(name) { return finished(ending(typed_helper_called(name, first_operand_type(form), p))) }
	if HOST_FUNCTIONS.has(name) { return wasm_called(form, arguments, WasmOperation(HOST_FUNCTIONS[name]#1, HOST_FUNCTIONS[name]#2, instruction(CALL, [host(p, name)])), p) }
	operations = memory_operations(p)
	if operations.has(name) { return wasm_called(form, arguments, operations[name], p) }
	refused(form, "no primitive of this name")
}
# the plain value a box holds
boxed_operand(form: Prim) as Node := match form { Prim(operation, given) => given#1 }
first_operand_type(form: Prim) as Node := match form { Prim(operation, given) => if given is empty then refused(form, "this primitive takes an operand") else type_of(given#1) }
# an optional's value, x known to be there: a plain value taken out of its box, a reference made non-null; a
# missing one traps. A value any or a number holds, known of its type, is cast to it first.
# an any's value as an any, `x!` of an any (an any? is an any), is the any itself, missing raising
optional_value(form: Node, p: Program) as list<int> := if layout_of(first_operand_type(form), p.m, p.records) == ANYREF then (if typed_layout(form, p) == ANYREF then REF_AS_NON_NULL else held_value(type_of(form), form, p)) else if typed_layout(form, p) in PLAIN_VALUES then instruction(STRUCT_GET, [box_index(p.m, plain_word(form)), 0]) else REF_AS_NON_NULL
# the code of a primitive its helper function performs
helper_called(form: Node, operands: list<int>, key: text, build: (Program) -> int, p: Program) as Code := finished(Code(typed_layout(form, p), operands + instruction(CALL, [helper(p, key, build)])))
# the wasm type of the value a primitive gives, [] when its definition writes none, NEVER when it never finishes
# the helper function of an operation, added by `build` the first time
helper(p: Program, operation: text, build: (Program) -> int) as int := {
	if p.helpers.has(operation) { return p.helpers[operation] }
	index = build(p)
	p.helpers[operation] = index
	index
}

# the body run for each count from 0 while it stays below the limit, the count in that local
counted(local: int, limit: list<int>, body: list<int>) as list<int> := {
	count = local_get(local)
	i32_const(0) + local_set(local) + BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + count + limit + I32_GE_U + instruction(BRANCH_IF, [1]) + body + count + i32_const(1) + I32_ADD + local_set(local) + instruction(BRANCH, [0]) + END + END
}

# The helper of text_joined: a new text of the first's bytes, then the second's. Its locals: 0 and 1 the texts, 2 the
# new one.
joining_function(p: Program) as int := {
	type = text_type(p.m)
	items_in = local => local_get(local) + ARRAY_LEN
	joined = local_get(2)
	copy = (at, local) => joined + at + local_get(local) + i32_const(0) + items_in(local) + instruction(ARRAY_COPY, [type, type])
	made = items_in(0) + items_in(1) + I32_ADD + instruction(ARRAY_NEW_DEFAULT, [type]) + local_set(2)
	added_function(p.m, [nullable(type), nullable(type)], [nullable(type)], [nullable(type)], made + copy(i32_const(0), 0) + copy(items_in(0), 1) + joined)
}

# The helper of array_slice(t, from, count): a new text of count bytes of t, from the place `from` counting from 0.
# Its locals: 0 the text, 1 from, 2 count, 3 the new text. A slice past the end traps.
slicing_function(p: Program) as int := {
	text = text_layout(p.m)
	added_function(p.m, [text, I64, I64], [text], [text], slice_copied(text_type(p.m), local_get(0)) + local_get(3))
}
# a slice's new array of an array type in local 3: `count` (local 2) items copied from the array `source` gives, from
# the place `from` (local 1), both ints
slice_copied(array: int, source: list<int>) as list<int> := int_local(2) + instruction(ARRAY_NEW_DEFAULT, [array]) + local_set(3) + local_get(3) + i32_const(0) + source + int_local(1) + int_local(2) + instruction(ARRAY_COPY, [array, array])
# an int local as an i32
int_local(slot: int) as list<int> := local_get(slot) + I32_WRAP_I64
# The helper giving a case's name by its tag, among the cases of every enum the program declares (patterns.wap
# tag_of). Its local: 0 the case.
case_naming_function(p: Program) as int := {
	cases = p.records.items.flat_map(cases_of)
	named = (1 to #cases).flat_map(at => local_get(0) + tagged(p.m) + i32_const(at - 1) + I32_EQ + IF + VOID_BLOCK + text_literal(text(case_name(cases#at)), p.m).instructions + RETURN + END)
	added_function(p.m, [nullable(enum_base(p.m))], [text_layout(p.m)], [], named + UNREACHABLE)
}
