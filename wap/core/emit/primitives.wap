# The primitives the emitter performs (notes/kernel.md "Primitives"): where warp ends and wasm or the host begins.
#
# Input: a Prim's operation and the code of its arguments; output: the code of the operation. Only the preload
# writes a Prim, as the body of a built-in (wap/preload/prelude.wap), so each operation here is named once, in the
# definition that gives it a warp signature. An operation that needs more than a few instructions is a helper
# function of the module, emitted once.

use "emitter.wap"
use "equality.wap"
use "lists.wap"
use "patterns.wap"
use "values.wap"
use "wasm.wap"
use "functions.wap"
use "opcodes.wap"
use "../../kernel/forms.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "places.wap"
use "host.wap"

# a character's UTF-8 bytes: the code point below which it takes 1, 2 or 3 bytes, the lead byte's mark for each count,
# a following byte's mark, and the bits each following byte holds
UTF8_LIMITS = [0x80, 0x800, 0x10000]
UTF8_LEADS = [0, 0xC0, 0xE0, 0xF0]
UTF8_FOLLOWER = 0x80
UTF8_BITS = 6

# The wasm instructions a Prim names: operation → opcode. The types of its operands and of its value are the ones
# its built-in's definition writes (wap/preload/prelude.wap).
INSTRUCTIONS = {
	"ref_is_null": REF_IS_NULL, "i64_add": I64_ADD, "i64_sub": I64_SUB, "i64_mul": I64_MUL, "i64_eq": I64_EQ, "i64_ne": I64_NE,
	"i64_lt_s": I64_LT_S, "i64_gt_s": I64_GT_S, "i64_le_s": I64_LE_S, "i64_ge_s": I64_GE_S,
	"f64_add": F64_ADD, "f64_sub": F64_SUB, "f64_mul": F64_MUL, "f64_div": F64_DIV, "f64_eq": F64_EQ, "f64_ne": F64_NE,
	"f64_lt": F64_LT, "f64_gt": F64_GT, "f64_le": F64_LE, "f64_ge": F64_GE,
	"i64_div_s": I64_DIV_S, "i64_rem_s": I64_REM_S, "f64_neg": F64_NEG, "f64_floor": F64_FLOOR, "f64_ceil": F64_CEIL,
	"i64_trunc_f64_s": I64_TRUNC_F64_S, "f64_convert_i64_s": F64_CONVERT_I64_S,
	"i64_reinterpret_f64": I64_REINTERPRET_F64, "f64_reinterpret_i64": F64_REINTERPRET_I64,
	"array_len": ARRAY_LEN + I64_EXTEND_I32_U, "i64_extend_i32_u": I64_EXTEND_I32_U, "i32_wrap_i64": I32_WRAP_I64
}
# a helper's early end: unless the test on the stack is yes, the helper gives no
NO_UNLESS_YES = I32_EQZ + IF + VOID_BLOCK + i32_const(0) + RETURN + END

# The operations a helper function of the module performs: operation → the function that builds the helper
HELPERS = {"print_text": printing_function, "error_text": error_writing_function, "arguments": arguments_function, "bytes_written": bytes_writing_function, "raise_text": raising_function, "read_text": reading_function, "text_equal": text_equality_function, "text_joined": joining_function, "char_text": char_text_function}
# The operations on an array, a text's bytes or a list's items, of the array type their first operand holds: their
# instructions after the operands, and the helpers they call, one for each array type
ARRAY_INSTRUCTIONS = {"array_get_u": unsigned_item}
ARRAY_HELPERS = {"array_slice": slicing_function, "array_joined": arrays_joining_function}
# the lists a map holds, not copied: its keys and its values, an entry the same place in both
MAP_FIELDS = {"map_keys_held": MAP_KEYS, "map_values_held": MAP_VALUES}

# two cases compared, by the type of the first: its tag and its fields, each by its own type's equality
TAG_EQUAL = "tag_equal"
# the code of a primitive: its arguments, then its instruction or a call of its helper, giving the value its
# built-in's definition writes
primitive_code(form: Node, operation: Node, arguments: list, p: Program) as Code := {
	name = operation_of(form)
	operands = arguments.flat_map(argument => argument.instructions)
	# the value the operands and these instructions after them give
	ending = instructions => Code(given_layout(form, p), operands + instructions)
	if INSTRUCTIONS.has(name) { return ending(INSTRUCTIONS[name]) }
	if HELPERS.has(name) { return helper_called(form, operands, name, HELPERS[name], p) }
	if name == BOXED_TEST { return ending(heap_instruction(REF_TEST, held_in_any(fact_of(form, TESTED), form, p)#1)) }
	if name == CHECKED_CAST { return finished(ending(cast_called(given_layout(form, p), text(fact_of(form, TYPE)), form, p))) }
	if name == OPTIONAL_VALUE { return ending(optional_value(form, p)) }
	if name == TAG_EQUAL { return ending(type_equality(first_operand_type(form), p)) }
	if name == LIST_COUNT { return ending(counted_items(p)) }
	if MAP_FIELDS.has(name) { return ending(instruction(STRUCT_GET, [map_struct(first_operand_type(form), p), MAP_FIELDS[name]])) }
	if TYPED_HELPERS.has(name) { return finished(ending(typed_helper_called(name, first_operand_type(form), p))) }
	if ARRAY_INSTRUCTIONS.has(name) { return ending(ARRAY_INSTRUCTIONS[name](form, array_operand(form, arguments), p)) }
	if ARRAY_HELPERS.has(name) {
		array = array_operand(form, arguments)
		return helper_called(form, operands, "${name} ${array}", q => ARRAY_HELPERS[name](q, array), p)
	}
	refused(form, "no primitive of this name")
}
# an array's operations given a list work on its items: operation → the list's
ON_LISTS = {"array_len": LIST_COUNT, "array_joined": "list_joined", "array_slice": "list_slice"}
# the operation a primitive performs: the one it names, or the list's for an array's operation given a list
operation_of(form: Prim) as text := match form { Prim(operation, given) => if ON_LISTS.has(text(operation)) and is_list_type(first_operand_type(form)) then ON_LISTS[text(operation)] else text(operation) }
first_operand_type(form: Prim) as Node? := match form { Prim(operation, given) => if given is empty then ø else fact_of(given#1, TYPE) }
is_list_type(type: Node?) as bool := item_type(type) != ø or type == symbol(LIST_TYPE)
# an optional's value, x known to be there: a plain value taken out of its box, a reference made non-null; a
# missing one traps. A value any or a number holds, known of its type, is cast to it first.
# an any's value as an any, `x!` of an any (an any? is an any), is the any itself, missing raising
optional_value(form: Node, p: Program) as list := if layout_of(first_operand_type(form), p.m, p.records) == ANYREF then (if given_layout(form, p) == ANYREF then REF_AS_NON_NULL else held_value(fact_of(form, TYPE), form, p)) else if given_layout(form, p) in PLAIN_VALUES then instruction(STRUCT_GET, [box_index(p.m, plain_word(form)), 0]) else REF_AS_NON_NULL
# the array type of a primitive's first operand
array_operand(form: Node, arguments: list) as int := (if arguments is empty then ø else referenced(arguments#1.type)) ?? refused(form, "this primitive's first operand is an array of a known type: a text or a list<T>")
# a packed array's item at a place counted from 0, an unsigned byte as an int
unsigned_item(form: Node, array: int, p: Program) as list := {
	if not packed_array(p.m, array) { refused(form, "array_get_u reads a text's bytes; a list's item is xs#i") }
	I32_WRAP_I64 + instruction(ARRAY_GET_U, [array]) + I64_EXTEND_I32_U
}
# the code of a primitive its helper function performs
helper_called(form: Node, operands: list, key: text, build: function, p: Program) as Code := finished(Code(given_layout(form, p), operands + instruction(CALL, [helper(p, key, build)])))
# the wasm type of the value a primitive gives, [] when its definition writes none, NEVER when it never finishes
given_layout(form: Node, p: Program) as list := if fact_of(form, TYPE) == ø then [] else if text(fact_of(form, TYPE)) == NEVER_WORD then NEVER else layout(form, p)
# the helper function of an operation, added by `build` the first time
helper(p: Program, operation: text, build: function) as int := {
	for each in p.helpers { if each#1 == operation { return each#2 } }
	index = build(p)
	p.helpers += [[operation, index]]
	index
}

# the body run for each count from 0 while it stays below the limit, the count in that local
counted(local: int, limit: list, body: list) as list := {
	count = instruction(LOCAL_GET, [local])
	i32_const(0) + instruction(LOCAL_SET, [local]) + BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + count + limit + I32_GE_U + instruction(BRANCH_IF, [1]) + body + count + i32_const(1) + I32_ADD + instruction(LOCAL_SET, [local]) + instruction(BRANCH, [0]) + END + END
}

# The helper of text_joined: a new text of the first's bytes, then the second's
joining_function(p: Program) as int := arrays_joining_function(p, text_type(p.m))
# The helper of array_joined and text_joined: a new array of the first's items, then the second's. Its locals: 0 and
# 1 the arrays, 2 the new one.
arrays_joining_function(p: Program, type: int) as int := {
	items_in = local => instruction(LOCAL_GET, [local]) + ARRAY_LEN
	joined = instruction(LOCAL_GET, [2])
	copy = (at, local) => joined + at + instruction(LOCAL_GET, [local]) + i32_const(0) + items_in(local) + instruction(ARRAY_COPY, [type, type])
	made = items_in(0) + items_in(1) + I32_ADD + instruction(ARRAY_NEW_DEFAULT, [type]) + instruction(LOCAL_SET, [2])
	added_function(p.m, [nullable(type), nullable(type)], [nullable(type)], [nullable(type)], made + copy(i32_const(0), 0) + copy(items_in(0), 1) + joined)
}

# The helper of array_slice(xs, from, count): a new list of count items of xs, from the place `from` counting from 0.
# Its locals: 0 the list, 1 from, 2 count, 3 the new list. A slice past the end traps.
slicing_function(p: Program, type: int) as int := {
	given = nullable(type)
	place = local => instruction(LOCAL_GET, [local]) + I32_WRAP_I64
	sliced = instruction(LOCAL_GET, [3])
	made = place(2) + instruction(ARRAY_NEW_DEFAULT, [type]) + instruction(LOCAL_SET, [3])
	copied = sliced + i32_const(0) + instruction(LOCAL_GET, [0]) + place(1) + place(2) + instruction(ARRAY_COPY, [type, type])
	added_function(p.m, [given, I64, I64], [given], [given], made + copied + sliced)
}

# The helper of char_text: a character's text, its UTF-8 bytes, 1 to 4 by its code point. Its local: 0 the character.
char_text_function(p: Program) as int := {
	type = text_type(p.m)
	c = instruction(LOCAL_GET, [0])
	shifted = bits => c + i32_const(bits) + I32_SHR_U
	follower = bits => shifted(bits) + i32_const(63) + I32_AND + i32_const(UTF8_FOLLOWER) + I32_OR
	bytes = count => shifted(UTF8_BITS * (count - 1)) + i32_const(UTF8_LEADS#count) + I32_OR + (1 to count - 1).flat_map(i => follower(UTF8_BITS * (count - 1 - i))) + instruction(ARRAY_NEW_FIXED, [type, count])
	shorter = (1 to UTF8_LIMITS.length).flat_map(count => c + i32_const(UTF8_LIMITS#count) + I32_LT_U + IF + VOID_BLOCK + bytes(count) + RETURN + END)
	added_function(p.m, [I32], [nullable(type)], [], shorter + bytes(UTF8_LEADS.length))
}
