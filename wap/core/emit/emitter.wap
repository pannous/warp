# Kernel forms to a wasm module (notes/kernel.md): one case per form, any other node refused.
#
# Input: the kernel (wap/kernel/forms.wap and the literals); output: a Module (core/emit/wasm.wap). The emitter
# never sees a surface spelling, and it decides nothing a rule could decide: it translates. Which wasm type holds a
# value is core/emit/values.wap's; the bytes are wasm.wap's.
#
# Names arrive bound (core/analyze/scope.wap): each carries what it refers to and the name that defined it, so the
# emitter never looks a name up by its spelling; a call's name refers to the one typed function it means
# (core/analyze/types.wap). The emitter reads only the parameters' types yet: a value's type is known once its code is
# emitted, so a function's body is emitted at its first call (its globals set by then), or at the end of its block
# when nothing calls it. What is still unknown, a function calling itself or a global read before it is set, is
# refused, never guessed.
#
# The emitter knows no library word: the preload's functions the program calls (wap/preload/prelude.wap) come before
# the program's statements, emitted like its own functions, and a built-in's body is a Prim
# (core/emit/primitives.wap). Functions and calls are core/emit/functions.wap's, matching patterns.wap's, and where
# values live places.wap's.

use "functions.wap"
use "lists.wap"
use "patterns.wap"
use "places.wap"
use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "host.wap"
use "function_values.wap"
use "opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

# the type of code that never finishes, as a return or a break: it fits wherever a value of any type is wanted
NEVER_WORD = "never"
# its layout, a byte no wasm value type has, so a layout list holds it as it holds the others
NEVER_LAYOUT = 0x00
NEVER = [NEVER_LAYOUT]
# the system interface the program prints and exits through
WASI = "wasi_snapshot_preview1"
# the labels wasm's structured instructions open, so a jump can count how far out its target is
EXIT_LABEL = "exit"
NEXT_LABEL = "next"
OTHER_LABEL = "other"
# the bindings whose variables live in the function's frame
FRAME_BINDINGS = [BOUND_LOCAL, BOUND_PARAMETER, BOUND_CAPTURE]

# The module of a program: its statements become the body of `main`, which the host runs. The typing stage made the
# program print its value, `print(show(it))`, so main gives nothing back.
emitted(program: Block) as Module := {
	m = Module()
	p = Program(m)
	for name in host_calls(program) { p.host[name] = imported(m, WASI, name, HOST_FUNCTIONS[name]#1, HOST_FUNCTIONS[name]#2) }
	added_tag(m, [nullable(text_type(m))])
	p.records = added_records(Records(), match program { Block(statements) => statements })
	f = Frame()
	body = code(program, p, f)
	exported(m, "main", FUNCTION_KIND, function_of(m, [], Code([], uncaught_ended(dropped(body), p)), f))
	exported(m, "memory", MEMORY_KIND, 0)
	m
}

# the host functions the primitives of a program call, each once, in the order met
host_calls(program: Node) as list := {
	names = RAISING_CALLS.map(name => name)
	for operation in primitives_in(program).filter(operation => HOST_CALLS.has(operation)) { for name in HOST_CALLS[operation] { if not names.contains(name) { names.add(name) } } }
	names
}
primitives_in(n: Node) as list := match n {
	Prim(operation, arguments) => [operation_of(n)] + arguments.flat_map(primitives_in)
	Get(subject, key) => primitives_in(subject) + primitives_in(key)
	List(items, bracket, separator) => items.flat_map(primitives_in)
	Key(left, op, right) => primitives_in(left) + primitives_in(right)
	_ => []
}

# What the emitter knows of the whole program: the module, the host functions it imported, and the functions and
# globals emitted so far, each a Placed
class Program {
	m: Module
	# the host functions imported: name → index
	host: map<text, int> = {}
	functions: list<Placed> = []
	globals: list<Placed> = []
	# the Defines whose body is not emitted yet
	pending: list<Node> = []
	# the helper functions primitives call: operation → index
	helpers: map<text, int> = {}
	# the Records the program declares, which lay out their instances
	records: Records = Records()
}
# The function being emitted: its parameters, then its locals, each a Placed numbered as wasm numbers them
class Frame {
	slots: list<Placed> = []
	parameter_count: int = 0
	# a function's frame takes returns, the program's does not; the types of the values returned so far
	function: bool = no
	returns: list = []
	# the layout of the function's result as its signature says, which a returned value is made to fit
	signed: list = []
	# the labels open around the code being emitted, the innermost last
	labels: list<text> = []
}
# A definition where wasm keeps it: its index, the type of its value (a function's result) and, for a function,
# its parameters' types. Its key is where it was defined: file, line and column.
class Placed {
	key: text
	index: int
	type: list
	parameters: list = []
	# a variable of the frame (wasm's locals) rather than of the module
	local: bool = no
}

# the code of a kernel form
code(form: Node, p: Program, f: Frame) as Code := match form {
	Block(statements) => block_code(statements, p, f)
	Define(name, parameters, body) => Code()
	Set(place, value) => assigned_code(form, place, value, p, f)
	Call(called, arguments) => call_code(form, called, arguments, p, f)
	Try(body, handler) => try_code(form, body, handler, p, f)
	If(condition, then_part, else_part) => if_code(form, code(condition, p, f), arm_code(form, then_part, p, f), arm_code(form, else_part, p, f))
	While(condition, body) => while_code(form, condition, body, p, f)
	Case(subject, arms) => case_code(form, code(subject, p, f), arms, p, f)
	Return(value) => return_code(form, value, p, f)
	Break() => Code(NEVER, instruction(BRANCH, [jump(form, f, EXIT_LABEL)]))
	Continue() => Code(NEVER, instruction(BRANCH, [jump(form, f, NEXT_LABEL)]))
	List(entries, Bracket.Curly, separator) => map_code(form, entries, p, f)
	EmptyMap() => map_code(form, [], p, f)
	List(items, Bracket.Square, separator) => Code(layout(form, p), list_made(fact_of(form, TYPE), items_fitted(item_type(fact_of(form, TYPE)), items, p, f), p))
	Get(subject, key) => if fact_of(form, DEFINED_AT) != ø then call_code(form, form, [subject], p, f) else read_code(layout(form, p), place_of(subject, key, p, f))
	Record(name, fields, variants) => Code([], [])
	Key(head, Op.None, List(items, Bracket.Curly, separator)) => instance_code(form, record_named(p.records, head), items, p, f)
	Prim(operation, arguments) => primitive_code(form, operation, arguments.map(argument => code(argument, p, f)), p)
	Fn(parameters, body) => function_value_code(form, p, f)
	Symbol(name) => name_code(form, p, f)
	_ => literal(form, p.m) ?? refused(form, "not a kernel form")
}

# Statements run in order, the value the last one's, every other value dropped. The functions the block defines wait
# from its start, so a call before a definition's line finds it; those nothing called are emitted at its end. A
# definition itself leaves no value.
block_code(statements: list, p: Program, f: Frame) as Code := {
	defined = statements.filter(s => s is Define)
	p.pending += defined
	codes = statements.map(s => code(s, p, f))
	keys = defined.map(function_key)
	for waiting in p.pending.filter(w => function_key(w) in keys) { if function_key(waiting) in p.pending.map(function_key) { emitted_function(waiting, p) } }
	if codes is empty { return Code() }
	Code(codes.last.type, codes[.. #codes - 1].flat_map(dropped) + codes.last.instructions)
}

# A choice by a condition, yes or no (an i32). With both parts of one type (a part that never finishes fits any) it has
# the chosen part's value, otherwise none: each part's value is dropped, as a missing else part's ø is.
if_code(form: Node, condition: Code, then_part: Code, else_part: Code) as Code := {
	checked_condition(form, condition)
	type = joined(then_part.type, else_part.type)
	Code(type, condition.instructions + IF + block_type(type) + kept(then_part, type) + ELSE + kept(else_part, type) + END)
}
# The body's value, or the handler's when a raise in the body is thrown (kernel-try): the handler's body runs in
# place, no closure made, its parameter a local of the frame holding the raise as a Node, Error(Text(text))
#   block (done)  block (caught: text)  try_table (raise → caught)  body  end  br done  end  call error_node
#   local.set error  handler  end
try_code(form: Node, body: Node, handler: Node, p: Program, f: Frame) as Code := match handler {
	Fn(parameters, handling) => {
		tried = choice_fitted(form, labelled(f, [OTHER_LABEL, OTHER_LABEL, OTHER_LABEL], () => code(body, p, f)), body, p)
		error = slotted(f, items_of(parameters)#1, layout_of(symbol(NODE_TYPE), p.m, p.records))
		instead = arm_code(form, handling, p, f)
		type = joined(tried.type, instead.type)
		caught = BLOCK + nullable(text_type(p.m)) + try_table(block_type(type), RAISED_TAG, 0, kept(tried, type)) + instruction(BRANCH, [1]) + END
		Code(type, BLOCK + block_type(type) + caught + instruction(CALL, [helper(p, "error_node", error_node_function)]) + instruction(LOCAL_SET, [error.index]) + kept(instead, type) + END)
	}
	_ => refused(handler, "a Try's handler is a function written in place, `error => …`")
}
# the program's code, a raise no Try caught written and the program ended
uncaught_ended(body: list, p: Program) as list := BLOCK + nullable(text_type(p.m)) + try_table(VOID_BLOCK, RAISED_TAG, 0, body) + RETURN + END + instruction(CALL, [helper(p, "uncaught", uncaught_function)])
# a structured instruction's type: the value it leaves, or none
block_type(type: list) as list := if valued(type) then type else VOID_BLOCK
# a part's code where its choice has the type: its value kept, or dropped when the choice has none
kept(part: Code, type: list) as list := if valued(type) then part.instructions else dropped(part)
arm_code(choice: Node, part: Node, p: Program, f: Frame) as Code := choice_fitted(choice, labelled(f, [OTHER_LABEL], () => code(part, p, f)), part, p)
# a part's value made to fit its choice's type, an If's or a Case's: 3 in `if b then 3 else ø`, an int?, is boxed
choice_fitted(choice: Node, given: Code, part: Node, p: Program) as Code := {
	wanted = typed_layout(choice, p)
	if wanted == ø then given else fitted(given, wanted, part, p)
}
# the type of either of two values: the one that finishes, or the common one; none when they differ
joined(a: list, b: list) as list := if a == NEVER then b else if b == NEVER or a == b then a else []
valued(type: list) as bool := not type is empty and type != NEVER
checked_condition(form: Node, condition: Code) := if condition.type != I32 { refused(form, "a condition is yes or no") }

# A loop: its condition tested before each run of its body, the loop left when it is no. It has no value.
#   block (exit)  loop (next)  condition, not, br_if exit; body; br next  end  end
while_code(form: Node, condition: Node, body: Node, p: Program, f: Frame) as Code := {
	inner = labelled(f, [EXIT_LABEL, NEXT_LABEL], () => {
		test = code(condition, p, f)
		checked_condition(form, test)
		Code([], test.instructions + I32_EQZ + instruction(BRANCH_IF, [jump(form, f, EXIT_LABEL)]) + dropped(code(body, p, f)) + instruction(BRANCH, [jump(form, f, NEXT_LABEL)]))
	})
	Code([], BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + inner.instructions + END + END)
}

# The function left with a value, or with none for a bare return of a function that gives nothing (`return ø` of a
# function giving P? gives its ø); the code after it never runs
return_code(form: Node, value: Node, p: Program, f: Frame) as Code := {
	if not f.function { refused(form, "a return leaves a function; the program has none to leave") }
	given = if value is Empty and not valued(f.signed) then Code() else signed_fit(code(value, p, f), value, f, p)
	f.returns += [given.type]
	Code(NEVER, given.instructions + RETURN)
}

# the code of items made to fit the type a list or a map holds: `[1, "a"]` as a list<any> boxes the 1
# REVIEW (notes/wap_review.md "Dynamic types", 2026-11-18): `fitted` is a second answer to "does it fit", on wasm
# layouts. Its last case turns an any given where a reference is wanted into ø (DROP + null_of): the program goes on
# with a missing value. That place is exactly where dynamic typing needs its checked cast (ref.test, else raise
# naming both types and the place). Once typing writes every conversion into the kernel (core/analyze/fits.wap),
# the emitter only emits the conversion it is handed and this function goes.
# DONE: the checked cast (wap-any-cast); the rest stands.
# A value given where a type is wanted, made to fit it: a plain value boxed for its optional or for `any`, any
# reference taken as itself where `any` is wanted, an `any` cast to the wanted reference type (checked_cast); any
# other value as it is, for its taker to check. `form` is the value's code, whose type picks a plain value's box.
fitted(given: Code, wanted: list, form: Node, p: Program) as Code := {
	m = p.m
	if given.type == wanted { return given }
	if given.type in PLAIN_VALUES and is_reference(wanted) {
		box = box_index(m, plain_word(form))
		if wanted in [nullable(box), ANYREF] { return Code(wanted, given.instructions + instruction(STRUCT_NEW, [box])) }
	}
	if wanted == ANYREF and is_reference(given.type) { return Code(wanted, given.instructions) }
	if given.type == ANYREF and is_reference(wanted) { return Code(wanted, given.instructions + cast_called(wanted, "one", form, p)) }
	given
}
# The helper casting an `any` to a type: the value when it holds one of that type, a plain value taken out of its box,
# a reference type taking ø too; else a raise naming the type and the place that wanted it. `form` is the code
# wanting it, whose type names a plain value's box; `name` the type's name. Its locals: 0 the value, 1 the place.
ANY_OF_ANOTHER_TYPE = "this any holds a value of another type than the"
checked_cast(p: Program, wanted: list, name: text, form: Node) as int := {
	plain = wanted in PLAIN_VALUES
	box = if plain then box_index(p.m, plain_word(form)) else 0
	test = if plain then heap_instruction(REF_TEST, box) else REF_TEST_NULL + heap_of(wanted)
	taken = if plain then heap_instruction(REF_CAST, box) + instruction(STRUCT_GET, [box, 0]) else REF_CAST_NULL + heap_of(wanted)
	fits = local_get(0) + test + IF + VOID_BLOCK + local_get(0) + taken + RETURN + END
	added_function(p.m, [ANYREF, nullable(text_type(p.m))], [wanted], [], fits + raised_with("${ANY_OF_ANOTHER_TYPE} ${name} wanted at ", local_get(1), p))
}
# a casting helper's call given the place, one helper for each type, the type's name for the raise
cast_called(wanted: list, name: text, form: Node, p: Program) as list := text_literal(place_of_code(form), p.m).instructions + instruction(CALL, [helper(p, "cast to ${wanted} ${name}", q => checked_cast(q, wanted, name, form))])
# where code was written, file:line:column
place_of_code(form: Node) as text := "${file_of(form)}:${line_of(form)}:${column_of(form)}"
items_fitted(type: Node, items: list, p: Program, f: Frame) as list := items.map(item => fitted(code(item, p, f), layout_of(type, p.m, p.records) ?? refused(item, "the emitter has no value layout for this type yet"), item, p))
# a function's value made to fit its signed result, a frame without one leaving it as it is
signed_fit(given: Code, form: Node, f: Frame, p: Program) as Code := if valued(f.signed) then fitted(given, f.signed, form, p) else given
# code emitted inside wasm's structured instructions, which open these labels
labelled(f: Frame, labels: list<text>, emit: function) as Code := {
	f.labels += labels
	emitted_code = emit()
	f.labels = f.labels[.. #f.labels - #labels]
	emitted_code
}
# how many labels out the innermost label of that kind is, as br counts
jump(form: Node, f: Frame, label: text) as int := {
	innermost = 0
	for at in 1 to #f.labels { if f.labels#at == label { innermost = at } }
	if innermost == 0 { refused(form, "this jumps out of a loop, and no loop is around it") }
	#f.labels - innermost
}

# the instructions of code whose value nobody takes
dropped(c: Code) as list := c.instructions + (if valued(c.type) then DROP else [])

# code that never finishes ends unreachable, so wasm types what follows as any
finished(c: Code) as Code := if c.type == NEVER then Code(NEVER, c.instructions + UNREACHABLE) else c
