# Kernel forms to a wasm module (notes/kernel.md): one case per form, any other node refused.
#
# Input: the kernel (wap/kernel/forms.wap and the literals); output: a Module (core/emit/wasm.wap). The emitter
# never sees a surface spelling, and it decides nothing a rule could decide: it translates. Which wasm type holds a
# value is core/emit/values.wap's; the bytes are wasm.wap's.
#
# Names arrive bound (core/analyze/scope.wap): each carries what it refers to and the name that defined it, so the
# emitter never looks a name up by its spelling; a call's name refers to the one typed function it means
# (core/analyze/types.wap). The emitter reads only the parameters' types yet: a value's type is known once its code is
# emitted, so a function's body is emitted at its first call (its globals set by then), or at the end of its block
# when nothing calls it. What is still unknown, a function calling itself or a global read before it is set, is
# refused, never guessed.
#
# The emitter knows no library word: the preload's functions the program calls (wap/preload/prelude.wap) come before
# the program's statements, emitted like its own functions, and a built-in's body is a Prim
# (core/emit/primitives.wap).

use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"

# the types of the values the host shows when main gives them back
SHOWN_BY_HOST = [I64]
# the type of code that never finishes, as a return or a break: it fits wherever a value of any type is wanted
NEVER_WORD = "never"
NEVER = [NEVER_WORD]
# the system interface the program prints and exits through
WASI = "wasi_snapshot_preview1"
# the labels wasm's structured instructions open, so a jump can count how far out its target is
EXIT_LABEL = "exit"
NEXT_LABEL = "next"
OTHER_LABEL = "other"
# the bindings whose variables live in the function's frame
FRAME_BINDINGS = [BOUND_LOCAL, BOUND_PARAMETER]

# The module of a program: its statements become the body of `main`, which the host runs. Its value is shown, as
# warp shows a program's value: an int the host shows itself, as main's result. Any other kind is dropped until
# values show themselves (notes/backbone.md "Debts"); the host's float digits are not warp's (0.1 as
# 0.10000000000000001).
emitted(program: Block) as Module := {
	m = Module()
	p = Program(m)
	for name in host_calls(program) { p.host[name] = imported(m, WASI, name, HOST_FUNCTIONS[name]#1, HOST_FUNCTIONS[name]#2) }
	f = Frame()
	body = code(program, p, f)
	shown = if body.type in SHOWN_BY_HOST then Code(body.type, body.instructions) else Code([], dropped(body))
	exported(m, "main", FUNCTION_KIND, function_of(m, [], shown, f))
	exported(m, "memory", MEMORY_KIND, 0)
	m
}

# the host functions the primitives of a program call, each once, in the order met
host_calls(program: Node) as list := {
	names = []
	for operation in primitives_in(program).filter(operation => HOST_CALLS.has(operation)) { for name in HOST_CALLS[operation] { if not names.contains(name) { names.add(name) } } }
	names
}
primitives_in(n: Node) as list := match n {
	Prim(operation, arguments) => [text(operation)] + arguments.flat_map(primitives_in)
	List(items, bracket, separator) => items.flat_map(primitives_in)
	Key(left, op, right) => primitives_in(left) + primitives_in(right)
	_ => []
}

# What the emitter knows of the whole program: the module, the host functions it imported, and the functions and
# globals emitted so far, each a Placed
class Program {
	m: Module
	# the host functions imported: name → index
	host: map = {}
	functions: list = []
	globals: list = []
	# the Defines whose body is not emitted yet
	pending: list = []
	# the helper functions primitives call, each [operation, index]
	helpers: list = []
}
# The function being emitted: its parameters, then its locals, each a Placed numbered as wasm numbers them
class Frame {
	slots: list = []
	parameter_count: int = 0
	# a function's frame takes returns, the program's does not; the types of the values returned so far
	function: bool = no
	returns: list = []
	# the labels open around the code being emitted, the innermost last
	labels: list = []
}
# A definition where wasm keeps it: its index, the type of its value (a function's result) and, for a function,
# its parameters' types. Its key is where it was defined: file, line and column.
class Placed {
	key: text
	index: int
	type: list
	parameters: list = []
	# a variable of the frame (wasm's locals) rather than of the module
	local: bool = no
}

# the code of a kernel form
code(form: Node, p: Program, f: Frame) as Code := match form {
	Block(statements) => block_code(statements, p, f)
	Define(name, parameters, body) => postponed(form, p, f)
	Set(place, value) => assigned_code(form, place, value, p, f)
	Call(called, arguments) => call_code(form, called, arguments, p, f)
	If(condition, then_part, else_part) => if_code(form, code(condition, p, f), labelled(f, [OTHER_LABEL], () => code(then_part, p, f)), labelled(f, [OTHER_LABEL], () => code(else_part, p, f)))
	While(condition, body) => while_code(form, condition, body, p, f)
	Case(subject, arms) => case_code(form, code(subject, p, f), arms, p, f)
	Return(value) => return_code(form, value, p, f)
	Break() => Code(NEVER, instruction(BRANCH, [jump(form, f, EXIT_LABEL)]))
	Continue() => Code(NEVER, instruction(BRANCH, [jump(form, f, NEXT_LABEL)]))
	List(items, Bracket.Square, separator) => Code(layout(form, p), items.flat_map(item => code(item, p, f).instructions) + instruction(ARRAY_NEW_FIXED, [list_of(form, p), #items]))
	Get(subject, key) => if fact_of(form, DEFINED_AT) != ø then call_code(form, form, [subject], p, f) else Code(layout(form, p), item_reached(subject, key, p, f) + instruction(ARRAY_GET, [list_of(subject, p)]))
	Prim(operation, arguments) => primitive_code(form, operation, arguments.map(argument => code(argument, p, f)), p)
	Fn(parameters, body) => refused(form, "the emitter takes function values with closures, not yet")
	Symbol(name) => name_code(form, p, f)
	_ => literal(form, p.m) ?? refused(form, "not a kernel form")
}

# Statements run in order, the value the last one's, every other value dropped. The functions the block defines and
# nothing called are emitted at its end.
block_code(statements: list, p: Program, f: Frame) as Code := {
	codes = statements.map(s => code(s, p, f))
	keys = statements.filter(s => s is Define).map(function_key)
	for waiting in p.pending.filter(w => function_key(w) in keys) { if function_key(waiting) in p.pending.map(function_key) { emitted_function(waiting, p) } }
	if codes is empty { return Code() }
	Code(codes.last.type, codes[.. #codes - 1].flat_map(dropped) + codes.last.instructions)
}

# A choice by a condition, yes or no (an i32). With both parts of one type (a part that never finishes fits any) it has
# the chosen part's value, otherwise none: each part's value is dropped, as a missing else part's ø is.
if_code(form: Node, condition: Code, then_part: Code, else_part: Code) as Code := {
	checked_condition(form, condition)
	type = joined(then_part.type, else_part.type)
	if valued(type) { return Code(type, condition.instructions + IF + type + then_part.instructions + ELSE + else_part.instructions + END) }
	Code(type, condition.instructions + IF + VOID_BLOCK + dropped(then_part) + ELSE + dropped(else_part) + END)
}
# the type of either of two values: the one that finishes, or the common one; none when they differ
joined(a: list, b: list) as list := if a == NEVER then b else if b == NEVER or a == b then a else []
valued(type: list) as bool := not type is empty and type != NEVER
checked_condition(form: Node, condition: Code) := if condition.type != I32 { refused(form, "a condition is yes or no") }

# A choice by patterns: the subject kept in a slot of its own, then each arm tested in order, an If each, until one
# fits; a name binds the subject. Typing gave the Case a value only when its last arm fits any.
#   subject, local.set held;  held == p1, if  r1  else  held == p2, if  r2  else …  end  end
case_code(form: Node, subject: Code, arms: list, p: Program, f: Frame) as Code := {
	f.slots += [Placed("subject of ${place_key(form)}", #f.slots, subject.type, [], yes)]
	held = f.slots.last
	chosen = arms_code(form, arms, held, p, f)
	Code(chosen.type, subject.instructions + instruction(LOCAL_SET, [held.index]) + chosen.instructions)
}
arms_code(form: Node, arms: list, held: Placed, p: Program, f: Frame) as Code := {
	if arms is empty { return Code() }
	match arms#1 {
		Arm(pattern, result) => {
			if pattern is symbol {
				named = held_by(pattern, held, p, f)
				given = code(result, p, f)
				return Code(given.type, named + given.instructions)
			}
			if_code(form, pattern_test(pattern, held, p), labelled(f, [OTHER_LABEL], () => code(result, p, f)), labelled(f, [OTHER_LABEL], () => arms_code(form, arms[1 ..], held, p, f)))
		}
	}
}
# whether the held subject equals a literal pattern: yes or no
pattern_test(pattern: Node, held: Placed, p: Program) as Code := {
	given = literal(pattern, p.m) ?? refused(pattern, "wap matches literals, names and _ so far")
	Code(I32, fetched(held) + given.instructions + equality(held.type, p))
}
# a name pattern given the held subject, code that leaves nothing; _ gives it to none
held_by(pattern: Node, held: Placed, p: Program, f: Frame) as list := if text(pattern) == WILDCARD then [] else fetched(held) + kept(added_variable(pattern, held.type, p, f)) + DROP

# A loop: its condition tested before each run of its body, the loop left when it is no. It has no value.
#   block (exit)  loop (next)  condition, not, br_if exit; body; br next  end  end
while_code(form: Node, condition: Node, body: Node, p: Program, f: Frame) as Code := {
	inner = labelled(f, [EXIT_LABEL, NEXT_LABEL], () => {
		test = code(condition, p, f)
		checked_condition(form, test)
		Code([], test.instructions + I32_EQZ + instruction(BRANCH_IF, [jump(form, f, EXIT_LABEL)]) + dropped(code(body, p, f)) + instruction(BRANCH, [jump(form, f, NEXT_LABEL)]))
	})
	Code([], BLOCK + VOID_BLOCK + LOOP + VOID_BLOCK + inner.instructions + END + END)
}

# The function left with a value, or with none for a bare return; the code after it never runs
return_code(form: Node, value: Node, p: Program, f: Frame) as Code := {
	if not f.function { refused(form, "a return leaves a function; the program has none to leave") }
	given = if value is Empty then Code() else code(value, p, f)
	f.returns += [given.type]
	Code(NEVER, given.instructions + RETURN)
}

# code emitted inside wasm's structured instructions, which open these labels
labelled(f: Frame, labels: list, emit: function) as Code := {
	f.labels += labels
	emitted_code = emit()
	f.labels = f.labels[.. #f.labels - #labels]
	emitted_code
}
# how many labels out the innermost label of that kind is, as br counts
jump(form: Node, f: Frame, label: text) as int := {
	innermost = 0
	for at in 1 to #f.labels { if f.labels#at == label { innermost = at } }
	if innermost == 0 { refused(form, "this jumps out of a loop, and no loop is around it") }
	#f.labels - innermost
}

# the instructions of code whose value nobody takes
dropped(c: Code) as list := c.instructions + (if valued(c.type) then DROP else [])

# a function defined, its body emitted later; the definition leaves no value
postponed(form: Node, p: Program, f: Frame) as Code := {
	p.pending += [form]
	Code()
}
# the function a name defines, its body emitted now if it waits
pending_function(p: Program, called: Node) as Placed? := waiting_function(p, defining_key(called))
waiting_function(p: Program, key: text) as Placed? := {
	for waiting in p.pending { if function_key(waiting) == key { return emitted_function(waiting, p) } }
	ø
}
defined_name(form: Define) as Node := match form { Define(name, parameters, body) => declared_name(name) }
function_key(form: Define) as text := place_key(defined_name(form))

# A function: its parameters the first slots of a new frame, its body's value its result. It waits no longer, so a
# call inside its own body finds it neither waiting nor placed.
emitted_function(waiting: Define, p: Program) as Placed := {
	p.pending = p.pending.filter(other => function_key(other) != function_key(waiting))
	function_placed(waiting, p)
}
function_placed(form: Define, p: Program) as Placed := match form { Define(name, parameters, body) => {
	f = Frame(function: yes)
	for parameter in parameters_of(parameters) { f.slots += [Placed(place_key(declared_name(parameter)), #f.slots, parameter_type(parameter, p), [], yes)] }
	f.parameter_count = #f.slots
	types = f.slots.map(slot => slot.type)
	value = code(body, p, f)
	result = result_type(name, value, f)
	p.functions += [Placed(place_key(declared_name(name)), function_of(p.m, types, Code(result, value.instructions), f), result, types)]
	p.functions.last
} }
parameters_of(parameters: List) as list := match parameters { List(items, bracket, separator) => items }
# The type a function gives back: its body's value and every return's, all of one type
result_type(name: Node, body: Code, f: Frame) as list := {
	result = if body.type == NEVER then (if f.returns is empty then NEVER else f.returns#1) else body.type
	for returned in f.returns { if returned != result { refused(name, "this function gives back values of different types") } }
	result
}
# the wasm function of a frame and its body, its value the result: its index
function_of(m: Module, parameters: list, body: Code, f: Frame) as int := {
	results = if valued(body.type) then [body.type] else []
	added_function(m, parameters, results, f.slots[f.parameter_count ..].map(slot => slot.type), body.instructions)
}

# a parameter's type, as the typing stage gives it
parameter_type(parameter: Node, p: Program) as list := layout(declared_name(parameter), p)
# the layout of a typed form's value
layout(n: Node, p: Program) as list := layout_of(fact_of(n, TYPE) ?? refused(n, "this reached the emitter untyped"), p.m) ?? refused(n, "the emitter has no value layout for this type yet")
# the GC array type of a typed list
list_of(n: Node, p: Program) as int := list_index(fact_of(n, TYPE), p.m) ?? refused(n, "this is no list")
# a list and the wasm index of an item's place, counted from 1 in warp and from 0 in wasm
item_reached(subject: Node, key: Node, p: Program, f: Frame) as list := code(subject, p, f).instructions + code(key, p, f).instructions + I32_WRAP_I64 + i32_const(1) + I32_SUB

# A value given to a place: a name, which then has that value, or a list's item, which leaves none
assigned_code(form: Node, place: Node, value: Node, p: Program, f: Frame) as Code := match place {
	Get(subject, key) => Code([], item_reached(subject, key, p, f) + code(value, p, f).instructions + instruction(ARRAY_SET, [list_of(subject, p)]))
	_ => set_code(form, declared_name(place), code(value, p, f), p, f)
}

# A value given to a name, and that value again, as `x = 3` has the value 3. The first value given decides the type.
set_code(form: Node, place: Node, value: Code, p: Program, f: Frame) as Code := {
	if not valued(value.type) { refused(form, "this gives no value to set") }
	held = variable_of(place, p, f) ?? added_variable(place, value.type, p, f)
	if held.type != value.type { refused(form, "this name held another kind of value before") }
	Code(value.type, value.instructions + kept(held))
}

# a name's value: a parameter, local or global; functions as values and captures come with closures
name_code(name: Node, p: Program, f: Frame) as Code := {
	held = variable_of(name, p, f) ?? refused(name, "this name is read before any value is given to it; a global is read only after the statement that sets it, until the typing stage")
	Code(held.type, fetched(held))
}

# The variable a bound name refers to, ø while nothing has given it a value: a local or parameter lives in the
# frame, a global in the module
variable_of(name: Node, p: Program, f: Frame) as Placed? := {
	binding = binding_of(name)
	if binding in FRAME_BINDINGS { return placed_for(f.slots, name) }
	if binding == BOUND_GLOBAL { return placed_for(p.globals, name) }
	refused(name, "the emitter reads and sets parameters, locals and globals, not a ${binding} yet")
}
added_variable(name: Node, type: list, p: Program, f: Frame) as Placed := {
	if binding_of(name) == BOUND_GLOBAL {
		p.globals += [Placed(defining_key(name), added_global(p.m, type, MUTABLE, default_of(type)), type)]
		return p.globals.last
	}
	f.slots += [Placed(defining_key(name), #f.slots, type, [], yes)]
	f.slots.last
}
fetched(held: Placed) as list := if held.local then instruction(LOCAL_GET, [held.index]) else instruction(GLOBAL_GET, [held.index])
# a value stored, and left on the stack
kept(held: Placed) as list := if held.local then instruction(LOCAL_TEE, [held.index]) else instruction(GLOBAL_SET, [held.index]) + fetched(held)

# code that never finishes ends unreachable, so wasm types what follows as any
finished(c: Code) as Code := if c.type == NEVER then Code(NEVER, c.instructions + UNREACHABLE) else c
# A call of a function the program or the preload defined, its arguments of its parameters' types
call_code(form: Node, called: Node, arguments: list, p: Program, f: Frame) as Code := {
	function = called_function(form, called, p, f)
	if #arguments != #function.parameters { refused(form, "the call gives ${#arguments} arguments, the function takes ${#function.parameters}") }
	given = arguments.map(argument => code(argument, p, f))
	if not (1 to #given).all(at => passes(given#at.type, function.parameters#at)) { refused(form, "the arguments are not of the parameters' types") }
	finished(Code(function.type, given.flat_map(argument => argument.instructions) + instruction(CALL, [function.index])))
}
# whether a value of one wasm type may be passed where another is taken: the same type, or a reference to an array
# where any array is taken (a list<T> given to a `list` parameter)
passes(given: list, taken: list) as bool := given == taken or (taken == ARRAYREF and given#1 == NULLABLE_REFERENCE)
called_function(form: Node, called: Node, p: Program, f: Frame) as Placed := {
	binding = binding_of(called)
	if binding != BOUND_FUNCTION and binding != BOUND_LIBRARY { refused(form, "the emitter calls functions, not a ${binding} yet") }
	placed_for(p.functions, called) ?? pending_function(p, called) ?? refused(form, "a function that calls itself needs its result type, which the typing stage will give")
}

# what a bound name refers to: local, parameter, capture, global, function or library
binding_of(name: Node) as text := text(fact_of(name, BINDING) ?? refused(name, "this name reached the emitter unbound"))
# the definition a bound name refers to, among those placed so far
placed_for(placed: list, name: Node) as Placed? := placed_by_key(placed, defining_key(name))
placed_by_key(placed: list, key: text) as Placed? := {
	for each in placed { if each.key == key { return each } }
	ø
}
# a bound name's definition, by its key
defining_key(name: Node) as text := place_key(fact_of(name, DEFINED_AT) ?? refused(name, "this name reached the emitter without its definition"))
