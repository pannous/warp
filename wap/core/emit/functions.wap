# Functions: a definition waits until its first call or its block's end, then
# its body becomes a wasm function; function values and their captures; calls.

use "emitter.wap"
use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"

# the function a name defines, its body emitted now if it waits
pending_function(p: Program, called: Node) as Placed? := waiting_function(p, defining_key(called))
waiting_function(p: Program, key: text) as Placed? := {
	for waiting in p.pending { if function_key(waiting) == key { return emitted_function(waiting, p) } }
	ø
}
defined_name(form: Define) as Node := match form { Define(name, parameters, body) => declared_name(name) }
function_key(form: Define) as text := place_key(defined_name(form))

# A function: its parameters the first slots of a new frame, its body's value its result. It waits no longer, so a
# call inside its own body finds it neither waiting nor placed.
emitted_function(waiting: Define, p: Program) as Placed := {
	p.pending = p.pending.filter(other => function_key(other) != function_key(waiting))
	function_placed(waiting, p)
}
function_placed(form: Define, p: Program) as Placed := match form { Define(name, parameters, body) => {
	f = Frame(function: yes)
	for parameter in listed(parameters) { f.slots += [Placed(place_key(declared_name(parameter)), #f.slots, parameter_type(parameter, p), [], yes)] }
	f.parameter_count = #f.slots
	types = f.slots.map(slot => slot.type)
	signed = signed_result(declared_name(name), p)
	results = if valued(signed) then [signed] else []
	placed = Placed(place_key(declared_name(name)), reserved_function(p.m, types, results), signed, types)
	f.signed = signed
	p.functions += [placed]
	loaded = captures_loaded(form, listed(parameters), p, f)
	value = signed_fit(code(body, p, f), body, f, p)
	given = result_type(name, value, f)
	if valued(signed) and given != signed and given != NEVER { refused(name, "this function's body gives another type than its signature says") }
	finished_body = if valued(signed) or given == NEVER then value.instructions else dropped(value)
	bodied(p.m, placed.index, f.slots[f.parameter_count ..].map(slot => slot.type), loaded + finished_body)
	placed
} }
# The layout of a function's result as its signature, which the typing stage writes on its name, says: none for ø
SIGNATURE_LESS = "this function reached the emitter without its signature"
signed_result(name: Node, p: Program) as list := {
	result = (function_type_parts(fact_of(name, SIGNATURE)) ?? refused(name, SIGNATURE_LESS))#2
	if text(result) == EMPTY_TYPE_WORD then [] else if text(result) == NEVER_WORD then NEVER else layout_of(result, p.m, p.records) ?? refused(name, "the emitter has no value layout for this function's result yet")
}
EMPTY_TYPE_WORD = "ø"
# the items of a list node: a definition's parameters, a fact's list
listed(n: Node) as list := match n { List(items, bracket, separator) => items }
# A function value's function starts by taking its captures out of its first parameter, the value, into variables of
# its own, which its body reads as any local; a function that captures nothing takes none
captures_loaded(form: Define, parameters: list, p: Program, f: Frame) as list := {
	captures = captures_of(form)
	value = if parameters is empty then ø else declared_name(parameters#1)
	parts = if value == ø then ø else function_value_parts(fact_of(value, TYPE))
	if captures is empty or parts == ø { return [] }
	closure = closure_of(value, p)
	loads = []
	for at in 1 to #captures {
		f.slots += [Placed(place_key(captures#at), #f.slots, layout_of(parts#(at + 1), p.m, p.records), [], yes)]
		loads += instruction(LOCAL_GET, [0]) + instruction(STRUCT_GET, [closure, at - 1]) + instruction(LOCAL_SET, [f.slots.last.index])
	}
	loads
}
# a function value, a struct of what it captures; a function's name as a value captures nothing
function_value_code(form: Node, p: Program, f: Frame) as Code := {
	Code(layout(form, p), captures_code(form, f) + instruction(STRUCT_NEW, [closure_of(form, p)]))
}
# the values a function value captures, read from the variables they are where it is made
captures_code(form: Node, f: Frame) as list := {
	captures_of(form).flat_map(definer => fetched(captured_variable(definer, f)))
}
captured_variable(definer: Node, f: Frame) as Placed := {
	placed_by_key(f.slots, place_key(definer)) ?? refused(definer, "this capture reached the emitter before its value")
}
# the GC struct of a typed function value
closure_of(n: Node, p: Program) as int := function_value_index(fact_of(n, TYPE), p.m, p.records) ?? refused(n, "this is no function value")
# The type a function gives back: its body's value and every return's, all of one type
result_type(name: Node, body: Code, f: Frame) as list := {
	result = if body.type == NEVER then (if f.returns is empty then NEVER else f.returns#1) else body.type
	for returned in f.returns { if returned != result { refused(name, "this function gives back values of different types") } }
	result
}
# the wasm function of a frame and its body, its value the result: its index
function_of(m: Module, parameters: list, body: Code, f: Frame) as int := {
	results = if valued(body.type) then [body.type] else []
	added_function(m, parameters, results, f.slots[f.parameter_count ..].map(slot => slot.type), body.instructions)
}

# a parameter's type, as the typing stage gives it
parameter_type(parameter: Node, p: Program) as list := layout(declared_name(parameter), p)
# A call of a function the program or the preload defined, its arguments of its parameters' types
call_code(form: Node, called: Node, arguments: list, p: Program, f: Frame) as Code := {
	if is_case(called) { return case_value_code(form, called, arguments, p, f) }
	function = called_function(form, called, p, f)
	if #arguments != #function.parameters { refused(form, "the call gives ${#arguments} arguments, the function takes ${#function.parameters}") }
	given = (1 to #arguments).map(at => fitted(code(arguments#at, p, f), function.parameters#at, arguments#at, p.m))
	if not (1 to #given).all(at => passes(given#at.type, function.parameters#at, p.m)) { refused(form, "the arguments are not of the parameters' types") }
	finished(Code(function.type, given.flat_map(argument => argument.instructions) + instruction(CALL, [function.index])))
}
# whether a value of one wasm type may be passed where another is taken: the same type, code that never finishes, or a
# list where any list is taken (a list<T> given to a `list` parameter, its type extending the list base)
passes(given: list, taken: list, m: Module) as bool := given == taken or given == NEVER or (taken == nullable(list_base(m)) and given#1 == NULLABLE_REFERENCE)
called_function(form: Node, called: Node, p: Program, f: Frame) as Placed := {
	binding = binding_of(called)
	if binding != BOUND_FUNCTION and binding != BOUND_LIBRARY { refused(form, "the emitter calls functions, not a ${binding} yet") }
	placed_for(p.functions, called) ?? pending_function(p, called) ?? refused(form, "a function that calls itself needs its result type, which the typing stage will give")
}

# `prim dispatched(x)` in f(x: any): a call of whichever of f's other overloads takes x's type at run time, tried in
# the order of the Prim's fact OVERLOADS, each a function's name as a call names it, its SIGNATURE on it; a value
# none takes, ø included, traps
DISPATCHED = "dispatched"
dispatched_code(form: Node, p: Program) as list := {
	overloads = listed(fact_of(form, OVERLOADS) ?? refused(form, "the typing stage gave this dispatch no overloads"))
	instruction(CALL, [helper(p, "${DISPATCHED} ${overloads.map(place_key).join(" ")}", q => dispatching_function(q, form, overloads))])
}
# The helper of a dispatch: for each overload, a test of its parameter's type on the value in local 0, then the value
# cast, a plain one taken out of its box, and the overload called
dispatching_function(p: Program, form: Node, overloads: list) as int := {
	tried = overloads.flat_map(overload => {
		taken = function_type_parts(fact_of(overload, SIGNATURE))#1#1
		boxed = WORD_LAYOUTS.has(text(taken)) and WORD_LAYOUTS[text(taken)] in PLAIN_VALUES
		type = if boxed then box_index(p.m, text(taken)) else referenced(layout_of(taken, p.m, p.records) ?? []) ?? refused(overload, "a dispatch tests references and boxed values, not this type")
		unboxed = if boxed then instruction(STRUCT_GET, [type, 0]) else []
		called = placed_by_key(p.functions, place_key(overload)) ?? waiting_function(p, place_key(overload)) ?? refused(overload, "this overload is not among the program's functions")
		local_get(0) + instruction(REF_TEST, [type]) + IF + VOID_BLOCK + local_get(0) + instruction(REF_CAST, [type]) + unboxed + instruction(CALL, [called.index]) + RETURN + END
	})
	added_function(p.m, [ANYREF], [given_layout(form, p)], [], tried + UNREACHABLE)
}
