# Equality: whether two values of one type are equal, as `==` and a map's search for a key ask. Plain values, texts
# and the values of `any` by their own comparison; cases, records, lists and optionals by their parts, in helpers that
# may reach themselves through a part of their own type, a Node holding Nodes, so each takes its place in the module
# before its code is written.

use "emitter.wap"
use "lists.wap"
use "patterns.wap"
use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"

# the instructions that compare two values of a type on the stack, giving yes or no
type_equality(type: Node, p: Program) as list<int> := {
	if base_of_optional(type) != ø { return parts_compared(p, "optional_equal ${type}", known_layout(type, p.m, p.records), optionals_compared(type, p)) }
	if item_type(type) != ø { return parts_compared(p, "list_equal ${type}", list_layout(type, p), lists_compared(type, p)) }
	record = record_named(p.records, type)
	if text(type) == ENUM_WORD or record != ø and cases_of(record) is not empty { return parts_compared(p, "tag_equal", nullable(enum_base(p.m)), cases_compared(p)) }
	if record != ø { return parts_compared(p, "record_equal ${type}", known_layout(type, p.m, p.records), records_compared(record, p)) }
	equality(known_layout(type, p.m, p.records), p)
}
# the instructions that compare two values of a wasm type: an int, float, yes/no or character, a text, an `any`
equality(type: list<int>, p: Program) as list<int> := {
	if type == I64 { return I64_EQ }
	if type == F64 { return F64_EQ }
	if type == I32 { return I32_EQ }
	if type == text_layout(p.m) { return instruction(CALL, [helper(p, "text_equal", text_equality_function)]) }
	if type == ANYREF { return instruction(CALL, [helper(p, "any_equal", any_equality_function)]) }
	refused(Text("${type}"), "wap compares ints, floats, yes/no, characters and texts so far")
}
# A call of the helper comparing two values of one layout by their parts, its locals after the two values; the helper
# takes its place before its code is written, so its code may call it again
class Compared { locals: list<list<int>>; code: list<int> }
parts_compared(p: Program, key: text, layout: list<int>, compared: function) as list<int> := {
	if p.helpers.has(key) { return instruction(CALL, [p.helpers[key]]) }
	index = reserved_function(p.m, [layout, layout], [I32])
	p.helpers[key] = index
	made = compared()
	bodied(p.m, index, made.locals, made.code + i32_const(1))
	instruction(CALL, [index])
}

# Two cases: one tag and, for a case with fields, equal fields. Tags count the cases of every enum, so one helper
# serves them all. Its locals: 0 and 1 the cases.
cases_compared(p: Program) as function := () => Compared([], tag_in(0, p) + tag_in(1, p) + I32_EQ + NO_UNLESS_YES + p.records.items.flat_map(record => cases_of(record).filter(case => case_fields(case) is not empty).flat_map(case => fields_compared(record, case, p))))
tag_in(local: int, p: Program) as list<int> := local_get(local) + tagged(p.m)
# When both cases are this one, each of its fields of the two compared by the field's equality
fields_compared(record: Node, case: Node, p: Program) as list<int> := {
	cast = case_struct_of(record, case, p.m, p.records)
	field = (local, at) => local_get(local) + heap_instruction(REF_CAST_NULL, cast) + instruction(STRUCT_GET, [cast, at + #fields_of(record)])
	fields = case_fields(case)
	compared = (1 to #fields).flat_map(at => field(0, at) + field(1, at) + type_equality(field_declared(fields#at), p) + NO_UNLESS_YES)
	tag_in(0, p) + i32_const(declared_tag(case, p)) + I32_EQ + IF + VOID_BLOCK + compared + END
}
# Two instances of a class: each field equal. Its locals: 0 and 1 the instances.
records_compared(record: Node, p: Program) as function := () => {
	at = [struct_of(record, p.m, p.records)]
	Compared([], (1 to #fields_of(record)).flat_map(field => (0 to 1).flat_map(local => local_get(local) + instruction(STRUCT_GET, at + [field - 1])) + type_equality(field_declared(fields_of(record)#field), p) + NO_UNLESS_YES))
}
# Two lists: one count and equal items in order. Its locals: 0 and 1 the lists, 2 a count.
lists_compared(type: Node, p: Program) as function := () => {
	item = local => items_in(type, local, p) + local_get(2) + instruction(ARRAY_GET, [items_array(type, p)])
	Compared([I32], count_in(type, 0, p) + count_in(type, 1, p) + I32_EQ + NO_UNLESS_YES + counted(2, count_in(type, 0, p), item(0) + item(1) + type_equality(list_item(type), p) + NO_UNLESS_YES))
}
# Two optionals: both ø, or both there and their values equal. Its locals: 0 and 1 the optionals.
optionals_compared(type: Node, p: Program) as function := () => {
	base = base_of_optional(type) ?? refused(type, "this is no optional type")
	boxed = text(base) in BOXED_WORDS
	held = local => local_get(local) + (if boxed then instruction(STRUCT_GET, [box_index(p.m, text(base)), 0]) else [])
	Compared([], missing_compared() + held(0) + held(1) + type_equality(base, p) + NO_UNLESS_YES)
}

# when either of locals 0 and 1 is ø: yes when both are, else no
missing_compared() as list<int> := local_get(0) + REF_IS_NULL + IF + VOID_BLOCK + local_get(1) + REF_IS_NULL + RETURN + END + local_get(1) + REF_IS_NULL + IF + VOID_BLOCK + i32_const(0) + RETURN + END

# The helper of text_equal: yes when both texts have the same bytes. Its locals: 0 and 1 the texts, 2 the length, 3 a
# count.
text_equality_function(p: Program) as int := {
	type = text_type(p.m)
	no_unless_equal = I32_EQ + NO_UNLESS_YES
	byte = local => local_get(local) + local_get(3) + instruction(ARRAY_GET_U, [type])
	lengths = local_get(0) + ARRAY_LEN + instruction(LOCAL_TEE, [2]) + local_get(1) + ARRAY_LEN + no_unless_equal
	bytes = counted(3, local_get(2), byte(0) + byte(1) + no_unless_equal)
	added_function(p.m, [nullable(type), nullable(type)], [I32], [I32, I32], lengths + bytes + i32_const(1))
}
# The helper of equality of two values of `any` or `number`: two ø are equal; two plain values of one type in their
# boxes and two texts by their values; any other two references only when they are the same one. Its locals: 0 and 1
# the values.
any_equality_function(p: Program) as int := {
	boxed = BOXED_WORDS.flat_map(word => compared_as(box_index(p.m, word), instruction(STRUCT_GET, [box_index(p.m, word), 0]), equality(WORD_LAYOUTS[word], p)))
	texts = compared_as(text_type(p.m), [], equality(text_layout(p.m), p))
	same = local_get(0) + REF_CAST + EQ_HEAP + local_get(1) + REF_CAST + EQ_HEAP + REF_EQ
	added_function(p.m, [ANYREF, ANYREF], [I32], [], missing_compared() + boxed + texts + same)
}
# when the value in local 0 is of a type: no unless local 1 is too, else both taken out and compared
compared_as(type: int, taken: list<int>, compare: list<int>) as list<int> := {
	both = local_get(0) + heap_instruction(REF_CAST, type) + taken + local_get(1) + heap_instruction(REF_CAST, type) + taken
	local_get(0) + heap_instruction(REF_TEST, type) + IF + VOID_BLOCK + local_get(1) + heap_instruction(REF_TEST, type) + NO_UNLESS_YES + both + compare + RETURN + END
}
