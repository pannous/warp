# Where values live: the layout of a typed form, a record's field or a list's item
# reached, read and written, and the variables a bound name refers to.

use "emitter.wap"
use "lists.wap"
use "primitives.wap"
use "values.wap"
use "wasm.wap"
use "opcodes.wap"
use "functions.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "patterns.wap"
use "function_values.wap"

# the layout of a form's value as typing gives it: none for a form typing left without a value, NEVER for one that
# never finishes
typed_layout(n: Node, p: Program) as list<int> := if fact_of(n, TYPE) == ø then [] else result_layout(type_of(n), p)
# a type's layout as a value or a result: none for ø, NEVER for never
result_layout(type: Node, p: Program) as list<int> := if text(type) == EMPTY_TYPE_WORD then [] else if text(type) == NEVER_WORD then NEVER else known_layout(type, p.m, p.records)
layout(n: Node, p: Program) as list<int> := layout_of(type_of(n), p.m, p.records) ?? refused(n, "the emitter has no value layout for the type ${type_of(n)} yet")
# The way to a part of a value, a record's field or a list's item: the instructions that reach it, then the one that
# reads it and the one that writes it
class Place { reached: list<int>; read: list<int>; written: list<int> }
place_of(subject: Node, key: Node, p: Program, f: Frame) as Place := {
	map = type_of(subject)
	record = record_named(p.records, type_of(subject))
	if record != ø {
		at = [struct_of(record, p.m, p.records), index_where(fields_of(record), field => text(declared_name(field)) == text(key)) - 1]
		return Place(code(subject, p, f).instructions, instruction(STRUCT_GET, at), instruction(STRUCT_SET, at))
	}
	Place(item_reached(subject, key, p, f), typed_helper_called(LIST_ITEM, map, p), typed_helper_called(LIST_SET, map, p))
}
read_code(type: list<int>, place: Place) as Code := Code(type, place.reached + place.read)
written_code(place: Place, value: Code) as Code := Code([], place.reached + value.instructions + place.written)

# A map, `{yes: 1, no: 0}`: its keys, a word's spelling as a text, in a new list, its values in another, both in a
# new struct of the map's type
map_code(form: Node, entries: list<Node>, p: Program, f: Frame) as Code := {
	keys = entries.map(entry => match entry { Key(key, Op.Colon, value) => if key is symbol then text_literal(text(key), p.m) else code(key, p, f); _ => refused(entry, NOT_AN_ENTRY) })
	Code(layout(form, p), map_made(type_of(form), keys, items_fitted(map_value(type_of(form)), entries.map(given_value), p, f), p))
}

# An instance, `Point{x: 1, y: 2}`: its fields' values in the order its record writes them, a new struct
instance_code(form: Node, record: Node, items: list<Node>, p: Program, f: Frame) as Code := {
	values = fields_of(record).map(field => items.filter(item => text(declared_name(item)) == text(declared_name(field)))#1)
	Code(layout(form, p), (1 to #values).flat_map(at => field_filled(fields_of(record)#at, given_value(values#at), p, f)) + instruction(STRUCT_NEW, [struct_of(record, p.m, p.records)]))
}
# the instructions of a value given to a field, made to fit the field's type
field_filled(field: Node, value: Node, p: Program, f: Frame) as list<int> := {
	given = code(value, p, f)
	fitted(given, known_layout(field_declared(field), p.m, p.records), value, p).instructions
}
given_value(field: Node) as Node := match field { Key(name, Op.Colon, value) => value; _ => refused(field, NOT_A_FIELD) }
# a list and the wasm index of an item's place, counted from 1 in warp and from 0 in wasm
item_reached(subject: Node, key: Node, p: Program, f: Frame) as list<int> := code(subject, p, f).instructions + code(key, p, f).instructions + i64_const(1) + I64_SUB

# A value given to a place: a name, which then has that value, or a list's item, which leaves none
assigned_code(form: Node, place: Node, value: Node, p: Program, f: Frame) as Code := match place {
	Get(subject, key) => written_code(place_of(subject, key, p, f), fitted(code(value, p, f), layout(place, p), value, p))
	_ => set_code(form, declared_name(place), value, p, f)
}

# A value given to a name, and that value again, as `x = 3` has the value 3. The first value given decides the type.
set_code(form: Node, place: Node, given: Node, p: Program, f: Frame) as Code := {
	value = code(given, p, f)
	held = variable_of(place, p, f) ?? added_variable(place, typed_layout(place, p), p, f)
	value = fitted(value, held.type, given, p)
	if not valued(value.type) { refused(form, "this gives no value to set") }
	if held.type != value.type { refused(form, "this name held another kind of value before") }
	Code(value.type, value.instructions + kept(held))
}

# a name's value: a parameter, local, capture or global, or a function's name as a value (an empty struct)
name_code(name: Node, p: Program, f: Frame) as Code := {
	if is_case(name) { return case_value_code(name, name, [], p, f) }
	if names_function(name) { return function_value_code(name, p, f) }
	# a global a function reads before the statement that sets it, the function emitted where its value is taken: the
	# global made here, its statement setting it later
	held = variable_of(name, p, f) ?? (if is_bound(name, DefinitionKind.Global) then added_variable(name, layout(name, p), p, f) else refused(name, "this name is read before any value is given to it"))
	Code(held.type, fetched(held))
}

# The variable a bound name refers to, ø while nothing has given it a value: a local or parameter lives in the
# frame, a global in the module
variable_of(name: Node, p: Program, f: Frame) as Placed? := {
	if FRAME_BINDINGS.any(kind => is_bound(name, kind)) { return placed_for(f.slots, name) }
	if is_bound(name, DefinitionKind.Global) { return placed_for(p.globals, name) }
	refused(name, "the emitter reads and sets parameters, locals and globals, not a ${binding_of(name)} yet")
}
added_variable(name: Node, type: list<int>, p: Program, f: Frame) as Placed := {
	if is_bound(name, DefinitionKind.Global) {
		p.globals += [Placed(defining_key(name), added_global(p.m, type, MUTABLE, default_of(type)), type)]
		return p.globals.last
	}
	f.slots += [Placed(defining_key(name), #f.slots, type, [], yes)]
	f.slots.last
}
fetched(held: Placed) as list<int> := if held.local then local_get(held.index) else instruction(GLOBAL_GET, [held.index])
# a value stored, and left on the stack
kept(held: Placed) as list<int> := if held.local then instruction(LOCAL_TEE, [held.index]) else instruction(GLOBAL_SET, [held.index]) + fetched(held)
# what a bound name refers to: local, parameter, capture, global, function or library
binding_of(name: Node) as text := text(fact_of(name, BINDING) ?? refused(name, "this name reached the emitter unbound"))
# the definition a bound name refers to, among those placed so far
placed_for(placed: list<Placed>, name: Node) as Placed? := placed_by_key(placed, defining_key(name))
placed_by_key(placed: list<Placed>, key: text) as Placed? := {
	for each in placed { if each.key == key { return each } }
	ø
}
# a bound name's definition, by its key
defining_key(name: Node) as text := place_key(fact_of(name, DEFINED_AT) ?? refused(name, "this name reached the emitter without its definition"))
