# The wasm binary format: the lower half of wap's emitter (notes/backbone.md, milestone 0).
#
# Input: what the emitter asks for (types, functions, data, instructions); output: a module's bytes. It knows
# modules, sections, types and instructions, and nothing of warp: no Node, no kernel form, no value layout (that is
# the emitter's). A module is built up by adding its parts (`imported`, `added_type`, `added_function`, `added_global`,
# `added_text`, `exported`) and turned into bytes once, by `module_bytes`.
# Format reference: https://webassembly.github.io/spec/core/binary/

use "opcodes.wap"

# A module in the making. Imports come first among the functions, so a function's index is counted after them. Each
# entry is in bytes, as its section writes it, except a function and a recursion group, whose parts
# the module reads again.
class WasmModule {
	types: list<list<int>> = []
	# the types declared together in one recursion group
	groups: list<RecursionGroup> = []
	imports: list<list<int>> = []
	functions: list<DefinedFunction> = []
	globals: list<list<int>> = []
	exports: list<list<int>> = []
	# passive segments, each its bytes, for `array.new_data`; numbered first, so an index is final when added
	texts: list<list<int>> = []
	# exception tags, each its bytes
	tags: list<list<int>> = []
	# the functions `ref.func` refers to, declared once each
	referenced: list<int> = []
	# types known by a name, each its index; the names whose type is being built; the indices reserved for names
	# that referred back to themselves while the recursion group holding them is still open
	named: map<text, int> = {}
	naming: list<text> = []
	reserved: list<int> = []
}
# a recursion group: the index of its first type, how many it holds, and whether its types are distinct from the
# same shapes elsewhere; those of records that refer to each other are not, so they are found again by shape
class RecursionGroup { first: int, count: int, distinct: bool }
# a function of the module: its type's index, and its code, empty while only its place is reserved
class DefinedFunction { type_index: int, code: list<int> }

# An unsigned number as LEB128, 7 bits a byte, the low bits first, each byte but the last with its high bit set:
# 624485 → [0xE5, 0x8E, 0x26]
unsigned(n: int) as list<int> := {
	bytes = []
	rest = n
	while rest >= 0x80 {
		bytes += [rest % 0x80 + 0x80]
		rest = rest ÷ 0x80
	}
	bytes + [rest]
}
# A signed number as LEB128, as `i64.const` takes it: -1 → [0x7F]
signed(n: int) as list<int> := {
	bytes = []
	rest = n
	while rest < -0x40 or rest >= 0x40 {
		bytes += [rest % 0x80 + 0x80]
		rest = (rest - rest % 0x80) ÷ 0x80
	}
	bytes + [rest % 0x80]
}
# a number as `width` bytes, the lowest first, as memory holds it
little_endian(n: int, width: int) as list<int> := (0 upto width).map(at => n ÷ 0x100 ^ at % 0x100)

# an instruction with its unsigned immediates: instruction(CALL, [3])
instruction(opcode: list<int>, indices: list<int>) as list<int> := opcode + indices.flat_map(unsigned)
# an instruction on a heap type, which the format writes signed, a declared type's index among them: ref.test 64 is
# [0xFB, 0x14, 0xC0, 0x00]
heap_instruction(opcode: list<int>, type_index: int) as list<int> := opcode + signed(type_index)
i32_const(n: int) as list<int> := I32_CONST + signed(n)
i64_const(n: int) as list<int> := I64_CONST + signed(n)
f64_const(x: float) as list<int> := F64_CONST + little_endian(float_bits(x), 8)
local_get(local: int) as list<int> := instruction(LOCAL_GET, [local])
local_set(local: int) as list<int> := instruction(LOCAL_SET, [local])
# the null reference of a heap type, `ref.null any`
null_of(heap_type: list<int>) as list<int> := REF_NULL + heap_type

# the value a variable of that type starts with: zero, or the null reference
default_of(value_type: list<int>) as list<int> := {
	if value_type == I64 { return i64_const(0) }
	if value_type == F64 { return f64_const(0.0) }
	if value_type == I32 { return i32_const(0) }
	if value_type#1 == NULLABLE_REFERENCE { return REF_NULL + value_type[1 ..] }
	REF_NULL + value_type
}

# whether a value type is a nullable reference, and the heap type it refers to
is_reference(type: list<int>) as bool := type == ANYREF or #type > 1 and type#1 == NULLABLE_REFERENCE
heap_of(reference: list<int>) as list<int> := if reference#1 == NULLABLE_REFERENCE then reference[1 ..] else reference
# a nullable reference to the declared type of that index
nullable(type_index: int) as list<int> := [NULLABLE_REFERENCE] + signed(type_index)
# the type index a nullable reference to a declared type holds, nullable(3) → 3; ø for an abstract one, as arrayref.
# Every reference wap makes is nullable, so a non-null one (0x64) is not read yet.
referenced(reference: list<int>) as int? := if #reference < 2 or reference#1 != NULLABLE_REFERENCE then ø else (2 to #reference).map(at => reference#at % 0x80 * 0x80 ^ (at - 2)).sum()

# The format's lists: their length, then the items. `counted` takes items already in bytes, `bytes_vector` raw bytes.
counted(items: list<list<int>>) as list<int> := unsigned(#items) + items.flat_map(item => item)
bytes_vector(bytes: list<int>) as list<int> := unsigned(#bytes) + bytes
named(name: text) as list<int> := bytes_vector(name.bytes)
section(id: int, items: list<list<int>>) as list<int> := {
	content = counted(items)
	[id] + unsigned(#content) + content
}

# Types: a function's, a struct's, an array's. A field is its storage type and whether it is mutable.
function_type(parameters: list<list<int>>, results: list<list<int>>) as list<int> := [FUNCTION_TYPE] + counted(parameters) + counted(results)
field_type(storage: list<int>, mutability: int) as list<int> := storage + [mutability]
struct_type(fields: list<list<int>>) as list<int> := [STRUCT_TYPE] + counted(fields)
array_type(item: list<int>) as list<int> := [ARRAY_TYPE] + item
# a type open to subtypes, extending these type indices
open_type(supertypes: list<int>, type: list<int>) as list<int> := [SUBTYPE] + unsigned(#supertypes) + supertypes.flat_map(unsigned) + type

# The index of a type, added once. Each type is its own recursion group, so a struct may hold references to itself.
added_type(m: WasmModule, type: list<int>) as int := {
	for at in 1 to #m.types { if m.types#at == type and not grouped(m, at - 1).distinct { return at - 1 } }
	m.types += [type]
	#m.types - 1
}
# Types declared together in one recursion group: types of one group are distinct by their place in it, even when
# their shapes match, so a reference tells at run time which of them it is. The index of the first.
added_group(m: WasmModule, types: list<list<int>>) as int := {
	for group in m.groups { if m.types[group.first .. group.first + group.count] == types { return group.first } }
	m.groups += [RecursionGroup(#m.types, #types, yes)]
	m.types += types
	m.groups.last.first
}
# A type known by a name, a record's by its declaration: its index, or ø while it is not built yet, which starts
# building it. A name asked for again while its type is being built refers back to itself: its index is reserved.
named_index(m: WasmModule, name: text) as int? := {
	if m.named.has(name) { return m.named[name] }
	if not m.naming.contains(name) {
		m.naming += [name]
		return ø
	}
	m.named[name] = #m.types
	m.reserved += [#m.types]
	m.types += [[]]
	m.named[name]
}
# The index of a named type built at last. One whose index was reserved takes its place; once every reserved one is
# built, the types made since the first are one recursion group, so they may refer to each other.
named_added(m: WasmModule, name: text, type: list<int>) as int := {
	m.naming = m.naming[0 .. #m.naming - 1]
	if not m.named.has(name) {
		m.named[name] = added_type(m, type)
		return m.named[name]
	}
	at = m.named[name]
	m.types = m.types[0 .. at] + [type] + m.types[at + 1 ..]
	if m.reserved.all(slot => m.types#(slot + 1) != []) {
		m.groups += [RecursionGroup(m.reserved#1, #m.types - m.reserved#1, no)]
		m.reserved = []
	}
	at
}
# the group a type's index lies in; a type declared alone is a group of one, as the format reads it
grouped(m: WasmModule, index: int) as RecursionGroup := {
	for group in m.groups { if index >= group.first and index < group.first + group.count { return group } }
	RecursionGroup(index, 1, no)
}
# the type section's entries: a group of one as its type, a larger group as one entry of its types
type_entries(m: WasmModule) as list<list<int>> := {
	entries = []
	for at in 0 to #m.types - 1 {
		group = grouped(m, at)
		if group.count == 1 { entries += [m.types#(at + 1)] } else if group.first == at { entries += [[REC_GROUP] + counted(m.types[at .. at + group.count])] }
	}
	entries
}

# An imported function, `wasi_snapshot_preview1.fd_write`: its index among the functions.
imported(m: WasmModule, module: text, name: text, parameters: list<list<int>>, results: list<list<int>>) as int := {
	m.imports += [named(module) + named(name) + [FUNCTION_KIND] + unsigned(added_type(m, function_type(parameters, results)))]
	#m.imports - 1
}

# A function of the module, its locals after its parameters, its body without the final `end`: its index among
# the functions.
added_function(m: WasmModule, parameters: list<list<int>>, results: list<list<int>>, locals: list<list<int>>, body: list<int>) as int := {
	index = reserved_function(m, parameters, results)
	bodied(m, index, locals, body)
	index
}
# A function's place in the module, taken before its code is known, so its own body can call it: its index
reserved_function(m: WasmModule, parameters: list<list<int>>, results: list<list<int>>) as int := {
	m.functions += [DefinedFunction(added_type(m, function_type(parameters, results)), [])]
	#m.imports + #m.functions - 1
}
# the code of a function whose place was reserved
bodied(m: WasmModule, index: int, locals: list<list<int>>, body: list<int>) := { m.functions[index - #m.imports].code = code_entry(locals, body) }
# a function's code: its size, its locals one entry each, its instructions and `end`
code_entry(locals: list<list<int>>, body: list<int>) as list<int> := {
	content = counted(locals.map(local => unsigned(1) + local)) + body + END
	unsigned(#content) + content
}

# A global of that type, mutable or not, set at start by the constant instructions `initial`: its index.
added_global(m: WasmModule, type: list<int>, mutability: int, initial: list<int>) as int := {
	m.globals += [type + [mutability] + initial + END]
	#m.globals - 1
}

exported(m: WasmModule, name: text, kind: int, index: int) := { m.exports += [named(name) + [kind] + unsigned(index)] }

# An exception tag whose exceptions carry values of these types: its index
added_tag(m: WasmModule, parameters: list<list<int>>) as int := {
	m.tags += [[EXCEPTION_TAG] + unsigned(added_type(m, function_type(parameters, [])))]
	#m.tags - 1
}
# a block of a type running `body`, an exception of the tag thrown in it caught: its values taken to the label that far out
try_table(type: list<int>, tag: int, label: int, body: list<int>) as list<int> := TRY_TABLE + type + unsigned(1) + [CATCH] + unsigned(tag) + unsigned(label) + body + END
# Bytes kept passive, for `array.new_data`: their segment index.
added_text(m: WasmModule, bytes: list<int>) as int := {
	m.texts += [bytes]
	#m.texts - 1
}

# A reference to a function of the module, `ref.func`, its index declared for the element section
function_reference(m: WasmModule, index: int) as list<int> := {
	if not (index in m.referenced) { m.referenced += [index] }
	instruction(REF_FUNC, [index])
}
# the element section, one declarative segment of the functions referred to; none when no function is
declared_references(m: WasmModule) as list<int> := if m.referenced is empty then [] else section(ELEMENT_SECTION, [DECLARED_FUNCTIONS + unsigned(#m.referenced) + m.referenced.flat_map(unsigned)])
# The whole module, its sections in the order the format requires.
module_bytes(m: WasmModule) as list<int> := {
	declarations = m.functions.map(function => unsigned(function.type_index))
	codes = m.functions.map(function => function.code)
	passive = m.texts.map(bytes => [PASSIVE_SEGMENT] + bytes_vector(bytes))
	memory_pages = [[0x00] + unsigned(1)]
	segment_count = [DATA_COUNT_SECTION] + unsigned(#unsigned(#passive)) + unsigned(#passive)
	MAGIC + VERSION + section(TYPE_SECTION, type_entries(m)) + section(IMPORT_SECTION, m.imports) + section(FUNCTION_SECTION, declarations) + section(MEMORY_SECTION, memory_pages) + section(TAG_SECTION, m.tags) + section(GLOBAL_SECTION, m.globals) + section(EXPORT_SECTION, m.exports) + declared_references(m) + segment_count + section(CODE_SECTION, codes) + section(DATA_SECTION, passive)
}
