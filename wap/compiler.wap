#!/usr/bin/env warp
# wap, the new compiler (notes/backbone.md, notes/wap.md, the file tree): a program's source in, a wasm module out.
#
#   warp wap/compiler.wap hello.wap hello.wasm      compile
#   warp hello.wasm                                  run it
#   warp wap/compiler.wap format hello.wap           print it in canonical warp spelling
#
# Its stages, each with one job and a declared input and output (the full pipeline: notes/wap.md):
#   read      text → notation       core/parse/reader.wap
#   operators notation → operated   core/parse/operators.wap, by the table in preload/operators.wap
#   shape     operated → surface    core/rules/stages.wap, the rules of kernel/forms.wap, core/sugar/ and the program
#   declare   operated → declared   core/analyze/declarations.wap, the names the top level defines, as facts
#   lower     declared → kernel     core/rules/lowering.wap, by hand until the rule engine runs
#   bind      kernel → bound        core/analyze/scope.wap, what each name refers to, as facts
#   type      bound → typed         core/analyze/types.wap, each value's type and the function each call means, as facts
#   typed rules typed → typed       core/rules/typed.wap, rules with holes of value types, typed again after each round
#   emit      kernel → module       core/emit/emitter.wap, one case per kernel form
#   encode    module → bytes        core/emit/wasm.wap, the wasm binary format
use "kernel/forms.wap"
use "core/stage.wap"
use "core/errors.wap"
use "preload/operators.wap"
use "core/parse/reader.wap"
use "core/parse/operators.wap"
use "core/format.wap"
use "core/analyze/declarations.wap"
use "core/rules/patterns.wap"
use "core/rules/templates.wap"
use "core/rules/stages.wap"
use "core/rules/lowering.wap"
use "core/analyze/scope.wap"
use "core/analyze/types.wap"
use "core/rules/typed.wap"
use "core/emit/wasm.wap"
use "core/emit/values.wap"
use "core/emit/emitter.wap"
use "core/emit/primitives.wap"

# the patterns of the kernel forms and the rules of the spellings every program may use, loaded as data
RULE_FILES = ["kernel/forms.wap", "core/sugar/conditions.wap", "core/sugar/definitions.wap", "core/sugar/calls.wap"]
rule_file(name: text) as text := program.folder + "/" + name
for file in RULE_FILES { rules_loaded(operated_program(notation(read(rule_file(file)), rule_file(file)))) }

# the standard language every program gets, as definitions (preload/prelude.wap), declared once: what it declares is
# the library every program is bound in
PRELOAD = program.folder + "/preload/prelude.wap"
preload = declared(PRELOAD)
library = declarations_of(preload)

# a file's text read, its operators read, its spellings rewritten by the shape rules, then declared
declared(file: text) as Node := declared_program(shaped_program(operated_program(notation(read(file), file))))
# declared code lowered and bound inside the preload's declarations and those of the modules it uses
prepared(code: Node, modules: list) as Block := bound_program(lowered_program(code), library + uses_of(code).flat_map(file => declarations_of(module_of(file, modules))))
# the program with the modules it uses, theirs first: a module's statements run before the code that uses it, its
# functions are there for any caller; typed, then rewritten by the typed rules
compiled(file: text) as list := {
	code_read = declared(file)
	modules = modules_used(code_read, declared) + [code_read]
	whole = Block(modules.flat_map(code => statements_in(prepared(code, modules))))
	library_code = bound_program(lowered_program(preload), [])
	module_bytes(emitted(typed_by_rules(typed_program(whole, library_code), library, library_code)))
}

if #args != 2 { raise "usage: warp wap/compiler.wap <program> <module.wasm>, or format <program>" }
if args#1 == "format" { print formatted(operated_program(notation(read(args#2), args#2))) } else { write_bytes(args#2, compiled(args#1)) }
