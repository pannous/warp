# The preload's node (notes/wap.md "Layers"): wap's Node, the one notation of data and code (notes/first_principles.md),
# and the words over it in plain warp: a node's position and facts, a symbol by its name. A Meta node's data is the
# list [line, column, facts…]. A list's items are typed list<Node>.

enum Node {
	True
	False
	Empty
	Number(value: number)
	Char(value: codepoint)
	Text(value: text)
	Symbol(name: text)
	Error(node: Node)
	Key(left: Node, op: Op, right: Node)
	List(items: list<Node>, bracket: Bracket, separator: Separator)
	Data(value: any)
	Meta(node: Node, data: Node)
	Type(name: Node, body: Node)
}

# The operators a node carries, each its own value:
# todo: put into operators.md ?
# `Op.Add as text` is "+" (text(op) below) TODO word(Op.Add) = "add" as definable alias def add(my_class,b){} ?
enum Op {
	Colon, Dot, SafeDot, Coalesce, Scope, Define, Assign, Arrow, ArrowUp, ArrowDown
	Add, Sub, Mul, Div, FloorDiv, Mod /* %: -7 mod 3 is 2*/ , Rem /* ⦼: -7 rem 3 is -1 */, Pow, LogBase, LogOf, Shl, Shr
	AddAssign, SubAssign, MulAssign, DivAssign, FloorDivAssign, ModAssign, PowAssign, AndAssign, OrAssign, XorAssign
	Lt, Gt, Le, Ge, Eq, Is, Ne, Identical, NotIdentical, Similar, Rough
	And, Or, Xor, Not, BitAnd, BitOr
	Neg, Sqrt, Cbrt, Abs /*unused: √ ∛ ‖ ‖ call functions; kept while the seed's op codes have them, card remove-unused*/, Inc, Dec, Question
	If, Then, Else, While, Do
	Hash, Range, To, As, PlusMinus
	None
	# any other operator, `a ⊕ b` of key(a, "⊕", b): its spelling is its own (`op as text` is "⊕"), each joining the
	# runtime's spellings at its first use (card enum-op-should)
	Other # Other(sign:char) todo: carry it's codepoint (or text?)
}

# A list's bracket: `Bracket.Square as text` is "[", an unbracketed list's None is ""
enum Bracket { Curly, Square, Round, Less, None }

# A list's separator: `Separator.Comma as text` is ","
enum Separator { Space, Comma, Semicolon, Newline, Tab, None }

# the place of a Meta node's line and column in its data, the facts after them
META_LINE := 1
META_COLUMN := 2
META_FACTS := 3
# a node marked with facts but written nowhere has line 0, so no position
NO_LINE := 0
# a Data node's text: its value has no text of its own type
DATA_TEXT := "data"
# the text of the case Other, which no node carries: it stands for every spelling no other case has, `⊕`
OTHER_SPELLING := "·other"

# the symbol of a name: `symbol("x")` is the word x
symbol(name: text): Node := Symbol(name)
# an atom as its case, read so wherever a Node is wanted: `n: Node = 'a'` is Char('a'), 3 is Number(3), "a" Text("a")
Node(c: char): Node := Char(c)
Node(n: number): Node := Number(n)
Node(t: text): Node := Text(t)

# where n was written, ø for a node without a position
line_of(n: Node) := written_part(n, META_LINE)
column_of(n: Node) := written_part(n, META_COLUMN)
written_part(n: Node, place: int) := match n {
	Meta(node, List(data, bracket, separator)) => if int_in(data#META_LINE) == NO_LINE then ø else int_in(data#place)
	_ => ø
}
# the int a node holds, ø for any other node
int_in(n: Node) := match n {
	Number(value) => if value is int then value else ø
	_ => ø
}
# n where it was written, its facts kept
positioned(n: Node, line: int, column: int): Node := Meta(unwrapped(n), meta_data(line, column, attributes_of(n)))

# the facts a stage marked n with, and n with one more in place of one of its name: `type: int` replaces `type: text`
attributes_of(n: Node): list<Node> := match n {
	Meta(node, List(data, bracket, separator)) => facts_in(data)
	_ => []
}
# a Meta's data past its line and column
facts_in(data: list<Node>): list<Node> := data[META_FACTS - 1 ..]
with_attribute(n: Node, fact: Node): Node := match n {
	Meta(node, List(data, bracket, separator)) => Meta(node, List(data.take(META_FACTS - 1) + facts_in(data).filter(held => not same_name(held, fact)) + [fact], bracket, separator))
	_ => Meta(n, meta_data(NO_LINE, NO_LINE, [fact]))
}
# whether two facts have one name, `type: int` and `type: text`
same_name(fact: Node, other: Node): bool := match fact {
	Key(name, Op.Colon, value) => match other { Key(other_name, Op.Colon, other_value) => name == other_name; _ => no }
	_ => no
}

# the node a Meta wraps, any other node itself
unwrapped(n: Node): Node := match n {
	Meta(node, data) => node
	_ => n
}
meta_data(line: int, column: int, facts: list<Node>): Node := List([Number(line), Number(column)] + facts, Bracket.Square, Separator.Comma)

# the text a node carries for an operator, `Op.Add as text` is "+"
text(op: Op): text := match op {
	Op.Colon => ":"
	Op.Dot => "."
	Op.SafeDot => "?."
	Op.Coalesce => "??"
	Op.Scope => "::"
	Op.Define => ":="
	Op.Assign => "="
	Op.Arrow => "->"
	Op.ArrowUp => "↑"
	Op.ArrowDown => "↓"
	Op.Add => "+"
	Op.Sub => "-"
	Op.Mul => "*"
	Op.Div => "/"
	Op.FloorDiv => "÷"
	Op.Mod => "%"
	Op.Rem => "rem"
	Op.Pow => "^"
	Op.LogBase => "⌞"
	Op.LogOf => "⌟"
	Op.Shl => "<<"
	Op.Shr => ">>"
	# DONE (compound_assignment, core/parse/operator_table.wap) assignment change is a UNIVERSAL pattern a ⊕= b  => a = a ⊕ b  for ALL operators automatically!
	Op.AddAssign => "+="
	Op.SubAssign => "-="
	Op.MulAssign => "*="
	Op.DivAssign => "/="
	Op.FloorDivAssign => "÷="
	Op.ModAssign => "%="
	Op.PowAssign => "^="
	Op.AndAssign => "&&="
	Op.OrAssign => "||="
	Op.XorAssign => "^^="
	Op.Lt => "<"
	Op.Gt => ">"
	Op.Le => "<="
	Op.Ge => ">="
	Op.Eq => "=="
	Op.Is => "is"
	Op.Ne => "!="
	Op.Identical => "==="
	Op.NotIdentical => "!=="
	Op.Similar => "≈"
	Op.Rough => "~"
	Op.And => "and"
	Op.Or => "or"
	Op.Xor => "xor"
	Op.Not => "not"
	Op.BitAnd => "&"
	Op.BitOr => "|"
	Op.Neg => "-"
	Op.Sqrt => "√"
	Op.Cbrt => "∛"
	Op.Abs => "‖"
	Op.Inc => "++"
	Op.Dec => "--"
	Op.Question => "?"
	Op.If => "if"
	Op.Then => "then"
	Op.Else => "else"
	Op.While => "while"
	Op.Do => "do"
	Op.Hash => "#"
	Op.Range => ".."
	Op.To => "to"
	Op.As => "as"
	Op.PlusMinus => "±"
	Op.None => ""
	Op.Other => OTHER_SPELLING
}

# A node's text as warp's runtime prints it (core/runtime/show.warp node_text): a word, a text or a character itself,
# a number its digits, a key `a: 1`, `f(x)`, `a+b`, `a and b`, a list between its brackets, its items as code
text(n: Node): text := match n {
	True => "yes"
	False => "no"
	Empty => "ø"
	Number(value) => number_text(value)
	Char(value) => text(value)
	Text(value) => value
	Symbol(name) => name
	Error(node) => text(node)
	Key(left, op, right) => key_text(left, op, right)
	List(items, bracket, separator) => opening(bracket) + items.map(code).join(separator_text(separator)) + closing(bracket)
	Data(value) => DATA_TEXT
	Meta(node, data) => text(node)
	Type(name, body) => "type " + text(name) + " " + text(body)
}
# the `is` narrows the number to an int or a float, so each arm picks its own text overload
number_text(value: number): text := if value is int then text(value) else text(value)
# `a: 1` with a space after the colon, a word operator between spaces, any other written against its operands
key_text(left: Node, op: Op, right: Node): text := {
	spelling = text(op)
	if op == Op.Colon { return code(left) + spelling + " " + code(right) }
	if spelling != "" and is_alpha(spelling[0 .. 1]) { return code(left) + " " + spelling + " " + code(right) }
	code(left) + spelling + code(right)
}
# a node as code: a text quoted, a character in single quotes, any other node as its text
code(n: Node): text := match n {
	Text(value) => show(value)
	Char(value) => show(value)
	Meta(node, data) => code(node)
	_ => text(n)
}
# a list's brackets and separator as written
opening(bracket: Bracket): text := match bracket {
	Bracket.Curly => "{"
	Bracket.Square => "["
	Bracket.Round => "("
	Bracket.Less => "<"
	Bracket.None => ""
}
closing(bracket: Bracket): text := match bracket {
	Bracket.Curly => "}"
	Bracket.Square => "]"
	Bracket.Round => ")"
	Bracket.Less => ">"
	Bracket.None => ""
}
separator_text(separator: Separator): text := match separator {
	Separator.Space => " "
	Separator.Comma => ", "
	Separator.Semicolon => "; "
	Separator.Newline => "\n"
	Separator.Tab => "\t"
	Separator.None => ""
}

# Two nodes are equal when their code is, wherever it was written and whatever facts it carries: a Meta is
# transparent, as in warp, at every depth, since a key's and a list's parts compare by this same ==
==(a: Node, b: Node): bool := same_code(unwrapped(a), unwrapped(b))
!=(a: Node, b: Node): bool := not(a == b)
# the two nodes' cases matched as a pair; nodes of two different cases, or of one case without parts, are equal as
# their tags are
same_code(a: Node, b: Node): bool := match [a, b] {
	[Number(x), Number(y)] => x == y
	[Char(x), Char(y)] => x == y
	[Text(x), Text(y)] => x == y
	[Symbol(x), Symbol(y)] => x == y
	[Error(x), Error(y)] => x == y
	[Key(left, op, right), Key(other_left, other_op, other_right)] => op == other_op and left == other_left and right == other_right
	[List(items, bracket, separator), List(other_items, other_bracket, other_separator)] => bracket == other_bracket and separator == other_separator and items == other_items
	[Type(name, body), Type(other_name, other_body)] => name == other_name and body == other_body
	_ => prim tag_equal(a, b)
}

# A node as a condition reads it, as warp's runtime does (core/runtime/conversions.warp node_truthy), wherever it was
# written: Empty, no and an Error are empty, a number, character, text or word when 0 or blank, a list without items,
# a key when both its sides are; any other node is not
empty(n: Node): bool := match unwrapped(n) {
	Empty => yes
	False => yes
	Error(node) => yes
	Number(value) => number_empty(value)
	Char(value) => ord(value) == 0
	Text(value) => empty(value)
	Symbol(name) => empty(name)
	List(items, bracket, separator) => empty(items)
	Key(left, op, right) => empty(left) and empty(right)
	_ => no
}
# the `is` narrows the number to an int or a float, so each arm picks its own empty
number_empty(value: number): bool := if value is int then empty(value) else empty(value)

# an Error's message, the text it was raised with: `e.message` of `catch e` after `raise "boom"` is "boom"
# (wiki/Error.md)
message(e: Node): text := match unwrapped(e) {
	Error(node) => match unwrapped(node) {
		Text(value) => value
		_ => text(node)
	}
	_ => raise "only an Error has a message: `catch e` names one, `if r failed` tests for one"
}
