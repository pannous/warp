# The preload's list words (notes/wap.md "Layers"): plain warp over lists and function values, a list in, a value or a
# new list out. `xs.map(f)` is map(xs, f) by the dot rule (core/sugar/calls.wap). A letter in a signature is a type
# variable, bound by the call: map's U is f's result for an item.

# whether every item of a list fits a test, any item does, a list holds an item: `xs.all(x => x > 0)`, `xs.contains(3)`
all(xs: list, fits) := {
	for x in xs { if not fits(x) { return no } }
	yes
}
any(xs: list, fits) := {
	for x in xs { if fits(x) { return yes } }
	no
}
contains(xs: list, item) := xs.any(x => x == item)

# a new list of a's items, then b's: `[1, 2] + [3]` is [1, 2, 3]
+(a: list<T>, b: list<T>): list<T> := prim array_joined(a, b)
# an item put at the end of a list, which grows in place: every name holding it sees the item
add(xs: list<T>, item: T) := prim list_add(xs, item)
# the last item taken off a list; an empty one raises
pop(xs: list<T>): T := prim list_pop(xs)

# each item's result, in order: `[1, 2].map(x => x * 10)` is [10, 20]
map(xs: list<T>, f: (T) -> U): list<U> := {
	out: list<U> = []
	for x in xs { out = out + [f(x)] }
	out
}
# the items that fit a test, in order
filter(xs: list<T>, fits: (T) -> bool): list<T> := {
	out: list<T> = []
	for x in xs { if fits(x) { out = out + [x] } }
	out
}
# each item's list of results, joined: `[1, 2].flat_map(x => [x, x])` is [1, 1, 2, 2]
flat_map(xs: list<T>, f: (T) -> list<U>): list<U> := {
	out: list<U> = []
	for x in xs { out = out + f(x) }
	out
}
# the items combined into one value from a first one, left to right: `[1, 2, 3].fold(0, (sum, x) => sum + x)` is 6
fold(xs: list<T>, first: U, combined: (U, T) -> U): U := {
	value = first
	for x in xs { value = combined(value, x) }
	value
}
# texts joined, the separator between each two: `["a", "b"].join(", ")` is "a, b"
join(texts: list<text>, separator: text): text := {
	out = ""
	for at in 1 to #texts { out = out + (if at > 1 then separator else "") + texts#at }
	out
}

# the position of an item, counted from 1, 0 when the list holds none: `[10, 20].index_of(20)` is 2 (wiki/indexing.md)
index_of(xs: list, item) := xs.index_where(x => x == item)
# the position of the first item that fits a test, 0 when none does
index_where(xs: list, fits) := {
	at = 0
	while at < #xs {
		at += 1
		if fits(xs#at) { return at }
	}
	0
}

# a list in warp notation, each item shown by its own show: `show([1, 2])` is [1, 2]
show(xs: list): text := {
	out = ""
	for at in 1 to #xs { out = out + (if at > 1 then ", " else "") + show(xs#at) }
	"[" + out + "]"
}
