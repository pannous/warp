# Calls written other ways (notes/wap.md preload/sugar/): `x.f(y)` is f(x, y), any function on any value, and `x.f` is
# x's part named f, a field or else f(x) (kernel/forms.wap Get), so a chain reads in order: `xs.map(f).sum`
rule $x.$f($arguments...) => $f($x, $arguments...)
# a part's item, `g.names["b"]`, is the part taken first, then its item: the reader glued the brackets to the name
rule $x.$f[$key] => Get($x, "$f")[$key]
rule $x.$f => Get($x, "$f")
# a script shows its last value, if it gives one: `1 + 2` alone prints 3
rule (Block $statements... $last: value) where script => { $statements...; print(show($last)) }
