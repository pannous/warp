# Data reached other ways, as Get (notes/kernel.md "Data"): the spellings wap's own source uses.

# a list's item by its place, counting from 1: `xs#2`
rule ($subject#$key) => Get($subject, $key)
# an item's own item, `xs#1[1 ..]`, is the item taken first, then its index: the reader glued the brackets to the
# place, as it glues them to a part's name (calls.wap `x.f[key]`)
rule ($subject#$key[$index]) => Get($subject, $key)[$index]


# a list's item by its index, counting from 0 (wiki/indexing.md): `xs[0]` is the first item, `xs#1`
rule $subject[$index] => Item($subject, $index)
