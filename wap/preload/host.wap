# The preload's host words (notes/wap.md "Layers"): files read and written and the command line, plain warp over the
# module's memory and WASI's calls. Its primitives are the memory's bytes and words, its size and growth, a text made
# and its bytes set, and each WASI call by its own name (core/emit/primitives.wap).

# the memory: an iovec [address, length] at 0, the count a call moved or the file it opened at 8, bytes from 16
IOVEC_AT := 0
MOVED_AT := 8
BYTES_AT := 16
PAGE_BYTES := 65536
# WASI: the folders the host opens for a program, the current one and the root (core/native/driver.warp), so a path
# starting with / opens in the second; links followed; the rights to read and seek; seek from the start or the end
CURRENT_FOLDER := 3
FOLLOW_LINKS := 1
READ_AND_SEEK := 6
# WASI: open flags to create a missing file and empty one that is there; the right to write
CREATED_OR_EMPTIED := 9
WRITE_RIGHT := 64
FROM_START := 0
FROM_END := 2
SLASH := 47

memory_byte(at: int): int := prim memory_byte(at)
set_memory_byte(at: int, b: int) := prim memory_set_byte(at, b)
memory_word(at: int): int := prim memory_word(at)
set_memory_word(at: int, word: int) := prim memory_set_word(at, word)
memory_pages(): int := prim memory_size()
memory_grown_by(pages: int): int := prim memory_grow(pages)
# a text of `count` zero bytes, and one of them set: how a text is made from the memory's bytes
text_made(count: int): text := prim text_made(count)
set_text_byte(t: text, at: int, b: int) := prim text_byte_set(t, at, b)

args_sizes_get(count_at: int, size_at: int): int := prim args_sizes_get(count_at, size_at)
args_get(addresses_at: int, bytes_at: int): int := prim args_get(addresses_at, bytes_at)
path_open(folder: int, lookup: int, path_at: int, length: int, flags: int, rights: int, inherited: int, file_flags: int, opened_at: int): int := prim path_open(folder, lookup, path_at, length, flags, rights, inherited, file_flags, opened_at)
fd_seek(file: int, offset: int, whence: int, position_at: int): int := prim fd_seek(file, offset, whence, position_at)
fd_read(file: int, iovecs_at: int, count: int, moved_at: int): int := prim fd_read(file, iovecs_at, count, moved_at)
fd_write(file: int, iovecs_at: int, count: int, moved_at: int): int := prim fd_write(file, iovecs_at, count, moved_at)
fd_close(file: int): int := prim fd_close(file)

# the memory grown to hold `count` bytes from BYTES_AT
memory_holding(count: int) := {
	short = (BYTES_AT + count + PAGE_BYTES - 1) ÷ PAGE_BYTES - memory_pages()
	if short > 0 { memory_grown_by(short) }
}
# the memory's bytes from an address, as a text
memory_text(at: int, count: int): text := {
	t = text_made(count)
	for place in 0 upto count { set_text_byte(t, place, memory_byte(at + place)) }
	t
}
# the memory's bytes from an address up to the first zero, as a text
zero_ended(at: int): text := {
	end = at
	while memory_byte(end) != 0 { end += 1 }
	memory_text(at, end - at)
}
# the file at a path opened with these flags and rights, relative to the current folder or from the root (/…); a path
# it cannot open raises the refusal and the path
opened(path: text, flags: int, rights: int, refusal: text): int := {
	rooted = if byte_count(path) > 0 and byte_at(path, 0) == SLASH then 1 else 0
	length = byte_count(path) - rooted
	memory_holding(length)
	for at in 0 upto length { set_memory_byte(BYTES_AT + at, byte_at(path, at + rooted)) }
	if path_open(CURRENT_FOLDER + rooted, FOLLOW_LINKS, BYTES_AT, length, flags, rights, 0, 0, MOVED_AT) != 0 { raise refusal + path }
	memory_word(MOVED_AT)
}
# the bytes from BYTES_AT moved to or from a file, by fd_read or fd_write, until `total` are or a call moves none; the
# count moved
moved(file: int, total: int, move: (int, int, int, int) -> int): int := {
	done = 0
	while done < total {
		set_memory_word(IOVEC_AT, BYTES_AT + done)
		set_memory_word(IOVEC_AT + 4, total - done)
		move(file, IOVEC_AT, 1, MOVED_AT)
		if memory_word(MOVED_AT) == 0 { return done }
		done += memory_word(MOVED_AT)
	}
	done
}
# the text of the file at a path, relative to the current folder or from the root (/…)
read(path: text): text := {
	file = opened(path, 0, READ_AND_SEEK, "cannot read ")
	fd_seek(file, 0, FROM_END, MOVED_AT)
	size = memory_word(MOVED_AT)
	fd_seek(file, 0, FROM_START, MOVED_AT)
	memory_holding(size)
	got = moved(file, size, fd_read)
	fd_close(file)
	memory_text(BYTES_AT, got)
}
# the command line: the program's file as it was named, then its arguments. WASI's args_sizes_get puts the count at 0 and the bytes' size at 4, args_get each one's
# address from BYTES_AT and their zero-ended bytes after them
arguments(): list<text> := {
	args_sizes_get(0, 4)
	count = memory_word(0)
	memory_holding(4 * count + memory_word(4))
	args_get(BYTES_AT, BYTES_AT + 4 * count)
	(0 upto count).map(at => zero_ended(memory_word(BYTES_AT + 4 * at)))
}
# bytes written to the file at a path, made anew or emptied first: what a compiler writes its module with
write_bytes(path: text, bytes: list<int>) := {
	file = opened(path, CREATED_OR_EMPTIED, WRITE_RIGHT, "write: cannot open ")
	memory_holding(#bytes)
	for at in 0 upto #bytes { set_memory_byte(BYTES_AT + at, bytes[at]) }
	moved(file, #bytes, fd_write)
	fd_close(file)
}
