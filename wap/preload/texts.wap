# The preload's text words (notes/wap.md "Layers"): plain warp over a text's UTF-8 bytes, as warp's runtime words
# (core/runtime/text_words.warp, characters.warp). Positions count characters from 1; byte offsets count from 0.
# Its primitives are the array operations on a text's bytes: its length, a byte, a new text of some of them.

use "host.wap"

# a byte that continues a character: 10xxxxxx
CONTINUATION_FROM := 128
CONTINUATION_UNTIL := 192
# the characters a hex digit takes beyond the digits
HEX_LETTERS := "abcdefABCDEF"
# the decimal digits, each one byte, at the place of its value
DIGITS := "0123456789"
# the blanks trim takes off: space, tab, line feed, carriage return
BLANK_BYTES := [32, 9, 10, 13]
# the bytes of A and Z, and how far a lower case letter's byte lies above its capital's
UPPER_A_BYTE := 65
UPPER_Z_BYTE := 90
CASE_DISTANCE := 32
# what a character's lead byte keeps of its code, by the character's byte count: all of 0xxxxxxx, five bits of
# 110xxxxx, four of 1110xxxx, three of 11110xxx; each continuation byte keeps six
LEAD_BITS := [128, 32, 16, 8]
CONTINUATION_BITS := 64

byte_count(t: text): int := prim array_len(t)
byte_at(t: text, at: int): int := prim array_get_u(t, at)
bytes_between(t: text, start: int, stop: int): text := prim array_slice(t, start, stop - start)
# a text of one byte
byte_text(b: int): text := {
	t = text_made(1)
	set_text_byte(t, 0, b)
	t
}
# a code's UTF-8 bytes: the fewest that hold it, from `count` bytes up, scale the part of the code below the lead byte's
# bits; the lead byte marked by its count, then the continuation bytes
encoded(code: int, count: int, scale: int): text := if code < LEAD_BITS#count * scale or count == #LEAD_BITS then byte_text(256 - 2 * LEAD_BITS#count + code ÷ scale) + continuation_bytes(code, scale ÷ CONTINUATION_BITS) else encoded(code, count + 1, scale * CONTINUATION_BITS)
# the continuation bytes of a code from the one holding `scale`'s six bits down to the last
continuation_bytes(code: int, scale: int): text := if scale == 0 then "" else byte_text(CONTINUATION_FROM + (code ÷ scale) rem CONTINUATION_BITS) + continuation_bytes(code, scale ÷ CONTINUATION_BITS)

is_continuation_byte(b: int): bool := b >= CONTINUATION_FROM and b < CONTINUATION_UNTIL
# the byte offset after the character at offset `at`
character_end(t: text, at: int): int := {
	end = at + 1
	while end < byte_count(t) and is_continuation_byte(byte_at(t, end)) { end += 1 }
	end
}
# the byte offset of t's index-th character, counted from 1; past the last, the byte count
character_offset(t: text, index: int): int := {
	at = 0
	counted = 1
	while counted < index and at < byte_count(t) {
		at = character_end(t, at)
		counted += 1
	}
	at
}

# the characters from one place to another, counted from 0 as a list's: `"warp"[1 .. 3]` is "ar"
slice(t: text, r: Range): text := bytes_between(t, character_offset(t, r.from + 1), character_offset(t, min(r.last, #t) + 2))
# a text repeated: `"ab" * 3` is "ababab", none for 0 times
*(t: text, times: int): text := {
	out = ""
	for at in 1 to times { out = out + t }
	out
}
# a text's UTF-8 bytes: `"aé".bytes` is [97, 195, 169]
bytes(t: text): list<int> := (0 upto byte_count(t)).map(at => byte_at(t, at))
# a text's characters, decoded from its UTF-8 bytes: `"aé".codepoints` is ['a', 'é']
codepoints(t: text): list<char> := {
	out: list<char> = []
	at = 0
	while at < byte_count(t) {
		end = character_end(t, at)
		out.add(char(decoded(t, at, end)))
		at = end
	}
	out
}
# a text of one character as that character (wiki/char.md: a one-character text is a character): `"é" as codepoint`
# is 'é'; any other text raises
char(t: text): char := {
	characters = codepoints(t)
	if #characters != 1 { raise "only a text of one character is a char" }
	characters#1
}
# the code of the character whose bytes lie between two offsets
decoded(t: text, start: int, end: int): int := {
	code = byte_at(t, start) % LEAD_BITS#(end - start)
	for at in start + 1 ..< end { code = code * CONTINUATION_BITS + byte_at(t, at) % CONTINUATION_BITS }
	code
}

# whether a text has no characters: `t is empty`
empty(t: text): bool := t == ""
# an int's decimal digits, `-` before a negative one's; counted on the int made negative, so the smallest int has its
# digits too
text(n: int): text := if n < 0 then "-" + negated_digits(n) else negated_digits(0 - n)
# the digits of a negative int's size, or of 0
negated_digits(n: int): text := if n > -10 then bytes_between(DIGITS, 0 - n, 1 - n) else negated_digits((n - n rem 10) ÷ 10) + negated_digits(n rem 10)
# a text and an int's digits joined: `"a" + 3` is "a3". A text ending in a digit takes no number, since `"5" + 3` could
# mean 8 (wiki/Footguns.md "String + number")
+(t: text, n: int): text := {
	if t != "" and is_digit(t#(#t)) { raise "no implicit conversion of a text ending in a digit: convert explicitly, e.g. int(\"5\") + 3" }
	t + text(n)
}
# how many characters t holds: `#"héllo"` is 5
#(t: text): int := {
	count = 0
	at = 0
	while at < byte_count(t) {
		at = character_end(t, at)
		count += 1
	}
	count
}
# t's character at a place, counted from 1: `"abc"#2` is "b"
#(t: text, place: int): text := bytes_between(t, character_offset(t, place), character_offset(t, place + 1))

# part's bytes stand in t from byte offset at on
bytes_match_at(t: text, part: text, at: int): bool := {
	if at < 0 or at + byte_count(part) > byte_count(t) { return no }
	i = 0
	while i < byte_count(part) {
		if byte_at(t, at + i) != byte_at(part, i) { return no }
		i += 1
	}
	yes
}
starts_with(t: text, start: text): bool := bytes_match_at(t, start, 0)
ends_with(t: text, end: text): bool := bytes_match_at(t, end, byte_count(t) - byte_count(end))
# the character position of part's first place in t, counted from 1; 0 when t holds no part
find(t: text, part: text): int := {
	at = 0
	position = 1
	while at <= byte_count(t) - byte_count(part) {
		if bytes_match_at(t, part, at) { return position }
		at = character_end(t, at)
		position += 1
	}
	0
}
contains(t: text, part: text): bool := find(t, part) > 0
# t without the blanks (spaces, tabs, line ends) at its start and end: `"  a b ".trim()` is "a b"
trim(t: text): text := {
	start = 0
	stop = byte_count(t)
	while start < stop and is_blank_byte(byte_at(t, start)) { start += 1 }
	while stop > start and is_blank_byte(byte_at(t, stop - 1)) { stop -= 1 }
	bytes_between(t, start, stop)
}
is_blank_byte(b: int): bool := b in BLANK_BYTES
# t with its letters A to Z in lower case: `"Hé ABC".lower()` is "hé abc"
lower(t: text): text := {
	out = ""
	start = 0
	for at in 0 .. byte_count(t) {
		if byte_at(t, at) >= UPPER_A_BYTE and byte_at(t, at) <= UPPER_Z_BYTE {
			out = out + bytes_between(t, start, at) + text(char(byte_at(t, at) + CASE_DISTANCE))
			start = at + 1
		}
	}
	out + bytes_between(t, start, byte_count(t))
}
# the parts of t between its separators, in order: `"a/b".split("/")` is ["a", "b"], a text without one is its only part
split(t: text, separator: text): list<text> := {
	parts: list<text> = []
	start = 0
	at = 0
	while at <= byte_count(t) - byte_count(separator) and byte_count(separator) > 0 {
		if bytes_match_at(t, separator, at) {
			parts.add(bytes_between(t, start, at))
			at += byte_count(separator)
			start = at
		} else {
			at += 1
		}
	}
	parts.add(bytes_between(t, start, byte_count(t)))
	parts
}
# t with each place of a part given another text: `"a-b-c".replace("-", "+")` is "a+b+c"
replace(t: text, part: text, other: text): text := split(t, part).join(other)

# texts in byte order, which is code point order: `"a" < "b"`
<(a: text, b: text): bool := compared(a, b) < 0
<=(a: text, b: text): bool := compared(a, b) <= 0
>(a: text, b: text): bool := compared(a, b) > 0
>=(a: text, b: text): bool := compared(a, b) >= 0
# below 0 when a comes first, 0 when equal, above 0 when b does
compared(a: text, b: text): int := {
	at = 0
	while at < byte_count(a) and at < byte_count(b) {
		if byte_at(a, at) != byte_at(b, at) { return byte_at(a, at) - byte_at(b, at) }
		at += 1
	}
	byte_count(a) - byte_count(b)
}

# a character's kind: a decimal digit, an ASCII letter, a hex digit
is_digit(c: text): bool := c >= "0" and c <= "9"
is_alpha(c: text): bool := (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
is_hex_digit(c: text): bool := is_digit(c) or HEX_LETTERS.contains(c)

# a text in warp notation, in its quotes, its quote and backslash escaped: `show("a\"b")` is "a\"b"; a character in
# single quotes, as written (as old warp shows them)
show(t: text): text := "\"" + escaped(t) + "\""
show(c: char): text := "'" + text(c) + "'"
# t with a backslash before each quote and backslash
escaped(t: text): text := t.replace("\\", "\\\\").replace("\"", "\\\"")
